            {
                "entry_id": "ec47da90-3986-36ff-ab82-e520c0568dd7",
                "word": "gélule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "48279989-ab0d-41f4-9b61-99a17f9865d7",
                        "entry_id": "ec47da90-3986-36ff-ab82-e520c0568dd7",
                        "tags": [
                            "plural"
                        ],
                        "form": "gélules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6bdb6007-c76a-3c9e-9243-c966e99e2bde",
                        "entry_id": "ec47da90-3986-36ff-ab82-e520c0568dd7",
                        "glosses": [
                            "Capsule gélatineuse formée de deux parties emboîtées l’une dans l’autre, destinée à contenir une poudre médicamenteuse en vue de son absorption par voie orale."
                        ],
                        "tags": [
                            "Pharmacie"
                        ],
                        "examples": [
                            {
                                "example_id": "306091cc-36f7-40c1-8caa-e274e0a7ded9",
                                "sense_id": "6bdb6007-c76a-3c9e-9243-c966e99e2bde",
                                "text": "— Non, non, pas en infusion. Ça se prend en gélules, avait-il répondu, fou de joie d’avoir trouvé une oreille intéressée, avant de continuer à psalmodier : La cristallothérapie est aussi très efficace, très réussie."
                            },
                            {
                                "example_id": "dfb08bb1-1533-4ad1-b181-e46bd8d7ce51",
                                "sense_id": "6bdb6007-c76a-3c9e-9243-c966e99e2bde",
                                "text": "Lorsqu’elle pose les médicaments sur la petite table et remplit un verre d’eau, Lucien remarque la grosse gélule et le petit comprimé blanc responsable du brouillard régnant dans son esprit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa811897-26ac-4a84-aeb2-a675015fe8c7",
                        "source_entry_id": "ec47da90-3986-36ff-ab82-e520c0568dd7",
                        "source_sense_id": "6bdb6007-c76a-3c9e-9243-c966e99e2bde",
                        "source_sense_description": "récipient gélatineux digeste destiné à contenir une poudre médicamenteuse",
                        "target_lang_word": "Kapsel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kapsel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ac74a890-1179-3d60-b85d-a074dd5a9597",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "kleines, meist rundes oder ovales Behältnis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b417c83f-f6c1-4453-bfdd-cc94a2d07866",
                                                "sense_id": "ac74a890-1179-3d60-b85d-a074dd5a9597",
                                                "text": "Er bewahrte seine Brille in einer Kapsel auf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2a0c2708-0112-3246-8528-b33d395e02ab",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "Schutzhülle um Pflanzensamen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d1f0163-4003-4b55-8849-a88d48e6c98f",
                                                "sense_id": "2a0c2708-0112-3246-8528-b33d395e02ab",
                                                "text": "Früchte mit Kapseln gehören zu den Streufrüchten."
                                            },
                                            {
                                                "example_id": "31f85567-d326-4f1c-a518-07dc602a1892",
                                                "sense_id": "2a0c2708-0112-3246-8528-b33d395e02ab",
                                                "text": "„Das war mühselig, denn die Pflücker mussten von morgens bis abends in gebückter Haltung durch die Plantagen gehen und dabei die Faserbüschel aus den aufgesprungenen, reifen Kapseln zupfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "934e98ba-7784-3eef-8528-e04243612d5f",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "Darreichungsform für Medikamente"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acb79a25-4052-4214-a978-829df01a3e48",
                                                "sense_id": "934e98ba-7784-3eef-8528-e04243612d5f",
                                                "text": "Sie nimmt drei Kapseln am Tag ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "b42bdb68-ec05-34f7-a2d9-cd61b6f007f1",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "Raumflugkörper zur Personen- und Frachtbeförderung"
                                        ],
                                        "tags": [
                                            "Weltraumtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0b48bbf4-0144-4225-af92-2fbb743130f9",
                                                "sense_id": "b42bdb68-ec05-34f7-a2d9-cd61b6f007f1",
                                                "text": "In einer Kapsel flogen sie durch den Weltraum."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "0bd097e7-84b4-3a40-b40f-3b3a05368411",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "bindegewebige Hülle um ein Gelenk"
                                        ],
                                        "tags": [
                                            "Physiologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0259745-bcbe-4754-aba3-368574ba2df9",
                                                "sense_id": "0bd097e7-84b4-3a40-b40f-3b3a05368411",
                                                "text": "All echten Gelenke sind von einer Kapsel umschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "ea3e0c47-b37c-322b-8e32-6227bf45da26",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "Schleimschicht bei Bakterien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3662df9-f847-4b43-8f5b-98b8af0f05d9",
                                                "sense_id": "ea3e0c47-b37c-322b-8e32-6227bf45da26",
                                                "text": "Die Dicke der Kapseln kann variieren und sie kann bei grampositiven wie gramnegativen Bakterien vorkommen."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4b96287a-4897-3d18-995d-617586a5b57f",
                                        "entry_id": "2ab03095-2898-39bf-b00b-25cf7e91d3f2",
                                        "glosses": [
                                            "Verschlussart einer Flasche"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b413d89-a441-44b0-ac15-68b30a0f1579",
                                                "sense_id": "4b96287a-4897-3d18-995d-617586a5b57f",
                                                "text": "Die Flasche ist mit einer Kapsel verschlossen."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
