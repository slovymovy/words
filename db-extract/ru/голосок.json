                ],
                "senses": [
                    {
                        "sense_id": "42da37e7-2c43-36b5-8946-f75c3487f7cd",
                        "entry_id": "5d4a3c76-465d-38e5-ba28-295cedb5a653",
                        "glosses": [
                            "ласк. к голос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4301ec56-6f07-41fc-803a-e21714a724c7",
                                "sense_id": "42da37e7-2c43-36b5-8946-f75c3487f7cd",
                                "text": "Раздайсь, голосок, // По́ бору сырому! // Ох, донесись, голосок, // К моёму дорогому!"
                            },
                            {
                                "example_id": "94e1d915-2b1d-4254-840e-afdc6878c7ec",
                                "sense_id": "42da37e7-2c43-36b5-8946-f75c3487f7cd",
                                "text": "Невесёлая неделюшка, — // Не вижу я дружка! // Не играет во тальяночку, // Не слышно голоска!"
                            },
                            {
                                "example_id": "418637f9-ff9e-474f-b1bf-223b379cdfb0",
                                "sense_id": "42da37e7-2c43-36b5-8946-f75c3487f7cd",
                                "text": "Говорила голоску: // «Раздайся, голос, по леску, // Чтобы милого-красивого // Ударило в тоску!»"
                            }
                        ]
                    },
                    {
                        "sense_id": "003e5df5-4b5c-3d12-92dc-c6887e8df190",
                        "entry_id": "5d4a3c76-465d-38e5-ba28-295cedb5a653",
                        "glosses": [
                            "уменьш. к голос; тихий, слабый голос"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c9bebec5-601d-42bf-b085-01f88a93a99e",
                                "sense_id": "003e5df5-4b5c-3d12-92dc-c6887e8df190",
                                "text": "Голосок у неё был тоненький-тоненький, слабый-слабый: как у прищемлённой птички."
                            }
                        ]
                    }
                ],
