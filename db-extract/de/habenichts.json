                ],
                "senses": [
                    {
                        "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                        "entry_id": "2eafc65f-37ef-34c6-af70-90cf83e59924",
                        "glosses": [
                            "jemand, der nichts hat/besitzt oder arm ist"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "def659b8-b23d-43a3-9ace-66b936bf3ac4",
                                "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                                "text": "Nicht alle Diebinnen sind Habenichtse."
                            },
                            {
                                "example_id": "5b6866cc-727e-4b5e-b786-21e60d03e266",
                                "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                                "text": "„Was Christa Petrásková meint, ist auch aus anderen Quellen zu erfahren: Sie waren größtenteils Habenichtse.“"
                            },
                            {
                                "example_id": "fb0f649b-e769-4f1d-bf00-64445cd2d5a1",
                                "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                                "text": "„Freilich würde ich dabei ein doppeltes Risiko eingehen: ungeachtet all seiner Vorzüge ist er doch nur ein hergelaufener Fremdling und Habenichts; wenn ich so einen in meinen Haushalt aufnehme, was bietet Gewähr, daß er mich nicht eines Tages bestiehlt und sich dann heimlich davonmacht?“"
                            },
                            {
                                "example_id": "a0245c3b-99b6-41dd-b800-0611bcaa09e3",
                                "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                                "text": "„Beim Souper dankte mir die Pelerinenträgerin dafür, daß ich sie von diesem Habenichts befreit hatte, der sie belästigte und immer mit den Worten erschreckte, er werde sich umbringen.“"
                            },
                            {
                                "example_id": "c32d50fe-99b1-419b-bdb8-2e54646b8cf7",
                                "sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                                "text": "„Indiens Ablehnung des Atomsperrvertrags, der die Hegemonie der Nuklearmächte festschreibt und die nuklearen Habenichtse auf die Dauer zu Staaten zweiter Klasse degradiert, entsprach ebenfalls seinem Anspruch auf eine solche Weltgeltung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dae73667-4e70-4675-9d13-87d92a55b69b",
                        "source_entry_id": "2eafc65f-37ef-34c6-af70-90cf83e59924",
                        "source_sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der nichts hat/besitzt oder arm ist",
                        "target_lang_word": "have-not",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "have-not",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "608e2949-95e8-3111-b499-8e602cdfede9",
                                        "entry_id": "d0e35726-7c29-3130-9f2b-e4501924a8bd",
                                        "glosses": [
                                            "A poor or underprivileged person."
                                        ],
                                        "tags": [
                                            "contrastive",
                                            "idiomatic",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf9fee33-c2af-44b4-bdf6-dc4dcd78548a",
                                                "sense_id": "608e2949-95e8-3111-b499-8e602cdfede9",
                                                "text": "A longtime advocate for racial and social justice with a degree from Virginia Commonwealth University, Walker, 40, got into politics at the urging of Edwards, an African American woman widely praised as a bridge-builder between the city’s haves and have-nots."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ffbd26-7921-3066-a6a5-09da75444386",
                                        "entry_id": "d0e35726-7c29-3130-9f2b-e4501924a8bd",
                                        "glosses": [
                                            "One who does not have some (contextually specified) thing."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "uncommon"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb6906db-e6bb-4dd1-9698-923f60b1418e",
                        "source_entry_id": "2eafc65f-37ef-34c6-af70-90cf83e59924",
                        "source_sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der nichts hat/besitzt oder arm ist",
                        "target_lang_word": "va-nu-pieds",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "va-nu-pieds",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                        "entry_id": "5894790b-929d-3016-8dc8-7bed56ee695a",
                                        "glosses": [
                                            "Vagabond, misérable."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5098794e-e33c-48f7-987d-fffd9f80494f",
                                                "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                                "text": "Un groupe d’enfants, de ces petits sauvages va-nu-pieds qui ont de tout temps battu le pavé de Paris sous le nom éternel de gamins… accourait vers le carrefour où gisait Gringoire."
                                            },
                                            {
                                                "example_id": "b1d883d2-7345-4fca-b7a8-9e7032936187",
                                                "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                                "text": "Ce lieu m’est signalé comme l’antre de l’anarchie, fréquenté par les plus effrontés jacobins de Nancy. Vous n’avez pas eu honte de vous lier avec les va-nu-pieds qui s’y donnent rendez-vous chaque soir."
                                            },
                                            {
                                                "example_id": "967298ff-6c2c-4e99-a7be-ee2c98d63c6b",
                                                "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                                "text": "Il fallait peut-être les fourrer dans du coton et leur donner de l’argent, par-dessus le marché, à ces va-nu-pieds dont l’entêtement de bêtes féroces prolongeait la guerre !"
                                            },
                                            {
                                                "example_id": "af6fb879-3888-448f-ac34-ff05775753dc",
                                                "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                                "text": "Et les pauvres, les faibles, les va-nu-pieds, tous ceux qui n’ont pas de voix ?"
                                            },
                                            {
                                                "example_id": "64ff3f74-d49b-45f3-9bc9-b8f746005f92",
                                                "sense_id": "e0e86748-7d46-3eb6-ac03-f0248f34413b",
                                                "text": "Les canons et les fusils, les torpilleurs et les cuirassés, la poudre et la dynamite, la fumée et le massacre emportent des milliards, des sommes plus que suffisantes à nourrir tout ce que l’Europe compte de faméliques et de va-nu-pieds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6c1e2134-8b63-4348-81c9-6c02a9c13c3c",
                        "source_entry_id": "2eafc65f-37ef-34c6-af70-90cf83e59924",
                        "source_sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der nichts hat/besitzt oder arm ist",
                        "target_lang_word": "sans-le-sou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sans-le-sou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e47e732b-1a45-32c6-9ffc-c992ece35b07",
                                        "entry_id": "53c4ddf6-b593-3f6b-89ca-53044d6be64c",
                                        "glosses": [
                                            "Personne désargentée, très pauvre, mendiant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dd6878a-f4f8-4f2d-89ff-d7b3c587a504",
                                                "sense_id": "e47e732b-1a45-32c6-9ffc-c992ece35b07",
                                                "text": "C’est un, une sans-le-sou."
                                            },
                                            {
                                                "example_id": "d355beef-d533-40a5-b4db-99587806b62d",
                                                "sense_id": "e47e732b-1a45-32c6-9ffc-c992ece35b07",
                                                "text": "Le bouquin va de l’avant, le môme a vraiment du sang, et l’on trinque à sa santé dans les cafés du boulevard et les mansardes du Quartier latin. Les sans-le-sou ont reconnu un des leurs, les bohèmes ont vu le gouffre, j’ai sauvé de la fainéantise ou du bagne un tas de garçons qui y couraient, par le sentier que Murger a bordé de lilas !"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "42dc7eea-bc7e-47de-9634-c1f9f63aeb23",
                        "source_entry_id": "2eafc65f-37ef-34c6-af70-90cf83e59924",
                        "source_sense_id": "b91a7160-c699-3ced-b840-3765cee728ba",
                        "source_sense_description": "umgangssprachlich, meist abwertend: jemand, der nichts hat/besitzt oder arm ist",
                        "target_lang_word": "нищеброд",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нищеброд",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "0daf17d8-81b8-3eb3-98d9-8437f3357a2f",
                                        "entry_id": "72331d75-d4f7-3cac-b56e-4db2d1bf8458",
                                        "glosses": [
                                            "устар., прост. притворный попрошайка; нищий, бродяга"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbe9dbb9-f695-4eac-8f11-550ccb206e8d",
                                                "sense_id": "0daf17d8-81b8-3eb3-98d9-8437f3357a2f",
                                                "text": "На одинаких весках с последним нищебродом знаменитейших в свете царей неумолимая судьба подвергает естественным сокрушениям."
                                            },
                                            {
                                                "example_id": "a4e8eb43-aff4-46f4-bd30-fd52ffba6a0a",
                                                "sense_id": "0daf17d8-81b8-3eb3-98d9-8437f3357a2f",
                                                "text": "Подымая тучи пыли, гнали лошадёнок пьяные мужики, возвращавшиеся с ярмарки, — рыжие, сивые, чёрные, но все одинаково безобразные, тощие и лохматые. И, обгоняя их гремящие телеги, Тихон Ильич мотал головой: — У, нищеброды, пропади вы пропадом!"
                                            },
                                            {
                                                "example_id": "fb6bc27f-1b21-4dbc-afe2-13b119ec295f",
                                                "sense_id": "0daf17d8-81b8-3eb3-98d9-8437f3357a2f",
                                                "text": "В школе мне снова стало трудно, ученики высмеивали меня, называя ветошником, нищебродом, а однажды, после ссоры, заявили учителю, что от меня пахнет помойной ямой и нельзя сидеть рядом со мной."
                                            }
                                        ]
                                    },
                                    {
