        "ru-extract.jsonl": [
            {
                "entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                "word": "неожиданно",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c14ee1c2-645b-310d-a39d-7939eede18ee",
                        "entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "glosses": [
                            "наречие к неожиданный; быстро и внезапно"
                        ],
                        "tags": [
                            "adverb"
                        ],
                        "examples": [
                            {
                                "example_id": "402d3620-a133-4c71-8da4-209943cea240",
                                "sense_id": "c14ee1c2-645b-310d-a39d-7939eede18ee",
                                "text": "С ним случилось в эту минуту то, что случается с людьми, когда они неожиданно уличены в чем-нибудь слишком постыдном."
                            },
                            {
                                "example_id": "c0b18fa2-a23a-4523-b7bf-93f81eac0901",
                                "sense_id": "c14ee1c2-645b-310d-a39d-7939eede18ee",
                                "text": "Неожиданно Петровский делает досадливый жест рукой и хмурится."
                            }
                        ]
                    },
                    {
                        "sense_id": "0bbd2f09-c369-3c11-80b3-b8ec6b01a258",
                        "entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "glosses": [
                            "вопреки чьим-либо ожиданиям, представлениям"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "89776c14-c41d-38e0-957d-692be621a65a",
                        "entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "glosses": [
                            "противоречит чьим-либо ожиданиям, представлениям"
                        ],
                        "tags": [
                            "в знач. сказуемого"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a8fe66f0-0591-4a81-afbd-fbecc981c355",
                        "source_entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "source_sense_description": "быстро и внезапно",
                        "target_lang_word": "unexpectedly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unexpectedly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                        "entry_id": "72175067-63da-3c54-a05e-1de7d45e321c",
                                        "glosses": [
                                            "In an unexpected manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d095c36-5026-4cd2-83af-63c47a289fd5",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Near-synonyms: against expectations, against all odds, surprisingly"
                                            },
                                            {
                                                "example_id": "8cf6fecf-97a8-4b26-8697-bff936162838",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "[…] she was startled by unexpectedly meeting her husband, who was coming to seek her."
                                            },
                                            {
                                                "example_id": "38b175cb-f4be-4ff2-8de1-b1e407b3dc97",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Other evidence of former ownerships such as notice-boards, number plates, and makers' plates, are often discovered unexpectedly."
                                            },
                                            {
                                                "example_id": "4ac4a871-d192-4892-ad79-18cc1f480fce",
                                                "sense_id": "be8c60b4-f273-3307-9237-f464721bd60f",
                                                "text": "Texas House Democrats’ historic quorum break unexpectedly ended Thursday evening when at least three new Democrats returned to the floor, paving the way for state Republicans to pass restrictive voting legislation."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "45de69e8-b0b5-47cd-8e79-9d8eaccd3924",
                        "source_entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "source_sense_description": "быстро и внезапно",
                        "target_lang_word": "suddenly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suddenly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                        "entry_id": "b4602e66-3e9c-3a64-b1ba-c57b0f38c649",
                                        "glosses": [
                                            "Happening quickly and with little or no warning; in a sudden manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e6e4ae1-a56b-4ffc-ad0e-daf126075dae",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "Suddenly, the heavens opened and we all got drenched."
                                            },
                                            {
                                                "example_id": "4b0aeef6-4f88-446a-9597-009ef96f1f4e",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "They've suddenly decided to sell the house."
                                            },
                                            {
                                                "example_id": "3063b5d4-74b7-4262-8a9e-66623a1457a3",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "The king before he would take his voyage, sent the Erle of Huntyngdon to ſerche and ſcowre the Seas, leaſt any Frenchmen lyeng in wayte for him might attrap him sodeinly, or he had any knowledge of their ſetting forward."
                                            },
                                            {
                                                "example_id": "f0e96555-43e8-4e9d-bdbf-8a130168d0d6",
                                                "sense_id": "381904d2-a0fa-3869-80f8-713229bcd1f1",
                                                "text": "But ever since the concept of \"hamartia\" recurred through Aristotle's Poetics, in an attempt to describe man's ingrained iniquity, our impulse has been to identify a telling defect in those brought suddenly and dramatically low."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "57d297ed-82a2-461f-9522-c63d46c49db6",
                        "source_entry_id": "0d208a51-5fa9-3f27-9a38-95fbba62cacd",
                        "source_sense_description": "быстро и внезапно",
