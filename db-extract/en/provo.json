                        ],
                        "examples": [
                            {
                                "example_id": "eaef3d85-686c-45c4-84af-bb118c9b7ce9",
                                "sense_id": "a4fd699f-f7d6-35ac-b167-44e6c9507cda",
                                "text": "Still, Daniel Cohn-Bendit has commented that without the example provided by the Dutch Provos to the young of other countries, Europe would have been a very different place in 1968."
                            },
                            {
                                "example_id": "e2cea448-45b7-4146-83e6-3f088d33ed19",
                                "sense_id": "a4fd699f-f7d6-35ac-b167-44e6c9507cda",
                                "text": "‘Dude, we want to make a revolution!’ protested one German Provo."
                            }
                        ]
                    }
                ],
