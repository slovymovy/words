                ],
                "senses": [
                    {
                        "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                        "entry_id": "df873769-7c1e-3af3-94dd-cd58b202514e",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c47cdaff-9883-4559-bb5c-28add2f63169",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Frau Gieger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a13f473f-c14a-4939-b080-70707401c517",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Herr Gieger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "ff2fb0ab-2927-408c-a84d-f276ebe91131",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Die Giegers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3a0b051d-6c7c-4dba-8961-958650155ce8",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Der Gieger trägt nie die Schals, die die Gieger ihm strickt."
                            },
                            {
                                "example_id": "8c9480f8-ea14-487e-a756-99406ec98487",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Gieger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "f28c96b8-31b0-4d89-ae33-03fafc7aacad",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Gieger kommt und geht."
                            },
                            {
                                "example_id": "9effc27e-223e-48d7-b4d3-8fa5a62d0a0c",
                                "sense_id": "d50f40a0-8c34-3ad6-b357-c7294b0d5666",
                                "text": "Giegers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
