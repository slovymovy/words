                        "sense_id": "89e64ebd-dd72-3486-b600-9bec9b938d5a",
                        "entry_id": "2da442ba-f493-3714-a643-943ad622afcc",
                        "glosses": [
                            "een door de landelijke overheid erkende titel voor een kaas die aan bepaalde kwaliteitseisen voldoet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ef2523f-76d8-4a54-8e7b-15e4b9ccd9ce",
                                "sense_id": "89e64ebd-dd72-3486-b600-9bec9b938d5a",
                                "text": "Verweij maakt kaas volgens het kwaliteitszorgsysteem KB (Kwaliteitszorg Boerderijzuivel) en al zijn kazen dragen het KB-keurmerk. Dit merk waarborgt de traceerbaarheid van het product in het kader van de voedselveiligheid. Elk merk heeft een uniek nummer: zo is van elke kaas de maker gemakkelijk te achterhalen. Verder draagt kaas van Verweij het rijksmerk voor Boerenkaas."
                            },
                            {
                                "example_id": "afa82689-744e-4e1f-9da6-82ba272ba307",
                                "sense_id": "89e64ebd-dd72-3486-b600-9bec9b938d5a",
                                "text": "Wél kenmerkend was het vetgehalte van minstens 48+ (in werkelijkheid rond de 51+). Was, want sinds de versoepeling van een aantal regels is die beperking tot 48 procent vervallen, net als de minimale rijpingstermijn en de rijksmerken."
                            }
                        ]
                    }
