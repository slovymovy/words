                            }
                        },
                        {
                            "text": "The board of directors decided to <w>authorize</w> a search for a new CEO.",
                            "target_lang_translations": {
                                "ru": "Совет директоров решил <w>санкционировать</w> поиск нового генерального директора."
                            }
                        },
                        {
                            "text": "Only a senior officer can <w>authorize</w> access to these confidential files.",
                            "target_lang_translations": {
                                "ru": "Только старший офицер может <w>разрешить</w> доступ к этим конфиденциальным файлам."
                            }
                        }
                    ],
                    "synonyms": [
