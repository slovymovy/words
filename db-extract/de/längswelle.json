                "senses": [
                    {
                        "sense_id": "b8f7dc29-a11a-3cf9-a9e8-9718a550ac36",
                        "entry_id": "77ba6160-57db-3f7d-968f-f15fc3b0d932",
                        "glosses": [
                            "Welle, bei der die Schwinger (zum Beispiel Moleküle) in dieselbe Richtung schwingen, wie sich die Welle ausbreitet"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fd0cf5dd-5ad5-38ba-9efa-a0a11340fc51",
                        "entry_id": "77ba6160-57db-3f7d-968f-f15fc3b0d932",
                        "glosses": [
                            "Antriebswelle in Fahrzeugen, bei denen sich der Motor am anderen Ende des Fahrzeugs als die Antriebsräder befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "090ea37a-bee9-4f38-9423-455c082f518a",
                                "sense_id": "fd0cf5dd-5ad5-38ba-9efa-a0a11340fc51",
                                "text": "Bei einigen Allradfahrzeugen dienen eine Längswelle zum Antrieb der Hinterachse wie beim Heckantrieb und eine zweite Längswelle zum Antrieb der Vorderachse. In diesem Fall verläuft die zweite Längswelle vom Verteilergetriebe zur Vorderachse."
                            },
                            {
                                "example_id": "9042d4cd-18db-4e20-b249-6dbcfd897181",
                                "sense_id": "fd0cf5dd-5ad5-38ba-9efa-a0a11340fc51",
                                "text": "Bei den heutigen Kraftfahrzeugen sind die Längswellen meist mit zwei oder drei Gelenken ausgeführt."
                            },
                            {
                                "example_id": "27d3ce95-8b46-4a1e-a7f1-1d57b8b53433",
                                "sense_id": "fd0cf5dd-5ad5-38ba-9efa-a0a11340fc51",
                                "text": "Die Motor-Getriebe-Einheit soll mit dem Achsgetriebe möglichst stabil, gleichförmig und schwingungsfrei verbunden werden. Wurde dies früher über \"Kardanwellen\" und Kardangelenke mit gewissen Nachteilen bewerkstelligt, erfolgt dies bei GKN über Längswellen mit Gleichlauf- oder CV-Gelenken (Constant velocity)."
                            },
                            {
                                "example_id": "3278a273-04cc-42ee-91cf-e27aa7862a46",
                                "sense_id": "fd0cf5dd-5ad5-38ba-9efa-a0a11340fc51",
                                "text": "Aufgrund des höheren Antriebsmoments wird die Längswelle des 405 T16 am Verteilergetriebe und am Hinterachsgetriebe jeweils durch vier Schrauben Ø 10mm befestigt (bei der Version SR x4 Ø 8mm)."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
