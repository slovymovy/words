                "translations": [
                    {
                        "translation_id": "63187bfc-a072-4d48-a570-9d6d7ff694ed",
                        "source_entry_id": "296ece39-90ff-35a5-a7ec-aee2d602bb99",
                        "source_sense_id": "72abb4fb-2009-3e2d-831c-f55dcc00ba8a",
                        "source_sense_description": "aan die zijde van het lichaam waar gewoonlijk het hart zit",
