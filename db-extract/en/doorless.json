                                        "glosses": [
                                            "ohne Tür, keine Tür habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c001ccbf-8a54-4add-9ea1-8f96a918cc3d",
                                                "sense_id": "18752be7-2eac-3e53-a107-5af1523bff18",
                                                "text": "„Als wir wenig später durch einen langen, niedrigen, türlosen und relieffreien Gang steil in die Tiefe stiegen, waren wir sicher, uns endlich dem Tunneleingang zu nähern.“"
                                            },
                                            {
                                                "example_id": "76a38c12-15f1-42a2-b299-febe86336726",
                                                "sense_id": "18752be7-2eac-3e53-a107-5af1523bff18",
                                                "text": "„An einer Seite des Hauptraumes konnten wir in eine türlose Küche blicken, die, obwohl sie im Dunkeln lag, einen noch stärker verwahrlosten Eindruck machte als der Tisch.“"
                                            },
                                            {
                                                "example_id": "cc3829e5-9540-4d4c-a03c-ffd8acb078f1",
                                                "sense_id": "18752be7-2eac-3e53-a107-5af1523bff18",
                                                "text": "„Er warf die Matratze in den Hof und ging wieder hinein. In der Küche ein türloser Holzofen, vorn auf zwei Ziegel gestützt, zum Ausgleich des abschüssigen Fußbodens.“"
                                            }
                                        ],
