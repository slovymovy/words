                        "entry_id": "d76f5a08-7fef-3235-8b95-a15fa15fc01a",
                        "glosses": [
                            "verkleinwoord meervoud van het zelfstandig naamwoord zilvervis"
                        ],
                        "tags": [
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "05ba8c89-0b61-4483-a604-689912c01d49",
                                "sense_id": "838a1b7b-da71-3050-b28d-23884402d466",
                                "text": "“Enkele voor mij spirituele momenten zal ik nooit vergeten. Bijvoorbeeld de ochtend dat ik – voorafgaand aan een duik in zee – de natuur bewonderde in al zijn schoonheid. Op het moment dat ik ten volle besefte hoe waardevol dat voor me is, sprongen honderden zilvervisjes tegelijk uit het water. Beschenen door de ochtendzon gaf dat een magische glittering. (…)”"
                            }
                        ]
                    }
