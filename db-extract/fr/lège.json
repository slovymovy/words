                ],
                "senses": [
                    {
                        "sense_id": "5091b853-aca1-375f-a6b8-0f59ef2b17c7",
                        "entry_id": "d5ed21fb-6846-32ad-9257-3633c96061eb",
                        "glosses": [
                            "Qualifie un bâtiment qui est vide ou n’a pas son chargement complet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac3eea6-12f0-4f8b-8560-deefa2ac979f",
                                "sense_id": "5091b853-aca1-375f-a6b8-0f59ef2b17c7",
                                "text": "Dans les trois écluses de Gatun, nous sommes derrière le Cosmic Fortune, un cargo lège. Les hélices à fleur d'eau, il embraye, met toute la sauce et produit une vague d'un mètre créant un courant pas possible."
                            },
                            {
                                "example_id": "e04a2fb7-5787-4924-8b07-cd6e78136ad4",
                                "sense_id": "5091b853-aca1-375f-a6b8-0f59ef2b17c7",
                                "text": "Des années de métier avaient fait de lui cette âme sceptique mais compatissante qui battait présentement la semelle du côté du terminal à grain de la jetée 86 pour surveiller, à une distance qui lui semblait sûre, son client – […] – qui se tenait au pied d'un porte-conteneurs lège en provenance de Chine jusqu'au moment où le colis lui chut dans les bras d'une hauteur de quatre étages."
                            },
                            {
                                "example_id": "b2fe7be3-7652-4342-8436-6ebb80be9e07",
                                "sense_id": "5091b853-aca1-375f-a6b8-0f59ef2b17c7",
                                "text": "Les tortues marines portent des balises de géolocalisation, mais ce déchet de 77 mètres de long et de 700 tonnes de poids lège, qui peut à tout moment entrer en collision avec un navire de commerce ou de pêche, et provoquer un naufrage et des pertes humaines, passe sous les radars."
                            }
                        ]
                    },
                    {
                        "sense_id": "7a56dcd5-be2d-3248-854b-5d058c104742",
                        "entry_id": "d5ed21fb-6846-32ad-9257-3633c96061eb",
                        "glosses": [
                            "Qui est vide ou qui porte peu de chose."
                        ],
                        "tags": [
                            "Acadie",
                            "Gaspésie"
                        ],
                        "examples": [
                            {
                                "example_id": "4dc4aa76-6504-4abd-903c-8bd2f58c5d81",
                                "sense_id": "7a56dcd5-be2d-3248-854b-5d058c104742",
                                "text": "J’y vais à lège."
                            }
                        ]
                    },
                    {
                        "sense_id": "8632735b-ec1a-3198-ad3b-0b27f53eecd3",
                        "entry_id": "d5ed21fb-6846-32ad-9257-3633c96061eb",
                        "glosses": [
