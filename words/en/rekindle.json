    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1cf84ecc-9612-36bb-b725-0f159321e163",
                    "sense_definition": "To revive or restore a feeling, interest, relationship, or activity after a period of absence or neglect.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "revive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The weekend trip helped the couple <w>rekindle</w> their relationship."
                        },
                        {
                            "text": "She took painting classes to <w>rekindle</w> her interest in the arts."
                        }
                    ],
                    "common_phrases": [
                        "rekindle an interest",
                        "rekindle memories",
                        "rekindle old friendships",
                        "rekindle romance"
                    ]
                },
                {
                    "sense_id": "0c20bcf9-c78f-3c34-b742-878903181ef9",
                    "sense_definition": "To start a fire again or cause it to start burning anew.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ignite_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He blew gently on the glowing embers to <w>rekindle</w> the dying campfire."
                        },
                        {
                            "text": "Fresh dry twigs were added to <w>rekindle</w> the flame in the fireplace."
                        }
                    ],
                    "common_phrases": [
                        "rekindle a fire",
                        "rekindle the flames"
                    ]
                },
                {
                    "sense_id": "a9e45e2f-d45f-328f-8b3f-951ac1ba1c78",
                    "sense_definition": "To catch fire or ignite again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ignite_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The firefighters feared that the smoldering ruins might <w>rekindle</w> overnight."
                        },
                        {
                            "text": "With the sudden gust of wind, the ashes began to <w>rekindle</w>."
                        }
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3d61cdea-ee4d-3d44-8844-87224a6fcfb7",
                    "sense_definition": "An instance of catching fire again or flaring up anew.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ignite_again",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crew monitored the charred site carefully to prevent any sudden <w>rekindle</w>."
                        },
                        {
                            "text": "A brief <w>rekindle</w> of the brush fire forced nearby residents to evacuate once more."
                        }
                    ],
                    "synonyms": [
                        "reflash"
                    ]
                }
            ]
        }
    ]
