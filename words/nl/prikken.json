                        {
                            "text": "Deze nieuwe wollen trui <w>prikt</w> verschrikkelijk op mijn huid.",
                            "target_lang_translations": {
                                "en": "This new wool sweater <w>itches</w> terribly on my skin.",
                                "ru": "Этот новый шерстяной свитер ужасно <w>колется</w>.",
                                "pl": "Ten nowy wełniany sweter strasznie <w>gryzie</w> mnie w skórę.",
                                "de": "Dieser neue Wollpullover <w>kratzt</w> schrecklich auf meiner Haut.",
                                "fr": "Ce nouveau pull en laine me <w>gratte</w> terriblement sur la peau.",
                                "it": "Questo nuovo maglione di lana <w>punge</w> terribilmente sulla pelle.",
                                "cs": "Tento nový vlněný svetr mě strašně <w>kouše</w> na kůži.",
                                "tr": "Bu yeni yün kazak tenime müthiş <w>batıyor</w>.",
                                "es": "Este jersey de lana nuevo me <w>pica</w> muchísimo en la piel."
                            }
