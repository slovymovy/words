                            {
                                "example_id": "355d445a-9e2f-4b99-b302-8156569e2d5a",
                                "sense_id": "01b328bc-358a-3f9f-8526-d4f28d99e401",
                                "text": "Щиплет травку белый бяшка / И играет у ручья…"
                            },
                            {
                                "example_id": "cf61c6fc-01ba-422a-a254-6190705f42cf",
                                "sense_id": "01b328bc-358a-3f9f-8526-d4f28d99e401",
                                "text": "Когда Никита протянул к нему руку и позвал: «Бяшка», — козёл бешено топнул копытцем."
                            }
                        ]
                    }
