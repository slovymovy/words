                        "glosses": [
                            "Tueur, personne qui flingue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8853ce1-8b35-4026-a136-8c9be111788b",
                                "sense_id": "0eaebd95-a7d4-3946-8666-7e2517e0244b",
                                "text": "Promis à une mort certaine si j’arrive comme ça devant les Teutons flingueurs… devant leurs mitrailleuses, leurs mausers à lunette…"
                            },
                            {
                                "example_id": "1bda6abd-a577-40d1-a3d6-2813ac427db2",
                                "sense_id": "0eaebd95-a7d4-3946-8666-7e2517e0244b",
                                "text": "Je ne suis ni un tueur, ni un flingueur."
                            }
                        ]
                    },
                    {
                        "sense_id": "85514d89-8cc3-3d24-944a-28620e9f9c22",
