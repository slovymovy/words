{
    "word_family": [
        "встреча",
        "встречный",
        "встречаться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2f8b9188-bbeb-3193-b444-d49ce8df5851",
                    "sense_definition": "Увидеть кого-либо или что-либо при движении навстречу или в определенном месте.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "encounter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я <w>встретил</w> старого друга на улице.",
                            "target_lang_translations": {
                                "de": "Ich habe einen alten Freund auf der Straße <w>getroffen</w>."
                            }
                        },
                        {
                            "text": "По дороге домой мы <w>встретили</w> много людей.",
                            "target_lang_translations": {
                                "de": "Auf dem Heimweg sind wir vielen Menschen <w>begegnet</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "сретить"
                    ],
                    "common_phrases": [
                        "встретить друга",
                        "встретить человека"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemandem zufällig oder geplant begegnen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "treffen",
                                "target_lang_sense_clarification": "jemandem begegnen"
                            },
                            {
                                "target_lang_word": "begegnen",
                                "target_lang_sense_clarification": "jemandem zufällig über den Weg laufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d67a8ca0-7e57-3eff-b102-ef15b66527c9",
                    "sense_definition": "Прийти в место прибытия кого-либо, чтобы поприветствовать или забрать его.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "welcome",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы поехали в аэропорт, чтобы <w>встретить</w> родителей.",
                            "target_lang_translations": {
                                "de": "Wir sind zum Flughafen gefahren, um meine Eltern <w>abzuholen</w>."
                            }
                        },
                        {
                            "text": "Кто будет <w>встречать</w> гостей на вокзале?",
                            "target_lang_translations": {
                                "de": "Wer wird die Gäste am Bahnhof <w>empfangen</w>?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить гостей",
                        "встретить делегацию"
                    ],
                    "target_lang_definitions": {
                        "de": "An einen Ort gehen, um jemanden bei der Ankunft in Empfang zu nehmen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "abholen",
                                "target_lang_sense_clarification": "jemanden von einem Ort (z.B. Bahnhof) mitnehmen"
                            },
                            {
                                "target_lang_word": "empfangen",
                                "target_lang_sense_clarification": "jemanden offiziell oder förmlich begrüßen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7ff62e0-dc61-386e-8f89-7713b64e5db8",
                    "sense_definition": "Отпраздновать или провести начало какого-либо события или даты.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "celebrate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили <w>встретить</w> Новый год в горах.",
                            "target_lang_translations": {
                                "de": "Wir haben beschlossen, das neue Jahr in den Bergen zu <w>feiern</w>."
                            }
                        },
                        {
                            "text": "Семья собралась, чтобы <w>встретить</w> праздник вместе.",
                            "target_lang_translations": {
                                "de": "Die Familie kam zusammen, um das Fest gemeinsam zu <w>verbringen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить праздник",
                        "встретить Новый год"
                    ],
                    "target_lang_definitions": {
                        "de": "Ein Ereignis oder einen Feiertag gemeinsam beginnen oder feiern."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "feiern",
                                "target_lang_sense_clarification": "ein Fest oder Ereignis begehen"
                            },
                            {
                                "target_lang_word": "verbringen",
                                "target_lang_sense_clarification": "Zeit an einem bestimmten Ort oder mit jemandem verbringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a138787-b264-372a-a1d2-941b207b74a7",
                    "sense_definition": "Отреагировать на что-либо определенным образом, выразить свое отношение.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "react",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Зрители <w>встретили</w> выступление бурными аплодисментами.",
                            "target_lang_translations": {
                                "de": "Das Publikum hat den Auftritt mit stürmischem Applaus <w>aufgenommen</w>."
                            }
                        },
                        {
                            "text": "Критики <w>встретили</w> новую книгу довольно холодно.",
                            "target_lang_translations": {
                                "de": "Die Kritiker haben das neue Buch ziemlich kühl <w>aufgenommen</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить аплодисментами",
                        "встретить критикой"
                    ],
                    "target_lang_definitions": {
                        "de": "Auf eine bestimmte Weise auf etwas reagieren oder eine Resonanz zeigen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "aufnehmen",
                                "target_lang_sense_clarification": "eine Reaktion auf etwas zeigen (z.B. positiv/negativ)"
                            },
                            {
                                "target_lang_word": "reagieren auf",
                                "target_lang_sense_clarification": "eine Antwort oder Haltung zu etwas ausdrücken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fac23506-7bd9-3e33-82a4-93dec709d8f1",
                    "sense_definition": "Познакомиться или начать близкие отношения с кем-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relationship",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он был счастлив, когда <w>встретил</w> свою будущую жену.",
                            "target_lang_translations": {
                                "de": "Er war glücklich, als er seine zukünftige Frau <w>kennengelernt</w> hat."
                            }
                        },
                        {
                            "text": "В жизни важно <w>встретить</w> человека, который тебя понимает.",
                            "target_lang_translations": {
                                "de": "Es ist wichtig im Leben, einen Menschen zu <w>treffen</w>, der einen versteht."
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить любовь"
                    ],
                    "target_lang_definitions": {
                        "de": "Jemanden kennenlernen, mit dem man eine Beziehung eingeht."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "kennenlernen",
                                "target_lang_sense_clarification": "den ersten Kontakt zu jemandem aufbauen"
                            },
                            {
                                "target_lang_word": "treffen",
                                "target_lang_sense_clarification": "sich mit jemandem verabreden oder zusammenkommen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62dcee0d-9b34-3fce-98d1-260031efafe9",
                    "sense_definition": "Дождаться наступления какого-либо момента времени.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Путешественники <w>встретили</w> рассвет на вершине горы.",
                            "target_lang_translations": {
                                "de": "Die Reisenden haben den Sonnenaufgang auf dem Berggipfel <w>erlebt</w>."
                            }
                        },
                        {
                            "text": "Мы <w>встретили</w> утро в тишине леса.",
                            "target_lang_translations": {
                                "de": "Wir haben den Morgen in der Stille des Waldes <w>erlebt</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить рассвет"
                    ],
                    "target_lang_definitions": {
                        "de": "Den Beginn eines Zeitabschnitts (wie den Morgen) erleben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erleben",
                                "target_lang_sense_clarification": "bei einem Ereignis oder Zeitpunkt anwesend sein"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb2dbcbf-48fa-3426-89a7-fa3a7e5e3381",
                    "sense_definition": "Получить в ответ или испытать на себе какое-либо отношение или действие.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "experience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он <w>встретил</w> полное непонимание со стороны коллег.",
                            "target_lang_translations": {
                                "de": "Er ist bei seinen Kollegen auf völliges Unverständnis <w>gestoßen</w>."
                            }
                        },
                        {
                            "text": "В этой стране туристы <w>встретили</w> очень теплый прием.",
                            "target_lang_translations": {
                                "de": "In diesem Land haben die Touristen einen sehr herzlichen Empfang <w>erfahren</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "встретить прием"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine bestimmte Behandlung oder Reaktion von anderen erfahren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "erfahren",
                                "target_lang_sense_clarification": "etwas erleben oder zu spüren bekommen"
                            },
                            {
                                "target_lang_word": "stoßen auf",
                                "target_lang_sense_clarification": "auf eine bestimmte Reaktion treffen"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}