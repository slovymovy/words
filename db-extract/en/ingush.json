                                            {
                                                "example_id": "7a5e9ee5-6e4b-4c82-9f5a-a4a92f37b5d9",
                                                "sense_id": "77e28403-7676-3c7e-b2b1-62b0249c182c",
                                                "text": "Sprechen Sie Inguschisch?"
                                            },
                                            {
                                                "example_id": "8dfc9ef3-16cd-4921-88bd-ab5ca7886bbc",
                                                "sense_id": "77e28403-7676-3c7e-b2b1-62b0249c182c",
                                                "text": "Wie heißt das auf Inguschisch?"
                                            },
                                            {
                                                "example_id": "79014f44-09d1-4d28-b188-42d185a162c6",
                                                "sense_id": "77e28403-7676-3c7e-b2b1-62b0249c182c",
                                                "text": "Wie kann ich mein Inguschisch verbessern?"
                                            },
                                            {
                                                "example_id": "92bf8d9e-91c8-472b-9062-4d609c8486b1",
                                                "sense_id": "77e28403-7676-3c7e-b2b1-62b0249c182c",
                                                "text": "Das Inguschische ist mit dem Tschetschenischen verwandt."
                                            },
                                            {
                                                "example_id": "337dc3b2-8a0f-4ea0-b216-0f6c0199fafc",
                                                "sense_id": "77e28403-7676-3c7e-b2b1-62b0249c182c",
                                                "text": "„»Gleiches gilt für das Wainachische, das verschiedene Formen aufweist, von denen die wichtigsten das Tschetschenische und Inguschische sind«.“"
                                            }
