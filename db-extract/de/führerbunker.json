                        "tags": [],
                        "examples": [
                            {
                                "example_id": "584a6798-ea8c-47fa-996d-def9369924c5",
                                "sense_id": "22b70e0f-6121-3747-afd0-0b43a0db116e",
                                "text": "Nachdem Hitler am 30. April 1945 im Berliner Führerbunker Selbstmord begangen hatte, kapitulierten zwei Tage später die deutschen Truppen der Stadt.",
                                "translation": "После того как 30 апреля 1945 года Гитлер покончил жизнь самоубийством в берлинском фюрербункере, немецкие войска города капитулировали через два дня."
                            }
                        ]
                    }
