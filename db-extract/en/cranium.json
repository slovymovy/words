{
    "word": "cranium",
    "lang_code": "en",
    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                "word": "cranium",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7c0759ef-5cce-42a2-a2d7-a563ede7fe0e",
                        "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                        "tags": [
                            "plural"
                        ],
                        "form": "craniums"
                    },
                    {
                        "form_id": "ee63f595-e146-4445-bb54-e9cb7e0d4139",
                        "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                        "tags": [
                            "plural"
                        ],
                        "form": "crania"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dc030412-c3ae-3ed9-afe6-f819b648d227",
                        "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                        "glosses": [
                            "That part of the skull consisting of the bones enclosing the brain, but not including the bones of the face or jaw."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ea2cdee7-0726-4fe3-bd49-8d51671165dd",
                                "sense_id": "dc030412-c3ae-3ed9-afe6-f819b648d227",
                                "text": "The Skull is divided into two parts, the Cranium and the Face. The Cranium is composed of eight bones; […]"
                            },
                            {
                                "example_id": "f72c7453-53cb-458b-b5ca-c9bf895a9df5",
                                "sense_id": "dc030412-c3ae-3ed9-afe6-f819b648d227",
                                "text": "‘I always ask leave, in the interests of science, to measure the crania of those going out there,’ he said."
                            },
                            {
                                "example_id": "9f6fd1c3-82fe-48af-8ed9-038c5faada84",
                                "sense_id": "dc030412-c3ae-3ed9-afe6-f819b648d227",
                                "text": "The cranium of the fowl is composed of the same elements as are present in the mammalian cranium, save that there is no interparietal."
                            },
                            {
                                "example_id": "867b7e1b-ce78-4866-b3c6-108440b58330",
                                "sense_id": "dc030412-c3ae-3ed9-afe6-f819b648d227",
                                "text": "The cranial bones, or cranium (kra′ne-um), enclose and protect the fragile brain and furnish attachment sites for head and neck muscles."
                            }
                        ]
                    },
                    {
                        "sense_id": "2dc6eadc-1c1d-31ec-b255-fc659b361df2",
                        "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                        "glosses": [
                            "The upper portion of the skull, including the neurocranium and facial bones, but not including the jawbone (mandible)."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "7fdeda34-89a4-4973-86f5-6583564e8541",
                                "sense_id": "2dc6eadc-1c1d-31ec-b255-fc659b361df2",
                                "text": "In this study, the cranium recovered from the River Witham in Lincoln exhibited a black metallic staining on the surfaces of the teeth."
                            }
                        ]
                    },
                    {
                        "sense_id": "d06c17d9-1c4b-3d89-866a-950de9adcb8d",
                        "entry_id": "44972163-b046-32f1-9cb7-f4fa34d6a10b",
                        "glosses": [
                            "Synonym of skull."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    }
                ],
