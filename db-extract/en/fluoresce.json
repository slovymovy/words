                        "translation_id": "a11312e3-c162-4486-b21a-9f51e65630c0",
                        "source_entry_id": "0681ccad-a53d-32ab-820d-fe79db367446",
                        "source_sense_description": "to emit light",
                        "target_lang_word": "fluoreszieren",
                        "target_lang_code": "de",
