                        "examples": [
                            {
                                "example_id": "95039528-f49e-4edd-85a0-f06617e77954",
                                "sense_id": "86f84568-7eee-35dd-8be6-6287a9a59ec1",
                                "text": "„Handy und Internet sind aus dem Leben von Jugendlichen nicht mehr wegzudenken: 97 Prozent der jungen Handynutzer in der Schweiz besitzen ein Smartphone.“"
                            },
                            {
                                "example_id": "b75ae594-18c0-4dff-92b5-d92c2faa3d7b",
                                "sense_id": "86f84568-7eee-35dd-8be6-6287a9a59ec1",
                                "text": "„Aus diesem Grunde führt die Kreispolizeibehörde Warendorf von 13. bis 20. Oktober eine Aktionswoche durch, in der verstärkt die Handynutzer unter den Verkehrsteilnehmern ins Visier genommen werden.“"
                            }
                        ],
