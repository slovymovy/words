                "translations": [
                    {
                        "translation_id": "e016db12-08ef-4d61-8838-47e60a57501e",
                        "source_entry_id": "95412e59-876b-30c1-be7f-a2d73a5670dd",
                        "source_sense_id": "a22ba7b0-f8da-38bf-86e3-bfa37e2d0a50",
