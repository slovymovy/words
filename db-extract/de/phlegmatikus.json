                        "examples": [
                            {
                                "example_id": "e8dad78c-79ab-4abf-9e29-8a878094429d",
                                "sense_id": "5fccccde-01bc-3344-9eca-9931abab9b32",
                                "text": "„Eselsgeschichte oder Der Schwachmatikus und seine vier Brüder, der Sanguinikus, Cholerikus, Melancholikus und Phlegmatikus nebst zwölf Vorstellungen vom Esel“"
                            }
                        ],
