                "senses": [
                    {
                        "sense_id": "f2dd2143-20ac-30e6-94d1-ee1d1e314907",
                        "entry_id": "a8db16f1-8195-3588-9a9c-9e35c4944ac4",
                        "glosses": [
                            "Langue parlée par le peuple Teko."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32a58b97-2f06-4c73-8729-10e3dea7c298",
                                "sense_id": "f2dd2143-20ac-30e6-94d1-ee1d1e314907",
                                "text": "Sept langues amérindiennes sont aujourd’hui parlées en Guyane : le kali’na, le lokono, le palikur, le teko, le wayampi, le wayana et l’apalaï."
                            }
                        ]
                    }
