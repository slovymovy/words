                        "glosses": [
                            "trichromatic (involving three colours)"
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "dd13deff-e659-45e2-804b-f15b20b70953",
                                "sense_id": "d3bf211a-03af-315a-8abe-4c5911ffd73f",
                                "text": "Like the Mumuye and Chamba examples they have a trichrome system of decoration in which red (ochre) and white (chalk) accents are set against an opaque and granular black (soot) background."
                            }
                        ]
                    },
                    {
                        "sense_id": "9486bc6b-14cb-377f-9f22-a8a39cd98cf7",
                        "entry_id": "6f35c52b-1593-32b7-84f8-db400599ef29",
                        "glosses": [
                            "Staining three different tissues three different colours."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "56ad346a-cf20-4684-b928-2ae08c0511ef",
                                "sense_id": "9486bc6b-14cb-377f-9f22-a8a39cd98cf7",
                                "text": "To summarize: it is possible to make reasonable predictions about the type of force to which connective tissues are subjected by examination of the morphological and biochemical features of[…]the histological staining reaction of the collagen fibers by the Masson trichrome stain[…]"
                            },
                            {
                                "example_id": "65611aa8-a204-42df-bcbc-32805ae2010f",
                                "sense_id": "9486bc6b-14cb-377f-9f22-a8a39cd98cf7",
                                "text": "Mitochondrial content was estimated based on visualization of the modified Gomori's trichrome stain."
                            }
                        ]
                    }
                ],
