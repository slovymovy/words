                    "frequency": "Middle",
                    "semantic_group_id": "mystere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La police cherche à éclaircir cette <w>ténébreuse</w> affaire de disparition inexpliquée."
                        },
                        {
                            "text": "Ses véritables motivations demeurent cachées derrière un dessein <w>ténébreux</w>."
                        }
                    ],
                    "synonyms": [
                        "énigmatique",
                        "mystérieux",
                        "obscur"
                    ],
                    "antonyms": [
                        "limpide",
                        "transparent"
