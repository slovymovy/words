                    {
                        "translation_id": "7cca4b04-b1c8-4b75-a0f9-9df008d49946",
                        "source_entry_id": "1ceb3cee-f979-302d-8628-bf12fa782fba",
                        "source_sense_description": "in warfare",
                        "target_lang_word": "вероло́мство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "вероло́мство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f75225dc-05e7-3eaa-a1ed-47b43d5946f8",
                                        "entry_id": "79f6f38b-5b0a-3493-98eb-a686c53d17bc",
                                        "glosses": [
                                            "свойство по значению прилагательного вероломный; вероломный характер поступка, действия, поведения; также склонность к предательству, нарушению клятв"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "21846d24-e8ee-407c-95ee-b53c6d06eeb8",
                                                "sense_id": "f75225dc-05e7-3eaa-a1ed-47b43d5946f8",
                                                "text": "Его хитрость, его вероломство были по-мужичьи просты."
                                            },
                                            {
                                                "example_id": "e30b39b4-6dd2-4bc4-babf-77bdd71bb8a2",
                                                "sense_id": "f75225dc-05e7-3eaa-a1ed-47b43d5946f8",
                                                "text": "По самоуверенности, глупости, ослиной тупости, копеечному вероломству, дикарской хитрости и ледяному охамлению он мировой уникум."
                                            },
                                            {
                                                "example_id": "54edc8ce-d2c5-4450-8861-385750c61dbb",
                                                "sense_id": "f75225dc-05e7-3eaa-a1ed-47b43d5946f8",
                                                "text": "Родительскую любовь предают, многолетнее побратимство… Человеческому вероломству Волкодав давно уже не удивлялся."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf631ea3-0ef9-3a07-acba-27f8013823db",
                                        "entry_id": "79f6f38b-5b0a-3493-98eb-a686c53d17bc",
                                        "glosses": [
                                            "вероломный поступок; нарушение клятвы, обязательств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6270bc9-932a-4c67-8aab-8a0bbd65d5cb",
                                                "sense_id": "cf631ea3-0ef9-3a07-acba-27f8013823db",
                                                "text": "Преемник Василия Димитриевича, Василий Васильевич, был человеком ограниченных дарований, слабого ума и слабой воли, но вместе с тем способный на всякие злодеяния и вероломства <…>."
                                            },
                                            {
                                                "example_id": "6775cd5c-7feb-4bbe-b66f-12c11c769510",
                                                "sense_id": "cf631ea3-0ef9-3a07-acba-27f8013823db",
                                                "text": "А между тем из всех наших предательств и вероломств по отношению к союзникам наше отношение к Румынии должно особенно ранить сколько-нибудь чуткую совесть."
                                            },
                                            {
                                                "example_id": "4d37942c-a9fb-492d-83f1-7e391e416d13",
                                                "sense_id": "cf631ea3-0ef9-3a07-acba-27f8013823db",
                                                "text": "<…> Франция, устрашённая ростом прусского военного могущества и оскорблённая вероломством своего бывшего союзника Фридриха, переметнувшегося на сторону Англии, объявила себя защитницей Австрии."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
