                ],
                "senses": [
                    {
                        "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                        "entry_id": "7c4285c4-0a3a-3da1-bd6a-d1a497299d50",
                        "glosses": [
                            "Person, die zur Unterstützung bei der Hausarbeit (nach Bedarf, stunden-/tageweise) beschäftigt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1240fc78-455f-46c7-9abb-0c5a6afe61bf",
                                "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                                "text": "Zum Glück habe ich eine zuverlässige Haushaltshilfe, die einmal in der Woche meine Wohnung putzt und sich um die Wäsche kümmert."
                            },
                            {
                                "example_id": "e89c2631-8085-4ed2-bfbb-035835908206",
                                "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                                "text": "„Wie es sich für wohlhabende Leute gehörte, stellten die Eckerts eine Haushaltshilfe ein.“"
                            },
                            {
                                "example_id": "734c6929-acf3-4e97-9acb-43da1e39e99f",
                                "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                                "text": "„Die Arbeitgeber der Haushaltshilfe, die Familie Homm, planten bereits die sofortige Abreise aus dem bedrohten Ostpreußen.“"
                            },
                            {
                                "example_id": "750cdeee-5509-48c3-9f36-289bcb1c6693",
                                "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                                "text": "„Nur unsere Haushaltshilfe Hedda – sie war eine sehr wichtige Person in unserer Familie – bestand darauf, auch bei Alarm im Haus zu bleiben.“"
                            },
                            {
                                "example_id": "cad642cc-4e05-436f-b9d8-c6a1812e3c2b",
                                "sense_id": "fa9bb8d1-fac3-3e92-8651-5ed6bd5edc17",
                                "text": "„Mit sechzehn ging sie als Haushaltshilfe bei Juwelier Franzen in Stellung, wo Herbert Schönuíng in der Werkstatt arbeitete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "10c12d3c-ec73-363e-848b-f508d0853141",
                        "entry_id": "7c4285c4-0a3a-3da1-bd6a-d1a497299d50",
                        "glosses": [
                            "Kostenerstattung für eine Haushaltshilfe^([1]), die von der Kranken- oder Pflegeversicherung erbracht wird, wenn aus bestimmten Gründen die Führung des Haushalts (vorübergehend) nicht mehr möglich ist (Krankheit, Schwangerschaft und anderes)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcf7d076-d37a-4a3a-8fd4-f6467fddf27d",
                                "sense_id": "10c12d3c-ec73-363e-848b-f508d0853141",
                                "text": "„Der Anspruch auf Haushaltshilfe besteht nur, soweit eine im Haushalt lebende Person den Haushalt nicht weiterführen kann.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
