                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ff492ef-4cb2-3d20-94ac-291330512f65",
                                        "entry_id": "55ffe25b-0a49-306a-801a-dd2dba3c39b5",
                                        "glosses": [
                                            "One who, or that which, gets."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "049311b6-2492-4cd6-a0db-456dee170c5f",
                                                "sense_id": "1ff492ef-4cb2-3d20-94ac-291330512f65",
                                                "text": "Many times things would open in him to admiration, showing to rich men and the eager getters of this world, the danger they were in of hurting themselves, by hindering their growth in the truth."
                                            },
                                            {
                                                "example_id": "15b9b58d-48be-4b14-8231-62bb5044665c",
                                                "sense_id": "1ff492ef-4cb2-3d20-94ac-291330512f65",
                                                "text": "Laird won a four-year city council term and was the top vote-getter in the 1981 election, which for the first time seated a progressive city council and a socialist mayor."
                                            },
                                            {
                                                "example_id": "f3b6446e-7086-4c51-ae6d-cb15d0458819",
                                                "sense_id": "1ff492ef-4cb2-3d20-94ac-291330512f65",
                                                "text": "In any case, now we have defined the identities and established the unique characteristics of all types of gift givers and gift getters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5913c2d8-d2f0-3bec-805d-0657acd5850d",
                                        "entry_id": "55ffe25b-0a49-306a-801a-dd2dba3c39b5",
                                        "glosses": [
                                            "A function used to retrieve the value of some property of an object, contrasted with the setter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a99825d-a1a7-4e61-be13-4e12084301d1",
                                                "sense_id": "5913c2d8-d2f0-3bec-805d-0657acd5850d",
                                                "text": "A proper getter must return the type of its attribute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7cdfd9e-4be3-302d-8171-6dd6ad7ccdd6",
                                        "entry_id": "55ffe25b-0a49-306a-801a-dd2dba3c39b5",
                                        "glosses": [
                                            "A material which is included in a vacuum system or device for removing gas by sorption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90415c92-7c7b-4b7c-9b04-5dd1b7e11a06",
                                                "sense_id": "a7cdfd9e-4be3-302d-8171-6dd6ad7ccdd6",
                                                "text": "Titanium has become the preferred getter for general vacuum-pumping applications because of its relatively high vapor pressure characteristic and its broad spectrum chemical reactivity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62d76e4-730a-31a8-b5e1-111ca86ab54e",
                                        "entry_id": "55ffe25b-0a49-306a-801a-dd2dba3c39b5",
                                        "glosses": [
                                            "A miner who dug coal, contrasted with the putter, who took it to the surface."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "getter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f79690b-481b-3b86-be2c-44d89170c7d6",
                                        "entry_id": "fb21ff34-e72a-3870-993c-cd4b5dd9fdee",
                                        "glosses": [
                                            "To remove gas by sorption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31705b2d-56fe-4cac-bbfc-937c7d9ac49c",
                                                "sense_id": "7f79690b-481b-3b86-be2c-44d89170c7d6",
                                                "text": "Many reactive metals rapidly pump large quantities of active gases because they getter (react with) the gases."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
