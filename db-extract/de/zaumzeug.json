                        "sense_id": "d8933e24-f943-345f-ab09-85619c5ddd5e",
                        "entry_id": "269befc2-7c6f-3d4d-88e8-de4c2506c69a",
                        "glosses": [
                            "Ledergeschirr; Riemen, die einem Reittier angelegt werden, um es lenken zu können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "638c3794-04a3-48e6-8d13-49c051c80296",
                                "sense_id": "d8933e24-f943-345f-ab09-85619c5ddd5e",
                                "text": "Das Zaumzeug wird nach der Nutzung mit Öl abgerieben."
                            },
                            {
                                "example_id": "73766b35-5026-4b89-8546-81c6bb4146c9",
                                "sense_id": "d8933e24-f943-345f-ab09-85619c5ddd5e",
                                "text": "„Gutes Zaumzeug lasse ich euch rechtzeitig zukommen, deins, Gísli, war schon letztes Mal verschlissen, und es dürfte seitdem kaum besser geworden sein.“"
                            }
                        ],
