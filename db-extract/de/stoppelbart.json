                "senses": [
                    {
                        "sense_id": "da97021b-4ac8-3d3a-bbf5-8eb5d10d5219",
                        "entry_id": "94114c30-0fee-3b64-9008-0ac8905c3d3c",
                        "glosses": [
                            "Bart mit nur kurzen Haaren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1198b1-73a8-4b9a-a648-81b09fee397f",
                                "sense_id": "da97021b-4ac8-3d3a-bbf5-8eb5d10d5219",
                                "text": "Sein Stoppelbart kratzte auf ihrer Wange."
                            },
                            {
                                "example_id": "1a429db4-40a8-4693-a1cf-ee40dcccffb4",
                                "sense_id": "da97021b-4ac8-3d3a-bbf5-8eb5d10d5219",
                                "text": "„Gerade war er noch auf einem langen Spaziergang mit seinem Hund Jimi, schon schneit er in Sportfunktionskleidung, mit Wollhaube und Stoppelbart in ein schickes Café.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ff6a03e-aa3d-4698-8a18-4b2f52f6d8e6",
                        "source_entry_id": "94114c30-0fee-3b64-9008-0ac8905c3d3c",
                        "source_sense_id": "da97021b-4ac8-3d3a-bbf5-8eb5d10d5219",
