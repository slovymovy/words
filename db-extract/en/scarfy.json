                            {
                                "example_id": "3353ad44-2f52-41fb-85ad-e80cba66fcd0",
                                "sense_id": "8a87be0f-501e-3f3a-9a8f-5737d23db81c",
                                "text": "a scarfy shawl"
                            },
                            {
                                "example_id": "5e970beb-67d7-4eb5-9f19-c38d1afaaac9",
                                "sense_id": "8a87be0f-501e-3f3a-9a8f-5737d23db81c",
                                "text": "It came with a Free Gift! A silk neck scarf in emerald green that Dawn knew she'd tuck away as a keepsake but never wear. She wasn't a scarfy sort of person."
                            },
                            {
                                "example_id": "9530eda9-bb1b-4f32-a07f-70bd6c1eabf2",
                                "sense_id": "8a87be0f-501e-3f3a-9a8f-5737d23db81c",
                                "text": "The next one who came too close to the alley was for Gua Gua. Kind of a badly shaven PLO sympathizer guy with a— What's that word for the Yasser Arafat scarfy thing? I don't know."
                            }
                        ]
                    }
