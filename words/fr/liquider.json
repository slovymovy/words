    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "607af250-ff7b-3100-961a-bad0201bf5a3",
                    "sense_definition": "Vendre à très bas prix des marchandises afin d'épuiser rapidement un stock.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "commerce",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le commerçant a décidé de <w>liquider</w> tout son stock avant les travaux de rénovation."
                        },
                        {
                            "text": "Ce magasin <w>liquide</w> ses anciens modèles pour faire de la place aux nouveautés."
                        }
                    ],
                    "synonyms": [
                        "brader",
                        "écouler"
                    ],
                    "common_phrases": [
                        "liquider un stock",
                        "liquider les invendus"
                    ]
                },
                {
                    "sense_id": "52d646f5-5ef6-357d-9ecc-f1ff54e0076a",
                    "sense_definition": "Régler entièrement et clore une dette, un compte ou une affaire en suspens.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a enfin réussi à <w>liquider</w> toutes ses dettes auprès de ses créanciers."
                        },
                        {
                            "text": "Nous devons impérativement <w>liquider</w> ce dossier en suspens avant la fin de la semaine."
                        }
                    ],
                    "synonyms": [
                        "apurer",
                        "régler",
                        "solder"
                    ],
                    "common_phrases": [
                        "liquider une dette",
                        "liquider une affaire"
                    ]
                },
                {
                    "sense_id": "f19e2772-ed41-3a1a-a15d-cc6247dcda87",
                    "sense_definition": "Tuer ou faire disparaître une personne, généralement de façon délibérée et méthodique.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le chef du réseau criminel a ordonné de <w>liquider</w> le complice imprudent."
                        },
                        {
                            "text": "Dans ce roman policier, le tueur <w>liquide</w> ses victimes sans laisser aucune trace."
                        }
                    ],
                    "synonyms": [
                        "abattre",
                        "éliminer",
                        "supprimer"
                    ],
                    "common_phrases": [
