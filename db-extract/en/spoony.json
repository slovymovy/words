                ],
                "senses": [
                    {
                        "sense_id": "e5dbffb0-82c3-30d5-9ae6-874f87941787",
                        "entry_id": "8a50d265-2dd9-3d9d-ba5a-a49d166cc8bd",
                        "glosses": [
                            "A foolish, simple, or silly person."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "207c7574-6f2a-3aca-b4d2-f0cbfe8feb1c",
                        "entry_id": "8a50d265-2dd9-3d9d-ba5a-a49d166cc8bd",
                        "glosses": [
                            "A foolishly amorous person."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "64defce2-f6ec-40b5-8f3e-182c449ca302",
                                "sense_id": "207c7574-6f2a-3aca-b4d2-f0cbfe8feb1c",
                                "text": "Major Pendennis, when the offer of the commission was acknowledged and refused, wrote back a curt and somewhat angry letter to the widow, and thought his nephew was rather a spooney."
                            },
                            {
                                "example_id": "666f9a8f-61e5-4512-87d6-99a77cae5daa",
                                "sense_id": "207c7574-6f2a-3aca-b4d2-f0cbfe8feb1c",
                                "text": "Occasionally, a Fascinating Lady catches a rich spoony whom she can manage and control. In that case, she continues to have all her whims fully gratified until Mr. Spoony's fortune is exhausted, and the creditors carry off the off the nice furniture."
                            }
                        ]
                    },
                    {
                        "sense_id": "98fd4694-0746-3d18-ad07-1a659bb2d1c8",
                        "entry_id": "8a50d265-2dd9-3d9d-ba5a-a49d166cc8bd",
                        "glosses": [
                            "Alternative form of spoonie (“person with chronic illness or disability”)."
                        ],
