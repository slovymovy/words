                        "sense_id": "3dbe6073-126a-3fb3-841d-a51046e4c411",
                        "entry_id": "881499ef-f291-3702-be4e-9d3069a1b495",
                        "glosses": [
                            "Qualifie une application qui est une submersion."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "570ef74e-5df3-4ce3-a320-e9c9116abcef",
                                "sense_id": "3dbe6073-126a-3fb3-841d-a51046e4c411",
                                "text": "Un morphisme surjectif qui est ouvert, ou fermé, est submersif, donc un morphisme surjectif universellement fermé ou universellement ouvert est universellement submersif."
                            }
                        ]
