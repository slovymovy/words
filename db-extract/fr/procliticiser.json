                ],
                "senses": [
                    {
                        "sense_id": "22f7df72-e5f2-3b16-a95d-395a8300c616",
                        "entry_id": "6267a1e4-dd2e-32e7-af09-428dcb142972",
                        "glosses": [
                            "Donner un caractère proclitique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c1eea4f-c97f-4332-a3c5-97ab6d2e6292",
                                "sense_id": "22f7df72-e5f2-3b16-a95d-395a8300c616",
                                "text": "Lorsque le pronom clitique apparaît avec un temps composé, il procliticise sur le verbe lexical et non sur l’auxiliaire."
                            },
                            {
                                "example_id": "b50ca749-3aa4-45f8-9bbf-d7d757dff9d0",
                                "sense_id": "22f7df72-e5f2-3b16-a95d-395a8300c616",
                                "text": "Phonologiquement, la marque de cas se procliticise à l’élément régissant."
                            },
                            {
                                "example_id": "a35658fd-e4fe-488b-a290-492306b126d4",
                                "sense_id": "22f7df72-e5f2-3b16-a95d-395a8300c616",
                                "text": "Étant donné que les prépositions se procliticisent sur leur complément, comme le montre le changement de la voyelle initiale sur les pronoms personnels tchèques en (68), le RNR suivi de la procliticisation serait prosidiquement “invisible”, cf. (69)"
                            }
                        ]
                    }
                ],
