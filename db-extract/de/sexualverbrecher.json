                "senses": [
                    {
                        "sense_id": "92598934-bfb7-36ed-ab4a-b757d8f37a79",
                        "entry_id": "410bc9af-dd45-3175-b50a-65c6d64115ee",
                        "glosses": [
                            "Verbrecher, der eine oder mehrere Straftaten mit sexuellem Motiv/Hintergrund begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b2ba0fd-4d18-4341-be69-32d3692b3030",
                                "sense_id": "92598934-bfb7-36ed-ab4a-b757d8f37a79",
                                "text": "„Ein Serienentführer, der seine Opfer für wer weiß wie lange in ein unterirdisches Verlies sperrte, war zwar nicht völlig unmöglich, aber doch immerhin so selten, dass Shaw eine etwas realistischere Tat annahm: dass Sophie einem soziopathischen Sexualverbrecher in die Hände gefallen war.“"
                            },
                            {
                                "example_id": "fbd83aaf-0271-4937-b070-00d050d45c37",
                                "sense_id": "92598934-bfb7-36ed-ab4a-b757d8f37a79",
                                "text": "„Dann aß sie den Schoko-Karamel-Riegel und schrieb ein Memo an Crawford, in dem sie vorschlug, dass man die computerisierten Adressenlisten der Entomologiepublikation mit den bekannten Straffälligenakten des FBI und den AKten in den Städten vergleichen solle, die den Entführungen am nächsten gelegen waren, dazu den Akten über Schwer- und Sexualverbrecher aus Metro Dade, San Antonio und Houston, den Gegenden, wo die Motten am allerhäufigsten vorkamen.“"
                            },
                            {
                                "example_id": "5c21b6a4-e28d-4413-9bdd-c32058327e79",
                                "sense_id": "92598934-bfb7-36ed-ab4a-b757d8f37a79",
                                "text": "„Es verdross mich, nicht für Aufklärung sorgen zu können, andererseits sprach nichts dafür, dass meine Oma als Witwe mit dem Gedanken leben sollte, einen Sexualverbrecher überlebt zu haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
