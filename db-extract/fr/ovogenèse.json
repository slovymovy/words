                        "entry_id": "85d44d97-a2d0-3aff-81fe-c8a13c2e3d51",
                        "glosses": [
                            "Ensemble des processus qui président à la formation et au développement des gamètes femelles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76e647a6-7b34-4519-ba1b-329b5eb1a772",
                                "sense_id": "d787db07-effc-35a2-ae94-670eb41088b6",
                                "text": "L'ovogenèse est le processus de production des ovules qui débute dans l'ovaire et se termine dans la trompe de Fallope."
                            },
                            {
                                "example_id": "30b7bc15-74b3-4cf9-9c9b-52db0e931a0c",
                                "sense_id": "d787db07-effc-35a2-ae94-670eb41088b6",
                                "text": "L’ovogenèse est l’ensemble des processus conduisant à la formation des gamètes femelles, les ovules ou plus improprement, « œufs vierges»."
                            }
                        ]
                    }
