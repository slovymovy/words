                "senses": [
                    {
                        "sense_id": "ac87f2f9-4202-3189-856b-5fa4f74de4ee",
                        "entry_id": "4912d3c9-e8bb-3d95-9efb-832080149114",
                        "glosses": [
                            "Mitaine, gant qui, ne couvrant que la moitié de la main, laisse les doigts découverts."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5a2065aa-0711-4630-8e7f-b04c8520a7c8",
                                "sense_id": "ac87f2f9-4202-3189-856b-5fa4f74de4ee",
                                "text": "MM. Leignadier et Daumas, fabricans dans la même ville, avaient exposé des gants de soie amadis, bordés à fleur, des gants et des mitons en fil d’Écosse."
                            }
                        ]
                    },
                    {
                        "sense_id": "13959272-9fc1-3b95-9dab-fafb4d843633",
                        "entry_id": "4912d3c9-e8bb-3d95-9efb-832080149114",
                        "glosses": [
                            "Gantelet d’une armure, ou partie du gantelet, qui ne recouvre que la moitié supérieur de la main, laissant les doigts découverts."
                        ],
                        "tags": [
                            "Armurerie"
                        ],
                        "examples": [
                            {
                                "example_id": "b830d67b-23ec-41f8-a21e-0e3f71ac7b7e",
                                "sense_id": "13959272-9fc1-3b95-9dab-fafb4d843633",
                                "text": "À cette extrémité, dont le rebord était percé d’une suite de petits trous, se fixait ordinairement un miton ou un gant de maille."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
