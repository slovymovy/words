                "senses": [
                    {
                        "sense_id": "819999e7-9730-3700-b160-7b6eb271a597",
                        "entry_id": "daeede6f-02d4-3789-b847-acfd43903d88",
                        "glosses": [
                            "Substanz (Stoff), die die Wirkung einer anderen Substanz aufheben kann, oder den genau gegenteiligen Effekt im Körper hat"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "2fca4058-5d36-492e-9dc3-075d9fd03b8e",
                                "sense_id": "819999e7-9730-3700-b160-7b6eb271a597",
                                "text": "„Mischt man nun diesen Gegenstoff mit Blut der Art, gegen die der Gegenstoff gebildet wurde, dann backen dessen Blutkörperchen zusammen. Der Kunstausdruck ist: Die Blutkörperchen agglutinieren.“"
                            },
                            {
                                "example_id": "1ba44207-a79f-4037-a7f2-5b05e5fed16a",
                                "sense_id": "819999e7-9730-3700-b160-7b6eb271a597",
                                "text": "„Die curareartigen Eigenschaften des Extraktes bleiben nach dem Kochen erhalten, werden aber durch Hinzufügen von Kalziumchlorid (dem funktionellen Gegenstoff des Kaliums) aufgehoben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
