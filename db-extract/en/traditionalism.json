                "senses": [
                    {
                        "sense_id": "38ab0486-2f7c-3925-8eab-17a843352770",
                        "entry_id": "5911d509-a6a0-3a13-ab74-225a81cb3ecb",
                        "glosses": [
                            "The adherence to traditional views or practices, especially with regard to cultural or religious matters."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "6e6116a0-ee4a-3722-8463-8d967d1f46f7",
                        "entry_id": "5911d509-a6a0-3a13-ab74-225a81cb3ecb",
                        "glosses": [
                            "The continuation of theological rituals on the basis that the ritual has always completed, rather than the ritual being a manifestation of theology."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7854a5f3-4e85-37b5-a00b-c42b6c5241e6",
                        "entry_id": "5911d509-a6a0-3a13-ab74-225a81cb3ecb",
                        "glosses": [
                            "A philosophical system which makes tradition the supreme criterion and rule of certitude; the doctrine that human reason is of itself radically unable to know with certainty any truth or, at least, the fundamental truths of the metaphysical, moral, and religious order."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ac36a891-1500-452e-bbfd-6c5c055edd04",
                                "sense_id": "7854a5f3-4e85-37b5-a00b-c42b6c5241e6",
                                "text": "But Drey also gave to the systematic theology of this school its peculiar stamp, equi-distinct from Traditionalism and Rationalism, recognizing on the one hand the objective facts in the history of Revelation and the tradition from generation to generation, maintaining on the other the rights of our natural reason and of philosophical speculation, with all due loyalty to dogma."
                            }
                        ]
                    }
                ],
