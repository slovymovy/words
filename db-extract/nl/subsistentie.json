                                                "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                                                "text": "In the general course of human nature, a power over a man's subsistence amounts to a power over his will."
                                            },
                                            {
                                                "example_id": "377b8ccd-daaa-40fa-80a2-213c9b608405",
                                                "sense_id": "88e337ec-8c02-36ec-afe1-50e14dc90715",
                                                "text": "His viceroy could only propose to himself a comfortable subsistence out of the plunder of his province."
                                            }
                                        ]
