                        "entry_id": "4d43f9a9-1f09-3b22-9e1d-2fad2af149f4",
                        "glosses": [
                            "holle ruimte gevuld met water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a63223a7-f2ae-4a37-8a20-2a01b34dc7eb",
                                "sense_id": "a5b1413f-e107-3636-b7ab-04c198db465e",
                                "text": "Ze zijn opgejaagd uit hun waterholen, de booze geesten der rivier. Ze hebben het stormsein gehoord, dat loeiend door de lucht vaart. Schimmig-wit zijn ze en in huiverende jacht razen ze vlak over 't water...."
                            },
                            {
                                "example_id": "732477d8-c7f3-4a8b-a059-7469402be345",
                                "sense_id": "a5b1413f-e107-3636-b7ab-04c198db465e",
                                "text": "In den drogen tijd, wanneer kreken en zwampen zijn opgedroogd, wordt de visch die in de waterholen is achtergebleven, met de hand gevangen."
                            }
                        ]
                    }
