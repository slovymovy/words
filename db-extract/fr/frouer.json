                ],
                "senses": [
                    {
                        "sense_id": "8d25a785-5d7f-3fd7-9a32-165be59a0baa",
                        "entry_id": "ae8d7bf6-feaa-35c4-8439-95253a99254b",
                        "glosses": [
                            "Crier, en parlant du hibou, de la chouette, du pigeon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3a44e01-5961-4932-aaef-a86609940797",
                                "sense_id": "8d25a785-5d7f-3fd7-9a32-165be59a0baa",
                                "text": "Autour de lui la forêt frouait infiniment, à croire qu’un vol immense de ramiers très bas, occupait tout le ciel."
                            }
                        ]
                    },
                    {
                        "sense_id": "2766a797-04c9-37dc-a3a9-756739433ea4",
                        "entry_id": "ae8d7bf6-feaa-35c4-8439-95253a99254b",
                        "glosses": [
                            "Contrefaire en sifflant le cri de la chouette, du hibou, du pigeon, du geai, pour attirer les petits oiseaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1e0ed8-78ff-42ae-9bea-c1b2efa4e5cf",
                                "sense_id": "2766a797-04c9-37dc-a3a9-756739433ea4",
                                "text": "[…] le Pipeur commence à frouer, ce qu’il fait en soufflant dans une feuille de lierre, à laquelle on fait un petit trou, en levant le côté du milieu assez près de la queue, ce qui fait le cri d’un petit oiseau, qui appelle les autres à son secours : il y a encore diverses manières de frouer. Aussitôt qu’on a froué, plusieurs oiseaux, comme des rouges-gorges, viennent se prendre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6135f5a-a943-4fa8-80be-5e468f941ef8",
                        "source_entry_id": "ae8d7bf6-feaa-35c4-8439-95253a99254b",
                        "target_lang_word": "screech",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
