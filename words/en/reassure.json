{
    "word_family": [
        "assurance",
        "reassurance",
        "assure",
        "assuredly",
        "unreassured"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "306de074-7f95-3d72-8326-876f19b39e66",
                    "sense_definition": "To say or do something to remove the doubts and fears of someone.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "comforting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor tried to <w>reassure</w> the patient that the surgery was very safe.",
                            "target_lang_translations": {
                                "ru": "Врач попытался <w>успокоить</w> пациента, заверив его, что операция очень безопасна.",
                                "zh": "医生试图<w>使</w>病人<w>安心</w>，告诉他手术非常安全。"
                            }
                        },
                        {
                            "text": "She needed to <w>reassure</w> the public that the situation was under control.",
                            "target_lang_translations": {
                                "ru": "Ей нужно было <w>заверить</w> общественность в том, что ситуация находится под контролем.",
                                "zh": "她需要<w>向</w>公众<w>保证</w>局势已在控制之中。"
                            }
                        },
                        {
                            "text": "The mother spoke in a soft voice to <w>reassure</w> her child after the nightmare.",
                            "target_lang_translations": {
                                "ru": "Мать говорила тихим голосом, чтобы <w>успокоить</w> своего ребенка после ночного кошмара.",
                                "zh": "噩梦过后，母亲轻声细语地<w>安慰</w>孩子。"
                            }
                        }
                    ],
                    "synonyms": [
                        "comfort",
                        "encourage",
                        "hearten",
                        "soothe"
                    ],
                    "antonyms": [
                        "alarm",
                        "unnerve",
                        "frighten",
                        "discourage"
                    ],
                    "common_phrases": [
                        "reassure the public",
                        "reassure the patient",
                        "reassure someone of something"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сказать или сделать что-либо, чтобы развеять сомнения и страхи человека.",
                        "zh": "通过言行消除某人的疑虑或担忧，使其安心"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "успокаивать",
                                "target_lang_sense_clarification": "рассеивать беспокойство или тревогу"
                            },
                            {
                                "target_lang_word": "заверять",
                                "target_lang_sense_clarification": "обещать, что всё будет в порядке"
                            },
                            {
                                "target_lang_word": "уверять",
                                "target_lang_sense_clarification": "пытаться убедить в истинности чего-либо"
                            },
                            {
                                "target_lang_word": "утешать",
                                "target_lang_sense_clarification": "облегчать горе или страдание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使放心",
                                "target_lang_sense_clarification": "消除疑虑让某人放心"
                            },
                            {
                                "target_lang_word": "使安心",
                                "target_lang_sense_clarification": "安抚并让心情平静稳定"
                            },
                            {
                                "target_lang_word": "安慰",
                                "target_lang_sense_clarification": "言语抚慰使人舒心"
                            },
                            {
                                "target_lang_word": "向……保证",
                                "target_lang_sense_clarification": "做出保证以消除担忧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6471188-6874-32c6-aaca-fa293dd74a4c",
                    "sense_definition": "To provide insurance for an insurer; to insure again.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "insurance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The primary insurance company decided to <w>reassure</w> its largest policies to minimize risk.",
                            "target_lang_translations": {
                                "ru": "Первичная страховая компания решила <w>перестраховать</w> свои крупнейшие полисы, чтобы минимизировать риск.",
                                "zh": "这家原保险公司决定为其最大的保单办理<w>再保险</w>，以最大限度地降低风险。"
                            }
                        },
                        {
                            "text": "In complex financial markets, firms often <w>reassure</w> their liabilities through secondary providers.",
                            "target_lang_translations": {
                                "ru": "На сложных финансовых рынках фирмы часто <w>перестраховывают</w> свои обязательства через вторичных провайдеров.",
                                "zh": "在复杂的金融市场中，企业经常通过二级提供商对其负债进行<w>分保</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reinsure"
                    ],
                    "common_phrases": [
                        "reassure a policy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять страховку страховщику; страховать повторно.",
                        "zh": "（为保险人）再保险；重复保险"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "перестраховывать",
                                "target_lang_sense_clarification": "страховать заново или передавать часть риска"
                            },
                            {
                                "target_lang_word": "перестраховать",
                                "target_lang_sense_clarification": "застраховать еще раз (совершенный вид)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "再保险",
                                "target_lang_sense_clarification": "将承保的风险转保给其他保险人"
                            },
                            {
                                "target_lang_word": "分保",
                                "target_lang_sense_clarification": "分出部分保险业务以分散风险"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}