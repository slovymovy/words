            {
                "entry_id": "b57d6c6c-edc1-3789-977a-0179d202cb5a",
                "word": "Caroline",
                "pos": "name",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a2047f02-81a6-4229-b525-65536dc21bf1",
                        "entry_id": "b57d6c6c-edc1-3789-977a-0179d202cb5a",
                        "tags": [
