                "senses": [
                    {
                        "sense_id": "11c5d195-3920-3c9e-9289-f224555d661b",
                        "entry_id": "9c973c6c-0447-39b2-b3dd-c97e81390085",
                        "glosses": [
                            "ablehnende Einstellung gegenüber (gesellschaftlichem, menschlichem, …) Fortschritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a962bc2f-8ebb-417d-9641-ab647a90ec5e",
                                "sense_id": "11c5d195-3920-3c9e-9289-f224555d661b",
                                "text": "„Es ist für eine Gesellschaft immer schädlich, wenn Obskurantismus, der Widerstand gegen die Aufklärung, Platz greift, wenn Fortschrittsfeindlichkeit real spürbar wird.“"
                            },
                            {
                                "example_id": "4565bc91-e202-4d94-b9fb-9f67aacd4081",
                                "sense_id": "11c5d195-3920-3c9e-9289-f224555d661b",
                                "text": "„Denn Skeptizismus, ein Vorbehalt gegen alles Neue und eine latente oder auch offensichtliche Fortschrittsfeindlichkeit schützen uns nicht vor Risiken und fragwürdigen Entwicklungen, sondern machen uns zu Unwissenden und Abgehängten.“"
                            },
                            {
                                "example_id": "e40cebee-a5b6-40af-b511-a63a7efd407a",
                                "sense_id": "11c5d195-3920-3c9e-9289-f224555d661b",
                                "text": "„Man warf dem Klerus Korruption und Fortschrittsfeindlichkeit vor sowie sich illegal zu bereichern und das Wort Gottes unglaubhaft gemacht zu haben.“"
                            },
                            {
                                "example_id": "eaf28136-2bed-40bb-a4fe-4031ca20d141",
                                "sense_id": "11c5d195-3920-3c9e-9289-f224555d661b",
                                "text": "„Zugleich verlieren traditionelle Industrieländer durch steigende Kosten, Inflexibilität des Arbeitsmarktes und Fortschrittsfeindlichkeit an Wettbewerbsfähigkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
