                "senses": [
                    {
                        "sense_id": "44e6e4ce-1dcb-3acb-86ba-0897950f5cab",
                        "entry_id": "f4aed259-4109-3362-a48f-6fa6292c7d4b",
                        "glosses": [
                            "Person, die in Deutschland Arbeitslosengeld II oder Sozialgeld ( Hartz IV) bezieht"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "bc3cef8e-7350-4e74-800b-b419d2beaf73",
                                "sense_id": "44e6e4ce-1dcb-3acb-86ba-0897950f5cab",
                                "text": "Da er Hartz-IV-Empfänger ist, kann sich Hans nur noch das Nötigste leisten."
                            },
                            {
                                "example_id": "fb422aca-2166-42a5-9450-4cabb4e8ae34",
                                "sense_id": "44e6e4ce-1dcb-3acb-86ba-0897950f5cab",
                                "text": "Erik leitet einen Gesprächskreis für Hartz-IV-Empfänger."
                            },
                            {
                                "example_id": "e2d94800-b09a-4532-98ec-159c869c78ed",
                                "sense_id": "44e6e4ce-1dcb-3acb-86ba-0897950f5cab",
                                "text": "„Auch in Stadtteilen mit einem hohen Anteil an Hartz-IV-Empfängern sei die Zustimmungsquote leicht höher gewesen als im Durchschnitt.“"
                            },
                            {
                                "example_id": "aadde481-d993-446e-9413-a94bf4ba4082",
                                "sense_id": "44e6e4ce-1dcb-3acb-86ba-0897950f5cab",
                                "text": "„Jeder Hartz-IV-Empfänger ist ein Kind, Produkt und Profiteur des Kapitalismus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
