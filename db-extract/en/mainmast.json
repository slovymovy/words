                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grotmaszt",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                                        "entry_id": "4eb07be5-57eb-344a-a1ae-7c62ddc345eb",
                                        "glosses": [
                                            "główny maszt statku żaglowego"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6de827ca-3ea3-4b44-a64a-241e77391487",
                                                "sense_id": "baa2ea67-48f3-3d74-8b2c-395b12003b82",
                                                "text": "Czubek grotmasztu Eniela ledwie sięgał pokładu rufówki, a żeglarz wysoko na salingu wydawał się malutki jak mewa."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5b65df42-c95d-44a9-991a-66c5ee72d7db",
                        "source_entry_id": "4f7b794b-10bb-37be-9028-eace98a9ee16",
