                    },
                    {
                        "form_id": "15c794af-6c3c-4148-93b1-11a4a034eee2",
                        "entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most dimly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                        "entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "glosses": [
                            "In a dim manner; not clearly."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c98dbc94-5719-4f99-9150-02aa8fe5c1c2",
                                "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                                "text": "I began dimly to understand."
                            },
                            {
                                "example_id": "32232f39-81fd-4407-935b-ba5781142dac",
                                "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                                "text": "It was a miserable evening; outside it was snowing and blowing, and in the squire's parlour the candle burned so dimly that you could scarcely distinguish anything in the room but a clock-case with some Chinese ornaments, a large mirror in an old-fashioned frame, and a silver family tankard."
                            },
                            {
                                "example_id": "a32ae941-bf16-408a-97a6-78c4a75b1d49",
                                "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                                "text": "\"The evil is for those benighted ones who will have none of it; seeing the light the true believers worship, as the fishes see the stars, but dimly.\""
                            },
                            {
                                "example_id": "dbf05bfe-e4cd-43fe-912c-42e96b531225",
                                "sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                                "text": "The well-heeled gay yuppies of Bay Village would just as soon banish Drag Queens and hustlers entirely from their lives, only to dimly acknowledge them once a year in flowery paeans to \"the gay men and Lesbians who rioted at Stonewall and gave birth to our movement\" on Gay Pride Day."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "275b53bc-b544-4e15-856c-a81062bf57e1",
                        "source_entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "source_sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                        "source_sense_description": "in a dim manner",
                        "target_lang_word": "faiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                        "entry_id": "14424ab6-2bdf-36a5-9c96-bb1962545589",
                                        "glosses": [
                                            "D’une manière faible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fea9e79-66f1-45be-8f48-08adab7dab91",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Nos malheurs jusqu'ici vous touchent faiblement."
                                            },
                                            {
                                                "example_id": "65b86657-f031-4316-a654-68af1fb43f99",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Que le cœur d’une femme est mal connu de vous, Et que vous savez peu ce qu’il veut faire entendre, Lorsque si faiblement on le voit se défendre !"
                                            },
                                            {
                                                "example_id": "1a34a869-ed44-4ae3-96fd-cf3b4b2bbfff",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Rome s'accroissait, mais faiblement."
                                            },
                                            {
                                                "example_id": "a4b8fef1-48cf-4baf-b2bd-0b378efc9451",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il faut prendre sur soi certaines choses décisives où l’on ne peut vous conseiller que faiblement."
                                            },
                                            {
                                                "example_id": "3e783c80-b78a-49fe-a1aa-666bd1f3bca7",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je m’en plaignis, mais si faiblement que je n'insistai point."
                                            },
                                            {
                                                "example_id": "bcd5a1ba-a5bb-4f21-91d2-0d3817a77d33",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Après cette paix, la France se rétablit faiblement."
                                            },
                                            {
                                                "example_id": "717a70bf-75e9-4639-ac73-4b4dac49a498",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Le marquis d’Argens vient d’imprimer à Berlin le discours de l’empereur Julien contre les Galiléens, discours à la vérité un peu faible, mais beaucoup plus faiblement réfuté par saint Cyrille."
                                            },
                                            {
                                                "example_id": "f8eb718e-c0a9-4072-8e3b-a248b6fd47d5",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Je me croirais haï, d’être aimé faiblement."
                                            },
                                            {
                                                "example_id": "a9bd1883-1ce0-4d91-9fba-b0e426d9ac17",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "J'ai peur que la raison, l’amitié filiale Combattent faiblement l’illusion fatale."
                                            },
                                            {
                                                "example_id": "9d8a9543-88ae-4ee2-9257-05b939eb2ce2",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "C'est la plus faiblement écrite de mes pièces de théâtre, mais la plus pathétique."
                                            },
                                            {
                                                "example_id": "83f09052-3857-46ad-b747-67b551d26a65",
                                                "sense_id": "611d0626-537f-3708-8a9b-2bc5d11b7929",
                                                "text": "Il poussa la porte si fort que le fer à cheval suspendu au linteau de chêne tinta faiblement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73660a05-7236-4d14-8c7e-06c2f615b5b5",
                        "source_entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "source_sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                        "source_sense_description": "in a dim manner",
                        "target_lang_word": "obscurément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obscurément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c56fa3cc-383f-3795-8083-acccf9b015bf",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "Sans clarté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "872729c0-4512-4112-a973-798445bab439",
                                                "sense_id": "c56fa3cc-383f-3795-8083-acccf9b015bf",
                                                "text": "La nuit approchait, on ne voyait les objets qu’obscurément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bd7372fd-936e-3523-b966-2dbceaa0a638",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "D’une manière brune, foncée, en parlant de teintes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb45d5a4-c0d2-43df-8898-62c6408eb840",
                                                "sense_id": "bd7372fd-936e-3523-b966-2dbceaa0a638",
                                                "text": "Le dessus du dos, de la tête et des ailes est d’un brun obscurément teint de verdâtre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "044a9574-0289-34f0-9e4b-ed9975b722d0",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "D’une manière à peine visible."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb6c3884-e269-488f-a93d-0d58714d742a",
                                                "sense_id": "044a9574-0289-34f0-9e4b-ed9975b722d0",
                                                "text": "À son origine, le cœur n'est qu’une vésicule obscurément contractile."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "D’une manière peu intelligible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4656f77c-e436-4b45-b981-c91bbf66a98d",
                                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                                "text": "L'enfant […] devinait obscurément que le monsieur, si bizarrement apparu, n'était pas comme les autres et elle songeait à quelque père Noël, les poches pleines de jouets et de friandises."
                                            },
                                            {
                                                "example_id": "4cd88769-12a7-47ab-8d02-736a9760c336",
                                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                                "text": "Quoi ! mon père tantôt parlait obscurément."
                                            },
                                            {
                                                "example_id": "2e3ef304-8759-4df0-bd54-6e9eccd8182c",
                                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                                "text": "Si le temps [du Messie] eût été prédit obscurément."
                                            },
                                            {
                                                "example_id": "71809037-e818-4040-b677-e2662696a886",
                                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                                "text": "Dans cette grammaire, dont l’objet ne paraissait pas devoir effrayer les âmes pieuses, les phrases citées par l’auteur pour exemples de ses préceptes étaient une suite d’assertions obscurément impies contre l’existence de Dieu, la spiritualité de l’âme, et les autres vérités que la religion nous oblige de croire."
                                            },
                                            {
                                                "example_id": "8fa29675-30f0-4b0d-906f-7d8b959c762c",
                                                "sense_id": "792c866e-e8c7-31c7-8c61-6b4150256fbe",
                                                "text": "Dois-je, au lieu de Laharpe, obscurément écrire : C’est ce petit rimeur, de tant de prix enflé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "Sans renom, sans éclatin."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf65fbc-fbca-45de-a6c6-19a70fd54fb5",
                                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                                "text": "Il dévore en secret ses sentiments d’humanité, il gémit obscurément sur la nature humaine."
                                            },
                                            {
                                                "example_id": "1899bbf1-6e3c-452a-ab8d-99bed7ae601c",
                                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                                "text": "Rien n'est si désagréable que d’être pendu obscurément."
                                            },
                                            {
                                                "example_id": "f4d4a7dc-75c8-4d63-9207-e4cc732bbb6f",
                                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                                "text": "Le bonheur, cet objet de nos désirs, mais qui fuit et repousse la grandeur et les richesses, serait-il donc obscurément attaché à la médiocrité en tout genre ?"
                                            },
                                            {
                                                "example_id": "d384fc11-b51e-40ff-9a03-d4f0b29296ef",
                                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                                "text": "Soldat obscurément utile, Je ne partageais les lauriers Ni de Saxe, ni de Belle-Isle."
                                            },
                                            {
                                                "example_id": "3ed2cab0-1e44-4122-828d-cba57ee93f29",
                                                "sense_id": "04223dcd-ff5c-389d-9024-01339f5a6baf",
                                                "text": "Dans les bras d’une épouse chérie Je goûte obscurément les doux fruits de ma vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                        "entry_id": "dd2a1395-739b-3d37-9129-a023303b5111",
                                        "glosses": [
                                            "D’une manière mal éclaircie, qui n'est pas bien certaine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28d7e549-fcd5-456e-b4c1-fae5be9977cd",
                                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                                "text": "Obscurément plongé dans ce doute cruel, Mes yeux, chargés de pleurs, se tournaient vers le ciel."
                                            },
                                            {
                                                "example_id": "b36b43cf-98e3-45e6-b391-474353d96f2c",
                                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                                "text": "Il se répandit obscurément de tous côtés que les Malais, qui seuls avaient des relations avec ces contrées, avaient porté du girofle et de la muscade dans plusieurs marchés."
                                            },
                                            {
                                                "example_id": "3755de5c-ac60-45eb-92d2-0c1983bbabc2",
                                                "sense_id": "e8e2a227-f734-34b1-a442-81ce401571ec",
                                                "text": "L'empereur flattait encore obscurément une espérance qu’il n'avait pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1442c40a-7cb8-4e63-9442-fa1066033cf5",
                        "source_entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "source_sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                        "source_sense_description": "in a dim manner",
                        "target_lang_word": "vaguement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vaguement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                        "entry_id": "3960fb2a-f770-38c0-a347-4d288b510134",
                                        "glosses": [
                                            "D’une manière vague."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3c254b2-456e-49bc-822a-0b72eed03d12",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Tous les habitants de la factorerie, hommes et femmes, s'y trouvaient rassemblés, vaguement éclairés par la lumière des lampes."
                                            },
                                            {
                                                "example_id": "4e8ce6fc-03bb-4612-a619-9c15a9ee1bdc",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Elle n'avait commencé à penser, très vaguement, que du jour où elle avait aimé."
                                            },
                                            {
                                                "example_id": "690f8b6d-6431-41c3-97d4-9850f685b6b3",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Il labourait dans le parc et cultivait assez de terrain pour nourrir ses chevaux et ses gens ; il y bottelait trois cents milliers de foin excellent, et n’en comptait que cent, en s’autorisant d’une permission vaguement accordée par le comte."
                                            },
                                            {
                                                "example_id": "63145d4e-3eff-43d9-9d65-0692bf4c076b",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "A l'infini, les sables ardents sont bosselés de touffes pâles, vaguement teintées d'un mélange de vert, de bleu et de gris, — les touffes de hâd arrondies, basses, compactes, hérissées de menus piquants."
                                            },
                                            {
                                                "example_id": "d02af268-22fa-4708-822c-217fd8bf499b",
                                                "sense_id": "a4541a4c-a91a-3457-8846-7967b1b2eaa1",
                                                "text": "Le traité avait pour objectif de délimiter « les régions sous-marines » du golfe de Paria qui sépare Trinité-et-Tobago, alors colonie britannique, du Venezuela. L'accord fixait ainsi trois segments depuis les bouches du Dragon jusqu'aux bouches du Serpent. Les surfaces délimitées respectaient vaguement ce qu'aurait pu donner une ligne d’équidistance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd2e7b6e-8d71-4320-8374-5463f91d289a",
                        "source_entry_id": "9c923a82-40a6-3473-a1f7-50813f8805f9",
                        "source_sense_id": "57472b2e-fad2-3a9c-bb03-8eed264d5d58",
                        "source_sense_description": "in a dim manner",
                        "target_lang_word": "confusément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "confusément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                        "entry_id": "d9b4d637-4400-3608-ad7b-54b454e0366d",
                                        "glosses": [
                                            "D’une manière confuse, indistincte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "114bb6fa-f47d-4b1a-8ce1-29c3aa962f84",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "[…]; un peu plus loin sur la droite, face au large, l'étrange roche à figure humaine qu'on appelle le roi Grallon se silhouettait confusément."
                                            },
                                            {
                                                "example_id": "bb3785a9-cf0d-4fcb-a42d-34ef41732173",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Cet horrible débris d’aigles, d’armes, de chars,\nSur ces champs empestés confusément épars."
                                            },
                                            {
                                                "example_id": "ebc489ae-c0d6-4890-8ed6-b7ddb766e100",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Les perles avec l’or confusément mêlées."
                                            },
                                            {
                                                "example_id": "1caaebdf-7835-441f-98a1-fb72e811736c",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Par un si grand bruit semé confusément."
                                            },
                                            {
                                                "example_id": "18079892-f614-4754-8c51-3c183d434921",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Les oisillons, las de l’entendre,\nSe mirent à jaser aussi confusément\nQue faisaient les Troyens, quand la pauvre Cassandre\nOuvrait la bouche seulement."
                                            },
                                            {
                                                "example_id": "4f42c65e-7043-4ba7-a749-0f24a303470b",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Il [l’ouvrage de Tournefort] est fait pour mettre de l’ordre dans ce nombre prodigieux de plantes semées si confusément sur la terre et même sous les eaux de la mer."
                                            },
                                            {
                                                "example_id": "96402c93-6e3f-4a93-b32e-db3198a69803",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Hier confusément j’en appris la nouvelle."
                                            },
                                            {
                                                "example_id": "51c9dcde-4a3f-450f-9472-dca75f4171b6",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Fables et vérités, ténèbres et lumière\nFlottent confusément devant notre paupière,\nEt l’un dit : C’est le jour ! et l’autre : C’est la nuit !"
                                            },
                                            {
                                                "example_id": "c7783118-8775-4869-a101-11468a7dc538",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Toutefois, le sergent crut apercevoir confusément, à travers un bouquet de bouleaux, une masse blanche, énorme, qui se mouvait lentement […]"
                                            },
                                            {
                                                "example_id": "66234776-6ec9-4178-8561-3b488de858bf",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Et, sans qu'il s'expliquât pourquoi, c'était cette première syllabe qui lui rappelait confusément un souvenir que son esprit en travail cherchait à préciser."
                                            },
                                            {
                                                "example_id": "f0354b2d-6112-4b33-9fd3-b9d010ecbbe5",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "Je crois confusément à beaucoup de choses ; par dessus tout, à l’existence de Dieu, sinon aux dogmes de la religion […]"
                                            },
                                            {
                                                "example_id": "6fa32847-1111-4491-99c3-92c932102adc",
                                                "sense_id": "186d4ab3-6a84-3d4f-8a76-731a54948b4d",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be9ae1d0-0934-434f-8c98-514979adf346",
