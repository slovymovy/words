                    }
                ],
                "translations": [
                    {
                        "translation_id": "93df8b5b-5cdd-4911-ba4c-4c660ed77004",
                        "source_entry_id": "98809af6-dd2d-35bf-b14e-306bf3c168e9",
                        "target_lang_word": "identity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "identity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "437d91bf-263d-31d0-bc93-f2665700e49c",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "Sameness, identicalness; the quality or fact of (several specified things) being the same."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76524576-5660-4b3e-82e8-9022f8c9501a",
                                                "sense_id": "437d91bf-263d-31d0-bc93-f2665700e49c",
                                                "text": "[…] suggesting the two are different stages of the same species. The identity of the two species is further suggested by allozyme analysis […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "The difference or character that marks off an individual or collective from the rest of the same kind; selfhood; the sense of who something or someone or oneself is, or the recurring characteristics that enable the recognition of such an individual or group by others or themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51e9686c-01fb-4f68-9b76-5fde6f595019",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "I've been through so many changes, I have no sense of identity."
                                            },
                                            {
                                                "example_id": "c7552b8e-9a4f-4044-acbb-481aba6ad229",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "This nation has a strong identity."
                                            },
                                            {
                                                "example_id": "229e5875-0ef7-4a11-a070-081918505cb1",
                                                "sense_id": "5944abb3-d874-373a-86df-7068650aa1eb",
                                                "text": "On the other hand, ME /ɛu/ preserved its identity into the early Modern English period, and the early writers on orthography and pronunciation normally distinguish between lME /iu/ and lME /ɛu/, the latter of which occurs in words with eME /ɛː/ like dew (OE dēaw), few (OE fēawe), hew (OE hēawan), sew (eME ē < ĕ, OE seowian), shrew (OE scrēawa), etc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "A name or persona—a mask or appearance one presents to the world—by which one is known."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b06c8fb1-8656-416b-a89c-31210def62b9",
                                                "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                                "text": "This criminal has taken on several identities."
                                            },
                                            {
                                                "example_id": "48e748ba-bef9-4351-8e73-67412f7d9811",
                                                "sense_id": "a66c0aa0-4f49-3daf-987b-843a39c34ae1",
                                                "text": "In this show, the competitor's identity will remain secret until after the vote."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4826d9e6-70fe-3ee8-8e45-a695e330ede1",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "An equation which always holds true regardless of the choice of input variables."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e168db2d-7eea-4d41-aabd-a31b3178eabe",
                                                "sense_id": "4826d9e6-70fe-3ee8-8e45-a695e330ede1",
                                                "text": "The equation (x+y)(x−y) = x²−y² is an algebraic identity. It is true regardless of the values of x and y."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc406e8e-f7c7-3ce5-a78e-d62a523717b8",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "Any function which maps all elements of its domain to themselves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "be6cdf7b-9fa3-320b-9c59-e9a30f84f7fa",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "An element of an algebraic structure which, when applied to another element under an operation in that structure, yields this second element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52ce82ad-4802-4ece-9946-2955f25c79b1",
                                                "sense_id": "be6cdf7b-9fa3-320b-9c59-e9a30f84f7fa",
                                                "text": "Zero is the identity for the addition of real numbers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1431f939-d5a7-3208-a08c-81630c348e12",
                                        "entry_id": "75e755e2-48f4-3491-9c63-74851bdd10ac",
                                        "glosses": [
                                            "A well-known or famous person."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9beed88-ae76-4cdb-aa92-c7c2b9ef6a97",
                                                "sense_id": "1431f939-d5a7-3208-a08c-81630c348e12",
                                                "text": "The body of a well known old identity named James Conroy […] was found in the water yesterday afternoon…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
