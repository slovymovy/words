{
    "word_family": [
        "vex",
        "vexing"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1848f7d2-ed8d-3547-b91d-c0ad42f377c0",
                    "sense_definition": "The state of being annoyed, irritated, or disappointed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He clenched his fists in <w>vexation</w> and looked up at her impetuously.",
                            "target_lang_translations": {
                                "de": "Er ballte vor <w>Ärger</w> die Fäuste und sah ungestüm zu ihr auf."
                            }
                        },
                        {
                            "text": "She spoke with some <w>vexation</w> because her plans were ruined.",
                            "target_lang_translations": {
                                "de": "Sie sprach mit einigem <w>Verdruss</w>, weil ihre Pläne durchkreuzt worden waren."
                            }
                        }
                    ],
                    "synonyms": [
                        "distress"
                    ],
                    "common_phrases": [
                        "sigh in vexation",
                        "cry in vexation"
                    ],
                    "target_lang_definitions": {
                        "de": "Der Zustand, verärgert, gereizt oder enttäuscht zu sein."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ärger",
                                "target_lang_sense_clarification": "Gefühl der Verärgerung oder Unzufriedenheit"
                            },
                            {
                                "target_lang_word": "Verdruss",
                                "target_lang_sense_clarification": "gehobenes Wort für andauernden Unmut oder Ärger"
                            },
                            {
                                "target_lang_word": "Irritation",
                                "target_lang_sense_clarification": "Gefühl der Verärgerung oder Verwirrung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3dd99ceb-58a3-3051-98c0-1f8c36749cbd",
                    "sense_definition": "A source of annoyance, irritation, or mental distress.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "annoyance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site was a major <w>vexation</w> for the neighbors.",
                            "target_lang_translations": {
                                "de": "Der ständige Lärm von der Baustelle war ein großes <w>Ärgernis</w> für die Nachbarn."
                            }
                        },
                        {
                            "text": "She admitted that she had been a great <w>vexation</w> to her parents during her teenage years.",
                            "target_lang_translations": {
                                "de": "Sie gab zu, dass sie während ihrer Teenagerjahre eine große <w>Plage</w> für ihre Eltern gewesen war."
                            }
                        }
                    ],
                    "synonyms": [
                        "affliction",
                        "grievance"
                    ],
                    "common_phrases": [
                        "constant vexation"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Quelle des Ärgers, der Reizung oder seelischen Belastung."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Ärgernis",
                                "target_lang_sense_clarification": "Umstand oder Sache, die Ärger bereitet"
                            },
                            {
                                "target_lang_word": "Plage",
                                "target_lang_sense_clarification": "große Last oder ständige Quelle des Ärgers"
                            },
                            {
                                "target_lang_word": "Belästigung",
                                "target_lang_sense_clarification": "als störend oder lästig empfundene Einwirkung"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}