                                        "sense_id": "58ae5774-9c22-3613-b6ac-7be5a3b6a5a3",
                                        "entry_id": "66361592-7b4a-3e6b-88d3-705c275ac035",
                                        "glosses": [
                                            "cecha kogoś, kto ma skłonność do uznawania za prawdziwe niesprawdzonych informacji"
                                        ],
                                        "tags": [],
