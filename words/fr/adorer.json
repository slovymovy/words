                            "text": "J'<w>adore</w> écouter de la musique quand je prépare le dîner.",
                            "target_lang_translations": {
                                "en": "I <w>love</w> listening to music while I cook dinner.",
                                "ru": "Я <w>обожаю</w> слушать музыку, когда готовлю ужин.",
                                "nl": "Ik <w>hou ervan</w> om naar muziek te luisteren terwijl ik het avondeten klaarmaak.",
                                "de": "Ich <w>liebe</w> es, beim Kochen des Abendessens Musik zu hören.",
                                "pl": "<w>Uwielbiam</w> słuchać muzyki, kiedy przygotowuję kolację.",
                                "it": "<w>Adoro</w> ascoltare musica mentre preparo la cena.",
                                "cs": "<w>Miluju</w> poslouchat hudbu, když připravuju večeři.",
                                "tr": "Yemek hazırlarken müzik dinlemeye <w>bayılırım</w>.",
                                "es": "Me <w>encanta</w> escuchar música cuando preparo la cena.",
                                "zh": "做晚饭的时候，我<w>喜欢</w>听音乐。"
                            }
                        },
                        {
                            "text": "Les enfants <w>adorent</w> passer leurs vacances au bord de la mer.",
                            "target_lang_translations": {
