                {
                    "sense_id": "af22c2e5-51e6-3361-9d52-f6eaaa5d6337",
                    "sense_definition": "A small burrowing rodent native to North and Central America.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "animal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>gopher</w> dug a long tunnel under the garden.",
                            "target_lang_translations": {
                                "cs": "<w>Gofér</w> vykopal pod zahradou dlouhý tunel."
                            }
                        },
                        {
                            "text": "Farmers often try to keep the <w>gopher</w> away from their crops.",
                            "target_lang_translations": {
                                "cs": "Zemědělci se často snaží udržet <w>goféry</w> dál od své úrody."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Malý hlodavec žijící v norách, původem ze Severní a Střední Ameriky."
