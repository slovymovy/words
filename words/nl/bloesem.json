{
    "word_family": [
        "bloesemen",
        "appelbloesem",
        "kersenbloesem"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f218346d-b217-3087-b86d-45eb657dd32f",
                    "sense_definition": "de bloemen van bomen of struiken, in het bijzonder van vruchtdragende bomen in het voorjaar",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bloesem_plantkunde",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente hangt er prachtige witte <w>bloesem</w> aan de appelbomen.",
                            "target_lang_translations": {
                                "fr": "Au printemps, de magnifiques <w>fleurs</w> blanches couvrent les pommiers."
                            }
                        },
                        {
                            "text": "Veel toeristen maken een fietstocht om de <w>bloesem</w> in de boomgaarden te bewonderen.",
                            "target_lang_translations": {
                                "fr": "De nombreux touristes font une balade à vélo pour admirer la <w>floraison</w> dans les vergers."
                            }
                        }
                    ],
                    "common_phrases": [
                        "witte bloesem",
                        "bloesem aan de bomen"
                    ],
                    "target_lang_definitions": {
                        "fr": "Ensemble des fleurs d'un arbre ou d'un arbuste, en particulier d'un arbre fruitier au printemps."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fleurs",
                                "target_lang_sense_clarification": "d'arbres fruitiers"
                            },
                            {
                                "target_lang_word": "floraison",
                                "target_lang_sense_clarification": "état ou ensemble de fleurs"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "759e4cc2-3b43-374b-a9ed-91f7e31c3270",
                    "sense_definition": "eerste persoon enkelvoud tegenwoordige tijd van <w>bloesemen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bloesemen_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als dichter <w>bloesem</w> ik telkens weer op wanneer de lente begint.",
                            "target_lang_translations": {
                                "fr": "En tant que poète, je <w>m'épanouis</w> à nouveau chaque fois que le printemps commence."
                            }
                        },
                        {
                            "text": "Elk voorjaar <w>bloesem</w> ik van geluk als de zon weer schijnt.",
                            "target_lang_translations": {
                                "fr": "Chaque printemps, je <w>rayonne</w> de bonheur quand le soleil brille à nouveau."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van bloesemen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Première personne du singulier au présent de l'indicatif du verbe « bloesemen » (fleurir, être en fleurs)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fleuris",
                                "target_lang_sense_clarification": "du verbe fleurir"
                            },
                            {
                                "target_lang_word": "s'épanouis",
                                "target_lang_sense_clarification": "au sens figuré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3a00cd88-5af3-3c52-a2a7-3ca8fdb31253",
                    "sense_definition": "gebiedende wijs van <w>bloesemen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bloesemen_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bloesem</w> en draag vrucht voor iedereen in deze mooie tuin!",
                            "target_lang_translations": {
                                "fr": "<w>Fleuris</w> et porte du fruit pour tout le monde dans ce beau jardin !"
                            }
                        },
                        {
                            "text": "<w>Bloesem</w> nu volop, kleine boom, nu het eindelijk warm genoeg is!",
                            "target_lang_translations": {
                                "fr": "<w>Fleuris</w> pleinement maintenant, petit arbre, car il fait enfin assez chaud !"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van bloesemen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Impératif du verbe « bloesemen » (fleurir)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fleuris",
                                "target_lang_sense_clarification": "impératif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1875f4e5-18d8-3597-9bce-d549f4b8fcd0",
                    "sense_definition": "tweede persoon enkelvoud tegenwoordige tijd (inversie) van <w>bloesemen</w>",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "bloesemen_vorm",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Bloesem</w> je dit jaar ook zo vroeg, vroeg de tuinman aan de boom.",
                            "target_lang_translations": {
                                "fr": "<w>Fleuris</w>-tu aussi si tôt cette année ? demanda le jardinier à l'arbre."
                            }
                        },
                        {
                            "text": "Waarom <w>bloesem</w> je nu al terwijl het buiten nog vriest?",
                            "target_lang_translations": {
                                "fr": "Pourquoi <w>fleuris</w>-tu déjà alors qu'il gèle encore dehors ?"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vervoeging van bloesemen"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Deuxième personne du singulier au présent (forme inversée) du verbe « bloesemen »."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fleuris",
                                "target_lang_sense_clarification": "du verbe fleurir"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}