                    {
                        "form_id": "fd62d5e9-5eff-4f9d-958c-6638632f274c",
                        "entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schurkenstaaten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "glosses": [
                            "Staat, der eine Gefahr für die Weltsicherheit darstellt, da er angeblich den weltweiten Terrorismus durch etwaige Zuwendungen fördert"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "86f7423d-ad25-44be-b18a-d5f0f3480044",
                                "sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                                "text": "„Der Rückgriff auf militärische Gewaltmittel ist nach dieser Doktrin des Weißen Hauses auch deshalb so wichtig, weil man auf diese Weise den Einsatz von Massenvernichtungswaffen durch terroristische Organisationen und \"Schurkenstaaten\" verhindern will, die sich durch die traditionellen Mittel der Diplomatie oder der militärischen Abschreckung nicht beeindrucken lassen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bbf2047-2540-4f91-a328-f5ca0f14d518",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "source_sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "target_lang_word": "rogue nation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9bfa9ded-b48f-4097-acf3-5ffc1e64961d",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "source_sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "target_lang_word": "rogue regime",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9953821b-34b1-4bb0-a672-05f67971bd6d",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "source_sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "target_lang_word": "rogue state",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rogue state",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "81610492-4d5d-35f9-a086-091654bf2430",
                                        "entry_id": "7f865378-4325-3461-a008-d03f852d30d8",
                                        "glosses": [
                                            "A state or nation acting outside of the accepted international norms and policies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65e61539-253b-4300-970c-d69df58f3c0c",
                                                "sense_id": "81610492-4d5d-35f9-a086-091654bf2430",
                                                "text": "In the early 2160s, the Alliance began aggressive colonization of worlds in the Skyllian Verge, much to the dismay of the batarians who had been developing the region for several decades. In 2171, the batarians petitioned the Council to declare the Verge a \"zone of batarian interest\". The Council refused, however, declaring unsettled worlds in the region open to human colonization.\nIn protest, the batarians closed their Citadel embassy and severed official diplomatic relations with the Council, effectively becoming a rogue state. They instigated a proxy war in the Verge by funneling money and weapons to criminal organizations, urging them to strike at human colonies."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64d1aba7-16a2-4052-8b32-cd5519a2ea88",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "source_sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "target_lang_word": "État voyou",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "État voyou",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "069dfc6c-4cb2-3128-9c20-343b2b0d185f",
                                        "entry_id": "1699d9f1-c2f0-34ab-8911-4c3d087ea869",
                                        "glosses": [
                                            "État qui ne respecte pas les lois internationales et soutiendrait le terrorisme."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a47e52d3-71c6-4784-9c0d-e6cefccde565",
                                                "sense_id": "069dfc6c-4cb2-3128-9c20-343b2b0d185f",
                                                "text": "Lors de son discours devant l’Assemblée générale de l’Organisation des Nations Unies (ONU) du 19 septembre 2017, Donald Trump a remis au goût du jour le concept « d’États voyous », en évoquant la Corée du Nord, l’Iran, la Syrie et le Venezuela."
                                            },
                                            {
                                                "example_id": "4ef3f6ab-cf0c-44ec-8645-4bf29f64c950",
                                                "sense_id": "069dfc6c-4cb2-3128-9c20-343b2b0d185f",
                                                "text": "Les circonstances ont vite fait de mettre au ban la Chine de Xi Jinping. Pour nos concitoyens, le pays de Mao est désormais à classer dans les États voyous.\nL’expression sous-entend un État qui ne respecte pas les lois internationales, soutient des attentats ou viole systématiquement les droits de la personne les plus élémentaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c13decc6-c510-421c-9815-f212cf8f4510",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
                        "source_sense_id": "d945f265-1628-3747-97f6-33d5864f2b46",
                        "target_lang_word": "schurkenstaat",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schurkenstaat",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "abaa82da-8a90-3a91-beeb-3e3cdce61249",
                                        "entry_id": "0321ed43-8379-37a2-bbc7-71a241701d54",
                                        "glosses": [
                                            "een staat die zich onfatsoenlijk gedraagt en zich niets aantrekt van internationale verdragen"
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6fe338dc-4c7b-446b-b1c3-7bd2caf3da70",
                                                "sense_id": "abaa82da-8a90-3a91-beeb-3e3cdce61249",
                                                "text": "Op de Iraanse televisie liet Rohani ook verstaan er niet mee gediend te zijn dat hij door zijn Amerikaanse evenknie opnieuw een ‘schurkenstaat’ te zijn genoemd. ‘Dat zijn beledigingen en valse beschuldigingen’, klonk het. Donald Trump is volgens Rohani dan ook bezig zichzelf te isoleren."
                                            },
                                            {
                                                "example_id": "6b51145d-9915-49ab-9318-4fac0eea218c",
                                                "sense_id": "abaa82da-8a90-3a91-beeb-3e3cdce61249",
                                                "text": ",,Noord-Korea toont zich in woorden en daden zeer vijandig en gevaarlijk tegenover de Verenigde Staten, schreef Trump gisteren op Twitter. ,,Het is een schurkenstaat die een blamage vormt voor China, dat probeert te helpen maar met weinig succes."
                                            },
                                            {
                                                "example_id": "913af501-d104-4fba-8275-05b2e2dfab03",
                                                "sense_id": "abaa82da-8a90-3a91-beeb-3e3cdce61249",
                                                "text": "„Ik heb er daar op gewezen dat Nederlandse pensioenfondsen benadeeld worden door die Amerikaanse beheerders, maar dat leeft niet echt in Den Haag. Ik vind de Verenigde Staten gewoon een financiële schurkenstaat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6debdb65-3012-455e-80f8-dad39d247ece",
                        "source_entry_id": "2e8f21f9-ad43-328e-8ece-a80bbfac287d",
