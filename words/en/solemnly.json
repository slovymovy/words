                    "semantic_group_id": "serious_manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge <w>solemnly</w> declared the defendant guilty after reviewing all the evidence.",
                            "target_lang_translations": {
                                "tr": "Yargıç, tüm kanıtları inceledikten sonra sanığın suçlu olduğunu <w>ciddiyetle</w> açıkladı."
                            }
                        },
                        {
                            "text": "They <w>solemnly</w> promised to support each other through every challenge they might face.",
                            "target_lang_translations": {
                                "tr": "Karşılaşabilecekleri her zorlukta birbirlerini destekleyeceklerine <w>ciddiyetle</w> söz verdiler."
                            }
                        }
                    ],
                    "synonyms": [
                        "hallowedly",
                        "hallowly"
                    ],
                    "common_phrases": [
                        "solemnly swear",
                        "solemnly promise",
                        "solemnly declare"
                    ],
                    "target_lang_definitions": {
                        "tr": "Ciddi, resmi ve ağırbaşlı bir tavırla."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "ciddiyetle",
