                "senses": [
                    {
                        "sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                        "entry_id": "4bc19b04-9f36-3055-ad16-d142d6113496",
                        "glosses": [
                            "iemand wiens taak het is de wet te handhaven en overtreders in de kraag te grijpen"
                        ],
                        "tags": [
                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "a62d24ec-7765-4084-8ece-28ffef1eba9f",
                                "sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                                "text": "Hij wilde politieman worden."
                            },
                            {
                                "example_id": "9068e350-426b-4aef-bf47-bcf9a6766f88",
                                "sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                                "text": "Tv-zender CNN vatte Obama’s woorden op als een aansporing voor jongeren om te blijven protesteren tegen het politiegeweld. Aanleiding voor de dagenlange protesten in Amerikaanse steden is de dood van de zwarte George Floyd, die in Minneapolis door verstikking om het leven kwam doordat hij minutenlang bekneld werd door de knie van een witte politieman."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "291009d4-9047-42e2-99c1-67fc63d8adea",
                        "source_entry_id": "4bc19b04-9f36-3055-ad16-d142d6113496",
                        "source_sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                        "source_sense_description": "iemand wiens taak het is de wet te handhaven en overtreders in de kraag te grijpen",
                        "target_lang_word": "Polizeibeamter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizeibeamter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                        "entry_id": "86f77a86-9cf5-3466-b2b9-afb496e201df",
                                        "glosses": [
                                            "Beamter bei der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9e8db3f-49fa-4788-9dc5-e07ee440b0da",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "Der Polizeibeamte konnte den Täter auf frischer Tat erwischen."
                                            },
                                            {
                                                "example_id": "beefcb45-18ee-44b7-bcaa-efbba8d2199e",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Im Frühjahr 2014 wurde eine Reportage über Gewalt und Respektlosigkeit gegenüber Polizeibeamten im Fernsehen gezeigt.“"
                                            },
                                            {
                                                "example_id": "0a8d45f0-89b6-43e3-bef5-b78f5263754e",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Bei Vernehmungen haben die Angeklagten inzwischen ausgesagt, dass Patrick, die Nummer zwei in der Hierarchie, immer wieder mal von Polizeibeamten über geplante Einsätze informiert worden sei.“"
                                            },
                                            {
                                                "example_id": "aeb4257b-3478-4828-b97b-5f4b96764409",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Eigil erhob sich, als er sah, wie die beiden Polizeibeamten auf das Grab zukamen.“"
                                            },
                                            {
                                                "example_id": "4f161c9a-ce92-46fc-81ac-0494fe075d95",
                                                "sense_id": "ff4cc5b4-c778-3a89-8793-78ffc22c8877",
                                                "text": "„Ich fing wirklich an, mir die Möglichkeit zu denken, daß ich einen Polizeibeamten vor mir hätte, darum antwortete ich auch der Wahrheit gemäß, daß ich aus Finnland käme.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e9ca48e6-2e4e-4739-ac49-90bf4dbd58cd",
                        "source_entry_id": "4bc19b04-9f36-3055-ad16-d142d6113496",
                        "source_sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                        "source_sense_description": "iemand wiens taak het is de wet te handhaven en overtreders in de kraag te grijpen",
                        "target_lang_word": "Polizist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polizist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                        "entry_id": "4e0b0e4d-ce09-3c07-b95e-829afca8bbb7",
                                        "glosses": [
                                            "Angehöriger der Polizei"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "573a6e95-efd0-4288-8b32-5518642bd897",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Die Polizisten verhafteten 21 gewalttätige Demonstranten."
                                            },
                                            {
                                                "example_id": "2ed6e61a-9a8a-47e2-8796-4ba0dab04ea3",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "Zu den bizarren Pointen der furchtbaren Terrorserie in Frankreich zählt aber auch die Tatsache, dass Muslime nicht nur Täter und Opfer, sondern auch Helden geworden sind. Am Mittwoch war es der Polizist Ahmed Merabet, ein 42-jähriger muslimischer Familienvater, den die terroristischen Kouachi-Brüder brutal ermordeten."
                                            },
                                            {
                                                "example_id": "cb549a3e-613b-4b88-9410-e6886a0b8b23",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Im März 1954 treiben Aufständische 30 Polizisten zusammen, sperren sie in ein Haus und zünden es an.“"
                                            },
                                            {
                                                "example_id": "4c43b5b6-68ea-468d-a341-038de7ac6bd7",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Einer der Polizisten schob sie heftig zur Seite, und sie bekam vor Angst weiche Knie.“"
                                            },
                                            {
                                                "example_id": "eeb75324-6e61-48b5-9a2c-546cd4b03963",
                                                "sense_id": "c2b70701-d170-39a8-98d9-e50d2df5b646",
                                                "text": "„Ein junger Polizist eilte den Gang herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41115003-c1b9-4239-8254-ff50da8c4f65",
                        "source_entry_id": "4bc19b04-9f36-3055-ad16-d142d6113496",
                        "source_sense_id": "39e7317e-0f05-38bf-9c66-21f140367fd3",
                        "source_sense_description": "iemand wiens taak het is de wet te handhaven en overtreders in de kraag te grijpen",
                        "target_lang_word": "policeman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "policeman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "A police officer, usually a male."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24379d2b-dc87-4a27-b67c-5faa85887f3d",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "The policeman who arrests the \"Red\" does not understand the theories the \"Red\" is preaching; if he did, his own position as bodyguard of the monied class might seem less pleasant to him."
                                            },
                                            {
                                                "example_id": "93617855-7138-4600-936c-a7540f86d798",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "Meanwhile Nanny Broome was recovering from her initial panic and seemed anxious to make up for any kudos she might have lost, by exerting her personality to the utmost. She took the policeman's helmet and placed it on a chair, and unfolded his tunic to shake it and fold it up again for him."
                                            },
                                            {
                                                "example_id": "a9eac769-d510-4e14-b7b2-c68572a22dc6",
                                                "sense_id": "60fb2557-7905-3791-bbae-743b823d4284",
                                                "text": "Still agitated, she watched resentfully as two traffic policemen remounted their motorcycles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a198f39c-877d-3ad4-a59a-3c16d2f990fd",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "A glass rod capped at one end with rubber, used in a chemistry laboratory for gravimetric analysis."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c613385-770d-313b-b0ba-7c5ea4be5d58",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
                                            "Any skipper of the genus Coeliades."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc384f96-4702-332f-821f-cbdf87167c60",
                                        "entry_id": "972b91a3-adef-34f2-88f6-d707caf5d56e",
                                        "glosses": [
