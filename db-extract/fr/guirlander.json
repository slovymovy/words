                ],
                "senses": [
                    {
                        "sense_id": "64bd14fb-c8c5-39ca-90b2-904fa6570d02",
                        "entry_id": "1295f0ac-f35c-3efb-ab7c-86ca01345376",
                        "glosses": [
                            "Décorer de guirlandes."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7d07b01e-c30a-416b-a629-8d5d8804e4bd",
                                "sense_id": "64bd14fb-c8c5-39ca-90b2-904fa6570d02",
                                "text": "Je veux (si vous m'aidez) élever son Trophée,\nEt guirlander son chef de mille et mille fleurs."
                            },
                            {
                                "example_id": "bd27df0d-9838-4a93-bcf5-c75d45a443ca",
                                "sense_id": "64bd14fb-c8c5-39ca-90b2-904fa6570d02",
                                "text": "Ses vrilles délicates lui font seulement chercher l'appui, ou d'une fleur plus forte qu'elle, ou d'un tuyau de seigle qu'elle semble guirlander."
                            },
                            {
                                "example_id": "8a85d5d9-92ee-4ec4-a4f9-4711a23af6ea",
                                "sense_id": "64bd14fb-c8c5-39ca-90b2-904fa6570d02",
                                "text": "Durant quatre mortelles heures nous n’aperçûmes que des bruyères guirlandées de bois, des friches à peine écrêtées, des semences de blé noir et d’indigentes avenières."
                            },
                            {
                                "example_id": "043c8320-66b7-43a0-a137-041c232c42f7",
                                "sense_id": "64bd14fb-c8c5-39ca-90b2-904fa6570d02",
                                "text": "Les femmes, au teint blanc et reposé, rappellent les types chers à Gérard Dow, et font penser à ces jolies têtes de ménagères que l’on voit dans les musées, encadrées par une fenêtre guirlandée d’une brindille de liseron, d’une grâce si calme, si intime et si douce, qu’elles vous donnent envie de les épouser."
                            }
                        ]
                    }
                ],
