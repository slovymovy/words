                "senses": [
                    {
                        "sense_id": "9de9770e-8412-3057-8d86-aa3447eda576",
                        "entry_id": "348d4cc3-3a5f-31d4-b92a-6a96b55b1c81",
                        "glosses": [
                            "Einstellung, das Wohlergehen anderer über das eigene zu stellen; selbstlose Haltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb53b232-1627-4485-a12d-e1b01faea392",
                                "sense_id": "9de9770e-8412-3057-8d86-aa3447eda576",
                                "text": "„Diese Großherzigkeit äußert sich vor allem denen gegenüber, die schwächer sind, die Not leiden, die unsere Hilfe brauchen.“"
                            },
                            {
                                "example_id": "35ab2411-46ff-44f9-a828-45874d04d549",
                                "sense_id": "9de9770e-8412-3057-8d86-aa3447eda576",
                                "text": "„Wer sich durch Großherzigkeit vortut – wie du damals Mallika, als du mir den ganzen Reis gabst – der wird Reichtum ernten, und wer eine Meisterin der Neidlosigkeit ist, diese wird mächtig werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
