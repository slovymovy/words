                    "sense_definition": "Demande vive, réitérée et pressante faite auprès de quelqu'un.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sollicitation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a finalement accepté la proposition sur les <w>instances</w> de toute son équipe."
                        },
                        {
                            "text": "Elle a fini par céder aux <w>instances</w> de ses amis et s'est jointe au voyage."
                        }
                    ],
                    "synonyms": [
                        "insistance",
                        "prière",
                        "sollicitation"
                    ],
                    "common_phrases": [
