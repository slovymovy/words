                        ],
                        "examples": [
                            {
                                "example_id": "0ab8b50a-bac2-46c9-a556-90c801a7b21d",
                                "sense_id": "82f97b70-bba8-3b40-96ed-e1d6c7296dc9",
                                "text": "[It] comprises the out-parishes of Holy Trinity, St. James and Peter, the parishes of Cawn, St. Rumbold Motcomb, East Stower, Stower Provost, Todbere, Melbury Abbas, Compton Abbas[.]"
                            }
                        ]
