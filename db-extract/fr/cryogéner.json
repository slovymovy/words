                ],
                "senses": [
                    {
                        "sense_id": "7b90817e-3602-3b90-b7a9-1b54ceb01cf2",
                        "entry_id": "25b692ea-6100-3f67-9193-7b0ed5e560f6",
                        "glosses": [
                            "Conserver (un être humain ou un animal) à une température très froide, en espérant le faire revivre ultérieurement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e171afb1-4792-4b87-80c8-6f734d415885",
                                "sense_id": "7b90817e-3602-3b90-b7a9-1b54ceb01cf2",
                                "text": "Pour effacer la Mort, elles inventèrent des bricolages : cryogéner le corps des disparus ; elles imaginèrent des sciences neuves : la thanatologie ; elles remirent à la mode la métempsychose."
                            },
                            {
                                "example_id": "285bb8a7-8dc6-4e43-99ea-3b53a12608e9",
                                "sense_id": "7b90817e-3602-3b90-b7a9-1b54ceb01cf2",
                                "text": "Tu es resté cinquante ans dans ton caveau, Rule. Irradié, mais sauvé par le froid. Cryogéné."
                            },
                            {
                                "example_id": "8eff2ab2-7737-4d37-aa54-dfc0222da567",
                                "sense_id": "7b90817e-3602-3b90-b7a9-1b54ceb01cf2",
                                "text": "Des gens font cryogéner leur corps (parfois seulement leur tête), dans l’attente que les progrès de la science (et de la rationalisation) leur permettent un jour de revenir à la vie."
                            }
                        ]
                    }
                ],
