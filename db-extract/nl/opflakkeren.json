        "nl-extract.jsonl": [
            {
                "entry_id": "c14993eb-ef28-3015-9fef-33be8d64a8d9",
                "word": "opflakkeren",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "75b993fb-7c6e-3f97-9bfd-626f9ed3aaa9",
                        "entry_id": "c14993eb-ef28-3015-9fef-33be8d64a8d9",
                        "glosses": [
                            "plotseling weer heftig gaan branden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a09589f-4c10-494e-8633-529081b8facb",
                                "sense_id": "75b993fb-7c6e-3f97-9bfd-626f9ed3aaa9",
                                "text": "Beelden op de televisiezender Globovision toonden een dichte zwarte rookpluim en vlammen die opflakkeren vanachter een schijnbaar onbeschadigd gebouw."
                            },
                            {
                                "example_id": "bb5b0f1a-8751-4f38-8a33-175fdd99e775",
                                "sense_id": "75b993fb-7c6e-3f97-9bfd-626f9ed3aaa9",
                                "text": "De brand werd vanochtend 'onder controle verklaard' nadat de aanwezige brandweerlieden de voorbije nacht op het terrein geen nieuwe vlammen zagen opflakkeren of rookontwikkeling opmerkten, luidt het in een verklaring."
                            }
                        ]
                    },
                    {
                        "sense_id": "ee3f60c9-b295-3361-9e6d-d4eb64ae684a",
                        "entry_id": "c14993eb-ef28-3015-9fef-33be8d64a8d9",
                        "glosses": [
                            "vanuit een rustige situatie weer heel actief worden, met name van gevoelens en hartstochten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f23511b-97db-424a-8d12-5fd5374a4187",
                                "sense_id": "ee3f60c9-b295-3361-9e6d-d4eb64ae684a",
                                "text": "Maar een makkelijk gegeven strafschop (hands) deed de onrust in het City of Manchester Stadium, waar de niet-speelgerechtigde Nigel de Jong op de tribune zat, vijf minuten later alweer opflakkeren."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fedf79fc-e3b6-4317-9d5c-63052fee29a7",
                        "source_entry_id": "c14993eb-ef28-3015-9fef-33be8d64a8d9",
                        "source_sense_id": "75b993fb-7c6e-3f97-9bfd-626f9ed3aaa9",
                        "source_sense_description": "plotseling weer heftig gaan branden",
                        "target_lang_word": "flare up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "flare up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d4a6c6f-8d4e-3048-94e5-b4e7b5b193da",
                                        "entry_id": "020deb56-15db-33ed-9ea7-f54fadfdb5c0",
                                        "glosses": [
                                            "To burn brightly again."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ee80d3a-3a4b-484a-bd86-5ab5e2e72129",
                                                "sense_id": "7d4a6c6f-8d4e-3048-94e5-b4e7b5b193da",
                                                "text": "The fire flared up after we added more wood to it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3545bdc3-c61d-3535-b5a9-15e1c606e04f",
                                        "entry_id": "020deb56-15db-33ed-9ea7-f54fadfdb5c0",
                                        "glosses": [
                                            "To become more intense suddenly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87282c9b-46bb-498d-9b02-8f0bbf486256",
                                                "sense_id": "3545bdc3-c61d-3535-b5a9-15e1c606e04f",
                                                "text": "Reports indicate that tensions have flared up in the Middle East again."
                                            },
                                            {
                                                "example_id": "3705cf59-9138-4866-a521-c669f7090cc2",
                                                "sense_id": "3545bdc3-c61d-3535-b5a9-15e1c606e04f",
                                                "text": "The pain in my shoulder flares up when I turn my head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff5f017a-f3d2-3d32-8220-c6cd6e6f966e",
                                        "entry_id": "020deb56-15db-33ed-9ea7-f54fadfdb5c0",
                                        "glosses": [
                                            "To burst out suddenly, as in anger."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7e2b4a35-912b-4ca8-aae1-ba16fef4b188",
                                                "sense_id": "ff5f017a-f3d2-3d32-8220-c6cd6e6f966e",
                                                "text": "The insult made him flare up."
                                            },
                                            {
                                                "example_id": "88f160f6-a1dd-4261-960a-600d28edf61a",
                                                "sense_id": "ff5f017a-f3d2-3d32-8220-c6cd6e6f966e",
                                                "text": "“Well,” I says, “I cal'late a body could get used to Tophet if he stayed there long enough.” ¶ She flared up; the least mite of a slam at Doctor Wool was enough to set her going."
                                            },
                                            {
                                                "example_id": "78822571-24b6-4f0a-aa22-91f5de1f1593",
                                                "sense_id": "ff5f017a-f3d2-3d32-8220-c6cd6e6f966e",
                                                "text": "\"It's my Welsh half that comes out when I flare up. Let the conjurors take their dirty money and let the rich folk keep their purses shut.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "flare up",
