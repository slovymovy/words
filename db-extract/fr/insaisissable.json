        "fr-extract.jsonl": [
            {
                "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                "word": "insaisissable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "332177a1-bb8e-49e3-87c9-dc61ec5a098b",
                        "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "insaisissables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "88f384d1-da2b-35a2-bd8c-21f119dd5a50",
                        "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "glosses": [
                            "Que l’on ne peut saisir valablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a87da47-9e09-4261-81a8-897730f14529",
                                "sense_id": "88f384d1-da2b-35a2-bd8c-21f119dd5a50",
                                "text": "Certains objets sont déclarés insaisissables par la loi : Une pension insaisissable ou une rente viagère stipulée insaisissable."
                            }
                        ]
                    },
                    {
                        "sense_id": "3102fb19-1389-3d35-acf9-b3adaa3e2b12",
                        "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "glosses": [
                            "Dont on ne parvient pas à s’emparer."
                        ],
                        "tags": [
                            "common"
                        ],
                        "examples": [
                            {
                                "example_id": "48158d64-c99c-4f1d-8de0-7b71ec1c43ad",
                                "sense_id": "3102fb19-1389-3d35-acf9-b3adaa3e2b12",
                                "text": "Les fells rôdaient, insaisissables ; on les croyait ici, ils apparaissaient plus loin ; on partait les y chercher, ils se trouvaient ailleurs."
                            },
                            {
                                "example_id": "cc9e092f-b388-4a28-8069-edd3f88379e6",
                                "sense_id": "3102fb19-1389-3d35-acf9-b3adaa3e2b12",
                                "text": "Nous en avons assez de ce jeu de cache-cache. Depuis des mois que nous grenouillons sur les pistes et dans les marais en croisant sans arrêt les traces d'une bande de fellouzes insaisissables."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ca48c84-bf87-3936-9279-2666efde9bff",
                        "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "glosses": [
                            "Qui ne peut être saisi par l’esprit."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "55d5b0e3-db98-4f1c-922e-8fca2a5dbe45",
                                "sense_id": "1ca48c84-bf87-3936-9279-2666efde9bff",
                                "text": "J’avoue que, pour moi, cette différence est tout à fait insaisissable."
                            }
                        ]
                    },
                    {
                        "sense_id": "c692c337-e480-35a7-bfdc-b4ba51151750",
                        "entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "glosses": [
                            "Qualifie une personne si occupée, si affairée que l’on ne peut avoir un entretien avec elle ni même la rencontrer."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "56a1ea09-a6d5-4422-b282-aefac92c49f0",
                        "source_entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "target_lang_word": "unfassbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unfassbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a4e19ea3-1c05-378a-9f2c-b0d9b082284f",
                                        "entry_id": "c291dca7-38b5-3d7f-adbb-151e8088d3cb",
                                        "glosses": [
                                            "nicht oder nur schwer verständlich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22917e6d-13a9-4520-8b75-02319295d820",
                                                "sense_id": "a4e19ea3-1c05-378a-9f2c-b0d9b082284f",
                                                "text": "\"Unfassbar! Dazu fällt mir nichts mehr ein\", lautete auch das Fazit eines weiteren Börsianers."
                                            },
                                            {
                                                "example_id": "afef5563-a7b7-4a81-bc2c-f681023dfca0",
                                                "sense_id": "a4e19ea3-1c05-378a-9f2c-b0d9b082284f",
                                                "text": "Nur der Massenselbstmord kann durch generelle Theorien erhellt werden. Ansonsten bleibt das Unfassbare unfassbar."
                                            },
                                            {
                                                "example_id": "37abfbf3-a79d-4d3a-8308-1c50e4a8545c",
                                                "sense_id": "a4e19ea3-1c05-378a-9f2c-b0d9b082284f",
                                                "text": "Für Justus ist Onkel Siem unangefochtene Bezugsperson – lebensfroh und unkompliziert überspringt er alle Hürden des Lebens. Umso unfassbarer scheint es, dass Siem sich eines Tages das Leben nimmt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "043ec718-f440-3e3d-8f69-0e3db2ddc2ec",
                                        "entry_id": "c291dca7-38b5-3d7f-adbb-151e8088d3cb",
                                        "glosses": [
                                            "nicht oder nur schwer glaubhaft oder vorstellbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f2ecff57-8177-471d-8b10-56c1c8be5014",
                                                "sense_id": "043ec718-f440-3e3d-8f69-0e3db2ddc2ec",
                                                "text": "Begreift man nun, welch ein unfassbares Wunder das Auge ist, das ohne Instrument noch den Stern zu sehen vermag, dessen Licht einen Weg von vielen Billionen Meilen zurücklegen muss?"
                                            },
                                            {
                                                "example_id": "469ee322-8a1b-45bd-a4ab-c876579671b4",
                                                "sense_id": "043ec718-f440-3e3d-8f69-0e3db2ddc2ec",
                                                "text": "Auch wenn sie „unfassbar fotogen“ sei, wäre Plassnik als Spitzenkandidatin leichter zu besiegen als der alte Polithase Molterer, philosophiert man in der Umgebung des roten Kanzlers."
                                            },
                                            {
                                                "example_id": "cbe0ba7c-85b9-4a8e-9bb3-9206e3dffb10",
                                                "sense_id": "043ec718-f440-3e3d-8f69-0e3db2ddc2ec",
                                                "text": "»Nach der neuerlichen unfassbaren Panne können wir nicht davon ausgehen, dass die Sicherheit von Stephanie bei der Zeugenaussage gewährleistet ist«, sagte Opferanwalt Thomas Kämmer, der für die Nebenklage arbeitet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a6f57b6-d683-411d-acc6-390e5fd3d2a1",
                        "source_entry_id": "1200f239-19d9-3ffb-bcfa-80cf2d8b8c07",
                        "target_lang_word": "unseizable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unseizable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "02c53135-8699-3527-8ba3-82c1715c7df7",
                                        "entry_id": "6f6c4721-a542-3718-88b6-0afc75d6385f",
                                        "glosses": [
                                            "That cannot be seized or grasped."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f4cc8da-2ede-4e4c-8d67-132df19a21d2",
                                                "sense_id": "02c53135-8699-3527-8ba3-82c1715c7df7",
                                                "text": "A large packet of 'Text Books'--left for that purpose by Norrish, if the truth were known-- whose covers were the same color as those of the 'Fruits', attracted Mr. Outram's attention, and he took off some of the brown paper wrapper, but found the goods unseizable."
                                            },
                                            {
                                                "example_id": "30978574-998b-43bb-bff5-c0447c954f1f",
                                                "sense_id": "02c53135-8699-3527-8ba3-82c1715c7df7",
                                                "text": "He eluded all pursuit, and his name--or at least the name he gave himself--was known all over the world, and inspired horror and terror everywhere, as being that of a legendary personage, a bogey, invisible and unseizable."
                                            },
                                            {
                                                "example_id": "afdd04c8-19df-4eef-8563-bfb94f79419e",
                                                "sense_id": "02c53135-8699-3527-8ba3-82c1715c7df7",
                                                "text": "For a moment she was lost in the pursuit of an unseizable clue--the explanation of this monstrous last perversity of fate."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
