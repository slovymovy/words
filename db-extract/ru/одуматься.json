                    },
                    {
                        "translation_id": "84df9659-ae1b-4cf6-8e81-e3bf599b8263",
                        "source_entry_id": "a3263465-f868-3f74-8286-5c169d62473c",
                        "source_sense_id": "9e4b4b89-0bfb-36bf-92e8-35252079e5e5",
                        "target_lang_word": "réfléchir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "réfléchir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                        "entry_id": "0a55fe4d-3d02-3499-b12c-8ea49c0165c5",
                                        "glosses": [
                                            "Renvoyer les rayons lumineux, caloriques, sonores, qui ont été reçus."
                                        ],
                                        "tags": [
                                            "Optique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f99e6bf6-0ad6-4e03-97c2-569d437aa870",
                                                "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                                "text": "Ce mur réfléchit la voix."
                                            },
                                            {
                                                "example_id": "2fb0283b-e240-4d74-a354-7415cef6c484",
                                                "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                                "text": "Les miroirs réfléchissent l’image des objets."
                                            },
                                            {
                                                "example_id": "7df376f3-5011-40a6-aacc-c65198f04eba",
                                                "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                                "text": "Tous les corps polis réfléchissent la lumière, les rayons lumineux."
                                            },
                                            {
                                                "example_id": "8bcd8211-89be-4669-b9a0-05809cc37d3b",
                                                "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                                "text": "Son image se réfléchissait dans l’eau."
                                            },
                                            {
                                                "example_id": "c72e4f1d-0289-456d-8334-081f731a141a",
                                                "sense_id": "f0eed0fd-fe96-3630-96b3-9982547d5c3a",
                                                "text": "Le son a, comme la lumière, la propriété de se réfléchir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3dd5cc1-58ea-322a-934f-2500143c0695",
                                        "entry_id": "0a55fe4d-3d02-3499-b12c-8ea49c0165c5",
                                        "glosses": [
                                            "Reporter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a30cad7-b6bf-4016-8e6c-a09e6d8d34bb",
                                                "sense_id": "a3dd5cc1-58ea-322a-934f-2500143c0695",
                                                "text": "L’action du verbe se réfléchit quelquefois sur le sujet. exemples : Je me repens., Vous vous moquez., Il se tourmente., Etc. Le verbe s’appelle alors Verbe réfléchi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                        "entry_id": "0a55fe4d-3d02-3499-b12c-8ea49c0165c5",
                                        "glosses": [
                                            "Penser longuement, mûrement à quelque chose."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e72742f8-b7a9-4e55-ab05-5be78d15a815",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "Mais on s’expliquera facilement cette particularité si l’on réfléchit que les minerais de fer, qui sont presque toujours à l’état terreux et présentent très rarement l’éclat métallique, n’avaient rien qui les signalât à l’attention des premiers hommes."
                                            },
                                            {
                                                "example_id": "68a250b3-e1d0-4d33-8e39-6c9c310b514c",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "En réfléchissant différemment sur l’installation des équipements, en refusant d’utiliser les équipements disponibles sur étagère, en traquant les poids inutiles, nous avons réussi à gagner 300 kilos sur le bateau proposé par les architectes."
                                            },
                                            {
                                                "example_id": "697e1ff1-ce69-45a8-8cae-ec30c945e3fc",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "Coincée dans un wagon, les bras encombrés par l’immense présent d’Alicia, je réfléchissais à toute vitesse et les questions sans réponses se bousculaient au portillon."
                                            },
                                            {
                                                "example_id": "180af54c-ea71-441e-962d-294b783d0eee",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "Agir comme un connard irresponsable ne me ressemble pas. Ce n'est pas moi. Mes valeurs auraient dû me pousser à réfléchir davantage avant de devenir le raté qui me fixe chaque matin dans le miroir."
                                            },
                                            {
                                                "example_id": "bd7caffe-f2de-4c2c-9773-89f0ee1dcc4b",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "On découvre des acteurs qui signent des tribunes sans réfléchir, comme ils gribouillent des autographes avant de monter les marches du Festival de Cannes, […]."
                                            },
                                            {
                                                "example_id": "e9e0f121-3a20-49cb-a04a-30142ac4a576",
                                                "sense_id": "6074d29a-051d-368e-84fa-619ccadfc79d",
                                                "text": "À Mulhouse, Mehdi inverse le problème : « Plutôt que d’agrandir les places de parking, et donc de limiter leur nombre, il vaut mieux inciter les gens à réfléchir avant leur achat : comment vont-ils garer leur véhicule ? »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
