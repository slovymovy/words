                                    {
                                        "sense_id": "0c41f040-ef9e-3406-943f-e4f7ecf98b6d",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The heat produced by the natural processes of the Earth, including heat from the undercrust, plate tectonics, volcanism, and other sources."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e27e8c1b-56e8-3989-bdf3-0d27555c0462",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The process and practice of harvesting heat produced by the Earth to be used as an energy source."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                        "entry_id": "841694ca-7e67-3ee3-8943-fc7bcd281f8e",
                                        "glosses": [
                                            "The study of heat produced naturally by the Earth, usually considered a subdiscipline of geophysics."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52344a10-95e0-46a9-b4ac-da958cfe4f93",
                                                "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                                "text": "A method was worked out by the Geothermy Laboratory of the O. Yu. Schmidt institute of Earth Physics (Lyubimova et al., 1964 b) which utilizes the principles of heat convection from a momentary linear source (Tikhonov, Samarskiy, 1953)."
                                            },
                                            {
                                                "example_id": "3b7ffa1d-0c8c-47c3-9ee4-400db3e82067",
                                                "sense_id": "93c72f0b-eb07-325b-a365-2e7b850899fa",
                                                "text": "However, in geothermy, as in any other area of geophysics, it is often necessary to solve an inverse problem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
