                        "entry_id": "18d66f0f-ae76-3e88-85ff-bc9d82a6a66c",
                        "glosses": [
                            "Qualité de ce qui est convertible."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "20188623-0e6b-4a5d-8e6f-911c9975dbea",
                                "sense_id": "c743604a-b2cd-3c53-a2e9-215e111e4b32",
                                "text": "En vertu de la convertibilité de l’être et de l’un, si un universel existe hors de notre esprit comme l'humanité, il devrait être unique en son espèce."
                            }
                        ]
                    },
                    {
                        "sense_id": "c9bc4ac7-821e-3241-8f98-e8ca472bb1ba",
                        "entry_id": "18d66f0f-ae76-3e88-85ff-bc9d82a6a66c",
                        "glosses": [
                            "Qualité de ce qui est convertible.",
                            "Possibilité de changer une monnaie pour une autre."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": [
                            {
                                "example_id": "bf6817da-74ba-4f0f-9459-5e36fcefcbe4",
                                "sense_id": "c9bc4ac7-821e-3241-8f98-e8ca472bb1ba",
                                "text": "Or, jusqu'au 19ème siècle, il y a convertibilité de ces trois valeurs : la monnaie or, de bon aloi, est thésaurisable."
                            }
                        ]
                    }
