        "ru-extract.jsonl": [
            {
                "entry_id": "7b5c5ca6-5900-359e-8dfd-3c4edb707803",
                "word": "периодически",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4a313ef4-cf36-3bb2-982c-7ed647bb2d6e",
                        "entry_id": "7b5c5ca6-5900-359e-8dfd-3c4edb707803",
                        "glosses": [
                            "возникая или повторяясь через определённые промежутки времени"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d609ddd8-9195-47f0-867c-f18046419666",
                                "sense_id": "4a313ef4-cf36-3bb2-982c-7ed647bb2d6e",
                                "text": "Это случалось периодически один или два раза в месяц, потому что тепла даром в трубу пускать не любили и закрывали печи, когда в них бегали ещё такие огоньки, как в «Роберте-Дьяволе»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "87eb83be-894a-4625-8d5e-9d22d0148800",
                        "source_entry_id": "7b5c5ca6-5900-359e-8dfd-3c4edb707803",
                        "source_sense_id": "4a313ef4-cf36-3bb2-982c-7ed647bb2d6e",
                        "target_lang_word": "periodically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "periodically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ea16c3f-5a1a-3b04-8aaa-af5d543dc40d",
                                        "entry_id": "8b06c096-69e0-3f9e-a2cf-129eeb79800a",
                                        "glosses": [
                                            "In a manner that is regular or periodic."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "587598e0-f1cb-45b9-889b-d3b8417f0a38",
                                                "sense_id": "2ea16c3f-5a1a-3b04-8aaa-af5d543dc40d",
                                                "text": "Put two encasings on a mattress if one must be removed periodically for cleaning."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "90d70c7f-a071-3458-9376-df2969b3c397",
                                        "entry_id": "8b06c096-69e0-3f9e-a2cf-129eeb79800a",
                                        "glosses": [
                                            "intermittently or recurrently."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80e9b474-cc04-4923-90b5-5c818f1af857",
                                                "sense_id": "90d70c7f-a071-3458-9376-df2969b3c397",
                                                "text": "The announcement comes amid mounting pressure on university administrators to rein in pro-Palestinian demonstrations, which have erupted periodically on college campuses across the country over the past year and led to the arrest of hundreds of demonstrators."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3581a179-d579-4ddb-8fb9-977c0182d6df",
                        "source_entry_id": "7b5c5ca6-5900-359e-8dfd-3c4edb707803",
                        "source_sense_id": "4a313ef4-cf36-3bb2-982c-7ed647bb2d6e",
                        "target_lang_word": "from time to time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "from time to time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                        "entry_id": "265de215-8422-3464-9233-d0d0aa8ba9ab",
                                        "glosses": [
                                            "Occasionally; sometimes; once in a while."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f80f6f59-e317-4e9a-b383-147a8572619e",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "I'll find out your man, / And he shall signify from time to time / Every good hap to you that chances here."
                                            },
                                            {
                                                "example_id": "7b17a90a-d79a-4077-8356-a090d0dc1588",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "On these red embers Hatteraick from time to time threw a handful of twigs."
                                            },
                                            {
                                                "example_id": "152dd2a8-d111-49b9-91a1-5f061973b81b",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "“A tight little craft,” was Austin’s invariable comment on the matron;[…]. ¶ Near her wandered her husband, orientally bland, invariably affable, and from time to time squinting sideways, as usual, in the ever-renewed expectation that he might catch a glimpse of his stiff, retroussé moustache."
                                            },
                                            {
                                                "example_id": "ae927d8e-33f5-441e-a387-9b60deec8569",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "But at my back from time to time I hear / The sound of horns and motors, […]"
                                            },
                                            {
                                                "example_id": "1ab1c775-bbaa-42ea-b334-954204aa2ee4",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "From time to time in both directions the engine was blowing off, so there was no shortness of steam."
                                            },
                                            {
                                                "example_id": "28430246-db88-47ae-bc38-f6721d849774",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "From time to time the coaches of the Lötschberg Railway itself, which in comfort and décor can rank with the finest in Europe today, travel far from the frontiers of Switzerland on through workings such as these."
                                            },
                                            {
                                                "example_id": "786cd637-d3e5-4b24-b800-fd5a1e9bcca7",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "Despite all the evidence confirming the existence of the Protheans, little is known about their culture and society. From time to time, dig sites will yield new clues, but after 50,000 years of decay, little of value is unearthed."
                                            },
                                            {
                                                "example_id": "404efa5c-6619-4ef7-8c03-c92694e9426f",
                                                "sense_id": "83215a8e-27d9-32de-a268-fe65a2ac909a",
                                                "text": "Life on Earth has developed over billions of years, largely unaffected by the solar storms that wash over our planet from time to time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcfa1d05-3551-3b7a-99c4-ff69a9ac14e0",
                                        "entry_id": "265de215-8422-3464-9233-d0d0aa8ba9ab",
                                        "glosses": [
                                            "In whatever status exists at various times."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "afe92047-ae26-4466-83d4-c268d5af97e2",
                                                "sense_id": "fcfa1d05-3551-3b7a-99c4-ff69a9ac14e0",
                                                "text": "This is another way of saying that the terms of the individual contracts are in part to be found in the agreed collective agreements as they exist from time to time […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1916313-56e9-3fae-9e73-d787f6acd989",
                                        "entry_id": "265de215-8422-3464-9233-d0d0aa8ba9ab",
                                        "glosses": [
                                            "Continuously from one time to another; at all times, constantly."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79e83df1-5295-414a-9753-749f006f20aa",
                                                "sense_id": "f1916313-56e9-3fae-9e73-d787f6acd989",
                                                "text": "So was she trayned vp from time to time, / In all chast vertue, and true bounti-hed / Till to her dew perfection she was ripened."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b1d1508-a388-49a3-84d3-70b1863dff1a",
                        "source_entry_id": "7b5c5ca6-5900-359e-8dfd-3c4edb707803",
                        "source_sense_id": "4a313ef4-cf36-3bb2-982c-7ed647bb2d6e",
