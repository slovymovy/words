                        "entry_id": "ed13613e-46b3-3043-a71e-c5d71cc15c46",
                        "glosses": [
                            "große Gruppe nicht fest organisierter Personen, die die staatliche und gesellschaftliche Anerkennung und Gleichheit von Frauen fordern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f521e024-6f6a-4faf-9611-0f37d9309a4c",
                                "sense_id": "36680e8f-cb20-3443-87a8-8d6f41f41030",
                                "text": "„Es gab politisch links stehende Eugeniker, und das eugenische Gedankengut war auch in der bürgerlichen Frauenbewegung populär.“"
                            },
                            {
                                "example_id": "4396cab1-6567-497c-aadb-cfcdbae2718a",
                                "sense_id": "36680e8f-cb20-3443-87a8-8d6f41f41030",
                                "text": "„Im Rückblick lässt sich behaupten, dass die Hudood-Gesetzgebung die wichtigste Geburtshelferin der pakistanischen Frauenbewegung war.“"
                            }
                        ],
