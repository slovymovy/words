                ],
                "senses": [
                    {
                        "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                        "entry_id": "ae9a3f0f-26f4-34f6-9885-e6344a7f1094",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac248219-e431-402a-b551-8e72d8c23e98",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Frau Kynast ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "54987f1a-4f70-4df2-9f33-57189d79e6b1",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Herr Kynast wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a60e23c0-ddc8-4993-8b04-637c0466288f",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Die Kynasts fahren heute nach Erfurt."
                            },
                            {
                                "example_id": "1ff3d1cd-ccfa-435d-89f3-2097de5332eb",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Der Kynast trägt nie die Pullover, die die Kynast ihm strickt."
                            },
                            {
                                "example_id": "3c5f7e75-d383-4b62-a5c8-fe373794879f",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kynast kommt, geht der Herr Kynast.“"
                            },
                            {
                                "example_id": "da4bc2a9-651c-4580-ba61-3963c4116ec7",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Kynast kommt und geht."
                            },
                            {
                                "example_id": "309c7150-839e-4e9b-8cdb-e2aa48db83ff",
                                "sense_id": "fe5b815e-1065-3791-94f3-d055d2d9b59a",
                                "text": "Kynasts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
