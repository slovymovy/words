        "fr-extract.jsonl": [
            {
                "entry_id": "8393a571-e278-3501-baf8-ff8cb36a9178",
                "word": "zettamètre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "52ed115a-61e5-48f7-94ee-7dc43125e0d6",
                        "entry_id": "8393a571-e278-3501-baf8-ff8cb36a9178",
                        "tags": [
                            "plural"
                        ],
                        "form": "zettamètres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6eb55143-6662-3096-87ff-a3ced0817dd4",
                        "entry_id": "8393a571-e278-3501-baf8-ff8cb36a9178",
                        "glosses": [
                            "Unité de mesure de longueur du Système international (SI), valant 10²¹ mètres, et dont le symbole est Zm."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "869242c1-67ae-41cd-910e-ab2e2f684c77",
                                "sense_id": "6eb55143-6662-3096-87ff-a3ced0817dd4",
                                "text": "L'univers a une taille estimée à 140 yottamètres. Notre galaxie a un diamètre d'environ 1,1 zettamètre. L'étoile Deneb est éloignée de la Terre de 14,6 examètres. Une année-lumière représente une distance de 9,5 pétamètres."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4413f1a6-0226-4518-9749-5798d47844b4",
                        "source_entry_id": "8393a571-e278-3501-baf8-ff8cb36a9178",
                        "source_sense_id": "6eb55143-6662-3096-87ff-a3ced0817dd4",
                        "source_sense_description": "Unité de mesure de longueur",
                        "target_lang_word": "zettametre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zettametre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                        "entry_id": "c94453f5-b79e-34af-936f-5b2325279676",
                                        "glosses": [
                                            "An SI unit of length equal to 10²¹ metres. Symbol: Zm"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b2ed190d-31f5-4bf4-bf39-5dc5fde5a657",
                                                "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                                "text": "Holonyms: yottametre < ronnametre < quettametre"
                                            },
                                            {
                                                "example_id": "15086f7d-f033-46ea-b3a8-0714f9bab908",
                                                "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                                "text": "Meronyms: picometre < nanometre < micrometre < millimetre < centimetre < decimetre < metre < kilometre < megametre < gigametre < terametre < petametre < exametre"
                                            },
                                            {
                                                "example_id": "c5ae45db-11a4-4f89-8593-c31518ec7d2a",
                                                "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                                "text": "The largest known galaxy, at the centre of the Abell 2029 cluster in Virgo, has a diameter of around 53 zettametres."
                                            },
                                            {
                                                "example_id": "1e222c55-9cd2-4eb3-a558-abdef1d518a6",
                                                "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                                "text": "As one of my reviewers (SP Gray) puts it: '...I think that Andromeda will be a good deal closer to the Solar System than it is now, before we read of its distance in zettametres'"
                                            },
                                            {
                                                "example_id": "dc2a20c1-abd3-42b0-b22b-7133c3d6a176",
                                                "sense_id": "33d0f969-cc2a-3585-b77d-3c741686a2f1",
                                                "text": "How many kiloparsecs are there in a zettametre (10²¹ m)?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d405115-6dfb-42ec-bf37-e10dd626cefa",
                        "source_entry_id": "8393a571-e278-3501-baf8-ff8cb36a9178",
                        "source_sense_id": "6eb55143-6662-3096-87ff-a3ced0817dd4",
                        "source_sense_description": "Unité de mesure de longueur",
                        "target_lang_word": "zettameter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zettameter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4d812102-39ea-318b-be56-fca62ef905bc",
                                        "entry_id": "53af680a-fa83-3785-8a86-237b4ddedf4c",
                                        "glosses": [
                                            "US spelling of zettametre."
                                        ],
                                        "tags": [
                                            "US",
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4fd37f40-d2c5-41b2-afee-bf9191c7a7e2",
                                                "sense_id": "4d812102-39ea-318b-be56-fca62ef905bc",
                                                "text": "On the other extreme, our galaxy (we call it the Milky Way) is about 0.9 Zm (Zettameters, 100 million trillion meters) in diameter."
                                            },
                                            {
                                                "example_id": "96f5899f-3bb1-4e3d-9113-846160845950",
                                                "sense_id": "4d812102-39ea-318b-be56-fca62ef905bc",
                                                "text": "What is the speed of light in Zm (zettameters) per second?"
                                            },
                                            {
                                                "example_id": "ec8a6a12-9637-4359-a1a0-b91aa1a5d480",
                                                "sense_id": "4d812102-39ea-318b-be56-fca62ef905bc",
                                                "text": "The size scale for the nuclear chemistry laboratory ranges from zeptometers (10⁻²¹ m) to zettameters (10²¹ m)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
