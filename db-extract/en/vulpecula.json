                        "cross_references": [
                            {
                                "target_word": "Fuchs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "Vertreter einer Gruppe von bestimmten kurzbeinigen Arten der Familie der Hunde (Canidae)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57c7d584-498d-49de-b288-c91bffcc423f",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "Die Tante des Jungen ist schlau wie ein Fuchs."
                                            },
                                            {
                                                "example_id": "9391b3b2-3c5b-4aaa-84a5-9cbc890da8bf",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "„Der graue Hase hatte den Haarwechsel schon zur Hälfte hinter sich, die jungen Füchse vom diesjährigen Wurf schwärmten bereits aus, und die jungen Wölfe waren schon größer als Hunde.“"
                                            },
                                            {
                                                "example_id": "39e751f6-8b10-44cd-a272-fc82ff690b86",
                                                "sense_id": "e9bb6d2d-1e9f-3f7f-9b34-3fef60c0abb0",
                                                "text": "Fuchs, du hast die Gans gestohlen – (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4bd772eb-3206-3a24-824f-812b2ed8419b",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "männlicher Fuchs^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65fcaa6c-c5b6-47c9-a371-ef3d62b2c6a5",
                                                "sense_id": "4bd772eb-3206-3a24-824f-812b2ed8419b",
                                                "text": "Der Fuchs jagt die Fähe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d7631335-6164-3620-8277-41ec31d51db0",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "meist der Rotfuchs, Vulpes vulpes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94ebd22b-8acb-4751-a476-8fc629db4bb6",
                                                "sense_id": "d7631335-6164-3620-8277-41ec31d51db0",
                                                "text": "Fuchs, du hast die Gans gestohlen – (Kinderlied)"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "506c08d7-39a7-3d5f-99df-9dc4fa35df33",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "Pelz des Fuchses"
                                        ],
                                        "tags": [
                                            "Kürschnerei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7001048c-4726-4b7b-b236-483c1e0a2d09",
                                                "sense_id": "506c08d7-39a7-3d5f-99df-9dc4fa35df33",
                                                "text": "Fuchs ist wieder schwer im Kommen!"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "20f352e9-111c-342a-b17a-c21a43af87b7",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "Pferd, bei dem Fell, Mähne und Schweif braun sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3918b81-dfb5-4fc4-a984-a08cb3939265",
                                                "sense_id": "20f352e9-111c-342a-b17a-c21a43af87b7",
                                                "text": "„Welcher Farbe hat er?“ – „Das Pferd ist ein Fuchs.“"
                                            },
                                            {
                                                "example_id": "34461446-bc4b-452e-a5c0-1b72f4f5e81c",
                                                "sense_id": "20f352e9-111c-342a-b17a-c21a43af87b7",
                                                "text": "„Dort erhob Simen Tjing die Hände zum Gruße, ritt nach Hause und ließ sofort den Fuchs durch Dai-an hinführen.“"
                                            },
                                            {
                                                "example_id": "35ac3226-32e9-493f-9108-ce6ce6beaf22",
                                                "sense_id": "20f352e9-111c-342a-b17a-c21a43af87b7",
                                                "text": "„Der eine war in schwarzer Uniform mit weissem Federbusch und ritt einen englisierten Fuchs, der andere trug eine weisse Uniform und sass auf einem Rappen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "af9ce86c-be09-36c0-a378-9517016bdd4a",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "Tagfalter („Kleiner Fuchs“, „Großer Fuchs“)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b27d442-988e-4a2f-be17-4a5eeb60fecf",
                                                "sense_id": "af9ce86c-be09-36c0-a378-9517016bdd4a",
                                                "text": "Während das Pfauenauge Feuchtigkeit liebt, hat der Fuchs es lieber trocken."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "5f2b9758-12df-3a30-8dbd-d8f3a3fbbcf0",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
                                            "ein kluger Mensch („schlauer Fuchs“)"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0690289a-cbd3-48e3-9df3-0ed741ac792a",
                                                "sense_id": "5f2b9758-12df-3a30-8dbd-d8f3a3fbbcf0",
                                                "text": "Müller, der alte Fuchs, hat es wieder einmal geschafft!"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "40934d4a-65be-38c3-ac1c-ca1b602a3b28",
