                "senses": [
                    {
                        "sense_id": "f09cd5d7-d71e-3502-ab5d-ec52b6cc7c19",
                        "entry_id": "c5df61a3-f1ec-344f-91b1-d98afd1ac2be",
                        "glosses": [
                            "eine nach jeder Halbzeit eines Fußballspiels vom Schiedsrichter festgelegte zusätzliche Spielzeit, die Unterbrechungen während des Spiels ausgleicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb2b1fda-0943-407d-ba00-c3038ec5aa05",
                                "sense_id": "f09cd5d7-d71e-3502-ab5d-ec52b6cc7c19",
                                "text": "Erst in der Nachspielzeit gelang es ihnen, nach einer Ecke den Ball über die Linie zu bringen."
                            },
                            {
                                "example_id": "9c4b398f-7444-4aec-b32b-08b1462c61ba",
                                "sense_id": "f09cd5d7-d71e-3502-ab5d-ec52b6cc7c19",
                                "text": "„Doch statt sich mit dem Unentschieden zufrieden zu geben, spielten die Gäste auf Sieg – und der gelang tatsächlich in der vierten Minute der Nachspielzeit durch den eingewechselten Miguel Crespo.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "00327591-3373-4203-ad60-c630ea36a07f",
                        "source_entry_id": "c5df61a3-f1ec-344f-91b1-d98afd1ac2be",
                        "source_sense_id": "f09cd5d7-d71e-3502-ab5d-ec52b6cc7c19",
                        "target_lang_word": "injury time",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "injury time",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96ba4400-3467-3f84-80d0-0397db7b3645",
                                        "entry_id": "832ced1c-93c3-33c5-8ed1-e65eaab9cce8",
                                        "glosses": [
                                            "Additional time played after each period of a game in order to compensate for stoppages due to player injuries; loosely extended to include time added on to compensate for all types of stoppages, i.e. synonymous with stoppage time."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0334c0a9-85d6-4419-a217-be3735454fbe",
                        "source_entry_id": "c5df61a3-f1ec-344f-91b1-d98afd1ac2be",
