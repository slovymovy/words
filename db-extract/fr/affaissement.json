        "fr-extract.jsonl": [
            {
                "entry_id": "99ecc842-1188-35da-85ef-9d9f203bbc3d",
                "word": "affaissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d923aaa7-ea88-4174-befb-4ab362fec7de",
                        "entry_id": "99ecc842-1188-35da-85ef-9d9f203bbc3d",
                        "tags": [
                            "plural"
                        ],
                        "form": "affaissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                        "entry_id": "99ecc842-1188-35da-85ef-9d9f203bbc3d",
                        "glosses": [
                            "État de ce qui est affaissé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a6c9d0ae-6428-4ec4-8215-c5782881b534",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "Elle sentait tout cela vaguement à une certaine désillusion, à un affaissement de ses rêves."
                            },
                            {
                                "example_id": "1dc4cea3-f04b-4b4c-90f1-76f70c3c3ade",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "Il n’osait pas interroger Dominique, lui demander pourquoi Pierre n’était pas de retour ; il soupçonnait, à son affaissement, qu’il s’était passé quelque chose."
                            },
                            {
                                "example_id": "21afeb42-f893-42a8-91a6-68046af4c1ee",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "Même, le fait d'employer un réfractaire léger n'est pas nécessairement lié à une usure plus rapide et à une moindre résistance à l’affaissement."
                            },
                            {
                                "example_id": "1b77e168-5849-409a-870a-349e5f0606b2",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "Pour les bétons très fluides, on mesure le diamètre moyen (étalement) de la « flaque » de béton. Les bétons autoplaçants ont généralement un affaissement supérieur à 25 cm, et un étalement compris entre 60 et 70 cm (…)."
                            },
                            {
                                "example_id": "ecb462fb-2ca6-42e0-9ae2-2cad484983ea",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "L’affaissement des terres."
                            },
                            {
                                "example_id": "6e9d0f4e-ccac-4f87-bf4f-42fd0a2eac16",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "J’ai trouvé ce malade dans un grand affaissement."
                            },
                            {
                                "example_id": "6886f830-8c93-4370-a212-00208f2506ad",
                                "sense_id": "f21466f1-32e9-370f-9e9c-ac8dca78ea86",
                                "text": "L’affaissement de l’esprit est souvent l’effet d’un grand chagrin."
                            }
                        ]
                    },
                    {
                        "sense_id": "c138828c-aaa3-3d60-b022-3abb58c65f36",
                        "entry_id": "99ecc842-1188-35da-85ef-9d9f203bbc3d",
                        "glosses": [
                            "Dégonflement d’un pneumatique qui s’affaisse sur le sol."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa5d427a-fa8d-4a8e-9eb1-39be45a044ce",
                        "source_entry_id": "99ecc842-1188-35da-85ef-9d9f203bbc3d",
                        "target_lang_word": "Senkung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Senkung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a16e2545-6c49-332e-8194-c4395c42f2fc",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "Verringerung oder Verkleinerung eines Wertes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8a9bf2d-4f84-40ce-88d0-217f4fa0a920",
                                                "sense_id": "a16e2545-6c49-332e-8194-c4395c42f2fc",
                                                "text": "Vor jeder Wahl wird die Senkung der Steuern versprochen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "42dc36da-b24a-360b-94b6-af5fb96c6663",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "eine Bewegung der Erdkruste nach unten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3f04d4f-00a4-42c8-940a-898e3305df94",
                                                "sense_id": "42dc36da-b24a-360b-94b6-af5fb96c6663",
                                                "text": "„Die spontanen Hebungen und Senkungen nach schweren Erdbeben führen zu großräumigen Verwerfungen der Gesteinsschichten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "55e7bde3-4877-320a-96e8-68460f565248",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "eine Abwärtsbewegung von Organen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07d3f285-6e27-447e-a56e-da5815efbb1b",
                                                "sense_id": "55e7bde3-4877-320a-96e8-68460f565248",
                                                "text": "Eine Senkung des Magens kann zu Beschwerden wie fehlendem Sättegefühl führen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "67075baa-ddc0-3462-b50d-088145a7de83",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "Blutsenkungsgeschwindigkeit, Messgröße für die Diagnose entzündlicher Erkrankungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6483578-3b0f-424a-a78f-3639c2b2a03e",
                                                "sense_id": "67075baa-ddc0-3462-b50d-088145a7de83",
                                                "text": "„Eine Erhöhung dieser Senkung entsteht vor allem bei Entzündungen und vermehrten Gewebszerfall zum Beispiel bei Tumoren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "82517b49-ed53-3ab4-a912-0d37dc5e9bd7",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "eine nicht betonte Silbe"
                                        ],
                                        "tags": [
                                            "Verslehre"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d3036d0-54a0-4897-8f31-12f15b460c5d",
                                                "sense_id": "82517b49-ed53-3ab4-a912-0d37dc5e9bd7",
                                                "text": "Beim Jambus kommt zunächst eine Senkung anschließend eine Hebung."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9a00def6-f0e5-38cc-a2b0-7c44cd2adddb",
                                        "entry_id": "870fd912-23ba-3be1-a823-c9f182c81c2c",
                                        "glosses": [
                                            "eine Vertiefung, ein kleines Tal in der Landschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8fd9d29-3f5e-415c-b04a-7f605df879bb",
                                                "sense_id": "9a00def6-f0e5-38cc-a2b0-7c44cd2adddb",
                                                "text": "In der Senkung dort vorne habe ich gestern Rehe beobachtet."
                                            },
                                            {
                                                "example_id": "0cab98ba-e862-4b98-b1d4-cfbed71e569c",
                                                "sense_id": "9a00def6-f0e5-38cc-a2b0-7c44cd2adddb",
                                                "text": "„Wir marschierten in der Senkung nach rechts ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ee4e906d-abeb-4276-bcab-5adbc106ead5",
