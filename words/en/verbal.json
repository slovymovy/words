                            },
                            {
                                "target_lang_word": "con capacidad de habla",
                                "target_lang_sense_clarification": "que posee la facultad de comunicarse oralmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38213b4a-ee2f-3fef-81b6-003b1632dd25",
                    "sense_definition": "Corresponding word for word.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "literal_translation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The diplomat insisted on a <w>verbal</w> translation of the treaty to avoid ambiguity.",
                            "target_lang_translations": {
                                "ru": "Дипломат настоял на <w>дословном</w> переводе договора, чтобы избежать двусмысленности.",
                                "zh": "外交官坚持要求对条约进行<w>逐字</w>翻译，以避免歧义。",
                                "es": "El diplomático insistió en una traducción <w>literal</w> del tratado para evitar ambigüedades."
                            }
                        },
                        {
                            "text": "This is a <w>verbal</w> copy of the original text, preserving every error.",
                            "target_lang_translations": {
                                "ru": "Это <w>дословная</w> копия оригинального текста, сохраняющая каждую ошибку.",
                                "zh": "这是原文的<w>逐字</w>副本，保留了每一个错误。",
                                "es": "Esta es una copia <w>literal</w> del texto original, conservando cada error."
                            }
                        }
                    ],
                    "synonyms": [
                        "literal",
                        "verbatim"
                    ],
                    "common_phrases": [
                        "verbal translation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дословный, слово в слово.",
                        "zh": "逐字逐句的。",
                        "es": "Que corresponde palabra por palabra."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "досло́вный",
                                "target_lang_sense_clarification": "word for word"
                            },
                            {
                                "target_lang_word": "буква́льный",
                                "target_lang_sense_clarification": "literal"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逐字",
                                "target_lang_sense_clarification": "word for word"
                            },
                            {
                                "target_lang_word": "字面",
                                "target_lang_sense_clarification": "literal"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "literal",
                                "target_lang_sense_clarification": "que sigue el sentido exacto de las palabras"
                            },
                            {
                                "target_lang_word": "al pie de la letra",
                                "target_lang_sense_clarification": "traducción exacta o fiel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e7df267-f55b-3bf4-8784-3b98c3af89a2",
                    "sense_definition": "Derived from or having the nature of a verb.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "grammatical_adj",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>verbal</w> noun functions syntactically as a noun but retains verb-like properties.",
                            "target_lang_translations": {
                                "ru": "<w>Отглагольное</w> существительное синтаксически функционирует как существительное, но сохраняет свойства глагола.",
                                "zh": "<w>动词性</w>名词在句法上作为名词使用，但保留了动词的特性。",
                                "es": "Un sustantivo <w>deverbal</w> funciona sintácticamente como un sustantivo pero conserva propiedades verbales."
                            }
                        },
                        {
                            "text": "In this sentence, the <w>verbal</w> phrase modifies the subject.",
                            "target_lang_translations": {
                                "ru": "В этом предложении <w>глагольный</w> оборот определяет подлежащее.",
                                "zh": "在这个句子中，<w>动词性</w>短语修饰主语。",
                                "es": "En esta oración, la frase <w>verbal</w> modifica al sujeto."
                            }
                        }
                    ],
                    "common_phrases": [
                        "verbal noun"
                    ],
                    "target_lang_definitions": {
                        "ru": "Глагольный, образованный от глагола.",
                        "zh": "源自动词或具有动词性质的。",
                        "es": "Derivado de un verbo o que tiene la naturaleza de un verbo."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отглаго́льный",
                                "target_lang_sense_clarification": "derived from a verb"
                            },
                            {
                                "target_lang_word": "глаго́льный",
                                "target_lang_sense_clarification": "relating to a verb"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动词性",
                                "target_lang_sense_clarification": "relating to a verb"
                            },
                            {
                                "target_lang_word": "由动词派生",
                                "target_lang_sense_clarification": "derived from a verb"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "verbal",
                                "target_lang_sense_clarification": "que pertenece o concierne al verbo"
                            },
                            {
                                "target_lang_word": "deverbal",
                                "target_lang_sense_clarification": "palabra que deriva de un verbo"
                            }
                        ]
                    }
                }
