                            {
                                "example_id": "b851b34f-2ef7-4dcf-9579-c47ca6894bb0",
                                "sense_id": "d8ee2b3f-ec60-3a57-a61e-4ab1ed68e64e",
                                "text": "Publier un hors-série."
                            },
                            {
                                "example_id": "069df66d-d198-4ed8-8711-70a9d76a1aa2",
                                "sense_id": "d8ee2b3f-ec60-3a57-a61e-4ab1ed68e64e",
                                "text": "Ces hors-séries sont en vente directement auprès du magazine."
