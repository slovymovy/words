        "fr-extract.jsonl": [
            {
                "entry_id": "e12835cd-31a8-322e-b293-59c7cb61b5d7",
                "word": "peuh",
                "pos": "intj",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                        "entry_id": "e12835cd-31a8-322e-b293-59c7cb61b5d7",
                        "glosses": [
                            "Sert à marquer le mépris."
                        ],
                        "tags": [
                            "familiar",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "8537ade4-fa56-47a0-9195-97ee28f4a6f6",
                                "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                                "text": "— Tu es fâché aussi contre moi ? interrogea la fille, se dressant tout anxieuse.\n— Peuh !…"
                            },
                            {
                                "example_id": "2c64c363-342e-49f8-b1fb-723dbc5bd8fc",
                                "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                                "text": "« Et alors, Charcot, demandait mon père, comment l’avez-vous traité ce malheureux ? »\nLe geste des doigts fuselés indiquait que la question était futile : « Peuh… je lui ai conseillé les femmes, si c’était encore possible… Mais vous savez, un Allemand… à cinquante-cinq ans… et le pays de Winckelmann… »"
                            },
                            {
                                "example_id": "66e481cb-2403-40a1-8282-331c67a090d8",
                                "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                                "text": "— Ses menaces ? peuh ! des paroles de soulaud. Comment avait-on pu le supporter et le craindre si longtemps !"
                            },
                            {
                                "example_id": "c852bcf8-688f-45de-ad29-355fc19ea9fb",
                                "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                                "text": "Attention à l'abus que font certains journaux de ces titres exorbitants composés en énormes majuscules, à propos desquels un humoriste a pu dire un jour: Peuh ! beaucoup de capitales, mais bien peu d'intérêt !"
                            },
                            {
                                "example_id": "b703b0fe-e723-4847-8944-d2cc17725985",
                                "sense_id": "d5923039-e9a5-3980-a48f-8c1455f85d54",
                                "text": "Ils doivent me trouver bien prétentieuse! Peuh! Il fait trop beau pour que ça m'atteigne!"
                            }
                        ]
                    },
                    {
                        "sense_id": "f754eefe-83ad-3c08-91fc-0072aa223466",
                        "entry_id": "e12835cd-31a8-322e-b293-59c7cb61b5d7",
                        "glosses": [
                            "Sert à imiter quelqu'un qui tousse."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "1f0f91fe-d14b-45d6-8920-8afeb9c62c42",
                                "sense_id": "f754eefe-83ad-3c08-91fc-0072aa223466",
                                "text": "Si vous saviez comme le père Vyder tousse et souffle ! Peuh ! peuh ! fit-elle en imitant le vieillard."
                            }
                        ]
                    }
                ],
