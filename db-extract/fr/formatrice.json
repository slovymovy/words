                        "examples": [
                            {
                                "example_id": "cfee44b0-d446-417f-a636-62898d92d668",
                                "sense_id": "09b525a4-635e-3356-a7a5-813ec28223cc",
                                "text": "Une formatrice appelait cette forme d’intégration « incarner mes apprentissages », en opposition à la forme d’intégration d’un jeune étudiant."
                            },
                            {
                                "example_id": "c8552774-34da-4abb-995a-9a0289d04edf",
                                "sense_id": "09b525a4-635e-3356-a7a5-813ec28223cc",
                                "text": "Ce travail de formatrice, Fabienne Boulard l’exerce aussi auprès de l’Institut Women Safe & Children."
                            }
                        ]
                    }
                ],
