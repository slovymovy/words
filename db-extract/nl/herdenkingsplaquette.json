                        "glosses": [
                            "plaat van duurzaam materiaal met die aan een persoon of gebeurtenis herinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c915cf7d-9103-472c-9b09-01fff33e2c18",
                                "sense_id": "f006763c-04cb-3dfa-86ae-7b885cb4ddc9",
                                "text": "In het gebouw van de Tweede Kamer zijn de slachtoffers van de Tweede Wereldoorlog in voormalig Nederlands-Indië herdacht. De voorzitters van de Eerste en Tweede Kamer, Bruijn en Arib, legden een krans bij de herdenkingsplaquette in de hal."
                            },
                            {
                                "example_id": "cefe652e-709c-4974-88f5-cc681f6d4347",
                                "sense_id": "f006763c-04cb-3dfa-86ae-7b885cb4ddc9",
                                "text": "In de kantine van DFC hing tot voor kort een herdenkingsplaquette voor de in 1944 omgekomen Weisz. Het bestuur besloot de plaquette onlangs echter weg te halen, tot verbijstering van archivaris en oud-voorzitter Arie Heijstek. Hij is nu op zoek naar een nieuwe plek in Dordrecht voor de glazen gedenkplaat."
                            }
                        ]
                    }
