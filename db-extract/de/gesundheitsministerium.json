                    {
                        "sense_id": "4710f4db-42d0-3b60-8275-f37d78fd7d66",
                        "entry_id": "007f1a4f-1b25-3ff3-9960-2f868d3e4aa6",
                        "glosses": [
                            "Ministerium, das für die gesundheitlichen Belange der Bevölkerung zuständig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5905207a-3e04-4ac7-8066-9e975823a7ad",
                                "sense_id": "4710f4db-42d0-3b60-8275-f37d78fd7d66",
                                "text": "Das Gesundheitsministerium berät derzeit über Maßnahmen zur besseren ärztlichen Versorgung der Landbevölkerung."
                            },
                            {
                                "example_id": "9b870da5-f085-469f-a45e-34db50599b35",
                                "sense_id": "4710f4db-42d0-3b60-8275-f37d78fd7d66",
                                "text": "„Ein achtjähriges Mädchen, das täglich rund 400 Epilepsie-Anfälle durchlebt, wird Mexikos erste legale Konsumentin von medizinischem Marihuana: Trotz striktem Marihuana-Verbot genehmigte das Gesundheitsministerium die Einfuhr eines Mittels auf der Basis von Cannabidiol (CBD), das die Anfälle des Mädchens verringern soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
