                        "source_entry_id": "1e229f11-3801-30a3-8f1d-856b8bdbda3f",
                        "source_sense_id": "fa0392df-43f8-383f-b7aa-c015322a3161",
                        "target_lang_word": "Pelzmantel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pelzmantel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                        "entry_id": "37ae8ae3-83ac-3fec-9ef3-f4a07fe6c7a3",
                                        "glosses": [
                                            "Mantel aus Pelz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b6f70d-e5ed-4596-9d94-71900da146c7",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Vor zwei Jahren hatte sich Rapper West ebenfalls nicht lumpen lassen: Da schenkte er seiner Frau satte 150 Gaben, darunter einen Pelzmantel in Regenbogenfarben und einen Jumpsuit von Prada.“"
                                            },
                                            {
                                                "example_id": "d76c248d-b8c2-4e7c-b545-5ef3dea5c6d1",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Dass der Pelzmantel, einst Symbol von Luxus und Highlife, heute ziemlich stark in der Kritik steht, dürfte den meisten Menschen bewusst sein.“"
                                            },
                                            {
                                                "example_id": "dd13f7f2-f1fc-493d-af5f-169f0a381215",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Keine Pelzdecke und keiner unserer Pelzmäntel kam abhanden, denn dafür interessierten sich die Russen nicht; Pelze sind für sie offenbar reine Gebrauchsgegenstände, über die sie selbst reichlich verfügen.“"
                                            },
                                            {
                                                "example_id": "bf179646-42b6-4699-8613-c4ddb798f2e5",
                                                "sense_id": "a93bd0c0-23d6-3a56-a283-6f04f4c47e12",
                                                "text": "„Almuth, angekleidet, kam herein und warf ihren Pelzmantel über die Schulter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
