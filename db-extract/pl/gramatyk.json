                                ]
                            },
                            {
                                "target_word": "gramático",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                        "entry_id": "d1fb7f37-fa88-316b-9112-6b61febd3d88",
                                        "glosses": [
                                            "Persona entendida en gramática o que escribe de ella."
                                        ],
                                        "tags": [
                                            "Profesiones"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c823c89-467b-4d08-b712-19ac273fee9f",
                                                "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                                "text": "«En este dominio, como no sea por la boca del vulgo ignaro, no hay que registrar fanfarronería alguna dialectal. Los gramáticos y filólogos que han estudiado esa curiosa modalidad lingüística, lo han hecho con singular amor y competencia científica»."
                                            },
                                            {
                                                "example_id": "98effde7-8bff-4ff3-8a2c-2b048ebfaf6b",
                                                "sense_id": "015eb07f-f04e-3e8a-9cd4-9df2dbdc28ad",
                                                "text": "«Pinciano Quintiliano, demás de los precebtos ordinarios y reglas comunes, pide que el buen gramático sea muy leído en los poetas y en historias, y muy curioso en las antigüedades, y docto en latín y griego, y abundoso de buenas y ordenadas palabras, porque no basta hablar congruamente como gramático, sed oportet latine dicere»."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9eaff6bb-d111-4d0a-af90-03328368a41a",
                        "source_entry_id": "d75beb8f-9d7d-3579-918c-b09ab38a642d",
                        "source_sense_id": "e3d87a9e-e99b-3e3d-9fbd-3ff84f3a8f4d",
                        "target_lang_word": "grammaticus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grammaticus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2a21042d-fa8c-379d-bfaa-28f70132d8d9",
                                        "entry_id": "0ad7249c-70a1-38c9-b2ae-df19089ddfeb",
                                        "glosses": [
                                            "iemand die de spraakkunst bestudeert, iemand die schrijft over de wetmatigheden waarmee de uitingen in een taal worden gevormd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce7feaf5-58b8-4dd8-b945-80edef5ee0d7",
                                                "sense_id": "2a21042d-fa8c-379d-bfaa-28f70132d8d9",
                                                "text": "Mijn proefschrift uit 1990 ging onder andere over Apollonius Dyscolus, mijn ‘oude vriend’, een grammaticus uit de tweede eeuw die als eerste op basis van wetenschappelijke principes taal heeft beschreven."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fa5b29d-57fb-408d-9396-23b14a116ea3",
                        "source_entry_id": "d75beb8f-9d7d-3579-918c-b09ab38a642d",
                        "source_sense_id": "e3d87a9e-e99b-3e3d-9fbd-3ff84f3a8f4d",
                        "target_lang_word": "Grammatiker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grammatiker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                        "entry_id": "53a32b2e-0e3d-372f-87ff-4402c884ed2d",
                                        "glosses": [
                                            "Forscher, Wissenschaftler, der sich mit Grammatik/Grammatiken oder Ausschnitten davon befasst, sie erforscht, beschreibt und/oder lehrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf0ded40-ef11-4825-8d4f-8c7c7d0185dc",
                                                "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                                "text": "Die Grammatiker bemühen sich, für unterschiedliche Zwecke (Erstsprachunterricht, Fremdsprachenunterricht, Sprachtheorie) angemessene Grammatiken zu entwickeln."
                                            },
                                            {
                                                "example_id": "e949827e-5e9b-426c-99b8-520d6e3b9f0d",
                                                "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                                "text": "„Das ist sicherlich für Sprachhistoriker und Grammatiker gleichermaßen fruchtbar.“"
                                            },
                                            {
                                                "example_id": "58abf2e1-f6b1-4b9b-ba53-d5aafa20c8cb",
                                                "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                                "text": "„Auftraggeber war der in Paris ausgebildete und zu den führenden Gelehrten der Universität Löwen gehörende Grammatiker und Jurist Antonius Haneron.“"
                                            },
                                            {
                                                "example_id": "78ed5ea5-2524-44cf-bd83-d81016ae2d66",
                                                "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                                "text": "„Grammatiker und Stilisten in Großbritannien veröffentlichten zur gleichen Zeit Warnungen gegen den Gebrauch von zu vielen Zeichen und einen übermäßig exklamatorischen Ton.“"
                                            },
                                            {
                                                "example_id": "acd3ced4-d935-4138-94f3-507d09d87dbf",
                                                "sense_id": "0942b340-529c-32ce-8fda-144f3bdf23fc",
                                                "text": "„Tatsächlich sind sich die Grammatiker nicht einig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
