                "senses": [
                    {
                        "sense_id": "ed1cfaaa-9fba-37e2-a332-968485d6fb16",
                        "entry_id": "88de2c3d-1615-3c08-a461-21062f3494d3",
                        "glosses": [
                            "Abandonner la priorité qui avait été donnée à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cfe2cda9-d084-4260-96ee-74a399551cd7",
                                "sense_id": "ed1cfaaa-9fba-37e2-a332-968485d6fb16",
                                "text": "Il ne s’agit pas d’oublier les seconds, mais bien de les déprioriser pour mettre les clients et les produits (ou les services, selon l’entreprise) au premier plan."
                            },
                            {
                                "example_id": "5d6e002f-2e03-41a3-9527-13024aae7b8c",
                                "sense_id": "ed1cfaaa-9fba-37e2-a332-968485d6fb16",
                                "text": "Evoluer de la procrastination au choix de déprioriser une action."
                            },
                            {
                                "example_id": "09ed0996-b152-4cf9-8eef-c2112489f571",
                                "sense_id": "ed1cfaaa-9fba-37e2-a332-968485d6fb16",
                                "text": "Pouvoir prioriser / déprioriser une tache dans la liste"
                            }
                        ]
                    }
