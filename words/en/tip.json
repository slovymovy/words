{
    "word_family": [
        "tipper",
        "tipping",
        "tiptoe",
        "fingertip",
        "tip-off"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81dd1c19-7d5d-3f9d-b88f-2904be9c4f5c",
                    "sense_definition": "The pointed or extreme end of something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "end_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He stood on the <w>tips</w> of his toes to reach the top shelf.",
                            "target_lang_translations": {
                                "ru": "Он встал на <w>кончики</w> пальцев, чтобы достать до верхней полки.",
                                "zh": "他踮起脚<w>尖</w>去够顶层的架子。"
                            }
                        },
                        {
                            "text": "The <w>tip</w> of the pencil broke when I dropped it on the floor.",
                            "target_lang_translations": {
                                "ru": "<w>Кончик</w> карандаша сломался, когда я уронил его на пол.",
                                "zh": "铅笔的<w>笔尖</w>掉在地上时断了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "extremity",
                        "end",
                        "point"
                    ],
                    "common_phrases": [
                        "tip of the iceberg",
                        "tip of the tongue",
                        "finger tips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Острый или крайний конец чего-либо.",
                        "zh": "某物的尖端或末端。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ко́нчик",
                                "target_lang_sense_clarification": "крайняя часть чего-либо (пальца, носа, хвоста)"
                            },
                            {
                                "target_lang_word": "остриё",
                                "target_lang_sense_clarification": "острый конец инструмента или оружия"
                            },
                            {
                                "target_lang_word": "наконе́чник",
                                "target_lang_sense_clarification": "деталь, надеваемая на конец предмета"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "尖端",
                                "target_lang_sense_clarification": "物体细长的末端"
                            },
                            {
                                "target_lang_word": "末端",
                                "target_lang_sense_clarification": "物体最后的部分"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e221cc11-d904-38bd-8240-ac6cb4145394",
                    "sense_definition": "A small amount of money given to a service worker, such as a waiter or taxi driver, as a reward for their service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We left a generous <w>tip</w> on the table for the waitress.",
                            "target_lang_translations": {
                                "ru": "Мы оставили щедрые <w>чаевые</w> на столе для официантки.",
                                "zh": "我们给服务员在桌上留下了一笔丰厚的<w>小费</w>。"
                            }
                        },
                        {
                            "text": "In some cultures, giving a <w>tip</w> is not expected or required.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах давать <w>чаевые</w> не принято и не требуется.",
                                "zh": "在某些文化中，并不要求或期望给<w>小费</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gratuity"
                    ],
                    "common_phrases": [
                        "leave a tip",
                        "give a tip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшая сумма денег, даваемая работнику сферы услуг сверх счета в знак благодарности.",
                        "zh": "给服务人员（如服务员或司机）的一小笔钱，作为对其服务的奖励。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чаевы́е",
                                "target_lang_sense_clarification": "денежное вознаграждение за обслуживание"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小费",
                                "target_lang_sense_clarification": "服务后的额外报酬"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b24943fb-9ffe-3f86-a0a3-7528a7c3bf40",
                    "sense_definition": "A helpful piece of advice or practical information.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "advice",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article offers some great <w>tips</w> on how to save money.",
                            "target_lang_translations": {
                                "ru": "Статья предлагает отличные <w>советы</w> о том, как сэкономить деньги.",
                                "zh": "这篇文章提供了一些关于如何省钱的绝佳<w>建议</w>。"
                            }
                        },
                        {
                            "text": "She gave me a handy <w>tip</w> for removing stains from clothes.",
                            "target_lang_translations": {
                                "ru": "Она дала мне полезный <w>совет</w> по удалению пятен с одежды.",
                                "zh": "她给了我一个去除衣物污渍的实用<w>诀窍</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hint",
                        "pointer",
                        "suggestion"
                    ],
                    "common_phrases": [
                        "handy tip",
                        "top tip",
                        "tips and tricks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полезный совет или практическая рекомендация.",
                        "zh": "有用的建议或实用信息。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сове́т",
                                "target_lang_sense_clarification": "наставление, указание, как поступить"
                            },
                            {
                                "target_lang_word": "подска́зка",
                                "target_lang_sense_clarification": "наводящая информация, помощь в решении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "建议",
                                "target_lang_sense_clarification": "对他人的提议"
                            },
                            {
                                "target_lang_word": "诀窍",
                                "target_lang_sense_clarification": "巧妙的办法或技巧"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "98b517dc-8ea1-3a63-9b52-197b08567e53",
                    "sense_definition": "A place where rubbish or waste is taken to be left; also used informally to describe a very messy place.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to take all this garden waste to the <w>tip</w>.",
                            "target_lang_translations": {
                                "ru": "Нам нужно отвезти весь этот садовый мусор на <w>свалку</w>.",
                                "zh": "我们需要把这些园艺垃圾都送到<w>垃圾场</w>去。"
                            }
                        },
                        {
                            "text": "Your bedroom is an absolute <w>tip</w>; please clean it up immediately.",
                            "target_lang_translations": {
                                "ru": "Твоя спальня — настоящая <w>помойка</w>; пожалуйста, уберись немедленно.",
                                "zh": "你的卧室简直就是个<w>垃圾堆</w>，请立刻打扫干净。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "rubbish tip",
                        "take to the tip"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British"
                        },
                        {
                            "trait_type": "colloquial",
                            "comment": "when referring to a messy room"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место для сброса мусора; в разговорной речи — очень грязное, беспорядочное место.",
                        "zh": "倾倒垃圾的地方；也常用于形容非常杂乱的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сва́лка",
                                "target_lang_sense_clarification": "место для вывоза отходов"
                            },
                            {
                                "target_lang_word": "помо́йка",
                                "target_lang_sense_clarification": "разг. очень грязное место"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "垃圾场",
                                "target_lang_sense_clarification": "堆放废弃物的地方"
                            },
                            {
                                "target_lang_word": "乱七八糟的地方",
                                "target_lang_sense_clarification": "形容环境极度脏乱"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "af642597-d555-33b7-8841-00d10d45a5f6",
                    "sense_definition": "To give a small amount of money to someone who has provided a service.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "money_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I always <w>tip</w> the taxi driver if the ride was smooth.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>даю на чай</w> таксисту, если поездка прошла гладко.",
                                "zh": "如果行程顺利，我总是会给出租车司机<w>小费</w>。"
                            }
                        },
                        {
                            "text": "It is customary to <w>tip</w> waiters in the United States.",
                            "target_lang_translations": {
                                "ru": "В Соединенных Штатах принято <w>давать чаевые</w> официантам.",
                                "zh": "在美国，给服务员<w>小费</w>是惯例。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tip the waiter",
                        "tip generously"
                    ],
                    "target_lang_definitions": {
                        "ru": "Давать небольшую сумму денег кому-либо за оказанную услугу.",
                        "zh": "给提供服务的人一小笔钱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дава́ть на ча́й",
                                "target_lang_sense_clarification": "вознаграждать сверх счета"
                            },
                            {
                                "target_lang_word": "дава́ть чаевы́е",
                                "target_lang_sense_clarification": "официальный вариант"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "给小费",
                                "target_lang_sense_clarification": "支付额外报酬的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "510bb73d-6b42-389d-acdd-41e23948ed50",
                    "sense_definition": "To move into a sloping position or cause to fall over; to tilt.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "move_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Be careful not to <w>tip</w> the chair over when you stand up.",
                            "target_lang_translations": {
                                "ru": "Будь осторожен, чтобы не <w>опрокинуть</w> стул, когда встаешь.",
                                "zh": "站起来时小心别把椅子<w>弄翻</w>了。"
                            }
                        },
                        {
                            "text": "The boat began to <w>tip</w> dangerously to one side in the storm.",
                            "target_lang_translations": {
                                "ru": "Лодка начала опасно <w>крениться</w> на один бок во время шторма.",
                                "zh": "暴风雨中，船开始危险地向一侧<w>倾斜</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tip over",
                        "tip up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Наклонять(ся) или приводить в наклонное положение; опрокидывать(ся).",
                        "zh": "移动到倾斜的位置或导致翻倒；倾斜。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "опроки́дывать",
                                "target_lang_sense_clarification": "ронять, переворачивать"
                            },
                            {
                                "target_lang_word": "наклоня́ть",
                                "target_lang_sense_clarification": "приводить в наклонное положение"
                            },
                            {
                                "target_lang_word": "крени́ться",
                                "target_lang_sense_clarification": "наклоняться набок (о судне)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倾斜",
                                "target_lang_sense_clarification": "偏离垂直位置"
                            },
                            {
                                "target_lang_word": "翻倒",
                                "target_lang_sense_clarification": "物体倒下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c31098b-d62b-3297-8eed-c39954e5a84e",
                    "sense_definition": "To cause the contents of a container to fall out by tilting it.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "move_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>tipped</w> the dirty water out of the bucket.",
                            "target_lang_translations": {
                                "ru": "Она <w>вылила</w> грязную воду из ведра.",
                                "zh": "她把桶里的脏水<w>倒</w>掉了。"
                            }
                        },
                        {
                            "text": "Please <w>tip</w> the ingredients into the mixing bowl.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>высыпьте</w> ингредиенты в миску для смешивания.",
                                "zh": "请把配料<w>倒进</w>搅拌碗里。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tip out",
                        "tip into"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выливать или высыпать содержимое емкости, наклонив ее.",
                        "zh": "通过倾斜容器使其中的内容物倒出。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вылива́ть",
                                "target_lang_sense_clarification": "о жидкости"
                            },
                            {
                                "target_lang_word": "высыпа́ть",
                                "target_lang_sense_clarification": "о сыпучих веществах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "倒出",
                                "target_lang_sense_clarification": "使液体或颗粒物从容器中流出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a2aea49-a7a0-3bac-a6ba-c70ab46fc1a3",
                    "sense_definition": "To predict that someone or something is likely to succeed or achieve a particular result.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "predict_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete is <w>tipped</w> to win a gold medal.",
                            "target_lang_translations": {
                                "ru": "Молодому спортсмену <w>прочат</w> золотую медаль.",
                                "zh": "这位年轻运动员被<w>看好</w>能赢得金牌。"
                            }
                        },
                        {
                            "text": "He was widely <w>tipped</w> as the next leader of the party.",
                            "target_lang_translations": {
                                "ru": "Ему многие <w>прочили</w> место следующего лидера партии.",
                                "zh": "他被广泛<w>预测</w>为下一任党魁。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tipped to win",
                        "widely tipped"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предсказывать, что кто-то добьется успеха или определенного результата.",
                        "zh": "预言某人或某事可能会成功或取得特定结果。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "про́чить",
                                "target_lang_sense_clarification": "предсказывать кому-либо что-либо (победу, успех)"
                            },
                            {
                                "target_lang_word": "предрека́ть",
                                "target_lang_sense_clarification": "предсказывать будущее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "看好",
                                "target_lang_sense_clarification": "认为某人有前途"
                            },
                            {
                                "target_lang_word": "预言",
                                "target_lang_sense_clarification": "预测未来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b4348f8b-8a36-33ad-8ecf-3d63df20c1db",
                    "sense_definition": "To attach something to the end or point of an object.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cover_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient arrows were <w>tipped</w> with iron heads.",
                            "target_lang_translations": {
                                "ru": "Древние стрелы были <w>снабжены</w> железными <w>наконечниками</w>.",
                                "zh": "古代箭矢的末端都<w>加装</w>了铁制箭头。"
                            }
                        },
                        {
                            "text": "She bought cigarettes that were <w>tipped</w> with filters.",
                            "target_lang_translations": {
                                "ru": "Она купила сигареты, <w>снабженные</w> фильтром.",
                                "zh": "她买的香烟是<w>带</w>过滤嘴的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "tipped with"
                    ],
                    "target_lang_definitions": {
                        "ru": "Прикреплять что-либо к концу или острию предмета.",
                        "zh": "在物体的末端或尖端附加某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "снабжа́ть наконе́чником",
                                "target_lang_sense_clarification": "делать конец из другого материала"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "加装",
                                "target_lang_sense_clarification": "在末端安装部件"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}