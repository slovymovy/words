                        "entry_id": "7346b75d-b1ae-396a-9afc-9cdf98e2e96f",
                        "glosses": [
                            "D’une manière dense."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "313d4b8a-09af-42b5-9af7-6b0742cd0bde",
                                "sense_id": "bbb1cb82-1231-3db7-b65c-691fe3e75c64",
                                "text": "L'Aveyron est l'un des départements les moins densément peuplés de France."
                            },
                            {
                                "example_id": "7832fa4f-0d6d-4eb0-9429-321b0c56cf2f",
                                "sense_id": "bbb1cb82-1231-3db7-b65c-691fe3e75c64",
                                "text": "On avait conscience d’y entrer parce que aux essences sauvages de bois Brésil et de pin se mêlaient de plus en plus densément des arbres utiles et qu’on pouvait presque qualifier de domestiques : des acajous pleins de leurs fruits, des copayers dont le tronc suait une huile précieuse, des maquis de cotonniers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ec4c571-afb3-4a9a-a636-83ef82ce0793",
                        "source_entry_id": "7346b75d-b1ae-396a-9afc-9cdf98e2e96f",
