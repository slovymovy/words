                    "sense_id": "9ea57cb1-59ca-3112-a736-9684ff822d3b",
                    "sense_definition": "een snelle waarneming met de ogen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waarneming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wierp een snelle <w>blik</w> op zijn horloge om te zien hoe laat het was.",
                            "target_lang_translations": {
