                        "glosses": [
                            "One of a group of seven, particularly one of seven babies born at the same birth."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03c1b4b3-d15f-406e-b9b3-50544bc09770",
                                "sense_id": "8ee0feb8-e9f9-3eac-9c91-d5a8f5d851eb",
                                "text": "Lady (Alyson Levy): Where are my babies? Where are my babies?\nXavier (Vernon Chatman): Keep it down, lady, we got families around here.\nLady: Aaaah, have you seen my babies?\nXavier: I'm poppin' a peek at a smokin' babe right now.\nLady: I lost seven of my babies!\nXavier: Tragic, I've got septuplets myself. I don't know what I'd do if I lost them. Good thing I'm a responsible parent. You should try it sometime."
                            }
                        ]
