                "senses": [
                    {
                        "sense_id": "c110d75d-48d2-3cc1-86ed-d203f9a87fae",
                        "entry_id": "0e7b6d63-b9c6-30fa-8679-d2d92bbbf3d4",
                        "glosses": [
                            "stelsel van met elkaar verbonden spoorwegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a5759be-436d-400c-b0d9-0bda5e02ed4a",
                                "sense_id": "c110d75d-48d2-3cc1-86ed-d203f9a87fae",
                                "text": "Hij moest een trein naar Bukowo laten komen, hetgeen gezien de vernielingen die de geallieerde bommenwerpers aan het Duitse spoorwegnet toebrachten, enig gemanipuleer zou vereisen, en hij moest die trein vullen met de schatten uit het paleis vóór Falk von Eschl in het kasteel kon ingrijpen."
                            },
                            {
                                "example_id": "f09c55d3-cef9-4e1b-8e9a-d685d2f5aab8",
                                "sense_id": "c110d75d-48d2-3cc1-86ed-d203f9a87fae",
                                "text": "Het zou het paradepaardje van het Nederlandse spoorwegnet moeten zijn, maar het is een hoofdpijndossier: de HSL-Zuid, de spoorlijn die Nederland via hogesnelheidstreinen moet verbinden met België en Frankrijk. Een bijna onmisbare schakel met het oog op de wens om zo duurzaam mogelijk te reizen."
                            }
                        ]
                    }
