{
    "word_family": [
        "wending",
        "omwenden",
        "terugwenden",
        "aanwenden"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "19ec348a-d9ed-376b-970d-652ab700c567",
                    "sense_definition": "je blik of hoofd een andere kant op draaien om iets niet te hoeven zien",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "visueel_afkeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>wendde</w> zijn hoofd <w>af</w> van het vreselijke ongeval op de snelweg.",
                            "target_lang_translations": {
                                "en": "He <w>turned</w> his head <w>away</w> from the terrible accident on the highway.",
                                "ru": "Он <w>отвернул</w> голову от ужасной аварии на шоссе."
                            }
                        },
                        {
                            "text": "Zij kon de nare beelden niet verdragen en <w>wendde</w> haar blik snel <w>af</w>.",
                            "target_lang_translations": {
                                "en": "She could not bear the nasty images and quickly <w>averted</w> her gaze.",
                                "ru": "Она не могла выносить эти неприятные кадры и быстро <w>отвела</w> взгляд."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeren"
                    ],
                    "common_phrases": [
                        "blik afwenden",
                        "hoofd afwenden",
                        "gezicht afwenden"
                    ],
                    "target_lang_definitions": {
                        "en": "to turn your gaze or head in another direction to avoid seeing something",
                        "ru": "отвернуть голову или взгляд в другую сторону, чтобы чего-то не видеть"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn away",
                                "target_lang_sense_clarification": "one's head or eyes"
                            },
                            {
                                "target_lang_word": "to avert",
                                "target_lang_sense_clarification": "one's gaze or eyes"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "взгляд или глаза"
                            },
                            {
                                "target_lang_word": "отворачивать",
                                "target_lang_sense_clarification": "голову или лицо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88d5148e-7584-32ad-823d-8b995a2d0273",
                    "sense_definition": "ervoor zorgen dat iets vervelends of gevaarlijks niet gebeurt",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voorkomen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door het verhogen van de dijken is het grote gevaar van een overstroming eindelijk <w>afgewend</w>.",
                            "target_lang_translations": {
                                "en": "By raising the dikes, the great danger of a flood has finally been <w>averted</w>.",
                                "ru": "Благодаря повышению дамб большая опасность наводнения была наконец <w>предотвращена</w>."
                            }
                        },
                        {
                            "text": "De diplomaat probeerde met alle macht een dreigende oorlog tussen de landen te <w>afwenden</w>.",
                            "target_lang_translations": {
                                "en": "The diplomat tried with all his might to <w>ward off</w> a looming war between the countries.",
                                "ru": "Дипломат всеми силами пытался <w>отвести</w> угрозу войны между странами."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gevaar afwenden",
                        "onheil afwenden",
                        "crisis afwenden",
                        "dreiging afwenden"
                    ],
                    "target_lang_definitions": {
                        "en": "to ensure that something unpleasant or dangerous does not happen",
                        "ru": "предотвратить наступление чего-то неприятного или опасного"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to avert",
                                "target_lang_sense_clarification": "a disaster or danger"
                            },
                            {
                                "target_lang_word": "to ward off",
                                "target_lang_sense_clarification": "a threat or evil"
                            },
                            {
                                "target_lang_word": "to head off",
                                "target_lang_sense_clarification": "a crisis or conflict"
                            },
                            {
                                "target_lang_word": "to prevent",
                                "target_lang_sense_clarification": "something bad from happening"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "предотвращать",
                                "target_lang_sense_clarification": "опасность или беду"
                            },
                            {
                                "target_lang_word": "отводить",
                                "target_lang_sense_clarification": "угрозу или удар"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b91a750c-cb30-330c-9a71-8aef61f2f9f5",
                    "sense_definition": "zich emotioneel of mentaal distantiëren van een persoon, groep of onderwerp",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "distantiëren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij <w>wendde</w> zich helemaal van de politiek <w>af</w> na zijn plotselinge aftreden als minister-president.",
                            "target_lang_translations": {
                                "en": "He <w>turned away</w> from politics completely after his sudden resignation as prime minister.",
                                "ru": "Он полностью <w>отвернулся</w> от политики после своей внезапной отставки с поста премьер-министра."
                            }
                        },
                        {
                            "text": "Veel kiezers hebben zich de afgelopen jaren van de traditionele partijen <w>afgewend</w>.",
                            "target_lang_translations": {
                                "en": "Many voters have <w>turned away</w> from the traditional parties in recent years.",
                                "ru": "Многие избиратели в последние годы <w>отвернулись</w> от традиционных партий."
                            }
                        }
                    ],
                    "synonyms": [
                        "afkeren"
                    ],
                    "common_phrases": [
                        "zich afwenden van"
                    ],
                    "target_lang_definitions": {
                        "en": "to distance oneself emotionally or mentally from a person, group, or subject",
                        "ru": "эмоционально или ментально дистанцироваться от человека, группы или темы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to turn away from",
                                "target_lang_sense_clarification": "to stop supporting or being involved with"
                            },
                            {
                                "target_lang_word": "to distance oneself from",
                                "target_lang_sense_clarification": "to become less involved"
                            },
                            {
                                "target_lang_word": "to alienate oneself from",
                                "target_lang_sense_clarification": "to become estranged"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отворачиваться",
                                "target_lang_sense_clarification": "от кого-либо или чего-либо"
                            },
                            {
                                "target_lang_word": "отстраняться",
                                "target_lang_sense_clarification": "от политики или общества"
                            }
                        ]
                    }
                }
            ]
        }
    ]
