                                                "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
                                                "text": "My father punctuated his tirade with thumps on the desk."
                                            },
                                            {
                                                "example_id": "59f17d19-c4ba-4c97-a6bc-a34d18ca34d4",
                                                "sense_id": "e97d62da-aa0c-3da7-8289-a4a1b82b087c",
