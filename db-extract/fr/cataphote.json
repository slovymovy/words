                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4af3d633-6d6f-4adb-8e7e-2c01cbaac9a7",
                        "entry_id": "acadbbc9-67f3-3467-b85c-ec899c4f7e65",
                        "tags": [
                            "plural"
