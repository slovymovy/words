                        "glosses": [
                            "mes waarmee men overtollig materiaal van een hoepel afsnijdt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "231a3a3f-e4a6-4aba-a51e-6b64637690fd",
                                "sense_id": "aa44d961-ae07-3169-b872-ff2eb3d01752",
                                "text": "Heeft men de hoepel om het vaatje gelegd en, na de klikken in elkaar gehaakt te hebben, de uiteinden onder de band doorgestoken en afgesneden met het lasmes - dat laatste tezamen heet lassṇ - dan wordt hij met de stómpṃ dissel (V.: den dissel) vastgedreven. Ook maakt men daarbij wel eens gebruik van een dréjfhòwt (V.) en een hamer."
                            }
                        ]
                    }
