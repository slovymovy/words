                                    {
                                        "sense_id": "e724da57-a08f-350e-a6ca-2612f016cf99",
                                        "entry_id": "2e013276-9888-3725-99cb-06134b9837ec",
                                        "glosses": [
                                            "Recipiente refractario usado para fundir o calcinar materiales a altas temperaturas."
                                        ],
