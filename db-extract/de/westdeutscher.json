                "senses": [
                    {
                        "sense_id": "8286a879-be28-3d80-8a70-eb9ab2426df8",
                        "entry_id": "333c0bd0-addc-391a-9e3d-ba2a71fb3889",
                        "glosses": [
                            "eine im Westen von Deutschland lebende oder geborene Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bce5b25-afac-40b5-97c0-523c460a3f44",
                                "sense_id": "8286a879-be28-3d80-8a70-eb9ab2426df8",
                                "text": "Bei seinem Badeurlaub an der Ostsee traf er viele Westdeutsche."
                            },
                            {
                                "example_id": "809c8eca-ed93-49b8-8ff9-a5ff4f2d9e62",
                                "sense_id": "8286a879-be28-3d80-8a70-eb9ab2426df8",
                                "text": "„Auch wenn sich die Westdeutschen nach 1989 nicht gerade heldenhaft verhalten haben, als sie endlich erkannten, was die Wiedervereinigung sie kosten würde, haben sie letztendlich den Preis bezahlt.“"
                            }
                        ],
