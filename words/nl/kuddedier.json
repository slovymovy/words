    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3b9691b4-f2c4-3d7f-94d6-ce0571bdcda7",
                    "sense_definition": "Iemand die zich gedraagt als een meeloper en kritiekloos de massa of de groep volgt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "figuurlijk_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wil geen <w>kuddedier</w> zijn en maakt daarom altijd zijn eigen keuzes.",
                            "target_lang_translations": {
                                "en": "He does not want to be a <w>follower</w> and therefore always makes his own choices."
                            }
                        },
                        {
                            "text": "Veel mensen gedragen zich als een <w>kuddedier</w> door blindelings de nieuwste trends te volgen.",
                            "target_lang_translations": {
                                "en": "Many people behave like <w>sheep</w> by blindly following the latest trends."
                            }
                        }
                    ],
                    "synonyms": [
                        "meeloper",
                        "volger"
                    ],
                    "antonyms": [
                        "individualist",
                        "eenling"
                    ],
                    "common_phrases": [
                        "gedragen als een kuddedier",
                        "typisch kuddedier"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Figurative usage to describe human behavior"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who behaves like a follower and uncritically follows the crowd or group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "conformist",
                                "target_lang_sense_clarification": "a person who conforms to accepted behavior or practices"
                            },
                            {
                                "target_lang_word": "follower",
                                "target_lang_sense_clarification": "someone who blindly follows others"
                            },
                            {
                                "target_lang_word": "sheep",
                                "target_lang_sense_clarification": "figurative term for people who copy others uncritically"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "81bacb00-9022-33c5-91f4-1f800fa63332",
                    "sense_definition": "Een dier dat van nature in een kudde of groep leeft.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het schaap is een typisch <w>kuddedier</w> dat zich alleen veilig voelt in de groep.",
                            "target_lang_translations": {
                                "en": "The sheep is a typical <w>herd animal</w> that only feels safe within the group."
                            }
                        },
                        {
                            "text": "In het wild zie je vaak hoe een <w>kuddedier</w> instinctief de rest van de groep volgt.",
                            "target_lang_translations": {
                                "en": "In the wild, you often see how a <w>herd animal</w> instinctively follows the rest of the group."
                            }
                        }
                    ],
                    "synonyms": [
                        "groepsdier"
                    ],
                    "antonyms": [
                        "solitair dier"
                    ],
                    "common_phrases": [
                        "typisch kuddedier"
                    ],
                    "target_lang_definitions": {
                        "en": "An animal that naturally lives in a herd or group."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "herd animal",
                                "target_lang_sense_clarification": "an animal that lives as part of a herd"
                            },
                            {
                                "target_lang_word": "gregarious animal",
                                "target_lang_sense_clarification": "a species that lives in flocks or communities"
                            }
                        ]
                    }
                }
            ]
        }
    ]
