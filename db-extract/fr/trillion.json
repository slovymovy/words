        "fr-extract.jsonl": [
            {
                "entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                "word": "trillion",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a8776b27-7190-426b-9a4e-61a085aa5d8e",
                        "entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                        "tags": [
                            "plural"
                        ],
                        "form": "trillions"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "31049a7d-498f-3747-a41b-03bb2dbb99d6",
                        "entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                        "glosses": [
                            "Un milliard de milliards ou un million au cube, selon l’échelle longue. 10¹⁸."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d66b7b64-3aa6-4036-ade1-535a2371aba4",
                                "sense_id": "31049a7d-498f-3747-a41b-03bb2dbb99d6",
                                "text": "Billions’ (douze zéros), trillions (18 zéros), trilliards (21 zéros), quatrillions’(24 zéros)."
                            }
                        ]
                    },
                    {
                        "sense_id": "441db1ea-d5a3-3bae-a793-0182359131bf",
                        "entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                        "glosses": [
                            "ou Un million de millions, selon l’échelle courte. 10¹²."
                        ],
                        "tags": [
                            "Anglicism",
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "0651fe89-a417-478b-932f-c97a98ad59d7",
                                "sense_id": "441db1ea-d5a3-3bae-a793-0182359131bf",
                                "text": "Mais je savais aussi que vingt lettres seulement peuvent former deux quintillions, quatre cent trente-deux quatrillions, neuf cent deux trillions, huit milliards, cent soixante-seize millions, six cent quarante mille combinaisons."
                            },
                            {
                                "example_id": "46f15d33-7c69-4460-a552-eae11db5fb87",
                                "sense_id": "441db1ea-d5a3-3bae-a793-0182359131bf",
                                "text": "[…] les billets en circulation de la Reichsbank seraient échangés contre des nouveaux billets libellés en mark-or, à raison d’un mark-or pour un trillion de mark-papier."
                            },
                            {
                                "example_id": "74f19494-08d1-4abf-b1ff-b21827d84027",
                                "sense_id": "441db1ea-d5a3-3bae-a793-0182359131bf",
                                "text": "Le gouvernement japonais a réagi à la crise par le lancement d’un plan de relance affichant un montant total de 75 trillions de yens (620 milliards d’euros)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7e1f4522-38c9-4eae-9c76-f45e0e2352e1",
                        "source_entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                        "source_sense_id": "31049a7d-498f-3747-a41b-03bb2dbb99d6",
                        "source_sense_description": "10¹⁸",
                        "target_lang_word": "Trillion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trillion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6085fdcd-ca7a-3bb9-82c8-6776aab3494a",
                                        "entry_id": "7ab0b1f4-9c33-3024-b99f-1624f4a4d377",
                                        "glosses": [
                                            "die Zahl 10¹⁸, eine Eins mit 18 Nullen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "907cb455-95df-4453-9050-00705b64b790",
                                                "sense_id": "6085fdcd-ca7a-3bb9-82c8-6776aab3494a",
                                                "text": "Eine Trillion sind tausend Billiarden."
                                            },
                                            {
                                                "example_id": "8b993fd8-941e-44ea-b6f4-654b4a073a17",
                                                "sense_id": "6085fdcd-ca7a-3bb9-82c8-6776aab3494a",
                                                "text": "„Schließlich wusste sich die Regierung nicht mehr anders zu helfen, als am 12. April 2009 den Simbabwe-Dollar ganz aus dem Verkehr zu ziehen und die US-Währung einzuführen, wobei am Ende 300 Trillionen Simbabwe-Dollar einen US-Dollar wert waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8640350f-5a03-4909-88b1-96c879efb036",
                        "source_entry_id": "7195de75-89b5-3773-8cac-7270e67718c0",
                        "source_sense_id": "31049a7d-498f-3747-a41b-03bb2dbb99d6",
                        "source_sense_description": "10¹⁸",
                        "target_lang_word": "quintillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quintillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "Either of two very large amounts:",
                                            "A billion billion: 1 followed by eighteen zeros, 10¹⁸."
                                        ],
                                        "tags": [
                                            "Australian",
                                            "British",
                                            "US",
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b87f9ba-7c57-45cb-8793-8f4af2880815",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "Last week, we used[…]the BBC News website's biggest number: 9,223,372,036,854,775,808, that's 9.2 quintillion[…][the maximum video viewer count on YouTube's] updated counter software."
                                            },
                                            {
                                                "example_id": "a512979d-47e1-4a1a-9d20-a3bd76ce8c52",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "“I’m not sure I understand why we have to send a quadrillion-credit mission to another galaxy.”\nHe looked fleetingly amused. “Quintillion... and we don’t have a choice, Harper. Any of us, really, but humanity especially.”"
                                            },
                                            {
                                                "example_id": "414ea0b3-d8d1-40c4-8d44-e0ba2d2fea04",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "You are currently logged on to the largest version of the internet that has ever existed. By clicking and scrolling, you’re one of the 5 billion–plus people contributing to an unfathomable array of networked information—quintillions of bytes produced each day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a49bae7-5b69-328e-9842-6b579b14ada4",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "Either of two very large amounts:",
                                            "A million quadrillion: 1 followed by 30 zeros, 10³⁰."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "An unspecified very large number."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09f436a-90e6-4121-b97f-5485c4935d3e",
                                                "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                                "text": "Near-synonyms: gazillion; see also Thesaurus:zillion"
                                            },
                                            {
                                                "example_id": "691d3726-1781-43be-a514-71c84001d339",
                                                "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                                "text": "He had like a quintillion excuses for why he couldn't meet his obligation to me."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
