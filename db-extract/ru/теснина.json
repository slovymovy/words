                "senses": [
                    {
                        "sense_id": "eeed6c09-602b-3b13-ac7f-8909172723d8",
                        "entry_id": "02d8196d-0f40-36d8-a614-3371e0457b20",
                        "glosses": [
                            "узкая глубокая речная долина с очень крутыми склонами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1e30176-b3aa-42ca-9826-efed7ffdaa55",
                                "sense_id": "eeed6c09-602b-3b13-ac7f-8909172723d8",
                                "text": "В глубокой теснине Дарьяла, где роется Терек во мгле."
                            }
                        ]
                    },
                    {
                        "sense_id": "116c86b6-caca-3243-8a21-938f500208a9",
                        "entry_id": "02d8196d-0f40-36d8-a614-3371e0457b20",
                        "glosses": [
                            "любой узкий проход, часто между горами, скалами, утёсами"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d721d3e8-e2c4-4e1f-b292-7db9081243dc",
                                "sense_id": "116c86b6-caca-3243-8a21-938f500208a9",
                                "text": "Опасная, скалистая теснина."
                            },
                            {
                                "example_id": "15a4a18f-3811-4b21-a241-844e3bfbf239",
                                "sense_id": "116c86b6-caca-3243-8a21-938f500208a9",
                                "text": "Теснины жизни",
                                "translation": "(об очень тяжёлом положении)."
                            }
                        ]
                    }
                ],
