                        "form": "sie sind gärtnerisch"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "dd3bc873-5e0a-3054-aa6c-b7a48520ee7c",
                        "entry_id": "d93b053b-e462-3b19-9695-ff7b529e2d86",
                        "glosses": [
                            "in Bezug auf oder in der Art eines Gartens, eines Gärtners"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "034efc2b-b77a-4265-a534-292042f9ae8b",
                                "sense_id": "dd3bc873-5e0a-3054-aa6c-b7a48520ee7c",
                                "text": "„Paprika und Chili werden sowohl gärtnerisch wie auch landwirtschaftlich kultiviert.“"
                            },
                            {
                                "example_id": "08d722f7-d73a-431e-9f76-40f8e2255203",
                                "sense_id": "dd3bc873-5e0a-3054-aa6c-b7a48520ee7c",
                                "text": "„Meine Großmutter wies mir eines Tages ein Stück Ackerland hinter dem Haus zu; ich könne mich dort gärtnerisch betätigen.“"
                            },
                            {
                                "example_id": "40c381d8-cbb0-4dd5-88a6-9e4ff7a15261",
                                "sense_id": "dd3bc873-5e0a-3054-aa6c-b7a48520ee7c",
                                "text": "„Zum Landgute gehören häufig auch forstlich und gärtnerisch benutzte, oder auch solche Bodenflächen, welche unbenutzt daliegen.“"
                            },
                            {
                                "example_id": "781a1900-b747-485a-9fba-4b1a86f57988",
                                "sense_id": "dd3bc873-5e0a-3054-aa6c-b7a48520ee7c",
                                "text": "„So gut Bäume wirken können, so verderblich sind gärtnerische Anlagen um die Kirche.“"
                            },
