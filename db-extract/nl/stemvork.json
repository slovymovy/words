                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93480a2d-695f-44af-87ce-c049a36f988b",
                        "source_entry_id": "bf633e43-bfc3-3eed-8c49-d4772e8bfac9",
                        "source_sense_id": "79d7ed39-e499-3f43-9ab7-2f39b0ff6d46",
                        "source_sense_description": "stemvork",
                        "target_lang_word": "diapason",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diapason",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ca7e42c-4faa-3368-8662-b61e8528ca66",
                                        "entry_id": "c8adee27-ddbe-345a-84cc-1e5b8a35fc18",
                                        "glosses": [
                                            "Étendue des sons qu’une voix ou un instrument peut parcourir, depuis le ton le plus bas jusqu’au plus haut."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80c6f44b-597c-43f3-9115-af7aeb5be10e",
                                                "sense_id": "6ca7e42c-4faa-3368-8662-b61e8528ca66",
                                                "text": "Cet air sort du diapason de la voix."
                                            },
                                            {
                                                "example_id": "a0cd6fd2-c6a2-4df0-8bd9-65f3006ed9db",
                                                "sense_id": "6ca7e42c-4faa-3368-8662-b61e8528ca66",
                                                "text": "Le frère dormait si tranquillement dans sa chambre, que l’orchestre de l’Opéra ne l’eût pas éveillé, et cependant le diapason de cet orchestre est célèbre !"
                                            },
                                            {
                                                "example_id": "d397a902-1a9f-4d7f-8f58-96d10f18f52b",
                                                "sense_id": "6ca7e42c-4faa-3368-8662-b61e8528ca66",
                                                "text": "Cela avait commencé si fort, sur un diapason si aigu, à cause du drame, de l’auto, du sang, de tout, qu’ils avaient atteint tout de suite au paroxysme."
                                            },
                                            {
                                                "example_id": "e655bc28-b261-48a9-9883-c600e09c6853",
                                                "sense_id": "6ca7e42c-4faa-3368-8662-b61e8528ca66",
                                                "text": "Les voix montèrent à un diapason extrême."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22af1d2c-fe4d-3a11-88f2-27fec202de48",
                                        "entry_id": "c8adee27-ddbe-345a-84cc-1e5b8a35fc18",
                                        "glosses": [
                                            "Instrument d’acier composé d’une tige aux branches en forme de U dont on se sert pour prendre le ton."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae17bc4c-f1c5-495a-ad36-562c7701e420",
                                                "sense_id": "22af1d2c-fe4d-3a11-88f2-27fec202de48",
                                                "text": "Chaque diapason est monté sur sa caisse de résonnance^([sic]) et vibre assez longtemps pour qu'on puisse compter les battements pendant une minute et demie."
                                            },
                                            {
                                                "example_id": "b0025990-36bc-48ed-a91c-740e986cb3a4",
                                                "sense_id": "22af1d2c-fe4d-3a11-88f2-27fec202de48",
                                                "text": "Toute cloche qui n'a pas été accordée par l’instrument musical, par le diapason dont je vous parlais tout à l'heure, est une cloche qui sonne faux et qui n'est plus qu'un bloc de métal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                        "entry_id": "c8adee27-ddbe-345a-84cc-1e5b8a35fc18",
                                        "glosses": [
                                            "Manière actuelle ou habituelle dont quelqu’un vit, agit, pense."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4a0c2cb8-01bb-4695-928b-688d6658cf15",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "Dans l’obscure salle à manger de la Crouts, l’anxiété vient d’atteindre son diapason le plus intense."
                                            },
                                            {
                                                "example_id": "68cbe528-d835-484f-b53e-8052d239597e",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "Pour moi, je n’ai jamais eu le goût des confidences, j’en ai si rarement fait sur mes sentiments que mes meilleurs amis ne sauraient dire qui il m’est arrivé d’aimer, et il fallait que je me force pour être au diapason de ces plaisanteries."
                                            },
                                            {
                                                "example_id": "288d0911-0b4c-41f8-a830-68384adfe4f2",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "Quand il se remit à écrire, après une interruption de dix ans, il n’était plus au diapason."
                                            },
                                            {
                                                "example_id": "0a113154-89fc-4a99-8a4f-a9e8c9cbf765",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "Comme il arrive souvent entre deux êtres dont les destinées complices ont élevé l’âme à un égal diapason, — engageant la conversation assez brusquement, — il eut néanmoins le bonheur bizarre de trouver une personne disposée à l’écouter et à lui répondre."
                                            },
                                            {
                                                "example_id": "2ed9b01e-d0a6-4e7e-aae2-19ef271cefad",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "À un diapason plus grave et dans une mesure plus lente, les églises retentissaient des échos de l’exaltation martiale, […]."
                                            },
                                            {
                                                "example_id": "34a4f00e-b396-4b55-ace7-f30da53b4642",
                                                "sense_id": "a51b3320-39a4-3dc7-8d3e-791987b3ad41",
                                                "text": "La conversation continue ainsi. Elle est si enjouée que les quatre vieilles demoiselles, ne se sentant pas au diapason, se taisent. Mais elles suivent, avec un même mouvement de tête, les phrases de M. le Grand Doyen, et sourient du même sourire aux mêmes répliques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "109e07f1-0d1b-3827-adde-bb347f7b2650",
                                        "entry_id": "c8adee27-ddbe-345a-84cc-1e5b8a35fc18",
                                        "glosses": [
                                            "Gabarit utilisé pour le tracé des hachures exprimant le relief."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
