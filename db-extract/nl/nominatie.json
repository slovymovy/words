                "senses": [
                    {
                        "sense_id": "1bdb01b4-756b-3f26-bc72-53349fea274e",
                        "entry_id": "053527a6-7f1d-3874-aabb-191871145b60",
                        "glosses": [
                            "voordracht van personen, genoemd worden als gelukkige of slachtoffer voor een bepaald proces"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "494b952d-5ddc-4c57-9bca-776402e2bcdb",
                                "sense_id": "1bdb01b4-756b-3f26-bc72-53349fea274e",
                                "text": "Poging om nominatie Trump te blokkeren tijdens conventie helaas mislukt"
                            },
                            {
                                "example_id": "60e49812-bcb3-4a33-8ace-f9df45ea4051",
                                "sense_id": "1bdb01b4-756b-3f26-bc72-53349fea274e",
                                "text": "Het ziekenhuis - waar de drie dochters van koning Willem-Alexander en koningin Máxima zijn geboren - staat al jaren op de nominatie om gesloten te worden. Zo werd in 2019 al aan het personeel gecommuniceerd dat het twee jaar later zou sluiten."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5dbd1f11-fff7-4969-ba6b-32491eb7f9f0",
                        "source_entry_id": "053527a6-7f1d-3874-aabb-191871145b60",
                        "source_sense_id": "1bdb01b4-756b-3f26-bc72-53349fea274e",
                        "target_lang_word": "nomination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                        "entry_id": "06d7e4f7-3569-32ec-b7b8-b0ca15da8fc4",
                                        "glosses": [
                                            "An act or instance of nominating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcb07690-1a79-452f-928d-a31b7606c984",
                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "After the nomination, he was required to accept or decline the offer."
                                            },
                                            {
                                                "example_id": "331fa207-5d4a-4345-aa1b-b765e9e2cf3b",
                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "Her nomination for the award came as a pleasant surprise."
                                            },
                                            {
                                                "example_id": "194a0c53-5447-47e5-9d50-5928ac622146",
                                                "sense_id": "a01834ee-b193-338d-ab90-8a226821308b",
                                                "text": "The committee announced his nomination for the position of president."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a7c269b-fb04-3bf6-b325-2ebfcd46be30",
                                        "entry_id": "06d7e4f7-3569-32ec-b7b8-b0ca15da8fc4",
                                        "glosses": [
                                            "The result of such a nomination act."
                                        ],
                                        "tags": [
                                            "common",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4c917c5-6c89-3242-9447-5c238f5c8df2",
                                        "entry_id": "06d7e4f7-3569-32ec-b7b8-b0ca15da8fc4",
                                        "glosses": [
                                            "A device or means by which a person or thing is nominated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "059f0779-58a7-45b0-b80a-1331ee5b2666",
                        "source_entry_id": "053527a6-7f1d-3874-aabb-191871145b60",
                        "source_sense_id": "1bdb01b4-756b-3f26-bc72-53349fea274e",
                        "target_lang_word": "nomination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nomination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                                        "glosses": [
                                            "Action de nommer à un emploi, à une charge, à une dignité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13ebf628-5c14-470a-9454-76df42596049",
                                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                                "text": "La seconde mesure que l’empereur a adoptée est la nomination d’un ministre auprès du gouvernement de la Colombie."
                                            },
                                            {
                                                "example_id": "6d4c9d67-ac1f-4499-b13f-25164eb5ce0b",
                                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                                "text": "Vous pensez bien, dit-il, que la nomination d’un chanoine étranger au diocèse n’a pas été considérée d’un œil indifférent par le clergé de Chartres."
                                            },
                                            {
                                                "example_id": "e82c847e-2a3b-4d0d-b38f-2875c71605fe",
                                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                                "text": "L'assemblée a procédé alors à la nomination du Comité permanent."
                                            },
                                            {
                                                "example_id": "b833ecd1-b745-40a0-969d-d952fee6134f",
                                                "sense_id": "ff69b259-8f4b-37a7-bde0-eabc4afee650",
                                                "text": "Le revirement d’Enzo Le Fée, qui voulait quitter la Bretagne cet été avant la nomination de Régis Le Bris, illustre cela."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc693769-1f4e-3b60-b166-adc3b44f9f0e",
                                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                                        "glosses": [
                                            "Droit de nommer à un emploi, à une charge, à une dignité, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "deb0b122-8f68-47d4-8dd8-077965a5b6cf",
                                                "sense_id": "cc693769-1f4e-3b60-b166-adc3b44f9f0e",
                                                "text": "La dignité de lord lieutenant est, rigoureusement parlant, à la nomination du Roi; mais elle est de fait, dans chaque comté, le partage héréditaire de quelque grande famille, d’où elle ne sort presque jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945d664a-8fdd-3f57-8218-c0d56280e1c1",
                                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                                        "glosses": [
                                            "Mentions obtenues dans un concours."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "444e513c-a886-454b-9bc4-55c67758cba8",
                                                "sense_id": "945d664a-8fdd-3f57-8218-c0d56280e1c1",
                                                "text": "Il a eu trois nominations au Concours général."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98e827d9-0688-31f5-bc68-791b5312bce6",
                                        "entry_id": "d91aceb3-9a10-39ff-99a4-e00c1b8a5fd8",
                                        "glosses": [
                                            "Présélection d’un artiste dans une catégorie lors d’un concours cinématographique ou télévisuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5504d2f2-e077-400d-a62b-0ff8dd39f223",
                                                "sense_id": "98e827d9-0688-31f5-bc68-791b5312bce6",
                                                "text": "Attention, contrairement à une idée largement répandue obtenir une nomination dans une catégorie ne signifie pas être le lauréat (le vainqueur). En effet, la nomination est la dernière étape sélective avant le vote final qui désignera le lauréat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
