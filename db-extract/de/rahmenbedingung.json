                ],
                "senses": [
                    {
                        "sense_id": "6d50f1cf-91dc-3a5d-911a-236b26b2c226",
                        "entry_id": "cbee3730-df02-3b6d-9709-99e5363393c0",
                        "glosses": [
                            "eine Bedingung, die von außerhalb des betrachteten Systems oder Vorgangs vorgegeben ist"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "8b2e7f5c-dfb3-4204-afef-a11b0eae1668",
                                "sense_id": "6d50f1cf-91dc-3a5d-911a-236b26b2c226",
                                "text": "Wir haben schlechte Rahmenbedingungen."
                            },
                            {
                                "example_id": "3dcb3f66-0039-4b11-b1a5-ea603602b7f3",
                                "sense_id": "6d50f1cf-91dc-3a5d-911a-236b26b2c226",
                                "text": "„Die gesellschaftlichen Rahmenbedingungen, die ethische Substanz einer Gemeinschaft und die Existenz oder Nichtexistenz einer Wagniserziehung tragen einen wesentlichen Verantwortungsanteil daran, in welche Wertrichtung sich die Wagnistendenzen bewegen.“"
                            },
                            {
                                "example_id": "ba5bfb90-f0f3-489b-99bd-02659aaed0b5",
                                "sense_id": "6d50f1cf-91dc-3a5d-911a-236b26b2c226",
                                "text": "„Während der Staat für die Schwarzen nur sehr grobe Rahmenbedingungen vorgab und den Rest den Missionen überließ, nahm er für die weißen Schüler die unmittelbare Verantwortung auf sich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
