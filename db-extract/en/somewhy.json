                    },
                    {
                        "translation_id": "4f0fc050-b7f0-4d81-af25-0060e4d27040",
                        "source_entry_id": "803c96a7-902a-38f9-876f-e9e59d10487e",
                        "source_sense_id": "ba1105b5-8e6a-3f0d-a21e-f1d6ab56109c",
