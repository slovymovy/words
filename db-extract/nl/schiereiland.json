                                    {
                                        "sense_id": "d3417ea5-eafa-3225-85fc-07d80297052d",
                                        "entry_id": "5addacc6-2d89-3e04-b38c-e8cf31b24968",
                                        "glosses": [
                                            "A piece of land projecting into water from a larger land mass."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab90db4-1b6b-4aa8-9bf7-426ee74b80de",
                                                "sense_id": "d3417ea5-eafa-3225-85fc-07d80297052d",
                                                "text": "Man cancelling Lisa's inauguration as president: I sentence you to a lifetime of horror on Monster Island. Don't worry, it's just a name.\n[Lisa and others are chased by fire-breathing monsters]\nLisa: He said it was just a name!\n Man being chased by monsters: What he meant is that Monster Island is actually a peninsula."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffca10d7-2aea-4d1e-ab62-306b08165e65",
                        "source_entry_id": "743a70b5-97ee-3acd-9324-aed776b729a9",
                        "source_sense_id": "7b3042fa-d826-3466-820a-3f1e51d526da",
                        "source_sense_description": "een landmassa die voor het grootste deel door water omgeven wordt, en slechts op (relatief) smalle verbinding heeft met het vasteland.",
                        "target_lang_word": "péninsule",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "péninsule",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "37f46d5f-8285-313d-8644-c155e8282b60",
                                        "entry_id": "b2d326e3-6d77-3ac5-84bb-fba3e3576fe0",
                                        "glosses": [
                                            "Contrée qui s’avance dans la mer et est unie au continent par un seul côté."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b2fe097-4658-48d3-8cfc-5615e05ed640",
                                                "sense_id": "37f46d5f-8285-313d-8644-c155e8282b60",
                                                "text": "[…], de même l’Espagne et le Portugal. Cette dernière péninsule a été isolée du reste de l’Europe par la surrection de la chaîne des Pyrénées."
                                            },
                                            {
                                                "example_id": "67d21508-9c94-474c-889e-d32b0decf0b9",
                                                "sense_id": "37f46d5f-8285-313d-8644-c155e8282b60",
                                                "text": "En 1980, l’Italie est d'ailleurs déjà celui des pays du Marché commun qui a les plus graves problèmes d'environnement : des égouts de Naples aux pollutions chimiques de la plaine du Pô, la péninsule exprime son incivisme glorieux. Dans une civilisation industrielle avancée, le chacun pour sa peau se paye au prix fort."
                                            },
                                            {
                                                "example_id": "6934b3b9-2fd1-4b35-8010-4365c0a8ec28",
                                                "sense_id": "37f46d5f-8285-313d-8644-c155e8282b60",
                                                "text": "Les Arabes de la péninsule ne possédaient rien d’autre qu’une homogénéité ethnique et culturelle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
