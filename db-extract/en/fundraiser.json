                "senses": [
                    {
                        "sense_id": "325a6ee7-a8df-3d41-a2e7-3fdc0d9198b8",
                        "entry_id": "f822cf94-684a-3058-9843-3fcc0d8e5f52",
                        "glosses": [
                            "An event undertaken to get money by voluntary contributions for a particular activity or cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e170f7ae-1cc0-4d09-bcc4-699ebbcd9cf4",
                                "sense_id": "325a6ee7-a8df-3d41-a2e7-3fdc0d9198b8",
                                "text": "This year’s fundraiser will be a walkathon."
                            },
                            {
                                "example_id": "e4c03528-0436-4164-a34e-6949794a78a1",
                                "sense_id": "325a6ee7-a8df-3d41-a2e7-3fdc0d9198b8",
                                "text": "But the most politically damaging blow came from a late-breaking apostate: Mr. Clooney, who just weeks earlier had spent time with Mr. Biden and helped deliver $28 million to his campaign at a Los Angeles fund-raiser."
                            }
                        ]
                    },
                    {
                        "sense_id": "e38f06e4-95a4-3ef1-96ff-cc64ad468a21",
                        "entry_id": "f822cf94-684a-3058-9843-3fcc0d8e5f52",
                        "glosses": [
                            "A person who collects money from the public for some cause."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96efd86a-1a73-46a4-9ff1-7360ce76e773",
                                "sense_id": "e38f06e4-95a4-3ef1-96ff-cc64ad468a21",
                                "text": "She works as fundraiser for the Democratic Party."
                            },
                            {
                                "example_id": "52c6908e-9089-48a4-845c-bc779f7c8357",
                                "sense_id": "e38f06e4-95a4-3ef1-96ff-cc64ad468a21",
                                "text": "The symphony will employ women as musicians, conductors, administrators, musicologists, composers and fund raisers."
                            }
                        ]
                    }
                ],
                "translations": [
