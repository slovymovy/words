                "senses": [
                    {
                        "sense_id": "7a79081a-794d-39a6-bee3-81ece1add009",
                        "entry_id": "d81e6ab9-dc75-36e5-89c2-b6bd362d0039",
                        "glosses": [
                            "Modell eines Schiffs, welches sich im Innern einer (meist aus Weißglas bestehenden) Glasflasche befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4fd06ef7-f183-4435-ae9c-b76a62f682eb",
                                "sense_id": "7a79081a-794d-39a6-bee3-81ece1add009",
                                "text": "„So erzählt man sich unter den Kunsthandwerkern von einer Familie auf den Philippinen, die mit mörderischem Tempo in Serie Buddelschiffe für den Großhandel produziert.“"
                            },
                            {
                                "example_id": "7779519c-e010-4c3d-bfd9-6e7fb7cceb49",
                                "sense_id": "7a79081a-794d-39a6-bee3-81ece1add009",
                                "text": "„So geht der Stapellauf eines Buddelschiffes nach dem traditionellen Fadenzugsystem etwa bei dem Profi Marcus Schormann vonstatten.“"
                            },
                            {
                                "example_id": "cd25a2e8-b71a-4530-b6c8-07874f40b2cf",
                                "sense_id": "7a79081a-794d-39a6-bee3-81ece1add009",
                                "text": "„In fast allen maritimen Museen der Welt sind Buddelschiffe zu bewundern.“"
                            },
                            {
                                "example_id": "47a4b03e-505b-40fe-9a82-08c9717cc2e9",
                                "sense_id": "7a79081a-794d-39a6-bee3-81ece1add009",
                                "text": "„Er fuhr mit den Fingern über ein Buddelschiff, das in einem der Bücherregale stand, in der hellblauen Glasflasche war ein Dreimaster ausgestellt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
