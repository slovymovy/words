                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5aaf423a-cdf2-3a1d-a409-a1272211319d",
                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
                                        "glosses": [
