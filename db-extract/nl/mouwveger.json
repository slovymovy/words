                "senses": [
                    {
                        "sense_id": "35e53e9f-7d83-334d-afe3-95c05e269b3c",
                        "entry_id": "7fc8ee60-a8d7-37ed-8e06-456bd695b841",
                        "glosses": [
                            "iemand die heel erg aardig en vriendelijk doet op een huichelachtige manier om er zelf beter van te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7032ae11-39a5-4fbc-bc9f-9a8c0c9ab163",
                                "sense_id": "35e53e9f-7d83-334d-afe3-95c05e269b3c",
                                "text": "Pas toen er een stel mouwvegers bij ons kwam staan, ging hij weer in ‘stramme modus’. Die mensen waren misschien wel vreemder dan de royal zelf. Ze lachten te breed, staarden en leken vast van plan hun hand nooit meer te wassen nadat ze die van hem hadden geschud."
                            },
                            {
                                "example_id": "07f78a6c-66c5-48e8-8ba8-86d162a7a665",
                                "sense_id": "35e53e9f-7d83-334d-afe3-95c05e269b3c",
                                "text": "Ik werk zonder agent en zonder manager en dus moet ik zelf maar bellen en contacten leggen. Soms word je gedwarsboomd door regisseurs die hun keuze al lang gemaakt hebben. Wat het ook is: ik ben geen mouwveger. Ik ga nooit naar feestjes waar de rollen worden verdeeld."
                            }
                        ]
                    }
                ],
