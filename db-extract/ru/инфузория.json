                "senses": [
                    {
                        "sense_id": "19defbce-3cf2-39df-8d7a-bf5f8247bca3",
                        "entry_id": "5b188da5-8867-3003-88ee-4a59976dfb29",
                        "glosses": [
                            "зоол. наиболее высокоорганизованное простейшее одноклеточное животное, обитающее в пресных и солёных водах"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5ee76c3-82c3-4d04-8263-60a341e6276f",
                                "sense_id": "19defbce-3cf2-39df-8d7a-bf5f8247bca3",
                                "text": "Инфузории — эукариотные одноклеточные простейшие размером от 10 мк до 4,5 мм."
                            },
                            {
                                "example_id": "e3b3c0e9-e804-4808-89bc-486b762bcf35",
                                "sense_id": "19defbce-3cf2-39df-8d7a-bf5f8247bca3",
                                "text": "Инфузория плавает при помощи постоянного биения ресничек, покрывающих всю поверхность клетки."
                            }
                        ]
                    }
