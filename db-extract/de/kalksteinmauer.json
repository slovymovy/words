                "senses": [
                    {
                        "sense_id": "08c9d2d8-447f-3e96-8831-bef99dc7ed88",
                        "entry_id": "f3d7f962-9d8d-3ee8-9976-11f4d64ee020",
                        "glosses": [
                            "aus Kalkstein erbaute Mauer"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348374c9-de61-4f56-ac78-a097cc904b6d",
                                "sense_id": "08c9d2d8-447f-3e96-8831-bef99dc7ed88",
                                "text": "„Die weißen Kalksteinmauern von Newgrange sind schon von Weitem zu sehen.“"
                            },
                            {
                                "example_id": "4b4078bd-17a5-428e-9bd9-778b68fcb522",
                                "sense_id": "08c9d2d8-447f-3e96-8831-bef99dc7ed88",
                                "text": "„Im ‚Ottonischen Wall‘ an der Heuneburg stieß das Team von [Jörg] Bofinger […] 30 Zentimeter unter der Grasnarbe auf zwei Kalksteinmauern, Reste einer Toranlage und zugleich das Fundament der legendären Burgmauer aus Lehmziegeln.“"
                            },
                            {
                                "example_id": "132156f3-8faa-4e61-9dd0-bf20ccb47438",
                                "sense_id": "08c9d2d8-447f-3e96-8831-bef99dc7ed88",
                                "text": "„Die Scheuern des ehemaligen Küchenhofes und die geräumigen Stallungen für die Rinder, die auf der Alm sommerten, erwiesen sich in gutem Zustand, wie auch das große Wohnhaus, dessen unteres Stockwerk massiv war. Die Kalksteinmauern waren außerordentlich dick, zum Schutz gegen die Strenge des langen Winters; denn das Vigiltal liegt sehr hoch, höher als der Brocken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
