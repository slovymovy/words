{
    "word_family": [
        "straggler",
        "straggly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "618beca2-911b-3e6d-82d8-5a6585a837ae",
                    "sense_definition": "To move along slowly so as to remain some distance behind the person or people in front.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tired hikers began to <w>straggle</w> behind the rest of the group as the trail got steeper.",
                            "target_lang_translations": {
                                "pl": "Zmęczeni wędrowcy zaczęli <w>wlec się</w> za resztą grupy, gdy szlak stał się bardziej stromy.",
                                "ru": "Уставшие туристы начали <w>отставать</w> от остальной группы, когда тропа стала круче."
                            }
                        },
                        {
                            "text": "A few students would always <w>straggle</w> into the classroom several minutes after the bell had rung.",
                            "target_lang_translations": {
                                "pl": "Kilku uczniów zawsze <w>wchodziło pojedynczo</w> do klasy kilka minut po dzwonku.",
                                "ru": "Несколько учеников всегда <w>плелись</w> в класс через несколько минут после звонка."
                            }
                        }
                    ],
                    "synonyms": [
                        "lag",
                        "dawdle",
                        "loiter"
                    ],
                    "antonyms": [
                        "lead",
                        "hasten"
                    ],
                    "common_phrases": [
                        "straggle behind",
                        "straggle along"
                    ],
                    "target_lang_definitions": {
                        "pl": "Poruszać się powoli, pozostając w tyle za grupą lub osobą idącą z przodu.",
                        "ru": "Двигаться медленно, оставаясь на некотором расстоянии позади идущего впереди человека или группы."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wlec się",
                                "target_lang_sense_clarification": "poruszać się powoli z tyłu"
                            },
                            {
                                "target_lang_word": "zostawać w tyle",
                                "target_lang_sense_clarification": "nie nadążać za grupą"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отставать",
                                "target_lang_sense_clarification": "двигаться медленнее группы"
                            },
                            {
                                "target_lang_word": "плестись",
                                "target_lang_sense_clarification": "идти медленно и неохотно позади"
                            },
                            {
                                "target_lang_word": "растягиваться",
                                "target_lang_sense_clarification": "о группе людей, идущих нестройной цепочкой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "97a13e2d-856d-3a0e-a94c-b1eadf7e5d95",
                    "sense_definition": "To stray, rove, or wander from a normal course and others of its kind.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gardener had to trim the branches that started to <w>straggle</w> over the neighbor's fence.",
                            "target_lang_translations": {
                                "pl": "Ogrodnik musiał przyciąć gałęzie, które zaczęły <w>rozrastać się</w> na płot sąsiada.",
                                "ru": "Садовнику пришлось подрезать ветки, которые начали <w>перелезать</w> через соседский забор."
                            }
                        },
                        {
                            "text": "He watched the sheep <w>straggle</w> away from the main flock to find better grass.",
                            "target_lang_translations": {
                                "pl": "Obserwował, jak owce <w>odłączają się</w> od głównego stada w poszukiwaniu lepszej trawy.",
                                "ru": "Он наблюдал, как овцы <w>отбиваются</w> от основного стада в поисках лучшей травы."
                            }
                        }
                    ],
                    "synonyms": [
                        "stray",
                        "wander",
                        "ramble",
                        "rove"
                    ],
                    "common_phrases": [
                        "straggle away"
                    ],
                    "target_lang_definitions": {
                        "pl": "Oddalać się, błąkać lub zbaczać z wyznaczonego kursu lub od reszty stada/grupy.",
                        "ru": "Отклоняться от курса, бродить или отделяться от себе подобных."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozłazić się",
                                "target_lang_sense_clarification": "o grupie lub roślinach rosnących w nieładzie"
                            },
                            {
                                "target_lang_word": "odłączać się",
                                "target_lang_sense_clarification": "oddalać się od głównej grupy"
                            },
                            {
                                "target_lang_word": "błąkać się",
                                "target_lang_sense_clarification": "chodzić bez celu"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "отбиваться",
                                "target_lang_sense_clarification": "отделяться от группы или стада"
                            },
                            {
                                "target_lang_word": "разрастаться",
                                "target_lang_sense_clarification": "о растениях, растущих беспорядочно"
                            },
                            {
                                "target_lang_word": "блуждать",
                                "target_lang_sense_clarification": "ходить без четкого направления"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae25bbb2-df4d-3adc-862e-fa576ed6443c",
                    "sense_definition": "To act or spread out in a disorderly, irregular, or scattered way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disorder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The small houses <w>straggled</w> down the hillside in no particular order.",
                            "target_lang_translations": {
                                "pl": "Małe domki <w>rozciągały się</w> w nieładzie wzdłuż zbocza wzgórza.",
                                "ru": " Маленькие домики <w>раскинулись</w> по склону холма в полном беспорядке."
                            }
                        },
                        {
                            "text": "The soldiers <w>straggled</w> out from the trees in small clusters rather than organized ranks.",
                            "target_lang_translations": {
                                "pl": "Żołnierze <w>wyłaniali się</w> spomiędzy drzew w małych grupkach, a nie w zorganizowanych szeregach.",
                                "ru": "Солдаты <w>выходили</w> из леса разрозненными группами, а не организованным строем."
                            }
                        }
                    ],
                    "synonyms": [
                        "scatter",
                        "sprawl"
                    ],
                    "common_phrases": [
                        "straggle out"
                    ],
                    "target_lang_definitions": {
                        "pl": "Rozprzestrzeniać się lub występować w nieuporządkowany, nieregularny lub rozproszony sposób.",
                        "ru": "Располагаться или распространяться беспорядочно, нерегулярно или разрозненно."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "rozciągać się",
                                "target_lang_sense_clarification": "o budynkach lub grupach w nieładzie"
                            },
                            {
                                "target_lang_word": "rozpraszać się",
                                "target_lang_sense_clarification": "występować w nieładzie"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разбрасываться",
                                "target_lang_sense_clarification": "быть расположенным в беспорядке"
                            },
                            {
                                "target_lang_word": "растягиваться",
                                "target_lang_sense_clarification": "располагаться длинной неровной линией"
                            },
                            {
                                "target_lang_word": "беспорядочно расти",
                                "target_lang_sense_clarification": "о растительности или застройке"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "629ed60a-bc7b-3b38-b4a7-f178dd37064f",
                    "sense_definition": "An irregular, spread-out, or scattered group of people or things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A <w>straggle</w> of protesters marched down the street, looking tired and disorganized.",
                            "target_lang_translations": {
                                "pl": "Rozproszona <w>grupka</w> protestujących maszerowała ulicą, wyglądając na zmęczoną i zdezorganizowaną.",
                                "ru": "<w>Разрозненная группа</w> протестующих маршировала по улице, выглядя усталой и дезорганизованной."
                            }
                        },
                        {
                            "text": "The village consisted of a few shops and a <w>straggle</w> of houses along the main road.",
                            "target_lang_translations": {
                                "pl": "Wieś składała się z kilku sklepów i <w>rozrzuconych</w> wzdłuż głównej drogi domów.",
                                "ru": "Деревня состояла из нескольких магазинов и <w>беспорядочно разбросанных</w> домов вдоль главной дороги."
                            }
                        }
                    ],
                    "synonyms": [
                        "sprinkling",
                        "scattering"
                    ],
                    "antonyms": [
                        "cluster",
                        "throng"
                    ],
                    "common_phrases": [
                        "straggle of houses",
                        "straggle of people"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nieregularna, rozproszona lub nieuporządkowana grupa ludzi lub rzeczy.",
                        "ru": "Нерегулярная, растянутая или разрозненная группа людей или предметов."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "grupka",
                                "target_lang_sense_clarification": "mała, nieuporządkowana grupa"
                            },
                            {
                                "target_lang_word": "rozproszona grupa",
                                "target_lang_sense_clarification": "osoby lub obiekty w nieładzie"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "разрозненная группа",
                                "target_lang_sense_clarification": "люди, идущие не вместе"
                            },
                            {
                                "target_lang_word": "беспорядочное скопление",
                                "target_lang_sense_clarification": "предметы, расположенные хаотично"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b5e7e618-85f1-3c32-8ee4-dd87b8513668",
                    "sense_definition": "Something that has strayed beyond normal limits; an outlier.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "outlier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a <w>straggle</w> of sense in his otherwise incoherent speech.",
                            "target_lang_translations": {
                                "pl": "W jego skądinąd niespójnym przemówieniu pojawił się <w>cień</w> sensu.",
                                "ru": "В его в остальном бессвязной речи был лишь <w>проблеск</w> смысла."
                            }
                        },
                        {
                            "text": "The map showed the main forest and a small <w>straggle</w> of trees further north.",
                            "target_lang_translations": {
                                "pl": "Mapa pokazywała główny las i małe <w>skupisko</w> drzew dalej na północ.",
                                "ru": "На карте был показан основной лес и небольшая <w>группка</w> деревьев дальше на север."
                            }
                        }
                    ],
                    "synonyms": [
                        "outlier",
                        "exception"
                    ],
                    "target_lang_definitions": {
                        "pl": "Coś, co wykracza poza normalne granice; pojedynczy, odosobniony element.",
                        "ru": "Что-то, что вышло за пределы обычных границ; единичный, обособленный элемент."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "niedobitki",
                                "target_lang_sense_clarification": "pozostałości po większej grupie"
                            },
                            {
                                "target_lang_word": "odosobniony element",
                                "target_lang_sense_clarification": "coś występującego poza głównym skupiskiem"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "единичное проявление чего-либо (напр. смысла)"
                            },
                            {
                                "target_lang_word": "отдельные элементы",
                                "target_lang_sense_clarification": "единичные объекты вне основной группы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}