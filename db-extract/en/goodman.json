                    {
                        "sense_id": "7632dfbc-0908-3908-911d-cdafde3d7df8",
                        "entry_id": "b5b28a4b-98a5-31f9-a9d8-ac98995084e4",
                        "glosses": [
                            "A husband; the master of a house or family."
                        ],
                        "tags": [
                            "Scotland",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "1e384d04-b821-4a76-a9ec-91a81abc296b",
                                "sense_id": "7632dfbc-0908-3908-911d-cdafde3d7df8",
                                "text": "Come, let us take our fill of love until the morning: let us solace ourselves with loves. For the goodman is not at home, he is gone a long journey."
                            },
                            {
                                "example_id": "b6f983c1-733b-49ad-9ee6-7bb9d1bd2bd6",
                                "sense_id": "7632dfbc-0908-3908-911d-cdafde3d7df8",
                                "text": "‘The gudeman,—he's done with t' paper, and you'll keep it for good and all.’"
                            },
                            {
                                "example_id": "7b9d0277-aa96-4b5a-a22f-e2142721f9a1",
                                "sense_id": "7632dfbc-0908-3908-911d-cdafde3d7df8",
                                "text": "The centre of the kitchen was the well-caumed fireside, the saut girnel in the jambs, the goodman's seat between the lowe and the candle, and pussy bawdrons not far from the warmth of the ace."
                            }
                        ]
                    }
