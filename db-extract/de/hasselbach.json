                ],
                "senses": [
                    {
                        "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                        "entry_id": "ac71f513-623f-3b30-8542-acd1acb59011",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2fa6db42-1136-431a-98b7-125d7d3a8c5d",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Frau Hasselbach ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "90026a3a-9896-4257-a1de-d6a5e9385a18",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Herr Hasselbach wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "db114af8-57ef-43b4-a1b6-f16ded4ba2c4",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Die Hasselbachs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "23a6cba7-6ae2-42dc-880b-06a633fdbd9f",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Der Hasselbach trägt nie die Schals, die die Hasselbach ihm strickt."
                            },
                            {
                                "example_id": "b6b591ba-5d34-4692-9d8b-4eab16cfb8e1",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hasselbach kommt, geht der Herr Hasselbach.“"
                            },
                            {
                                "example_id": "e4e0ef57-7402-4139-bbc3-e38be331930d",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Hasselbach kommt und geht."
                            },
                            {
                                "example_id": "988606df-e636-42b1-a3f0-7f6b45dfb3dc",
                                "sense_id": "4496b864-b6d0-37bc-92ae-b6ae2c7a2d51",
                                "text": "Hasselbachs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
