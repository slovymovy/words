                "senses": [
                    {
                        "sense_id": "a3aa43fe-86f2-39bf-8a73-033231758377",
                        "entry_id": "a6465bbc-7b75-34ee-afb5-03dbb610ed48",
                        "glosses": [
                            "bezinteresowne świadczenie pomocy"
                        ],
                        "tags": [],
