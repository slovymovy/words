                    {
                        "translation_id": "31b9cef9-8e57-4b3f-b309-9ec140495ff2",
                        "source_entry_id": "45245305-11e7-3731-ac07-debb353dd092",
                        "source_sense_id": "8f234ba5-835e-34eb-9033-f96889f2e310",
                        "target_lang_word": "Moschusochse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Moschusochse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e3e56ca4-3a75-3769-b241-7a912316461a",
                                        "entry_id": "da5c103c-543e-3261-b166-5ae9b6184b59",
                                        "glosses": [
                                            "arktisches Säugetier mit langem Fell und gebogenen Hörnern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44b140cd-6072-4f87-a52d-35d241959fb9",
                                                "sense_id": "e3e56ca4-3a75-3769-b241-7a912316461a",
                                                "text": "Moschusochsen sind Herdentiere."
                                            },
                                            {
                                                "example_id": "780644a7-5638-438c-a0cf-91388523846c",
                                                "sense_id": "e3e56ca4-3a75-3769-b241-7a912316461a",
                                                "text": "„Eigentlich ist sie keine Expertin für Vögel - ihr Forschungsgebiet sind Moschusochsen, jene Urviecher, die jemand in den Sechzigerjahren in der Nähe des Flughafens von Kangerlussuaq angesiedelt hat - und die sehr zartes Fleisch liefern.“"
                                            },
                                            {
                                                "example_id": "5ede8e61-3e59-48ca-92a8-7a861dc51b0a",
                                                "sense_id": "e3e56ca4-3a75-3769-b241-7a912316461a",
                                                "text": "„Immer weiter führte ihn seine Jagd, fort von den fruchtbaren Ebenen mit ihren Mammuts, ihren Moschusochsen und Karibus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
