                "senses": [
                    {
                        "sense_id": "33c2f9e6-34f5-3399-84c2-46503a6d4356",
                        "entry_id": "f092aaa6-a6a0-32d1-b992-049c91d5bf34",
                        "glosses": [
                            "auf Guthabenbasis geführtes Konto mit grundlegenden Funktionen und ohne Anspruch auf einen Dispositionskredit oder eine Kreditkarte, dessen Führung für jeden Kunden den Banken seit 2016 gesetzlich vorgeschrieben ist"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "e792b386-be36-4013-8283-3e9f8e874eb2",
                                "sense_id": "33c2f9e6-34f5-3399-84c2-46503a6d4356",
                                "text": "Alle Geldhäuser sind demnach verpflichtet, Menschen ohne festen Wohnsitz auf Wunsch ein Basiskonto einzurichten."
                            },
                            {
                                "example_id": "9ccd4e4a-aed6-48d4-93b6-b7005a19b2cf",
                                "sense_id": "33c2f9e6-34f5-3399-84c2-46503a6d4356",
                                "text": "Als am teuersten erwies sich dabei das Basiskonto der Hypovereinsbank (159,96 Euro/Jahr), das auch Versicherungsleistungen enthält."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
