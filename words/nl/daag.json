                        {
                            "text": "Ik moet nu echt gaan, <w>daag</w>!",
                            "target_lang_translations": {
                                "en": "I really have to go now, <w>bye</w>!",
                                "ru": "Мне правда пора, <w>пока</w>!",
                                "pl": "Naprawdę muszę już iść, <w>cześć</w>!",
                                "de": "Ich muss jetzt wirklich gehen, <w>tschüss</w>!",
                                "fr": "Je dois vraiment y aller maintenant, <w>salut</w> !",
                                "it": "Devo proprio andare ora, <w>ciao</w>!",
                                "cs": "Už opravdu musím jít, <w>ahoj</w>!",
                                "tr": "Gerçekten gitmem lazım, <w>hoşça kal</w>!",
                                "es": "Realmente tengo que irme ahora, ¡<w>adiós</w>!",
                                "zh": "我真的得走了，<w>再见</w>！"
                            }
                        },
                        {
                            "text": "<w>Daag</w>, tot de volgende keer!",
                            "target_lang_translations": {
                                "en": "<w>Bye</w>, see you next time!",
                                "ru": "<w>Пока</w>, до следующего раза!",
                                "pl": "<w>Pa</w>, do zobaczenia następnym razem!",
                                "de": "<w>Tschüss</w>, bis zum nächsten Mal!",
                                "fr": "<w>Salut</w>, à la prochaine !",
                                "it": "<w>Ciao</w>, alla prossima!",
                                "cs": "<w>Ahoj</w>, příště na viděnou!",
                                "tr": "<w>Görüşürüz</w>, bir dahaki sefere kadar!",
                                "es": "¡<w>Adiós</w>, hasta la próxima!",
                                "zh": "<w>再见</w>，下次见！"
                            }
                        }
                    ],
