                                "target_senses": [
                                    {
                                        "sense_id": "fd68eec3-d6e8-3b92-88d3-4475a2225cd7",
                                        "entry_id": "0ccea158-388a-3ce5-9fcd-a8f36b789c49",
                                        "glosses": [
                                            "südslawische Sprache, die in Bosnien und Herzegowina, Serbien und Montenegro gesprochen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81fb9b90-2ef5-436b-8dd5-e8582d7dd351",
                                                "sense_id": "fd68eec3-d6e8-3b92-88d3-4475a2225cd7",
                                                "text": "„Grammatikalisch betrachtet hat das Bosnische sieben Fälle (Kasus): Nominativ, Genitiv, Dativ, Akkusativ, Vokativ, Instrumental und Lokativ.“"
                                            },
                                            {
                                                "example_id": "7cdda77f-46c8-4908-9fe3-3cb5d9eb0ad0",
                                                "sense_id": "fd68eec3-d6e8-3b92-88d3-4475a2225cd7",
                                                "text": "Das Bosnische ist mit dem Serbischen verwandt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
