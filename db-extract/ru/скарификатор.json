                                        "sense_id": "c667943c-15fa-3bd1-89ff-16c77ba0b37d",
                                        "entry_id": "5fc58262-9402-38d9-91b1-d5e6bf8fad7a",
                                        "glosses": [
                                            "An implement for working and loosening the soil; often, one with teeth or shanks that does not bring up a fresh surface."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37202e7f-0bd7-49fa-8c74-e547c8c9b0ef",
                                                "sense_id": "c667943c-15fa-3bd1-89ff-16c77ba0b37d",
                                                "text": "Near-synonyms: cultivator, scuffler, grubber, horse hoe (not always precisely differentiated; dialectal usage has varied)"
                                            },
                                            {
                                                "example_id": "5dc3665f-a00d-441a-a175-d70f038efc37",
                                                "sense_id": "c667943c-15fa-3bd1-89ff-16c77ba0b37d",
                                                "text": "You have your scarifiers to make the ground clean."
                                            }
