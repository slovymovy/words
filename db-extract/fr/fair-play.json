            {
                "entry_id": "fe7063ad-8c07-316a-90c8-8787ebe61b9d",
                "word": "fair-play",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "16d07682-243e-4b0c-b0c3-17396ce6aab7",
                        "entry_id": "fe7063ad-8c07-316a-90c8-8787ebe61b9d",
