                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efe1cd63-b857-4c5e-a9e4-11d57e0fab6b",
                                "sense_id": "5deb3293-a87e-328a-8b8d-fa9ba2595386",
                                "text": "„Seine Begründung der Bevölkerungszunahme durch die Quantität der Nahrungsmittel, ferner seine Ansicht vom Bevölkerungswachstume, bis eine Hemmung durch Nahrungsmangel eintritt und schließlich das von ihm angenommene Stehenbleiben der Bevölkerungsziffer auf dem Niveau des Nahrungsmittelspielraumes sind letzten Endes auch nichts anderes als Folgen des Gesetzes von der Erhaltung der Kraft, oder seiner Abart, der Erhaltung der Arbeit, anzusehen.“"
                            },
                            {
                                "example_id": "f1343293-9255-4624-9fe6-d0af60642c4a",
                                "sense_id": "5deb3293-a87e-328a-8b8d-fa9ba2595386",
                                "text": "„Die UNO hat Ägypten mit seinem Bevölkerungswachstum von fast zwei Millionen Menschen pro Jahr schon für 2025 Wassermangel bescheinigt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
