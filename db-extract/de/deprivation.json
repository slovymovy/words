                        ],
                        "form": "die Deprivation"
                    },
                    {
                        "form_id": "f76e17b3-f09b-491c-b663-32ae046205d2",
                        "entry_id": "ced5e8b0-e36c-35b9-a0f0-b759731919d9",
                        "tags": [
                            "accusative",
