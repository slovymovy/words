                                    {
                                        "sense_id": "94605f00-950c-3dee-915e-d4c271cf8301",
                                        "entry_id": "ff1eb0a0-dae8-3549-80e2-a0e05129be5e",
                                        "glosses": [
                                            "Involving a heavy sauce flavored with truffles, mushrooms and Madeira wine, and garnished with one or more of olives, kidneys, quenelles, sweetbreads, livers, and cockscombs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffd7424a-2639-40cf-896e-d444b4fdfe8f",
                                                "sense_id": "94605f00-950c-3dee-915e-d4c271cf8301",
                                                "text": "[…] add a good financière ragoût (No. 89) of cocks’ combs, fat livers, truffles, and some mushrooms; […]"
                                            },
                                            {
                                                "example_id": "ed30b2fc-acec-4316-95f3-4330d7dcdc4d",
                                                "sense_id": "94605f00-950c-3dee-915e-d4c271cf8301",
                                                "text": "Fill six vol-au-vents made with feuilletage paste (No. 1076) with a quart of financière garnishing (No. 246), and serve them on a dish with a folded napkin."
                                            },
                                            {
                                                "example_id": "a03a2b8d-5dcb-48a0-a5da-5736b2092528",
                                                "sense_id": "94605f00-950c-3dee-915e-d4c271cf8301",
                                                "text": "The classic version of financière sauce is rather esoteric, a tomato-and-Madeira-flavored brown sauce with elaborate garnishes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
