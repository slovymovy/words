                    {
                        "translation_id": "4310876b-5d32-4be1-878c-49438424bdd7",
                        "source_entry_id": "799afca7-6ce2-34e1-9180-46b88dbc11a2",
                        "source_sense_id": "e363f368-b9ac-341a-9123-e97c55cb0caa",
