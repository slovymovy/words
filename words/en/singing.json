{
    "word_family": [
        "singer",
        "song",
        "singsong",
        "singable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "a61977c1-0d1b-37b2-8e6c-03c7aa2ac86d",
                    "sense_definition": "Present participle and gerund of <w>sing</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_vocal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is <w>singing</w> a beautiful lullaby to her baby.",
                            "target_lang_translations": {
                                "ru": "Она <w>поёт</w> своему ребёнку красивую колыбельную.",
                                "zh": "她正在为宝宝<w>唱</w>一首优美的摇篮曲。"
                            }
                        },
                        {
                            "text": "The birds were <w>singing</w> loudly in the garden this morning.",
                            "target_lang_translations": {
                                "ru": "Птицы громко <w>пели</w> в саду сегодня утром.",
                                "zh": "今天早上，鸟儿在花园里大声<w>鸣叫</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола <w>sing</w> (петь).",
                        "zh": "动词 sing 的现在分词和动名词形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поющий",
                                "target_lang_sense_clarification": "причастие"
                            },
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "герундий / процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "唱歌",
                                "target_lang_sense_clarification": "动名词 / 过程"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a44374a9-4ee1-3f57-89ed-ac32b5c1fe65",
                    "sense_definition": "The activity, art, or act of producing musical sounds with the voice.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action_vocal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her <w>singing</w> has improved significantly since she started taking lessons.",
                            "target_lang_translations": {
                                "ru": "Её <w>пение</w> значительно улучшилось с тех пор, как она начала брать уроки.",
                                "zh": "自从开始上课以来，她的<w>歌唱</w>水平有了显著提高。"
                            }
                        },
                        {
                            "text": "We could hear the sound of <w>singing</w> coming from the church.",
                            "target_lang_translations": {
                                "ru": "Мы слышали звуки <w>пения</w>, доносившиеся из церкви.",
                                "zh": "我们能听到从教堂传来的<w>歌声</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vocalizing",
                        "crooning",
                        "chanting"
                    ],
                    "common_phrases": [
                        "singing voice",
                        "singing lessons",
                        "bird singing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Деятельность, искусство или акт произведения музыкальных звуков голосом.",
                        "zh": "用嗓音发出乐音的活动、艺术或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пение",
                                "target_lang_sense_clarification": "процесс или занятие"
                            },
                            {
                                "target_lang_word": "вокал",
                                "target_lang_sense_clarification": "искусство исполнения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "歌唱",
                                "target_lang_sense_clarification": "过程或活动"
                            },
                            {
                                "target_lang_word": "声乐",
                                "target_lang_sense_clarification": "艺术形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ab77491-e987-3c8a-8f90-872aab05ca41",
                    "sense_definition": "A continuous ringing, buzzing, or humming sound heard in the ears.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound_noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the loud explosion, he suffered from a persistent <w>singing</w> in his ears.",
                            "target_lang_translations": {
                                "ru": "После громкого взрыва он страдал от постоянного <w>звона</w> в ушах.",
                                "zh": "剧烈爆炸后，他一直感到耳朵里有持续的<w>耳鸣</w>。"
                            }
                        },
                        {
                            "text": "The doctor asked if the <w>singing</w> in my head was high-pitched or low.",
                            "target_lang_translations": {
                                "ru": "Врач спросил, был ли <w>шум</w> у меня в голове высоким или низким.",
                                "zh": "医生问我头里的<w>嗡嗡声</w>是高音还是低音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ringing",
                        "tinnitus",
                        "buzzing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывный звон, жужжание или гул в ушах.",
                        "zh": "耳朵里持续听到的嗡嗡声或鸣响声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "звон",
                                "target_lang_sense_clarification": "в ушах"
                            },
                            {
                                "target_lang_word": "шум",
                                "target_lang_sense_clarification": "звуковой фон"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "耳鸣",
                                "target_lang_sense_clarification": "医学症状"
                            },
                            {
                                "target_lang_word": "嗡嗡声",
                                "target_lang_sense_clarification": "听觉感受"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "086944ba-067c-32c8-b05e-af7e5438b701",
                    "sense_definition": "The act of disclosing secret information or giving evidence against someone to authorities.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "betrayal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gang member's <w>singing</w> to the police led to several arrests.",
                            "target_lang_translations": {
                                "ru": "<w>Стукачество</w> члена банды полиции привело к нескольким арестам.",
                                "zh": "那名帮派成员向警方<w>告密</w>，导致了多人被捕。"
                            }
                        },
                        {
                            "text": "He was afraid that his partner's <w>singing</w> would put him in jail.",
                            "target_lang_translations": {
                                "ru": "Он боялся, что <w>доносительство</w> его напарника отправит его в тюрьму.",
                                "zh": "他担心同伙的<w>出卖</w>会让他入狱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "snitching",
                        "informing",
                        "squealing"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт раскрытия секретной информации или дачи показаний против кого-либо властям.",
                        "zh": "向当局泄露秘密信息或指证他人的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стукачество",
                                "target_lang_sense_clarification": "разговорное"
                            },
                            {
                                "target_lang_word": "доносительство",
                                "target_lang_sense_clarification": "формальное"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "告密",
                                "target_lang_sense_clarification": "揭发他人"
                            },
                            {
                                "target_lang_word": "出卖",
                                "target_lang_sense_clarification": "背叛行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4ed41c9-87ea-3cfa-954a-6aef11d16e54",
                    "sense_definition": "A social gathering specifically for the purpose of singing songs or hymns together.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The community organized a <w>singing</w> at the town hall on Sunday afternoon.",
                            "target_lang_translations": {
                                "ru": "Община организовала <w>вечер пения</w> в ратуше в воскресенье днём.",
                                "zh": "社区在周日下午于市政厅组织了一场<w>歌咏会</w>。"
                            }
                        },
                        {
                            "text": "Folks traveled from neighboring counties to attend the annual shape-note <w>singing</w>.",
                            "target_lang_translations": {
                                "ru": "Люди приехали из соседних округов, чтобы посетить ежегодное <w>собрание</w> любителей пения по фигурным нотам.",
                                "zh": "人们从邻县赶来参加一年一度的简谱<w>歌咏会</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "often US South or Appalachia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Общественное собрание специально для совместного пения песен или гимнов.",
                        "zh": "专门为了聚在一起唱歌曲或赞美诗而举办的社交聚会。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спевка",
                                "target_lang_sense_clarification": "собрание для пения"
                            },
                            {
                                "target_lang_word": "вечер пения",
                                "target_lang_sense_clarification": "мероприятие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "歌咏会",
                                "target_lang_sense_clarification": "集体活动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "e964540b-94f0-3597-8f51-be1b54dc63e3",
                    "sense_definition": "Having a melodious, smooth, and flowing quality, often referring to a musical tone.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The cellist produced a warm, <w>singing</w> tone that filled the concert hall.",
                            "target_lang_translations": {
                                "ru": "Виолончелист извлёк тёплый, <w>певучий</w> тон, наполнивший концертный зал.",
                                "zh": "大提琴手拉出了温暖而<w>悠扬</w>的音色，回荡在整个音乐厅。"
                            }
                        },
                        {
                            "text": "He read the poem with a <w>singing</w> rhythm that captivated the audience.",
                            "target_lang_translations": {
                                "ru": "Он читал стихотворение с <w>напевным</w> ритмом, который очаровал аудиторию.",
                                "zh": "他以一种<w>如歌</w>的节奏朗诵诗歌，深深吸引了听众。"
                            }
                        }
                    ],
                    "synonyms": [
                        "melodious",
                        "resonant",
                        "musical"
                    ],
                    "common_phrases": [
                        "singing tone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обладающий мелодичным, плавным и текучим качеством (часто о музыкальном тоне).",
                        "zh": "具有悦耳、平滑和流畅的特质，常指音乐音色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "певучий",
                                "target_lang_sense_clarification": "мелодичный"
                            },
                            {
                                "target_lang_word": "напевный",
                                "target_lang_sense_clarification": "о ритме или интонации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "悠扬的",
                                "target_lang_sense_clarification": "形容声音"
                            },
                            {
                                "target_lang_word": "如歌的",
                                "target_lang_sense_clarification": "形容节奏或音色"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f1b613e-5130-3d62-afbe-ed9b511c7440",
                    "sense_definition": "Producing a high-pitched whistling or humming sound, often caused by escaping steam or wind.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound_noise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>singing</w> kettle on the stove alerted us that the water was boiling.",
                            "target_lang_translations": {
                                "ru": "<w>Свистящий</w> чайник на плите предупредил нас, что вода закипела.",
                                "zh": "炉子上<w>鸣响</w>的茶壶提醒我们水开了。"
                            }
                        },
                        {
                            "text": "We could hear the <w>singing</w> wires overhead as the wind blew through them.",
                            "target_lang_translations": {
                                "ru": "Мы слышали <w>гудящие</w> провода над головой, когда сквозь них дул ветер.",
                                "zh": "当风吹过时，我们可以听到头顶电线发出的<w>嗡嗡</w>声。"
                            }
                        }
                    ],
                    "synonyms": [
                        "whistling",
                        "humming"
                    ],
                    "common_phrases": [
                        "singing kettle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Издающий высокий свистящий или гудящий звук (часто из-за выходящего пара или ветра).",
                        "zh": "发出高音的哨声或嗡嗡声，通常由逸出的蒸汽或风引起。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "свистящий",
                                "target_lang_sense_clarification": "о чайнике или ветре"
                            },
                            {
                                "target_lang_word": "гудящий",
                                "target_lang_sense_clarification": "о проводах"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鸣响的",
                                "target_lang_sense_clarification": "形容物体"
                            },
                            {
                                "target_lang_word": "呼啸的",
                                "target_lang_sense_clarification": "形容风声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}