                },
                {
                    "sense_id": "2962320a-7347-3962-b7ac-a840ae2929f8",
                    "sense_definition": "the part of a vehicle body that surrounds the wheel",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "automotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The front <w>guard</w> was badly dented in the minor collision.",
                            "target_lang_translations": {
                                "ru": "Переднее <w>крыло</w> было сильно помято в результате небольшого столкновения."
                            }
                        },
                        {
                            "text": "He spent the afternoon cleaning the mud off the rear <w>guard</w> of his car.",
                            "target_lang_translations": {
                                "ru": "Он провел вторую половину дня, счищая грязь с заднего <w>крыла</w> своего автомобиля."
                            }
                        }
                    ],
                    "synonyms": [
                        "fender"
                    ],
                    "common_phrases": [
                        "front guard",
                        "rear guard"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in Australian and New Zealand English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "часть кузова автомобиля, окружающая колесо"
                    },
                    "translations": {
                        "ru": [
