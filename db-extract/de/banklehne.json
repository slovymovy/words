                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73bca805-cfe8-455c-9b11-57f6a8d67e44",
                                "sense_id": "432337d9-4c72-30fe-afb9-7d6019b0c201",
                                "text": "„Kutusow seufzte und stützte sich mit beiden Händen auf die Banklehne, um aufzustehen.“"
                            },
                            {
                                "example_id": "4ec195fa-c1ac-4df0-b7e5-aefd0ccd8d45",
                                "sense_id": "432337d9-4c72-30fe-afb9-7d6019b0c201",
                                "text": "„Aber während sie diese Worte sprach, hielt sie sich an einer Banklehne, und St. Arnaud sah deutlich, daß sie todmüde war, gleichviel ob vom Weg oder von der Unterhaltung.“"
                            }
                        ],
