                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67ea475b-a323-4bde-8062-ccfe8f406c96",
                                "sense_id": "8af638c7-22eb-3e1d-b0ba-5503245c7ea2",
                                "text": "Hun onmenselijkheid ging door voor een wonder van klassenbewustzijn, hun barbarij voor een staaltje proletarische onverzettelijkheid en revolutionair instinct."
                            },
                            {
                                "example_id": "1de31840-b128-435c-ba83-5b561d05fe7d",
                                "sense_id": "8af638c7-22eb-3e1d-b0ba-5503245c7ea2",
                                "text": "Ben Crump, advocaat van de familie van Floyd, zei in het tv-programma Face the Nation dat de openbaar aanklager deze nieuwe aanklacht wil toevoegen \"om er zeker van te zijn dat de juryleden alle mogelijke opties hebben om Chauvin strafrechtelijk aansprakelijk te stellen voor de marteling, de onmenselijkheid en de moord op George Floyd\"."
                            }
                        ]
                    }
