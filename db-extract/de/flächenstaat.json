                ],
                "senses": [
                    {
                        "sense_id": "5c00d389-7057-35e8-8751-bab63c5e2236",
                        "entry_id": "79dbf0af-1b85-3b75-9672-d50e69409040",
                        "glosses": [
                            "dünn besiedelte unabhängige politische Einheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b09fc37-08d4-4439-a24e-8f1a9f2ac0af",
                                "sense_id": "5c00d389-7057-35e8-8751-bab63c5e2236",
                                "text": "Wer je die Mongolei bereist hat, weiß, was ein Flächenstaat ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4f058ae2-9127-3e50-8d26-64e0dd118e26",
                        "entry_id": "79dbf0af-1b85-3b75-9672-d50e69409040",
                        "glosses": [
                            "Bundesland oder -staat, das bzw. der nicht nur aus einer Stadt besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d642a4e-73fb-490a-a561-ec5a2e5e861c",
                                "sense_id": "4f058ae2-9127-3e50-8d26-64e0dd118e26",
                                "text": "„Die Stadt New York City hatte für den Fall eines negativen Referendums mit der Abspaltung vom Flächenstaat New York gedroht.“"
                            },
                            {
                                "example_id": "d6ea5d46-e732-4e4a-84eb-dca9185090a8",
                                "sense_id": "4f058ae2-9127-3e50-8d26-64e0dd118e26",
                                "text": "„Hessen ist der erste deutsche Flächenstaat, der eine solche Karte anbietet.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                        "entry_id": "79dbf0af-1b85-3b75-9672-d50e69409040",
                        "glosses": [
                            "durch seine territoriale Ausdehnung definiertes unabhängiges politisches Gebilde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5520ba48-245a-43c2-8b9a-e72279cca234",
                                "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                                "text": "„Die Konstituierung des institutionellen Flächenstaates, der sich durch das räumliche Prinzip der Gebietshoheit definiert, kann als die zentrale Entwicklung in der mittelalterlichen Verfassungsgeschichte bezeichnet werden.“"
                            },
                            {
                                "example_id": "bf1431b9-a569-4d7a-b429-e249ce82aac3",
                                "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                                "text": "„So stieg der Gott (mitsamt Partnerin) des dominierenden Stammes mit seinem Stamm von einer ehedem lokalen Größe zum Herrn über mehrere Stämme und später über einen Flächenstaat auf.“"
                            },
                            {
                                "example_id": "a4dbf76a-ad2d-41d0-bd08-f90523e2dda4",
                                "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                                "text": "„Behauptet wird hier der Primat des Volkes vor dem Staat, den erst der moderne institutionelle Flächenstaat aufgehoben habe.“"
                            },
                            {
                                "example_id": "9267fe7c-6b3a-4c33-b39e-205a60fc0ba3",
                                "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                                "text": "„Die Germanenreiche waren Reiche ohne Hauptstadt, aus denen sich im Mittelalter der europäische Flächenstaat entwickeln konnte.“"
                            },
                            {
                                "example_id": "3169bc52-a8e7-4fa0-8709-b300b242ccee",
                                "sense_id": "b895bab5-25cb-3498-a4d8-16171a65fb16",
                                "text": "„Noch war das Ganze kein geschlossener Flächenstaat, aber wie ein späterer Landesherr hielt der Papst Landtage, wie ein weltlicher Fürst vereinheitlichte er die einzelnen Herrschaften in gleichartiger Gesetzgebung.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
