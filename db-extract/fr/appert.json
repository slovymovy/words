                "senses": [
                    {
                        "sense_id": "2ffa8af2-bc20-379a-a38b-09269cc730df",
                        "entry_id": "f95fe90d-ae01-3829-a6c6-bf85a23bb59c",
                        "glosses": [
                            "Troisième personne du singulier de l’indicatif présent du verbe apparoir."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e7e09f8d-5a43-4797-bdcd-ebb12f31eaf7",
                                "sense_id": "2ffa8af2-bc20-379a-a38b-09269cc730df",
                                "text": "Bref, il appert que le chemin est parfois hasardeux du verbe à la chair."
                            },
                            {
                                "example_id": "3ea2239c-6f1d-42c8-bee5-82a2b2b1f25e",
                                "sense_id": "2ffa8af2-bc20-379a-a38b-09269cc730df",
                                "text": "Il appert que…"
                            },
                            {
                                "example_id": "681c1f64-240f-4630-9b19-6b8dd35b2bfc",
                                "sense_id": "2ffa8af2-bc20-379a-a38b-09269cc730df",
                                "text": "De tout ceci, il appert que le seigneur Morphée ne t’a pas visité cette nuit."
                            },
                            {
                                "example_id": "d501914a-970b-4f02-a9a4-7a9990c1ee48",
                                "sense_id": "2ffa8af2-bc20-379a-a38b-09269cc730df",
                                "text": "Elle était originaire de Bar-le-Duc, fille de Bénédict Langévol, demeurant impasse Loriol, mort en 1812, ainsi qu’il appert des registres de la municipalité de ladite ville… Ces registres sont une institution bien précieuse, monsieur, bien précieuse !…"
                            }
                        ]
                    }
