                        "sense_id": "1f9d0209-1436-3e3a-b82f-d5c756927e63",
                        "entry_id": "919e3778-6ddc-328f-a0dc-a9d19b25336f",
                        "glosses": [
                            "ein fließendes Gewässer, wobei sowohl natürliche als auch künstliche Wasserläufe gemeint sein können, insofern diese ein Gefälle aufweisen; größere, von Flüssen durchflossene Seen werden meist nicht als Fließgewässer angesehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ddcb485c-ea84-43ca-9994-6cd0a59f63f8",
                                "sense_id": "1f9d0209-1436-3e3a-b82f-d5c756927e63",
                                "text": "Die Oder ist ein Fließgewässer."
                            },
                            {
                                "example_id": "6f91195d-2e74-44b7-a504-69bf3acba783",
                                "sense_id": "1f9d0209-1436-3e3a-b82f-d5c756927e63",
                                "text": "„Die Talsperre staut ein natürliches Fließgewässer auf und erzeugt den notwendigen Wasserspeicher für das Speicherkraftwerk.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a4613a1-4202-4f80-a9ee-79cfed65b7ce",
                        "source_entry_id": "919e3778-6ddc-328f-a0dc-a9d19b25336f",
                        "source_sense_id": "1f9d0209-1436-3e3a-b82f-d5c756927e63",
                        "target_lang_word": "stream",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5cc8261-3628-35be-a601-dfc387de0bab",
                                        "entry_id": "1708e41d-6198-3c54-93da-f1632dcbae18",
                                        "glosses": [
                                            "To flow in a continuous or steady manner, like a liquid."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d2a421bc-873f-438f-860a-fcaf469bd840",
                                                "sense_id": "f5cc8261-3628-35be-a601-dfc387de0bab",
                                                "text": "beneath those banks where rivers now stream"
                                            },
                                            {
                                                "example_id": "0c442a4b-9127-4086-80d6-d08331198626",
                                                "sense_id": "f5cc8261-3628-35be-a601-dfc387de0bab",
                                                "text": "When I came to myself I was lying, not in the outer blackness of the Mohune vault, not on a floor of sand; but in a bed of sweet clean linen, and in a little whitewashed room, through the window of which the spring sunlight streamed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae464e52-4812-3b33-9a3c-eb61f6913dc1",
                                        "entry_id": "1708e41d-6198-3c54-93da-f1632dcbae18",
                                        "glosses": [
                                            "To extend; to stretch out with a wavy motion; to float in the wind."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffc024ee-136d-4a20-bccc-4a058dafdc84",
                                                "sense_id": "ae464e52-4812-3b33-9a3c-eb61f6913dc1",
                                                "text": "A flag streams in the wind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af7a217e-a234-3652-9512-f06340e2fff3",
                                        "entry_id": "1708e41d-6198-3c54-93da-f1632dcbae18",
                                        "glosses": [
                                            "To discharge in a stream."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0481f06-9eea-4a4e-8625-ba170424b1c3",
                                                "sense_id": "af7a217e-a234-3652-9512-f06340e2fff3",
                                                "text": "The soldier's wound was streaming blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "828664b2-9391-3f7c-9232-1ad86585f323",
                                        "entry_id": "1708e41d-6198-3c54-93da-f1632dcbae18",
                                        "glosses": [
                                            "To push continuous data (e.g. music) from a server to a client computer while it is being used (played) on the client."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21e920ad-8099-3ac9-bb1c-9cdf44c462f5",
                                        "entry_id": "1708e41d-6198-3c54-93da-f1632dcbae18",
                                        "glosses": [
                                            "To livestream."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c927991f-839f-49e3-b367-d8999d68674d",
                                                "sense_id": "21e920ad-8099-3ac9-bb1c-9cdf44c462f5",
                                                "text": "I did factor in the whole, like, \"oh, I wonder if doing streaming, and the money that's kind of attached to it, is the reason I wanted to do this?\", like, is it warping my brain? I did think about that. I've streamed for years and it's been my entire life and I've made a lot of money off it, and I wondered if that's what's affecting me and making me want to do this. And it's not."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "stream",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0fe94337-ecb3-3682-acdb-40ff5c73dc5a",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "A small river; a large creek; a body of moving water confined by banks."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e0ab3f-13b7-4298-b82c-d4c585ef8236",
                                                "sense_id": "0fe94337-ecb3-3682-acdb-40ff5c73dc5a",
                                                "text": "Now we plunged into a deep shade with the boughs lacing each other overhead, and crossed dainty, rustic bridges over the cold trout-streams, the boards giving back the clatter of our horses' feet:[…]."
                                            },
                                            {
                                                "example_id": "3b9a960d-e511-4d45-a0a2-22fbfc41b094",
                                                "sense_id": "0fe94337-ecb3-3682-acdb-40ff5c73dc5a",
                                                "text": "European adventurers found themselves within a watery world, a tapestry of streams, channels, wetlands, lakes and lush riparian meadows enriched by floodwaters from the Mississippi River."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46cbf334-42e3-327a-a626-a513b6f6f206",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "All moving waters."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bb4489ff-311c-3b90-92fc-47f9d58c3046",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "A thin connected passing of a liquid through a lighter gas (e.g. air)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de782b75-b397-4680-bae0-389c028a4c48",
                                                "sense_id": "bb4489ff-311c-3b90-92fc-47f9d58c3046",
                                                "text": "He poured the milk in a thin stream from the jug to the glass."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18a325f5-a2a5-304e-904a-4d38c7339d9d",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "Current, the force of moving water."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e92386c-8708-4a7d-a8ba-59fa1fd55a6b",
                                                "sense_id": "18a325f5-a2a5-304e-904a-4d38c7339d9d",
                                                "text": "to swim against the stream"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a0077af-636c-3ed7-8b9e-a786724f9b7b",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "Any steady flow or succession of material, such as water, air, radio signal or words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "226cea57-d4cf-461c-970a-6578ce0b7b5c",
                                                "sense_id": "1a0077af-636c-3ed7-8b9e-a786724f9b7b",
                                                "text": "Her constant nagging was to him a stream of abuse."
                                            },
                                            {
                                                "example_id": "e4ea78e5-312b-406f-bab4-2264e1f8f2c9",
                                                "sense_id": "1a0077af-636c-3ed7-8b9e-a786724f9b7b",
                                                "text": "With a little manœuvring they contrived to meet on the doorstep which was […] in a boiling stream of passers-by, hurrying business people speeding past in a flurry of fumes and dust in the bright haze."
                                            },
                                            {
                                                "example_id": "a53c84d3-b54a-4cd5-866a-11bcfd2e62ea",
                                                "sense_id": "1a0077af-636c-3ed7-8b9e-a786724f9b7b",
                                                "text": "A new stream of migrants is leaving the continent. It threatens to become a torrent if the debt crisis continues to worsen."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d94dad2-5dc1-3ce8-9081-6b5d29c42f02",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "A particular path, channel, division, or way of proceeding."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4f635326-64ab-4ccc-a1ca-8e181b057e59",
                                                "sense_id": "2d94dad2-5dc1-3ce8-9081-6b5d29c42f02",
                                                "text": "Haredi Judaism is a stream of Orthodox Judaism characterized by rejection of modern secular culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96f1a05d-f9fd-3e3f-bf53-adddf4e44ee1",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "A source or repository of data that can be read or written only sequentially."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d6f1be-5caa-4300-b6f5-4e1b7d810551",
                                                "sense_id": "96f1a05d-f9fd-3e3f-bf53-adddf4e44ee1",
                                                "text": "In the context of computer science, lexical analysis can be defined as the conversion of a stream of characters to a stream of meaningful tokens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d59e1540-b732-3e69-bc9b-c4ba396a8ae8",
                                        "entry_id": "b421a6a8-f0ee-346e-92ec-71d23a3ef70f",
                                        "glosses": [
                                            "Digital data (e.g. music or video) delivered in a continuous manner to a client computer, intended for immediate consumption or playback.",
                                            "An instance of streaming digital data."
                                        ],
                                        "tags": [],
                                        "examples": [
