                ],
                "senses": [
                    {
                        "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                        "entry_id": "ac8b1c65-a744-311a-b9c5-1c30420744c8",
                        "glosses": [
                            "Hose, die im Hüftbereich weit geschnitten und nach unten hin schmaler wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9e3fa34-5327-4e60-9ae0-1ab1e4b7680d",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Die Frau trug pastellgelbe Karottenhosen und ein blendend weißes Hemd mit Rüschenkragen.“"
                            },
                            {
                                "example_id": "882022af-62e8-46cc-a380-6ab3e20dadea",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Ihnen folgte auf dem Fuß ein stämmiger Mann in schillernder Karottenhose und spitzen Schuhen.“"
                            },
                            {
                                "example_id": "5d4b8f3c-ee79-40a2-8d96-739034eab61f",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Im Wohnzimmer dösen zwei Damen in Strickjacken und Karottenhosen vor dem Fernseher, während sich eine Kochshow auf magische Weise in ein altes Schwarz-Weiß-Musical verwandelt.“"
                            },
                            {
                                "example_id": "3c9aa3be-6651-4767-9bd4-937b007e339c",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Ungefähr zur selben Zeit waren sogenannte Karottenhosen mit Längsstreifen ein absolutes Muss, nichts habe ich mir so sehnlichst gewünscht wie eine solche Hose.“"
                            },
                            {
                                "example_id": "9b335492-fbfe-4548-bbfc-6a15b3c68ad8",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Gewiss, es war irgendwie einleuchtend, das alles zu notieren und eine Karottenhose anzuziehen, wenn alle eine Karottenhose anzogen.“"
                            },
                            {
                                "example_id": "eb060076-3663-47d9-8a97-a877f549cfda",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Aber auch er strahlt mit frisch toupierten Haaren und ganz in Weiß mit Karottenhose.“"
                            },
                            {
                                "example_id": "cf4acdad-43a9-4cd9-b40b-a6362c48fddf",
                                "sense_id": "9b010752-105c-3804-aace-b470166a8c12",
                                "text": "„Ich entscheide mich für eine lila karierte Karottenhose, eine hochgeknöpfte weiße Bluse und bordeauxfarbene Ballerinas.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
