                        "glosses": [
                            "statek handlowy przystosowany do masowego przewozu suchych, sypkich ładunków luzem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e489ca14-b39c-4c10-9a3d-1a2b3734d298",
                                "sense_id": "2f2ba8e7-f8d1-368c-9edb-3c89620cef67",
                                "text": "Pod flagą PŻM pływał jeden z największych polskich statków, masowiec o nośności 60 tysięcy ton, m/s „Huta im. Lenina”"
                            }
                        ],
