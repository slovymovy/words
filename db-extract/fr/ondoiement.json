        "fr-extract.jsonl": [
            {
                "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                "word": "ondoiement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8c663fcf-3edb-491c-8461-d2cd778dc278",
                        "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                        "tags": [
                            "plural"
                        ],
                        "form": "ondoiements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5d349332-31d9-3898-b349-06e146b0af27",
                        "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                        "glosses": [
                            "Action d’ondoyer, de faire des ondes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "836155c1-0f6e-4884-9fc8-8b71e7dd8802",
                                "sense_id": "5d349332-31d9-3898-b349-06e146b0af27",
                                "text": "Tu m’as dit : Vois la mer ! Et je n’ai pas compris,\nDevant la houle verte et l’ondoiement des seigles,\nQue, lorsqu’ils sont au bord de l’aire, les grands aigles\nPeuvent, à cette image accorder quelque prix."
                            },
                            {
                                "example_id": "d9501016-391a-4441-ad61-baf9782f8442",
                                "sense_id": "5d349332-31d9-3898-b349-06e146b0af27",
                                "text": "Toute cette nappe d’un ton doré avait des ondoiements de lumière qui changeaient et fuyaient à chaque mouvement de tête qu'il faisait en priant."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ec4271f-a41c-3204-bdd8-e24a08f6a437",
                        "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                        "glosses": [
                            "Versatilité dans les avis ou les façons de faire."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "f8a05108-6ffa-47c6-bad9-6fb36d690686",
                                "sense_id": "1ec4271f-a41c-3204-bdd8-e24a08f6a437",
                                "text": "Mais il était Franc, et comme tous ceux de sa race, empli de simples certitudes, bien éloignées des ondoiements du Levant."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c08278a-3fb1-3a3c-b112-abad2a89e214",
                        "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                        "glosses": [
                            "Baptême catholique où l’on n’observe que l’essentiel du sacrement, en se réservant de procéder par la suite aux cérémonies qui ont été omises."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ebff7b0-d1c0-4a9d-a017-e06afc7dabfb",
                                "sense_id": "5c08278a-3fb1-3a3c-b112-abad2a89e214",
                                "text": "Toute une paroisse régénérée comme par un nouveau baptême, un ondoiement collectif, quel miracle !"
                            },
                            {
                                "example_id": "3505f1a3-3183-4711-a28b-cd07b50b276e",
                                "sense_id": "5c08278a-3fb1-3a3c-b112-abad2a89e214",
                                "text": "Durant ces années, elle perdit un bébé à la naissance qu’on ondoya sur-le-champ, mais Mme Desrosiers, tel Thomas, douta que le petit garçon prénommé Hector fût monté au ciel. Au cours de sa vie, elle s’en ouvrit à quelques prêtres qui tentèrent de la convaincre que l’ondoiement valait bien le baptême et que le nourrisson avait échappé aux limbes."
                            },
                            {
                                "example_id": "d62872b4-b4f9-44fe-8468-b07c24f3ae54",
                                "sense_id": "5c08278a-3fb1-3a3c-b112-abad2a89e214",
                                "text": "Au moment de l’ondoiement, le père, Nicolas, se penche sur l’enfant, s’interrogeant sur son avenir."
                            },
                            {
                                "example_id": "ad3ed189-49e2-4f36-a95c-b50a598cca0c",
                                "sense_id": "5c08278a-3fb1-3a3c-b112-abad2a89e214",
                                "text": "— Il devient évident que la bataille est manquée, ou n’a pas eu lieu, et que nous aurons eu un ondoiement avant le baptême."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad93072d-348d-334f-bb31-a65143bab695",
                        "entry_id": "b6e13d64-7aa4-34dd-beed-2d4a0a64926d",
                        "glosses": [
                            "Sorte de baptême bouddhique."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
