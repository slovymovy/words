{
    "word_family": [
        "wiper",
        "wipeout",
        "rewipe",
        "unwiped"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "63679011-b485-3faf-a7ff-901b21e1b088",
                    "sense_definition": "To move an object over a surface, maintaining contact, to remove a substance or clean it.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "cleaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please <w>wipe</w> your feet on the mat before you come into the house.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>вытрите</w> ноги о коврик, прежде чем войти в дом.",
                                "zh": "进屋前请在垫子上<w>擦</w>干净你的脚。"
                            }
                        },
                        {
                            "text": "She used a soft cloth to <w>wipe</w> the dust from the old wooden table.",
                            "target_lang_translations": {
                                "ru": "Она использовала мягкую ткань, чтобы <w>вытереть</w> пыль со старого деревянного стола.",
                                "zh": "她用一块软布<w>擦</w>去了旧木桌上的灰尘。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe your feet",
                        "wipe the table",
                        "wipe away tears"
                    ],
                    "target_lang_definitions": {
                        "ru": "Проводить чем-либо по поверхности, сохраняя контакт, чтобы удалить вещество или очистить её.",
                        "zh": "通过在表面上移动物体来清除物质或进行清洁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытирать",
                                "target_lang_sense_clarification": "очищать поверхность"
                            },
                            {
                                "target_lang_word": "протирать",
                                "target_lang_sense_clarification": "удалять пыль или грязь"
                            },
                            {
                                "target_lang_word": "вытереть",
                                "target_lang_sense_clarification": "завершить процесс очистки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦",
                                "target_lang_sense_clarification": "一般的擦拭动作"
                            },
                            {
                                "target_lang_word": "抹",
                                "target_lang_sense_clarification": "用布或手擦拭"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd5cad68-83be-35da-95d9-8c8b61780be3",
                    "sense_definition": "To remove or eliminate something by rubbing or as if by rubbing; to obliterate.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "removal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rain will <w>wipe</w> away the chalk drawings on the sidewalk by tomorrow.",
                            "target_lang_translations": {
                                "ru": "К завтрашнему дню дождь <w>сотрет</w> рисунки мелом на тротуаре.",
                                "zh": "到明天，雨水会把人行道上的粉笔画<w>冲刷</w>掉。"
                            }
                        },
                        {
                            "text": "He tried to <w>wipe</w> the memory of the accident from his mind.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>стереть</w> воспоминание об аварии из своей памяти.",
                                "zh": "他试图将那场事故的记忆从脑海中<w>抹去</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe away",
                        "wipe off",
                        "wipe out"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удалить или устранить что-либо трением или как бы трением; стереть.",
                        "zh": "通过摩擦或类似摩擦的方式消除或抹去某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стирать",
                                "target_lang_sense_clarification": "удалять информацию или следы"
                            },
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "полностью уничтожить след или память"
                            },
                            {
                                "target_lang_word": "изглаживать",
                                "target_lang_sense_clarification": "постепенно удалять из памяти"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦掉",
                                "target_lang_sense_clarification": "通过擦拭使某物消失"
                            },
                            {
                                "target_lang_word": "抹去",
                                "target_lang_sense_clarification": "消除痕迹或记忆"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c4e5be3b-f81a-3e44-92ab-13511ddb0f0f",
                    "sense_definition": "To completely erase data from a storage device like a hard drive or phone.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>wipe</w> your hard drive before selling your old computer.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>очистить</w> жесткий диск перед продажей старого компьютера.",
                                "zh": "在卖掉旧电脑之前，你应该<w>清除</w>硬盘数据。"
                            }
                        },
                        {
                            "text": "The virus managed to <w>wipe</w> all the files from the server.",
                            "target_lang_translations": {
                                "ru": "Вирусу удалось <w>стереть</w> все файлы с сервера.",
                                "zh": "病毒成功地<w>删除了</w>服务器上的所有文件。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe the drive",
                        "wipe the phone",
                        "completely wipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полностью удалить данные с запоминающего устройства, такого как жесткий диск или телефон.",
                        "zh": "彻底清除存储设备（如硬盘或手机）中的数据。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стирать",
                                "target_lang_sense_clarification": "удалять файлы или данные"
                            },
                            {
                                "target_lang_word": "очищать",
                                "target_lang_sense_clarification": "освобождать память устройства"
                            },
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "выполнить полное удаление данных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "格式化",
                                "target_lang_sense_clarification": "清除磁盘数据"
                            },
                            {
                                "target_lang_word": "清除",
                                "target_lang_sense_clarification": "删除所有数据"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "65b3fa6d-748d-35af-add9-9276e23d7420",
                    "sense_definition": "To clean oneself with paper or cloth after using the toilet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hygiene",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Parents must teach their children how to <w>wipe</w> properly after using the bathroom.",
                            "target_lang_translations": {
                                "ru": "Родители должны научить своих детей правильно <w>вытираться</w> после посещения туалета.",
                                "zh": "父母必须教孩子如厕后如何正确地<w>擦拭</w>。"
                            }
                        },
                        {
                            "text": "He realized there was no paper left to <w>wipe</w> with.",
                            "target_lang_translations": {
                                "ru": "Он понял, что не осталось бумаги, чтобы <w>подтереться</w>.",
                                "zh": "他意识到没有纸可以<w>擦</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe your bottom",
                        "properly wipe",
                        "wipe carefully"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вытираться бумагой или тканью после посещения туалета.",
                        "zh": "如厕后使用纸张或布进行清洁。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытираться",
                                "target_lang_sense_clarification": "гигиеническая процедура"
                            },
                            {
                                "target_lang_word": "подтираться",
                                "target_lang_sense_clarification": "разговорное, о гигиене"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦屁股",
                                "target_lang_sense_clarification": "如厕后的清洁动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ae8e411-0729-3408-8fe1-a8681949f9a6",
                    "sense_definition": "To smear or spread a substance over a surface using a sliding motion.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "smearing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler managed to <w>wipe</w> jam all over the new white sofa.",
                            "target_lang_translations": {
                                "ru": "Малышу удалось <w>размазать</w> варенье по всему новому белому дивану.",
                                "zh": "那个蹒跚学步的孩子把果酱<w>涂抹</w>得新白色沙发上到处都是。"
                            }
                        },
                        {
                            "text": "Be careful not to <w>wipe</w> grease on your clean clothes while fixing the bike.",
                            "target_lang_translations": {
                                "ru": "Будьте осторожны, чтобы не <w>размазать</w> смазку по чистой одежде во время ремонта велосипеда.",
                                "zh": "修自行车时要小心，别把润滑油<w>蹭</w>到干净衣服上。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe grease",
                        "wipe jam",
                        "wipe all over"
                    ],
                    "target_lang_definitions": {
                        "ru": "Размазывать или распределять вещество по поверхности скользящим движением.",
                        "zh": "通过滑动动作将物质涂抹或散布在表面上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "размазывать",
                                "target_lang_sense_clarification": "распределять грязь или жир"
                            },
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "загрязнять поверхность чем-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "涂抹",
                                "target_lang_sense_clarification": "将物质散布在表面"
                            },
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "因涂抹而导致表面变脏"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9ed8a39-1ab5-3a0d-9c70-bc10bb5319ee",
                    "sense_definition": "To remove a specific expression or look from one's face.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You better <w>wipe</w> that smirk off your face before I get angry.",
                            "target_lang_translations": {
                                "ru": "Тебе лучше <w>стереть</w> эту ухмылку со своего лица, пока я не разозлился.",
                                "zh": "在我发火之前，你最好把脸上那副假笑<w>收起来</w>。"
                            }
                        },
                        {
                            "text": "She tried to <w>wipe</w> the look of surprise from her eyes quickly.",
                            "target_lang_translations": {
                                "ru": "Она попыталась быстро <w>убрать</w> выражение удивления из своих глаз.",
                                "zh": "她试图迅速从眼中<w>抹去</w>惊讶的神情。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe that smirk",
                        "wipe the look",
                        "wipe off your face"
                    ],
                    "target_lang_definitions": {
                        "ru": "Убрать определенное выражение или взгляд с лица.",
                        "zh": "从脸上抹去某种表情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стереть",
                                "target_lang_sense_clarification": "убрать улыбку или выражение"
                            },
                            {
                                "target_lang_word": "сгонять",
                                "target_lang_sense_clarification": "заставить исчезнуть выражение лица"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "收起",
                                "target_lang_sense_clarification": "改变脸上的表情"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce4695a1-8ce4-3309-964a-a5e73e04df2e",
                    "sense_definition": "To transition between scenes in a film or presentation by sliding one image over another.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "media_transition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The editor decided to <w>wipe</w> to the next shot instead of using a fade.",
                            "target_lang_translations": {
                                "ru": "Монтажер решил использовать <w>вытеснение</w> для перехода к следующему кадру вместо затухания.",
                                "zh": "剪辑师决定使用<w>擦除</w>效果切换到下一个镜头，而不是使用淡入淡出。"
                            }
                        },
                        {
                            "text": "The presentation will <w>wipe</w> horizontally between each of the data slides.",
                            "target_lang_translations": {
                                "ru": "В презентации будет использоваться горизонтальная <w>шторка</w> между слайдами с данными.",
                                "zh": "演示文稿将在每张数据幻灯片之间进行水平<w>擦除</w>切换。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe to the next",
                        "horizontal wipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical term in film/media"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Переходить между сценами в фильме или презентации, накладывая одно изображение на другое скольжением.",
                        "zh": "在电影或演示中，通过图像滑动来切换场景。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вытеснение",
                                "target_lang_sense_clarification": "тип монтажного перехода"
                            },
                            {
                                "target_lang_word": "шторка",
                                "target_lang_sense_clarification": "эффект перехода в видео"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "擦除",
                                "target_lang_sense_clarification": "视频转场效果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88ac1514-61fe-3e10-b0db-af3193d21792",
                    "sense_definition": "In gaming, for an entire group or party to be defeated or killed at once.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the healer makes a mistake, the whole team is going to <w>wipe</w>.",
                            "target_lang_translations": {
                                "ru": "Если лекарь ошибется, вся команда <w>вайпнется</w>.",
                                "zh": "如果治疗犯错，整个队伍就会<w>团灭</w>。"
                            }
                        },
                        {
                            "text": "We were doing well until the boss used its ultimate ability and caused us to <w>wipe</w>.",
                            "target_lang_translations": {
                                "ru": "У нас все шло хорошо, пока босс не использовал свою ульту и не заставил нас <w>погибнуть</w>.",
                                "zh": "我们本来打得很好，直到BOSS用了大招导致我们<w>团灭</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "going to wipe",
                        "team wipe",
                        "total wipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В видеоиграх: поражение или гибель всей группы или отряда одновременно.",
                        "zh": "在游戏中，指整个团队同时被击败或死亡。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вайпнуться",
                                "target_lang_sense_clarification": "игровой сленг, погибнуть всей группой"
                            },
                            {
                                "target_lang_word": "слиться",
                                "target_lang_sense_clarification": "сленг, проиграть бой"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "团灭",
                                "target_lang_sense_clarification": "游戏术语，全队阵亡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b7c82e9b-8e26-3451-81be-fc3c810645a8",
                    "sense_definition": "To cheat, defraud, or trick someone out of their possessions or land.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The swindlers attempted to <w>wipe</w> the villagers out of their ancestral lands.",
                            "target_lang_translations": {
                                "ru": "Мошенники пытались <w>лишить</w> жителей деревни их исконных земель.",
                                "zh": "骗子试图将村民从他们的祖传土地上<w>驱逐</w>出去。"
                            }
                        },
                        {
                            "text": "He was <w>wiped</w> of his inheritance by a series of clever legal tricks.",
                            "target_lang_translations": {
                                "ru": "Его <w>лишили</w> наследства с помощью серии хитрых юридических уловок.",
                                "zh": "他通过一系列巧妙的法律手段被<w>剥夺</w>了继承权。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe out of",
                        "wipe beside"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обманывать, обсчитывать или выманивать у кого-либо имущество или землю.",
                        "zh": "通过欺诈手段骗取某人的财产或土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "оббирать",
                                "target_lang_sense_clarification": "лишать имущества обманом"
                            },
                            {
                                "target_lang_word": "выманивать",
                                "target_lang_sense_clarification": "получать хитростью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诈取",
                                "target_lang_sense_clarification": "通过欺骗手段获取"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ca1baf0-9a7c-3c16-88c9-3085e7a30c4b",
                    "sense_definition": "To hit or strike someone or something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "violence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boxer managed to <w>wipe</w> his opponent across the jaw with a heavy blow.",
                            "target_lang_translations": {
                                "ru": "Боксеру удалось <w>ударить</w> противника по челюсти тяжелым ударом.",
                                "zh": "拳击手成功地用重拳<w>击中</w>了对手的下巴。"
                            }
                        },
                        {
                            "text": "He threatened to <w>wipe</w> him if he didn't step away immediately.",
                            "target_lang_translations": {
                                "ru": "Он пригрозил <w>врезать</w> ему, если тот немедленно не отойдет.",
                                "zh": "他威胁说如果他不立刻走开就<w>揍</w>他。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wipe him",
                        "give a wipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "regional or older usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ударить или нанести удар кому-либо или чему-либо.",
                        "zh": "击打某人或某物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ударить",
                                "target_lang_sense_clarification": "нанести физический удар"
                            },
                            {
                                "target_lang_word": "врезать",
                                "target_lang_sense_clarification": "сильно ударить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "猛击",
                                "target_lang_sense_clarification": "用力打击"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
