                        "sense_id": "547f2f7c-e6cc-39db-b558-5002919503dc",
                        "entry_id": "4741b8b2-9eec-382e-8626-872ddb90a253",
                        "glosses": [
                            "лицо, выдержавшее испытание на право заниматься изготовлением лекарств"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f250a9fd-bc40-4483-90d8-c5aaa3bf835e",
                                "sense_id": "547f2f7c-e6cc-39db-b558-5002919503dc",
                                "text": "Самого аптекаря, Фердинанда Рулковиуса, не было налицо, и мы с Болманом пили разные «шипучки» и художественные «желудочные» настойки фармацевта."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "af303e8b-c525-4829-b6c2-d45058b7dcbf",
                        "source_entry_id": "4741b8b2-9eec-382e-8626-872ddb90a253",
                        "source_sense_id": "547f2f7c-e6cc-39db-b558-5002919503dc",
                        "target_lang_word": "pharmacist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pharmacist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "A health professional who controls, formulates, preserves, and dispenses medications and provides medical advice and counseling on how medicines should be used in order to achieve maximum benefit, and minimal side effects in order to avoid drug interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14be8282-495f-48c0-a376-eeacadccc211",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "He has served as a prescriptionist to the leading pharmacists of the old country, and been employed in many of our American cities."
                                            },
                                            {
                                                "example_id": "15387852-6c96-4cef-90e0-3b8a55de5159",
                                                "sense_id": "6d049902-d62f-3c35-9bd2-b519de5301f1",
                                                "text": "By Admir, pharmacist by profession and hobby dronist by passion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78c77034-62b7-3d65-b61e-0c954fb3cdd2",
                                        "entry_id": "5bc79c19-c47c-3d17-a249-479a35ce81fb",
                                        "glosses": [
                                            "One who studies pharmacy."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
