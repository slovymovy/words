                ],
                "senses": [
                    {
                        "sense_id": "485b29d1-fa8d-3abb-8166-7dd51f7e86d1",
                        "entry_id": "6197d2f6-1089-3553-b347-4f722e377669",
                        "glosses": [
                            "Attraktion, bei der (scheinbar) dressierte Flöhe bestimmte Kunststücke vorführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c51f8878-6a7c-4a24-883c-7fc0b1580a55",
                                "sense_id": "485b29d1-fa8d-3abb-8166-7dd51f7e86d1",
                                "text": "„Ein Flohzirkus kommt in die Stadt mit neuer Sensation, die man noch nie gesehen hat.“"
                            },
                            {
                                "example_id": "0889b7d9-43cf-4c7c-bbd5-2b227514b8b6",
                                "sense_id": "485b29d1-fa8d-3abb-8166-7dd51f7e86d1",
                                "text": "„Als die Olchis am Morgen aufwachen sind auch sie winzig klein und laufen Gefahr, für den ortsansässigen Flohzirkus eingefangen zu werden.“"
                            },
                            {
                                "example_id": "8f7569e8-c66b-40f5-a635-b8ca2daaab2c",
                                "sense_id": "485b29d1-fa8d-3abb-8166-7dd51f7e86d1",
                                "text": "„Mai 1953 wurde im Studio ein Flohzirkus aus acht leeren Streichholzschachteln aufgebaut – und ich, der Zirkusdirektor, gab den imaginären Flöhen Anweisung, Seil zu tanzen, Salti zu schlagen oder eine Parade abzuhalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
