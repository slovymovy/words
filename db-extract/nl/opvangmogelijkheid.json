                        "glosses": [
                            "plaats waar mensen of dieren in nood tijdelijk kunnen verblijven totdat een meer permanente oplossing is gevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c752b15-c4df-45b4-9d26-31e2f463d701",
                                "sense_id": "e2931248-1eb8-39a7-9853-c92061723ab8",
                                "text": "Honderden verwarde mensen hebben de afgelopen maanden snel geestelijke zorg gekregen dankzij een nieuwe opvangmogelijkheid. Sinds de opening in mei van de zogenoemde Opvang Verwarde Personen (OVP) bij het politiebureau in Den Haag zijn 800 mensen geholpen. Meer dan 90 procent kreeg passende zorg."
                            },
                            {
                                "example_id": "33150176-6768-4008-99d9-cfccbc603fd2",
                                "sense_id": "e2931248-1eb8-39a7-9853-c92061723ab8",
                                "text": "Intussen zoeken de familiale instanties nog steeds naar de beste opvangmogelijkheid voor het kind. De burgemeester blijft de oproep herhalen naar de moeder van het kind om zich te melden."
                            }
                        ]
