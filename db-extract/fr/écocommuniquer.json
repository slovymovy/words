                "senses": [
                    {
                        "sense_id": "6954e5d2-f413-38cf-89a4-9e2883ae6bba",
                        "entry_id": "bec09d6f-892c-3f47-8639-84127aa31b08",
                        "glosses": [
                            "Communiquer en portant de l’attention aux questions écologiques."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0470544-a05e-43ab-8012-2a42617a86f0",
                                "sense_id": "6954e5d2-f413-38cf-89a4-9e2883ae6bba",
                                "text": "Écocommuniquer, c'est réduire les impacts sur l'environnement des métiers de la communication."
                            },
                            {
                                "example_id": "1fd2b8f6-45e2-447b-957e-9be3d82d19e3",
                                "sense_id": "6954e5d2-f413-38cf-89a4-9e2883ae6bba",
                                "text": "Elle parvient surtout, petit à petit, à faire entendre sa démarche initiale: écocommuniquer."
                            },
                            {
                                "example_id": "58c52009-de50-495a-b509-e0a42555c52f",
                                "sense_id": "6954e5d2-f413-38cf-89a4-9e2883ae6bba",
                                "text": "En somme, écocommuniquer c'est être écoresponsable, inscrire ses actions dans la durée, se préoccuper aussi de la façon de communiquer avec autrui."
                            }
                        ]
                    }
