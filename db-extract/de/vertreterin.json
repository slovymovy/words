                "senses": [
                    {
                        "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                        "glosses": [
                            "weibliche Person, die für andere in bestimmten Angelegenheiten an deren Stelle handelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084b0d20-ec3e-45dd-a304-38b06194cb2f",
                                "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                                "text": "„Hainisch gelang die Einbindung des Bunds in den International Council of Women (ICW); sie war als österreichische Vertreterin bei internationalen Frauenkonferenzen des ICW in Berlin und Toronto anwesend.“"
                            },
                            {
                                "example_id": "35d08605-ab9f-43be-8f2c-84d7366412db",
                                "sense_id": "bfb21e30-b92d-36a7-9f98-c81e1928d4c3",
                                "text": "„Österreichs Vertreterin Zoë startet dabei mit Startnummer 24 und somit als Drittletzte in den Bewerb.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "211aee60-1160-36c5-a849-8b75db1b8bbe",
                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                        "glosses": [
                            "Verkäuferin"
                        ],
                        "tags": [
                            "von ^([1]) abgeleitet",
                            "auf den Verkauf beschränkt"
                        ],
                        "examples": [
                            {
                                "example_id": "c288185e-2cea-405e-9b1f-0f9d1be15fc8",
                                "sense_id": "211aee60-1160-36c5-a849-8b75db1b8bbe",
                                "text": "„Einmal im Jahr lädt der Versicherungskonzern unter dem Namen seines ehemaligen Chefs seine erfolgreichsten Vertreterinnen und Vertreter aus Deutschland ein.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "f044bdb6-b7c9-33fb-b99e-173a76819969",
                        "entry_id": "8c25d6d4-7b93-3425-9161-fd39f0910490",
                        "glosses": [
                            "weibliche Person, die eine bestimmte (Denk-)Richtung repräsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8de877bb-7091-43fc-b1cd-5ccfb2054110",
                                "sense_id": "f044bdb6-b7c9-33fb-b99e-173a76819969",
                                "text": "„Hildegard Joos, * 7. Mai 1909 Wien, † 17. Jänner 2005 Wien, Künstlerin, Vertreterin des Konstruktivismus, betrieb ab 1959 mit ihrem Mann Harold Joos ein Atelier in Paris.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
