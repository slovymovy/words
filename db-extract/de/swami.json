                "senses": [
                    {
                        "sense_id": "75cc98e7-c01b-398e-953f-6e5fc1dc4051",
                        "entry_id": "0197bee7-f7b6-3734-b4de-bf82797daa70",
                        "glosses": [
                            "hinduistischer Titel für eine angesehene Person (häufig Lehrer und Mönche)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39670c03-a198-4d45-8a24-4809ac43370e",
                                "sense_id": "75cc98e7-c01b-398e-953f-6e5fc1dc4051",
                                "text": "„In Eds Fall führte der Weg zur Verbindung mit dem Herzen des Dienens von der New Yorker Welt der Drogen und Discos nach Indien, wo er ein Swami wurde, ein Yogapraktizierender, der in einem Ashram lebte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "70144cd9-4892-333f-a420-ed0ef685e78d",
                        "entry_id": "0197bee7-f7b6-3734-b4de-bf82797daa70",
                        "glosses": [
                            "Träger des hinduistischen Titels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cab40bbe-5329-4aaa-8e05-0d0c1df545e7",
                                "sense_id": "70144cd9-4892-333f-a420-ed0ef685e78d",
                                "text": "„Swami Sivananda faßt sein Programm in die vier Worte zusammen: Diene, liebe, meditiere, verwirkliche.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
