    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a1d1e931-d543-34a2-bb4e-a800d0fe4477",
                "word": "unfaithfulness",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d4aacfac-2d7f-4b61-b003-8a12be5c9b5b",
                        "entry_id": "a1d1e931-d543-34a2-bb4e-a800d0fe4477",
                        "tags": [
                            "plural"
                        ],
                        "form": "unfaithfulnesses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "21ea7988-8c2a-3937-a960-9ba1d7120118",
                        "entry_id": "a1d1e931-d543-34a2-bb4e-a800d0fe4477",
                        "glosses": [
                            "The characteristic of being unfaithful; infidelity; disloyalty."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a353eab1-d60b-40eb-ade8-bb446c07636a",
                                "sense_id": "21ea7988-8c2a-3937-a960-9ba1d7120118",
                                "text": "For even the enchantresses Circe and Medea could not, by their black arts, prevent the unfaithfulness of Odysseus and Jason."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "505065a6-c949-49d0-8918-887410b49feb",
                        "source_entry_id": "a1d1e931-d543-34a2-bb4e-a800d0fe4477",
                        "source_sense_id": "21ea7988-8c2a-3937-a960-9ba1d7120118",
                        "source_sense_description": "characteristic of being unfaithful",
                        "target_lang_word": "infidélité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "infidélité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "07a75378-a41b-3122-8d30-46339c138406",
                                        "entry_id": "7e44cd1e-d0f6-3c88-b180-e09135c10084",
                                        "glosses": [
                                            "Manque de fidélité ; manquement à ses devoirs, en particulier conjugaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "277822b2-3431-4dbf-a774-7cd64668986a",
                                                "sense_id": "07a75378-a41b-3122-8d30-46339c138406",
                                                "text": "Pour Don Juan, « la féminité tout à fait abstraite est l'essentiel », l’individualité n'existe pas : il n'y a jamais eu à ses yeux ni infidélité ni tromperie, mais seulement répétition et multiplicité."
                                            },
                                            {
                                                "example_id": "34b9127d-6b30-4004-bed8-bf7d63e5ab65",
                                                "sense_id": "07a75378-a41b-3122-8d30-46339c138406",
                                                "text": "L’infidélité d’une femme, d’un mari, d’un ami, d’un dépositaire, d’un domestique, d’un employé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                        "entry_id": "7e44cd1e-d0f6-3c88-b180-e09135c10084",
                                        "glosses": [
                                            "Actes d’infidélité."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26eb7e75-a310-4325-8acd-0cc295717030",
                                                "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                                "text": "Ce nom de Trognon lui fit entrevoir quelque machination, il crut à quelque vice de forme projeté par avance, à quelque infidélité préméditée par la Cibot, et il résolut de se servir de ce Trognon pour se faire dicter un testament olographe qu’il cachèterait et serrerait dans le tiroir de sa commode."
                                            },
                                            {
                                                "example_id": "ad31f833-23c4-4ff2-8638-c8381b37ce83",
                                                "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                                "text": "Reconnaissons que l’infidélité plurielle, systématique, récurrente et assidue, est plus facilement revendiquée par les hommes, en particulier par ceux qui prônent le papillonnage érotico-relationnel, et qu'elle reste assez mal perçue chez les femmes, à qui l'on prête moins facilement le droit à de nombreuses aventures sans lendemain."
                                            },
                                            {
                                                "example_id": "bd7381f5-951e-4224-89cd-20119e07e5db",
                                                "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                                "text": "Une grande infidélité."
                                            },
                                            {
                                                "example_id": "c81faef3-d20b-43bd-994d-dbfcf1eeae6b",
                                                "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                                "text": "L’infidélité de la mémoire : Le défaut de mémoire."
                                            },
                                            {
                                                "example_id": "b3445971-88de-4bca-971c-90cbd554c93a",
                                                "sense_id": "1a258721-5110-3e80-8b4b-534675e1d311",
                                                "text": "Il ne faut en accuser que l’infidélité de sa mémoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577b1452-0a85-31ba-a58f-f40e68a5cf1c",
                                        "entry_id": "7e44cd1e-d0f6-3c88-b180-e09135c10084",
                                        "glosses": [
                                            "Manque d’exactitude, de vérité, en parlant des personnes et des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6be0389-19bb-420e-83a3-63ee7f6cde99",
                                                "sense_id": "577b1452-0a85-31ba-a58f-f40e68a5cf1c",
                                                "text": "L’infidélité d’un historien, d’un traducteur, d’un copiste."
                                            },
                                            {
                                                "example_id": "a3e13a12-88d0-4ad6-8047-c228a6213fad",
                                                "sense_id": "577b1452-0a85-31ba-a58f-f40e68a5cf1c",
                                                "text": "L’infidélité d’un récit, d’un rapport, d’une citation."
                                            },
                                            {
                                                "example_id": "96319027-6c38-43d0-8032-cffaf785f42b",
                                                "sense_id": "577b1452-0a85-31ba-a58f-f40e68a5cf1c",
                                                "text": "Il y a de grandes infidélités dans cette traduction."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff334a7a-738e-3ecb-95e7-b20f74389d55",
                                        "entry_id": "7e44cd1e-d0f6-3c88-b180-e09135c10084",
                                        "glosses": [
                                            "L’état de ceux qui ne sont pas dans la vraie religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88991d24-be54-45e0-8a9a-425cff4cf2a6",
                                                "sense_id": "ff334a7a-738e-3ecb-95e7-b20f74389d55",
                                                "text": "Être obstiné dans son infidélité."
                                            },
                                            {
                                                "example_id": "a9127334-d5ec-4581-9a99-e8308370d85d",
                                                "sense_id": "ff334a7a-738e-3ecb-95e7-b20f74389d55",
                                                "text": "Il était chrétien et tomba dans l’infidélité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
