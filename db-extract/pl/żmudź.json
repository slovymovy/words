                "senses": [
                    {
                        "sense_id": "b80ff4d2-8700-341e-bdff-d15cf8913e34",
                        "entry_id": "089395ba-23d5-3609-ad10-2de8ca939d87",
                        "glosses": [
                            "jeden z pięciu regionów etnograficznych współczesnej Litwy ze stolicą w Szawlach, a także historyczna nazwa Dolnej Litwy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a80c43a-51a5-41b7-b1ca-cdaabbd8efed",
                                "sense_id": "b80ff4d2-8700-341e-bdff-d15cf8913e34",
                                "text": "Potem (…), urastając coraz więcej w siły, ziemię poniżej ku Prusom leżącą, którą właściwem swego języka brzmieniem nazwali Żmudzią, co znaczy ziemię niższą, (…) splądrowali"
                            },
                            {
                                "example_id": "ae981fb5-23f5-468f-b019-50a6fef06d96",
                                "sense_id": "b80ff4d2-8700-341e-bdff-d15cf8913e34",
                                "text": "Szupienie – tak zwano na Żmudzi kaszę jęczmienną lub groch utarty, okraszone słoniną, a zwłaszcza wieprzowym ogonem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
