                    }
                ],
                "senses": [
                    {
                        "sense_id": "da29ced4-ce0d-3a1a-aaa2-2893d3525053",
                        "entry_id": "1932695e-d72f-33e1-b15c-0ea30154b7cb",
                        "glosses": [
                            "das Ablegen der Ordensgelübde (Bindung an einen Orden für eine gewisse Zeit oder für immer und Befolgung der Regeln Keuschheit, Armut und Gehorsam)"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "40114188-5a3c-452c-9707-f56a4d835212",
                                "sense_id": "da29ced4-ce0d-3a1a-aaa2-2893d3525053",
                                "text": "„Ein Jahr nach der Einkleidung legte sie ihre dreijährige zeitliche Profess ab, nun folgen die ewigen Gelübde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f79793ff-49d7-4b2f-b005-8dfca381ac31",
                        "source_entry_id": "1932695e-d72f-33e1-b15c-0ea30154b7cb",
                        "source_sense_id": "da29ced4-ce0d-3a1a-aaa2-2893d3525053",
                        "target_lang_word": "profession",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "profession",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "df2351bb-f836-328f-9a33-b3e76cf638fa",
                                        "entry_id": "b200d92e-b377-3684-b3d4-7673c6dd83f8",
                                        "glosses": [
                                            "A declaration of faith.",
                                            "A promise or vow made on entering a religious order."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fcc13bc-0a58-4840-9a70-b037041acc09",
                                                "sense_id": "df2351bb-f836-328f-9a33-b3e76cf638fa",
                                                "text": "She died only a few years after her profession."
                                            },
                                            {
                                                "example_id": "521805ee-13b3-45c1-a80d-8b3990aae916",
                                                "sense_id": "df2351bb-f836-328f-9a33-b3e76cf638fa",
                                                "text": "Rosario was a young novice belonging to the monastery, who in three months intended to make his profession."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22b91c31-5511-37cb-94f5-be31dba55e95",
                                        "entry_id": "b200d92e-b377-3684-b3d4-7673c6dd83f8",
                                        "glosses": [
                                            "A declaration of faith.",
                                            "The declaration of belief in the principles of a religion; hence, one's faith or religion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13c21b68-7732-42b9-a822-890d0e4668cd",
                                                "sense_id": "22b91c31-5511-37cb-94f5-be31dba55e95",
                                                "text": "I congratulate you upon the wisdom that withheld you from entering yourself a member of the Protestant Association […] it is likely to bring an odium upon the profession they make, that will not soon be forgotten."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee90f3ce-1c6b-3a5b-805c-86785a3dbb10",
                                        "entry_id": "b200d92e-b377-3684-b3d4-7673c6dd83f8",
                                        "glosses": [
                                            "A declaration of faith.",
                                            "Any declaration of belief, faith or one's opinion, whether genuine or (as now often implied) pretended."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "823aafac-482c-4f6c-8813-0b9d5296bba9",
                                                "sense_id": "ee90f3ce-1c6b-3a5b-805c-86785a3dbb10",
                                                "text": "Despite his continued professions of innocence, the court eventually sentenced him to five years."
                                            },
                                            {
                                                "example_id": "eee1b4a8-1d2d-4294-a59a-6bb545cb345c",
                                                "sense_id": "ee90f3ce-1c6b-3a5b-805c-86785a3dbb10",
                                                "text": "I scarcely know any thing that really interests me, and I would give a great deal not to be so quick-sighted as I am; it would be so pleasant to believe only a tithe of the professions that are made me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d22ec9e3-d177-3407-ba21-b0614e75ee9a",
                                        "entry_id": "b200d92e-b377-3684-b3d4-7673c6dd83f8",
                                        "glosses": [
                                            "A professional occupation.",
                                            "An occupation, trade, craft, or activity in which one has a professed expertise in a particular area; a job, especially one requiring a high level of skill or training."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5223563-3898-4a35-a8d9-eefe394224bc",
                                                "sense_id": "d22ec9e3-d177-3407-ba21-b0614e75ee9a",
                                                "text": "My father was a barrister by profession."
                                            },
                                            {
                                                "example_id": "c41d4e08-5315-468c-88af-3940b566c8bf",
                                                "sense_id": "d22ec9e3-d177-3407-ba21-b0614e75ee9a",
                                                "text": "“You are very idle, Cashel; I am sure of that. It is too provoking to throw away so much money every year for nothing. Besides, you must soon be thinking of a profession.” “I shall go into the army,” said Cashel. “It is the only profession for a gentleman.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ae729501-d8d4-39d4-b044-3857d167bbd2",
                                        "entry_id": "b200d92e-b377-3684-b3d4-7673c6dd83f8",
                                        "glosses": [
                                            "A professional occupation.",
                                            "The practitioners of such an occupation collectively."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8696b608-d793-4371-b721-3eb0a2fb1264",
                                                "sense_id": "ae729501-d8d4-39d4-b044-3857d167bbd2",
                                                "text": "His conduct is against the established practices of the legal profession."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
