{
    "word_family": [
        "blabber",
        "blabbermouth",
        "blabby"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bcee2593-cdf7-388d-bd88-04d752197e5e",
                    "sense_definition": "To reveal secrets or gossip without reserve or discretion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "to-talk-indiscreetly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I trusted him with my secret, but he went ahead and <w>blabbed</w> to everyone in the office.",
                            "target_lang_translations": {
                                "pl": "Powierzyłem mu swój sekret, ale on poszedł i <w>wygadał się</w> wszystkim w biurze."
                            }
                        },
                        {
                            "text": "Please don't <w>blab</w> about the surprise party before we are ready.",
                            "target_lang_translations": {
                                "pl": "Proszę, nie <w>wygadaj się</w> o przyjęciu niespodziance, zanim będziemy gotowi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blab about the secret",
                        "blab to everyone"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in informal contexts regarding secrets."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Wygadywać sekrety lub plotki bez dyskrecji."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wygadać się",
                                "target_lang_sense_clarification": "ujawnić tajemnicę przez przypadek lub brak dyskrecji"
                            },
                            {
                                "target_lang_word": "rozgadać",
                                "target_lang_sense_clarification": "rozpowiedzieć coś, co powinno pozostać poufne"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "418f2ec2-1f4a-36cf-a559-c242a66c35c4",
                    "sense_definition": "To speak carelessly, excessively, or foolishly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "to-talk-indiscreetly",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She would <w>blab</w> on for hours about her problems without letting anyone else speak.",
                            "target_lang_translations": {
                                "pl": "Potrafiła <w>paplać</w> godzinami o swoich problemach, nie pozwalając nikomu innemu dojść do słowa."
                            }
                        },
                        {
                            "text": "He has a tendency to <w>blab</w> when he gets nervous during interviews.",
                            "target_lang_translations": {
                                "pl": "Ma tendencję do <w>paplania</w>, kiedy denerwuje się podczas wywiadów."
                            }
                        }
                    ],
                    "common_phrases": [
                        "blab on and on"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used informally to describe mindless or excessive talking."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Mówić niedbale, nadmiernie lub bez sensu."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "paplać",
                                "target_lang_sense_clarification": "mówić dużo i bez sensu"
                            },
                            {
                                "target_lang_word": "gawędzić",
                                "target_lang_sense_clarification": "mówić dużo, często o mało istotnych sprawach"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4d5a98c-0791-3680-a270-b36bccf2c47f",
                    "sense_definition": "A person who reveals secrets or gossips; a telltale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gossip-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't tell her anything important; she is a known <w>blab</w> who cannot keep a secret.",
                            "target_lang_translations": {
                                "pl": "Nie mów jej nic ważnego; to znana <w>plotkara</w>, która nie potrafi dochować tajemnicy."
                            }
                        },
                        {
                            "text": "He was accused of being a <w>blab</w> after the confidential plans were leaked.",
                            "target_lang_translations": {
                                "pl": "Oskarżono go o bycie <w>paplą</w>, gdy poufne plany wyciekły."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossiper",
                        "gossip"
                    ],
                    "common_phrases": [
                        "a known blab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for a person who talks too much."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Osoba, która wyjawia sekrety lub plotkuje; skarżypyta."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "plotkarz",
                                "target_lang_sense_clarification": "osoba lubiąca rozpowiadać plotki"
                            },
                            {
                                "target_lang_word": "papla",
                                "target_lang_sense_clarification": "osoba, która nie potrafi dochować tajemnicy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d25ecf6c-562e-3325-9f60-2e2adfabf20e",
                    "sense_definition": "Idle talk, chatter, or gossip.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gossip-noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I am tired of listening to all this useless <w>blab</w> about other people's lives.",
                            "target_lang_translations": {
                                "pl": "Jestem zmęczony słuchaniem tej całej bezużytecznej <w>paplaniny</w> o życiu innych ludzi."
                            }
                        },
                        {
                            "text": "She ignored his constant <w>blab</w> and focused on finishing her work.",
                            "target_lang_translations": {
                                "pl": "Zignorowała jego ciągłe <w>gadanie</w> i skupiła się na kończeniu swojej pracy."
                            }
                        }
                    ],
                    "synonyms": [
                        "gossip"
                    ],
                    "common_phrases": [
                        "useless blab"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal term for chatter or gossip."
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Puste gadanie, paplanina lub plotki."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "paplanina",
                                "target_lang_sense_clarification": "bezsensowne lub męczące mówienie"
                            },
                            {
                                "target_lang_word": "gadanie",
                                "target_lang_sense_clarification": "potoczne określenie na zbędne słowa"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}