                                        "sense_id": "883d3bfc-c13d-3f82-8b40-eafc5a4bda31",
                                        "entry_id": "fb96ea1a-0254-3345-8b66-3b41573bb6f1",
                                        "glosses": [
                                            "Féminin singulier de légumineux."
                                        ],
