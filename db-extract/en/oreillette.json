                "senses": [
                    {
                        "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                        "entry_id": "bd45d0ea-458e-3bb1-bb89-46bbeaa1b09d",
                        "glosses": [
                            "A flap or plate covering the ear in medieval armor helmets and civilian clothing."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3c590490-dc90-4eec-b3c7-b0ebe991d7f2",
                                "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                                "text": "The head is covered with a helmet, with oreillettes, and a pierced vizor; upon which are the arms of England, and the King's initials, “J. R.”"
                            },
                            {
                                "example_id": "ea1b48b6-a8b5-4de4-a629-c7ea0cb8363f",
                                "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                                "text": "The third attendant, who bears the king's square banner, whereon is emblazoned his harp, has a visor'd helmet, with the mentoniere and circular oreillettes, and the neck-covering, or hausse-col, of plate; […]"
                            },
                            {
                                "example_id": "15f912c2-0c8c-400e-bbcb-d798813ecfa7",
                                "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                                "text": "Iron helmet, with oreillettes ornamented with repoussé arabesques crested with a sort of sheaf ornament; in front is a dolphin mask. This beautiful helmet is doubtless the work of Paolo di Negroli, a famous Milanese armourer ..."
                            },
                            {
                                "example_id": "817f738e-28e8-4e43-a8bf-52e9caad8cc9",
                                "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                                "text": "The helmet is also furnished with two oreillettes, attached by hinges, and will meet over the chin ..."
                            },
                            {
                                "example_id": "0c08619f-f6e9-49b9-b393-1677e3c839b6",
                                "sense_id": "5f58709c-a168-302f-9e25-4e1cb864e96b",
                                "text": "It is in fact a conical cap, with a laminated neckpiece and oreillettes. This helmet was designed to meet a defect in the armet, for there was a weak place, where the casque came in contact with the body armour."
                            }
                        ]
                    }
                ],
