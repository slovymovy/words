                "senses": [
                    {
                        "sense_id": "1823fc03-d293-3219-bbe3-be63366cd9dd",
                        "entry_id": "97ed4799-e538-3a04-99cc-8bc724f56a02",
                        "glosses": [
                            "Cellule ayant une partie unciforme destinée à être projetée puis à injecter une substance urticante à une proie ou un prédateur. On trouve ces cellules urticantes sur les cnidaires (méduse, anémone de mer, etc.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b85023-3df6-4cd9-8564-fedef1ed5a3b",
                                "sense_id": "1823fc03-d293-3219-bbe3-be63366cd9dd",
                                "text": "Cnidoblaste ou Cnidocyte n. m. (du gr. knidê, ortie, et du gr. blastos, germe). Cellule urticante de l'ectoderme des Cnidaires, comportant une capsule appelée cnidocyste ou nématocyste et un filament sensoriel, le cnidocil."
                            },
                            {
                                "example_id": "565bb573-3af8-4e88-ae38-306542ffdec0",
                                "sense_id": "1823fc03-d293-3219-bbe3-be63366cd9dd",
                                "text": "Chaque cnidocyte est équipé d'un cnidocil sensoriel qui, excité par le contact d'une proie, induit une levée de l'opercule fermant l'ampoule à venin (ou cnydocyste)."
                            }
                        ]
                    }
                ],
