                    {
                        "sense_id": "90815f8d-fee1-395c-bdcc-6cfbed262b3f",
                        "entry_id": "c056437e-8505-3129-b6fe-1867dfbfa8dc",
                        "glosses": [
                            "een explosief of wapen dat niet op het oorspronkelijk bedoelde moment afgegaan is; ook figuurlijk gebruikt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145a9d61-d0b0-47a3-a44c-9f2a9b3880a5",
                                "sense_id": "90815f8d-fee1-395c-bdcc-6cfbed262b3f",
                                "text": "Hij werd het slachtoffer van een NAVO-blindganger, waarschijnlijk een 40mm-granaat. Ook de Nederlandse krijgsmacht, die vooral in de provincie Uruzgan actief was, gebruikte deze granaten."
                            },
                            {
                                "example_id": "ee7f094c-6985-40b8-bd52-fd18bfdd0840",
                                "sense_id": "90815f8d-fee1-395c-bdcc-6cfbed262b3f",
                                "text": "Toch draait het kabinet na verloop van tijd bij. Als steeds meer explosief jihadistisch vuurwerk naar Syrië vertrekt groeit de angst voor terugkerende blindgangers in Nederland. Na de schietpartij in Brussel, waar zo’n volledig doorgedraaide jongen vier mensen doodschoot, ging Opstelten overstag."
                            }
                        ]
                    }
