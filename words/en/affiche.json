{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "604dbfc1-72b9-318c-a371-66bcf6936b61",
                    "sense_definition": "A written or printed notice, poster, or placard displayed publicly.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The curator examined an antique <w>affiche</w> promoting a Parisian cabaret.",
                            "target_lang_translations": {
                                "zh": "策展人仔细检查了一张宣传巴黎歌舞表演的古董<w>海报</w>。"
                            }
                        },
                        {
                            "text": "An ornate <w>affiche</w> was pasted onto the wooden fence near the square.",
                            "target_lang_translations": {
                                "zh": "一张华丽的<w>告示</w>被贴在广场附近的木栅栏上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "placard",
                        "poster"
                    ],
                    "target_lang_definitions": {
                        "zh": "公开发布或张贴的书面、印刷通告、海报或布告。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "海报",
                                "target_lang_sense_clarification": "宣传或告示海报"
                            },
                            {
                                "target_lang_word": "告示",
                                "target_lang_sense_clarification": "张贴的通知或公告"
                            },
                            {
                                "target_lang_word": "布告",
                                "target_lang_sense_clarification": "公开张贴的官方或公共通知"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32f47b42-9f84-3d6f-8915-fe148c443ecc",
                    "sense_definition": "To fasten or paste a poster or placard onto a surface.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Activists began to <w>affiche</w> political notices across the city walls.",
                            "target_lang_translations": {
                                "zh": "活动人士开始在全城的墙壁上<w>张贴</w>政治通告。"
                            }
                        },
                        {
                            "text": "The workers <w>affiched</w> advertisements on the designated billboards each morning.",
                            "target_lang_translations": {
                                "zh": "工人们每天早晨都在指定的广告牌上<w>贴出</w>广告。"
                            }
                        }
                    ],
                    "synonyms": [
                        "post"
                    ],
                    "target_lang_definitions": {
                        "zh": "将海报、布告等张贴或固定在表面上。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "张贴",
                                "target_lang_sense_clarification": "贴上海报、布告等"
                            },
                            {
                                "target_lang_word": "贴出",
                                "target_lang_sense_clarification": "公开贴出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3aa5c5ae-6cd4-3ad3-98eb-263423149262",
                    "sense_definition": "To parade, publicize, or conspicuously display something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>affiche</w> his political allegiances quite openly at every public gathering.",
                            "target_lang_translations": {
                                "zh": "他选择在每一次公共集会上非常公开地<w>宣示</w>自己的政治立场。"
                            }
                        },
                        {
                            "text": "The aristocrats gathered to celebrate victories while personal sentiments were routinely <w>affiched</w>.",
                            "target_lang_translations": {
                                "zh": "贵族们聚集在一起庆祝胜利，而个人情绪也常常被公开<w>张扬</w>出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "display",
                        "parade",
                        "publicize"
                    ],
                    "target_lang_definitions": {
                        "zh": "炫耀、公开宣扬或引人注目地展示某种观点或情感。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "宣示",
                                "target_lang_sense_clarification": "公开表明或表达"
                            },
                            {
                                "target_lang_word": "张扬",
                                "target_lang_sense_clarification": "高调展示或宣扬"
                            },
                            {
                                "target_lang_word": "大肆宣扬",
                                "target_lang_sense_clarification": "广泛且公开地展示"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}