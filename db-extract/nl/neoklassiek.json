                "senses": [
                    {
                        "sense_id": "f5663653-75d2-3a0a-8bbd-7630d0b9b3c2",
                        "entry_id": "8dc12ff8-31b3-358d-82d2-d496ffd0f496",
                        "glosses": [
                            "op een nieuwe manier die gebaseerd is op oudere stijlen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd65de3f-3f18-490e-8d9f-7016fb66ba76",
                                "sense_id": "f5663653-75d2-3a0a-8bbd-7630d0b9b3c2",
                                "text": "Vanaf het jaar daarop voerde hij in vooral neoklassieke stijl bouwopdrachten uit voor de partij."
                            },
                            {
                                "example_id": "7ac18549-abb3-4f0b-a148-58bd183f4a2d",
                                "sense_id": "f5663653-75d2-3a0a-8bbd-7630d0b9b3c2",
                                "text": "Hij nam het mee naar zijn streng neoklassieke huis in Cumbria, waar het een plek kreeg in de hal."
                            },
                            {
                                "example_id": "4031c776-4b66-4c16-84ba-d3d73b4f3b85",
                                "sense_id": "f5663653-75d2-3a0a-8bbd-7630d0b9b3c2",
                                "text": "In een mooi neoklassiek gebouw, het centrum van netwerk Melissa in Athene, zijn de cursussen en andere programma's voor vluchtelingenvrouwen na de zomer weer begonnen. In bijna alle ruimtes zijn activiteiten gaande."
                            }
                        ]
                    }
