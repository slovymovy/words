                                        "examples": [
                                            {
                                                "example_id": "fc781d9f-1bdd-4a56-bac1-8efd062bc736",
                                                "sense_id": "8af3fbc3-f785-3181-a602-71deb5fd524c",
                                                "text": "\"My friends ICQ me before they call me just to make sure I'm there,\" said Kurera, a 19-year-old sophomore […]"
                                            },
                                            {
                                                "example_id": "8ae97daa-71e4-4f1a-a177-9b091a9095af",
                                                "sense_id": "8af3fbc3-f785-3181-a602-71deb5fd524c",
                                                "text": "I'll log-on in Hawaii. If needed we can ICQ from there."
                                            },
                                            {
                                                "example_id": "6b458856-4453-4ec7-bdfc-c19fbd367485",
                                                "sense_id": "8af3fbc3-f785-3181-a602-71deb5fd524c",
                                                "text": "It shut him up. Never had him ICQ me again."
                                            }
                                        ]
                                    }
