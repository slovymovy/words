                        "sense_id": "53238f66-a1d1-351b-8b21-87ac4adf48db",
                        "entry_id": "8a1ab69c-818b-3e2d-9e6c-adff25ff3bb6",
                        "glosses": [
                            "Graminée du genre Glyceria qui comprend 40 espèces de vivaces hygrophytes ou aquatiques. → voir Glyceria"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dc49e1e-e12f-48c2-ba97-234b1d4b2859",
                                "sense_id": "53238f66-a1d1-351b-8b21-87ac4adf48db",
                                "text": "De la fétuque et du pâturin comme en France, mais aussi du cynodon pied-de-poule, de la glycérie flottante, et le ray-grass et la fléole et l'andropogon."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9e6f41e2-66dc-495b-9efd-10bbea3139c9",
                        "source_entry_id": "8a1ab69c-818b-3e2d-9e6c-adff25ff3bb6",
                        "source_sense_id": "53238f66-a1d1-351b-8b21-87ac4adf48db",
                        "target_lang_word": "Schwade",
