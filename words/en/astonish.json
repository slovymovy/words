    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f70758dc-19b6-315c-b027-ed921ef8bc1e",
                    "sense_definition": "To surprise someone very much.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magician's final trick never fails to <w>astonish</w> the audience.",
                            "target_lang_translations": {
                                "tr": "Sihirbazın son numarası izleyicileri <w>şaşırtmaktan</w> asla geri kalmıyor.",
                                "es": "El truco final del mago nunca deja de <w>asombrar</w> al público."
                            }
                        },
                        {
                            "text": "It did not <w>astonish</w> me that she decided to quit her job.",
                            "target_lang_translations": {
                                "tr": "İşinden ayrılmaya karar vermesi beni <w>hayrete düşürmedi</w>.",
                                "es": "No me <w>sorprendió</w> que decidiera renunciar a su trabajo."
                            }
                        }
                    ],
                    "synonyms": [
                        "astound",
                        "flabbergast",
                        "surprise"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini çok şaşırtmak, hayrete düşürmek.",
                        "es": "Sorprender o impresionar a alguien en gran medida."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "şaşırtmak",
                                "target_lang_sense_clarification": "Beklenmedik bir durumla birini şaşkınlığa uğratmak."
                            },
                            {
                                "target_lang_word": "hayrete düşürmek",
                                "target_lang_sense_clarification": "Birini büyük bir şaşkınlık içinde bırakmak."
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "asombrar",
                                "target_lang_sense_clarification": "Causar gran admiración o extrañeza ante algo extraordinario"
                            },
                            {
                                "target_lang_word": "sorprender",
                                "target_lang_sense_clarification": "Causar sorpresa o conmoción"
                            },
                            {
                                "target_lang_word": "pasmar",
                                "target_lang_sense_clarification": "Dejar a alguien atónito o estupefacto"
                            },
                            {
                                "target_lang_word": "anonadar",
                                "target_lang_sense_clarification": "Dejar a alguien perplejo o profundamente impresionado"
                            }
                        ]
                    }
                }
            ]
        }
    ]
