                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c5edeb4-7dbf-4eee-a827-8ceaec5c8114",
                                "sense_id": "e986cd01-3db8-3eb6-940e-3daf9c181bfe",
                                "text": "„Auf dem eroberten Territorium errichteten die Ordensritter Festungen, gründeten Städte und besiedelten bislang menschenleere Gebiete mit Kolonisten aus Deutschland und anderen europäischen Ländern.“"
                            },
                            {
                                "example_id": "fc5e9b7e-51c8-4186-b536-9c6ad6b1e1ad",
                                "sense_id": "e986cd01-3db8-3eb6-940e-3daf9c181bfe",
                                "text": "„An den Ufern des Binnenmeers hatten die ersten deutschen Ordensritter ihre Anker geworfen; das Haff war eines der frühen Einfallstore der Kolonisatoren gewesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
