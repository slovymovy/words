                "senses": [
                    {
                        "sense_id": "b92796ff-cb46-358a-9349-d2b7cb979388",
                        "entry_id": "198a9c23-c073-34e5-b6a8-92e18d7887da",
                        "glosses": [
                            "zeitliche Erstreckung eines Lüftungsvorgang für einen Motor; Kühlsystem für einen Verbrennungsmotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aed419af-b400-488d-a681-ef566f632438",
                                "sense_id": "b92796ff-cb46-358a-9349-d2b7cb979388",
                                "text": "„Dort wird die Motorlüftung überprüft und allenfalls ausgewechselt.“"
                            },
                            {
                                "example_id": "6c932fed-7673-4619-8db7-7474e0b2327c",
                                "sense_id": "b92796ff-cb46-358a-9349-d2b7cb979388",
                                "text": "„Die Motorlüftung sowie die Sehklappen werden durch Ätzteile ersetzt bzw. ergänzt.“"
                            },
                            {
                                "example_id": "1312e863-1809-492f-b797-28e21043618c",
                                "sense_id": "b92796ff-cb46-358a-9349-d2b7cb979388",
                                "text": "„Das häufigste Problem sei Kondenswasser, das sich im Motor bildet und die Motorlüftung verstopfe.“"
                            },
                            {
                                "example_id": "0b6ffd0d-b706-4b32-8dc3-548797233fd9",
                                "sense_id": "b92796ff-cb46-358a-9349-d2b7cb979388",
                                "text": "„Nachdem gestern eine Welle zur Motorlüftung für einen Ölverlust sorgte, versuchten Mathias Behringer, Hugo Kupper und Michael Karg die ganze Nacht vergebens, an die fehlenden Ersatzteile heranzukommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ff7920f5-401f-3a86-bad7-39192186943c",
                        "entry_id": "198a9c23-c073-34e5-b6a8-92e18d7887da",
                        "glosses": [
                            "permanenter Lüftungsvorgang an einem Elektromotor im Dauerbetrieb; Lüfterrad auf dem Rotor"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "457bbe39-cd58-4c52-84d2-7653560a64c7",
                                "sense_id": "ff7920f5-401f-3a86-bad7-39192186943c",
                                "text": "„Zur Motorlüftung ist ein Wandabstand von 50 mm erforderlich.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
