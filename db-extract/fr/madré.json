                "senses": [
                    {
                        "sense_id": "6fa8a45c-5b68-361f-b59d-2c5cd6bb5c0d",
                        "entry_id": "c7a17f8c-cf29-3dd5-8e3c-39815d12ce26",
                        "glosses": [
                            "Personnage rusé et matois."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c23a0fb-d6b9-49cc-971c-ca70d581c6c1",
                                "sense_id": "6fa8a45c-5b68-361f-b59d-2c5cd6bb5c0d",
                                "text": "Je sais bien ce que tu penses, Alexandre, que je suis un brigand, un madré et un fourbe, peu importe, je t’ai dévoilé les choses telles qu’elles sont, c’est toi qui détiens la clé de mon bonheur."
                            },
                            {
                                "example_id": "55b7e251-0ee6-40db-a838-46ee936e4009",
                                "sense_id": "6fa8a45c-5b68-361f-b59d-2c5cd6bb5c0d",
                                "text": "Le pays des terribles Cadets de Gascogne, le pays de madrés, des malins, des finauds, des habiles, […], ce pays là ne serait plus qu’un pays de hongres, voué à la décadence et à la destruction ?"
                            }
                        ]
                    }
