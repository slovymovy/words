                        ]
                    },
                    {
                        "translation_id": "67fadbeb-f0a5-4095-9f70-b5575aec6033",
                        "source_entry_id": "f9d10ba0-124d-35b5-9cd5-061f5144520c",
                        "source_sense_id": "9e7abcf5-f72e-3547-8069-c7313ed57182",
                        "target_lang_word": "coiner",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coiner",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                        "entry_id": "1a7e789b-902d-391e-be2c-3e2342b6cff3",
                                        "glosses": [
                                            "A person who makes coins (often counterfeit coins)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "65afaac1-8160-48cd-adb7-1f98782b91e8",
                                                "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                                "text": "But canst thou excuse thy selfe of vice in that thou art not couetous? certeinly no more then the murtherer would therefore be guiltlesse bicause he is no coyner."
                                            },
                                            {
                                                "example_id": "c6837410-6ccd-4144-8f9f-b6b6ce08d0b7",
                                                "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                                "text": "[…] that most venerable man which I\nDid call my father, was I know not where\nWhen I was stamp’d; some coiner with his tools\nMade me a counterfeit […]"
                                            },
                                            {
                                                "example_id": "7e51f1b5-c4e3-4d4d-8ee7-3a9d7fa728fc",
                                                "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                                "text": "The figures and letters were so mingled together, that one would think the Coiner was hard put to it on what part of the money to bestow the several words of his inscription."
                                            },
                                            {
                                                "example_id": "a1f8c025-00b3-4cac-b56b-9718178b6269",
                                                "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                                "text": "1776, Adam Smith, An Inquiry into the Nature and Causes of the Wealth of Nations, London: W. Strahan & T. Cadell, Book 4, Chapter 6, pp. 139-40,\nThe dangers to which a false coiner is every where exposed, if he lives in the country of which he counterfeits the coin, and to which his agents or correspondents are exposed if he lives in a foreign country, are by far too great to be incurred for the sake of a profit of six or seven per cent."
                                            },
                                            {
                                                "example_id": "080e8e6d-4d23-4436-b63b-c69857767408",
                                                "sense_id": "0f035972-6347-330c-a554-8160596f5f9a",
                                                "text": "The coiners too multiplied and prospered; for the worse the current money became the more easily it was imitated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "faf3a5a0-d747-3965-8759-49c303e3bcb5",
                                        "entry_id": "1a7e789b-902d-391e-be2c-3e2342b6cff3",
                                        "glosses": [
                                            "A person who invents words or phrases."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39fe38c6-3f8e-452a-8308-7139bf7257fe",
                                                "sense_id": "faf3a5a0-d747-3965-8759-49c303e3bcb5",
                                                "text": "1651, John Ellistone (translator), Signatura Rerum by Jakob Böhme (1621), London: Gyles Calvert, Postscript, “The Translators Exposition of the word, Sude,” p. 207,\nThese are some unusual Words, which I have used in the rendering this Book into English; not that I would make it a Strange-Lation, or be a Coyner of new words to amuse the mind only, but to express as well, and as fitly as I could, the Authors Intent and scope […]"
                                            },
                                            {
                                                "example_id": "20dfb048-6b6f-4545-b681-bf3a13799e8c",
                                                "sense_id": "faf3a5a0-d747-3965-8759-49c303e3bcb5",
                                                "text": "This is likewise a Libel upon the memory of Mr. Dryden whom he pretends to admire; for never any one was a greater Coiner than he, and it is directly contrary to the Improvement of Languages […]"
                                            },
                                            {
                                                "example_id": "bd051f97-a079-4847-b22e-5b2ace840d8e",
                                                "sense_id": "faf3a5a0-d747-3965-8759-49c303e3bcb5",
                                                "text": "It was not, however, among the verbs and adjectives that the American word-coiners of the first half of the century achieved their gaudiest innovations, but among the substantives."
                                            },
                                            {
                                                "example_id": "b3261817-2ac1-4ab3-875b-5280a46d5e36",
                                                "sense_id": "faf3a5a0-d747-3965-8759-49c303e3bcb5",
                                                "text": "Any fresh idea is immediately pounced on and mauled to death. Irvin Cobb remarked concerning the dull conversation of Hollywood that the phrase coiners preserved silence until they had sold the wheeze themselves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f63159af-a773-361a-9cff-0aec638aaeca",
                                        "entry_id": "1a7e789b-902d-391e-be2c-3e2342b6cff3",
                                        "glosses": [
                                            "A person who invents or fabricates (stories, lies, etc.)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d448c47-0410-4418-b242-90c7ac35fd04",
                                                "sense_id": "f63159af-a773-361a-9cff-0aec638aaeca",
                                                "text": "[…] the inuenter & coyner of al these michiefes, & seruante & bondslaue of al bawdie luste, fylthie concupiscence, and all detestable sinne and vice."
                                            },
                                            {
                                                "example_id": "30d1fb99-94ce-40b7-b7d3-f45611880396",
                                                "sense_id": "f63159af-a773-361a-9cff-0aec638aaeca",
                                                "text": "The truth is, men in generall hate lying, both the coyner of it, and the teller of it […]"
                                            },
                                            {
                                                "example_id": "956a2dc0-e621-4a45-8967-c8018283d79f",
                                                "sense_id": "f63159af-a773-361a-9cff-0aec638aaeca",
                                                "text": "[…] a coyner and broacher of fictions and fables, to gain credit thereby to his cheating Trade, and to gull poor people with, by telling them such fond tales, and frivolous stories, as himself well knows, and his own Conscience (if he have any at least,) told him, that he had no proof at all for […]"
                                            },
                                            {
                                                "example_id": "4b002f7d-05b4-4ea6-9ad8-3dddc9b3abb6",
                                                "sense_id": "f63159af-a773-361a-9cff-0aec638aaeca",
                                                "text": "[…] a Romancer, a Coyner of Fables, a Misrepresenter and Slanderer […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "780e2f9e-3eef-300c-a25d-fe100c8916d5",
                                        "entry_id": "1a7e789b-902d-391e-be2c-3e2342b6cff3",
                                        "glosses": [
                                            "A person who invests in or advocates for cryptocurrencies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
