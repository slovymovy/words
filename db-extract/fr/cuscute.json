                                        "sense_id": "577263ed-154f-33f5-973f-3b67eae2974c",
                                        "entry_id": "99d00bed-3baa-386c-976f-e392f076bff8",
                                        "glosses": [
                                            "parasitische Pflanze aus der Gattung Cuscuta"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ec04013-20d0-4df6-9687-ebad71059857",
                                                "sense_id": "577263ed-154f-33f5-973f-3b67eae2974c",
                                                "text": "Der Teufelszwirn hat keine Blätter und ernährt sich parasitisch von anderen Pflanzen."
                                            }
