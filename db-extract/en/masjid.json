                        "entry_id": "482168d8-157a-3071-9af0-95d2170b6643",
                        "glosses": [
                            "A mosque."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4561d8a4-205f-4b42-9a4a-3d64f4a08b87",
                                "sense_id": "ae1548ab-e2dd-3b77-a6ab-217990e9b396",
                                "text": "Any masjid where the practices are devoted absolutely to The God ALONE."
                            },
                            {
                                "example_id": "0991d2cd-6f52-4ba2-9d44-a09f9c95af1b",
                                "sense_id": "ae1548ab-e2dd-3b77-a6ab-217990e9b396",
                                "text": "If you assign a place in your home or office for prayer, then it can be considered as your own masjid."
                            },
                            {
                                "example_id": "6191a711-10c2-465a-8ab7-09d8508328e7",
                                "sense_id": "ae1548ab-e2dd-3b77-a6ab-217990e9b396",
                                "text": "A terribly painful sound never before heard in any masjid escaped Aashraf."
                            }
                        ]
                    }
