                ],
                "senses": [
                    {
                        "sense_id": "59d5a991-1e0f-33dd-ab13-4f307d808b8e",
                        "entry_id": "f942b0bb-94fb-3cea-acd2-94ddfaed1797",
                        "glosses": [
                            "Celui qui prétend à la même dignité, à la même charge ou au même emploi que veut obtenir une autre personne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b2afb2-42d8-426a-b67c-9032750643ee",
                                "sense_id": "59d5a991-1e0f-33dd-ab13-4f307d808b8e",
                                "text": "Ils étaient compétiteurs à la même charge. — Il aura bien des compétiteurs."
                            },
                            {
                                "example_id": "d2055e29-867f-48df-9588-fb5e6c32269a",
                                "sense_id": "59d5a991-1e0f-33dd-ab13-4f307d808b8e",
                                "text": "Quant à mon illustre compétiteur le prince de Condé, continua le prince d'Auvergne, il me semble que rien ne saurait mieux récompenser son désintéressement que le gouvernement général de la Gascogne, de la Guyenne et de la Navarre, avec pleins pouvoirs civils, militaires et financiers."
                            }
                        ]
                    },
                    {
                        "sense_id": "68f60058-86f2-3112-9974-d44cbfd7a4f8",
                        "entry_id": "f942b0bb-94fb-3cea-acd2-94ddfaed1797",
                        "glosses": [
                            "Celui qui participe à une compétition."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7511a2bf-9544-44bd-9126-9d325e375af7",
                                "sense_id": "68f60058-86f2-3112-9974-d44cbfd7a4f8",
                                "text": "Lors de cette rencontre inter-communes, 5 compétiteurs mirambeaulais ont participé."
                            },
                            {
                                "example_id": "3a88cb38-3f79-4601-930e-4912fef41d97",
                                "sense_id": "68f60058-86f2-3112-9974-d44cbfd7a4f8",
                                "text": "Gaby Irvoas confiait il y a quelques jours : « Cette saison s'est fort bien terminée pour nos jeunes savateuses et savateurs. Depuis plusieurs années, l'école de savate de la MJC présente des compétiteurs et compétitrices jusqu'en finale du championnat de France."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "84b8914f-fdea-4cd4-8188-0d21fe942eba",
                        "source_entry_id": "f942b0bb-94fb-3cea-acd2-94ddfaed1797",
