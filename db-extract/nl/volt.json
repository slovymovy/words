                    {
                        "translation_id": "297d2501-33b5-4d5a-b348-8b473ef28bf4",
                        "source_entry_id": "b31fafcf-83c0-39e0-a404-24470e453d9a",
                        "source_sense_id": "ff4e6594-5560-3be9-9292-d6ff4dd6734c",
