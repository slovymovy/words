                                    },
                                    {
                                        "sense_id": "dc59111d-d3c3-33d9-8605-cde181e1c62d",
                                        "entry_id": "574ca9d5-6ba8-33d8-bbb9-2692bf38f21e",
                                        "glosses": [
                                            "To obscure in condensation or water."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8014c241-c79f-44ff-82e7-0450eca8f8c5",
                                                "sense_id": "dc59111d-d3c3-33d9-8605-cde181e1c62d",
                                                "text": "Unfortunately, the pendulum has swung way too far to the other end where the saying in the industry is is^([sic]) that if you could fog a mirror, you could get a loan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f587fb7-27ad-3faf-943c-98d3a9f81e29",
                                        "entry_id": "574ca9d5-6ba8-33d8-bbb9-2692bf38f21e",
                                        "glosses": [
                                            "To make confusing or obscure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
