                "senses": [
                    {
                        "sense_id": "49861145-b4cf-3ca0-8c52-3488eb21ddb8",
                        "entry_id": "09fb4d14-4d89-3850-bee5-d8a9c2fbaf40",
                        "glosses": [
                            "weibliche Person, die in den Medien (Fernsehen, Presse, Rundfunk, Verlage) Manuskripte überarbeitet, verbessert und abfasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33dcc98e-adae-459e-bc4f-a4af7b34d7a0",
                                "sense_id": "49861145-b4cf-3ca0-8c52-3488eb21ddb8",
                                "text": "Die Redakteurin kam zu spät zur Redaktionssitzung."
                            },
                            {
                                "example_id": "da6dd2f7-8344-4a28-8242-ca9468d3d5a4",
                                "sense_id": "49861145-b4cf-3ca0-8c52-3488eb21ddb8",
                                "text": "„Durch Vermittlung seines Klassenlehrers trat die Demonstrationsperson wiederholt im Kinderfunk des Senders Hamburg auf und hinterließ nach Meinung der Redakteurin einen außergewöhnlichen Eindruck …“"
                            },
                            {
                                "example_id": "ff17e861-7a37-4c47-abd2-8c8bc21e029d",
                                "sense_id": "49861145-b4cf-3ca0-8c52-3488eb21ddb8",
                                "text": "„Die Bekanntschaft mit den dortigen Redakteurinnen und Zeichnern soll ihm später noch einmal sehr nützlich werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
