                ],
                "senses": [
                    {
                        "sense_id": "1d983078-ee06-3b18-ac22-42b20f8d8fcd",
                        "entry_id": "f02cef26-439b-31bc-8d6e-b4e46052dc9c",
                        "glosses": [
                            "A straight run downhill."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7d0b90f-9097-4a78-bdd6-32fe0aaa025e",
                                "sense_id": "1d983078-ee06-3b18-ac22-42b20f8d8fcd",
                                "text": "The hand slid down the schuss of material and plucked at the hem."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc799974-8341-439e-a7f4-220dbd195066",
                        "source_entry_id": "f02cef26-439b-31bc-8d6e-b4e46052dc9c",
                        "source_sense_id": "1d983078-ee06-3b18-ac22-42b20f8d8fcd",
                        "source_sense_description": "straight run downhill",
                        "target_lang_word": "Schuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Abfeuern einer Waffe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f9b87e02-359f-4da5-87e7-53c2221e1041",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "Zur Warnung gab die Polizei einen Schuss ab."
                                            },
                                            {
                                                "example_id": "7187a674-9275-4dac-adeb-f1e1bb2d5beb",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "„Nur noch vereinzelt waren Schüsse zu hören.“"
                                            },
                                            {
                                                "example_id": "3e7c2b4a-eec4-4551-9e28-b87cb03a132a",
                                                "sense_id": "b309288e-479f-3aec-ba74-2845d6c89d8a",
                                                "text": "„Sie hatten die Autos noch nicht erreicht, als ein Schuss durch die klare Nachtluft hallte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "der Vorgang des Schießens, vom Abfeuern bis zum Eindringen des Geschosses ins Ziel (oder daneben)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e052ca49-f7c4-4e87-928a-098cf1fbeddc",
                                                "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                                "text": "Ein Schuss traf ihn ins Bein, ein anderer in die rechte Hand."
                                            },
                                            {
                                                "example_id": "b1293921-1813-44a1-94f3-e00488da89c1",
                                                "sense_id": "5444f5e3-8ecb-3697-97c0-c14e01390b82",
                                                "text": "Stauffacher: „Gott sei gelobt!“ Leuthold: „Das war ein Schuss! Davon / Wird man noch reden in den spätsten Zeiten.“ (Schiller)"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9f73cd5c-2eae-3822-8517-78be0eecf96f",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Mengenangabe des jeweiligen Geschosses"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56a0d1a-72c2-4da6-9b2e-b404dea8fa31",
                                                "sense_id": "9f73cd5c-2eae-3822-8517-78be0eecf96f",
                                                "text": "„Wieviel Schuss hast du noch“, fragte er unsicher. „Ein Magazin und zwei Kugeln im Lauf!“, sagte der andere."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ebcd06f1-6649-3261-b9ee-ea95647adddb",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Treten eines Balles"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f085150a-1a32-411c-8fe3-3ecb1838f5b5",
                                                "sense_id": "ebcd06f1-6649-3261-b9ee-ea95647adddb",
                                                "text": "Michael Ballack setzt zum Schuss an, schießt und … leider Ecke."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "etwas, eine kleinere Menge (in Bezug auf Flüssigkeiten)"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ae5940c8-8d68-46f5-bd4a-94a9abe86ba3",
                                                "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                                "text": "Ich hätte gern Tee mit einem Schuss Rum."
                                            },
                                            {
                                                "example_id": "4fc08c7f-fb31-493c-94cc-4c1c3ee140c4",
                                                "sense_id": "f9491588-0eb2-3eb7-b670-6ff4036d82f4",
                                                "text": "Berliner Weiße mit Schuss"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "2f5d22ab-76cf-392c-8e60-c40f16ffe688",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Injektion einer Droge"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b30b8a1-e374-4716-b475-8ed93b1ab62c",
                                                "sense_id": "2f5d22ab-76cf-392c-8e60-c40f16ffe688",
                                                "text": "Sie setzte sich einen Schuss mit einer rostigen Spritze."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "98bdfae7-4a10-3165-a7ff-d105a4524a89",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "die Aufzeichnung eines bewegten Bildes (Video / Film)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49909af8-fc0d-40a8-ab90-29d5eb697994",
                                                "sense_id": "98bdfae7-4a10-3165-a7ff-d105a4524a89",
                                                "text": "Eine Kamera übernimmt den Schuss auf den Moderator, die andere den Gegenschuss auf den Gast."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "c55333eb-e45c-3332-b038-487b7b33661b",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "Weberei: der beim Weben durch die Kette geführte Faden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e51e2c42-1813-4df8-84c2-2869e2bb3783",
                                                "sense_id": "c55333eb-e45c-3332-b038-487b7b33661b",
                                                "text": "Beim Halbleinen ist entweder die Kette oder der Schuss aus Baumwolle."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "a982a2d6-1ae0-3fdf-862a-22c81153162c",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "leichte Verrücktheit"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17fa4d50-5e2c-4b19-a613-a0116476a8f1",
                                                "sense_id": "a982a2d6-1ae0-3fdf-862a-22c81153162c",
                                                "text": "Hör doch auf, du hast ja einen Schuss!"
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                        "entry_id": "29b7647d-b9b8-39ca-a4a5-92ae5b0bad24",
                                        "glosses": [
                                            "besonders schnelles Wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0fbe9151-41ec-41cc-af78-bb46e0b8b10c",
                                                "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                                "text": "Bei günstiger Witterung machen die Pflanzen im Frühjahr einen Schuss."
                                            },
                                            {
                                                "example_id": "be6a60c9-faab-41eb-8098-34b541723383",
                                                "sense_id": "b0680cf5-51f8-3b0d-b3fa-7c422dc609ca",
                                                "text": "„Du meine Güte, Junge, hast Du einen Schuss gemacht! Du kannst mir jetzt ja auf den Kopf spucken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    }
                                ]
                            }
                        ]
                    },
