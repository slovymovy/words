                                "example_id": "120ebaed-1db4-43f9-9eaf-0fe312640923",
                                "sense_id": "972e61e5-4ac4-36c9-9c76-b56d43349e78",
                                "text": "„Wir stoßen mit einem Bier auf einen herrlichen Skitag an, teilen uns einen großen Teller Nachos und schauen im Licht der Nachmittagssonne auf die Berge.“"
                            },
                            {
                                "example_id": "de67cef3-f268-42b0-a659-47e096aad69e",
                                "sense_id": "972e61e5-4ac4-36c9-9c76-b56d43349e78",
                                "text": "Vom Geruch des Popcorns und der Nachos wird mir im Kino immer ganz schlecht."
                            }
                        ],
