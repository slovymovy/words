{
    "word_family": [
        "verantwoordelijk",
        "verantwoordelijkheid",
        "onverantwoordelijkheid",
        "verantwoorden"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ac854271-8dc3-3448-a21a-013dbc59c28c",
                    "sense_definition": "Zich onvoldoende rekenschap gevend van de gevolgen van zijn daden; blijk gevend van een gebrek aan plichtsbesef.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onverantwoordelijk_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het is uiterst <w>onverantwoordelijk</w> om met te veel alcohol op achter het stuur te kruipen.",
                            "target_lang_translations": {
                                "en": "It is extremely <w>irresponsible</w> to get behind the wheel with too much alcohol in your system."
                            }
                        },
                        {
                            "text": "Zijn <w>onverantwoordelijke</w> gedrag bracht de veiligheid van de hele groep in gevaar.",
                            "target_lang_translations": {
                                "en": "His <w>irresponsible</w> behavior endangered the safety of the entire group."
                            }
                        }
                    ],
                    "synonyms": [
                        "roekeloos",
                        "lichtzinnig",
                        "onbezonnen"
                    ],
                    "antonyms": [
                        "verantwoordelijk"
                    ],
                    "common_phrases": [
                        "onverantwoordelijk gedrag",
                        "onverantwoordelijk handelen"
                    ],
                    "target_lang_definitions": {
                        "en": "Not sufficiently considering the consequences of one's actions; showing a lack of a sense of duty."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "lacking a sense of responsibility or duty"
                            },
                            {
                                "target_lang_word": "reckless",
                                "target_lang_sense_clarification": "heedless of danger or consequences"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c21be11a-1377-3270-8126-949aabea4eaf",
                    "sense_definition": "Niet te rechtvaardigen of te verdedigen; getuigend van een gebrek aan verantwoordelijkheidsgevoel.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "onverantwoordelijk_gedrag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directie nam een <w>onverantwoordelijk</w> financieel risico door al het geld in één project te steken.",
                            "target_lang_translations": {
                                "en": "The management took an <w>irresponsible</w> financial risk by putting all the money into a single project."
                            }
                        },
                        {
                            "text": "Ik vind het een <w>onverantwoordelijke</w> beslissing om de school nu al te sluiten.",
                            "target_lang_translations": {
                                "en": "I think it is an <w>irresponsible</w> decision to close the school already."
                            }
                        }
                    ],
                    "synonyms": [
                        "onverdedigbaar",
                        "onverantwoord"
                    ],
                    "antonyms": [
                        "verantwoordelijk"
                    ],
                    "common_phrases": [
                        "onverantwoordelijke beslissing",
                        "onverantwoordelijk risico"
                    ],
                    "target_lang_definitions": {
                        "en": "Unjustifiable or indefensible; showing a lack of responsibility."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "irresponsible",
                                "target_lang_sense_clarification": "not showing proper responsibility; unjustifiable"
                            },
                            {
                                "target_lang_word": "unjustifiable",
                                "target_lang_sense_clarification": "impossible to excuse or defend"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}