                "senses": [
                    {
                        "sense_id": "fac5d2f2-ab26-30e3-85b8-9b15383a7165",
                        "entry_id": "112c473c-7900-399e-a5b8-9d990e4930e8",
                        "glosses": [
                            "Justizskandal im Frankreich des 19. Jahrhunderts über die ungerechtfertigte Verurteilung eines jüdischen Offiziers wegen Landesverrats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5990ba7-db20-4d76-916a-c3fc2b90690f",
                                "sense_id": "fac5d2f2-ab26-30e3-85b8-9b15383a7165",
                                "text": "„Wie hätte Israel ausgesehen, wenn nicht Theodor Herzl, den der Zorn über die Dreyfus-Affäre zum Handeln zwang, den Staat aufgebaut hätte, sondern sein Rivale Ehad Haam (Asher Ginzburg) und die anderen zionistischen Intellektuellen, die die Größe des jüdischen Volkes, nicht aber seine Schwächen wiederbeleben wollten?“"
                            },
                            {
                                "example_id": "73d527ae-0d9b-466f-900b-96fc8f9db670",
                                "sense_id": "fac5d2f2-ab26-30e3-85b8-9b15383a7165",
                                "text": "„Maschinengewehre in einem 5-Sterne-Hotel mitten in Paris waren für sich genommen schon eine Schlagzeile wert, aber in Verbindung mit den neun Leichen garantierte es ein Medienspektakel, wie es die Stadt seit der Dreyfus-Affäre nicht mehr erlebt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
