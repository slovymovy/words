                "senses": [
                    {
                        "sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                        "entry_id": "d35426e1-dd84-310d-a1cc-e5d11325b16b",
                        "glosses": [
                            "Mittel, das störende Insekten abtötet oder vertreibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d8e51f2a-0f2a-46eb-8958-e0c34d007c68",
                                "sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                                "text": "Zur Ertragserhöhung werden Insektizide eingesetzt."
                            },
                            {
                                "example_id": "eac42830-612e-4b00-9770-725565c4be7b",
                                "sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                                "text": "„Hier also ackerten geflüchtete Tagelöhner ohne Schutzkleidung unter den Plastikbergen und spritzen Fungizide und Insektizide auf die zarten Pflanzen, die dann mit EU-Gütesiegel auf unseren Tellern landeten.“"
                            },
                            {
                                "example_id": "98374650-aadc-44ac-9c98-48a5ff5bd3c0",
                                "sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                                "text": "„Andere verchwinden, so zum Beispiel die Witze von den Tieren, die durch eine Art Insektizid bekämpft werden, auch wenn es sich nicht um Insekten, sondern etwa um Löwen oder Tiger handelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "da97c99b-1b09-41f5-923d-3ff317957efb",
                        "source_entry_id": "d35426e1-dd84-310d-a1cc-e5d11325b16b",
                        "source_sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                        "source_sense_description": "Mittel, das störende Insekten abtötet oder vertreibt",
                        "target_lang_word": "杀虫剂",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "cfe52769-838c-4a84-aab2-02a3926aa300",
                        "source_entry_id": "d35426e1-dd84-310d-a1cc-e5d11325b16b",
                        "source_sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                        "source_sense_description": "Mittel, das störende Insekten abtötet oder vertreibt",
                        "target_lang_word": "insecticide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insecticide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2a8215ec-b11c-3c3b-87fa-06866ad5eeda",
                                        "entry_id": "4e13e1f5-7868-30d5-ac66-e317b532940f",
                                        "glosses": [
                                            "A substance used to kill insects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba20e6d-856e-43e0-92b7-acee55d5df9c",
                                                "sense_id": "2a8215ec-b11c-3c3b-87fa-06866ad5eeda",
                                                "text": "The dried seed powder of custard apple (Annona squamosa L; family: Annonaceae) has been used as an insecticide in India and many other tropical countries since ancient times."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a43d5c0c-0c46-48b3-858a-e79abb66e996",
                        "source_entry_id": "d35426e1-dd84-310d-a1cc-e5d11325b16b",
                        "source_sense_id": "2b0739e8-375b-31b5-af0d-0092163e29f5",
                        "source_sense_description": "Mittel, das störende Insekten abtötet oder vertreibt",
                        "target_lang_word": "insecticide",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insecticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bbb4e66e-489e-3467-a64b-64702fa74f34",
                                        "entry_id": "621af61e-41eb-33cf-abcc-9daa4c63ecc4",
                                        "glosses": [
                                            "Qui détruit les insectes."
                                        ],
                                        "tags": [],
                                        "note": "Il ne se dit guère que des produits inventés pour faire périr les insectes nuisibles",
                                        "examples": [
                                            {
                                                "example_id": "bcf20922-7901-4cac-b03b-caffe274a74f",
                                                "sense_id": "bbb4e66e-489e-3467-a64b-64702fa74f34",
                                                "text": "L’action insecticide du mélange précédent devient beaucoup plus énergique lorsqu’on y ajoute, ainsi que M. Henneguy en a eu l’idée, une certaine quantité d’alcool méthylique ou esprit de bois qui dissout une partie de l’huile lourde."
                                            },
                                            {
                                                "example_id": "9f9160e6-6c54-49ea-9cb9-e5c8a36569f1",
                                                "sense_id": "bbb4e66e-489e-3467-a64b-64702fa74f34",
                                                "text": "Quant au lysol, nous avons déjà noté, à plusieurs reprises, ses remarquables propriétés insecticides, en particulier dans nos études sur l’acariose."
                                            },
                                            {
                                                "example_id": "882af93d-5e06-4214-9ff0-05a458fbe401",
                                                "sense_id": "bbb4e66e-489e-3467-a64b-64702fa74f34",
                                                "text": "En 1938, le suisse Paul Muller, prix Nobel 1939, découvre les propriétés insecticides du dichloro-diphényltrichloroéthane ou DDT pourtant synthétisé depuis 1874 par l'autrichien Zeidler."
                                            },
                                            {
                                                "example_id": "5edfac0c-705f-4121-9fc8-4a9137ec13ef",
                                                "sense_id": "bbb4e66e-489e-3467-a64b-64702fa74f34",
                                                "text": "Toutefois, les « américanistes », fervents propagandistes des vignes américaines et du greffage, se heurtaient très souvent à l'hostilité active des « sulfuristes » ou « insecticideurs », partisans non moins acharnés des traitements insecticides, seul moyen efficace, d'après eux, pour lutter contre le phylloxéra."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "insecticide",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01802df4-7fb0-3578-b55b-872870b2f498",
                                        "entry_id": "220b8a8e-89b5-38f4-8a37-02c36a940ce2",
                                        "glosses": [
                                            "Produit destiné à l'élimination des insectes, et autres arthropodes comme les araignées, mille-pattes ou cloportes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "072ade85-d0e1-481b-bcbe-417272dd5bdd",
                                                "sense_id": "01802df4-7fb0-3578-b55b-872870b2f498",
                                                "text": "Nous sommes redevables à la lutte contre le Doryphore par les insecticides d'avoir pu maintenir la production de la pomme de terre dans une très grande partie de notre territoire, en dépit de l'invasion doryphorique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f24a590d-189d-3d74-869a-0773a9d443f0",
                                        "entry_id": "220b8a8e-89b5-38f4-8a37-02c36a940ce2",
                                        "glosses": [
                                            "Toute substance active entrant dans cette préparation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b879385-22bf-4955-9c79-a52d2e0e1b7c",
                                                "sense_id": "f24a590d-189d-3d74-869a-0773a9d443f0",
                                                "text": "Arséniate de chaux : C'est l'un des meilleurs insecticides qui existe aujourd'hui sur le marché et le plus économique pour le contrôle de la bête à patate et des insectes mordants en général."
                                            },
                                            {
                                                "example_id": "4566c7e2-411c-4dd8-8a7a-fc947ba34fd8",
                                                "sense_id": "f24a590d-189d-3d74-869a-0773a9d443f0",
                                                "text": "Il est sensible aux insecticides type H. C. H. ou S. P. C., et, dans diverses régions, des opérations d'ensemble connues sous le nom d'« opération hanneton » ont été entreprises avec des moyens puissants."
                                            },
                                            {
                                                "example_id": "7ec02c4f-7438-4601-8b9c-49c88474a7e1",
                                                "sense_id": "f24a590d-189d-3d74-869a-0773a9d443f0",
                                                "text": "La lutte contre les thrips peut être réalisée à l'aide d’insecticide tels que diméthoate ou thiométon."
                                            },
                                            {
                                                "example_id": "7bf78aff-683c-41a0-959d-2cc34b7c5d83",
                                                "sense_id": "f24a590d-189d-3d74-869a-0773a9d443f0",
                                                "text": "C'est donc la lutte chimique qui en fait, a été la méthode utilisée la première contre le doryphore puisque déjà vers 1860 fut employé pour la première fois un insecticide, l’acétoarsénite de cuivre ou vert de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f0350e1-6e5e-30db-a3d5-3feaded89b6c",
                                        "entry_id": "220b8a8e-89b5-38f4-8a37-02c36a940ce2",
                                        "glosses": [
                                            "Produit phytosanitaire destiné à détruire les insectes nuisibles des cultures."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ad9698d-58f5-33d5-bb1b-4796cb410db0",
                                        "entry_id": "220b8a8e-89b5-38f4-8a37-02c36a940ce2",
                                        "glosses": [
                                            "Bombe aérosol contenant le produit lui-même."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
