                    {
                        "form_id": "8caed2e6-c8d4-4670-8437-07133a03cea7",
                        "entry_id": "a436a7ee-399c-33fa-a8fb-910255258094",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "déhanchées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1e57df4d-f2fe-3277-b19f-76c09ba08426",
                        "entry_id": "a436a7ee-399c-33fa-a8fb-910255258094",
                        "glosses": [
                            "Dont la silhouette montre une saillie du côté d’une hanche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e09b444f-675b-441f-9bb9-fa9602c64469",
                                "sense_id": "1e57df4d-f2fe-3277-b19f-76c09ba08426",
                                "text": "La courbe oblique, imperceptiblement déhanchée, qui va des reins au talon rappelle à Michel celle de certaines statuettes de Tanagra, dont, comme toute son époque, il raffole."
                            }
                        ]
                    },
                    {
                        "sense_id": "ab15c351-3b31-3508-b4b4-8fa9f58374b6",
                        "entry_id": "a436a7ee-399c-33fa-a8fb-910255258094",
                        "glosses": [
                            "Qui a une silhouette déformée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25d3ff0c-b261-4cad-a52e-19a9fc83cbf4",
                                "sense_id": "ab15c351-3b31-3508-b4b4-8fa9f58374b6",
                                "text": "Il y avait un grand Napolitain déhanché, avec de longs cheveux noirs, une face parcheminée, des yeux peu rassurants, qui déclarait s’appeler Annibal Pantalacci."
                            },
                            {
                                "example_id": "a1a43689-c4b2-4fd5-9e0e-c6fe89b6578c",
                                "sense_id": "ab15c351-3b31-3508-b4b4-8fa9f58374b6",
                                "text": "Tsetseg était là derrière lui, un peu déhanchée sur son cheval, les mains croisées sur le pommeau de sa selle et son arc en bandoulière."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e69575c-8028-3996-973c-66537c726aab",
                        "entry_id": "a436a7ee-399c-33fa-a8fb-910255258094",
                        "glosses": [
                            "Qui boite suite à une hanche abimée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "784a5bc1-7301-485d-ab28-7c28b750deb1",
                                "sense_id": "5e69575c-8028-3996-973c-66537c726aab",
                                "text": "Et la bête ébouriffée, de son petit galop de loup déhanché, avait suivi la Rousse."
                            },
                            {
                                "example_id": "053f926b-457f-4b7f-bdc8-dcd533ba0f92",
                                "sense_id": "5e69575c-8028-3996-973c-66537c726aab",
                                "text": "— Une petite levrette, avec une patte déhanchée et des yeux tristes, […], boitait d’un tapis sur l'autre."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eb5066c-56ee-4744-b00d-5dce62eee9bb",
                        "source_entry_id": "a436a7ee-399c-33fa-a8fb-910255258094",
