                "senses": [
                    {
                        "sense_id": "d79b3202-13c5-3ca0-b0fb-c25048eaff3a",
                        "entry_id": "ff32672c-e72d-314b-b16c-bdfd96891c49",
                        "glosses": [
                            "Nom générique de plusieurs types de kératose (épaississement de la couche cornée de l’épiderme) de nature tumorale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce195bdc-ec5c-4770-9e6c-d6706f837348",
                                "sense_id": "d79b3202-13c5-3ca0-b0fb-c25048eaff3a",
                                "text": "Quand l’hyperplasie est considérable, on la dénomme hyperkératose ; on l’appelle kératome lorsqu’elle est tumorale."
                            }
                        ]
                    },
                    {
                        "sense_id": "0637dbb8-e48e-3f8c-81da-7192206f7e89",
                        "entry_id": "ff32672c-e72d-314b-b16c-bdfd96891c49",
                        "glosses": [
                            "Instrument de microchirurgie utilisé pour inciser la cornée, notamment dans les opérations de la cataracte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bd16f94d-26a5-4b4f-b7d6-b566c2b8f231",
                                "sense_id": "0637dbb8-e48e-3f8c-81da-7192206f7e89",
                                "text": "Le cyclotome ou kératome, car il porte ces deux noms, est présenté comme bistouri et ophthalmostat : ainsi, il doit fixer l’œil en même temps qu’on ouvre la cornée."
                            },
                            {
                                "example_id": "a0fae8ec-2376-4fe5-b3f6-a6c218fd2bf4",
                                "sense_id": "0637dbb8-e48e-3f8c-81da-7192206f7e89",
                                "text": "Nouvelle révolution en 2003 avec le laser « femtoseconde » (ainsi nommé parce qu’il génère des impulsions aussi brèves qu’une fraction de seconde). Il n’y a plus de découpe mécanique de la cornée avec un kératome (petit rabot microchirurgical automatisé). Tout est fait au laser au micron près (1/1 000 de millimètre)."
                            }
                        ]
                    }
