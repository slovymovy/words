                ],
                "senses": [
                    {
                        "sense_id": "3eca36ba-968f-3f67-84e4-d4b8f0945d11",
                        "entry_id": "baf6131c-8e68-3005-b7f2-3b56944ae560",
                        "glosses": [
                            "mit Schleifmittel beschichtetes Stück Papier zum Schleifen und Glätten rauer Holzflächen oder zum Brechen von Kanten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e50013d-436e-4a00-8498-3a27944910ac",
                                "sense_id": "3eca36ba-968f-3f67-84e4-d4b8f0945d11",
                                "text": "„Das können Sie entweder mühsam von Hand mit Raspel, Feile und Schleifpapier oder ganz einfach mit der maschinellen Hilfe einer Bohrmaschine erledigen.“"
                            },
                            {
                                "example_id": "476de3cc-80e0-4ac2-8ddf-e6599a10b735",
                                "sense_id": "3eca36ba-968f-3f67-84e4-d4b8f0945d11",
                                "text": "„Das Schleifpapier sitzt nun fest auf der Schleifscheibe und kann mit einem Werkzeug oder mit einer Schere zum Scheibenumfang beschnitten werden.“"
                            },
                            {
                                "example_id": "47fe75b9-9d1d-497a-984f-74a573fbba53",
                                "sense_id": "3eca36ba-968f-3f67-84e4-d4b8f0945d11",
                                "text": "„Bei längerem Gebrauch setzt sich das Schleifpapier zu und es kommt sehr schnell zu Brandspuren im Holz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
