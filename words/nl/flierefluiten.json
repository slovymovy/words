            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5a824443-768c-3c31-91fe-32f432ddd4ba",
                    "sense_definition": "zorgeloos en vrolijk door het leven gaan zonder zich druk te maken over plichten of de toekomst",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "levensstijl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt niet je hele leven blijven <w>flierefluiten</w> zonder een echte baan te zoeken.",
                            "target_lang_translations": {
                                "en": "You can't keep <w>drifting through life</w> forever without looking for a real job."
                            }
                        },
                        {
                            "text": "In plaats van te studeren, koos hij ervoor om een jaar lang door Europa te <w>flierefluiten</w>.",
                            "target_lang_translations": {
                                "en": "Instead of studying, he chose to <w>gad about</w> Europe for a year."
                            }
                        }
                    ],
                    "synonyms": [
                        "lanterfanten",
                        "leeglopen",
                        "pierewaaien"
                    ],
                    "antonyms": [
                        "zwoegen",
                        "ploeteren"
                    ],
                    "common_phrases": [
                        "door het leven flierefluiten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "vaak met een licht afkeurende ondertoon"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to go through life in a carefree and cheerful manner without worrying about duties or the future"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to drift through life",
                                "target_lang_sense_clarification": "living without a fixed plan or responsibilities"
                            },
                            {
                                "target_lang_word": "to gad about",
                                "target_lang_sense_clarification": "to wander around in search of pleasure"
                            },
                            {
                                "target_lang_word": "to live a carefree life",
                                "target_lang_sense_clarification": "living without worries or obligations"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "335d08c0-55d1-34a8-9f4b-1556f21e9830",
                    "sense_definition": "de tijd doorbrengen met nietsdoen of luieren op een ontspannen manier",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vrije tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de vakantie deden we niets anders dan een beetje <w>flierefluiten</w> in de tuin.",
                            "target_lang_translations": {
                                "en": "During the holiday, we did nothing but <w>idle</w> a bit in the garden."
                            }
                        },
                        {
                            "text": "Hij houdt ervan om op zondagmiddag heerlijk te <w>flierefluiten</w> zonder enige verplichting.",
                            "target_lang_translations": {
                                "en": "He loves to <w>loaf around</w> on Sunday afternoons without any obligations."
                            }
                        }
                    ],
                    "synonyms": [
                        "luieren",
                        "nietsnutten",
                        "lummelen"
                    ],
                    "antonyms": [
                        "werken",
                        "bezig zijn"
                    ],
                    "common_phrases": [
                        "lekker flierefluiten"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to spend time doing nothing or idling in a relaxed way"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to idle",
