                    {
                        "translation_id": "5b4ffc1b-05d1-447e-91fd-c97741f4d494",
                        "source_entry_id": "ad0b609f-0f0f-3502-97be-0dc7d2ff5b61",
                        "source_sense_description": "female celebrity",
                        "target_lang_word": "diva",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diva",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4190cc4-edee-3dbb-837c-90992846929f",
                                        "entry_id": "32b5f269-140f-3171-a894-4c428915f419",
                                        "glosses": [
                                            "Chanteuse, notamment cantatrice d’art lyrique, de grand talent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8b43a4f-62d2-4b34-8974-0922738f9ce7",
                                                "sense_id": "f4190cc4-edee-3dbb-837c-90992846929f",
                                                "text": "J’aimais ce genre de confrontation entre une diva et une formation symphonique, j’en avais éprouvé les charmes avec Kiri Te Kanawa à New York, Montserrat Caballé à Barcelone, Barbara Hendricks, Natalie Dessay à Paris, et tant d'autres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3dadb5b4-08b8-3d8f-9720-413b840c9a22",
                                        "entry_id": "32b5f269-140f-3171-a894-4c428915f419",
                                        "glosses": [
                                            "Personne vaniteuse au comportement difficile, capricieux et exigeant."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "013b290b-f458-4fba-a4f0-56f2ea567c2c",
                                                "sense_id": "3dadb5b4-08b8-3d8f-9720-413b840c9a22",
                                                "text": "Ton problème c’est que tu prends tout trop dramatiquement, t’es une vraie diva et t’appelles “dépression” ce que la plupart des gens appellent juste la vie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a01526a-c52b-3586-a809-32cf5cb538ae",
                                        "entry_id": "32b5f269-140f-3171-a894-4c428915f419",
                                        "glosses": [
                                            "Grande vedette, notamment au temps du cinéma muet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9aa15934-1b47-4872-9652-590f741bf100",
                                                "sense_id": "7a01526a-c52b-3586-a809-32cf5cb538ae",
                                                "text": "Le divo et la diva sont des aimables personnes qui, pour avoir obtenu quelques succès auprès du public, ont cru posséder une exceptionnelle valeur artistique."
                                            },
                                            {
                                                "example_id": "47c881a1-dd23-45e6-9b20-e5c696f426d2",
                                                "sense_id": "7a01526a-c52b-3586-a809-32cf5cb538ae",
                                                "text": "Les dive ne sont pas, en outre, tout le cinéma italien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a562ee0a-1bdd-419f-a22c-1b83408f5be7",
                        "source_entry_id": "ad0b609f-0f0f-3502-97be-0dc7d2ff5b61",
