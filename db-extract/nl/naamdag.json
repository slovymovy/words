                                        "sense_id": "4081ea7b-2e28-3fd5-b193-71c86b102394",
                                        "entry_id": "18f98a8a-423f-3aa9-97a4-db8921c3e68e",
                                        "glosses": [
                                            "A day in a liturgical calendar that is observed in honour of a saint; not necessarily a holiday."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14b79edb-df1e-4eb0-b7a0-2db2f0cfaa17",
                                                "sense_id": "4081ea7b-2e28-3fd5-b193-71c86b102394",
                                                "text": "One saint's day in mid-term a certain newly appointed suffragan-bishop came to the school chapel, and there preached on “The Inner Life.” He at once secured attention by his informal method, and when presently the coughing of Jarvis […] interrupted the sermon, he altogether captivated his audience with a remark about cough lozenges being cheap and easily procurable."
                                            },
                                            {
                                                "example_id": "abc9e2b7-6230-434b-b3be-f0e44f33f932",
                                                "sense_id": "4081ea7b-2e28-3fd5-b193-71c86b102394",
                                                "text": "To-day is a saint's day. This is a Catholic part of Switzerland, and they have a great many holidays because they have a great many saints. There is hardly a week without some saint in it who has to be commemorated, and often there are two in the same week, and sometimes three."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
