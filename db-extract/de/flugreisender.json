                "senses": [
                    {
                        "sense_id": "b18ca416-d218-349f-b6c5-25673d14a74a",
                        "entry_id": "05736d5e-7beb-36ab-b83d-88770602a265",
                        "glosses": [
                            "männliche Person, die eine Reise mit einem Flugzeug unternimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1551434-3feb-441b-99bc-400480c35d40",
                                "sense_id": "b18ca416-d218-349f-b6c5-25673d14a74a",
                                "text": "„Verspätungen und Ausfälle strapazieren die Nerven Flugreisender.“"
                            },
                            {
                                "example_id": "de3092af-e9ce-4553-99ba-f214048b367f",
                                "sense_id": "b18ca416-d218-349f-b6c5-25673d14a74a",
                                "text": "„Aus Furcht vor Anschlägen verbannen die US-Behörden Laptops und andere elektronische Geräte aus dem Handgepäck bestimmter Flugreisender: Das am Dienstag in Washington verkündete Verbot betrifft Passagiere, die von zehn Flughäfen im Nahen Osten und in Nordafrika auf direktem Weg in die USA fliegen - darunter stark frequentierte Drehkreuze wie Istanbul oder Dubai. Die Maßnahme ist zeitlich nicht befristet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
