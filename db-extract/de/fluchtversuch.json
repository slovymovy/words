                ],
                "senses": [
                    {
                        "sense_id": "7b0dd683-5b60-3793-8518-8a6031ccc286",
                        "entry_id": "c92a6bbf-f9df-3577-8e6e-df6a3f85485a",
                        "glosses": [
                            "Versuch zu fliehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87ed06dc-0fe4-405f-a8f4-7e2eaa4f930e",
                                "sense_id": "7b0dd683-5b60-3793-8518-8a6031ccc286",
                                "text": "„Sie wussten beide, dass sein nächster Fluchtversuch nur eine Frage der Zeit war.“"
                            },
                            {
                                "example_id": "abdf5f0f-d4d8-4ab1-b6a1-aec95d464e88",
                                "sense_id": "7b0dd683-5b60-3793-8518-8a6031ccc286",
                                "text": "„Jede Beteiligung an einer Rebellion wurde mit dem Tod bestraft, Fluchtversuche und Diebstahl hatten eine Brandmarkung auf der Stirn oder eine Amputation von für die Arbeit nicht wichtigen Körperteilen zur Folge.“"
                            },
                            {
                                "example_id": "31a2cef4-1e84-4be4-98e8-6aa6a2150b97",
                                "sense_id": "7b0dd683-5b60-3793-8518-8a6031ccc286",
                                "text": "„Fluchtversuche wurden natürlich sofort geahndet.“"
                            },
                            {
                                "example_id": "f6c734b4-ab8e-4dd6-b00d-0b166ec8a615",
                                "sense_id": "7b0dd683-5b60-3793-8518-8a6031ccc286",
                                "text": "„Der alte Gentleman sprach sehr milde zu uns und sagte, er könne uns unseren Fluchtversuch nicht verübeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
