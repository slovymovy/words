                                        "sense_id": "1c131d1b-edbb-39f6-8ea9-f9a7346131b2",
                                        "entry_id": "c58a744b-64c7-3358-ba23-ec2bc216f717",
                                        "glosses": [
                                            "One of a group of churches (usually a pair) which share the function of being the seat of a bishop."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa2294ea-8a00-40c3-99bd-a9079720f8ed",
                                                "sense_id": "1c131d1b-edbb-39f6-8ea9-f9a7346131b2",
                                                "text": "Long before this day of contented stagnancy, in 1061, when Forcalquier, fortified, growing, and important, claimed many honours, Bishop Gérard Caprérius of Sisteron had given the city a Provost and a Chapter, and created the Church of Saint-Mary, co-cathedral with that of Notre-Dame of Sisteron. Not contented with this honour, Forcalquier demanded and received a Bishopric of her own."
                                            }
                                        ]
                                    }
                                ]
