                    {
                        "sense_id": "76ddae6a-bfed-3088-9a30-8811c4574668",
                        "entry_id": "2c25dc7a-77b5-39f3-a6ae-f2ef5093345c",
                        "glosses": [
                            "Propre ou relatif à Georges Simenon et à son œuvre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba382f08-0dab-460b-8c7d-977cb0dd958c",
                                "sense_id": "76ddae6a-bfed-3088-9a30-8811c4574668",
                                "text": "Mais voilà que le lecteur attentif rétorque qu’au détour de certaines enquêtes le narrateur simenonien fait preuve non seulement d’omniscience, mais aussi d’interventionnisme."
                            },
                            {
                                "example_id": "8143a1c6-61a9-491b-905e-3522d17fe85e",
                                "sense_id": "76ddae6a-bfed-3088-9a30-8811c4574668",
                                "text": "Cet \"acteur simenonien\" a été choisi sans hésitation par le réalisateur et par Jacques Santamaria, qui signe ici sa troisième adaptation d’un roman de Simenon."
                            },
                            {
                                "example_id": "3d9663a7-872c-40c5-a87f-95f076860277",
                                "sense_id": "76ddae6a-bfed-3088-9a30-8811c4574668",
                                "text": "On ne se lasse pas de ces pluies simenoniennes."
                            },
                            {
                                "example_id": "76e3cfc3-07a1-487f-b057-1d7af5fcb578",
                                "sense_id": "76ddae6a-bfed-3088-9a30-8811c4574668",
                                "text": "Néanmoins, si on veut être plus précis on pourrait trouver quelques thèmes forts qui permettent d’affiner le portrait du héros simenonien."
                            }
                        ]
                    }
                ],
