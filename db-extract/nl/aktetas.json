                "senses": [
                    {
                        "sense_id": "f050e170-0a4d-3565-9537-a2302270a4f3",
                        "entry_id": "fe50e69f-72ed-36a3-af5e-d6eb3314f718",
                        "glosses": [
                            "platte en rechthoekige tas van stevig materiaal, geschikt voor papieren en boeken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8345a92-fc9d-4e82-ba34-0bc026fb344c",
                                "sense_id": "f050e170-0a4d-3565-9537-a2302270a4f3",
                                "text": "Hij had zijn aktetas in de trein laten staan."
                            },
                            {
                                "example_id": "00030417-6dd5-42b4-aa83-c6c0784f2846",
                                "sense_id": "f050e170-0a4d-3565-9537-a2302270a4f3",
                                "text": "We waren geen doorsneepassagiers die uitstapten in Baldock's Ridge; de doorsneepassagiers waren mannen van eind veertig met een beginnend buikje, zegelring, de Telegraph onder de arm, een uitpuilende aktetas."
                            },
                            {
                                "example_id": "b058d0da-fb52-4526-99b1-b3ee90d0ac45",
                                "sense_id": "f050e170-0a4d-3565-9537-a2302270a4f3",
                                "text": "Toen ze plaatsnamen aan het ene uiteinde van de buitenproportionele vergadertafel knipte ze plechtig het slot open van haar zwarte aktetas met het gouden logo en haalde de documenten eruit, het kwartaalrapport en de balans, die ze snel uitdeelde."
                            }
                        ]
                    }
                ],
