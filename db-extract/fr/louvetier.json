                            {
                                "example_id": "2d785a34-7af8-417d-9ea7-1ba8bea3d4cb",
                                "sense_id": "304d4873-d77e-3d83-9aae-9d8a3f8c7745",
                                "text": "Le grand louvetier était l’officier de la maison du roi qui commandait l’équipage pour la chasse au loup."
                            },
                            {
                                "example_id": "4f5c2838-c064-49a8-852c-58520be033be",
                                "sense_id": "304d4873-d77e-3d83-9aae-9d8a3f8c7745",
                                "text": "Le président de la Fédération leur a conseillé de s’adresser aux louvetiers chargés de la destruction des animaux nuisibles et au garde de l’Association communale de chasse agréée (ACCA) de Froide-fontaine."
                            }
