                            "singular"
                        ],
                        "form": "den Freilauf"
                    },
                    {
                        "form_id": "bac6c0f8-5147-4a44-9333-f12a8b2fa8a7",
                        "entry_id": "9ec087f0-633a-3028-8431-4dd3d2e51e43",
                        "tags": [
