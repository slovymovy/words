        "fr-extract.jsonl": [
            {
                "entry_id": "974e33e6-3e9f-3dab-b1d9-94ffbb675ac8",
                "word": "litron",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a8fc1f3-c1d9-4330-b2de-9291474b0508",
                        "entry_id": "974e33e6-3e9f-3dab-b1d9-94ffbb675ac8",
                        "tags": [
                            "plural"
                        ],
                        "form": "litrons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fc07c8f9-4f47-37f2-a3d4-6f3794fc31b4",
                        "entry_id": "974e33e6-3e9f-3dab-b1d9-94ffbb675ac8",
                        "glosses": [
                            "Ancienne mesure de capacité valant un seizième de boisseau"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "4abc6bb1-e973-45f4-bd35-e6d69a1f73ff",
                                "sense_id": "fc07c8f9-4f47-37f2-a3d4-6f3794fc31b4",
                                "text": "Celui qui achète un litron de petits pois 100 livres les paye à un cultivateur qui les emploie en dépenses de culture à l’avantage de la reproduction annuelle."
                            },
                            {
                                "example_id": "06ecd62a-e30f-42c8-a8ac-c35183357bc9",
                                "sense_id": "fc07c8f9-4f47-37f2-a3d4-6f3794fc31b4",
                                "text": "Prenez un litron & demi de petits pois, lavez-les, mettez-les dans une casserole avec un morceau de beurre, …"
                            },
                            {
                                "example_id": "7b62c11c-bcec-4aab-9830-e16a88360598",
                                "sense_id": "fc07c8f9-4f47-37f2-a3d4-6f3794fc31b4",
                                "text": "Comme tu connais mieux la valeur des fèves que celle de la monnaie, continua la vieille, tu vendras au marché ces six litrons de fèves choisies à la grande mesure."
                            }
                        ]
                    },
                    {
                        "sense_id": "495c5084-cb1a-3a20-b46f-9aed52ade619",
                        "entry_id": "974e33e6-3e9f-3dab-b1d9-94ffbb675ac8",
                        "glosses": [
                            "Bouteille d’un litre, sa capacité, ou le liquide qu’elle contient."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1d7efced-12e6-41fd-b38f-78aa2e9c0ec1",
                                "sense_id": "495c5084-cb1a-3a20-b46f-9aed52ade619",
                                "text": "C’est toujours moi qui portait^([sic]) la besace, un grand honneur pour une fille de chasseur ! Elle était lourde avec les 6 litrons de vin blanc qu’il lui fallait jusqu’à midi !"
                            },
                            {
                                "example_id": "099fd6d2-7722-4e06-a83b-0469d297b4ee",
                                "sense_id": "495c5084-cb1a-3a20-b46f-9aed52ade619",
                                "text": "C’était ce qui lui valait une allure un peu saccadée et titubante ; mais le ciel pouvait être témoin que pendant tout le temps qu’il avait été seul dans la forêt, faute d’un litron de vin rouge, il avait eu la langue collée au palais."
                            },
                            {
                                "example_id": "9208864b-e309-4734-a6ab-89d45362de1a",
                                "sense_id": "495c5084-cb1a-3a20-b46f-9aed52ade619",
                                "text": "Ici, ça papote, ça ingurgite des litrons de café et ça résonne d’éclats de rire."
                            }
                        ]
                    },
                    {
                        "sense_id": "8579a932-ecb5-3cae-9d7f-6c72e01910fd",
                        "entry_id": "974e33e6-3e9f-3dab-b1d9-94ffbb675ac8",
                        "glosses": [
                            "Litre de vin."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "3ca78cdb-b02a-48cb-8362-78402ab22f44",
                                "sense_id": "8579a932-ecb5-3cae-9d7f-6c72e01910fd",
                                "text": "Alors papa, ça l'avait rendu triste et il s'était mis à picoler. Qu'est-ce qu'il descendait comme litrons."
                            },
                            {
                                "example_id": "520657b6-9f98-4626-963c-064fdb122479",
                                "sense_id": "8579a932-ecb5-3cae-9d7f-6c72e01910fd",
                                "text": "La coco faut savoir la doser, c’est comme le picton, 11,5° en litron étoilé, et tout le monde est content, ça devient un produit standard pour classe moyenne."
                            }
                        ]
                    }
                ],
