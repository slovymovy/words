{
    "word_family": [
        "chicken",
        "chicklet",
        "chickweed"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "09fba01e-3c66-315f-b3af-1f4211f9520f",
                    "sense_definition": "A young chicken.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother hen protected her little <w>chick</w> from the rain.",
                            "target_lang_translations": {
                                "ru": "Курица-мать защищала своего маленького <w>цыплёнка</w> от дождя.",
                                "zh": "母鸡保护着它的<w>小鸡</w>免受雨淋。"
                            }
                        },
                        {
                            "text": "We watched the yellow <w>chick</w> hatch from its egg at the farm.",
                            "target_lang_translations": {
                                "ru": "Мы наблюдали, как жёлтый <w>цыплёнок</w> вылупляется из яйца на ферме.",
                                "zh": "我们在农场看着那只黄色的<w>小鸡</w>破壳而出。"
                            }
                        }
                    ],
                    "antonyms": [
                        "hen",
                        "rooster"
                    ],
                    "common_phrases": [
                        "day-old chick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Молодая курица или петух; птенец курицы.",
                        "zh": "小鸡，鸡的幼崽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цыплёнок",
                                "target_lang_sense_clarification": "детёныш курицы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小鸡",
                                "target_lang_sense_clarification": "鸡的幼崽"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8b64c75-b9b4-3440-8557-801ce4a32548",
                    "sense_definition": "An attractive, young woman.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is hoping to meet a nice <w>chick</w> at the party tonight.",
                            "target_lang_translations": {
                                "ru": "Он надеется встретить симпатичную <w>девчонку</w> на вечеринке сегодня вечером.",
                                "zh": "他希望今晚在派对上能遇到一位漂亮的<w>美女</w>。"
                            }
                        },
                        {
                            "text": "That <w>chick</w> plays the guitar in a popular rock band.",
                            "target_lang_translations": {
                                "ru": "Эта <w>девчонка</w> играет на гитаре в популярной рок-группе.",
                                "zh": "那位<w>辣妹</w>在一个很受欢迎的摇滚乐队里弹吉他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "girl",
                        "gal",
                        "babe",
                        "bird"
                    ],
                    "antonyms": [
                        "guy",
                        "dude"
                    ],
                    "common_phrases": [
                        "hot chick",
                        "cool chick",
                        "chick flick"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often considered slightly offensive or objectifying depending on context"
                        },
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Привлекательная молодая женщина (разговорное).",
                        "zh": "指年轻漂亮的女性（口语，有时带有冒犯性）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цыпочка",
                                "target_lang_sense_clarification": "разг., привлекательная девушка"
                            },
                            {
                                "target_lang_word": "девчонка",
                                "target_lang_sense_clarification": "разг., девушка"
                            },
                            {
                                "target_lang_word": "тёлочка",
                                "target_lang_sense_clarification": "слэнг, часто пренебрежительно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "美女",
                                "target_lang_sense_clarification": "口语，指年轻女性"
                            },
                            {
                                "target_lang_word": "辣妹",
                                "target_lang_sense_clarification": "口语，指时髦漂亮的年轻女性"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "63bbec65-1ea7-3ce2-b923-007700fd9e65",
                    "sense_definition": "A young bird.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The penguin <w>chick</w> waited on the ice for its parents to return with food.",
                            "target_lang_translations": {
                                "ru": "<w>Птенец</w> пингвина ждал на льду возвращения родителей с едой.",
                                "zh": "企鹅<w>雏鸟</w>在冰面上等待父母带食物回来。"
                            }
                        },
                        {
                            "text": "An eagle feeds its <w>chicks</w> high up in the nest.",
                            "target_lang_translations": {
                                "ru": "Орёл кормит своих <w>птенцов</w> высоко в гнезде.",
                                "zh": "老鹰在高处的巢里喂养它的<w>幼鸟</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fledgling"
                    ],
                    "target_lang_definitions": {
                        "ru": "Детёныш птицы.",
                        "zh": "幼鸟。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "птенец",
                                "target_lang_sense_clarification": "детёныш любой птицы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "雏鸟",
                                "target_lang_sense_clarification": "幼小的鸟"
                            },
                            {
                                "target_lang_word": "幼鸟",
                                "target_lang_sense_clarification": "未成年的鸟"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9c4434da-d3ee-3fdb-b188-349482d5455a",
                    "sense_definition": "A young child.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Come here, my little <w>chick</w>, and let me fix your hair.",
                            "target_lang_translations": {
                                "ru": "Иди сюда, мой маленький <w>птенчик</w>, дай я поправлю тебе волосы.",
                                "zh": "过来，我的<w>小宝贝</w>，让我帮你整理一下头发。"
                            }
                        },
                        {
                            "text": "She treats every student in her class like her own <w>chick</w>.",
                            "target_lang_translations": {
                                "ru": "Она относится к каждому ученику в классе как к своему собственному <w>птенцу</w>.",
                                "zh": "她对待班里的每个学生都像对待自己的<w>孩子</w>一样。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "term of endearment"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький ребёнок (ласковое обращение).",
                        "zh": "对小孩的昵称。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "птенчик",
                                "target_lang_sense_clarification": "ласковое обращение"
                            },
                            {
                                "target_lang_word": "детка",
                                "target_lang_sense_clarification": "ребёнок"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小宝贝",
                                "target_lang_sense_clarification": "对小孩的亲昵称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "897d9ea4-ff2e-3a4c-834a-c12e94fb4c23",
                    "sense_definition": "A screen or blind made of finely slit bamboo and twine, hung in doorways or windows.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They lowered the bamboo <w>chick</w> to keep the harsh afternoon sun out of the room.",
                            "target_lang_translations": {
                                "ru": "Они опустили бамбуковую <w>штору</w>, чтобы укрыться от яркого полуденного солнца.",
                                "zh": "他们放下了<w>竹帘</w>，以遮挡午后刺眼的阳光。"
                            }
                        },
                        {
                            "text": "I could hear the wind rattling the <w>chick</w> against the door frame.",
                            "target_lang_translations": {
                                "ru": "Я слышал, как ветер стучит <w>жалюзи</w> о дверной косяк.",
                                "zh": "我能听到风吹得<w>竹帘</w>撞击门框的声音。"
                            }
                        }
                    ],
                    "synonyms": [
                        "chick-blind"
                    ],
                    "common_phrases": [
                        "bamboo chick"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "India"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Штора или жалюзи из тонких бамбуковых планок.",
                        "zh": "一种用细竹条编成的帘子。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бамбуковая штора",
                                "target_lang_sense_clarification": "занавесь"
                            },
                            {
                                "target_lang_word": "жалюзи",
                                "target_lang_sense_clarification": "оконная штора"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竹帘",
                                "target_lang_sense_clarification": "竹子做的帘子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd115497-3d40-351a-8674-046062659728",
                    "sense_definition": "A friendly fighter aircraft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radar operator confirmed that all <w>chicks</w> had returned to the base safely.",
                            "target_lang_translations": {
                                "ru": "Оператор радара подтвердил, что все <w>истребители</w> благополучно вернулись на базу.",
                                "zh": "雷达操作员确认所有<w>战斗机</w>都已安全返回基地。"
                            }
                        },
                        {
                            "text": "We have two <w>chicks</w> approaching from the north sector.",
                            "target_lang_translations": {
                                "ru": "К нам приближаются два <w>своих самолёта</w> с северного сектора.",
                                "zh": "有两架<w>战斗机</w>正从北部区域靠近。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Дружественный истребитель (военный сленг).",
                        "zh": "友军战斗机（军事俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "истребитель",
                                "target_lang_sense_clarification": "военный самолёт"
                            },
                            {
                                "target_lang_word": "свой самолёт",
                                "target_lang_sense_clarification": "дружественный борт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "战斗机",
                                "target_lang_sense_clarification": "军事用语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2151b046-3324-3201-a205-d181cbee2d62",
                    "sense_definition": "To compress the lips and then separate them quickly, resulting in a percussive noise.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "5",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>chicked</w> his tongue in disapproval at the messy room.",
                            "target_lang_translations": {
                                "ru": "Он неодобрительно <w>цокнул</w> языком, глядя на грязную комнату.",
                                "zh": "看到凌乱的房间，他<w>咂</w>了咂嘴表示不满。"
                            }
                        },
                        {
                            "text": "The rider <w>chicked</w> to the horse to urge it forward.",
                            "target_lang_translations": {
                                "ru": "Всадник <w>цокнул</w> лошади, побуждая её идти вперёд.",
                                "zh": "骑手<w>啧啧</w>地催促马儿向前走。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Издавать цокающий звук губами.",
                        "zh": "用嘴发出“啧啧”的响声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цокать",
                                "target_lang_sense_clarification": "издавать звук языком"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "咂嘴",
                                "target_lang_sense_clarification": "发出啧啧声"
                            },
                            {
                                "target_lang_word": "啧啧",
                                "target_lang_sense_clarification": "表示不满或催促的拟声词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eae9fbf8-19c0-30fb-beab-6321d07952a1",
                    "sense_definition": "To sprout, as seed does in the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The farmer was happy to see that the wheat had finally <w>chicked</w>.",
                            "target_lang_translations": {
                                "ru": "Фермер был счастлив увидеть, что пшеница наконец <w>проклюнулась</w>.",
                                "zh": "农夫很高兴看到小麦终于<w>发芽</w>了。"
                            }
                        },
                        {
                            "text": "After the heavy rain, the seeds in the garden began to <w>chick</w>.",
                            "target_lang_translations": {
                                "ru": "После сильного дождя семена в саду начали <w>прорастать</w>.",
                                "zh": "大雨过后，花园里的种子开始<w>出苗</w>了。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прорастать, давать ростки (о семенах).",
                        "zh": "种子发芽。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проклёвываться",
                                "target_lang_sense_clarification": "начинать расти"
                            },
                            {
                                "target_lang_word": "прорастать",
                                "target_lang_sense_clarification": "давать ростки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发芽",
                                "target_lang_sense_clarification": "种子长出芽"
                            },
                            {
                                "target_lang_word": "出苗",
                                "target_lang_sense_clarification": "种子破土而出"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c7665cbd-9835-3421-8233-d1bc58a42e79",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "7",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "We have an appointment with Dr. <w>Chick</w> at three o'clock.",
                            "target_lang_translations": {
                                "ru": "У нас назначена встреча с доктором <w>Чиком</w> на три часа.",
                                "zh": "我们和<w>奇克</w>医生约在三点见面。"
                            }
                        },
                        {
                            "text": "Mr. <w>Chick</w> has lived in this neighborhood for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Чик</w> живёт в этом районе уже двадцать лет.",
                                "zh": "<w>奇克</w>先生在这个社区已经住了二十年了。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Чик",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奇克",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}