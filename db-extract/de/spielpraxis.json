                "senses": [
                    {
                        "sense_id": "97426798-3359-3bec-a31e-6087ae748d76",
                        "entry_id": "fed18f98-3945-3a4c-b996-e8b2d2619a52",
                        "glosses": [
                            "handelnde Tätigkeit mit entsprechender Erfahrung auf dem Gebiet des Spielens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d25fb83-0c23-4462-a9d3-48bef6d9f60b",
                                "sense_id": "97426798-3359-3bec-a31e-6087ae748d76",
                                "text": "„Im Gegensatz zu solchen Gruppen, in denen sich Spielprozesse ohne eine Vielfalt von Regeln entwickeln lassen, wirkt die Spielpraxis von Gruppen im Vereins- und Wettkampfsport häufig sehr viel geregelter und phantasieloser.“"
                            },
                            {
                                "example_id": "82831ba0-2edf-4b9c-b9e4-1f3c5ed84cc4",
                                "sense_id": "97426798-3359-3bec-a31e-6087ae748d76",
                                "text": "„Dieses Buch über Möglichkeiten des Spielens in der Schule zieht die Summe aus einer langjährigen Spielpraxis und aus theoretischen Überlegungen über Form und Funktionen eines Spielcurriculums.“"
                            },
                            {
                                "example_id": "8aaf0435-4e3b-45f4-a94b-758b51eeaf52",
                                "sense_id": "97426798-3359-3bec-a31e-6087ae748d76",
                                "text": "„De Cyreé, ein Roulettespezialist mit damals 35-jähriger Spielpraxis, publizierte 1933 über die Alyettschen Figuren und glaubte damit, das Hasard ausschalten zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
