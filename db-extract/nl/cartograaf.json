                        ],
                        "examples": [
                            {
                                "example_id": "cff0eac1-7811-4362-b248-095eae0c4901",
                                "sense_id": "92b8f6f6-cb56-3cbe-a8c4-ce2352ebcf22",
                                "text": "Joan Blaeu was een welgesteld cartograaf en uitgever in Amsterdam. Hij maakte kaarten die gebaseerd waren op bestaand materiaal, op scheepsjournaals en gesprekken met zeelui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "805520d7-4c97-49c1-9e27-cbbffe79cf05",
                        "source_entry_id": "c27f4ffc-19a6-362a-96a0-dd3239487a9d",
                        "source_sense_id": "92b8f6f6-cb56-3cbe-a8c4-ce2352ebcf22",
                        "source_sense_description": "iemand die land-, zee- en/of luchtkaarten maakt",
                        "target_lang_word": "Kartograf",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
