                ],
                "senses": [
                    {
                        "sense_id": "f61b6b04-683b-3e45-911b-2980d1bf388c",
                        "entry_id": "f926e1bf-e39b-30e8-a7c7-2ae5cc2e4cc7",
                        "glosses": [
                            "Stelle, an der zwei im Winkel zueinander stehende Wände eines Zimmers aufeinandertreffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3e4b824-754c-4000-916f-8bb2e52cd6c6",
                                "sense_id": "f61b6b04-683b-3e45-911b-2980d1bf388c",
                                "text": "„Wieder das Summen, dann ein roter Blitz, und drüben in der Zimmerecke erschien eine zweite Jeannie Nitro.“"
                            },
                            {
                                "example_id": "3cbe4f7a-c7b5-49df-ade5-2772e328c279",
                                "sense_id": "f61b6b04-683b-3e45-911b-2980d1bf388c",
                                "text": "„Mein Blick fällt auf eine Porzellanschale, die auf dem Boden in der Zimmerecke steht und in der sich Anar türmen.“"
                            },
                            {
                                "example_id": "2bc55a37-2647-4240-bcff-e2d5cfabadbe",
                                "sense_id": "f61b6b04-683b-3e45-911b-2980d1bf388c",
                                "text": "„Fürst Andrej ging, die Hände auf dem Rücken, mit gedankenvollem und mildem Gesichtsausdruck, raschen Schrittes von einer Zimmerecke zur anderen, sah vor sich hin und wiegte den Kopf hin und her.“"
                            },
                            {
                                "example_id": "5ff3b779-a7f2-4a42-8f94-eeda5d585670",
                                "sense_id": "f61b6b04-683b-3e45-911b-2980d1bf388c",
                                "text": "„Von der Zimmerecke aus beobachtete Ferris das Ganze mit großen Augen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
