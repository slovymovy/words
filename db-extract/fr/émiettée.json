                        "glosses": [
                            "Préparation culinaire à base de miettes (de pain ou d’autre chose)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb7268fe-ea84-4950-85ff-b8284e289584",
                                "sense_id": "c1ec4f80-91a8-3800-b50e-ab135f794c56",
                                "text": "Les gros travaux n’étaient pas commencés, on ne faisait encore que quatre repas, l’émiettée de lait à sept heures, la rôtie à midi, le pain et le fromage à quatre heures, la soupe et le lard à minuit."
                            },
                            {
                                "example_id": "334d4d02-f2cc-4920-ab1a-7bb8e4c64186",
                                "sense_id": "c1ec4f80-91a8-3800-b50e-ab135f794c56",
                                "text": "Je les ai garnies avec une émiettée de tourteau au combava et poudre de feuilles de Tasmanie."
                            },
                            {
                                "example_id": "dac4cf16-8cca-417e-9e1c-39a9db3971a9",
                                "sense_id": "c1ec4f80-91a8-3800-b50e-ab135f794c56",
                                "text": "Beurrez vos toasts avec une couche de Ricotta puis du pesto de Toscane et déposez une émiettée de fromage de chèvre, ou des fines tranches de radis noir."
                            }
                        ]
                    }
