                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "754c4f20-bd5e-4767-adce-bc9fb77e3818",
                                "sense_id": "2f8f8d9a-dcf0-3740-ba6a-bf4c61e0859a",
                                "text": "Je vous parlerai donc là de cette rencontre, en tant qu’elle m’a conduite à re-lire et à ré-écrire le texte initial."
                            },
                            {
                                "example_id": "f3822b8e-51e6-41b0-9afa-0039c284588c",
                                "sense_id": "2f8f8d9a-dcf0-3740-ba6a-bf4c61e0859a",
                                "text": "Il écrit, éteint, se couche, réfléchit, rallume, ré-écrit, ré-éteint, se re-couche, re-pense."
                            },
                            {
                                "example_id": "fc5245fb-a26a-420b-a7b7-db408308a685",
                                "sense_id": "2f8f8d9a-dcf0-3740-ba6a-bf4c61e0859a",
                                "text": "Savez-vous pourquoi Shelley a justement choisi celles-là dans un manuscrit de cinq-cents page au moins, pour les ré-écrire ?"
                            }
                        ]
                    }
