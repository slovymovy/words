                "senses": [
                    {
                        "sense_id": "c18bb4bf-f771-3da7-8ec4-d1bd4789452a",
                        "entry_id": "4122530e-66b3-3502-a697-c4e3ed62fdac",
                        "glosses": [
                            "two inch"
                        ],
                        "tags": [
                            "no-comparative",
                            "relational"
                        ],
                        "examples": [
                            {
                                "example_id": "b6e19a82-d50f-4070-9369-cb6dd732b155",
                                "sense_id": "c18bb4bf-f771-3da7-8ec4-d1bd4789452a",
                                "text": "– Ку́пишь в лаба́зе де́сять жестя́нок тушёной свини́ны, де́сять помидо́рной па́сты и фу́нта три двухдюймо́вых шуру́пов. Иди́ споко́йно, не огля́дывайся. Они́ тебя́ не тро́нут. Е́сли ошиба́юсь и всё-таки реша́т брать, стрельни́ хоть раз, чтоб я подгото́вился.",
                                "translation": "'Go to the shop and buy ten tins of stewed pork, ten tins of tomato paste and three pounds of two-inch screws. Walk calmly; don't look back. They won't touch you. If I'm wrong and they do decide to take you, fire at least one shot so I can prepare.'",
                                "english": "'Go to the shop and buy ten tins of stewed pork, ten tins of tomato paste and three pounds of two-inch screws. Walk calmly; don't look back. They won't touch you. If I'm wrong and they do decide to take you, fire at least one shot so I can prepare.'"
                            }
                        ]
                    }
                ],
