                ],
                "senses": [
                    {
                        "sense_id": "d2044260-d141-39d8-b1bc-62a8b223e1d3",
                        "entry_id": "5f678899-9b73-3a7e-8514-c2e244b07107",
                        "glosses": [
                            "Any of various forms of low horse-drawn cart or wagon, often without sides or with removable sides, and used especially for heavy loads."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "f9b79e02-0c22-4439-aedc-33dbee7a3de4",
                                "sense_id": "d2044260-d141-39d8-b1bc-62a8b223e1d3",
                                "text": "Let him be brought into the field of election upon his dray-cart."
                            },
                            {
                                "example_id": "5d1c04a4-4c3a-4534-bb5f-032d52c24496",
                                "sense_id": "d2044260-d141-39d8-b1bc-62a8b223e1d3",
                                "text": "Standing foursquare in the heart of the town, at the intersection of the two main streets, a “jog” at each street corner left around the market-house a little public square, which at this hour was well occupied by carts and wagons from the country and empty drays awaiting hire"
                            },
                            {
                                "example_id": "d9cc7f0c-824d-4aaf-b0f1-876b33aea418",
                                "sense_id": "d2044260-d141-39d8-b1bc-62a8b223e1d3",
                                "text": "The shooting motor cars, more like spiders in the moon than terrestrial objects, the thundering drays, the jingling hansoms, and little black broughams, made her think of the world she lived in."
                            }
                        ]
                    },
                    {
                        "sense_id": "a168e968-2bca-361a-8ec0-79512e59e85d",
                        "entry_id": "5f678899-9b73-3a7e-8514-c2e244b07107",
                        "glosses": [
                            "A kind of sledge or sled."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
