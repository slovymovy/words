                {
                    "sense_id": "655e3dc7-cb8f-37d5-9e18-74ab208c9dc3",
                    "sense_definition": "Devenir plus faible, perdre de sa force ou de son intensité.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "diminution de force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le signal radio s'<w>affaiblit</w> à mesure que nous nous éloignons de la ville.",
                            "target_lang_translations": {
                                "en": "The radio signal <w>fades</w> as we move away from the city.",
                                "ru": "Радиосигнал <w>затухает</w> по мере того, как мы удаляемся от города.",
                                "de": "Das Funksignal wird <w>schwächer</w>, je weiter wir uns von der Stadt entfernen.",
                                "es": "La señal de radio <w>se debilita</w> a medida que nos alejamos de la ciudad.",
                                "zh": "随着我们远离城市，无线电信号逐渐<w>减弱</w>。"
                            }
                        },
                        {
                            "text": "Après plusieurs heures de marche sous la pluie, son enthousiasme commençait à s'<w>affaiblir</w>.",
                            "target_lang_translations": {
                                "en": "After several hours of walking in the rain, their enthusiasm was beginning to <w>wane</w>.",
                                "ru": "После нескольких часов ходьбы под дождём энтузиазм начал <w>угасать</w>.",
                                "de": "Nach mehreren Stunden Fußmarsch im Regen begann seine Begeisterung <w>nachzulassen</w>.",
                                "es": "Tras varias horas de caminata bajo la lluvia, su entusiasmo empezaba a <w>decaer</w>.",
                                "zh": "在雨中走了好几个小时后，他的热情开始<w>减退</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "décliner",
                        "baisser",
                        "faiblir"
                    ],
                    "antonyms": [
                        "augmenter",
                        "croître"
                    ],
                    "target_lang_definitions": {
                        "en": "Become weaker, losing strength or intensity.",
                        "ru": "Становиться слабее, терять силу или интенсивность.",
                        "de": "An Kraft oder Intensität verlieren und schwächer werden.",
                        "es": "Volverse más débil y perder fuerza o intensidad.",
                        "zh": "逐渐变弱，失去力量或强度。"
                    },
