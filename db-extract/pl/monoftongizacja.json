                    {
                        "translation_id": "bc5b4005-10a8-46f1-8c77-136e9db22115",
                        "source_entry_id": "1725dd46-13fa-3055-a3fa-e027372de2f5",
                        "source_sense_id": "6fbf2ffc-a3df-324c-bdd3-1ffb2ef532d6",
                        "target_lang_word": "Monophthongierung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Monophthongierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                        "entry_id": "1c40bf20-a6bf-3623-a20e-eee0b104cab7",
                                        "glosses": [
                                            "Ersetzung eines Diphthongs durch einen Monophthong"
                                        ],
                                        "tags": [
                                            "historische Linguistik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "114b97c3-57b5-4ea1-91dc-2d444ff97dff",
                                                "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                                "text": "Durch Monophthongierung wurde im Deutschen aus dem mittelhochdeutschen Wort \"fuoz\" das neuhochdeutsche \"Fuß\"."
                                            },
                                            {
                                                "example_id": "2e326d90-e138-45ae-854e-ff928a783fb7",
                                                "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                                "text": "„Die Monophthongierung ergibt sich durch reziproke Assimilation der Diphthongteile…“"
                                            },
                                            {
                                                "example_id": "96b315c7-dbca-4069-8e9c-37869a68b4f0",
                                                "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                                "text": "„Der Zeitpunkt dieser Monophthongierung ist noch nicht eindeutig geklärt…“"
                                            },
                                            {
                                                "example_id": "d49d425a-97b1-4d4e-9b53-52525fec318f",
                                                "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                                "text": "„Mehr oder weniger die gleichen Monophthongierungen haben auch in verschiedenen mittel- und oberdeutschen Dialekten stattgefunden."
                                            },
                                            {
                                                "example_id": "8917cdd3-2c5d-4a87-af93-84966e8b1fde",
                                                "sense_id": "b871248e-bce5-3894-afc9-ea0dd1a61151",
                                                "text": "„Falls diese These zutrifft, galt im Mitteldeutschen für die Übergangszeit zwischen Monophthongierung und Diphthongierung folgendes System der langen Vokale: ….“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
