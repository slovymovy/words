                                        "entry_id": "aa1caf64-f64c-3489-bc66-3d1e0936a7d0",
                                        "glosses": [
                                            "Mode de fécondation de nombreuses espèces animales et végétales, consistant en un unique processus d'union entre deux cellules différentes, un gamète femelle, oosphère immobile et un gamète mâle, spermatozoïde mobile flagellé et comprenant surtout un noyau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48505f58-cd50-4c95-b73d-6b8526722cb9",
                                                "sense_id": "9e769acf-c04a-3188-8fc4-6d46b76d9f1b",
                                                "text": "La zoïdogamie est un cas d’oogamie où le gamète mâle est libéré dans le milieu aquatique extérieur et se déplace par lui-même."
                                            }
                                        ]
                                    }
