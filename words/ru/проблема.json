    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0ae10416-d193-3269-89dd-e21bac4d3977",
                    "sense_definition": "Неприятная ситуация, трудность или препятствие, которые необходимо преодолеть.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У меня возникла небольшая <w>проблема</w> с двигателем машины.",
                            "target_lang_translations": {
                                "en": "I had a small <w>problem</w> with the car engine.",
                                "zh": "我的汽车引擎出了点小<w>问题</w>。"
                            }
                        },
                        {
                            "text": "Мы должны быстро решить эту <w>проблему</w>, чтобы продолжить работу.",
                            "target_lang_translations": {
                                "en": "We must quickly solve this <w>problem</w> to continue working.",
                                "zh": "我们必须尽快解决这个<w>问题</w>，以便继续工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "тру́дность",
                        "затрудне́ние",
                        "препя́тствие",
                        "сложность"
                    ],
                    "common_phrases": [
                        "нет проблем",
                        "решить проблему",
                        "создать проблему",
                        "большие проблемы"
                    ],
                    "target_lang_definitions": {
                        "en": "An unpleasant situation, difficulty, or obstacle that needs to be overcome.",
                        "zh": "指需要克服的不愉快的情况、困难或障碍。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "problem",
                                "target_lang_sense_clarification": "difficulty to be resolved"
                            },
                            {
