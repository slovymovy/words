                    {
                        "translation_id": "ce2812ad-68aa-4a04-9a31-1027e1d3c798",
                        "source_entry_id": "78118a0c-e76c-356c-9a20-2a6ffe089e43",
                        "source_sense_id": "d9607547-8056-3f2d-a1a2-832cc305e160",
