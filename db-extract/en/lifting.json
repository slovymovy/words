                                "target_senses": [
                                    {
                                        "sense_id": "156a5c44-97c8-3e5c-9898-5c71ad171be6",
                                        "entry_id": "5971dc34-d3e1-3893-bf81-67f7641f65a4",
                                        "glosses": [
                                            "Opération de chirurgie esthétique destinée à retendre la peau. Lissage ou remodelage sont recommandés à la place de cet anglicisme."
                                        ],
                                        "tags": [
                                            "Faux anglicisme"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "46d6f13b-65ad-4e08-8a48-75c1c6d05919",
                                                "sense_id": "156a5c44-97c8-3e5c-9898-5c71ad171be6",
                                                "text": "Depuis son lifting elle arbore constamment une espèce de sourire crispé qui me met mal à l’aise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                                        "entry_id": "5971dc34-d3e1-3893-bf81-67f7641f65a4",
                                        "glosses": [
                                            "Opération de réarrangement ou modification superficielle d’une chose."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47845ae2-2419-4f08-848f-7ac07179fd96",
                                                "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                                                "text": "Je portais toujours cet imperméable. Les effets du petit coup de lifting que j’avais essayé de lui donner s’étaient, depuis longtemps, dissipés."
                                            },
                                            {
                                                "example_id": "f4d4f525-1504-4de6-8d9f-18e5c82d2924",
                                                "sense_id": "df3400d6-2be7-32c4-b5ad-158b345aa123",
                                                "text": "Tels George Lucas sur la première trilogie Star Wars, ses producteurs se sont permis un lifting à coups d'effets spéciaux de synthèse pas très réussis, glissant des vaisseaux à rayons laser fluos ici, des kaméhaméhas translucides là, n’ajoutant qu’une couche de nanardise supplémentaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
