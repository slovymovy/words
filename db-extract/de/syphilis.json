                ],
                "senses": [
                    {
                        "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                        "entry_id": "5f14f544-4100-3db8-8813-4afa0ac24e8c",
                        "glosses": [
                            "eine ansteckende Geschlechtskrankheit, die von Bakterien (Treponema pallidum) verursacht und zwischen Menschen über die Schleimhäute übertragen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d60607d-a88b-4ebd-8312-48be6c75655b",
                                "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                                "text": "Durch die Anwendung von Kondomen beim Geschlechtsverkehr kann die Übertragungswahrscheinlichkeit der Syphilis wesentlich verringert werden."
                            },
                            {
                                "example_id": "2392a7fa-d6dd-4a30-bbea-a08eef7e417d",
                                "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                                "text": "„Die Schuldgefühle, die den Komponisten wegen seiner Syphilis beschwerten, nagten an ihm.“"
                            },
                            {
                                "example_id": "24b17a9f-23c9-4a6b-822b-25c01de9bd80",
                                "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                                "text": "„Wahrscheinlich infizierte ihr Mann sie bald nach der Hochzeit mit Syphilis.“"
                            },
                            {
                                "example_id": "e48ae739-bebc-47d7-812a-9d832b2987de",
                                "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                                "text": "„In den Arbeiterbezirken vieler Städte herrschten grauenhafte Zustände; Alkoholismus, Typhus, Tuberkulose und Syphilis grassierten.“"
                            },
                            {
                                "example_id": "bdf8285b-be0a-4576-b49b-61f3864263e2",
                                "sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
                                "text": "„Der Baron selbst hat jedoch nichts mehr davon; er stirbt bereits 1962 mit 64 Jahren geistig umnachtet an der Syphilis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "027cfb06-6db9-4543-a17c-5e3b7f58b8cf",
                        "source_entry_id": "5f14f544-4100-3db8-8813-4afa0ac24e8c",
                        "source_sense_id": "dea9d884-d1c7-3d68-ab01-914a45500818",
