                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a8a0b844-a3cc-3a80-83e6-936f10b92dfb",
                        "entry_id": "114176dd-a6c4-3cf5-b88f-10fde73c4342",
                        "glosses": [
