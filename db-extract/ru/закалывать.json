                        "examples": [
                            {
                                "example_id": "735063c8-5744-4dd7-b877-97fd2c85970e",
                                "sense_id": "f6bfb014-eb45-38ec-b431-22108a8983c0",
                                "text": "В кишлаках наших солдат вилами деревянными закалывали…"
                            },
                            {
                                "example_id": "df5cb985-20bc-403a-a87d-b47fa1407f89",
                                "sense_id": "f6bfb014-eb45-38ec-b431-22108a8983c0",
                                "text": "И на острове совершались жертвоприношения ― на огромном камне закалывали коней."
                            },
                            {
                                "example_id": "49087e14-d315-4b36-9a8e-527c99a1cf59",
                                "sense_id": "f6bfb014-eb45-38ec-b431-22108a8983c0",
                                "text": "Раненых офицеров закалывали штыками."
                            }
                        ]
                    }
