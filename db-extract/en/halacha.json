                                        "sense_id": "bf6c31f4-797d-3771-916e-0affd6e36dcb",
                                        "entry_id": "249f5e71-2871-3fda-9aec-477b05f6f760",
                                        "glosses": [
                                            "nella religione ebraica, l'insieme delle rivelazioni dottrinali codificate in un corpo di Scritture"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2dfc4c99-e0a6-4043-89e0-6cec71e03b84",
                                                "sense_id": "bf6c31f4-797d-3771-916e-0affd6e36dcb",
                                                "text": "\"Inizialmente sono stati creati i cieli, successivamente la Terra... poi questa ha completato il cielo: questa è un'Halakhah definitiva\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c094f19-85b6-3da4-8870-f727c92c5423",
                                        "entry_id": "249f5e71-2871-3fda-9aec-477b05f6f760",
                                        "glosses": [
                                            "i dettagli nell'osservanza religiosa dei devoti ebrei"
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "134717cd-bedb-41f8-9a4f-02fb28769440",
                                                "sense_id": "0c094f19-85b6-3da4-8870-f727c92c5423",
                                                "text": "secondo l'Halakhah agli ebrei è proibito anche mescolare e mangiare latte e carne assieme"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
