            {
                "entry_id": "d4339116-7355-376f-a20c-8de99db5432b",
                "word": "Candie",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "74d207f1-95b1-3a79-802e-50c43e7b2afc",
                        "entry_id": "d4339116-7355-376f-a20c-8de99db5432b",
                        "glosses": [
                            "Nom d’Héraklion dans un contexte arabe ou turc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45991629-17d0-489c-add8-15adb56240f5",
                                "sense_id": "74d207f1-95b1-3a79-802e-50c43e7b2afc",
                                "text": "Doménikos vient de la Crète, de Candie plus exactement, aujourd’hui Héraklion, une ville portuaire au cœur de la Méditerranée sous domination vénitienne depuis le XIIIᵉ siècle."
                            }
                        ]
                    },
                    {
                        "sense_id": "9d9bd6d2-f3a0-3780-bf84-730ae5b2f028",
                        "entry_id": "d4339116-7355-376f-a20c-8de99db5432b",
                        "glosses": [
                            "Ancien nom de la Crète."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1711ba99-624f-4b1d-afa2-ecb7dda5b3fd",
                                "sense_id": "9d9bd6d2-f3a0-3780-bf84-730ae5b2f028",
                                "text": "Sept jours s’étaient déjà écoulés depuis notre départ de Malte, aucune terre n’avait depuis cette époque frapé [sic] notre vue, lorsque le 8 messidor à la pointe du jour nous découvrîmes dans le lointain la pointe de l’isle de Candie ; ..."
                            },
                            {
                                "example_id": "19c69908-43fc-4bd7-b7ec-8bca4cfe6a18",
                                "sense_id": "9d9bd6d2-f3a0-3780-bf84-730ae5b2f028",
                                "text": "Duché de Candie, la Crète."
                            },
                            {
                                "example_id": "728d3599-352a-408b-843f-6d8f23236af6",
                                "sense_id": "9d9bd6d2-f3a0-3780-bf84-730ae5b2f028",
                                "text": "Les Anciens estimoient fort le seseli de Candie, d’Ethyopie & du Péloponese."
                            }
                        ]
                    }
                ],
