                "senses": [
                    {
                        "sense_id": "c1b9707b-2a41-3c35-9b4d-6ef812409c31",
                        "entry_id": "148fb71f-984a-395c-a342-466244c3a78b",
                        "glosses": [
                            "Artisan qui pose des antennes."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "3c116056-e065-457f-8eb3-072409cd98c5",
                                "sense_id": "c1b9707b-2a41-3c35-9b4d-6ef812409c31",
                                "text": "Pour un antenniste qui, du matin au soir, est baigné dans ce champ, ce rêve devient de jour en jour une hantise, voire une obsession."
                            },
                            {
                                "example_id": "8f93fae4-ed0a-47c7-8918-cffc78407301",
                                "sense_id": "c1b9707b-2a41-3c35-9b4d-6ef812409c31",
                                "text": "Fred est l’antenniste attitré de la Scic — qu’il préside — et Alan en est l’unique salarié. Revêtus de leurs gilets jaunes, les deux techniciens raccordent la demeure de Marc à la fameuse fibre de verre."
                            }
                        ]
                    },
                    {
                        "sense_id": "d837756d-d402-3963-a8a0-2203f959a8e4",
                        "entry_id": "148fb71f-984a-395c-a342-466244c3a78b",
                        "glosses": [
                            "Ingénieur ou ingénieure qui conçoit des antennes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57a35169-8383-4481-bc9e-87d919e52c58",
                                "sense_id": "d837756d-d402-3963-a8a0-2203f959a8e4",
                                "text": "Les antennistes se sont également tournés vers ces nouveaux outils pour satisfaire le besoin d’antennes de plus en plus complexes et de plus en plus difficiles à réaliser : antennes miniatures, antennes multi-bandes, antennes reconfigurables, etc."
                            }
                        ]
                    }
