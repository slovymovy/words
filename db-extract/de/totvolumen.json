                ],
                "senses": [
                    {
                        "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                        "entry_id": "0cef2be6-a90f-3b0b-aa95-c457bf56672e",
                        "glosses": [
                            "verbleibender, nicht erwünschter Rauminhalt (Volumen) in Maschinen, Vorrichtungen oder Geräten, die mit einem Medium (einer Flüssigkeit oder Gasen) arbeiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e21281c-5bf8-4097-a460-16523ad88222",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Die Kapillare erfüllen den Zweck, daß Totvolumen der Spritzen zu verkleinern.“"
                            },
                            {
                                "example_id": "911e094f-1bba-4d40-a0d5-190d00aaebcc",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Aufgrund der hydrophilen äußeren Oberfläche werden ausgeschlossene Bestandteile minimal verzögert und erscheinen im Waschschritt im Totvolumen der Säule.“"
                            },
                            {
                                "example_id": "c49321e6-1761-4d4e-806f-ac356a570e4c",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Das Ventil besitzt aufgrund seiner Bauweise praktisch kein Totvolumen und kann bis zu einer Temperatur von 70°C eingesetzt werden.“"
                            },
                            {
                                "example_id": "d0db797f-ecdb-48a2-a337-a431b10818d9",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Ferner haben diese Spritzen ein großes Totvolumen mit einem hohen Memory-Effekt bei Proben wechselnder Zusammensetzung.“"
                            },
                            {
                                "example_id": "3145c60e-17ec-48e3-ae42-6b01a194a4ba",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Zur Verringerung der Verluste durch Totvolumina und durch Anhaften an den Gefäßwänden ist in solchen Fällen die Messung von Lösungen auch dann vorzuziehen, wenn es sich um niedrigviskose Flüssigkeiten handelt.“"
                            },
                            {
                                "example_id": "b7e2f2cb-6281-4c31-9591-5ebed844865c",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Dieser Weg ist etwas umständlich und bewirkt auch eine Zunahme des Totvolumens der Pumpe.“"
                            },
                            {
                                "example_id": "9fef7f7e-bd35-4fbd-9e0a-931fabdf9128",
                                "sense_id": "512e5a23-a1ba-3f21-b363-1d9ddb78af61",
                                "text": "„Ein kleines Totvolumen ist in der Mikropumpe erwünscht, weil im Fall eines Luftbläschens die fluidische Kapazität klein gehalten wird und keinen wesentlichen Einfluss auf die Pumpwirkung hat […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
