                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f66d121b-6b4c-4c38-85ee-cb6e64a44467",
                        "entry_id": "196a0d19-b077-3fc9-ba15-0adc4b6cda7e",
                        "tags": [
                            "plural"
