                        ]
                    },
                    {
                        "translation_id": "a719cba7-9160-4c14-82b0-9c9071017ad5",
                        "source_entry_id": "ef7cbd9d-524c-386c-917e-d756d897c13b",
                        "source_sense_id": "c3b7ad95-a210-39dc-bf92-9edb54072dfd",
                        "source_sense_description": "tot de planten behorend, uit planten bestaand of daarvan afkomstig",
                        "target_lang_word": "végétal",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "végétal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c92996dc-11c4-306c-ac37-0b6937caab67",
                                        "entry_id": "c8715133-023e-3024-8874-1d708cd76200",
                                        "glosses": [
                                            "Relatif à ce qui pousse, à la végétation, aux plantes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e4870ba-0b7c-4c01-af54-60e3baf4ee59",
                                                "sense_id": "c92996dc-11c4-306c-ac37-0b6937caab67",
                                                "text": "Quand on sème une plante pour l’enterrer, on doit se souvenir que le but n’est pas la production granifère, mais la production de la masse la plus considérable possible de matière végétale."
                                            },
                                            {
                                                "example_id": "354109a9-5488-43e7-91ee-31ed52d9697c",
                                                "sense_id": "c92996dc-11c4-306c-ac37-0b6937caab67",
                                                "text": "On verse sur le tas ou dans le composteur tous les déchets végétaux du jardin en évitant le branchage d'un trop gros diamètre."
                                            },
                                            {
                                                "example_id": "789a96db-07f2-4e44-a894-c0860da57713",
                                                "sense_id": "c92996dc-11c4-306c-ac37-0b6937caab67",
                                                "text": "Les chancels, barrières basses qui séparent le chœur de la nef, reçoivent des ornements sculptés où la croix entrelacée de motifs végétaux évoquant la vie tient une place de choix."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a85b0b7c-77d1-3ada-be75-42f1f2eb3737",
                                        "entry_id": "c8715133-023e-3024-8874-1d708cd76200",
                                        "glosses": [
                                            "Fabriqué sans produits animaux et destiné à l’alimentation végan."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4cd78b9-85ca-49e8-ab38-0d5a00b0be75",
                                                "sense_id": "a85b0b7c-77d1-3ada-be75-42f1f2eb3737",
                                                "text": "À l’instar de la viande ou du poisson végétal (y compris les crustacés), le simili-œuf, encore à l’état de prototype, est le fruit d’une poignée de starts-up de la food tech."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "végétal",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6deccbf2-d988-3174-a0bf-74e849920ec7",
                                        "entry_id": "725687eb-ac80-3a34-92c3-1abcc1f9b539",
                                        "glosses": [
                                            "Être vivant pluricellulaire, organisme autotrophe capable de synthétiser les composants organiques à partir de sels minéraux puisés dans le sol et d’énergie solaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "815de25b-0abd-4ce1-8456-aafe7dd0ebc0",
                                                "sense_id": "6deccbf2-d988-3174-a0bf-74e849920ec7",
                                                "text": "Trembley trouvait donc ici deux grands phénomènes, jusque-là regardés comme appartenant exclusivement aux végétaux, la reproduction par boutures et la multiplication par bourgeons."
                                            },
                                            {
                                                "example_id": "920ea2c7-d51e-47c2-ad62-78e3546ebd44",
                                                "sense_id": "6deccbf2-d988-3174-a0bf-74e849920ec7",
                                                "text": "Dans les Pyrénées, la présence de végétaux propéméditerranéens est très fréquente le long des chaînons calcaires du Planturel et vers les Petites Pyrénées."
                                            },
                                            {
                                                "example_id": "4f59259f-752b-4913-9b5e-1f92a7f1a588",
                                                "sense_id": "6deccbf2-d988-3174-a0bf-74e849920ec7",
                                                "text": "Après Prévost, il faudra attendre près de 50 ans encore et traverser les terribles famines d’Irlande pour que l'on reconnaisse enfin de façon irréfutable que les champignons vivants peuvent être la cause de maladies chez les végétaux."
                                            },
                                            {
                                                "example_id": "6cbffc45-278e-4011-8d61-ce006c285b04",
                                                "sense_id": "6deccbf2-d988-3174-a0bf-74e849920ec7",
                                                "text": "Le végétal est-il l’avenir du steak?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5447da22-b621-349a-8389-da1ed5f5e171",
                                        "entry_id": "725687eb-ac80-3a34-92c3-1abcc1f9b539",
                                        "glosses": [
                                            "Un des cinq règnes de la vie regroupant des êtres pluricellulaires réalisant la photosynthèse."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44799a50-1a08-4986-8b95-a573bba7dd93",
                                                "sense_id": "5447da22-b621-349a-8389-da1ed5f5e171",
                                                "text": "Le règne des végétaux."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
