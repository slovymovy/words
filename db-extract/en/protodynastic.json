                                        "examples": [
                                            {
                                                "example_id": "4426ec72-114c-4cc2-adc4-b6d89a691b53",
                                                "sense_id": "cfa61aff-49ce-38c8-97d2-bf6640f5f152",
                                                "text": "„Sumer bestand während der frühdynastischen Zeit (2750–2350 v. Chr.) aus einzelnen Stadtstaaten geringer räumlicher Entfernung […], die von Fürsten (zugleich Oberpriester des Stadtgotts und oberste Gerichtsherren) regiert wurden.“"
                                            },
                                            {
                                                "example_id": "318715fe-a6e7-4e2a-a4f8-4d6b19c870c9",
                                                "sense_id": "cfa61aff-49ce-38c8-97d2-bf6640f5f152",
                                                "text": "„Archäologisch spiegelt sich die Bedeutung des Krieges [um landwirtschaftliche Nutzfläche] darin wider, daß die südmesopotamischen Städte in der frühdynastischen Zeit ummauert wurden“"
                                            },
                                            {
                                                "example_id": "f976fc0b-ad31-41a0-b988-8fce2c5ea9b9",
                                                "sense_id": "cfa61aff-49ce-38c8-97d2-bf6640f5f152",
                                                "text": "„In der Glyptik kann man den Übergang von der frühsumerischen zur frühdynastischen Kunst am besten verfolgen. […] Daß in einer Anzahl von Gräbern Rollsiegel gefunden worden sind, zeigt, daß sie in der frühdynastischen Zeit zur persönlichen Ausstattung gehören konnten.“"
                                            }
                                        ],
