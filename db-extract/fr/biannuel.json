                ],
                "senses": [
                    {
                        "sense_id": "035283c0-0f41-36c4-97ce-566ccf8d5e34",
                        "entry_id": "bbb1ebce-2f21-3301-b7d9-eba5cfca0d71",
                        "glosses": [
                            "Qualifie un événement qui se produit une fois tous les deux ans."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc0fc166-f96d-4873-9103-a01448929bbe",
                                "sense_id": "035283c0-0f41-36c4-97ce-566ccf8d5e34",
                                "text": "En 2009, L'USPSTF a fait un second changement dans ses recommandations en cautionnant un dépistage biannuel chez les femmes de 50 à 74 ans. Elle a déclaré que le passage d'un dépistage annuel à un dépistage biannuel réduirait de moitié les effets nocifs du dépistage par mammographie."
                            },
                            {
                                "example_id": "8f6d2b7c-6170-4812-ae2b-59b895e0a050",
                                "sense_id": "035283c0-0f41-36c4-97ce-566ccf8d5e34",
                                "text": "Le rythme biannuel des naissances s'explique probablement par la pratique de l'allaitement des nourrissons, qui rend momentanément stériles les trois quarts des femmes, et qui ralentit la fréquence des conceptions."
                            },
                            {
                                "example_id": "86c1a466-da88-4715-bc27-ee0ea32ee45d",
                                "sense_id": "035283c0-0f41-36c4-97ce-566ccf8d5e34",
                                "text": "Les chiffres concernant l'Afrique du Sud représentent les transitions biannuelles calculées sur la période 2010-12."
                            }
                        ]
                    },
                    {
                        "sense_id": "e7488275-c601-36ce-b73e-fa96824edf84",
                        "entry_id": "bbb1ebce-2f21-3301-b7d9-eba5cfca0d71",
                        "glosses": [
                            "Qualifie un événement qui se produit deux fois par an."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a559377-fbb9-42c6-9893-28f96f36929a",
                                "sense_id": "e7488275-c601-36ce-b73e-fa96824edf84",
                                "text": "Nka est une publication biannuelle fondée en 1994."
                            },
                            {
                                "example_id": "28b6f999-6762-4f55-a6f3-1b6499872121",
                                "sense_id": "e7488275-c601-36ce-b73e-fa96824edf84",
                                "text": "En 2009, L'USPSTF a fait un second changement dans ses recommandations en cautionnant un dépistage biannuel chez les femmes de 50 à 74 ans. Elle a déclaré que le passage d'un dépistage annuel à un dépistage biannuel réduirait de moitié les effets nocifs du dépistage\npar mammographie. — (Peter G. Sziagyi & Lynn S. Bickley, Guide de l'examen clinique, traduit par Paul Babinet & Jean-Marc Retbi, Montrouge : Arnette, 2014, chap.10, page 426)"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47a47660-9592-4972-bc97-9cfdee5bb346",
                        "source_entry_id": "bbb1ebce-2f21-3301-b7d9-eba5cfca0d71",
                        "source_sense_id": "035283c0-0f41-36c4-97ce-566ccf8d5e34",
                        "source_sense_description": "Tous les deux ans",
                        "target_lang_word": "biennial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biennial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6e41be5a-fa3c-38d7-b863-0492f7cf5dee",
                                        "entry_id": "c4473b19-cef6-32c4-951f-9f9a9f7dd9d7",
                                        "glosses": [
                                            "Happening every two years."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30a3a983-0e0b-42ae-8ee9-126b44cee2f9",
                                                "sense_id": "6e41be5a-fa3c-38d7-b863-0492f7cf5dee",
                                                "text": "This is a marked difference from the task force’s previous guidance, which was to start biennial mammograms by age 50."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a7a944e-1c1e-33ca-8746-1572bade1fb8",
                                        "entry_id": "c4473b19-cef6-32c4-951f-9f9a9f7dd9d7",
                                        "glosses": [
                                            "Lasting for two years."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "biennial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9e0fde92-7ec6-3465-a62a-f373d25be448",
                                        "entry_id": "4698b06d-9d8c-35c5-a279-370a83179d16",
                                        "glosses": [
                                            "A plant that requires two years to complete its life-cycle, germinating and growing in its first year, then producing its flowers and fruit in its second year, after which it usually dies."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a23afe06-d5ae-365e-a834-45ed03b02b18",
                                        "entry_id": "4698b06d-9d8c-35c5-a279-370a83179d16",
                                        "glosses": [
                                            "An event that happens every two years."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c358c834-9457-4468-b189-54c3960c8e17",
                                                "sense_id": "a23afe06-d5ae-365e-a834-45ed03b02b18",
                                                "text": "The famous Biennial was won by Earl of Dartrey, a light, peacocky horse, who was, perhaps, better than he looked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "81306bf6-2e42-445d-ba57-b0b99419b677",
