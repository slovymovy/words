                                "target_senses": [
                                    {
                                        "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                                        "entry_id": "0b0f1c42-2009-3e6c-9be8-0bea5137f889",
                                        "glosses": [
                                            "Qui est banni, interdit de séjour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83cd3c2-5ee8-49bb-a5a9-5c699dc82dc3",
                                                "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                                                "text": "Insulteurs des foules proscrites,\nQui chantez au bruit des écus,\nCachez vos lyres hypocrites :\nNous sommes avec les vaincus!"
                                            },
                                            {
                                                "example_id": "afc70a20-5698-471f-91b7-4484a019deaa",
                                                "sense_id": "ed104313-e383-3294-ae2b-176157934254",
                                                "text": "La Belgique est le troisième pays qui possède, au lendemain de mai 1871, une nombreuse colonie de communards proscrits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                                        "entry_id": "0b0f1c42-2009-3e6c-9be8-0bea5137f889",
                                        "glosses": [
                                            "Qui est banni, écarté de l’usage."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c39c1026-c54a-4e6e-a3b2-e76a71e8f4dd",
                                                "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                                                "text": "Ce mot est proscrit."
                                            },
                                            {
                                                "example_id": "1cb8de8d-3fc1-4255-b0bb-e40fd7bd05e8",
                                                "sense_id": "6a26a801-1db7-3390-8ab7-d2504712ccfa",
                                                "text": "Cette façon d’agir est proscrite."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proscrit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1fbde5a5-689b-38ae-9b71-c17f2481748d",
                                        "entry_id": "ba5bc7d7-9567-3734-83a9-b737bf80faa7",
                                        "glosses": [
                                            "Personne bannie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967e0c8b-3779-4d1e-9b05-88e0a2f7f4ad",
                                                "sense_id": "1fbde5a5-689b-38ae-9b71-c17f2481748d",
                                                "text": "Les proscrits avaient le droit d’emporter leurs biens meubles. Mais leurs biens de mainmorte (immeubles, champs, vignobles, caves greniers) furent décrétés propriété royale et confisqués."
                                            },
                                            {
                                                "example_id": "4ad7e280-ea9f-44ff-aae6-7a168d5ac176",
                                                "sense_id": "1fbde5a5-689b-38ae-9b71-c17f2481748d",
                                                "text": "On les agitait déjà dans une petite brochure abstentionniste publiée au commencement de 1876, à Genève, par des proscrits lyonnais."
                                            },
                                            {
                                                "example_id": "edffba8b-1aa7-49cb-bdc4-46a1e6d34393",
                                                "sense_id": "1fbde5a5-689b-38ae-9b71-c17f2481748d",
                                                "text": "Adieu, surtout à Toi, qui ne sais où reposer la tête, proscrit sublime."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "proscrit",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62e133a4-d7ed-3e32-a90c-115e3c0602b3",
                                        "entry_id": "d7e10e22-7239-3443-83d8-328b47f15639",
                                        "glosses": [
                                            "Participe passé masculin singulier de proscrire."
