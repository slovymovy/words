                ],
                "senses": [
                    {
                        "sense_id": "74ad39ff-6507-389f-8055-2cc132314111",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "записать себя в очередь на получение чего-либо, посещение чего-либо и т. п."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7014c8a-9d50-4e17-8846-e071c9b9851d",
                                "sense_id": "74ad39ff-6507-389f-8055-2cc132314111",
                                "text": "Записаться на приём к врачу."
                            }
                        ]
                    },
                    {
                        "sense_id": "5bab1247-d4ee-31da-b9b8-1c88cb92d0a9",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "вступить куда-либо, включиться в число кого-либо, внести себя в какой-либо список, реестр"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f65fa17-9b5b-4c7f-a98a-d6f08c88adc4",
                                "sense_id": "5bab1247-d4ee-31da-b9b8-1c88cb92d0a9",
                                "text": "записаться с Мариею, обрученною ему женою, которая была беременна."
                            }
                        ]
                    },
                    {
                        "sense_id": "c041ac2f-7a33-3e5f-b72f-c335f96b014f",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "перен. разг. причислить себя к кому-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01cefb3b-db6c-46e3-9948-8e92e9c4de6e",
                                "sense_id": "c041ac2f-7a33-3e5f-b72f-c335f96b014f",
                                "text": "Слышала последние новости? Он недавно записался в верующие! Невозможно поверить!"
                            }
                        ]
                    },
                    {
                        "sense_id": "896685c8-4fe7-33d8-b18d-0e91d450a273",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "записать свой звук или своё изображение на плёнку или на магнитную ленту"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46dced49-484b-43fd-9adf-8c7888316412",
                                "sense_id": "896685c8-4fe7-33d8-b18d-0e91d450a273",
                                "text": "Когда запишешься-то уже? Продюсер ждёт нас уже два часа."
                            }
                        ]
                    },
                    {
                        "sense_id": "49643b24-be44-3c3b-8193-94d4973ba61f",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "разг. слишком увлечься писанием; устать от долгого писания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d88307e9-b0e7-4eae-9333-69d028b1d2bf",
                                "sense_id": "49643b24-be44-3c3b-8193-94d4973ba61f",
                                "text": "Что-то я записался сегодня — пойду-ка отдохну."
                            }
                        ]
                    },
                    {
                        "sense_id": "7785acbf-2b01-35c1-8a8f-efff0b3188b1",
                        "entry_id": "196dd226-981c-318e-8cf8-c09205dd63d7",
                        "glosses": [
                            "страд. к записать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
