                ],
                "senses": [
                    {
                        "sense_id": "7631e018-f2d0-333e-a0ad-ef5a695c7ae2",
                        "entry_id": "484dcf99-2931-3f66-88be-a204c34ea745",
                        "glosses": [
                            "Habitant imaginaire de Lilliput."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "ea1e1aeb-6891-4049-bf75-9ded477ca633",
                                "sense_id": "7631e018-f2d0-333e-a0ad-ef5a695c7ae2",
                                "text": "La corbeille était si petite qu’elle ne pouvait assurément contenir qu’un enfant microscopique et phénoménal, un Lilliputien bon à montrer dans les foires."
                            },
                            {
                                "example_id": "e67d8e3b-aecf-433e-bf14-6fd47eae2b3f",
                                "sense_id": "7631e018-f2d0-333e-a0ad-ef5a695c7ae2",
                                "text": "En effet, d’après ce qui vient d’être dit, pour faire un pas, un Lilliputien n’a besoin que d’une seule des cent fibres de sa jambe."
                            },
                            {
                                "example_id": "0a8f95cc-7eca-4dcf-9f43-25132b6f0f34",
                                "sense_id": "7631e018-f2d0-333e-a0ad-ef5a695c7ae2",
                                "text": "Écartant les Lilliputiens du débat car présentant peu d’intérêt, il rappelle les points forts des Brobdingnagiens, des Laputiens et des Houyhnhnms, à savoir respectivement la force physique, la tactique stratégique, enfin l’intelligence, la cohésion, la bravoure et le patriotisme."
                            }
                        ]
                    }
                ],
