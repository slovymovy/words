                ],
                "senses": [
                    {
                        "sense_id": "4a92b5ec-440b-3b0f-a630-08767b0e3227",
                        "entry_id": "464190b7-9c2d-3c5b-bdb6-197700fdc196",
                        "glosses": [
                            "Relatif au monométallisme, à la circulation monétaire d’un seul étalon métallique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f40fbea7-6c13-4e3e-8b74-04b5bddcba31",
                                "sense_id": "4a92b5ec-440b-3b0f-a630-08767b0e3227",
                                "text": "L’empire britannique n’est ni monométalliste ni bimétalliste mais bi-monométalliste. Il ne peut être ni monométalliste or ni monométalliste argent d’un bout à l’autre de son étendue."
                            },
                            {
                                "example_id": "8421d2bd-deda-48bd-aa0e-a186d435379a",
                                "sense_id": "4a92b5ec-440b-3b0f-a630-08767b0e3227",
                                "text": "Entre un pays monométalliste or et un pays monométalliste argent, le change doit varier selon les cours des deux métaux sur le marché du monde."
                            },
                            {
                                "example_id": "353d2206-e663-476e-8076-426f5ac577a6",
                                "sense_id": "4a92b5ec-440b-3b0f-a630-08767b0e3227",
                                "text": "Mais, à ce point de vue, ce n’est pas un système monométalliste que les partisans de l’étalon unique d’or devraient réclamer."
                            }
                        ]
                    }
                ],
