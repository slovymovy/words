                                    {
                                        "sense_id": "a8fca7d0-7e02-3b22-9f71-8aeab5ab7e05",
                                        "entry_id": "8815b343-a1ee-3c65-ac0c-843caaaf176a",
                                        "glosses": [
                                            "Kasus in Ergativsprachen, der das Subjekt intransitiver Verben sowie das Objekt transitiver Verben markiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f664e248-68fa-4dc1-9ee3-10c4eacb9fa2",
                                                "sense_id": "a8fca7d0-7e02-3b22-9f71-8aeab5ab7e05",
                                                "text": "In einigen Sprachen gibt es einen Kasus Absolutiv, der im Gegensatz zum Ergativ steht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aea3e9ce-8ece-35a9-9885-093c4e38bac6",
                                        "entry_id": "8815b343-a1ee-3c65-ac0c-843caaaf176a",
                                        "glosses": [
                                            "Verbalsubstantiv in manchen indogermanischen Sprachen, das in einem erstarrten Kasus steht und die Handlung des Subjekts bezeichnet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b4f4e431-d22e-47f6-95bb-109a0fc3f28e",
                                                "sense_id": "aea3e9ce-8ece-35a9-9885-093c4e38bac6",
                                                "text": "Absolutiv ist nur eine der grammatischen Formen, die aus einem erstarrten Kasus entstanden sind."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
