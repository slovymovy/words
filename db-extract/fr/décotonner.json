                        "glosses": [
                            "Séparer les feuilles de tabac du tronc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27390e07-428d-4297-b812-45a411b66b20",
                                "sense_id": "e4e457fe-8c69-3d0c-8a8c-ac9512ab38b6",
                                "text": "On enlève alors délicatement les pieds pour les “ décotonner ”, c'est à dire, pour séparer les feuilles du tronc."
                            },
                            {
                                "example_id": "ee1cac5c-f6b0-4c04-aedd-b1ac7f6416d6",
                                "sense_id": "e4e457fe-8c69-3d0c-8a8c-ac9512ab38b6",
                                "text": "Elles se brûlaient les poumons à «décotonner» le tabac."
                            }
                        ]
