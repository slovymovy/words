                "senses": [
                    {
                        "sense_id": "011e18c5-7cd2-30c8-a1dd-6edb0f32cc72",
                        "entry_id": "57c88a3e-a97c-3de9-80bd-3a487bd46452",
                        "glosses": [
                            "Familienname, der ursprünglich von einer Berufsbezeichnung abgeleitet wurde"
                        ],
                        "tags": [
                            "Namensforschung"
                        ],
                        "examples": [
                            {
                                "example_id": "4c24c45a-d6d0-4cd9-8c92-dee5cf50789d",
                                "sense_id": "011e18c5-7cd2-30c8-a1dd-6edb0f32cc72",
                                "text": "Die indirekten Berufsnamen beziehen sich dann auf eine bestimmte Auffälligkeit an der Art, wie der Benannte seinen Beruf ausübt – diese Berufsnamen sind aber eher selten und zum anderen von einer anderen Gruppe der Familiennamensbildung (Familiennamen aus Übernamen) nur schwer zu unterscheiden."
                            },
                            {
                                "example_id": "2a3d4d66-cad2-4b8b-b8f3-e1ceebc9e680",
                                "sense_id": "011e18c5-7cd2-30c8-a1dd-6edb0f32cc72",
                                "text": "So ist der Familienname Beinhauer, wie Knochenhauer, ein Berufsname des Metzgers."
                            },
                            {
                                "example_id": "0513f141-2901-4a5e-b58e-24e0f4138499",
                                "sense_id": "011e18c5-7cd2-30c8-a1dd-6edb0f32cc72",
                                "text": "„Das gilt natürlich gleichermaßen auch für andere soziale Schichten und für Beinamen anderer Provenienz wie die Berufsnamen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "475524e7-9d4e-3e76-ba04-800618d99603",
                        "entry_id": "57c88a3e-a97c-3de9-80bd-3a487bd46452",
                        "glosses": [
                            "Name, der im Rahmen der Berufsausübung verwendet wird"
                        ],
                        "tags": [
                            "Namensrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "f5bab2c2-aa47-4c19-88c9-322174f82c24",
                                "sense_id": "475524e7-9d4e-3e76-ba04-800618d99603",
                                "text": "Bei Künstlern heißt dieser Berufsname Künstlername."
                            },
                            {
                                "example_id": "4a0442fe-2148-4297-b87e-1152fb3e1157",
                                "sense_id": "475524e7-9d4e-3e76-ba04-800618d99603",
                                "text": "Im Einklang mit dieser gesetzlichen Zielsetzung darf auch ein Berufsname allenfalls unter der Voraussetzung eingetragen werden, dass die Eintragung zur Feststellung der Identität des Ausweisinhabers erforderlich ist (VGH Mannheim, a.a.O.)."
                            },
                            {
                                "example_id": "fe5a8364-6a8a-4e31-9e9d-d545969f5e6a",
                                "sense_id": "475524e7-9d4e-3e76-ba04-800618d99603",
                                "text": "„Statt ihres bürgerlichen Namens tragen die Boten im Dienst Bezeichnungen wie Orca, Fux oder Laus. Auch Mex ist nur der Berufsname, aber jeder in der Rad-Community weiß, um wen es sich dreht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
