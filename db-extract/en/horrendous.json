                                        "entry_id": "486ab0f5-cda1-3466-9f6d-250b2d2bc88e",
                                        "glosses": [
                                            "deutlich mehr als normal (beispielsweise bei Preisen, Mieten, Zinsen)"
                                        ],
                                        "tags": [
                                            "Geld"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b1ec8aa1-1c51-4f52-80a9-374c5517e3be",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "In manchen Großstädten findet man horrende Preise bei Immobilien."
                                            },
                                            {
                                                "example_id": "0030b58c-bef4-4862-adb7-35946d2d9edc",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "„Die horrenden Mieten für die fünf Häuser liefen aber weiter.“"
                                            },
                                            {
                                                "example_id": "b2899b86-f7b1-4688-a79c-9860a8c7af63",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "So mussten […] die deutschen Häuser des Möbelhändlers Ikea über viele Jahre horrende Lizenzgebühren für die Nutzung des Firmennamens an eine Schwestergesellschaft im Ausland zahlen, die das Geld dann […] günstig versteuerte."
                                            },
                                            {
                                                "example_id": "ad097677-c64e-409c-886b-b8218520e845",
                                                "sense_id": "b7cb8d80-adc7-301e-99c3-3af58508a8f1",
                                                "text": "„Die Rechnung ist horrend.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
