{
    "word_family": [
        "amenability",
        "amenableness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "8635317b-c500-390d-81c8-4beebbd88e40",
                    "sense_definition": "Willing to respond to persuasion or suggestions.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "willingness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager was <w>amenable</w> to our suggestions for improving the office workflow.",
                            "target_lang_translations": {
                                "ru": "Менеджер был <w>сговорчив</w> в отношении наших предложений по улучшению рабочего процесса в офисе."
                            }
                        },
                        {
                            "text": "She is usually <w>amenable</w> to new ideas if you explain them clearly.",
                            "target_lang_translations": {
                                "ru": "Она обычно <w>покладиста</w> к новым идеям, если объяснить их понятно."
                            }
                        }
                    ],
                    "synonyms": [
                        "persuadable",
                        "agreeable"
                    ],
                    "antonyms": [
                        "unamenable"
                    ],
                    "common_phrases": [
                        "amenable to suggestions",
                        "amenable to change"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый прислушаться к убеждениям или предложениям, открытый для обсуждения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сговорчивый",
                                "target_lang_sense_clarification": "готовый идти на компромисс и договариваться"
                            },
                            {
                                "target_lang_word": "покладистый",
                                "target_lang_sense_clarification": "легкий в общении, не склонный к спорам"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ab4ac7a3-2b02-3a09-9d90-6e11e51716cd",
                    "sense_definition": "Willing to comply or easily led.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "willingness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team was <w>amenable</w> to the new rules set by the coach.",
                            "target_lang_translations": {
                                "ru": "Команда была <w>послушна</w> новым правилам, установленным тренером."
                            }
                        },
                        {
                            "text": "The animals were <w>amenable</w> to being moved into the larger enclosure.",
                            "target_lang_translations": {
                                "ru": "Животные <w>податливо</w> отреагировали на перемещение в вольер побольше."
                            }
                        }
                    ],
                    "synonyms": [
                        "compliant",
                        "complaisant"
                    ],
                    "common_phrases": [
                        "amenable to control"
                    ],
                    "target_lang_definitions": {
                        "ru": "Готовый подчиниться или легко поддающийся влиянию."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "податливый",
                                "target_lang_sense_clarification": "легко поддающийся чужому влиянию или воздействию"
                            },
                            {
                                "target_lang_word": "послушный",
                                "target_lang_sense_clarification": "готовый выполнять указания или правила"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54551863-f7c6-3ce0-902c-e5cc4e24aa89",
                    "sense_definition": "Liable to the legal authority or jurisdiction of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "accountability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "All citizens are <w>amenable</w> to the laws of the country.",
                            "target_lang_translations": {
                                "ru": "Все граждане <w>подсудны</w> законам страны."
                            }
                        },
                        {
                            "text": "The company is <w>amenable</w> to legal action if it violates the contract.",
                            "target_lang_translations": {
                                "ru": "Компания <w>несет юридическую ответственность</w> в случае нарушения контракта."
                            }
                        }
                    ],
                    "common_phrases": [
                        "amenable to law"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подлежащий юридической ответственности или юрисдикции чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подсудный",
                                "target_lang_sense_clarification": "подлежащий суду или юридическому разбирательству"
                            },
                            {
                                "target_lang_word": "ответственный",
                                "target_lang_sense_clarification": "несущий ответственность перед законом"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}