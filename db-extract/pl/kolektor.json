                ],
                "translations": [
                    {
                        "translation_id": "bf984125-cce3-4df5-bb03-10cfcb6d5f2e",
                        "source_entry_id": "4687675d-fc19-3ee7-a8b1-5f4e211e2b9a",
                        "source_sense_id": "b5a423cc-1dac-374b-ad0d-4d2aa25b81a3",
                        "target_lang_word": "коллектор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "коллектор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8f10272e-f46c-34b5-923f-1cc827dc565a",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "спец. лицо, которое собирает, заносит в опись и хранит какие-либо образцы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf88c758-a577-4587-83a4-896c3f4c1b43",
                                                "sense_id": "8f10272e-f46c-34b5-923f-1cc827dc565a",
                                                "text": "Кроме того, в качестве коллекторов в экспедицию были зачислены авторитетные учёные, интересовавшиеся проблемой."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "267adff1-a375-3669-9798-768d81f52ccb",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "спец. сотрудник агентства, специализирующегося на взыскании задолженности"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "744d664c-700d-45e5-a502-07fd515bd209",
                                                "sense_id": "267adff1-a375-3669-9798-768d81f52ccb",
                                                "text": "Коллекторское агентство приглашает на работу коллекторов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b163b353-26d8-3004-895f-a3f0397ee8a1",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "спец. учреждение, производящее сбор и распределение чего-либо для организаций и частных лиц"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c4dfe1f-d498-4514-91f0-3b31a5695d0d",
                                                "sense_id": "b163b353-26d8-3004-895f-a3f0397ee8a1",
                                                "text": "Единственная цель «Коллектора библейской книги» — снабжать верующих духовной пищей."
                                            },
                                            {
                                                "example_id": "9b965a19-e051-404b-929d-f62d006a5c26",
                                                "sense_id": "b163b353-26d8-3004-895f-a3f0397ee8a1",
                                                "text": "Коллектор заявок."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a78c22b-6766-3452-873a-fe87e682a40f",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "спец. трубопровод относительно большого поперечного сечения, в который поступают для дальнейшего продвижения и вывода газы и жидкости из примыкающих трубопроводов меньшего поперечного сечения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7033daba-3ace-4a52-8be0-d978b74f01b9",
                                                "sense_id": "8a78c22b-6766-3452-873a-fe87e682a40f",
                                                "text": "До сих пор в реку по четырём коллекторам стекает 12 процентов неочищенных канализационных вод из наших кухонь, ванн и туалетов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c935663d-93c2-3771-aa4b-cd0ca6795c7f",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "спец. подземная галерея для укладки кабелей или труб различного назначения"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b301a0a1-697f-4474-897e-492719854767",
                                                "sense_id": "c935663d-93c2-3771-aa4b-cd0ca6795c7f",
                                                "text": "Около 600 зданий в центре Москвы оказались обесточены вечером в понедельник из-за пожара в подземном коллекторе, где проходили четыре кабельные линии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f38d6d75-c61f-3227-822a-50c48aa1062c",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "техн. часть якоря электрической машины, состоящая из ряда расположенных по кругу изолированных друг от друга медных пластин"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73b473eb-a4f8-4d92-bc35-bbd06b294194",
                                                "sense_id": "f38d6d75-c61f-3227-822a-50c48aa1062c",
                                                "text": "Проточка ламелей коллектора якоря электродвигателя продлевает срок службы электрощёток."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91229e83-4856-338c-bc9d-ad73c3ca24a1",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "техн. электрод в электровакуумном приборе, принимающий основной поток электронов или ионов при электрическом разряде"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ba91866-ee0b-47d1-a808-506542d52620",
                                                "sense_id": "91229e83-4856-338c-bc9d-ad73c3ca24a1",
                                                "text": "Бомбардировка коллектора ионами приводит к появлению вторичных электронов, ток которых пропорционален коэффициенту ионно-электронной эмиссии."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e061976-b716-3ad6-b482-69d73b5d894b",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "техн. область транзистора, предназначенная главным образом для приёма носителей заряда из базы"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f110ec22-d295-4262-9f21-f56e879c9a45",
                                                "sense_id": "1e061976-b716-3ad6-b482-69d73b5d894b",
                                                "text": "Электронный поток из эмиттера в коллектор одинаков в любом сечении транзистора, а его величина зависит от процессов в базовой области."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "020de507-3f6d-31e9-894c-403e7f851b70",
                                        "entry_id": "4c1144ba-782a-31fa-826a-1adbf37d1796",
                                        "glosses": [
                                            "техн. название некоторых технических устройств"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83b504ac-542d-461a-b1e3-4ec2db36b8d7",
                                                "sense_id": "020de507-3f6d-31e9-894c-403e7f851b70",
                                                "text": "Выпускной коллектор двигателя внутреннего сгорания."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
