                "senses": [
                    {
                        "sense_id": "1b68efcd-6201-331c-bc82-210b79e7d0bd",
                        "entry_id": "90f70a01-78fd-3e3f-aa86-36f8cf09e336",
                        "glosses": [
                            "Herrschaft, die nur die Interessen des/der Herrschenden wahrnimmt, ohne Rücksicht auf Gesetze oder Menschenrechte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1368b329-3d84-4baa-8f5b-1aff809ed3a8",
                                "sense_id": "1b68efcd-6201-331c-bc82-210b79e7d0bd",
                                "text": "„Doch die Kommission tut ihm nicht den Gefallen: Sie sammelt von Hunderten Zeugen derart vernichtende Aussagen, dass Leopold die Willkürherrschaft im Kongo nicht mehr leugnen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e0c3832d-73e4-414a-ae1e-51bf7af99d65",
                        "source_entry_id": "90f70a01-78fd-3e3f-aa86-36f8cf09e336",
                        "source_sense_id": "1b68efcd-6201-331c-bc82-210b79e7d0bd",
                        "source_sense_description": "Herrschaft, die nur die Interessen des/der Herrschenden wahrnimmt",
                        "target_lang_word": "despotism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "despotism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                        "entry_id": "311c7ee9-321a-3f56-a3f8-65fd84b13b42",
                                        "glosses": [
                                            "Government by a despot or despots: rule by a singular authority, either a single person or a tight-knit group, which rules with absolute power, especially in a cruel and oppressive way."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa476a69-731c-4347-9eb5-a8b3c467e073",
                                                "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                                "text": "The iron hand of despotism has quenched the last spark of liberty; hunted down like a wild beast, I am watching an opportunity to fly my degraded and enslaved country."
                                            },
                                            {
                                                "example_id": "645f6371-385e-47ad-94e4-23b358c91ca2",
                                                "sense_id": "e00ae285-c115-32fd-a5ee-58da4f67efdd",
                                                "text": "But now events have proved that I was right because Khrushchev's grandchildren do live in freedom and the great question of our time: can they continue to live in freedom, or will they revert to the old, or a new despotism?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
