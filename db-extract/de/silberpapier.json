                ],
                "senses": [
                    {
                        "sense_id": "5b2a32b1-b5a5-3917-a472-ab26a5bfb3b6",
                        "entry_id": "ef861dbe-3f23-36bd-9822-fbd8d715b094",
                        "glosses": [
                            "papierdünne Folie aus Aluminium"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91bbddc3-7261-4012-8491-bb42918a5278",
                                "sense_id": "5b2a32b1-b5a5-3917-a472-ab26a5bfb3b6",
                                "text": "Die Wanderer machten eine Pause und holten ihre in Silberpapier eingewickelten Wurstbrötchen hervor."
                            },
                            {
                                "example_id": "24f4e1af-9c6c-4565-b21b-dbed31046bea",
                                "sense_id": "5b2a32b1-b5a5-3917-a472-ab26a5bfb3b6",
                                "text": "„Das Silberpapier stammt aus Zigarettenschachteln, die er von Onkel Willi und anderen ketterauchenden Verwandten, auch aus den nahen Gasthäusern erbettelt hat.“"
                            },
                            {
                                "example_id": "03e6b8ca-055b-42b8-90fe-781a5d986256",
                                "sense_id": "5b2a32b1-b5a5-3917-a472-ab26a5bfb3b6",
                                "text": "„Das Silberpapier, in das die Bonbons gewickelt waren, benutzte sie für ihre Collagen.“"
                            },
                            {
                                "example_id": "761ec760-9c51-4446-a86c-2a384964f521",
                                "sense_id": "5b2a32b1-b5a5-3917-a472-ab26a5bfb3b6",
                                "text": "„Er gab ihr eine mit schimmerndem Silberpapier und weißem Satinband verpackte Schachtel.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
