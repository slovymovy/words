                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d8c5be7-b9c2-4af9-939c-50424f69cd34",
                                                "sense_id": "5b2ad18f-2ae5-39af-a6a5-37755299bbb6",
                                                "text": "Die Kartäuser sind ein auf den heiligen Bruno von Köln zurückgehender Orden."
                                            },
                                            {
                                                "example_id": "945545db-10be-4599-8fb4-74ea4b7288fd",
                                                "sense_id": "5b2ad18f-2ae5-39af-a6a5-37755299bbb6",
                                                "text": "„Derart lobreiche Formulierungen erwecken den Eindruck, Balduin habe sich schon seit längerem für den Orden der Kartäuser entschieden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1a\""
                                    },
                                    {
                                        "sense_id": "fa97cab1-6c00-3ddd-94b6-134b3c0dfd55",
                                        "entry_id": "716e019c-72de-3e89-843c-93e56ae9f485",
