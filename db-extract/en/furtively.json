                                                "sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                                                "text": "Uczniowie ukradkiem spoglądali na zegarki."
                                            },
                                            {
                                                "example_id": "559ab90b-41d0-4827-a13c-0956530ca829",
                                                "sense_id": "1f72d4e8-7f25-39bb-9bf6-cc69c369ca60",
                                                "text": "Jego stukanie ukradkiem w telefon pod torbą było przezabawne."
                                            }
                                        ],
