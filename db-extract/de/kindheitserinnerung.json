                ],
                "senses": [
                    {
                        "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                        "entry_id": "6c22d3b1-0e31-3640-a8af-a2d603ce0f1d",
                        "glosses": [
                            "Erinnerung an Erlebnisse in der Kindheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d7ba33-6814-401e-b587-e946f8a1dc0e",
                                "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                                "text": "Julius hat seine Kindheitserinnerungen aufgeschrieben und veröffentlicht."
                            },
                            {
                                "example_id": "0840caa8-39e4-4dd7-b800-7e9301e16b53",
                                "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                                "text": "„Tóvó freute sich, dass der Besuch solch angenehme Kindheitserinnerungen auslöste.“"
                            },
                            {
                                "example_id": "0aa54096-41f3-4c6c-a64b-67941d71d2f3",
                                "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                                "text": "„Es beruht auf ihren Kindheitserinnerungen aus den Jahren um 1820.“"
                            },
                            {
                                "example_id": "f3580cd5-95b1-448b-b3d6-26987a5d413f",
                                "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                                "text": "„Über meine Familie weiß ich nichts außer dem, was mir meine eigenen Kindheitserinnerungen und die Berichte meiner Schwester verraten.“"
                            },
                            {
                                "example_id": "376e8653-e7d8-4ad7-ae97-30169cb2bddd",
                                "sense_id": "64fe21e1-13d6-302b-85ae-427e9e449abf",
                                "text": "„So viele von meinen Kindheitserinnerungen beruhten auf den Erzählungen meiner Eltern, hingegen ab von dem, was sie ausließen, und dem, was sie aufnahmen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
