                                            {
                                                "example_id": "8e08abbe-5673-4a3c-8fd5-d9466a7e832c",
                                                "sense_id": "cc6fcd7d-fa91-3e21-ba26-19cac2603f2d",
                                                "text": "Les informaticiens joueront un grand rôle dans la croyance selon laquelle le langage humain est réductible à de l'information, manipulable à merci pourvu qu'on dispose de la clef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca2057ac-c83e-3bac-b2e7-cc8967102f4b",
                                        "entry_id": "ed78d537-9c98-32bf-b6b6-cd5ca836ed98",
                                        "glosses": [
                                            "Qui peut être influencé et dirigé, instrumentalisé."
                                        ],
