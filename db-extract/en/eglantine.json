                    }
                ],
                "senses": [
                    {
                        "sense_id": "08da6221-67df-31bd-9ba2-2324144a9327",
                        "entry_id": "75582781-67c4-3402-b084-be9cf208d7ed",
                        "glosses": [
                            "A Eurasian rose (Rosa rubiginosa, syn. Rosa eglanteria), having prickly stems, fragrant leaves, pink flowers and red hips."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "348f9cf3-eb23-4791-a628-980573ca9e81",
                                "sense_id": "08da6221-67df-31bd-9ba2-2324144a9327",
                                "text": "Come down, we pray thee, ere the hot sun count / His dewy rosary on the eglantine."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d064d6b6-0848-437a-b449-d00e95c790bf",
                        "source_entry_id": "75582781-67c4-3402-b084-be9cf208d7ed",
                        "source_sense_id": "08da6221-67df-31bd-9ba2-2324144a9327",
                        "source_sense_description": "Rosa eglanteria",
                        "target_lang_word": "egelantier",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "egelantier",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "7153487b-317d-326f-89a3-8f6413b73e80",
                                        "entry_id": "a8b74768-274d-3ad6-9099-5dfb80eca66f",
                                        "glosses": [
                                            "Rosa rubiginosa roosachtige heester met stevige, hakig tot sikkelvormig gebogen stekels, beklierde, naar appels of wijn geurende blaadjes, witte tot felroze bloemen en scharlakenrode rozenbottels"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b392cfd-f2f5-4dd6-a1b3-feb3fb92f82e",
                        "source_entry_id": "75582781-67c4-3402-b084-be9cf208d7ed",
                        "source_sense_id": "08da6221-67df-31bd-9ba2-2324144a9327",
                        "source_sense_description": "Rosa eglanteria",
                        "target_lang_word": "églantier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "églantier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f37a44bb-9764-37fe-967c-85bb47c95492",
                                        "entry_id": "6fff7206-2df1-39bd-aa5c-6c2d030cbbef",
                                        "glosses": [
                                            "Rosier sauvage aux fruits oblongs, d’un rouge vif, renfermant des semences enveloppées de poils (→ voir gratte-cul)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b49e3c51-2c8e-4321-b681-c746665ca084",
                                                "sense_id": "f37a44bb-9764-37fe-967c-85bb47c95492",
                                                "text": "Oh ! qu’il est beau, voyez, tout couvert de ses roses, Dans l’humide vallon, qu’il est beau, l’églantier !"
                                            },
                                            {
                                                "example_id": "999dfbac-1e17-4bdc-9ca7-dc2399157a5c",
                                                "sense_id": "f37a44bb-9764-37fe-967c-85bb47c95492",
                                                "text": "Greffez les églantiers en écusson pour multiplier vos rosiers"
                                            },
                                            {
                                                "example_id": "91ed88c9-889a-4934-893b-41be3bcc58ca",
                                                "sense_id": "f37a44bb-9764-37fe-967c-85bb47c95492",
                                                "text": "« Ortie dioïque, vigne rouge, petite centaurée, baies d’églantier et... racines de... bardane ? »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71a761d0-5a97-3b88-a18a-0ad0d2fb0a94",
                                        "entry_id": "6fff7206-2df1-39bd-aa5c-6c2d030cbbef",
                                        "glosses": [
                                            "Désigne l’espèce Rosa canina, l’églantier des chiens."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e7de86a1-5293-43cf-955e-93db826ab9a8",
                        "source_entry_id": "75582781-67c4-3402-b084-be9cf208d7ed",
                        "source_sense_id": "08da6221-67df-31bd-9ba2-2324144a9327",
                        "source_sense_description": "Rosa eglanteria",
                        "target_lang_word": "églantine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "églantine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fb3b1a7-0995-3f94-8d99-d13ae3ea77f1",
                                        "entry_id": "51369672-92e7-3a0f-8e66-cb89124e089d",
                                        "glosses": [
                                            "Fleur de l’églantier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb3fd3e-f8b6-4014-b065-7007fcf6a086",
                                                "sense_id": "9fb3b1a7-0995-3f94-8d99-d13ae3ea77f1",
                                                "text": "Et l’églantine du ménestrel sera fanée, que fleurira toujours la giroflée, chaque printemps […]"
                                            },
                                            {
                                                "example_id": "c171da5e-cacb-4ba5-b994-63c3a6c596e4",
                                                "sense_id": "9fb3b1a7-0995-3f94-8d99-d13ae3ea77f1",
                                                "text": "C’étaient des regards doux et délicats comme les lotos bleus qui nagent sur les eaux, des expressions fugitives comme les faibles parfums de l’églantine, des mélancolies tendres comme le velours des mousses ; fleurs de deux belles âmes qui naissaient d’une terre riche, féconde, immuable."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
