                    {
                        "form_id": "3058ab99-296d-49f6-bf4c-7effc42823db",
                        "entry_id": "22aaf2b6-cd51-381c-a73c-b3d8da0860a1",
                        "tags": [
                            "positive",
                            "predicative",
                            "plural"
                        ],
                        "form": "sie sind handgeschnitzt"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c61b9364-12e0-3ef1-adcc-ff52aa194e8d",
                        "entry_id": "22aaf2b6-cd51-381c-a73c-b3d8da0860a1",
                        "glosses": [
                            "von einer Person eigenhändig durch Schnitzen angefertigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91933591-ab88-4714-9e66-46d76853ee3c",
                                "sense_id": "c61b9364-12e0-3ef1-adcc-ff52aa194e8d",
                                "text": "„Ich ziehe so würdevoll wie möglich das Klebeband ab, falte das Papier vorsichtig auseinander und finde darin den verschwundenen weißen Bauern, der zu dem handgeschnitzten Schachspiel meines Vaters gehört.“"
                            },
                            {
                                "example_id": "3118e474-859d-43d0-9371-8ec2b05231d4",
                                "sense_id": "c61b9364-12e0-3ef1-adcc-ff52aa194e8d",
                                "text": "„Auf dem Rückweg zum Hotel hielt Marsh in einem Laden in der Nähe der Via Veneto und kaufte sich einen handgeschnitzten Spazierstock.“"
                            },
                            {
                                "example_id": "cdf658a5-ea20-47a7-a0fb-29f42b3bda39",
                                "sense_id": "c61b9364-12e0-3ef1-adcc-ff52aa194e8d",
                                "text": "„Wenn glatter Stein und handgeschnitzte Vertäfelung Garanten verdienter Strafe wären, das Mitchell Courthouse und sein Schwesterbau auf der anderen Straßenseite - das alte Postgebäude, das nun als Courthouse East ebenfalls als Gerichtsgebäude dient - wäre das Allerheiligste jedes Gesetzeshüters von Baltimore.“"
                            },
                            {
