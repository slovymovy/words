                "senses": [
                    {
                        "sense_id": "8c9bc397-8fde-3115-864e-973422269deb",
                        "entry_id": "67c21d9b-9ae6-36cf-859e-658eda7ce4a1",
                        "glosses": [
                            "Qui ressent des courbatures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "513d1f3c-1fcb-454b-9cbf-6e3e9a2b21e2",
                                "sense_id": "8c9bc397-8fde-3115-864e-973422269deb",
                                "text": "Pendant les six premières semaines, elle criait la nuit en se retournant, courbaturée, les épaules meurtries"
                            },
                            {
                                "example_id": "ad979a1b-dddb-48b2-a3cc-8ff0574af47e",
                                "sense_id": "8c9bc397-8fde-3115-864e-973422269deb",
                                "text": "Courbaturée, prise de vertiges, elle retombait toutes les cinq minutes dans le sommeil et il finit par y sombrer aussi."
                            },
                            {
                                "example_id": "32ad3aec-0f54-4ff4-a2d4-18ac2d279f4e",
                                "sense_id": "8c9bc397-8fde-3115-864e-973422269deb",
                                "text": "J’étais courbaturé, fiévreux. J'aurais voulu me recoucher. Mais j’avais à faire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
