                    "sense_id": "c2e002e1-736f-387c-8b74-80a9e9c5f412",
                    "sense_definition": "A substance found in the body that prevents blood from clotting, often used as a medication to treat blood clots.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "medical_substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor prescribed <w>heparin</w> to prevent the formation of dangerous blood clots after the surgery.",
                            "target_lang_translations": {
                                "zh": "医生开了<w>肝素</w>，以防止术后形成危险的血栓。"
                            }
                        },
                        {
                            "text": "Patients receiving <w>heparin</w> therapy must be monitored closely for any signs of internal bleeding.",
                            "target_lang_translations": {
                                "zh": "接受<w>肝素</w>治疗的患者必须受到密切监测，以防出现任何内出血迹象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "anticoagulant"
                    ],
                    "common_phrases": [
                        "heparin therapy",
                        "heparin injection"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种存在于人体内可防止血液凝固的物质，常作为药物用于治疗血栓。"
                    },
                    "translations": {
