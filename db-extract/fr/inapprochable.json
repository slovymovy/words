                                        "sense_id": "ed2783a2-b282-34bb-9bed-39a7f13473da",
                                        "entry_id": "d5ec2efb-3c58-3e5e-bd6c-d1fb6fa40eca",
                                        "glosses": [
                                            "Aloof and unfriendly."
                                        ],
