                        "cross_references": [
                            {
                                "target_word": "court de tennis",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6ff551f5-6f1b-3387-873a-3a31c23cb424",
                                        "entry_id": "eecbe1b2-8693-390c-97a0-34dbe8bd8203",
                                        "glosses": [
                                            "Terrain de sport spécifique au tennis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ccd01df2-63be-4158-9d0c-30582919bbe8",
                                                "sense_id": "6ff551f5-6f1b-3387-873a-3a31c23cb424",
                                                "text": "Ce dimanche 9 juillet, l’Aunis Athlétisme La Rochelle-Aytré organise son épreuve de course à pied, l’Angoulinoise, au départ des courts de tennis, près de la gare d’Angoulins-sur-Mer, à partir de 9 heures."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ed1528bc-1d6f-4c3e-b6dd-e847a7c1d33d",
                        "source_entry_id": "2b30f564-a1d2-3681-a327-f601492fd91d",
                        "source_sense_id": "1490e9a0-e891-3c21-9301-9568e1e622ca",
                        "source_sense_description": "das Spielfeld für ein Tennisspiel",
                        "target_lang_word": "tennisveld",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tennisveld",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                        "entry_id": "a7710a3e-4d8c-35fb-af0b-37c3fb503a91",
                                        "glosses": [
                                            "veld waarop men tennis kan spelen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32d9d43d-0100-4136-90aa-fb0afa4eaf7a",
                                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                                "text": "Maar allemaal samen is het absorberende oppervlak dat gevormd wordt door de kleine gaatjes erin zo groot als een tennisveld."
                                            },
                                            {
                                                "example_id": "6945bae1-07e3-4747-acac-d1d05dfaa40e",
                                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                                "text": "De liefde voor voetballen hebben ze van Marcel meegekregen, ik vertoefde liever op het naastgelegen tennisveld."
                                            },
                                            {
                                                "example_id": "8d21e6e9-8867-44dd-9249-7c80e2a8b99d",
                                                "sense_id": "332ef3ff-eeaa-3c8d-965c-1de1f9715ca9",
                                                "text": "\"Hij is mijn vriend, hij is mijn coach en ik kan wel zeggen dat hij ook soms mijn vader is\", vertelde Alcaraz, die op zijn vijftiende toetrad tot de tennisacademie van Ferrero. \"Hij was nummer een van de wereld en ik heb zo veel van hem geleerd. Ik ben heel dankbaar om hem in mijn spelersbox te hebben, maar ook buiten het tennisveld.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5a7c4e03-bec1-42f7-80ca-73b58ea78a32",
                        "source_entry_id": "2b30f564-a1d2-3681-a327-f601492fd91d",
