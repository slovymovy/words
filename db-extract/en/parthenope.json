                        "entry_id": "ae2750ad-ce89-391e-a2b5-6cd1172e684e",
                        "glosses": [
                            "One of the sirens, daughter of the god Achelous and the Muse Terpsichore."
                        ],
                        "tags": [
                            "Greek"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "5bdebb8f-e5cb-39c1-9688-f47c0c2bd2f4",
                        "entry_id": "ae2750ad-ce89-391e-a2b5-6cd1172e684e",
                        "glosses": [
                            "Former name of Naples: a port city in southwestern Italy."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "3212d2c4-11f0-47b2-9219-5d0199bc6bec",
                                "sense_id": "5bdebb8f-e5cb-39c1-9688-f47c0c2bd2f4",
                                "text": "Neapolis, Naples, was situated on the W. slope of Mt. Vesuvius and on the banks of the small stream Sebethus. It was founded by the Greeks of Cumae, and was named Neapolis, \"New City,\" in contradistinction to Palaepolis, \"Old City,\" which had been previously established, probably on the hill of Pausilypus. The name of Parthenope appears to have originally belonged to Palaepolis, but was subsequently transferred to Neapolis."
                            }
                        ]
                    },
