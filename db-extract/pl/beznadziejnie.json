                        "source_sense_id": "fb20c2b8-d45b-3b6f-99bb-9ee7214b8970",
                        "target_lang_word": "hopelessly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hopelessly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                        "entry_id": "5606bb62-fff3-3a9e-8397-c8ba1edbabff",
                                        "glosses": [
                                            "In a manner showing no hope"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "991b8a38-131e-4a29-942e-fecdfdcc29e9",
                                                "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                                "text": "The whole covey of victims was thus netted; the household ruin was thus full and orbicular; and in that proportion the tendency of men and women, flutter as they might, would be helplessly and hopelessly to sink into the all-conquering hands of the mighty murderer."
                                            },
                                            {
                                                "example_id": "55d79b6a-68ce-4896-a409-72692310972a",
                                                "sense_id": "89fe2876-50d7-3d02-85ad-ae8998a1ecd5",
                                                "text": "Crouch had earlier hopelessly miskicked an excellent volleyed chance from eight yards out after a delightful Pennant cross."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05959203-1b26-49bd-b15e-9af4497b6b9b",
                        "source_entry_id": "4a89498b-3944-33e6-8eeb-0cf00444a854",
                        "source_sense_id": "fb20c2b8-d45b-3b6f-99bb-9ee7214b8970",
                        "target_lang_word": "hoffnungslos",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoffnungslos",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "55f91f85-b65f-3fea-b6fc-5f3f3a09090b",
                                        "entry_id": "5f8c89f2-3940-30b1-a03c-7884c6f1a090",
                                        "glosses": [
                                            "keine Hoffnung (mehr) besitzend; pessimistisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b11378bd-26a3-4159-bf73-0ccdacd63c82",
                                                "sense_id": "55f91f85-b65f-3fea-b6fc-5f3f3a09090b",
                                                "text": "Mein Leben ist am Ende, ich fühle mich so hoffnungslos."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "176ba2d9-ed0a-333e-9bd4-78a9c362fac5",
                                        "entry_id": "5f8c89f2-3940-30b1-a03c-7884c6f1a090",
                                        "glosses": [
                                            "nicht zur Hoffnung veranlassend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebeefb2d-0bf9-4de3-b6c5-ffd958626621",
                                                "sense_id": "176ba2d9-ed0a-333e-9bd4-78a9c362fac5",
                                                "text": "Das ist ein hoffnungsloses Unterfangen."
                                            },
                                            {
                                                "example_id": "cce43392-3a1d-4b24-b036-fca755cf467a",
                                                "sense_id": "176ba2d9-ed0a-333e-9bd4-78a9c362fac5",
                                                "text": "Mein Cousin ist ein hoffnungsloser Säufer."
                                            },
                                            {
                                                "example_id": "6e8e66e9-ce38-4a9a-a52c-f77caa3e1193",
                                                "sense_id": "176ba2d9-ed0a-333e-9bd4-78a9c362fac5",
                                                "text": "„Als Hillebrecht anfing, war die Stadt in einem hoffnungslosen zustand, im Zentrum zu 90 Prozent zerstört, die Wege waren unpassierbar, in den Büros der Stadtverwaltung wurden Papiere von Ratten zerfressen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "9d60c3cb-ccbc-33d2-a604-bec0bc858727",
                                        "entry_id": "5f8c89f2-3940-30b1-a03c-7884c6f1a090",
                                        "glosses": [
                                            "in einem hohen Maße"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ab8def-1cb1-45a3-8e28-a14451ed2c3e",
                                                "sense_id": "9d60c3cb-ccbc-33d2-a604-bec0bc858727",
                                                "text": "„Die Halle, in der Schulz dann seine Rede hält, ist so hoffnungslos überfüllt, dass der Auftritt live in einen weiteren Zuschauerraum übertragen wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
