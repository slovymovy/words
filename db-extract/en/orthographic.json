                "senses": [
                    {
                        "sense_id": "f6f346c9-fd4d-3aba-b399-b2188f35a3f0",
                        "entry_id": "b14e0348-4028-39d8-ac6d-c782b452f7f1",
                        "glosses": [
                            "Of a projection used in maps, architecture etc., in which the rays are parallel."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a44580f5-9747-3e49-a384-08a2532e7284",
                        "entry_id": "b14e0348-4028-39d8-ac6d-c782b452f7f1",
                        "glosses": [
                            "Of, or relating to, orthography."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "08adf692-363b-49d8-86d6-b745ab5f57a2",
                                "sense_id": "a44580f5-9747-3e49-a384-08a2532e7284",
                                "text": "This overlapping is reflective of hybrid languages, where certain features (phonetic, orthographic, semantic, syntactic) are also difficult to disentangle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f54ad40-a3ee-4b6c-9227-d98eeacd43f7",
