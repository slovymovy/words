        "fr-extract.jsonl": [
            {
                "entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                "word": "prosopagnosie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d829cf7-9857-47a7-80b9-7d073483ea76",
                        "entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                        "tags": [
                            "plural"
                        ],
                        "form": "prosopagnosies"
                    },
                    {
                        "form_id": "9bd0bd03-d1af-41a5-b590-cc2a1505a8e2",
                        "entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                        "tags": [],
                        "form": "prosopoagnosie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "34feabe0-3732-3f50-b97d-a902133c81df",
                        "entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                        "glosses": [
                            "Trouble de la reconnaissance des visages ; le sujet ne peut identifier une personne par la vue de son visage bien qu’il soit parfaitement capable de distinguer les caractéristiques anthropométriques propres d’un individu."
                        ],
                        "tags": [
                            "Nosologie"
                        ],
                        "examples": [
                            {
                                "example_id": "0607a68e-2c06-407e-a9a3-df3dca4a0ba2",
                                "sense_id": "34feabe0-3732-3f50-b97d-a902133c81df",
                                "text": "C’est la prosopagnosie. Les patients atteints de ce trouble neurologique ont tout simplement perdu la capacité de reconnaître le visage d’un être familier. — (Lionel Naccache, Le Nouvel Inconscient : Freud, le Christophe Colomb des neurosciences, Odile Jacob, 2009, page 23)"
                            },
                            {
                                "example_id": "9d76cdd1-7fe9-4abd-b9da-597fe2e720ba",
                                "sense_id": "34feabe0-3732-3f50-b97d-a902133c81df",
                                "text": "Elle m’a appris encore que l’incapacité de reconnaître un visage se nomme “prosopagnosie” : ce fut le troisième mot grec que j’entendis d’elle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "30d693ed-7a7f-47ac-bfb7-4fbf75adeaa9",
                        "source_entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                        "source_sense_id": "34feabe0-3732-3f50-b97d-a902133c81df",
                        "source_sense_description": "Trouble de la reconnaissance des visages",
                        "target_lang_word": "Prosopagnosie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Prosopagnosie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                        "entry_id": "b4bd5a44-4f89-3fd6-a8ce-2c22e2dad9f0",
                                        "glosses": [
                                            "angeborene oder erworbene krankhafte Störung der Fähigkeit, Gesichter wiederzuerkennen"
                                        ],
                                        "tags": [
                                            "Neurologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0b916f6-b415-4aca-ab73-20f10a3df716",
                                                "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                                "text": "Allgemein bekannt wurde die Prosopagnosie durch den Bestseller \"Der Mann, der seine Frau mit einem Hut verwechselte\" des amerikanischen Wissenschaftlers und Autors Oliver Sacks."
                                            },
                                            {
                                                "example_id": "c08ce656-c613-4c09-aad8-02af2175007c",
                                                "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                                "text": "Bei der erworbenen Prosopagnosie sieht man deutliche Veränderungen im Gehirn, weil Hirngewebe zugrunde gegangen ist und einen Defekt hinterlassen hat."
                                            },
                                            {
                                                "example_id": "74e8f5f5-d727-4181-80ab-49bb35db76af",
                                                "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                                "text": "Wer bist denn du? Wer unter Prosopagnosie leidet, erkennt Freunde und Kollegen nicht. Die Betroffenen schweigen. Aus Scham."
                                            },
                                            {
                                                "example_id": "3662872b-22c0-4d00-ba01-8eb7892ad4aa",
                                                "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                                "text": "Ein Kniff, den schon die Jüngsten kennen: Kindern mit Prosopagnosie spielen, um es sich leichter zu machen, fast ausschließlich mit Kindern, die äußerlich besonders auffällig sind."
                                            },
                                            {
                                                "example_id": "d3f98546-f02f-4703-8725-e5f657fcea89",
                                                "sense_id": "c72c03c8-340b-36bd-91a1-c598ee8db941",
                                                "text": "Jane Goodall: Lange Zeit hielt ich es für geistige Trägheit, wenn ich Menschen nicht wiedererkannte. Dann erklärte mir Oliver Sacks, der Neurologe, dass ich an einer wohl angeborenen Störung leide, Prosopagnosie."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b561928c-5a5e-4276-8540-8944fb390ae9",
                        "source_entry_id": "cf54e101-1d0e-3875-9fb6-2b322498122c",
                        "source_sense_id": "34feabe0-3732-3f50-b97d-a902133c81df",
                        "source_sense_description": "Trouble de la reconnaissance des visages",
                        "target_lang_word": "prosopagnosia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prosopagnosia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22e8b399-8569-3e5b-844a-82fd75071ea2",
                                        "entry_id": "071a0de8-4b60-37d3-8c56-988b1c7cfcf7",
                                        "glosses": [
                                            "A form of visual agnosia characterized by difficulty with face recognition despite intact low-level visual processing."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb4c67af-5652-422d-9d16-566dbe43e0cb",
                                                "sense_id": "22e8b399-8569-3e5b-844a-82fd75071ea2",
                                                "text": "A normal person can name someone from facial features alone, even if the features have changed substantially over the years. People with prosopagnosia are not able to make this association, but have few other neurological symptoms other than a loss of some part of the visual field."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
