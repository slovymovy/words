                        "cross_references": []
                    },
                    {
                        "translation_id": "8abfaba0-f8cb-4afa-8737-8982c0a37874",
                        "source_entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "source_sense_description": "short curtain on top of a window",
                        "target_lang_word": "сваг",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "сваг",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe7f7ec-a608-3a02-abc2-252cc47b6705",
                                        "entry_id": "843ccf57-fe55-379f-8fbb-c4665945037b",
                                        "glosses": [
                                            "неол. элемент текстильного декорирования; специальным образом присборенный или собранный в складки отрезок ткани образующий полукруг"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "167afbef-b60d-48e0-b170-7b6f60846312",
                                                "sense_id": "8fe7f7ec-a608-3a02-abc2-252cc47b6705",
                                                "text": "Для изготовления наиболее красиво и правильно выполненных декоративных элементов ламбрекена (свагов, асимметричных свагов, перекидов, ассиметричных перекидов, свагов, переходящих в де жабо) при крое используют не нить основы или утка, а направление нити по косой, т.е. под углом 45°, так как косое направление ткани при ручном закладывании даёт мягкую драпируемую складку, позволяющую добиться максимально изящной формы деталей ламбрекена."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0364f690-8575-4c97-849d-87c99449cc78",
                        "source_entry_id": "230bbadb-9c66-330b-8e05-8d88d33e46bc",
                        "source_sense_description": "short, decorative edging of a mattress",
                        "target_lang_word": "по́лог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "по́лог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bff36f89-08a6-3f1f-b694-c0e66bc420c1",
                                        "entry_id": "de8cd5ee-4ef3-355c-8cc6-1d7ad705988b",
                                        "glosses": [
                                            "занавеска, закрывающая кровать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6c1359e-89ad-42c9-bce6-a0df21baac1a",
                                                "sense_id": "bff36f89-08a6-3f1f-b694-c0e66bc420c1",
                                                "text": "Меблированы были мои комнаты весьма изящно, уж вовсе не по-студенчески: в спальне красовались розовые занавески, и кисейный полог с голубыми помпончиками возвышался над кроватью."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4184c93-8be7-3f99-bdcc-afa8c4afdc73",
                                        "entry_id": "de8cd5ee-4ef3-355c-8cc6-1d7ad705988b",
                                        "glosses": [
                                            "любая занавеска, закрывающая, завешивающая что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4554217e-89ad-4c39-9669-7a7bd2925277",
                                                "sense_id": "f4184c93-8be7-3f99-bdcc-afa8c4afdc73",
                                                "text": "Изба была оклеена обоями на городскую руку; на полу везде половики; русская печь закрыта ситцевым пологом."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f34a7331-f16a-3e80-94ab-a6040ba0986b",
                                        "entry_id": "de8cd5ee-4ef3-355c-8cc6-1d7ad705988b",
                                        "glosses": [
                                            "перен. то, что покрывает, скрывает, окутывает что-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "57b0d6f0-1d62-4d76-aa5b-b4b1c2e4e8fb",
                                                "sense_id": "f34a7331-f16a-3e80-94ab-a6040ba0986b",
                                                "text": "Зеленая свежая трава ровным, слегка склонявшимся к городу пологом любовно скрывала в своих объятиях ужас и безобразие смерти."
                                            },
                                            {
                                                "example_id": "b4dbc555-d2ff-43f9-a16d-61fb039355ad",
                                                "sense_id": "f34a7331-f16a-3e80-94ab-a6040ba0986b",
                                                "text": "Я подошел к покойнику и поднял полог с лица."
                                            },
                                            {
                                                "example_id": "48f56c3b-0045-4ed4-b863-82628deba5bb",
                                                "sense_id": "f34a7331-f16a-3e80-94ab-a6040ba0986b",
                                                "text": "Стояли три телеги с поднятыми оглоблями, а на них раскинут громадный полог."
                                            },
                                            {
                                                "example_id": "92ab82aa-41f8-4852-b3c3-e3965bb2be26",
                                                "sense_id": "f34a7331-f16a-3e80-94ab-a6040ba0986b",
                                                "text": "Тёмное небо над освещённой улицей казалось чёрным, тяжёлым пологом."
                                            }
                                        ]
                                    }
                                ]
                            },
