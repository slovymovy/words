    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "68d0f754-547e-3f44-b026-dd2934f5faf8",
                    "sense_definition": "A picture, diagram, or representation made with lines, usually on paper.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child showed me a colorful <w>drawing</w> of a house.",
                            "target_lang_translations": {
                                "ru": "Ребёнок показал мне красочный <w>рисунок</w> дома.",
                                "zh": "孩子给我看了他画的一幅色彩鲜艳的房子的<w>画</w>。"
                            }
                        },
                        {
                            "text": "Architects create a detailed <w>drawing</w> before building begins.",
                            "target_lang_translations": {
                                "ru": "Архитекторы создают детальный <w>чертёж</w> перед началом строительства.",
                                "zh": "建筑师在施工前会制作详细的<w>图纸</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sketch",
                        "illustration",
                        "picture",
                        "diagram"
                    ],
                    "common_phrases": [
                        "pencil drawing",
                        "line drawing",
                        "technical drawing",
                        "scale drawing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Изображение, диаграмма или представление, выполненное линиями, обычно на бумаге.",
                        "zh": "用线条制作的图片、图表或表现形式，通常画在纸上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рисунок",
                                "target_lang_sense_clarification": "изображение"
                            },
                            {
                                "target_lang_word": "чертёж",
                                "target_lang_sense_clarification": "технический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "画",
                                "target_lang_sense_clarification": "图画"
                            },
                            {
                                "target_lang_word": "图纸",
                                "target_lang_sense_clarification": "技术图样"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f1f6c5e-d2b6-3144-bcef-d26c8a8c3eee",
                    "sense_definition": "The art or skill of creating pictures using a pencil, pen, or similar tool.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "visual_art",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is taking a <w>drawing</w> class at the local college.",
                            "target_lang_translations": {
                                "ru": "Она посещает класс <w>рисования</w> в местном колледже.",
                                "zh": "她正在当地学院上<w>绘画</w>课。"
                            }
                        },
                        {
                            "text": "My hobbies include reading and <w>drawing</w>.",
                            "target_lang_translations": {
                                "ru": "Мои хобби включают чтение и <w>рисование</w>.",
                                "zh": "我的爱好包括阅读和<w>绘画</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sketching",
                        "art"
                    ],
                    "common_phrases": [
                        "drawing class",
                        "drawing board",
                        "good at drawing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искусство или навык создания картин с использованием карандаша, ручки или аналогичного инструмента.",
                        "zh": "使用铅笔、钢笔或类似工具创作图画的艺术或技能。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рисование",
                                "target_lang_sense_clarification": "искусство"
                            },
                            {
                                "target_lang_word": "черчение",
                                "target_lang_sense_clarification": "техническое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "绘画",
                                "target_lang_sense_clarification": "艺术活动"
                            },
                            {
                                "target_lang_word": "素描",
                                "target_lang_sense_clarification": "绘画技法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a70f394a-8ddb-363a-94d8-675804026607",
                    "sense_definition": "A competition where winners are chosen by chance, often by picking a ticket from a container.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "lottery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We will hold a <w>drawing</w> to decide who wins the new car.",
                            "target_lang_translations": {
                                "ru": "Мы проведём <w>розыгрыш</w>, чтобы решить, кто выиграет новую машину.",
                                "zh": "我们将举行一次<w>抽奖</w>来决定谁能赢得这辆新车。"
                            }
                        },
                        {
                            "text": "Please put your name in the box for the prize <w>drawing</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, опустите своё имя в ящик для <w>розыгрыша</w> призов.",
                                "zh": "请把你的名字放进盒子里参加奖品<w>抽签</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "raffle",
                        "lottery",
                        "draw"
                    ],
                    "common_phrases": [
                        "prize drawing",
                        "enter the drawing",
                        "random drawing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкурс, в котором победители определяются случайно, часто путем вытягивания билета из контейнера.",
                        "zh": "一种通过随机方式（通常是从容器中抽取票据）选出获胜者的竞赛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "розыгрыш",
                                "target_lang_sense_clarification": "призов"
                            },
                            {
                                "target_lang_word": "жеребьёвка",
                                "target_lang_sense_clarification": "жребий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抽奖",
                                "target_lang_sense_clarification": "随机选出获胜者"
                            },
                            {
                                "target_lang_word": "抽签",
                                "target_lang_sense_clarification": "决定胜负或顺序"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3832a1b9-27e7-3c54-b79c-fa9ea885ff41",
                    "sense_definition": "The action of pulling or dragging something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action_pull",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>drawing</w> of the heavy curtains let in the sunlight.",
                            "target_lang_translations": {
                                "ru": "<w>Отдёргивание</w> тяжёлых штор впустило солнечный свет.",
                                "zh": "<w>拉</w>开厚重的窗帘后，阳光照了进来。"
                            }
                        },
                        {
                            "text": "He assisted in the <w>drawing</w> of the fishing nets.",
                            "target_lang_translations": {
                                "ru": "Он помогал в <w>вытягивании</w> рыболовных сетей.",
                                "zh": "他协助<w>拉</w>起了渔网。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pulling",
                        "dragging",
                        "traction"
                    ],
                    "antonyms": [
                        "pushing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по вытягиванию или тащению чего-либо.",
                        "zh": "拉动或拖拽某物的动作。"
                    },
                    "translations": {
