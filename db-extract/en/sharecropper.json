                                            {
                                                "example_id": "b0d4a8ed-d91c-4f76-b01f-44946253037e",
                                                "sense_id": "edf50415-1e4f-3666-ba0a-a5351e3763f2",
                                                "text": "Elle le pria d'aller prendre sa place au guichet, car elle craignait de traverser la salle d’attente où deux métayères assises, un panier sur les genoux et branlant la tête, tricotaient."
                                            }
                                        ]
                                    }
                                ]
