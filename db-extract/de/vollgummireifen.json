                "senses": [
                    {
                        "sense_id": "fe0e4c61-1683-327c-9b24-d1f1591043b4",
                        "entry_id": "3e81a801-9f3c-361f-aa96-6eb331388e09",
                        "glosses": [
                            "Reifen, der nicht mit einem Gas gefüllt ist, sondern durch und durch aus Gummi besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "989e905b-7fd2-42e5-8ac6-a186511c2ab4",
                                "sense_id": "fe0e4c61-1683-327c-9b24-d1f1591043b4",
                                "text": "„Zwar waren rasch Spezialisten zur Stelle, um die passenden Holzräder mit Vollgummireifen zu bauen oder die Alubleche über den Holzrahmen zu dengeln.“"
                            },
                            {
                                "example_id": "4d85d521-978a-4397-9c16-51ecfd857304",
                                "sense_id": "fe0e4c61-1683-327c-9b24-d1f1591043b4",
                                "text": "„Und auch die beinharten Vollgummireifen, die wenig später auf den Markt kamen, machten eine Fahrt in den modernen Motorwagen nicht gerade bequemer.“"
                            },
                            {
                                "example_id": "a05329e1-719d-4e12-b625-2c8c91a66ba4",
                                "sense_id": "fe0e4c61-1683-327c-9b24-d1f1591043b4",
                                "text": "„1895 wurden bereits 72 Benzinkutschen gebaut, 1899 waren es bereits 300; dazu kamen immer neue Verbesserungen, wie etwa Vollgummireifen, die Peugeot als erster Automobilhersteller verwendete.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
