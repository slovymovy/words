                ],
                "senses": [
                    {
                        "sense_id": "25fcc200-cbb1-34d4-b8c0-21fb49206a6d",
                        "entry_id": "24b64b9a-80b1-354a-a749-02ce987780e4",
                        "glosses": [
                            "Voler par ruse."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "860ee808-cfc1-4db8-aed5-db9f8b14890b",
                                "sense_id": "25fcc200-cbb1-34d4-b8c0-21fb49206a6d",
                                "text": "– Eh ! oui... c’est le même individu qui s’est jeté sur vous à la buvette et qui se sauvait parce qu’il avait filouté la bourse d’un monsieur."
                            },
                            {
                                "example_id": "cac6dbf9-d091-498a-9549-5d13034fd8bd",
                                "sense_id": "25fcc200-cbb1-34d4-b8c0-21fb49206a6d",
                                "text": "Viens, ami ; laisse-les s'en aller à la Bourse\nSe filouter entre eux."
                            },
                            {
                                "example_id": "1c221a34-b1d2-4c26-ba10-3574b57541b4",
                                "sense_id": "25fcc200-cbb1-34d4-b8c0-21fb49206a6d",
                                "text": "Je désire savoir pourquoi l’on nous a pris\nNos villes, notre armée, et notre force utile ;\nEt pourquoi l’on filoute et pourquoi l’on mutile\nL’immense peuple aimant d’où sortent les clartés."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a4f9e61-dc3a-3360-bfc6-a3df9927ecec",
                        "entry_id": "24b64b9a-80b1-354a-a749-02ce987780e4",
                        "glosses": [
                            "Faire une filouterie ; abuser ; tromper."
                        ],
