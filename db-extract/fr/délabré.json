                        "form": "délabrés"
                    },
                    {
                        "form_id": "dd015a7b-47ca-4a95-9d24-af42f41a48d3",
                        "entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "délabrée"
                    },
                    {
                        "form_id": "80e269e3-ad95-4b62-ac63-40c70cf18a28",
                        "entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "délabrées"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                        "entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "glosses": [
                            "En mauvais état, en parlant d’une chose, d’une construction."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9177fa58-ec6a-4b04-bef1-99e873e136a8",
                                "sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                                "text": "Pareils à des vaisseaux délabrés, avant de trouver l’infaillible naufrage, nous laissons un débris de nous-mêmes sur tous les écueils."
                            },
                            {
                                "example_id": "0b90e806-7825-4f3f-b421-01c251755571",
                                "sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                                "text": "Au cours des dernières années, les affaires avaient marché cahin-caha, avec une prédisposition romanesque à l’insécurité, dans une petite échoppe délabrée ouvrant sur la Grand’Rue."
                            },
                            {
                                "example_id": "85685921-db09-48b7-abeb-47b396e7a00d",
                                "sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                                "text": "Rares et maigres, pauvres et silencieuses étaient les localités traversées et, dans celles-ci, nombreuses étaient les demeures manifestement abandonnées, les bicoques délabrées où tout en fait des ruines."
                            },
                            {
                                "example_id": "d21c90c9-4dda-4171-aa7d-d5ba9f47c888",
                                "sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                                "text": "Le couvent était un édifice trapu et délabré, dont le toit ressemblait plutôt à de la tôle ondulée qu’à un pinacle gothique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9d3afa32-d783-4f18-b2f9-3525d8b6bd67",
                        "source_entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "source_sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                        "source_sense_description": "En mauvais état",
                        "target_lang_word": "in ruins",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "in ruins",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e86243a6-7822-3b1f-9a9d-c6ba435ef647",
                                        "entry_id": "809691f0-0bf7-3bf4-b364-088bf0a23643",
                                        "glosses": [
                                            "Of a building or structure, mostly destroyed."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fce7ccdd-8ba7-4171-bca8-179913b0a160",
                                                "sense_id": "e86243a6-7822-3b1f-9a9d-c6ba435ef647",
                                                "text": "The line ends at Narvik. Eight years ago the whole town was in ruins, but the industry of the Norwegian people has rebuilt it entirely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "80df5164-37b6-3084-bebf-a14b4a5cd85e",
                                        "entry_id": "809691f0-0bf7-3bf4-b364-088bf0a23643",
                                        "glosses": [
                                            "Of a person, attribute, relationship, etc., totally damaged or spoiled."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8173f859-6c65-4c56-b4a8-c588a26f7dca",
                                                "sense_id": "80df5164-37b6-3084-bebf-a14b4a5cd85e",
                                                "text": "After being found guilty of animal abuse, her reputation was in ruins."
                                            },
                                            {
                                                "example_id": "57b9d94f-03c2-4928-be44-469bbcda808b",
                                                "sense_id": "80df5164-37b6-3084-bebf-a14b4a5cd85e",
                                                "text": "His finances were in ruins after spending all his inheritance on cars and drugs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c00b0a2a-a91a-445a-a6ff-2eca43580c94",
                        "source_entry_id": "45a5e44c-abcf-3a35-8991-6360126af298",
                        "source_sense_id": "51ec6085-c6d1-39d0-b1ac-912d75e531cb",
                        "source_sense_description": "En mauvais état",
