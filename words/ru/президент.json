                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总裁",
                                "target_lang_sense_clarification": "大型企业或机构的负责人"
                            },
                            {
                                "target_lang_word": "会长",
                                "target_lang_sense_clarification": "协会或俱乐部的负责人"
                            }
                        ]
                    }
                }
            ]
        }
