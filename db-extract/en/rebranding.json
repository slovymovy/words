                                "sense_id": "037466d9-52de-3a3a-aaf1-f6c56729ac04",
                                "text": "The frequent rebrandings of the product have confused some customers."
                            },
                            {
                                "example_id": "78dd05f6-802a-4ecb-ad11-5fc6f8ee7884",
                                "sense_id": "037466d9-52de-3a3a-aaf1-f6c56729ac04",
                                "text": "A dictionary on historical principles is one that is modelled on the Oxford English dictionary. In fact, before undergoing rebranding, the original title of the now-familiar Oxford English dictionary was A new English dictionary on historical principles."
                            }
                        ]
