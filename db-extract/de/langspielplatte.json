                "translations": [
                    {
                        "translation_id": "0b26fe9f-e6ab-4b36-bc39-404750d8a304",
                        "source_entry_id": "2f0b0f91-ca49-3abb-868b-81ebe1d0c522",
                        "source_sense_id": "3443b72a-94a5-3503-9cc2-b3cc8e6aae84",
