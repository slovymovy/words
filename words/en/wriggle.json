{
    "word_family": [
        "wriggler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "88666dcc-636a-3a71-bae5-e780e3b88681",
                    "sense_definition": "To twist one's body to and fro with short, writhing motions; to squirm.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Teachers often lose their patience when children <w>wriggle</w> in their seats.",
                            "target_lang_translations": {
                                "zh": "当孩子们在座位上<w>扭动</w>时，老师们常常会失去耐心。"
                            }
                        },
                        {
                            "text": "I tried to ease my grip, but the lizards began to <w>wriggle</w> out of my hands.",
                            "target_lang_translations": {
                                "zh": "我试着放松手劲，但蜥蜴开始从我手中<w>扭动</w>着逃脱。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wiggle"
                    ],
                    "common_phrases": [
                        "wriggle in seat"
                    ],
                    "target_lang_definitions": {
                        "zh": "身体扭动或蠕动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "指身体或身体部位的来回摆动。"
                            },
                            {
                                "target_lang_word": "蠕动",
                                "target_lang_sense_clarification": "指像虫子一样缓慢地移动或扭动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba171b8b-9c09-36cf-a1d4-508106eb0c84",
                    "sense_definition": "To cause something to wriggle.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was sitting on the lawn, <w>wriggling</w> his toes in the grass.",
                            "target_lang_translations": {
                                "zh": "他坐在草坪上，在草丛中<w>动</w>着脚趾。"
                            }
                        },
                        {
                            "text": "The child started <w>wriggling</w> his fingers to show he was bored.",
                            "target_lang_translations": {
                                "zh": "孩子开始<w>动</w>着手指，表示他很无聊。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "使某物扭动。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "动",
                                "target_lang_sense_clarification": "指使身体部位活动。"
                            },
                            {
                                "target_lang_word": "摆动",
                                "target_lang_sense_clarification": "指使某物来回晃动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ce098b4-f3d6-317b-aa8b-11fc2a1961cb",
                    "sense_definition": "To use crooked or devious means.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician tried to <w>wriggle</w> out of his previous campaign promises.",
                            "target_lang_translations": {
                                "zh": "那位政客试图<w>推脱</w>他之前的竞选承诺。"
                            }
                        },
                        {
                            "text": "He always finds a way to <w>wriggle</w> through legal loopholes.",
                            "target_lang_translations": {
                                "zh": "他总能找到办法<w>钻</w>法律的<w>空子</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wriggle out of"
                    ],
                    "target_lang_definitions": {
                        "zh": "使用狡猾或不正当的手段摆脱困境。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "推脱",
                                "target_lang_sense_clarification": "指试图逃避责任或承诺。"
                            },
                            {
                                "target_lang_word": "钻空子",
                                "target_lang_sense_clarification": "指利用漏洞来达到目的。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "fce04ca4-ba80-3900-945d-163b90ddec41",
                    "sense_definition": "A wriggling movement.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "With a quick <w>wriggle</w>, the snake disappeared into the tall grass.",
                            "target_lang_translations": {
                                "zh": "蛇<w>扭动</w>了一下，迅速消失在长草丛中。"
                            }
                        },
                        {
                            "text": "The puppy gave a happy <w>wriggle</w> when it saw its owner.",
                            "target_lang_translations": {
                                "zh": "小狗见到主人时开心地<w>扭动</w>着身体。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "扭动的动作。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "扭动",
                                "target_lang_sense_clarification": "指身体的扭动动作。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}