                        "translation_id": "60dc0ddc-2848-4cb3-a1cd-583b4e33f90e",
                        "source_entry_id": "4c121f13-51d8-3245-87a9-ee86117fcea3",
                        "source_sense_id": "4bdb7a36-cfe0-3305-802c-566aa04515fe",
                        "source_sense_description": "the automation of a system or process by use of robotic devices",
