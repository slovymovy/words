                "senses": [
                    {
                        "sense_id": "caf5ab12-eb3e-31db-a1b2-abcebd0ef35b",
                        "entry_id": "be348c9f-4591-35cd-b219-7597753c470c",
                        "glosses": [
                            "Étrangler, étouffer."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "166bc5ff-efed-4901-bb42-a369123e4a8a",
                                "sense_id": "caf5ab12-eb3e-31db-a1b2-abcebd0ef35b",
                                "text": "Y venait vous strangouiller, l’animal!"
                            },
                            {
                                "example_id": "592a8657-8c84-40ff-bd75-6d6aec488772",
                                "sense_id": "caf5ab12-eb3e-31db-a1b2-abcebd0ef35b",
                                "text": "Les prolétaires n’étaient pas contents ; ils reprochaient, au fond de leur âme, à l’échappé des geôles capitalistes de n’y avoir pas été strangouillé, au traître, l’officier réactionnaire en l’occasion, de n’avoir pas joué sa partie jusqu’au bout, d’avoir montré de la mollesse ; la tragédie leur paraissait tronquée, mal venue."
                            }
                        ]
                    }
