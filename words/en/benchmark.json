{
    "word_family": [
        "benchmarking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e90a5cc9-d147-3432-9927-205e82bae68c",
                    "sense_definition": "A standard or point of reference against which things may be compared or assessed.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "standard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company's performance is the <w>benchmark</w> for the rest of the industry.",
                            "target_lang_translations": {
                                "ru": "Показатели этой компании являются <w>эталоном</w> для всей остальной отрасли."
                            }
                        },
                        {
                            "text": "We need to establish a clear <w>benchmark</w> for success before we start the project.",
                            "target_lang_translations": {
                                "ru": "Нам нужно установить четкий <w>критерий</w> успеха перед началом проекта."
                            }
                        }
                    ],
                    "synonyms": [
                        "yardstick"
                    ],
                    "common_phrases": [
                        "clear benchmark",
                        "industry benchmark",
                        "establish a benchmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандарт или точка отсчета, с которыми можно сравнивать или оценивать другие объекты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "эталон",
                                "target_lang_sense_clarification": "образец для сравнения"
                            },
                            {
                                "target_lang_word": "критерий",
                                "target_lang_sense_clarification": "признак для оценки"
                            },
                            {
                                "target_lang_word": "ориентир",
                                "target_lang_sense_clarification": "точка отсчета"
                            },
                            {
                                "target_lang_word": "мерило",
                                "target_lang_sense_clarification": "основание для оценки"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ceaf48f-159d-3d8b-9645-441e09684dc5",
                    "sense_definition": "A standardized problem or test used to evaluate the performance of a computer system or software.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_test",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new processor achieved a record score in the latest graphics <w>benchmark</w>.",
                            "target_lang_translations": {
                                "ru": "Новый процессор показал рекордный результат в последнем графическом <w>бенчмарке</w>."
                            }
                        },
                        {
                            "text": "Running a <w>benchmark</w> test helps determine if the hardware is functioning at its peak.",
                            "target_lang_translations": {
                                "ru": "Запуск <w>теста производительности</w> помогает определить, работает ли оборудование на пике своих возможностей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "benchmark test",
                        "performance benchmark",
                        "run a benchmark"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стандартизированная задача или тест, используемый для оценки производительности компьютерной системы или программного обеспечения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бенчмарк",
                                "target_lang_sense_clarification": "технический тест производительности"
                            },
                            {
                                "target_lang_word": "тест производительности",
                                "target_lang_sense_clarification": "проверка скорости работы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "496bdfbf-ffd1-3d1a-99da-6089088501d4",
                    "sense_definition": "A surveyor's mark cut into a wall or other durable object, used as a reference point in measuring altitudes.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "surveying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveyor located the brass <w>benchmark</w> embedded in the stone foundation of the old church.",
                            "target_lang_translations": {
                                "ru": "Геодезист нашел латунный <w>репер</w>, вмонтированный в каменный фундамент старой церкви."
                            }
                        },
                        {
                            "text": "Each <w>benchmark</w> on the map corresponds to a specific elevation above sea level.",
                            "target_lang_translations": {
                                "ru": "Каждая <w>высотная отметка</w> на карте соответствует определенной высоте над уровнем моря."
                            }
                        }
                    ],
                    "common_phrases": [
                        "surveyor benchmark",
                        "elevation benchmark"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Геодезическая отметка на стене или другом прочном объекте, используемая в качестве опорной точки при измерении высот."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "репер",
                                "target_lang_sense_clarification": "геодезический знак высоты"
                            },
                            {
                                "target_lang_word": "нивелирная марка",
                                "target_lang_sense_clarification": "отметка высоты"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30839c08-28ef-3769-9902-7e61b22e7ff1",
                    "sense_definition": "To evaluate or check something by comparison with a standard.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "evaluate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency will <w>benchmark</w> our current safety protocols against international regulations.",
                            "target_lang_translations": {
                                "ru": "Агентство будет <w>сравнивать</w> наши текущие протоколы безопасности с международными нормами."
                            }
                        },
                        {
                            "text": "It is difficult to <w>benchmark</w> performance when there are no similar companies to compare with.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>оценивать</w> эффективность, когда нет похожих компаний для сравнения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "benchmark against",
                        "benchmark performance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Оценивать или проверять что-либо путем сравнения со стандартом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сравнивать",
                                "target_lang_sense_clarification": "сопоставлять с эталоном"
                            },
                            {
                                "target_lang_word": "тестировать",
                                "target_lang_sense_clarification": "проверять производительность"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}