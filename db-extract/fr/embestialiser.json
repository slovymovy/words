                        "glosses": [
                            "Donner un caractère de bête à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c4c8638-4d84-4af5-b9d1-ffcfacc4e279",
                                "sense_id": "6fc90adf-66d7-3938-b500-b43e8bbc2156",
                                "text": "Certes, il a toujours existé de séduisantes créatures, des enchanteresses débordantes de sensualité, capables d’attirer et de retenir les hommes, je veux dire leurs dupes, de leur faire tout oublier, de leur inspirer un amour désordonné, d’embraser leur être, d’affoler leur chair, de les embestialiser en quelque sorte."
                            },
                            {
                                "example_id": "ea9485c0-7260-4ecd-91c8-d777bea65c2a",
                                "sense_id": "6fc90adf-66d7-3938-b500-b43e8bbc2156",
                                "text": "Lucrèce ne nous propose point de nous embestialiser et le retour est impossible."
                            }
                        ]
                    }
