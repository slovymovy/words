                },
                {
                    "sense_id": "f6616be9-1274-350d-bd09-403b7810ac21",
                    "sense_definition": "A person's outward bearing or way of behaving towards others.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mode_of_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His professional <w>manner</w> made the patients feel at ease.",
                            "target_lang_translations": {
                                "ru": "Его профессиональная <w>манера</w> поведения успокаивала пациентов.",
                                "tr": "Profesyonel <w>tavrı</w> hastaların rahat hissetmesini sağladı."
                            }
                        },
                        {
                            "text": "She has a very gentle and calm <w>manner</w>.",
                            "target_lang_translations": {
                                "ru": "У неё очень мягкая и спокойная <w>манера</w> держаться.",
                                "tr": "Çok nazik ve sakin bir <w>tavrı</w> var."
                            }
