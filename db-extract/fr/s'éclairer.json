                "senses": [
                    {
                        "sense_id": "969b3f62-7f0f-3f80-b37c-9d5f9add4ea7",
                        "entry_id": "7b59936b-f14b-34ac-816b-95bd19dd1001",
                        "glosses": [
                            "Devenir lumineux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "573aa7c5-17fd-4d2e-ab16-e359bb3434cf",
                                "sense_id": "969b3f62-7f0f-3f80-b37c-9d5f9add4ea7",
                                "text": "« Singulière affaire, assurément », se disait-elle. Elle en fut si bouleversée qu'elle ne devait même pas s’apercevoir que le coq avait déjà annoncé l'aube et que l'Orient peu à peu s'éclairait."
                            }
                        ]
                    },
                    {
                        "sense_id": "ca80d2e3-16b5-3fcc-b0c7-c389bc36d353",
                        "entry_id": "7b59936b-f14b-34ac-816b-95bd19dd1001",
                        "glosses": [
                            "S'informer, se renseigner."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "87dc7585-3c94-46ed-96dc-4a4ad627fac2",
                                "sense_id": "ca80d2e3-16b5-3fcc-b0c7-c389bc36d353",
                                "text": "— Écoutez : je veux m’éclairer ; puis quand je saurai ce que je désire savoir, je m’éloignerai.\n— Éclairez-vous, dit flegmatiquement Athos."
                            }
                        ]
                    }
