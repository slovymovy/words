                    {
                        "translation_id": "5e7749fb-1765-4cc3-a9ca-e288899b1fb5",
                        "source_entry_id": "d77d9595-582b-3b1d-b45b-1b2ce99ec872",
                        "source_sense_id": "10faf353-2053-36fc-964a-68ab2cecf5d8",
                        "source_sense_description": "virale Infektion der Haut, bei der derbe, hautfarbene Papeln mit Hornpfropf heranwachsen",
                        "target_lang_word": "molluscum contagiosum",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "molluscum contagiosum",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44cfc604-37cf-3e9f-ab80-7197734cc4b1",
                                        "entry_id": "4657d60e-02e1-3de0-a428-e1ab68cb992c",
                                        "glosses": [
                                            "A viral infection of the skin or (occasionally) mucous membranes, caused by Molluscum contagiosum virus (MCV), a DNA poxvirus."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a36b57-61ba-4c04-a06f-f3f2fcad8f9f",
                                                "sense_id": "44cfc604-37cf-3e9f-ab80-7197734cc4b1",
                                                "text": "The virus causing molluscum contagiosum is a member of the DNA pox family. It is particularly prevalent in underdeveloped countries, and afflicts over 20% of the population in some South Pacific regions. Children are its prime target, but adults can be affected as well."
                                            },
                                            {
                                                "example_id": "81ccc2d1-e2e9-4863-9aa6-8b8cac31bb2a",
                                                "sense_id": "44cfc604-37cf-3e9f-ab80-7197734cc4b1",
                                                "text": "Molluscum contagiosum is a viral infection caused by the large poxvirus, and, as the name implies, it is spread by direct contact. In older adolescents and adults, it is most often passed by sexual contact."
                                            },
                                            {
                                                "example_id": "f6b55e52-2ae2-444e-9eea-1ab2901fa5e9",
                                                "sense_id": "44cfc604-37cf-3e9f-ab80-7197734cc4b1",
                                                "text": "Molluscum contagiosum is a benign lesion usually seen on the skin and caused by a poxvirus.[…]An increased incidence of molluscum contagiosum has been observed in patients with HIV infection.[…]Molluscum contagiosum is extremely rare in the oral cavity."
                                            },
                                            {
                                                "example_id": "37d754b6-2546-43d0-8aaa-a8ec06732e11",
                                                "sense_id": "44cfc604-37cf-3e9f-ab80-7197734cc4b1",
                                                "text": "It has been estimated that in the United States, office visits for molluscum contagiosum account for about 0.2% of total outpatient visits (22)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
