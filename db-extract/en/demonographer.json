                        "glosses": [
                            "Synonym of demonologist."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6f15534d-5b93-457e-bd8d-0fd5be5e3856",
                                "sense_id": "932e1b63-3214-397c-a475-dc171055d2c0",
                                "text": "Wierus (Johann Wier or Weier, 1515-'88, physician to the duke of Cleves, opponent of belief in sorcery), demonographer, his infernal court, V. 794, 2 c."
                            },
                            {
                                "example_id": "4c576b26-71c2-40ec-ba87-cc1dd169cb39",
                                "sense_id": "932e1b63-3214-397c-a475-dc171055d2c0",
                                "text": "Bodin, the medieval demonographer, enumerates various methods of producing anaphrodisiac effects by enchantments."
                            },
                            {
                                "example_id": "680eb03e-35f9-47ed-b948-8ad49f9729d9",
                                "sense_id": "932e1b63-3214-397c-a475-dc171055d2c0",
                                "text": "'Wicrus' is the Latinized form of the name of Johann Weier or Wier, a sixteenth-century physician and demonographer."
                            },
                            {
                                "example_id": "402e2a4a-dc3d-47bf-95d1-db5a5f95d28c",
                                "sense_id": "932e1b63-3214-397c-a475-dc171055d2c0",
                                "text": "Many of the demonographers Naudé cites, especially Weyer and Bodin, dispute the causes while affirming the Malleus maleficarum's opinion that women are more prone to cooperating with demons than are men."
                            }
                        ]
                    }
