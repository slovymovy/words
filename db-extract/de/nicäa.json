                                "target_senses": [
                                    {
                                        "sense_id": "33649a16-d746-3ce1-8bc5-9513bd4eaaca",
                                        "entry_id": "09685902-515c-34a2-8dd5-4a812fa99edc",
                                        "glosses": [
                                            "Former name of Iznik: a town in Bursa Province, Turkey, famed for the 325 CE church council that composed the Nicene Creed."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
