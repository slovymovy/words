                                "target_senses": [
                                    {
                                        "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                        "entry_id": "d209eb10-03b5-3fdf-8bf6-d8b01d17268e",
                                        "glosses": [
                                            "Décorer une surface suivant un dessin gravé en creux avec des éléments d’une matière différente, ordinairement plus précieuse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c793eff7-e237-426e-b7d5-88c1e2b37d8b",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster de marbre, de jaspe une colonne, un pilastre, un portique."
                                            },
                                            {
                                                "example_id": "3a5fbafe-a5c8-4e07-b724-3f804c225209",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster un pilastre, un portique, etc."
                                            },
                                            {
                                                "example_id": "e7dd4d16-338a-4340-9066-5564b9121d92",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Incruster d’or une tabatière d’écaille."
                                            },
                                            {
                                                "example_id": "da8edffb-6ea2-48e7-ad3b-d3c0c13927de",
                                                "sense_id": "a905133b-8893-350f-b98e-683495a04773",
                                                "text": "Des lettres d’or incrustées dans une plaque de marbre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "850928f5-68e2-38ac-9041-ed975476b711",
                                        "entry_id": "d209eb10-03b5-3fdf-8bf6-d8b01d17268e",
                                        "glosses": [
                                            "Remplacer une surface préalablement évidée par une autre composée de petits matériaux taillés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "450cc332-cd0c-4a84-97e4-482e90e2fcba",
                                                "sense_id": "850928f5-68e2-38ac-9041-ed975476b711",
                                                "text": "Incruster une mosaïque dans le pavé d’un temple."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a8ba00e-71a8-3a83-9749-7ed6b3abc2b1",
                                        "entry_id": "d209eb10-03b5-3fdf-8bf6-d8b01d17268e",
                                        "glosses": [
                                            "Laisser une empreinte en creux dans une matière molle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec6a452-ef4a-4473-b023-e46a85530e2f",
                                                "sense_id": "0a8ba00e-71a8-3a83-9749-7ed6b3abc2b1",
                                                "text": "Madeleine marchait légèrement dans les chemins détrempés. À chaque pas, elle y laissait dans la terre molle la forme imprimée de sa chaussure étroite à talons saillants. Je regardais cette trace fragile, je la suivais, tant elle était reconnaissable à côté des nôtres. Je calculais ce qu’elle pouvait durer. J’aurais souhaité qu’elle restât toujours incrustée, comme des témoignages de présence, pour l’époque incertaine où je repasserais là sans Madeleine"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
