                "senses": [
                    {
                        "sense_id": "98a68798-e93b-3a0e-bf93-b4b4098d28c7",
                        "entry_id": "ec22fb29-8795-3ae8-a9ff-6cf1bed4d3c3",
                        "glosses": [
