                        "glosses": [
                            "Saigner très légèrement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a7208d-87f1-46be-a19e-5da0b6c08e82",
                                "sense_id": "28248621-e681-3488-b01f-089d6f701385",
                                "text": "Enfin on distingue la plaie (celle de tous les jours) qui peut « saignotter », de l’hémorragie qui bien sûr résulte aussi d’une plaie mais qui saigne abondamment (voir chapitre 9)."
                            },
                            {
                                "example_id": "fed453f6-4f59-418a-a35d-ec99de23f89d",
                                "sense_id": "28248621-e681-3488-b01f-089d6f701385",
                                "text": "On suture alors au catgut peau et muqueuse, en comprenant dans les points de suture les artérioles qui pourraient saignotter."
                            }
                        ]
