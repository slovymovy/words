                                        "entry_id": "7c68632e-d99a-3459-b506-0f2fec15b586",
                                        "glosses": [
                                            "A period of time when regular competitions are not being held, or when an athlete is not participating in competitions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa3b1f62-27b7-4958-b1c6-8894da0959f2",
                                                "sense_id": "86aa6f0f-b346-37d4-a34b-567aea0c5ddd",
                                                "text": "Alternating off-season and precontest cycles in bodybuilding over a period of years will result in the relatively quick development of a championship physique."
                                            },
                                            {
                                                "example_id": "ce1a4deb-84b4-4548-a333-c2deba187958",
                                                "sense_id": "86aa6f0f-b346-37d4-a34b-567aea0c5ddd",
                                                "text": "That’s why virtually nothing should be off the table this offseason, including the idea of improving at quarterback."
                                            }
