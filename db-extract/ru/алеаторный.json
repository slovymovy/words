                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b839fae7-76aa-4ad9-acf4-2ac96cf970a8",
                                                "sense_id": "3a5ee3dd-d61e-3dc5-8163-d545b1a0d3ad",
                                                "text": "Jedes Ereignis im Leben sei aleatorisch und kontingent, meinte er."
                                            },
                                            {
                                                "example_id": "0c5ddc43-a728-4389-84a8-023cb7423282",
                                                "sense_id": "3a5ee3dd-d61e-3dc5-8163-d545b1a0d3ad",
                                                "text": "Die aleatorischen Verfahren haben mir im Kunstunterricht immer besonders gefallen."
                                            }
