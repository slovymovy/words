                "senses": [
                    {
                        "sense_id": "1bf093ac-8994-3748-911e-eedf362df4fb",
                        "entry_id": "af975b68-dd4a-3193-956a-af9387f764b1",
                        "glosses": [
                            "w islamie: opinia teologa muzułmańskiego wyjaśniająca kontrowersję teologiczną, czasem zawierająca konkretne wskazania w indywidualnej sprawie, np. wydająca wyrok śmierci lub zakazująca jakiś praktyk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "916ff272-68f6-48c2-8ef2-404ca6a0adbb",
                                "sense_id": "1bf093ac-8994-3748-911e-eedf362df4fb",
                                "text": "Zdaniem duchowego przywódcy Iranu ajatollaha Ali Chamenei, internetowy czat pomiędzy mężczyzną i kobietą, których nie łączą związki pokrewieństwa, jest niedopuszczalny. Ajatollah wydał już w tej sprawie fatwę czyli zakaz takich praktyk."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e7bf50e-5d9f-470b-8ae6-a6d8074e748e",
                        "source_entry_id": "af975b68-dd4a-3193-956a-af9387f764b1",
                        "source_sense_id": "1bf093ac-8994-3748-911e-eedf362df4fb",
                        "target_lang_word": "fatwa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fatwa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd8baf14-22c0-36ef-bd68-e80b757d150e",
                                        "entry_id": "2675b186-22a3-3eef-861a-75f117307fb4",
                                        "glosses": [
                                            "A formal legal decree, opinion, or ruling issued by a mufti or other Islamic judicial authority."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b06710de-baac-44b2-be7c-3dcd38b60710",
                                                "sense_id": "cd8baf14-22c0-36ef-bd68-e80b757d150e",
                                                "text": "The website contains fatwas on points of Islamic law that arise in court cases."
                                            },
                                            {
                                                "example_id": "78551a5f-3222-402d-8250-ce030c90831d",
                                                "sense_id": "cd8baf14-22c0-36ef-bd68-e80b757d150e",
                                                "text": "In 2015, one person was killed in Copenhagen at a meeting meant to mark the 25th anniversary of an Iranian fatwa against British writer Salman Rushdie, which Vilks attended."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a59c04d-f499-3d49-8b54-1ad5b45b57c1",
                                        "entry_id": "2675b186-22a3-3eef-861a-75f117307fb4",
                                        "glosses": [
                                            "A decree issued by a mufti or other Islamic judicial authority that a person should be put to death, usually as punishment for committing apostasy or blasphemy."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "proscribed"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bc0b190-ddae-3bae-a252-2c85c56b68eb",
                                        "entry_id": "2675b186-22a3-3eef-861a-75f117307fb4",
                                        "glosses": [
                                            "A formal decree or ruling, or statement, issued by an authority of a religion other than Islam."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4d64bcd-2239-3bc0-9d94-294b7fa383c0",
                                        "entry_id": "2675b186-22a3-3eef-861a-75f117307fb4",
                                        "glosses": [
                                            "An emphatic decree or opinion, especially one which condemns or criticizes."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "informal"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "fatwa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9fd0574-ef9d-3563-9af0-597ee9ca3215",
                                        "entry_id": "53893a7e-5562-3a91-9fe3-a9b826a6ebea",
                                        "glosses": [
                                            "To issue a fatwa (noun sense 1) against (someone); specifically (loosely, erroneous), a fatwa imposing a ban or a death sentence."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74a53ff0-0ae6-4abb-a134-7f348910cf93",
                                                "sense_id": "c9fd0574-ef9d-3563-9af0-597ee9ca3215",
                                                "text": "Unlike many writers and artists, Chahine had not been fatwaed by the militants, but he felt threatened nevertheless."
                                            },
                                            {
                                                "example_id": "db0f471d-fbd1-4b17-8c1e-9db4ecdff724",
                                                "sense_id": "c9fd0574-ef9d-3563-9af0-597ee9ca3215",
                                                "text": "One wonders why these terrorists are not fatwaed."
                                            },
                                            {
                                                "example_id": "0e53601f-f211-4f54-b610-3328bcb5009c",
                                                "sense_id": "c9fd0574-ef9d-3563-9af0-597ee9ca3215",
                                                "text": "'I'm just beginning one,' says famously-fatwaed author of new novel [subtitle]"
                                            },
                                            {
                                                "example_id": "57756116-0ed5-40e2-b131-109a4f7d7145",
                                                "sense_id": "c9fd0574-ef9d-3563-9af0-597ee9ca3215",
                                                "text": "Ask Salman Rushdie. He was fatwaed for linking facts and fiction in ways that the mullahs say they should not be linked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3e6e367-43a8-4962-88cf-84d997400f78",
                        "source_entry_id": "af975b68-dd4a-3193-956a-af9387f764b1",
                        "source_sense_id": "1bf093ac-8994-3748-911e-eedf362df4fb",
