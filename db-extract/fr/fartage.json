                        "glosses": [
                            "Action de farter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28838929-ccbf-4e87-91c5-f3f1053cbc58",
                                "sense_id": "e4de43bc-7b32-3128-93c6-eaddf3aae882",
                                "text": "Elle ne parle que fartage, fautes de carre, lac des Moinges, combe Gautier, fonds très raides à couper, camaraderie, chalets, repas froids."
                            },
                            {
                                "example_id": "a02c6d62-a85e-4181-bbbc-50ddd4cded5b",
                                "sense_id": "e4de43bc-7b32-3128-93c6-eaddf3aae882",
                                "text": "L’importance du fartage est évidente en compétition où les écarts se jouent à quelques centièmes de seconde."
                            },
                            {
                                "example_id": "dd602768-896f-4c29-a9c4-7918cfd152f5",
                                "sense_id": "e4de43bc-7b32-3128-93c6-eaddf3aae882",
                                "text": "En mars 2023, la Fédération internationale de ski et de snowboard a décidé d’interdire l’utilisation du fluor pour le fartage des skis dans les courses professionnelles en raison du risque de toxicité qui lui est attaché."
                            }
                        ]
                    }
