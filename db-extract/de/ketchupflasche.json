                ],
                "senses": [
                    {
                        "sense_id": "17ad6310-f4e3-3c06-8282-40ad3521d809",
                        "entry_id": "c404dc67-c582-38bd-984f-17c214ac62a7",
                        "glosses": [
                            "mit Ketchup gefüllte Flasche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8383c909-ff5f-4b3e-a538-e06c1c0d6f31",
                                "sense_id": "17ad6310-f4e3-3c06-8282-40ad3521d809",
                                "text": "Reichst du mir bitte mal die Ketchupflasche?"
                            },
                            {
                                "example_id": "17c8cd31-889a-4f88-9ddf-22f0233f9c07",
                                "sense_id": "17ad6310-f4e3-3c06-8282-40ad3521d809",
                                "text": "„Die Vierzig-Watt-Birne hinten im Kühlschrank, ein leuchtendes Etwas, das ich hinter den leeren Ketchupflaschen und den Gläsern mit Mixpickles oder Mayonnaise nicht sehen kann, ein winziges Licht aus dem Kühlschrank, lässt Tylers Umrisse an den Rändern leuchten.“"
                            },
                            {
                                "example_id": "87dc10e6-cc37-463e-85c5-dac5b6369e75",
                                "sense_id": "17ad6310-f4e3-3c06-8282-40ad3521d809",
                                "text": "„Geht Ketchup zur Neige, hat es die unangenehme Angewohnheit, in der Gegend herumzuspritzen, wenn man es aus der Plastikflasche drücken will. Warum das so ist und wie die aktuellen Ketchupflaschen mit Gummiventil das Problem noch verschlimmern, haben nun zwei britische Physiker der Universität Oxford wissenschaftlich erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
