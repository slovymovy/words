                ],
                "senses": [
                    {
                        "sense_id": "a10775ee-bd2c-3adb-b511-c3e247020fd1",
                        "entry_id": "a5561f72-e413-321c-9876-89ec6d397e38",
                        "glosses": [
                            "durch markante Ereignisse begrenzter Teil des Lebens einer Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dc4b4dc-fdaa-4d66-b21c-11c38d7d2f72",
                                "sense_id": "a10775ee-bd2c-3adb-b511-c3e247020fd1",
                                "text": "„Die Schüler, für die an diesem Tag ein neuer Lebensabschnitt begann, kamen aus ganz Deutschland, aus Österreich und der Schweiz, und man sah ihnen an, dass ihre Eltern sich um sie gekümmert hatten.“"
                            },
                            {
                                "example_id": "52a6f916-7329-4997-8864-b806eeddfe19",
                                "sense_id": "a10775ee-bd2c-3adb-b511-c3e247020fd1",
                                "text": "„Das Jahr 1937 war für Janosch ein neuer Lebensabschnitt, denn es kam die Zeit der Schulpflicht.“"
                            },
                            {
                                "example_id": "909adcf5-eb43-4706-988f-603dc77a6be8",
                                "sense_id": "a10775ee-bd2c-3adb-b511-c3e247020fd1",
                                "text": "„Ich beschloss, wie der kleine Johannes mit wachen Augen einen neuen Lebensabschnitt zu beginnen und die neuen Erfahrungen und Eindrücke in mich aufzusaugen.“"
                            },
                            {
                                "example_id": "867a897c-38d3-4266-96db-aa5768961e12",
                                "sense_id": "a10775ee-bd2c-3adb-b511-c3e247020fd1",
                                "text": "„Ein neuer Lebensabschnitt beginnt; er sollte von entscheidender Bedeutung werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
