                                "example_id": "09675639-f2de-4ce3-b93e-b92cb7a35328",
                                "sense_id": "33625a41-2997-3c43-ab39-e76bc94dadd4",
                                "text": "At times Air Force and CAS efforts blended to the point of indistinguishability."
                            },
