    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "93f68df9-ed01-3286-bc23-a913c92a6f09",
                "word": "Michaela",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9d956b34-27a9-3729-8ba4-137ff43fe52a",
                        "entry_id": "93f68df9-ed01-3286-bc23-a913c92a6f09",
                        "glosses": [
                            "A female given name from Hebrew."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e494f40a-5e58-439e-96dd-7bd9e2a8fb12",
                                "sense_id": "9d956b34-27a9-3729-8ba4-137ff43fe52a",
                                "text": "Do you remember at Holmwood I called you Michaela, because you were so fair, like the girl in the opera? Now, this type-writer girl is dark, and she has been playing Carmen to you - stealing your love away from you by her clever ways."
                            },
                            {
                                "example_id": "fbc20b60-82db-4f4e-b597-ed90c0ebab65",
                                "sense_id": "9d956b34-27a9-3729-8ba4-137ff43fe52a",
                                "text": "Edward had asked about her name. What was the origin and the meaning? \"Unusual, but it has a nice sound. Kind of like Mahalia.\"\nMichaela had lifted her shoulders, helplessly. \"I have no idea. My mother said she read it somewhere and liked the sound. And she didn't want me to have a name like everyone else. She said she thought I was going to be special.\""
                            }
                        ]
                    }
                ],
