                                "target_senses": [
                                    {
                                        "sense_id": "1fa11f1e-ea15-3bc0-a8f2-077d0b023bd0",
                                        "entry_id": "2819b546-d4e3-33fb-88c8-2c67f6e23477",
                                        "glosses": [
                                            "An act of incompetence or ineptitude."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "27d47c56-87db-4fc9-ba30-897bebff5ae9",
                                                "sense_id": "1fa11f1e-ea15-3bc0-a8f2-077d0b023bd0",
                                                "text": "Your bungling nearly cost us our jobs."
                                            }
