                ],
                "senses": [
                    {
                        "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                        "entry_id": "80f29c0f-2397-3c19-b8fc-77cda28d0503",
                        "glosses": [
                            "(männliche) Person, die wegen einer Straftat verurteilt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca435ad7-4193-4150-8dd2-8fab25f622a9",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Als Vorbestrafte haben Marcel und Paolo nun kaum noch Chancen auf dem regulären Arbeitsmarkt."
                            },
                            {
                                "example_id": "7c6d8eb0-5893-4076-84b4-308865f5f59c",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Stimmt es, dass der Ehemann von Frau Schmidt ein Vorbestrafter ist?"
                            },
                            {
                                "example_id": "82bd3da8-367a-411e-958c-1c8589129f0c",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Rebecca leitet ein Projekt, das sich mit der Wiedereingliederung Vorbestrafter in die Gesellschaft beschäftigt."
                            },
                            {
                                "example_id": "53e92002-5e15-403e-8535-7d4eab5dff68",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Einem Vorbestraften schlägt vielerorts Misstrauen entgegen."
                            },
                            {
                                "example_id": "21f97a1f-3624-4bcf-a646-79b6d186a1bf",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Ein wegen Brandstiftung Vorbestrafter wird verdächtigt, den Raub im Stadtpark begangen zu haben."
                            },
                            {
                                "example_id": "dd81bd05-e380-423a-a8b7-20452a668a8d",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Der Vorbestrafte, der ins Visier der Ermittlungsbehörden geraten war, war zuvor schon mehrmals auch zu Unrecht verdächtigt worden."
                            },
                            {
                                "example_id": "1a3ace18-8689-409d-ac58-68916c623cfa",
                                "sense_id": "cf4fbd07-01cf-36f5-9a55-f668137ca887",
                                "text": "Als Vorbestraftem gelang es ihm, sein Leben doch noch in geordnete Bahnen zu lenken."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
