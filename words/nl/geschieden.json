    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "487dd585-6556-3b13-9c4e-0de504001ba8",
                    "sense_definition": "het plaatsvinden van een gebeurtenis of voorval",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gebeuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kwaad is nu eenmaal <w>geschied</w> en we kunnen de tijd niet terugdraaien.",
                            "target_lang_translations": {
                                "en": "The evil has simply <w>done</w> and we cannot turn back time."
                            }
                        },
                        {
                            "text": "Men vraagt zich nog steeds af hoe dit ongeluk heeft kunnen <w>geschieden</w>.",
                            "target_lang_translations": {
                                "en": "People still wonder how this accident could have <w>occurred</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "plaatsgrijpen",
                        "gebeuren"
                    ],
                    "common_phrases": [
                        "het kwaad is geschied",
                        "zo geschiedde het"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal or literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the occurrence of an event or incident, often used in a formal or literary context"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "happen",
                                "target_lang_sense_clarification": "to take place"
                            },
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "to take place, especially of an incident"
                            },
                            {
                                "target_lang_word": "transpire",
                                "target_lang_sense_clarification": "to happen or come to pass"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dfcd037b-ba0c-359b-88ea-46d7e43ef8d1",
                    "sense_definition": "het werkelijkheid worden van een situatie of voorspelling",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "gebeuren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat er ook <w>geschiedt</w> in de toekomst, we zullen altijd bij elkaar blijven.",
                            "target_lang_translations": {
                                "en": "Whatever <w>happens</w> in the future, we will always stay together."
                            }
                        },
                        {
                            "text": "In dit oude boek worden de wonderen beschreven die in die dagen <w>geschiedden</w>.",
                            "target_lang_translations": {
                                "en": "In this old book, the miracles are described that <w>came to pass</w> in those days."
                            }
                        }
                    ],
                    "synonyms": [
                        "gebeuren"
                    ],
                    "common_phrases": [
                        "wat er ook geschiedt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in religious or solemn contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the becoming reality of a situation or prophecy, often in a solemn or religious context"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come to pass",
                                "target_lang_sense_clarification": "to happen or be fulfilled"
                            },
                            {
                                "target_lang_word": "befall",
                                "target_lang_sense_clarification": "to happen to someone or something"
                            },
                            {
                                "target_lang_word": "occur",
                                "target_lang_sense_clarification": "to take place"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}