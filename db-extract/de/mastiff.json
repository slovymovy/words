                "senses": [
                    {
                        "sense_id": "9ecffb04-ae67-3353-8355-b35abdbc61de",
                        "entry_id": "f3da2fd1-7ef3-33ab-914a-273c48801816",
                        "glosses": [
                            "britische Hunderasse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69983835-ae23-4fdc-ab9d-7db62e6eb00b",
                                "sense_id": "9ecffb04-ae67-3353-8355-b35abdbc61de",
                                "text": "„All ihre körperlichen Vorzüge wurden jedoch vom Rest ihres Gesichts konterkariert: In sehr jungen Jahren hatte sie der Angriff eines Mastiffs ein Ohr gekostet und ihr beide Wangen zerfetzt; ihre Nase war vollkommen eingefallen (auch das dank ihres Zechers von einem Vater) und sie litt unter einem beständigen Hautausschlag.“"
                            },
                            {
                                "example_id": "19f15362-3c3b-4303-a750-e9b8204f5d05",
                                "sense_id": "9ecffb04-ae67-3353-8355-b35abdbc61de",
                                "text": "„Ein riesiger schwarzer Hund kam vom anderen Ende des Gartens herüberspaziert und rieb den Kopf am Oberschenkel des alten Mannes. Ein reinrassiger Mastiff.“"
                            },
                            {
                                "example_id": "32855fdd-f664-43c5-ad9b-37a215f4e7cf",
                                "sense_id": "9ecffb04-ae67-3353-8355-b35abdbc61de",
                                "text": "„Ein bisschen Glück, und es könnte sein, dass ich es mir in einem bescheidenen ländlichen Ruhesitz gemütlich mache. Ein samtener Hausrock für den Abend, und am Kamin zwei Mastiffs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
