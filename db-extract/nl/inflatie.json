                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "ee75bcab-4fde-4f8d-9fdf-5ec90457bedf",
                        "entry_id": "8b55825b-6709-3569-b1fb-36a07a21cba8",
                        "tags": [
                            "plural"
                        ],
                        "form": "inflaties"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b1cd899-17b1-39da-b880-d3ddf7d8d561",
                        "entry_id": "8b55825b-6709-3569-b1fb-36a07a21cba8",
                        "glosses": [
                            "stijging van het prijspeil, waardoor het geld in waarde daalt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "399d4ddd-40d4-4084-bb7f-65e1f1912515",
                                "sense_id": "1b1cd899-17b1-39da-b880-d3ddf7d8d561",
                                "text": "Wanneer er te veel geld in omloop gebracht wordt ontstaat er hoge inflatie."
                            },
                            {
                                "example_id": "fcbc8387-8b29-4728-a292-882b87ff9604",
                                "sense_id": "1b1cd899-17b1-39da-b880-d3ddf7d8d561",
                                "text": "Door de energiecrisis en de inflatie staat vooral de koopkracht van mensen met een laag of middeninkomen onder druk. Voor de laagste inkomens presenteerde het kabinet dit voorjaar al een pakket van 6 miljard euro. Minima krijgen een energietoeslag van 800 euro, het minimumloon en de AOW worden verhoogd en de energiebelasting wordt verlaagd."
                            },
                            {
                                "example_id": "c306bde5-e011-41a2-9d38-608b39212d8d",
                                "sense_id": "1b1cd899-17b1-39da-b880-d3ddf7d8d561",
                                "text": "De theorie is: hoe hoger de rente, hoe lager de inflatie. Bij een hoge rente verdienen mensen meer aan hun spaargeld, waardoor ze het langer laten staan. Daarnaast wordt lenen fors duurder. Die twee factoren zorgen ervoor dat mensen minder uitgeven en de prijzen dus omlaaggaan."
                            }
                        ]
                    },
                    {
                        "sense_id": "f9a8a6d2-e7a7-38ac-8384-ddea763f33dc",
                        "entry_id": "8b55825b-6709-3569-b1fb-36a07a21cba8",
                        "glosses": [
                            "vermindering in waarde"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a278da50-2750-4a92-b6e4-d97521f9d71e",
                                "sense_id": "f9a8a6d2-e7a7-38ac-8384-ddea763f33dc",
                                "text": "Inflatie van de gele kaart."
                            },
                            {
                                "example_id": "09de6811-36ee-4beb-9f70-cb7f7e072499",
                                "sense_id": "f9a8a6d2-e7a7-38ac-8384-ddea763f33dc",
                                "text": "De betekenis van dat woord is aan inflatie onderhevig."
                            }
                        ]
                    },
                    {
                        "sense_id": "f39b6a49-3937-3af6-b881-122eeab042ad",
                        "entry_id": "8b55825b-6709-3569-b1fb-36a07a21cba8",
                        "glosses": [
                            "opzwellen van een holte of weefsel door gas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "868016fc-1766-4dfc-ae9d-3bf1b577d8a2",
                                "sense_id": "f39b6a49-3937-3af6-b881-122eeab042ad",
                                "text": "Tijdens een astma-aanval is ook een te hoge inflatie van de longen te zien op een röntgenfoto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ceae0401-3f22-4c8f-ac92-7ea2fda48a5a",
                        "source_entry_id": "8b55825b-6709-3569-b1fb-36a07a21cba8",
                        "source_sense_id": "1b1cd899-17b1-39da-b880-d3ddf7d8d561",
                        "source_sense_description": "stijging van het prijspeil waardoor het geld in waarde daalt",
                        "target_lang_word": "Inflation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Inflation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                        "entry_id": "10c1c6d3-ad80-3c16-80a3-8dff434d95f1",
                                        "glosses": [
                                            "anhaltender Anstieg des Preisniveaus einer Ökonomie, verbunden mit einer Verminderung der Kaufkraft der Währung und eines Wachstums der Geldmenge"
                                        ],
                                        "tags": [
                                            "Volkswirtschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c2de7cd-8299-4d88-a531-4b9fa136e50f",
                                                "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                                "text": "„Die Inflation in Deutschland ist 2022 so hoch ausgefallen wie noch nie. Die Verbraucherpreise erhöhten sich um durchschnittlich 7,9 Prozent ….“"
                                            },
                                            {
                                                "example_id": "e54d3160-f0b1-4c27-884a-e8af026bb426",
                                                "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                                "text": "„Wegen der Erfahrungen mit galoppierender Inflation ist der Leitzins in Brasilien traditionell hoch und liegt nun bei acht Prozent, was für brasilianische Verhältnisse ein Rekordtief ist.“"
                                            },
                                            {
                                                "example_id": "7e1613b7-e09a-407a-876c-e4cc8a665ff4",
                                                "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                                "text": "„Noch ehe das Jahr zu Ende geht, im grauen Monat November, dem Monat, in dem sonst gern Revolutionen gemacht werden, wird die Inflation zum Stillstand gebracht.“"
                                            },
                                            {
                                                "example_id": "0a3f1523-23a7-4135-9cc8-0d12c8666f50",
                                                "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                                "text": "„Im Kriegswinter 1920 durchlebte Südrussland eine galoppierende Inflation.“"
                                            },
                                            {
                                                "example_id": "7acfdd5e-fefd-4f0b-9419-859658e49f63",
                                                "sense_id": "f04492ae-a7bc-33c5-b108-53254f6fa46b",
                                                "text": "„Als Retter hatten die Deutschen Hitler begrüßt, der sie aus den politischen Nöten und persönlichen Ängsten erlösen sollte, die der Versailler Friedensvertrag nach dem Ersten Weltkrieg, die Inflation der frühen zwanziger Jahre und die Weltwirtschaftskrise zu Beginn der Dreißiger heraufbeschworen hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                        "entry_id": "10c1c6d3-ad80-3c16-80a3-8dff434d95f1",
                                        "glosses": [
                                            "Periode, während der hohe Inflation [1] herrscht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e146c662-a540-4c4b-b11b-75505983e4b4",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "„Als Retter hatten die Deutschen Hitler begrüßt, der sie aus den politischen Nöten und persönlichen Ängsten erlösen sollte, die der Versailler Friedensvertrag nach dem Ersten Weltkrieg, die Inflation der frühen zwanziger Jahre und die Weltwirtschaftskrise zu Beginn der Dreißiger heraufbeschworen hatte.“"
                                            },
                                            {
                                                "example_id": "8eb590b0-d58d-428c-a0d7-3fcfcbe198da",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "Deutschland erlebte 1923 eine schwere Inflation."
                                            },
                                            {
                                                "example_id": "0647d725-e03c-4884-bd83-a6e0d28221da",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "Während der Inflation in den 20er Jahren im vorigen Jahrhundert waren viele Menschen arbeitslos."
                                            },
                                            {
                                                "example_id": "36de86ab-b593-41dd-83d7-dcdf4926cdbb",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "„Elias Canetti hat in Frankfurt die harte Nachkriegszeit mit aller materiellen und geistigen Not und der Inflation miterlebt.“"
                                            },
                                            {
                                                "example_id": "233becec-6333-4901-b313-59fe2affbdea",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "„Die Inflation ist das beherrschende Thema des Geschehens, lapidar wird von den ansteigenden Selbstmorden der durch die Geldentwertung in den Ruin gestürzten Kleinbürger berichtet.“"
                                            },
                                            {
                                                "example_id": "e118c027-d188-414c-8f3e-44139dde1862",
                                                "sense_id": "886b2fc6-0229-3fbf-8d16-5ce2d0d7a2c6",
                                                "text": "„Die Erfahrung seit dem Zweiten Weltkrieg lehrt: Verteuerungen von Rohstoffen standen häufig am Beginn von Inflationen, aber sie sind gewöhnlich nicht in der Lage, längerfristige Inflationsprozesse im Alleingang zu befeuern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "894b1376-405f-383d-8637-687cf5c61d2d",
                                        "entry_id": "10c1c6d3-ad80-3c16-80a3-8dff434d95f1",
                                        "glosses": [
                                            "starkes Anwachsen der Häufigkeit von etwas"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5a1ee36-115a-4e13-b7ad-a7b68f4fa5c2",
                                                "sense_id": "894b1376-405f-383d-8637-687cf5c61d2d",
                                                "text": "Seit einiger Zeit ist eine Inflation von Sekten zu verzeichnen."
                                            },
                                            {
                                                "example_id": "afae7c64-3cd5-48a0-a02c-608a03dc18a1",
                                                "sense_id": "894b1376-405f-383d-8637-687cf5c61d2d",
                                                "text": "„Er warnt davor, dass die Erweiterung der psychiatrischen Grenzen eine Inflation an psychiatrischen Diagnosen verursachen wird, die zu einer Übertherapie der „eingebildeten Kranken“ führt, wodurch die Psychiatrie nur vom eigentlichen Zweck, nämlich der Behandlung der psychisch schwer Kranken, abgelenkt wird.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6bdabdbe-635f-3d40-bd4f-eb01a47ed7b4",
                                        "entry_id": "10c1c6d3-ad80-3c16-80a3-8dff434d95f1",
                                        "glosses": [
                                            "Phase in der Entwicklung des Universums mit einer sehr schnellen Ausdehnung des Weltraumes, kurz nach dem Urknall"
                                        ],
                                        "tags": [
                                            "Kosmologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f24383ea-826c-421f-8e26-0ee178c80b43",
                                                "sense_id": "6bdabdbe-635f-3d40-bd4f-eb01a47ed7b4",
                                                "text": "„Während dieser sogenannten Inflation dehnte sich das Universum innerhalb von 10⁻³⁵ s bis 10⁻³² s um einen Faktor zwischen 10³⁰ und 10⁵⁰ aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
