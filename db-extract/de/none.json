                "translations": [
                    {
                        "translation_id": "a71f9b1d-46e9-4615-89da-ef6e2ee18ff5",
                        "source_entry_id": "a7392cc9-789e-385d-9189-59f106803675",
                        "source_sense_id": "5fb8bd34-9bf6-3801-9cc2-c2661f7da3cb",
                        "source_sense_description": "Musik: Intervall, das sich aus einer Oktave und Sekunde zusammensetzt",
                        "target_lang_word": "ninth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ninth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23274a8b-655e-3afc-9921-e95bfb4a0640",
                                        "entry_id": "f4352b7e-d936-36b1-a0e4-64cd0809ad57",
                                        "glosses": [
                                            "The ordinal form of the number nine."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf4b09d-7c8d-4c16-9dba-56f1e94ffe36",
                                                "sense_id": "23274a8b-655e-3afc-9921-e95bfb4a0640",
                                                "text": "Ever since El Martinez started asking to be called by the gender-neutral pronouns “they/them” in the ninth grade, they have fielded skepticism in a variety of forms and from a multitude of sources about what it means to identify as nonbinary."
                                            },
                                            {
                                                "example_id": "29a682b5-7aa2-4e8d-9d26-2135d50be3d2",
                                                "sense_id": "23274a8b-655e-3afc-9921-e95bfb4a0640",
                                                "text": "Kash Patel, born to Gujarati parents in New York in 1980, was sworn in as the ninth director of the Federal Bureau of Investigation on Friday, in the presence of his girlfriend Alexis Wilkins and his family."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ninth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5e30671-a962-388e-b932-99d8ae42e0c9",
                                        "entry_id": "e293258f-73ce-3644-ac8c-d5f19877c0dd",
                                        "glosses": [
                                            "The person or thing in the ninth position."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ce0fbc1-6ca3-3974-bee8-c3b5a93adf22",
                                        "entry_id": "e293258f-73ce-3644-ac8c-d5f19877c0dd",
                                        "glosses": [
                                            "One of nine equal parts of a whole."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f08f627a-0907-33fe-a5c1-27c6891ea92c",
                                        "entry_id": "e293258f-73ce-3644-ac8c-d5f19877c0dd",
                                        "glosses": [
                                            "The compound interval between any tone and the tone represented on the ninth degree of the staff above it, as between one of the scale and two of the octave above; the octave of the second, consisting of 13 or 14 semitones (called minor and major ninth)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ninth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "13130532-4d37-335a-a9ce-47804d678663",
                                        "entry_id": "a3465b54-05a8-3c11-b2d8-759eae1be4d3",
                                        "glosses": [
                                            "To lose a ninth."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "558ea0e6-e272-4f82-a818-87bcc7916079",
                                                "sense_id": "13130532-4d37-335a-a9ce-47804d678663",
                                                "text": "οὐ[δ̓] ὲνατεὐεται, should be translated “a tithe (offering or fee) is not given (or paid)”, “no tithing” (literally, “a ninth is not given”, “no ninth-ing”, if I may coin such a word)."
                                            },
                                            {
                                                "example_id": "cdd0f46e-2a7d-4d7f-bae5-f6d6e64e9f59",
                                                "sense_id": "13130532-4d37-335a-a9ce-47804d678663",
                                                "text": "A yearling \"is ninthed\" for Semele on Myconos (LSCG 96.23–24); the victim \"is not ninthed\" for Heracles Thasios"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cab19828-3eee-3e5c-87b9-99883418f09f",
                                        "entry_id": "a3465b54-05a8-3c11-b2d8-759eae1be4d3",
                                        "glosses": [
                                            "To divide by nine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44a48249-21cc-4928-b1f0-11a2ca119340",
                                                "sense_id": "cab19828-3eee-3e5c-87b9-99883418f09f",
                                                "text": "THE NINTHER-MEAN COMBINATION When data are only a little worse than usual, so far as wild and straggling values are concerned, we can do well enough by taking means of the results of ninthing."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
