                "entry_id": "3f22bd73-e5c1-3d99-99fc-56ff550b28db",
                "word": "andermans",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0f94f3ad-7776-3582-80a9-5ac7ac5a0678",
                        "entry_id": "3f22bd73-e5c1-3d99-99fc-56ff550b28db",
                        "glosses": [
                            "someone else's"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0967c3d0-ff0f-4201-8504-be58b18de325",
                                "sense_id": "0f94f3ad-7776-3582-80a9-5ac7ac5a0678",
                                "text": "Hij nam per ongeluk mijn boek mee in plaats van zijn eigen boek, dus nu moet ik andermans boek lezen.",
                                "translation": "He accidentally took my book instead of his own, so now I have to read someone else's book.",
                                "english": "He accidentally took my book instead of his own, so now I have to read someone else's book."
                            },
                            {
                                "example_id": "64ec08c6-a570-45a5-a7c7-1304ce177caa",
                                "sense_id": "0f94f3ad-7776-3582-80a9-5ac7ac5a0678",
                                "text": "Het is onbeleefd om zomaar aan andermans spullen te zitten.",
                                "translation": "It is impolite to touch someone else's belongings without permission.",
                                "english": "It is impolite to touch someone else's belongings without permission."
                            },
                            {
                                "example_id": "06bc18cb-7ed6-4905-a8e1-7125a16d0eb9",
                                "sense_id": "0f94f3ad-7776-3582-80a9-5ac7ac5a0678",
                                "text": "Respecteer de privacy van anderen en lees niet stiekem andermans berichten.",
                                "translation": "Respect others' privacy and don't read someone else's messages secretly.",
                                "english": "Respect others' privacy and don't read someone else's messages secretly."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
