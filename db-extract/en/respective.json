    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                "word": "respective",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2ea023da-f6ae-32bd-afa9-b9061194ab71",
                        "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "glosses": [
                            "Relating to particular persons or things, each to each; particular; own."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "e6cad0ce-9daf-4421-96d1-cf74130ceb1b",
                                "sense_id": "2ea023da-f6ae-32bd-afa9-b9061194ab71",
                                "text": "They returned to their respective places of abode."
                            },
                            {
                                "example_id": "a6a2b262-a612-4446-9295-9b82ee5b15be",
                                "sense_id": "2ea023da-f6ae-32bd-afa9-b9061194ab71",
                                "text": "Adam and Novikovas swapped long-range efforts, neither of which troubled the respective keepers."
                            },
                            {
                                "example_id": "50fc8a7a-be52-4108-b596-aa38249de829",
                                "sense_id": "2ea023da-f6ae-32bd-afa9-b9061194ab71",
                                "text": "Hitachi and CAF have begun a staged return to work at their respective Newton Aycliffe and Newport factories, having reduced output following the COVID-19 outbreak."
                            }
                        ]
                    },
                    {
                        "sense_id": "fe9d43c9-75f2-35d2-ae99-1d427c5d50f2",
                        "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "glosses": [
                            "Noticing with attention; careful; wary."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f55aa3d0-e830-41c3-835a-d921fdca0d62",
                                "sense_id": "fe9d43c9-75f2-35d2-ae99-1d427c5d50f2",
                                "text": "c. 1559-1570, Edwin Sandys, letter to Bernard Gilpin\nBut if you looke upon the estate of the church of England with a respective eye , you cannot with a good conscience refuse this charge imposed upon you"
                            }
                        ]
                    },
                    {
                        "sense_id": "0df955a3-a801-32bf-b42f-58673fc104ba",
                        "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "glosses": [
                            "Looking toward; having reference to; relative, not absolute."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "54c50b97-9f6e-4881-914a-40b6f1dd1a76",
                                "sense_id": "0df955a3-a801-32bf-b42f-58673fc104ba",
                                "text": "the respective connections of society"
                            }
                        ]
                    },
                    {
                        "sense_id": "ec310908-9c00-32df-a8b0-0ae1cc22b830",
                        "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "glosses": [
                            "Fitted to awaken respect."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "dd08d1fe-e9f8-433a-9765-69689a222c40",
                                "sense_id": "ec310908-9c00-32df-a8b0-0ae1cc22b830",
                                "text": "What should it be that he respects in her / But I can make respective in myself,"
                            }
                        ]
                    },
                    {
                        "sense_id": "23fe4f3f-2853-3990-b793-4eaf0353aedf",
                        "entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "glosses": [
                            "Rendering respect; respectful; regardful."
                        ],
                        "tags": [
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2c76b5cb-92cd-432f-9622-5b1d117f942e",
                                "sense_id": "23fe4f3f-2853-3990-b793-4eaf0353aedf",
                                "text": "With a respective shame, rose, took us by the hands."
                            },
                            {
                                "example_id": "e630cb77-b594-4392-befd-1edfd3f432a4",
                                "sense_id": "23fe4f3f-2853-3990-b793-4eaf0353aedf",
                                "text": "a. 1598, William Cecil, 1st Baron Burghley, instructions to his son Robert Cecil, when young\nWith thy equals familiar, yet respective."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d2f21925-a552-42db-b9cb-0616f70799e3",
                        "source_entry_id": "ff81a9ec-d018-36ce-9d2a-7ab9f4971680",
                        "source_sense_description": "referencing two or more things as individuals",
                        "target_lang_word": "achtereenvolgend",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achtereenvolgend",
