            {
                "entry_id": "08840afd-6632-399b-8dc6-f6639da6a9ca",
                "word": "machaon",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "b91f7e6c-ae63-4ccf-90a4-d41df84f1c5a",
                        "entry_id": "08840afd-6632-399b-8dc6-f6639da6a9ca",
                        "tags": [
                            "plural"
                        ],
                        "form": "machaons"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2ea4616-9429-3e62-9c6d-5dedcf11d2d3",
                        "entry_id": "08840afd-6632-399b-8dc6-f6639da6a9ca",
                        "glosses": [
                            "Grand papillon diurne vivement coloré (jaune clair, noir, bleu et rouge), et pourvu d'une queue aux ailes postérieures."
                        ],
                        "tags": [
                            "Lépidoptérologie"
                        ],
                        "examples": [
                            {
                                "example_id": "c3e47fa5-fa7c-4af7-8319-83c4b5601381",
                                "sense_id": "e2ea4616-9429-3e62-9c6d-5dedcf11d2d3",
                                "text": "La chenille du machaon se nourrit sur des ombellifères (apiacées) tel le fenouil."
                            },
                            {
                                "example_id": "2bfabdd1-c4ef-4f65-8aa9-fa3f929ac6cb",
                                "sense_id": "e2ea4616-9429-3e62-9c6d-5dedcf11d2d3",
                                "text": "La chenille du machaon dissuade ses prédateurs naturels grâce à son « osmeterium », organe répulsif bifide orangé, malodorant, et qui se déploie quand elle est agressée."
                            },
                            {
                                "example_id": "c4aa0c29-b913-45a5-915b-76763a5182a0",
                                "sense_id": "e2ea4616-9429-3e62-9c6d-5dedcf11d2d3",
                                "text": "D’un pas bien accordé, ils s’en retournèrent vers les « étaloirs » de liège où séchaient les machaons"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a9453d9-cc69-4189-a975-13727598c6ea",
                        "source_entry_id": "08840afd-6632-399b-8dc6-f6639da6a9ca",
                        "source_sense_id": "e2ea4616-9429-3e62-9c6d-5dedcf11d2d3",
                        "target_lang_word": "Schwalbenschwanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwalbenschwanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "68807c0a-66e8-3abd-994b-65ceca66b9b0",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "der größte Tagfalter Mitteleuropas"
                                        ],
                                        "tags": [
                                            "Entomologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0108af6b-1694-4f71-8457-3d9da0192f95",
                                                "sense_id": "68807c0a-66e8-3abd-994b-65ceca66b9b0",
                                                "text": "Die Raupe des Schwalbenschwanzes lebt an Möhren, Dill und Fenchel."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "Gerät der Holz- oder sonstigen Materialverbindung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36495cf2-0926-41c6-a562-7618ffc628ea",
                                                "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                                "text": "Der Schrank ist mit Schwalbenschwanz verbunden."
                                            },
                                            {
                                                "example_id": "ff3f0c65-8d86-4f5c-a1e5-ec74bb97f0b7",
                                                "sense_id": "81d3d895-7ee0-3352-bd51-3e20d192c627",
                                                "text": "„Und tatsächlich sind ja die Wirbel eine Art Verbindungsteil im Innern des menschlichen Körpers, in einem Gebäude aus Stein erfüllen die Schwalbenschwänze diese Funktion und in Kleidung und Magie sind es die Knoten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "dd4cab61-a9e7-30a1-b306-3a82490bd337",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "geteilte untere Rückenpartie des Fracks oder der Frack selber"
                                        ],
                                        "tags": [
                                            "humorous",
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "01a67b35-0e7f-4985-9265-4a0cdaf3556f",
                                                "sense_id": "dd4cab61-a9e7-30a1-b306-3a82490bd337",
                                                "text": "Herr Puvogel kam in Schwalbenschwanz und Zylinder."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a5829a33-171b-3028-88c9-8288de02197b",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "herabhängendes Band an einer Matrosenmütze"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e508ee8d-3ced-4013-9066-25c3ee9c41fc",
                                                "sense_id": "a5829a33-171b-3028-88c9-8288de02197b",
                                                "text": "Donald Duck trägt eine Matrosenmütze mit Schwalbenschwanz."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "e938b6c1-288e-3170-8b36-7230b14e084f",
                                        "entry_id": "c4d73fbe-f067-32ca-968b-39ab0a981199",
                                        "glosses": [
                                            "Einschnitt am Hinterende eines Skis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52dbee99-e55b-4e32-8370-db2ce28ea2a6",
                                                "sense_id": "e938b6c1-288e-3170-8b36-7230b14e084f",
                                                "text": "Der Schwalbenschwanz verbessert das Verhalten im Pulverschnee."
                                            }
                                        ],
