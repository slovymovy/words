                "senses": [
                    {
                        "sense_id": "217a8220-2eb2-3b5a-9a8f-0f57f72d6dbb",
                        "entry_id": "84b8acbe-8d9a-3d26-a440-f51219d6d66b",
                        "glosses": [
                            "Gerücht, das eine möglicherweise bevorstehende Scheidung zum Thema hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60048ff6-3bab-4704-a5fa-879e67a7d644",
                                "sense_id": "217a8220-2eb2-3b5a-9a8f-0f57f72d6dbb",
                                "text": "„Und auch Stephanies Managerin Beatrice Lamprecht erklärte: „An den Scheidungsgerüchten ist nichts dran. Würden die beiden hier heute mit ihren Kindern auftreten, wenn etwas nicht in Ordnung wäre?““"
                            },
                            {
                                "example_id": "252822e8-14c2-4621-920c-ab7c86afb709",
                                "sense_id": "217a8220-2eb2-3b5a-9a8f-0f57f72d6dbb",
                                "text": "„Baumeister-Gattin Cathy Lugner hat sich gegen die kursierenden Scheidungsgerüchte zur Wehr gesetzt.“"
                            },
                            {
                                "example_id": "33a54921-bbcd-4c2f-b556-a06aec90d06c",
                                "sense_id": "217a8220-2eb2-3b5a-9a8f-0f57f72d6dbb",
                                "text": "„Die Scheidungsgerüchte um Caroline von Monaco und Ernst August von Hannover verstummen nicht.“"
                            },
                            {
                                "example_id": "58c1ac49-e3fc-43ca-9429-71966a6e9d20",
                                "sense_id": "217a8220-2eb2-3b5a-9a8f-0f57f72d6dbb",
                                "text": "„Demzufolge sei jede Information über eine Hochzeit mit Putin falsch. Doch das Scheidungsgerücht hält sich weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
