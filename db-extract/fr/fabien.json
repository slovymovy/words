            {
                "entry_id": "e1b3fcb3-a7d2-3118-982c-9a0730be8524",
                "word": "Fabien",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                        "entry_id": "e1b3fcb3-a7d2-3118-982c-9a0730be8524",
                        "glosses": [
                            "Prénom masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08fc3834-62eb-40da-bb95-4bebf5d07fda",
                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                "text": "« Mon coup de cœur, c’est Camélia Jordana », confie Fabien Gay, qui se réjouit de ce « moment de retrouvailles » après deux ans de Covid-19."
                            },
                            {
                                "example_id": "892f4113-bbdb-4279-a206-2967b952fe8d",
                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                "text": "Fabien Bonnel a encore donné de la voix pour France-Autriche, au cœur des Irrésistibles Français."
                            },
                            {
                                "example_id": "f5d98115-cd09-48b4-b79e-8adc01f46f0a",
                                "sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                                "text": "En tennis de table maintenant, Benoît Froment, de la Fédération française handisport (FFH), donne le nom de Fabien Lamirault et Matéo Bohéas, « les numéros 1 et 5 mondiaux »."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "54c9458b-437e-4a0b-8e30-98d55ac10182",
                        "source_entry_id": "e1b3fcb3-a7d2-3118-982c-9a0730be8524",
                        "source_sense_id": "ba9f0b9d-c102-3a64-bd60-e71680ea1bc8",
                        "target_lang_word": "Fabian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fabian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0a9f95be-69cf-3518-a55e-3470e19f85a0",
                                        "entry_id": "a9133993-51a0-371b-b2af-5d903e9147df",
                                        "glosses": [
                                            "Pertaining to or reminiscent of Roman general Fabius Maximus, whose tactics against Hannibal during the Second Punic War famously consisted of delaying or avoiding combat, focusing instead on weakening the enemy by cutting off supply lines."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e9315a9a-6699-4bfa-9463-8d48465ea2ca",
                                                "sense_id": "0a9f95be-69cf-3518-a55e-3470e19f85a0",
                                                "text": "Hood complained behind his commander's back to Richmond of Johnston's Fabian strategy."
                                            },
                                            {
                                                "example_id": "274d00d2-664e-4ee8-81a3-a61137c095bd",
                                                "sense_id": "0a9f95be-69cf-3518-a55e-3470e19f85a0",
                                                "text": "“This is how I know you've never had an adult relationship. If I say no, then I will be required to say yes to something else in the future, and the stakes in the future might be higher.” “Then say yes.” “If I give in, then I'm no longer the alpha in my house. Before you know it, she'll have me wearing jeans and reading fiction!” “Yeah, well, yes and no are kind of your only two choices.” “For most men, sure. But there is a third option. The Fabian strategy.” “I know this. If an apple and a feather fall at the same time--” “The Fabian strategy derives its name from the Roman general Quintus Fabius Maximus. He ran away, Lemon. Rather than engage in battle, he would retreat and retreat until the enemy grew fatigued and eventually made a mistake. Although I abhor it as a military strategy, it is the basis for all of my, uh, personal relationships.” “So Avery is your enemy. That sounds healthy.” “You're in no position to judge.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a90dc62-b6e9-3979-9366-6aa43d770801",
                                        "entry_id": "a9133993-51a0-371b-b2af-5d903e9147df",
                                        "glosses": [
                                            "Advocating that social reforms be reached through a series of gradual and moderate stages rather than sudden revolution; specifically, relating to the Fabian Society, a British socialist society advocating reformist socialism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "52a2ef26-37e6-3f01-b79c-6a553daf76c6",
                                        "entry_id": "a9133993-51a0-371b-b2af-5d903e9147df",
                                        "glosses": [
                                            "Cautious; dilatory; avoiding a decisive contest."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
