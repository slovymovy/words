                                        "sense_id": "0b990d27-c10c-3125-a209-bf4b23f6d1af",
                                        "entry_id": "3cd922c9-7633-3324-9c8f-f4f3a3198b02",
                                        "glosses": [
                                            "feminino de poeta"
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d66aa2a0-5e4a-4eeb-b9f9-3a804081bbe5",
                                                "sense_id": "0b990d27-c10c-3125-a209-bf4b23f6d1af",
                                                "text": "Mas Verônica Espíndola Vaz, de 39 anos, não é uma poetisa qualquer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eae22515-829b-4866-9775-e5259d10a6c7",
                        "source_entry_id": "ff39791b-1338-3b3d-8fac-9ee0a069989c",
                        "source_sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
                        "target_lang_word": "поэтесса",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "поэтесса",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                        "entry_id": "23a89612-5687-3525-b322-1904d18506eb",
                                        "glosses": [
                                            "женск. к поэт; женщина-поэт"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf26da6c-5624-41d4-841d-a1f210f27590",
                                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                                "text": "Но раз мы услышали, что в Москве застрелилась молодая скромная поэтесса, тихая девушка, и что это самоубийство связано с Брюсовым."
                                            },
                                            {
                                                "example_id": "0807291b-8e18-4b28-bba7-b9964fb2a350",
                                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                                "text": "― Но, правда, эти стихи навеяны мне стихами одной молодой поэтессы."
                                            },
                                            {
                                                "example_id": "e66c445a-677b-4342-a863-557e7e7200c3",
                                                "sense_id": "028ff8ba-6639-32db-b395-fbc7560417d5",
                                                "text": "Она поэтесса, и почти в каждом номере стенной газеты есть ее стихи."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a00f43f6-ca5e-49fd-93b3-fe9a42ef89c8",
                        "source_entry_id": "ff39791b-1338-3b3d-8fac-9ee0a069989c",
                        "source_sense_id": "d411ce05-1c1c-336e-bed5-aa2084f71f37",
