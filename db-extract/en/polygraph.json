    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                "word": "polygraph",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "3664d012-0a12-4240-8ac2-30011b26d567",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "tags": [
                            "plural"
                        ],
                        "form": "polygraphs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ea04685-4cc8-39de-9676-970db1c81a6b",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "A device which measures and records several physiological variables such as blood pressure, heart rate, respiration and skin conductivity while a series of questions is being asked to a subject, in an attempt to detect lies."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e3a8d2d-394b-4a10-bf4c-18e472ab8aec",
                                "sense_id": "4ea04685-4cc8-39de-9676-970db1c81a6b",
                                "text": "It used to be just a plain office with a chair and some instruments on a table. Then they got the new, fancy polygraph system."
                            }
                        ]
                    },
                    {
                        "sense_id": "27ad2067-2076-3e7d-9fd6-54e0fc835a1c",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "A mechanical instrument for multiplying copies of a writing, resembling multiple pantographs."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7e2f355d-064b-3574-886b-a1a31c7ef5d3",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "A collection of different works, either by one or several authors."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "cfbf7f83-9389-3b02-8b06-b3016745bd02",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "A group of letters that represent a single phoneme."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "83dd4107-4e74-3558-9853-d4378ae66a18",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "Any group of letters treated as a single item."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d1574e-dd49-48cd-975b-408309541a46",
                                "sense_id": "83dd4107-4e74-3558-9853-d4378ae66a18",
                                "text": "A polygraph consists of an unspecified number of adjacent letters. A polygraph need not be recognisable as a word in a language but if we are attempting to decipher a message which is expected to be in English and we find the heptagraph MEETING it is much more promising than if we find a heptagraph such as DKRPIGX."
                            }
                        ]
                    },
                    {
                        "sense_id": "c6988c7d-2817-35ea-9948-2445c9c465e4",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "An author who writes on many subjects."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e4cec550-d528-35cd-8fed-cd495bcb33de",
                        "entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "glosses": [
                            "A multidimensional directed graph."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19a33658-d3b5-46e3-b639-bdf733919ed8",
                        "source_entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "source_sense_description": "device to discern if a subject is lying",
                        "target_lang_word": "polygraphe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "polygraphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d7278bea-f833-3232-bc99-c88cd8ab2374",
                                        "entry_id": "fa76e752-3040-3b07-85c6-21938db13722",
                                        "glosses": [
                                            "Auteur qui écrit sur plusieurs matières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3ee3cf-b2a1-4a73-9477-83fd76235418",
                                                "sense_id": "d7278bea-f833-3232-bc99-c88cd8ab2374",
                                                "text": "Les polygraphes forment une classe particulière dans les catalogues des bibliothèques."
                                            },
                                            {
                                                "example_id": "96597559-9a9b-4f66-bb26-c18d0565b4d3",
                                                "sense_id": "d7278bea-f833-3232-bc99-c88cd8ab2374",
                                                "text": "C’est punir en crime un petit délit et faire subir à Stendhal romancier la peine encourue par Stendhal polygraphe."
                                            },
                                            {
                                                "example_id": "6322405f-0ed3-450c-a3b7-8fa07d62745b",
                                                "sense_id": "d7278bea-f833-3232-bc99-c88cd8ab2374",
                                                "text": "On sait que les familles Rousseau et Jarry, lavaloises toutes deux, étaient liées de longue date quand le jeune Alfred, khâgneux du lycée Henry-IV, polygraphe génial, entra dans le champ magnétique d'un peintre qui avait l’âge de son père."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816677bc-9127-36ab-807a-8f31ef02c8c1",
                                        "entry_id": "fa76e752-3040-3b07-85c6-21938db13722",
                                        "glosses": [
                                            "Qui traite de plusieurs sujets sans les maîtriser, en parlant de journalistes."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7a7b9b5a-08ff-3f37-a447-5ef0beb2d786",
                                        "entry_id": "fa76e752-3040-3b07-85c6-21938db13722",
                                        "glosses": [
                                            "Personne qui, avec l’aide d’un ordinateur, compose, organise du texte et des images avant son impression."
                                        ],
                                        "tags": [
                                            "Imprimerie",
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0dde03c-777a-4836-9119-6295fbba0fe9",
                                                "sense_id": "7a7b9b5a-08ff-3f37-a447-5ef0beb2d786",
                                                "text": "Le typographe travaillait avec des caractères en plomb, le polygraphe organise du texte à l’écran."
                                            },
                                            {
                                                "example_id": "6334a30d-e3df-4bb5-af06-7e91eac9583c",
                                                "sense_id": "7a7b9b5a-08ff-3f37-a447-5ef0beb2d786",
                                                "text": "Le/La polygraphe prépare des documents graphiques incluant des textes et des images"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "polygraphe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01025748-7846-38dd-9934-e1ca974a2117",
                                        "entry_id": "956777db-8b68-336b-9ddf-af5fe6fe9405",
                                        "glosses": [
                                            "Appareil électronique qui enregistre plusieurs valeurs physiologiques ; il est parfois utilisé comme détecteur de mensonges."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02ec45d0-e0e4-46b7-8715-121b9de063c3",
                                                "sense_id": "01025748-7846-38dd-9934-e1ca974a2117",
                                                "text": "Au début des années 1960, un sujet passionnait la presse nationale : fallait-il, oui ou non, introduire le détecteur de mensonges dans la procédure criminelle ? L’opinion publique semblait favorable à l’usage de cet outil, appelé polygraphe, censé permettre, grâce à la mesure des pulsions cardiaques, de la respiration et de la sudation, de confondre n’importe quel suspect."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29791d84-92ac-4b7f-a7c0-beff479cff37",
                        "source_entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "source_sense_description": "device to discern if a subject is lying",
                        "target_lang_word": "détecteur de mensonges",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "détecteur de mensonges",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32889f06-ff75-34d5-87ef-1e9fecf3f5ae",
                                        "entry_id": "51412d7b-a1d7-3694-8b76-9e97403c929d",
                                        "glosses": [
                                            "Dispositif qui mesure les réactions physiologiques de l'humain (pouls, sueur, etc.) pour détecter si le sujet ment ou non."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff294cce-0a1b-45d2-a599-fc2ea4dc6b45",
                                                "sense_id": "32889f06-ff75-34d5-87ef-1e9fecf3f5ae",
                                                "text": "Dans l'article, Blackburn écrit : « L'enquêteur privé John Harrison est un spécialiste des interrogatoires au détecteur de mensonges depuis plus de quarante ans. »"
                                            },
                                            {
                                                "example_id": "8c9835f0-140d-44f2-90aa-509b1e402a40",
                                                "sense_id": "32889f06-ff75-34d5-87ef-1e9fecf3f5ae",
                                                "text": "En poussant sa théorie des émotions jusqu'à sa conclusion logique, Trivers fait observer que, dans un monde de détecteurs de mensonges ambulants la meilleure stratégie consiste à croire ses propres mensonges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "76fce61b-88ea-461c-9510-8cde64515e44",
                        "source_entry_id": "43e2ba1b-db9c-35ca-8f45-8e00f1610f7a",
                        "source_sense_description": "device to discern if a subject is lying",
                        "target_lang_word": "Lügendetektor",
