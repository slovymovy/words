                "senses": [
                    {
                        "sense_id": "a6a7f9c3-2aaf-3a77-968d-e0ccfcdaac36",
                        "entry_id": "281a98c9-d0c4-3a78-a83c-41ba6d963f58",
                        "glosses": [
                            "Donner un caractère nanotechnologique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "238ed0db-3c5e-499d-b570-da8dcad25c2f",
                                "sense_id": "a6a7f9c3-2aaf-3a77-968d-e0ccfcdaac36",
                                "text": "Mon amour géocalise moi! Nanotechnologise moi!"
                            },
                            {
                                "example_id": "b086c00d-5c93-49d3-be87-f19fd187565a",
                                "sense_id": "a6a7f9c3-2aaf-3a77-968d-e0ccfcdaac36",
                                "text": "Tant qu'on ne me nanotechnologise pas mon salaire en guise de retour de bâton, moi je suis pour."
                            },
                            {
                                "example_id": "c8e19be1-73cb-43b5-bef6-658eda2c2c96",
                                "sense_id": "a6a7f9c3-2aaf-3a77-968d-e0ccfcdaac36",
                                "text": "Tour à tour simulacre, monstre issu d’un dérèglement social et scientifique, chose informe faisant voler en éclat le concept d’une identité close et unifiée, l’être biomécanique au corps modifié, nanotechnologisé, nous questionne sur ces constructions fabuleuses que nos sociétés modernes mondialisées élaborent et diffusent."
                            },
                            {
                                "example_id": "ffed1492-966a-4ea7-9f93-447d802ffcbc",
                                "sense_id": "a6a7f9c3-2aaf-3a77-968d-e0ccfcdaac36",
                                "text": "On peut modeler le paysage, \"nano- ou biotechnologiser\", souhaiter régler le thermostat du réchauffement climatique."
                            }
                        ]
                    }
