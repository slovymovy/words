                    "sense_id": "289a2ef5-e857-33d6-aa41-7f0747ec2302",
                    "sense_definition": "Without meaning to; in a way that is not deliberate or planned.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>unintentionally</w> deleted the important document while cleaning her computer desktop. ",
                            "target_lang_translations": {
                                "tr": "Bilgisayarının masaüstünü temizlerken önemli belgeyi <w>istemeden</w> sildi.",
                                "fr": "Elle a <w>involontairement</w> supprimé le document important en nettoyant le bureau de son ordinateur.",
                                "zh": "她在清理电脑桌面时<w>不小心</w>删除了那份重要文件。"
                            }
                        },
                        {
                            "text": "He made an <w>unintentionally</w> rude comment, but he apologized as soon as he realized his mistake.",
                            "target_lang_translations": {
                                "tr": "<w>İstemeden</w> kaba bir yorumda bulundu ancak hatasını anlar anlamaz özür diledi.",
                                "fr": "Il a fait une remarque <w>involontairement</w> blessante, mais il s'est excusé dès qu'il a pris conscience de son erreur.",
                                "zh": "他<w>无意中</w>说了一句冒犯的话，但一意识到自己的错误就立刻道歉了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "accidentally",
                        "unwittingly",
                        "inadvertently"
                    ],
                    "antonyms": [
                        "intentionally"
                    ],
                    "common_phrases": [
