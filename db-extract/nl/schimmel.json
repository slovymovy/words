                    },
                    {
                        "form_id": "4f355b2d-86ba-4a3c-93f3-f98efb707679",
                        "entry_id": "8ae701ef-16ac-3c0d-bbf3-2cb4ee86c90c",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "schimmeltjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9fca4a5b-8ef7-33e4-8605-8e70fe637cf8",
                        "entry_id": "8ae701ef-16ac-3c0d-bbf3-2cb4ee86c90c",
                        "glosses": [
                            "paardenras met een grotendeels witte vacht met fijne grijze of blauwige tekening"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94754cad-5598-4c61-a7f7-629f3263d80b",
                                "sense_id": "9fca4a5b-8ef7-33e4-8605-8e70fe637cf8",
                                "text": "Sinterklaas rijdt op een schimmel over de daken."
                            },
                            {
                                "example_id": "e6052237-616d-4bd2-b053-3ccaf1f41203",
                                "sense_id": "9fca4a5b-8ef7-33e4-8605-8e70fe637cf8",
                                "text": "Uw witte schimmel is zwaar ziek, het zal zeker zes weken duren voordat hij weer beter is. En het is het enige paard dat over de daken kan rijden!'"
                            },
                            {
                                "example_id": "247412f4-c2cd-4023-9f59-8aaaa08149bc",
                                "sense_id": "9fca4a5b-8ef7-33e4-8605-8e70fe637cf8",
                                "text": "‘Ze hebben een temperamentje, net als mijn vrouw!’ Hij aaide de schimmel over zijn neus, die in de handschoen van de man probeerde te bijten."
                            }
                        ]
                    },
                    {
                        "sense_id": "50de88eb-0b66-3b02-8923-c48270a83eee",
                        "entry_id": "8ae701ef-16ac-3c0d-bbf3-2cb4ee86c90c",
                        "glosses": [
                            "zwamsoort of substantie die op dode of levende organismen groeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9724ef0-3bbe-4c45-a8df-1ba8a71dab6a",
                                "sense_id": "50de88eb-0b66-3b02-8923-c48270a83eee",
                                "text": "Op dat blok kaas zit groene schimmel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a127448-7be7-431e-a348-d9fa5b9a3cc1",
                        "source_entry_id": "8ae701ef-16ac-3c0d-bbf3-2cb4ee86c90c",
                        "source_sense_id": "9fca4a5b-8ef7-33e4-8605-8e70fe637cf8",
                        "source_sense_description": "paardenras met een grotendeels witte vacht met fijne grijze of blauwige tekening",
                        "target_lang_word": "Schimmel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schimmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bcfcf49e-99bd-3de1-9990-739a9e31444e",
                                        "entry_id": "411f0744-ebb6-3640-94cd-af56d2490e6b",
                                        "glosses": [
                                            "weißes Pferd"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec8ed220-37d0-4479-ac2a-5f8204d22791",
                                                "sense_id": "bcfcf49e-99bd-3de1-9990-739a9e31444e",
                                                "text": "„Mata, eine hübsche, hellhäutige Frau, saß auf einem Schimmel; Grifone, ein muskulöser, dunkelhäutiger Mann, auf einem Rappen.“"
                                            },
                                            {
                                                "example_id": "31a8a682-572b-498d-8879-71a1444b3589",
                                                "sense_id": "bcfcf49e-99bd-3de1-9990-739a9e31444e",
                                                "text": "„Ihm folgen auf einem bräunlichen und rötlichen Schimmel ein Offizier und ein weiterer Adjutand.“"
                                            },
                                            {
                                                "example_id": "540a652f-134a-4630-b35b-104fdbe5b62f",
                                                "sense_id": "bcfcf49e-99bd-3de1-9990-739a9e31444e",
                                                "text": "„Tagaus, tagein ritt nun Simen Tjing zum Amt auf stattlichem Schimmel.“"
                                            },
                                            {
                                                "example_id": "9ab2ee96-52c4-4c5d-99a3-8f2626cf90a4",
                                                "sense_id": "bcfcf49e-99bd-3de1-9990-739a9e31444e",
                                                "text": "„Senta wird auch den alten Landbriefträger verpasst haben, der sich jeden Morgen nach der Ablieferung der Post in der Küche stärkte und immer auf dasselbe Thema zu sprechen kam: Er wünschte sich, dass der Gutsherr, den er wegen gemeinsamer Erfahrungen im Ersten Weltkrieg unbelehrbar als »Herr Hauptmann« ansprach, seine vier legendären Schimmel zur Verfügung stellen möge, sollte die Zeit gekommen sein und sein Leichenwagen durch Friedland gezogen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Schimmel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9548c3d4-fa4b-3a69-b7fb-18b22f7f78fe",
                                        "entry_id": "b718b75f-6a39-3a0e-a8cf-8777c97b78ac",
                                        "glosses": [
                                            "Pilz, dessen Fruchtkörper das Aussehen von einem weißlichen bis grünlichen Belag hat"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c8f7609-d95b-4ea9-aef7-59513114daa2",
                                                "sense_id": "9548c3d4-fa4b-3a69-b7fb-18b22f7f78fe",
                                                "text": "Das Brot ist voller Schimmel."
                                            },
                                            {
                                                "example_id": "3e3f4f01-4ce0-4925-8ebf-71af61dc08dc",
                                                "sense_id": "9548c3d4-fa4b-3a69-b7fb-18b22f7f78fe",
                                                "text": "„Ein grüngrauer Schimmel wuchs inzwischen sogar auf diesem Humus.“"
                                            },
                                            {
                                                "example_id": "ac7ee6e0-8385-471f-9137-bf1f08c01737",
                                                "sense_id": "9548c3d4-fa4b-3a69-b7fb-18b22f7f78fe",
                                                "text": "„Schimmel fraß an den Pappkartons und Spinnen huschten über die Wände.“"
                                            },
                                            {
                                                "example_id": "230df6a4-8fd7-4d98-a2a2-5410bc5f5544",
                                                "sense_id": "9548c3d4-fa4b-3a69-b7fb-18b22f7f78fe",
                                                "text": "„Die meisten Fenster sind zersprungen, an zahlreichen Stellen regnet es durch, das schadhafte Dach, die kostbaren Möbel und Tapeten sind von Schimmel überzogen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
