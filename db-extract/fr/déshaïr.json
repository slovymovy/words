                "senses": [
                    {
                        "sense_id": "9806277c-1585-3ef7-9132-93dbdcd8266e",
                        "entry_id": "34d34b32-c2ce-3dfd-a425-08dc2c21c7fa",
                        "glosses": [
                            "Cesser d’haïr, ne plus haïr."
                        ],
                        "tags": [
                            "Extrêmement rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3748e9ed-5d6c-4264-9dcf-d8dddf53de0b",
                                "sense_id": "9806277c-1585-3ef7-9132-93dbdcd8266e",
                                "text": "Et pour la couleur des yeux, tu peux me déshaïr tout de suite."
                            },
                            {
                                "example_id": "22131f82-4f82-4137-8485-3effb3a61458",
                                "sense_id": "9806277c-1585-3ef7-9132-93dbdcd8266e",
                                "text": "Le langage des ’Wari du Brésil offre une belle illustration de cette structure : «aimer, penser à quelqu’un avec nostalgie» s’y exprime par une locution qui, littéralement, signifie «cesser de ressentir de la rage», en somme «déshaïr»."
                            },
                            {
                                "example_id": "5153bea1-de74-4a5e-b310-5e0eeb265e47",
                                "sense_id": "9806277c-1585-3ef7-9132-93dbdcd8266e",
                                "text": "J'apprendrai à déshaïr les meufs. … Elle va m’aider car je vais la déshaïr."
                            }
                        ]
                    }
                ],
