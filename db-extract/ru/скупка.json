                    {
                        "translation_id": "1487bee2-b245-4971-ada6-75d97a498d37",
                        "source_entry_id": "045180fa-43fa-386f-b632-fad23bf28afa",
                        "source_sense_description": "действие",
                        "target_lang_word": "achat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achat",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                        "entry_id": "9b13e957-1753-3203-8ada-ee13bad6a622",
                                        "glosses": [
                                            "Acquisition faite à prix d’argent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec093afa-9f37-429b-82cd-b4365df221d3",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Faire achat de marchandises."
                                            },
                                            {
                                                "example_id": "8584e6f4-2368-451a-bd17-741d9a07d8d1",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Ce jeudi 9 janvier, la plus haute juridiction de l’Union européenne a statué que le fait d’exiger des passagers ferroviaires qu’ils déclarent leur genre lors de l’ achat d’un billet était contraire au règlement général sur la protection des données (RGPD) de l’UE."
                                            },
                                            {
                                                "example_id": "5b910bf9-2b53-48e5-94b2-2b6453ca5799",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Je renonce à faire des achats cette année."
                                            },
                                            {
                                                "example_id": "767b9cd6-91fe-4f90-8295-b74a8acaedcf",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat avantageux."
                                            },
                                            {
                                                "example_id": "88181abf-577c-4d0d-9a48-24d118feb7b9",
                                                "sense_id": "e3554545-47d1-3c16-a7b3-13fee85556de",
                                                "text": "Un achat durable est un achat qui est respectueux de l’environnement, des lois sociales et de l’éthique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82e16234-e47e-33c2-96ce-023abcbe2641",
                                        "entry_id": "9b13e957-1753-3203-8ada-ee13bad6a622",
                                        "glosses": [
                                            "Chose achetée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52052fe9-b38d-4744-82de-a872847d05ab",
                                                "sense_id": "82e16234-e47e-33c2-96ce-023abcbe2641",
                                                "text": "Je veux vous faire voir mon dernier achat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98d7f3bf-d1c2-44ae-b24b-adb7988e8ca2",
                        "source_entry_id": "045180fa-43fa-386f-b632-fad23bf28afa",
                        "source_sense_description": "действие",
                        "target_lang_word": "accaparement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "accaparement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                        "entry_id": "227329ed-b941-3c9f-b970-899bf65c5d21",
                                        "glosses": [
                                            "Action d’accaparer ; résultat de cette action."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f81e837-a247-43df-8114-1298f0ae8bc6",
                                                "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                                "text": "[…], M. Smallways se livrait à l’horticulture, sur ce dernier bout de terrain investi de jour en jour plus étroitement par les accaparements urbains."
                                            },
                                            {
                                                "example_id": "37b1c0d2-0ab5-45ae-a8a5-b8d7407d33b4",
                                                "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                                "text": "En effet, les contrats de vente et d'achat ne servaient qu'à légaliser un accaparement opéré au détriment du petit paysan."
                                            },
                                            {
                                                "example_id": "8703dd6e-4300-4b79-88ec-3b91a17b6e53",
                                                "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                                "text": "L’accaparement des terres agricoles par les grands producteurs n’est pas le seul problème, soulignent les auteurs."
                                            },
                                            {
                                                "example_id": "0e62e146-4cc9-4855-adb1-fb1b93dc361c",
                                                "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                                "text": "L’accaparement toujours plus grand des richesses par une minorité dans plusieurs démocraties et les conséquences catastrophiques de cet accaparement sur le niveau de vie permettent à la Chine de se proposer en modèle alternatif aux démocraties."
                                            },
                                            {
                                                "example_id": "51645dbf-2f8f-4feb-abfa-ad16741591f0",
                                                "sense_id": "e35cc977-369a-3e6d-b4cf-51cc8a07c43a",
                                                "text": "Des accaparements de blés, de farines."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
