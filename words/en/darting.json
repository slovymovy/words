                                "target_lang_sense_clarification": "dicho de un movimiento súbito y veloz"
                            },
                            {
                                "target_lang_word": "esquivo",
                                "target_lang_sense_clarification": "inquieto o veloz"
                            },
                            {
                                "target_lang_word": "punzante",
                                "target_lang_sense_clarification": "dicho de dolores agudos y repentinos"
                            }
                        ]
