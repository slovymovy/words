    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                "word": "untruthful",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "396d6090-2e16-41af-8188-7eb4770d53f3",
                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more untruthful"
                    },
                    {
                        "form_id": "0e3e6b8d-701e-42ac-9113-b9b7c0ee4d2e",
                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most untruthful"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "glosses": [
                            "Not giving the truth; providing untrue facts; lying."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43e0718e-23b0-4bda-be56-ee5ac3311ca5",
                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                "text": "Cousin, good night; / And whatsoe’er be told of me henceforth, / A most untruthful annalist were he, / Who said I did not love my cousin Anna."
                            },
                            {
                                "example_id": "6ab55e29-3bb2-4942-9ac5-0d8173d6298e",
                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                "text": "Upon principle it is his aim to exhibit integrity of dealing, honest and godly sincerity to all men; if he fail, it must be in degree, it cannot be in kind; for a false and untruthful mind can never rightly know God; the more we know of him, the more upright and ingenuous, and liberal, and kind, and humane, and generous, must be our conduct to man."
                            },
                            {
                                "example_id": "768e310b-953b-453c-8463-8914371ab2e4",
                                "sense_id": "3f999066-790f-346d-96b5-03da820b8789",
                                "text": "He who obeys not the good Shepherd of the soul and heart has an untruthful mind; a mind filled with fallacies; a mind of wrong resolvings and concludings."
                            }
                        ]
                    },
                    {
                        "sense_id": "14dfa14d-3abf-3a71-b9c6-6aa49aec1569",
                        "entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "glosses": [
                            "Pertaining to falsehood; corrupt; dishonest."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7d5fe85-4f2b-4895-8b9f-a56898153abb",
                                "sense_id": "14dfa14d-3abf-3a71-b9c6-6aa49aec1569",
                                "text": "But what was our astonishment when the “Seven Letters by Anglicanus” made their appearance amongst us, accompanied by the report that you—one of our brethren—was the author of that untruthful, bitter, and malignant publication!"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f2bc4ab7-388f-415f-8476-60f6083b4e61",
                        "source_entry_id": "39b299fc-ed59-3519-bafb-b090d7a92daa",
                        "source_sense_description": "not giving the truth, lying",
                        "target_lang_word": "menteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "menteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                        "entry_id": "dd03b8ee-2a88-33f1-bb17-e0f67c0e5182",
                                        "glosses": [
                                            "Qui ment, qui a l’habitude de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "147133c2-2e5f-41c2-9044-b471b44f8e34",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Une femme menteuse."
                                            },
                                            {
                                                "example_id": "5051e98c-1daf-4bd6-a153-e8de00c3b701",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Langage menteur."
                                            },
                                            {
                                                "example_id": "6a0b5ca3-25f7-46a0-a9cc-ae5af676737f",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Physionomie menteuse."
                                            },
                                            {
                                                "example_id": "254936fa-9c23-43c1-8f22-57e299909090",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Menteur comme un arracheur de dents."
                                            },
                                            {
                                                "example_id": "c4ee3136-162e-4ee1-b231-2ee3efa9030e",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Robespierre enfin fit rédiger par Saint-Just l’acte d’accusation le plus menteur, le plus violent, le plus haineux, le plus infâme, par lequel on reprochait à Danton et à ses compagnons d’être royalistes."
                                            },
                                            {
                                                "example_id": "5604a864-de5b-4b45-abc1-23dd428bf41b",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Il ne savait donc rien, cet homme ! Toute sa science était donc menteuse, puisqu’il ne pouvait d’un coup d’œil distinguer la vie de la mort !"
                                            },
                                            {
                                                "example_id": "f812fe57-9b90-4290-9924-761d53cad776",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Un fiancé se dupe aisément ; mais un mari ! N’importe qui sait proférer des paroles menteuses ; les mensonges du corps exigent une autre science. Mimer le désir, la joie, la fatigue bienheureuse, cela n’est pas donné à tous."
                                            },
                                            {
                                                "example_id": "3fccbefe-d19d-4537-b184-aec94d4816cd",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Quoi de plus simple que de mimer la loyauté, elle n’est jamais plus vraie que dans les bouches menteuses."
                                            },
                                            {
                                                "example_id": "eeb08a8e-c4f8-4278-8c7e-b986be6a42be",
                                                "sense_id": "9fcf34e2-d95e-3d20-80f1-21842dfda232",
                                                "text": "Frapper quelqu'un qui vous a traité de menteur ne prouve pas que vous avez dit la vérité."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "menteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                        "entry_id": "09760989-2ab7-3efd-a33c-3764f8cb5c76",
                                        "glosses": [
                                            "Personne qui ment, qui a l’habitude de mentir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a267181-f480-40e8-be9e-d4c280d79cf0",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "De l’autre côté, quelques-uns parmi nous discutaient s’il fallait ajouter foi aux affirmations du criminel qui s’était montré menteur incorrigible."
                                            },
                                            {
                                                "example_id": "d8df8b8b-e2ed-4c6e-a8bd-8a1ecf042b83",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "Sommeil impossible pour quatre, car Laurent ronfle. Nous vérifions enfin sur lui l’affirmation classique des ronfleurs qui ne ronflent prétendent-ils, que couchés sur le dos. Les ronfleurs sont des menteurs : Laurent ronfle quand nous le tournons sur le côté droit, et sur le côté gauche, et sur le ventre."
                                            },
                                            {
                                                "example_id": "7723c31c-bfc4-488a-a327-b71a45228414",
                                                "sense_id": "4a3b31d6-6898-3bd9-9f2e-4e3283f096aa",
                                                "text": "« Ne faites pas attention, il est extrêmement blagueur », dit-il à mi-voix à Saint-Loup qui n’en fut que plus intéressé, étant très curieux de la psychologie des menteurs. — Plus menteur encore que l’Ithaquesien Odysseus qu’Athènes appelait pourtant le plus menteur des hommes, compléta notre camarade Bloch."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdfa8939-0744-3b01-b8a9-47b13a314dce",
                                        "entry_id": "09760989-2ab7-3efd-a33c-3764f8cb5c76",
                                        "glosses": [
                                            "Jeux de cartes se jouant à cartes face cachée (sauf la première). À tout moment, on peut accuser un des joueurs de mentir après qu’il a posé sa carte, d’où le nom du jeu."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
