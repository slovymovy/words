                "senses": [
                    {
                        "sense_id": "142df390-772e-324f-af52-fd9450fd4530",
                        "entry_id": "e42cd2dc-c19e-3e47-b615-16399bacb037",
                        "glosses": [
                            "Grundstück, das für einen (Neu-)Bau bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a718683d-52cc-4ca3-9465-77260df2c559",
                                "sense_id": "142df390-772e-324f-af52-fd9450fd4530",
                                "text": "Dies ist mein Bauplatz."
                            },
                            {
                                "example_id": "7f8887a0-5b54-4cc6-befe-41a6ff83ad86",
                                "sense_id": "142df390-772e-324f-af52-fd9450fd4530",
                                "text": "Am vergangenen Sonnabend, ab 10.30 Uhr, versammelten sich etwa 1.300 Katholiken der Stadt Leipzig auf dem künftigen Bauplatz der neuen Leipziger Propstei, um das Foto für das Werbeplakat zur deutschlandweiten Kollekte machen zu lassen."
                            },
                            {
                                "example_id": "0dd1750e-8de4-4d0e-a85d-e493f3c3ae4e",
                                "sense_id": "142df390-772e-324f-af52-fd9450fd4530",
                                "text": "„Wir wollten uns den Bauplatz für seine Kirche ansehen.“"
                            },
                            {
                                "example_id": "9329a80b-9981-49c4-b257-17032194971f",
                                "sense_id": "142df390-772e-324f-af52-fd9450fd4530",
                                "text": "„Aber wenigstens sind die Bauplätze billig.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
