                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f5be05-8b56-42b6-bcfe-4a584eaea581",
                                "sense_id": "80ca9c50-ca88-37a8-8d52-f86a2a60e80c",
                                "text": "On the 28th April a cossid arrived here from the Sirdars of Candahar, with letters from Dost Mahomed Khan, and Nawab Jubbar Khan."
                            },
                            {
                                "example_id": "7e7c3bd3-c9c9-479e-8ddd-5883c916f85a",
                                "sense_id": "80ca9c50-ca88-37a8-8d52-f86a2a60e80c",
                                "text": "As elsewhere, contact was maintained by means of fleet-footed messengers, known as cossids, who took their lives in their hands running the gauntlet with secret despatches concealed on them."
                            }
                        ]
                    }
