                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Deutschschweiz"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                        "entry_id": "084f292c-d4d4-38ea-b025-15642d3f0a86",
                        "glosses": [
                            "der Teil der Schweiz, in dem überwiegend Deutsch gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9308126f-921b-440b-83e0-a1126f5674d7",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Der letzte Sonntagsverkauf in diesem Jahr hat in der Deutschschweiz und im Tessin Zehntausende in die Läden gelockt.“"
                            },
                            {
                                "example_id": "7141a511-836d-4162-aa1b-75ba5c8df924",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Ein Café Crème kostete 2010 in der Deutschschweiz durchschnittlich 3.95 Franken.“"
                            },
                            {
                                "example_id": "4f3aa5db-1fc8-487d-810a-dfbf7114acc1",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Erst als er im März eine Debatte über den Gebrauch der Mundart in der Deutschschweiz losgetreten habe, hätten die Deutschschweizer Medien über ihn berichtet.“"
                            },
                            {
                                "example_id": "461e9cbd-0c16-46bb-84d5-d2b916585ac9",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Über 50 Organisationen in der Deutschschweiz und Liechtenstein beteiligten sich neben tausenden Organisationen weltweit mit Aktivitäten gegen Gewalt an Frauen.“"
                            },
                            {
                                "example_id": "8dde58bc-9630-4b43-b8b8-e51c35590971",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Die Kapuziner in der Deutschschweiz sind mit dem Echo auf ihr Stelleninserat zufrieden. Mit den drei bis fünf Männern, welche die Kriterien erfüllten, würden nun Gespräche geführt.“"
                            },
                            {
                                "example_id": "894e80a3-1256-4522-96b7-edcd96e393e3",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Insgesamt 234 Kinder und Jugendliche aus 16 Kantonen der Deutschschweiz weilen zwischen Weihnachten und Neujahr auf dem Glaubenberg oberhalb von Sarnen, um an fünf Tagen verschiedene Wintersportarten auszuprobieren oder sich zu verbessern.“"
                            },
                            {
                                "example_id": "2a1a0c13-7ce6-45d1-baf7-53257d44460d",
                                "sense_id": "143a804b-1b3e-3bde-87b8-61444365d355",
                                "text": "„Karl Moser und sein von 1888 bis 1915 in Karlsruhe zusammen mit Robert Curjel betriebenes Büro bauten vornehmlich in Südwestdeutschland und der Deutschschweiz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
