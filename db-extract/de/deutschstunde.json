                "senses": [
                    {
                        "sense_id": "cf08e1c6-121a-3f8a-96cc-436551e92d83",
                        "entry_id": "72a10c7f-909a-3647-a05e-85df6e6f956f",
                        "glosses": [
                            "Unterrichtsstunde im Fach Deutsch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "262ac963-4000-44d5-90fe-7b5c2b0b05ab",
                                "sense_id": "cf08e1c6-121a-3f8a-96cc-436551e92d83",
                                "text": "„Aber ich muß die doppelte Deutschstunde nachholen, muß die Arbeit liefern, die ein hagerer, schreckhafter Doktor Kurbjuhn und unser Direktor Himpel von mir erwarten.“"
                            },
                            {
                                "example_id": "36c9cddb-08e9-4437-b0c4-8ed484471009",
                                "sense_id": "cf08e1c6-121a-3f8a-96cc-436551e92d83",
                                "text": "„Wenn Sie solche Deutschstunden eines gelehrt haben, dann dass Grammatik eine akademische Übung ist, bei der Situationen der Sprache mit nichtsnutzigen Namen durchetikettiert werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
