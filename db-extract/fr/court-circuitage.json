                "senses": [
                    {
                        "sense_id": "49ec5a9b-5668-3670-9a35-98037be223e7",
                        "entry_id": "4ef2deec-d7ae-3594-94d8-113158323ac0",
                        "glosses": [
                            "Action de court-circuiter."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "3c5a8825-8742-4c03-805a-6d38b7d236a0",
                                "sense_id": "49ec5a9b-5668-3670-9a35-98037be223e7",
                                "text": "Ce n'est probablement pas dans le « court-circuitage » de la hiérarchie traditionnelle des échanges, explication qui spontanément vient à l'esprit, qu'il faut chercher l'origine des critiques formulées contre l'usage d'Internet."
                            },
                            {
                                "example_id": "18bac76f-c9eb-49f2-99c8-204937df0be2",
                                "sense_id": "49ec5a9b-5668-3670-9a35-98037be223e7",
                                "text": "Le projet en cours d'exécution est un cas typique de court-circuitage du circuit inférieur de l'économie, dans le but de faciliter la diffusion du grand capital dans l'espace, mais aussi un cas de court-circuitage du projet politico-économique du gouvernement."
                            },
                            {
                                "example_id": "c10d0288-e54b-4341-a262-9634d88c3fe8",
                                "sense_id": "49ec5a9b-5668-3670-9a35-98037be223e7",
                                "text": "Ailleurs, il dénonce certains court-circuitages de l'aide. Combien de millions accordés à tel ou tel pays pour tel projet n'ont-ils pas été déroutés par tel ou tel ministre, président ou dictateur ?"
                            }
                        ]
                    }
