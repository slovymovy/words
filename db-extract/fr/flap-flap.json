                            {
                                "example_id": "5b8b36c2-a307-4547-9f0d-c0acfe5973ef",
                                "sense_id": "e08c310b-69d9-3545-a7e6-f48857913f9a",
                                "text": "Le flap-flap de l’eau tombant dans le bassin, les mouvances des rides de soleil sur la surface, la bordure de mousse verte le long de la pierre me captivaient autant que la fraîcheur de la coulée."
                            },
                            {
                                "example_id": "ab7cc3b1-996a-4891-bcd6-c0fda7173591",
                                "sense_id": "e08c310b-69d9-3545-a7e6-f48857913f9a",
                                "text": "Il entendit soudain le flap-flap des pales d’hélicoptère, mais l’appareil demeura invisible."
                            },
                            {
                                "example_id": "24445963-4eb3-4e0c-8dde-c94d9fcc032f",
                                "sense_id": "e08c310b-69d9-3545-a7e6-f48857913f9a",
                                "text": "L’habitacle fut secoué de convulsions démentes et ils perçurent distinctement le flap-flap hargneux du rotor."
