                                "target_senses": [
                                    {
                                        "sense_id": "98a20bc5-a39b-3248-a131-3a100950da8c",
                                        "entry_id": "abe12a52-8dbd-3f2e-8cdc-7ac61882ce16",
                                        "glosses": [
                                            "Fluss in Kärnten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34ac47d0-e0b4-46fb-a4c4-d60954bff640",
                                                "sense_id": "98a20bc5-a39b-3248-a131-3a100950da8c",
                                                "text": "Am Sonntag radeln wir zu den Wasserfällen der Malta."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Malta",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f323c3ce-cb22-35d9-9c81-e16d79618843",
                                        "entry_id": "de396c34-6bae-31b9-a502-f80fb5efb6f9",
                                        "glosses": [
                                            "eine Insel im Mittelmeer"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ba8b95-41cc-4b2e-8792-33e375114da4",
                                                "sense_id": "f323c3ce-cb22-35d9-9c81-e16d79618843",
                                                "text": "„Auf der Insel Malta leben etwa 357.000 Einwohner, das sind 90 Prozent der Gesamtbevölkerung des Staatswesens.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "074915f0-2c6c-3df3-b355-8dd543735385",
                                        "entry_id": "de396c34-6bae-31b9-a502-f80fb5efb6f9",
                                        "glosses": [
                                            "europäischer Inselstaat, der die Inseln Malta, Gozo, Comino, Cominotto, Filfla und St. Paul’s Islands umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4319f12-3c5b-4ed6-bfdb-c06c90d7bab5",
                                                "sense_id": "074915f0-2c6c-3df3-b355-8dd543735385",
                                                "text": "Malta ist ein Inselstaat."
                                            },
                                            {
                                                "example_id": "6b0710e8-4fe8-4219-86bc-c0f7c8fe4cb7",
                                                "sense_id": "074915f0-2c6c-3df3-b355-8dd543735385",
                                                "text": "Valletta ist die Hauptstadt von Malta."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d448fbcb-7270-394f-9f5e-d92998600661",
                                        "entry_id": "de396c34-6bae-31b9-a502-f80fb5efb6f9",
                                        "glosses": [
                                            "Gemeinde in Kärnten, die vom gleichnamigen Fluss durchflossen wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04482a9c-d7c6-42dd-9459-40745738f919",
                                                "sense_id": "d448fbcb-7270-394f-9f5e-d92998600661",
                                                "text": "„Laut Volkszählung 2001 hat Malta 2.185 Einwohner, davon besitzen 97,8 % die österreichische Staatsbürgerschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
