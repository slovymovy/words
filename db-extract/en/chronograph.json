                                        "entry_id": "15237beb-3780-3f2d-b069-aa3f26b7fe04",
                                        "glosses": [
                                            "техн. прибор для измерения кратких интервалов времени или для точной регистрации по часам моментов каких-либо событий"
                                        ],
                                        "tags": [],
