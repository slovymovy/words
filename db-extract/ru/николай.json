                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "a213e4da-e419-4e36-afd9-b3a6efae17d9",
                        "source_entry_id": "303a3648-ba6c-3e21-b3dc-b1014410f48f",
                        "source_sense_id": "b2283d97-7303-3b6e-a7e1-1bf2859dff09",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Nicolas",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nicolas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7afe9f8e-dd3c-38b2-ba06-b156682d2a3b",
                                        "entry_id": "2aeaced6-f6cd-3a13-8587-c5dee7ae39a4",
                                        "glosses": [
                                            "A male given name from Latin [in turn from Ancient Greek], of less common usage, variant of Nicholas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd3c5d93-2332-4f02-b253-ce6a0ff6cac7",
                                                "sense_id": "7afe9f8e-dd3c-38b2-ba06-b156682d2a3b",
                                                "text": "And the saying pleased the whole multitude: and they chose Stephen, a man full of faith and of the Holy Ghost, and Philip, and Prochorus, and Nicanor, and Timon, and Parmenas, and Nicolas a proselyte of Antioch."
                                            },
                                            {
                                                "example_id": "d6005fc4-98b4-4e84-85ff-e011e3b3c2e4",
                                                "sense_id": "7afe9f8e-dd3c-38b2-ba06-b156682d2a3b",
                                                "text": "French President Nicolas Sarkozy advocated more regulation of commodities markets and better management of capital flows at the last G-20 meeting, and the G-7 intervened in currency markets to depress the yen in the wake of Japan’s March earthquake."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3b90c8db-86a8-4543-ba1c-0b0a949ffba3",
                        "source_entry_id": "303a3648-ba6c-3e21-b3dc-b1014410f48f",
                        "source_sense_id": "b2283d97-7303-3b6e-a7e1-1bf2859dff09",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Nicole",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nicole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd9d645b-615d-385d-98fd-a212a12f138b",
                                        "entry_id": "032da060-47cd-3a0a-9959-c807f509a339",
                                        "glosses": [
                                            "Commune française, située dans le département du Lot-et-Garonne."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Nicole",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba56ae08-1739-341a-bf9e-3e09f24f154b",
                                        "entry_id": "da338869-720f-3ca0-a526-efd17d036ead",
                                        "glosses": [
                                            "Prénom féminin français."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2b6632f-2543-448a-911e-1c8c97a23e1a",
                                                "sense_id": "ba56ae08-1739-341a-bf9e-3e09f24f154b",
                                                "text": "Elle était Nicole Diver, Anna Karénine, elle était Pauline de Théus."
                                            },
                                            {
                                                "example_id": "c80302c1-31f6-45d5-877a-2cedfda058ea",
                                                "sense_id": "ba56ae08-1739-341a-bf9e-3e09f24f154b",
                                                "text": "Bodenstein lui avait raconté sous le sceau du secret d’où venait l’aversion que Nicole Engel avait à son encontre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8b236eab-f88f-3eff-98b2-d9f959d74845",
                                        "entry_id": "da338869-720f-3ca0-a526-efd17d036ead",
                                        "glosses": [
                                            "Prénom épicène français."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "052a0b1b-a7d6-46cd-820d-f295ad474c95",
                                                "sense_id": "8b236eab-f88f-3eff-98b2-d9f959d74845",
                                                "text": "Né vers 1320 dans le petit village d’Alemaigne, dans le diocèse de Bayeux, le jeune Nicole Oresme, déjà maître ès arts, est admis comme boursier théologien au Collège de Navarre en 1348 : c’est une chance extraordinaire qui témoigne de la modestie de ses origines, car, pour y entrer, il fallait être pauvre et doué de talent."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
