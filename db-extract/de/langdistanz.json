                "senses": [
                    {
                        "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                        "entry_id": "1113fc0f-c9d3-3d3b-96f2-4211ea0466e8",
                        "glosses": [
                            "relativ lange Streckenlänge oder Wettkampfdistanz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a13df5d-2422-49d8-af26-43e46fa61c7b",
                                "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                                "text": "„Bei der Langdistanz ging es über 138 Kilometer mit fast 4.300 Höhenmetern.“"
                            },
                            {
                                "example_id": "19adea10-53ce-4ece-8d68-168932603711",
                                "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                                "text": "„Unter den Teilnehmern befand sich auch der Regensburger Triathlet Hans Gallmeier, der Ende Oktober noch die legendäre Langdistanz in Hawaii bewältigte und nach kurzer Trainingspause zum ersten Mal wieder an den Start ging.“"
                            },
                            {
                                "example_id": "08d5e0ff-4599-43e8-ae39-429a6ce1c487",
                                "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                                "text": "„Trotz meiner Erfahrung aus circa 25 Rennen über die Langdistanz in Europa sehe ich mich dort als Lehrling.“"
                            },
                            {
                                "example_id": "7af0dffa-1305-414e-a9a4-a3780cfcf838",
                                "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                                "text": "Der 21-Jährige aus Wemmetsweiler war bei der Europameisterschaft auf der Langdistanz einer von mehr als 3000 Amateuren, die den Triathlon über 3,8 Kilometer Schwimmen, 180 Kilometer Radfahren und 42,195 Kilometer Laufen in Angriff nahmen - auf der identischen Strecke wie die 90 Profisportler.“"
                            },
                            {
                                "example_id": "0715297b-1248-442c-b4f6-3667573bd64b",
                                "sense_id": "01aa558d-0fb9-3c6a-a3bd-fa5c6490e941",
                                "text": "„Neben der Langdistanz gibt es auch wieder die 10 km-Funstrecke (Start 9.45 Uhr) durch den oberen Teil der Ravennaschlucht bis zum Piketfelsen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
