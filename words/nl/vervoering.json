                    "semantic_group_id": "emotionele toestand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het publiek luisterde in diepe <w>vervoering</w> naar de prachtige aria van de sopraan.",
                            "target_lang_translations": {
                                "en": "The audience listened in deep <w>rapture</w> to the soprano's beautiful aria.",
                                "fr": "Le public écoutait avec un profond <w>ravissement</w> le magnifique air de la soprano."
                            }
                        },
                        {
                            "text": "Zij raakte in <w>vervoering</w> door het adembenemende uitzicht over de besneeuwde bergtoppen.",
                            "target_lang_translations": {
                                "en": "She was <w>entranced</w> by the breathtaking view of the snow-capped mountain peaks.",
                                "fr": "Elle fut prise d'<w>extase</w> devant la vue à couper le souffle sur les sommets enneigés."
                            }
                        }
                    ],
                    "synonyms": [
                        "extase"
                    ],
                    "common_phrases": [
                        "in vervoering raken",
                        "in vervoering brengen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literair"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "a state of intense joy or enthusiasm in which one is completely carried away by emotions",
