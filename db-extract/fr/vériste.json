                ],
                "senses": [
                    {
                        "sense_id": "cccd26b4-bf53-3ca6-a602-47872eed70a1",
                        "entry_id": "60158b14-dd6c-3eb8-b222-6911b5e63846",
                        "glosses": [
                            "Relatif au vérisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76c17636-7c5e-4102-bb8b-e28026141172",
                                "sense_id": "cccd26b4-bf53-3ca6-a602-47872eed70a1",
                                "text": "L’écrivain italien Luigi Capuana (1939-1915) théorise les principes véristes, mais sans jamais les appliquer réellement. C’est l'écrivain Giovanni Verga (1840-1922), un ami très proche de Capuana, qui sera le principal représentant du mouvement vériste."
                            },
                            {
                                "example_id": "2320749e-74b6-45eb-b61d-d1591896a6c7",
                                "sense_id": "cccd26b4-bf53-3ca6-a602-47872eed70a1",
                                "text": "Est-il bien rationnel de prétendre avoir identifié un Genyornis (oiseau disparu il y a environ cinquante mille ans) sur une peinture rupestre d’Australie qui pourtant n’est aucunement vériste ? Quelle autre « raison » qu’une nette tendance à la paréidolie obligerait les observateurs à reconnaître un volcan en observant de vagues digitations marquant une paroi de la grotte Chauvet ? Ou un oiseau sur un simple accident d’un éclat de silex aurignacien?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b4b657d-fc2c-49ea-a02e-db353d220943",
                        "source_entry_id": "60158b14-dd6c-3eb8-b222-6911b5e63846",
                        "source_sense_id": "cccd26b4-bf53-3ca6-a602-47872eed70a1",
                        "target_lang_word": "verist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "84020168-af77-36b7-bcf6-b98c98af4023",
                                        "entry_id": "78ef411e-bb5f-393f-81a6-01da235183c8",
                                        "glosses": [
                                            "One who subscribes to verism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67910732-5db3-4fb7-8238-5bdee21ca3fd",
                                                "sense_id": "84020168-af77-36b7-bcf6-b98c98af4023",
                                                "text": "It is the creation of a verist, of a naturalist, founded on a clear and intimate perception of nature."
                                            },
                                            {
                                                "example_id": "cdce84fb-a97e-47ab-a64b-750172b73bf9",
                                                "sense_id": "84020168-af77-36b7-bcf6-b98c98af4023",
                                                "text": "He is, nevertheless, a realist—a verist, as he prefers to be called."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
