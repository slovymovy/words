        "fr-extract.jsonl": [
            {
                "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                "word": "pragmatique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "546af60c-655f-4d7c-bc52-d488687c9a2b",
                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "pragmatiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3c49b8b-e8d4-333e-9811-444c09ecff64",
                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "glosses": [
                            "Qualifie le choix d'une décision, d'une action, ou directement la décision ou l'action, adaptée au but recherché, qui s’impose immédiatement, qui s’avère plus pratique plus efficace."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08437568-ae23-4025-afe6-695eee59d407",
                                "sense_id": "e3c49b8b-e8d4-333e-9811-444c09ecff64",
                                "text": "De fil en aiguille, cette langue progresse, et ce pour des raisons essentiellement pragmatiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "glosses": [
                            "Qui concerne les affaires, la pratique. Il est surtout utilisé en termes d’Histoire dans cette locution :"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c392678c-ac88-41c6-af34-cf0d3c5cd569",
                                "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                                "text": "Pragmatique sanction, qui se dit particulièrement d’un Règlement fait en matière ecclésiastique."
                            },
                            {
                                "example_id": "78ef0a35-d937-4e9c-90d2-ba95aecd230e",
                                "sense_id": "82170d02-a7bf-3f0f-91cb-ef41dc0ff9a4",
                                "text": "La pragmatique sanction de Charles VII."
                            }
                        ]
                    },
                    {
                        "sense_id": "6492df98-8574-3d90-bf55-dcfe0d9b12de",
                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "glosses": [
                            "Qui concerne l’action, qui est fondé surtout sur la pratique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbd9ed30-e134-4054-8d6a-6225c38d346d",
                                "sense_id": "6492df98-8574-3d90-bf55-dcfe0d9b12de",
                                "text": "Cette philosophie est surtout pragmatique."
                            }
                        ]
                    },
                    {
                        "sense_id": "7f16b246-1866-3707-a189-182f74a2319d",
                        "entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "glosses": [
                            "Qui concerne la pragmatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4f373d6-d4a2-4ab3-a317-70012910dbd5",
                                "sense_id": "7f16b246-1866-3707-a189-182f74a2319d",
                                "text": "Tous ces protocoles offrent de travailler l’acquisition des habiletés pragmatiques par les jeux de rôle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ba4b183-59a0-44fd-bae9-1888a2387c39",
                        "source_entry_id": "82672b95-0f4b-3614-b50e-f14dcf1ff67e",
                        "source_sense_description": "Qui concerne la pratique",
                        "target_lang_word": "pragmatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pragmatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fc1c9e7a-9ff6-309e-8300-ac03714dc9ff",
                                        "entry_id": "417ec4f5-c9c0-3567-af1f-039171e5a339",
                                        "glosses": [
                                            "Practical, concerned with making decisions and actions that are useful in practice, not just theory."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f588729b-089c-4783-bcfc-e20c06f1d1bf",
                                                "sense_id": "fc1c9e7a-9ff6-309e-8300-ac03714dc9ff",
                                                "text": "The sturdy furniture in the student lounge was pragmatic, but unattractive."
                                            },
                                            {
                                                "example_id": "29865d91-7806-44ef-9b53-6ddb324fbd10",
                                                "sense_id": "fc1c9e7a-9ff6-309e-8300-ac03714dc9ff",
                                                "text": "Nor indeed are these restrictions pragmatic in nature: i.e. the ill-formedness of the heed-sentences in (60) is entirely different in kind from the oddity of sentences like:\n (61) !That man will eat any car which thinks heʼs stupid\n which is purely pragmatic (i.e. lies in the fact that (61) describes the kind of bizarre situation which just doesnʼt happen in the world we are familiar with, where cars donʼt think, and people donʼt eat cars)."
                                            },
                                            {
                                                "example_id": "6f1d6805-0c04-4cd7-8dfa-5abdc6c6b03a",
                                                "sense_id": "fc1c9e7a-9ff6-309e-8300-ac03714dc9ff",
                                                "text": "Another increasing concern with both ideological and pragmatic elements related to the situation of wickerworkers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f84ba5bc-5c41-3159-821f-961e48705f92",
                                        "entry_id": "417ec4f5-c9c0-3567-af1f-039171e5a339",
                                        "glosses": [
                                            "Philosophical; dealing with causes, reasons, and effects, rather than with details and circumstances; said of literature."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b44a72cb-fbb8-4f7a-b420-547fb3b80179",
                                                "sense_id": "f84ba5bc-5c41-3159-821f-961e48705f92",
                                                "text": "Polybius’s pragmatic history is simply the history of affairs, as distinguished from the descriptive and often poetical character which much history before his time had."
                                            },
                                            {
                                                "example_id": "c563a13c-fb43-4930-9687-e55730d2c887",
                                                "sense_id": "f84ba5bc-5c41-3159-821f-961e48705f92",
                                                "text": "[…]such objects belonged to the domain of the comic poet, and of the lighter kinds of poetry. For the more serious kinds, for pragmatic poetry, to use an excellent expression of Polybius, they were more difficult and severe in the range of subjects which they permitted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "071b638b-ddc5-30ae-b31a-fb0650b483ce",
                                        "entry_id": "417ec4f5-c9c0-3567-af1f-039171e5a339",
                                        "glosses": [
                                            "Interfering in the affairs of others; officious; meddlesome."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
