                        "form": "centauresques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98ea7ef4-6186-3c7f-b600-cdaed70c4852",
                        "entry_id": "719fbcdd-4c0c-31ad-8fd5-2061e4e24d1c",
                        "glosses": [
                            "Qui a la forme d’un centaure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03d67a23-1232-45b3-85f2-0f8380f2c872",
                                "sense_id": "98ea7ef4-6186-3c7f-b600-cdaed70c4852",
                                "text": "Un dessin centauresque, une créature centauresque."
                            },
                            {
                                "example_id": "722884e7-b700-47cc-987c-ee58040f6aa4",
                                "sense_id": "98ea7ef4-6186-3c7f-b600-cdaed70c4852",
                                "text": "Dans ce rapport ambigu de domination et de coopération que le cavalier entretient avec lui, rapport unique dans les échanges entre créatures humaines et non humaines, est créée une entité centauresque devenue l’homme-cheval."
                            }
                        ]
                    },
                    {
                        "sense_id": "8f909641-b23c-385a-af4e-cbabe06accc4",
                        "entry_id": "719fbcdd-4c0c-31ad-8fd5-2061e4e24d1c",
                        "glosses": [
                            "Qui concerne les centaures."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b3f1c74-bba2-46b9-8905-93a8bf1c6fee",
                                "sense_id": "8f909641-b23c-385a-af4e-cbabe06accc4",
                                "text": "Par l’ouverture de la jarre [de vin], Héraclès bouleverse l’espace centauresque."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91e88182-b259-407e-9ebf-f679592f4908",
                        "source_entry_id": "719fbcdd-4c0c-31ad-8fd5-2061e4e24d1c",
                        "target_lang_word": "centauresque",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centauresque",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8652e982-0d66-3568-b1d3-77730cc02a83",
                                        "entry_id": "be87fff0-cca5-3cb3-9131-6e69d44cd5bd",
                                        "glosses": [
                                            "Having attributes like those of the mythical centaur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "04abaca7-487e-4e8d-b3c9-4b71fb4d372f",
                                                "sense_id": "8652e982-0d66-3568-b1d3-77730cc02a83",
                                                "text": "More distrustful and irritable than ever, in this section, this watchdog character was to be obsessed with the centauresque likeness of my four boys."
                                            },
                                            {
                                                "example_id": "c87ce8e9-22d1-4985-b616-01c5ca2b00f0",
                                                "sense_id": "8652e982-0d66-3568-b1d3-77730cc02a83",
                                                "text": "Here they take on their true centauresque form, each one mounting a hired courser and clattering through the town in the direction of the Wood of Verrières."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eb42f8d-5369-3523-9c64-4685adc79143",
                                        "entry_id": "be87fff0-cca5-3cb3-9131-6e69d44cd5bd",
                                        "glosses": [
                                            "By extension, having the characteristics of two things combined together; hybridized; chimeric."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d680fd3-75ba-4d52-8e82-94824bd1fa79",
                                                "sense_id": "4eb42f8d-5369-3523-9c64-4685adc79143",
                                                "text": "Message and method merge, centauresque, to assist him."
                                            },
                                            {
                                                "example_id": "594cd07f-39bc-47bc-a9d1-d184b6682eb8",
                                                "sense_id": "4eb42f8d-5369-3523-9c64-4685adc79143",
                                                "text": "Machiavelli begins chapter 26 by asking if the times are right for a \"new prince\" in Italy, one \"prudente e virtuoso,\" like Borgia, like the profeta armato, like the hybrid centauresque monster to be composed of Machiavelli's counsel and Medicean power."
                                            },
                                            {
                                                "example_id": "161abd0c-79e5-4284-864f-8a9093f8fb02",
                                                "sense_id": "4eb42f8d-5369-3523-9c64-4685adc79143",
                                                "text": "We are of opinion in any way, that the grace is more obvious than the strength ; and there may be something centauresque and of twofold nature in their rushing mutabilities, and changes on passion and weakness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
