                "senses": [
                    {
                        "sense_id": "04a31610-e552-3d4a-b93a-2ce2fe71528e",
                        "entry_id": "e860f39d-6bcc-3d81-9383-ab69c135a85b",
                        "glosses": [
                            "Spitze eines Säbels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b4267c7-3f3d-468c-8cc5-f06414aaf226",
                                "sense_id": "04a31610-e552-3d4a-b93a-2ce2fe71528e",
                                "text": "„Er geht gerade und aufrecht, als wäre sein Blut nie mit meiner Säbelspitze in Berührung gekommen.“"
                            },
                            {
                                "example_id": "829d3518-34c7-4c32-a0c5-9d02d1afd079",
                                "sense_id": "04a31610-e552-3d4a-b93a-2ce2fe71528e",
                                "text": "„Die Säbelspitze war keine zehn Zentimeter vom Gesicht des Jungen entfernt; der Riemen hing an der flachen Seite der Flasche.“"
                            },
                            {
                                "example_id": "4f85f82a-7f18-4cf6-9c6b-cb3876d13882",
                                "sense_id": "04a31610-e552-3d4a-b93a-2ce2fe71528e",
                                "text": "„Er hatte Augen wie Säbelspitzen, sein Gesicht war bleich und trug jenen angewiderten Ausdruck, den er für derartige Anlässe bereit hielt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
