{
    "word_family": [
        "twinkling",
        "twinkler"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "17f4d68c-679b-3f69-95ec-94219f441c51",
                    "sense_definition": "To shine with a flickering light; to glimmer.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We could see the lights of the village <w>twinkling</w> in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы видели, как вдалеке <w>мерцают</w> огни деревни.",
                                "zh": "我们能看见远处村庄的灯火在<w>闪烁</w>。"
                            }
                        },
                        {
                            "text": "The stars <w>twinkle</w> brightly in the clear night sky.",
                            "target_lang_translations": {
                                "ru": "Звезды ярко <w>мерцают</w> в чистом ночном небе.",
                                "zh": "星星在晴朗的夜空中明亮地<w>闪烁</w>着。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flicker",
                        "glimmer",
                        "shimmer",
                        "sparkle",
                        "shine"
                    ],
                    "common_phrases": [
                        "twinkle in the distance",
                        "stars twinkle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светиться неровным, колеблющимся светом; мерцать.",
                        "zh": "发出忽明忽暗的光；微微闪光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцать",
                                "target_lang_sense_clarification": "о свете звезд или огней"
                            },
                            {
                                "target_lang_word": "сверкать",
                                "target_lang_sense_clarification": "ярко блестеть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪烁",
                                "target_lang_sense_clarification": "指星星、灯光等忽明忽暗地发光"
                            },
                            {
                                "target_lang_word": "微微发亮",
                                "target_lang_sense_clarification": "较轻微、柔和地发亮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4a7af48-8aad-3ce3-a1b3-fabd71872bb3",
                    "sense_definition": "To be bright with delight or amusement, especially of the eyes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His shrewd little eyes <w>twinkled</w> roguishly as he told the joke.",
                            "target_lang_translations": {
                                "ru": "Его проницательные глазки лукаво <w>заискрились</w>, когда он рассказывал анекдот.",
                                "zh": "他讲笑话时，那双机灵的小眼睛狡黠地<w>闪着光</w>。"
                            }
                        },
                        {
                            "text": "Her eyes <w>twinkle</w> with joy whenever she sees her grandchildren.",
                            "target_lang_translations": {
                                "ru": "Ее глаза <w>сияют</w> от радости каждый раз, когда она видит внуков.",
                                "zh": "她每次见到孙辈，眼睛里都会<w>闪着光</w>，满是喜悦。"
                            }
                        }
                    ],
                    "synonyms": [
                        "sparkle",
                        "gleam"
                    ],
                    "common_phrases": [
                        "eyes twinkle with delight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Светиться радостью или весельем (обычно о глазах).",
                        "zh": "（尤指眼睛）因喜悦或逗趣而发亮。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сиять",
                                "target_lang_sense_clarification": "о глазах, выражающих радость"
                            },
                            {
                                "target_lang_word": "искриться",
                                "target_lang_sense_clarification": "о глазах, выражающих веселье"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪着光",
                                "target_lang_sense_clarification": "指眼睛因喜悦或顽皮而发亮"
                            },
                            {
                                "target_lang_word": "发亮",
                                "target_lang_sense_clarification": "指眼神明亮，流露出高兴或逗趣"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b2d720e3-0388-3ce7-bd90-9e0cb9cbfba4",
                    "sense_definition": "To bat, blink or wink the eyes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "eye movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She smiled and gave a little nod and <w>twinkled</w> her eyes at the guest.",
                            "target_lang_translations": {
                                "ru": "Она улыбнулась, слегка кивнула и <w>подмигнула</w> гостю.",
                                "zh": "她笑了笑，轻轻点了点头，还冲着客人<w>眨眼</w>。"
                            }
                        },
                        {
                            "text": "The owl sat on the branch, <w>twinkling</w> its eyes in the bright morning sun.",
                            "target_lang_translations": {
                                "ru": "Сова сидела на ветке, <w>щурясь</w> на ярком утреннем солнце.",
                                "zh": "猫头鹰蹲在树枝上，在明亮的晨光里不停<w>眨眼</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blink",
                        "wink",
                        "nictitate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро моргать или подмигивать.",
                        "zh": "眨眼；快速地眯动或挤动眼睛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мигать",
                                "target_lang_sense_clarification": "быстро закрывать и открывать глаза"
                            },
                            {
                                "target_lang_word": "моргать",
                                "target_lang_sense_clarification": "двигать веками"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "眨眼",
                                "target_lang_sense_clarification": "快速闭合再睁开眼睛；也可指使眼色"
                            },
                            {
                                "target_lang_word": "眨巴眼睛",
                                "target_lang_sense_clarification": "连续快速地眨动眼皮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1322fdf3-29ef-3aaf-a989-9614f766cb7d",
                    "sense_definition": "To flit to and fro rapidly.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A colorful butterfly <w>twinkled</w> among the vines in the garden.",
                            "target_lang_translations": {
                                "ru": "Разноцветная бабочка <w>порхала</w> среди виноградных лоз в саду.",
                                "zh": "一只色彩斑斓的蝴蝶在花园的藤蔓间<w>飞舞</w>。"
                            }
                        },
                        {
                            "text": "The small birds <w>twinkle</w> through the leaves of the old oak tree.",
                            "target_lang_translations": {
                                "ru": "Маленькие птички <w>мелькают</w> в листве старого дуба.",
                                "zh": "小鸟们在老橡树的叶间<w>穿梭</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flicker",
                        "flutter",
                        "flit"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро перемещаться или порхать туда-сюда.",
                        "zh": "快速地来回飞动或闪动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порхать",
                                "target_lang_sense_clarification": "легко и быстро летать"
                            },
                            {
                                "target_lang_word": "мелькать",
                                "target_lang_sense_clarification": "быстро появляться и исчезать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "飞舞",
                                "target_lang_sense_clarification": "轻快地来回移动，常指蝴蝶、鸟等"
                            },
                            {
                                "target_lang_word": "穿梭",
                                "target_lang_sense_clarification": "快速地来回掠过或移动"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c864694-d154-312f-9b77-e638d6b96a2e",
                    "sense_definition": "A sparkle or glimmer of light.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "light emission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soon the rocket was out of sight, and the flame was only seen as a tiny <w>twinkle</w> of light.",
                            "target_lang_translations": {
                                "ru": "Вскоре ракета скрылась из виду, и пламя было видно лишь как крошечное <w>мерцание</w> света.",
                                "zh": "很快火箭就看不见了，只剩下一点微小的<w>闪光</w>。"
                            }
                        },
                        {
                            "text": "The distant <w>twinkle</w> of a lighthouse guided the sailors home.",
                            "target_lang_translations": {
                                "ru": "Далекий <w>огонек</w> маяка вел моряков домой.",
                                "zh": "远处灯塔的一点<w>微光</w>引导着水手们回家。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glint",
                        "spark",
                        "glimmer",
                        "sparkle"
                    ],
                    "common_phrases": [
                        "twinkle of light"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вспышка или мерцание света.",
                        "zh": "一闪一闪的光；微弱的亮光。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мерцание",
                                "target_lang_sense_clarification": "колеблющийся свет"
                            },
                            {
                                "target_lang_word": "огонек",
                                "target_lang_sense_clarification": "слабый свет вдали"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪光",
                                "target_lang_sense_clarification": "一点闪亮的光"
                            },
                            {
                                "target_lang_word": "微光",
                                "target_lang_sense_clarification": "远处微弱的小亮点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "962799b3-4de9-37d2-a6c7-083619161a59",
                    "sense_definition": "A sparkle of delight or mischief in the eyes.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "facial expression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was a rotund, jolly man with a <w>twinkle</w> in his eye.",
                            "target_lang_translations": {
                                "ru": "Это был дородный весельчак с <w>огоньком</w> в глазах.",
                                "zh": "他是个胖乎乎、乐呵呵的人，眼里带着一丝<w>笑意</w>。"
                            }
                        },
                        {
                            "text": "I noticed a mischievous <w>twinkle</w> as she prepared her prank.",
                            "target_lang_translations": {
                                "ru": "Я заметил озорной <w>блеск</w> в ее глазах, когда она готовила свою шутку.",
                                "zh": "她准备恶作剧时，我注意到她眼中闪过一丝顽皮的<w>神采</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "glint",
                        "sparkle",
                        "glimmer"
                    ],
                    "common_phrases": [
                        "twinkle in one's eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Блеск восторга или лукавства в глазах.",
                        "zh": "眼中流露出的喜悦、顽皮或狡黠的神色。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "огонек",
                                "target_lang_sense_clarification": "задорный блеск в глазах"
                            },
                            {
                                "target_lang_word": "сияние",
                                "target_lang_sense_clarification": "радостное выражение глаз"
                            },
                            {
                                "target_lang_word": "блеск",
                                "target_lang_sense_clarification": "оживленный взгляд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "笑意",
                                "target_lang_sense_clarification": "眼中流露出的愉快神情"
                            },
                            {
                                "target_lang_word": "神采",
                                "target_lang_sense_clarification": "眼神中显出的灵动、顽皮或喜悦"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88216b63-16b9-3ea8-bbbe-04dc1751484f",
                    "sense_definition": "A brief moment; a <w>twinkling</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "time",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire scene changed in the <w>twinkle</w> of an eye.",
                            "target_lang_translations": {
                                "ru": "Вся сцена изменилась в <w>мгновение</w> ока.",
                                "zh": "整个场景在<w>一瞬间</w>就变了。"
                            }
                        },
                        {
                            "text": "He was gone in a <w>twinkle</w>, leaving us all surprised.",
                            "target_lang_translations": {
                                "ru": "Он исчез в один <w>миг</w>, оставив нас в полном удивлении.",
                                "zh": "他在<w>一瞬间</w>就不见了，留下我们大家都很惊讶。"
                            }
                        }
                    ],
                    "synonyms": [
                        "instant",
                        "moment",
                        "jiffy",
                        "flash"
                    ],
                    "common_phrases": [
                        "in the twinkle of an eye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткое мгновение; миг.",
                        "zh": "极短的一段时间；瞬间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мгновение",
                                "target_lang_sense_clarification": "очень короткий промежуток времени"
                            },
                            {
                                "target_lang_word": "миг",
                                "target_lang_sense_clarification": "момент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "一瞬间",
                                "target_lang_sense_clarification": "极短的时间"
                            },
                            {
                                "target_lang_word": "转眼间",
                                "target_lang_sense_clarification": "非常快的一会儿"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c51c41a-3526-39fe-bb60-406fda0e22e3",
                    "sense_definition": "A flitting or quick movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I saw the <w>twinkle</w> of white feet as the dancers moved across the stage.",
                            "target_lang_translations": {
                                "ru": "Я видел <w>мелькание</w> белых ног, когда танцоры двигались по сцене.",
                                "zh": "舞者们穿过舞台时，我看见了白色双脚的<w>闪动</w>。"
                            }
                        },
                        {
                            "text": "The <w>twinkle</w> of the hummingbird's wings was almost too fast to see.",
                            "target_lang_translations": {
                                "ru": "<w>Порхание</w> крыльев колибри было почти невозможно уловить взглядом.",
                                "zh": "蜂鸟翅膀的一阵<w>掠动</w>快得几乎看不清。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flit",
                        "flicker"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстрое, едва уловимое движение.",
                        "zh": "快速而轻巧的一闪而过的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "порхание",
                                "target_lang_sense_clarification": "легкое движение"
                            },
                            {
                                "target_lang_word": "мелькание",
                                "target_lang_sense_clarification": "быстрое движение мимо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "闪动",
                                "target_lang_sense_clarification": "迅速而短暂的动作或出现"
                            },
                            {
                                "target_lang_word": "掠动",
                                "target_lang_sense_clarification": "轻快迅速地一掠而过的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c62c652-430f-3a6f-8420-3b109347f6fe",
                    "sense_definition": "A childish or euphemistic term for the female genitalia.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children's song was translated using the words Willie and <w>Twinkle</w> for body parts.",
                            "target_lang_translations": {
                                "ru": "Детская песенка была переведена с использованием слов «Вилли» и «<w>Пиписька</w>» для обозначения частей тела.",
                                "zh": "那首儿歌被翻译时，用了 Willie 和 <w>小妹妹</w> 这样的词来指代身体部位。"
                            }
                        },
                        {
                            "text": "Some parents use the word <w>twinkle</w> when talking to toddlers about anatomy.",
                            "target_lang_translations": {
                                "ru": "Некоторые родители используют слово «<w>писька</w>», когда говорят с малышами об анатомии.",
                                "zh": "有些父母在跟幼儿谈身体构造时会用<w>小妹妹</w>这个词。"
                            }
                        }
                    ],
                    "synonyms": [
                        "front bottom",
                        "tuppence"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "childish euphemism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Детское или эвфемистическое название женских половых органов.",
                        "zh": "对女性生殖器的儿童式或委婉说法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пиписька",
                                "target_lang_sense_clarification": "детское название половых органов"
                            },
                            {
                                "target_lang_word": "писька",
                                "target_lang_sense_clarification": "разговорное детское слово"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小妹妹",
                                "target_lang_sense_clarification": "对女性生殖器的儿童式委婉说法"
                            },
                            {
                                "target_lang_word": "下面",
                                "target_lang_sense_clarification": "对女性私处的较委婉、对幼儿说的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}