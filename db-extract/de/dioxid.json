                    {
                        "sense_id": "64dae668-fb6a-3eb6-996b-89b89a3f5385",
                        "entry_id": "f457358d-6dee-3137-9348-8e2737768d3a",
                        "glosses": [
                            "chemische Verbindung mit unter anderem zwei Sauerstoffatomen in jedem Molekül"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9300b1b9-145f-443f-b6e6-fd10019252ac",
                                "sense_id": "64dae668-fb6a-3eb6-996b-89b89a3f5385",
                                "text": "Der Chemielehrer besteht darauf, dass jeder Schüler mindestens fünf Dioxide kennen sollte."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1f2b8a06-952c-4c83-9c22-5ece6f601e37",
                        "source_entry_id": "f457358d-6dee-3137-9348-8e2737768d3a",
                        "source_sense_id": "64dae668-fb6a-3eb6-996b-89b89a3f5385",
                        "source_sense_description": "chemische Verbindung mit unter anderem zwei Sauerstoffatomen in jedem Molekül",
                        "target_lang_word": "dioxide",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dioxide",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                        "entry_id": "38e3df1b-8060-3b47-94f8-144ff121d1f2",
                                        "glosses": [
                                            "Any oxide containing two oxygen atoms in each molecule."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a82da96e-b26e-457d-8b15-e8295ea156f0",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Discoid lesions and minor subacute involvement may be controlled by freezing with carbon dioxide or a course of atabrine."
                                            },
                                            {
                                                "example_id": "7800605a-f637-4cdc-907f-df2502702f49",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Kruban is a tidally-locked Venusian hothouse, its surface perpetually obscured by clouds of sulfur and carbon dioxides."
                                            },
                                            {
                                                "example_id": "38bcf9de-e8e4-4361-b878-96d427f17450",
                                                "sense_id": "5e8890b1-3115-3542-b0ca-fa705eeca28c",
                                                "text": "Oxygen levels on Earth skyrocketed 2.4 billion years ago, when cyanobacteria evolved photosynthesis: the ability to convert water and carbon dioxide into carbohydrates and waste oxygen using solar energy."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e84e9212-85da-4ae9-8111-ba27ac78ae67",
                        "source_entry_id": "f457358d-6dee-3137-9348-8e2737768d3a",
