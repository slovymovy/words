                ],
                "translations": [
                    {
                        "translation_id": "db2f5a47-d688-4670-9f10-4b68ff2ec832",
                        "source_entry_id": "d4d9b312-a4fe-344e-b7fb-2db3bf2a8079",
                        "source_sense_id": "cabe1467-48dd-34f4-b519-d186d4a0e878",
                        "target_lang_word": "fodder",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fodder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d351e60e-6906-3381-99e7-4005a01950c8",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "Food for animals; that which is fed to cattle, horses, and sheep, such as hay, cornstalks, vegetables, etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "911f3284-494c-49fd-a901-35694c043a18",
                                                "sense_id": "d351e60e-6906-3381-99e7-4005a01950c8",
                                                "text": "The sheep for fodder follow the shepherd, the shepherd for food follows not the sheep."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c95589aa-e17d-3ea5-91cf-bd4006125e6e",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "A load: various English units of weight or volume based upon standardized cartloads of certain commodities, generally around 1000 kg."
                                        ],
                                        "tags": [
                                            "countable",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd54e360-5a1f-443c-abe8-52a158002e13",
                                                "sense_id": "c95589aa-e17d-3ea5-91cf-bd4006125e6e",
                                                "text": "Now measured by the old hundred, that is, 108 lbs. the charrus contains nearly 19 1/2 hundreds, that is it corresponds to the fodder, or fother, of modern times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "65cec0b5-35aa-34ea-955b-7eee6efd4397",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "Tracing paper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05942fc1-bab9-32c3-a291-e00c0b9f5bb7",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "Stuff; material; something that serves as inspiration or encouragement, especially for satire or humour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21b0bd9a-cee1-4387-b6ac-e10ef14566c3",
                                                "sense_id": "05942fc1-bab9-32c3-a291-e00c0b9f5bb7",
                                                "text": "According to the audio commentary on “Treehouse Of Horror III,” some of the creative folks at The Simpsons were concerned that the “Treehouse Of Horror” franchise had outworn its welcome and was rapidly running out of classic horror or science-fiction fodder to spoof."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05e6e490-cbb2-33c0-90e4-a941a2a0dcf2",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "The text to be operated on (anagrammed, etc.) within a clue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18873277-7a91-438a-941c-cc2a90062fb9",
                                                "sense_id": "05e6e490-cbb2-33c0-90e4-a941a2a0dcf2",
                                                "text": "In (part of) Shelley's poem Ozymandias is a \"crumbling statue\". If this is the explanation then the clue is not a reverse cryptic in the same was^([sic]) as GEGS -> SCRAMBLED EGGS but a normal clue where where^([sic]) the fodder and anagrind are *both* indirect."
                                            },
                                            {
                                                "example_id": "01da20a7-592f-4bb3-aa74-aeed8f774050",
                                                "sense_id": "05e6e490-cbb2-33c0-90e4-a941a2a0dcf2",
                                                "text": "Insane Roman! (4) […] Look in -sane Roman and you'll uncover NERO, the insane Roman. Dovetailing the signpost — in — with the hidden fodder — sane Roman — is inspired, an embedded style of signposting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1d61247-9179-3d6c-a194-3184cde12d7e",
                                        "entry_id": "5356ea9b-3ce3-3345-a835-ec0c92a7993c",
                                        "glosses": [
                                            "People considered to have negligible value and easily available or expendable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb4b9c56-d4b5-4eab-a603-22355961f4d3",
                                                "sense_id": "f1d61247-9179-3d6c-a194-3184cde12d7e",
                                                "text": "Innocent people who are arrested become fodder for the justice system."
                                            },
                                            {
                                                "example_id": "6dae49ed-efce-43c5-beeb-6827f6b11026",
                                                "sense_id": "f1d61247-9179-3d6c-a194-3184cde12d7e",
                                                "text": "cannon fodder"
                                            },
                                            {
                                                "example_id": "c0fffc62-79cc-4840-a79c-2a51d23f4362",
                                                "sense_id": "f1d61247-9179-3d6c-a194-3184cde12d7e",
                                                "text": "The Russian government was not interested in who will pay the mortgage or take care of his pregnant wife. It simply wanted more fodder for its war."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fodder",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53858325-14e1-3750-aa6b-60849a5a2560",
                                        "entry_id": "c0c3da6c-9f29-37d0-8c8a-2ecc1095d4ec",
                                        "glosses": [
                                            "To feed animals (with fodder)."
                                        ],
                                        "tags": [
                                            "dialectal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7ac6b1-6025-4645-a45a-c2ede52861f2",
                                                "sense_id": "53858325-14e1-3750-aa6b-60849a5a2560",
                                                "text": "Straw will do well enough to fodder them with"
                                            },
                                            {
                                                "example_id": "b8a77616-64da-4467-835a-cebf1bf1c88b",
                                                "sense_id": "53858325-14e1-3750-aa6b-60849a5a2560",
                                                "text": "\"When I had foddered the horse, I went into the barn and took the handle of an old rake to chase the dog out with.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
