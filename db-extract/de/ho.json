                "senses": [
                    {
                        "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                        "entry_id": "c62c21e8-0d0e-329a-9536-f3eebc85945f",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fedb31-62cf-4bcd-8b61-a1b9ef37b12e",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Frau Ho ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "752fe26a-4151-40f7-a53b-b8971e5739e5",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Herr Ho wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "0bc75d13-6bb2-48b7-802f-6728c4b25059",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Die Hos kommen heute aus Hamburg."
                            },
                            {
                                "example_id": "944305f9-ba4d-46ba-ab78-7bb3e5ca3251",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Der Ho trägt nie die Schals, die die Ho ihm strickt."
                            },
                            {
                                "example_id": "32f77edf-ef97-4373-82e6-84e343e7dd48",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ho kommt, geht der Herr Ho.“"
                            },
                            {
                                "example_id": "7bdfbb53-9bbe-4d63-8c03-6431ed3aa292",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Ho kommt und geht."
                            },
                            {
                                "example_id": "1b807fd8-089c-456d-a3e1-507278c162b6",
                                "sense_id": "f3d4921d-da41-3f7a-b842-a20939dc97ad",
                                "text": "Hos kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
