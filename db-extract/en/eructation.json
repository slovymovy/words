                        "glosses": [
                            "The act of belching, of expelling gas from the stomach through the mouth."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "14eb1bca-54b6-44d5-b77b-dafcd5127ae1",
                                "sense_id": "eb9b9167-5920-3c5a-8429-5da9f1b02808",
                                "text": "His eyes were as restless as his limbs, and seemed ever to be seeking for something upon which they could definitely alight, and not finding it. He performed eructations with the disarming naturalness of a baby."
                            },
                            {
                                "example_id": "e140df39-c75a-4c72-bba6-35cdf02805cf",
                                "sense_id": "eb9b9167-5920-3c5a-8429-5da9f1b02808",
                                "text": "\"Move along, you coxcomb,\" Ignatius belched, the gassy eructations echoing between the walls of the alley."
                            }
                        ]
                    },
                    {
                        "sense_id": "e6394c8d-7dff-3368-8afa-21df807e0b14",
                        "entry_id": "6de28b93-ec6e-3405-8dc0-7153bdc8160b",
                        "glosses": [
