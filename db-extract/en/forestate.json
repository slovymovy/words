                        "examples": [
                            {
                                "example_id": "966c0995-91a3-48a4-ab0e-ab0be9ad478d",
                                "sense_id": "9916817d-3112-376b-a1b0-21bea8daa4aa",
                                "text": "That was the occasion when the Cardinal Gonsalvi, knowing whom he should please, and what schemes were in progress, ventured to forestate the decision of the parliament on the Bill that now engages its attention."
                            },
                            {
                                "example_id": "9184aad8-b6f7-4db3-bb39-0dd3309df14a",
                                "sense_id": "9916817d-3112-376b-a1b0-21bea8daa4aa",
                                "text": "It is far from being what I should like to write about them, but perhaps enough has been said to forestate the problem as it appears to one who has traveled with these children and learned to know them “in the open.”"
                            },
                            {
                                "example_id": "4a0347e6-f705-4d9b-aff4-324ca25da7c6",
                                "sense_id": "9916817d-3112-376b-a1b0-21bea8daa4aa",
                                "text": "\"And I'll bet she's found him and given him that money,\" he continued, — forestating Sid's own conclusion."
                            }
                        ]
                    }
