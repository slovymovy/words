                                        "sense_id": "dfde0cba-bb35-30bd-b77b-ca82c1dd20d1",
                                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                                        "glosses": [
                                            "D’une manière provisoire, en attendant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd28b087-a842-47a9-a68d-35b3238252ef",
                                                "sense_id": "dfde0cba-bb35-30bd-b77b-ca82c1dd20d1",
                                                "text": "Parfois, l'ampleur des travaux est telle que la route doit être provisoirement fermée et interdite à toute circulation. Un itinéraire de déviation est alors provisoirement mis en place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                                        "entry_id": "900eead3-da3a-3e49-91f4-01df607452b9",
                                        "glosses": [
                                            "Par provision."
                                        ],
                                        "tags": [
                                            "Justice"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65b0ee78-bf50-4b2e-b517-2a9d23f2d7e5",
                                                "sense_id": "f523179d-5390-3a0e-89e1-2b57989ad671",
                                                "text": "Cela n'a été jugé que provisoirement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9bb9308f-a90b-46c1-a3d9-a9e9ef0c77d0",
                        "source_entry_id": "3a8a0257-163c-30e2-89f0-0c6a0ad2b465",
                        "source_sense_id": "f17a277f-91eb-381f-b7a4-9809a9f125e7",
                        "source_sense_description": "in a provisional way",
                        "target_lang_word": "vorläufig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                        "entry_id": "1e32a1d8-0b52-3b52-ac0d-2621fd31694f",
                                        "glosses": [
                                            "nicht endgültig, bis zu einer späteren Festlegung gültig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e662726-e720-484f-8df3-a090647b81be",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "Das hier soll nur eine vorläufige Lösung sein."
                                            },
                                            {
                                                "example_id": "0e709f96-84a0-4734-ab89-857d72f31f04",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Mit diesem Zitat gelang es mir, ihn nicht grundsätzlich umzustimmen, aber doch sein vorläufiges Einverständnis zur Fortsetzung meiner Arbeit zu bekommen.“"
                                            },
                                            {
                                                "example_id": "f78c568c-d9e7-4bd7-bf7e-608727c43be7",
                                                "sense_id": "ce1af7d0-2fbb-35b8-bce7-1b966713b190",
                                                "text": "„Allein von den für Permanentmagnete wichtigen und als knappe Ressource eingestuften Elementen Neodym und Praseodym könnten aus dem Fen Carbonatite Complex mindestens 1,5 Millionen Tonnen gefördert werden, so die vorläufige Abschätzung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "vorläufig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                        "entry_id": "79c35e8a-7bf5-374a-b885-cfd3bf0b821e",
                                        "glosses": [
                                            "fürs Erste, bis auf Weiteres"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1b7c8de-be16-4a42-a61f-3b784d138505",
                                                "sense_id": "ccaac0bf-a45a-352c-935d-70a5ad393ea6",
                                                "text": "Wir müssen uns vorläufig mit einer kleinen Wohnung zufrieden geben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6f84139-b3e2-441d-a538-bd6524de32f3",
                        "source_entry_id": "3a8a0257-163c-30e2-89f0-0c6a0ad2b465",
                        "source_sense_id": "f17a277f-91eb-381f-b7a4-9809a9f125e7",
