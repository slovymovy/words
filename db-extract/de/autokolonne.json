                "senses": [
                    {
                        "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                        "entry_id": "fa0c3ca2-3af1-3059-8960-9fd3ba655934",
                        "glosses": [
                            "Gruppe von Autos, die über längere Zeit hinweg in gleichem Tempo und Abstand fährt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8c9007d-0969-4da9-8076-1b04e5c95d6f",
                                "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                                "text": "„Es mußte ihr vielmehr schon als eine höchst ansehnliche Leistung angerechnet werden, daß die Heeresleitung von Mitte 1917 an mit einer monatlichen Fertigstellung von sechs Autokolonnen zu je 20 Lastkraftwagen — außer den für die Fliegerverbände erforderlichen Kraftfahrzeugen — rechnen konnte.“"
                            },
                            {
                                "example_id": "83bb5b62-2cfe-490b-9c68-40e1faa4fb3d",
                                "sense_id": "1e13eb5e-7ec6-3d13-a0ee-0ffbc161f0e9",
                                "text": "„Die Autokolonnen, die sich durch die Straßen schlängelten, sahen von hier oben aus wie Goldkettchen auf schwarzem Samt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
