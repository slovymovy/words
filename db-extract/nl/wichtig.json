                ],
                "senses": [
                    {
                        "sense_id": "31167f36-1477-31b4-9334-b69414e87c0d",
                        "entry_id": "cdb6f477-c382-380e-abb4-a24c77c22fc2",
                        "glosses": [
                            "duidelijk of sterk de zwaartekracht van de aarde ondervinden"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "f8d4a352-e3e3-46b2-8319-a21acc9d7d89",
                                "sense_id": "31167f36-1477-31b4-9334-b69414e87c0d",
                                "text": "Hij zette onvervaard zijn rug onder een tamelijk wichtig rijtuig, tilde het van de pin, tot de baas er de schraag onder plaatste en Tinus het losse voorstel wegreed."
                            },
                            {
                                "example_id": "749cbee3-33eb-40ac-811e-a7671fd07880",
                                "sense_id": "31167f36-1477-31b4-9334-b69414e87c0d",
                                "text": "En Pluto, op zijn troon gezeten\nvan wichtig staal,\nheeft zijn gestrengheid toen vergeten\nvoor de eerste maal."
                            }
                        ]
                    },
                    {
                        "sense_id": "7c2a93aa-f873-35b1-96cf-d9c75eb7990a",
                        "entry_id": "cdb6f477-c382-380e-abb4-a24c77c22fc2",
                        "glosses": [
                            "een massa hebben die overeenkomt met gestelde eisen"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2bf9ae81-038c-4b83-920a-633a49557a17",
                                "sense_id": "7c2a93aa-f873-35b1-96cf-d9c75eb7990a",
                                "text": "⧖ Verdoet eens gantsch'lyk uyt ons hert,\nHet geene daar nog is verwert,\nEn voor Uw' Oogen nog niet richtig:\nOch wierdt het in ons Licht, en Regt\nEn (in de heil'ge schaal gelegt)\nBevonden, naar syn maate, wichtig!"
                            }
                        ]
                    },
                    {
                        "sense_id": "06a7b7e0-31b9-3801-b952-4880737c2e87",
                        "entry_id": "cdb6f477-c382-380e-abb4-a24c77c22fc2",
                        "glosses": [
                            "van belang zijn, van grote betekenis"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "b35e1549-32d0-4f83-8601-be02227e9f7e",
                                "sense_id": "06a7b7e0-31b9-3801-b952-4880737c2e87",
                                "text": "Gisterochtend om kwart voor acht twitterde Maxime Verhagen: ‘Want die een hoge staat, of wichtig ambt bekleedt, Is nimmer buiten zorg, en zelden buiten leed.’ Het was een citaat van de dichter en politicus Jacob Cats naar wie het Catshuis is vernoemd."
                            },
                            {
                                "example_id": "901d7b8e-8673-4cbf-843d-5c72c1616ba9",
                                "sense_id": "06a7b7e0-31b9-3801-b952-4880737c2e87",
                                "text": "Woutertje hàd z'n prentenboeken en voelde zich wichtig!"
                            }
                        ]
                    }
                ],
