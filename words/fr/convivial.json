                    "frequency": "High",
                    "semantic_group_id": "relationnel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons passé la soirée dans une ambiance très <w>conviviale</w> avec nos voisins."
                        },
                        {
                            "text": "Ce petit restaurant de quartier offre un cadre <w>convivial</w> pour retrouver ses amis."
                        }
                    ],
                    "synonyms": [
                        "accueillant",
                        "agréable",
                        "chaleureux",
                        "sympathique"
                    ],
                    "antonyms": [
