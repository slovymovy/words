            "senses": [
                {
                    "sense_id": "eb827de5-8108-3e4c-a9ae-1dc23551d962",
                    "sense_definition": "Exclamation marquant l'impatience, le dépit ou la déception.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ah, <w>zut</w> alors, j'ai encore oublié mes clés à la maison !",
                            "target_lang_translations": {
                                "en": "Ah, <w>darn</w> it, I've forgotten my keys at home again!",
                                "ru": "Ах, <w>блин</w>, я опять забыл ключи дома!",
                                "de": "Ach, <w>Mist</w>, ich habe schon wieder meine Schlüssel zu Hause vergessen!",
                                "es": "¡Ah, <w>caramba</w>, otra vez me he olvidado las llaves en casa!",
                                "zh": "啊，<w>糟糕</w>，我又把钥匙忘在家里了！"
                            }
                        },
                        {
                            "text": "<w>Zut</w>, le train vient de partir sous nos yeux.",
                            "target_lang_translations": {
                                "en": "<w>Darn</w>, the train has just left right before our eyes.",
                                "ru": "<w>Блин</w>, поезд только что ушёл прямо у нас на глазах.",
                                "de": "<w>Verflixt</w>, der Zug ist uns gerade direkt vor den Augen abgefahren.",
                                "es": "¡<w>Caramba</w>, el tren acaba de marcharse ante nuestros ojos!",
                                "zh": "<w>哎呀</w>，火车刚刚就在我们眼前开走了！"
                            }
                        }
                    ],
                    "synonyms": [
                        "crotte",
                        "flute",
                        "mince"
                    ],
                    "common_phrases": [
                        "zut alors"
                    ],
                    "traits": [
