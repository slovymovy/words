    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6ed3740f-9e7f-330a-90c1-605a306da1ec",
                    "sense_definition": "Existing in possibility but not yet in actuality; capable of being or becoming.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possibility",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is currently identifying <w>potential</w> customers for its new software product.",
                            "target_lang_translations": {
                                "ru": "В настоящее время компания выявляет <w>потенциальных</w> клиентов для своего нового программного продукта."
                            }
                        },
                        {
                            "text": "Every child is a <w>potential</w> hero if they are given the right support and guidance.",
                            "target_lang_translations": {
                                "ru": "Каждый ребенок — это <w>потенциальный</w> герой, если ему обеспечить правильную поддержку и руководство."
                            }
                        }
                    ],
                    "synonyms": [
                        "virtual"
                    ],
                    "antonyms": [
                        "actual",
                        "real"
                    ],
                    "common_phrases": [
                        "potential"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий в возможности, но еще не реализованный; способный стать чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциальный",
                                "target_lang_sense_clarification": "скрытый, возможный в будущем"
                            },
                            {
                                "target_lang_word": "возможный",
                                "target_lang_sense_clarification": "вероятный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "350862d3-1425-3109-9359-4048567bb58e",
                    "sense_definition": "Relating to a verbal construction or <w>form</w> that expresses possibility or probability.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "grammar",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>potential</w> mood is used in some languages to indicate that an action is likely.",
                            "target_lang_translations": {
                                "ru": "<w>Потенциальное</w> наклонение используется в некоторых языках для указания на вероятность действия."
                            }
                        },
                        {
                            "text": "Linguists analyzed the <w>potential</w> form of the verb to understand its usage in ancient texts.",
                            "target_lang_translations": {
                                "ru": "Лингвисты проанализировали <w>потенциальную</w> форму глагола, чтобы понять его использование в древних текстах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "potential mood"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "linguistic term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к глагольной форме, выражающей возможность или вероятность действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциальный",
                                "target_lang_sense_clarification": "лингвистический термин, наклонение"
                            },
                            {
                                "target_lang_word": "возможностный",
                                "target_lang_sense_clarification": "выражающий возможность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "924ad706-c8fa-391f-a37e-820f2e3d762c",
                    "sense_definition": "Describing a vector field that is the gradient of a scalar function; irrotational.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this specific model, the electric field is <w>potential</w> and can be derived from a scalar.",
                            "target_lang_translations": {
                                "ru": "В этой конкретной модели электрическое поле является <w>потенциальным</w> и может быть выведено из скаляра."
                            }
                        },
                        {
                            "text": "The non-viscous flow of the vacuum should be <w>potential</w> and free of rotation.",
                            "target_lang_translations": {
                                "ru": "Невязкий поток вакуума должен быть <w>потенциальным</w> и безвихревым."
                            }
                        }
                    ],
                    "common_phrases": [
                        "potential flow"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "scientific context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Описывающий векторное поле, которое является градиентом скалярной функции; безвихревой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциальный",
                                "target_lang_sense_clarification": "физический термин, о поле или потоке"
                            },
                            {
                                "target_lang_word": "безвихревой",
                                "target_lang_sense_clarification": "о поле с нулевым ротором"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5befd46b-7270-3062-bbaf-d37efd078a1d",
                    "sense_definition": "A currently unrealized ability or capacity for growth, development, or future success.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "ability",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young athlete has the <w>potential</w> to become a world champion one day.",
                            "target_lang_translations": {
                                "ru": "У молодого атлета есть <w>потенциал</w>, чтобы однажды стать чемпионом мира."
                            }
                        },
                        {
                            "text": "Teachers often try to help students reach their full <w>potential</w> through personalized learning.",
                            "target_lang_translations": {
                                "ru": "Учителя часто стараются помочь ученикам полностью раскрыть свой <w>потенциал</w> с помощью индивидуального обучения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "full potential",
                        "reach potential",
                        "potential to"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нереализованная на данный момент способность или возможность для роста, развития или будущего успеха."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциал",
                                "target_lang_sense_clarification": "совокупность возможностей"
                            },
                            {
                                "target_lang_word": "задатки",
                                "target_lang_sense_clarification": "природные способности"
                            },
                            {
                                "target_lang_word": "возможности",
                                "target_lang_sense_clarification": "перспективы развития"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d02125c2-7053-359d-ba7f-908862922fb9",
                    "sense_definition": "The amount of energy or work per unit charge or mass needed to move an object within a force field.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The electric <w>potential</w> at this point is measured in volts.",
                            "target_lang_translations": {
                                "ru": "Электрический <w>потенциал</w> в этой точке измеряется в вольтах."
                            }
                        },
                        {
                            "text": "Gravity creates a gravitational <w>potential</w> that affects the movement of planets.",
                            "target_lang_translations": {
                                "ru": "Гравитация создает гравитационный <w>потенциал</w>, который влияет на движение планет."
                            }
                        }
                    ],
                    "common_phrases": [
                        "electric potential",
                        "gravitational potential"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина энергии или работы на единицу заряда или массы, необходимая для перемещения объекта в силовом поле."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потенциал",
                                "target_lang_sense_clarification": "физическая величина"
                            }
