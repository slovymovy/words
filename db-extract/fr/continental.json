                                "target_senses": [
                                    {
                                        "sense_id": "28cfee7b-e6af-3284-8701-041a0c968cbe",
                                        "entry_id": "0c8cf9ea-60e5-3751-a143-e4b46eeec8f8",
                                        "glosses": [
                                            "Someone from the continent."
