                        "tags": [],
                        "examples": [
                            {
                                "example_id": "887ead69-ad51-4bed-aed4-5de8158a5759",
                                "sense_id": "639ac7dc-aaa2-356f-95f4-10d0af606273",
                                "text": "„Der Bismarckturm in Kattowitz war ein Aussichtsturm, der 1903 auf der Beatenhöhe im Südpark als Denkmal für Otto von Bismarck errichtet wurde.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
