                "forms": [],
                "senses": [
                    {
                        "sense_id": "8e73dc42-1c2f-3777-a1fc-7a79d36cad83",
                        "entry_id": "04f7a2f8-0ecb-3f68-a1ae-1f2d63047aea",
                        "glosses": [
                            "Angehöriger einer japanischen kriminellen Bande; Yakuza"
                        ],
                        "tags": [
                            "Japan"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "50e3c313-58e2-438c-9fa9-c8fa3f27dca9",
                        "source_entry_id": "04f7a2f8-0ecb-3f68-a1ae-1f2d63047aea",
                        "source_sense_id": "8e73dc42-1c2f-3777-a1fc-7a79d36cad83",
                        "source_sense_description": "Japan: Angehöriger einer japanischen kriminellen Bande; Yakuza",
                        "target_lang_word": "Yakuza",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Yakuza",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b83eacd9-838d-3cbb-a7e4-64565aa8acd5",
                                        "entry_id": "56594129-2e93-359c-a493-d21aa8c35917",
                                        "glosses": [
                                            "japanische, kriminelle Organisation (ähnlich der Mafia)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c72bf1f-ad18-4d19-9ba4-a21aa6590969",
                                                "sense_id": "b83eacd9-838d-3cbb-a7e4-64565aa8acd5",
                                                "text": "Die Rezession der 1970er Jahre und die Blasenökonomie der 1980er nutzte die Yakuza zum Einstieg in die Finanzbranche."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Yakuza",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                        "entry_id": "bccae46b-79b0-34d7-8b07-df83c1c65de7",
                                        "glosses": [
                                            "Mitglied der gleichnamigen kriminellen Organisation"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbbd0c19-26d2-40d6-b886-1302f15b5f3f",
                                                "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                                "text": "„Begeht ein Yakuza einen schweren Fehler, erwartet sein Boss zur Buße das Abtrennen eines Fingergliedes, angefangen beim kleinen Finger.“"
                                            },
                                            {
                                                "example_id": "ebd41733-d62b-4d1a-91f5-1aeeaaab6d39",
                                                "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                                "text": "„Auch ein Yakuza, ein Mitglied der japanischen Mafia, fängt mal ganz unten an.“"
                                            },
                                            {
                                                "example_id": "999befc4-91a6-4b2b-a142-83e8dc7215d7",
                                                "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                                "text": "„Als letzte der 48 japanischen Präfekturen führte vor zwei Jahren auch Tokio eine Bestimmung ein, wonach sich jeder strafbar macht, der mit einem Yakuza Geschäfte macht.“"
                                            },
                                            {
                                                "example_id": "20facf53-03e7-4a48-8e10-9306283ffc50",
                                                "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                                "text": "„In Japan sind es vor allem die Yakuzas, die Mitglieder der dortigen und fast allmächtigen Mafia, die mit der meist schmerzhaften Zufügung der Tattoos Eintritt in ihre zweifelhafte Gesellschaft erlangen und mit speziellen Symbolen ihre Zugehörigkeit zu den entsprechenden Banden demonstrieren.“"
                                            },
                                            {
                                                "example_id": "ca6f479f-c8b5-4efa-8236-18da913ebdb1",
                                                "sense_id": "e69d8353-87cb-34da-8ed8-b22519cd372e",
                                                "text": "„Als Tomohiko Suzuki am 11. März 2011 aus dem Radio von der Reaktorkatastrophe in Fukushima erfährt, sitzt er gerade im Auto neben einigen Yakuzas (Mitgliedern der japanischen Mafia), die Hilfsgüter in die vom verheerenden Erdbeben und dem Tsunami betroffene Region in Nordostjapan bringen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
