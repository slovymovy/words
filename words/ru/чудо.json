    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b14f3437-3285-3953-9155-f30c585be998",
                    "sense_definition": "Сверхъестественное явление, вызванное вмешательством высших или божественных сил.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "miracle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Верующие люди искренне надеялись на настоящее <w>чудо</w> в этот праздничный день.",
                            "target_lang_translations": {
                                "fr": "Les croyants espéraient sincèrement un véritable <w>miracle</w> en ce jour de fête."
                            }
                        },
                        {
                            "text": "Старый священник часто рассказывал прихожанам про великие <w>чудеса</w> святых.",
                            "target_lang_translations": {
                                "fr": "Le vieux prêtre racontait souvent aux paroissiens les grands <w>miracles</w> des saints."
                            }
                        }
                    ],
                    "synonyms": [
                        "волшебство",
                        "сверхъестественное"
                    ],
                    "antonyms": [
                        "обыденность"
                    ],
                    "common_phrases": [
                        "верить в чудеса",
                        "совершить чудо"
                    ],
                    "target_lang_definitions": {
                        "fr": "Phénomène surnaturel attribué à l'intervention d'une force supérieure ou divine."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "miracle",
                                "target_lang_sense_clarification": "acte divin ou surnaturel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78087b7d-379b-3bd4-94c7-df4929c67ab1",
                    "sense_definition": "Крайне маловероятное, поразительное и счастливое событие.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "miracle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пациент неожиданно пошёл на поправку, и врачи назвали это настоящим <w>чудом</w>.",
                            "target_lang_translations": {
                                "fr": "Le patient s'est rétabli de manière inattendue, et les médecins ont qualifié cela de véritable <w>miracle</w>."
                            }
                        },
                        {
                            "text": "Команда смогла забить победный гол в самом конце матча только каким-то <w>чудом</w>.",
                            "target_lang_translations": {
                                "fr": "L'équipe n'a réussi à marquer le but de la victoire à la toute fin du match que par <w>miracle</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "каким-то чудом",
                        "произошло чудо"
                    ],
                    "target_lang_definitions": {
                        "fr": "Événement extrêmement improbable, surprenant et heureux."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "miracle",
                                "target_lang_sense_clarification": "hasard heureux, fait extraordinaire inespéré"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "03f3b06e-fd9c-3666-9ac9-8935006adbdb",
                    "sense_definition": "Нечто выдающееся, вызывающее всеобщее восхищение, удивление или восторг.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "wonder",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот древний храм по праву считается настоящим <w>чудом</w> архитектуры.",
                            "target_lang_translations": {
                                "fr": "Ce temple ancien est considéré à juste titre comme une véritable <w>merveille</w> architecturale."
                            }
                        },
                        {
                            "text": "Северное сияние зимой — это удивительное <w>чудо</w> природы.",
                            "target_lang_translations": {
                                "fr": "Les aurores boréales en hiver sont une étonnante <w>merveille</w> de la nature."
                            }
                        }
                    ],
                    "common_phrases": [
                        "чудо природы",
                        "семь чудес света"
                    ],
                    "target_lang_definitions": {
                        "fr": "Chose remarquable qui suscite l'admiration générale, l'étonnement ou l'émerveillement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "merveille",
                                "target_lang_sense_clarification": "chose remarquable, prodige de la nature ou de l'art"
                            },
                            {
                                "target_lang_word": "miracle",
                                "target_lang_sense_clarification": "chef-d'œuvre, réussite exceptionnelle"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9fc4f1-a020-3344-af86-2c412338c7c9",
                    "sense_definition": "Сказочное, фантастическое или чудовищное существо.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старинной русской сказке богатырь смело сражается с трёхглавым <w>чудом</w>-юдом.",
                            "target_lang_translations": {
                                "fr": "Dans ce vieux conte russe, le bogatyr combat courageusement le <w>monstre</w> à trois têtes Tchoudo-Youdo."
                            }
                        },
                        {
                            "text": "Моряки испугались, когда из тёмных глубин внезапно вынырнуло невиданное морское <w>чудо</w>.",
                            "target_lang_translations": {
                                "fr": "Les marins ont pris peur lorsqu'un <w>monstre</w> marin prodigieux a soudainement émergé des profondeurs sombres."
                            }
                        }
                    ],
                    "common_phrases": [
                        "чудо-юдо"
                    ],
                    "target_lang_definitions": {
                        "fr": "Créature fabuleuse, fantastique ou monstrueuse."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "monstre",
                                "target_lang_sense_clarification": "créature effrayante ou prodigieuse"
                            },
                            {
                                "target_lang_word": "créature fantastique",
                                "target_lang_sense_clarification": "être mythologique ou fabuleux"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}