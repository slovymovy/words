                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "Der Fahrstuhl ist außer Betrieb."
                                            },
                                            {
                                                "example_id": "23e7ce11-6108-4b38-bac5-28bd50728ff1",
                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "„Allerdings braucht die Wärmepumpe für ihren Betrieb in der Regel Strom.“"
                                            },
                                            {
                                                "example_id": "f656afbc-d5e8-4129-83a4-f06a235a83d3",
                                                "sense_id": "05825ef3-ceb9-3148-990e-d9d16a7a8206",
                                                "text": "[2025:] „[…] Die Zukunft gehört dem Elektroauto. Es stößt im Betrieb kein CO2 aus und ist über seinen gesamten Lebenszyklus deutlich klimafreundlicher als ein Verbrenner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a43a5c16-bd26-39bf-950b-5bf8e9a8842a",
                                        "entry_id": "20bec346-c6d4-3b68-aee3-a21170bd2182",
                                        "glosses": [
                                            "Betriebsamkeit, Aktivität, Handlung"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f9806b2-3a94-4ef9-95e2-984be5ca163a",
                                                "sense_id": "a43a5c16-bd26-39bf-950b-5bf8e9a8842a",
                                                "text": "Nun mach aber endlich Betrieb, wir wollen fertig werden."
                                            }
