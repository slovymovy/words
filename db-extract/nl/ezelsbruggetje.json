                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c020fa0-9d6a-44f2-ab73-deb0a0931291",
                                "sense_id": "8afff8f1-28e8-3c61-9439-4be4fb6452d5",
                                "text": "'t Kofschip is een goed ezelsbruggetje om de juiste werkwoordvorm te kiezen."
