                        "cross_references": [
                            {
                                "target_word": "размагни́чивание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "91ad1290-729f-3b74-b408-bc6580fa8da5",
                                        "entry_id": "9b6163eb-50ff-3f97-85c3-b5342cf2f952",
                                        "glosses": [
                                            "физ. действие по значению гл. размагничивать, размагничиваться; процесс, в результате которого под воздействием внешнего магнитного поля уменьшается намагниченность магнитного материала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c1bee789-658a-42ca-b46b-f80eef77d404",
                                                "sense_id": "91ad1290-729f-3b74-b408-bc6580fa8da5",
                                                "text": "Если телефон не работает, то приходится предположить: 1) обрыв в шнуре, 2) обрыв в катушке, 3) размагничивание магнитов, а потому приступают к испытанию его состояния, что можно сделать при помощи маленькой батарейки."
                                            },
                                            {
                                                "example_id": "fa91aa9b-5171-4b23-83d5-77cc462d86c6",
                                                "sense_id": "91ad1290-729f-3b74-b408-bc6580fa8da5",
                                                "text": "Датчик, который представляет собой электромагнит, устанавливают на исследуемый участок и, подавая в обмотку ток, намагничивают сталь до насыщения. Затем тем же электромагнитом производят размагничивание. Чем больше коэрцитивная сила, тем больший ток необходим для размагничивания."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d6b6a2f-c962-3949-aa0e-1f9cbccf2369",
                                        "entry_id": "9b6163eb-50ff-3f97-85c3-b5342cf2f952",
                                        "glosses": [
                                            "перен., разг. эмоциональная, сексуальная разрядка"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb69a2b2-430d-4b3b-aaed-0134fafb3d17",
                                                "sense_id": "2d6b6a2f-c962-3949-aa0e-1f9cbccf2369",
                                                "text": "Установленные для стоявших в финском порту плавбаз суровые казарменные порядки вызывали у него раздражение, и он своей властью, под свою личную ответственность отпускал небольшие группы моряков на берег. Это называлось «ходить на размагничивание». После чудовищного перенапряжения всех сил, после скованности и тесноты подводника неудержимо тянет погулять, почувствовать какую ни на есть свободу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
