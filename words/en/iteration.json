{
    "word_family": [
        "iterate",
        "iterative",
        "reiterate"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2c0dc13d-ffd2-3d4c-bcc2-22f0314e0e1a",
                    "sense_definition": "A specific version or variation of something that has been developed or improved over time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "versioning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The architect drafted several <w>iterations</w> of the floorplan before deciding on his final design.",
                            "target_lang_translations": {
                                "ru": "Архитектор набросал несколько <w>вариантов</w> планировки этажа, прежде чем определиться с окончательным проектом."
                            }
                        },
                        {
                            "text": "This new <w>iteration</w> of the software includes many useful features.",
                            "target_lang_translations": {
                                "ru": "Эта новая <w>версия</w> программного обеспечения включает множество полезных функций."
                            }
                        }
                    ],
                    "common_phrases": [
                        "latest iteration",
                        "new iteration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретная версия или вариант чего-либо, доработанный или улучшенный со временем."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "версия",
                                "target_lang_sense_clarification": "вариант разработки или дизайна"
                            },
                            {
                                "target_lang_word": "вариант",
                                "target_lang_sense_clarification": "модификация или редакция"
                            },
                            {
                                "target_lang_word": "итерация",
                                "target_lang_sense_clarification": "этап или промежуточная версия продукта"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f22dd59-29d8-3bc2-b7a8-22e39a41cd06",
                    "sense_definition": "The process of repeating a set of instructions in a computer program.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The program uses <w>iteration</w> to process every item in the list.",
                            "target_lang_translations": {
                                "ru": "Программа использует <w>итерацию</w> для обработки каждого элемента списка."
                            }
                        },
                        {
                            "text": "Efficient <w>iteration</w> is essential for high-performance code.",
                            "target_lang_translations": {
                                "ru": "Эффективная <w>итерация</w> имеет решающее значение для высокой производительности кода."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс циклического повторения набора инструкций в компьютерной программе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "итерация",
                                "target_lang_sense_clarification": "циклическая обработка данных"
                            },
                            {
                                "target_lang_word": "цикл",
                                "target_lang_sense_clarification": "повторение операций в программировании"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "305b73ce-3c4d-3071-b8f6-12360c0f384e",
                    "sense_definition": "A single cycle or pass through a repetitive process.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The code calculates the appropriate value at each <w>iteration</w>.",
                            "target_lang_translations": {
                                "ru": "Код вычисляет соответствующее значение на каждой <w>итерации</w>."
                            }
                        },
                        {
                            "text": "During the final <w>iteration</w>, the system saves all the data.",
                            "target_lang_translations": {
                                "ru": "Во время последней <w>итерации</w> система сохраняет все данные."
                            }
                        }
                    ],
                    "common_phrases": [
                        "each iteration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Один отдельный проход или шаг в циклическом процессе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "итерация",
                                "target_lang_sense_clarification": "один проход цикла"
                            },
                            {
                                "target_lang_word": "шаг",
                                "target_lang_sense_clarification": "этап или проход в вычислениях"
                            },
                            {
                                "target_lang_word": "проход",
                                "target_lang_sense_clarification": "один цикл выполнения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6b5fcb86-7193-37d7-85be-a38454159bdc",
                    "sense_definition": "The act of repeating something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "repetition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>iteration</w> of the same phrase became quite annoying.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>повторение</w> одной и той же фразы стало очень раздражать."
                            }
                        },
                        {
                            "text": "His <w>iteration</w> of the poem was clear and precise.",
                            "target_lang_translations": {
                                "ru": "Его <w>декламация</w> стихотворения была четкой и точной."
                            }
                        }
                    ],
                    "synonyms": [
                        "reiteration",
                        "repeat",
                        "reoccurrence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по повторению чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повторение",
                                "target_lang_sense_clarification": "действие по повтору слов или действий"
                            },
                            {
                                "target_lang_word": "повтор",
                                "target_lang_sense_clarification": "очередное воспроизведение"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}