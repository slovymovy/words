                        "entry_id": "5f1ed011-cee2-37a2-80e3-c37365ec6006",
                        "glosses": [
                            "A person or institution who processes things (foods, photos, applications, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b166a0f7-de50-43fa-a080-1b5ed3c212b9",
                                "sense_id": "be9b31cd-7b99-3099-b8b2-ef91a5aecd42",
                                "text": "He is a loan processor with a bank."
                            }
                        ]
                    },
                    {
                        "sense_id": "92b8cb27-3916-3a44-8562-a75a58ccd550",
                        "entry_id": "5f1ed011-cee2-37a2-80e3-c37365ec6006",
                        "glosses": [
                            "A device which processes, which changes something (a computer processor, food processor, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef251b7a-d3b5-4fd3-a778-d4741f807645",
                                "sense_id": "92b8cb27-3916-3a44-8562-a75a58ccd550",
                                "text": "The food processor shredded the vegetables."
                            },
                            {
                                "example_id": "1d8b45c3-3c9a-4be9-b843-b7bcb5d9f9e7",
                                "sense_id": "92b8cb27-3916-3a44-8562-a75a58ccd550",
                                "text": "A smartphone is not the best camera, notebook, word processor, audio recorder, radio, MP3 player, map reader, pedometer and so on, but it is good enough replace numerous separate devices for most people most of the time."
                            }
                        ]
                    },
                    {
                        "sense_id": "b32b44b3-2234-3190-a6da-fa6046b5ad63",
                        "entry_id": "5f1ed011-cee2-37a2-80e3-c37365ec6006",
                        "glosses": [
                            "A central processing unit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4de36af6-7fb3-4886-81c4-874f42ea5472",
                                "sense_id": "b32b44b3-2234-3190-a6da-fa6046b5ad63",
                                "text": "This mainframe's processor is fast."
                            }
                        ]
                    },
                    {
                        "sense_id": "6ea09549-85c9-326e-9818-131360e8faf2",
                        "entry_id": "5f1ed011-cee2-37a2-80e3-c37365ec6006",
                        "glosses": [
                            "A microprocessor."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae58fd56-0335-41ab-907d-4c34f66057bb",
                                "sense_id": "6ea09549-85c9-326e-9818-131360e8faf2",
                                "text": "This computer has two processors, but only one keyboard."
                            },
                            {
                                "example_id": "b7e4e975-22f6-4ee6-803a-a9625ee9c144",
                                "sense_id": "6ea09549-85c9-326e-9818-131360e8faf2",
                                "text": "Intel usually brings out a new generation of processors every 12-18 months, and the Core range is now in its seventh generation."
                            }
                        ]
                    }
