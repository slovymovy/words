                    "frequency": "Middle",
                    "semantic_group_id": "kollision",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Autofahrer verlor bei Glätte die Kontrolle und <w>rammte</w> eine Leitplanke am Straßenrand."
                        },
                        {
                            "text": "Das Schiff geriet bei dichtem Nebel vom Kurs ab und <w>rammte</w> die Kaimauer im Hafen."
                        }
                    ],
                    "common_phrases": [
                        "eine Leitplanke rammen",
                        "einen Baum rammen"
                    ]
                },
                {
