                "senses": [
                    {
                        "sense_id": "2bc1f96a-103a-32b7-ad7a-0516b1c13e21",
                        "entry_id": "3ada932d-000e-301c-a450-63e5e0c09b0a",
                        "glosses": [
                            "Personne dont le métier est de rendre des films, des spectacles ou des expositions, accessibles aux personnes aveugles ou malvoyantes grâce à un texte en voix off qui décrit les éléments visuels de l’œuvre."
                        ],
                        "tags": [
                            "Audiovisuel"
                        ],
                        "examples": [
                            {
                                "example_id": "e24da17c-35f7-41f7-8425-9c121256f7a2",
                                "sense_id": "2bc1f96a-103a-32b7-ad7a-0516b1c13e21",
                                "text": "Selon Élisabeth Mesmer, une audiodescription est réussie si l’audiodescripteur parvient à se fondre dans l’ambiance du film, si le vocabulaire est précis, le style en accord avec le ton du film."
                            },
                            {
                                "example_id": "a9fc6671-e8bd-4bf3-993b-a90247711297",
                                "sense_id": "2bc1f96a-103a-32b7-ad7a-0516b1c13e21",
                                "text": "Misako passe son temps à décrire les objets, les sentiments et le monde qui l’entoure : elle est audiodescripteur de films."
                            },
                            {
                                "example_id": "dcb74d61-dd4e-4065-8296-43c128d478fb",
                                "sense_id": "2bc1f96a-103a-32b7-ad7a-0516b1c13e21",
                                "text": "L’audiodescripteur (ou traducteur d’image) est un auteur qui doit traduire l’image avec précision, concision, simplicité et sensibilité."
                            }
                        ]
                    }
