                    {
                        "sense_id": "dbaaf1fd-23a4-3e50-8b29-88fb0dfb1f73",
                        "entry_id": "bd88fb68-2c7e-37cf-be3d-d178f82b7284",
                        "glosses": [
                            "während einer Prunksitzung von einer Männergruppe in Damenbekleidung aufgeführter Tanz zur Belustigung des Publikums"
                        ],
                        "tags": [
                            "Karneval",
                            "Fasching",
                            "Fastnacht"
                        ],
                        "examples": [
                            {
                                "example_id": "fc83d639-6013-40f0-b90d-bf456d6e213d",
                                "sense_id": "dbaaf1fd-23a4-3e50-8b29-88fb0dfb1f73",
                                "text": "„Das kann man ganz gut vertanzen. Was ich nicht mag, sind obszöne Männerballette.“"
                            },
                            {
                                "example_id": "00ee9534-3556-4d43-b762-d06ef1208454",
                                "sense_id": "dbaaf1fd-23a4-3e50-8b29-88fb0dfb1f73",
                                "text": "„Das Männerballett hat sich mit den Jahren in Richtung Schautanz entwickelt und nach oben gesteigert.“"
                            },
                            {
                                "example_id": "6e8df03c-9f23-4421-8bc6-2af39ab7fdd4",
                                "sense_id": "dbaaf1fd-23a4-3e50-8b29-88fb0dfb1f73",
                                "text": "„Versprochen ist versprochen - was zunächst nach einem Scherz aussah, ist seit Donnerstag bei Youtube hochgeladene Realität: ein Männerballett, aufgeführt von männlichen Mitarbeitern der Hammer Stadtbücherei!“"
                            },
                            {
                                "example_id": "3322524a-454f-4332-9529-503d67989118",
                                "sense_id": "dbaaf1fd-23a4-3e50-8b29-88fb0dfb1f73",
                                "text": "„»Schnell haben wir alles organisiert, uns als Damen verkleidet und ein Männerballett aufgeführt«, so Tobi Wiesen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "27158ef4-2850-3615-96ce-2370464be365",
                        "entry_id": "bd88fb68-2c7e-37cf-be3d-d178f82b7284",
