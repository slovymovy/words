                        "entry_id": "5444ce29-44f3-346b-9f7b-758dd2dc5287",
                        "glosses": [
                            "Étoffe de soie et d’armure sergée, de même origine mais très différente du tweed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ac1451e-a0f2-4c29-bc8f-4e855fe1eeaf",
                                "sense_id": "8626b664-87b2-3b1a-b28f-bed4caac9415",
                                "text": "[…] flanelle rayée ou twill à pois selon le matin ou le soir […]"
                            },
                            {
                                "example_id": "1fc1ebb6-2871-4608-8da3-5607333532bd",
                                "sense_id": "8626b664-87b2-3b1a-b28f-bed4caac9415",
                                "text": "Le twill est un tissu sergé de 3 avec deux laissés pour un pris."
                            },
                            {
                                "example_id": "8f325e04-a360-45d2-ba93-31369fa00f5b",
                                "sense_id": "8626b664-87b2-3b1a-b28f-bed4caac9415",
                                "text": "Le twill de laine fait partie des lainages secs, il est lisse et compact."
                            }
                        ]
