                        "glosses": [
                            "Hauteur partant du sol, ou une longueur de vêtement descendant, qui s'arrête au milieu de la cuisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31e0a068-4781-47d9-a36a-20b532d133f2",
                                "sense_id": "b941da7f-a01a-3661-90ae-ac595a6c2e5a",
                                "text": "Je ne suis pas trop mal installé avec Pater, à condition de nous plier en chien de fusil, sans quoi les jambes couchent dehors à partir de la mi-cuisse."
                            },
                            {
