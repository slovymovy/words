            {
                "entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                "word": "entame",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d027d769-0979-487d-a192-9be8f40d41aa",
                        "entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                        "tags": [
                            "plural"
                        ],
                        "form": "entames"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "07dc5f59-b58c-3b39-9a7f-869802bd88dd",
                        "entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                        "glosses": [
                            "Première tranche d’un aliment qu’on a découpé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a81bbaab-87eb-475a-b97b-f587dd96c9e7",
                                "sense_id": "07dc5f59-b58c-3b39-9a7f-869802bd88dd",
                                "text": "Ôtez l’entame au moment de servir."
                            },
                            {
                                "example_id": "d1f55915-1e9b-4d10-9f64-aeae2099cadd",
                                "sense_id": "07dc5f59-b58c-3b39-9a7f-869802bd88dd",
                                "text": "Réservez-moi l’entame."
                            }
                        ]
                    },
                    {
                        "sense_id": "04202e19-7d08-331f-961a-506a027ed2c8",
                        "entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                        "glosses": [
                            "Première carte jouée."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "371a3a7b-b1d4-4347-9b76-ff79c8df4594",
                                "sense_id": "04202e19-7d08-331f-961a-506a027ed2c8",
                                "text": "Le donneur distribue 7 cartes à chaque joueur et retourne la première carte de la pioche, qui constitue l’entame."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d07ce93-35fa-33e9-8ca4-129a4a915574",
                        "entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                        "glosses": [
                            "Début."
                        ],
                        "tags": [
                            "analogy",
                            "familiar",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1ab95aad-66ef-43ad-bf05-658cf39bd636",
                                "sense_id": "5d07ce93-35fa-33e9-8ca4-129a4a915574",
                                "text": "Moi, j’assistais à tout cela en parfait spectateur, car la moindre entame de discussion avec une fille se terminait immanquablement et très rapidement par un snobage, un camouflet, une éconduite, en termes plus crus un vent, une veste ou un râteau."
                            },
                            {
                                "example_id": "df25acc0-1d0f-402d-8e87-489b2d8a785b",
                                "sense_id": "5d07ce93-35fa-33e9-8ca4-129a4a915574",
                                "text": "Quatre jours après avoir été sérieusement secoué d’emblée à Haïfa (Israël), le PSG a, cette fois, survolé l’entame du match à Décines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7d52bd24-7f09-4b04-bfae-c60edd82cbad",
                        "source_entry_id": "e180edab-5db3-311c-b10f-5a6c8ca1d729",
                        "target_lang_word": "slice",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slice",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "62f1c145-6bb8-3a31-b03d-8321ca8246f1",
                                        "entry_id": "3afb0bff-26a1-354c-ab39-f5daa46b0386",
                                        "glosses": [
                                            "That which is thin and broad."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "490af2f6-2390-4756-9406-61d565864f81",
                                                "sense_id": "62f1c145-6bb8-3a31-b03d-8321ca8246f1",
                                                "text": "I pulled in hand over hand on the cord, and when I judged myself near enough, rose at infinite risk to about half my height and thus commanded the roof and a slice of the interior of the cabin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d896907d-e7ef-35d9-849e-19c896cfdc73",
                                        "entry_id": "3afb0bff-26a1-354c-ab39-f5daa46b0386",
                                        "glosses": [
                                            "A thin, broad piece cut off."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a7b5ed-afd6-4688-944e-158be201ac69",
                                                "sense_id": "d896907d-e7ef-35d9-849e-19c896cfdc73",
                                                "text": "a slice of bacon; a slice of cheese; a slice of bread"
                                            },
                                            {
                                                "example_id": "2af30b53-c919-49eb-8fda-58e264d3c75f",
                                                "sense_id": "d896907d-e7ef-35d9-849e-19c896cfdc73",
                                                "text": "Jim was munching on a slice of toast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e90165d5-f198-347f-9c3d-9eace3aa33aa",
                                        "entry_id": "3afb0bff-26a1-354c-ab39-f5daa46b0386",
                                        "glosses": [
                                            "An amount of anything."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49949441-31f1-4cdd-bfb0-8219f286050b",
                                                "sense_id": "e90165d5-f198-347f-9c3d-9eace3aa33aa",
                                                "text": "Blackpool, chasing a seventh win in 17 league matches, simply could not contain Sunderland's rampant attack and had to resort to a combination of last-ditch defending, fine goalkeeping and a large slice of fortune."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4022cf6c-15d2-3b23-a057-e57928e25776",
                                        "entry_id": "3afb0bff-26a1-354c-ab39-f5daa46b0386",
                                        "glosses": [
                                            "A piece of pizza, shaped like a sector of a circle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ca68682-4c52-49d6-bc64-4dbbc4aab118",
                                                "sense_id": "4022cf6c-15d2-3b23-a057-e57928e25776",
                                                "text": "For breakfast, lunch, or dinner, the best Guido meal is a slice and a Coke."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73db4075-d792-3de3-9d03-4be1f0c0960b",
                                        "entry_id": "3afb0bff-26a1-354c-ab39-f5daa46b0386",
                                        "glosses": [
