                    {
                        "translation_id": "b0291b03-e438-4aff-8eb2-f998dad895c4",
                        "source_entry_id": "ce6c28c0-6a52-3711-9044-8aa38cdea5d3",
                        "source_sense_description": "a diabolically evil person",
