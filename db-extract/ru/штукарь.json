                "senses": [
                    {
                        "sense_id": "675d449a-9d96-3e7e-886b-c43216d2b03e",
                        "entry_id": "ad7a1e6d-d170-355c-ac91-5e78350a0dc2",
                        "glosses": [
                            "крим.жарг. то же, что штука; тысяча"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f276d8b1-6f72-4622-9564-32e5ced377d2",
                                "sense_id": "675d449a-9d96-3e7e-886b-c43216d2b03e",
                                "text": "Пенсия-то маленькая, выпить не на что, а тут штукарь баксов как с куса…"
                            },
                            {
                                "example_id": "38e4e575-c708-4c12-814e-87d04388a4ae",
                                "sense_id": "675d449a-9d96-3e7e-886b-c43216d2b03e",
                                "text": "— Неужели тридцать штукарей — это непомерная цена за кресло градоначальника?"
                            }
                        ]
                    }
                ],
