                            {
                                "example_id": "1f6d2e51-a62c-4c1a-be4a-3293f7c49c89",
                                "sense_id": "43141faa-6049-3b5f-84a3-31e26057619c",
                                "text": "Desant w Normandii był największą operacją morską w Europie w czasie II wojny światowej."
                            }
