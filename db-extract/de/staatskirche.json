                        ],
                        "form": "die Staatskirchen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                        "entry_id": "a7a0d1c5-4908-3630-8e74-dec55b77f2b9",
                        "glosses": [
                            "christliche Religionsgemeinschaft, die in einem Staat aufgrund geltenden Rechts zur offiziellen Religion bestimmt wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aa4581e-370e-47df-ac84-b1cc54352461",
                                "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                                "text": "Im frankistischen Spanien fungierte die Katholische Kirche als Staatskirche."
                            },
                            {
                                "example_id": "a0d1469b-2beb-4fce-bfa1-80710dc2ce4e",
                                "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                                "text": "„Die Gegnerschaft gegen die Kindertaufe war die logische Folge der Gegnerschaft gegen die Staatskirche.“"
                            },
                            {
                                "example_id": "126ad6ce-3c63-45fc-8129-3fc2ffe37e8e",
                                "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                                "text": "„Die nonkonformistischen Bewegungen entwickelten sich zu selbständigen Freikirchen neben der Staatskirche.“"
                            },
                            {
                                "example_id": "e012e35d-9ebe-48be-96af-0cc2e9f16e77",
                                "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                                "text": "„Es besteht keine Staatskirche. Jede Religionsgemeinschaft ordnet und verwaltet ihre Angelegenheiten selbständig. Den Religionsgesellschaften werden die Vereinigungen gleichgestellt, die sich die gemeinschaftliche Pflege einer Weltanschauung zur Aufgabe machen.“ (Artikel 137 der Weimarer Reichsverfassung)"
                            },
                            {
                                "example_id": "7265df5a-8259-4c9a-8de3-37a38fc9b8f1",
                                "sense_id": "b02e617b-e5e0-399b-96d5-3e4de9bdd0f0",
                                "text": "„Offiziell heißt es im Grundgesetz, es gäbe keine »Staatskirche«, doch das bedeutet nur, dass der Staat die evangelische nicht der katholischen Kirche vorziehen darf und umgekehrt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
