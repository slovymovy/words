                                        "entry_id": "08ceea0d-159c-36e5-b880-bd76f22420b5",
                                        "glosses": [
                                            "перен. книжн. о неожиданном пришельце, о том, кто (что) появился (появилось) неожиданно"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "290a72ad-7a3f-469f-a876-6663b50ca8f1",
                                                "sense_id": "eb9bbca6-628b-3ce0-9651-537d9066d6c2",
                                                "text": "Чума — страшный гость средневекового города."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b6c66cc-cb84-3b2c-be9b-7192b57c9e7e",
                                        "entry_id": "08ceea0d-159c-36e5-b880-bd76f22420b5",
                                        "glosses": [
                                            "старин. купец, ведущий заморскую торговлю"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f16c1f5-c044-4fd0-9f8e-48971d3cb0c1",
                                                "sense_id": "2b6c66cc-cb84-3b2c-be9b-7192b57c9e7e",
                                                "text": "Садко богатый гость."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "562eefbe-9fb7-3bfa-aa5a-e734226f633f",
                                        "entry_id": "08ceea0d-159c-36e5-b880-bd76f22420b5",
                                        "glosses": [
                                            "посетитель ресторана или гостиницы (в устах обслуживающего персонала)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b6d68f45-cb62-4e1a-9dba-7d590f33bb3c",
                                                "sense_id": "562eefbe-9fb7-3bfa-aa5a-e734226f633f",
                                                "text": "Картотека гостей, в которой содержатся данные о всех клиентах гостиницы за последние 12 месяцев."
                                            }
