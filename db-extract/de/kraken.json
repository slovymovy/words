                "senses": [
                    {
                        "sense_id": "0f809880-dead-3a71-aa4c-24de66f8bdb2",
                        "entry_id": "54e961b8-010a-3f6e-a1e9-a4b4be64b7bb",
                        "glosses": [
                            "alternative form of Krake"
                        ],
                        "tags": [
                            "alt-of",
