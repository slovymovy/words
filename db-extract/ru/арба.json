                                        "sense_id": "6628fe05-198e-3531-b611-bcb0f4e9eab1",
                                        "entry_id": "0b33d936-d98a-3af7-85a8-e1ec148e773e",
                                        "glosses": [
                                            "Ancienne voiture couverte tirée par des bœufs, utilisée en Turquie et dans l’Empire ottoman."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd65679b-c2ba-4e8c-9b03-06babfea510b",
                                                "sense_id": "6628fe05-198e-3531-b611-bcb0f4e9eab1",
                                                "text": "Assis dans l’araba mal capitonnée d’un cocher apoplectique, nous fîmes un pieux pèlerinage à la nécropole d’Eyoub, funèbre jeu de dominos, aux doubles-blancs innombrables fichés dans la terre sèche."
                                            },
                                            {
                                                "example_id": "356a1368-d1fa-4e00-8e7b-61c18c3ddc70",
                                                "sense_id": "6628fe05-198e-3531-b611-bcb0f4e9eab1",
                                                "text": "Partis de Mehediya le 21, avec un convoi d’un millier de chameaux, plusieurs centaines d’arabas et du bétail, […], nous atteignons Mouley Idris en cinq étapes […]."
                                            },
                                            {
                                                "example_id": "b2d33467-014c-4d5c-bd03-b6c11df8e51b",
                                                "sense_id": "6628fe05-198e-3531-b611-bcb0f4e9eab1",
                                                "text": "Saïd conduisait le plus souvent l’araba."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
