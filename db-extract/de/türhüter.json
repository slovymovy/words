                "senses": [
                    {
                        "sense_id": "5df8507f-b6b0-3f76-b0c3-67e5f026202b",
                        "entry_id": "7d9c2e9f-5840-379b-8cc3-6f16be4a59f6",
                        "glosses": [
                            "Person, die darauf achtet, dass nur Berechtigte ein- und ausgehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38dfddce-9b65-46e2-85ac-4e9d390cbdd9",
                                "sense_id": "5df8507f-b6b0-3f76-b0c3-67e5f026202b",
                                "text": "„Das Hotel lag noch im Schlaf, aber als ich in die Halle hinunterkam, erschien ein Türhüter und rieb sich die Augen.“"
                            },
                            {
                                "example_id": "cc5a57c8-62d9-4060-b25e-c75227171f93",
                                "sense_id": "5df8507f-b6b0-3f76-b0c3-67e5f026202b",
                                "text": "„Der Türhüter der Kanzlei des Konsulats der Vereinigten Staaten stand, stark wie ein Boxer, hinter dem aktenbeladenen Tisch, der den Aufgang der Treppe versperrte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "47dc20b8-2ea0-43c9-95ba-34a2ba50ff56",
                        "source_entry_id": "7d9c2e9f-5840-379b-8cc3-6f16be4a59f6",
                        "source_sense_id": "5df8507f-b6b0-3f76-b0c3-67e5f026202b",
                        "source_sense_description": "Person, die darauf achtet, dass nur Berechtigte ein- und ausgehen",
                        "target_lang_word": "portier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "portier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6adf8ed9-42af-33b5-9980-d4b8e4571e90",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Homme dont la profession est de garder une porte d’entrée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c87c8870-c06b-41a0-ba4c-cdc668f17ea5",
                                                "sense_id": "6adf8ed9-42af-33b5-9980-d4b8e4571e90",
                                                "text": "Mon hôtel, en façade sur l’une des principales voies, a vraiment noble allure : des portiers corrects gardent son huis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e67259f2-102d-3e07-93f6-b98adc32a11f",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Religieux qui a le soin d’ouvrir et de fermer la porte d’un couvent."
                                        ],
                                        "tags": [
                                            "Par apposition"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "70278cf4-8a96-4414-ac64-ad8b4b05ea23",
                                                "sense_id": "e67259f2-102d-3e07-93f6-b98adc32a11f",
                                                "text": "Le frère portier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5671b2fe-9164-3a29-99ab-9d17aa09eac9",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Dispositif qui ouvre ou ferme une porte de façon automatique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd09009b-ad8f-4bbd-95c4-9ac2873f1783",
                                                "sense_id": "5671b2fe-9164-3a29-99ab-9d17aa09eac9",
                                                "text": "Notre idée ingénieuse pour vos poules : le portier ferme la trappe de votre poulailler à la tombée de la nuit et l’ouvre au lever du jour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "381e939d-72a1-32d5-be61-3aed298bdeac",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Gardien de but."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e7e64b1-254f-4fc3-afcb-d03dcab8f14c",
                                                "sense_id": "381e939d-72a1-32d5-be61-3aed298bdeac",
                                                "text": "Quatre ans plus tard, le portier de 33 ans a vu son avenir se brouiller au Real Madrid comme en sélection, où le match de vendredi au Brésil accrédite l’idée qu’il ne présente plus les mêmes garanties qu’autrefois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72537f9e-4fc5-39e7-82d5-a0943e418e5a",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Concierge, gardien."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "95e53077-2b13-3d9e-9f3e-7c2795bd5ada",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Premier (ou dernier selon le sens) du Klub, 50ᵉ en partant de la fin du classement de sortie."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0064266d-2683-34b6-a72a-6b08905d8089",
                                        "entry_id": "638382bf-3678-30d7-bff1-f824e2580bc8",
                                        "glosses": [
                                            "Logiciel généralement associé à une ou plusieurs passerelles, qui assure notamment la conversion des adresses et vérifie les autorisations d’accès à un réseau."
                                        ],
                                        "tags": [
                                            "Réseaux informatiques"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d86a1827-9bd9-47a6-906f-e6182042cc3f",
                        "source_entry_id": "7d9c2e9f-5840-379b-8cc3-6f16be4a59f6",
                        "source_sense_id": "5df8507f-b6b0-3f76-b0c3-67e5f026202b",
                        "source_sense_description": "Person, die darauf achtet, dass nur Berechtigte ein- und ausgehen",
                        "target_lang_word": "gardien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gardien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                        "entry_id": "58fceac1-c769-3eed-8acb-ea7ba6ce8500",
                                        "glosses": [
                                            "Celui qui garde, surveille quelqu’un ou quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f1c93d-0816-4677-bccc-062158f4fde8",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Les bêtes levèrent leur mufle humide et, dociles à l’invite de leur jeune gardien, gravirent le coteau pour reprendre, […], le chemin de terre bordé de haies vives aboutissant au village."
                                            },
                                            {
                                                "example_id": "e5f8ae53-9261-4b00-8146-526c65cbc53f",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il pense au gardien de la mine d’Ichmoul mettant en fuite les bandits avec les quatre cartouches de son vieux mousqueton."
                                            },
                                            {
                                                "example_id": "aa62c904-5acc-4233-9a8f-51a41ef46e4d",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Il fit état de la tendresse et de l’affection que le couple de lions manifestait à leur gardien."
                                            },
                                            {
                                                "example_id": "4ff3cd60-404f-4bca-bf10-4c2ec27268cc",
                                                "sense_id": "9ddafff1-5a97-3836-89e2-226d9b0807b3",
                                                "text": "Profitant des possibilités de sens offertes par le mot « gardien », qui peut désigner un gardien de cimetière mais aussi un gardien de zoo ou de cirque, le texte propose une descente dans le règne animal et prend dès lors l’allure d’une visite à une ménagerie de cirque."
