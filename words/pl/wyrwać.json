                    "sense_definition": "nagle przerwać trwający stan lub ciszę",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "przerwanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Głośny krzyk <w>wyrwał</w> go z głębokiego snu.",
                            "target_lang_translations": {
                                "ru": "Громкий крик <w>вырвал</w> его из глубокого сна."
                            }
                        },
                        {
                            "text": "Nagły hałas <w>wyrwał</w> wszystkich z zamyślenia.",
                            "target_lang_translations": {
                                "ru": "Внезапный шум <w>вырвал</w> всех из задумчивости."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wyrwać ze snu",
                        "wyrwać z zamyślenia"
                    ],
                    "target_lang_definitions": {
                        "ru": "внезапно прервать текущее состояние или тишину"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вырвать",
                                "target_lang_sense_clarification": "резко вывести из состояния покоя или сна"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1212403e-d212-390a-9778-0bd28bfbd70c",
                    "sense_definition": "zyskać czyjeś względy lub zainteresowanie",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relacje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Próbował <w>wyrwać</w> dziewczynę na dyskotece.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>подцепить</w> девушку на дискотеке."
                            }
                        },
                        {
                            "text": "Udało mu się <w>wyrwać</w> atrakcyjną partnerkę.",
                            "target_lang_translations": {
                                "ru": "Ему удалось <w>закадрить</w> привлекательную партнершу."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie zdobycia partnera"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "добиться чьего-либо внимания или расположения (разговорное)"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подцепить",
                                "target_lang_sense_clarification": "разговорное: познакомиться с кем-то для отношений"
                            },
                            {
                                "target_lang_word": "закадрить",
                                "target_lang_sense_clarification": "сленг: добиться расположения партнера"
                            }
                        ]
                    }
                }
            ]
        }
