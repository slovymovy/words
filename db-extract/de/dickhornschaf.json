                    {
                        "sense_id": "9878edfe-831c-338f-b5ed-47d748fe40e2",
                        "entry_id": "2a2fb654-b651-3e8f-986b-857fa40a5d49",
                        "glosses": [
                            "wildes Schaf, das im westlichen Nordamerika lebt"
