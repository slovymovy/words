                "senses": [
                    {
                        "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                        "entry_id": "70215105-5522-3f93-9c2d-6bd889a16f7f",
                        "glosses": [
                            "Zimmer, das so eingerichtet ist, dass Frauen darin Babys zur Welt bringen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d2c2124-4f47-4509-a2de-0a733fc46867",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "Geburtsräume sind oft in warmen Farben, gelb oder orange, gestrichen."
                            },
                            {
                                "example_id": "d13be817-5e0d-4c1e-8694-54226ea0f547",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Ihre Frau ist schon im Geburtsraum, Herr Böhm.“"
                            },
                            {
                                "example_id": "ecd87b9a-0442-4047-bb26-201c1e53a864",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "Wenn Sie sich zur Geburt anmelden zeigt Ihnen unsere Hebamme auch gerne unsere freundlichen Geburtsräume."
                            },
                            {
                                "example_id": "e116402e-a8e9-4679-b2a6-ecd1155b3502",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Die Hebamme hatte mich in einen der Geburtsräume geführt, auf einem Gymnastikball Platz genommen und mir einen zweiten angeboten. »Welche Wünsche hast du für die Geburt?«“"
                            },
                            {
                                "example_id": "1ceaf05a-7bde-4aa1-af35-2c388602069e",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "In unseren Geburtsräumen stehen jeweils ein großes Bett, eine große Badewanne für eine Wassergeburt, ein Gebärhocker und eine Wickelkommode."
                            },
                            {
                                "example_id": "ce942d22-e495-448f-9e4a-0c433ade495c",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Auf den ersten Blick erinnerten die Geburtsräume an die Zimmer eines Viersternehotels: breites Doppelbett, passende Nachtschränkchen, bequeme Ruhesessel, Flachbildfernseher, Kühlschrank und ein geräumiges Bad.“"
                            },
                            {
                                "example_id": "a0da1765-1dc8-459e-b863-db9a3663e9d6",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Die Architektin Anka Dür hat jetzt einen Geburtsraum entworfen, in dem die Geburt vor allem als etwas Schönes erlebt werden soll.“"
                            },
                            {
                                "example_id": "b41fc963-391a-4dcd-9888-88d7f898e9ff",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Auch in den Entbindungsstationen wird heute zunehmend auf die Atmosphäre der Geburtsräume geachtet.“"
                            },
                            {
                                "example_id": "27ede2e7-d8af-42ce-bb36-2932033f2f6c",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Konzipiert und gestaltet haben hier die Hebammen selbst, und mit einem Kreißsaal haben die Geburtsräume so gar nichts gemein: Da steht ein großes Bett, daneben ein Sessel für den Vater oder andere Begleiter.“"
                            },
                            {
                                "example_id": "31779c17-70e9-42a3-8e52-d81edf9a9e3c",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Welche Rolle spielt die Gestaltung eines Geburtsraumes für ein gelungenes Willkommenserlebnis?“"
                            },
                            {
                                "example_id": "ecb22b0d-9a99-4058-97f9-0e2c0d1f20ab",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Wirklich anheimelnd ist keiner der acht Geburtsräume, auch wenn manche mit kreativen Wand- und Deckenbildern ausgestattet wurden.“"
                            },
                            {
                                "example_id": "2c0040ce-53bc-48a8-aaa6-d1f4abc80e7b",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„Auch nach Jahren im Geburtshaus wundert sich Schüssler noch, dass der Geburtsraum jedes Mal anders aussieht.“"
                            },
                            {
                                "example_id": "2c05309c-4bdf-4eca-a14c-dcf9008c63d7",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„2012 eröffnete die Gynäkologie einen neuen Kreißsaal mit sieben Geburtsräumen und direkter Verbindung zur Kinderintensivstation.“"
                            },
                            {
                                "example_id": "d204db45-836e-46d7-9abd-80f6dc559296",
                                "sense_id": "0a1fb144-ce00-3ae5-9563-3275641a9a15",
                                "text": "„»Wir sind in der Regel drei Hebammen pro Dienst für sechs Geburtsräume und mehrere Aufnahmezimmer.«“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
