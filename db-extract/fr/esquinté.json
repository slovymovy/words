                        "sense_id": "256b2205-c438-3b29-b218-26896fa685dc",
                        "entry_id": "48cd2079-3bbc-36df-b0b5-b058b9acc193",
                        "glosses": [
                            "Qui est très fatigué."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2fd18d4-bc40-4b29-bfbc-06ecbab3a3e2",
                                "sense_id": "256b2205-c438-3b29-b218-26896fa685dc",
                                "text": "Célestine s’emportait, lançait les plus grossières injures, tapait les meubles, glapissait de sa voix esquintée."
                            }
                        ]
                    },
                    {
                        "sense_id": "783853fe-6e15-35fe-b796-31d74d8eadb2",
                        "entry_id": "48cd2079-3bbc-36df-b0b5-b058b9acc193",
                        "glosses": [
                            "Qui est abîmé ou blessé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ae0cdb8-08b0-4ea9-8635-7f3202bf2819",
                                "sense_id": "783853fe-6e15-35fe-b796-31d74d8eadb2",
                                "text": "Ses citations ?\n– Je ne les ai pas sur moi, mon général, avait répondu Conan, mais ça va chercher dans les cinquante-deux Fritz esquintés en dix-huit coups de main."
                            },
                            {
                                "example_id": "251f9225-7d76-416c-ba90-8a54371b60aa",
                                "sense_id": "783853fe-6e15-35fe-b796-31d74d8eadb2",
                                "text": "J’ai le bras gauche esquinté. Peu de gens le savent. C’est un accident de naissance – la conséquence d’un accouchement difficile – et, à l’époque, la rééducation, on ne connaissait pas."
                            }
                        ]
                    }
