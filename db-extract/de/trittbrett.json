                    }
                ],
                "senses": [
                    {
                        "sense_id": "0abb604b-00a5-394c-910e-f09411e8d641",
                        "entry_id": "182c2f71-a31e-3160-ae1a-6142cb4e9152",
                        "glosses": [
                            "Stufe, die das Einsteigen in ein Fahrzeug erleichtert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4668313-34ee-4c1b-8ab2-fd4bf88bed3c",
                                "sense_id": "0abb604b-00a5-394c-910e-f09411e8d641",
                                "text": "„Ich stieg auf das Trittbrett, und schon ruckte er an.“"
                            },
                            {
                                "example_id": "1c938c1c-099f-4be7-9239-977792c7f44a",
                                "sense_id": "0abb604b-00a5-394c-910e-f09411e8d641",
                                "text": "„Die Waggons sind verschlossen, jeder Waggon hat seinen Aufseher, auf den Trittbrettern stehen bewaffnete Soldaten.“"
                            },
                            {
                                "example_id": "03d7f828-c2d3-43ac-9f21-d8f34de66d65",
                                "sense_id": "0abb604b-00a5-394c-910e-f09411e8d641",
                                "text": "„Sie stellten sich auf die Trittbretter und auf die Stufen vor dem Bremserhäuschen.“"
                            },
                            {
                                "example_id": "dc17926a-cbd4-4fc0-ad7b-f75f8298d07a",
                                "sense_id": "0abb604b-00a5-394c-910e-f09411e8d641",
                                "text": "„Macomber stieg durch die gewölbte Öffnung neben dem Beifahrersitz aufs Trittbrett und von dort auf den Boden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
