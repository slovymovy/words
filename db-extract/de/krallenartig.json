                "senses": [
                    {
                        "sense_id": "0536dcf0-62e6-32e7-8a64-366f8aa9b2c1",
                        "entry_id": "302bbf77-ccf6-3db8-8f1b-f14e6d1c5db3",
                        "glosses": [
                            "Krallen ähnelnd, an Krallen erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "053575b9-9d51-425f-90ea-c2aead73f7fb",
                                "sense_id": "0536dcf0-62e6-32e7-8a64-366f8aa9b2c1",
                                "text": "„Die Lenden der Kreatur wurden von einem Schurz aus echter Schlangenhaut bedeckt, und in ihren krallenartigen Händen hielt sie einen kurzen Speer mit steinerner Spitze und einen bedrohlich aussehenden Schlaghammer aus poliertem Feuerstein.“"
                            },
                            {
                                "example_id": "f7c65f93-c198-4f92-bbf6-410032516fd5",
                                "sense_id": "0536dcf0-62e6-32e7-8a64-366f8aa9b2c1",
                                "text": "„Damit legte der Professor auch seine andere krallenartige Hand an seinen Stab und ließ ihn in einem schwarz-verschwommenen Rauschen heruntersausen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
