                ],
                "senses": [
                    {
                        "sense_id": "ae135879-1269-3715-9d9c-e38fe31d44f6",
                        "entry_id": "21dca9c8-ed59-38ce-aa9f-d335fb7deab5",
                        "glosses": [
                            "Genre de petits carnivores asiatiques, de la taille d’un chat, aux habitudes fouisseuses mais aussi arboricoles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dcd8f3be-16f6-47c6-9543-67ca2f7f9b5b",
                                "sense_id": "ae135879-1269-3715-9d9c-e38fe31d44f6",
                                "text": "Le blaireau-furet s’adapte à plusieurs milieux, de la prairie à la forêt tropicale. C’est un animal nocturne qui se nourrit de graines, de fruits, d’insectes, de vers ou de grenouilles."
                            },
                            {
                                "example_id": "9108f02a-6683-4a41-b7f3-5bb272450534",
                                "sense_id": "ae135879-1269-3715-9d9c-e38fe31d44f6",
                                "text": "L’étude privilégie la théorie généralement admise de la transmission naturelle du virus d'un animal réservoir (probablement la chauve-souris) à l’humain, par l’intermédiaire d’un autre animal non encore identifié. Parmi les suspects figurent le chat domestique, le lapin ou le vison, ou encore le pangolin ou le blaireau-furet."
                            },
                            {
                                "example_id": "7e8f3cbc-3d6f-471a-8a12-8f044b964404",
                                "sense_id": "ae135879-1269-3715-9d9c-e38fe31d44f6",
                                "text": "Découvert en 1831 par Geoffroy Saint-Hilaire, zoologiste français, le blaireau-furet est un animal peu connu du grand public. … Animal omnivore, nocturne, et plutôt discret, le blaireau-furet mesure en moyenne 33 à 43 centimètres et pèse 1 à 3 kg."
                            }
                        ]
                    }
