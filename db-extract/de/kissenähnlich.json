                ],
                "senses": [
                    {
                        "sense_id": "79af2ffa-e307-3317-b0c4-589d58168653",
                        "entry_id": "e0888cca-04ce-33d5-8959-90cf7eee17a8",
                        "glosses": [
                            "einem Kissen ähnelnd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc871549-c986-478f-ae3e-73302effcc86",
                                "sense_id": "79af2ffa-e307-3317-b0c4-589d58168653",
                                "text": "„Ein wenig später, als eine Veränderung und ein leichtes Zucken die toten Gliedmaßen zu erfassen schien, drückte West einen kissenähnlichen Gegenstand fest auf das zuckende Gesicht und entfernte ihn erst wieder, als der Leichnam ruhig schien und bereit für unseren Wiederbelebungsversuch.“"
                            },
                            {
                                "example_id": "2c1a9aa6-b780-47a6-b406-c734927c75cb",
                                "sense_id": "79af2ffa-e307-3317-b0c4-589d58168653",
                                "text": "„Große Schwefelfontänen kühlen sich schlagartig beim Kontakt mit dem kalten Meerwasser ab, bilden groteske, kissenähnliche Strukturen, wenn sie sich in schwarze Gesteine umwandeln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
