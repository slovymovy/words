                "senses": [
                    {
                        "sense_id": "fa8d6806-3e43-3209-9f07-3ed9d8cd4a86",
                        "entry_id": "a873163d-4b9b-334d-98d4-47fd5ec49f07",
                        "glosses": [
                            "Stoff, für die Herstellung von Gardinen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6095a1f0-1301-4a84-936d-a83149b43582",
                                "sense_id": "fa8d6806-3e43-3209-9f07-3ed9d8cd4a86",
                                "text": "Wo hast du den Gardinenstoff gekauft?"
                            },
                            {
                                "example_id": "6dfcaaa4-623a-4026-b3de-164adcbe0b1d",
                                "sense_id": "fa8d6806-3e43-3209-9f07-3ed9d8cd4a86",
                                "text": "„Isabelle Hagen etwa möchte Gebäck im Supermarkt nicht in einem Beutel aus Gardinenstoff aufs Kassenband legen, wie es ihr empfohlen wurde.“"
                            },
                            {
                                "example_id": "c21a4f16-2eff-445a-8466-2a3935a8afd6",
                                "sense_id": "fa8d6806-3e43-3209-9f07-3ed9d8cd4a86",
                                "text": "„Martha Helen Stewart, geborene Kostya, 62, präsentiert sich gern als amerikanische Vorzeige-Hausfrau, die ihren Perfektionismus an Gardinenstoff und Tischdekoration auslebt.“"
                            }
                        ],
