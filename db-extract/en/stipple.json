                        "entry_id": "1056dee8-c066-3f6c-ac21-3338c4c32744",
                        "glosses": [
                            "The use of small dots that give the appearance of shading; the dots thus used."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
