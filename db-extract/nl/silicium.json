                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "silicon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e470a2c4-5b60-3707-900b-7ca7382acb2d",
                                        "entry_id": "f2e4b73a-e64b-33bb-bacb-cd0a5ecce315",
                                        "glosses": [
                                            "A nonmetallic element (symbol Si) with an atomic number of 14 and atomic weight of 28.0855."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "864430eb-20ff-4587-a8a1-2efee1285bf2",
                                                "sense_id": "e470a2c4-5b60-3707-900b-7ca7382acb2d",
                                                "text": "The isolated disordered regions and the amorphous layer have widely different anneal behavior. In the case of germanium and silicon, the isolated disordered regions anneal at moderate temperatures of approximately 200° and 300° C, respectively. The amorphous layers also anneal in a characteristic fashion, but at appreciably higher temperatures, i.e., at approximately 600° C in silicon and 400° C in germanium."
                                            },
                                            {
                                                "example_id": "bed22e60-f230-41f3-8c97-cc2eed73272e",
                                                "sense_id": "e470a2c4-5b60-3707-900b-7ca7382acb2d",
                                                "text": "His idea is to stand billions of ultrafine wire loops around the edge of a silicon chip — hence the name racetrack — and use electric current to slide infinitesimally small magnets up and down along each of the wires to be read and written as digital ones and zeros."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d05a4719-5596-388b-92c9-40370cbaaffd",
                                        "entry_id": "f2e4b73a-e64b-33bb-bacb-cd0a5ecce315",
                                        "glosses": [
                                            "A single atom of this element."
                                        ],
                                        "tags": [
                                            "countable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
