                ],
                "senses": [
                    {
                        "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                        "entry_id": "7aad4986-4307-376c-ae7d-9a601411d8e7",
                        "glosses": [
                            "Vertreter des Expressionismus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "149830d1-2de7-4c06-b163-8d8d232bdd65",
                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                "text": "„Mit der Wiederentdeckung der Expressionisten hätte sich mein Vater gerne geschmückt.“"
                            },
                            {
                                "example_id": "7d2be95d-4045-4e0d-bbe1-9d79cbb06d52",
                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                "text": "„Hanns Johst will helfen, aber Wolfgang Willrich, unterstützt von Ernährungsminister Walther Darré, greift auch ihn an, schließlich hat auch Johst als Expressionist und Jungautor »dumme Sachen« gemacht.“"
                            },
                            {
                                "example_id": "7eff1050-2de3-487d-8dd1-51c0b35457fd",
                                "sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                                "text": "„Auf der nahe gelegenen Kurischen Nehrung konnte man den großen deutschen Expressionisten der Zeit beim Malen zusehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1edde807-494d-4f27-9f9e-0b20aa8352dc",
                        "source_entry_id": "7aad4986-4307-376c-ae7d-9a601411d8e7",
                        "source_sense_id": "bff1dfb3-332d-343b-95db-0ca9994d5a81",
                        "source_sense_description": "Vertreter des Expressionismus",
                        "target_lang_word": "expressionist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expressionist",
