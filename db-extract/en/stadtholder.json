                                            {
                                                "example_id": "e9edc66f-f2f7-4f81-9a05-1f95fbb02da6",
                                                "sense_id": "780fdd34-6e11-32b2-89e2-d385f21984c4",
                                                "text": "Georges Cuvier trouve ainsi dans la collection scientifique du stathouder de Hollande des crânes d’éléphants de Ceylan et du Cap, qui lui permettent de confirmer qu’il y a deux espèces distinctes d’éléphants vivants."
                                            },
                                            {
                                                "example_id": "c029a1d3-44f1-4d33-a2cc-56ea7e167616",
                                                "sense_id": "780fdd34-6e11-32b2-89e2-d385f21984c4",
                                                "text": "un stathouder qui se fera roi ;"
                                            },
                                            {
                                                "example_id": "a91e1494-26c6-481d-b2bb-826c926be047",
                                                "sense_id": "780fdd34-6e11-32b2-89e2-d385f21984c4",
                                                "text": "Sur la proposition de Brissot, elle déclare la guerre au roi d’Angleterre, au stathouder de Hollande, au roi d’Espagne."
                                            }
                                        ]
                                    }
                                ]
                            }
