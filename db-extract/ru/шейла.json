                        "source_entry_id": "cfa3e611-0ff2-3ab8-82b7-e452e9fe9cb1",
                        "source_sense_id": "04c337fc-96e6-337e-9b13-d1e943b18c4b",
                        "target_lang_word": "Sheila",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sheila",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2a58ac8-3a49-30cf-a62e-50d25310e5d7",
                                        "entry_id": "7f663a36-5bca-396c-8658-f6f3ac4410db",
                                        "glosses": [
                                            "A female given name from Irish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f48d09-313e-4c75-b5bc-ec8b9c181a12",
                                                "sense_id": "b2a58ac8-3a49-30cf-a62e-50d25310e5d7",
                                                "text": "Were English girls not good enough for him that he must needs come up and take away Sheila Mackenzie, and keep her there in the South."
                                            },
                                            {
                                                "example_id": "8af06184-0ca0-4b77-8e8b-d518ca804b99",
                                                "sense_id": "b2a58ac8-3a49-30cf-a62e-50d25310e5d7",
                                                "text": "What lovely names for girls there are! / There's Stella like the Evening Star, / And Sylvia like a rustling tree, / And Lola like a melody, / And Flora like a flowery morn, / And Sheila like a field of corn,"
                                            },
                                            {
                                                "example_id": "922f88e1-ef30-48b0-8938-672f9d77ee65",
                                                "sense_id": "b2a58ac8-3a49-30cf-a62e-50d25310e5d7",
                                                "text": "He shortened her name to Sheila which, in spite of its primness, she seemed to love. - - - For Susheela - Sheila, as she was now known - this creeping daylight signalled the start, not the end of sleep."
                                            }
                                        ]
                                    }
                                ]
                            },
