                        "für Ordnung sorgen",
                        "in Ordnung"
                    ]
                },
                {
                    "sense_id": "d99b53c0-5408-3ef1-85ea-bcd33480ab57",
                    "sense_definition": "Gesamtheit verbindlicher Regeln, Gesetze oder Richtlinien, die das menschliche Zusammenleben strukturieren.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "regeln",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Polizei ist für die Sicherheit und öffentliche <w>Ordnung</w> zuständig."
                        },
                        {
                            "text": "In diesem Gebäude gilt eine strenge <w>Ordnung</w> für alle Bewohner."
