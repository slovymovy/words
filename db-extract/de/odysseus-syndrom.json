                "senses": [
                    {
                        "sense_id": "5283bece-6b1c-3dcf-b359-2caf9af763f7",
                        "entry_id": "c9df67f0-9e03-3e3e-8f68-21cb8744c317",
                        "glosses": [
                            "psychische Störung, bei der Migranten aufgrund von psychischen Belastungen an Stress, Depressionen, Nervosität, Schlaflosigkeit und Realitätsverlust leiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2df66b23-9961-49d1-8683-46a94e04a54a",
                                "sense_id": "5283bece-6b1c-3dcf-b359-2caf9af763f7",
                                "text": "Das Odysseus-Syndrom bzw. Einwanderersyndrom mit chronischem Mehrfachstress wird durch eine Reihe von Kümmernissen ausgelöst, die sich aus dem Verlust von Werten ableiten, die für den Einzelnen sehr wichtig sind: die Familie, die Freunde, die eigene Kultur, das Vaterland, die soziale Position und die physische Sicherheit."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cebcdf44-ba32-3120-a40f-1da5b98a082d",
                        "entry_id": "c9df67f0-9e03-3e3e-8f68-21cb8744c317",
                        "glosses": [
                            "psychische Störung, bei welcher der Kranke wegen eines falschen Befundes oder einer unklaren Diagnose eine Irrfahrt (Odyssee) von Arzt zu Arzt durchführt, beziehungsweise eine Behandlung nach der anderen erfährt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc699fd7-ae17-47ce-b457-0156c374c23c",
                                "sense_id": "cebcdf44-ba32-3120-a40f-1da5b98a082d",
                                "text": "Als Odysseus- oder engl. Ulysses-Syndrom bezeichnet man Zustände, bei denen der Kranke wegen eines falschen Befundes oder einer unklaren Diagnose eine Irrfahrt von Arzt zu Arzt durchführt bzw eine Behandlung nach der anderen erfährt."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "90b92aed-22a2-30fa-ae5d-b780d31691cb",
                        "entry_id": "c9df67f0-9e03-3e3e-8f68-21cb8744c317",
                        "glosses": [
                            "psychische Störung, bei der ein Patient eine irreversible Selbstbindung vornimmt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "849f0e18-eb7d-41db-99cf-3b0c1dc8d454",
                                "sense_id": "90b92aed-22a2-30fa-ae5d-b780d31691cb",
                                "text": "Situationen, bei denen eine irreversible Selbstbindung vorgenommen wird, werden als Odysseus-Syndrom bezeichnet."
                            },
                            {
                                "example_id": "c9c83c05-4131-4faf-a3d4-bddcf3f5cd5d",
                                "sense_id": "90b92aed-22a2-30fa-ae5d-b780d31691cb",
                                "text": "Die krankhafte Überzeugung, dass eine nahestehende Person verstorben sei, obwohl diese tatsächlich noch lebt, heißt Odysseus-Syndrom."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
