                    "sense_id": "519e2727-54b8-38d6-8246-c1c6ad11bd80",
                    "sense_definition": "A sneaky, unexpected, or clever swap or exchange.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "swap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company pulled a <w>switcheroo</w> by replacing the popular product with a cheaper version.",
                            "target_lang_translations": {
                                "pl": "Firma zrobiła <w>podmiankę</w>, zastępując popularny produkt tańszą wersją."
                            }
                        },
                        {
                            "text": "He did not expect the <w>switcheroo</w> when his seat was changed at the last minute.",
                            "target_lang_translations": {
                                "pl": "Nie spodziewał się takiej <w>podmianki</w>, gdy w ostatniej chwili zmieniono mu miejsce."
                            }
                        }
                    ],
                    "synonyms": [
                        "swap",
                        "exchange"
                    ],
                    "common_phrases": [
