                },
                {
                    "sense_id": "9f8df4c8-7d48-34c0-8af8-297955c07a9e",
                    "sense_definition": "Leitet einen Nebensatz ein, der den Grund oder Anlass für die Handlung des Hauptsatzes angibt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "kausal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Nachdem</w> alle Vorbereitungen abgeschlossen sind, können wir nun endlich mit der Konferenz beginnen."
                        },
                        {
                            "text": "<w>Nachdem</w> er keine Einwände erhob, wurde der gemeinsame Vorschlag ohne Diskussion angenommen."
