                "senses": [
                    {
                        "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                        "entry_id": "8d9a4cfa-c39e-3f3d-94f7-16ae8a707edd",
                        "glosses": [
                            "fehlende Bereitschaft, Unlust zum Spielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "281d9546-af63-4858-a169-46ed1a58a19e",
                                "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                                "text": "„Dies führt zu einer Spielmüdigkeit, der mitunter auch durch immer wieder neue oder neu zusammengesetzte Spielprogramme nicht mehr entgegenzuwirken ist.“"
                            },
                            {
                                "example_id": "c9fe7c0c-4885-4715-bfb4-e31d1b15e121",
                                "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                                "text": "„Daß Kasparow zuletzt zehn Monate bei keinem ernsthaften Turnier zu sehen war, hat indes nichts mit Spielmüdigkeit oder dem nahenden Ende seiner Karriere zu tun.“"
                            },
                            {
                                "example_id": "34824920-65ef-4ec6-81a9-8bf4efc7eadc",
                                "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                                "text": "„Bei ersten Anzeichen von Überanstrengung, Spielmüdigkeit und nachlassendem Interesse sollte die Beendigung eines Spiels möglichst schnell erfolgen.“"
                            },
                            {
                                "example_id": "83a9ba31-5619-4a2e-9874-99ba11acca41",
                                "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                                "text": "„Wer als Reaktion auf Spielmüdigkeit stets mehr Spielzeug heranschafft, hat langfristig wenig Aussicht auf Erfolg.“"
                            },
                            {
                                "example_id": "55942f35-f825-4505-ab91-91ee5d500d4d",
                                "sense_id": "7a4ecfb1-5769-386b-90f7-68c775ac1d4c",
                                "text": "„Diese Spielmüdigkeit ist auch Mawerick anzumerken, schon nach wenigen Wochen, vielleicht ist es aber auch nur die dringende Notwendigkeit zwei neuer Nieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
