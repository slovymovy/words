                ],
                "senses": [
                    {
                        "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                        "entry_id": "332ce53f-3765-3439-9f9f-fdd789518479",
                        "glosses": [
                            "Geruch, der von Wacholder stammt oder daran erinnert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f7406b5-4703-4fd3-8d6f-da084f964194",
                                "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                                "text": "„Verräuchert entfalten Wacholderbeeren den typischen Wacholdergeruch, der sich gut mit anderen aromatischen Düften kombinieren lässt, wie beispielsweise Rosmarin, Harz von Fichte und Kiefer oder auch Weihrauch.“"
                            },
                            {
                                "example_id": "afdebbb6-d60f-4b86-9c0e-b7ad055bc412",
                                "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                                "text": "„Der Wacholdergeruch ist stechend stark.“"
                            },
                            {
                                "example_id": "e0450be3-d770-4c7b-a1b2-14440ed648a5",
                                "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                                "text": "„Keine Spur vom würzig duftendem Wacholdergeruch kam auf die Zunge - woher auch.“"
                            },
                            {
                                "example_id": "3882f8bb-e10f-47d2-b11a-e08f69513f1d",
                                "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                                "text": "„Als er eine Viertelmeile auf der Landstraße gelaufen war, sah er auf dem Stoppelfeld eine Reihe von Rauchsäulen aufsteigen, und ein angenehmer Wacholdergeruch dampfte ihm entgegen.“"
                            },
                            {
                                "example_id": "6f5087af-c09e-4796-af5e-fc9260fc0132",
                                "sense_id": "408c8b0e-eade-302a-8d72-457ed5de7b4f",
                                "text": "„Das angenehm harzig riechende Holz mit dem typischen Wacholdergeruch wurde in der alten Küche gern zum Räuchern von Schinken verwendet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
