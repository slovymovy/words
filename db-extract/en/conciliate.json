                                "target_senses": [
                                    {
                                        "sense_id": "ab08650d-5ce4-3f80-b81a-cc14ccffd49a",
                                        "entry_id": "a1c6fbe3-f52d-34b4-b566-bcc35916ecc7",
                                        "glosses": [
                                            "jemandem, der sich aufregt oder ängstigt, die Vorbehalte oder Sorgen nehmen/versuchen zu nehmen, damit alles wieder normal und handhabbar wird/aussieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ef71c4f4-a0c9-442f-af49-df89df8d6598",
                                                "sense_id": "ab08650d-5ce4-3f80-b81a-cc14ccffd49a",
                                                "text": "„‚Still, still, kleiner Schreihals!‘ beschwichtigte die gute, dicke Fran ängstlich.“"
                                            },
                                            {
                                                "example_id": "5a5d1015-cf21-47d3-b1e2-282305a8acbd",
                                                "sense_id": "ab08650d-5ce4-3f80-b81a-cc14ccffd49a",
                                                "text": "„Die nächsten Tage regnete es, und Honoré Robert beschwerte sich immer lautstärker, während ihn sein Neffe hin und wieder, jedoch vergeblich, zu beschwichtigen suchte.“"
                                            },
                                            {
                                                "example_id": "e9409758-b31f-4095-b779-8c1f6f0a0ba7",
                                                "sense_id": "ab08650d-5ce4-3f80-b81a-cc14ccffd49a",
                                                "text": "Die umgerechnet 3,4 Milliarden Euro sollen den euroskeptischen Flügel der Konservativen beschwichtigen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
