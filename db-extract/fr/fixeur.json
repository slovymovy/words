                        "translation_id": "64b22979-8be2-4133-afa0-35f9a58fd1af",
                        "source_entry_id": "be75dd6b-e1fe-33a2-97a0-928213f19efe",
                        "source_sense_id": "bddd7d7c-e820-3662-9e58-9a7961a9079c",
