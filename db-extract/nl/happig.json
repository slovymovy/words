                                        "glosses": [
                                            "Enthusiastic; keen; eager; showing great interest in something or desire to do something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed459924-31a6-4300-a435-2c4f57f67936",
                                                "sense_id": "b96b26e9-f20d-368d-8ae4-358bfa55f520",
                                                "text": "an avid fan of 1960s sci-fi movies"
                                            },
                                            {
                                                "example_id": "07c886a0-d822-469b-81a1-6a2316c6df7f",
                                                "sense_id": "b96b26e9-f20d-368d-8ae4-358bfa55f520",
                                                "text": "an avid learner of history"
                                            },
                                            {
                                                "example_id": "fbf1f995-f6af-4214-9733-9668010042aa",
                                                "sense_id": "b96b26e9-f20d-368d-8ae4-358bfa55f520",
                                                "text": "I'm an avid reader."
                                            },
                                            {
                                                "example_id": "b164b3a5-0dd1-4895-9acc-44ba74cb8205",
                                                "sense_id": "b96b26e9-f20d-368d-8ae4-358bfa55f520",
                                                "text": "A blanket disdain for indigenous foods doesn't explain the delay, because Spain was avid to adopt a different New World root."
                                            },
                                            {
                                                "example_id": "e5591386-ac99-45ce-903b-9317389b40be",
                                                "sense_id": "b96b26e9-f20d-368d-8ae4-358bfa55f520",
                                                "text": "We waited for something to happen, for anything to happen, we were avid for some event to unfold itself out of the burning nothing to save us."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6e94321c-2438-4091-a2a4-9c6793d79f0c",
                        "source_entry_id": "bffd57ab-95ff-3f70-9155-ac596716bd53",
                        "source_sense_id": "c05d4108-2bc9-3756-a856-47e995127f1c",
                        "target_lang_word": "eager",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
