    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83ac7abc-f415-340c-bb6f-5d9f793ed519",
                    "sense_definition": "Qui a vaincu ou remporté un succès éclatant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "victoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après une longue bataille, l'armée <w>triomphante</w> fit son entrée dans la capitale libérée."
                        },
                        {
                            "text": "Le héros <w>triomphant</w> a brandi son trophée devant une foule enthousiaste."
                        }
                    ],
                    "common_phrases": [
                        "armée triomphante",
                        "héros triomphant",
                        "retour triomphant"
                    ]
                },
                {
                    "sense_id": "221991a4-fe94-3d4d-8b9b-b6c273c314a0",
                    "sense_definition": "Qui exprime une grande satisfaction, une fierté ou une confiance liée au succès.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il affichait un sourire <w>triomphant</w> après avoir réussi son examen du premier coup."
                        },
                        {
                            "text": "Elle est entrée dans la pièce d'un air <w>triomphant</w> pour annoncer la bonne nouvelle."
                        }
                    ],
                    "common_phrases": [
                        "air triomphant",
                        "sourire triomphant",
                        "regard triomphant"
                    ]
                },
                {
                    "sense_id": "2e32dd59-be7a-324a-b1a5-d8aff03e7eb1",
                    "sense_definition": "Qui tire avantage d'une situation et s'en prévaut avec ostentation.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "attitude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est revenu <w>triomphant</w> après avoir obtenu gain de cause lors de la négociation."
                        },
                        {
                            "text": "D'un ton <w>triomphant</w>, elle rappela à tous ses collègues qu'elle avait vu juste."
                        }
                    ],
                    "common_phrases": [
                        "ton triomphant"
                    ]
                },
                {
                    "sense_id": "a63e79a5-650f-3301-816f-fe906ce7da31",
                    "sense_definition": "Qui reçoit les honneurs officiels du triomphe, particulièrement dans l'Antiquité romaine.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "victoire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le général <w>triomphant</w> défilait sur son char au milieu des acclamations du peuple romain."
                        },
                        {
                            "text": "Le sénat accorda une cérémonie solennelle au consul <w>triomphant</w> de retour de campagne."
                        }
                    ],
                    "common_phrases": [
                        "général triomphant"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "contexte historique romain"
                        }
                    ]
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
