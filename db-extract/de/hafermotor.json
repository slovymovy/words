                                    }
                                ]
                            },
                            {
                                "target_word": "zèbre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ad6a60-db26-36eb-8d47-0d871d3c3df4",
                                        "entry_id": "2c7d3be5-0dd6-3cd0-86cc-8b1c83dbcada",
                                        "glosses": [
                                            "Personne à haut potentiel intellectuel, surdouée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a84770ad-a171-4eb6-bbf2-1af2ad5a9b97",
                                                "sense_id": "f4ad6a60-db26-36eb-8d47-0d871d3c3df4",
                                                "text": "Dans les classes nous avons déjà les « bêtes comme un âne », les « têtus comme une mule », les « malins comme un singe » ou encore les « bavards comme une pie », les « muets comme une carpe » et les « chevaux de course », premiers de la classe ! Alors, pourquoi pas « doué comme un zèbre » ?"
                                            },
                                            {
                                                "example_id": "4886bb87-4711-4f4a-bc55-2bbbc6b5b486",
                                                "sense_id": "f4ad6a60-db26-36eb-8d47-0d871d3c3df4",
                                                "text": "Êtes-vous un zèbre? Eh non, le terme « zèbre » ne s'applique pas qu'aux mammifères à rayures: il désigne aussi les individus à haut potentiel intellectuel (HPI), ceux que l'on dit « doués »."
                                            }
                                        ]
                                    }
                                ]
                            },
