                        "examples": [
                            {
                                "example_id": "0d1c34c8-7385-4e4d-abb8-bea60d6bd919",
                                "sense_id": "beeba031-94fc-3409-a1b8-4019802b052d",
                                "text": "„Einem Pizzalieferanten geben die Leute ohne Zögern ihre Adresse.“"
                            },
                            {
                                "example_id": "9829ed9b-7df1-4f3e-92ff-47f62ee5093d",
                                "sense_id": "beeba031-94fc-3409-a1b8-4019802b052d",
                                "text": "„Ein im Eilverfahren errichteter Schrein. Erbaut, noch bevor die Collegestudenten und Pizzalieferanten und Skateboardfahrer ihre Einberufungsbefehle erhielten.“"
                            },
                            {
                                "example_id": "fd5f5c45-994d-4b33-9f00-e539477b5f47",
                                "sense_id": "beeba031-94fc-3409-a1b8-4019802b052d",
                                "text": "„»Hiro Protagonist«, sagt der Lametta, als Hiro ihn schließlich in der Dunkelheit neben einer Hütte stellen kann. »CIC-Stringer seit elf Monaten. Spezialisiert auf die Industrie. Ehemaliger Hacker, Nachtwächter, Pizzalieferant, Konzertpromoter«“"
                            }
                        ],
