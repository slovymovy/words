                    {
                        "sense_id": "f7337f14-d3ee-3ff0-af33-9fa34af1fd1b",
                        "entry_id": "33d9e39e-68eb-38be-87b6-501a07ad55d2",
                        "glosses": [
                            "any small round table"
                        ],
                        "tags": [
