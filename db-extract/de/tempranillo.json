                "senses": [
                    {
                        "sense_id": "011d1677-1a4b-3472-adc1-fe3dc6cba303",
                        "entry_id": "ed8e9adb-f4cb-3bd3-baf4-87f7519dcc41",
                        "glosses": [
                            "eine rote, spanische Rebsorte, die auch in Südamerika angebaut wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f60021-a142-41c3-8711-235af4a5d5db",
                                "sense_id": "011d1677-1a4b-3472-adc1-fe3dc6cba303",
                                "text": "Der Tempranillo „eignet sich hervorragend für den Ausbau im Eichenfass und bringt die qualitativ hochwertigsten spanischen Weine hervor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ab0bc76-e043-3492-9089-6098a864ecd8",
                        "entry_id": "ed8e9adb-f4cb-3bd3-baf4-87f7519dcc41",
                        "glosses": [
                            "Wein, der aus der Rebsorte Tempranillo hergestellt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e3ecc0e0-85e4-4a7c-b670-ae7af4901d95",
                                "sense_id": "9ab0bc76-e043-3492-9089-6098a864ecd8",
                                "text": "Der Tempranillo zeichnet sich durch elegante Weiche und süße Tannine aus, weshalb er im Gegensatz zum Cabernet schon als Jungwein getrunken werden kann, obwohl seine Stärke erst im Barriqueausbau zur Geltung kommt."
                            },
                            {
                                "example_id": "7a38634f-41d0-47ff-b7bb-b8d36e0ded5f",
                                "sense_id": "9ab0bc76-e043-3492-9089-6098a864ecd8",
                                "text": "„Tempranillo - Die helle, würzige, feine Rioja-Traube wird in Katalonien ull-de-llebre und in La Mancha cencibel genannt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
