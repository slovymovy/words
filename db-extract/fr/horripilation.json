                        "sense_id": "5380703e-cade-34a6-9c41-3533656890e0",
                        "entry_id": "bd9a1800-dcd9-326d-a8a7-d502812272ee",
                        "glosses": [
                            "Frissonnement accompagné de froid, qui fait hérisser les poils."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07621c54-ffd9-48cd-9567-0fc043b4695b",
                                "sense_id": "5380703e-cade-34a6-9c41-3533656890e0",
                                "text": "Cela peut être aussi bien une légère accélération cardiaque, une augmentation de la sudation ou de l’horripilation, ou encore de la dilatation pupillaire."
                            },
                            {
                                "example_id": "0a10e505-9b89-44b4-8e4a-2ed146f6b212",
                                "sense_id": "5380703e-cade-34a6-9c41-3533656890e0",
                                "text": "En entendant ces vibrations lugubres, le docteur Patak est pris d’une peur convulsive, d’une insurmontable angoisse, d’une irrésistible épouvante, qui lui fait courir de froides horripilations sur tout le corps."
                            }
                        ]
                    }
