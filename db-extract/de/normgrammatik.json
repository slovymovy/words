                ],
                "senses": [
                    {
                        "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                        "entry_id": "e07c02a7-9cb9-3c06-a6a3-e2df6ef6c26b",
                        "glosses": [
                            "Grammatik, die eine Sprache nicht nur beschreibt, sondern Normen für den korrekten Sprachgebrauch setzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff429a13-21f6-419f-9423-bdd3b4882102",
                                "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                                "text": "„Die überregionale Schreibsprache, für die es keine Lehrbücher oder Normgrammatiken gab, beherrschten sie nur noch unvollkommen.“"
                            },
                            {
                                "example_id": "b2f12577-8c5f-4d92-9972-3197ff4efafc",
                                "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                                "text": "„Qualifikationsziele und Inhalte: Aktive und passive Sprachkompetenz (Wortschatz, Formenlehre, Syntax); Fähigkeit, Sprachrichtigkeit im Sinne der Normgrammatik zu beurteilen und der Normgrammatik entsprechende lateinische Texte zu verfassen; Fähigkeit, die Angemessenheit deutscher Übersetzungen aus dem Lateinischen zu beurteilen.“"
                            },
                            {
                                "example_id": "e92bac27-b930-4b4f-bfea-bf557428e7d8",
                                "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                                "text": "„Frühe Zeugnisse für dieses vom Standpunkt der Normgrammatik aus zum Teil fehlerhafte Latein sind vor allem die Wandinschriften Pompeiis und die Freigelassenengespräche Petrons, später auch etwa die Warnungen der Grammatiker vor Sprachfehlern.“"
                            },
                            {
                                "example_id": "3cf73445-5b94-4ec4-a967-af325abef3a8",
                                "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                                "text": "„Obwohl garniert mit Neologismen, entspricht die Sprache in Form- und Satzlehre der Normgrammatik.“"
                            },
                            {
                                "example_id": "ac4e57a4-a0c8-4263-8014-ee77279e3c3b",
                                "sense_id": "0e09a7fd-796d-39d1-96cc-07d9160d23f7",
                                "text": "„Im 17. und 18. Jahrhundert insgesamt war die Sprachbeobachtung an der Normgrammatik orientiert, deren Aufgabe nicht darin bestand, empirisch zu untersuchen, wie eine Sprache faktisch gebaut war oder funktionierte, sondern darin, festzulegen, wie eine Sprache — von der phonetischen Ebene über die morphologische bis zur Stilebene — sein sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
