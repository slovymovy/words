                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы гуляли в парке совсем <w>недолго</w>, потому что начался дождь.",
                            "target_lang_translations": {
                                "en": "We walked in the park for quite <w>a short time</w> because it started to rain.",
                                "nl": "We hebben <w>niet lang</w> in het park gewandeld, omdat het begon te regenen.",
                                "pl": "Spacerowaliśmy po parku <w>niedługo</w>, ponieważ zaczął padać deszcz.",
                                "de": "Wir waren nur <w>kurz</w> im Park spazieren, weil es anfing zu regnen.",
                                "fr": "Nous nous sommes promenés dans le parc <w>pas longtemps</w> du tout, car il a commencé à pleuvoir.",
                                "it": "Abbiamo passeggiato nel parco per <w>poco tempo</w>, perché ha iniziato a piovere.",
                                "cs": "V parku jsme se procházeli jen <w>krátce</w>, protože začalo pršet.",
                                "tr": "Yağmur başladığı için parkta <w>kısa bir süre</w> yürüdük.",
                                "es": "Paseamos por el parque <w>poco tiempo</w>, porque empezó a llover.",
                                "zh": "因为下雨了，我们在公园里只待了<w>一会儿</w>。"
                            }
                        },
                        {
                            "text": "Ждать автобуса пришлось <w>недолго</w>.",
                            "target_lang_translations": {
                                "en": "We had to wait <w>only a short while</w> for the bus.",
                                "nl": "Het was <w>niet lang</w> wachten op de bus.",
                                "pl": "Na autobus nie trzeba było czekać <w>długo</w>.",
                                "de": "Wir mussten <w>nicht lange</w> auf den Bus warten.",
                                "fr": "Il n'a pas fallu attendre le bus <w>longtemps</w>.",
                                "it": "Non abbiamo dovuto aspettare <w>a lungo</w> l'autobus.",
                                "cs": "Na autobus jsme nemuseli čekat <w>dlouho</w>.",
                                "tr": "Otobüsü beklemek <w>uzun sürmedi</w>.",
                                "es": "No hubo que esperar <w>mucho tiempo</w> el autobús.",
                                "zh": "等公交车<w>没多久</w>。"
                            }
                        }
