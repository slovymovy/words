                    "frequency": "Middle",
                    "semantic_group_id": "zeichen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die neue Gesetzgebung sollte ein deutliches <w>Signal</w> an die gesamte Industrie senden."
