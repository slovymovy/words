                "senses": [
                    {
                        "sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                        "entry_id": "1be71890-4839-39e1-bf26-25335b3721cc",
                        "glosses": [
                            "vorübergehend zurückbleibender männlicher Partner einer Lebensgemeinschaft, dessen Partnerin oder Partner vorübergehend abwesend ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f66a0243-295a-49be-8763-7f03b6b527cc",
                                "sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                                "text": "Er ist Strohwitwer; seine Frau kann das Klima hier nicht vertragen, sagt sie, und reist darum jeden Herbst nach Italien und Ägypten."
                            },
                            {
                                "example_id": "0973d46b-a2ca-46e0-8dd4-bc2b885e8980",
                                "sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                                "text": "»Wirklich, du bist ja heute abend Strohwitwer?« bemerkte sie. »Deine Frau kommt erst morgen früh zurück, nicht wahr?«"
                            },
                            {
                                "example_id": "313b2202-aed1-4cc8-aa11-67b22228af14",
                                "sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                                "text": "Wenn Emma aber leben blieb, d. h. noch einige Jahre sich hinschleppte, so galt er dem Freiherrn immer als der verächtliche Schwiegersohn des alten Wucherers, so mußte er bei Auenheims in der langweiligen Rolle eines traurigen Strohwitwers auftreten und konnte vor allem natürlich nicht um die Hand eines der Mädchen werben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "74a0ab16-bc51-4c42-b355-572ccf95c281",
                        "source_entry_id": "1be71890-4839-39e1-bf26-25335b3721cc",
                        "source_sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                        "target_lang_word": "grass widower",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grass widower",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "79aa8f94-9b50-37b1-8575-a0026b2ac6d7",
                                        "entry_id": "08259968-4901-32a3-b212-7d0e1562ed65",
                                        "glosses": [
                                            "A married man whose spouse is away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e04c689-fa4e-4a78-ad42-3009ec3bf9be",
                                                "sense_id": "79aa8f94-9b50-37b1-8575-a0026b2ac6d7",
                                                "text": "“I shall be a gay grass widower for the next two months—wife’s gone for a holiday to the West Indies.”"
                                            },
                                            {
                                                "example_id": "89f10975-2cba-497b-8495-fc1d49acbff6",
                                                "sense_id": "79aa8f94-9b50-37b1-8575-a0026b2ac6d7",
                                                "text": "\"I wonder if there is a single person in the Stewartry that Campbell didn't have a row with,\" thought Wimsey, and made an addition to his list:—\n6. John Ferguson—about 36—about 5 foot 10 inches—grass widower."
                                            },
                                            {
                                                "example_id": "38176d1a-f68c-48c5-a45d-7a297d00a37f",
                                                "sense_id": "79aa8f94-9b50-37b1-8575-a0026b2ac6d7",
                                                "text": "She was generous with her offers to introduce Edith to various grass-widowers of her acquaintance – ‘my cast-offs’, as she laughingly referred to them […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "be78bfa9-0d34-4ab6-8a0b-7feb121569f4",
                        "source_entry_id": "1be71890-4839-39e1-bf26-25335b3721cc",
                        "source_sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                        "target_lang_word": "veuf de paille (zumindest in der Gegend von Sion, CH)",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6a6fd3e5-6692-4755-a27f-fd3e41d465c0",
                        "source_entry_id": "1be71890-4839-39e1-bf26-25335b3721cc",
                        "source_sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                        "target_lang_word": "соломенный вдовец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "соломенный вдовец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2a4b46b4-311d-38f1-85d1-6a162df2cd01",
                                        "entry_id": "65416c3f-4d16-3876-aee8-c24f5095f0f9",
                                        "glosses": [
                                            "шутл. муж, находящийся во временной разлуке с женой, не живущий с ней"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdd5d812-42b8-4411-9b49-5de8bfebeb1b",
                                                "sense_id": "2a4b46b4-311d-38f1-85d1-6a162df2cd01",
                                                "text": "Не думаешь же ты, что весь смысл жизни в неразлучном счастливом житии с женой, хотя бы и с такой, в которую влюблён до сих пор до безумия, и с детьми?.. Положим, это одна из приятных сторон жизни, не спорю, но есть и другое. И не один же ты в положении соломенного вдовца… Не один же ты на свете влюблённый муж, расстающийся по каким-нибудь делам с женой…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bbf0834-2314-4e7a-a7ea-775d1060fb84",
                        "source_entry_id": "1be71890-4839-39e1-bf26-25335b3721cc",
                        "source_sense_id": "351b4b03-bf53-319e-8f3d-6084f8e889dd",
                        "target_lang_word": "slaměný vdovec",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "slaměný vdovec",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e9406f31-e047-3fb5-8335-669d00516d7d",
                                        "entry_id": "6b01c42c-b4bd-3b05-a6a9-ca31cb081796",
                                        "glosses": [
                                            "manžel, který žije přechodně sám"
                                        ],
                                        "tags": [
                                            "expressively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a24048bd-f231-4029-a7e9-4a7c26bedef1",
                                                "sense_id": "e9406f31-e047-3fb5-8335-669d00516d7d",
                                                "text": "Do Imperialu přišel slavit také manžel Heleny Vondráčkové Martin Michal, který je do konce týdne slaměným vdovcem. Jeho žena je totiž toho času s fotbalovým klubem Amfora v Keni."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
