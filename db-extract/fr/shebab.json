                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d081b386-bc6d-4613-ba42-c2a6647eb4f0",
                                "sense_id": "e867b16e-d633-35c4-a7d3-d9375029baf9",
                                "text": "Les autorités kényanes dénoncent régulièrement les risques d’infiltration shebab dans les camps."
                            },
                            {
                                "example_id": "bb84fef6-ef87-47c6-9e4a-36d76c57d5ed",
                                "sense_id": "e867b16e-d633-35c4-a7d3-d9375029baf9",
                                "text": "L’Amisom (force de l’Union africaine en Somalie) et les forces pro-gouvernementales somaliennes ont repris, le 10 octobre 2011, les derniers bastions shebabs au nord-est de la capitale Mogadiscio."
                            }
                        ]
                    }
