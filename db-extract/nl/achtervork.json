                "translations": [
                    {
                        "translation_id": "ab40e1a7-159b-42fe-be1c-4ef58686e659",
                        "source_entry_id": "65da0e07-e59a-3c9a-9853-89e4bbcff121",
                        "source_sense_id": "58c48370-428b-38a8-abe6-3938b236a77c",
                        "source_sense_description": "dubbelzijdig uitgevoerde achterwielophanging van een motorfiets",
                        "target_lang_word": "Schwinge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwinge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "48d14e54-a54e-3584-ba85-6daed20ca295",
                                        "entry_id": "b7278d66-c2c6-3591-ae49-70c2dc71aed8",
                                        "glosses": [
                                            "Flügel"
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17c7a52f-f172-4eb1-92c8-34f8d0b1f03c",
                                                "sense_id": "48d14e54-a54e-3584-ba85-6daed20ca295",
                                                "text": "Du gehörst in die Freiheit, breite deine Schwingen aus und fliege!"
                                            },
                                            {
                                                "example_id": "33e9bbe8-0b1b-4bdb-a2e7-2a7bed0634a1",
                                                "sense_id": "48d14e54-a54e-3584-ba85-6daed20ca295",
                                                "text": "„Hadran merkte, dass er in der Luft war, und er breitete seine Schwingen aus, schlug ein- oder zweimal damit.“"
                                            },
                                            {
                                                "example_id": "4e93da64-4941-4e82-9774-85d0a61dd4f4",
                                                "sense_id": "48d14e54-a54e-3584-ba85-6daed20ca295",
                                                "text": "„Migisi breitete ihre Schwingen aus wie ein großes, mythisches Geschöpf‚ Macht in jeder Flugfeder.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "124919c2-91b6-3152-9d42-02431ef41a90",
                                        "entry_id": "b7278d66-c2c6-3591-ae49-70c2dc71aed8",
                                        "glosses": [
                                            "Bauteil zur geführten Aufhängung (Radaufhängung vorne und hinten beim Motorrad)"
                                        ],
                                        "tags": [
                                            "Motorrad"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ae32b6d-aeb2-4a24-a86c-591410806f22",
                                                "sense_id": "124919c2-91b6-3152-9d42-02431ef41a90",
                                                "text": "Die Schwinge ist die Hinterradaufhängung des Motorrades, hat man die Einarmschwinge, lässt sich ein Rad sehr schnell wechseln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ceaba952-5521-3816-910e-acf6c8e8733a",
                                        "entry_id": "b7278d66-c2c6-3591-ae49-70c2dc71aed8",
                                        "glosses": [
                                            "bewegliches Bauteil"
                                        ],
                                        "tags": [
                                            "Motor",
                                            "Getriebe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bb1909a8-0d69-4981-98c2-2ada8fa3fd33",
                                                "sense_id": "ceaba952-5521-3816-910e-acf6c8e8733a",
                                                "text": "„Die Koppelstange greift oben in eine Schwinge ein, die bodenseitig gelagert ist, um eine weitere Verstärkung der Sehaltkraft darstellen zu können; die Schwinge umfasst die Schaltmuffe und führt diese dann axial.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9d9ed8ac-6794-3514-b41a-c3c70e15ec1b",
                                        "entry_id": "b7278d66-c2c6-3591-ae49-70c2dc71aed8",
                                        "glosses": [
                                            "flacher, geflochtener Korb"
                                        ],
                                        "tags": [
                                            "regional"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76e9173e-8aa4-448e-9526-611e0ff660a8",
                                                "sense_id": "9d9ed8ac-6794-3514-b41a-c3c70e15ec1b",
                                                "text": "Die Schwinge war das geflochtene Sieb, das man schwang, um das Getreide zu reinigen."
                                            },
                                            {
                                                "example_id": "a03f150d-1ab4-4ff3-8c3b-d53a12608359",
                                                "sense_id": "9d9ed8ac-6794-3514-b41a-c3c70e15ec1b",
                                                "text": "„Eine Menge Hafer ward in die Schwinge geschüttet, und das Gebiß den Pferden abgenommen, damit sie bequemer fressen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "581259dc-f9a8-48f8-99ee-639318b49a01",
                        "source_entry_id": "65da0e07-e59a-3c9a-9853-89e4bbcff121",
                        "source_sense_id": "58c48370-428b-38a8-abe6-3938b236a77c",
                        "source_sense_description": "dubbelzijdig uitgevoerde achterwielophanging van een motorfiets",
                        "target_lang_word": "swingarm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "swingarm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8088610b-540a-3bc1-be75-b8b34b5fc1a6",
                                        "entry_id": "e683d6b5-5f7e-3f56-ae00-66e5ae1e2555",
                                        "glosses": [
                                            "The main component of the rear suspension of most modern motorcycles and ATVs; holds the rear axle in place while swinging vertically to allow the suspension to absorb the shock from bumps in the road."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb15245e-4adc-4b27-bcde-0f7c00e5e238",
                                                "sense_id": "8088610b-540a-3bc1-be75-b8b34b5fc1a6",
                                                "text": "At the rear, you'll find a single, centrally mounted shock, the now-familiar single-sided swingarm and BMW's Paralever shaft-drive system, which does away with most of a shafty's chassis-jacking bugaboos."
                                            },
                                            {
                                                "example_id": "03195581-c482-4dab-84e0-359926cb9317",
                                                "sense_id": "8088610b-540a-3bc1-be75-b8b34b5fc1a6",
                                                "text": "At the rear, stiffer springs, a new aluminum swingarm and a redesigned linkage for the suspension all benefit on-road behavior, though there is now an inch less ground clearance."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c380d9e1-f366-41e0-9f7d-57fdef1a168f",
                        "source_entry_id": "65da0e07-e59a-3c9a-9853-89e4bbcff121",
                        "source_sense_id": "58c48370-428b-38a8-abe6-3938b236a77c",
