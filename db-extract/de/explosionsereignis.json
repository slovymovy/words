                "senses": [
                    {
                        "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                        "entry_id": "41c1b8f9-6174-3124-add7-a72848f70396",
                        "glosses": [
                            "meist bedeutsames Geschehen oder Erlebnis im Zusammenhang mit einer Explosion"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "88806805-3630-4029-8e2a-7c03384c2b55",
                                "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                                "text": "„Das Prinzip des Explosionsschutzes macht sich den Umstand zunutze, daß ein Explosionsereignis immer grundsätzlich das gleichzeitige Auftreten einer explosionsfähigen Atmosphäre und einer wirksamen Zündquelle voraussetzen.“"
                            },
                            {
                                "example_id": "3e2b18cb-6f4b-435d-924b-5894cdbb7659",
                                "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                                "text": "„Zum einen dienen sie bei der bestimmungsgemäßen Verwendung zur Abscheidung der Staubpartikel aus dem Gasstrom, zum anderen erfolgt bei einem Explosionsereignis über sie ein Überströmen der expandierenden Druckgase von der Rohgas- auf die Reingasseite des Filtergeräts.“"
                            },
                            {
                                "example_id": "ee7db8cf-2d02-4ba7-b565-95fc9b653c02",
                                "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                                "text": "„Im Vordergrund steht daher immer die Beurteilung, ob beim Betrieb der Anlage irgend etwas vorhanden ist oder entsteht, was in dem Zustand, in dem es vorliegt, unter den vorhandenen Randbedingungen zu einem Explosionsereignis führen kann.“"
                            },
                            {
                                "example_id": "df2e40bd-122a-48ff-9f01-eb9eb6f2d8e9",
                                "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                                "text": "„Viele Unternehmen kaufen hohe Haftpflichtdeckungssummen ein, um für diese Worst-Case-Szenarien, wie jetzt auch das jüngste Explosionsereignis am Chemiepark Marl, abgesichert zu sein.“"
                            },
                            {
                                "example_id": "9a268239-c278-4f1b-a51c-b918b531f15c",
                                "sense_id": "f89c0991-6abe-3579-a5cf-a0ae2741cae5",
                                "text": "„Damit die Drucksensoren ausreichend selektiv, schnell und sicher auf ein Explosionsereignis reagieren, bedarf es jedoch einer optimierten Signalverarbeitung, welche diverse Störgrößen ausgleicht: […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
