                ],
                "senses": [
                    {
                        "sense_id": "448b8360-438d-32d9-9d3c-36fcd4c6dae5",
                        "entry_id": "6f67d3c1-3c2d-37bf-9168-a2fe0693f7e6",
                        "glosses": [
                            "dat iets heel veel zaken betreft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "78d6b40d-3219-4a9b-bf24-11dee779e28b",
                                "sense_id": "448b8360-438d-32d9-9d3c-36fcd4c6dae5",
                                "text": "‘De opwarming van de aarde is zo belangrijk en veelomvattend. Het zou iedere dag op de voorpagina moeten staan. Toch gebeurt dat zelden’, zegt Rusbridger. ‘Ik dacht: wat kunnen we doen om onze lezers wakker te schudden?’"
                            },
                            {
                                "example_id": "561ce469-8ea2-4110-b4bd-0577f087e9ca",
                                "sense_id": "448b8360-438d-32d9-9d3c-36fcd4c6dae5",
                                "text": "Verder beloofde de premier om voor het eind van dit jaar met een veelomvattend plan te komen om de vergrijzing tegen te gaan. Het gaat daarbij om investeringen in educatie, productiviteit en wijzigingen in het pensioenstelsel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a0c3ae5-61e3-4ba5-ade0-be153a2b0a6e",
                        "source_entry_id": "6f67d3c1-3c2d-37bf-9168-a2fe0693f7e6",
                        "source_sense_id": "448b8360-438d-32d9-9d3c-36fcd4c6dae5",
                        "target_lang_word": "comprehensive",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                        "entry_id": "98fda171-b43e-35af-8f88-78a32256fd01",
                                        "glosses": [
                                            "Broadly or completely covering; including a large proportion of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cc1e84ea-b6b9-4f1d-b4f1-34d2c5a972f7",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "When there are diametrically opposing views on a big issue that concerns millions of people, doing comprehensive research just makes sense."
                                            },
                                            {
                                                "example_id": "29459872-bb3b-4f17-b620-088a22beff4b",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "Nevertheless, the comprehensive comparative analysis of pumpkin viromes across various geographic regions by NGS remains deficient."
                                            },
                                            {
                                                "example_id": "6fcdde41-5867-4e9f-a77a-92eec9dcbe75",
                                                "sense_id": "ee6c3549-7caa-3ad4-bf01-10ae535a5a76",
                                                "text": "So what is it that makes SBB (Swiss national railways) tick? In my humble opinion, two things. Firstly, a comprehensive and set-in-stone integrated timetable (incorporating trains, ferries, cable cars and buses, including the world-famous yellow 'post-autos'), compiled four years in advance and which gets tested twice before it becomes operational."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "comprehensive",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6dcf2341-7e6e-3020-9315-d51a58e22a7d",
                                        "entry_id": "10b5e4a3-7f2d-345d-a2cf-17670b0a42c4",
                                        "glosses": [
                                            "A comprehensive school."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93fca2fd-bc17-4576-bf75-3ab7cdf8a03f",
                                                "sense_id": "6dcf2341-7e6e-3020-9315-d51a58e22a7d",
                                                "text": "Imagine a country where children do nothing but play until they start compulsory schooling at age seven. Then, without exception, they attend comprehensives until the age of 16. Charging school fees is illegal, and so is sorting pupils into ability groups by streaming or setting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3f12e4c-9ec2-4904-b769-d5527b903943",
                        "source_entry_id": "6f67d3c1-3c2d-37bf-9168-a2fe0693f7e6",
                        "source_sense_id": "448b8360-438d-32d9-9d3c-36fcd4c6dae5",
                        "target_lang_word": "all-encompassing",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "all-encompassing",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "54610811-5a15-38eb-9d72-b4316c9c6af8",
                                        "entry_id": "bc1d8729-44ad-38df-95b2-8047ce290f82",
                                        "glosses": [
                                            "Including everything; universal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6eb67fd-7f58-4f8e-84de-93fe8eb59d6b",
                                                "sense_id": "54610811-5a15-38eb-9d72-b4316c9c6af8",
                                                "text": "The desire to get back into the womb can become, in a creative way, a making of a womb out of the whole world, including everything in the womb (the city, the enlarged universe of Black Spring, of The Black Book), the all-englobing, all-encompassing womb, holding everything."
                                            },
                                            {
                                                "example_id": "86cb4a44-b8c3-401d-9d6d-4a496f8f77a0",
                                                "sense_id": "54610811-5a15-38eb-9d72-b4316c9c6af8",
                                                "text": "This essay, \"Identity: Skin Blood Heart,\" is an account of her struggle to wrench herself free from the all-encompassing racist indoctrination that white people in North America are taught."
                                            },
                                            {
                                                "example_id": "e48c4ae0-ead3-447c-b617-b7f7917f2980",
                                                "sense_id": "54610811-5a15-38eb-9d72-b4316c9c6af8",
                                                "text": "[…] since the goddess Antu did not hold a prominent status at Uruk before the fifth century. The primary purpose of MLC 1890 was evidently to present Antu as universal goddess and all-encompassing cosmic location."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
