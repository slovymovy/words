                "senses": [
                    {
                        "sense_id": "41760fd9-4487-3e9e-be02-705c32969951",
                        "entry_id": "3cec1468-c10b-3b7b-adea-2d00d11a69ef",
                        "glosses": [
                            "Betrieb von Eisenbahnen zur Beförderung von Fracht und Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea313f3-469b-4939-8145-6f29241d0cb7",
                                "sense_id": "41760fd9-4487-3e9e-be02-705c32969951",
                                "text": "Der Eisenbahnverkehr wird in den letzten Jahren auch aus Umweltschutzgründen in Europa ausgebaut."
                            },
                            {
                                "example_id": "071e0491-6609-4015-bc8f-fa2037ff5b1c",
                                "sense_id": "41760fd9-4487-3e9e-be02-705c32969951",
                                "text": "„Der Eisenbahnverkehr ist so unregelmäßig, dass wir nicht mehr geschlossen transportiert werden können.“"
                            },
                            {
                                "example_id": "919ec339-3b27-44d1-9790-11c489d89115",
                                "sense_id": "41760fd9-4487-3e9e-be02-705c32969951",
                                "text": "„Durch den Eisenbahnverkehr wurde ganz Deutschland schließlich eine einheitliche Zeitzone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
