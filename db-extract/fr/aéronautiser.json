                "senses": [
                    {
                        "sense_id": "610702f5-a466-33ce-8728-b21c48da0772",
                        "entry_id": "d764ed71-71f7-3d42-94c1-a0dc19c1a647",
                        "glosses": [
                            "Donner à (quelque chose) des caractéristiques propres à l’aéronautique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8221f8-1151-4314-b7e2-05914f2a0e63",
                                "sense_id": "610702f5-a466-33ce-8728-b21c48da0772",
                                "text": "Les pilotes d'aéronefs ont tendance à \"aéronautiser\" (hublots, reflets métalliques, termes techniques, etc.) leurs ovnis."
                            },
                            {
                                "example_id": "813609be-5434-42df-a5f3-6fccbd629a9d",
                                "sense_id": "610702f5-a466-33ce-8728-b21c48da0772",
                                "text": "Voilà rapidement brossé le portrait de mon vieux Spica \"aéronautisé\", et tout ça pour pas un centime !"
                            },
                            {
                                "example_id": "72e599bd-e61c-4da7-89d7-b25cf5fd5608",
                                "sense_id": "610702f5-a466-33ce-8728-b21c48da0772",
                                "text": "Quand, au début des années 80, nous avons été contactés par les avionneurs, notre démarche a consisté à adapter des produits existants pour l'industrie, en vue de les \"aéronautiser\", c'est-à-dire de les modifier pour les intégrer dès la conception des aéronefs, dans le respect des spécifications propres à l'aéronautique."
                            }
                        ]
                    }
                ],
