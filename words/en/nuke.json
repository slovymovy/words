                            {
                                "target_lang_word": "ядерка",
                                "target_lang_sense_clarification": "разговорное сокращение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "38fafc47-3770-34ea-b4a6-5acd5dae7e8d",
                    "sense_definition": "A microwave oven.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "microwave_usage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Just put the meal in the <w>nuke</w> for two minutes and it will be ready.",
                            "target_lang_translations": {
                                "ru": "Просто поставь еду в <w>микроволновку</w> на две минуты, и она будет готова."
