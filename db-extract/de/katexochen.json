                        "sense_id": "2653853e-8938-326e-b70c-fd7d2410d559",
                        "entry_id": "ff53d376-33f4-3212-821c-438b46587523",
                        "glosses": [
                            "preeminent, archetypal"
                        ],
                        "tags": [
