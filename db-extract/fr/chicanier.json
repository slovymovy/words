                "senses": [
                    {
                        "sense_id": "8e41d1f7-acb1-30e7-be8c-9c48c4fae5a0",
                        "entry_id": "def2bced-3e6b-3c66-a80b-04d9f28a726c",
                        "glosses": [
                            "Qui est de nature à chercher noise sur les moindres choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f8acab9-18cd-4b79-9ef7-8af6b2906ab8",
                                "sense_id": "8e41d1f7-acb1-30e7-be8c-9c48c4fae5a0",
                                "text": "Je lègue à Monsieur Delesvaux,\nPrésident d’humeur chicanière\nQui me voulait, moi, pauvre hère,\nPrisonnier en de froids caveaux,\nUne tranche de galantine\nFaite de langues d’écrivains; […]"
                            },
                            {
                                "example_id": "0a099b89-0b21-4369-bf00-b734adea1092",
                                "sense_id": "8e41d1f7-acb1-30e7-be8c-9c48c4fae5a0",
                                "text": "Ce côté chicanier et mesquin nuit à ses incontestables qualités de cœur et à sa bonté naturelle."
                            },
                            {
                                "example_id": "c30154ea-ece6-4909-a23b-5bcafb999211",
                                "sense_id": "8e41d1f7-acb1-30e7-be8c-9c48c4fae5a0",
                                "text": "Une lettre plaisante de Cicéron, datée de 56 av. J. C, fait état du danger pour les créanciers héréditaires de voir leurs créances définitivement ajournées du fait de l’esprit chicanier d’un héritier."
                            },
                            {
                                "example_id": "8c5d5218-7ce6-4c32-9475-1ba621877a82",
                                "sense_id": "8e41d1f7-acb1-30e7-be8c-9c48c4fae5a0",
                                "text": "Dès que les militants d’un parti débattent plus durement, on les accuse d’être chicaniers."
                            }
                        ]
                    }
                ],
