                                    {
                                        "sense_id": "ebda09bc-be9c-3b36-99d1-ed4d65a0c740",
                                        "entry_id": "227f76a9-7c55-3c76-bf44-1cf953c97f43",
                                        "glosses": [
                                            "Édulcorant artificiel principalement utilisé avec la saccharine comme produit sucrant, qui a pour formule chimique C₆H₁₂NNaO₃S."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29586f61-44b1-4bd9-9eb2-dcfac1b899e6",
                                                "sense_id": "ebda09bc-be9c-3b36-99d1-ed4d65a0c740",
                                                "text": "Il est vrai qu’elles comportent, selon les chercheurs, 2 à 3 fois moins des deux édulcorants principaux (aspartame surtout et acesulfame-K, parfois associé) que les boissons gazeuses, étant en revanche plus riches en cyclamate et saccharine."
                                            },
                                            {
                                                "example_id": "160b4f8a-f1b6-4621-8b92-865e809f08c9",
                                                "sense_id": "ebda09bc-be9c-3b36-99d1-ed4d65a0c740",
                                                "text": "Cyclamates (E952). Interdits aux États-Unis, car soupçonnés d'être cancérogènes."
                                            },
                                            {
                                                "example_id": "4cd27a1a-1f74-4f46-96d7-1772c845dba4",
                                                "sense_id": "ebda09bc-be9c-3b36-99d1-ed4d65a0c740",
                                                "text": "Cette toxicité était induite par la cyclohexylamine, qui est un métabolite du cyclamate produit par fermentation microbiale du cyclamate non absorbé dans l’intestin « grêle »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
