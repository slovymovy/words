            {
                "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                "word": "garant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "1ed00d89-e9ba-455c-a471-cefd3d98a0ed",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "tags": [
                            "plural"
                        ],
                        "form": "garants"
                    },
                    {
                        "form_id": "9f9547bf-496f-40e8-987b-d1da648c57a1",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "tags": [
                            "feminine"
                        ],
                        "form": "garante"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Celui qui répond ou se porte responsable de son propre fait ou du fait d’autrui."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6cf3bede-c506-472d-83e1-42fe67174709",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "être garant, être garante, assurer d'une chose, en répondre."
                            },
                            {
                                "example_id": "2853a5ec-b82a-43ee-8cf5-5ec6ca872234",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "Je vous suis garant que cela est vrai."
                            },
                            {
                                "example_id": "377a2644-6656-4894-bfe9-e712e1b7c93f",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "C’est un très honnête homme, je vous en suis garante."
                            },
                            {
                                "example_id": "77ac0fd4-34dd-4435-99ec-d2034bba71be",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "Tout homme est garant de ses faits et promesses."
                            },
                            {
                                "example_id": "6410e161-4a65-4d3c-a4b6-9544d53bcdc4",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "Je ne suis point garant de l’événement."
                            },
                            {
                                "example_id": "45a212c4-d269-4c60-b049-6883d0c674b4",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "Cette puissance s’est rendue garante du traité."
                            },
                            {
                                "example_id": "481aa2d8-dfa9-45c5-a47e-1e9f5e980d06",
                                "sense_id": "19f56030-addd-3bd0-b5bf-19ee52ad432f",
                                "text": "Autour de Monsieur se groupaient quelques gentilshommes, factieux, avides, remuants, qui ne pouvaient grandir et s'enrichir que par le désordre. Le duc d’Orléans était leur garant, leur pavillon, leur espoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "9129980e-3d25-3848-acc6-223a22933232",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Celui qui répond ou se porte responsable de son propre fait ou du fait d’autrui.",
                            "Celui qui est caution d’un autre, qui répond de sa dette."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "6fc39eca-6f4c-46dd-ad92-88de30fae3ad",
                                "sense_id": "9129980e-3d25-3848-acc6-223a22933232",
                                "text": "Vous rendez- vous garant de cet homme ?"
                            },
                            {
                                "example_id": "d1ceff7c-0d39-4768-8558-7ccac54683d1",
                                "sense_id": "9129980e-3d25-3848-acc6-223a22933232",
                                "text": "Être garant d’une obligation."
                            },
                            {
                                "example_id": "c14dd005-536f-477d-acc6-7164e64f6153",
                                "sense_id": "9129980e-3d25-3848-acc6-223a22933232",
                                "text": "Je n’aurais pas été payé si je n’avais eu un bon garant."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9379d69-ca1a-3a40-aff0-132a9486bdc9",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Celui qui est obligé de faire jouir un autre de la chose qu’il lui a vendue ou transportée à titre onéreux ou gratuit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dae17694-f53e-4481-bad4-25f37e59fd65",
                                "sense_id": "a9379d69-ca1a-3a40-aff0-132a9486bdc9",
                                "text": "Le vendeur est garant envers l’acquéreur de la propriété de la chose qu’il lui a vendue."
                            },
                            {
                                "example_id": "49d9c55b-821e-4ed9-8c65-493f042c1613",
                                "sense_id": "a9379d69-ca1a-3a40-aff0-132a9486bdc9",
                                "text": "On m’a attaqué en éviction, j’ai mis en cause mon garant."
                            }
                        ]
                    },
                    {
                        "sense_id": "05e18a3c-d4b4-3045-a0c5-6767bb436157",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Auteur dont on a tiré un fait, un principe qu’on avance, un passage que l’on cite ; personne de qui on tient une nouvelle."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "3ab070ee-e346-4d57-9665-e24668932fe4",
                                "sense_id": "05e18a3c-d4b4-3045-a0c5-6767bb436157",
                                "text": "Il cite comme garant tel historien."
                            },
                            {
                                "example_id": "f9122128-8ebb-4a1f-9d6f-3f5b94eafbaf",
                                "sense_id": "05e18a3c-d4b4-3045-a0c5-6767bb436157",
                                "text": "J’ai pour garants plusieurs témoins de l’affaire."
                            },
                            {
                                "example_id": "033a45c1-5ae0-4af2-a6fd-266f005ec5cd",
                                "sense_id": "05e18a3c-d4b4-3045-a0c5-6767bb436157",
                                "text": "Cette nouvelle paraît difficile à croire, mais j’en ai les meilleurs garants."
                            }
                        ]
                    },
                    {
                        "sense_id": "69bdb92e-43f6-3757-a6f5-e901525e5837",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Partie de la corde d’un palan sur laquelle on tire pour faire monter la charge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "731cbb31-6dea-4120-b17a-d825f72ba1b5",
                                "sense_id": "69bdb92e-43f6-3757-a6f5-e901525e5837",
                                "text": "On pourrait même, à l’occasion, mettre un garant de plus à ce palan , en faisant son dormant sur la corne, au lieu de le faire sur la poulie de retour au couronnement."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a93a1eb-9dec-387e-aef2-3a32210bbdc0",
                        "entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
                        "glosses": [
                            "Sûreté, garantie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "548d6d3d-c0ca-44bb-998f-fef02d14572d",
                                "sense_id": "5a93a1eb-9dec-387e-aef2-3a32210bbdc0",
                                "text": "Sa conduite passée vous est un sûr garant de sa fidélité pour l’avenir."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f8593656-54e3-4f25-93e4-8420efb5a01f",
                        "source_entry_id": "466a1a8f-1379-395e-ac8f-a067885fb548",
