                "senses": [
                    {
                        "sense_id": "7b1cba35-c167-3e47-95f6-455e8b490921",
                        "entry_id": "ce28b375-663f-3e99-95b3-e25fdfaa655f",
                        "glosses": [
                            "einzelner Gegenstand, der als Gepäck mitgeführt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d23112-a0bb-4db5-85d5-e41ff1e46990",
                                "sense_id": "7b1cba35-c167-3e47-95f6-455e8b490921",
                                "text": "„Dann trug jemand ihre drei Gepäckstücke hinter ihr drei Treppen hoch, bis sie in ihr Zimmer kam und endlich allein war.“"
                            },
                            {
                                "example_id": "0dbef06b-6ea9-4a45-b258-fb558d329ade",
                                "sense_id": "7b1cba35-c167-3e47-95f6-455e8b490921",
                                "text": "„Konstantin hat seine Gepäckstücke an den Straßenrand gestellt.“"
                            },
                            {
                                "example_id": "31c53031-d458-4738-865e-736864c72d88",
                                "sense_id": "7b1cba35-c167-3e47-95f6-455e8b490921",
                                "text": "„Ich hörte Gepäckstücke rollen und krachen, als lägen sie schlecht verwahrt im Lagerraum eines vom Meer geschüttelten Schiffes.“"
                            },
                            {
                                "example_id": "dd9380f3-54b2-452c-b5ed-e5421aeb6b42",
                                "sense_id": "7b1cba35-c167-3e47-95f6-455e8b490921",
                                "text": "„Als er am Freitag in Caen ausstieg, waren seine Gepäckstücke noch nicht da.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
