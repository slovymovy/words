                                "example_id": "66ef1f6b-65dd-4a65-a422-58dade39b58c",
                                "sense_id": "4ffd7f32-41ff-3e1a-b9cb-0eaac7d8fef5",
                                "text": "„Rant sagt, die Polizei hat das Puder in Bels Puderdose untersucht, und natürlich bestand der zur Hälfte aus Mäusescheiße. Getrockneter, gemahlener Staub aus Mäusescheiße.“"
                            },
                            {
                                "example_id": "76b75463-7099-49cd-b66e-624c82bc1940",
                                "sense_id": "4ffd7f32-41ff-3e1a-b9cb-0eaac7d8fef5",
                                "text": "„Der Boden vor dem Herd ist voller Mäusescheiße, und neben dem Mülleimer, in einer Falle, hängt eine zerquetschte tote Maus.“"
                            }
                        ],
