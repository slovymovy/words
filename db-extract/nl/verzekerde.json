                            {
                                "example_id": "b61d96d0-4df7-407b-b2d6-6984b4d6d815",
                                "sense_id": "a1f54683-ecef-32a5-8b76-ac63a90771d1",
                                "text": "Ik verzekerde."
                            },
                            {
                                "example_id": "3ff31c8d-68e8-4d3c-9b0d-83ef3f46cf78",
                                "sense_id": "a1f54683-ecef-32a5-8b76-ac63a90771d1",
                                "text": "Jij verzekerde."
                            },
                            {
                                "example_id": "07e9d8cd-5c5d-4fed-bc28-308574b40a11",
                                "sense_id": "a1f54683-ecef-32a5-8b76-ac63a90771d1",
                                "text": "Hij, zij, het verzekerde."
                            },
                            {
                                "example_id": "2d91f515-f0f6-491e-9c7f-c4d6224b7562",
                                "sense_id": "a1f54683-ecef-32a5-8b76-ac63a90771d1",
                                "text": "Waren ze gaan twijfelen? Nee, helemaal niet. Echt niet, verzekerde Karl hem opgelaten. Als hij en Louise het alleen konden beslissen, zouden ze allang getrouwd zijn. Maar dat was helaas niet zo."
                            },
                            {
                                "example_id": "567637c0-bc53-46e9-92e5-8e07320fddce",
                                "sense_id": "a1f54683-ecef-32a5-8b76-ac63a90771d1",
                                "text": "Áls je zo midden in de nacht naar beneden springt met een parachute, ja ik weet er niets van, maar ik neem aan dat het midden in de nacht moet zijn, dan ben je toch enorm bang?' Hij verzekerde haar dat hij niet bang zou zijn."
                            }
                        ]
