    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a27ee80c-9336-3df0-9a44-2703a996a18a",
                    "sense_definition": "The quality of remaining loyal, trustworthy, and constant in support or belief.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "loyalty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog was honored for its unwavering <w>faithfulness</w> to its owner.",
                            "target_lang_translations": {
                                "es": "El perro fue homenajeado por su inquebrantable <w>fidelidad</w> a su dueño."
                            }
                        },
                        {
                            "text": "They promised their mutual <w>faithfulness</w> during the wedding ceremony.",
                            "target_lang_translations": {
                                "es": "Se prometieron <w>fidelidad</w> mutua durante la ceremonia de boda."
                            }
                        }
                    ],
                    "synonyms": [
                        "allegiance",
                        "fidelity",
                        "loyalty"
                    ],
                    "antonyms": [
                        "unfaithfulness",
                        "infidelity",
                        "disloyalty"
                    ],
                    "common_phrases": [
                        "rewarded for faithfulness",
                        "great faithfulness"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de permanecer leal, digno de confianza y constante en el apoyo o en una creencia."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fidelidad",
                                "target_lang_sense_clarification": "lealtad o constancia hacia personas o compromisos"
                            },
                            {
                                "target_lang_word": "lealtad",
                                "target_lang_sense_clarification": "firmeza en el apoyo o devoción a alguien"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "62dcc3ff-218f-3b16-a918-58451d4aa4d3",
                    "sense_definition": "The quality of being accurate, true to detail, or exact in reproducing an original.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "accuracy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The translation was praised for its <w>faithfulness</w> to the original text.",
                            "target_lang_translations": {
                                "es": "La traducción fue elogiada por su <w>fidelidad</w> al texto original."
                            }
                        },
                        {
                            "text": "Critics questioned the film's <w>faithfulness</w> to the historical events.",
                            "target_lang_translations": {
                                "es": "Los críticos cuestionaron la <w>fidelidad</w> de la película a los acontecimientos históricos."
                            }
                        }
                    ],
                    "synonyms": [
                        "fidelity"
                    ],
                    "antonyms": [
                        "inaccuracy"
                    ],
                    "common_phrases": [
                        "faithfulness to the original"
                    ],
                    "target_lang_definitions": {
                        "es": "Cualidad de ser exacto, preciso en los detalles o riguroso al reproducir un original."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "fidelidad",
                                "target_lang_sense_clarification": "exactitud respecto a un original o hechos"
                            },
                            {
                                "target_lang_word": "exactitud",
                                "target_lang_sense_clarification": "precisión al reproducir detalles"
                            }
                        ]
                    }
                }
            ]
        }
    ]
