                "senses": [
                    {
                        "sense_id": "866f357e-4f77-387c-9844-60a4d7d19c02",
                        "entry_id": "f85b1791-7a8d-3f44-aff7-42a0ae1495f6",
                        "glosses": [
                            "Heizung, die mit Hackschnitzeln als Energieträger betrieben wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "331baf3f-2d02-4868-b91d-a74408301cac",
                                "sense_id": "866f357e-4f77-387c-9844-60a4d7d19c02",
                                "text": "Hackschnitzelheizungen sind heutzutage weit mehr verbreitet als früher."
                            },
                            {
                                "example_id": "89bac8c5-c8c8-4c45-a058-e0ef4443cdbc",
                                "sense_id": "866f357e-4f77-387c-9844-60a4d7d19c02",
                                "text": "„Der Unfall dürfte durch ein verstopftes Rauchrohr, das von der im Erdgeschoß befindlichen Hackschnitzelheizung zum Kamin führt, ausgelöst worden sein.“"
                            },
                            {
                                "example_id": "0d553019-ddf3-4b54-babd-9b2da6613520",
                                "sense_id": "866f357e-4f77-387c-9844-60a4d7d19c02",
                                "text": "„Der Schulkomplex soll eine Hackschnitzelheizung erhalten, die über ein Fernwärmenetz das Rathaus, die Gäste-Info, das ehemalige Hotel Post, der Alpenfestsaal und die Bücherei mitversorgen soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
