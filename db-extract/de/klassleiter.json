                "senses": [
                    {
                        "sense_id": "bc870046-794c-3b31-9ca2-796ab5cfba31",
                        "entry_id": "78371120-c197-3dc7-8787-f92ecc9fde3f",
                        "glosses": [
                            "Lehrer, der für eine ihm zugewiesene Schulklasse (meist über mehrere Jahre) verantwortlich ist"
                        ],
                        "tags": [
                            "regional"
                        ],
                        "examples": [
                            {
                                "example_id": "2d14dd52-e80a-4290-8aa7-88f8dcaa605e",
                                "sense_id": "bc870046-794c-3b31-9ca2-796ab5cfba31",
                                "text": "„Nach den Ferien wird an der Grundschule in Neukirchen vorm Wald vieles anders sein. Der Grund: Alle vier Klassleiter wurden gleichzeitig in den Ruhestand verabschiedet.“"
                            },
                            {
                                "example_id": "c47470eb-c9d5-4d7a-95fa-91a65dd00eac",
                                "sense_id": "bc870046-794c-3b31-9ca2-796ab5cfba31",
                                "text": "„Die Entlassschüler dankten besonders ihrem Klassleiter Marco Friedrich, den sie ‚echt cool‘ fanden.“"
                            },
                            {
                                "example_id": "26c73a54-37aa-4937-8b52-e3fa3abbeeb4",
                                "sense_id": "bc870046-794c-3b31-9ca2-796ab5cfba31",
                                "text": "„Selbst der Klassleiter, Liebhaber der Schriften Thomas Manns, geriet in einen heiligen Zorn, als er Bibis Mutter das Benehmen ihres Jüngsten schilderte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
