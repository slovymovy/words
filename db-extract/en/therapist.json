                                        "sense_id": "334ad9ec-450f-38ec-8fae-fc35df2a4da4",
                                        "entry_id": "edcdbd9d-dbac-328e-991e-cf4170b6effc",
                                        "glosses": [
                                            "Ascète juif qui se livrait à la vie contemplative et mortifiée. Saint Jérôme les considère comme chrétiens. Ce sont les précurseurs du monachisme."
                                        ],
                                        "tags": [
                                            "Ancient"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1da7f513-037a-4986-8573-950baf8c7e6b",
                                                "sense_id": "334ad9ec-450f-38ec-8fae-fc35df2a4da4",
                                                "text": "Les thérapeutes ont été les modèles de la vie monastique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "978b8aec-5de1-3f1e-9d64-46c3dd9a8da1",
                                        "entry_id": "edcdbd9d-dbac-328e-991e-cf4170b6effc",
                                        "glosses": [
                                            "Médecin ou guérisseur."
                                        ],
                                        "tags": [],
