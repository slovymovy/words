                "senses": [
                    {
                        "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                        "entry_id": "1509f1d4-f103-322e-aea0-0877f557294a",
                        "glosses": [
                            "plötzliches Versagen des Nervensystems aufgrund einer extremen seelischen oder körperlichen Belastung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "059896ff-f4aa-49b0-b768-4e1ffa9ef1e7",
                                "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                                "text": "Wegen eines Nervenzusammenbruchs konnte er wochenlang nicht arbeiten."
                            },
                            {
                                "example_id": "6c31bb68-e862-4c43-bdca-40bb5f2f590a",
                                "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                                "text": "„So fühlt sich also ein Nervenzusammenbruch an.“"
                            },
                            {
                                "example_id": "6fc85f58-2ab1-4534-8171-b5c09b2c604e",
                                "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                                "text": "„Sie hatte einen Nervenzusammenbruch erlitten und verließ wegen Angstzuständen ihr Zimmer nicht mehr.“"
                            },
                            {
                                "example_id": "90a23a0d-46f9-4d9c-92a6-fab4f95a56c2",
                                "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                                "text": "Einige Menschen bekommen ständig Nervenzusammenbrüche, etwa wenn die Haare nicht ordentlich sind, der Lieblingspulli einen Fleck hat oder der gerade reparierte Wagen wieder kaputtgeht. „Ich krieg' einen Nervenzusammenbruch“, regen sie sich dann ganz laut auf. Das sind natürlich im medizinischen Sinn keine richtigen Nervenzusammenbrüche."
                            },
                            {
                                "example_id": "fecd893e-5524-4afe-bf8d-02c694640580",
                                "sense_id": "9eb302de-07ea-3a0e-a4fe-3d301d83f021",
                                "text": "„Danach filmte Brack in einem solchen Tempo zu Ende, daß der Kameramann nach der letzten Einstellung mit Nervenzusammenbruch in die Klinik gebracht werden mußte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9a51cf28-cbe2-4966-9ae0-0a2eca436406",
