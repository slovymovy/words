                                                "example_id": "70cccf8f-5794-4b1d-9eb6-19c68acad0e2",
                                                "sense_id": "234befa4-0f33-33c4-b1d9-bca97b571fe7",
                                                "text": "The lion's young are curious about the world around them."
                                            },
