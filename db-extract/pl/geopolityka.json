                "senses": [
                    {
                        "sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                        "entry_id": "9855623b-7678-31cb-9fe1-292cb66c0d24",
                        "glosses": [
                            "doktryna polityczna, która głosi, że warunki geograficzne wyznaczają procesy i fakty polityczne"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "899ada03-613c-401d-8239-6828c2b5e8c3",
                                "sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                                "text": "Żyjemy w czasach, w których geopolityka, czyli zabiegi o zasoby ustępuje technopolityce"
                            },
                            {
                                "example_id": "e835409c-0c0d-40c9-9c8b-411a70980af1",
                                "sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                                "text": "Co szkolnictwo wyższe może zyskać oraz co może stracić na nadchodzących zmianach w geopolityce Europy?"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fb776e14-e9dd-47f7-a548-e63b4bd8199b",
                        "source_entry_id": "9855623b-7678-31cb-9fe1-292cb66c0d24",
                        "source_sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                        "target_lang_word": "geopolitics",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "geopolitics",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ba5c5b7-bfc3-350d-a065-9f78343f2714",
                                        "entry_id": "2992f6fb-0bba-3f59-aed4-501e10b28b18",
                                        "glosses": [
                                            "The study of the effects of geography (especially economic geography) on international politics."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f73c4cb2-c2d7-4f5a-a081-f76a17d6ab77",
                                                "sense_id": "8ba5c5b7-bfc3-350d-a065-9f78343f2714",
                                                "text": "Hidden behind thickets of acronyms and gorse bushes of detail, a new great game is under way across the globe. Some call it geoeconomics, but it's geopolitics too. The current power play consists of an extraordinary range of countries simultaneously sitting down to negotiate big free trade and investment agreements."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6886dfcc-2035-4712-ac84-e53162229cc7",
                        "source_entry_id": "9855623b-7678-31cb-9fe1-292cb66c0d24",
                        "source_sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                        "target_lang_word": "geopolitika",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "821971df-7f45-4b5f-85d3-3c71a62fc33c",
                        "source_entry_id": "9855623b-7678-31cb-9fe1-292cb66c0d24",
                        "source_sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
                        "target_lang_word": "géopolitique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                        "entry_id": "6f324075-4c96-3405-b53f-820368ef95b9",
                                        "glosses": [
                                            "Relatif à la géopolitique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee18195c-3b6e-4154-a6cb-b68d6374a47c",
                                                "sense_id": "f174902d-fefc-39b0-8313-86147054234b",
                                                "text": "\"The New Digital Age\" est, avant tout, une tentative de la part de Google de se positionner comme le visionnaire géopolitique de l'Amérique – la seule entreprise capable de répondre à la question : \"Où doit aller l'Amérique ?\" Il n'est donc guère surprenant qu'un certain nombre des plus grands fauteurs de guerre soient convoqués pour apporter leur caution à cette défense du soft power occidental."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "géopolitique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                        "entry_id": "ff9bbfb5-1db5-3aef-ae7b-f39904f8a226",
                                        "glosses": [
                                            "Science humaine qui étudie les implications politiques de la géographie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76ac409-8123-45ac-b11f-f3eeea7e1765",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "[Sait-il] qu’un carton rouge de trop peut menacer la paix mondiale ? C’est ce que nous ont expliqué, pendant cette longue semaine de délire médiatique, les spécialistes de la géopolitique."
                                            },
                                            {
                                                "example_id": "e4dd7103-1c9f-4dc9-ac19-3a9919c652ae",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "En géopolitique, il n’y a rien de simple. Il est soulageant toutefois de s’entendre sur les faits, sur qui sont les bons (pour citer Joe Biden, « ... les dirigeants de nos alliés proches, dont le Canada, [avec qui] reconstruire le muscle de nos alliances démocratiques atrophié au cours des dernières années... ») et qui sont les méchants, ceux qui tyrannisent, empoisonnent, emprisonnent pour se maintenir au pouvoir."
                                            },
                                            {
                                                "example_id": "bda75d2c-6a3b-4f93-95db-99b970a5e396",
                                                "sense_id": "b75fed03-70b7-37e1-bc96-9c3c6fdab501",
                                                "text": "Chaque jour, Harold Hyman, chroniqueur à BFMTV, explique les nœuds de la géopolitique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1f420fa8-76d9-4229-a68d-11f7dcfd5490",
                        "source_entry_id": "9855623b-7678-31cb-9fe1-292cb66c0d24",
                        "source_sense_id": "2a4ef7ce-36f2-3803-b0bb-be20054d2dfc",
