                    {
                        "sense_id": "13598f78-db91-32f2-aa2b-4b5547366abb",
                        "entry_id": "d2b899d0-cbe2-3fb7-993a-5a80afac729f",
                        "glosses": [
                            "acorns as a suit in German playing cards"
                        ],
                        "tags": [
                            "archaic",
