                "senses": [
                    {
                        "sense_id": "15d5343d-acf5-364f-adc8-e6c55b170164",
                        "entry_id": "0f83b38e-989c-3ed8-a201-7829c4c3e8c5",
                        "glosses": [
                            "legitimation (process of legitimizing; giving something legal force)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "45d3f1c0-8466-3250-b074-f05f6341a65c",
                        "entry_id": "0f83b38e-989c-3ed8-a201-7829c4c3e8c5",
                        "glosses": [
                            "legitimation (process of legitimizing; recognition of a political system as the most appropriate for a given type of society)"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "f9873053-8ca9-4725-a98d-956b692bf788",
                                "sense_id": "45d3f1c0-8466-3250-b074-f05f6341a65c",
                                "text": "[Henry’ego] Kissingera pociąga w Metternichowskiej recepcie zasada równowagi, umiarkowania, i zasada legitymizacji. Koncept równowagi jako szansa uspokojenia sił rewolucyjnych przez odwołanie się do wspólnych interesów państw, które w innej sytuacji mogłyby być rywalami (rewolucjonistą w układzie [Klemensa von] Metternicha był oczywiście Napoleon [Bonaparte], który stosował siłę bez umiaru), i drugi, bardzo ważny, koncept legitymizacji, czyli próba nadania piętna prawa nagiej, brutalnej, agresywnej sile politycznej.",
                                "translation": "[Henry] Kissinger is attracted to the Metternichian's recipe due to the rule of balance, moderation, and the rule of legitimation. The concept of balance as a chance of calming down the revolutionary powers by making reference to common interests of the countries, which in a different situation could be rivals (the revolutionist in [Klemens von] Metternich's layout was of course Napoleon, who applied force without moderation), and the second, very important, concept of legitimation, or the attempt of giving a mark of law to the naked, brutal, aggressive political power.",
                                "english": "[Henry] Kissinger is attracted to the Metternichian's recipe due to the rule of balance, moderation, and the rule of legitimation. The concept of balance as a chance of calming down the revolutionary powers by making reference to common interests of the countries, which in a different situation could be rivals (the revolutionist in [Klemens von] Metternich's layout was of course Napoleon, who applied force without moderation), and the second, very important, concept of legitimation, or the attempt of giving a mark of law to the naked, brutal, aggressive political power."
                            }
                        ]
                    }
