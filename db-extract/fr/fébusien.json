                        "entry_id": "67a3368b-7d02-3cd8-9694-56ecd0cdc4ae",
                        "glosses": [
                            "Relatif au système d’écriture qui était utilisée en Béarn, avant son rattachement à la France."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06d6a668-0a23-411d-a939-04a7b85d373a",
                                "sense_id": "9ad1a6be-5e27-3528-9a5d-77d5b0fb1898",
                                "text": "En toile de fond, l’opposition rédhibitoire à la graphie dite classique ou normalisée de certains défenseurs de la langue béarnaise, qui prônent la graphie dite fébusienne."
                            }
                        ]
