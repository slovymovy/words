                "senses": [
                    {
                        "sense_id": "db5a1feb-aba4-3003-8ba5-5810c9d30937",
                        "entry_id": "b810c0e1-e137-3435-b842-8acf26758915",
                        "glosses": [
                            "staatliche Einrichtung, die privaten Züchtern hochwertige Zuchthengste (Landbeschäler) zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ecd370-6cf3-438e-a435-00fc993fa553",
                                "sense_id": "db5a1feb-aba4-3003-8ba5-5810c9d30937",
                                "text": "„Bei der Eröffnungsfeier der Pferdesport-EM in Aachen war die Bundesverteidigungsministerin am Dienstagabend Teil einer Quadrille der zehn deutschen Landgestüte mit 68 Hengsten.“"
                            },
                            {
                                "example_id": "a8115509-dd2b-46ac-abf2-adaf6c22e407",
                                "sense_id": "db5a1feb-aba4-3003-8ba5-5810c9d30937",
                                "text": "„Die meisten Regierungen Teutschlands sind zu der Überzeugung gelangt, daß der Staat die Pferdezucht unter seinen Schutz nehmen müsse, wenn nicht durch Anlegung von Stamm- und Landgestüten, so doch durch Aufstellung tüchtiger Landbeschäler und andere Begünstigungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
