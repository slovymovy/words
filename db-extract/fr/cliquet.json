                ],
                "senses": [
                    {
                        "sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
                        "entry_id": "374c9e43-14cf-3bdd-a0cf-09db300b75f6",
                        "glosses": [
                            "Petit levier dont on se sert pour empêcher qu’une roue à rochet qui tourne dans un sens puisse se mouvoir dans un sens contraire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "063b8db4-36e4-4368-a48c-724d3a7bc7d2",
                                "sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
                                "text": "Les cliquets se lèvent quand leurs électros respectifs reçoivent le courant, c’est à dire quand les interrupteurs à tube de mercure des relais sont fermés."
                            },
                            {
                                "example_id": "a918b3ff-3a98-493c-87c4-8629443838b2",
                                "sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
                                "text": "L’image usuelle est celle d’une roue dentée à dents asymétriques jointe à un cliquet interdisant l’un des sens de rotation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "91a7d9b7-e48b-4969-9fe9-af786e21db72",
                        "source_entry_id": "374c9e43-14cf-3bdd-a0cf-09db300b75f6",
                        "source_sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
                        "target_lang_word": "Knarre",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Knarre",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "271a85f2-9bc5-3881-8c86-13f1ed38465e",
                                        "entry_id": "e85df36e-c545-3c3b-8915-4f0c5f6c03ed",
                                        "glosses": [
                                            "hölzernes Lärm- und Musikinstrument, teilweise auch aus Kunststoff hergestellt"
                                        ],
                                        "tags": [
                                            "Instrument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cefdcc6-dfc9-4b4b-a123-899e95ec438d",
                                                "sense_id": "271a85f2-9bc5-3881-8c86-13f1ed38465e",
                                                "text": "Die Kinder lärmten mit ihren Knarren und Glocken im ganzen Dorf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "89d36085-d4f6-368c-926d-c5219e129492",
                                        "entry_id": "e85df36e-c545-3c3b-8915-4f0c5f6c03ed",
                                        "glosses": [
                                            "Schraubwerkzeug, das aus Handhebel mit aufgesetztem, austauschbarem Werkzeugteil besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06573d6c-8a4e-44c3-84e4-d166619c5292",
                                                "sense_id": "89d36085-d4f6-368c-926d-c5219e129492",
                                                "text": "Mit der Knarre lassen sich die langen Schrauben einfacher ausdrehen als mit dem Maulschlüssel."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "e3039919-b683-3675-a29e-280491de383a",
                                        "entry_id": "e85df36e-c545-3c3b-8915-4f0c5f6c03ed",
                                        "glosses": [
                                            "mehrschüssige Waffe, die man zum Abfeuern in der Hand hält"
                                        ],
                                        "tags": [
                                            "casual",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05e7a37b-8476-43c9-bfe1-d7c1c70e66c4",
                                                "sense_id": "e3039919-b683-3675-a29e-280491de383a",
                                                "text": "Leg die Knarre lieber weg, bevor du jemanden damit tötest."
                                            },
                                            {
                                                "example_id": "715ca156-b58c-425f-bdcc-074e6e9478bd",
                                                "sense_id": "e3039919-b683-3675-a29e-280491de383a",
                                                "text": "Dagegen wird das Waffenrecht in der Mitte des Landes und im Süden noch weiter gelockert. Getreu dem Motto von Wayne LaPierre, dem Chef der mächtigen Waffenlobby NRA: \"Der einzige Weg, einen bösen Kerl mit Knarre zu stoppen, ist ein guter Kerl mit einer Knarre.\""
                                            },
                                            {
                                                "example_id": "207b8936-cee2-44f9-8688-189df345a034",
                                                "sense_id": "e3039919-b683-3675-a29e-280491de383a",
                                                "text": "„Nach einer Weile kam der Motherfucker, der mir die Knarre abgenommen hatte, wieder herein und stellte mir das Glas auf den Couchtisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a06a9cff-9db1-4541-b55c-44d1c4b6a261",
                        "source_entry_id": "374c9e43-14cf-3bdd-a0cf-09db300b75f6",
                        "source_sense_id": "05a65f7b-e0c0-3692-88eb-47fe342795d0",
