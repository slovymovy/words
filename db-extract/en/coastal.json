                        "glosses": [
                            "Relating to the coast; on or near the coast; longshore."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17f01c98-a264-4d11-9c46-2d388199d1f3",
                                "sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                                "text": "coastal town"
                            },
                            {
                                "example_id": "257d188e-7d46-4b18-b785-f095618c9979",
                                "sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                                "text": "coastal breeze"
                            },
                            {
                                "example_id": "84b2993b-134a-4d08-a147-ea72727c8add",
                                "sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                                "text": "coastal elites"
                            },
                            {
                                "example_id": "32269f56-434c-4be6-964f-0024589f6c64",
                                "sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                                "text": "These included other Niphargus species from deep cave lakes and coastal anchihaline caves [23 ] and Gammarus and Echinogammarus amphipods that live only in permanently watered streams [21 ,24 ]."
                            },
                            {
                                "example_id": "d48172d0-f9d5-45b2-8e63-53b07bfe6e86",
                                "sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                                "text": "Another ANC splinter party, the uMkhonto weSizwe Party (MK), led by former President Jacob Zuma appears to be on course to do well in KwaZulu-Natal, the eastern coastal province where Durban is located."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0c2476e5-e448-4fa1-920f-db5ee607932c",
                        "source_entry_id": "b5951f5f-7a71-3013-a900-ec3009267471",
                        "source_sense_id": "e0c80814-de2a-3cda-a305-8f620ea46a4f",
                        "source_sense_description": "relating to the coast",
                        "target_lang_word": "côtier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "côtier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e1b0aa6a-d930-30c2-83f8-78cc1348baff",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Relatif à, ou qui a la connaissance, la pratique d’une côte, des côtes du bord de la mer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "32c3094e-2782-4015-9039-a88485541526",
                                                "sense_id": "e1b0aa6a-d930-30c2-83f8-78cc1348baff",
                                                "text": "Il s’agissait de découvrir cette pêche du fond des temps consistant à traquer le hareng côtier quand, entre octobre et novembre, il passe au large de la Côte d’Opale […]"
                                            },
                                            {
                                                "example_id": "37dfe4ff-4983-4bb9-9f87-0c2ff97f3ae6",
                                                "sense_id": "e1b0aa6a-d930-30c2-83f8-78cc1348baff",
                                                "text": "Pilote côtier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ee90ba69-53ec-340a-9f14-2544260b0c70",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie la navigation qui se fait le long des côtes, près des côtes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "905293e9-c51f-3e82-9ff2-8e736c74ad3e",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie les bateaux qui suivent les côtes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b1203bc7-ea71-3626-82bc-dd65c3558a18",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie la région terrestre proche d'une côte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bc8fabc-4b90-47d1-9d93-eb6009872ff6",
                                                "sense_id": "b1203bc7-ea71-3626-82bc-dd65c3558a18",
                                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96554263-179a-33af-aa1e-bc3ecaa3444a",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie la région maritime proche d'une côte."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "208b21b8-53f9-42f1-aafa-8ea9a9071086",
                                                "sense_id": "96554263-179a-33af-aa1e-bc3ecaa3444a",
                                                "text": "Une campagne de crowdfunding a d’ailleurs été lancée. Le but est de réunir la maximum de dons pour aider les clubs de sauvetage côtier de Nouvelle-Aquitaine à acquérir du matériel et développer la formation des jeunes MNS."
                                            },
                                            {
                                                "example_id": "2e576a87-b226-4c44-a94e-754ba7cbbe45",
                                                "sense_id": "96554263-179a-33af-aa1e-bc3ecaa3444a",
                                                "text": "En 1968, quarante-deux gros palangriers et dix chalutiers féroésiens ont travaillé au large de la côte Ouest du Groenland, tandis qu'une centaine de petits palangriers (bateaux ouverts) ont péché dans les eaux côtières."
                                            },
                                            {
                                                "example_id": "1126fcbf-78e9-472e-801a-8ade41efa132",
                                                "sense_id": "96554263-179a-33af-aa1e-bc3ecaa3444a",
                                                "text": "Pourtant, d’autres chasseurs hantent ces rivages, avec des intentions moins ludiques : des liches amies, des sérioles ambrées, des tassergals aux dents pointues errent dans la frange côtière, à la poursuite des mulets et orphies."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6957b1a2-7589-3a31-8893-f85ea82748ef",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie un fleuve dont la source est proche de la côte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a3310dd-0882-3728-8cd1-f832c9b868d9",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifie la population qui habite le long d’une côte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "331abd47-fe2b-316e-8d4a-e591d646cf53",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qui a rapport à une côte, dans le sens de pente."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ba39ee9-ce7d-36ab-9756-b611fc077c66",
                                        "entry_id": "b7bb9434-c2a5-3206-ae2b-880e3e64d417",
                                        "glosses": [
                                            "Qualifiait un cheval de renfort, sur les attelages hippomobiles, pour monter une côte."
                                        ],
                                        "tags": [
                                            "especially",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50e4e8ab-9c3b-4b96-a925-c95f3facf48f",
                                                "sense_id": "9ba39ee9-ce7d-36ab-9756-b611fc077c66",
                                                "text": "Je descendais doucement la rue des Martyrs sur le trottoir de gauche, jetant un regard de sympathie au petit salon blanc et or du Faisan Doré, m’arrêtant quelquefois à la boutique de joaillerie du père Salomon, tout en bas, à côté du marchand de couleurs, et parfois aussi allant regarder un peu les côtiers, à l’entrée de la rue Notre-Dame-de-Lorette."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "côtier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "deff72cd-8efb-3b65-bf85-c8c337e886e0",
                                        "entry_id": "a9eeada7-b6f1-3c63-96ea-d9b7d16b62a9",
                                        "glosses": [
                                            "Personne qui mène un cheval côtier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dab5f793-eeba-38da-a8a4-158d79ba64cd",
                                        "entry_id": "a9eeada7-b6f1-3c63-96ea-d9b7d16b62a9",
                                        "glosses": [
                                            "Pilote côtier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0a6b30-0c6c-4651-815e-8a7f46d9343d",
                                                "sense_id": "dab5f793-eeba-38da-a8a4-158d79ba64cd",
                                                "text": "Nous aurons besoin d’un bon côtier pour éviter les récifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8045bfb5-fd6a-330a-83fa-2c7dac49c56a",
                                        "entry_id": "a9eeada7-b6f1-3c63-96ea-d9b7d16b62a9",
                                        "glosses": [
                                            "Bateau destiné à rester près de la côte."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
