                "senses": [
                    {
                        "sense_id": "571b61cb-e18f-3050-b7dc-bb96220b7855",
                        "entry_id": "e1e4c901-f0c2-3a88-97e3-b32ed9aea257",
                        "glosses": [
                            "elektromagnetische Welle mit kurzer Wellenlänge (von 10 m bis 100 m)"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "6f0e01d8-c614-4398-a863-9c4c95e17931",
                                "sense_id": "571b61cb-e18f-3050-b7dc-bb96220b7855",
                                "text": "Die Kurzwelle zeichnet sich durch ein sehr gutes Reflexionsverhalten ihrer Radiowellen an der Ionosphäre aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "5e0015c9-3880-3f21-8cc5-e7a0b61070d5",
                        "entry_id": "e1e4c901-f0c2-3a88-97e3-b32ed9aea257",
                        "glosses": [
                            "Wellenbereich von [1], höherer Frequenzbereich (von 3 MHz bis 30 MHz) als Lang- und Mittelwellen"
                        ],
                        "tags": [
                            "Rundfunk"
                        ],
                        "examples": [
                            {
                                "example_id": "33440321-9e84-41d3-9f9f-ab1e8e1d3ed9",
                                "sense_id": "5e0015c9-3880-3f21-8cc5-e7a0b61070d5",
                                "text": "Die meisten Sender bekommt man auf UKW, nur diesen Sender bekommst du nur auf Kurzwelle."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "969274ae-eab1-30ff-8fb4-3ecc6d641b70",
                        "entry_id": "e1e4c901-f0c2-3a88-97e3-b32ed9aea257",
                        "glosses": [
                            "Kurzform für Kurzwellentherapie: Heilbehandlung durch Bestrahlung mit [1]"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a19b4bf7-cddb-47c0-8a0c-1711ffcd76df",
                                "sense_id": "969274ae-eab1-30ff-8fb4-3ecc6d641b70",
                                "text": "Im Gegensatz zu den Reizstromtherapieformen, die auf elektrische und elektromagnetische Ströme des Körpers einwirken, erzeugt die Kurzwelle eine Erwärmung des Körpergewebes."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51408a2c-01fe-4a9c-9ebb-ef1b082dfe19",
                        "source_entry_id": "e1e4c901-f0c2-3a88-97e3-b32ed9aea257",
                        "source_sense_id": "571b61cb-e18f-3050-b7dc-bb96220b7855",
