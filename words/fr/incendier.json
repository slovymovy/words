            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a28891b-2345-3749-b61a-c610be3caf7f",
                    "sense_definition": "Détruire par le feu ou mettre volontairement le feu à un édifice, une forêt ou un bien.",
