                "senses": [
                    {
                        "sense_id": "18a1d1ce-7ec5-39cd-94fa-e408479e702d",
                        "entry_id": "42a748e2-f5db-3b2f-8cc1-651d2706f4f5",
                        "glosses": [
                            "Pertaining to Unitarianism."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d220f814-c403-4091-8292-f67be66d8196",
                                "sense_id": "18a1d1ce-7ec5-39cd-94fa-e408479e702d",
                                "text": "It was no less than whether the psychic movement in Britain was destined to take a Unitarian or a Trinitarian course."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ef5c62e3-cfea-4c6f-bba3-ce0e940aec3a",
                        "source_entry_id": "42a748e2-f5db-3b2f-8cc1-651d2706f4f5",
                        "source_sense_id": "18a1d1ce-7ec5-39cd-94fa-e408479e702d",
                        "source_sense_description": "pertaining to Unitarianism",
                        "target_lang_word": "unitarien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unitarien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "26e7618b-7fc9-378b-9ee5-b3d322404222",
                                        "entry_id": "58facdf9-158e-3637-b492-ac048a55eef2",
                                        "glosses": [
                                            "Apparenté à l'unitarisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2600f7c8-2c10-4462-a2b8-1fd06c3497ad",
                                                "sense_id": "26e7618b-7fc9-378b-9ee5-b3d322404222",
                                                "text": "Ce n'est pas, sans doute, le catholicisme de Thérèse d'Ervins qui triomphe dans Delphine ; la voie y est déiste, protestante, d'un protestantisme unitairien qui ne diffère guère de celui du Vicaire savoyard."
                                            },
                                            {
                                                "example_id": "8e158c71-c5f5-4af7-bbb1-43b0fc754e45",
                                                "sense_id": "26e7618b-7fc9-378b-9ee5-b3d322404222",
                                                "text": "C'étaient des Unitariens — dans le sens pratique. Grands cœurs, esprits larges, pourvoyeurs sincères d'amusements pour le pauvre peuple."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "unitarien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8518482-e1f7-3eda-8a0b-1bd4a06b2a2f",
                                        "entry_id": "7988e7e0-542e-3008-b99f-43c465d76c49",
                                        "glosses": [
                                            "Sectateur de l'unitarisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9b51f2ec-d1a6-4f95-98ce-3e6e1e565eb7",
                                                "sense_id": "a8518482-e1f7-3eda-8a0b-1bd4a06b2a2f",
                                                "text": "Les unitariens se réclament des courants non trinitaires du christianisme en particulier des ariens, qui avant le concile de Nicée ne reconnaissaient pas Dieu en trois personnes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
