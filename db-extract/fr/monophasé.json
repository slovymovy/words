                        "sense_id": "836b38ba-a65d-390e-b242-cc952fd9e3c8",
                        "entry_id": "037392d4-af86-34ec-8a5f-f2cb3adaa1e9",
                        "glosses": [
                            "Système de distribution de courant électrique dans lequel la tension électrique alternative est présente sur une ligne bifilaire (phase et neutre)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4229a426-9108-4287-b753-4ac34dbb60b5",
                                "sense_id": "836b38ba-a65d-390e-b242-cc952fd9e3c8",
                                "text": "Le monophasé est le courant que l’on trouve généralement dans la maison en France."
                            },
                            {
                                "example_id": "deac7658-8d9c-48e6-a3af-6d1596042b87",
                                "sense_id": "836b38ba-a65d-390e-b242-cc952fd9e3c8",
                                "text": "L’un est appelé le monophasé, c’est celui utilisé dans le circuit électrique domestique, et le triphasé qui est utilisé dans le domaine industriel (gros moteurs, appareils nécessitant une haute puissance)."
                            }
                        ]
                    }
