                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Koordinierung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                        "entry_id": "a3dbde58-4405-3480-acfc-8f1b65072989",
                                        "glosses": [
                                            "das Abstimmen verschiedener Aktivitäten aufeinander, die Verbesserung des Zusammenspiels, des Zusammenwirkens, das Ordnen unter Berücksichtigung mehrerer Aspekte"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "36beb0a9-07f8-4b25-84a0-d0ba0a6e5f7b",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Je mehr Stellen entstehen, umso wichtiger wird die Koordinierung der einzelnen Stellen.“"
                                            },
                                            {
                                                "example_id": "6fe64053-5678-45d1-80d0-dfd84d818f47",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Nachdem zunächst die Angleichung nationaler Schutzvorschriften angestrebt wurde, folgten für die Koordinierung des Verbraucherschutzes mehrere Richtlinien.“"
                                            },
                                            {
                                                "example_id": "377dccc1-1b3c-4046-82d5-759da439a114",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Das Schwerpunktthema des diesjährigen Workshops lautet Echtzeitaspekte bei der Koordinierung Autonomer Systeme.“"
                                            },
                                            {
                                                "example_id": "cfad1ac8-c8f1-402a-a452-b5384f228fbf",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Die Koordinierung der Nordkorea-Politik wird auch ein zentrales Thema bei den Gesprächen Blinkens und Austins mit der südkoreanischen Regierung sein.“"
                                            },
                                            {
                                                "example_id": "620f4dc8-3f7a-45ad-a2b4-a879f5217a16",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Der Mangel an internationaler Koordinierung in dieser Krise sticht ja geradezu hervor.“"
                                            },
                                            {
                                                "example_id": "19dbae16-8ffd-49f4-b69c-4d358947de30",
                                                "sense_id": "753d8989-06d7-371a-80b3-d88055d69450",
                                                "text": "„Bisher werden noch immer 40 Menschen nach Angaben der UN-Agentur zur Koordinierung humanitärer Hilfe (OCHA) vermisst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
