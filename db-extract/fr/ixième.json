                ],
                "senses": [
                    {
                        "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                        "entry_id": "6327cabb-17da-3df0-9de7-b01ae920f36a",
                        "glosses": [
                            "Qui occupe une place indéterminée dans une suite considérée comme trop longue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e849f31-6c5a-41a8-8250-950ba049d2bd",
                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                "text": "Elle n'avait pas envie d'entendre une ixième fois le discours que servait son homme quand on lui disait qu'il jouait avec sa santé. Oh ! Après tout, il fait ce qu'il veut!"
                            },
                            {
                                "example_id": "85371430-53a0-4f9f-8d21-e33d15abc2dd",
                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                "text": "Je décide donc d'acheter une voiture, de développer tant bien que mal mon sens de l'orientation, et commence pour moi une ixième série de cours de conduite, jumelée à des pratiques incessantes."
                            },
                            {
                                "example_id": "8aaef42d-c9ff-457d-ae15-4d0e056fab30",
                                "sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
                                "text": "Oh la la, on ne se fera pas dire non, c’est pas vrai!», a dit François Legault en se frottant le nez pour la ixième fois et en donnant un gros coup de pied sur une roche."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad87d9d5-28c4-48ed-b744-920f1721293a",
                        "source_entry_id": "6327cabb-17da-3df0-9de7-b01ae920f36a",
                        "source_sense_id": "3931fadb-ee61-3891-8da9-84c8a3125137",
