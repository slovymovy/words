                        "sense_id": "71379ef6-4994-36d9-94aa-ff3c018ca5a6",
                        "entry_id": "23807e36-d7be-3833-852a-6f71e0cd4b5b",
                        "glosses": [
                            "von einer anderen/andersartigen/fremden Art/Funktion/Form (als der, die man gerade betrachtet)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2b00dc51-5682-47b0-904f-02f7b888295e",
                                "sense_id": "71379ef6-4994-36d9-94aa-ff3c018ca5a6",
                                "text": "„Warum empfiehlt die STIKO für bereits einmal mit Vaxzervria (AstraZeneca) geimpfte Personen im Alter von <60 Jahren ein heterologes Impfschema (2. Dosis mit mRNA-Impfstoff anstatt Vaxzevria)?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e196328a-2318-3102-a7a7-83f2c7992bdb",
                        "entry_id": "23807e36-d7be-3833-852a-6f71e0cd4b5b",
                        "glosses": [
                            "von einer anderen biologischen Art (als der einen Art, die gerade betrachtet wird)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6931142-fd85-47bf-9f5f-01425fcbb8c3",
                                "sense_id": "e196328a-2318-3102-a7a7-83f2c7992bdb",
                                "text": "Wenn nicht der Ehemann der Samenspender ist, sondern ein Fremder, handelt es sich um eine heterologe Insemination."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
