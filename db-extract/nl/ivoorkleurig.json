                                                "text": "to tickle the ivories"
                                            },
                                            {
                                                "example_id": "c06a6981-7121-43c7-812b-c67bb6527b4f",
                                                "sense_id": "69dffaf2-8527-3ac4-93a6-b09cb73553ee",
                                                "text": "Tony had gone into the storage room and gotten two more standing lamps, one placed near the ebonies and ivories."
                                            }
