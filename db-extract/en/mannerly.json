                                        "entry_id": "6cee6a6e-7f57-393e-a5e0-6879384128ff",
                                        "glosses": [
                                            "mit guten Manieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e4cea55e-f515-49a1-bd7f-2f3149c90569",
                                                "sense_id": "eed6c869-97f2-3985-b3e7-c53b4a5af272",
                                                "text": "Er ist ein ganz manierlicher Junge."
                                            },
                                            {
                                                "example_id": "43b83004-4093-4bb2-9bf4-326e6520f3ca",
                                                "sense_id": "eed6c869-97f2-3985-b3e7-c53b4a5af272",
                                                "text": "„Ich stellte mich manierlich hinten an und konnte mir immerhin noch etwas Eiersalat, einen Hähnchenschenkel und eine Ananasscheibe sichern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f36a0d2d-8e7e-309c-a874-332d1e47f7ed",
                                        "entry_id": "6cee6a6e-7f57-393e-a5e0-6879384128ff",
                                        "glosses": [
                                            "ohne besondere Kritik, ohne große Problem, weder besonders gut noch besonders schlecht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68a3d2fa-d23a-4b8f-85c9-95eee56f190e",
                                                "sense_id": "f36a0d2d-8e7e-309c-a874-332d1e47f7ed",
                                                "text": "Das Fest ist sehr manierlich verlaufen."
                                            },
                                            {
                                                "example_id": "6d12821e-e432-479d-bb46-18eb23d8f5ec",
                                                "sense_id": "f36a0d2d-8e7e-309c-a874-332d1e47f7ed",
                                                "text": "Ich bin einen Meter achtundsiebzig groß, schlank und sehe, wie man mir zu verstehen gibt, recht manierlich aus."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0fdab85e-2a41-46d7-9922-2639b99b3f66",
                        "source_entry_id": "71d24eba-0d20-3f8f-96ac-eea79fd5b9cd",
