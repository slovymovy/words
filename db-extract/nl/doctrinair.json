                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3edfd910-4e2f-440d-8ee5-ce0d33517939",
                                                "sense_id": "573c0ba6-07b4-328c-a8da-3d04c9fc9e34",
                                                "text": "The word of God serveth no otherwise than in the nature of a doctrinal instrument."
                                            }
