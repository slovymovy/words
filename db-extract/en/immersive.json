                        "translation_id": "b7eb7f74-756a-462a-9e78-07e0a7fb5526",
                        "source_entry_id": "85a65dd3-e425-3bc9-858a-7c9634a5c55d",
                        "source_sense_description": "giving the impression of immersion",
                        "target_lang_word": "eindringlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eindringlich",
