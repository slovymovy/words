{
    "word_family": [
        "locoism",
        "locoweed"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "96a6dedb-248f-3a44-b658-326d5372fe7c",
                    "sense_definition": "Crazy, mad, or eccentric.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "crazy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Everyone thought he had gone totally <w>loco</w> when he quit his job to travel the world.",
                            "target_lang_translations": {
                                "fr": "Tout le monde a pensé qu'il était devenu complètement <w>fou</w> lorsqu'il a quitté son travail pour faire le tour du monde.",
                                "zh": "当他辞职去环游世界时，大家都以为他完全<w>疯</w>了。"
                            }
                        },
                        {
                            "text": "The loud music and endless crowds were driving her completely <w>loco</w>.",
                            "target_lang_translations": {
                                "fr": "La musique forte et la foule interminable étaient en train de la rendre complètement <w>dingue</w>.",
                                "zh": "吵闹的音乐和无穷无尽的人群快要把她逼<w>发疯</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go loco"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "commonly used in informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Fou, dingue ou excentrique.",
                        "zh": "疯狂的、发疯的或古怪的（俚语）。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "fou",
                                "target_lang_sense_clarification": "dérangé ou excentrique"
                            },
                            {
                                "target_lang_word": "cinglé",
                                "target_lang_sense_clarification": "familier, un peu fou"
                            },
                            {
                                "target_lang_word": "dingue",
                                "target_lang_sense_clarification": "très familier"
                            },
                            {
                                "target_lang_word": "maboul",
                                "target_lang_sense_clarification": "familier"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疯",
                                "target_lang_sense_clarification": "形容精神失常或举止狂妄"
                            },
                            {
                                "target_lang_word": "发疯的",
                                "target_lang_sense_clarification": "指失去理智或陷入狂乱"
                            },
                            {
                                "target_lang_word": "发狂的",
                                "target_lang_sense_clarification": "指极度狂乱或失去控制"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61456b3b-655b-3b03-ac19-c41a905f01a2",
                    "sense_definition": "Suffering from disease or intoxication caused by consuming locoweed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locoweed_poisoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rancher noticed that several of his cows had become <w>loco</w> after grazing on the dry pasture.",
                            "target_lang_translations": {
                                "fr": "L'éleveur a remarqué que plusieurs de ses vaches étaient <w>atteintes de locoïsme</w> après avoir brouté dans le pâturage aride.",
                                "zh": "农场主注意到，他的几头牛在干燥的牧场上吃草后变得<w>疯草中毒</w>了。"
                            }
                        },
                        {
                            "text": "Horses that turn <w>loco</w> display uncoordinated movements and erratic behavior.",
                            "target_lang_translations": {
                                "fr": "Les chevaux qui deviennent <w>intoxiqués</w> présentent des mouvements désordonnés et un comportement erratique.",
                                "zh": "<w>患疯草病</w>的马匹会表现出动作不协调和行为反常的症状。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pea struck"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily Western US ranching context"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Atteint de locoïsme, une intoxication causée chez le bétail par l'ingestion d'astragales ou d'oxytropis toxiques.",
                        "zh": "（牲畜）因食用疯草而中毒患病的。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "atteint de locoïsme",
                                "target_lang_sense_clarification": "bétail intoxiqué par une plante"
                            },
                            {
                                "target_lang_word": "intoxiqué",
                                "target_lang_sense_clarification": "par une plante toxique"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "患疯草病的",
                                "target_lang_sense_clarification": "指牲畜因食用疯草中毒"
                            },
                            {
                                "target_lang_word": "疯草中毒的",
                                "target_lang_sense_clarification": "指受疯草毒害产生神经症状"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c96f11a5-ee5b-377b-acda-0344b762d88d",
                    "sense_definition": "A locomotive engine.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "locomotive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Train enthusiasts gathered at the depot to photograph the vintage steam <w>loco</w>.",
                            "target_lang_translations": {
                                "fr": "Les passionnés de trains se sont rassemblés au dépôt pour photographier l'ancienne <w>loco</w> à vapeur.",
                                "zh": "火车迷们聚集在车辆段，给老式蒸汽<w>机车</w>拍照。"
                            }
                        },
                        {
                            "text": "The modern electric <w>loco</w> pulled twenty freight cars along the mountain pass.",
                            "target_lang_translations": {
                                "fr": "La <w>locomotive</w> électrique moderne tirait vingt wagons de marchandises le long du col de montagne.",
                                "zh": "那台现代电力<w>机车</w>牵引着二十节货车车厢穿过了山口。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "steam loco"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "shortened form of locomotive"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Locomotive, motrice ferroviaire.",
                        "zh": "机车、火车头（locomotive 的口语简称）。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "loco",
                                "target_lang_sense_clarification": "abréviation familière de locomotive"
                            },
                            {
                                "target_lang_word": "locomotive",
                                "target_lang_sense_clarification": "engin ferroviaire"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "机车",
                                "target_lang_sense_clarification": "指铁路机车或火车头"
                            },
                            {
                                "target_lang_word": "火车头",
                                "target_lang_sense_clarification": "牵引列车的车头"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b044189-623c-3fed-88bf-812e97be8d7f",
                    "sense_definition": "Any of several species of plants belonging to the genera Astragalus or Oxytropis that are toxic to livestock.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locoweed_poisoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rancher carefully cleared the field to prevent cattle from feeding on the poisonous <w>loco</w>.",
                            "target_lang_translations": {
                                "fr": "L'éleveur a soigneusement défriché le champ pour empêcher le bétail de se nourrir de <w>locoweed</w> toxique.",
                                "zh": "牧场主仔细清理了田地，防止牛群误食有毒的<w>疯草</w>。"
                            }
                        },
                        {
                            "text": "Ingesting <w>loco</w> can lead to irreversible neurological damage in grazing herds.",
                            "target_lang_translations": {
                                "fr": "L'ingestion d'<w>astragale toxique</w> peut causer des lésions neurologiques irréversibles chez les troupeaux au pâturage.",
                                "zh": "摄入<w>疯草</w>会导致放牧的牲畜受到不可逆转的神经损伤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "locoweed"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Western US"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Plante toxique pour le bétail des genres Astragalus ou Oxytropis provoquant le locoïsme.",
                        "zh": "疯草（黄芪属或棘豆属植物，对牲畜有毒）。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "locoweed",
                                "target_lang_sense_clarification": "plante toxique pour le bétail"
                            },
                            {
                                "target_lang_word": "astragale toxique",
                                "target_lang_sense_clarification": "terme botanique"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "疯草",
                                "target_lang_sense_clarification": "美洲西部对牲畜有毒的草本植物"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ae41393-147e-3c6c-a35e-122d7b73abb2",
                    "sense_definition": "To drive someone crazy or make them insane.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "crazy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of solitary living in the arid desert seemed to <w>loco</w> the old prospector.",
                            "target_lang_translations": {
                                "fr": "Des années de solitude dans le désert aride semblaient avoir <w>rendu fou</w> le vieux chercheur d'or.",
                                "zh": "在干旱的沙漠里多年的独居生活似乎<w>逼疯</w>了这位老探矿者。"
                            }
                        },
                        {
                            "text": "The endless isolation would <w>loco</w> even the strongest minds among them.",
                            "target_lang_translations": {
                                "fr": "L'isolement sans fin <w>rendrait dingues</w> même les esprits les plus solides d'entre eux.",
                                "zh": "无休止的与世隔绝会<w>使</w>他们当中意志最坚定的人也<w>发疯</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "dated"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Rendre fou, faire perdre la raison à quelqu'un.",
                        "zh": "使发疯，使狂乱。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "rendre fou",
                                "target_lang_sense_clarification": "faire perdre la tête"
                            },
                            {
                                "target_lang_word": "rendre dingue",
                                "target_lang_sense_clarification": "familier"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使发疯",
                                "target_lang_sense_clarification": "指让人失去理智或精神错乱"
                            },
                            {
                                "target_lang_word": "逼疯",
                                "target_lang_sense_clarification": "口语，指使人发疯"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ff12d2e-db63-367f-8e80-8279a5954a2d",
                    "sense_definition": "To poison livestock with locoweed, causing locoism.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "locoweed_poisoning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Severe drought can force cattle to eat weeds that <w>loco</w> them.",
                            "target_lang_translations": {
                                "fr": "Une grave sécheresse peut forcer le bétail à manger des herbes qui les <w>intoxiquent</w>.",
                                "zh": "严重的干旱会迫使牛群啃食那些<w>使</w>它们<w>患疯草病</w>的野草。"
                            }
                        },
                        {
                            "text": "The contaminated pasture will <w>loco</w> any animal left to graze there.",
                            "target_lang_translations": {
                                "fr": "Le pâturage contaminé va <w>rendre malade</w> tout animal laissé là pour brouter.",
                                "zh": "长满毒草的牧场会<w>使</w>在那里放牧的任何动物<w>患上疯草病</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Western US"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Empoisonner le bétail avec du locoweed, entraînant le locoïsme.",
                        "zh": "使（牲畜）因吃疯草而中毒发病。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "intoxiquer",
                                "target_lang_sense_clarification": "empoisonner avec du locoweed"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "使患疯草病",
                                "target_lang_sense_clarification": "因摄入毒草引发牲畜疯草病"
                            },
                            {
                                "target_lang_word": "毒害",
                                "target_lang_sense_clarification": "用有毒草类致害"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "d598b027-6672-3871-b521-24e898087206",
                    "sense_definition": "As a musical direction, indicating that notes should be played at their written pitch after having been played an octave higher or lower.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Following the octave section, the score instructed the pianist to play <w>loco</w>.",
                            "target_lang_translations": {
                                "fr": "Après la section à l'octave, la partition indiquait au pianiste de jouer <w>loco</w>.",
                                "zh": "在八度演奏段落之后，乐谱指示钢琴家<w>按原音高</w>演奏。"
                            }
                        },
                        {
                            "text": "The passage continues <w>loco</w> until the next octave transposition mark appears.",
                            "target_lang_translations": {
                                "fr": "Le passage se poursuit <w>loco</w> jusqu'à ce que la prochaine marque de transposition d'octave apparaisse.",
                                "zh": "乐段继续按<w>原位</w>演奏，直到出现下一个八度移位记号。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "En musique, indication précisant que les notes doivent être jouées à leur hauteur réelle après un passage à l'octave.",
                        "zh": "（音乐术语）按原音高演奏，恢复原位。"
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "loco",
                                "target_lang_sense_clarification": "terme musical italien invariable"
                            },
