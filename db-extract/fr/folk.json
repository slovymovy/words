                ],
                "senses": [
                    {
                        "sense_id": "672a08d5-f80c-3f8d-b9b5-99d50b9b37e8",
                        "entry_id": "0c683d2b-f094-3ec1-8b98-e956d2db1f8d",
                        "glosses": [
                            "Forme courte de musique folk."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9003bc61-96db-47cd-8214-2a39545483da",
                                "sense_id": "672a08d5-f80c-3f8d-b9b5-99d50b9b37e8",
                                "text": "Le folk que joue Dylan, même si avec Gretel Hoffmann il découvre Mississippi John Hurt et qu’avec Koerner on travaille Leadbelly, ce n’est pas tout de suite une musique radicale."
                            },
                            {
                                "example_id": "d1edfe62-ee10-4bab-9c33-ec6821f1c317",
                                "sense_id": "672a08d5-f80c-3f8d-b9b5-99d50b9b37e8",
                                "text": "La folk est une musique traditionnelle populaire modernisée, issue des musiques traditionnelles du monde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4cbbe0ab-0827-42d3-816b-e544c8ed3884",
                        "source_entry_id": "0c683d2b-f094-3ec1-8b98-e956d2db1f8d",
                        "source_sense_id": "672a08d5-f80c-3f8d-b9b5-99d50b9b37e8",
                        "target_lang_word": "folk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "folk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "A people; a tribe or nation; the inhabitants of a region, especially the native inhabitants."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec53dbc3-164c-4752-961e-633607a5ea37",
                                                "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                                "text": "The organization of each folk, as such, sprang mainly from war."
                                            },
                                            {
                                                "example_id": "7ba35a66-e152-4685-8b89-e5a8842c1753",
                                                "sense_id": "744b294d-467e-36f1-b4b0-f06accf373f7",
                                                "text": "We thus arrive at a most unexpected imbroglio. The French have become a Germanic folk and the Germanic folk have become Gaulish!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "People, persons."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fadd8aa-af2c-4ff7-8894-eb19c54095a9",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "There were a lot of folk in the streets."
                                            },
                                            {
                                                "example_id": "25b5da8c-baa4-42ba-8c13-0d6857bc2b36",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "Young folk, old folk, everybody come / To our little Sunday School, and have a lot of fun."
                                            },
                                            {
                                                "example_id": "461d22d3-ba91-4295-8e69-573e6a28633a",
                                                "sense_id": "110e3e0d-65cd-306f-8ab1-c6add681f6a4",
                                                "text": "“[…] the awfully hearty sort of Christmas cards that people do send to other people that they don't know at all well. You know. The kind that have mottoes[…]. And then, when you see [the senders], you probably find that they are the most melancholy old folk with malignant diseases. […]”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d12004fe-fe45-3f48-b3a7-fe247d76eb62",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "One’s relatives, especially one’s parents."
                                        ],
                                        "tags": [
                                            "collective",
                                            "countable",
                                            "plural",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0c187d03-3623-46db-9eab-9eb5b62ecbfb",
                                                "sense_id": "d12004fe-fe45-3f48-b3a7-fe247d76eb62",
                                                "text": "I need to call my folks back home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05d318bf-d658-3bbc-94cd-95c45dcc2b5a",
                                        "entry_id": "4554fa66-845f-3dc1-abea-1322bff63a1d",
                                        "glosses": [
                                            "Ellipsis of folk music."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "countable",
                                            "ellipsis",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
