                            {
                                "example_id": "31985ac2-6391-4642-9b9e-8d289e1e014a",
                                "sense_id": "f8ad54e3-6154-3966-89d3-fb1d72b72689",
                                "text": "De meest gezochte nazioorlogsmisdadiger, Laszlo Csatary, is gevonden in de hoofdstad van Hongarije, Boedapest. Hij staat bovenaan een lijst van meest gezochte oorlogsmisdadigers uit de Tweede Wereldoorlog van het Simon Wiesenthal Centrum. Dit centrum werd vernoemd naar een bekende Joodse nazi-jager. Hieronder volgt een overzicht van de meest gezochte nazi's."
                            },
                            {
                                "example_id": "fa495255-a5dc-4c20-9373-699f44c46f0f",
                                "sense_id": "f8ad54e3-6154-3966-89d3-fb1d72b72689",
                                "text": "Het Simon Wiesenthal Center heeft nazi Alois Brunner officieel van de lijst van meest gezochte nazioorlogsmisdadigers geschrapt. Er is voldoende informatie dat hij vier jaar geleden in Syrië is overleden."
                            }
                        ]
                    }
