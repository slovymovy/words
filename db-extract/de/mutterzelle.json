                    {
                        "sense_id": "70da1338-0ede-3417-ad19-8981e80c53d4",
                        "entry_id": "e5e466ca-f9b1-370a-8ff2-5c4f0bc459a1",
                        "glosses": [
                            "Zelle, aus der bei der Zellteilung die Tochterzellen entstehen"
                        ],
                        "tags": [
                            "Zellbiologie"
                        ],
                        "examples": [
                            {
                                "example_id": "db4de907-8988-4617-bbc1-88bda070f047",
                                "sense_id": "70da1338-0ede-3417-ad19-8981e80c53d4",
                                "text": "„Das Plasma und andere Bestandteile der Mutterzelle werden auf die Tochterzellen aufgeteilt, indem zwischen ihnen Zellmembranen eingezogen oder ausgebildet werden.“"
                            },
                            {
                                "example_id": "9f3d4665-2c01-4081-90f1-5c71c2a92961",
                                "sense_id": "70da1338-0ede-3417-ad19-8981e80c53d4",
                                "text": "Die Veränderungen des Erbguts der Mutterzelle werden an die beiden Tochterzellen weitergegeben."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
