                        "examples": [
                            {
                                "example_id": "97c6ccdd-901d-4116-b399-c47dfa7d1847",
                                "sense_id": "b0257ae8-d281-3ed7-b93f-417c36a27dcf",
                                "text": "Moja sukienka jest w kolorze khaki."
                            },
                            {
                                "example_id": "70113d82-0f1c-4294-9ccf-95db567b051b",
                                "sense_id": "b0257ae8-d281-3ed7-b93f-417c36a27dcf",
                                "text": "Przyzwyczaiłam się do tego, że Krzysiek zawsze chodzi w khaki."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3a8e5b86-9243-3d96-8850-10500f343440",
