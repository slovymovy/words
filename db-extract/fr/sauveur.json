                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45ab8ff4-f60d-4abc-90d3-13bd29962256",
                                                "sense_id": "a67f19fa-c20e-3c5f-8a89-840670eefe16",
                                                "text": "W miarę jak człowiek bierze swój krzyż, łącząc się duchowo z Krzyżem Chrystusa, odsłania się przed nim zbawczy sens cierpienia"
                                            },
                                            {
                                                "example_id": "a7cb31e3-5a4a-429d-ab69-ea82917350f6",
                                                "sense_id": "a67f19fa-c20e-3c5f-8a89-840670eefe16",
                                                "text": "Chrystus uobecnia swoje zbawcze dzieło w liturgii roku kościelnego"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
