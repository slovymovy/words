                        "examples": [
                            {
                                "example_id": "31226f77-4440-4d19-9ea7-d45ed6132c55",
                                "sense_id": "00642613-8823-3aef-8a82-40b40d616acb",
                                "text": "Turnkring Levet Scone uit Lot geeft zondag 17 mei zijn jaarlijkse turnfeest in de sporthal Vogelenzang. Vanaf 14.30uur kunnen bezoekers alle turn- en dansgroepen van de vereniging aan het werk zien. Om 17uur is er een speciale linedance demonstratie."
                            },
                            {
                                "example_id": "4dc46f5f-6dda-47cb-8c6a-7342fa76aae8",
                                "sense_id": "00642613-8823-3aef-8a82-40b40d616acb",
                                "text": "Na een geslaagd turnfeest in de sporthal van Sint-Amandse, start turnkring PACSAM&VES op 1 september het nieuwe turnjaar."
