{
    "word_family": [
        "harborage",
        "harborer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e7e8cb5e-aa7d-3431-b881-8a0c76624a1a",
                    "sense_definition": "A sheltered area of water next to the land where ships can safely anchor or dock.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "water_shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The large ship slowly entered the <w>harbor</w> to unload its cargo.",
                            "target_lang_translations": {
                                "ru": "Большой корабль медленно вошел в <w>гавань</w>, чтобы разгрузить свой груз.",
                                "zh": "大船缓慢地驶入<w>港口</w>卸货。",
                                "fr": "Le grand navire est entré lentement dans le <w>port</w> pour décharger sa cargaison."
                            }
                        },
                        {
                            "text": "Fishermen often leave the <w>harbor</w> before sunrise to catch fish.",
                            "target_lang_translations": {
                                "ru": "Рыбаки часто покидают <w>гавань</w> до рассвета, чтобы наловить рыбы.",
                                "zh": "渔民们常在日出前离开<w>港口</w>去捕鱼。",
                                "fr": "Les pêcheurs quittent souvent le <w>port</w> avant le lever du soleil pour aller pêcher."
                            }
                        }
                    ],
                    "synonyms": [
                        "port",
                        "haven",
                        "dock",
                        "seaport"
                    ],
                    "common_phrases": [
                        "safe harbor",
                        "enter the harbor",
                        "leave the harbor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищенная часть водного пространства у суши, где корабли могут безопасно стоять на якоре или у причала.",
                        "zh": "陆地旁水域受保护的区域，船只可以在此安全停泊或靠岸。",
                        "fr": "Zone protégée d'un plan d'eau près de la terre où les navires peuvent mouiller ou accoster en toute sécurité."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "гавань",
                                "target_lang_sense_clarification": "место стоянки судов"
                            },
                            {
                                "target_lang_word": "порт",
                                "target_lang_sense_clarification": "оборудованное место для судов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "港口",
                                "target_lang_sense_clarification": "供船只停泊的场所"
                            },
                            {
                                "target_lang_word": "海港",
                                "target_lang_sense_clarification": "天然或人工的避风港"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "port",
                                "target_lang_sense_clarification": "lieu aménagé pour les navires"
                            },
                            {
                                "target_lang_word": "havre",
                                "target_lang_sense_clarification": "abri naturel ou sûr pour les bateaux"
                            },
                            {
                                "target_lang_word": "rade",
                                "target_lang_sense_clarification": "vaste étendue d'eau protégée"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "956300fa-d361-3092-bf12-67ef0aa6c99d",
                    "sense_definition": "A place of safety, shelter, or refuge.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The quiet library was a <w>harbor</w> for students trying to study.",
                            "target_lang_translations": {
                                "ru": "Тихая библиотека была <w>убежищем</w> для студентов, пытающихся учиться.",
                                "zh": "安静的图书馆是学生们学习的<w>避风港</w>。",
                                "fr": "La bibliothèque calme était un <w>refuge</w> pour les étudiants qui essayaient de travailler."
                            }
                        },
                        {
                            "text": "During the war, the neutral country became a <w>harbor</w> for refugees.",
                            "target_lang_translations": {
                                "ru": "Во время войны нейтральная страна стала <w>пристанищем</w> для беженцев.",
                                "zh": "战争期间，这个中立国成为了难民的<w>庇护所</w>。",
                                "fr": "Pendant la guerre, le pays neutre est devenu un <w>havre</w> pour les réfugiés."
                            }
                        }
                    ],
                    "synonyms": [
                        "refuge",
                        "sanctuary",
                        "shelter",
                        "asylum"
                    ],
                    "common_phrases": [
                        "harbor of refuge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место безопасности, укрытия или защиты.",
                        "zh": "提供安全、庇护或避难的地方。",
                        "fr": "Un lieu de sécurité, d'abri ou de refuge."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "убежище",
                                "target_lang_sense_clarification": "безопасное место"
                            },
                            {
                                "target_lang_word": "пристанище",
                                "target_lang_sense_clarification": "приют"
                            },
                            {
                                "target_lang_word": "укрытие",
                                "target_lang_sense_clarification": "место, где можно спрятаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "避风港",
                                "target_lang_sense_clarification": "比喻安全的地方"
                            },
                            {
                                "target_lang_word": "庇护所",
                                "target_lang_sense_clarification": "提供保护的场所"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "refuge",
                                "target_lang_sense_clarification": "lieu où l'on cherche un abri"
                            },
                            {
                                "target_lang_word": "havre",
                                "target_lang_sense_clarification": "abri figuré ou littéraire"
                            },
                            {
                                "target_lang_word": "abri",
                                "target_lang_sense_clarification": "lieu qui protège"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4d27e649-b92b-34f9-9289-fdbd2d755583",
                    "sense_definition": "To keep a thought, feeling, or secret in one's mind for a long time, often a negative one.",
                    "learner_level": "C1",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She still <w>harbors</w> a grudge against her former boss for firing her.",
                            "target_lang_translations": {
                                "ru": "Она все еще <w>таит</w> обиду на своего бывшего начальника за увольнение.",
                                "zh": "她因为被解雇的事，至今仍对前老板<w>怀有</w>怨恨。",
                                "fr": "Elle <w>nourrit</w> toujours de la rancœur envers son ancien patron pour l'avoir licenciée."
                            }
                        },
                        {
                            "text": "It is unhealthy to <w>harbor</w> resentment for so many years.",
                            "target_lang_translations": {
                                "ru": "Вредно <w>вынашивать</w> чувство обиды в течение стольких лет.",
                                "zh": "多年来一直<w>心存</w>怨恨对健康不利。",
                                "fr": "Il est malsain de <w>couver</w> du ressentiment pendant tant d'années."
                            }
                        }
                    ],
                    "synonyms": [
                        "hold",
                        "nurse",
                        "bear",
                        "cherish",
                        "entertain"
                    ],
                    "antonyms": [
                        "forget",
                        "dismiss"
                    ],
                    "common_phrases": [
                        "harbor a grudge",
                        "harbor resentment",
                        "harbor feelings",
                        "harbor doubts"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранять в душе мысли или чувства (часто негативные) в течение долгого времени.",
                        "zh": "长期在心中怀有某种想法、情感或秘密，通常指负面的。",
                        "fr": "Garder une pensée, un sentiment ou un secret dans son esprit pendant longtemps, souvent de nature négative."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "затаить",
                                "target_lang_sense_clarification": "обиду или злобу"
                            },
                            {
                                "target_lang_word": "вынашивать",
                                "target_lang_sense_clarification": "мысли или планы"
                            },
                            {
                                "target_lang_word": "питать",
                                "target_lang_sense_clarification": "чувства или надежды"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "怀有",
                                "target_lang_sense_clarification": "心中存有某种情感"
                            },
                            {
                                "target_lang_word": "心存",
                                "target_lang_sense_clarification": "内心保留某种想法"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "nourrir",
                                "target_lang_sense_clarification": "entretenir un sentiment"
                            },
                            {
                                "target_lang_word": "entretenir",
                                "target_lang_sense_clarification": "garder une pensée"
                            },
                            {
                                "target_lang_word": "couver",
                                "target_lang_sense_clarification": "garder en soi un sentiment négatif"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b25cda6-8c19-3dce-81a9-239cb6f53b25",
                    "sense_definition": "To give shelter or protection to someone or something, especially to hide a criminal or to allow germs to live.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is a serious crime to <w>harbor</w> a fugitive from the law.",
                            "target_lang_translations": {
                                "ru": "Это серьезное преступление — <w>укрывать</w> беглеца от закона.",
                                "zh": "<w>窝藏</w>逃犯是严重的犯罪行为。",
                                "fr": "C'est un crime grave que d'<w>abriter</w> un fugitif recherché par la loi."
                            }
                        },
                        {
                            "text": "Kitchen sponges can <w>harbor</w> harmful bacteria if not cleaned regularly.",
                            "target_lang_translations": {
                                "ru": "Кухонные губки могут <w>содержать</w> вредные бактерии, если их не чистить регулярно.",
                                "zh": "如果厨房海绵不定期清洗，可能会<w>滋生</w>有害细菌。",
                                "fr": "Les éponges de cuisine peuvent <w>abriter</w> des bactéries nocives si elles ne sont pas nettoyées régulièrement."
                            }
                        }
                    ],
                    "synonyms": [
                        "shelter",
                        "hide",
                        "conceal",
                        "shield",
                        "protect"
                    ],
                    "antonyms": [
                        "expose",
                        "eject"
                    ],
                    "common_phrases": [
                        "harbor a criminal",
                        "harbor a fugitive",
                        "harbor germs"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предоставлять укрытие или защиту, особенно скрывать преступника.",
                        "zh": "为某人或某物提供庇护或保护，尤指藏匿罪犯或允许病菌滋生。",
                        "fr": "Donner un abri ou une protection à quelqu'un ou quelque chose, notamment cacher un criminel ou permettre à des germes de se développer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укрывать",
                                "target_lang_sense_clarification": "прятать кого-то"
                            },
                            {
                                "target_lang_word": "прятать",
                                "target_lang_sense_clarification": "скрывать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "窝藏",
                                "target_lang_sense_clarification": "非法藏匿罪犯"
                            },
                            {
                                "target_lang_word": "滋生",
                                "target_lang_sense_clarification": "指细菌等生长"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "abriter",
                                "target_lang_sense_clarification": "donner un refuge"
                            },
                            {
                                "target_lang_word": "héberger",
                                "target_lang_sense_clarification": "accueillir quelqu'un"
                            },
                            {
                                "target_lang_word": "recéler",
                                "target_lang_sense_clarification": "cacher un criminel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eb464145-091e-3849-9896-c8021677edf8",
                    "sense_definition": "To take shelter or refuge in a protected area of water.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "water_shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The naval fleet <w>harbored</w> in the southern bay during the winter.",
                            "target_lang_translations": {
                                "ru": "Военно-морской флот <w>стоял</w> в южной бухте в течение зимы.",
                                "zh": "冬季期间，海军舰队在南部海湾<w>停泊</w>。",
                                "fr": "La flotte navale s'est <w>abritée</w> dans la baie sud pendant l'hiver."
                            }
                        },
                        {
                            "text": "We <w>harbored</w> near the island to wait for the storm to pass.",
                            "target_lang_translations": {
                                "ru": "Мы <w>встали на якорь</w> у острова, чтобы переждать шторм.",
                                "zh": "我们在岛屿附近<w>停泊</w>，等待风暴过去。",
                                "fr": "Nous nous sommes <w>abrités</w> près de l'île pour attendre que la tempête passe."
                            }
                        }
                    ],
                    "synonyms": [
                        "dock",
                        "anchor"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находить укрытие или убежище в защищенной акватории (о судах).",
                        "zh": "指船只在受保护的水域中寻找避难所或停泊。",
                        "fr": "Trouver un abri ou un refuge dans une zone d'eau protégée (pour les navires)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стоять в гавани",
                                "target_lang_sense_clarification": "находиться на стоянке"
                            },
                            {
                                "target_lang_word": "встать на якорь",
                                "target_lang_sense_clarification": "остановиться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "停泊",
                                "target_lang_sense_clarification": "船只靠岸或停靠"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "s'abriter",
                                "target_lang_sense_clarification": "se mettre à l'abri"
                            },
                            {
                                "target_lang_word": "mouiller",
                                "target_lang_sense_clarification": "jeter l'ancre"
                            },
                            {
                                "target_lang_word": "se réfugier",
                                "target_lang_sense_clarification": "trouver un refuge"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
