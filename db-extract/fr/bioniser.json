                "senses": [
                    {
                        "sense_id": "e6bffb35-4ba1-3802-8c6d-d4334e7609a1",
                        "entry_id": "f12e9562-70b4-30ba-8c21-40dbde3bc5db",
                        "glosses": [
                            "Donner un caractère bionique à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef5e0803-d897-426f-9d58-0986d6d4099d",
                                "sense_id": "e6bffb35-4ba1-3802-8c6d-d4334e7609a1",
                                "text": "Sélectionner le génome de son enfant, comme dans ‘‘Bienvenue à Gattaca’’, le faire « pousser » en laboratoire comme dans ‘‘Le Meilleur des Mondes’’, puis le « bioniser » pour en faire « le plus fort, le plus rapide, en un mot, le meilleur » comme le proclamait l’Homme qui valait trois milliards… c’est aujourd’hui possible. Ou presque."
                            },
                            {
                                "example_id": "519932f0-bb7e-4e05-adab-2478354ca1ee",
                                "sense_id": "e6bffb35-4ba1-3802-8c6d-d4334e7609a1",
                                "text": "Je me suis fait \"bioniser\" le coeur ^([sic : cœur]) !"
                            },
                            {
                                "example_id": "9be0f8df-6a96-4feb-b04c-1634958c1f52",
                                "sense_id": "e6bffb35-4ba1-3802-8c6d-d4334e7609a1",
                                "text": "J’aurais peur, en achetant la chemise, de me bioniser."
                            }
                        ]
                    }
