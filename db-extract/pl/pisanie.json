                                    {
                                        "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "Graphism of symbols such as letters that express some meaning."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88d72575-24ad-4fb3-8e99-f497b30605b4",
                                                "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                                "text": "Because writing of any kind is no more and no less than a graphic representation of speech[…], to study its nature and history we must often have recourse to the speech, that is, to the language, that the writing writes."
                                            },
                                            {
                                                "example_id": "fb36aed3-1830-4d9e-bca3-f2509052b0b2",
                                                "sense_id": "c8b7736c-4787-3cba-9635-f824e0907536",
                                                "text": "Early writing appeared in both societies around 3000 B.C.E., mainly for administrative purposes in Egypt and for accounting and trading in Sumer."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5d3c06a7-9fa0-3b9e-8e4b-208944e1c0c4",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "Something written, such as a document, article or book."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "202e0f3d-a710-3bff-ba48-f763cd6ae3b2",
                                        "entry_id": "ba568620-5920-3971-a2a9-4d612e163251",
                                        "glosses": [
                                            "The process of representing a language with symbols or letters."
