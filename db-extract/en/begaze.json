                        ],
                        "examples": [
                            {
                                "example_id": "7e7b7fdb-8bc4-4b74-a4d1-16d5c9432c0e",
                                "sense_id": "4e673839-d428-34db-9f7f-ca3f8081d9f1",
                                "text": "I had not leisure to see our friend Masclet, who is prefect there; I could only run along the rampart and begaze the site of Lord Nelson's misemployment."
                            },
                            {
                                "example_id": "3c6ba0e8-042a-4ac8-bebb-d7fc6c2d178c",
                                "sense_id": "4e673839-d428-34db-9f7f-ca3f8081d9f1",
                                "text": "When the high wind volleyed And guardian the moon was I was castled in quietness Begazed and slurred I was And I heard I heard the myriad thrill Of holy and boon Of the whisper of the lieder In the philosophic strings."
                            },
                            {
                                "example_id": "e67ef04b-9fcc-4b25-a7a6-4e0b008d19e2",
                                "sense_id": "4e673839-d428-34db-9f7f-ca3f8081d9f1",
                                "text": "One slow moment as the spearmen tensed, faces drawn, teeth fixed in lower lips, aslant their fearsome eyes begazed him, pale their faces though they so many and he but one; [...]"
                            }
                        ]
                    }
