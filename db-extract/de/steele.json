                ],
                "senses": [
                    {
                        "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                        "entry_id": "aec2e85a-5c80-3674-863b-a192e5c343e8",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65540b4b-6575-4831-98b6-08db09c6cbcf",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Frau Steele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "1b6bcb80-dc55-4a00-99a5-18d6eb247567",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Herr Steele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b03e7a87-6fcc-4bbc-ac12-799cc61847a6",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Die Steeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "072f634a-f09a-49b9-a30c-6b176f2c0b4f",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Der Steele trägt nie die Schals, die die Steele ihm strickt."
                            },
                            {
                                "example_id": "af7ba9fc-29ff-4498-bc8e-d4588ad544c8",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Steele kommt, geht der Herr Steele.“"
                            },
                            {
                                "example_id": "c7e70350-a62f-4210-b54a-082555916d8c",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Steele kommt und geht."
                            },
                            {
                                "example_id": "c804d351-d83f-44e8-9985-234bd46801cd",
                                "sense_id": "21c0d5e7-e76b-3941-8187-fce476b34114",
                                "text": "Steeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
