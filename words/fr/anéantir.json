    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9391436f-d168-358c-b2ff-e4780693344d",
                    "sense_definition": "Détruire complètement quelque chose, le faire disparaître ou le réduire à rien.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le terrible incendie a <w>anéanti</w> une grande partie de la forêt en quelques heures seulement."
                        },
                        {
                            "text": "Cette défaite inattendue risque d'<w>anéantir</w> tous les espoirs de qualification de l'équipe."
                        }
                    ],
                    "synonyms": [
                        "annihiler",
                        "réduire à néant"
                    ],
                    "common_phrases": [
                        "anéantir tout espoir",
                        "anéantir les efforts"
                    ]
                },
                {
                    "sense_id": "f71978d2-73dc-3224-8612-119b98b60794",
                    "sense_definition": "Plonger quelqu'un dans un profond abattement moral ou un épuisement physique extrême.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "accablement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'annonce de cette mauvaise nouvelle l'a complètement <w>anéantie</w> pour le reste de la journée."
                        },
                        {
                            "text": "Après dix heures de marche intense sous le soleil brûlant, nous étions totalement <w>anéantis</w>."
                        }
                    ],
                    "common_phrases": [
                        "être totalement anéanti"
                    ]
                },
                {
                    "sense_id": "47347395-801e-3498-82e0-b020e3f3a381",
                    "sense_definition": "Cesser complètement d'exister, s'évanouir dans le néant.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "destruction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans le silence de la nuit, toute l'agitation de la ville semble s'<w>anéantir</w> peu à peu."
                        },
                        {
                            "text": "Face aux faits indiscutables présentés par l'avocat, cet argument fragile s'<w>anéantit</w> de lui-même."
                        }
                    ],
                    "common_phrases": [
                        "s anéantir d'elle-même"
                    ]
                }
            ]
        }
