                "senses": [
                    {
                        "sense_id": "5f219f66-9aff-3890-98c5-309d59bfc635",
                        "entry_id": "2ffde9fa-ceb5-34ae-afde-2ac4835fd4b3",
                        "glosses": [
                            "Ausbildung an einer Hochschule nach Abschluss, die zur Promotion führt"
                        ],
                        "tags": [
                            "Austrian German"
                        ],
                        "examples": [
                            {
                                "example_id": "396bba38-f72e-4b6c-9c40-7217dfaab3ff",
                                "sense_id": "5f219f66-9aff-3890-98c5-309d59bfc635",
                                "text": "„Johanna Mair: Die Idee dahinter war, ein Doktoratsstudium im Businessbereich anzubieten, das sich auf praxisbezogene Forschung fokussiert.“"
                            },
                            {
                                "example_id": "ab164e60-45dc-4906-8da4-b6ecc5a77400",
                                "sense_id": "5f219f66-9aff-3890-98c5-309d59bfc635",
                                "text": "„Nach seinem Doktoratsstudium in Yale ist er nach Stationen an der Universität Michigan, der RWTH Aachen und der Universität Frankfurt 2014 wieder in die USA zurückgekehrt.“"
                            },
                            {
                                "example_id": "be773783-d86d-470c-b5cd-72f81eb84255",
                                "sense_id": "5f219f66-9aff-3890-98c5-309d59bfc635",
                                "text": "„Dazu hatte er in Bonn schwerpunktmäßig sein Doktoratsstudium absolviert, mit einem Forschungsaufenthalt in Paris 1993/ 94.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
