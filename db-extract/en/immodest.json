                                        "entry_id": "2827d739-1c76-36d6-abc8-69de792018cd",
                                        "glosses": [
                                            "Qui manque à la modestie, aux bienséances, à la pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "771ca3c1-5379-4905-822c-663dfead87ef",
                                                "sense_id": "e790a6ec-8c3d-3ca1-9b3e-0c0f61f217c6",
                                                "text": "C’est une jeune fille assez immodeste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b994e15-4e68-3382-94e0-997dc9a60727",
                                        "entry_id": "2827d739-1c76-36d6-abc8-69de792018cd",
                                        "glosses": [
                                            "Qui est contraire à la modestie, à la pudeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d36eb90b-2b64-4e8e-9472-158f0658ba97",
                                                "sense_id": "9b994e15-4e68-3382-94e0-997dc9a60727",
                                                "text": "D’abord il n’aurait jamais osé s’approcher, il aurait fui plutôt ; tout spectacle immodeste est un péché qui peut être mortel."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2a256f93-93ed-44e8-b12b-960b393e44d6",
                        "source_entry_id": "a0e6a5fe-a138-30b5-8058-33f422434978",
                        "source_sense_id": "1d740323-85a0-3049-921a-9216e555d005",
                        "source_sense_description": "lacking modesty",
