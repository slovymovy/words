            {
                "entry_id": "c85d13bb-26dd-3cd5-b9b7-8b61316add93",
                "word": "overtuigd",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                        "entry_id": "c85d13bb-26dd-3cd5-b9b7-8b61316add93",
                        "glosses": [
                            "voltooid deelwoord van overtuigen"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "e125a324-abd7-4a8b-8f01-956543f76383",
                                "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                                "text": "Mevrouw Maillard had maar één zoon en ze had veel bewondering voor directeuren. Dus zag ze Albert al als directeur van een bank, en reken maar dat ze meteen enthousiast was en ervan overtuigd was dat hij zich 'met zijn intelligentie' rap naar de top zou opwerken."
                            },
                            {
                                "example_id": "fea0264b-8b97-4b5b-a8d5-af9f88a6db85",
                                "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                                "text": "Elk stel heeft zijn eigen dynamiek en behoeftes, maar ik ben ervan overtuigd dat een beetje ruimte veel relaties goed zou doen."
                            },
                            {
                                "example_id": "8783b655-9c39-43c1-934c-7ef798cbdd2c",
                                "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                                "text": "Ze is ervan overtuigd dat hun toekomst in Assendelft is gestrand en daar met haar verleden kennismaakt."
                            },
                            {
                                "example_id": "d524860a-7844-42a3-b86d-dde51d0a10a5",
                                "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                                "text": "Ik was ervan overtuigd dat je hem niet schreef omdat je interesse had in bruidsboeketten, of zelfs maar in tincturen."
                            },
                            {
                                "example_id": "c5e0899d-9e5d-4ac7-ad81-c93d28df49cd",
                                "sense_id": "f2614da6-e24b-362e-83e7-dd69a26dab4c",
                                "text": "' 'Aha,' zei hij, hoewel hij niet overtuigd leek."
                            }
                        ]
                    }
                ],
