                                        "examples": [
                                            {
                                                "example_id": "8b95f239-973e-4a46-880c-050d3eea393c",
                                                "sense_id": "713c0b04-2f30-373c-ada6-2c500ec142f7",
                                                "text": "What changes will be wrought in the character and condition of mankind, as the millennium advances and rolls blissfully away."
                                            },
