                "senses": [
                    {
                        "sense_id": "7f3149df-e6b0-3295-9a1d-21c4a142a562",
                        "entry_id": "5f04ca21-a7ef-3de5-98fa-8e64c1ea7c65",
                        "glosses": [
                            "ein Buch des Neuen Testaments in der Bibel; ein Paulus zugeschriebener, aber vermutlich von einem Paulusschüler verfasster Mahn- und Lehrbrief an die christliche Gemeinde der kleinasiatischen Stadt Kolossä"
                        ],
                        "tags": [
                            "Theologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d0a473ee-22d8-474c-8926-07c4bbaf374c",
                                "sense_id": "7f3149df-e6b0-3295-9a1d-21c4a142a562",
                                "text": "Der Kolosserbrief „ist vom Kampf gegen Irrlehrer geprägt.“"
                            },
                            {
                                "example_id": "e3113a96-0ce4-470d-882e-6cca467723d1",
                                "sense_id": "7f3149df-e6b0-3295-9a1d-21c4a142a562",
                                "text": "„Der Kolosserbrief, der wahrscheinlich nicht von Paulus selbst verfaßt ist, in seinem Geist jedoch dem Denken des Apostels nahesteht, behandelt ein Problem, das dem Anlaß des Galaterbriefes analog ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
