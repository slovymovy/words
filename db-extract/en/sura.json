                                                "example_id": "4e6378ff-00b4-4623-9d42-cd443cc130f7",
                                                "sense_id": "c262dbd8-bb4b-3948-8e33-dcf69ef3a034",
                                                "text": "Eine Sure wird in Verse (Aya) unterteilt."
                                            },
                                            {
                                                "example_id": "0ce777c2-b0f4-45ac-8fa5-c97750ff83ca",
                                                "sense_id": "c262dbd8-bb4b-3948-8e33-dcf69ef3a034",
                                                "text": "„Gottes Offenbarung an Mohammed tat sich kund in einhundertvierzehn Kapiteln, auch Suren genannt.“"
                                            },
                                            {
                                                "example_id": "9adc42bc-15ee-4dc4-8f95-c394c9d0be0d",
                                                "sense_id": "c262dbd8-bb4b-3948-8e33-dcf69ef3a034",
                                                "text": "„Der Muezzin holte nach jeder Sure auffällig tief Luft, ich hörte es durch die Lautsprecher und dachte, dass mir das am besten gefiel, das Luftholen.“"
                                            }
