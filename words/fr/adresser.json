                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré la distance importante, le tireur expérimenté a su <w>adresser</w> au but sans faillir."
                        },
                        {
                            "text": "Le jeune archer a parfaitement <w>adressé</w> sa flèche au centre de la cible."
                        }
                    ],
                    "synonyms": [
                        "atteindre",
                        "toucher"
                    ],
                    "antonyms": [
                        "manquer",
                        "rater"
                    ],
                    "common_phrases": [
                        "adresser au but"
                    ],
