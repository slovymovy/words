                        "examples": [
                            {
                                "example_id": "b6d3c2d8-72f3-4123-a987-9b2ac8c74503",
                                "sense_id": "950ad884-814f-3f72-851d-0b2ca4f35688",
                                "text": "Think’st thou I am so shallow, so conceitless,\nTo be seduced by thy flattery,\nThat hast deceived so many with thy vows?"
                            },
                            {
                                "example_id": "72514099-33b5-436b-b261-70e786108fcf",
                                "sense_id": "950ad884-814f-3f72-851d-0b2ca4f35688",
                                "text": "1614, William Browne, The Shepheards Pipe, London: George Norton, The First Eglogue,\nHe thus departeth as God would harmlesse;\nAnd forth of auenture his way is went,\nBut whitherward he draw, he conceitlesse\nWas, he nat knew to what place he was bent."
                            }
                        ]
                    }
