                    },
                    {
                        "translation_id": "28e035c7-6bc9-4ccd-98bb-87f282ab11ec",
                        "source_entry_id": "3e0c4739-3bb5-3ba7-9e2b-34deffed9047",
                        "source_sense_id": "e961de09-40c2-3e31-a48e-1a3abcedcb8e",
                        "source_sense_description": "transitiv, veraltet: etwas reparieren; wieder in Ordnung bringen; instand setzen",
                        "target_lang_word": "instand setzen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "instand setzen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                        "entry_id": "28f7b109-a817-3054-a702-ceff0532995b",
                                        "glosses": [
                                            "wieder in den Zustand bringen, in dem etwas entsprechend seiner Bestimmung eingesetzt/benutzt/verwendet werden kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e29a08e-e989-4eeb-9869-e960271ed220",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Ich glaube, er hatte gar nicht vor, heute noch einen Zaun instand zu setzen.“"
                                            },
                                            {
                                                "example_id": "7cc5d291-7695-4a5b-b670-c67aff2b223f",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Im August setzte man die westliche Esskastanieallee instand und befestigte Wege. In den Monaten Juni bis September reinigte man alle Wallgräben.“"
                                            },
                                            {
                                                "example_id": "5410c82b-6aee-4e59-b0b7-2e19cdf4c881",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„An vielen Stellen war die untere Platte neben den 1970 instandgesetzten Bereichen und auch innerhalb dieser Bereiche von den Längsträgerstegen, den Randbalken und den Querträgern abgerissen.“"
                                            },
                                            {
                                                "example_id": "59bc13d8-212b-4f61-a5fa-b227ae763ed6",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Es gab Fälle, wo ein gerade eben instand gesetzter Abschnitt gleich wieder zerstört wurde.“"
                                            },
                                            {
                                                "example_id": "8902ef82-5e13-486f-b681-2f6f843ad8c0",
                                                "sense_id": "697d568c-5fe5-368c-bed6-d93ac74ad4a5",
                                                "text": "„Auf einem wackeligen Gerüst aus knorrigen Stöcken waren ein Dutzend Maurer damit beschäftigt, ein kommunales Gebäude mit einem wolkenförmigen Loch in der Fassade instand zu setzen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
