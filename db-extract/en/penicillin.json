                    }
                ],
                "senses": [
                    {
                        "sense_id": "e4a7646c-9671-3c5e-9697-186e00feac54",
                        "entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "glosses": [
                            "Any of a group of narrow-spectrum antibiotics obtained from Penicillium molds or synthesized, that have a beta-lactam structure and are active against gram-positive bacteria and used in the treatment of various infections and diseases."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "21540e16-0b24-3686-a4c0-216425bb1d26",
                        "entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "glosses": [
                            "A blue mold of the genus Penicillium that produces penicillin."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd11bfa7-e60a-4d18-854f-499786e1a3ad",
                        "source_entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "source_sense_description": "antibiotic",
                        "target_lang_word": "penicilín",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penicilín",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "1821881b-c232-3ef6-8257-64e871cd49ad",
                                        "entry_id": "04656ef2-3e97-3fd6-94d1-b001fd037303",
                                        "glosses": [
                                            "antibiotikum obsažené v některých plísních rodu Penicillium"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eaf791e1-7c52-4323-a4f8-8e5a1f752a6d",
                                                "sense_id": "1821881b-c232-3ef6-8257-64e871cd49ad",
                                                "text": "Lékaři ze spuštění alergie podezírají následnou léčbu penicilínem, který zřejmě narušil pacientčinu hladinu histaminu v krvi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07325871-8b08-4d2c-9de1-616b078de477",
                        "source_entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "source_sense_description": "antibiotic",
                        "target_lang_word": "penicilline",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "penicilline",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "40c90558-7761-3a65-a81d-b505d75790c2",
                                        "entry_id": "3727f64d-4197-343a-8d56-f278106466d8",
                                        "glosses": [
                                            "een in 1928 door de Britse arts-bacterioloog Alexander Fleming ontdekte antibacteriële stof die het eerste algemeen bruikbare antibioticum opleverde. Het is een bètalactamantibioticum (β-lactam) geproduceerd door de penseelschimmel Penicillium chrysogenum"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "693d5fb5-4841-4ce8-ad62-07bea5fd935f",
                        "source_entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "source_sense_description": "antibiotic",
                        "target_lang_word": "pénicilline",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pénicilline",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                        "entry_id": "c184a5c7-2c32-3d81-bb00-e3eab69ad5de",
                                        "glosses": [
                                            "Antibiotique bêta-lactamine produit à l'origine par des champignons du genre Penicillium, puis par hemi-synthèse ou synthèse totale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52d81a00-7f1b-4bfc-8ea5-9c1da6c4985f",
                                                "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                                "text": "Depuis sept ans, la Chine est coupée du monde extérieur, et c'est seulement maintenant que nous parviennent quelques microfilms. On dit que la Septième Symphonie de Chostakovitch a été envoyée en Amérique sur microfilms, mais personne ne nous a encore transmis, par microfilms, des renseignements sur la pénicilline."
                                            },
                                            {
                                                "example_id": "f5e4ceb9-2639-46b1-9bd8-b12c2e82e28b",
                                                "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                                "text": "Breese, en 1969, montre l'absence de portage de streptocoque A chez 100 enfants traités par la lincomycine, alors que 12/102 enfants traités par pénicilline en sont porteurs."
                                            },
                                            {
                                                "example_id": "b4ffe80e-6933-40ec-ae9e-96008548d71e",
                                                "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                                "text": "Nous vivions tous ensemble dans des burons d’altitude, cabanes de berger où mûrissait, sur des claies, le cantal, fromage délicieux dont nous nous gavions et qui, avec des steaks de vaches fraîchement tuées, constituait notre unique nourriture, ce qui entraîna à terme de spectaculaires furonculoses, inguérissables jusqu’à l’arrivée de la pénicilline apportée par les Américains."
                                            },
                                            {
                                                "example_id": "26475aaf-ad86-49b7-b509-385f44678bbc",
                                                "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                                "text": "Les pénicillines inhibent une enzyme indispensable aux bactéries pour former leur paroi cellulaire. Elles servent à traiter un large éventail d’infections. Parmi les effets secondaires : nausée, fièvre, confusion, mal de tête, vomissement et convulsions."
                                            },
                                            {
                                                "example_id": "0895e733-d480-4730-9295-7c21636c4262",
                                                "sense_id": "022b56ab-9133-3b1f-8044-a2e0baa13c2f",
                                                "text": "La même année, le groupe Beecham a lui aussi déposé une demande de brevet concernant la pénicilline synthétique au Royaume-Uni, et ce brevet a été délivré en 1960."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edb04dd9-8f5f-42fe-8ce5-70d3bc0b3f7f",
                        "source_entry_id": "49a1f36a-5f12-36e0-a923-2e40b13683ae",
                        "source_sense_description": "antibiotic",
                        "target_lang_word": "Penicillin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
