                        "glosses": [
                            "Frau, die erst in einem höheren Alter als üblich ihr erstes Kind oder ein weiteres Kind bekommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96c279ea-8835-4c26-96a4-704cda602a1b",
                                "sense_id": "3af3b2ab-40af-301d-aa91-712ea0204c39",
                                "text": "Tatjana bekam ihren Sohn mit 39 und war damit eine Spätgebärende."
                            },
                            {
                                "example_id": "0fed1c0b-8862-444d-8298-0a8ad7f88df3",
                                "sense_id": "3af3b2ab-40af-301d-aa91-712ea0204c39",
                                "text": "Nachdem sie schon mit 17 Mutter eines Zwillingspaares geworden war, bekam Vroni ihr drittes Kind als Spätgebärende kurz vor ihrem 41. Geburtstag."
                            }
                        ],
