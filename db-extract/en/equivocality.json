                "senses": [
                    {
                        "sense_id": "5f8ed0d8-c684-3720-9c7b-23d66c0f5c1d",
                        "entry_id": "17005ff3-9868-33ac-86fc-ac5cc114c27b",
                        "glosses": [
                            "The quality of being equivocal."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3111c639-0636-4ee9-b78c-05fcc580b18f",
                                "sense_id": "5f8ed0d8-c684-3720-9c7b-23d66c0f5c1d",
                                "text": "The military lent a new context to Mr. Widmark’s moral equivocality: in films like “Halls of Montezuma,” “The Frogmen,” “Take the High Ground!” and “Destination Gobi” Mr. Widmark played hard-bitten commanders whose apparent coldness and cruelty masked a deeper concern with the safety of their men."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5ddc39db-774e-44aa-a5c4-3e33748606b3",
                        "source_entry_id": "17005ff3-9868-33ac-86fc-ac5cc114c27b",
                        "source_sense_id": "5f8ed0d8-c684-3720-9c7b-23d66c0f5c1d",
                        "source_sense_description": "quality of being equivocal",
                        "target_lang_word": "Doppeldeutigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Doppeldeutigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "390e483f-e76c-3be8-992e-c521b0f6394e",
                                        "entry_id": "2721a63b-01b9-3289-8c29-35a83cedf408",
                                        "glosses": [
                                            "Zustand, der zwei Deutungen beziehungsweise zwei Arten der Interpretation zulässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f44ec56a-fa7e-408a-a2c0-c0451947ae84",
                                                "sense_id": "390e483f-e76c-3be8-992e-c521b0f6394e",
                                                "text": "Die Doppeldeutigkeit seiner Aussage fiel ihm erst im Nachhinein auf."
                                            },
                                            {
                                                "example_id": "07a27c0e-d22b-4b6b-9ddf-6d6f160f962d",
                                                "sense_id": "390e483f-e76c-3be8-992e-c521b0f6394e",
                                                "text": "„Solche Definitionen meinen vor allem den Wortwitz, der sich an der Doppeldeutigkeit von Worten entzündet, und zwar vor allem dann, wenn die Sinnbereiche eines und desselben Wortes möglichst weit voneinander entfernt liegen.“"
                                            },
                                            {
                                                "example_id": "58df39a9-c253-41b6-a920-5db221d36c9a",
                                                "sense_id": "390e483f-e76c-3be8-992e-c521b0f6394e",
                                                "text": "„Das Spiel mit der Doppeldeutigkeit von Wörtern funktionierte gerade im Themenbereich der wirtschaftlichen Versorgung gut.“"
                                            },
                                            {
                                                "example_id": "47e080fd-69f2-4503-a2f4-6ff7efc1b4e6",
                                                "sense_id": "390e483f-e76c-3be8-992e-c521b0f6394e",
                                                "text": "„Es war nicht der Schatten von Doppeldeutigkeit in ihrem Gesicht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "714493f9-1b89-4011-9fb8-c6eba75884fa",
                        "source_entry_id": "17005ff3-9868-33ac-86fc-ac5cc114c27b",
                        "source_sense_id": "5f8ed0d8-c684-3720-9c7b-23d66c0f5c1d",
                        "source_sense_description": "quality of being equivocal",
                        "target_lang_word": "Doppelsinn",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
