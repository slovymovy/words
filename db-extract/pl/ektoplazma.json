                        "cross_references": [
                            {
                                "target_word": "ectoplasma",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "03a3927d-de05-3a93-a9b4-b503883a67ee",
                                        "entry_id": "d04e6dbb-298a-3049-92df-aa05786482ef",
                                        "glosses": [
                                            "Región periférica de la célula, la cual carece de orgánulos y es de mayor densidad que el endoplasma."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7bb9ab98-0a88-39df-8954-ecb8b687465e",
                                        "entry_id": "d04e6dbb-298a-3049-92df-aa05786482ef",
                                        "glosses": [
                                            "Supuesta sustancia material emanada de un medium durante un trance."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "1ea866a9-dbea-332a-be2e-0d35fb6bc33a",
                                        "entry_id": "d04e6dbb-298a-3049-92df-aa05786482ef",
                                        "glosses": [
                                            "Supuesta sustancia visible pero etérea que manifiesta la presencia de un espíritu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9db5438a-1282-49ee-9616-75ac143f2d68",
                                                "sense_id": "1ea866a9-dbea-332a-be2e-0d35fb6bc33a",
                                                "text": "OCTAVIO.― No tiene forma ni consistencia ni expresión. Es ectoplasma y nada más.\nLEOPOLDO.― ¿Y en ese amor de ectoplasma está la felicidad?\nOCTAVIO.― Es mucho más fácil enamorarme de un fantasma."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9ff03bbf-5997-45e4-9a3e-43bd0633bc27",
                        "source_entry_id": "558486c1-0856-3384-98d4-d9c23ff34bc7",
                        "source_sense_id": "00fa779a-9bd7-3aab-97cc-202a8dd701e4",
