                                        "entry_id": "ff3c5b3d-a391-34e2-919b-d67ed213f296",
                                        "glosses": [
                                            "Corps capable de réaliser l’adsorption."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "78a6c65a-dfa1-4e91-96bf-eb0178607225",
                                                "sense_id": "cba8edb7-bf76-3126-be81-02617101a567",
                                                "text": "Le prélèvement s’effectue par préconcentration sur adsorbant solide. Après thermodésorption, l’analyse est effectuée par chromatographie en phase gazeuse."
                                            },
                                            {
                                                "example_id": "115a06d3-7703-4da5-a55f-246babf7a8ac",
                                                "sense_id": "cba8edb7-bf76-3126-be81-02617101a567",
                                                "text": "Le gel de silice est l’adsorbant le plus fréquemment utilisé en chromatographie sur colonne, à basse, moyenne ou haute pression."
                                            }
                                        ]
                                    }
