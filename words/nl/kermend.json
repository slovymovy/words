{
    "word_family": [
        "kermen",
        "gekerm"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "74fa08c5-4866-317e-ba8b-b8bc1f25d331",
                    "sense_definition": "geluiden van pijn, smart of verdriet uitstotend",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "geluid_van_pijn",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verpleegkundige ontfermde zich snel over het <w>kermende</w> kind.",
                            "target_lang_translations": {
                                "pl": "Pielęgniarka szybko zaopiekowała się <w>jęczącym</w> dzieckiem."
                            }
                        },
                        {
                            "text": "Na de zware botsing lag het slachtoffer <w>kermend</w> op het asfalt.",
                            "target_lang_translations": {
                                "pl": "Po silnym zderzeniu ofiara leżała na asfalcie, <w>jęcząc</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "jammerend",
                        "kreunend",
                        "lamenterend"
                    ],
                    "common_phrases": [
                        "kermend van de pijn"
                    ],
                    "target_lang_definitions": {
                        "pl": "wydający ciche dźwięki z bólu, cierpienia lub smutku; jęczący"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jęczący",
                                "target_lang_sense_clarification": "wydający jęki z bólu"
                            },
                            {
                                "target_lang_word": "skamlący",
                                "target_lang_sense_clarification": "żałośnie jęczący, popłakujący"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0b11c7d3-8101-3621-9136-903cd5082b1f",
                    "sense_definition": "onvoltooid deelwoord van <w>kermen</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "deelwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij strompelde <w>kermend</w> naar de dichtstbijzijnde uitgang.",
                            "target_lang_translations": {
                                "pl": "Poczłapał, <w>jęcząc</w>, do najbliższego wyjścia."
                            }
                        },
                        {
                            "text": "De gewonde man lag zacht <w>kermend</w> te wachten op medische hulp.",
                            "target_lang_translations": {
                                "pl": "Ranny mężczyzna leżał, cicho <w>jęcząc</w> i czekając na pomoc medyczną."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "imiesłów przysłówkowy współczesny od czasownika kermen (jęczeć)"
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jęcząc",
                                "target_lang_sense_clarification": "podczas wydawania jęków"
                            },
                            {
                                "target_lang_word": "stękając",
                                "target_lang_sense_clarification": "wydając odgłosy wysiłku lub bólu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}