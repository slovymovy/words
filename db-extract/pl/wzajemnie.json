                                "sense_id": "d12fd762-5180-3c76-a46d-ed6b14143f92",
                                "text": "– Życzę ci wszystkiego dobrego. – I wzajemnie."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
