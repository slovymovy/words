                        "examples": [
                            {
                                "example_id": "c9cb0697-944a-4bee-8446-df83f9c41bf7",
                                "sense_id": "8eced7ee-035d-3ffe-8cd2-6d1355b0820e",
                                "text": "Ça m’turlubustait, ton histoire !"
                            },
                            {
                                "example_id": "66b6c9ab-31f3-4218-afb7-ff659faf1fc8",
                                "sense_id": "8eced7ee-035d-3ffe-8cd2-6d1355b0820e",
                                "text": "Je viens de recevoir un chargeur standard MP5 Marui pour ma Cyma et une question me turlubuste..."
                            },
                            {
                                "example_id": "f38fe18c-0117-4aa9-a57c-134653980327",
                                "sense_id": "8eced7ee-035d-3ffe-8cd2-6d1355b0820e",
                                "text": "Enfin, une question brûlante me turlubuste (verbe que j'affectionne et qui n'est autre que le fruit des amours coupables et consommées de \"turlupiner\" et tarabuster\")."
                            },
                            {
                                "example_id": "28e0c35c-32b2-4966-8af0-d20cdf238659",
                                "sense_id": "8eced7ee-035d-3ffe-8cd2-6d1355b0820e",
                                "text": "Cette question me tarapine... euh... me turlubuste... enfin, vous voyez."
                            }
                        ]
                    }
