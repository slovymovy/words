                    },
                    {
                        "translation_id": "4ec49f79-a32b-410d-8a5e-69aa172afa29",
                        "source_entry_id": "06c34173-cd4b-357d-9398-0f2e705c1468",
                        "source_sense_id": "11801f02-98f5-3021-8b17-be050f9dbad7",
                        "source_sense_description": "katholische Kirche: feierliche Form der Eucharistiefeier (Missa solemnis)",
                        "target_lang_word": "grand-messe",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grand-messe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8347e0c1-b4d6-3602-b760-b61e9a4c79fa",
                                        "entry_id": "236f00d3-f304-3109-86de-054cb4c87955",
                                        "glosses": [
                                            "Messe chantée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b9caa9c-af01-4a66-ad75-c8e9fe877e7b",
                                                "sense_id": "8347e0c1-b4d6-3602-b760-b61e9a4c79fa",
                                                "text": "C’est moi qui conduisais Catherine à la grand-messe et aux vêpres, et, pendant la fête, elle ne quittait pas mon bras et refusait de danser avec les autres garçons du village."
                                            },
                                            {
                                                "example_id": "dec49371-93e2-4b12-a5e9-7dc255210807",
                                                "sense_id": "8347e0c1-b4d6-3602-b760-b61e9a4c79fa",
                                                "text": "— François Paradis n’avait quasiment pas de famille : alors comme nous avions tous de l’amitié pour lui, on pourrait peut-être faire dire une messe ou deux… Eh, Laura ?\n— Sûrement. Trois grand-messes avec chant ; et quand les garçons reviendront du bois, en bonne santé s’il plaît au bon Dieu, trois autres pour le repos de son âme, pauvre garçon ! Et tous les dimanches nous dirons un chapelet pour lui."
                                            },
                                            {
                                                "example_id": "c4c95dea-5800-45ba-8b02-660966a782fe",
                                                "sense_id": "8347e0c1-b4d6-3602-b760-b61e9a4c79fa",
                                                "text": "Quelle vie ont eu nos grand-parents\n Entre l’absinthe et les grand-messes\n Ils étaient vieux avant que d’être."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "429eb936-b749-35c1-9c82-af1a8595f6da",
                                        "entry_id": "236f00d3-f304-3109-86de-054cb4c87955",
                                        "glosses": [
                                            "Grand rassemblement autour d’un thème."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8370ffff-1d94-496f-ab0a-3275408f7989",
                                                "sense_id": "429eb936-b749-35c1-9c82-af1a8595f6da",
                                                "text": "La seconde édition du Paris Games Week, grand-messe française du jeu vidéo, ouvre ses portes ce vendredi 21 octobre à la Porte de Versailles à Paris."
                                            },
                                            {
                                                "example_id": "f203627e-7a83-46b9-a90e-b26845e84c05",
                                                "sense_id": "429eb936-b749-35c1-9c82-af1a8595f6da",
                                                "text": "D’aucuns voient dans cette perte d’influence des grand-messes automobiles un signe des transformations de la société."
                                            },
                                            {
                                                "example_id": "d5fb0f61-f697-4a43-a002-d171d06b3afd",
                                                "sense_id": "429eb936-b749-35c1-9c82-af1a8595f6da",
                                                "text": "François Legault lui-même répète qu’il se méfie de ces grand-messes : « Des chantiers, des commissions partisanes, des comités, des forums, des sommets, mais rien de concret », a-t-il déjà résumé en point de presse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
