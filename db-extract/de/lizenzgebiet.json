                "senses": [
                    {
                        "sense_id": "a43c021d-5418-3b77-90b7-6c2fb64984e2",
                        "entry_id": "41bdbbc2-884c-3352-a23b-4f506becb333",
                        "glosses": [
                            "dasjenige geografische Areal (Gebiet) in dem laut Vertrag/Lizenzvertrag eine bestimmte Zulassung (Lizenz) gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1de1cbd9-2a38-41b0-98e4-a98c4ff5667c",
                                "sense_id": "a43c021d-5418-3b77-90b7-6c2fb64984e2",
                                "text": "„Ob der Lizenzgeber, wie dies § 178 Abs. 1 GIW fordert, das Lizenzobjekt zum Zeitpunkt des Vertragsabschlusses frei von Rechten Dritter im Lizenzgebiet zu überlassen hat, sollte zweckmäßigerweise im Vertrag vereinbart werden.“"
                            },
                            {
                                "example_id": "c844ffb6-f27d-4b18-b480-377936d92fc2",
                                "sense_id": "a43c021d-5418-3b77-90b7-6c2fb64984e2",
                                "text": "„Dies führt im Ergebnis dazu, dass ein Lizenznehmer, der lediglich die Rechte für das Gebiet der Bundesrepublik Deutschland erworben hat, die Rechte Dritter verletzt, wenn diese auch außerhalb des Lizenzgebietes abrufbar sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
