                    {
                        "sense_id": "4c5b1840-d6c1-37c6-962e-a4919935b781",
                        "entry_id": "b20b8a02-a539-32aa-9d78-1ffc1eb37969",
                        "glosses": [
                            "Sachverständige, Fachfrau, die für ein Amt schriftlich oder mündlich eine Situation beurteilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0478002b-3fcc-483b-b8d4-f99945f9da3b",
                                "sense_id": "4c5b1840-d6c1-37c6-962e-a4919935b781",
                                "text": "Die Gutachterin beurteilte die Gefahr nicht ausreichend ernst."
                            },
                            {
                                "example_id": "a80a9e04-58a7-4321-b441-b1011f1b76cc",
                                "sense_id": "4c5b1840-d6c1-37c6-962e-a4919935b781",
                                "text": "„Die Gutachterin hält die Einsichtsfähigkeit der Patientin G. für erheblich vermindert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
