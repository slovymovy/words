            "senses": [
                {
                    "sense_id": "5d9abf21-37ee-30a2-8b5d-8f7b0335934a",
                    "sense_definition": "een traditioneel schoeisel dat volledig of gedeeltelijk van hout is gemaakt",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "schoeisel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De boer loopt de hele dag op houten <w>klompen</w> terwijl hij op het land werkt.",
                            "target_lang_translations": {
                                "en": "The farmer walks on wooden <w>clogs</w> all day while working on the land."
                            }
                        },
                        {
                            "text": "In veel toeristische winkels kun je een paar <w>klompen</w> als souvenir kopen.",
                            "target_lang_translations": {
                                "en": "In many tourist shops, you can buy a pair of <w>clogs</w> as a souvenir."
                            }
                        }
                    ],
                    "synonyms": [
                        "houten schoen"
                    ],
                    "common_phrases": [
                        "houten klompen",
                        "een paar klompen"
                    ],
                    "target_lang_definitions": {
                        "en": "a traditional type of footwear made entirely or partially of wood"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clog",
                                "target_lang_sense_clarification": "a shoe with a wooden sole"
                            },
                            {
                                "target_lang_word": "wooden shoe",
                                "target_lang_sense_clarification": "footwear made of wood"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc32a9d3-4827-371b-86d7-301dd35b3aef",
                    "sense_definition": "een onregelmatige, vaste massa of een vormeloze hoeveelheid van een bepaalde stof",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "massa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De goudzoeker was dolblij toen hij een grote <w>klomp</w> goud in de rivier vond.",
                            "target_lang_translations": {
                                "en": "The gold prospector was overjoyed when he found a large <w>nugget</w> of gold in the river."
                            }
                        },
                        {
                            "text": "Zij deed een kleine <w>klomp</w> boter in de pan om de groenten te bakken.",
                            "target_lang_translations": {
                                "en": "She put a small <w>lump</w> of butter in the pan to sauté the vegetables."
                            }
                        }
                    ],
                    "synonyms": [
                        "homp",
                        "klont",
                        "massa",
                        "brok"
                    ],
                    "common_phrases": [
                        "klomp goud",
                        "klomp boter"
                    ],
                    "target_lang_definitions": {
                        "en": "an irregular, solid mass or a shapeless quantity of a certain substance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "lump",
                                "target_lang_sense_clarification": "a mass of no particular shape"
                            },
                            {
                                "target_lang_word": "nugget",
                                "target_lang_sense_clarification": "a small solid lump, especially of gold"
                            },
                            {
                                "target_lang_word": "chunk",
                                "target_lang_sense_clarification": "a thick, irregular piece"
                            },
                            {
                                "target_lang_word": "clod",
                                "target_lang_sense_clarification": "a lump of earth or clay"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25491bfb-2ec8-38a8-8f50-7af29d9eed7f",
                    "sense_definition": "beschermend schoeisel van hard materiaal dat door hockeykeepers wordt gedragen om de voeten te beschermen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sportuitrusting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De keeper trok zijn <w>klompen</w> aan voordat hij het hockeyveld opging voor de wedstrijd.",
                            "target_lang_translations": {
                                "en": "The goalkeeper put on his <w>kickers</w> before heading onto the hockey field for the match."
                            }
                        },
                        {
                            "text": "Zonder stevige <w>klompen</w> is het gevaarlijk om als doelman de harde ballen te stoppen.",
                            "target_lang_translations": {
                                "en": "Without sturdy <w>kickers</w>, it is dangerous for a goalkeeper to stop the hard balls."
                            }
                        }
                    ],
                    "synonyms": [
                        "kicker"
                    ],
                    "common_phrases": [
                        "beschermende klompen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "specifiek gebruikt in de hockeysport"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "protective footwear made of hard material worn by field hockey goalkeepers to protect the feet"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kicker",
