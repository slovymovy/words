                ],
                "senses": [
                    {
                        "sense_id": "14bd429d-0247-3acf-94da-b87c55dbeecd",
                        "entry_id": "f883a6e7-b561-3b08-8b58-6ccd88d361c4",
                        "glosses": [
                            "eine Vogelart der Familie der Segler, durch besondere Flugfähigkeit ausgezeichnet, und der sich ausschließlich von Insekten ernährt, einen breiten, kurzen Schnabel und lange, spitze Flügel hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52d517c-0d2c-4af4-8096-64de57c60902",
                                "sense_id": "14bd429d-0247-3acf-94da-b87c55dbeecd",
                                "text": "Zu einem richtigen Sommer gehört das Kreischen der Mauersegler."
                            },
                            {
                                "example_id": "82e43553-5279-46ed-b572-30b06df08681",
                                "sense_id": "14bd429d-0247-3acf-94da-b87c55dbeecd",
                                "text": "Der Mauersegler hat besonders stark entwickelte Speicheldrüsen, deren Absonderungen beim Bauen des Nestes verwandt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
