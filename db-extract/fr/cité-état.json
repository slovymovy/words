        "fr-extract.jsonl": [
            {
                "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                "word": "cité-État",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "29846d78-5667-466a-88a9-29352c597918",
                        "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                        "tags": [
                            "plural"
                        ],
                        "form": "cités-États"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                        "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                        "glosses": [
                            "Espace géographique contrôlé exclusivement par une ville, qui possède généralement la souveraineté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99df7191-4d14-4a29-a4b0-32a43285d8b5",
                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                "text": "Singapour, cité-État, en troisième position de l’Indice mondial de l’innovation pour la deuxième année consécutive."
                            },
                            {
                                "example_id": "08b6f0f5-dd7b-475b-854c-e1bb28e44f19",
                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                "text": "Athènes, Sparte et Thèbes étaient les trois plus puissantes cités-États de la Grèce antique."
                            },
                            {
                                "example_id": "4082d1f9-8a30-4dcd-b8c3-da870441922c",
                                "sense_id": "e095b850-ce62-3dd2-a6f6-4c7e2cb7339b",
                                "text": "Il a vu la République romaine, vieille cité-État inadaptée à l'immensité de ses conquêtes, vaciller et s'effondrer."
                            }
                        ]
                    },
                    {
                        "sense_id": "87a5523d-b417-3149-8ea5-63bd8bb3747b",
                        "entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                        "glosses": [
                            "Ville allemande qui constitue un land à elle seule."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4688ffd-aaa5-4e6f-9d40-61dcb8197764",
                                "sense_id": "87a5523d-b417-3149-8ea5-63bd8bb3747b",
                                "text": "Berlin, Hambourg et Brême sont les trois cités-États allemandes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7364673a-f18b-4261-8a52-0e5de934a84d",
                        "source_entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
                        "target_lang_word": "Stadtstaat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stadtstaat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                        "entry_id": "b55aa9d6-68b4-3f04-90ba-73094b3ac3d8",
                                        "glosses": [
                                            "ein Staat, der nur das Gebiet einer Stadt (und je nach Festlegung der Grenzen sein engeres Umland) umfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a80cca57-e79d-4b60-bf30-a5cc6d641236",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Ein typischer Stadtstaat war Venedig."
                                            },
                                            {
                                                "example_id": "bfb5cc74-7e2c-4bd7-a507-1e7dd61fce51",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Singapur ist ein moderner Stadtstaat."
                                            },
                                            {
                                                "example_id": "7e25f394-fe42-43e3-a497-4dca470eceb1",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Der Stadtstaat Bremen steht durch den geplanten Länderfinanzausgleich vor der Pleite."
                                            },
                                            {
                                                "example_id": "f97f8fb0-83b8-4cfd-9fed-1c296c3a56ba",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Unter den deutschen Stadtstaaten scheint es beliebt zu sein, in kontroversen Fragen gesetzliche Vorstöße auf Landesebene zu unternehmen."
                                            },
                                            {
                                                "example_id": "c485a832-2299-4811-ba36-065908c0f241",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "Die Besonderheiten beginnen damit, dass Bremen genau genommen kein Stadtstaat ist, sondern ein \"Zwei-Städte-Staat\". Dieser besteht aus zwei eigenständigen Städten - Bremen und Bremerhaven."
                                            },
                                            {
                                                "example_id": "8daeff09-4ca1-4346-a220-c774c28f6fc3",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "„Später war es abwechselnd unter der Hoheit der Byzantiner, Karolinger und Venezianer, bis es sich als teilsouveräner Stadtstaat der Habsburgermonarchie anschloss.“"
                                            },
                                            {
                                                "example_id": "4dec33a3-ae0d-4106-84e1-aa3dc474613e",
                                                "sense_id": "9563ff66-fc5d-3ede-8f66-b8fca9dc22ab",
                                                "text": "„Frauen und Sklaven hatten in der Polis, dem griechischen Stadtstaat, nichts zu melden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "87cc1cfd-26b6-4f8b-ad47-24ffa45205e5",
                        "source_entry_id": "f7fcce17-583b-32ad-bbe9-95c78c4c005a",
