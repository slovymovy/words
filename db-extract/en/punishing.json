                "senses": [
                    {
                        "sense_id": "bc086701-f6f9-3424-b571-770f9e6577d2",
                        "entry_id": "f0df5939-b06a-3d63-95ce-910967911c3f",
                        "glosses": [
                            "That punishes physically and/or mentally; arduous, gruelling, demanding."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34b2040d-811d-4bae-93d7-6ab20c754050",
                                "sense_id": "bc086701-f6f9-3424-b571-770f9e6577d2",
                                "text": "Upon Amelia's return from the West Coast in October, George presented her with a punishing schedule of lectures and appointments to promote the new book and solidify her position as America's foremost woman aviator."
                            },
                            {
                                "example_id": "6970de95-f8d7-46af-9a17-55289f54ca80",
                                "sense_id": "bc086701-f6f9-3424-b571-770f9e6577d2",
                                "text": "Regardless of the punishing heat and physicality, restaurant cooking is a calling many Chinese chefs cannot deny."
                            },
                            {
                                "example_id": "a00e3d6d-27e5-4f76-8016-e68c290f8d56",
                                "sense_id": "bc086701-f6f9-3424-b571-770f9e6577d2",
                                "text": "They took off at a punishing speed, making London in less than half a day."
                            }
                        ]
                    },
                    {
                        "sense_id": "4f93e992-bf40-3a81-af82-88444e813452",
                        "entry_id": "f0df5939-b06a-3d63-95ce-910967911c3f",
                        "glosses": [
                            "Debilitating, harsh."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "4ca3bf25-1e5f-4388-90f1-1b0f364136cf",
                                "sense_id": "4f93e992-bf40-3a81-af82-88444e813452",
                                "text": "1999, Edward Gonzalez, Richard Nuccio, Rand Corporation. National Security Research Division, The Rand Forum on Cuba, Rand Corp\nOthers argued that the worst of all outcomes after 40 years of a punishing embargo would be for the United States to adopt policies that might extend the life of a dictatorial regime."
                            },
                            {
                                "example_id": "9a718c0b-97d2-4de6-9fb3-b042137bddf5",
                                "sense_id": "4f93e992-bf40-3a81-af82-88444e813452",
                                "text": "Public debt of this magnitude can provoke punishing tax rates and crowd out private investment."
                            },
                            {
                                "example_id": "41e5a4aa-4eb1-470d-9347-9acbb3f31992",
                                "sense_id": "4f93e992-bf40-3a81-af82-88444e813452",
                                "text": "The apparent punishing effect of naloxone may be mediated through the withdrawal reaction that it produces[.]"
                            },
                            {
                                "example_id": "e7f3d96a-077b-4526-8cbf-55be2441e074",
                                "sense_id": "4f93e992-bf40-3a81-af82-88444e813452",
                                "text": "a punishing blow"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
