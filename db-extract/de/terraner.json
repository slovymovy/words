                "senses": [
                    {
                        "sense_id": "d76fb181-97c2-3bf6-a471-564acf8bab8f",
                        "entry_id": "2e6b4513-f2d4-3df3-a155-554216cea20a",
                        "glosses": [
                            "Bewohner des Planeten Erde (Terra) oder von ihm Stammender"
                        ],
                        "tags": [
                            "Science-Fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "f10a87a0-4378-4150-9a54-c97a7f91bc56",
                                "sense_id": "d76fb181-97c2-3bf6-a471-564acf8bab8f",
                                "text": "„StarCraft 2 führt die Saga der Protoss, Terraner und Zerg fort und knüpft am Ende von StarCraft: Brood War an.“"
                            },
                            {
                                "example_id": "7f9fb60d-8174-4926-b1a1-c44e4fabf4ac",
                                "sense_id": "d76fb181-97c2-3bf6-a471-564acf8bab8f",
                                "text": "„Aber auch ihre Fähigkeiten grenzen nicht ans Wunderbare: Terraner und Terlogs sind insgesamt ebenbürtige Gegner.“"
                            },
                            {
                                "example_id": "a955109b-a2f7-414e-a0c8-70eb84c71cb3",
                                "sense_id": "d76fb181-97c2-3bf6-a471-564acf8bab8f",
                                "text": "„Die Frage spiegelt die ambivalenten Gefühle des Terraners, die er im Angesicht der geheimnisreichen Unendlichkeiten des Kosmos empfindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
