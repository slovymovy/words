                                "example_id": "d2c16877-aeb9-4549-b946-adeb790a9930",
                                "sense_id": "e745fbce-f844-3eb6-92f5-c499278e57d2",
                                "text": "„Wir stolperten über Eisenbahnschienen weg.“"
                            },
                            {
                                "example_id": "989a3b19-7d9e-457e-b4b7-703ae1081db5",
                                "sense_id": "e745fbce-f844-3eb6-92f5-c499278e57d2",
                                "text": "„Telegraphenleitungen wurden zerschnitten, Eisenbahnschienen abgeschraubt, Polizeistationen gestürmt und die Kongressfahne gehisst.“"
                            },
                            {
                                "example_id": "22f708bf-a827-4654-b44e-f4d9893df47b",
                                "sense_id": "e745fbce-f844-3eb6-92f5-c499278e57d2",
                                "text": "„Der Ford holperte über Eisenbahnschienen und -schwellen und hielt zuletzt an der finsteren Mole A.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
