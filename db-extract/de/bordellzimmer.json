                "senses": [
                    {
                        "sense_id": "e0dac6ce-9bd8-3920-8a4f-5131ba62524a",
                        "entry_id": "61806695-dee3-3f71-91b2-8159e955db46",
                        "glosses": [
                            "Zimmer in einem Bordell, in dem Besucher bedient werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1eb130f0-af96-4b18-b545-e2ec2db941ed",
                                "sense_id": "e0dac6ce-9bd8-3920-8a4f-5131ba62524a",
                                "text": "„Gewiss führte ich mich bereits ein paar Grade weniger eckig und hilflos auf als im Bordellzimmer Nummer 37.“"
                            },
                            {
                                "example_id": "57f592f8-c94d-4553-91a5-221c63c2a186",
                                "sense_id": "e0dac6ce-9bd8-3920-8a4f-5131ba62524a",
                                "text": "„Sie arbeiten 18 Stunden am Tag und schicken 500 Euro nach Hause an ihre Familie. In Deutschland müssen sie ihr Bordellzimmer bezahlen und ihren Zuhälter aushalten.“"
                            },
                            {
                                "example_id": "f0497017-95d5-4590-a887-df505d089ff7",
                                "sense_id": "e0dac6ce-9bd8-3920-8a4f-5131ba62524a",
                                "text": "„Eine versteckte Videokamera in einem Bordellzimmer. ‚Da hab ich mir nichts dabei gedacht‘, sagt der Geschäftsführer. Die Polizei allerdings denkt sich so einiges: Sie verdächtigt den Betreiber des Etablissements am Stahlgruberring, mit der Kamera kontrollieren zu wollen, wie es die Damen mit der Benutzung von Kondomen halten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
