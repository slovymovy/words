                    {
                        "sense_id": "01b6c402-9e6d-375a-95a7-6935d2c4d8ab",
                        "entry_id": "6e8c2f20-9c2e-369b-966c-faf0be279c16",
                        "glosses": [
                            "Frisur im Intimbereich, speziell der Schamhaare"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a21628fb-af2f-45ad-a7d1-2ed6ec192d5d",
                                "sense_id": "01b6c402-9e6d-375a-95a7-6935d2c4d8ab",
                                "text": "„Begriffe wie »Brazilian Hollywood Cut« (eine Komplettentfernung der Schambehaarung) oder »Brazilian Landing Strip« (eine Intimfrisur, bei der nur ein schmaler Streifen auf dem Schambein stehen bleibt) sind ebenso Teil des Vokabulars junger Erwachsener wie früher die »Vokuhila«-Frisur (vorne kurz, hinten lang) für das Schopfhaar.“"
                            }
                        ],
