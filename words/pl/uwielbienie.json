                    "sense_definition": "głęboki zachwyt, miłość, bezgraniczny szacunek lub cześć okazywana komuś lub czemuś",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uczucie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W jego oczach widać było nieskrywane <w>uwielbienie</w> dla utalentowanej artystki.",
                            "target_lang_translations": {
                                "en": "In his eyes, one could see undisguised <w>adoration</w> for the talented artist."
                            }
                        },
                        {
                            "text": "Młody poeta darzył swoją muzę niemal religijnym <w>uwielbieniem</w>.",
                            "target_lang_translations": {
                                "en": "The young poet treated his muse with almost religious <w>worship</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "adoracja",
                        "podziw",
                        "zachwyt",
                        "cześć"
                    ],
                    "antonyms": [
