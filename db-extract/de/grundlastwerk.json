                "senses": [
                    {
                        "sense_id": "7b1423a6-2f61-38fb-a893-eaca14c33929",
                        "entry_id": "b2518651-0089-3b57-b4f5-50c9d85cbd4e",
                        "glosses": [
                            "Kraftwerk, das mit gleichbleibender Leistung den Grundbedarf in einem Verbundnetz deckt und 24 Stunden am Tag in Betrieb ist"
                        ],
                        "tags": [
                            "Energiewirtschaft",
                            "Energietechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "6f0b3c82-2c3a-4121-89b7-710afac0f0c8",
                                "sense_id": "7b1423a6-2f61-38fb-a893-eaca14c33929",
                                "text": "Als Grundlastwerke werden unter anderem Kernkraft- oder Wasserkraftwerke eingesetzt."
                            },
                            {
                                "example_id": "d61c7dc8-bb9a-4c50-89a1-7bc78ad56d54",
                                "sense_id": "7b1423a6-2f61-38fb-a893-eaca14c33929",
                                "text": "„Obwohl als Grundlastwerk ausgelegt, sollte die Anlage auch im Bedarfsfall zur Deckung von Lastspitzen herangezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
