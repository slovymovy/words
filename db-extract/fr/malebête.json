                    {
                        "sense_id": "c5e30f2d-19a3-3135-84f2-f1698bd9d969",
                        "entry_id": "8e6100ec-c40d-32d6-893f-99ef4fb025ae",
                        "glosses": [
                            "Personne malveillante, dangereuse."
                        ],
                        "tags": [
                            "dated",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "7fb57542-ccf8-48f2-97b4-7036e718f1cc",
                                "sense_id": "c5e30f2d-19a3-3135-84f2-f1698bd9d969",
                                "text": "Hélas ! L’écho de nos succès arriva jusqu’aux oreilles du colonel. La malebête, exaspérée à l’idée que les prisonniers pouvaient se distraire, fut prise d’un accès de fureur et nous interdit de continuer."
                            },
                            {
                                "example_id": "99b91670-ce30-4c81-900c-d92f5b999e21",
                                "sense_id": "c5e30f2d-19a3-3135-84f2-f1698bd9d969",
                                "text": "1466/1475 – Noble Jean de Tardes, en même temps châtelain de Peyrepertuse. 1475 – Pierre Peur dit Malebête, destitué. 1475/1484 – Guillaume Baille, damoiseau, suspendu de sa charge en 1484..."
                            }
                        ]
                    },
                    {
                        "sense_id": "119c992d-4f53-357d-92d0-4e55d4131c7b",
                        "entry_id": "8e6100ec-c40d-32d6-893f-99ef4fb025ae",
                        "glosses": [
                            "Outil semblable à un marteau, qui sert au calfat à bourrer l'étoupe dans les interstices de la coque d'un navire en bois. On ecrit aussi malbête."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cf163277-754c-31b2-9e37-7e650281ca09",
                        "entry_id": "8e6100ec-c40d-32d6-893f-99ef4fb025ae",
                        "glosses": [
                            "Monstre fabuleux qui selon une légende terrorisait les habitants de Toulouse."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "1464d933-3f92-3025-b501-11ed7d4b0451",
                        "entry_id": "8e6100ec-c40d-32d6-893f-99ef4fb025ae",
                        "glosses": [
                            "Toute sorte de monstre. Le mot est couramment utilisé dans des romans fantastiques pour évoquer des monstres qui hanteraient les campagnes profondes."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "77f95743-259e-448a-8244-d77244a25c59",
                                "sense_id": "1464d933-3f92-3025-b501-11ed7d4b0451",
                                "text": "Ce cabaret lui semblait le repaire de la malebête."
                            },
                            {
                                "example_id": "e39d9fb1-e061-45a1-9461-453053e2706c",
                                "sense_id": "1464d933-3f92-3025-b501-11ed7d4b0451",
                                "text": "Redécouvrant le chien noir, le loup-cerve ou la malebête qui terrorisaient nos aïeux, nous redécouvrons aussi quelle a été leur vie."
                            },
                            {
                                "example_id": "43b9ea60-db8e-44bc-9e1b-36b359e03327",
                                "sense_id": "1464d933-3f92-3025-b501-11ed7d4b0451",
                                "text": "Tandis qu'ils cherchent des traces de Ruppert, leur compagnon disparu, ils entendent parler de la malebête, une créature de cauchemar qui occis et dévore ses victimes sans répis."
                            }
                        ]
                    }
