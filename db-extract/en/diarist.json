                                        "glosses": [
                                            "Person, die ein Tagebuch führt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "780e221b-5ebb-4a8a-948f-6a63c2986e2c",
                                                "sense_id": "a80cbe3c-0b27-3db5-8dbf-c090bab6ad24",
                                                "text": "„Jeder Tagebuchschreiber erfindet einen.“"
                                            },
                                            {
                                                "example_id": "ca29e2d3-dbe8-44b2-9379-5a29c1547712",
                                                "sense_id": "a80cbe3c-0b27-3db5-8dbf-c090bab6ad24",
                                                "text": "„Ein nervöser Verliebter und ein sich selbst in dieser Beziehung sehr klar beobachtender Tagebuchschreiber ist er in all diesen Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "71f514a4-d422-4863-b488-c5a04656006a",
