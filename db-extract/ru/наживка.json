                    {
                        "form_id": "e247694f-04aa-46c7-a168-79082c0e6762",
                        "entry_id": "92498dc6-2f99-33ef-9b48-21843c6890f5",
                        "tags": [
                            "plural",
                            "prepositional"
                        ],
                        "form": "нажи́вках"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "efc14ca0-1552-310e-91a6-d47faecda191",
                        "entry_id": "92498dc6-2f99-33ef-9b48-21843c6890f5",
                        "glosses": [
                            "действие по значению гл. наживлять"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e95b3822-0270-4468-a83b-b558a972adf9",
                                "sense_id": "efc14ca0-1552-310e-91a6-d47faecda191",
                                "text": "Хвост, плавники, жабры ― всё сгодится на наживку."
                            }
                        ]
                    },
                    {
                        "sense_id": "7854963d-1c41-3e17-8a97-5b2bc08febd5",
                        "entry_id": "92498dc6-2f99-33ef-9b48-21843c6890f5",
                        "glosses": [
                            "результат такого действия; приманка для ловли рыбы, зверя, птиц (на удочку, в капкан, в западню)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77c572d7-d36b-40b0-b934-a943ba65720d",
                                "sense_id": "7854963d-1c41-3e17-8a97-5b2bc08febd5",
                                "text": "В воду опускают крюк с наживкой ― мясом."
                            },
                            {
                                "example_id": "4a1d0c90-b70d-4249-a58c-36094dadbaee",
                                "sense_id": "7854963d-1c41-3e17-8a97-5b2bc08febd5",
                                "text": "Кукша находит в глуши тайги ловушку, чаще всего капкан, съедает наживку ― кусочек мяса, рыбы, птичьей требухи."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1767c21-5653-4263-965a-87c20af67869",
                        "source_entry_id": "92498dc6-2f99-33ef-9b48-21843c6890f5",
                        "target_lang_word": "appât",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "appât",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2641e59d-c2e2-3a85-88cb-ff51630db745",
                                        "entry_id": "0fc5d306-1604-3f22-85eb-d8bb67b0b216",
                                        "glosses": [
                                            "Pâture qu’on met soit à des pièges, pour attirer des quadrupèdes ou des oiseaux, soit à des hameçons, pour pêcher des poissons."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dbba4029-9137-464c-b0bb-fc94782862fb",
                                                "sense_id": "2641e59d-c2e2-3a85-88cb-ff51630db745",
                                                "text": "On a inventé des pièges de formes variées dont on se sert pour prendre les rongeurs et les petits carnassiers en les amorçant à l'aide d’appâts appropriés au goût de chaque espèce."
                                            },
                                            {
                                                "example_id": "ae9799f8-d11d-402e-94c8-a56c5ecc0535",
                                                "sense_id": "2641e59d-c2e2-3a85-88cb-ff51630db745",
                                                "text": "Mais à peine y touche-t-elle que le piquet qui soutient la porte attiré par la petite corde qui tient lʼappât, venant à tomber, cette porte chargée de bois et conséquemment fort pesante lui tombe sur les reins et lʼécrase."
                                            },
                                            {
                                                "example_id": "0abd1c43-6a7a-44fe-bb93-ae7a1e2829d7",
                                                "sense_id": "2641e59d-c2e2-3a85-88cb-ff51630db745",
                                                "text": "Le brodifacoum et le flocoumafen, à 40 ppm dans les appâts, sont réservés aux professionnels de la dératisation; les appâts à 10 ppm de brodifacoum peuvent être vendus aux particuliers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                                        "entry_id": "0fc5d306-1604-3f22-85eb-d8bb67b0b216",
                                        "glosses": [
                                            "Procédé destiné à tromper, séduire, attirer."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b3ebc0d2-aa66-45a5-a516-42d65fbd49f7",
                                                "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                                                "text": "Attention, cette promesse n’est qu’un appât !"
                                            },
                                            {
                                                "example_id": "9b59a2d1-255c-4165-949f-34ea55456603",
                                                "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                                                "text": "Ce bon accueil, ces paroles obligeantes ne sont qu’un appât pour l’engager à faire ce que l’on souhaite de lui."
                                            },
                                            {
                                                "example_id": "b8907f33-0b81-482b-9ce7-40dcc49a9465",
                                                "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                                                "text": "Ce dernier prince s'était laissé séduire par l'appât de la gloire militaire, tout en voulant ménager la bourse de ses sujets."
                                            },
                                            {
                                                "example_id": "69f4e4e3-c940-416d-bb1b-031a8e47c445",
                                                "sense_id": "7bf51f61-3037-34bf-a1a7-dba0827daf5c",
                                                "text": "La volupté est l’appât le plus dangereux pour l'homme!. ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4785a3b-7be3-3ff4-aaa2-03d71ef20848",
                                        "entry_id": "0fc5d306-1604-3f22-85eb-d8bb67b0b216",
                                        "glosses": [
                                            "Caractéristique d’une personne qui suscite une attirance sexuelle."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c56437f5-4cc2-49da-a02b-e35ac47777f4",
                                                "sense_id": "a4785a3b-7be3-3ff4-aaa2-03d71ef20848",
                                                "text": "Il songeait souvent aux appâts d’Agathe, dont le parfum d’œillet le poursuivait, comme une arrière-pensée, quand il ouvrait une bouteille de vin français."
                                            },
                                            {
                                                "example_id": "04706b1c-86b1-4a9e-842e-6bc560b88fb8",
                                                "sense_id": "a4785a3b-7be3-3ff4-aaa2-03d71ef20848",
                                                "text": "[…] par derrière la lune est au soleil ; par devant les appâts masculins sont cachés du mieux possible."
                                            },
                                            {
                                                "example_id": "021163d6-d5d3-43e0-bb49-574907ad6db9",
                                                "sense_id": "a4785a3b-7be3-3ff4-aaa2-03d71ef20848",
                                                "text": "Marie, grandissant comme une diablesse, n’ignore rien des appâts masculins et en use fort tôt en se nourrissant de lectures licencieuses et de vie au grand air."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc6e40e6-456f-452e-bd80-cbb1de12c090",
                        "source_entry_id": "92498dc6-2f99-33ef-9b48-21843c6890f5",
                        "target_lang_word": "amorce",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amorce",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât fixé à l'hameçon d'une ligne de pêcheur, destiné à faire mordre le poisson."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "006d8d65-2c1f-4456-90de-c881d94f935e",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "Le blé est une amorce plus résistante que le chènevis."
                                            },
                                            {
                                                "example_id": "de8e1786-93fa-49e8-82d7-767738401dfb",
                                                "sense_id": "5c242085-5f17-3f32-aea3-5d7fa2af64dd",
                                                "text": "— Vois, mon frère, dit-il, les ruses de l’ennemi qui nous dévore ! Voilà les amorces avec lesquelles il pêche les âmes !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Matière explosive qui sert à enflammer la charge d’un canon, d’un fusil, d’une mine, etc."
                                        ],
                                        "tags": [
                                            "Pyrotechnie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b986293a-94d8-4d35-97b8-46a43856d28a",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "La voix claquait. Le vieux clignota comme si on lui eût tiré des amorces aux oreilles."
                                            },
                                            {
                                                "example_id": "8b239df1-c3a2-4088-a07e-35a103d28540",
                                                "sense_id": "7508269d-a420-30cb-9d3d-18519005f1a4",
                                                "text": "Ce sont, répondit un muletier, nos gens qui battent les buissons à la ronde, et brûlent des amorces pour amuser les brigands."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Appât, ce qui attire vers quelque chose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0679a8d3-60da-4416-913e-d30b2407581f",
                                                "sense_id": "e719e039-a96b-329f-a4c5-f8067a9b291e",
                                                "text": "La gloire a de puissantes amorces pour les grandes âmes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9058f56f-0717-370f-8728-82bf5b85b633",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Oligonucléotide qui, hybridé avec une matrice d'acide nucléique, permet à une polymérase de déclencher la synthèse du brin complémentaire."
                                        ],
                                        "tags": [
                                            "Biologie moléculaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e1c7362f-0f64-36e7-8c6f-eaf7fe454dce",
                                        "entry_id": "ae47b9a6-8d16-3cd0-940f-a92c2c63cf1e",
                                        "glosses": [
                                            "Partie de muraille non achevée et qui doit être continuée plus tard."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
