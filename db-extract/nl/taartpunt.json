                    {
                        "sense_id": "f99587fa-72cf-32cc-83a4-c1c0fe680bcf",
                        "entry_id": "ae5bfe34-a439-3ade-bcee-5255b3cb4d2e",
                        "glosses": [
                            "deel van een ronde taart die ontstaat door twee sneden vanuit het middelpunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "664d02a4-4b14-478e-acd5-cbaa886da334",
                                "sense_id": "f99587fa-72cf-32cc-83a4-c1c0fe680bcf",
                                "text": "Om de verspreiding van ziektes te voorkomen, moeten de jarige Joppen die de kaarsjes op een taart willen uitblazen zelf een stuk taart meenemen. Met de hele klas smullen van een taart is er niet meer bij. Voortaan moeten de kinderen het doen met aparte cupcakejes of taartpunten."
                            }
                        ]
                    },
                    {
                        "sense_id": "54132064-8eec-38c3-86d3-1b74dcd99645",
                        "entry_id": "ae5bfe34-a439-3ade-bcee-5255b3cb4d2e",
                        "glosses": [
                            "deel van een cirkeldiagram"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "554d6086-78de-41db-927b-d264ecf4dae5",
                                "sense_id": "54132064-8eec-38c3-86d3-1b74dcd99645",
                                "text": "Verreweg de grootste taartpunt beslaat witte modellen in printcampagnes."
                            },
                            {
                                "example_id": "96eb1886-f02c-4f0c-b0a9-6284dc09d443",
                                "sense_id": "54132064-8eec-38c3-86d3-1b74dcd99645",
                                "text": "Maar vergeleken met de totale groei van hotelovernachtingen werd de taartpunt van Rotterdam de afgelopen zes jaar slechts 0,6 procentpunt groter."
                            }
                        ]
                    },
                    {
                        "sense_id": "769ed720-016b-386f-b19a-2d2a849a10cc",
                        "entry_id": "ae5bfe34-a439-3ade-bcee-5255b3cb4d2e",
                        "glosses": [
                            "deel van een cirkel omgeven uit twee lijnen die verbonden zijn met het middelpunt en een deel van de omtrek van de cirkel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b3d7ea4-a19c-410e-b100-15753129d1d2",
                                "sense_id": "769ed720-016b-386f-b19a-2d2a849a10cc",
                                "text": "De indeling van een dartbord is als volgt: een cirkel verdeeld in 20 gelijke taartpunten, met een binnenste en een buitenste bullseye in het midden, en twee ringen, een half en een op de buitenrand van de cirkel voor respectievelijk driedubbele en dubbele scores."
                            }
                        ]
                    }
