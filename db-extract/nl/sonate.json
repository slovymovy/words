                            {
                                "example_id": "bcdecfd4-525a-46c4-bba0-2c5b0b19c4f7",
                                "sense_id": "2c335fbf-ada7-3a5d-b119-910ffdee496f",
                                "text": "Een sonate voor fluit en piano van G.F. Handel."
                            }
                        ]
