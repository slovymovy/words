                "senses": [
                    {
                        "sense_id": "c97e046a-3b97-3a27-9a1e-e839166f43cd",
                        "entry_id": "be403813-972e-35d0-bf5b-db3ef129e9fa",
                        "glosses": [
                            "das vorsätzliche Vermeiden von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b107e93-df57-44eb-9dae-c7a600f621cd",
                                "sense_id": "c97e046a-3b97-3a27-9a1e-e839166f43cd",
                                "text": "Die Vermeidung von Autounfällen im Straßenverkehr ist genauso wichtig, wie die Vermeidung von unnötigem Müll und Abfall."
                            },
                            {
                                "example_id": "73600f55-793f-45ee-84aa-7b6b906e1841",
                                "sense_id": "c97e046a-3b97-3a27-9a1e-e839166f43cd",
                                "text": "„Denn auch die Vermeidung von Unfällen kann Vorsprung durch Technik sein.“"
                            },
                            {
                                "example_id": "75e64c15-3f6d-40af-80d4-f4e40fa0486e",
                                "sense_id": "c97e046a-3b97-3a27-9a1e-e839166f43cd",
                                "text": "„Diese Vermeidung war notwendig, wenn wir uns nicht entmutigen lassen wollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "78b8de71-964c-4f1d-81db-b94a9a95f702",
                        "source_entry_id": "be403813-972e-35d0-bf5b-db3ef129e9fa",
                        "source_sense_id": "c97e046a-3b97-3a27-9a1e-e839166f43cd",
                        "source_sense_description": "das vorsätzliche Vermeiden von etwas",
                        "target_lang_word": "avoidance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "avoidance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b2c07c7f-db76-33ee-b99b-854bb65ba6fc",
                                        "entry_id": "9b6bef5f-fcb8-3831-83b0-9bf73b075ef3",
                                        "glosses": [
                                            "The act of avoiding or shunning; keeping clear of."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cc557ef4-b74f-45b4-a992-dd6b49739879",
                                                "sense_id": "b2c07c7f-db76-33ee-b99b-854bb65ba6fc",
                                                "text": "At her invitation he outlined for her the succeeding chapters with terse military accuracy ; and what she liked best and best understood was avoidance of that false modesty which condescends, turning technicality into pabulum."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e54ac95-465d-3a6b-96b4-156eab93bf54",
                                        "entry_id": "9b6bef5f-fcb8-3831-83b0-9bf73b075ef3",
                                        "glosses": [
                                            "The act of annulling; annulment."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "37fb5026-e64a-3ccc-bcec-8ef1b417a563",
                                        "entry_id": "9b6bef5f-fcb8-3831-83b0-9bf73b075ef3",
                                        "glosses": [
                                            "The act of becoming vacant, or the state of being vacant, specifically used for the state of a benefice becoming void by the death, deprivation, or resignation of the incumbent."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "91435544-9f13-3504-acc5-1b4e3372e22f",
                                        "entry_id": "9b6bef5f-fcb8-3831-83b0-9bf73b075ef3",
                                        "glosses": [
                                            "The act of dismissing a person."
                                        ],
                                        "tags": [
