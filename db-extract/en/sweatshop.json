                        "glosses": [
                            "A factory or other place of work where pay is low and conditions are poor or even illegal."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a443ba4-439f-4bb8-ae57-af900406e5c0",
                                "sense_id": "d9e906d5-bbf4-3918-995c-96518d7b30d8",
                                "text": "I was thrilled to be able to build my own shoes, and my personal iD was offered as a small token of appreciation for the sweatshop workers poised to help me realize my vision."
                            }
                        ]
