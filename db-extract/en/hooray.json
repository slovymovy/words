                        ],
                        "examples": [
                            {
                                "example_id": "fa638e98-589d-40ac-b32e-727bb80fe45c",
                                "sense_id": "60d61f22-7bd8-3eec-814b-29200cccc365",
                                "text": "The Caribbean isn’t just for minor royals and hedge-fund hoorays. […] But the hurricanes had not struck the southern Caribbean (they rarely do), and the hedge fund hoorays were clearly confined to Mustique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2007aa53-c914-4076-b164-e2a7117d4d23",
                        "source_entry_id": "6eab7669-5b23-315a-a177-921a80894719",
                        "source_sense_description": "a shout to signify victory",
                        "target_lang_word": "Hurra",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hurra",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "480e107e-98f6-3717-b845-bda155351306",
