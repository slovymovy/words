                "senses": [
                    {
                        "sense_id": "881488dc-de4d-3f9f-b816-97df8cfa21f3",
                        "entry_id": "c22d2f9b-3fc8-371c-ade1-c98a73b81ef6",
                        "glosses": [
                            "Person, die (gerne) Wein trinkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a9f87ca-5930-4dec-ab3b-d8612ec1a939",
                                "sense_id": "881488dc-de4d-3f9f-b816-97df8cfa21f3",
                                "text": "\"Es gibt Weintrinker die sich ausschließlich an der sinnlichen Seite eines Weins erfreuen … Andere wiederum diskutieren über seltene alte Weine und bewerten und analysieren … Beide Typen von Weintrinkern greifen in ihrer Einseitigkeit zu kurz: Die wahre Befriedigung, die der Wein zu verschaffen vermag, liegt in der Ausgewogenheit zwischen alltäglichem Genuß und esoterischem Erlebnis.\""
                            },
                            {
                                "example_id": "2af5c097-5b74-4c16-bb1e-9461ade5aed1",
                                "sense_id": "881488dc-de4d-3f9f-b816-97df8cfa21f3",
                                "text": "„Weintrinker können gleich noch einen Soave Classico oder tiefroten Valpoicella aus dem großen Sortiment mitnehmen oder ein Gläschen zum Essen trinken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
