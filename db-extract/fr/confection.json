        "fr-extract.jsonl": [
            {
                "entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                "word": "confection",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e1a6e695-74f9-48d1-a432-1300fa6d1ba2",
                        "entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "tags": [
                            "plural"
                        ],
                        "form": "confections"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                        "entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "glosses": [
                            "Action par laquelle on exécute un ouvrage jusqu’à complet achèvement. — Note d’usage : Il ne se dit plus que dans des cas spéciaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33d72416-14bd-4dbd-93b1-a1293dc050d5",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "Assez loin d’elle, debout devant une table en véritable laque, une personne grassouillette surveillait le samovar de cuivre où chauffait l’eau qui allait servir à la confection du thé."
                            },
                            {
                                "example_id": "10ce3701-4d0e-43df-bb85-db415e82fd9d",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "On groupe quelquefois sous ce nom quelques fibres qui sont employées dans la corderie, la brosserie, la fabrication des feutres, etc., et qui ne pourraient entrer que difficilement dans la confection d'une étoffe quelconque."
                            },
                            {
                                "example_id": "fb5679e1-bf5b-4bd5-8242-fe7433f9749c",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "Tous les bras disponibles travaillaient à la confection d’un mât, auquel les électriciens du Vaterland accrocheraient les longues antennes de l’appareil de télégraphie sans fil […]."
                            },
                            {
                                "example_id": "350c425b-41a8-48d1-9376-f80671561526",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "Il faut dire que le fabricant a fait très tôt le choix de la délocalisation, […]. 45% des tissus des collections du groupe sont tricotés et découpés en France, la confection étant sous-traitée au Maghreb, en Roumanie ou en Asie."
                            },
                            {
                                "example_id": "cbe67f6f-5f24-439a-9f09-f65f53fc4de2",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "— La confection des listes électorales."
                            },
                            {
                                "example_id": "119272b4-503d-47f6-89c0-796d85267cc6",
                                "sense_id": "99a7cfc5-0102-32ea-8f01-2a2f13224d3b",
                                "text": "— La confection d’un papier terrier, la confection d’un inventaire."
                            }
                        ]
                    },
                    {
                        "sense_id": "502d020f-a0fc-35c8-91c6-f0d1ca41de06",
                        "entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "glosses": [
                            "Les vêtements, la lingerie, les chaussures qui ne sont pas faits sur mesure."
                        ],
                        "tags": [
                            "collectively"
                        ],
                        "examples": [
                            {
                                "example_id": "cec37c35-1928-448f-a40d-35252e6a67cf",
                                "sense_id": "502d020f-a0fc-35c8-91c6-f0d1ca41de06",
                                "text": "Mais, comme elle entrait dans la rue, Denise fut reprise par une vitrine, où étaient exposées des confections pour dames.."
                            },
                            {
                                "example_id": "68d739b5-ac93-4ae5-82b0-1f9d5386aa78",
                                "sense_id": "502d020f-a0fc-35c8-91c6-f0d1ca41de06",
                                "text": "[…] elle tapait avec une application timide, toute frêle, toute mièvre dans sa robe de confection simili popeline."
                            },
                            {
                                "example_id": "53ee3cdb-5a80-4b74-8771-ece8d0414441",
                                "sense_id": "502d020f-a0fc-35c8-91c6-f0d1ca41de06",
                                "text": "Mais le savetier fit entendre des plaintes obscures, confuses et vraies. Ce n’était plus comme autrefois. Maintenant on ne pouvait soutenir la concurrence de la grande confection."
                            },
                            {
                                "example_id": "01be4c95-7a86-41fa-90e2-d4d837b18901",
                                "sense_id": "502d020f-a0fc-35c8-91c6-f0d1ca41de06",
                                "text": "Magasin de confection. - Maison de confection."
                            }
                        ]
                    },
                    {
                        "sense_id": "6df985e9-c6a7-3f83-bd8e-a4416d7bf7ad",
                        "entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "glosses": [
                            "Le commerce et la vente de ces sortes d’objets."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7f42c7c3-eeb0-4399-9f6c-446d30e7cf25",
                                "sense_id": "6df985e9-c6a7-3f83-bd8e-a4416d7bf7ad",
                                "text": "Il est employé dans la confection."
                            },
                            {
                                "example_id": "b600ed66-f550-45e3-8463-c2edd1441caf",
                                "sense_id": "6df985e9-c6a7-3f83-bd8e-a4416d7bf7ad",
                                "text": "Je lus en effet : CONAN, MERCERIE, sur la glace de la devanture. Il y avait en montre une étoile faite de pelotons de laine et deux premiers communiants de bois, très vernis, gantés de fil et habillés de costumes marins. « On fait aussi de la confection », m’avait-il dit jadis…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ead37961-d359-4784-959d-648dfb3d5e55",
                        "source_entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "source_sense_description": "Action par laquelle on exécute",
                        "target_lang_word": "Herstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Herstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82aee765-a036-3b3a-8158-637dd4a275d6",
                                        "entry_id": "c9f71e7e-c970-3dae-aaf3-c0dbe9c5b648",
                                        "glosses": [
                                            "Vorgang, bei dem etwas angefertigt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1302afab-221f-4461-8d16-7c1b5768ce3c",
                                                "sense_id": "82aee765-a036-3b3a-8158-637dd4a275d6",
                                                "text": "Dieses Modell ist in der Herstellung sehr teuer."
                                            },
                                            {
                                                "example_id": "f0d5e92a-6fa3-40a6-b99c-595eb4969327",
                                                "sense_id": "82aee765-a036-3b3a-8158-637dd4a275d6",
                                                "text": "„Zur Herstellung von Munition, aber auch von Düngemitteln für die Landwirtschaft bilden Stickstoffverbindungen (Nitrate), darunter insbesondere Salpeter (NaNO₃) und Salpetersäure (HNO₃), einen unentbehrlichen Grundbestandteil.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b589adc4-5673-344a-bc6a-f0d5a7876da7",
                                        "entry_id": "c9f71e7e-c970-3dae-aaf3-c0dbe9c5b648",
                                        "glosses": [
                                            "das Erwirken eines Zustandes"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c04ab48-a6f9-4d3f-b93a-405fbeb87ceb",
                                                "sense_id": "b589adc4-5673-344a-bc6a-f0d5a7876da7",
                                                "text": "Nach der Herstellung von Ruhe und Ordnung im Lande gab es keine Zwischenfälle mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df0b3f10-69af-492b-8b4b-1bb02b11ad4c",
                        "source_entry_id": "5896434c-f80a-3568-aa17-dd6d6b452e68",
                        "source_sense_description": "vêtements etc. qui ne sont pas faits sur mesure",
                        "target_lang_word": "Konfektion",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfektion",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3d40459b-014e-3c09-a0b7-27f3b3635d64",
                                        "entry_id": "963ac771-01b4-3d39-873e-c56e86bf1508",
                                        "glosses": [
                                            "serienmäßige Anfertigung von Kleidungsstücken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e868f46-022a-464a-9cd3-f571b40e9b4f",
                                                "sense_id": "3d40459b-014e-3c09-a0b7-27f3b3635d64",
                                                "text": "„Er garantiert die Einhaltung von sozialen Standards in der Konfektion und von ökologischen Anforderungen in der Textilveredelung, etwa Drucken, Färben oder chemische Nachrüstungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5c297de0-3884-3c9e-8fbd-004e5f05dbc3",
                                        "entry_id": "963ac771-01b4-3d39-873e-c56e86bf1508",
                                        "glosses": [
                                            "serienmäßig hergestellte Kleidung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f81e6c0-197b-482b-b063-3b41b5066f97",
                                                "sense_id": "5c297de0-3884-3c9e-8fbd-004e5f05dbc3",
                                                "text": "„Die berühmte Berliner Mode der zwanziger Jahre gab es nur von 1924 bis 1929, als die Konfektion so einfallsreich wie nie war und die Berlinerinnen für einen modernen, Grenzen verwischenden Stil standen, der die ganze Welt berauschte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "cd158db8-2c49-3e2f-a301-d6b8558310bb",
                                        "entry_id": "963ac771-01b4-3d39-873e-c56e86bf1508",
                                        "glosses": [
                                            "kurz für Bekleidungsindustrie, Konfektionsindustrie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6a7c8d6-4a8a-4044-a340-df8a5228447c",
                                                "sense_id": "cd158db8-2c49-3e2f-a301-d6b8558310bb",
                                                "text": "Maria war lange Zeit in der Konfektion beschäftigt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
