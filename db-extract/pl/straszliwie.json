                "translations": [
                    {
                        "translation_id": "a814bd9b-8f83-4414-8f02-1cde0cb18fe7",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "damnably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damnably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                        "entry_id": "244c1d53-ca87-362f-9f7b-354408a6a671",
                                        "glosses": [
                                            "In a damnable manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35ba99d6-1ae2-41d2-9064-4920826a529b",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "I haue miſ-vs'd the Kings Preſſe damnably."
                                            },
                                            {
                                                "example_id": "2eeb72a8-ecb0-496a-83af-50e338fac2f2",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "The people were in hopes he had killed the lawyers, and were damnably disappointed when they found he had only broke the leg o' the one, and the back of the other."
                                            },
                                            {
                                                "example_id": "75ce7c28-41f8-4df2-a33b-15ade6cca602",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "But I am blabbing damnably; come, tell me one little bit of the story, and I shall tell you the rest."
                                            },
                                            {
                                                "example_id": "bc5e23a1-35d4-4416-9e23-3eca10f3301b",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "By the way: my dressing-gown smells most damnably of benzine."
                                            },
                                            {
                                                "example_id": "917ad338-829a-4a13-8c85-da26377cee96",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "The young man was so damnably full of his experiences, so eager to compare one thing with another, so insistent upon foreign places and changes in England and what we'd all got to do about it."
                                            },
                                            {
                                                "example_id": "4c6fa043-1171-4757-8f27-865a87b05238",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "And in his male spirit he felt himself hating her: hating her deeply, damnably."
                                            },
                                            {
                                                "example_id": "b206ce02-40c6-4db2-8ccd-2d4a3a15b62c",
                                                "sense_id": "204d04d4-dca9-3e62-8505-632aa9daddc9",
                                                "text": "They had just got me on to the stretcher when my paralysed right arm came to life and began hurting damnably."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4b97ad4-9ce7-4471-a78b-647339b5fb0c",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "horrendously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horrendously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                        "entry_id": "27c8b534-2f08-3594-8eee-4f8df3688294",
                                        "glosses": [
                                            "In a horrendous manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1d7a171-175d-42b0-a0c1-56542cacf3e4",
                                                "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                                "text": "The car handled horrendously when I took it for a test drive."
                                            },
                                            {
                                                "example_id": "07a2015a-e557-4fdb-91b0-357e59d98951",
                                                "sense_id": "374f3d39-16dc-3471-87e9-0bf7bbedf4dc",
                                                "text": "Mean-times, spelling and pronunciation are horrendously uncircumvoluted and the English vocabulary simply oozes with unloquaciousness. Irregardless of whether I say “wreck a nice beach” or “recognize speech,” you know what I mean, unless I say it too fast."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b344857c-d9bf-4457-9b11-80a13084f1bd",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "horrifically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horrifically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e95148cc-18ca-3699-a10a-7918ffb1ce22",
                                        "entry_id": "4163365d-a035-3765-ab01-64d7ae95b447",
                                        "glosses": [
                                            "In a horrific manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7a79d3-e507-4750-bc55-03529e4d83da",
                                                "sense_id": "e95148cc-18ca-3699-a10a-7918ffb1ce22",
                                                "text": "What other television show would feature a gorgeously designed sequence where a horrifically mutated Pierre and Marie Curie, their bodies swollen to Godzilla-like proportions from prolonged exposure to the radiation that would eventually kill them, destroy an Asian city with their bare hands like vengeance-crazed monster-Gods?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b2e52bbc-ab9b-4259-b95b-c1fab9f5d0be",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "murderously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "murderously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cba0c05b-a744-3670-83ed-cfcc953907f4",
                                        "entry_id": "b16e146d-c0d7-3ac2-ad69-e4cdf7326bd1",
                                        "glosses": [
                                            "In a murderous manner; as if wanting to commit murder; extremely angrily."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83224bdb-6672-4c6e-851d-6903c7cbd8f2",
                                                "sense_id": "cba0c05b-a744-3670-83ed-cfcc953907f4",
                                                "text": "They decided to stop arguing over which spelling was correct after she began glaring murderously at each person who participated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8457e458-74f7-43a9-af3b-c2a2b193751f",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "entsetzlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "entsetzlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                        "entry_id": "37651b58-7f25-32cd-bf44-aaa329f965b2",
                                        "glosses": [
                                            "Entsetzen/nicht beherrschbaren Schrecken erregend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8978bb8f-4d27-4db3-acea-c9b6e32ae20e",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "Ein entsetzlicher Unfall hat eine ganze Familie ausgelöscht."
                                            },
                                            {
                                                "example_id": "d02def55-e6e2-4895-b7d1-139c8c6a29d2",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "Die Pest war im Mittelalter eine entsetzliche Krankheit."
                                            },
                                            {
                                                "example_id": "989b1364-e781-465a-9364-8b65f05c5c51",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "[Heinrich II.:] „Trotz einer Notoperation durch die besten Ärzte seiner Zeit starb er nach entsetzlichen Leiden […].“"
                                            },
                                            {
                                                "example_id": "b50218f0-fdfd-469a-8e67-24e65910f627",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„Luis Ortiz litt unter so entsetzlichen Kopfschmerzen, dass seine Eltern ihren Sohn ins Spital brachten.“"
                                            },
                                            {
                                                "example_id": "1189b431-2207-4713-842b-99eb3468f8d9",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "[Skagerak-Schlacht im Mai 1916:] „Entsetzlich ist dagegen die Zahl der menschlichen Opfer: Ein paar Hundert Schiffbrüchige werden noch während der Schlacht von Schiffen aufgenommen, von eigenen und gegnerischen. Die anderen ertrinken jämmerlich: mehr als 6.000 Briten und 2.500 Deutsche.“"
                                            },
                                            {
                                                "example_id": "5ca68e03-3995-4c7f-ab38-6cc27f0c3d40",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„Mehr als eine Million italienischer und österreichischer Soldaten starben unter entsetzlichen Bedingungen in Eis und Schnee.“"
                                            },
                                            {
                                                "example_id": "ccc232ca-6fa7-48c6-87c2-fd3cae4e04f9",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„In den folgenden Tagen spitzte sich die Lage immer mehr zu, und die Einwohner beschreiben in den sozialen Medien, wie entsetzlich sich die heftigen Bombardierungen aus Israel anfühlen.“"
                                            },
                                            {
                                                "example_id": "28ff82d6-0935-494e-a861-d6c6f3679ce0",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„Blutbad auf Moskauer Flughafen Domodedowo durch Bombenanschlag – […] Im Terminal sollen sich nach der Detonation entsetzliche Szenen abgespielt haben.“"
                                            },
                                            {
                                                "example_id": "e3bf9ef7-77f3-4c00-b3c3-5903ba5ca96c",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "[Schlagzeile:] \"Der Zustand der Flüchtlinge ist entsetzlich\""
                                            },
                                            {
                                                "example_id": "085dfaa7-6eb0-4b73-bcd3-98b610ef48a5",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„Der Generalsekretär des Europarats, Thorbjørn Jagland, äußerte sich in einem Interview zur Lage der Roma in Europa. […] Die Lebensbedingungen der Roma in vielen europäischen Ländern bezeichnete er als entsetzlich.“"
                                            },
                                            {
                                                "example_id": "56ebe471-b3ba-4e89-ba6d-72c7722c794e",
                                                "sense_id": "86e7ca06-954d-3418-957e-2d1af6b78183",
                                                "text": "„Gleich zu Beginn ihrer weiten und gefährlichen Reise treibt die entsetzliche Trockenheit die verzweifelten Tiere dazu, nach Wasser zu suchen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "91c6b479-b3fb-3302-82c5-86dfe1ec095d",
                                        "entry_id": "37651b58-7f25-32cd-bf44-aaa329f965b2",
                                        "glosses": [
                                            "in negativer Weise sehr stark/groß"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1591abe-23b2-4f8b-ab26-1bfff8102393",
                                                "sense_id": "91c6b479-b3fb-3302-82c5-86dfe1ec095d",
                                                "text": "„Gleich zu Beginn ihrer weiten und gefährlichen Reise treibt die entsetzliche Trockenheit die verzweifelten Tiere dazu, nach Wasser zu suchen.“"
                                            },
                                            {
                                                "example_id": "a9665031-9942-43d9-a062-7915f34f302c",
                                                "sense_id": "91c6b479-b3fb-3302-82c5-86dfe1ec095d",
                                                "text": "„Hanau, Halle, Walter Lübcke - Namen deutscher Städte und eines ermordeten Politikers, die für das entsetzliche Ausmaß von Rechtsextremismus und Antisemitismus seit 2019 stehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                        "entry_id": "37651b58-7f25-32cd-bf44-aaa329f965b2",
                                        "glosses": [
                                            "sehr"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "008b4f54-e44d-40d2-bfd0-5ce7c0c77467",
                                                "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                                "text": "In Sibirien ist es im Winter entsetzlich kalt."
                                            },
                                            {
                                                "example_id": "5f18abd2-57ac-4338-86cb-9a49bfdf5fa0",
                                                "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                                "text": "Ich friere entsetzlich bei dieser Kälte."
                                            },
                                            {
                                                "example_id": "775ddcaa-5092-4c1c-86a2-453936e80d91",
                                                "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                                "text": "„»Hätte ich das Surfen nicht entdeckt, wäre ich jetzt wahrscheinlich in irgendeiner chinesischen Stadt Ehefrau und Mutter und würde mich entsetzlich langweilen«, sagt sie.“"
                                            },
                                            {
                                                "example_id": "c86dfb53-5355-4ab8-a67d-5b45bc192c07",
                                                "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                                "text": "[Edward Elgar, Violinkonzert h-Moll:] »Es ist entsetzlich emotional«, bekannte Elgar, »aber ich liebe es!«"
                                            },
                                            {
                                                "example_id": "066f5fc4-d43f-48b3-ac2c-5ea9764bc218",
                                                "sense_id": "6a1fa0ec-2517-3902-8e57-78f798fac6d1",
                                                "text": "„Hamburger Rathausmarkt: Bauarbeiter stoßen auf Sarg – Es habe plötzlich ganz entsetzlich gestunken, sagte ein Baurbeiter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "adbde8d3-c04a-4487-b1f7-aa884b2958fb",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
                        "source_sense_id": "54e575b9-d37a-3c4e-bb17-89cd28ec91d1",
                        "target_lang_word": "furchtbar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "furchtbar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                        "entry_id": "41b3a5f5-230f-3581-a480-9809403b7b77",
                                        "glosses": [
                                            "in starken Ausmaße negativ oder Entsetzen, Furcht hervorrufend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5aa624fe-2317-4ccb-a3b5-363e2771fd91",
                                                "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                                "text": "Das ist ja furchtbar."
                                            },
                                            {
                                                "example_id": "2d60eace-3d73-407d-8e00-1991b7fa6de6",
                                                "sense_id": "a69373ed-19f3-35a7-a5cb-7448e0942ba2",
                                                "text": "„Vor neun Jahrzehnten erlitt das bevölkerungsreichste, technisch fortgeschrittenste und fleißigste Land Kontinentaleuropas einen furchtbaren Rückschlag.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18c135d8-bee3-48c8-b8e4-19e367d715ef",
                        "source_entry_id": "a8115a3e-b096-3db0-a852-513d39e03d72",
