                    {
                        "translation_id": "314fe8a5-8703-4dc3-82b0-2b7bbc9f1813",
                        "source_entry_id": "ccdabd79-122b-35f2-bd2d-529edb1f0176",
                        "source_sense_id": "df32fc4e-4f71-3f51-8d5e-8205c35bee21",
                        "target_lang_word": "трансгрессия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "трансгрессия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fff0a2e1-30c2-3e89-afa2-d94fde6700da",
                                        "entry_id": "31dc6717-38ad-3c76-af5a-6d3abd1640ae",
                                        "glosses": [
                                            "геол. наступление моря на сушу в результате опускания земной коры либо повышения уровня моря"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31854a20-fe19-4414-bab0-40ee8fa4d285",
                                                "sense_id": "fff0a2e1-30c2-3e89-afa2-d94fde6700da",
                                                "text": "Главные процессы, протекающие в пределах биосферы и непосредственно воздействующие на ее развитие как суперэкосистемы по принципу управления с обратной связью, – это тектогенез, трансгрессии, эволюция климата и органического мира."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5ec73dc-3cba-3b9d-886b-1bf6d55300a3",
                                        "entry_id": "31dc6717-38ad-3c76-af5a-6d3abd1640ae",
                                        "glosses": [
                                            "генет. усиленное (или ослабленное) проявление какого-либо генетического признака у потомства по сравнению с родительскими особями"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a03b8fb-9ac8-3da3-b6d3-e7e3133b1a73",
                                        "entry_id": "31dc6717-38ad-3c76-af5a-6d3abd1640ae",
                                        "glosses": [
                                            "филос. преодоление разумным субъектом границ возможного, в том числе социальных, моральных и иных запретов, традиций"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60c05fd8-2775-4cd0-bdb2-3c9011e4752f",
                                                "sense_id": "8a03b8fb-9ac8-3da3-b6d3-e7e3133b1a73",
                                                "text": "В перечисленных „трансгрессиях“ физики обогатились такими метафизическими „прозрениями“, как, соответственно, гипотеза квантования Планка, доктрина релятивизма Пуанкаре — Эйнштейна, программа геометризации физических взаимодействий Вейля — Эйнштейна. <…> Современный философ не видит эпистемологической проблемы в основанной на трансгрессии стандартной познавательной процедуре современной физики."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
