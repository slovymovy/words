                "senses": [
                    {
                        "sense_id": "01b56b35-0730-3354-a31a-652841050051",
                        "entry_id": "8ba3e3f0-0f50-3485-83ea-967e47d05941",
                        "glosses": [
                            "Initialism of general issue, given to a soldier by the army (as an item), rather than brought from home; or used by the army (as a procedure), and different from its civilian counterpart."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "15c18fd4-8996-4b90-8e07-8431cd17942b",
                                "sense_id": "01b56b35-0730-3354-a31a-652841050051",
                                "text": "Soldiers counted cadence by chanting: “GI brush / And GI comb / Gee, I wish that I was home!”"
                            }
                        ]
                    },
                    {
                        "sense_id": "04e85e9c-1616-34bf-b567-6a8c2ae720e7",
