                },
                {
                    "sense_id": "cc18f8ee-7852-39a7-9553-3f52000e3b57",
                    "sense_definition": "beschikbaar komen, betaald worden of officieel toegekend worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "formeel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De subsidie voor het nieuwe project zal pas aan het eind van het jaar <w>afkomen</w>.",
                            "target_lang_translations": {
                                "en": "The grant for the new project will not <w>come through</w> until the end of the year."
                            }
                        },
                        {
                            "text": "We wachten nog steeds tot de officiële uitslagen van het examen <w>afkomen</w>.",
                            "target_lang_translations": {
                                "en": "We are still waiting for the official exam results to <w>be released</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "geld dat afkomt",
                        "een benoeming die afkomt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in administrative or financial contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to become available, be paid out, or be officially granted"
                    },
                    "translations": {
