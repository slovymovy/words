                        "target_lang_word": "zum Nennwert",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "6741b164-488e-444e-9cf4-113bf519d6b1",
                        "source_entry_id": "db66248e-0890-39eb-bcf8-99a568ca7b6d",
                        "source_sense_id": "8ab796cf-4ce2-3674-8c6d-d6f07451975b",
                        "target_lang_word": "au pair",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "au pair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2b4ded0-215d-3925-86c9-de3b815eb7ac",
                                        "entry_id": "0ce13628-ac1e-3d29-bb48-09dcfa23b887",
                                        "glosses": [
                                            "À égalité, à parité, en parlant de celle entre le capital nominal d’une valeur et son cours actuel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3d2d3a6-6fbc-4dbb-836e-57703a5a7f0f",
                                                "sense_id": "e2b4ded0-215d-3925-86c9-de3b815eb7ac",
                                                "text": "Acheter une valeur au pair."
                                            },
                                            {
                                                "example_id": "012a9f48-7cb1-4a4f-bc9a-615edd855f42",
                                                "sense_id": "e2b4ded0-215d-3925-86c9-de3b815eb7ac",
                                                "text": "La rente est au pair."
                                            },
                                            {
                                                "example_id": "fcea4e34-731d-48ba-8bb4-960573d65afe",
                                                "sense_id": "e2b4ded0-215d-3925-86c9-de3b815eb7ac",
                                                "text": "Savinet. — Quoi… C’est que… Je comprends très bien, la dot … évidemment ! Mais la rendre en ce moment-ci … Moi, quand ma femme m’a apporté ses quatre cent mille francs, je les ai employés en valeurs argentines !…\nAngèle. — Eh ! Bien…\nSavinet. — Eh bien, à ce moment-là, c’était très bon ! Aujourd’hui, ça ne vaut pas le quart… C’est pas le moment de vendre ! Je ne pourrais jamais restituer la dot au pair !…"
                                            },
                                            {
                                                "example_id": "d1841920-8ee0-48e0-992e-7b6631719982",
                                                "sense_id": "e2b4ded0-215d-3925-86c9-de3b815eb7ac",
                                                "text": "Sur ces quatre-vingt sacs soixante-deux, sur l’ordre du Président Brigham Young, furent employés à la frappe de pièces de cinq et dix dollars, opération qui permit aux billets émis par la banque mormone de Kirtland de remonter au pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1beb637c-366b-370f-b401-a3ece167b9c0",
                                        "entry_id": "0ce13628-ac1e-3d29-bb48-09dcfa23b887",
                                        "glosses": [
                                            "Sans arriéré."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e5e316f1-fe7f-4521-9707-40119efcc6fd",
                                                "sense_id": "1beb637c-366b-370f-b401-a3ece167b9c0",
                                                "text": "J’étais en retard dans mon travail, maintenant je suis au pair, je me suis mis au au pair."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0288f35a-7d85-3ac6-912d-4b29b2fb01b8",
                                        "entry_id": "0ce13628-ac1e-3d29-bb48-09dcfa23b887",
                                        "glosses": [
                                            "Se dit de l’emploi rémunéré uniquement en nature (logement et nourriture)."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2b6c6f4-3315-4890-9deb-f6ba57e3dd38",
                                                "sense_id": "0288f35a-7d85-3ac6-912d-4b29b2fb01b8",
                                                "text": "Prendre quelqu’un au pair."
                                            },
                                            {
                                                "example_id": "215dc3c9-228c-4be7-bbfd-833b66d59bd6",
                                                "sense_id": "0288f35a-7d85-3ac6-912d-4b29b2fb01b8",
                                                "text": "Elle connaissait fort peu la mercerie , dont elle ne s'occupait que depuis huit mois, au grade de demoiselle au pair, c'est-a-dire, sans appointements […] elle n’est que demoiselle au pair, son élévation sera pour ma femme une occasion de se faire une créature, de signaler sa puissance."
                                            },
                                            {
                                                "example_id": "b25f3242-29ad-4f97-bd01-b13528e6449f",
                                                "sense_id": "0288f35a-7d85-3ac6-912d-4b29b2fb01b8",
                                                "text": "Sylvie Rogron fut envoyée à cent écus de pension en apprentissage rue Saint-Denis, chez des négociants nés à Provins. Deux ans après, elle était au pair : si elle ne gagnait rien, ses parents ne payaient plus rien pour son logis et sa nourriture. Voilà ce qu’on appelle être au pair, rue Saint-Denis."
                                            },
                                            {
                                                "example_id": "62cf0d21-de57-4af3-a322-667ec3db50c9",
                                                "sense_id": "0288f35a-7d85-3ac6-912d-4b29b2fb01b8",
                                                "text": "Le 2 ou 3 novembre 1845, je franchis le dernier seuil par lequel l’église avait voulu me retenir, et j’allai m’établir dans une institution du quartier Saint-Jacques, relevant du lycée Henri IV, comme répétiteur au pair, c’est-à-dire, selon le langage du Quartier Latin d’alors, sans appointements. J’avais une petite chambre, la table avec les élèves, à peine deux heures par jour occupées, beaucoup de temps par conséquent pour travailler. Cela me satisfaisait pleinement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "414efafa-1d05-3863-b999-20c0a64e86cf",
                                        "entry_id": "0ce13628-ac1e-3d29-bb48-09dcfa23b887",
                                        "glosses": [
                                            "Se dit de l’emploi offert à quelqu’un en lui offrant logement et nourriture avec une petite rémunération en argent en l’échange d’un service donné."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2dcc298-efeb-4d5b-96b6-06c283fda42c",
                                                "sense_id": "414efafa-1d05-3863-b999-20c0a64e86cf",
                                                "text": "Elle travaille au pair en Angleterre."
                                            },
                                            {
                                                "example_id": "ee8603fd-f6f9-44cc-9336-b2238795c993",
                                                "sense_id": "414efafa-1d05-3863-b999-20c0a64e86cf",
                                                "text": "— J'ai l'impression, me disait Bertille, d'avoir engagé une Anglaise au pair qui ne saurait pas trois mots de français."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "au pair",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2055fd24-b4b5-35a9-a7af-d927d90607f7",
                                        "entry_id": "876af549-515c-3ea3-9d3d-2186f84073e7",
                                        "glosses": [
                                            "Qui travaille contre nature (logement, nourriture) voire avec une petite rémunération."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c697828f-d69c-4398-a06e-a1fd64e7167e",
                                                "sense_id": "2055fd24-b4b5-35a9-a7af-d927d90607f7",
                                                "text": "Une jeune fille au pair."
                                            },
                                            {
                                                "example_id": "2c5a767b-d2cd-4042-a393-7b7934d27fd0",
                                                "sense_id": "2055fd24-b4b5-35a9-a7af-d927d90607f7",
                                                "text": "– Avec qui s’est-il remarié ?\n– Une Suisse allemande, une conne. C’était notre jeune fille au pair. J’ai toujours pensé qu’on écrivait « jeune fille au père »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
