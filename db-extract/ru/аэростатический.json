                    },
                    {
                        "translation_id": "c7bf455e-5685-4740-8b0f-4d025d0e2fc9",
                        "source_entry_id": "307ca182-4bac-3f20-a292-36a07420973f",
                        "target_lang_word": "aérostatique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aérostatique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c5e3af12-1b15-34e2-96a5-ad6d8254825a",
                                        "entry_id": "4ee44c71-0f05-3a93-8e30-128e63f79138",
                                        "glosses": [
                                            "Relatif à l’aérostation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "50a0fcae-b1d7-4a8f-ad2e-250360578607",
                                                "sense_id": "c5e3af12-1b15-34e2-96a5-ad6d8254825a",
                                                "text": "La production de ce gaz est facile, et c’est celui qui a donné les meilleurs résultats dans les expériences aérostatiques."
                                            },
                                            {
                                                "example_id": "a7295362-120c-4ba8-a68d-d682553943eb",
                                                "sense_id": "c5e3af12-1b15-34e2-96a5-ad6d8254825a",
                                                "text": "On établit un service aérostatique. Chaque jour, lorsque le temps le permet, un ou plusieurs ballons sont lancés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "aérostatique",
                                "target_lang_code": "fr",
                                "target_senses": [
