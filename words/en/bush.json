{
    "word_family": [
        "bushy",
        "bushman",
        "bushfire",
        "bushland"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "71ca7404-42a6-3b46-8789-f14789e02a23",
                    "sense_definition": "A woody plant distinguished from a tree by its multiple stems and lower height.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to plant a rose <w>bush</w> near the front entrance of the house.",
                            "target_lang_translations": {
                                "ru": "Мы решили посадить розовый <w>куст</w> у парадного входа в дом.",
                                "zh": "我们决定在房子正门附近种一棵玫瑰<w>灌木</w>。"
                            }
                        },
                        {
                            "text": "The bird flew out of the thick <w>bush</w> when we approached it.",
                            "target_lang_translations": {
                                "ru": "Птица вылетела из густого <w>кустарника</w>, когда мы подошли к нему.",
                                "zh": "当我们靠近时，那只鸟从茂密的<w>灌木丛</w>中飞了出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "shrub"
                    ],
                    "common_phrases": [
                        "rose bush",
                        "beat about the bush",
                        "berry bush"
                    ],
                    "target_lang_definitions": {
                        "ru": "Древесное растение, отличающееся от дерева наличием нескольких стволов и меньшей высотой.",
                        "zh": "一种木本植物，与树木的区别在于其多茎且高度较低。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "куст",
                                "target_lang_sense_clarification": "отдельное растение"
                            },
                            {
                                "target_lang_word": "кустарник",
                                "target_lang_sense_clarification": "вид растения или заросли"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "灌木",
                                "target_lang_sense_clarification": "指代该类植物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "774029f0-37d9-3038-b364-767ff26654a2",
                    "sense_definition": "Tracts of land covered in natural vegetation that are largely undeveloped and uncultivated, especially in Australia, New Zealand, or Canada.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent several days hiking through the <w>bush</w> without seeing another person.",
                            "target_lang_translations": {
                                "ru": "Они провели несколько дней, путешествуя по <w>бушу</w>, и не встретили ни души.",
                                "zh": "他们在<w>荒野</w>中徒步旅行了几天，没见到其他人。"
                            }
                        },
                        {
                            "text": "Living in the <w>bush</w> requires a good understanding of survival skills.",
                            "target_lang_translations": {
                                "ru": "Жизнь в <w>дикой местности</w> требует хороших навыков выживания.",
                                "zh": "在<w>丛林</w>中生活需要具备良好的生存技能。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wilderness",
                        "wild"
                    ],
                    "common_phrases": [
                        "the bush",
                        "bush fire"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia, New Zealand, Canada"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обширные участки земли, покрытые естественной растительностью, в основном неосвоенные (особенно в Австралии, Новой Зеландии или Канаде).",
                        "zh": "指未开发、未耕种的自然植被覆盖区域，常见于澳大利亚、新西兰或加拿大。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "буш",
                                "target_lang_sense_clarification": "дикая местность в Австралии/Африке"
                            },
                            {
                                "target_lang_word": "дикая местность",
                                "target_lang_sense_clarification": "неосвоенная территория"
                            },
                            {
                                "target_lang_word": "заросли",
                                "target_lang_sense_clarification": "густая растительность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "荒野",
                                "target_lang_sense_clarification": "指未开发的自然区域"
                            },
                            {
                                "target_lang_word": "丛林",
                                "target_lang_sense_clarification": "指植被茂密的野外地区"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a7d3ed6-7786-3696-b206-3c1f62248720",
                    "sense_definition": "A person's pubic hair.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fashion trends regarding the natural <w>bush</w> have changed significantly over the decades.",
                            "target_lang_translations": {
                                "ru": "Модные тенденции касательно естественной <w>растительности</w> значительно изменились за десятилетия.",
                                "zh": "几十年来，关于自然<w>阴毛</w>的时尚潮流发生了巨大变化。"
                            }
                        },
                        {
                            "text": "He made a crude joke about her <w>bush</w> that no one found funny.",
                            "target_lang_translations": {
                                "ru": "Он отпустил грубую шутку про её <w>кустик</w>, которую никто не счел смешной.",
                                "zh": "他开了一个关于她<w>阴毛</w>的粗俗玩笑，没人觉得好笑。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pubes"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Лобковые волосы человека.",
                        "zh": "指人的阴毛。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растительность",
                                "target_lang_sense_clarification": "эвфемизм"
                            },
                            {
                                "target_lang_word": "кустик",
                                "target_lang_sense_clarification": "сленг"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴毛",
                                "target_lang_sense_clarification": "生理学称呼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0adac935-2bbb-365f-8320-e26a63e798ae",
                    "sense_definition": "A thick washer or hollow cylinder of metal used as a lining or guide for a mechanical part.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mechanic needed to replace the worn <w>bush</w> to stop the rattling noise.",
                            "target_lang_translations": {
                                "ru": "Механику нужно было заменить изношенную <w>втулку</w>, чтобы прекратить дребезжание.",
                                "zh": "机械师需要更换磨损的<w>衬套</w>以消除咔哒声。"
                            }
                        },
                        {
                            "text": "You must insert the steel <w>bush</w> before tightening the bolt.",
                            "target_lang_translations": {
                                "ru": "Вы должны вставить стальную <w>втулку</w> перед тем, как затягивать болт.",
                                "zh": "在拧紧螺栓之前，必须先装入钢制<w>轴套</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "bushing"
                    ],
                    "target_lang_definitions": {
                        "ru": "Толстая шайба или полый металлический цилиндр, используемый как вкладыш или направляющая для механической детали.",
                        "zh": "一种厚垫圈或空心金属圆筒，用作机械零件的衬套或导向装置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "втулка",
                                "target_lang_sense_clarification": "деталь механизма"
                            },
                            {
                                "target_lang_word": "вкладыш",
                                "target_lang_sense_clarification": "техническая деталь"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "衬套",
                                "target_lang_sense_clarification": "机械零件"
                            },
                            {
                                "target_lang_word": "轴套",
                                "target_lang_sense_clarification": "机械零件"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "066f5569-402e-348f-ba06-a0354fa41344",
                    "sense_definition": "A surname of Middle English origin, notably borne by two presidents of the United States.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "5",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "George W. <w>Bush</w> was the 43rd president of the United States.",
                            "target_lang_translations": {
                                "ru": "Джордж У. <w>Буш</w> был 43-м президентом Соединенных Штатов.",
                                "zh": "乔治·W·<w>布什</w>是美国第43任总统。"
                            }
                        },
                        {
                            "text": "The <w>Bush</w> family has been very influential in American politics for decades.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Буш</w> десятилетиями была очень влиятельной в американской политике.",
                                "zh": "<w>布什</w>家族几十年来在美国政坛一直很有影响力。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия среднеанглийского происхождения, которую носили два президента США.",
                        "zh": "源自中古英语的姓氏，曾由两位美国总统使用。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Буш",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "布什",
                                "target_lang_sense_clarification": "姓氏"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d1cee0e4-6abf-3049-952a-0b0f3f068606",
                    "sense_definition": "Not skilled; not professional; amateurish.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "6",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The way they handled the contract negotiations was completely <w>bush</w>.",
                            "target_lang_translations": {
                                "ru": "То, как они вели переговоры по контракту, было совершенно <w>непрофессионально</w>.",
                                "zh": "他们处理合同谈判的方式完全是<w>业余的</w>。"
                            }
                        },
                        {
                            "text": "Don't make <w>bush</w> mistakes if you want to play in the major leagues.",
                            "target_lang_translations": {
                                "ru": "Не совершай <w>дилетантских</w> ошибок, если хочешь играть в высшей лиге.",
                                "zh": "如果你想进入大联盟打球，就别犯这种<w>外行</w>错误。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "bush league"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Неумелый, непрофессиональный, дилетантский.",
                        "zh": "不熟练的、非专业的、业余的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "непрофессиональный",
                                "target_lang_sense_clarification": "о качестве работы"
                            },
                            {
                                "target_lang_word": "дилетантский",
                                "target_lang_sense_clarification": "любительский, низкого уровня"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "业余的",
                                "target_lang_sense_clarification": "指水平不高"
                            },
                            {
                                "target_lang_word": "外行的",
                                "target_lang_sense_clarification": "指缺乏专业知识"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4603b43b-196c-37b1-9d2d-963024376b49",
                    "sense_definition": "To become bushy or thick.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When the cat gets angry, its tail will <w>bush</w> out to make it look bigger.",
                            "target_lang_translations": {
                                "ru": "Когда кот злится, его хвост <w>распушается</w>, чтобы казаться больше.",
                                "zh": "当猫生气时，它的尾巴会<w>蓬松</w>起来，让自己看起来更大。"
                            }
                        },
                        {
                            "text": "His hair tends to <w>bush</w> up in the humidity.",
                            "target_lang_translations": {
                                "ru": "Его волосы имеют тенденцию <w>пушиться</w> при влажности.",
                                "zh": "他的头发在潮湿环境下容易<w>炸开</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Становиться густым или пушистым.",
                        "zh": "变得浓密或蓬松。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "распушаться",
                                "target_lang_sense_clarification": "о волосах или шерсти"
                            },
                            {
                                "target_lang_word": "густеть",
                                "target_lang_sense_clarification": "становиться густым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "蓬松",
                                "target_lang_sense_clarification": "形容毛发状态"
                            },
                            {
                                "target_lang_word": "炸开",
                                "target_lang_sense_clarification": "形容毛发竖起变厚"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "646b837e-1d9d-3fb9-bf86-8c50ad18ada1",
                    "sense_definition": "Towards the direction of the outback or wild country.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the meeting, they decided to head <w>bush</w> for a quiet weekend.",
                            "target_lang_translations": {
                                "ru": "После встречи они решили отправиться <w>в глушь</w> на тихие выходные.",
                                "zh": "会议结束后，他们决定去<w>野外</w>度过一个安静的周末。"
                            }
                        },
                        {
                            "text": "The animals scramble to the surface and immediately go <w>bush</w>.",
                            "target_lang_translations": {
                                "ru": "Животные выбираются на поверхность и тут же убегают <w>в заросли</w>.",
                                "zh": "动物们爬到地面上，随即逃向<w>野外</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go bush",
                        "head bush"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia, New Zealand"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В направлении малонаселенной или дикой местности.",
                        "zh": "朝向荒野或偏远地区的方向。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "в глушь",
                                "target_lang_sense_clarification": "в удаленное место"
                            },
                            {
                                "target_lang_word": "в дикую местность",
                                "target_lang_sense_clarification": "на природу"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "野外",
                                "target_lang_sense_clarification": "指偏远地区"
                            }
                        ]
                    }
                }
            ]
        }
    ]
