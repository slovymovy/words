{
    "word_family": [
        "enhance",
        "enhancement",
        "enhancer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "5117c51a-401c-396e-be5e-2dfe0f925a3e",
                    "sense_definition": "present participle and gerund of <w>enhance</w>",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new software is <w>enhancing</w> the speed of our daily operations.",
                            "target_lang_translations": {
                                "ru": "Новое программное обеспечение <w>увеличивает</w> скорость наших ежедневных операций."
                            }
                        },
                        {
                            "text": "She is <w>enhancing</w> her skills by taking an advanced evening course.",
                            "target_lang_translations": {
                                "ru": "Она <w>совершенствует</w> свои навыки, посещая продвинутые вечерние курсы."
                            }
                        }
                    ],
                    "common_phrases": [
                        "enhancing performance",
                        "enhancing quality"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс улучшения или увеличения чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "процесс повышения качества или эффективности"
                            },
                            {
                                "target_lang_word": "повышение",
                                "target_lang_sense_clarification": "увеличение уровня или степени чего-либо"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "da8360f1-29f5-34a2-9988-cbbda58539bf",
                    "sense_definition": "Serving to improve the quality, value, or extent of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>enhancing</w> effect of the new lighting made the room look much larger.",
                            "target_lang_translations": {
                                "ru": "<w>Улучшающий</w> эффект нового освещения сделал комнату визуально намного больше."
                            }
                        },
                        {
                            "text": "They implemented an <w>enhancing</w> strategy to boost overall productivity.",
                            "target_lang_translations": {
                                "ru": "Они внедрили <w>улучшающую</w> стратегию для повышения общей производительности."
                            }
                        }
                    ],
                    "synonyms": [
                        "improving",
                        "beneficial"
                    ],
                    "antonyms": [
                        "detracting",
                        "damaging"
                    ],
                    "common_phrases": [
                        "enhancing factor",
                        "enhancing effect"
                    ],
                    "target_lang_definitions": {
                        "ru": "служащий для улучшения качества, ценности или масштаба чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшающий",
                                "target_lang_sense_clarification": "прилагательное, описывающее действие по улучшению"
                            },
                            {
                                "target_lang_word": "повышающий",
                                "target_lang_sense_clarification": "прилагательное, описывающее действие по увеличению эффективности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "921f22dd-4641-39d5-ac3d-7075b859c660",
                    "sense_definition": "The process of making something better or more valuable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>enhancing</w> of the city park has made it a popular destination for families.",
                            "target_lang_translations": {
                                "ru": "<w>Улучшение</w> городского парка сделало его популярным местом для семейного отдыха."
                            }
                        },
                        {
                            "text": "Constant <w>enhancing</w> of the security system is necessary to prevent unauthorized access.",
                            "target_lang_translations": {
                                "ru": "Постоянное <w>совершенствование</w> системы безопасности необходимо для предотвращения несанкционированного доступа."
                            }
                        }
                    ],
                    "synonyms": [
                        "improvement",
                        "augmentation"
                    ],
                    "common_phrases": [
                        "enhancing of"
                    ],
                    "target_lang_definitions": {
                        "ru": "процесс придания чему-либо лучшего качества или большей ценности"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "улучшение",
                                "target_lang_sense_clarification": "общий процесс совершенствования"
                            },
                            {
                                "target_lang_word": "совершенствование",
                                "target_lang_sense_clarification": "процесс доведения до более высокого уровня"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}