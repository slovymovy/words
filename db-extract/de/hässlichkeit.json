                        ],
                        "form": "die Hässlichkeiten"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                        "glosses": [
                            "unschönes Aussehen"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9e3f6dec-5a66-47dc-85d7-fb4ce1f96d91",
                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                "text": "Die Hässlichkeit der neuen Magd ist unbeschreiblich."
                            },
                            {
                                "example_id": "842582b7-7c09-4f22-95a7-162f876eccd9",
                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                "text": "Der neue Nachbar hat ein Gesicht von bemerkenswerter Hässlichkeit."
                            },
                            {
                                "example_id": "3d004bb4-3445-452b-8022-d489c3f33d8d",
                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                "text": "„Henriette war überzeugt, dass die Ursache seiner Hässlichkeit in dem Missverhältnis zwischen Augen und Mund bestand.“"
                            },
                            {
                                "example_id": "122bf32f-2eb2-44f8-8416-56449e374f22",
                                "sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                                "text": "„Aber seltsamer Weise findet er jetzt die Öde und Hässlichkeit Ostberlins weit weniger deprimierend als damals.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "03cae497-6ab3-388a-9f7f-7ccb4392159f",
                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                        "glosses": [
                            "üble Gesinnung, die sich auf die Mitmenschen negativ auswirkt"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "9f3f1d12-8c0b-4de2-bc5d-7b4fda34359c",
                                "sense_id": "03cae497-6ab3-388a-9f7f-7ccb4392159f",
                                "text": "Dass dein Kollege dich immerzu anschwärzt, zeigt seine ganze Hässlichkeit."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                        "entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                        "glosses": [
                            "Handlung, die für andere ein Grund zum Unmut ist"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "179eed73-245c-43fb-8639-dad30389aac2",
                                "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                                "text": "Lilo hatte während der vergangenen Jahre so einige Hässlichkeiten seitens ihres Ehemannes zu ertragen."
                            },
                            {
                                "example_id": "25f9de68-670a-456a-ae42-20b9905466e5",
                                "sense_id": "541effdf-9071-3693-a11c-b653f3e6d33e",
                                "text": "Herr Müller regt sich über jede Kleinigkeit auf und übt Rache, indem er sich allerhand Hässlichkeiten ausdenkt."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5afdac0-53f5-4a01-a038-b9f28a949d7c",
                        "source_entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                        "source_sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                        "source_sense_description": "ohne Plural: unschönes Aussehen",
                        "target_lang_word": "ugliness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ugliness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "The condition of being ugly."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2738c4d-b956-4397-8fd5-1c0c561c6455",
                                                "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                                "text": "His best friend would not have called him good-looking, but he was the fortunate possessor of that cheerful type of ugliness which inspires immediate confidence in its owner."
                                            },
                                            {
                                                "example_id": "a584beef-bf3f-4a43-afb4-2aec0d103c72",
                                                "sense_id": "f870880a-0bb0-3c8b-aefc-046221fb3fa9",
                                                "text": "Everything that's realistic has some sort of ugliness in it. Even a flower is ugly when it wilts, a bird when it seeks its prey, the ocean when it becomes violent. Sharon Tate"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48fe9cab-7244-3efb-b810-4e034c0615e0",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "An unsightly or frightful object."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "626e06f0-fe4e-3ffa-8a82-d7f9a25267e9",
                                        "entry_id": "01a25a73-9c16-3e92-a4a6-ef2e58fef1cf",
                                        "glosses": [
                                            "Unpleasant behaviour."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4f26d56-d656-4c84-b4bc-0286925f696f",
                                                "sense_id": "626e06f0-fe4e-3ffa-8a82-d7f9a25267e9",
                                                "text": "There was some ugliness at the council meeting."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15d8f3f8-72ee-4e64-8d8c-3c9b6e87ad32",
                        "source_entry_id": "5365e2a1-7a73-36d0-a952-d7486ddc8c00",
                        "source_sense_id": "aa1d4a44-4260-310a-a4f6-0292001e3752",
                        "source_sense_description": "ohne Plural: unschönes Aussehen",
                        "target_lang_word": "laideur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laideur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                        "entry_id": "bf8a3fe0-8226-3a79-afd6-b1bd67c1cadf",
                                        "glosses": [
                                            "État de ce qui est laid."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "642385a6-61d1-4fd5-bbcd-6a80710fd032",
                                                "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                                "text": "Mais je déclare que Durandeau a bien mérité de la France, en mettant en circulation dans le commerce cette matière morte jusqu’à ce jour, qu’on appelle laideur. Entendons-nous, c’est de la laideur laide que je veux parler, de la laideur franche, vendue loyalement pour de la laideur."
                                            },
                                            {
                                                "example_id": "7c42a599-9866-40f2-9d1d-dc9ca39bcd63",
                                                "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                                "text": "La beauté et la laideur sont relatives à qui les contemple, et nos visages diffèrent selon les jugements qu’on en porte. Les plus beaux êtres sont ceux qui recueillent les admirations les plus nombreuses. Mais ils sont beaux aussi, les vilains pour qui une admiration, même isolée, remplace l’éloge des foules."
                                            },
                                            {
                                                "example_id": "d3218de8-bf17-491d-8160-eeac386a37b7",
                                                "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                                "text": "Elle fit sans doute une forte impression sur l’esprit du savant italien, car celui-ci, tout de suite après les compliments, parla d’elle avec cet intérêt qu’inspire la laideur, quand elle est grande et terrible."
                                            },
                                            {
                                                "example_id": "a68753c0-c25d-4996-9b8a-3077ccffd2e7",
                                                "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                                "text": "Aucun objet que de Saint-Sulpice : la pire des laideurs – celle que crée le manque de culture."
                                            },
                                            {
                                                "example_id": "e40f9909-8690-4c73-97f2-fda606634f7c",
                                                "sense_id": "54e1b4ff-411c-3827-83d8-63e055a3f525",
                                                "text": "Elle débuta par une de ses citations préférées d'Oscar Wilde – « La mode est une forme de laideur si intolérable que nous devons en changer tous les six mois » – et enchaîna avec une de ses plaisanteries bien rôdées : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "db6b16a4-b0ad-3543-9ca9-e5c73a88584d",
                                        "entry_id": "bf8a3fe0-8226-3a79-afd6-b1bd67c1cadf",
                                        "glosses": [
                                            "Se dit en parlant des vices et des actions vicieuses ou malhonnêtes."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66580813-b172-4a24-b54b-3ce5de3507d2",
                                                "sense_id": "db6b16a4-b0ad-3543-9ca9-e5c73a88584d",
                                                "text": "La plus part des Princes ne voyent la laideur de leurs actions que sous des mots spécieux , & que sous des raisons sophystiques : Quand ils font des leuées excessiues, on leur dit que les imposts sont les soustiens de la domination, […]."
                                            },
                                            {
                                                "example_id": "100df784-1706-4f49-a611-e4c17248d44f",
                                                "sense_id": "db6b16a4-b0ad-3543-9ca9-e5c73a88584d",
                                                "text": "Il avait tout perdu dans ces pérégrinations, foi, honneur, fierté, et n’avait conservé que les desseins de faire le mal inspiré par les démons de l’enfer. Il eut bientôt fait de se faire connaître et par ses propos impurs et blasphématoires et dévoilé la laideur de son âme basse et perfide."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12b3bc56-d953-38dc-83b0-09f90e2e7b8a",
                                        "entry_id": "bf8a3fe0-8226-3a79-afd6-b1bd67c1cadf",
                                        "glosses": [
                                            "Chose laide."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31bf9c90-bb1d-47a5-ad34-6eee63a8b61b",
                                                "sense_id": "12b3bc56-d953-38dc-83b0-09f90e2e7b8a",
                                                "text": "[…] ; les ruelles étranges s’animent, s’emplissent, sous le soleil, de parasols bariolés. Le défilé des laideurs commence, des laideurs inadmissibles ; le défilé des longues robes de magot surmontées de chapeaux melons ou canotiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "049c1a35-ba29-3bfd-896a-3ad2431a64c0",
                                        "entry_id": "bf8a3fe0-8226-3a79-afd6-b1bd67c1cadf",
                                        "glosses": [
                                            "Personne laide ; individu laid"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ee5e8a8-0f18-4b3d-b4b0-ed394d97119f",
                                                "sense_id": "049c1a35-ba29-3bfd-896a-3ad2431a64c0",
                                                "text": "Florent, dans son ardeur, n'avait-il pas laissé échapper qu'il était une laideur qui, à son point de vue d'artiste, surpassait ce que le monde appelait beauté ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
