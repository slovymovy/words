                "word": "nonaligned",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "efe2e838-11fa-3f60-85e6-e57d50e96c1a",
                        "entry_id": "4efd0df5-0d17-3ffb-938c-30c4e7fa46f6",
                        "glosses": [
                            "Not allied with any particular nation, or with any side in a dispute."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "09dabcd8-6a5b-3506-b311-869fd9cbfe83",
                        "entry_id": "4efd0df5-0d17-3ffb-938c-30c4e7fa46f6",
                        "glosses": [
                            "Neutral; impartial."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3baad268-391d-4e7b-8920-0f29f6f867d2",
                        "source_entry_id": "4efd0df5-0d17-3ffb-938c-30c4e7fa46f6",
                        "source_sense_description": "not allied",
                        "target_lang_word": "non-aligné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "non-aligné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6eec0197-ab07-3138-bbc0-bf05dab22f94",
                                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                                        "glosses": [
                                            "Qui n’est pas dans un alignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d32ab486-a132-4451-bbb4-6b407010cd05",
                                                "sense_id": "6eec0197-ab07-3138-bbc0-bf05dab22f94",
                                                "text": "Cette homothétie envoie tout point B non-aligné avec O, M et N sur le point d’intersection de la droite (0B)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                                        "glosses": [
                                            "Indépendant des États-Unis et de l’Union soviétique lors de la Guerre froide."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb9a8a3-c0d1-4005-b04b-084d09fd8988",
                                                "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                                                "text": "Pays non-aligné pendant la Guerre froide, le Cap-Vert de Pereira chercha à soutenir la paysannerie dans ses réformes économiques."
                                            },
                                            {
                                                "example_id": "f33856c5-8ec7-4c19-895f-96b7f686a360",
                                                "sense_id": "7756e873-2b8e-39e4-a94f-bee18d8a89f3",
                                                "text": "Outre les pays membres de l’Otan, la Finlande et la Suède, deux nations officiellement non-alignées mais où le débat sur une adhésion a été relancé par l’invasion russe en Ukraine, devraient envoyer un contingent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28c6cbae-5739-37db-a2a6-1c5c9707db91",
                                        "entry_id": "6df489fd-3656-3490-807c-6e1d196f7192",
                                        "glosses": [
                                            "Qui n’est pas inféodé à une puissance ou un parti."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4450567a-d93b-46e1-ac4b-c6d3fd2aac3a",
                                                "sense_id": "28c6cbae-5739-37db-a2a6-1c5c9707db91",
                                                "text": "Le Parti communautaire national-européen est une organisation non-alignée dont le siège est à Bruxelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9552bfe2-e4e7-42e1-a2c4-10dbc2672c1b",
                        "source_entry_id": "4efd0df5-0d17-3ffb-938c-30c4e7fa46f6",
                        "source_sense_description": "not allied",
                        "target_lang_word": "bündnisfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bündnisfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea1be42c-c133-30da-9f0d-2495e74dd1a1",
                                        "entry_id": "9c5a9148-688b-3696-a318-9038b79cd892",
                                        "glosses": [
                                            "sich in keinem Bündnis befindend, keinem Bündnis angehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2c6ef02-6502-4bbf-8e0d-1c88ba1c0357",
                                                "sense_id": "ea1be42c-c133-30da-9f0d-2495e74dd1a1",
                                                "text": "Dieses Land ist militärisch bündnisfrei."
                                            },
                                            {
                                                "example_id": "e89cb5a4-fc25-49f4-a4f3-0f315b8f41e0",
                                                "sense_id": "ea1be42c-c133-30da-9f0d-2495e74dd1a1",
                                                "text": "Um ihre Neutralität zu wahren, bleiben sie bündnisfrei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0ae04a0-0f0e-4489-9ef1-e703ac5ea3a6",
                        "source_entry_id": "4efd0df5-0d17-3ffb-938c-30c4e7fa46f6",
                        "source_sense_description": "not allied",
                        "target_lang_word": "blockfrei",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blockfrei",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1627614c-3753-30d9-9993-bbfd26d6fb50",
                                        "entry_id": "9c0374ec-42da-3ff5-ba58-be70ef0eb63b",
                                        "glosses": [
                                            "keinem Block angehörend, neutral"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c1cfca-2a25-48b7-95b0-be22e57fd599",
                                                "sense_id": "1627614c-3753-30d9-9993-bbfd26d6fb50",
                                                "text": "„Nach seiner Rückkehr nach Istanbul musste Taylor feststellen, dass sich bei der CIA in diesem Sommer alles nur um eines drehte: um die Konferenz der blockfreien Staaten in Havanna.“"
                                            },
                                            {
                                                "example_id": "f0ab2a07-4f97-4f8c-96da-1dcf25415847",
                                                "sense_id": "1627614c-3753-30d9-9993-bbfd26d6fb50",
                                                "text": "„Ägypten bemühte sich hierfür um ausländische Wirtschaftshilfe, während es gleichzeitig versuchte, im Kalten Krieg blockfrei zu bleiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
