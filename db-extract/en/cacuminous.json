                "senses": [
                    {
                        "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                        "entry_id": "78d16d21-7c31-38d2-bd34-0c14e94020ca",
                        "glosses": [
                            "Having a pyramidal top."
                        ],
                        "tags": [
                            "not-comparable",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ca07f5-5fdc-4bb1-b638-7e64dd93062e",
                                "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                                "text": "Cleopatra’s Needles are three cacuminous monoliths first erected in Ancient Egypt over a thousand years before the birth of Christ."
                            },
                            {
                                "example_id": "4a454477-c08a-46e0-92e6-657c0545c633",
                                "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                                "text": "[A]s the snow advanced vpon yᵉ poynts vertical of cacuminous mountains dissolveth and discoagulateth it self into humorous liquidity[.]"
                            },
                            {
                                "example_id": "38aa0a35-795a-4d7b-8cbf-3b691e075eaa",
                                "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                                "text": "Equally so as it ha been in his own, over the estuous rivers of Lapland, or its frozen and cacuminous mountains;"
                            },
                            {
                                "example_id": "79dbc7d1-ba75-48fe-a6a6-c78f2a07f017",
                                "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                                "text": "Hours Of youth…and love ‛neath trees cacuminous."
                            },
                            {
                                "example_id": "22ad4961-4e5a-4032-948b-98c383c9197c",
                                "sense_id": "dcca1946-de9e-3f66-aeb0-611eebe57b62",
                                "text": "Luminous books (not voluminous) To read under beech-trees cacuminous."
                            }
                        ]
                    }
