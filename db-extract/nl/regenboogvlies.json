                            {
                                "target_word": "iris",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3436bb1c-2e5e-3e61-8b15-b627b91660a8",
                                        "entry_id": "723c94f6-0cc1-36f5-bb4d-ebb06514c7f1",
                                        "glosses": [
                                            "To open or close in the manner of an iris."
                                        ],
                                        "tags": [
                                            "of an aperture"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc03e48b-bb74-3bb5-a252-ed8540d09fd6",
                                        "entry_id": "723c94f6-0cc1-36f5-bb4d-ebb06514c7f1",
                                        "glosses": [
                                            "To cause (something) to shine with the colours of the rainbow; to make iridescent."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ac36ae1-700a-4d14-a6d0-376c3f8ab205",
                                                "sense_id": "cc03e48b-bb74-3bb5-a252-ed8540d09fd6",
                                                "text": "Pure, transparent, glistening in the sun, and irised by a thousand hues, which float and wave and spread in graceful and ceaseless motion on its surface!"
                                            },
                                            {
                                                "example_id": "d780640e-d80e-42c7-be41-0aa9706b0dc1",
                                                "sense_id": "cc03e48b-bb74-3bb5-a252-ed8540d09fd6",
                                                "text": "The sun as it comes indoors out of space\nHas left a rainbow irising each glass—\nA refraction, caught then multiplied\nFrom the crystal tied within our window,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "67f14ed2-5cc6-4b1a-913f-58a8362d8b03",
                        "source_entry_id": "a87cc216-91b2-3d93-8847-b8119e20d324",
                        "source_sense_id": "8acbb617-220b-3bf9-99fa-31b8065ed87a",
                        "source_sense_description": "het gekleurde vlies in het oog waarin de pupil zich bevindt",
                        "target_lang_word": "iris",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "iris",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6e97fbf4-c4cf-3f7a-9724-2307a9555e11",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "Partie colorée de l’œil qui environne la prunelle et qui présente quelquefois des nuances circulaires et concentriques."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0a09ad1a-65d7-4fd4-b396-fae0779e156f",
                                                "sense_id": "6e97fbf4-c4cf-3f7a-9724-2307a9555e11",
                                                "text": "Cette affection est caractérisée par une sensibilité exagérée de l'œil à la lumière; de là une contraction spasmodique de l’iris, quelquefois avec occlusion complète de la pupille, de sorte que les personnes nyctalopes voient très-bien pendant la nuit, mais cessent de voir pendant le jour."
                                            },
                                            {
                                                "example_id": "f15cdf20-e607-4043-ae52-fbd467ab0cc0",
                                                "sense_id": "6e97fbf4-c4cf-3f7a-9724-2307a9555e11",
                                                "text": "On remarquera par ailleurs que l’iris de cet œil est hétérochrome. Il est pigmenté en brun, mais aussi en bleu."
                                            },
                                            {
                                                "example_id": "bb43ac8f-c819-489a-af74-7ee40c839eec",
                                                "sense_id": "6e97fbf4-c4cf-3f7a-9724-2307a9555e11",
                                                "text": "Mais c’était l’irrégularité de la couleur de ses iris, l’un bleu pâle et l’autre jaune, qui achevait de conférer à son visage une étrangeté indéfinissable."
                                            },
                                            {
                                                "example_id": "b539d0da-37a1-4cff-838a-1a683aaf3aad",
                                                "sense_id": "6e97fbf4-c4cf-3f7a-9724-2307a9555e11",
                                                "text": "Grégoire ne se rappelait pas à quel moment les yeux de son père s’étaient vidés de leur couleur. À un certain moment, une buée grisâtre avait recouvert l’iris brun, le regard était devenu transparent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "329e2290-f9b1-3522-9a58-cfbb17101d49",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "Système mécanique constitué de plaques assemblées en cercle, permettant par un mécanisme d’obturer l’ouverture centrale progressivement en lui conservant la forme d’un cercle."
                                        ],
                                        "tags": [
                                            "Par analogie avec le sens 1"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29916b71-71fa-4bc0-b2f5-e4433fc486f7",
                                                "sense_id": "329e2290-f9b1-3522-9a58-cfbb17101d49",
                                                "text": "Diaphragme à iris, iris d’un appareil photo."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "Genre de plantes monocotylédones à fleur de couleur vive et de bonne taille."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff3964a2-1c48-4865-9daa-c80273a5029b",
                                                "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                                "text": "Juliette avait tenu aussi à ranger elle-même mes affaires, dans l’armoire, qu’elle bourrait de paquets d’iris."
                                            },
                                            {
                                                "example_id": "0be6b029-bf4c-4a98-825a-b2b9e5c6d251",
                                                "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                                "text": "Les toits de chaume des bâtiments, au sommet desquels poussaient des iris aux feuilles pareilles à des sabres, fumaient un peu comme si l’humidité des écuries et des granges se fût envolée à travers la paille."
                                            },
                                            {
                                                "example_id": "a579b9da-4524-415f-a30e-a83e85b95b4d",
                                                "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                                "text": "Sa biodiversité est exceptionnelle : hérons, aigrettes, poules d’eau, mais aussi orchidées sauvages, iris jaunes, roseaux…"
                                            },
                                            {
                                                "example_id": "3df5d251-3056-4275-88cb-c1b1c2502a0a",
                                                "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                                "text": "Au milieu de la mousse espagnole et des lentilles d'eau s'épanouissent la jacinthe d'eau et l'iris bleu, emblème de la Louisiane."
                                            },
                                            {
                                                "example_id": "299b1fb3-0b93-4ed4-a99d-0d87ece937ed",
                                                "sense_id": "8bcfc827-f6f7-3e18-a5d4-05cdbec61264",
                                                "text": "J'ose même suggérer que, tout comme cette fleur est hors du commun, il en va de même pour les amoureux des iris : des personnes extravagantes, un peu bizarres, une espèce à part. Je me demande d'ailleurs si c'est l'excentricité qui les attire vers les fleurs ou le contraire. Chaque jardin exerce son influence sur l'âme, mais les cultivateurs et les passionnés d'iris sortent du lot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e37f4964-7241-32b7-abaf-42dff5e5efab",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "La racine de cet iris dans ses emplois en parfumerie."
                                        ],
                                        "tags": [
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51ac76be-326a-4f39-839c-205d4160934b",
                                                "sense_id": "e37f4964-7241-32b7-abaf-42dff5e5efab",
                                                "text": "Poudre à poudrer […] sur huit livres, on mêle une livre d’iris, racine qui sent naturellement la violette […]"
                                            },
                                            {
                                                "example_id": "f0c8e13d-d5d8-4b5b-82d7-236fd27d665d",
                                                "sense_id": "e37f4964-7241-32b7-abaf-42dff5e5efab",
                                                "text": "Je la serre d’un peu près pour ne pas perdre le rythme, enveloppé d’un frais parfum mêlé de crème Tokalon et de poudre à l’iris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9771cec4-b146-3d46-ba02-033f0ef44a30",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "Arc-en-ciel, en référence à Iris dans la mythologie grecque à laquelle ce phénomène est associé."
                                        ],
                                        "tags": [
                                            "dated",
                                            "literary"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c73b3275-d9c2-363c-bbc5-766ce574a9d7",
                                        "entry_id": "4e14e157-f1c1-3704-b286-d1a46b171913",
                                        "glosses": [
                                            "Pierre d’iris, iris : Quartz irisé."
                                        ],
                                        "tags": [
                                            "Par analogie avec le sens 5"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
