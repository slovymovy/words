                ],
                "senses": [
                    {
                        "sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
                        "entry_id": "3c61c042-fbb6-303c-80bd-f27f07861d7a",
                        "glosses": [
                            "Relatif à la dynastie des Habsbourgs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8391ab2a-4fd7-4324-a626-5bb19e4f9e2f",
                                "sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
                                "text": "Dès qu'on le regarde mieux, on retrouve vite chez lui la tare habsbourgeoise qui, comme la lèvre proéminente de la famille se transmet de génération en génération : l'orgueil impérial, la volonté implacable de domination et le fanatisme de l'Allemagne."
                            },
                            {
                                "example_id": "bc08ae6c-3417-4eb8-8809-eacc13d49c87",
                                "sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
                                "text": "Finalement, Frédéric dut se contenter de recevoir les fiefs habsbourgeois."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61d866d3-0ca2-4ae7-b555-89aaaa2811a7",
                        "source_entry_id": "3c61c042-fbb6-303c-80bd-f27f07861d7a",
                        "source_sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
                        "target_lang_word": "habsburgisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e595f8d7-9188-40a5-89d1-00da2a857476",
                        "source_entry_id": "3c61c042-fbb6-303c-80bd-f27f07861d7a",
                        "source_sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
                        "target_lang_word": "Habsburgian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Habsburgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "08c0c31c-db4b-374d-996d-cf2db81c6f17",
                                        "entry_id": "07c09627-a134-3e81-8ca2-a33aaeeea9ff",
                                        "glosses": [
                                            "Of or pertaining to (either branch of) the House of Habsburg, to the Habsburg Monarchy or to the rule of individual Habsburgs."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "259117a6-e5b8-4ad0-b4e5-c9e1c9c2ddc3",
                                                "sense_id": "08c0c31c-db4b-374d-996d-cf2db81c6f17",
                                                "text": "It was an attempt to preserve the teutsche Libertät, the autonomy of the imperial Estates against Habsburgian efforts to gain absolute power."
                                            },
                                            {
                                                "example_id": "8d768730-d46e-4296-ac47-e434adb4df83",
                                                "sense_id": "08c0c31c-db4b-374d-996d-cf2db81c6f17",
                                                "text": "They most commonly employed a Habsburgian notion of state and society in which authorities were understood to be guardians of Indians, part of a pact between crown and subjects."
                                            },
                                            {
                                                "example_id": "89c05a4a-246a-43a5-b85d-07adac887d18",
                                                "sense_id": "08c0c31c-db4b-374d-996d-cf2db81c6f17",
                                                "text": "From that time on and for over a century and a half, the struggle against this “Habsburgian noose” and against the threat of a Habsburgian universal monarchy became the main concern of French foreign policy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Habsburgian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e07608f-2fb5-3051-989a-a77b6d3b9ad8",
                                        "entry_id": "31bbd1ac-7368-367d-bd10-0cef195c7ecd",
                                        "glosses": [
                                            "A Habsburg, a member of the Habsburg dynastic family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "028a41a7-9811-487b-924b-004d362b89b9",
                                                "sense_id": "2e07608f-2fb5-3051-989a-a77b6d3b9ad8",
                                                "text": "Before that time the Habsburgians had been for centuries the emperors of the German Holy Roman Empire until they were deposed by Napoleon in 1806."
                                            },
                                            {
                                                "example_id": "8daa592d-3f92-4ef0-8bc7-cb1419067387",
                                                "sense_id": "2e07608f-2fb5-3051-989a-a77b6d3b9ad8",
                                                "text": "The successors to Ferdinand of Aragon as kings of Spain were the Habsburgians Charles I (1516-1556, since 1519 Roman Emperor Charles V), Philipp II (1556-1598), Philipp III (1598-1621), the dedicatee of Stella's Columbeis (see above, pp. 456 ff.), Philipp IV (1621-1665), Charles II (1665-1700), and Philipp V (1701-1746)."
                                            },
                                            {
                                                "example_id": "322a506b-3c8c-48b0-9140-008d5f2aed5c",
                                                "sense_id": "2e07608f-2fb5-3051-989a-a77b6d3b9ad8",
                                                "text": "They did not imitate the image policy of the Constantinople emperors but that of the Habsburgians, saying that they were the equals of the Habsburgs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8fc89fbf-97ca-481c-af82-3f8c373c7d8c",
                        "source_entry_id": "3c61c042-fbb6-303c-80bd-f27f07861d7a",
                        "source_sense_id": "b2706993-4390-3ed7-a17e-16dd848eda0d",
