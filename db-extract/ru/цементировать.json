                                        "entry_id": "7dda9658-6665-3dee-8bf0-c4acd65b7217",
                                        "glosses": [
                                            "etwas mit Zement befestigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c46be871-130c-4e5e-a63d-2feb862d2e13",
                                                "sense_id": "78cb0b75-9242-3ceb-a86f-29a23b1cfc30",
                                                "text": "Die Pfeiler für den Zaun werden in den Boden zementiert."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d64b84fd-4411-3258-b321-e1660deefb01",
                                        "entry_id": "7dda9658-6665-3dee-8bf0-c4acd65b7217",
                                        "glosses": [
                                            "für lange Zeit unveränderlich machen"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0a4c0e8-e77c-444c-9166-06ae6a316996",
                                                "sense_id": "d64b84fd-4411-3258-b321-e1660deefb01",
                                                "text": "Die Regeln und Sitten sollen die gesellschaftlichen Zustände zementieren"
                                            },
                                            {
                                                "example_id": "8c35b89e-8d7c-48fe-8b44-6caf4ea187d5",
                                                "sense_id": "d64b84fd-4411-3258-b321-e1660deefb01",
                                                "text": "Die Militärführung versucht mit allen Mitteln ihren Machtanspruch zu zementieren."
                                            },
                                            {
                                                "example_id": "0f17562c-a100-49e6-b2b7-86a525cb7a71",
                                                "sense_id": "d64b84fd-4411-3258-b321-e1660deefb01",
                                                "text": "„Damit wurde die aristokratische Prägung der römischen Republik bis zu deren Untergang zementiert.“"
                                            },
                                            {
                                                "example_id": "6b81dc1f-4ede-413d-9ed9-f35ff4b633e6",
                                                "sense_id": "d64b84fd-4411-3258-b321-e1660deefb01",
                                                "text": "„Sobald diese Abhängigkeit zementiert war, fielen plötzlich die günstigen Konditionen weg. Genau das passiert CERN jetzt auch mit Microsoft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
