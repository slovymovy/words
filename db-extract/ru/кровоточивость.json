                                    {
                                        "sense_id": "9fc836da-8ebb-31ff-9702-553fd21baf97",
                                        "entry_id": "03d58ff4-9e2a-37aa-aba5-658f5008048c",
                                        "glosses": [
                                            "Écoulement, épanchement de sang, principalement par le nez."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "76cb38b7-84a2-4eb1-8aa5-622ba7c9f522",
                                                "sense_id": "9fc836da-8ebb-31ff-9702-553fd21baf97",
                                                "text": "Vers cette époque, et sans doute à cause de l’état de fatigue où je me trouvais, je fus victime de saignements assez violents."
                                            },
                                            {
                                                "example_id": "283483e3-7f9f-49c5-b8ee-09c68849bc0c",
                                                "sense_id": "9fc836da-8ebb-31ff-9702-553fd21baf97",
                                                "text": "Oui, tout va bien, madame Deck, vous pouvez arrêter les anticoagulants, c’est à cause d’eux que vous avez ce vilain saignement sous-cutané, de toute façon vous avez rendez-vous avec la cardiologue la semaine prochaine pour faire le point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bb0b7f21-5b6d-4b4b-9bfb-cea8c103ad3e",
                        "source_entry_id": "ab2906bd-b541-3d03-91ca-74384d768e77",
                        "source_sense_id": "4c7e9194-133c-3611-9269-8828ca689888",
                        "target_lang_word": "hémophilie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hémophilie",
