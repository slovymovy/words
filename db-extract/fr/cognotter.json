                        "sense_id": "80db26e5-9036-30a4-a935-80f6bd0ac7b3",
                        "entry_id": "8105ec58-b8ab-37cc-a97b-ac8b3ceb361e",
                        "glosses": [
                            "Cogner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4af135d-b9f1-4a86-842b-4884123a2376",
                                "sense_id": "80db26e5-9036-30a4-a935-80f6bd0ac7b3",
                                "text": "La sueur connote l’effort, les forts cognottent les faibles, c’est connu."
                            },
                            {
                                "example_id": "b53f7aa0-0084-4689-9760-e0916826df78",
                                "sense_id": "80db26e5-9036-30a4-a935-80f6bd0ac7b3",
                                "text": "L’ex-feldwebel, dressé à l’allemande, court, jappe, cognotte du poing à tort et à travers."
                            },
                            {
                                "example_id": "5d41a0c4-4a17-4fc6-a579-1abf36c67b03",
                                "sense_id": "80db26e5-9036-30a4-a935-80f6bd0ac7b3",
                                "text": "L’ondin gras prend un marteau à manche d’acajou déposé sur un rocher, &, avant de quitter la place, il cognotte çà & là, recueillant précieusement les esquilles de granit détachés par son marteau, sans doute pour les examiner plus tard à loisir."
                            }
                        ]
                    },
                    {
                        "sense_id": "3bdd5367-a439-3edb-896e-25217c1251c7",
                        "entry_id": "8105ec58-b8ab-37cc-a97b-ac8b3ceb361e",
                        "glosses": [
                            "Puer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ffaf304-a9b2-4e41-b10a-0734b106a30b",
                                "sense_id": "3bdd5367-a439-3edb-896e-25217c1251c7",
                                "text": "Ram’nez-vous que j’vous dis ! Merde ! Si ça cognotte, ici…"
                            },
                            {
                                "example_id": "a1f6399b-fb60-4dfe-a558-01b7be0492c9",
                                "sense_id": "3bdd5367-a439-3edb-896e-25217c1251c7",
                                "text": "Parce que là, alors, ça cognotte affreux !"
                            }
                        ]
                    }
