                                "target_senses": [
                                    {
                                        "sense_id": "8e7e00b7-3303-3af8-87dc-e35c75842371",
                                        "entry_id": "ddeb0f8b-b6e3-33af-b236-866106fd90f2",
                                        "glosses": [
                                            "A picture or symbol which represents the idea of something without indicating the sequence of sounds used to pronounce it. Examples include digits, traffic signs, and graphic symbols such as @."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90540e0d-d111-4d85-97f2-4a8c962ed2c9",
                                                "sense_id": "8e7e00b7-3303-3af8-87dc-e35c75842371",
                                                "text": "Pensé tatuarme un ideograma secreto en mi hombro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b3b561ad-42ad-47e7-a1d4-ff6ddb6498af",
                        "source_entry_id": "27254d74-5e50-3ef3-a503-1fd7ffd64e10",
                        "source_sense_id": "3200a143-819e-3f9b-a1e9-f8070b14dfb2",
                        "source_sense_description": "een grafisch teken dat een voorwerp symboliseert",
