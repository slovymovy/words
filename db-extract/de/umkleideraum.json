                    },
                    {
                        "translation_id": "c42b8c98-fc6c-4c98-b2cd-62070326343b",
                        "source_entry_id": "10d38b7f-5487-37a7-914d-9048e88303d7",
                        "source_sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                        "source_sense_description": "Raum zum Umkleiden",
                        "target_lang_word": "changing room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "changing room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                        "entry_id": "bf8aef75-1713-3272-b928-408f87eb5e98",
                                        "glosses": [
                                            "A room, especially in a gym, sports center, school, swimming pool, etc, designed for people to change their clothes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8eb4f10-de56-47ae-aea9-fccddb689830",
                                                "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                                "text": "We changed into our swimsuits in the changing room next to the pool."
                                            },
                                            {
                                                "example_id": "549a1e2e-5975-4767-9a6e-421f6d06c64e",
                                                "sense_id": "f0a8b90b-7987-3bd9-90e1-499943d8e703",
                                                "text": "John Betjeman would later recall that the railway 'smelt of feet', and the carriages may have continued to smell of feet after they were taken out of service in the 1920s because some of them found use as changing rooms beside the playing fields of southern England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc6c9a30-6db5-3e19-a93e-d2ce6be96b6b",
                                        "entry_id": "bf8aef75-1713-3272-b928-408f87eb5e98",
                                        "glosses": [
                                            "A room or enclosure, e.g. in a clothes shop, where people try on clothes they are interested in buying."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "68de16d8-bfef-4b2d-9830-5cf2ec535d53",
                        "source_entry_id": "10d38b7f-5487-37a7-914d-9048e88303d7",
                        "source_sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                        "source_sense_description": "Raum zum Umkleiden",
                        "target_lang_word": "locker room",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e805344f-394e-371f-8b5b-9ad09c9391cf",
                                        "entry_id": "21d15fa9-5015-3f70-a847-855cf28897d2",
                                        "glosses": [
                                            "A room attached to an athletic, recreational, or workplace facility, filled with lockers for storage of clothing and equipment; clothes are generally changed there."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93089457-b266-46f9-9515-02d55dc9173a",
                                                "sense_id": "e805344f-394e-371f-8b5b-9ad09c9391cf",
                                                "text": "We changed into our swimsuits in the locker room next to the pool."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                        "entry_id": "3be24441-73b9-30b5-9db5-62d03363f6a8",
                                        "glosses": [
                                            "Characteristic of conversations held in locker rooms; that is boastful, juvenile, or explicitly sexual."
                                        ],
                                        "tags": [
                                            "informal",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "102b87c4-1945-480a-a863-06199ab9bdf3",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "The others tired of Frank's habitual locker-room boasting about various women he had \"scored\" with"
                                            },
                                            {
                                                "example_id": "9baef5d5-ef8c-4e0c-bf31-6031cc11b37f",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "“I think of how scary it was for me starting comedy in Chicago, and then how much scarier it would have been if I was a woman starting comedy there because it really was such a boys’ club,” he says. “It was very aggressive. It was very locker room."
                                            },
                                            {
                                                "example_id": "9cdc83c5-6876-4305-bd26-beac202ad3d5",
                                                "sense_id": "90a172c6-0914-3780-bb17-c556c92a0778",
                                                "text": "It’s in a very locker room, busting-my-stones sort of way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "locker room",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "eb850ebf-2b33-30ef-99c7-0b577c6644f4",
                                        "entry_id": "6d83bbfb-943d-3be1-88b1-0f31d9b03c66",
                                        "glosses": [
                                            "inhalants"
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5189f2bf-9f01-4f48-a3ef-ff43b677199f",
                        "source_entry_id": "10d38b7f-5487-37a7-914d-9048e88303d7",
                        "source_sense_id": "837ce45d-c1ee-3cbc-92fa-f5bbbdb7f385",
                        "source_sense_description": "Raum zum Umkleiden",
                        "target_lang_word": "vestiaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vestiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3836e95a-9509-3d2c-a8da-1832beb34f4c",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Lieu où l’on serre les habits destinés aux religieux et aux religieuses, ou les costumes des membres d’un tribunal, d’une académie, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aea17a2-1886-4b4b-8db2-51cf4e0cd7ec",
                                                "sense_id": "3836e95a-9509-3d2c-a8da-1832beb34f4c",
                                                "text": "Le vestiaire du couvent."
                                            },
                                            {
                                                "example_id": "d5d7438f-57b4-4dbb-9057-d40cba4589b8",
                                                "sense_id": "3836e95a-9509-3d2c-a8da-1832beb34f4c",
                                                "text": "Le vestiaire du tribunal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c9e9161-8eb3-3bf5-8d09-9fcbd6009a51",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Endroit où l’on dépose momentanément des vêtements, dans un théâtre, une discothèque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "374d72e2-0655-4855-b021-50c9a5d1f4a2",
                                                "sense_id": "0c9e9161-8eb3-3bf5-8d09-9fcbd6009a51",
                                                "text": "Déposer son chapeau, son manteau au vestiaire."
                                            },
                                            {
                                                "example_id": "d8eed2a6-3599-403e-af95-c8c849114f4f",
                                                "sense_id": "0c9e9161-8eb3-3bf5-8d09-9fcbd6009a51",
                                                "text": "J’aime encore mieux le vieux monsieur à barbe du vestiaire qui vous tient votre pardessus comme un reliquaire et vous le rend comme s’il allait vous le vendre très cher."
                                            },
                                            {
                                                "example_id": "551e8381-b56e-4cee-929d-925e215270df",
                                                "sense_id": "0c9e9161-8eb3-3bf5-8d09-9fcbd6009a51",
                                                "text": "Elle a tenu les emplois les plus divers, pour finir dans les vestiaires d’une boîte de nuit."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f7cdbf5-c1fa-3e4f-9d8e-ce556db1478c",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Endroit où on se change dans un gymnase, un centre sportif, une piscine, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "88e38a55-42ab-4773-8fbf-9610fa6274df",
                                                "sense_id": "9f7cdbf5-c1fa-3e4f-9d8e-ce556db1478c",
                                                "text": "Quand les catcheuses regagnèrent les vestiaires, les spectateurs se retirèrent lentement du chapiteau. Les commentaires fusèrent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc06f10b-c565-3492-9d83-f7fe88478188",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Dépense que l’on fait pour les habits des religieux et des religieuses, ou de l’Argent qu’on leur donne pour s’habiller."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f6caa77-39cf-3b94-9488-9ff3543fd8d2",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Réunions de charité où des dames s’occupent à faire des vêtements pour les pauvres et à les leur distribuer, et de l’Endroit où se tiennent ces réunions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1144c414-4984-4141-8fd5-d6c5fc1a5dc8",
                                                "sense_id": "2f6caa77-39cf-3b94-9488-9ff3543fd8d2",
                                                "text": "Le vestiaire de Mont."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e564acc2-b01f-3f85-b297-6ecb8417f688",
                                        "entry_id": "6e72415f-d8d0-3fb3-8d79-e2aaa03682d8",
                                        "glosses": [
                                            "Ensemble de vêtements."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afaa89a-3bcd-494e-bc13-d2e80f58375f",
                                                "sense_id": "e564acc2-b01f-3f85-b297-6ecb8417f688",
                                                "text": "Zara a copié des défilés, H&M et Uniqlo ont multiplié les collaborations, et les consommateurs découvert des vestiaires adaptables à toutes les silhouettes de mode et à bas prix."
                                            },
                                            {
                                                "example_id": "7ee68b55-9d1f-4e6f-9c94-f0a61fdf36e7",
                                                "sense_id": "e564acc2-b01f-3f85-b297-6ecb8417f688",
                                                "text": "Pour Delphine Lebas, le constat était simple : « un bébé change six fois de taille durant sa première année ! On a des produits qui ont habillé un bébé mais qui sont encore en parfait état. Il était naturel pour nous de proposer des vestiaires à la location »."
                                            },
                                            {
                                                "example_id": "6e66f695-e0a5-4690-b182-60cd0d77b70f",
                                                "sense_id": "e564acc2-b01f-3f85-b297-6ecb8417f688",
                                                "text": "Le vestiaire masculin a évolué vers plus de praticité et d’utilitaire au détriment de l’esthétisme à partir du XVIIIᵉ et XIXᵉ siècle, note Serge Carreira."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vestiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4c0fc3a-8cb2-3e23-a016-15b88aa12c25",
                                        "entry_id": "732810f4-7de1-348f-a84b-38dc2fd0b901",
                                        "glosses": [
                                            "Employé chargé du vestiaire, du lieu de dépôt des vêtements, dans un établissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b14afb3-32a9-43da-9da3-fed17d364b9d",
                                                "sense_id": "f4c0fc3a-8cb2-3e23-a016-15b88aa12c25",
                                                "text": "Une fois à l’intérieur et expédiées les salutations aux maîtres d’hôtel, à la caissière et à la vestiaire, elle me mena vers les coulisses."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "vestiaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4ecdd6f5-a7c5-3e19-b048-de49ae07286e",
                                        "entry_id": "cdc575dd-102a-34bf-87de-d3db5c6011e6",
                                        "glosses": [
                                            "À Byzance, désigne l’officier chargé de la garde des vêtements impériaux et qui avait pour fonction d'habiller l’empereur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
