                "senses": [
                    {
                        "sense_id": "d26c1ecb-a9fd-363b-97f3-16a1a7b5ecc0",
                        "entry_id": "e54c9f5f-9720-3166-809c-767a608e202f",
                        "glosses": [
                            "Ajouter 1 à une variable numérique après son utilisation dans une formule mathématique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3089860b-8199-4d9e-8786-4687ec1b7af7",
                                "sense_id": "d26c1ecb-a9fd-363b-97f3-16a1a7b5ecc0",
                                "text": "Dans l’exemple précédent, l’expression *p++ correspond bien (priorité des opérateurs) à *(p++) : on post-incrémente le pointeur et on lit la valeur pointée."
                            },
                            {
                                "example_id": "d0bbc465-6595-4847-a67f-ae5124ab381c",
                                "sense_id": "d26c1ecb-a9fd-363b-97f3-16a1a7b5ecc0",
                                "text": "Le Registre X peut être laissé inchangé par l’opération, ou il peut être post-incrémenté ou pré-décrémenté."
                            },
                            {
                                "example_id": "a9866698-2c69-432c-ae50-0cb552204fae",
                                "sense_id": "d26c1ecb-a9fd-363b-97f3-16a1a7b5ecc0",
                                "text": "Ce qui permet de post-incrémenter, de pré-incrémenter, de post-décrémenter ou de pré-décrémenter."
                            }
                        ]
                    }
