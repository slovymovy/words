                "senses": [
                    {
                        "sense_id": "5f060e29-ba92-307b-88cd-4d5bbb479bf7",
                        "entry_id": "622d40c9-0756-3779-94d6-a1f551eda445",
                        "glosses": [
                            "Preis, der beim Erwerb einer Immobilie gefordert/bezahlt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29c4454a-41c1-4d0f-ac99-66dcd2f402a4",
                                "sense_id": "5f060e29-ba92-307b-88cd-4d5bbb479bf7",
                                "text": "„Die in die Höhe schießenden Immobilienpreise alarmieren auch die Bundesbank.“"
                            },
                            {
                                "example_id": "b8e81270-9a07-468d-a766-8d5036264751",
                                "sense_id": "5f060e29-ba92-307b-88cd-4d5bbb479bf7",
                                "text": "„Im Iran habe ich ihn offenbar vor lauter Gerede über Immobilienpreise und Schönheitschirurgen immer überhört.“"
                            },
                            {
                                "example_id": "ac19df98-185e-45d2-ac1d-992497b4b58a",
                                "sense_id": "5f060e29-ba92-307b-88cd-4d5bbb479bf7",
                                "text": "„Seitdem waren die Immobilienpreise stetig gestiegen, aber sie lagen immer noch weit unter dem, was man in Reykjavík und Umgebung verlangte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
