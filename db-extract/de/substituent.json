                    {
                        "sense_id": "3efef701-fd2a-3859-886b-cfe263ac1592",
                        "entry_id": "4cfecf74-b668-32cc-a780-cf99b574842a",
                        "glosses": [
                            "Atom, welches ein anderes in einer chemischen Verbindung ersetzen kann, ohne dass diese zerstört wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc6f24d-3ceb-4d90-982e-9a7c20f1edf6",
                                "sense_id": "3efef701-fd2a-3859-886b-cfe263ac1592",
                                "text": "„Durch Änderungen der Substituenten am Diphenylether entstehen Herbizide, die die Biosynthese des Chlorophylls hindern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
