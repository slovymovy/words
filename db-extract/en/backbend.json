    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "2ed32ea6-96c0-3543-ba40-e6e621ee6857",
                "word": "backbend",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "8efde92b-cbcc-45f2-b5ef-dbf2ed2d6e52",
                        "entry_id": "2ed32ea6-96c0-3543-ba40-e6e621ee6857",
                        "tags": [
                            "plural"
                        ],
                        "form": "backbends"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cb62d5f0-affc-3e86-a5d1-41df6abe9c6d",
                        "entry_id": "2ed32ea6-96c0-3543-ba40-e6e621ee6857",
                        "glosses": [
                            "A move in which the performer bends backwards until the hands touch the floor or catches him/herself with the hands."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42528768-f590-4f39-868c-6b0e46bef83c",
                                "sense_id": "cb62d5f0-affc-3e86-a5d1-41df6abe9c6d",
                                "text": "The gal's backbends, the father's hoofology, the boy's fast steps and the mother's taps all won solid mitting."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "354f7f7e-d8c9-49f2-ab70-d692a658bf97",
                        "source_entry_id": "2ed32ea6-96c0-3543-ba40-e6e621ee6857",
                        "source_sense_id": "cb62d5f0-affc-3e86-a5d1-41df6abe9c6d",
                        "source_sense_description": "a gymnastics, contortion, or dance move",
                        "target_lang_word": "мост",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "мост",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "f1afdc27-0fae-3ce7-9e36-6bb2266a1c6b",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "сооружение для перехода или переезда через реку, углубление, улицу или другое поперечное препятствие"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71a6f580-7f8c-44c6-b994-78ef646840ff",
                                                "sense_id": "f1afdc27-0fae-3ce7-9e36-6bb2266a1c6b",
                                                "text": "Все, свесившись через перила моста, молчат, не двигаются и вопросительно глядят вниз на реку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c704262-d843-38d8-be27-d443b0351fea",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "устар. помост, настил из досок, брёвен и т. п."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "269dba17-610a-3425-b8fd-636425430825",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "перен. то, что является связующим звеном между кем-либо или чем-либо"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4fb0fe8-3e2b-4ac5-b8ee-2324a44da9e2",
                                                "sense_id": "269dba17-610a-3425-b8fd-636425430825",
                                                "text": "〈…〉содержание иррационально мерцает сквозь выражение и играет роль как бы моста из рационального мира в мир мистический."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8df9702-e1e1-3320-8a53-f37ecd24f1d8",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "телеком. линия дальней связи или другого взаимодействия между удалёнными точками"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0027c12-c9f2-4c48-85bd-4e8bdba42a24",
                                                "sense_id": "a8df9702-e1e1-3320-8a53-f37ecd24f1d8",
                                                "text": "Телевизионный мост Москва — Вашингтон."
                                            },
                                            {
                                                "example_id": "25e13056-1835-415a-ba6c-271868edecff",
                                                "sense_id": "a8df9702-e1e1-3320-8a53-f37ecd24f1d8",
                                                "text": "Спасатели наладили воздушный мост между городом и пострадавшим посёлком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e456e266-2356-3f24-aa27-d133f3f1fb3a",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "телеком. устройство, предназначенное для объединения двух сетей сходной конструкции в одну"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd0ad822-4385-416f-ae77-d063b2375051",
                                                "sense_id": "e456e266-2356-3f24-aa27-d133f3f1fb3a",
                                                "text": "В режиме Bridge ADSL-модем может работать в качестве прозрачного моста."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c613dbdf-deb7-334b-92cf-b64fbfb4eb23",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "мед. зубоврачевный протез, состоящий из нескольких протезов зубов, закреплённых на общем основании"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39bdb95d-2c6d-4734-9fe3-d6b5e896bd1f",
                                                "sense_id": "c613dbdf-deb7-334b-92cf-b64fbfb4eb23",
                                                "text": "Как у всех Рахленков, руки у Иосифа были золотые, дело он освоил, изготовлял коронки, мосты, протезы и всё, что требовалось для пациентов его жены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b84ac735-117c-3820-8119-977763a538e6",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "автомоб. часть шасси, узел, состоящий из двух колёс или блоков колёс, соединённых осью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62d91a71-3b0a-4baa-8dc4-549958c95e82",
                                                "sense_id": "b84ac735-117c-3820-8119-977763a538e6",
                                                "text": "Трансмиссия — классическая заднеприводная, с неразрезной балкой заднего моста на рессорной подвеске."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e73b4661-dfe9-3162-811f-f11c89b0a284",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "спорт. в спортивной борьбе — положение спортсмена, при котором тело изогнуто грудью вверх и опирается на затылок и пятки"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a38d973-a781-418d-916a-1618f9414d2c",
                                                "sense_id": "e73b4661-dfe9-3162-811f-f11c89b0a284",
                                                "text": "Предлагаются различные варианты уходов с помощью борцовского моста, вращением, забеганием."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3e843c5-8c13-3e38-9720-efb97bd13995",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "спорт. в гимнастике — положение спортсмена спиной к опоре, при котором тело изогнуто грудью вверх и опирается на ладони рук и ступни ног; мостик"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3ad71e59-082e-3723-bf6d-3d7c2a931cf2",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "диал., рег. пол, реже поверхность земли"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93c86398-289b-4b07-83e5-370046827737",
                                                "sense_id": "3ad71e59-082e-3723-bf6d-3d7c2a931cf2",
                                                "text": "Банка выскользнула из рук и разбилась об мост."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f1eb2590-2e8c-3d8b-8cbc-4c056b73aece",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "рег. холодные сени между передней и задней избами"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ee810ee2-cff4-39d6-8278-2b90d16fe9ac",
                                        "entry_id": "a5d022bc-1b32-3e6d-9ea7-30163a41338e",
                                        "glosses": [
                                            "эл.-техн. схема соединения электронных элементов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9981b294-a62f-4984-bb59-eae0be4129c3",
                                                "sense_id": "ee810ee2-cff4-39d6-8278-2b90d16fe9ac",
                                                "text": "Термометр в виде катушки сопротивления включается в мост Уитстона, как одно из плеч его."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
