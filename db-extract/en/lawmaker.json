                                                "sense_id": "47b90ced-913e-3b68-acb7-dc4df25a8cd8",
                                                "text": "In Deutschland sind die Parlamente die Gesetzgeber."
                                            },
                                            {
                                                "example_id": "7aeadb5f-e062-48fe-a2e9-a06785136845",
                                                "sense_id": "47b90ced-913e-3b68-acb7-dc4df25a8cd8",
                                                "text": "„Der Gesetzgeber hat einfach an alles gedacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
