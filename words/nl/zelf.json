                    "semantic_group_id": "identity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens de lange reis hoopte hij zijn ware <w>zelf</w> te vinden.",
                            "target_lang_translations": {
                                "en": "During the long journey, he hoped to find his true <w>self</w>.",
                                "ru": "Во время долгого путешествия он надеялся найти своё истинное <w>«я»</w>.",
                                "pl": "Podczas długiej podróży miał nadzieję odnaleźć swoje prawdziwe <w>ja</w>.",
                                "de": "Während der langen Reise hoffte er, sein wahres <w>Selbst</w> zu finden.",
                                "fr": "Pendant ce long voyage, il espérait trouver son véritable <w>soi</w>.",
                                "it": "Durante il lungo viaggio sperava di trovare il suo vero <w>sé</w>.",
