                    {
                        "form_id": "194a17e9-3060-4f7b-bcd1-98d403629cbc",
                        "entry_id": "261592c9-5ede-38b7-914a-6e8a4c25d007",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Schlieren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0b1e960d-df0f-3c9f-bd5c-1311c1c12cf8",
                        "entry_id": "261592c9-5ede-38b7-914a-6e8a4c25d007",
                        "glosses": [
                            "langgezogene Form von halbflüssigem Material mit unklaren Rändern, die als Film auf einer Fläche liegt, meist mit der Folge, dass das Licht anders gebrochen wird und das deutliche Sehen behindert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df6379f9-3357-44e3-9f5c-60ca4ee66c3f",
                                "sense_id": "0b1e960d-df0f-3c9f-bd5c-1311c1c12cf8",
                                "text": "Wieso entstehen eigentlich manchmal beim Fensterputzen Schlieren?"
                            },
                            {
                                "example_id": "d4aa54d9-30fc-44d4-bd7d-07ae11b30754",
                                "sense_id": "0b1e960d-df0f-3c9f-bd5c-1311c1c12cf8",
                                "text": "Sie macht mit ihrem Zeigefinger Schlieren an die Scheibe."
                            },
                            {
                                "example_id": "671105ed-d1ae-4e37-8428-cb1c3df6a0ed",
                                "sense_id": "0b1e960d-df0f-3c9f-bd5c-1311c1c12cf8",
                                "text": "Beim Wein deuten Schlieren am Glasinnenrand auf Qualität."
                            },
                            {
                                "example_id": "a64387ca-3770-4361-98eb-e242b0a85c51",
                                "sense_id": "0b1e960d-df0f-3c9f-bd5c-1311c1c12cf8",
                                "text": "„Mit dem linken Auge konnte ich plötzlich nur noch durch Schlieren sehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7aa3ed89-5a03-3640-8b7d-2375aa94f594",
                        "entry_id": "261592c9-5ede-38b7-914a-6e8a4c25d007",
                        "glosses": [
                            "Einschlüsse im Glas, entweder als Fehler der Herstellung oder als absichtliches, künstlerisches Gestaltungsmoment"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36b07f5c-6c30-4223-addc-b0c5f056c80a",
                                "sense_id": "7aa3ed89-5a03-3640-8b7d-2375aa94f594",
                                "text": "„Unter Schlieren werden sichtbare Glasfehler verstanden, welche auf Unregelmäßigkeiten im Brechungsvermögen des Glases beruhen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "40f4de6c-77bf-325a-a26e-f9e5fe856da8",
                        "entry_id": "261592c9-5ede-38b7-914a-6e8a4c25d007",
                        "glosses": [
                            "Schleim, Masse mit klebriger oder schleimiger Konsistenz"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "0a76eb1c-748d-4b72-b5c6-863754ff8e20",
                                "sense_id": "40f4de6c-77bf-325a-a26e-f9e5fe856da8",
                                "text": "„Er betätigte die Spülung und schaute zu, wie die Schliere mit einem hohlen Schlürfgeräusch abgesaugt wurde.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
