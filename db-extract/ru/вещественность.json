                                "target_senses": [
                                    {
                                        "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                                        "glosses": [
                                            "Qualité de ce qui est matériel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9fc6026-2f3a-4123-8c66-31c87a507b9f",
                                                "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                                                "text": "Ce voyage de leurs noces, non plus dans la chaude Italie, mais au pays des glaces et des neiges, était sans doute d’une élégance rare, qui disait bien la distinction de leur amour, exempt de toute matérialité grossière."
                                            },
                                            {
                                                "example_id": "e798bfed-317c-4eb9-8b12-16aff1952ee8",
                                                "sense_id": "d7b3e60d-a8ff-35f2-bd09-f65b05d058bc",
                                                "text": "La question du support est notamment celle de la matérialité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a1972f3-5550-3b1f-bb9b-fb6453527ed1",
                                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                                        "glosses": [
                                            "Information matérielle, c’est-à-dire dont l’omission, l’inexactitude ou l’occultation est raisonnablement susceptible d’influencer les décisions d’acheter ou de vendre des actions d’une entreprise, ou de lui prêter ou pas des capitaux."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1d10194c-ce50-3e71-8bc4-5abd1f09e420",
                                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                                        "glosses": [
                                            "Réalité d’un fait."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcdd4946-a27f-4c4e-95e0-e7e91afd9200",
                                                "sense_id": "1d10194c-ce50-3e71-8bc4-5abd1f09e420",
                                                "text": "Confirmant une information de nos confrères d’Actu Rennes, le procureur de la République adjoint Sébastien Farges nous indique que la décision ne leur « apparaît pas conforme à la matérialité des faits »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "205f9d4d-eb84-333c-a492-7a9547b50c16",
                                        "entry_id": "110e216f-5ec2-3fdf-a92d-1352238469e0",
                                        "glosses": [
                                            "Tendance à s’attacher aux choses matérielles, ou à leur donner une importance prééminente."
                                        ],
