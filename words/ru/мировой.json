    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9f36e9c1-dca4-31a8-9564-bc36fe223c92",
                    "sense_definition": "Относящийся ко всему миру, земному шару; всемирный.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "global",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Загрязнение окружающей среды — это серьёзная <w>мировая</w> проблема.",
                            "target_lang_translations": {
                                "en": "Environmental pollution is a serious <w>global</w> problem.",
                                "zh": "环境污染是一个严重的<w>全球</w>性问题。"
                            }
                        },
                        {
                            "text": "Этот спортсмен установил новый <w>мировой</w> рекорд на соревнованиях.",
                            "target_lang_translations": {
                                "en": "This athlete set a new <w>world</w> record at the competition.",
                                "zh": "这位运动员在比赛中创下了新的<w>世界</w>纪录。"
                            }
                        }
                    ],
                    "synonyms": [
                        "всемирный",
                        "глобальный",
                        "общемировой",
                        "вселенский"
                    ],
                    "antonyms": [
                        "местный",
                        "локальный"
                    ],
                    "common_phrases": [
                        "мировой океан",
                        "мировой рынок",
                        "мировой рекорд",
                        "мировая война",
                        "мировая экономика"
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to the whole world or the globe; worldwide.",
                        "zh": "指与整个世界或地球有关的；全球性的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "world",
                                "target_lang_sense_clarification": "attributive use, e.g., world record"
                            },
                            {
                                "target_lang_word": "global",
                                "target_lang_sense_clarification": "relating to the whole world"
                            },
                            {
                                "target_lang_word": "worldwide",
                                "target_lang_sense_clarification": "extending across the world"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "用于名词前，如世界纪录"
                            },
                            {
                                "target_lang_word": "全球",
                                "target_lang_sense_clarification": "指涉及整个地球的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "60617efc-425b-3088-8a4e-2bb8dd38d155",
                    "sense_definition": "Очень хороший, превосходный, отличный (обычно в разговорной речи).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Твой брат — <w>мировой</w> парень, он мне очень помог с переездом.",
                            "target_lang_translations": {
                                "en": "Your brother is a <w>great</w> guy; he really helped me with the move.",
                                "zh": "你哥哥真是个<w>极好的</w>人，他帮了我不少搬家的忙。"
                            }
                        },
                        {
                            "text": "У нас получилась <w>мировая</w> вечеринка, всем гостям понравилось.",
                            "target_lang_translations": {
                                "en": "We had an <w>awesome</w> party; all the guests liked it.",
                                "zh": "我们办了一场<w>棒的</w>派对，客人们都很喜欢。"
                            }
                        }
                    ],
                    "synonyms": [
                        "отли́чный",
                        "прекра́сный",
                        "кла́ссный"
                    ],
                    "common_phrases": [
                        "мировой парень"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Very good, excellent, or first-rate (usually in colloquial speech).",
                        "zh": "非常好、极好、出色（通常用于口语）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "informal, excellent"
                            },
                            {
                                "target_lang_word": "awesome",
                                "target_lang_sense_clarification": "slang, very impressive"
                            },
                            {
                                "target_lang_word": "first-class",
                                "target_lang_sense_clarification": "of the best quality"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "极好的",
                                "target_lang_sense_clarification": "口语，表示非常出色"
                            },
                            {
                                "target_lang_word": "棒的",
                                "target_lang_sense_clarification": "口语，表示令人印象深刻"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8d88a73c-a3a7-36c3-a67a-8979b2f6eb02",
                    "sense_definition": "Касающийся мирного соглашения сторон, прекращающий спор или судебную тяжбу.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_agreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Стороны решили не продолжать суд и подписали <w>мировое</w> соглашение.",
                            "target_lang_translations": {
                                "en": "The parties decided not to continue the trial and signed a <w>settlement</w> agreement.",
                                "zh": "双方决定不再诉讼，并签署了<w>和解</w>协议。"
                            }
                        },
                        {
                            "text": "Эта <w>мировая</w> сделка устроила всех участников конфликта.",
                            "target_lang_translations": {
                                "en": "This <w>settlement</w> deal satisfied all participants in the conflict.",
                                "zh": "这份<w>和解</w>协议让冲突各方都感到满意。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "мировое соглашение",
                        "мировая сделка"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to a legal settlement or peace agreement that ends a dispute.",
                        "zh": "与法律和解或结束纠纷的协议有关的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "settlement",
                                "target_lang_sense_clarification": "attributive, relating to an agreement"
                            },
                            {
                                "target_lang_word": "amicable",
                                "target_lang_sense_clarification": "characterized by agreement"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "和解",
                                "target_lang_sense_clarification": "法律用语，指达成协议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c5e8faed-53ba-3add-a13d-4ac2900995d8",
                    "sense_definition": "Относящийся к низшему суду для разбора мелких гражданских и уголовных дел.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_court",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Мировой</w> судья рассматривает дела о разводах и мелких кражах.",
                            "target_lang_translations": {
                                "en": "The <w>justice of the peace</w> examines cases regarding divorces and petty thefts.",
                                "zh": "<w>基层</w>法官负责审理离婚和轻微盗窃案件。"
                            }
                        },
                        {
                            "text": "В нашем районе открылся новый участок, где работает <w>мировой</w> суд.",
                            "target_lang_translations": {
                                "en": "A new precinct has opened in our district where the <w>magistrate's</w> court operates.",
                                "zh": "我们区新开了一个办公点，那里设有<w>基层</w>法院。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "мировой суд",
                        "мировой судья"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal or historical"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Relating to a lower court or a justice of the peace for minor cases.",
                        "zh": "指处理轻微案件的基层法院或治安法官。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "magistrate's",
                                "target_lang_sense_clarification": "relating to a minor court"
                            },
                            {
                                "target_lang_word": "peace",
                                "target_lang_sense_clarification": "in 'justice of the peace'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "基层",
                                "target_lang_sense_clarification": "指处理小案件的法院级别"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9454d528-7fb7-31ac-9bd6-e767702a5540",
                    "sense_definition": "Судья, разбирающий мелкие дела (разговорное сокращение от «мировой судья»).",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal_court",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Крестьяне пришли к <w>мировому</w> с жалобой на соседа.",
                            "target_lang_translations": {
                                "en": "The peasants came to the <w>magistrate</w> with a complaint against their neighbor.",
                                "zh": "农民们来到<w>治安法官</w>那里投诉邻居。"
                            }
                        },
                        {
                            "text": "<w>Мировой</w> внимательно выслушал обе стороны и вынес справедливое решение.",
                            "target_lang_translations": {
                                "en": "The <w>magistrate</w> listened carefully to both sides and delivered a fair decision.",
                                "zh": "<w>治安法官</w>认真听取了双方的陈述，并作出了公正的判决。"
                            }
                        }
                    ],
                    "synonyms": [
                        "мировой судья"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A judge who handles minor legal cases (colloquial short for 'justice of the peace').",
                        "zh": "处理轻微法律案件的法官（“治安法官”的口语简称）。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "magistrate",
                                "target_lang_sense_clarification": "civil officer administering law"
                            },
                            {
                                "target_lang_word": "justice of the peace",
                                "target_lang_sense_clarification": "local judicial official"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "治安法官",
                                "target_lang_sense_clarification": "负责处理轻微民事或刑事案件的官员"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}