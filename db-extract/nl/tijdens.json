                                            "temporal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4002a06d-effa-484f-b48c-a56ebcbcfd66",
                                                "sense_id": "0389daab-ba4a-3da5-b8ee-171a3e74c31b",
                                                "text": "Während wir auf dem Fest waren, haben wir uns gestritten. (Duden Band 4 – Die Grammatik. ⁷2005 Mannheim, Leipzig, Wien, Zürich; Seite 626)"
                                            },
                                            {
                                                "example_id": "359390cb-fbd0-4a39-9159-5f6c2c825609",
                                                "sense_id": "0389daab-ba4a-3da5-b8ee-171a3e74c31b",
                                                "text": "Während wir hier streiten, sind die anderen schon beim Nachtisch."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21ca2b03-5143-3df6-9823-b334cb8ef4e4",
                                        "entry_id": "66578852-4d40-331a-a812-9186f0b9ce24",
                                        "glosses": [
                                            "wohingegen (drückt einen Gegensatz aus)"
                                        ],
                                        "tags": [
                                            "adversativ"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "248bf83a-5206-4cdd-b2d1-4697bea062e7",
                                                "sense_id": "21ca2b03-5143-3df6-9823-b334cb8ef4e4",
                                                "text": "Während die meisten noch auf der Suche nach Geschenken sind, habe ich bereits alle gekauft."
                                            }
