                "translations": [
                    {
                        "translation_id": "c23728be-b5ce-4cdd-a745-05ca21966b3d",
                        "source_entry_id": "2cc90f37-8e7f-3397-a024-7b17048e70d9",
                        "source_sense_id": "b6f4eb3f-e697-3f5e-b581-9e01a1cbe5e2",
                        "target_lang_word": "possibly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "possibly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "Perhaps; indicates that the proposition may be true (is not certainly false) regardless of any facts or circumstances known to, stated by or implied by the speaker."
                                        ],
                                        "tags": [
                                            "modifying a clause or predicate"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7deef97a-3ee5-4d06-ad06-94ac3d01c986",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Near-synonyms: maybe, perhaps, mayhap, mayhaps, by chance, perchance, peradventure; conceivably"
                                            },
                                            {
                                                "example_id": "02df7048-c149-419f-88c4-124d63a6bb58",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "Possibly, they will make gains in the midterm elections."
                                            },
                                            {
                                                "example_id": "04493592-5c28-48fc-b83c-794fcdfa8453",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "It was possibly the costliest mistake in the organization's history."
                                            },
                                            {
                                                "example_id": "ff077c1b-bf07-4212-8b9a-e3ea94980206",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "This rare and possibly unique specimen must be conserved."
                                            },
                                            {
                                                "example_id": "97d3a85d-e4c3-42da-8017-6bf7a8427f96",
                                                "sense_id": "c65307b6-9054-37b9-8c68-0cced087ff09",
                                                "text": "“Well, everything does point to either a major epeirogenic deformation, or possibly just a simple disruption of isostasy throughout the entire plate network.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                        "entry_id": "aa1d7883-731f-3425-a890-391933fcebea",
                                        "glosses": [
                                            "In the realm of possibility; indicates that the action may successfully be performed (is not impossible) regardless of any facts or circumstances known to, stated by or implied by the speaker that might limit the performance."
                                        ],
                                        "tags": [
                                            "modifying a verb"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e9a4a0e-0e4d-4d8a-99fa-8b36b3e452cb",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly cheat on my wife."
                                            },
                                            {
                                                "example_id": "929cad39-c4ea-40fb-847a-3e8884cceb64",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "It seems unlikely, but, yes, they could possibly win even now."
                                            },
                                            {
                                                "example_id": "ebaa713b-5d95-4193-aba2-83681d849f23",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I'm much stronger than you, so you can't possibly win."
                                            },
                                            {
                                                "example_id": "8abd20c2-52ca-433e-983d-ee3fa6309add",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "I couldn't possibly be there on time."
                                            },
                                            {
                                                "example_id": "c3662d54-b7b7-4b24-b657-128fab3fb7b2",
                                                "sense_id": "4eaec1af-82ad-3185-83bc-bcc7a2bbeb20",
                                                "text": "The police don't know him, and the information they have leads them to think he could possibly have murdered his wife."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4c15b6b-3ef5-4da8-b81d-b83e84dd1003",
                        "source_entry_id": "2cc90f37-8e7f-3397-a024-7b17048e70d9",
                        "source_sense_id": "b6f4eb3f-e697-3f5e-b581-9e01a1cbe5e2",
                        "target_lang_word": "möglichst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "möglichst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa39d588-6121-3e46-974b-af46726447d2",
                                        "entry_id": "47cba099-e8da-3e1e-acca-8265854f8a9e",
                                        "glosses": [
                                            "so gut, so schnell, so groß und Ähnliches sich etwas einrichten/machen lässt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "71360fbe-2870-4934-b191-c2203e00f830",
                                                "sense_id": "aa39d588-6121-3e46-974b-af46726447d2",
                                                "text": "Er möchte möglichst wenig Zucker in den Tee bekommen."
                                            },
                                            {
                                                "example_id": "ddb8126c-c719-49d4-8309-856de6153f4b",
                                                "sense_id": "aa39d588-6121-3e46-974b-af46726447d2",
                                                "text": "„Frauen trinken aber auch viel Tee, um sich möglichst viel Flüssigkeit zuzuführen und es in puncto Gesundheit den Topmodels gleichzutun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2956573-54f0-4349-b9d8-e6748f59e5b6",
                        "source_entry_id": "2cc90f37-8e7f-3397-a024-7b17048e70d9",
                        "source_sense_id": "b6f4eb3f-e697-3f5e-b581-9e01a1cbe5e2",
                        "target_lang_word": "возможно",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "возможно",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "предик. есть возможность"
                                        ],
                                        "tags": [
                                            "в знач. сказуемого"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d897365-0779-4d25-88fb-827a5377bd6d",
                                                "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                                "text": "Сделать это возможно."
                                            },
                                            {
                                                "example_id": "524cac88-385f-4174-832f-a1a1edf7d33d",
                                                "sense_id": "a4bb8558-55b2-37bd-be26-84db1112b6d8",
                                                "text": "Возможно наследование от большинства встроенных типов и типов расширений."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c8d60db-bbff-3ed5-9c7e-60a09333813a",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "вводн. сл., вероятно, по-видимому"
                                        ],
                                        "tags": [
                                            "указывает на вероятность события"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a9fdb44-ba1d-4c5a-ba6c-b82b7790d339",
                                                "sense_id": "5c8d60db-bbff-3ed5-9c7e-60a09333813a",
                                                "text": "Возможно, если бы речь шла об обещаниях или призывах убить кого-либо с помощью радиоактивного вещества (например, полония-210), ингибитора холинэстеразы (например, метил (1-(диэтиламино)этилиден)-амидофторфосфоната, в просторечии «Новичок») или, на худой случай, из огнестрельного оружия (например, из золотого пистолета), это вряд ли противоречило бы принятым представлениям о депутатской этике. Но обещать (призывать) действовать столь примитивным способом – отделяя голову от туловища – недостойно высокого звания депутата Государственной Думы Российской Федерации, государства, обладающего разнообразными высокими технологиями."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ac6dd85f-816d-365c-ab55-bb94d3ed8fb8",
                                        "entry_id": "df4c501d-c566-3300-9166-d926ff127517",
                                        "glosses": [
                                            "как можно, по возможности"
                                        ],
                                        "tags": [
                                            "указывает на крайнюю необходимость, употребляется перед сравнительной степенью прилагательного"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "631050d4-f208-4335-92fa-0c600bc50563",
                                                "sense_id": "ac6dd85f-816d-365c-ab55-bb94d3ed8fb8",
                                                "text": "Я прошу прийти тебя возможно скорее."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
