                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The article criticized the behavior of the typical <w>AWFUL</w> in the city.",
                            "target_lang_translations": {
                                "ru": "Статья критиковала поведение типичной <w>AWFUL</w> в городе.",
                                "tr": "Makale, şehirdeki tipik bir <w>AWFUL</w>'ın davranışlarını eleştirdi.",
                                "zh": "这篇文章批评了城里典型的<w>AWFUL</w>的行为。"
                            }
                        },
                        {
                            "text": "He dismissed her complaints by labeling her an <w>AWFUL</w>.",
                            "target_lang_translations": {
                                "ru": "Он отмахнулся от её жалоб, назвав её <w>AWFUL</w>.",
                                "tr": "Onu bir <w>AWFUL</w> olarak etiketleyerek şikayetlerini görmezden geldi.",
                                "zh": "他给对方贴上<w>AWFUL</w>的标签，从而无视了她的抱怨。"
                            }
                        }
