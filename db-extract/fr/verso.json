                        "entry_id": "c5c6e1cd-d67b-35e5-a69b-2ab559e84324",
                        "glosses": [
                            "Seconde page d’un feuillet, par opposition à recto."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": [
                            {
                                "example_id": "a6877cc4-d182-4b6e-a079-bd0e9341809a",
                                "sense_id": "976f1441-0ec0-3fb4-9923-cf08c17aa88b",
                                "text": "Vous trouverez ce passage folio 42 verso."
                            },
                            {
                                "example_id": "e8062bd3-bb68-4612-b7ce-99ea116a3ba4",
                                "sense_id": "976f1441-0ec0-3fb4-9923-cf08c17aa88b",
                                "text": "Quand on rédige un texte pour l’impression, on ne doit pas écrire au verso des feuillets."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "75505dfb-d661-4d09-a60e-8e7bc78a797b",
                        "source_entry_id": "c5c6e1cd-d67b-35e5-a69b-2ab559e84324",
