                    {
                        "sense_id": "d82de20a-0a55-324f-bc09-17764d191229",
                        "entry_id": "bf02696b-f4ca-3392-8a8e-21c4f80c1219",
                        "glosses": [
                            "ein Beamter der kastilischen Krone mit richterlichen und Regierungskompetenzen für einen festgelegten Bereich"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "a3a5581a-22e3-4240-858d-95b28e5ed470",
                                "sense_id": "d82de20a-0a55-324f-bc09-17764d191229",
                                "text": "„Nach der Eroberung von Honduras und Guatemala erhielt Pedro de Alvarado ebenfalls eine eigene Kapitulation und die Ernennung zum Adelantado der Krone.“"
                            },
                            {
                                "example_id": "cb034cb9-bfbb-430b-bfe1-4b33359715bc",
                                "sense_id": "d82de20a-0a55-324f-bc09-17764d191229",
                                "text": "„Daher hatte er bereits seinen Schatzmeister Gonzálo Guzmán mit dem Auftrag nach Spanien entsandt, für Velázquez den Titel eines Adelantado von Yucatán zu erwirken.“"
                            }
                        ],
