                    {
                        "sense_id": "dfdbef3b-8136-373b-89fa-20aaabec6697",
                        "entry_id": "42b763ad-f1fc-30c3-99e9-61211cf5e438",
                        "glosses": [
                            "A cement-based slurry applied to a wall in order to improve adhesion of the render."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b75f9a1-c5a1-4f59-9a7d-2cd421844c7a",
                                "sense_id": "dfdbef3b-8136-373b-89fa-20aaabec6697",
                                "text": "A spatterdash treatment consisting of a cement:sand slurry may be used over the surface of these bricks to provide a mechanical key for rendering."
                            },
                            {
                                "example_id": "b91accdf-13b5-49ad-a60b-72fbbf72c600",
                                "sense_id": "dfdbef3b-8136-373b-89fa-20aaabec6697",
                                "text": "Spatterdash can be used to produce an attractive appearance, or it can be applied before plastering in order to make a good surface for the plaster or render. Spatterdash is a wet, rich mix of cement and sand, called a slurry. This sand and cement is mixed to a proportion of 1:1,5 or 1:3. This slurry is thrown hard, or spattered, against the smooth block or concrete surface, and then allowed to harden."
                            }
                        ]
