                        "sense_id": "2e8caaac-3bd8-37ac-a04c-a4cf8ed4f576",
                        "entry_id": "87fc03f5-97e1-3d6c-8961-2ac93f03da68",
                        "glosses": [
                            "Handeln und Auftreten, das Pflichten und Regeln folgt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f651333-6fd2-482a-983c-2f7ed2300fc6",
                                "sense_id": "2e8caaac-3bd8-37ac-a04c-a4cf8ed4f576",
                                "text": "Das Wohlverhalten des Patienten ist wichtig für den Erfolg der Therapie."
                            },
                            {
                                "example_id": "a6ffcab9-b2d6-4d55-9899-16490703411a",
                                "sense_id": "2e8caaac-3bd8-37ac-a04c-a4cf8ed4f576",
                                "text": "„Grundrechte sind kein Privileg, die es als Belohnung für Wohlverhalten gibt, sondern ein Anspruch jeder Bürgerin und jedes Bürgers.“"
                            },
                            {
                                "example_id": "7bff1640-1b8e-4a69-aae4-b5508d66f3cb",
                                "sense_id": "2e8caaac-3bd8-37ac-a04c-a4cf8ed4f576",
                                "text": "„Die sanktionsbewertete Bindung von Transferleistungsbezug an erwerbsintegratives Wohlverhalten (»Fördern und Fordern«), knüpft bruchlos an die repressiven Verschärfungen des Arbeitsförderungs- und Sozialhilferechts der Kohl-Ära an. Sie stellt vor allem in der Sozialhilfe einen weit reichenden Paradigmenwechsel dar: Mit (aus Behördensicht) mangelndem Wohlverhalten verwirkt der Betroffene sein soziales Existenzrecht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
