                            {
                                "example_id": "c282a22c-8572-41d7-a553-3f39c0667649",
                                "sense_id": "d2721ed4-431c-32e4-9434-f86406671929",
                                "text": "Amy's husband was called Ivan. Ivan the Terrible, Barry always called him, naturally. 'Ivan? What kind of name is that?' he said to Tracy after Amy's engagement was announced. 'Bloody Russian.'\n'Actually, I think it's because he had a Norwegian grandfather', Tracy said.\n'Norwegian?' Barry said incredulously, as if she'd just announced that Ivan's family came from the moon."
                            }
                        ]
