                ],
                "senses": [
                    {
                        "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                        "entry_id": "972ca3fd-8d9f-33e2-93c2-6a286a46e438",
                        "glosses": [
                            "(ursprünglich im tropischen und subtropischen Südamerika vorkommender, artenreicher) zu den Wunderblumen gehörender Strauch oder kleiner Baum, dessen rosa, gelbliche oder weiße Blütenhülle an einem roten, violetten oder weißen Hochblatt wächst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a8d5a9a-648d-4dbc-99fc-064f3f5b1802",
                                "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                                "text": "„Am nächsten Morgen bemerkte er, dass zwei starke Zweige seines Orangenbäumchens abgebrochen waren, und neben den Bougainvillien, die sich an der Hauswand hochrankten, fand er zwei tiefe Schuhabdrücke in der weichen Erde.“"
                            },
                            {
                                "example_id": "3056e99c-c177-43f4-92a3-7ff1ffc649ac",
                                "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                                "text": "„Auch Bougainvillien sahen wir in strahlender Schönheit die Wände innerer Höfe bekleiden.“"
                            },
                            {
                                "example_id": "f1dffdaa-0582-4878-8ce1-c14573bdec4f",
                                "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                                "text": "„Die Bougainvillien entfalteten hier eine nie gesehene Farbenpracht und eine Fülle der edelsten Blumen deckte die Grabhügel jener Unglücklichen, die eine trügerische ärztliche Hoffnung veranlasst hatte, hieher zu kommen.“"
                            },
                            {
                                "example_id": "33b81a2e-07f3-49d1-96c8-ea1dbdf79e0d",
                                "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                                "text": "„Buntfarbige Schmetterlinge gaukeln in der Luft, Bougainvillien, Rosen und Hibiskussträucher verbreiten betörende Düfte.“"
                            },
                            {
                                "example_id": "7cab2e55-1305-42c0-8fed-3f2a1a5f1d7f",
                                "sense_id": "6aa32680-f756-3eac-bbf1-11c2da9b9c12",
                                "text": "„Auf den Feldern verstreut stehen malerische einzelne Fikusbäume, gelbblühender Hibiskus ziert die Umgebung der Bauernhöfe und die sauberen Bahnstationen leuchten von dicken Hecken violetter Bougainvillien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
