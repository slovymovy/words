                                        "glosses": [
                                            "Correctly written; syntactically correct; expressed in a way that obeys rules for constructing formulas in a certain language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "812673ef-30a0-4527-8655-988ac7ecba87",
                                                "sense_id": "be455d01-115f-3a0c-a618-8e616e5b9f76",
                                                "text": "If the parser says it is good, then it must be well-formed and is part of the language."
