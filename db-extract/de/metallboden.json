                "senses": [
                    {
                        "sense_id": "a11e047a-293d-35f7-a43c-2a892a6b2138",
                        "entry_id": "3f7fdc45-1f5d-3df6-89f2-08e2f0a5af0f",
                        "glosses": [
                            "Boden aus Metall"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "078181ac-c381-437e-bc5d-f8bb1e633557",
                                "sense_id": "a11e047a-293d-35f7-a43c-2a892a6b2138",
                                "text": "„Ich rieche die Tiere, bevor ich ihr gedämpftes Blöken und das Getrappel ihrer winzigen, nervösen Hufe auf dem Metallboden der Kabine höre.“"
                            },
                            {
                                "example_id": "36aea79d-77e6-4f95-ad56-4a5d7e89ae0e",
                                "sense_id": "a11e047a-293d-35f7-a43c-2a892a6b2138",
                                "text": "„Er geriet ins Wanken und schlug der Länge nach auf den Metallboden, klammerte sich daran fest und kroch auf allen vieren zum letzten Dach hinüber, wo er sich umblickte.“"
                            },
                            {
                                "example_id": "fdb0c600-bcea-4267-abd7-384abea2c4df",
                                "sense_id": "a11e047a-293d-35f7-a43c-2a892a6b2138",
                                "text": "„Der heiße Metallboden verbrannte ihm durch die gebügelte Hose die blasse Haut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
