                "senses": [
                    {
                        "sense_id": "ab8e9c8d-8905-35a5-900a-2297ad431f29",
                        "entry_id": "f0b4a9d6-eaf9-337c-90ec-a8c7efc9bb4a",
                        "glosses": [
                            "Kraftwerk, das mit Abfall neben Strom auch Wärme erzeugt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "733793fd-8cce-478f-ab1a-7a3eea22094c",
                                "sense_id": "ab8e9c8d-8905-35a5-900a-2297ad431f29",
                                "text": "„Das CopenHill ist zum einen ein Abfallheizkraftwerk in Kopenhagen, das aus lokalen Abfällen bis 63 Megawatt Strom und 250 Megawatt Wärme bereitstellt.“k"
                            },
                            {
                                "example_id": "c349340b-ae1a-4220-943e-56737fffe288",
                                "sense_id": "ab8e9c8d-8905-35a5-900a-2297ad431f29",
                                "text": "„Die drei Hausmüllofenlinien sind ganzjährig voll ausgelastet, so dass wir eine Vollauslastung des Abfallheizkraftwerks seit 1997 verzeichnen können.“"
                            },
                            {
                                "example_id": "9f954432-4ec2-4d50-a55d-a38116b6ee2d",
                                "sense_id": "ab8e9c8d-8905-35a5-900a-2297ad431f29",
                                "text": "„Seit einer kompletten Anlagenerneuerung zwischen 1996 und 2001 entsorgt die EEW Energy from Waste Saarbrücken GmbH für Sie in ihrem Abfallheizkraftwerk (AHKW) pro Jahr bis zu 160.000 Tonnen Abfall.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
