                        "sense_id": "acc7d559-cc5f-39c6-80df-0c46483a9a9c",
                        "entry_id": "18a5b042-43c7-3da3-8f53-16443cd066cf",
                        "glosses": [
                            "разг., непригодный, не соответствующий потребности"
                        ],
                        "tags": [
                            "часто неодобр."
                        ],
                        "examples": [
                            {
                                "example_id": "d0a36cd5-8d75-4363-b3e8-350dcdb1a800",
                                "sense_id": "acc7d559-cc5f-39c6-80df-0c46483a9a9c",
                                "text": "Неподходящие условия."
                            },
                            {
                                "example_id": "00260435-c265-4a4d-9b90-f46fd8f9be95",
                                "sense_id": "acc7d559-cc5f-39c6-80df-0c46483a9a9c",
