                                "target_senses": [
                                    {
                                        "sense_id": "45f2a2bc-5ed9-3956-951e-5923ff2f9e53",
                                        "entry_id": "b09e3c24-15ed-3190-abef-7bd81e18fe11",
                                        "glosses": [
                                            "Genre de plante de la famille des Boraginacées, dont certaines espèces étaient utilisées jadis en teinturerie comme par exemple l’orcanette des teinturiers (Alkanna tinctoria). → voir Alkanna"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a6d6bea2-4274-3a80-a769-2385f617c43a",
                                        "entry_id": "b09e3c24-15ed-3190-abef-7bd81e18fe11",
                                        "glosses": [
                                            "Sans précision, désigne généralement l’orcanette des teinturiers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7201c0ba-7124-4c4d-b737-a92feb125f75",
                                                "sense_id": "a6d6bea2-4274-3a80-a769-2385f617c43a",
                                                "text": "Là où d’autres auraient utilisé force teintures végétales, cochenille et garance, racine d’orcanette ou écorce de quercitron, afin de donner, aux différents bois composant le double pupitre, une coloration unique, lui s’était abstenu."
                                            },
                                            {
                                                "example_id": "874acdf8-eae1-448e-b259-a7d08ac3581d",
                                                "sense_id": "a6d6bea2-4274-3a80-a769-2385f617c43a",
                                                "text": "La coloration des crayons était autrefois presque uniquement obtenue avec la racine d’orcanette restant, au bain-marie, en contact avec la matière grasse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
