                "senses": [
                    {
                        "sense_id": "83c34853-3a6e-33c3-94be-99d84ae169e5",
                        "entry_id": "2744cd86-b1f2-3c4f-bebc-5a42ce823b69",
                        "glosses": [
                            "État de santé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4be9c552-b97a-4e8a-a084-1c660b695f63",
                                "sense_id": "83c34853-3a6e-33c3-94be-99d84ae169e5",
                                "text": "Die Verwirrung um den Gesundheitszustand von Li Wenliang ist beendet - mit einem traurigen Ergebnis.",
                                "translation": "La confusion autour de l’état de santé de Li Wenliang est terminée - avec un triste résultat."
                            },
                            {
                                "example_id": "c0bda5d4-ee1f-4d47-b95a-8eae184f4d79",
                                "sense_id": "83c34853-3a6e-33c3-94be-99d84ae169e5",
                                "text": "Das Fernbleiben des belarussischen Machthabers sowie das Ausbleiben aktueller Bilder des Politikers im Staatsfernsehen veranlassen nun zu Spekulationen über seinen Gesundheitszustand.",
                                "translation": "L'absence du dirigeant biélorusse ainsi que l’absence d'images récentes de l'homme politique à la télévision d'État suscitent désormais des spéculations sur son état de santé."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
