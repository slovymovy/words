                            "comparative"
                        ],
                        "form": "more unfashionable"
                    },
                    {
                        "form_id": "d55081b2-7230-4d8d-926b-ccf9d881af5b",
                        "entry_id": "e393e6a9-f193-3990-b163-86afec9e3a97",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unfashionable"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "76b4b3a0-25b5-3a54-81ba-15f77f699f8e",
                        "entry_id": "e393e6a9-f193-3990-b163-86afec9e3a97",
                        "glosses": [
                            "Not fashionable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ad33eba-24fd-4a70-adaf-0deb2dd47fc1",
                                "sense_id": "76b4b3a0-25b5-3a54-81ba-15f77f699f8e",
                                "text": "The fashionable intelligence says so for the comfort of the Parisians, and it knows all fashionable things. To know things otherwise were to be unfashionable."
                            }
                        ]
                    },
                    {
                        "sense_id": "9645354e-7417-3bd5-8515-db1cfeb0058e",
                        "entry_id": "e393e6a9-f193-3990-b163-86afec9e3a97",
                        "glosses": [
                            "That cannot be fashioned; unshapely, distorted."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "20c76976-be3a-45be-af84-23529ed99b3c",
                                "sense_id": "9645354e-7417-3bd5-8515-db1cfeb0058e",
                                "text": "I, that am rudely stamp'd, and want love's majesty\nTo strut before a wanton ambling nymph;\nI, that am curtail'd of this fair proportion,\nCheated of feature by dissembling nature,\nDeformed, unfinish'd, sent before my time\nInto this breathing world, scarce half made up,\nAnd that so lamely and unfashionable\nThat dogs bark at me as I halt by them ..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a2191fc-618b-407b-869e-58c0ea38da3c",
                        "source_entry_id": "e393e6a9-f193-3990-b163-86afec9e3a97",
                        "source_sense_description": "not fashionable",
                        "target_lang_word": "onmodieus",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "onmodieus",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6f4e56eb-9b54-31a0-90f5-8b4bb36746eb",
                                        "entry_id": "1b7a7d4d-5228-32c9-b88d-5279835592c1",
                                        "glosses": [
                                            "niet volgens de laatste mode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "15b4a3dc-fa9b-4f06-ae6a-1f3d119ec2dc",
                                                "sense_id": "6f4e56eb-9b54-31a0-90f5-8b4bb36746eb",
                                                "text": "Tegelijk gelden de tegenstanders van hervorming van de verzorgingsstaat als een lelijk monsterverbond dat ‘met de rug naar de toekomst’ staat. Die Linke (populair in de voormalige DDR) doen geen moeite om modern te zijn; bij ons is de SP bewust onmodieus."
                                            },
                                            {
                                                "example_id": "44b30450-1fd4-46e0-b490-30e998591974",
                                                "sense_id": "6f4e56eb-9b54-31a0-90f5-8b4bb36746eb",
                                                "text": "“Een aantal recepten staat ook in mijn boek: crème au beurre-taart, Kempense wafels, zelfgemaakte Grand Marnier en natuurlijk rijstpap en de naar oorlog smakende melksaus. De bloemen zou je dus ook kunnen zien als een onmodieus kookboek.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cae07ad-e0b7-3215-a2cd-17aa8a3884c0",
                                        "entry_id": "1b7a7d4d-5228-32c9-b88d-5279835592c1",
                                        "glosses": [
                                            "niet mooi"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29e48232-4968-441c-85f2-dfea2ebb14ff",
                                                "sense_id": "7cae07ad-e0b7-3215-a2cd-17aa8a3884c0",
                                                "text": "Hoe zit dat bij de Koningin, die het liefst comfortabel op haar maatje 43 rondloopt en er tegelijkertijd ook weer niet onmodieus uit wil zien?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4e003da-a6a8-4b0e-89a9-11baf532963b",
                        "source_entry_id": "e393e6a9-f193-3990-b163-86afec9e3a97",
                        "source_sense_description": "not fashionable",
                        "target_lang_word": "quétaine",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quétaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                        "entry_id": "12512a39-d75d-31f1-8ac5-a0915b301ae9",
                                        "glosses": [
                                            "Qui manque de raffinement, est de mauvais goût, démodé, ou qui relève du cliché."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2eabe99b-636b-4038-9a68-6d6e958e3f6e",
                                                "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                                "text": "[…] le poète, qui se réfère à « nos amis les nuages » (en une formule assez quétaine), est dans la tranquillité saisonnière, alors que « les jardins sont fleuris du regret de la fleur »."
                                            },
                                            {
                                                "example_id": "acbac4ae-871a-44b8-a539-a884d36a4ebd",
                                                "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                                "text": "« […] En plus, l’imagerie fantasmatique gaie peut être très quétaine ! » Bernar fait référence à la scène où un modèle new-yorkais grimpe une selle western, attifé en cow-boy […]."
                                            },
                                            {
                                                "example_id": "c5fbe2bb-a5b7-4b0a-8449-ca8bdef3f3f5",
                                                "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                                "text": "« En fait, l’opéra nous donne la permission d’être quétaines! Les chics connaisseurs de Bayreuth et de La Scala, l’engeance la plus snob et la plus discriminatoire du monde, le savent-ils qu’ils sont de véritables quétaines ? »"
                                            },
                                            {
                                                "example_id": "083594db-1e3e-4415-9993-de932eb71e6e",
                                                "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                                "text": "Pis pas juste pour dire à mon chum dans une petite carte quétaine que je l’aime et qu’il est parfait pour moi (il a des défauts, faites-vous-en pas). Non."
                                            },
                                            {
                                                "example_id": "8cb0c24d-c428-4482-abca-a12017aa35bd",
                                                "sense_id": "71f729fc-857f-326d-8129-58baac132bf5",
                                                "text": "Tous des acteurs de la vie culturelle dite populaire. Qui se faisaient regarder de haut par une certaine élite. Qui se sont fait traiter de quétaines plus souvent qu’à leur tour."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "quétaine",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee2109b6-002b-375c-bb34-6a5fd3571295",
                                        "entry_id": "879c94c4-8f0d-34b7-9338-d29d9f77eefa",
                                        "glosses": [
                                            "Personne qui, sans être grossière, est considérée comme ridicule en raison de son manque de goût ou de raffinement."
                                        ],
                                        "tags": [
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6963166e-c051-4bc0-a771-c2c36f982770",
                                                "sense_id": "ee2109b6-002b-375c-bb34-6a5fd3571295",
                                                "text": "Pour pousser l’insulte à son comble, un torrent de clichés déferle sur cette ânerie réalisée avec soin mais sans goût. C’est que Fuqua est ce qu’on appelle communément chez nous « un moyen quétaine ». En témoignent les nombreux ralentis sur le héros viril avançant vers la caméra pendant qu’une explosion embrase l’arrière-plan, la photo aux couleurs saturées pour communiquer un état de fièvre, le montage frénétique pour indiquer un état d’urgence, une musique pompière pour s’assurer qu’on est bien assommés. Tout cela ne serait qu’un moindre mal si les dialogues n’étaient pas d’une niaiserie tellement profonde qu’ils déclenchent l’hilarité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
