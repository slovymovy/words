                        "glosses": [
                            "größere Anzahl sich wild durcheinander fortbewegender Wespen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c88dd241-d94c-4c82-8e7c-71ffe1c04263",
                                "sense_id": "4037cf82-fe0d-3f57-8807-b6c84e576994",
                                "text": "„In Schweinfurt ist eine Gruppe von acht- bis 13-Jährigen während einer Nachtwanderung von einem Wespenschwarm angegriffen worden.“"
                            },
                            {
                                "example_id": "f1e381ba-8944-41fc-be62-bc3c0d973184",
                                "sense_id": "4037cf82-fe0d-3f57-8807-b6c84e576994",
                                "text": "„Die Attacke des aus unbekannten Gründen aggressiven Wespenschwarms sei letztlich glimpflich verlaufen.“"
                            }
                        ],
