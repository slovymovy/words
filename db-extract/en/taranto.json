                        "cross_references": [
                            {
                                "target_word": "Tarent",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                        "entry_id": "5ee96dad-c3f5-367e-ae48-61ad0ff6c952",
                                        "glosses": [
                                            "italienische Stadt in Apulien (italienisch: Taranto)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2a3aaa5-d5f5-4af9-8e46-877f8c35e11f",
                                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                                "text": "Tarent verdankt seine Existenz seit jeher seinen Meeren."
                                            },
                                            {
                                                "example_id": "2110a1c1-7480-49b3-b264-a6fb958b08d6",
                                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                                "text": "Das griechische Tarent war […] in seiner Zeit des größten Glanzes in Akropolis, Polis und Nekropolis unterteilt."
                                            },
                                            {
                                                "example_id": "733e6618-0091-42c7-9c44-501aa45ccb03",
                                                "sense_id": "87bc6abc-dbe6-36c5-a399-7be2708e3e60",
                                                "text": "„Die Lukaner brauchten Hilfe gegen die Griechenstadt Tarent, welche den spartanischen König Kleonymos aus Griechenland zu ihrem Schutz herbeigerufen. hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5dbab692-cb63-48e7-9a83-5f1e455c20ba",
                        "source_entry_id": "490038af-365b-36db-a2c6-35426830c443",
                        "source_sense_description": "city and province",
                        "target_lang_word": "Taranto",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taranto",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                        "entry_id": "c91183d8-a47f-315e-a675-48073904fabe",
                                        "glosses": [
                                            "italienische Stadt in Apulien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b418fd1d-15a9-4444-afdb-65479a11bf34",
                                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                                "text": "„Während die Flüchtlingsschiffe „Excelsior“ und „Catania“ ihre Fahrt ins apulische Taranto antraten, sollten noch am Donnerstag weitere 2000 Nordafrikaner in Lampedusa abgelegt haben.“"
                                            },
                                            {
                                                "example_id": "6105c0b1-bc84-4ab4-9ff3-14302852596a",
                                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                                "text": "„Libyen deckte sein Atomwaffenprogramm auf, aus Angst vor den Amerikanern, nachdem im italienischen Taranto im Oktober 2003 das deutsche Frachtschiff \"BBC China\" mit einer Ladung Atombombenbedarf für den Wüstenstaat an die Kette gelegt worden war.“"
                                            },
                                            {
                                                "example_id": "0be96b1d-6d12-4ea2-8e98-04941c6227bf",
                                                "sense_id": "e80666c3-c047-3fdd-84fa-e25feca95629",
                                                "text": "„Eine Untersuchung zur Häufigkeit von Krebserkrankungen aus diesem Jahr fand heraus, dass die Wahrscheinlichkeit in Taranto bis zu 190 Mal höher ist als im Landesdurchschnitt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
