{
    "word_family": [
        "hugger",
        "huggable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0a4ebb71-f36d-3108-81e5-545ee7328223",
                    "sense_definition": "To embrace by holding someone closely, especially in the arms, to show affection or comfort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "embrace_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ran to her father and <w>hugged</w> him tightly.",
                            "target_lang_translations": {
                                "ru": "Она подбежала к отцу и крепко <w>обняла</w> его.",
                                "zh": "她跑向父亲，紧紧地<w>拥抱</w>了他。"
                            }
                        },
                        {
                            "text": "They <w>hugged</w> each other before saying goodbye at the station.",
                            "target_lang_translations": {
                                "ru": "Они <w>обнялись</w> перед тем, как попрощаться на вокзале.",
                                "zh": "他们在车站告别前互相<w>拥抱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embrace",
                        "hold"
                    ],
                    "common_phrases": [
                        "hug tightly",
                        "hug back",
                        "hug goodbye"
                    ],
                    "target_lang_definitions": {
                        "ru": "Обнимать кого-либо, прижимая к себе, чтобы выразить привязанность или утешить.",
                        "zh": "用双臂紧紧抱住某人，以表达爱意或安慰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обнимать",
                                "target_lang_sense_clarification": "несовершенный вид"
                            },
                            {
                                "target_lang_word": "обнять",
                                "target_lang_sense_clarification": "совершенный вид"
                            },
                            {
                                "target_lang_word": "обниматься",
                                "target_lang_sense_clarification": "взаимное действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥抱",
                                "target_lang_sense_clarification": "动作或状态"
                            },
                            {
                                "target_lang_word": "抱",
                                "target_lang_sense_clarification": "常用动词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "062cdcf7-2395-3593-a7c9-349c10288722",
                    "sense_definition": "To stay very close to a specific path, boundary, or edge while moving.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scenic road <w>hugs</w> the coastline for several miles.",
                            "target_lang_translations": {
                                "ru": "Живописная дорога несколько миль <w>тянется вдоль</w> береговой линии.",
                                "zh": "这条风景优美的公路沿海岸线<w>延伸</w>了数英里。"
                            }
                        },
                        {
                            "text": "The small boat <w>hugged</w> the shore to avoid the rough waves.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка <w>держалась</w> берега, чтобы избежать сильных волн.",
                                "zh": "小船<w>紧贴</w>着岸边航行以避开大浪。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hug the shore",
                        "hug the road",
                        "hug the curve",
                        "hug the coast"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться очень близко к определенному пути, границе или краю.",
                        "zh": "移动时紧贴着某条路径、边界或边缘。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "держаться",
                                "target_lang_sense_clarification": "двигаться рядом с чем-то"
                            },
                            {
                                "target_lang_word": "идти вдоль",
                                "target_lang_sense_clarification": "следовать линии чего-либо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧贴",
                                "target_lang_sense_clarification": "靠近边缘移动"
                            },
                            {
                                "target_lang_word": "沿……行进",
                                "target_lang_sense_clarification": "沿着边界走"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c583e454-c626-330a-9205-fbd04eb28a50",
                    "sense_definition": "To fit or cling closely to something, often used to describe tight clothing.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wet fabric <w>hugged</w> his body uncomfortably.",
                            "target_lang_translations": {
                                "ru": "Мокрая ткань неприятно <w>облепила</w> его тело.",
                                "zh": "湿透的布料让他感到不适地<w>紧贴</w>在身上。"
                            }
                        },
                        {
                            "text": "She wore a dress that <w>hugged</w> her figure perfectly.",
                            "target_lang_translations": {
                                "ru": "На ней было платье, которое идеально <w>облегало</w> ее фигуру.",
                                "zh": "她穿了一件完美<w>贴合</w>她身形的连衣裙。"
                            }
                        }
                    ],
                    "synonyms": [
                        "stick",
                        "adhere",
                        "cleave"
                    ],
                    "common_phrases": [
                        "hug the body",
                        "hug the hips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотно прилегать или обтягивать (обычно об одежде).",
                        "zh": "紧紧贴合某物，常用于形容紧身衣物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "облегать",
                                "target_lang_sense_clarification": "сидеть по фигуре"
                            },
                            {
                                "target_lang_word": "обтягивать",
                                "target_lang_sense_clarification": "плотно прилегать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧贴",
                                "target_lang_sense_clarification": "物体表面接触"
                            },
                            {
                                "target_lang_word": "紧裹",
                                "target_lang_sense_clarification": "衣物贴身"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e08d0587-8a28-3d81-8357-f0e30c405c1c",
                    "sense_definition": "To hold on to a belief, idea, or feeling firmly and unwillingly to let go.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He still <w>hugs</w> the belief that he can change the past.",
                            "target_lang_translations": {
                                "ru": "Он все еще <w>цепляется</w> за веру в то, что может изменить прошлое.",
                                "zh": "他依然<w>固守</w>着自己能改变过去的信念。"
                            }
                        },
                        {
                            "text": "Some people <w>hug</w> their prejudices rather than facing the truth.",
                            "target_lang_translations": {
                                "ru": "Некоторые люди <w>держатся</w> за свои предрассудки, вместо того чтобы взглянуть правде в глаза.",
                                "zh": "有些人宁愿<w>坚持</w>偏见，也不愿面对真相。"
                            }
                        }
                    ],
                    "synonyms": [
                        "treasure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Твердо придерживаться убеждения, идеи или чувства, не желая отпускать их.",
                        "zh": "坚定地坚持某种信念、想法或感受，不愿放弃。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "цепляться",
                                "target_lang_sense_clarification": "упорно держаться за что-то"
                            },
                            {
                                "target_lang_word": "держаться",
                                "target_lang_sense_clarification": "не отступать от чего-то"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "固守",
                                "target_lang_sense_clarification": "坚持某种观念"
                            },
                            {
                                "target_lang_word": "坚持",
                                "target_lang_sense_clarification": "不愿改变"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8957947-9be5-3c1e-94a0-b7d39ce4ff45",
                    "sense_definition": "To crouch low or huddle, often to keep warm or stay hidden.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The frightened animal <w>hugged</w> the ground to avoid being seen.",
                            "target_lang_translations": {
                                "ru": "Испуганное животное <w>прижалось</w> к земле, чтобы его не заметили.",
                                "zh": "受惊的动物<w>紧贴</w>地面以防被发现。"
                            }
                        },
                        {
                            "text": "They <w>hugged</w> down behind the wall to escape the wind.",
                            "target_lang_translations": {
                                "ru": "Они <w>припали</w> к земле за стеной, спасаясь от ветра.",
                                "zh": "他们躲在墙后<w>蜷缩</w>着身体以避风。"
                            }
                        }
                    ],
                    "synonyms": [
                        "hunker",
                        "squat",
                        "stoop"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "often used in regional or older texts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Припадать к земле или сжиматься, часто чтобы согреться или спрятаться.",
                        "zh": "身体蜷缩或紧贴地面，通常为了保暖或躲藏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прижиматься",
                                "target_lang_sense_clarification": "плотно прилегать всем телом"
                            },
                            {
                                "target_lang_word": "припадать",
                                "target_lang_sense_clarification": "низко наклоняться к земле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "紧贴",
                                "target_lang_sense_clarification": "身体贴近地面"
                            },
                            {
                                "target_lang_word": "蜷缩",
                                "target_lang_sense_clarification": "身体收缩"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b4564250-7c1a-3e3a-bff1-bcd83a94c78c",
                    "sense_definition": "A close embrace where two people hold each other, usually to express affection, love, or comfort.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "embrace_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave her mother a big <w>hug</w> when she arrived.",
                            "target_lang_translations": {
                                "ru": "Она крепко <w>обняла</w> маму, когда приехала.",
                                "zh": "她到达时给了母亲一个大大的<w>拥抱</w>。"
                            }
                        },
                        {
                            "text": "Everyone needs a <w>hug</w> when they are feeling sad.",
                            "target_lang_translations": {
                                "ru": "Каждому нужны <w>объятия</w>, когда ему грустно.",
                                "zh": "每个人在难过时都需要一个<w>拥抱</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "embrace",
                        "squeeze"
                    ],
                    "common_phrases": [
                        "give a hug",
                        "big hug",
                        "group hug",
                        "bear hug"
                    ],
                    "target_lang_definitions": {
                        "ru": "Тесное объятие, когда два человека держат друг друга, выражая любовь или утешение.",
                        "zh": "两人互相紧紧抱住，通常用于表达爱意、亲情或安慰。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объятие",
                                "target_lang_sense_clarification": "жест выражения чувств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "拥抱",
                                "target_lang_sense_clarification": "名词，指拥抱的动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "48cd265a-3654-3690-8390-9dfec2857625",
                    "sense_definition": "A specific type of tight grip used in the sport of wrestling.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wrestler trapped his opponent in a powerful <w>hug</w>.",
                            "target_lang_translations": {
                                "ru": "Борец поймал противника в мощный <w>захват</w>.",
                                "zh": "摔跤手用强力的<w>锁抱</w>困住了对手。"
                            }
                        },
                        {
                            "text": "He could not escape the tight <w>hug</w> of the champion.",
                            "target_lang_translations": {
                                "ru": "Он не мог вырваться из крепкого <w>захвата</w> чемпиона.",
                                "zh": "他无法从冠军那紧密的<w>锁抱</w>中挣脱。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Особый вид жесткого захвата, используемый в спортивной борьбе.",
                        "zh": "摔跤运动中使用的一种紧密锁抱动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "захват",
                                "target_lang_sense_clarification": "прием в борьбе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "锁抱",
                                "target_lang_sense_clarification": "摔跤术语"
                            },
                            {
                                "target_lang_word": "抱锁",
                                "target_lang_sense_clarification": "摔跤动作"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}