                                        "glosses": [
                                            "The sound or action of one who champs (bites or chews)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c8d900d-2840-42bc-b422-570ab69df621",
                                                "sense_id": "f161d9c0-f7eb-3868-99c9-7ac9a007e8dc",
                                                "text": "When I passed them each a plate of the fried meat, they ate greedily, making loud mouth-noises — champings of worn teeth and sucking intakes of the breath, accompanied by a continuous spluttering and mumbling."
                                            }
                                        ]
