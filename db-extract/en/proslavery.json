                "word_linkages": []
            },
            {
                "entry_id": "67415690-f238-3aa6-b9e3-4d5c4368db28",
                "word": "proslavery",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a2fcc7b2-a5de-39c9-a0b4-7101ab786d8e",
                        "entry_id": "67415690-f238-3aa6-b9e3-4d5c4368db28",
                        "glosses": [
                            "Support for the institution of slavery."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "63b42d99-178d-4e62-b26c-4a35c86bc404",
                                "sense_id": "a2fcc7b2-a5de-39c9-a0b4-7101ab786d8e",
                                "text": "The old wisdom that southerners rose up in unison in 1831 after a decade of preparation in the tenets of proslavery is patently an erroneous interpretation."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "55deebcb-3618-4bcf-beda-3115457b931b",
                        "source_entry_id": "67415690-f238-3aa6-b9e3-4d5c4368db28",
                        "source_sense_id": "a2fcc7b2-a5de-39c9-a0b4-7101ab786d8e",
                        "source_sense_description": "support for the institution of slavery",
                        "target_lang_word": "esclavagisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "esclavagisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b6c7534-60e8-3cf5-9bc0-ceeeaa60f62d",
                                        "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                                        "glosses": [
                                            "Système social fondé sur l'esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "654cdf10-3ef5-4149-97c2-5bb5bae2ceb5",
                                                "sense_id": "2b6c7534-60e8-3cf5-9bc0-ceeeaa60f62d",
                                                "text": "Finalement, la fin de l’esclavagisme et du travail forcé avait laissé la place à un autre système, celui du travail obligé. Et ce dernier était encore plus profitable à l’homme blanc que le précédent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f230fee4-8d61-3fe4-b121-217a215969cc",
                                        "entry_id": "3e72cd3f-2a15-3e01-a3e0-e0fde47a102b",
                                        "glosses": [
                                            "Doctrine favorable à l'esclavage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8c52724-b0a3-4761-a14c-5ae8618d49bf",
                                                "sense_id": "f230fee4-8d61-3fe4-b121-217a215969cc",
                                                "text": "Cependant, le maintien du statut colonial et du pouvoir des grands planteurs fait que la liberté et la citoyenneté vont être « colorées » par le colonialisme et l’héritage de l’esclavagisme."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
