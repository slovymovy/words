                        "target_lang_word": "vingt-quatre heures sur vingt-quatre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vingt-quatre heures sur vingt-quatre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                        "entry_id": "591db4be-9c11-3b58-939d-0be31bb6cdd3",
                                        "glosses": [
                                            "Le jour et la nuit, sans aucune interruption."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1690c4d-99ef-4ccd-83a9-e3537d27343c",
                                                "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                                "text": "– Ce sont des paysans à qui on a donné des sabres et qu’on abrutit d’injures vingt-quatre heures sur vingt-quatre."
                                            },
                                            {
                                                "example_id": "350471a1-5a53-491f-ba9d-9484b17883c8",
                                                "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                                "text": "La lumière électrique crue vingt-quatre heures sur vingt-quatre dans la cellule ou le box où vous êtes enfermé, avec une ampoule d’une puissance démesurée pour un local aussi exigu et aux murs peints en blanc."
                                            },
                                            {
                                                "example_id": "0d066114-5b8e-4bbb-bbff-53ca7f1525dd",
                                                "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                                "text": "À mon avis, c’est le froid qui m’empêchait de dormir. Le froid tout autant que le bruit de la chaudière, quand d’aventure elle s’allumait, bruit que je guettais, plus tendu qu’un crin d’archet, vingt-quatre heures sur vingt-quatre, alors qu’elle ne s’allumait que tous les trente-six du mois, car elle était réglée au minimum."
                                            },
                                            {
                                                "example_id": "703c6fd7-8036-4286-9ccd-a5775ed2b9ad",
                                                "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                                "text": "La SCCOPOL fonctionne vingt-quatre heures sur vingt-quatre, sept jours sur sept, et constitue le point d’entrée unique des demandes émises par les enquêteurs français auprès des services étrangers comme des sollicitations en provenance de l’étranger."
                                            },
                                            {
                                                "example_id": "6ac04dba-46b0-4de3-98f1-9d2f38a65251",
                                                "sense_id": "903e260b-f901-38f7-9b9e-fcfa5bbc8460",
                                                "text": "Sous les faire-part de décès dans Adresseavisen se trouvaient des publicités pour d’autres entreprises de pompes funèbres, dont deux avec un numéro de téléphone joignable vingt-quatre heures sur vingt-quatre. Il examina ces réclames."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
