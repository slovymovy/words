                "senses": [
                    {
                        "sense_id": "38737806-b581-3c24-bd95-47b4334ffb30",
                        "entry_id": "882758c9-af00-395f-9dee-36c4cfede7cd",
                        "glosses": [
                            "großes Eichenholzfass, in dem Wein reift"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32e05de3-b1c3-4db3-811b-d9cfc2a28b4a",
                                "sense_id": "38737806-b581-3c24-bd95-47b4334ffb30",
                                "text": "„Die Küche des hotel12 bezieht fast alle Zutaten von den Bauern der Gegend, an diesem Abend gibt es Hühnchen mit Speck-Kürbiskern-Füllung und Selleriecreme. Dazu das H12 Grand Cuvée 2009, einen tollen Rotwein, gereift im Barriquefass, den ein Winzer aus dem Burgenland für das Hotel abfüllt. Das alles bereitet so verdammt gute Laune, dass man nur noch dasitzt und lächelt.“"
                            },
                            {
                                "example_id": "35010da3-1f79-42c9-8c6c-6dcdaa4a863d",
                                "sense_id": "38737806-b581-3c24-bd95-47b4334ffb30",
                                "text": "„Mit dem Barriquefass mussten viele Winzer oft erst noch Erfahrungen sammeln.“"
                            },
                            {
                                "example_id": "82dc48b8-96cb-41cb-ab5a-fa93d6f40180",
                                "sense_id": "38737806-b581-3c24-bd95-47b4334ffb30",
                                "text": "„In der Regel wird dem Barriquefass das Bordelaiser Schiffsmaß von 225 Litern zugeordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
