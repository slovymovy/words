                "senses": [
                    {
                        "sense_id": "b4113cb8-0aa8-3aee-9718-fdc0bc2cd93c",
                        "entry_id": "140c4c90-206b-39ad-b40d-c84b7bb7a28d",
                        "glosses": [
                            "ein sehr elastisches Gewebe aus Kräuselgarn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f74795a3-fb5a-49ac-9e1b-7b8632a78b28",
                                "sense_id": "b4113cb8-0aa8-3aee-9718-fdc0bc2cd93c",
                                "text": "Strümpfe aus Stretch bieten angeblich einen angenehmen Tragekomfort."
                            },
                            {
                                "example_id": "9f437a23-0ee1-46b0-a369-7cd64f8e4fe6",
                                "sense_id": "b4113cb8-0aa8-3aee-9718-fdc0bc2cd93c",
                                "text": "Ein Anzug aus Stretch macht aus ihm einen feinen Kavalier, der, so scheint es jedenfalls, zu seiner Liebsten geht."
                            },
                            {
                                "example_id": "f783dc05-5ab7-4e1c-ae06-590de5cc31e8",
                                "sense_id": "b4113cb8-0aa8-3aee-9718-fdc0bc2cd93c",
                                "text": "In der engen Stretch-Laufhose wirkte sie mit ihren langen Beinen gazellenhaft."
                            },
                            {
                                "example_id": "abfa5658-7eff-4440-a305-a92d9c4ec590",
                                "sense_id": "b4113cb8-0aa8-3aee-9718-fdc0bc2cd93c",
                                "text": "Ihm war heiß in der grauen Stretch-Hose, sein Nacken war von der Sonne bereits verbrannt und jedes Mal, wenn er den Kopf bewegte, kratzte der Kragen seines weißen T-Shirts auf der zarten Haut."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
