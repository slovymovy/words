                        "entry_id": "d5cbd298-bb98-35c3-9899-b4530de2d2bb",
                        "glosses": [
                            "soort jas, oorspronkelijk ontworpen voor de Engelse soldaten van WW I, die sluit met langwerpige houten knopen en lussen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d212bb8b-0ad7-48e6-9a52-14f5554704a2",
                                "sense_id": "8ef32c96-1233-3eea-9716-6f17188ca402",
                                "text": "Een houtje-touwtjejas was tot lang na de Tweede Wereldoorlog erg populair."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dbbd7dfe-3a94-413f-8298-e6540669fe99",
                        "source_entry_id": "d5cbd298-bb98-35c3-9899-b4530de2d2bb",
                        "source_sense_id": "8ef32c96-1233-3eea-9716-6f17188ca402",
