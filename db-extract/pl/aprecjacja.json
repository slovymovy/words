                        "cross_references": [
                            {
                                "target_word": "appreciation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "581fb8e6-728b-3b17-9ecf-c05af260fb40",
                                        "entry_id": "06b5bff6-cde6-308b-900c-27c839a780ba",
                                        "glosses": [
                                            "The act of appreciating."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2dd41710-cea9-35b5-b5e7-a349bf058951",
                                        "entry_id": "06b5bff6-cde6-308b-900c-27c839a780ba",
                                        "glosses": [
                                            "A fair valuation or estimate of merit, worth, weight, etc.; recognition of excellence; gratitude and esteem."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3247b3a2-1181-42ef-97a3-32320acc6189",
                                                "sense_id": "2dd41710-cea9-35b5-b5e7-a349bf058951",
                                                "text": "We give to you this trophy as a token of our appreciation of all your years of service."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "748f117d-99e8-3c35-bcb6-29eba5193c9f",
                                        "entry_id": "06b5bff6-cde6-308b-900c-27c839a780ba",
                                        "glosses": [
                                            "Accurate perception; true estimation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4621a05-2ce0-449b-b13b-3fd07204e3c1",
                                                "sense_id": "748f117d-99e8-3c35-bcb6-29eba5193c9f",
                                                "text": "an appreciation of the difficulties before us"
                                            },
                                            {
                                                "example_id": "2d4f8baa-d09d-4352-9938-87987bae0449",
                                                "sense_id": "748f117d-99e8-3c35-bcb6-29eba5193c9f",
                                                "text": "an appreciation of colors"
                                            },
                                            {
                                                "example_id": "0e37a6e4-1416-405b-adf2-c7c491eb3b7d",
                                                "sense_id": "748f117d-99e8-3c35-bcb6-29eba5193c9f",
                                                "text": "The English, until relatively recently, seem to have imagined “English” and “British” to be interchangeable, as if Britain was just a bigger England. Our dualism gave us a better appreciation of the nation-state we lived in, though if Britain was a “nation” as well as a “state”, where did that leave Scotland?"
                                            },
                                            {
                                                "example_id": "ab509779-4d93-460c-b470-7d407edec330",
                                                "sense_id": "748f117d-99e8-3c35-bcb6-29eba5193c9f",
                                                "text": "His foreboding showed his appreciation of Henry's character."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3abaa43-35c9-336b-94da-cf74f0a7ef34",
                                        "entry_id": "06b5bff6-cde6-308b-900c-27c839a780ba",
                                        "glosses": [
                                            "A rise in value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
