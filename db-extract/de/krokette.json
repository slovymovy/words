                    },
                    {
                        "translation_id": "82f27bc7-9159-442f-a7af-1773ef8288fa",
                        "source_entry_id": "857d7f59-9ea2-371c-b3a1-25d577f3bd68",
                        "source_sense_id": "7d48e7e2-fd8a-3c51-b94a-e12d4a77607c",
                        "target_lang_word": "croquette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "croquette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "319ca475-ad31-35b3-95a9-a508f26a41c1",
                                        "entry_id": "f80fee21-d8f6-31f7-bc3e-757e95ed8c7e",
                                        "glosses": [
                                            "Boulette alimentaire de composition variée, mélangée à de la béchamel puis trempée dans du jaune d’œuf et saupoudrée de chapelure ou de farine, frite et croquante sous la dent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8347f2d3-ce4c-419a-aa85-88bb49419b1c",
                                                "sense_id": "319ca475-ad31-35b3-95a9-a508f26a41c1",
                                                "text": "Il avait fait des pommes de terre sautées pour accompagner des croquettes de viande et, ayant tout mis dans une casserole, il avait enveloppé la casserole dans une couverture pour la garder au chaud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e92dbd9-a0e0-3656-9d6c-89c9993e05df",
                                        "entry_id": "f80fee21-d8f6-31f7-bc3e-757e95ed8c7e",
                                        "glosses": [
                                            "Friandise sèche, de forme plate et ronde ou ovale."
                                        ],
                                        "tags": [
                                            "Confiserie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7976df70-b98f-49aa-bebe-34e8064a0c84",
                                                "sense_id": "6e92dbd9-a0e0-3656-9d6c-89c9993e05df",
                                                "text": "Nougats de Montélimar au miel sous toutes ses formes dont ce cœur à la Saint-Valentin, tendre cœur en nougat, des croquettes de nougat au chocolat pour fondre de plaisir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a805ca67-e9ca-374c-80d4-6ba1a4d1189d",
                                        "entry_id": "f80fee21-d8f6-31f7-bc3e-757e95ed8c7e",
                                        "glosses": [
                                            "Pellet d’aliment pour animaux, en particulier pour les chiens ou les chats."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f929495-eb29-43e7-9e6e-3b416062f14f",
                                                "sense_id": "a805ca67-e9ca-374c-80d4-6ba1a4d1189d",
                                                "text": "Je rentrai chez moi et préparai la gamelle de mon chien « Raymond » agrémentée de petites croquettes et de pâté au poulet."
                                            },
                                            {
                                                "example_id": "9d05f1f2-c88e-4fbe-a343-c0648cc28974",
                                                "sense_id": "a805ca67-e9ca-374c-80d4-6ba1a4d1189d",
                                                "text": "Aujourd’hui, je suis allée en France (je suis québécoise). Au McDo, voulant manger du poulet, j’ai commandé des croquettes. Tout le monde a explosé de rire sans que je comprenne pourquoi. Il semble qu’en France, il n’y a que les animaux qui mangent des croquettes. VDM"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72147bf7-0ea1-3b56-bf02-46fba696af44",
                                        "entry_id": "f80fee21-d8f6-31f7-bc3e-757e95ed8c7e",
                                        "glosses": [
                                            "Coup de poing, pichenette."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16c50cd7-e540-4a04-9ce9-d3f74cf2add6",
                                                "sense_id": "72147bf7-0ea1-3b56-bf02-46fba696af44",
                                                "text": "Puis course d’obstacles vers la sortie, piétinant petites culottes et slips abandonnés par terre, saut carpé du peignoir s’égouttant sur le lit, pied qui se tord dans la savate à talon, rixe générale et « Va-te-faire-voir », suivi de lancer de croquettes en plein dans les oreilles."
                                            },
                                            {
                                                "example_id": "01475296-16c0-4284-a8fb-40a93b780cf9",
                                                "sense_id": "72147bf7-0ea1-3b56-bf02-46fba696af44",
                                                "text": "Mais elle est dingue, elle vient de me mettre une croquette, pas la pichenette du coin du doigt, les bonnes quatre phalanges enfoncées sur mon front et bien évidemment sur ma blessure, au moins le sous-marin a replongé dans les abysses."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
