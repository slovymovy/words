                "senses": [
                    {
                        "sense_id": "c36ff704-bb2f-30fe-a4a6-75b812fc2732",
                        "entry_id": "7810ae03-bbd7-3c7b-82ca-f991f038adea",
                        "glosses": [
                            "A certain non-steroidal anti-inflammatory drug that inhibits the COX-1 and COX-2 enzymes and thereby reduces pain, fever, inflammation, and stiffness."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "dff233f0-417c-4d41-b9fd-fa49b118ccd5",
                                "sense_id": "c36ff704-bb2f-30fe-a4a6-75b812fc2732",
                                "text": "These days, especially when she kept on top of taking her naproxen, the hurt in her joints and limbs merely teased."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f31aa6a1-54b9-48e2-9f41-5588fff9601b",
