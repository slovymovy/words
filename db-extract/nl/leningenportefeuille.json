                        "examples": [
                            {
                                "example_id": "2f074357-d617-4fbc-928f-b914cfbd2f36",
                                "sense_id": "99b3877c-86b5-3865-a719-a821f5726029",
                                "text": "ING is met een leningenportefeuille van 7,5 miljard euro de belangrijkste en grootste Nederlandse bank in Rusland en ligt straatlengtes voor op andere Nederlandse financiële instellingen. ING is vooral actief met leningen en exportfinancieringen in de olie- en gasindustrie en heeft de grootste Russische en Nederlandse bedrijven als klanten."
                            },
                            {
                                "example_id": "8d5ecb57-21c9-4a84-a119-4bb345be2be9",
                                "sense_id": "99b3877c-86b5-3865-a719-a821f5726029",
                                "text": "Het gaat om kredietverstrekker Arenda, bekend van onder meer het product Vola. In 2005 verkocht ING het onderdeel voor 21,5 miljoen euro aan het investeringsbedrijf Amodo. Aan het eind van dat jaar bleek de leningenportefeuille veel minder waard te zijn."
                            }
