                                            {
                                                "example_id": "3d4410a2-a955-4770-9154-7b3dcac43d9e",
                                                "sense_id": "87396f15-0b50-3f8c-a97e-ce203794c32e",
                                                "text": "L'algolagnie remonte loin (histoire de l'Église au moyen âge), ses diverses formes sont le flagellantisme, l'algolagnie bestiale, la nécrophilie."
                                            },
                                            {
                                                "example_id": "2129d79f-28e2-4786-94ce-4a9a2d68c6b3",
                                                "sense_id": "87396f15-0b50-3f8c-a97e-ce203794c32e",
                                                "text": "Le flagellantisme, qui recrute ses principaux adhérents parmi les officiers de la garnison de Strasbourg, consiste en ceci : l'homme et la femme étant complètement nus, cette dernière frappe son compagnon à l'aide de ces baguettes; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7bc3685-d6f0-3585-995f-c894d3f5323a",
                                        "entry_id": "a7714594-26f4-3e19-8784-ef2a43dcacbc",
                                        "glosses": [
                                            "Propension à se punir soi-même."
                                        ],
