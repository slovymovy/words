                    },
                    {
                        "translation_id": "2a45cd69-8c89-4b64-80a9-350521713648",
                        "source_entry_id": "dcdc32f0-4b36-3298-ac5d-0db1e58f5916",
                        "target_lang_word": "scrofuleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
