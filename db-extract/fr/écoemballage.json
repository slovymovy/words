                "senses": [
                    {
                        "sense_id": "eccf043c-a540-3ad5-b433-e08349a1d731",
                        "entry_id": "ac685d8c-31bd-3998-a75b-0cf4c04d2722",
                        "glosses": [
                            "Emballage respectueux de l’environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bdc5cd6a-fa93-43c5-aeab-c4ceeb8d6d01",
                                "sense_id": "eccf043c-a540-3ad5-b433-e08349a1d731",
                                "text": "Le point vert visible sur la plupart des emballages est souvent pris pour une attestation d’écoemballage, en réalité, il signifie simplement que la société qui fabrique le produit contribue financièrement à la collecte sélective des déchets."
                            },
                            {
                                "example_id": "06e60a06-3289-43cb-ba00-7bcf97615b9f",
                                "sense_id": "eccf043c-a540-3ad5-b433-e08349a1d731",
                                "text": "Les Pentawards ont récompensé en 2009 un écoemballage à base de matériaux 100% recyclés et recyclables pour des ampoules à économie d’énergie."
                            }
                        ]
                    }
                ],
                "translations": [
