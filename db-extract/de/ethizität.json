                "senses": [
                    {
                        "sense_id": "425a47ee-06e9-35e0-bfec-a3508960533c",
                        "entry_id": "e544112f-b1e6-3636-8f10-c28a1597527c",
                        "glosses": [
                            "die Tatsache, dass eine philosophische Größe oder ein Sachverhalt wie z.B. die Person oder das Leben als ethisch bewertet wird oder zu bewerten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f83970a6-6d23-473d-8dab-2a3be7748a58",
                                "sense_id": "425a47ee-06e9-35e0-bfec-a3508960533c",
                                "text": "„Ich möchte nur den zentralen Passus der Enzyklopädie über die Beziehungen des Staates zur Religion in Erinnerung rufen: „Die sofortige Konsequenz dessen, was vorausging, ist, daß die Ethizität der Staat ist, zurückgeführt auf seine substantielle Innerlichkeit ist; […]““"
                            },
                            {
                                "example_id": "c24481c8-044f-4fea-a539-f1dfe5163382",
                                "sense_id": "425a47ee-06e9-35e0-bfec-a3508960533c",
                                "text": "„[…] schließlich wollen wir klären, ob es nicht in der Tat spezifisch bioethische Aspekte zu beachten gilt, mit denen eine Relativierung des Autonomieprinzips einhergehen könnte. Wir werden sehen, dass es solche Aspekte tatsächlich gibt – dass aber auch eine „Versöhnung“ zwischen der immanenten Ethizität des Lebens und der Ethik der Freiheit nicht einfach undenkbar ist“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
