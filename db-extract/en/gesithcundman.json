                        "entry_id": "691902e8-715c-3191-9bd6-e2ac4e290e47",
                        "glosses": [
                            "A gesith."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54975030-e521-4d10-b94e-3dace0f061b6",
                                "sense_id": "4add90a0-b579-32c0-afdf-baa657662b62",
                                "text": "The gesiths, gesithmen, or gesithcundmen, were the military companions or followers of the Anglo-Saxon chiefs and Kings."
                            },
                            {
                                "example_id": "14b5d38b-5dbd-41e1-a292-d7ca9caed0b5",
                                "sense_id": "4add90a0-b579-32c0-afdf-baa657662b62",
                                "text": "The penalty of the adultery of the gesithcundman goes to his lord, ‘according to ancient usage.’"
                            },
                            {
                                "example_id": "2ab2ac21-3a63-4a5a-b51b-af6afee853ef",
                                "sense_id": "4add90a0-b579-32c0-afdf-baa657662b62",
                                "text": "Now, if we might regard the gesithcundman as one of a class to whom ten hides or twenty hides had been allotted by King Ine on a system providing in this practical way inter alia for the night’s entertainments, it would be natural that the food rent of the unit of ten hides should be fixed."
                            }
                        ]
                    }
