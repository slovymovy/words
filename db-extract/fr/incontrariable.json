                        "examples": [
                            {
                                "example_id": "6cba6b81-8e69-4cfb-a153-0604768862da",
                                "sense_id": "ee47d5f5-93e5-37e5-8f8f-f5d739ede99d",
                                "text": "Selon toute probabilité la vocation poétique, au même titre que la vocation philosophique, est, n’en déplaise aux sociologues, tout à fait incontrariable."
                            },
                            {
                                "example_id": "0ce0184a-d749-4c6a-baa7-48fe9655083e",
                                "sense_id": "ee47d5f5-93e5-37e5-8f8f-f5d739ede99d",
                                "text": "Pour ce cryptofumeur, vapoter est devenu sa cause, son affirmation de soi, son droit incontrariable... et une planche de salut tabagique inespérée qu’il ne lâchera pas aisément."
                            }
                        ]
