                        "examples": [
                            {
                                "example_id": "bce18233-a2f4-4089-bf53-a00c95b7678c",
                                "sense_id": "a36ecd92-da51-3735-b522-ce34f5ccb6fc",
                                "text": "Der Sachbearbeiter im Standesamt war zur Vornahme der Amtshandlung befugt."
                            },
                            {
                                "example_id": "e729afa3-053b-4c4f-9306-15f3103b5693",
                                "sense_id": "a36ecd92-da51-3735-b522-ce34f5ccb6fc",
                                "text": "Sie wurde mit der Vornahme aller erforderlichen Handelsregisteranmeldungen betraut."
