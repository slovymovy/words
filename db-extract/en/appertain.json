                        "source_sense_description": "to belong to or be a part of, whether by right, nature, appointment, or custom; to relate to",
                        "target_lang_word": "принадлежа́ть",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "принадлежа́ть",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "c1dec0e7-946b-3271-ba2b-15950b9ce040",
