                "senses": [
                    {
                        "sense_id": "a928f647-186e-3768-8df8-2b855eba129e",
                        "entry_id": "d0a1c078-ebd9-3d36-a131-20ac604a5541",
                        "glosses": [
                            "Agencer à nouveau, d’une nouvelle façon."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2deba6bd-4730-4ef5-b436-cefe44493743",
                                "sense_id": "a928f647-186e-3768-8df8-2b855eba129e",
                                "text": "Dans la foulée, c’est le garage à véhicules routiers qui a été réagencé afin d’y placer notre camion-grue dont l’utilité n’est plus à démontrer ; là aussi ce fut l’occasion d’évacuer tout ce qui est stocké « au cas où », mais ne sert jamais."
                            },
                            {
                                "example_id": "9b49ddb6-0268-4349-ba16-d571bcfa11a2",
                                "sense_id": "a928f647-186e-3768-8df8-2b855eba129e",
                                "text": "Le matin, elle bricole son manuscrit, réagence des chapitres, coupe, récrit."
                            }
                        ]
                    }
