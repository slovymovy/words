                        "form": "achtergrondje"
                    },
                    {
                        "form_id": "1e35622d-b950-4c43-8319-b239525c70c8",
                        "entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "tags": [
                            "diminutive",
                            "plural"
                        ],
                        "form": "achtergrondjes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "27a45996-f562-340b-8d28-fc7f1b1d2356",
                        "entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "glosses": [
                            "letterlijk, hetgeen zich achter de voorgrond bevindt, vaak het aandachtspunt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "568af107-5706-4dab-a901-2ce232400644",
                                "sense_id": "27a45996-f562-340b-8d28-fc7f1b1d2356",
                                "text": "Pasfoto's hebben vaak een rustige achtergrond."
                            },
                            {
                                "example_id": "b268393a-1a47-4ce0-a461-0f38a3f30901",
                                "sense_id": "27a45996-f562-340b-8d28-fc7f1b1d2356",
                                "text": "Eenmaal aangekomen op de pas vermaakte ik me, net als de poedelnaakte Goldie, door foto’s te nemen terwijl we een handstand maakten met de betoverende Kings Canyon bergen op de achtergrond."
                            }
                        ]
                    },
                    {
                        "sense_id": "a4afb7a3-950d-34e2-ba1e-af3bd0eda891",
                        "entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "glosses": [
                            "figuurlijk, iets dat naar de achtergrond verdwijnt of raakt, iets dat uit de aandacht raakt (vaak doordat iets niet belangrijk gevonden wordt)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05803c53-d0ab-4e81-a178-1bd63bd48ce9",
                                "sense_id": "a4afb7a3-950d-34e2-ba1e-af3bd0eda891",
                                "text": "Dat punt is naar de achtergrond geraakt."
                            },
                            {
                                "example_id": "3e6ffcf1-0865-4cbd-acf4-c4d41f404b4c",
                                "sense_id": "a4afb7a3-950d-34e2-ba1e-af3bd0eda891",
                                "text": "Waar tot een paar jaar terug nog gekeken werd naar Tesla voor de grote innovaties, lijkt de blik nu te zijn gericht naar China. Eerdere zorgen over dat China de data van de auto's zou gebruiken, lijken voor veel consumenten naar de achtergrond te zijn verdwenen."
                            }
                        ]
                    },
                    {
                        "sense_id": "389d1bec-b0bb-3efb-91bb-59c4618cf927",
                        "entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "glosses": [
                            "verleden van een persoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5868ba6f-497d-48eb-bab7-474086691010",
                                "sense_id": "389d1bec-b0bb-3efb-91bb-59c4618cf927",
                                "text": "Dat komt door zijn achtergrond."
                            },
                            {
                                "example_id": "dd08bc4a-10b8-4098-86f2-3050642fcc7d",
                                "sense_id": "389d1bec-b0bb-3efb-91bb-59c4618cf927",
                                "text": "Hij heeft een communistische achtergrond."
                            }
                        ]
                    },
                    {
                        "sense_id": "b015dfcc-6a50-3489-abdd-83ae6ee0406d",
                        "entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "glosses": [
                            "de indirecte oorzaak van actualiteiten, de achterliggende oorzaak of betekenis"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "54f0aa2b-53a3-45ea-820a-9c8bcc802400",
                                "sense_id": "b015dfcc-6a50-3489-abdd-83ae6ee0406d",
                                "text": "Week en maandbladen richten zich vaak meer dan dagbladen op achtergronden."
                            },
                            {
                                "example_id": "281ce2a6-5260-487c-8fe1-1c06cc10b955",
                                "sense_id": "b015dfcc-6a50-3489-abdd-83ae6ee0406d",
                                "text": "Toen men uiteindelijk onder begeleiding van de politie naar boven ging, lag daar Francisco, doorboord met kogels. Men heeft nooit geweten wat de achtergronden van zijn dood waren. Hij was alom geliefd."
                            },
                            {
                                "example_id": "e9e3beea-3294-4662-8945-8d0b771b2cad",
                                "sense_id": "b015dfcc-6a50-3489-abdd-83ae6ee0406d",
                                "text": "In onze tijd bestaat er een toenemende belangstelling, zowel voor de folklore als voor de achtergrond en de inhoud van de feesten. Temeer als die beleefd kunnen worden door het hele gezin en de hele groep, jong of oud."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a19521f9-18fd-4765-aa62-df53cf0974fe",
                        "source_entry_id": "6a28d096-2b76-3cb0-8938-25d0d85fcde6",
                        "source_sense_id": "27a45996-f562-340b-8d28-fc7f1b1d2356",
                        "source_sense_description": "de indirecte oorzaak van actualiteiten",
                        "target_lang_word": "Hintergrund",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hintergrund",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e794396b-68af-3536-8e52-c6371d9e4685",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "ein vom Standort abhängiger hinterer Bereich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebf0639d-7c42-4236-80bb-1ea4653dc055",
                                                "sense_id": "e794396b-68af-3536-8e52-c6371d9e4685",
                                                "text": "Im Hintergrund sah ich einen Mann zur Tür hinausschleichen."
                                            },
                                            {
                                                "example_id": "bdb7163a-7e19-4dcf-9a14-c3c722520896",
                                                "sense_id": "e794396b-68af-3536-8e52-c6371d9e4685",
                                                "text": "„Im Hintergrund dröhnte eine Jukebox.“"
                                            },
                                            {
                                                "example_id": "53667ed1-3e9d-44c6-9573-0e5810bb1308",
                                                "sense_id": "e794396b-68af-3536-8e52-c6371d9e4685",
                                                "text": "„Im Hintergrund schwoll das Geschrei wieder an, und dann schien meine Schwester den Raum zu wechseln, denn ich hörte das Zuschlagen einer Tür, und plötzlich herrschte Ruhe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b4408b9e-74be-3aa8-be27-29c25751e5a1",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "(Bild) der perspektivisch hinterste Bereich eines Bildes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f772420-eab7-4db8-bc18-b78d86715f01",
                                                "sense_id": "b4408b9e-74be-3aa8-be27-29c25751e5a1",
                                                "text": "Im Hintergrund des Bildes befindet sich ein Fluss."
                                            },
                                            {
                                                "example_id": "0be60e86-0cad-4ecb-9ed0-12fc917b5a0c",
                                                "sense_id": "b4408b9e-74be-3aa8-be27-29c25751e5a1",
                                                "text": "„Im Hintergrund lugte die schneebedeckte Kuppe eines Berges hervor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "672eeb69-5020-304f-aadb-973773e1ad01",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "(einer Tat) der Grund; Informationen darüber, weshalb etwas geschah"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37e863a2-2f40-4938-97a7-4112f32a7d9b",
                                                "sense_id": "672eeb69-5020-304f-aadb-973773e1ad01",
                                                "text": "Die Hintergründe der Tat sind weiterhin unbekannt."
                                            },
                                            {
                                                "example_id": "57f10940-7ef0-412c-b3eb-97ed3905cc2f",
                                                "sense_id": "672eeb69-5020-304f-aadb-973773e1ad01",
                                                "text": "„Hier wird nicht explizit kontrovers um religiöse Themen gestritten, aber der öffentliche Diskurs hierzu wäre ohne diesen Hintergrund weder existent noch verstehbar.“"
                                            },
                                            {
                                                "example_id": "aeeb5a9a-56b9-437e-95da-730bc7c7f93b",
                                                "sense_id": "672eeb69-5020-304f-aadb-973773e1ad01",
                                                "text": "„Vor seinem düsteren Hintergrund erzählt dieses Buch vom Mitgefühl und vom Mut, von der Besonnenheit und der Energie zum Handeln, von der Stärke der Schwachen.“"
                                            },
                                            {
                                                "example_id": "13449e15-be69-4f73-922d-fc5c8d3c5aa0",
                                                "sense_id": "672eeb69-5020-304f-aadb-973773e1ad01",
                                                "text": "„Der zeitgeschichtliche Hintergrund der endgültigen Fassung zeigt bereits den Aufmarsch des Nationalsozialismus, der schließlich zum Untergang der Republik führt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "bdebdeca-ea37-3366-a3c3-91b70f170a06",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "außerhalb (öffentlicher) Einsicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "701c4614-1426-4d5c-9c71-ee2e893be3cd",
                                                "sense_id": "bdebdeca-ea37-3366-a3c3-91b70f170a06",
                                                "text": "Was im Hintergrund geschieht, fällt niemandem auf."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "4342aa2a-fcae-348b-88e4-a30062ca8258",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "außerhalb der Beachtung; relative Unwichtigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0249ad9e-e30f-4c47-92f4-7c341a7b52a0",
                                                "sense_id": "4342aa2a-fcae-348b-88e4-a30062ca8258",
                                                "text": "Das eigentliche Thema geriet in den Hintergrund."
                                            },
                                            {
                                                "example_id": "c6fa31e3-47ed-430b-b434-fc5d2abfc5b2",
                                                "sense_id": "4342aa2a-fcae-348b-88e4-a30062ca8258",
                                                "text": "„Die Befindlichkeit des Reiches war im Inneren durch sozialen Frieden und wirtschaftliche Prosperität gekennzeichnet sowie durch Stabilität in der Außenpolitik, die zeitweilig in den Hintergrund trat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "38a0199c-0e4f-3773-85cf-ce850afa7c3c",
                                        "entry_id": "04330a27-ab4b-3a32-8573-fbff832db2c1",
                                        "glosses": [
                                            "(einer Person) die Lebensgeschichte; die prägende Vergangenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8b5591c-5787-4b83-8edd-208aa1b04a49",
                                                "sense_id": "38a0199c-0e4f-3773-85cf-ce850afa7c3c",
                                                "text": "Ihr privater Hintergrund hat niemanden zu interessieren."
                                            },
                                            {
                                                "example_id": "e5dddc60-7d27-425e-89f5-f993295ebfd1",
                                                "sense_id": "38a0199c-0e4f-3773-85cf-ce850afa7c3c",
                                                "text": "[Deutschland, 1945:] „Die Deutschen, die nach dem Krieg im Norden ankamen, hatten unterschiedliche kulturelle und konfessionelle Hintergründe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
                    },
