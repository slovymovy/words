                        "examples": [
                            {
                                "example_id": "0afe7ebe-5331-453c-b4d2-a2e4d7378405",
                                "sense_id": "b10b497c-0db0-3155-b304-8858f926f72e",
                                "text": "Alors que les collèges et universités états-uniens accueillent depuis longtemps des étudiants ayant été instruits à domicile, au Canada, une récente invitation a été lancée aux homeschoolers par l’Université d’Ottawa."
                            },
                            {
                                "example_id": "df4b4556-2ba5-4f49-967e-2328b1c5b1e6",
                                "sense_id": "b10b497c-0db0-3155-b304-8858f926f72e",
                                "text": "Ne consacrant qu’une heure ou deux par jour aux apprentissages formels (maths, orthographe), les homeschoolers ont du temps pour apprendre ce que l’école n’enseigne pas."
                            }
                        ]
                    }
                ],
