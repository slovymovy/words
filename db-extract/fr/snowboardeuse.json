                                "target_senses": [
                                    {
                                        "sense_id": "175105a3-ba6c-3da1-9e02-678c43194abe",
                                        "entry_id": "09c21101-a2ee-3944-8103-5d12818429ff",
                                        "glosses": [
                                            "weibliche Person, die mit einem Snowboard auf Schnee gleitet; die snowboardet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f01866b3-a2fe-498e-9e19-3a8e7231a97a",
                                                "sense_id": "175105a3-ba6c-3da1-9e02-678c43194abe",
                                                "text": "„Denn das, was da auf der Tafel steht, Platz eins für sie, die Snowboarderin, das kann natürlich nicht stimmen.“"
                                            },
                                            {
                                                "example_id": "02b8c6d0-a3b1-4a84-904f-40f60e315494",
                                                "sense_id": "175105a3-ba6c-3da1-9e02-678c43194abe",
                                                "text": "„Und wie verhält man sich als Snowboarderin unter Skifahrerinnen?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85803cf0-a23f-43ef-b0de-b011a3dd1160",
                        "source_entry_id": "edaa0cdd-18df-3d4a-b18b-13865d9c2888",
                        "source_sense_id": "06b83bd1-7c0e-39b8-a75e-52a8a9ef9f2b",
