                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "minime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                                        "entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                                        "glosses": [
                                            "Qui est très petit, très peu considérable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2a56719-dabb-4ffa-9ddc-d492b239afc3",
                                                "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                                                "text": "Aussi, dès qu'un paysan a réalisé une minime aisance , fait-il badigeonner d’ocre la façade et les murs intérieurs de son réduit : […]."
                                            },
                                            {
                                                "example_id": "9a3a1b01-d092-41a6-8d8e-5005077cb4c4",
                                                "sense_id": "a58890c9-a266-35ef-a3c7-5af9df4f5e86",
                                                "text": "Ce dernier conservera toujours sa valeur pour la culture intensive ; les scories Thomas, grâce au bon marché de leur acide phosphorique, doivent servir seulement à l'amélioration des grandes étendues des sols de minime valeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba9517a2-e7d2-3e03-af28-1e2d918fa7b5",
                                        "entry_id": "50414414-2ea0-3405-86ee-20ba63104cea",
                                        "glosses": [
                                            "Qui concerne, qui se rapporte à l’ordre religieux des Minimes fondé par François de Paule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f41ca0d2-16be-4ddc-8348-4556906d1247",
                                                "sense_id": "ba9517a2-e7d2-3e03-af28-1e2d918fa7b5",
                                                "text": "Pédagogue et maître spirituel, le religieux minime Nicolas Barré (1621-1686) œuvra pour l’éducation de nombreux enfants défavorisés du \"grand siècle\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "minime",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8584df4f-83f4-3245-b48a-6aa975cccbee",
                                        "entry_id": "927da48d-6f1e-3671-b380-0daa5551f9fc",
                                        "glosses": [
                                            "Religieux de la congrégation fondée par François de Paule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab1a3a04-b233-4a17-8ff7-3042335579da",
                                                "sense_id": "8584df4f-83f4-3245-b48a-6aa975cccbee",
                                                "text": "« Quartier des Minimes », « port des Minimes », « rue des Minimes » : plus de deux siècles après la disparition de la branche française de l'ordre fondé en 1435 par saint François de Paule, de nombreuses villes de France (Toulouse bien sûr, mais aussi La Rochelle, Paris, Rouen, Grenoble, Perpignan...) gardent le souvenir de cette congrégation religieuse qui était très répandue sous l'Ancien Régime."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4836b2d8-8bd4-3754-8dc8-0f365bd5b737",
                                        "entry_id": "927da48d-6f1e-3671-b380-0daa5551f9fc",
                                        "glosses": [
                                            "Sportif appartenant à une certaine catégorie d’âge selon le sport pratiqué, généralement aux alentours de 13 ans."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58055001-e73f-4c78-ade3-5a3225decdf5",
                                                "sense_id": "4836b2d8-8bd4-3754-8dc8-0f365bd5b737",
                                                "text": "Souhaites-tu poursuivre le badminton et passer minime l’an prochain ?"
                                            },
                                            {
                                                "example_id": "4aaf4cc6-b3e9-4660-9b5e-bcf5d447b055",
                                                "sense_id": "4836b2d8-8bd4-3754-8dc8-0f365bd5b737",
                                                "text": "Malgré leur défaite, les minimes se sont bien défendus aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            },
