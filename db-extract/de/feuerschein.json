                ],
                "senses": [
                    {
                        "sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                        "entry_id": "dd0874f9-754f-3cb0-9fad-912862f4d281",
                        "glosses": [
                            "Lichtschein, der durch ein Brandereignis entsteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbf9e9e-f510-466d-bd49-b6a1b6a5c6b8",
                                "sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                                "text": "„Laut Bericht der Feuerwehr Radolfzell war beim Eintreffen gegen 1.45 Uhr Feuerschein sowie starke Rauchentwicklung in der Gaststätte zu erkennen.“"
                            },
                            {
                                "example_id": "a583d0a2-5acf-4c4c-be81-f583926b1157",
                                "sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                                "text": "„Da der Feuerschein weit genug von ihrer Unterkunft entfernt war, gab es auch keinen Grund zu Besorgnis.“"
                            },
                            {
                                "example_id": "53a5c235-cc18-44ef-86b4-caf3988db5d0",
                                "sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                                "text": "„Auch Rostows Pferd war unruhig geworden, schlug mit dem Fuss gegen den hartgefrorenen Boden, spitzte wieder die Ohren und sah nach dem Feuerschein hinüber.“"
                            },
                            {
                                "example_id": "4b4b0192-3cae-400c-b27b-846306152b70",
                                "sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                                "text": "„Als wir aus dem Feuerschein traten, merkte ich erst, wie bleich sie war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7324a493-1ac5-4029-8eed-9401ba41112d",
                        "source_entry_id": "dd0874f9-754f-3cb0-9fad-912862f4d281",
                        "source_sense_id": "229f856a-1cd2-3afe-8d33-a84551baa4dd",
                        "source_sense_description": "Lichtschein, der durch ein Brandereignis entsteht",
                        "target_lang_word": "firelight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "firelight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "46ff7dc9-2bcf-319e-b6a8-c6036209996f",
                                        "entry_id": "5ab5b6b1-3c3a-37d0-a7b2-cf9fd068b971",
                                        "glosses": [
                                            "The light of a fire, such as from a campfire or fireplace."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e43f2b1e-82d4-417a-b59f-32a2ab79afc6",
                                                "sense_id": "46ff7dc9-2bcf-319e-b6a8-c6036209996f",
                                                "text": "He sat on by the cheerful firelight thrown from a bundle of green ash-sticks laid across the dogs; the sticks snapped pleasantly, and hissed out bubbles of sap from their ends."
                                            },
                                            {
                                                "example_id": "d105a512-8773-4e4b-872b-120fc53e4670",
                                                "sense_id": "46ff7dc9-2bcf-319e-b6a8-c6036209996f",
                                                "text": "He glanced continually at the diamond-panes of the casement, gleaming dimly in the firelight, and cocked his ear toward the door, as if half expecting to hear the pad of furtive feet in the corridor without."
                                            },
                                            {
                                                "example_id": "620af4df-5497-4d54-ae9f-d8c8c0d1ee04",
                                                "sense_id": "46ff7dc9-2bcf-319e-b6a8-c6036209996f",
                                                "text": "Dane was startled out of the contemplation of his misery to see the medic on his knees before their row of canteens, the vial of water purifier held to the firelight for a closer inspection."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
