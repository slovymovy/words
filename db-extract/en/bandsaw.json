                    },
                    {
                        "translation_id": "3b60a9d3-6ad1-4b7b-8094-47c22f941e1e",
                        "source_entry_id": "ec9e5238-f005-365d-b93d-d885d7fdfc7c",
                        "source_sense_id": "260e7c7a-9b0f-3233-a4db-fa6f01cbb550",
                        "source_sense_description": "a saw whose blade is a continuous band",
                        "target_lang_word": "Bandsäge",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bandsäge",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                        "entry_id": "e091f681-aa40-365c-a7a0-2e09a29feeb8",
                                        "glosses": [
                                            "Werkzeugmaschine, in der ein Motor ein zu einem geschlossenen Ring verschweißtes Bandsägeblatt antreibt, um unterschiedliche Materialien zu sägen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d56f01f3-799c-431e-aaf1-33654acb5dbe",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "Der Schwerpunkt der Verwendung von Bandsägen liegt in der Holzverarbeitung."
                                            },
                                            {
                                                "example_id": "adbcfc0b-ddc2-4ab9-8983-f05c707fa38e",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "„Roland hobelt unter Anleitung das rohe Holz ab und schneidet es mit der Bandsäge auf. Dabei muss er sich sehr konzentrieren und auf seine Finger achten.“"
                                            },
                                            {
                                                "example_id": "2eae08fb-90f9-416e-8feb-2ddf186368d9",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "„Jesse Ritch muss aufpassen, dass er mit der Bandsäge nur Holz absägt und nicht auch seine Finger.“"
                                            },
                                            {
                                                "example_id": "468fdcfc-f18a-4446-ac90-2484c3aff3cd",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "„Wenn ungeübte Heimwerker zur Bandsäge oder zur Bohrmaschine greifen, kann schnell etwas passieren. Besonders gefährdet sind die Hände.“"
                                            },
                                            {
                                                "example_id": "051b7f0d-0252-45c3-bb03-53a1dfc6d041",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "„Das Holz […] muss zunächst grob mit der Bandsäge zugeschnitten werden, bevor es dann mit Stechbeitel, Schnitzmesser, Feile und Sandpapier die gewünschte Form erhält.“"
                                            },
                                            {
                                                "example_id": "573661df-bec7-4712-82f2-75113122e975",
                                                "sense_id": "cabff5ce-258b-3c02-a5a7-27155928a714",
                                                "text": "„Im Moment sind hier zwei unserer Laborantinnen damit beschäftigt, einen Eisbohrkern mit Hilfe einer Bandsäge zu zerteilen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
