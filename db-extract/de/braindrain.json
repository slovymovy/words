                        "source_entry_id": "6aef59e8-27f8-3205-a8bd-0e51106f4f6b",
                        "source_sense_id": "1c4edbbc-b6b9-3f22-9f3f-ab83f457e441",
                        "source_sense_description": "Abwanderung von Akademikern, hochqualifizierten Fachkräften und Künstlern ins Ausland",
                        "target_lang_word": "утечка мозгов",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "утечка мозгов",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c4b3f20-eabb-3424-9b03-8a2273be8f28",
                                        "entry_id": "67beb1fa-0c99-33d5-a461-9b838ef94bfa",
                                        "glosses": [
                                            "процесс массовой эмиграции, при которой из страны или региона уезжают специалисты, учёные и квалифицированные рабочие по политическим, экономическим, религиозным или иным причинам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1bad196e-9a40-4ef1-ac88-6c723682be98",
                                                "sense_id": "5c4b3f20-eabb-3424-9b03-8a2273be8f28",
                                                "text": "Когда упал «железный занавес», началась работа с иностранными фирмами и исследовательскими центрами, довольно много специалистов, уже сложившихся авторитетных учёных и перспективной молодёжи отправились на Запад. Утечка мозгов коснулась ЦАГИ? ― Да, к большому сожалению, утечка мозгов ударила по ЦАГИ."
                                            },
                                            {
                                                "example_id": "8d42da63-c083-4430-bb57-ad2c6b029934",
                                                "sense_id": "5c4b3f20-eabb-3424-9b03-8a2273be8f28",
                                                "text": "Молодые ученые и специалисты различных профессий должны четко ощущать, что они востребованы в своей родной стране. Пресловутая «утечка мозгов» категорически недопустима! ПВР абсолютно уверена, что только развитие интеллектуального потенциала отечественной молодежи позволит достичь уже в самой ближайшей перспективе высокого уровня благосостояния страны."
                                            }
