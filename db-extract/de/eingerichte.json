                        "glosses": [
                            "Glasflasche mit innenliegendem Kunstwerk"
                        ],
                        "tags": [
                            "Kunsthandwerk"
                        ],
                        "examples": [
                            {
                                "example_id": "e13e008b-2e7e-4c4b-87b0-ff60132a1585",
                                "sense_id": "8e6880e8-f634-3695-bd16-c5ac241b39bc",
                                "text": "Als Geduldflaschen (Eingerichte) bezeichnet man Erzeugnisse der Volkskunst, bei denen themenbezogene Schnitzereien in das Innere von - zuletzt kunstvoll und irreversibel verschlossenen - Glasflaschen eingebracht werden."
                            }
