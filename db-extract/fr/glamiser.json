                        "glosses": [
                            "Donner un caractère glam à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "416bfa3d-9798-491a-9764-e98fccead87d",
                                "sense_id": "167e9d15-dbd4-3169-b164-0de61415c30c",
                                "text": "Le groupe aurait, selon moi, pu devenir mainstream si il aurait choisi de \"glamiser\" son son look pour plaire aux midinettes et continué à sortir des chansons faciles style \"rock me to the top\"."
                            },
                            {
                                "example_id": "0cde6bc2-e755-40f8-80a8-0fd800e4132b",
                                "sense_id": "167e9d15-dbd4-3169-b164-0de61415c30c",
                                "text": "On adore : les boots lacées argent, qui viennent glamiser l'attitude dark girl."
                            },
                            {
                                "example_id": "67cb358a-1a6e-4532-bc76-9bd523850b9f",
                                "sense_id": "167e9d15-dbd4-3169-b164-0de61415c30c",
                                "text": "Sans oublier un ou deux accessoires glam et paillettes pour glamiser (oui,j'invente des mots) le tout."
                            }
                        ]
                    }
