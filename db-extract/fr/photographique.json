                    }
                ],
                "senses": [
                    {
                        "sense_id": "3a2b2e0a-317b-39b0-8072-f4769ed033bc",
                        "entry_id": "9fbc1d68-3794-30d2-8622-73faae63b979",
                        "glosses": [
                            "Qui est relatif à la photographie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cba80291-a745-472e-9cc6-cbd00e6ebb7f",
                                "sense_id": "3a2b2e0a-317b-39b0-8072-f4769ed033bc",
                                "text": "Ce n'est qu'en 1930 que son assistant, Clyde Tombough, a trouvé, après une recherche exhaustive parmi des milliers de plaques photographiques, une nouvelle planète."
                            },
                            {
                                "example_id": "a9402f2a-187d-4aa4-a9e9-cc72107dfa41",
                                "sense_id": "3a2b2e0a-317b-39b0-8072-f4769ed033bc",
                                "text": "Un (ou une) « selfie », mot emprunté à l’anglais, est un autoportrait photographique."
                            }
                        ]
                    },
                    {
                        "sense_id": "16baf197-e6ee-3a37-bbc9-8e9f3cb1c1a3",
                        "entry_id": "9fbc1d68-3794-30d2-8622-73faae63b979",
                        "glosses": [
                            "Précis comme une photographie."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "40d6d67e-c6db-477c-8607-e4be17264d5e",
                                "sense_id": "16baf197-e6ee-3a37-bbc9-8e9f3cb1c1a3",
                                "text": "Ma mémoire conserve encore avec une netteté photographique l’image de la chaire et du cahier de classe sur lequel nous ne cessions de loucher parce que nos notes y étaient consignées ; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0bff399-2be7-4529-b6be-6278db8551dc",
                        "source_entry_id": "9fbc1d68-3794-30d2-8622-73faae63b979",
                        "target_lang_word": "photographic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "photographic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                                        "entry_id": "7e0a0328-88b4-3247-a9a6-8c6a936234a6",
                                        "glosses": [
                                            "Pertaining to photographs or photography."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9633b0bc-a24b-4e07-b056-d8e5317ad007",
                                                "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                                                "text": "This shop stocks all the latest photographic equipment."
                                            },
                                            {
                                                "example_id": "c8816404-b3dc-4214-8dff-c1b03f1fca50",
                                                "sense_id": "fd72ebad-c458-3b18-b676-dee2d304be31",
                                                "text": "There is also a fine dance and concert hall, a capacious reading room, a well-appointed billiards room with five tables, various committee and games rooms, photographic dark rooms, and a small but compact ladies' lounge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "397d30a8-62a0-3ff6-b33e-43c709f097c5",
                                        "entry_id": "7e0a0328-88b4-3247-a9a6-8c6a936234a6",
                                        "glosses": [
                                            "Synonym of accurate."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a0d3149-3b53-48b6-93dd-de808a57be25",
                                                "sense_id": "397d30a8-62a0-3ff6-b33e-43c709f097c5",
                                                "text": "What each evangelist preserved is not a photographic reproduction of the words and deeds of Jesus, but an interpretative portrait delineated in accord with the special needs of the early church."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
