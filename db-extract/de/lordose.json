                "senses": [
                    {
                        "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                        "entry_id": "24879477-bf7b-39ed-ba03-0b2b6902f5b8",
                        "glosses": [
                            "konvexe Verkrümmung der Wirbelsäule nach ventral in der Medianebene"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f72a9e1f-e404-483e-8623-ff0860c09909",
                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                "text": "Unter Lordose wird die natürliche Krümmung der Wirbelsäule im Bereich der Hals- und Lendenwirbelsäule verstanden."
                            },
                            {
                                "example_id": "771793a3-e507-4376-8d6a-568622d228bb",
                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                "text": "Im Hals- und Lendenbereich ist sie nach vorne gekrümmt (Lordose), im Brust- und Kreuzbeinbereich nach hinten (Kyphose)."
                            },
                            {
                                "example_id": "af42850c-2c9d-4ff5-89c7-f5e777e2dbba",
                                "sense_id": "89c23d55-94b8-3a96-9ecc-a038a507029c",
                                "text": "Als Lordose bezeichnen Mediziner die nach vorn gerichtete natürliche Krümmung der menschlichen Wirbelsäule."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
