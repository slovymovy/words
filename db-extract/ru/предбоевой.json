                "senses": [
                    {
                        "sense_id": "28c0923a-fa0f-382e-a274-e754543d2b3a",
                        "entry_id": "b7d267d0-f420-378c-9248-a00eaf2a253a",
                        "glosses": [
                            "такой, как бывает перед боем"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "18676315-499c-4e4e-8430-8bf2e43dee0e",
                                "sense_id": "28c0923a-fa0f-382e-a274-e754543d2b3a",
                                "text": "Армию и штаб охватило горячее предбоевое возбуждение."
                            },
                            {
                                "example_id": "b9f845e8-e7a0-4027-91af-9f160c91375e",
                                "sense_id": "28c0923a-fa0f-382e-a274-e754543d2b3a",
                                "text": "Механизированный корпус вводится в прорыв на фронте шесть-восемь километров в предбоевых порядках по двум-четырем маршрутам."
                            }
                        ]
