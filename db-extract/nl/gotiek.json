                                        "sense_id": "189fd83d-7343-3cfe-8fd3-bdcfcca39cf3",
                                        "entry_id": "95f33198-46c3-35f7-85a2-41871e04d7cd",
                                        "glosses": [
                                            "der Kunststil der mittelalterlichen europäischen Hochkultur des 13. bis 15. Jahrhunderts der besonders ausgeprägt in der kirchlichen Baukunst der Kathedralen hervortritt"
                                        ],
                                        "tags": [
                                            "Kunstgeschichte"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d49c2fc0-ce8e-4a41-9fcb-3eda316c8839",
                                                "sense_id": "189fd83d-7343-3cfe-8fd3-bdcfcca39cf3",
                                                "text": "Im Stil der Gotik sind viele eindrucksvolle Kirchen errichtet worden."
                                            },
                                            {
                                                "example_id": "c545cf50-98a3-47d5-bbf9-4693ba0d1695",
                                                "sense_id": "189fd83d-7343-3cfe-8fd3-bdcfcca39cf3",
                                                "text": "\"Die Gotik ist Resultat und Medium komplexer sozialökonomischer, politischer, kirchlich-religiöser und kulturell-geistiger Vorgänge innerhalb des Feudalismus als sozialökonomische Gesellschaftsformation.\""
                                            },
                                            {
                                                "example_id": "fa428681-62d6-4cee-8859-7f16b8e9e0c6",
                                                "sense_id": "189fd83d-7343-3cfe-8fd3-bdcfcca39cf3",
                                                "text": "„Seit der Gotik wurde oft in der Sakristei ein Altar aufgestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
