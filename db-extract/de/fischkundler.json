                ],
                "senses": [
                    {
                        "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                        "entry_id": "9f57f1c0-8164-36e9-89bd-1ba138b94b7b",
                        "glosses": [
                            "Wissenschaftler/Experte auf dem Gebiet der Fischkunde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be11a0c1-769d-4a42-819e-12179b810eac",
                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                "text": "„Bekannt ist er vor allem wegen seiner bahnbrechenden Eiszeitstudien sowie seiner Leistungen als Ichthyologe (Fischkundler) und Hochschullehrer.“"
                            },
                            {
                                "example_id": "5417f3a1-a278-421c-9baa-77e9eb586b25",
                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                "text": "„Eddington vergleicht einen Naturwissenschaftler mit einem Ichthyologen, einem Fischkundler, der seine Welt erforschen will.“"
                            },
                            {
                                "example_id": "ac8dcb0e-0982-4aad-8ecf-624932f60a65",
                                "sense_id": "5e300ef4-3b6a-3c01-be28-067afdd185d1",
                                "text": "„So wie die Entwicklungen in der nordamerikanischen Fischkunde normalerweise vornehmlich für nordamerikanische Fischkundler von Interesse sind, interessieren sich für die Kunst Südafrikas vornehmlich südafrikanische Künstler.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
