                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05d9ae68-a5b7-3666-a614-b0f715f7e705",
                                        "entry_id": "8e5f69b3-06e1-3c07-b22d-3a961d5b3f1a",
                                        "glosses": [
                                            "To abandon or give up on (something); to be abandoned or given up on."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "931b9940-66a7-4955-84bf-b887983985d6",
                                                "sense_id": "05d9ae68-a5b7-3666-a614-b0f715f7e705",
                                                "text": "My lawyer said some of those charges will be dropped off."
                                            },
                                            {
                                                "example_id": "b07c5b71-972c-4f6f-90f2-1dcfecd5cbc7",
                                                "sense_id": "05d9ae68-a5b7-3666-a614-b0f715f7e705",
