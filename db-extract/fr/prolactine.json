            {
                "entry_id": "87de24bb-42df-3e15-b487-03ad968cfd86",
                "word": "prolactine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3249ba34-004d-4336-aea8-a08c91dda640",
