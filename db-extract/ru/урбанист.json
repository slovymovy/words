                    {
                        "translation_id": "f8118242-767b-46f6-b993-de1d450ff5e5",
                        "source_entry_id": "26ca148f-5450-356c-b1ae-ed4662dd627d",
                        "target_lang_word": "Urbanist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "60a6ac91-4560-44d1-ba33-ed2655955a89",
                        "source_entry_id": "26ca148f-5450-356c-b1ae-ed4662dd627d",
                        "target_lang_word": "urbaniste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "urbaniste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "995a9148-7287-39b9-a167-f0bc7978e5d0",
                                        "entry_id": "62215258-bcc7-3b98-a958-59fb58718461",
                                        "glosses": [
                                            "Architecte ou technicien spécialisé dans les réalisations de l’urbanisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63e59123-0a04-461f-a300-c22fbee372d3",
                                                "sense_id": "995a9148-7287-39b9-a167-f0bc7978e5d0",
                                                "text": "Nancy est une ville d'ordre et de lumières où dès le XVIIᵉ et le XVIIIᵉ siècle, des ducs intelligents furent, sans le savoir, les précurseurs heureux de nos urbanistes modernes."
                                            },
                                            {
                                                "example_id": "88d54b01-8e06-4a82-90cb-88ea2990d3cf",
                                                "sense_id": "995a9148-7287-39b9-a167-f0bc7978e5d0",
                                                "text": "Toutefois, la dimension des rues n'est pas le seul sujet qui préoccupe les urbanistes réformateurs. Ceux-ci s'intéressent aussi à l'alignement des voies, la hauteur des constructions, les mesures contre les incendies, les noms et numérotation des rues, le lotissement régulier, etc."
                                            },
                                            {
                                                "example_id": "11617adf-c3f4-4b6c-a56a-087b3a18a8e8",
                                                "sense_id": "995a9148-7287-39b9-a167-f0bc7978e5d0",
                                                "text": "Il faudrait aussi une représentation interdisciplinaire avec des spécialistes du développement de l'enfant, des accidentologues, des ingénieurs, des urbanistes, des cliniciens, des sociologues et d'autres encore."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45eaeca6-9729-3efb-a57a-c876d0aa8082",
                                        "entry_id": "62215258-bcc7-3b98-a958-59fb58718461",
                                        "glosses": [
                                            "Religieuse cloitrée de l’ordre des Clarisses autorisées par le pape Urbain IV à posséder des biens fonciers."
                                        ],
                                        "tags": [
                                            "Au féminin"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
