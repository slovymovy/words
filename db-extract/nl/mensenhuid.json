                            {
                                "example_id": "ac915efa-2615-458b-b244-3f5e72282682",
                                "sense_id": "685c11a6-ef47-3f0e-ae84-de0490c55b53",
                                "text": "Ingenieurs van de Zuidelijke Universiteit voor Wetenschap en Technologie in Shenzhen, China, hebben een elektronische huid ontwikkeld die texturen kan voelen. De makers baseerden hun sensor op de mensenhuid."
                            }
