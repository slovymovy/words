                        "entry_id": "50ef38d0-fc16-35b3-b5db-b78d6516f392",
                        "glosses": [
                            "złota moneta o wartości 2 escudo używana w Hiszpanii m.in. w latach 1537–1817"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4710270c-3a02-45b9-8b80-81bb9a5eeaf1",
                                "sense_id": "ba7edaa9-09d1-3c6e-ab9b-b7c0225befb1",
                                "text": "Jeszcze u wróżbitów za ciężkie dublony ratunku szukała, jeszcze co dzień do kościoła biegała, po trzy klepsydry na dobę się modląc, ale w końcu na duchu upadła."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
