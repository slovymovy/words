                    }
                ],
                "senses": [
                    {
                        "sense_id": "4ce0902b-d386-34f7-95ae-d70fc95ab3df",
                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "glosses": [
                            "The act of vibrating or the condition of being vibrated."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "0001c130-c9b6-3216-ad00-4480d3d69458",
                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "glosses": [
                            "Any periodic process, especially a rapid linear motion of a body about an equilibrium position."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "303191b1-c55e-384a-a853-8f2904abb9db",
                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "glosses": [
                            "A single complete vibrating motion."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "30e59562-3788-480c-93bd-d1e20f5cc9e8",
                                "sense_id": "303191b1-c55e-384a-a853-8f2904abb9db",
                                "text": "The moon, which had been slowly ascending, now shone through an open space between the trees; and the rippling waters of the brook gave back her light in luminous vibrations."
                            }
                        ]
                    },
                    {
                        "sense_id": "be0c7eb0-1332-3dff-9672-f5f9c69bffb3",
                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "glosses": [
                            "A vibrational energy of spiritual nature through which mediumistic and other paranormal phenomena are conveyed or affected."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "3f64d5c1-fe70-49eb-88a7-99d76d42a415",
                                "sense_id": "be0c7eb0-1332-3dff-9672-f5f9c69bffb3",
                                "text": "\"And the sitters?\" \"I expect Professor Challenger may wish to bring a friend or two of his own.\" \"They will form a horrible block of vibrations! We must have some of our own sympathetic people to counteract it.\""
                            }
                        ]
                    },
                    {
                        "sense_id": "e247e716-945f-34f6-92e6-b3770633704c",
                        "entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "glosses": [
                            "An instinctively sensed emotional aura or atmosphere."
                        ],
                        "tags": [
                            "broadly",
                            "countable",
                            "in-plural",
                            "often",
                            "slang",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "35b53fa6-411e-4375-a7c7-283b657eefbd",
                                "sense_id": "e247e716-945f-34f6-92e6-b3770633704c",
                                "text": "I'm pickin' up good vibrations / She's giving me the excitations."
                            },
                            {
                                "example_id": "a3a845b0-72ee-4e94-aa2c-789eaeb21906",
                                "sense_id": "e247e716-945f-34f6-92e6-b3770633704c",
                                "text": "The procession circled the district, symbolically purging the area of its “evil,” which paraders described as the “bad vibrations” from tourists and youths in Hippie clothes not living up to Hippie standards."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aedd52af-c33d-458d-8748-590cdfd52784",
                        "source_entry_id": "04418173-44f0-3fbe-a771-c869c0c1f08f",
                        "source_sense_description": "act of vibrating",
                        "target_lang_word": "vibration",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vibration",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                        "entry_id": "bd35df79-6d30-36d0-ba50-0688cce2302b",
                                        "glosses": [
                                            "Mouvement des points d’un système déformable écartés de leur position d’équilibre."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "93e322f0-08ff-45e4-9df6-40b6623c5189",
                                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                                "text": "Différents mécanismes laryngés sont utilisés dans la parole et le chant pour faire varier la fréquence des vibrations."
                                            },
                                            {
                                                "example_id": "0942c9ba-97d5-4008-b6c8-553ad8113f47",
                                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                                "text": "Dans le tamis vibrant électrique Hummer, les vibrations sont provoquées par voie électro-magnétique. Elles se produisent perpendiculairement à la surface tamisante et elles sont déterminées par quatre vibrateurs actionnant à chaque coin le cadre sur lequel la toile est tendue."
                                            },
                                            {
                                                "example_id": "8f9f7fb1-e004-46d7-9f55-27d10279a1fd",
                                                "sense_id": "f4ea31ae-0260-329c-a285-8cc81fc30a51",
                                                "text": "[…]; les vibrations du moteur à deux-temps et de la chaîne de tronçonnage en mouvement sont absorbées, par conséquent, d'une manière encore plus efficace dans la zone tampon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "199015ff-fc79-4026-97d4-480575be0826",
