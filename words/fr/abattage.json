            "senses": [
                {
                    "sense_id": "48ac1796-819e-308a-9c27-6b63296fedd5",
                    "sense_definition": "Action de couper et de faire tomber des arbres sur pied.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chute_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>abattage</w> des arbres malades commencera dès les premières semaines de l'automne."
                        },
                        {
                            "text": "Les bûcherons ont suspendu l'<w>abattage</w> en raison des fortes rafales de vent."
                        }
                    ],
                    "common_phrases": [
                        "abattage des arbres",
                        "permis d abattage"
                    ]
                },
                {
                    "sense_id": "f0b6ebf1-8ce0-3308-a84c-475ad2d87898",
                    "sense_definition": "Action de tuer des animaux destinés à la boucherie ou pour des raisons sanitaires.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "chute_materielle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les services vétérinaires ont ordonné l'<w>abattage</w> du troupeau pour stopper l'épidémie."
                        },
                        {
                            "text": "Les règles concernant l'<w>abattage</w> des bêtes sont devenues beaucoup plus strictes."
                        }
                    ],
                    "synonyms": [
                        "mise à mort"
                    ],
                    "common_phrases": [
                        "abattage des animaux",
                        "abattage sanitaire"
                    ]
                },
                {
                    "sense_id": "62682dc9-b594-3be8-a70a-54284a31294d",
                    "sense_definition": "Dynamisme, entrain remarquable et grande présence, notamment en public ou sur scène.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vitalite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette jeune actrice a un <w>abattage</w> extraordinaire dès qu'elle monte sur scène."
                        },
                        {
                            "text": "Il a présenté son projet avec beaucoup d'<w>abattage</w> devant un public conquis."
