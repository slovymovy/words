                "senses": [
                    {
                        "sense_id": "d0a48789-f425-3f66-a484-d4ddb429256d",
                        "entry_id": "56c96fc7-9f33-32e2-891a-d7b60f418f72",
                        "glosses": [
                            "(abgezogenes) Fell eines Waschbären"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28f91280-9e30-4686-9906-822f81526ce5",
                                "sense_id": "d0a48789-f425-3f66-a484-d4ddb429256d",
                                "text": "„Die Farmer der Umgebung lebten in ihren selbstgezimmerten Blockhütten, sie trugen Wildlederkniehosen und indianische Mokassins, keinen Überrock über ihrem einfachen Jagdhemd und Mützen aus Waschbärfell auf dem Kopfe.“"
                            },
                            {
                                "example_id": "daca7aca-ef77-4a1c-9dd9-069d33fb0732",
                                "sense_id": "d0a48789-f425-3f66-a484-d4ddb429256d",
                                "text": "„Zu sehen sind Trophäen kroatischer Wildtiere, daneben auch Elchgeweihe und Waschbärfelle, eine Vogelschau mit 171 Vogelarten und ihren Eiern sowie eine eigenwillige Sammlung von Missbildungen in der Tierwelt.“"
                            },
                            {
                                "example_id": "0ffefe1d-8118-4b7b-8976-2fc3d66a2fab",
                                "sense_id": "d0a48789-f425-3f66-a484-d4ddb429256d",
                                "text": "„Um die große Nachfrage nach Waschbärfellen zu befriedigen, begann man in den 1920er Jahren nicht nur in Nordamerika, sondern auch in Europa damit, Waschbären in Pelztierfarmen zu züchten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
