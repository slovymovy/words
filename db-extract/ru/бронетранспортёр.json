                        "source_sense_id": "d2465f9b-97a7-3361-a1b1-33e80d343edc",
                        "target_lang_word": "Schützenpanzer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schützenpanzer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "831978eb-d2d4-3218-afec-8c9424352cc2",
                                        "entry_id": "e92f925c-1d3f-33a3-be13-d6fddb177f3c",
                                        "glosses": [
                                            "gepanzertes Militärfahrzeug, das gleichermaßen dem Truppentransport sowie im Verbund mit den mitgeführten Panzergrenadieren dem Feuerkampf dient."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2982393-afa1-4149-b3c8-c6f9a73469e0",
                                                "sense_id": "831978eb-d2d4-3218-afec-8c9424352cc2",
                                                "text": "„Am Anlegesteg bei Molovata Noua stehen zwei russische Soldaten unter einer Schwarzbirke, ein wenig weiter ist ein halbeingegrabener Schützenpanzer zu sehen.“"
                                            },
                                            {
                                                "example_id": "23ac04d1-5a73-4340-92bf-f9fa0e25e303",
                                                "sense_id": "831978eb-d2d4-3218-afec-8c9424352cc2",
                                                "text": "„Eine weitere Besonderheit ist die Gestaltung des Armata-Systems an sich (Armata ist der Plural des griechischen Worts für \"Streitwagen\"): Es wird wie erwähnt zur Basis einer kompletten Fahrzeugserie, die etwa auch Schützenpanzer (Arbeitsname \"Kurganets 25\"), Panzerartillerie, Flammenwerferpanzer, Flugabwehrpanzer und Bergepanzer umfassen kann ; weil alle diese Fahrzeuge das gleiche Fahrgestell haben, werden Produktion und Wartung deutlich erleichtert und verbilligt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
