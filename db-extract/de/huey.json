                "senses": [
                    {
                        "sense_id": "bc10b9a4-5dbb-3026-ae2f-ed9ebe63ad6b",
                        "entry_id": "9531512f-df94-3876-805c-50fcae509b5d",
                        "glosses": [
                            "Spitzname des Hubschraubers Bell UH-1"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "142c020e-b5f8-4081-b00e-86825750f837",
                                "sense_id": "bc10b9a4-5dbb-3026-ae2f-ed9ebe63ad6b",
                                "text": "„Vier weitere Beamte mit taktischer Ausrüstung saßen in einem alten olivgrünen Huey der Air National Guard, der fünfzig Meter rechts von ihnen flog.“"
                            },
                            {
                                "example_id": "223a836b-fd84-4edc-8144-b3db8a2be402",
                                "sense_id": "bc10b9a4-5dbb-3026-ae2f-ed9ebe63ad6b",
                                "text": "„Seine Prognose basierte auf dem unverwechselbaren Klang der Hubschraubertriebwerke. Es handelte sich zweifellos um Hueys.“"
                            },
                            {
                                "example_id": "fe25e2a8-3f07-4503-a727-d2c9764801ac",
                                "sense_id": "bc10b9a4-5dbb-3026-ae2f-ed9ebe63ad6b",
                                "text": "„Dieser Huey hat uns aufgelesen, wir sind zum Stützpunkt zurückgekommen, und sie haben den Lieutenant auf eine Trage gelegt und mit einer Decke zugedeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
