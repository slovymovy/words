                    {
                        "sense_id": "e2a9ede2-6d0c-3efe-9ae1-1e1feaa3a907",
                        "entry_id": "dc82ad5d-7392-3039-95fe-2f6a1a2a1f12",
                        "glosses": [
                            "Werkzeug mit rauer/stacheliger Oberfläche für die Bearbeitung von Werkstücken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42dff63b-c086-4214-a288-7bb96aa7f640",
                                "sense_id": "e2a9ede2-6d0c-3efe-9ae1-1e1feaa3a907",
                                "text": "„Obwohl er sich morgens rasierte, war sein Kinn abends stoppelig und fühlte sich am nächsten Morgen wie ein Reibeisen an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
