                        "entry_id": "bc8d11d3-e501-3e3a-ae10-307a26053817",
                        "glosses": [
                            "doek waarmee men de handen in de keuken kan afdrogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dfbe0df-221b-451e-9ecf-d4675d133564",
                                "sense_id": "c8ebf221-9eaa-3da7-842e-43c1bef75fa7",
                                "text": "Ik pakte een keukenhanddoek en droogde het zweet van mijn lichaam onder mijn overhemd."
                            }
                        ]
                    },
                    {
                        "sense_id": "69787b36-8921-399f-85df-e85e96714c2d",
                        "entry_id": "bc8d11d3-e501-3e3a-ae10-307a26053817",
                        "glosses": [
                            "doek waarmee men de vaat kan afdrogen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "29ec9a7b-4eb0-4d82-a8a6-4395eae174bc",
                                "sense_id": "69787b36-8921-399f-85df-e85e96714c2d",
                                "text": "Snijd de gember in flinterdunne plakjes. Bestrooi deze met zout, wrijf ze goed in en laat een uur staan. Blancheer de gezouten gember een minuut in een pan met kokend water, spoel de gember hierna af met koud water en dep de plakjes droog op een schone keukenhanddoek of op keukenpapier."
                            }
                        ]
                    }
                ],
