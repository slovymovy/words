                    "target_lang_definitions": {
                        "ru": "Причастие настоящего времени и герундий от глагола split (разделять, раскалывать).",
                        "pl": "Imiesłów czynny lub rzeczownik odczasownikowy od czasownika 'split' (dzielić, rozłupywać)."
                    },
                    "translations": {
                        "ru": [
                            {
