                        "target_lang_word": "Verschärfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verschärfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                        "entry_id": "c8ce9795-1820-3d92-8709-6a5578e601c0",
                                        "glosses": [
                                            "Veränderung in Richtung schlimmer, schlechter, oder auch restriktiver, einschränkender (schärfer)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b78d76d5-ac73-4d5e-a03d-0ae9eac17a8e",
                                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                                "text": "Eine Verschärfung der Maßnahmen sei derzeit nicht nötig."
                                            },
                                            {
                                                "example_id": "ba253b01-c0d1-43ff-b7a4-d501d28c35eb",
                                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                                "text": "Die Verschärfungen der Freiheitsstrafen wurden in der Öffentlichkeit heiß diskutiert."
                                            },
                                            {
                                                "example_id": "11a1c5c1-b613-4170-ab7d-28c0b7fffec0",
                                                "sense_id": "375398af-2262-33bb-b321-28708848fa68",
                                                "text": "Der subjektive Wahrnehmungsfilter des Betroffenen trägt zur Verschärfung der Problemsituation bei."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f3bde04-a8fb-437a-8e75-305747319308",
                        "source_entry_id": "d66d1150-8765-3922-9675-2611e3c01a1a",
                        "source_sense_id": "ec170ed1-8093-3a2e-aa08-d527675697c8",
