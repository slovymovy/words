                                    {
                                        "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                        "entry_id": "83952abd-4164-3ea1-9272-9544223a2724",
                                        "glosses": [
                                            "Qui transmet des messages."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ce92a90-d380-43ed-844c-0b95d70d82b9",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Acide ribonucléique messager, acide ribonucléique qui exerce une transmission de l'information génétique des gènes aux ribosomes où s'effectue la synthèse des protéines."
                                            },
                                            {
                                                "example_id": "f5258331-9b85-4094-a06c-21c49c80c29b",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "Le pigeon messager, pigeon voyageur qui transmet des messages."
                                            },
                                            {
                                                "example_id": "85a5545f-e059-4ca3-8ca3-9bd4ca087d36",
                                                "sense_id": "86e200ec-3c9b-36d0-a917-4f626c3470eb",
                                                "text": "La colombe messagère."
                                            }
                                        ]
                                    }
