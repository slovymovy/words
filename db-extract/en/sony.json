            {
                "entry_id": "9a725e7c-77be-3058-a751-e24f835aad78",
                "word": "Sony",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                        "entry_id": "9a725e7c-77be-3058-a751-e24f835aad78",
                        "glosses": [
                            "An international electronics and media company based in Tokyo, Japan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3b6b324-6f91-4a43-892b-45706293ede4",
                                "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                                "text": "he mostly makes videos—virtually reinventing the diary form with his Sony 8 scrapbook."
                            },
                            {
                                "example_id": "17485310-4ec4-4964-84ff-c8ddc587d5a8",
                                "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                                "text": "Bernstein always understood this symphony, and his Sony recording was for many years one of the best."
                            },
                            {
                                "example_id": "9282a345-ef9f-46b2-9d22-a7efcd2886fe",
                                "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                                "text": "Gary’s roster currently has Tritt and two new Sony artists soon to be hugely famous, JEB and Christy Sutherland."
                            },
                            {
                                "example_id": "1906310f-ad08-48e5-a317-5b5207899e42",
                                "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                                "text": "Most of the e-mails were blowback from the departure of our divisional vice president, Crawford, who’d just jumped ship to Sony."
                            },
                            {
                                "example_id": "fc265104-2f3f-4b0c-997c-5d4875e8829a",
                                "sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                                "text": "Jade Raymond, the executive in charge of SG&E who previously worked at Sony (SNE), Electronic Arts (EA) and Ubisoft (UBSFF), will leave Google (GOOG) to “pursue other opportunities,” Harrison added."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3c79902c-e78a-4df1-bdf9-ec21c359a9d1",
                        "source_entry_id": "9a725e7c-77be-3058-a751-e24f835aad78",
                        "source_sense_id": "5f0dba44-3a0f-313e-a5ee-8534085b173d",
                        "source_sense_description": "An international electronics and media company based in Tokyo, Japan",
                        "target_lang_word": "Sony",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sony",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8b11c5ee-8ef9-3daf-a28e-a9642ef06fb0",
                                        "entry_id": "d55a6a1f-07e1-3bc4-929b-ae9404e0f3fc",
                                        "glosses": [
                                            "Société multinationale japonaise,active dans différents domaines tels que l’électronique, la téléphonie, l’informatique, le jeu vidéo, la musique, le cinéma et l’audiovisuel en général."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93a945fc-14d8-4423-b4e3-d63f296e7acf",
                                                "sense_id": "8b11c5ee-8ef9-3daf-a28e-a9642ef06fb0",
                                                "text": "Universal, Warner et Sony possèdent indirectement quelque 15 % du capital de Deezer et près de 20 % de celui de Spotify."
                                            },
                                            {
                                                "example_id": "37a1cb64-c4e1-460a-a827-00f2e76094fd",
                                                "sense_id": "8b11c5ee-8ef9-3daf-a28e-a9642ef06fb0",
                                                "text": "Sony a développé cette technologie pour trouver une solution aux problèmes d’autofocus que rencontraient les reflex en Live View (visée à l’écran) et en vidéo."
                                            },
                                            {
                                                "example_id": "06cd8e07-be7d-4785-b9e0-5d320713cea8",
                                                "sense_id": "8b11c5ee-8ef9-3daf-a28e-a9642ef06fb0",
                                                "text": "L’annonce, le même jour, par Sony de l’acquisition de la division reflex numérique ainsi que du portefeuille de technologies d’avant-garde accumulé par Minolta se heurte à un certain scepticisme de la presse comme de la clientèle."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Sony",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e60c22a6-bcb5-3a9b-a9a0-d63309dae5c7",
                                        "entry_id": "fd47325a-6b81-39f1-9da3-b6c0a51223da",
