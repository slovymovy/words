                        "glosses": [
                            "Femme ou fille qui fait montre de paresse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81bee089-819e-43cc-b928-a7aa74aa0435",
                                "sense_id": "2d88feb8-9be0-3446-a78d-ee8f1886fea1",
                                "text": "Eh ! mais il est depuis quinze jours dans le lit d’Arsène, dit la petite Niseron en éclatant de rire ; si cette grande paresseuse faisait son lit, elle l’aurait trouvé…"
                            },
                            {
                                "example_id": "2d440335-d1e9-4388-85bd-ec0f39bb0515",
                                "sense_id": "2d88feb8-9be0-3446-a78d-ee8f1886fea1",
                                "text": "Les bons plans anti-cellulite des paresseuses"
                            }
                        ]
                    },
                    {
