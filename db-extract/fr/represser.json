                "senses": [
                    {
                        "sense_id": "6e8859f8-cd85-33a9-9eb5-c943878c488d",
                        "entry_id": "c4cac2bf-3555-3406-a061-d4a75773bc21",
                        "glosses": [
                            "Presser de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "847bd697-08ce-4fef-9673-a67428b31666",
                                "sense_id": "6e8859f8-cd85-33a9-9eb5-c943878c488d",
                                "text": "Un pauvre passementier dans ce faubourg Saint-Marceau était taxé à dix écus pour un impôt sur les maîtrises ; il ne les avait pas : on le presse et represse."
                            },
                            {
                                "example_id": "07a162c9-283b-4d35-96e7-a8d0c7a246bf",
                                "sense_id": "6e8859f8-cd85-33a9-9eb5-c943878c488d",
                                "text": "Les marcs ou aines, sont souvent retaillés, humectés d'un peu d'eau et repressés ; ils donnent ainsi un cidre léger, dit retaille."
                            }
                        ]
                    }
