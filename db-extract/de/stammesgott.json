                "senses": [
                    {
                        "sense_id": "cbebc469-fb03-36bf-b6b4-9520c6b1d3d7",
                        "entry_id": "3a9e08ab-d219-3536-b02a-3420211e4de5",
                        "glosses": [
                            "von einem Volksstamm verehrte Gottheit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "170d04f8-22f5-4b83-a09a-e261f421ad40",
                                "sense_id": "cbebc469-fb03-36bf-b6b4-9520c6b1d3d7",
                                "text": "„Eine scheinbar freundliche Einladung der Azteken an ihn zu einem Tempelfest benützten sie auf Anraten ihres Stammesgottes Huītzilōpōchtli, um einen Priester in der übergezogenen Haut der zuvor geschundenen Tochter eben dieses Herrschers auftreten zu lassen.“"
                            },
                            {
                                "example_id": "c191a0ce-5730-4bb9-a5b7-6fca364985cd",
                                "sense_id": "cbebc469-fb03-36bf-b6b4-9520c6b1d3d7",
                                "text": "„Es handelte sich um eine heilige Handlung unter Gleichen, bei der herausgefunden wurde, welcher Stammesgott der Stärkere war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
