{
    "word_family": [
        "направлять",
        "направиться",
        "направленность",
        "направитель",
        "перенаправление"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e6665b69-afcb-3496-ae11-cdc411d1aab7",
                    "sense_definition": "Линия движения или сторона, в которую устремлено действие или объект.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы выбрали правильное <w>направление</w> и быстро дошли до дома.",
                            "target_lang_translations": {
                                "en": "We chose the right <w>direction</w> and quickly reached the house.",
                                "de": "Wir wählten die richtige <w>Richtung</w> und kamen schnell zu Hause an."
                            }
                        },
                        {
                            "text": "Ветер внезапно изменил своё <w>направление</w> на северное.",
                            "target_lang_translations": {
                                "en": "The wind suddenly changed its <w>direction</w> to the north.",
                                "de": "Der Wind änderte plötzlich seine <w>Richtung</w> nach Norden."
                            }
                        }
                    ],
                    "synonyms": [
                        "сторона",
                        "вектор",
                        "курс"
                    ],
                    "common_phrases": [
                        "в направлении",
                        "изменить направление",
                        "направление движения",
                        "правильное направление"
                    ],
                    "target_lang_definitions": {
                        "en": "The path or line along which a person or thing moves, looks, or points.",
                        "de": "Der Pfad oder die Linie, entlang der sich eine Person oder ein Objekt bewegt, schaut oder zeigt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "direction",
                                "target_lang_sense_clarification": "general physical path"
                            },
                            {
                                "target_lang_word": "course",
                                "target_lang_sense_clarification": "route or path of movement"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Richtung",
                                "target_lang_sense_clarification": "allgemeiner physischer Pfad oder Ziel"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a83b805-5604-3b9b-bbec-c6c05f5516fa",
                    "sense_definition": "Общественное, научное или художественное течение, объединённое общими принципами, идеями и целями.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract_trend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это новое <w>направление</w> в искусстве привлекает много молодежи.",
                            "target_lang_translations": {
                                "en": "This new <w>movement</w> in art attracts many young people.",
                                "de": "Diese neue <w>Richtung</w> in der Kunst zieht viele junge Leute an."
                            }
                        },
                        {
                            "text": "Учёный развивал перспективное научное <w>направление</w> в генетике.",
                            "target_lang_translations": {
                                "en": "The scientist was developing a promising scientific <w>direction</w> in genetics.",
                                "de": "Der Wissenschaftler entwickelte eine vielversprechende wissenschaftliche <w>Richtung</w> in der Genetik."
                            }
                        }
                    ],
                    "synonyms": [
                        "течение",
                        "ориентация"
                    ],
                    "common_phrases": [
                        "научное направление",
                        "литературное направление",
                        "новое направление"
                    ],
                    "target_lang_definitions": {
                        "en": "A general development, trend, or school of thought in science, art, or society.",
                        "de": "Eine allgemeine Entwicklung, ein Trend oder eine Denkschule in Wissenschaft, Kunst oder Gesellschaft."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "movement",
                                "target_lang_sense_clarification": "artistic or social group"
                            },
                            {
                                "target_lang_word": "trend",
                                "target_lang_sense_clarification": "general tendency"
                            },
                            {
                                "target_lang_word": "school",
                                "target_lang_sense_clarification": "school of thought"
                            },
                            {
                                "target_lang_word": "direction",
                                "target_lang_sense_clarification": "course of development"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Richtung",
                                "target_lang_sense_clarification": "Ausrichtung in Denken oder Kultur"
                            },
                            {
                                "target_lang_word": "Bewegung",
                                "target_lang_sense_clarification": "künstlerische oder soziale Gruppierung"
                            },
                            {
                                "target_lang_word": "Trend",
                                "target_lang_sense_clarification": "allgemeine Tendenz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0b7021a-5a45-3c1b-a952-e1a55d830125",
                    "sense_definition": "Официальный документ, предписывающий явиться куда-либо для лечения, работы или учёбы.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "document",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Врач выписал пациенту <w>направление</w> на обследование в больницу.",
                            "target_lang_translations": {
                                "en": "The doctor wrote the patient a <w>referral</w> for an examination at the hospital.",
                                "de": "Der Arzt stellte dem Patienten eine <w>Einweisung</w> für eine Untersuchung im Krankenhaus aus."
                            }
                        },
                        {
                            "text": "Без официального <w>направления</w> вас не смогут принять на работу.",
                            "target_lang_translations": {
                                "en": "Without an official <w>referral</w> you cannot be hired.",
                                "de": "Ohne eine offizielle <w>Zuweisung</w> können Sie nicht eingestellt werden."
                            }
                        }
                    ],
                    "synonyms": [
                        "предписание"
                    ],
                    "common_phrases": [
                        "направление к врачу",
                        "направление на работу",
                        "получить направление"
                    ],
                    "target_lang_definitions": {
                        "en": "An official document sending someone for medical treatment, a job, or study.",
                        "de": "Ein offizielles Dokument, das jemanden zur medizinischen Behandlung, zur Arbeit oder zum Studium schickt."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "referral",
                                "target_lang_sense_clarification": "medical or administrative recommendation"
                            },
                            {
                                "target_lang_word": "assignment",
                                "target_lang_sense_clarification": "order to take a post or task"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Einweisung",
                                "target_lang_sense_clarification": "medizinische Überweisung in eine Klinik"
                            },
                            {
                                "target_lang_word": "Überweisung",
                                "target_lang_sense_clarification": "ärztliche Empfehlung zum Facharzt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d243ce59-aaad-3002-b895-3be29cc35bc5",
                    "sense_definition": "Действие по глаголу «направлять»; устремление чего-либо в определённую сторону или назначение кого-либо на должность.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Направление</w> всех ресурсов на решение этой задачи дало результат.",
                            "target_lang_translations": {
                                "en": "The <w>channeling</w> of all resources into solving this problem yielded results.",
                                "de": "Die <w>Ausrichtung</w> aller Ressourcen auf die Lösung dieser Aufgabe brachte Ergebnisse."
                            }
                        },
                        {
                            "text": "Его <w>направление</w> на руководящую должность стало неожиданностью для коллег.",
                            "target_lang_translations": {
                                "en": "His <w>appointment</w> to a leadership position came as a surprise to his colleagues.",
                                "de": "Seine <w>Besetzung</w> für die Führungsposition kam für die Kollegen überraschend."
                            }
                        }
                    ],
                    "synonyms": [
                        "устремление"
                    ],
                    "common_phrases": [
                        "направление усилий"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of directing resources or efforts, or appointing someone to a position.",
                        "de": "Der Akt, Ressourcen oder Anstrengungen zu lenken oder jemanden auf eine Position zu berufen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "direction",
                                "target_lang_sense_clarification": "act of guiding or aiming"
                            },
                            {
                                "target_lang_word": "appointment",
                                "target_lang_sense_clarification": "assignment to a job/post"
                            },
                            {
                                "target_lang_word": "channeling",
                                "target_lang_sense_clarification": "focusing of resources"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Ausrichtung",
                                "target_lang_sense_clarification": "das Ausrichten von Anstrengungen oder Ressourcen"
                            },
                            {
                                "target_lang_word": "Besetzung",
                                "target_lang_sense_clarification": "Zuteilung einer Stelle oder eines Postens"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}