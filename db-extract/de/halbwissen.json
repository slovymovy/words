                "senses": [
                    {
                        "sense_id": "a0f84f38-1eac-3108-bc04-15ce3f05dd96",
                        "entry_id": "8bfc2a3b-b39c-3e36-bdf7-22ded9dc4c9e",
                        "glosses": [
                            "oberflächliches Wissen, keine fundierten Kenntnisse"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "af9e9df2-2829-4f0a-afb3-5fe6ecb76480",
                                "sense_id": "a0f84f38-1eac-3108-bc04-15ce3f05dd96",
                                "text": "„Jeder hat neulich irgendeine Studie gelesen und streut sein Halbwissen nun ungefragt aus.“"
                            },
                            {
                                "example_id": "57e3eba6-694f-4007-a052-5bea1a39b8c7",
                                "sense_id": "a0f84f38-1eac-3108-bc04-15ce3f05dd96",
                                "text": "Vorsicht bei der Suche nach medizinischem Rat im Internet: Da stößt man auf eine Menge unseriöses Halbwissen."
                            },
                            {
                                "example_id": "931c75d1-3d13-4580-826b-4a2f4bfe5834",
                                "sense_id": "a0f84f38-1eac-3108-bc04-15ce3f05dd96",
                                "text": "„Auf diese Weise haben die Deutschen stets den Eindruck, sie seien gut informiert, ohne dass sie es tatsächlich sind, und Deutschland gewinnt immer mehr den Ruf, das Land des Halbwissens zu sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
