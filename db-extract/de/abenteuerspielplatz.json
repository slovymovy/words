                                "sense_id": "0f17e569-14f5-36a1-9223-49dafddefdb8",
                                "text": "Der Abenteuerspielplatz macht den Kindern Spaß."
                            },
                            {
                                "example_id": "3de1f90b-94de-4003-82c7-226db9396e9a",
                                "sense_id": "0f17e569-14f5-36a1-9223-49dafddefdb8",
                                "text": "Die Anzahl der Abenteuerspielplätze wächst."
                            },
                            {
                                "example_id": "4472aa5d-9651-463d-a259-56aaba6490f1",
                                "sense_id": "0f17e569-14f5-36a1-9223-49dafddefdb8",
                                "text": "„Bald sollte ich feststellen, dass ich in meinem neuen Zuhause auf einem Abenteuerspielplatz gelandet war: Direkt hinter den Holzschuppen begann der Wald.“"
                            }
                        ],
