                "senses": [
                    {
                        "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                        "entry_id": "08e48cd6-3ad0-3328-8ccb-5237c9e7b82e",
                        "glosses": [
                            "eine Währung, mit der man in einem Land bezahlt, in welchem sie nicht offiziell benutzt wird; ausländische Währung"
                        ],
                        "tags": [
                            "finance"
                        ],
                        "examples": [
                            {
                                "example_id": "b4948eaf-5ebd-40d0-9e0f-fea0228adea6",
                                "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                                "text": "Der Euro ist in Amerika eine Fremdwährung wie in Europa der Dollar."
                            },
                            {
                                "example_id": "32226322-4120-483d-9731-745bc5efa191",
                                "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                                "text": "„Im Fall Ungarns könnte auch der Zwangsumtausch von Fremdwährungs-Hypothekarkrediten eine Rolle gespielt haben.“"
                            },
                            {
                                "example_id": "888ca665-efb0-46f0-9e54-17ec0231913a",
                                "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                                "text": "„Millionen Unternehmen können ihre in Fremdwährung gewährten Darlehen nicht wie geplant zurückzahlen.“"
                            },
                            {
                                "example_id": "df77a6b3-abd2-469a-b60a-d8c46611ef2a",
                                "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                                "text": "„Zudem floriert der Dollar-Schwarzmarkt, weil die Regierung von Präsidentin Cristina Fernández Kirchner ihre Bürger daran hindert, Pesos frei in Fremdwährungen umzutauschen.“"
                            },
                            {
                                "example_id": "8b668bb3-666f-4412-8bfc-b9109c285bea",
                                "sense_id": "dbe36463-675b-3da3-a822-855ee8e8d110",
                                "text": "„Seit Jahrzehnten stützen die beträchtlichen Überweisungen in Fremdwährungen auf pakistanische Bankkonten auch die Währungsreserven des Staates.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
