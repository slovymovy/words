                "senses": [
                    {
                        "sense_id": "7169e925-0e09-33c8-91ca-2aefb54005c8",
                        "entry_id": "89cb96f1-fc5e-3369-b840-f0fd5ef82c93",
                        "glosses": [
                            "грызть, кусать друг друга (о животных)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "01a6169a-b2a4-4f30-b605-bcaddab1a484",
                                "sense_id": "7169e925-0e09-33c8-91ca-2aefb54005c8",
                                "text": "Вечером собаки вели себя неспокойно. Они грызлись друг с другом и рвались с привязи."
                            }
                        ]
                    },
                    {
                        "sense_id": "d574c7ab-4d82-3cfa-8392-25e476d5adfc",
                        "entry_id": "89cb96f1-fc5e-3369-b840-f0fd5ef82c93",
                        "glosses": [
                            "перен., разг. бранить друг друга, ворчать друг на друга (о людях)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "67abf469-003e-4c3d-8318-761eda991e38",
                                "sense_id": "d574c7ab-4d82-3cfa-8392-25e476d5adfc",
                                "text": "― Никогда я не думал вас ссорить, сами вы грызлись между собою. ― Сами! .. вот как! а кто велел не пускать меня в квартиру?"
                            }
                        ]
                    },
                    {
                        "sense_id": "b03e7932-99ad-3a0e-8b3f-b59965fb4df0",
                        "entry_id": "89cb96f1-fc5e-3369-b840-f0fd5ef82c93",
                        "glosses": [
                            "перен., разг. жить в распрях, ссориться, враждовать (о людях)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
