                "senses": [
                    {
                        "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                        "entry_id": "9d74b913-cf85-3b7d-88e3-158817aabeb3",
                        "glosses": [
                            "imię żeńskie"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "60f71b6c-c79e-4adb-b0d0-bdc55a8535a0",
                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                "text": "Dzień dobry, mam na imię Selena i jestem Polką greckiego pochodzenia."
                            },
                            {
                                "example_id": "7dcde51e-cc1e-4527-ac1a-4ef5df07e14e",
                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                "text": "Selena to rzadkie imię żeńskie w Polsce."
                            },
                            {
                                "example_id": "d3a6c847-1077-48f1-a5a3-34657959b6f0",
                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                "text": "Zeszłoroczne wakacje spędziliśmy z kuzynką Seleną na Cyprze."
                            },
                            {
                                "example_id": "5df5eb5a-6a99-4d9a-8fa1-288e82c05ebe",
                                "sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                                "text": "Pani Seleno, proszę nas jutro koniecznie odwiedzić."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ee6b7715-3e7b-4fc8-b64b-39503acd5960",
                        "source_entry_id": "9d74b913-cf85-3b7d-88e3-158817aabeb3",
                        "source_sense_id": "3ac705c4-ffca-302a-8026-0f094aa2641b",
                        "target_lang_word": "Селена",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Селена",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "ed7717db-f40b-30df-8782-fe446aebf515",
                                        "entry_id": "b4b61d2e-2891-32db-a4f2-f97382654034",
                                        "glosses": [
                                            "мифол. древнегреческая богиня Луны"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c69cea00-db6e-4dc3-9f94-07b67ccb3504",
                                                "sense_id": "ed7717db-f40b-30df-8782-fe446aebf515",
                                                "text": "Артемида была и Селеной, богиней луны, и Илифией, помощницей рожающих женщин, и Гекатой, покровительницей колдуний; впрочем иногда Геката отождествлялась с Деметрой, а иногда почиталась отдельно."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "13be80ae-6fc6-350a-965e-e55785938ebb",
                                        "entry_id": "b4b61d2e-2891-32db-a4f2-f97382654034",
                                        "glosses": [
                                            "поэт. Луна"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "762c7ddb-9cd0-43b9-97be-71557949feef",
                                                "sense_id": "13be80ae-6fc6-350a-965e-e55785938ebb",
                                                "text": "Влажный туман окружал корабли; не светила Селена // С неба высокого; тучи его покрывали густые."
                                            },
                                            {
                                                "example_id": "3db4e37d-b372-49e1-82de-e62bc6fb1877",
                                                "sense_id": "13be80ae-6fc6-350a-965e-e55785938ebb",
                                                "text": "Кроме того, с Морем Кризисов связана одна из наиболее волнующих загадок Селены."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c578fd7a-5d64-37c4-9a3a-ed8fd8ed8ed8",
                                        "entry_id": "b4b61d2e-2891-32db-a4f2-f97382654034",
                                        "glosses": [
                                            "женское имя"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22e4afb4-64e0-47ba-a898-98c4da79b5f4",
                                                "sense_id": "c578fd7a-5d64-37c4-9a3a-ed8fd8ed8ed8",
                                                "text": "Мою подругу зовут Селена."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
