                                                "sense_id": "f301afb4-c60c-345f-bf46-5061975f36e1",
                                                "text": "Eine Kinderärztin hat gelernt, die besonderen Erkrankungen von Kindern zu behandeln."
                                            },
                                            {
                                                "example_id": "65e1d55d-4e4c-4846-b86a-6df878a42523",
