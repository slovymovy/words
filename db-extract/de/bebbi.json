                "senses": [
                    {
                        "sense_id": "1837448f-08dc-3831-be5b-e1ce96966077",
                        "entry_id": "7ae7fe12-2aea-33d2-b934-02144d061197",
                        "glosses": [
                            "eine Person aus Basel (Schweiz)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c059676-0427-45f7-b067-458eea7ee316",
                                "sense_id": "1837448f-08dc-3831-be5b-e1ce96966077",
                                "text": "«‹Bebbi› ist in Basel ein allgemein bekannter Begriff und fest verankert im Wortschatz eines jeden richtigen Bebbi. Bebbisagg, Basler Bebbi, Fuessballbebbi…der Begriff steht im Dialekt sonnenklar für ‹Basler›»."
                            },
                            {
                                "example_id": "a0635602-ad03-4d38-aff3-d92acb9048fa",
                                "sense_id": "1837448f-08dc-3831-be5b-e1ce96966077",
                                "text": "„Wenn der Bebbi, so nennt der Basler sich selbst, wenn der Bebbi etwas richtig lieb gewonnen hat, dann schrumpft er es auf die Verkleinerungsform und hängt ein -li an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "bf50bb43-89a8-33d7-b02e-117334dac109",
                        "entry_id": "7ae7fe12-2aea-33d2-b934-02144d061197",
                        "glosses": [
                            "die Spieler des Fussballvereins FC Basel"
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "a87391c1-a433-4a34-8a22-95168954fb63",
                                "sense_id": "bf50bb43-89a8-33d7-b02e-117334dac109",
                                "text": "«Setzen sich die Bebbi dennoch durch, würden sie den FC Thun und den FC Zürich wieder überholen und sich auf Rang 2 vorschieben.»"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
