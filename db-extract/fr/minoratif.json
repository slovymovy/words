                                "example_id": "e72fd481-be29-4f8f-84f9-2fbf95256192",
                                "sense_id": "6c3d9b74-5d34-3570-853d-02cdc324f049",
                                "text": "On appelait minorative une médication lénitive ou laxative."
                            }
