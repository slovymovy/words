                    "sense_id": "58e3406f-2609-3ec5-8411-ab3c2cc8ba58",
                    "sense_definition": "de vloer schoonmaken of droogmaken met een dweil, meestal met water en zeep",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "schoonmaken",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb de vloer in de keuken gisteren grondig <w>gedweild</w>.",
                            "target_lang_translations": {
                                "en": "I <w>mopped</w> the kitchen floor thoroughly yesterday."
                            }
                        },
                        {
                            "text": "Je moet eerst de vloer <w>dweilen</w> voordat de gasten vanavond aankomen.",
                            "target_lang_translations": {
                                "en": "You must <w>mop</w> the floor first before the guests arrive tonight."
                            }
                        }
                    ],
                    "synonyms": [
                        "moppen"
                    ],
                    "common_phrases": [
                        "de vloer dweilen",
                        "met water dweilen"
                    ],
                    "target_lang_definitions": {
                        "en": "to clean or dry the floor using a floor cloth or mop, usually with water and soap"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to mop",
                                "target_lang_sense_clarification": "cleaning a floor with a wet cloth or mop"
                            },
                            {
                                "target_lang_word": "to swab",
                                "target_lang_sense_clarification": "cleaning a surface with a large mop"
                            }
                        ]
                    }
                }
            ]
        },
        {
