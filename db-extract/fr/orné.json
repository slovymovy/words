                                "target_senses": [
                                    {
                                        "sense_id": "cac9bef4-2c86-3cb1-a176-767bc15e242e",
                                        "entry_id": "662d02e8-d31d-3784-a7e5-209bad8547fa",
                                        "glosses": [
                                            "Elaborately ornamented, often to excess."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a1e984d-4cdd-4930-8da1-560fb1461811",
                                                "sense_id": "cac9bef4-2c86-3cb1-a176-767bc15e242e",
                                                "text": "The house of Ruthven was a small but ultra-modern limestone affair, between Madison and Fifth ;[…]. As a matter of fact its narrow ornate façade presented not a single quiet space that the eyes might rest on after a tiring attempt to follow and codify the arabesques, foliations, and intricate vermiculations of what some disrespectfully dubbed as “near-aissance.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "728cc14b-4502-3b94-8c31-63a395e5e9ca",
                                        "entry_id": "662d02e8-d31d-3784-a7e5-209bad8547fa",
                                        "glosses": [
                                            "Flashy, flowery or showy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d046e303-a650-3123-9ca3-d50768c6328e",
                                        "entry_id": "662d02e8-d31d-3784-a7e5-209bad8547fa",
                                        "glosses": [
                                            "Finely finished, as a style of composition."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c1a37e1-d18a-4670-8480-8496f8bbce31",
                                                "sense_id": "d046e303-a650-3123-9ca3-d50768c6328e",
                                                "text": "a graceful and ornate rhetoric"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ornate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9381bf96-dc64-3dd5-a213-d4b551282d66",
                                        "entry_id": "5faa698a-47c5-3b50-8ed6-e1347e7d2346",
                                        "glosses": [
                                            "To adorn or honour (someone or something)."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5974e36f-1171-4381-bad7-e073ea9ca0fc",
                                                "sense_id": "9381bf96-dc64-3dd5-a213-d4b551282d66",
                                                "text": "And truely thoſe that lyue in the feare of god, (conſydering that they ſerue not only their carnal maiſters, but God hymſelfe,) they be in a good caſe: but they may not bee eye ſeruauntes. […] Saincte Paule woulde haue them to lyue ſo, that they maye ornate and ſanctifye the name of God."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
