                        "glosses": [
                            "In a belligerent manner; with aggressive hostility."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c643071-3f04-46a4-afa4-efda805f40de",
                                "sense_id": "6c5fe1bd-687d-3e33-aae1-6ded887f3654",
                                "text": "They swaggered unsteadily but belligerently toward the bar and looked at Pete with bleared and blinking eyes."
                            },
                            {
                                "example_id": "f2a9d383-f223-42cd-873b-6385b8f0a6d9",
                                "sense_id": "6c5fe1bd-687d-3e33-aae1-6ded887f3654",
                                "text": "“How’d you get a job like this?” she asked.\n“A fella got to eat,” he began; and then, belligerently, “A fella got a right to eat.”"
                            },
                            {
                                "example_id": "7cbf40f9-0b15-49fa-a858-fff9d740d261",
                                "sense_id": "6c5fe1bd-687d-3e33-aae1-6ded887f3654",
                                "text": "In truth, Mrs. Lish’s charge of anti-Semitism had backfired with a number of the faculty, who were quite belligerently anti-Semitic themselves."
                            }
                        ]
                    }
