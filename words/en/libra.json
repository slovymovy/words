            "pos": "name",
            "senses": [
                {
                    "sense_id": "597d0aa4-0672-3f6c-84f5-2ad7ea52fe92",
                    "sense_definition": "The seventh sign of the zodiac, symbolised by scales and covering roughly September 23 to October 22.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astrology",
                    "name_type": "mythological_or_astrological_entity",
                    "examples": [
                        {
                            "text": "The Sun enters <w>Libra</w> at the time of the autumn equinox."
                        },
                        {
                            "text": "According to the horoscope, <w>Libra</w> is an air sign ruled by the planet Venus."
                        }
                    ],
                    "antonyms": [],
                    "common_phrases": [
                        "sign of Libra",
                        "born under Libra"
                    ]
                },
                {
                    "sense_id": "ff251fd5-8698-3fde-aa2e-7d31c38e3a5a",
                    "sense_definition": "A constellation of the zodiac, situated between Virgo and Scorpius, traditionally depicted as a pair of scales.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "astronomy",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "On clear nights, astronomers can observe faint stars in the constellation of <w>Libra</w>."
                        },
                        {
                            "text": "The brightest star in <w>Libra</w> is known as Zubeneschamali."
                        }
                    ],
                    "common_phrases": [
                        "constellation of Libra"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d7fef971-5c02-36ea-8b7f-068e02f7bcc4",
                    "sense_definition": "A person who was born while the sun was in the astrological sign of Libra.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "astrology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As a typical <w>Libra</w>, she always strives for harmony and fairness in relationships."
                        },
                        {
                            "text": "Both of my brothers are <w>Libras</w>, so their birthdays are only a few days apart."
                        }
                    ],
                    "common_phrases": [
                        "typical Libra"
                    ]
                },
                {
