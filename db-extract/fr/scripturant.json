                        "sense_id": "13b67ebe-e5d3-3e72-9fe8-84ad4da16211",
                        "entry_id": "fe4ba33d-753f-3260-9465-f48da8e9599f",
                        "glosses": [
                            "Écrivain qui construit ses récits au moment de leur écriture, sans avoir préparé de plan ni de structure."
                        ],
                        "tags": [
                            "neologism"
                        ],
                        "examples": [
                            {
                                "example_id": "7e7e5f51-7025-44c4-811e-c59b34d97bf8",
                                "sense_id": "13b67ebe-e5d3-3e72-9fe8-84ad4da16211",
                                "text": "Pierre est un scripturant, moi je suis un structurant. Tout lui arrive au moment de l’écriture, alors que, pour mon compte, je dois tout savoir avant de commencer."
                            },
                            {
                                "example_id": "88b3559d-2a9c-4026-af71-104de4676603",
                                "sense_id": "13b67ebe-e5d3-3e72-9fe8-84ad4da16211",
                                "text": "Bordage dit-il de lui-même qu’il est «un scripturant» et pas un «structurant», selon la définition de Francis Berthelot, c’est-à-dire qu’il se lance sans plan ni structure."
                            }
                        ]
                    }
