    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ed6e4158-e973-3f85-883a-609d08a75e03",
                    "sense_definition": "Enfreindre volontairement les règles d'un jeu, d'une compétition ou d'un examen pour obtenir un avantage indu.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fraude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est strictement interdit de <w>tricher</w> pendant cette épreuve sous peine d'exclusion immédiate."
                        },
                        {
                            "text": "Mon petit frère essaie toujours de <w>tricher</w> aux cartes quand nous jouons en famille."
                        }
                    ],
                    "synonyms": [
                        "cheater"
                    ],
                    "common_phrases": [
                        "tricher au jeu",
                        "tricher à un examen",
                        "interdit de tricher"
                    ]
                },
                {
                    "sense_id": "6d87cf77-6b39-3b71-8366-6c0b479521f5",
                    "sense_definition": "Manquer de sincérité ou dissimuler la vérité pour donner une impression trompeuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dissimulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a toujours refusé de <w>tricher</w> avec ses sentiments pour faire plaisir aux autres."
                        },
                        {
                            "text": "Dans son autobiographie, l'écrivain s'exprime avec sincérité et ne cherche jamais à <w>tricher</w>."
                        }
                    ],
                    "common_phrases": [
                        "tricher avec soi-même",
                        "refuser de tricher",
                        "sans tricher"
                    ]
                },
                {
                    "sense_id": "1cdc67c5-756b-3fe2-b4a9-bfd178529481",
                    "sense_definition": "Dissimuler un défaut de régularité ou de symétrie par un artifice technique ou visuel.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ajustement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peintre a dû <w>tricher</w> avec la perspective pour donner une illusion de profondeur plus convaincante."
                        },
                        {
                            "text": "Pour que l'ourlet de la robe tombe parfaitement droit, la couturière a légèrement <w>triché</w> sur les plis."
                        }
                    ],
                    "common_phrases": [
                        "tricher sur les mesures",
                        "tricher avec la perspective"
                    ]
                },
                {
                    "sense_id": "699ddd44-15fb-312a-bb7d-fef962609ff4",
                    "sense_definition": "Contourner, éluder ou enfreindre des dispositions légales ou réglementaires par des ruses.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fraude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Certains automobilistes utilisent des applications mobiles pour <w>tricher</w> avec les contrôles de vitesse."
                        },
                        {
                            "text": "L'entreprise a exploité des failles juridiques pour <w>tricher</w> avec le règlement fiscal en vigueur."
                        }
                    ],
                    "common_phrases": [
                        "tricher le règlement",
                        "tricher la loi"
                    ]
                },
                {
                    "sense_id": "1b5fcbc5-22bc-3d60-9c16-c803011ff796",
                    "sense_definition": "Tromper ou duper directement quelqu'un par une manœuvre déloyale.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fraude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux marchand s'est plaint amèrement qu'un escroc l'avait <w>triché</w> lors de la vente."
                        },
                        {
                            "text": "Ils ont découvert tardivement que leur associé les avait <w>trichés</w> sans le moindre scrupule."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Emploi transitif direct vieilli"
                        }
                    ]
                }
            ]
        }
    ]
