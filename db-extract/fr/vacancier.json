                    {
                        "form_id": "f61fa9e1-2ecf-4c1c-80c8-5adf979207ff",
                        "entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                        "tags": [
                            "feminine"
                        ],
                        "form": "vacancière"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                        "entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                        "glosses": [
                            "Personne qui est en vacances, qui prend des vacances."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6530250f-88f5-4829-96af-cb6088a1ad40",
                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                "text": "Elle, elle était du côté des « vacanciers », des campeurs, de ceux qui vont et viennent, même les riches qui descendent dans les grands hôtels."
                            },
                            {
                                "example_id": "155104e7-3142-4100-b00a-e61c2c9dfb04",
                                "sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                                "text": "C’est pourquoi il faut bien distinguer vacances et voyages et par voie de conséquence le touriste du vacancier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "951eb081-30f1-4041-8702-fcb6aa672f3f",
                        "source_entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                        "source_sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
                        "target_lang_word": "Urlauber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Urlauber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                        "entry_id": "da7e2838-4fe6-3dd6-9f90-760aa418a216",
                                        "glosses": [
                                            "jemand, der Urlaub macht; der sich im Urlaub befindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c53dfc6-46d5-4e04-a784-88fe7e910e9d",
                                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                                "text": "Die Urlauber warteten auf den Reiseleiter."
                                            },
                                            {
                                                "example_id": "0b8ad85d-00fd-4aac-a86c-d86a53a752d1",
                                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                                "text": "„Der letzte Schwung Urlauber der Saison war abgereist.“"
                                            },
                                            {
                                                "example_id": "af8f7b75-b538-4a66-a0bc-2473d9b44597",
                                                "sense_id": "79fa00d0-2280-3e69-9721-30f3fe88ff82",
                                                "text": "„Am Straßenrand war ein Reisebus geparkt und eine Flut von Urlaubern überschwemmte nun das Dorf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6f7053d1-0689-478e-84f1-9faa5a704d29",
                        "source_entry_id": "a525b10d-035f-3600-8f7a-7451a7f0792c",
                        "source_sense_id": "cf041508-2cd6-31a2-a2f6-8073e05e6e90",
