                        "entry_id": "1f3e065b-d446-350c-b116-bb57b5dd6347",
                        "glosses": [
                            "Vélo dont le conducteur transporte une autre personne ou des biens en échange d’une somme d’argent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "875a367f-3036-4719-9fac-4b9428126233",
                                "sense_id": "bdf39d2a-5b98-3222-b257-1dc9f3875093",
                                "text": "Le taxi-vélo est l’activité importante qui engage la majorité des Jeunes citadins."
                            },
                            {
                                "example_id": "9d19baaa-c80f-43df-b8b2-d856eb42a59d",
                                "sense_id": "bdf39d2a-5b98-3222-b257-1dc9f3875093",
                                "text": "Le taxi-vélo quant à lui ne semble pas jouer de rôle significatif en milieu urbain."
                            },
                            {
                                "example_id": "87c040df-1229-4875-bfbd-7ff40b5d8132",
                                "sense_id": "bdf39d2a-5b98-3222-b257-1dc9f3875093",
                                "text": "Elle se parcourait à pied, à vélo ou encore, pour les plus fortunés, à taxi-vélo."
                            }
                        ]
                    }
                ],
