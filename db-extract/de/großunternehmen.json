                    {
                        "sense_id": "8f1a2c3c-df20-32d3-b71a-4494d73ec4cf",
                        "entry_id": "7d3b07e0-7914-3378-9cc1-046a25e553e4",
                        "glosses": [
                            "Unternehmen mit hohen Umsätzen und/oder vielen Mitarbeitern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0ae4914-a670-4cde-b10a-21dfe3b2bef6",
                                "sense_id": "8f1a2c3c-df20-32d3-b71a-4494d73ec4cf",
                                "text": "„Darüber hinaus war es üblich, dass deutsche Großunternehmen und Konzerne ihre Auslandsgeschäfte über teilweise oder ganz in ausländischem Besitz befindliche Tochterunternehmen abwickelten, insbesondere solche mit Sitz in den Niederlanden.“"
                            },
                            {
                                "example_id": "c9eba006-36a0-4de3-a57b-597dfafa7e4e",
                                "sense_id": "8f1a2c3c-df20-32d3-b71a-4494d73ec4cf",
                                "text": "„Es soll dafür sorgen, dass in gut hundert Großunternehmen 30 Prozent aller Aufsichtsratsposten weiblich besetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
