{
    "word_family": [
        "velvety",
        "velveteen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "16388982-d0f5-385a-95fc-ee6f848c6bc4",
                    "sense_definition": "A closely woven fabric with a thick, short pile on one side, originally made of silk but now also of cotton or synthetic fibers.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a beautiful evening gown made of black <w>velvet</w>.",
                            "target_lang_translations": {
                                "ru": "На ней было красивое вечернее платье из черного <w>бархата</w>.",
                                "zh": "她穿了一件漂亮的黑色<w>天鹅绒</w>晚礼服。"
                            }
                        },
                        {
                            "text": "The royal throne was covered in rich red <w>velvet</w>.",
                            "target_lang_translations": {
                                "ru": "Королевский трон был обит дорогим красным <w>бархатом</w>.",
                                "zh": "皇家宝座上铺着华贵的红色<w>天鹅绒</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "red velvet",
                        "blue velvet",
                        "velvet curtain",
                        "silk velvet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Плотная ткань с густым коротким ворсом на одной стороне, изначально изготавливаемая из шелка, а сейчас также из хлопка или синтетических волокон.",
                        "zh": "一种表面有浓密短绒毛的紧密织物，最初由丝绸制成，现在也用棉或合成纤维制成。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́рхат",
                                "target_lang_sense_clarification": "ткань"
                            },
                            {
                                "target_lang_word": "велю́р",
                                "target_lang_sense_clarification": "похожая ворсовая ткань"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天鹅绒",
                                "target_lang_sense_clarification": "织物"
                            },
                            {
                                "target_lang_word": "丝绒",
                                "target_lang_sense_clarification": "织物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "627bfc43-700d-3d85-89b9-c6a305104cce",
                    "sense_definition": "The soft, hairy skin that covers the antlers of a deer while they are growing.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stag rubbed its antlers against the tree to remove the itching <w>velvet</w>.",
                            "target_lang_translations": {
                                "ru": "Олень терся рогами о дерево, чтобы счистить зудящий <w>бархат</w>.",
                                "zh": "公鹿在树上蹭它的角，以除去发痒的<w>鹿茸</w>。"
                            }
                        },
                        {
                            "text": "In the spring, the growing antlers are protected by a layer of <w>velvet</w>.",
                            "target_lang_translations": {
                                "ru": "Весной растущие рога защищены слоем <w>бархата</w>.",
                                "zh": "春天时，生长的鹿角被一层<w>茸皮</w>保护着。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "zoology"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкая кожица с ворсом, покрывающая рога оленя в период их роста.",
                        "zh": "鹿角在生长期间覆盖的一层柔软且带有绒毛的皮肤。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́рхат",
                                "target_lang_sense_clarification": "на рогах оленя"
                            },
                            {
                                "target_lang_word": "пушо́к",
                                "target_lang_sense_clarification": "мягкий ворс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "鹿茸",
                                "target_lang_sense_clarification": "鹿角上的绒皮"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "9d947c70-1926-3084-b90e-02e8e3b28ea7",
                    "sense_definition": "Made of the fabric velvet.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He put on his <w>velvet</w> jacket for the formal dinner.",
                            "target_lang_translations": {
                                "ru": "Он надел свой <w>бархатный</w> пиджак на званый ужин.",
                                "zh": "他穿上他的<w>天鹅绒</w>夹克去参加正式晚宴。"
                            }
                        },
                        {
                            "text": "The <w>velvet</w> cushions on the sofa were very comfortable.",
                            "target_lang_translations": {
                                "ru": "<w>Бархатные</w> подушки на диване были очень удобными.",
                                "zh": "沙发上的<w>天鹅绒</w>靠垫非常舒服。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "velvet dress",
                        "velvet ribbon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделанный из бархата.",
                        "zh": "由天鹅绒制成的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́рхатный",
                                "target_lang_sense_clarification": "материал"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天鹅绒的",
                                "target_lang_sense_clarification": "材质"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4f4482a1-ad93-3b37-a2f9-7b719b487f13",
                    "sense_definition": "Soft, smooth, and delicate to the touch or hearing; resembling the texture of velvet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer has a <w>velvet</w> voice that calms the audience immediately.",
                            "target_lang_translations": {
                                "ru": "У певца <w>бархатный</w> голос, который мгновенно успокаивает публику.",
                                "zh": "这位歌手有着<w>天鹅绒般</w>的嗓音，能让观众立刻安静下来。"
                            }
                        },
                        {
                            "text": "The horse's nose felt like <w>velvet</w> skin under my hand.",
                            "target_lang_translations": {
                                "ru": "Нос лошади под моей рукой ощущался как <w>бархатная</w> кожа.",
                                "zh": "马的鼻子在我手下摸起来像<w>天鹅绒</w>一样柔软。"
                            }
                        }
                    ],
                    "synonyms": [
                        "velvety",
                        "soft",
                        "smooth"
                    ],
                    "antonyms": [
                        "rough",
                        "coarse"
                    ],
                    "common_phrases": [
                        "velvet touch",
                        "velvet voice"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мягкий, гладкий и нежный на ощупь или на слух; напоминающий текстуру бархата.",
                        "zh": "触感或听感上柔软、光滑、细腻；类似于天鹅绒的质地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́рхатный",
                                "target_lang_sense_clarification": "перен. мягкий, приятный"
                            },
                            {
                                "target_lang_word": "мя́гкий",
                                "target_lang_sense_clarification": "нежный"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "天鹅绒般的",
                                "target_lang_sense_clarification": "形容质感或声音"
                            },
                            {
                                "target_lang_word": "柔软的",
                                "target_lang_sense_clarification": "触感"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "502d8745-3fca-3dfd-bab3-1dc82664371e",
                    "sense_definition": "Peaceful and carried out without violence, particularly regarding political changes.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens hoped for a <w>velvet</w> revolution rather than a violent conflict.",
                            "target_lang_translations": {
                                "ru": "Граждане надеялись на <w>бархатную</w> революцию, а не на насильственный конфликт.",
                                "zh": "市民们希望进行一场<w>和平的</w>革命，而不是暴力冲突。"
                            }
                        },
                        {
                            "text": "The two nations agreed on a <w>velvet</w> divorce to separate their territories peacefully.",
                            "target_lang_translations": {
                                "ru": "Две нации договорились о <w>бархатном</w> разводе для мирного разделения территорий.",
                                "zh": "两国达成了一项<w>和平</w>分手的协议，以和平方式划分领土。"
                            }
                        }
                    ],
                    "synonyms": [
                        "peaceful",
                        "nonviolent"
                    ],
                    "antonyms": [
                        "violent"
                    ],
                    "common_phrases": [
                        "velvet revolution",
                        "velvet divorce"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "political"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мирный, осуществляемый без насилия (о политических изменениях).",
                        "zh": "和平的，以非暴力方式进行的，尤指政治变革。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ба́рхатный",
                                "target_lang_sense_clarification": "о революции или разводе"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "和平的",
                                "target_lang_sense_clarification": "指政治变革"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d0181f61-a2e9-3df5-ab1f-8241cc7b2565",
                    "sense_definition": "To coat raw meat in starch and oil before cooking to keep it tender.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>velvet</w> the chicken strips before adding them to the stir-fry.",
                            "target_lang_translations": {
                                "ru": "Вам следует <w>запанировать</w> полоски курицы перед тем, как добавить их в жаркое.",
                                "zh": "在把鸡肉条放入炒锅前，你应该先给它们<w>上浆</w>。"
                            }
                        },
                        {
                            "text": "The chef taught us how to <w>velvet</w> beef so it stays juicy in the wok.",
                            "target_lang_translations": {
                                "ru": "Шеф-повар научил нас, как <w>мариновать</w> говядину, чтобы она оставалась сочной в воке.",
                                "zh": "厨师教我们如何给牛肉<w>上浆</w>，这样在炒的时候肉质依然鲜嫩多汁。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "cooking"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать сырое мясо смесью крахмала и масла перед готовкой для сохранения сочности.",
                        "zh": "在烹饪前将生肉裹上淀粉和油，以保持其鲜嫩。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "панирова́ть",
                                "target_lang_sense_clarification": "в крахмале"
                            },
                            {
                                "target_lang_word": "маринова́ть",
                                "target_lang_sense_clarification": "кулинарная обработка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "上浆",
                                "target_lang_sense_clarification": "烹饪技法"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2414cf5b-ec89-354c-a68e-15b44fa12d18",
                    "sense_definition": "To cover a surface with velvet or a material with a similar texture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The interior designer decided to <w>velvet</w> the walls of the private cinema.",
                            "target_lang_translations": {
                                "ru": "Дизайнер интерьера решил <w>обить бархатом</w> стены частного кинотеатра.",
                                "zh": "室内设计师决定用天鹅绒<w>覆盖</w>私人影院的墙壁。"
                            }
                        },
                        {
                            "text": "Over time, the moss had <w>velveted</w> the rocks near the river.",
                            "target_lang_translations": {
                                "ru": "Со временем мох <w>покрыл бархатом</w> камни у реки.",
                                "zh": "随着时间的推移，苔藓像天鹅绒一样<w>覆盖</w>了河边的岩石。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Покрывать поверхность бархатом или материалом с похожей текстурой.",
                        "zh": "用天鹅绒或类似质地的材料覆盖表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обива́ть",
                                "target_lang_sense_clarification": "бархатом"
                            },
                            {
                                "target_lang_word": "драпирова́ть",
                                "target_lang_sense_clarification": "тканью"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "覆盖",
                                "target_lang_sense_clarification": "用天鹅绒覆盖"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}