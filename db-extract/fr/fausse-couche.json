                                                "example_id": "add90d2e-1d7d-49c8-b31d-cff4f13053f0",
                                                "sense_id": "f61ae385-5cf3-34bc-babd-7531606dbfd1",
                                                "text": "< υπώνυμα: αποκοπή"
