                        "glosses": [
                            "Vin produit au Maroc, dans la région de Casablanca."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1b26b511-87c3-47c0-95e3-40ec084424b9",
                                "sense_id": "154134bc-d354-36ae-8a7e-d47d71f1432e",
                                "text": "Clémence refusa le couscous royal, mais les merguez et le gris Boulaouane lui mirent aux joues deux jolies taches roses, au seuil d’après-midi."
                            },
                            {
                                "example_id": "53b26dc7-2f9a-470b-a9ce-cee6bd11b742",
                                "sense_id": "154134bc-d354-36ae-8a7e-d47d71f1432e",
                                "text": "Ce soir les hommes ont allumé un brasier et nous avons dîné de succulentes grillades, merguez et côtes d'agneau. Nous avons même bu un verre de boulaouane, mais discrètement."
                            },
                            {
                                "example_id": "64ebc09d-3e77-4881-bfec-c458c0856edc",
                                "sense_id": "154134bc-d354-36ae-8a7e-d47d71f1432e",
                                "text": "Une bouteille de boulaouane à moitié vide trônait au milieu des casseroles et des marmites."
                            }
                        ]
                    }
