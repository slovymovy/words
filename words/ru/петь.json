                            "text": "Эй, <w>Петь</w>, ты идёшь сегодня в кино?",
                            "target_lang_translations": {
                                "en": "Hey, <w>Petya</w>, are you going to the movies today?",
                                "zh": "嘿，<w>佩佳</w>，你今天去看电影吗？"
                            }
                        }
