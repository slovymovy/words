                "senses": [
                    {
                        "sense_id": "7a1853d4-393e-3461-9b3b-9ce4adfc9ef1",
                        "entry_id": "a808b42d-2e7a-32a5-b979-b3e6adfb3097",
                        "glosses": [
                            "Angehöriger einer Kultur, die im 2. Jahrtausend vor Christus auf dem südlichen und zentralen griechischen Festland siedelte"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "5a68e869-ea8e-448d-89c8-e02a0fccf9d9",
                                "sense_id": "7a1853d4-393e-3461-9b3b-9ce4adfc9ef1",
                                "text": "„Als schließlich die Mykener vom griechischen Festland im 15. Jahrhundert v. Chr. Kreta eroberten, hatten sich die Vorzeichen der Beziehungen geändert […].“"
                            },
                            {
                                "example_id": "b542f807-2a7d-462c-bcfc-910668fe42e4",
                                "sense_id": "7a1853d4-393e-3461-9b3b-9ce4adfc9ef1",
                                "text": "„Natürlich könnte ein zehnjähriger zermürbender Krieg gegen Troja als Erklärung des Endes der Mykener herangezogen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
