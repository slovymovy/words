                    {
                        "sense_id": "22cb552f-881c-391d-90bf-9431ee6a9b92",
                        "entry_id": "8847d981-b6c5-3d28-b286-8a3a09778784",
                        "glosses": [
                            "ruimte waarin een (kleine) medische behandeling kan plaatsvinden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4a86be3f-bcca-4ff7-a362-db425965acf5",
                                "sense_id": "22cb552f-881c-391d-90bf-9431ee6a9b92",
                                "text": "Er gaat een rilling door mijn lichaam als Sjinkie Knegt breekt en begint te huilen. In de behandelkamer van het Brandwondencentrum in het Martini Ziekenhuis in Groningen kijken en luisteren acht personen intens mee. Twee NOS-collega's, twee verpleegkundigen, de manager van Knegt, de cameraman, de geluidsman en de vriendin van Sjinkie."
                            },
                            {
                                "example_id": "f804e7b1-123b-4aaa-8ae1-60412d70f048",
                                "sense_id": "22cb552f-881c-391d-90bf-9431ee6a9b92",
                                "text": "\"Eerder bleef het in de behandelkamer bij gesprekken en kreeg de patiënt de oefeningen mee naar huis. Nu kunnen we hier direct situaties oefenen en daarover in gesprek gaan\", zegt Van Pelt. \"Die stap tussen de behandelkamer en het echte leven ontbrak, maar hebben we nu via deze tool in handen.\""
                            }
                        ]
                    }
