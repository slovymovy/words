                            {
                                "example_id": "6cd426e1-b5b6-4e14-bfef-5b5aabe77900",
                                "sense_id": "fb60a723-52ab-3ad7-956d-1b0f526c7dae",
                                "text": "In het huidige tijdvak (het holoceen, van 10.000 v. Chr. tot heden) wordt het klimaat warmer en vochtiger."
                            },
                            {
                                "example_id": "8161a354-dd25-4e45-9202-d27cf5c70bc0",
                                "sense_id": "fb60a723-52ab-3ad7-956d-1b0f526c7dae",
                                "text": "Decoraties en meubelstukken uit ver van elkaar verwijderde tijdvakken hingen en stonden elkaar met verwondering aan te staren."
