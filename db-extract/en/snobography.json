                "senses": [
                    {
                        "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                        "entry_id": "927746bd-ff21-3569-bc32-8a1dab69e14f",
                        "glosses": [
                            "The description of snobs and snobbery."
                        ],
                        "tags": [
                            "humorous",
                            "literary",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "04b839bd-8889-4975-b624-c2aaa514b8c8",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "But the coincidence in two such artists is curious, nor is it the only foreshadowing of 'snobography' in the lady."
                            },
                            {
                                "example_id": "a1e4f01c-e2fe-446b-8dab-57e1eb4a54e8",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "But the safer and wiser way in this infancy of the science of snobography is to refrain from the attempt at absolute aphorism."
                            },
                            {
                                "example_id": "601160c5-dda7-495b-bc6d-55e1a2446f15",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "On this side of the Atlantic it may be recommended to a certain class by an undertaking that promises to be a veritable snobography."
                            },
                            {
                                "example_id": "d42b99c8-b7e8-46a6-b758-09bb49933e2f",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "The reader will recall many a name eminent in the science of snobology and the art of snobography."
                            },
                            {
                                "example_id": "8b08dcdd-b9ea-447c-b8a5-f2d94bb7f05c",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "The Colony restaurant does not suffer as intensely from Snobography as does a night club like El Morocco."
                            },
                            {
                                "example_id": "caa6610f-3d27-48f5-bddd-826b769c4ad4",
                                "sense_id": "3f7af93e-b795-3fda-8a8f-5eda790152b6",
                                "text": "Mr. Pirrup's self-lacerating autobiography was the superior snobography, the true inside story, not the omniscient narrator's satiric yet forgiving biography of Arthur Pendennis."
                            }
                        ]
                    }
