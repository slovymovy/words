                ],
                "senses": [
                    {
                        "sense_id": "ba21111d-e1a8-377d-aec8-2541c4e6e277",
                        "entry_id": "e04c1bbf-3f2f-3699-a9bf-e28c52d68813",
                        "glosses": [
                            "Remuer, sauter, danser, bouger sans cesse."
                        ],
                        "tags": [
                            "Régionalisme"
                        ],
                        "examples": [
                            {
                                "example_id": "e3e4de1e-3597-4266-8b90-330632514ce9",
                                "sense_id": "ba21111d-e1a8-377d-aec8-2541c4e6e277",
                                "text": "Mais la Vouivre « n’est pas du diable pour un sou », et selon Arsène, « c’est comme une espèce de garçon manqué, toujours à courir dans les bois, à rejinguer, avec point de souci en tête ». Une fille presque normale, pas méchante."
                            },
                            {
                                "example_id": "29c2c5e1-0c28-49cb-9610-0db7598c7ec0",
                                "sense_id": "ba21111d-e1a8-377d-aec8-2541c4e6e277",
                                "text": "Je les ai entendus rejinguer au-dessus de ma tête."
                            },
                            {
                                "example_id": "6fdacf0c-075a-4e11-9ee8-7cc8307fa332",
                                "sense_id": "ba21111d-e1a8-377d-aec8-2541c4e6e277",
                                "text": "Il me semble d'avoir entendu rejinguer le cheval dans l'écurie, répondit-elle à une question de sa mère."
                            }
                        ]
                    }
                ],
