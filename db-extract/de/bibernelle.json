                                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
                                        "glosses": [
                                            "Any of various plants of the genus Anagallis, having small red, white or purple flowers, especially the scarlet pimpernel (Anagallis arvensis)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64805934-1add-4543-b511-7d539c0f78cf",
                                                "sense_id": "14156227-8395-3a5f-bd6c-240d3bc8bc2f",
                                                "text": "Common Pimpernel has diverse weak square stalks lying on the ground, beset all along with two small and almost round leaves at every joint [...]."
                                            },
                                            {
                                                "example_id": "1eb59dfb-1c95-45ed-9740-b7763ee5951b",
                                                "sense_id": "14156227-8395-3a5f-bd6c-240d3bc8bc2f",
                                                "text": "Pimpernel (poor man's weather glass) was also a protection, but as the gatherer collected the herbs, he must chant a certain incantation and continue to do so twice a day for 15 days[.]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5452d1fb-4891-367f-abe7-6f90d8cdfbd5",
                                        "entry_id": "ca835f15-2f68-3528-918f-123cb9f88b0e",
