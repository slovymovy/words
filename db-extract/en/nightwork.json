                                "example_id": "60a776a6-dcab-4317-96d9-ad5c6164b471",
                                "sense_id": "c3a3c201-5692-3adf-8ee1-2e626b126d72",
                                "text": "Much of that highway reconstruction project was nightwork."
                            },
                            {
                                "example_id": "d5e02266-491a-4514-9114-3bc3875ec15f",
                                "sense_id": "c3a3c201-5692-3adf-8ee1-2e626b126d72",
                                "text": "I don't know why it is the hours fly with such a strange celerity in the monotony and solitude of such nightwork."
                            },
                            {
                                "example_id": "6e394601-0e10-4030-83eb-1ff5f54f1806",
                                "sense_id": "c3a3c201-5692-3adf-8ee1-2e626b126d72",
                                "text": "‘Under journalist cover we bring her into play, give her Chinese newspapers to translate, send her on little errands, involve her, complete her education and train her in nightwork.’"
                            }
                        ]
                    }
