                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d7d2a49-83df-4bce-b86f-96af9ae19044",
                        "source_entry_id": "c9510746-4b56-3b76-8f0e-fabf8b8f971c",
                        "source_sense_id": "f679b626-3bf4-36a9-b52b-b6bdde1f0018",
                        "target_lang_word": "assimilation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assimilation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The act of assimilating or the state of being assimilated."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "17b70f09-1c28-4f4e-ac1d-441687361da7",
                                                "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                                "text": "--France swarms with Gracchus's and Publicolas, who by imaginary assimilations of acts, which a change of manners has rendered different, fancy themselves more than equal to their prototypes."
                                            },
                                            {
                                                "example_id": "25e47fbf-ebec-4c21-9031-e4249f2b89dc",
                                                "sense_id": "16ed900e-f705-3420-abc8-078cc5b7740b",
                                                "text": "His work generally is full of assimilations and quotations from art that is not Mexican, and he's said, \"Nationalism has nothing to do with my work."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc7d5e94-17be-3e7c-b554-812747a662e0",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The metabolic conversion of nutrients into tissue."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a787d65-847f-401f-933b-ad5a59e66a35",
                                                "sense_id": "dc7d5e94-17be-3e7c-b554-812747a662e0",
                                                "text": "We have great need to be careful in these assimilations; some kinds of food are rich but not easily digested."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "898b295e-2fe6-3cd1-add0-f9f914b70bf2",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The absorption of new ideas into an existing cognitive structure."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "665f4137-e2ac-366c-beff-2ab19a68fe85",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "A sound change process by which the phonetics of a speech segment becomes more like that of another segment in a word (or at a word boundary), so that a change of phoneme occurs."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea274d1a-1783-4a81-8909-6df5e7234fc8",
                                                "sense_id": "665f4137-e2ac-366c-beff-2ab19a68fe85",
                                                "text": "Hence, rather than being the result of mishearing and assimilation, the application of Hobson-Jobson to the Muharram was intentionally disparaging."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                        "entry_id": "b5636a46-1069-387b-a728-e790b53fd8c2",
                                        "glosses": [
                                            "The adoption, by a minority group, of the customs and attitudes of the dominant culture."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee92ac35-b741-4d47-920b-7d4f6f82e492",
                                                "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                                "text": "After centuries of British cultural assimilation, a majority of Irish now speak English instead of Irish."
                                            },
                                            {
                                                "example_id": "afe59825-ed37-4fa3-ba89-547964f32473",
                                                "sense_id": "0db00957-0283-386f-9d39-d78ede05ebed",
                                                "text": "Assimilation was one of the words they used for Indians becoming white in order to survive, in order that they might not be killed for being Indians."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cdf71381-06ba-483a-906f-0a0ff7c67114",
                        "source_entry_id": "c9510746-4b56-3b76-8f0e-fabf8b8f971c",
                        "source_sense_id": "f679b626-3bf4-36a9-b52b-b6bdde1f0018",
                        "target_lang_word": "digestion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "digestion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The process, in the gastrointestinal tract, by which food is converted into substances that can be used by the body."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6ca9726-b217-469b-a0ab-06d2fb884fca",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "In the dead state all is apparently without motion. No agent within indicates design, intelligence, or foresight: there is no respiration; no digestion, circulation, or nutrition; […]"
                                            },
                                            {
                                                "example_id": "cd2e1045-3679-498f-8235-72dd8954e5d9",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "As for Grierson, he poured liquor into himself as if it were so much soothing syrup, demonstrating that a good digestion is the highest form of good conscience."
                                            },
                                            {
                                                "example_id": "a4ecf268-b5a2-4621-8719-a2d316519f5d",
                                                "sense_id": "2ffcf6c5-815a-336c-80ce-b8cd431bdd3d",
                                                "text": "Mostly, the microbiome is beneficial. It helps with digestion and enables people to extract a lot more calories from their food than would otherwise be possible. Research over the past few years, however, has implicated it in diseases from atherosclerosis to asthma to autism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "544f2a99-8393-3c5f-a543-f39ae13be263",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The result of this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5144a7ac-12b2-382b-91b4-680461a270b7",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The ability to use this process."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f5db9a5f-c84f-344c-baf5-d96baf60379a",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The processing of decay in organic matter assisted by microorganisms."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8b2022e3-c001-37c8-b795-8884f63beead",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "The assimilation and understanding of ideas."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "371537e5-b817-3909-94f2-4382761ce159",
                                        "entry_id": "a73812ac-667a-3d9a-a5e0-2fc906d57de6",
                                        "glosses": [
                                            "Generation of pus; suppuration."
                                        ],
