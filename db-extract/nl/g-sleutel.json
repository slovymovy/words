                                "target_senses": [
                                    {
                                        "sense_id": "c7a79db9-ceb4-3aba-99ee-4cbe738429da",
                                        "entry_id": "7f769eb2-890d-3794-9700-7f003806419f",
                                        "glosses": [
                                            "Clé qui indique le sol nᵒ 3, proche du la du diapason, et qui concerne les sons aigus. Elle est représentée par le signe 𝄞 et se place en début de portée, sur la deuxième ligne en partant du bas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce4b0d30-d469-402d-a30b-cca2bd0fe011",
                                                "sense_id": "c7a79db9-ceb4-3aba-99ee-4cbe738429da",
                                                "text": "Je ne suis pas musicien, en ce sens que je manque tout à fait de culture technique : je ne sais pas lire les notes de la gamme, et je distingue mal la clé de sol et la clé de fa."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
