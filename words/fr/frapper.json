    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "75b883f1-ef75-3147-9951-072c5993a0f8",
                    "sense_definition": "Donner un ou plusieurs coups à quelqu'un ou à quelque chose.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "donner des coups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>frappé</w> son adversaire au visage pendant le match."
                        },
                        {
                            "text": "Il <w>frappe</w> du poing sur la table pour réclamer le silence."
                        },
                        {
                            "text": "Les enfants ne doivent jamais <w>frapper</w> leurs camarades dans la cour de l'école."
                        }
                    ],
                    "synonyms": [
                        "taper",
                        "cogner"
                    ],
                    "common_phrases": [
                        "frapper du poing",
                        "frapper fort",
                        "frapper à coups de pied"
                    ]
                },
                {
                    "sense_id": "d233312e-bc00-30e3-8638-b55c43880dd8",
                    "sense_definition": "Donner des coups à une porte pour signaler sa présence et se faire ouvrir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "donner des coups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Quelqu'un <w>frappe</w> à la porte, peux-tu aller ouvrir ?"
                        },
                        {
                            "text": "Il faut <w>frapper</w> avant d'entrer dans le bureau du directeur."
                        }
                    ],
                    "synonyms": [
                        "cogner",
                        "toquer"
                    ],
                    "common_phrases": [
                        "frapper à la porte",
                        "frapper avant d'entrer"
                    ]
                },
                {
                    "sense_id": "90c1143f-4ddb-3d14-b11b-679eab2cf229",
                    "sense_definition": "Faire une forte impression sur les sens, sur l'esprit ou sur les émotions de quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faire impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce qui m'a <w>frappé</w> dans ce film, c'est la qualité des images."
                        },
                        {
                            "text": "Ces images choquantes ont <w>frappé</w> les esprits dans tout le pays."
                        }
                    ],
                    "common_phrases": [
                        "frapper les esprits"
                    ]
                },
                {
                    "sense_id": "60537bf6-026a-3078-880b-130dabe970e8",
                    "sense_definition": "Se donner des coups à soi-même, souvent comme un geste qui exprime un sentiment.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "donner des coups",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il se <w>frappe</w> le front en réalisant qu'il a oublié ses clés."
                        },
                        {
                            "text": "Les supporters se <w>frappent</w> la poitrine pour montrer leur fierté."
                        }
                    ],
                    "common_phrases": [
                        "se frapper la poitrine",
                        "se frapper le front"
                    ]
                },
                {
                    "sense_id": "eb88cc22-cd9a-3e4f-8274-2df170c55a1b",
                    "sense_definition": "Rafraîchir fortement une boisson, en particulier avec de la glace.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut <w>frapper</w> le champagne une demi-heure avant le dîner."
                        },
                        {
                            "text": "Elle a plongé la bouteille dans un seau de glace pour la <w>frapper</w>."
                        }
                    ],
                    "common_phrases": [
                        "frapper le champagne",
                        "frapper le vin"
                    ]
                },
                {
                    "sense_id": "38ca174f-6231-3b74-9169-9253f842f375",
                    "sense_definition": "Atteindre durement, affliger ou faire périr par un malheur ou une calamité.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "faire impression",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La crise économique a <w>frappé</w> de plein fouet les petites entreprises."
                        },
                        {
                            "text": "Une terrible épidémie <w>frappa</w> la région au début de l'été."
                        }
                    ],
                    "common_phrases": [
                        "frapper de plein fouet",
                        "frapper un grand coup"
                    ]
                },
                {
                    "sense_id": "95ed9721-5a8a-3a79-a30b-1aed606b2f45",
                    "sense_definition": "En parlant de la lumière, atteindre une surface ou un objet.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le soleil du matin <w>frappe</w> directement la façade de la maison."
                        },
                        {
                            "text": "Quand la lumière <w>frappe</w> le cristal, elle crée de petits arcs-en-ciel."
                        }
                    ]
                },
                {
                    "sense_id": "e235ce7c-222d-3f7d-b79e-1e078bd7e274",
                    "sense_definition": "Donner une empreinte à un métal au moyen d'une matrice, pour fabriquer une médaille ou un objet semblable.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabriquer des pièces et des médailles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet atelier <w>frappe</w> des médailles commémoratives pour les clubs sportifs."
                        },
                        {
                            "text": "On a <w>frappé</w> cette médaille pour célébrer les cent ans de la ville."
                        }
                    ],
                    "common_phrases": [
                        "frapper des médailles"
                    ]
                },
                {
                    "sense_id": "9176982f-8de3-3b6d-be2c-3778360e0634",
                    "sense_definition": "Fabriquer de la monnaie métallique, des pièces.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fabriquer des pièces et des médailles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La Monnaie de Paris <w>frappe</w> aussi des pièces pour d'autres pays."
                        },
                        {
                            "text": "Autrefois, chaque roi pouvait <w>frapper</w> sa propre monnaie."
                        }
                    ],
                    "common_phrases": [
                        "frapper la monnaie",
                        "frapper des pièces"
                    ]
                },
                {
                    "sense_id": "7adee8ea-7dd5-39d0-b340-88f68535bde2",
                    "sense_definition": "Se faire du souci, s'inquiéter à l'excès pour quelque chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne te <w>frappe</w> pas, tout va s'arranger."
                        },
                        {
                            "text": "Elle se <w>frappe</w> pour un rien avant chaque examen."
                        }
                    ],
                    "common_phrases": [
                        "ne pas se frapper"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "emploi familier, surtout à la forme pronominale"
                        }
                    ]
                },
                {
                    "sense_id": "5e66a55c-77bb-36b1-a15c-bba07ad1c3e8",
                    "sense_definition": "Peser sur quelque chose ou quelqu'un, en parlant d'une charge, d'un impôt ou d'une hypothèque.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une lourde taxe <w>frappe</w> désormais tous les produits importés."
                        },
                        {
                            "text": "Cet immeuble est <w>frappé</w> d'une hypothèque importante."
                        }
                    ]
                },
                {
                    "sense_id": "e8bd0a95-bd59-3087-a629-13c946837b84",
                    "sense_definition": "Fixer ou attacher quelque chose avec un nœud, en particulier un cordage sur un bateau.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le matelot <w>frappe</w> l'amarre sur le taquet avant l'arrivée au port."
                        },
                        {
                            "text": "Il faut <w>frapper</w> un cordage solide au mât avant la tempête."
                        }
                    ]
                },
                {
                    "sense_id": "63760ee5-8d51-310a-8ffb-118d32baf598",
                    "sense_definition": "Escroquer quelqu'un, lui prendre de l'argent en le trompant.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le faux garagiste a <w>frappé</w> plusieurs clients en vendant des voitures truquées."
                        },
                        {
                            "text": "Méfie-toi de lui, il est capable de te <w>frapper</w> si tu lui fais confiance."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "emploi argotique"
                        }
                    ]
                }
            ]
        }
    ]
}