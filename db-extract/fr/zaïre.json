                        "entry_id": "c3c31c32-9cbe-34fa-a858-6c4fb4fe7103",
                        "glosses": [
                            "Nom donné à la République Démocratique du Congo (Congo-Kinshasa) durant la même période."
                        ],
                        "tags": [],
                        "examples": [
