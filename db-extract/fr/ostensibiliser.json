                ],
                "senses": [
                    {
                        "sense_id": "25aeb340-807e-3d16-90dd-83c2f8496d14",
                        "entry_id": "a1623142-003c-3cea-a1be-318204f8bc88",
                        "glosses": [
                            "Donner un caractère ostensible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99c90ef1-9b1c-494a-9918-05d559b2f838",
                                "sense_id": "25aeb340-807e-3d16-90dd-83c2f8496d14",
                                "text": "Vous cherchez toujours à vous \"ostensibiliser\" alors ne vous plaignez pas ensuite de faire le bonheur des politiques et des médias."
                            },
                            {
                                "example_id": "27a6a887-a366-48d0-a620-0e719edba131",
                                "sense_id": "25aeb340-807e-3d16-90dd-83c2f8496d14",
                                "text": "Contrairement à ce que vous soutenez c’est en évitant « d’ostensibiliser » ses appartenances que que l’on progressera vers un mélange harmonieux au sein de la Société Française de tous ceux qui se sentent « différents »."
                            },
                            {
                                "example_id": "98d4d28f-64cf-4392-b8cb-f432270b2596",
                                "sense_id": "25aeb340-807e-3d16-90dd-83c2f8496d14",
                                "text": "Depuis quand, un ordre initiatique se fait connaître, pavoise, s'ostensibilise ?"
                            }
                        ]
                    }
                ],
