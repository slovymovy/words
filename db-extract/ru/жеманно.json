                                        "entry_id": "89991d44-8f1a-31e9-9b38-bac726f9bba5",
                                        "glosses": [
                                            "Comme chose de prix."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca4870b2-edd5-4f5b-aad1-c830f77ea9b8",
                                                "sense_id": "3cf28353-f3c0-370d-b0dc-d569628c1157",
                                                "text": "Conserver précieusement un objet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "99cea69b-b730-3ba0-b4d9-b446ba802c64",
                                        "entry_id": "89991d44-8f1a-31e9-9b38-bac726f9bba5",
                                        "glosses": [
                                            "Avec le plus grand soin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bab7e32e-ef75-40ac-bad8-48b0284b07e6",
                                                "sense_id": "99cea69b-b730-3ba0-b4d9-b446ba802c64",
                                                "text": "Il serra précieusement dans son secrétaire l'agenda mystérieux et l’épitre du domino blanc, ses armes pour entrer en campagne."
                                            },
                                            {
                                                "example_id": "5bede61d-bb56-41fd-9a5b-6e7af5755454",
                                                "sense_id": "99cea69b-b730-3ba0-b4d9-b446ba802c64",
                                                "text": "Un tableau, une statue précieusement exécutés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2f8a29f-1166-3358-8da5-dd30929c7899",
                                        "entry_id": "89991d44-8f1a-31e9-9b38-bac726f9bba5",
                                        "glosses": [
                                            "Avec le caractère de la préciosité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea68d9d5-a87a-455b-b964-6d4583a7d78c",
                                                "sense_id": "f2f8a29f-1166-3358-8da5-dd30929c7899",
                                                "text": "Ces critiques, satires et invectives secrètes, qui ne sont que trop ordinaires à ce qu’on appelle les savants polis et d’un style précieusement adouci à l’égard de ceux qui ne sont pas de leur avis ou de leur cabale,"
                                            },
                                            {
                                                "example_id": "8188ec25-7bc5-473f-8ab5-b76cc27f260b",
                                                "sense_id": "f2f8a29f-1166-3358-8da5-dd30929c7899",
                                                "text": "[…] nous ne trouvons plus que deux toutes petites places en face d'un monsieur tout pomponné, tout raide en ses beaux habits ; il lit précieusement le journal ; […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
