                        "examples": [
                            {
                                "example_id": "6e2b44d6-2ec6-40be-b180-245a659384d1",
                                "sense_id": "2a7b1d43-0264-3582-be60-e9507aa7d604",
                                "text": "„Ganz zu schweigen vom Barbecue - auch eine Spezialität des Südens, die über die Spanier zu uns kam, welche sie aus der Karibik mitbrachten: Der Begriff stammt von den dortigen Taino-Indianern.“"
                            },
                            {
                                "example_id": "7b840a37-7082-48de-b802-9c8dac288dc2",
                                "sense_id": "2a7b1d43-0264-3582-be60-e9507aa7d604",
                                "text": "„Eine halbe Stunde später genießen wir am prasselnden Lagerfeuer das Barbecue und lassen den Tag im Massaidorf ausklingen – auch ohne Blutsuppe und Trommeltamtam.“"
                            }
                        ],
