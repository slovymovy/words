                "senses": [
                    {
                        "sense_id": "4f6c3392-4057-30fd-95f5-0d2621a7e5d5",
                        "entry_id": "169c611c-a475-333e-9c19-a40b7ea13cf6",
                        "glosses": [
                            "Celui qui creuse, approfondit, va au fond des choses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc1cd00-44a1-4c1e-99d3-4e9d517b9643",
                                "sense_id": "4f6c3392-4057-30fd-95f5-0d2621a7e5d5",
                                "text": "Des gens ingénieux et profonds, des creuseurs d’antiquité."
                            },
                            {
                                "example_id": "b2df9e20-257a-43bd-8def-9600ae1c8a5a",
                                "sense_id": "4f6c3392-4057-30fd-95f5-0d2621a7e5d5",
                                "text": "Cet infatigables creuseur de tunnels"
                            }
                        ]
                    },
                    {
                        "sense_id": "97f20609-59ba-3fff-879c-8fe313cb5526",
                        "entry_id": "169c611c-a475-333e-9c19-a40b7ea13cf6",
                        "glosses": [
                            "Personne employée dans des mines illégales."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "9291548b-0e8f-4882-95d4-8a6659e117c3",
                                "sense_id": "97f20609-59ba-3fff-879c-8fe313cb5526",
                                "text": "Dans les mines de l’ex-Katanga, dans la partie la plus méridionale de la RDC, en effet, l’on compte environ 40 000 enfants « creuseurs » en quête de minerais, selon un rapport de l’Unicef publié en 2014."
                            }
                        ]
                    }
