                ],
                "senses": [
                    {
                        "sense_id": "ccbd04e3-b472-3d87-8c16-24b1c7039d12",
                        "entry_id": "d1dbfcb6-7b4c-3a6d-801e-8e5aaff95e8d",
                        "glosses": [
                            "физиол. страдающий одышкой, подверженный одышке"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92b04758-3438-4c12-aaf0-c3b03e38ffcd",
                                "sense_id": "ccbd04e3-b472-3d87-8c16-24b1c7039d12",
                                "text": "Пожилой монтёр, грузный и одышливый, работал с профессиональной неспешностью, спокойно, ни на что не отвлекаясь."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccb58274-cc57-3c9b-8fd9-b4adaa33c812",
                        "entry_id": "d1dbfcb6-7b4c-3a6d-801e-8e5aaff95e8d",
                        "glosses": [
                            "свойственный тому, кто страдает одышкой"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e8ca931-e169-4f0c-b61e-47d868d3b969",
                                "sense_id": "ccb58274-cc57-3c9b-8fd9-b4adaa33c812",
                                "text": "Порывами было слышно в трубке одышливое кряхтенье Петра Евграфовича; возможно ― уже стоя на коленях, он шарил по полу свою запонку."
                            }
                        ]
                    }
                ],
