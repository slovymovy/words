                "senses": [
                    {
                        "sense_id": "4a4a6799-1e0a-31d4-b360-ba079b121e44",
                        "entry_id": "1aa38322-acd6-3730-8973-f16944fe338b",
                        "glosses": [
                            "мед. наука, ставящая своей задачей изучение законов возникновения, развития и угасания эпидемий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d45b2a4-3375-4d29-ba2c-0c84ec50f3f8",
                                "sense_id": "4a4a6799-1e0a-31d4-b360-ba079b121e44",
                                "text": "Николай Васильевич считал меня ― с полным основанием ― своей ученицей и надеялся, что я пойду работать в Институт эпидемиологии, которым он руководил последние годы."
                            }
                        ]
                    },
                    {
                        "sense_id": "0262816d-8cc7-3c8c-8f26-837803e46d06",
                        "entry_id": "1aa38322-acd6-3730-8973-f16944fe338b",
                        "glosses": [
                            "изучение распространения неэпидемиологических заболеваний, основанное на статистических методах"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fa456946-6b9c-441a-97c6-fe5bf05dce18",
                        "source_entry_id": "1aa38322-acd6-3730-8973-f16944fe338b",
                        "target_lang_word": "epidemiology",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
