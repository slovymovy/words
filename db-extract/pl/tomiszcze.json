                    },
                    {
                        "translation_id": "bacb379f-67a5-459a-a499-6b1ea9e0203f",
                        "source_entry_id": "7a98e416-cc93-3ea7-87b9-deb267322977",
                        "source_sense_id": "7434fe70-3f9c-3796-ba30-b7657228e734",
                        "target_lang_word": "Schwarte",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schwarte",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "71f8c4b1-5e13-3b9f-a605-b8d74f8222b1",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "dicke, behaarte Haut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b42a097-535a-4c7c-b9a2-92f7842d8f30",
                                                "sense_id": "71f8c4b1-5e13-3b9f-a605-b8d74f8222b1",
                                                "text": "Schweine haben eine dicke Schwarte."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "cca84979-b152-3ebe-94d8-8aeba54b7f08",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "zum Verzehr bestimmte Schweinehaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10188210-6f5c-4a52-8ca1-b096efdd0b2d",
                                                "sense_id": "cca84979-b152-3ebe-94d8-8aeba54b7f08",
                                                "text": "Eisbein wird mit Schwarte zubereitet."
                                            },
                                            {
                                                "example_id": "2e0d3f8f-2c7a-4458-aa7d-edf585352318",
                                                "sense_id": "cca84979-b152-3ebe-94d8-8aeba54b7f08",
                                                "text": "„Den Schweinbauch in 4 cm breite Scheiben schneiden. Die Scheiben auf der Schwarte in einer warmen Pfanne in Öl anbraten, bis die Kruste knusprig ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f93c69c2-1d2a-36d4-8e16-2e1deaa976c9",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "die menschliche Kopfhaut"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10622cb8-e2ac-49e1-868b-6ab4535e6545",
                                                "sense_id": "f93c69c2-1d2a-36d4-8e16-2e1deaa976c9",
                                                "text": "Da die Schwarte sehr gut durchblutet ist, sehen auch kleine Kopfplatzwunden meist bedrohlicher aus, als sie eigentlich sind."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a3b2c20e-7f9b-3bc5-a9d0-9b81bed0f7e7",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "ein dickes Buch (oft abwertend)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cadd4c88-f30e-4a67-b4c6-a7fe8e4dc5f6",
                                                "sense_id": "a3b2c20e-7f9b-3bc5-a9d0-9b81bed0f7e7",
                                                "text": "Für die Prüfung musste ich diese ganze Schwarte durcharbeiten."
                                            },
                                            {
                                                "example_id": "96707f1b-e0f3-4aba-8a11-35997abe0244",
                                                "sense_id": "a3b2c20e-7f9b-3bc5-a9d0-9b81bed0f7e7",
                                                "text": "„Man habe vielmehr sofort den Rechtsanwalt des Angeklagten verständigt und in dessen Beisein, in mühseliger Wochenendarbeit ein Verzeichnis der Schwarten erstellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "f1c6e9a2-acb2-32b1-bf65-b80f87d33084",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "das mit Rinde bedeckte erste und letzte Brett beim Zersägen eines Baumstamms"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43c38198-9086-45fe-9372-2ea97717b6f3",
                                                "sense_id": "f1c6e9a2-acb2-32b1-bf65-b80f87d33084",
                                                "text": "Schwarten sind von schlechter Qualität und werden häufig als Brennholz verwendet."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "b68204e4-dc75-3eb3-bd19-f6fcd5a8847a",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "eine Erscheinungsform von Eisenerz"
                                        ],
                                        "tags": [
                                            "Mineralogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "477db769-8125-4724-b49f-91204c7447a4",
                                                "sense_id": "b68204e4-dc75-3eb3-bd19-f6fcd5a8847a",
                                                "text": "Eisenerz kann als Schwarte auftreten."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "4cea45b0-ecfe-3884-baba-916b57bcb952",
                                        "entry_id": "c5ff31dc-4732-3f6b-b882-f257a67cda6b",
                                        "glosses": [
                                            "großflächige, derb verwachsene innere Narben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18f9e6c9-ba71-452b-b144-c40a0a984bea",
                                                "sense_id": "4cea45b0-ecfe-3884-baba-916b57bcb952",
                                                "text": "Nach einem Herzinfarkt sterben die Myokardzellen ab und bilden eine Schwarte."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
