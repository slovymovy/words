                                                "text": "Одесса — крупнейший порт Украины."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "78851146-9849-3a67-bb03-d435d0832819",
                                        "entry_id": "aaadf9f7-892d-3e1d-b288-346de867e2cc",
