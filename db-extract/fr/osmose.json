                                        "entry_id": "0553338f-e088-31fd-88a8-b8d297c31a76",
                                        "glosses": [
                                            "Passive absorption or impartation of information, habits, etc.; the process of teaching or learning particular knowledge incidentally rather than consciously."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e99a6e31-30e7-4acf-bca8-be1b6a2ef72d",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "Near-synonym: serendipity"
                                            },
                                            {
                                                "example_id": "b7cda480-a1ba-4508-ab02-3c1afaa102ff",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "I was reading about chickens, and I guess I learned about hawks through osmosis."
                                            },
                                            {
                                                "example_id": "34f4559a-27d9-48c1-9655-a6f77b2d23fd",
                                                "sense_id": "7966c586-31a6-3a70-8344-224d6c55fd34",
                                                "text": "At age fourteen, by a process of osmosis, of dirty jokes, whispered secrets and filthy ballads, Tristram learned of sex."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
