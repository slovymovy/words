                    {
                        "translation_id": "aca94088-5ffd-4d3f-a6c4-7601b94cdc71",
                        "source_entry_id": "c0375aeb-8de5-3a81-bee2-b61c26ce93d4",
                        "target_lang_word": "maquette",
