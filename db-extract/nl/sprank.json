                ],
                "senses": [
                    {
                        "sense_id": "1f750f61-b094-3980-abd9-5e8a3d53bb27",
                        "entry_id": "515760fb-7549-39eb-89bd-bddac99e92ef",
                        "glosses": [
                            "een klein beginnetje"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f9c7b16-940b-4b98-8c30-e79eccd19d12",
                                "sense_id": "1f750f61-b094-3980-abd9-5e8a3d53bb27",
                                "text": "Wat zo vreemd was, was dat ze bij die vrolijke muziek heel ernstig keek. Geen sprankje plezier. En dit contrast met de vrolijke draaiorgelmuziek vond ik beangstigend."
                            },
                            {
                                "example_id": "4a07832d-9d42-4b9b-921f-44b9ab3330a7",
                                "sense_id": "1f750f61-b094-3980-abd9-5e8a3d53bb27",
                                "text": "Of reageerde ik misschien op het geprefabriceerde van de dagen in deze wereld, op de vastgelegde routines die we hadden en die alles zo voorspelbaar maakten dat we in vermaak moesten investeren om een sprankje intensiteit te voelen?"
                            },
                            {
                                "example_id": "46c33407-686f-4afc-963a-3c9f0102f91a",
                                "sense_id": "1f750f61-b094-3980-abd9-5e8a3d53bb27",
                                "text": "Nicht Coosje Boudier vertelt, dat in Den Haag meisjes met Duitse officieren in de Rotonde zitten te borrelen. Hebben ze dan geen sprank eergevoel, en trots en schaamte"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0fe80f63-f5ad-4cbd-8be7-8c685727a563",
                        "source_entry_id": "515760fb-7549-39eb-89bd-bddac99e92ef",
                        "source_sense_id": "1f750f61-b094-3980-abd9-5e8a3d53bb27",
                        "source_sense_description": "een klein beginnetje",
                        "target_lang_word": "spark",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6359187-0074-378c-80af-987b4570636a",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A small particle of glowing matter, either molten or on fire, resulting from an electrical surge or excessive heat created by friction."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1bbdc321-92a2-3f4e-9780-44ce6d6bb207",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A short or small burst of electrical discharge."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2440d339-2e57-36fa-a3e5-bddf4cf33fbc",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A small, shining body, or transient light; a sparkle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A small amount of something, such as an idea or romantic affection, that has the potential to become something greater, just as a spark can start a fire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6c810805-e1c9-44a8-8c5f-2a1cc24140dd",
                                                "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                                                "text": "if any spark of life be yet remaining"
                                            },
                                            {
                                                "example_id": "a7e9cbd0-f804-48d5-851a-a08c0e04cb99",
                                                "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                                                "text": ", Book IV, Chapter XVII\nBut though we have, here and there, a little of this clear light, some sparks of bright knowledge"
                                            },
                                            {
                                                "example_id": "8282cc8a-52a5-4d4c-bb68-870ca21bc62a",
                                                "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                                                "text": "When the latter disk showed some sparks, Moman contacted MGM's Jim Vienneau, who picked up the waxing for national release."
                                            },
                                            {
                                                "example_id": "d3cc8e76-9274-4fb2-a346-7f685dd4db55",
                                                "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                                                "text": "Everton's Marouane Fellaini looks one certain arrival but Moyes, who also saw United held to a draw by Chelsea at Old Trafford on Monday, needs even more of a spark in a midfield that looked laboured by this team's standards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec4ac971-dc3e-3aa6-a695-3f418c7dc166",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "Any of various lycaenid butterflies of the Indomalayan genus Sinthusa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1997696-e0ad-36e6-80d2-80a2f5205453",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A ship's radio operator."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0a83a72b-abf5-3e7a-8e8a-e7b5af8fea6c",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "An electrician."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec29165f-d5a2-4e1e-adb0-5575fbab8318",
                                                "sense_id": "0a83a72b-abf5-3e7a-8e8a-e7b5af8fea6c",
                                                "text": "At the other extreme, with limitless budgets all they have to do is dream up amazing lighting rigs to be constructed and operated by the huge team of gaffers and sparks, with their generators, discharge lights, flags, gobos and brutes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b68bdbf7-7561-3123-a6f0-dde9492eb713",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A small collection of cells which briefly appears at the edge of a larger pattern before dying off."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f329592f-7569-364d-8712-18bd1ec7192f",
                                        "entry_id": "bf4d2002-8552-32c8-bc41-56aad4d0cd7c",
                                        "glosses": [
                                            "A diamond, especially one set in a piece of jewellery."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "spark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cac7750e-2b97-3a78-af26-42834f788d3d",
                                        "entry_id": "52a9f6ad-b517-32ca-89ff-1e6bdde87b8c",
                                        "glosses": [
                                            "To trigger, kindle into activity (an argument, etc)."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9d29879-0ba4-4292-aae2-abacc5dbc807",
                                                "sense_id": "cac7750e-2b97-3a78-af26-42834f788d3d",
                                                "text": "The introduction of substitute Andy Carroll sparked Liverpool into life and he pulled a goal back just after the hour - and thought he had equalised as Kenny Dalglish's side laid siege to Chelsea's goal in the closing stages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f26e9616-8291-34a6-aa89-4d31636decef",
                                        "entry_id": "52a9f6ad-b517-32ca-89ff-1e6bdde87b8c",
                                        "glosses": [
                                            "To light; to kindle."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bca68f16-e27d-448b-a0f1-82ce2ae26ef0",
                                                "sense_id": "f26e9616-8291-34a6-aa89-4d31636decef",
                                                "text": "Byron sparked the cigarette. He sucked it dramatically and thrust it into Marko's hand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7cf8a14d-0f18-3c7b-96ca-f6cf020bfbfe",
                                        "entry_id": "52a9f6ad-b517-32ca-89ff-1e6bdde87b8c",
                                        "glosses": [
                                            "To give off a spark or sparks."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "900c57d8-1984-3a3f-96e3-29250afb343d",
                                        "entry_id": "52a9f6ad-b517-32ca-89ff-1e6bdde87b8c",
                                        "glosses": [
                                            "To shoot; to fire"
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3ea228-9556-43dd-a1c0-4ef4ce2ae641",
                                                "sense_id": "900c57d8-1984-3a3f-96e3-29250afb343d",
                                                "text": "[Streetlife]:Fuck a peace talk, let the gun spark, on the streets of New York."
                                            },
                                            {
                                                "example_id": "559a2b69-9a93-4281-98e0-ee14caa617d2",
                                                "sense_id": "900c57d8-1984-3a3f-96e3-29250afb343d",
                                                "text": "All of a sudden, everybody tuggin', everybody dark. Everybody gums runnin', 'til the guns spark."
                                            },
                                            {
                                                "example_id": "9819001e-2bf5-4c10-8aa8-5d784ed89470",
                                                "sense_id": "900c57d8-1984-3a3f-96e3-29250afb343d",
                                                "text": "Guns spark in the dark, it was all just a part of the eighties Bronx scene that created all."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "spark",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "749cb309-1f9d-3d50-807f-63312b2caaf0",
                                        "entry_id": "14b75465-e7e8-3f6d-bba4-637773d65b76",
                                        "glosses": [
                                            "A gallant; a foppish young man."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91d07fe3-edc7-4ccb-ae75-e032074eebb3",
                                                "sense_id": "749cb309-1f9d-3d50-807f-63312b2caaf0",
                                                "text": "The finest sparks and cleanest beaux."
                                            },
                                            {
                                                "example_id": "a27e68e0-5c98-4876-8b54-ce915127333d",
                                                "sense_id": "749cb309-1f9d-3d50-807f-63312b2caaf0",
                                                "text": "Jones had no sooner quitted the room, than the petty-fogger, in a whispering tone, asked Mrs Whitefield, “If she knew who that fine spark was?”"
                                            },
                                            {
                                                "example_id": "297cc3e4-ef8d-4a6e-87eb-568e2e5fe5c5",
                                                "sense_id": "749cb309-1f9d-3d50-807f-63312b2caaf0",
                                                "text": "He will retrieve his errors yet—their worthy Father, once my honour'd master, was at his years nearly as wild a spark."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a564fe2-8246-3952-b760-e4a30565323e",
                                        "entry_id": "14b75465-e7e8-3f6d-bba4-637773d65b76",
                                        "glosses": [
                                            "A beau, lover."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
