                "senses": [
                    {
                        "sense_id": "3716395c-09d9-3d23-9565-ba4afe567d1f",
                        "entry_id": "5eb7508f-4afc-34cd-98ff-dee325518856",
                        "glosses": [
                            "Mitglied einer männlichen Showtanz-Gruppe („Chippendales“), die insbesondere für Striptease bekannt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7ef132e3-5baa-4f80-b3c3-8d25d72cdda4",
                                "sense_id": "3716395c-09d9-3d23-9565-ba4afe567d1f",
                                "text": "„Bevor ich ein Chippendale wurde, habe ich einen Gesundheitsladen eröffnet.“"
                            },
                            {
                                "example_id": "56df76d5-c94c-4adc-b965-9a0e42a5ed42",
                                "sense_id": "3716395c-09d9-3d23-9565-ba4afe567d1f",
                                "text": "„Jeder glaubt, ein Chippendale strippe für seine Freundin oder so.“"
                            },
                            {
                                "example_id": "8ac4384d-d4ec-4d37-95c3-ed73bfbb6d07",
                                "sense_id": "3716395c-09d9-3d23-9565-ba4afe567d1f",
                                "text": "„Er selbst legte die Musik auf, und zwischendrin machten zwei Go-Go-Girls den Stangentanz, und ein Chippendale heizte die Meute mit einem Striptease vom Feinsten noch weiter auf.“"
                            },
                            {
                                "example_id": "8a4db8c1-c907-4e2c-947e-7d753576361b",
                                "sense_id": "3716395c-09d9-3d23-9565-ba4afe567d1f",
                                "text": "„Bei Bauer Gerhardt (Armin Wolff), der Gegenentwurf eines Chippendale, finden die Damen eine geruhsame Unterkunft für die Nacht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
