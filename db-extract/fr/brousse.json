                        "entry_id": "5d0dd146-2f83-33a3-bf67-9c0a41232bae",
                        "glosses": [
                            "Formation végétale constituée d’arbrisseaux et d’arbustes dans les pays tropicaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38fb73a1-e9d3-460a-ad18-a9581e1535ef",
                                "sense_id": "d82ba7ba-e42d-3dae-9531-ee22981e5df2",
                                "text": "Une maigre brousse arborescente hérisse les parties basses du terrain — bouquets de daschi et de candili garnis de plus d'épines que de feuilles."
                            }
                        ]
                    },
                    {
                        "sense_id": "7e34d434-3a1d-37db-9f8e-1ef821c1fa1a",
                        "entry_id": "5d0dd146-2f83-33a3-bf67-9c0a41232bae",
                        "glosses": [
                            "Pays couvert de broussailles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27b34fa2-93d4-439e-a0b2-5a83e25767e2",
                                "sense_id": "7e34d434-3a1d-37db-9f8e-1ef821c1fa1a",
                                "text": "Les rebelles se sont réfugiés dans la brousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "87a61383-fdee-3db9-9b84-58edc1f1d00d",
                        "entry_id": "5d0dd146-2f83-33a3-bf67-9c0a41232bae",
                        "glosses": [
                            "Lieu retiré, éloigné de tout."
                        ],
                        "tags": [
                            "analogy"
                        ],
                        "examples": [
                            {
                                "example_id": "8f7d5592-2f0f-475b-b027-93965275cbb1",
                                "sense_id": "87a61383-fdee-3db9-9b84-58edc1f1d00d",
                                "text": "Ils habitent dans la brousse."
                            },
                            {
                                "example_id": "9f238e33-4d12-43af-9ae2-73fb24b01b5d",
                                "sense_id": "87a61383-fdee-3db9-9b84-58edc1f1d00d",
                                "text": "Il avait entendu parler de la présence de cette épave dans le lac grâce à des témoignages de pilotes de brousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "52599f42-2584-3fdd-829d-23bd3ba4c270",
                        "entry_id": "5d0dd146-2f83-33a3-bf67-9c0a41232bae",
                        "glosses": [
                            "Espace non urbanisé."
                        ],
                        "tags": [
                            "Afrique"
                        ],
                        "examples": [
                            {
                                "example_id": "b250c67d-6605-4774-85d9-897e92fc6931",
                                "sense_id": "52599f42-2584-3fdd-829d-23bd3ba4c270",
                                "text": "Le convoi quittait les lumières de la ville pour s’enfoncer dans la brousse."
                            }
                        ]
                    },
                    {
                        "sense_id": "1ec488d3-a590-3b3c-b903-a26e865f875b",
                        "entry_id": "5d0dd146-2f83-33a3-bf67-9c0a41232bae",
                        "glosses": [
