                ],
                "senses": [
                    {
                        "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                        "entry_id": "ae4e51d6-1367-3ffc-831d-fbd7e5600e8c",
                        "glosses": [
                            "Person, die in einer bestimmten Tätigkeit bereits erfahren, geschickt oder versiert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc128020-2975-4b4a-8665-6c1430976080",
                                "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                                "text": "„Die Geübten unter uns können natürlich die gesamte Strecke im Tiefschnee laufen.“"
                            },
                            {
                                "example_id": "788e01a4-6db2-44a6-9768-b772d2ca7d76",
                                "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                                "text": "„Ob du zu den weniger Geübten und Untrainierten gehörst oder deine sportlichen Ziele aktiv verfolgen möchtest – bei der BSG sind alle richtig.“"
                            },
                            {
                                "example_id": "affb9650-21b6-4708-b7c0-7ca869271a8c",
                                "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                                "text": "„Als bereits Geübter hast du in dieser Klasse die Möglichkeit [sic!] deine Praxis mit entsprechend modifizierten Asana zu intensivieren.“"
                            },
                            {
                                "example_id": "21b71630-3384-47d6-9829-92db48226b88",
                                "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                                "text": "„Zwischen sechs und acht Kilogramm schwer, konnte ein Geübter ihn mit mehr als dreißig Kilometern pro Stunde werfen, und wo solch ein Geschoss einschlug, wuchs kein Gras mehr.“"
                            },
                            {
                                "example_id": "b1b10f65-4de1-44c0-bcc1-e9f8400d1981",
                                "sense_id": "0f10546a-9794-334c-9e8c-5c06fa0dfc7a",
                                "text": "„Die Zubereitung der Rezepte wird auch weniger Geübten leicht gelingen, denn schwierige Arbeitsschritte werden in Wort und Bild step-by-step erklärt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
