{
    "word_family": [
        "ping"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "24caed4e-3407-34c5-9c89-0457b6443f3a",
                    "sense_definition": "A sudden sharp feeling of an emotional or mental nature, such as guilt, regret, or joy.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "emotional_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>pang</w> of guilt when she realized she had forgotten her best friend's birthday.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапный <w>укол</w> совести, когда поняла, что забыла про день рождения лучшей подруги."
                            }
                        },
                        {
                            "text": "He experienced a sharp <w>pang</w> of regret as he watched the train pull away from the station.",
                            "target_lang_translations": {
                                "ru": "Он ощутил острый <w>приступ</w> сожаления, глядя, как поезд отходит от станции."
                            }
                        }
                    ],
                    "synonyms": [
                        "twinge",
                        "stab"
                    ],
                    "common_phrases": [
                        "pang of guilt",
                        "pang of regret",
                        "pang of jealousy"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное острое чувство эмоционального или психического характера, такое как вина, сожаление или радость."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "укол",
                                "target_lang_sense_clarification": "внезапное неприятное чувство"
                            },
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "внезапное проявление эмоции"
                            },
                            {
                                "target_lang_word": "угрызение",
                                "target_lang_sense_clarification": "обычно о совести или вине"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "85c7ca22-774b-3bd4-8e71-a23cc6a72702",
                    "sense_definition": "A sudden, brief, and intense feeling of physical pain or agony.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A fierce <w>pang</w> of pain shot through his leg as he tried to stand up after the fall.",
                            "target_lang_translations": {
                                "ru": "Сильный <w>приступ</w> боли пронзил его ногу, когда он попытался встать после падения."
                            }
                        },
                        {
                            "text": "The patient described the sensation as a sharp <w>pang</w> of hunger that occurred every few hours.",
                            "target_lang_translations": {
                                "ru": "Пациент описал это ощущение как острый <w>приступ</w> голода, возникающий каждые несколько часов."
                            }
                        }
                    ],
                    "synonyms": [
                        "twinge",
                        "throe",
                        "stab"
                    ],
                    "common_phrases": [
                        "pangs of hunger",
                        "pangs of death",
                        "sharp pang"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внезапное, кратковременное и интенсивное ощущение физической боли или мучения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приступ",
                                "target_lang_sense_clarification": "внезапная острая боль"
                            },
                            {
                                "target_lang_word": "резь",
                                "target_lang_sense_clarification": "острая, режущая боль"
                            },
                            {
                                "target_lang_word": "спазм",
                                "target_lang_sense_clarification": "внезапное сокращение, вызывающее боль"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "3d2b1b7d-cc58-3f29-964d-420defca41c0",
                    "sense_definition": "To cause someone to experience great physical or mental pain; to torment or torture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "causing_pain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It <w>panged</w> him deeply to say goodbye to his family before leaving for the long journey.",
                            "target_lang_translations": {
                                "ru": "Его глубоко <w>мучило</w> прощание с семьей перед отъездом в долгое путешествие."
                            }
                        },
                        {
                            "text": "The memory of his failure continued to <w>pang</w> his conscience for many years.",
                            "target_lang_translations": {
                                "ru": "Воспоминание о неудаче продолжало <w>терзать</w> его совесть долгие годы."
                            }
                        }
                    ],
                    "synonyms": [
                        "torment",
                        "torture",
                        "afflict",
                        "rack"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb use is rare in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Причинять кому-либо сильную физическую или душевную боль; мучить или терзать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мучить",
                                "target_lang_sense_clarification": "причинять страдания"
                            },
                            {
                                "target_lang_word": "терзать",
                                "target_lang_sense_clarification": "сильно мучить, разрывать душу"
                            },
                            {
                                "target_lang_word": "уязвлять",
                                "target_lang_sense_clarification": "ранить чувства"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14f13190-18b9-3337-b84d-9bc4d74c8280",
                    "sense_definition": "A past tense form of <w>ping</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sonar <w>panged</w> loudly as it detected an object deep beneath the surface of the water.",
                            "target_lang_translations": {
                                "ru": "Сонар громко <w>запищал</w>, обнаружив объект глубоко под поверхностью воды."
                            }
                        },
                        {
                            "text": "The microwave <w>panged</w> to signal that the food was finally ready to be served.",
                            "target_lang_translations": {
                                "ru": "Микроволновка <w>дзынькнула</w>, подав сигнал о том, что еда наконец готова к подаче."
                            }
