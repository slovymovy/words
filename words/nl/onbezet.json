                {
                    "sense_id": "4f797805-fb50-3e0f-bb46-bcb378dceb7e",
                    "sense_definition": "Niet door iemand in gebruik of ingenomen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "niet_in_gebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gelukkig was er nog een tafel <w>onbezet</w> in het drukke restaurant.",
                            "target_lang_translations": {
                                "en": "Fortunately, there was still a table <w>unoccupied</w> in the busy restaurant."
                            }
                        },
                        {
                            "text": "De meeste stoelen in de wachtkamer bleven die ochtend <w>onbezet</w>.",
                            "target_lang_translations": {
                                "en": "Most chairs in the waiting room remained <w>unoccupied</w> that morning."
                            }
