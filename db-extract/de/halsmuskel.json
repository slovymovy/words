                            {
                                "example_id": "847d8437-93a2-4d1e-a351-d1af27ccf2a1",
                                "sense_id": "fa31562c-4df6-3869-8c31-916f9c2a7989",
                                "text": "„Der Gestank trifft einen mit solcher Wucht, dass sich die Halsmuskeln zusammenziehen.“"
                            },
                            {
                                "example_id": "9932f844-b8a6-4577-b28c-0f870b99ddf8",
                                "sense_id": "fa31562c-4df6-3869-8c31-916f9c2a7989",
                                "text": "„Andrews fühlte etwas Bitteres in seiner Kehle aufsteigen; der Magen verkrampfte sich plötzlich, und die Halsmuskeln zogen sich zusammen, nahmen ihm fast die Luft.“"
                            }
                        ],
