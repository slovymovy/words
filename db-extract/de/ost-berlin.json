                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d735f5e5-1a05-48ae-a10b-15e65cbadec8",
                                "sense_id": "1ff68dd8-072e-3da8-a058-557467e549d9",
                                "text": "„West-Berlins Radsport-Präsident Jörg-Peter Schulze äußerte sogleich seinen Wunsch, in der Werner-Seelenbinder-Halle in Ost-Berlin im Winter trainieren zu können.“"
                            },
                            {
                                "example_id": "5832c650-f1da-463f-ac8d-1354b27ee3fb",
                                "sense_id": "1ff68dd8-072e-3da8-a058-557467e549d9",
                                "text": "„Mit dem Grundlagenvertrag wollten Bonn und Ost-Berlin die Voraussetzungen für die Entwicklung ‚gutnachbarlicher‘ Beziehungen schaffen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
