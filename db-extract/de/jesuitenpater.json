                ],
                "senses": [
                    {
                        "sense_id": "0ef5aae0-c0cf-3f3f-a043-367c1bd456fe",
                        "entry_id": "c469bb02-f30c-391a-9c67-2a14a818760e",
                        "glosses": [
                            "ein Pater (also ein Geweihter), der dem Jesuitenorden angehört"
                        ],
                        "tags": [
                            "Katholizismus"
                        ],
                        "examples": [
                            {
                                "example_id": "7dd6363d-a710-4980-9dca-8f9e598535f4",
                                "sense_id": "0ef5aae0-c0cf-3f3f-a043-367c1bd456fe",
                                "text": "„Filippo Bonanni (* 7. Januar 1638 in Rom; † 30. März 1725 ebenda) war ein Jesuitenpater, Mikroskopbauer und Naturforscher.“"
                            },
                            {
                                "example_id": "aef997f3-7c1d-45eb-b7ca-fff83235f6cd",
                                "sense_id": "0ef5aae0-c0cf-3f3f-a043-367c1bd456fe",
                                "text": "„Johannes Arnoldi (* 24. Juni 1596 in Warburg; † 9. November 1631 in Visselhövede) war ein deutscher Jesuitenpater und Märtyrer.“"
                            },
                            {
                                "example_id": "46248e69-abbd-4007-8e76-29987a6d6a31",
                                "sense_id": "0ef5aae0-c0cf-3f3f-a043-367c1bd456fe",
                                "text": "„Becher selbst erwähnt noch ältere Vertreter der Kryptographie oder Geheimschrift, darunter den berühmten Polyhistor und Jesuitenpater Athanasius Kircher, ferner die Kabbalisten […], den hochgelehrten Abt Trithemius […] und andere mehr.“"
                            },
                            {
                                "example_id": "eeccd3c3-5765-4869-942c-05b4403e5eeb",
                                "sense_id": "0ef5aae0-c0cf-3f3f-a043-367c1bd456fe",
                                "text": "„Der rheinische Jesuitenpater Friedrich Spee ist zu dieser Zeit Seelsorger eines Kölner Frauenordens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
