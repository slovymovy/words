                "senses": [
                    {
                        "sense_id": "f5de7ff6-346e-3484-b282-67e2784ab9a7",
                        "entry_id": "3e18075d-4d15-30b0-a2c2-eb732f47a5b9",
                        "glosses": [
                            "letzter Buchstabe eines Wortes, Textabschnitts oder Textes"
                        ],
                        "tags": [
                            "Schriftlinguistik"
                        ],
                        "examples": [
                            {
                                "example_id": "8c9da242-bbfc-4743-9e05-10cbbedb42c0",
                                "sense_id": "f5de7ff6-346e-3484-b282-67e2784ab9a7",
                                "text": "„So wird der Lexembestand aufgeschlüsselt nach den Wortarten und grammatischen Kategorien, nach den ersten drei Anfangs- beziehungsweise Endbuchstaben, …“"
                            },
                            {
                                "example_id": "5d4f58ad-1761-4b01-a0e9-39c419cfdf35",
                                "sense_id": "f5de7ff6-346e-3484-b282-67e2784ab9a7",
                                "text": "Die rückläufigen Wörterbücher sind nach den Endbuchstaben der Wörter alphabetisch geordnet."
                            },
                            {
                                "example_id": "b837e0b4-08b3-4113-b64c-0fa50545f848",
                                "sense_id": "f5de7ff6-346e-3484-b282-67e2784ab9a7",
                                "text": "Der Buchstabe »ß« kann als Endbuchstabe vorkommen, aber nicht als Anfangsbuchstabe."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
