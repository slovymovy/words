                "senses": [
                    {
                        "sense_id": "f7554084-e27f-3913-a1ca-504b16e999c7",
                        "entry_id": "0b15cad9-d9e2-35f6-a84b-14202efac580",
                        "glosses": [
                            "Combinaison linéaire des puissances d’une ou plusieurs indéterminées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c71dd73-bc5b-4778-bb66-91f7686acc48",
                                "sense_id": "f7554084-e27f-3913-a1ca-504b16e999c7",
                                "text": "Racines d’un polynôme."
                            },
                            {
                                "example_id": "1ee73df5-b079-40c6-9c62-ca7fa4d95df7",
                                "sense_id": "f7554084-e27f-3913-a1ca-504b16e999c7",
                                "text": "Polynôme caractéristique."
                            },
                            {
                                "example_id": "ae0b55d8-9156-451d-964a-9193b337c9b5",
                                "sense_id": "f7554084-e27f-3913-a1ca-504b16e999c7",
                                "text": "Son équipe met notamment en cause l'utilisation d'un \"polynôme de degré 12 \", une équation permettant de \"nettoyer\" un signal de détection, mais au risque de le corrompre si le degré est trop élevé."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6676153f-2bdd-4f65-ab0a-c3fc9b5e38b7",
                        "source_entry_id": "0b15cad9-d9e2-35f6-a84b-14202efac580",
                        "source_sense_id": "f7554084-e27f-3913-a1ca-504b16e999c7",
                        "target_lang_word": "Polynom",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Polynom",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "73b793f3-9403-37ab-9520-d33a85a3d63f",
                                        "entry_id": "1ecff7dd-5ee9-3a5d-9c16-951d04d88570",
                                        "glosses": [
                                            "Ausdruck, der aus zwei oder mehr Gliedern (genauer Monomen) besteht, die jeweils ein Produkt aus einem Koeffizienten und Potenzen von Variablen sind und durch Addition oder Subtraktion miteinander verkettet sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89ffb96f-4d36-422f-9ac2-ffd2b58a018c",
                                                "sense_id": "73b793f3-9403-37ab-9520-d33a85a3d63f",
                                                "text": "Das Polynom x²+1 ist vom Grad zwei."
                                            },
                                            {
                                                "example_id": "6ab19861-8b39-42f2-bf60-0cec93e4efb7",
                                                "sense_id": "73b793f3-9403-37ab-9520-d33a85a3d63f",
                                                "text": "„Polynome ungeraden Grades mit reellen Koeffizienten haben immer mindestens eine reelle Nullstelle.“"
                                            },
                                            {
                                                "example_id": "14dc8b33-75cc-4531-befd-edfefaf533b9",
                                                "sense_id": "73b793f3-9403-37ab-9520-d33a85a3d63f",
                                                "text": "„Ein Polynom heißt homogen, falls sämtliche Monome, aus denen das Polynom besteht, den gleichen Grad haben.“",
                                                "translation": "[*] „In der Algebra ist ein Monom ein Polynom, das nur aus einem Glied besteht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "686757db-356a-48b2-8e65-8513d00ca0d3",
                        "source_entry_id": "0b15cad9-d9e2-35f6-a84b-14202efac580",
