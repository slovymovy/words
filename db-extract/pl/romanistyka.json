                "senses": [
                    {
                        "sense_id": "96d06db2-75ca-321b-9563-f664c9917936",
                        "entry_id": "1d021aa9-842b-37f1-81b8-0b0651fb1b61",
                        "glosses": [
                            "Romance studies"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "a58078c8-5b14-4138-8261-806bad92b548",
                                "sense_id": "96d06db2-75ca-321b-9563-f664c9917936",
                                "text": "doktor/profesor romanistyki",
                                "translation": "doctor/professor of Romance studies",
                                "english": "doctor/professor of Romance studies"
                            },
                            {
                                "example_id": "aabf4740-5dc8-411e-a62a-a88f4f0fd2c0",
                                "sense_id": "96d06db2-75ca-321b-9563-f664c9917936",
                                "text": "Autor tej pracy, profesor uniwersytetu w Grazu i nader ceniony badacz na polu romanistyki, zastanawia się najpierw wogóle nad przyczynami mieszanin językowych.",
                                "translation": "The author of this work, a professor at the University of Graz and a highly regarded researcher in the field of Romance studies, first considers the causes of language mixing in general.",
                                "english": "The author of this work, a professor at the University of Graz and a highly regarded researcher in the field of Romance studies, first considers the causes of language mixing in general."
                            },
                            {
                                "example_id": "c0d72166-68ad-4406-b8c9-21d98c749909",
                                "sense_id": "96d06db2-75ca-321b-9563-f664c9917936",
                                "text": "Istnieje romanistyka, czyli filologja romańska, obejmująca nietylko stronę lingwistyczną, ale także etnografję, literaturę, historję i t. d. narodów romańskich, a więc łącząca w jedną całość portugalczyków, hiszpanów, francuzów z prowensalami, włochów z retoromanami i furlanami, rumunów i t. d.",
                                "translation": "There is Romance studies, or Romance philology, which covers not only linguistics, but also ethnography, literature, history, etc. of the Romance peoples, thus bringing together the Portuguese, Spanish, French with the Provençals, Italians with the Rhaeto-Romans and Friulians, Romanians, etc.",
                                "english": "There is Romance studies, or Romance philology, which covers not only linguistics, but also ethnography, literature, history, etc. of the Romance peoples, thus bringing together the Portuguese, Spanish, French with the Provençals, Italians with the Rhaeto-Romans and Friulians, Romanians, etc."
                            }
                        ]
                    }
