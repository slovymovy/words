                        "glosses": [
                            "Membre d’un peuple humain vivant en Afrique de l’Ouest, particulièrement au Yorubaland au Nigéria."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "9e87b1cb-6028-49ec-997a-4bb118339066",
                                "sense_id": "6ef856f7-0dc5-35ee-a437-53eeb5fb3e5c",
                                "text": "Les Yoroubas ont un dicton, Iku ya j’esin lo, qui se traduit littéralement par « la mort plutôt que l’indignité »."
                            }
                        ]
