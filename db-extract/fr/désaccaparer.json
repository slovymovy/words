                ],
                "senses": [
                    {
                        "sense_id": "29768a5a-7711-3cd0-bbef-c47ed1a05979",
                        "entry_id": "086866d9-9736-390d-b66c-050e062d47e0",
                        "glosses": [
                            "Ne plus accaparer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743989a9-b198-4a47-95ba-9515ab26ea4b",
                                "sense_id": "29768a5a-7711-3cd0-bbef-c47ed1a05979",
                                "text": "Le long des murs, les plus longs pourtant de la chrétienté, nous dit-on, dans chaque niche de la coupole, et jusqu’à la voûte du lanternon, tout est comble sous le regard ; nul espace n’est laissé vacant où les yeux puissent évoluer à leur aise, désaccaparés, oublier l’art et se reposer."
                            },
                            {
                                "example_id": "7b9e119a-7c7d-4d48-a144-139a809ed338",
                                "sense_id": "29768a5a-7711-3cd0-bbef-c47ed1a05979",
                                "text": "Désaccaparé, le conducteur me virgule un regard critique dans son rétro."
                            },
                            {
                                "example_id": "16117a97-af07-4ed5-b3e8-a82c2ddc8aab",
                                "sense_id": "29768a5a-7711-3cd0-bbef-c47ed1a05979",
                                "text": "Nous-mêmes qui, comme Abraham, sommes appelés à nous déposséder, à nous «désaccaparer» de nos enfants, ce qu’exprimait très bien le texte de Khalil Gibran, tout à l’heure."
                            }
                        ]
                    }
                ],
