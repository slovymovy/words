                    {
                        "translation_id": "baf0b55c-de4a-4a75-9af1-38a56082fb15",
                        "source_entry_id": "ccdddad0-5edc-325a-93ed-64d91882da41",
                        "source_sense_id": "66ae7338-c435-32ab-a857-a36b415db067",
                        "source_sense_description": "(law) The status of being constitutional",
