        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "34785a59-9b38-3c36-a714-cd354dec0112",
                    "sense_definition": "Сравнительная степень прилагательного <w>высокий</w>; имеющий бо́льшую высоту или рост.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "comp_high",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мой старший брат уже <w>выше</w> отца.",
                            "target_lang_translations": {
                                "en": "My older brother is already <w>taller</w> than father.",
                                "zh": "我哥哥已经比父亲<w>高</w>了。",
                                "it": "Mio fratello maggiore è già <w>più alto</w> di mio padre."
                            }
                        },
                        {
                            "text": "Это новое здание значительно <w>выше</w> соседних домов.",
                            "target_lang_translations": {
                                "en": "This new building is significantly <w>higher</w> than the neighboring houses.",
                                "zh": "这栋新建筑比周围的房子<w>高</w>得多。",
                                "it": "Questo nuovo edificio è notevolmente <w>più alto</w> delle case vicine."
                            }
                        }
                    ],
                    "antonyms": [
                        "ниже"
                    ],
                    "common_phrases": [
                        "стать выше",
                        "значительно выше",
                        "намного выше"
                    ],
                    "target_lang_definitions": {
                        "en": "Comparative form of \"high\" or \"tall\"; having greater height or stature.",
                        "zh": "形容词“高”的比较级；指高度或身高更大。",
                        "it": "Forma comparativa di \"alto\"; che ha una maggiore altezza o statura."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "taller",
                                "target_lang_sense_clarification": "used for people, trees, and vertical objects"
                            },
                            {
                                "target_lang_word": "higher",
                                "target_lang_sense_clarification": "used for buildings, mountains, and general height"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "更高",
                                "target_lang_sense_clarification": "用于建筑物、山脉等一般高度"
                            },
                            {
                                "target_lang_word": "更高",
                                "target_lang_sense_clarification": "用于人、树木等垂直物体"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "più alto",
                                "target_lang_sense_clarification": "usato per persone, edifici e oggetti verticali"
                            }
                        ]
                    }
                }
            ]
        },
