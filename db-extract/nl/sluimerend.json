                "senses": [
                    {
                        "sense_id": "c6be354b-d61c-3b91-8d26-220757181505",
                        "entry_id": "45c905ab-cb54-392a-bd18-7372bffa9af9",
                        "glosses": [
                            "niet openbaar, (nog) niet manifest, (nog) verborgen"
                        ],
                        "tags": [
                            "nog"
                        ],
                        "examples": [
                            {
                                "example_id": "d22881f3-5cc2-4058-aff2-069558c1cfb2",
                                "sense_id": "c6be354b-d61c-3b91-8d26-220757181505",
                                "text": "Anne Fontaine vertelt dit verhaal zonder overdadig effectbejag. Zij behandelt alle obstakels - taalproblemen (de verpleegster spreekt geen woord Pools), het taboe over de zwangerschap van de nonnen en het sluimerend antisemitisme - keurig stuk voor stuk. Haar film maakt een te brave indruk, wat gezien de materie een merkwaardige keuze is."
                            },
                            {
                                "example_id": "345207ef-82de-4c05-9a32-0584df2252e6",
                                "sense_id": "c6be354b-d61c-3b91-8d26-220757181505",
                                "text": ",,Gemiddeld heeft 20 tot 25 procent een sluimerend gevoel om eens te vertrekken. Maar mensen voelden zich lang beducht om de stap te zetten. Nu hebben ze meer vertrouwen in de economie.”"
                            }
                        ]
                    }
