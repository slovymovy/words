                "translations": [
                    {
                        "translation_id": "c4e4fe1f-da51-4412-9a84-6cd50bc87003",
                        "source_entry_id": "b8061da3-395f-347c-97d9-8b22f3eadbc3",
                        "source_sense_id": "e9d62fc6-595b-3781-b10c-56923de839d8",
                        "source_sense_description": "iemand die zich toelegt op het bedrijven van sport",
                        "target_lang_word": "Sportler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sportler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb7e2ecb-3291-3276-94b4-7d37479cba6e",
                                        "entry_id": "5589f37c-26cb-3e74-b0cc-5746714f9db3",
                                        "glosses": [
                                            "Person, die regelmäßig eine oder mehrere Sportarten betreibt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1057dd9c-7e12-48eb-9a99-89c2c006b8bd",
                                                "sense_id": "eb7e2ecb-3291-3276-94b4-7d37479cba6e",
                                                "text": "Er ist einer der besten Sportler des Teams."
                                            },
                                            {
                                                "example_id": "16570dcb-bb50-4ac4-a042-7bf2e42733e2",
                                                "sense_id": "eb7e2ecb-3291-3276-94b4-7d37479cba6e",
                                                "text": "„Bei dem als Bodyflying bezeichneten Sport begibt sich der Sportler, mit Helm, Brille, Mundschutz, Handschuhen und vor allem einem speziellen Anzug ausgestattet, in einen Luftstrom, der durch ein Gitter hindurch senkrecht in die Höhe strebt.“"
                                            },
                                            {
                                                "example_id": "c63d9fc7-53ae-42e2-97b5-b807677c5c9b",
                                                "sense_id": "eb7e2ecb-3291-3276-94b4-7d37479cba6e",
                                                "text": "„Die Sportler kommen trotzdem, 3961 an der Zahl, aus 49 Ländern, mehr als je zuvor.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "63d4113b-1c30-4f57-82a2-4e159001999d",
                        "source_entry_id": "b8061da3-395f-347c-97d9-8b22f3eadbc3",
                        "source_sense_id": "e9d62fc6-595b-3781-b10c-56923de839d8",
                        "source_sense_description": "iemand die zich toelegt op het bedrijven van sport",
                        "target_lang_word": "sportsman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sportsman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fbb20ea3-a7f7-381c-aaff-3f41beed2bb1",
                                        "entry_id": "a190b89b-7ef3-34b9-9c8d-fdaded00ba74",
                                        "glosses": [
                                            "A man who engages in sports; an athlete."
                                        ],
                                        "tags": [
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0cb1ff1-55d9-4fe8-a745-54a204c31f64",
                                                "sense_id": "fbb20ea3-a7f7-381c-aaff-3f41beed2bb1",
                                                "text": "On the contrary, the difference between the worse male and female sportsmen was 54 ms. Among the male sportsmen [...]. Among the female sportsmen [...]"
                                            },
                                            {
                                                "example_id": "b2162556-6a50-456f-9aa3-c337d6788348",
                                                "sense_id": "fbb20ea3-a7f7-381c-aaff-3f41beed2bb1",
                                                "text": "In both cases the female sportsmen were Nordic skiers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "929d7bee-b969-3391-bb43-2e6091f4a799",
                                        "entry_id": "a190b89b-7ef3-34b9-9c8d-fdaded00ba74",
                                        "glosses": [
                                            "A man who engages in country sports, such as hunting or fishing."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b78bc805-ac8a-4392-9c82-69c9a244eb28",
                                                "sense_id": "929d7bee-b969-3391-bb43-2e6091f4a799",
                                                "text": "At last extinguishing the fire, he took the idol up very unceremoniously, and bagged it again in his grego pocket as carelessly as if he were a sportsman bagging a dead woodcock."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e91878a-3712-3e5a-ab43-0d312fd20d7d",
                                        "entry_id": "a190b89b-7ef3-34b9-9c8d-fdaded00ba74",
                                        "glosses": [
                                            "A man who exhibits good sportsmanship, or who exhibits sportsmanship as specified (good or bad)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d4867d16-5eed-4289-acb6-905eeecc86fa",
                        "source_entry_id": "b8061da3-395f-347c-97d9-8b22f3eadbc3",
                        "source_sense_id": "e9d62fc6-595b-3781-b10c-56923de839d8",
                        "source_sense_description": "iemand die zich toelegt op het bedrijven van sport",
                        "target_lang_word": "sportif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sportif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui se rapporte ou est propre au sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe047e3b-4d28-4ad6-80a4-3bd0ef8f8dcd",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "Le gouvernement s’emploiera en outre, avec des partenaires, à accroitre les activités sportives aux niveaux communautaire et compétitif."
                                            },
                                            {
                                                "example_id": "90bbbd81-d028-4fce-a142-4084d0c4b3ec",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "Ces derniers ont montré que le temps de jeu sur le terrain était, lui aussi, fonction de variables extra-sportives en plus de variables sportives."
                                            },
                                            {
                                                "example_id": "07f0f6d4-b92e-499c-9168-111ac71796fc",
                                                "sense_id": "87b79386-14e7-3dd2-a075-d6b4a2da9915",
                                                "text": "[…], mais elles n'existaient plus l’échoppe du cordonnier que traversaient les émissions sportives et la boulangerie où la mère de Josette pesait le pain."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1866d6df-0125-31aa-a6ec-32ed64578a4d",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui pratique un sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3c1a51e-63f2-4221-b3a4-ca72110b997a",
                                                "sense_id": "1866d6df-0125-31aa-a6ec-32ed64578a4d",
                                                "text": "Elle est très sportive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a17a2f-f0b0-3b97-9151-68dadce5596c",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui atteste de sportivité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6dab4bf2-37f9-4b71-b97a-9a9e74afb730",
                                                "sense_id": "63a17a2f-f0b0-3b97-9151-68dadce5596c",
                                                "text": "Il court à une allure sportive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f4e45333-d990-33de-99eb-7a393cb15f82",
                                        "entry_id": "c8917ed2-e5f9-31a6-9dc4-9fcbf648113f",
                                        "glosses": [
                                            "Qui correspond à l'esprit du sport."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa7a59f9-131e-4de8-b708-0f1afc35abde",
                                                "sense_id": "f4e45333-d990-33de-99eb-7a393cb15f82",
                                                "text": "Le public britannique est connu pour n’être pas très sportif."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sportif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e2a85e7f-4038-3964-a475-f2ca4425bb4f",
                                        "entry_id": "aae60818-ed5d-37a4-936a-9c885bb5d5b3",
