                                        "sense_id": "d28fa7a1-f183-3627-b4ec-1b09e28c2eaf",
                                        "entry_id": "2ad33939-e149-383e-a115-fdae65256c7d",
                                        "glosses": [
                                            "To walk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "583982f4-4369-4442-8535-ab3bfaa2ab40",
                                                "sense_id": "d28fa7a1-f183-3627-b4ec-1b09e28c2eaf",
                                                "text": "thieves do foot by night"
                                            }
                                        ]
                                    },
