                                    },
                                    {
                                        "sense_id": "600d1ee5-280b-3b50-9661-fbd63762847e",
                                        "entry_id": "366fe2af-e6da-3800-99ee-bd14bbb1ed02",
                                        "glosses": [
                                            "Phänomen, das eine Anziehung ausübt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c38c4979-87e5-4d37-bb75-0d1530e85079",
                                                "sense_id": "600d1ee5-280b-3b50-9661-fbd63762847e",
                                                "text": "„Ich fühle, wie aus der anderen Richtung an ihr gezerrt wird, und manchmal hat der Tod mehr Zugkraft als das Leben.“"
                                            }
                                        ],
