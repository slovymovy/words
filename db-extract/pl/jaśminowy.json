                                        "entry_id": "03f02269-0412-3cdf-bff1-e6dd72efa498",
                                        "glosses": [
                                            "относящийся к жасмину, свойственный или принадлежащий жасмину"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07266d76-a6ed-4ebe-9eaf-b4436f8fb71c",
                                                "sense_id": "9be54b38-58fc-37f4-8be7-b14024b0d582",
                                                "text": "В общем, жасминовый чай не мил с голодухи."
                                            },
                                            {
                                                "example_id": "c8a66334-a878-4362-9bf2-17ebfdc07de9",
                                                "sense_id": "9be54b38-58fc-37f4-8be7-b14024b0d582",
                                                "text": "Ныряю за большой жасминовый куст, сижу тихонечко, дабы себя не обнаружить."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
