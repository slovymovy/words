                ],
                "senses": [
                    {
                        "sense_id": "d48f4393-6754-337b-af95-28541adea343",
                        "entry_id": "a07a11ba-fc76-3095-9794-7860d3bec3bd",
                        "glosses": [
                            "Qui est de plusieurs couleurs ou fait avec des matières de diverses couleurs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b948a460-fe8d-4544-a617-da8594d78bb7",
                                "sense_id": "d48f4393-6754-337b-af95-28541adea343",
                                "text": "À l'intérieur, quatre colonnes corinthiennes et les colonnettes cannelées du chancel supportent le jubé de bois, orné de panneaux en bas-relief polychrome."
                            },
                            {
                                "example_id": "251a244f-1c32-41ec-9e4d-b67850f70787",
                                "sense_id": "d48f4393-6754-337b-af95-28541adea343",
                                "text": "COULEUR incolore, violet, pourpre, vert, jaune, orangé, rose, rose-orangé (« Padparadscha »), noir (étoilé), parfois polychrome ou dichroïque"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4af84b42-46f9-46da-960a-f66de6d98a59",
                        "source_entry_id": "a07a11ba-fc76-3095-9794-7860d3bec3bd",
                        "source_sense_id": "d48f4393-6754-337b-af95-28541adea343",
                        "target_lang_word": "mehrfarbig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
