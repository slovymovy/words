                        "entry_id": "3546b428-7b75-3852-8978-9ca9cf5e355a",
                        "glosses": [
                            "Capacité d’un composé chimique à induire des modifications physiques ou fonctionnelles dans un génome."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "684d0781-ce47-4e22-8d40-e300ce798c0d",
                                "sense_id": "6cf20b07-a707-36a2-848f-55e65a12d1f5",
                                "text": "C’est cette corrélation qui sert de fondement à l’utilisation des marqueurs biologiques de génotoxicité comme indicateur du risque de cancer chez l’humain."
                            },
                            {
                                "example_id": "ca18f531-babf-4803-af76-367a8e4b5cd5",
                                "sense_id": "6cf20b07-a707-36a2-848f-55e65a12d1f5",
                                "text": "On l’oppose à la génotoxicité directe des substances qui peuvent entrer directement en interaction avec l’ADN sans passer par une transformation chimique via le métabolisme de détoxication d’une cellule."
                            }
                        ]
                    }
