                                        "sense_id": "b4a9a434-5a02-3b50-a39e-6fa87aa90637",
                                        "entry_id": "8ea7d82b-f990-34f3-92ca-915992213b91",
                                        "glosses": [
                                            "A person suffering from rheumatism"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5ba99c50-67a7-450e-a9ed-663edc06137e",
                                                "sense_id": "b4a9a434-5a02-3b50-a39e-6fa87aa90637",
                                                "text": "It has been a clinical observation with me that the majority of chronic rheumatics are likewise the subjects of chronic constipation."
                                            },
                                            {
                                                "example_id": "0ae7c42c-8cee-4617-bcf3-e837e6997828",
                                                "sense_id": "b4a9a434-5a02-3b50-a39e-6fa87aa90637",
                                                "text": "It must, be confessed, however, that the majority of rheumatics are not able to stand such treatment."
                                            },
                                            {
                                                "example_id": "2b75bd2d-cccb-47e6-bd3c-8892ef50eb2c",
                                                "sense_id": "b4a9a434-5a02-3b50-a39e-6fa87aa90637",
                                                "text": "The rheumatics in the survey who had complete disability had had this same disability for an average of two years."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
