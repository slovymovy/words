                                        "entry_id": "60b801c5-4f8e-3765-b848-5147228651b8",
                                        "glosses": [
                                            "A gene from one species introduced into the genome of another by transgenesis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa85bcec-b344-4cfd-aea6-67897236a9cc",
                                                "sense_id": "7b009978-45aa-3ff9-b836-530429c93d86",
                                                "text": "It has created a biotechnology centred on genetic engineering that has introduced transgenes, transmitted through natural interspecies crosses, which, in turn, have allowed emergence of resistant superweeds and superpests, which, in their turn, demand the application of further chemical poisons […]"
                                            }
                                        ]
                                    }
