                "senses": [
                    {
                        "sense_id": "0a9e00f7-a193-3d9c-b292-f216d6c14440",
                        "entry_id": "2d6b7128-a8bb-3366-a63d-a850e91975c0",
                        "glosses": [
                            "to guard, to watch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "798a13f7-64ce-438d-a00e-cf09277e35d2",
                                "sense_id": "0a9e00f7-a193-3d9c-b292-f216d6c14440",
                                "text": "Невольника стерегли семеро турок (люди простые и в душе такие же разбойники, как и Кирджали); они уважали его и с жадностию, общею всему Востоку, слушали его чудные рассказы.",
                                "translation": "The prisoner was guarded by seven Turks (common people, and in their hearts as much brigands as Kirdjali himself); they respected him and, like all Orientals, listened with avidity to his strange stories.",
                                "english": "The prisoner was guarded by seven Turks (common people, and in their hearts as much brigands as Kirdjali himself); they respected him and, like all Orientals, listened with avidity to his strange stories."
                            }
                        ]
                    }
