                "senses": [
                    {
                        "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                        "entry_id": "d196bb4c-6c29-3389-a80e-83458ef0cb1f",
                        "glosses": [
                            "Laufen (im Freien) bei frostigen Temperaturen"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "6c0c73e7-82df-44c7-ba6a-f0a3cdc26fd0",
                                "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                                "text": "„Lang wird es aber nicht mehr dauern bis zum ersten richtigen Frostlauf.“"
                            },
                            {
                                "example_id": "2e38d787-6c6d-4a73-9d4d-fdf3dea028d9",
                                "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                                "text": "„Du hättest beim Frostlauf deinen Bommelwollmützen-BH tragen sollen.“"
                            },
                            {
                                "example_id": "6776ef91-89d3-447b-9e85-778fd2564916",
                                "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                                "text": "„Und, wie war der Frostlauf heute?“"
                            },
                            {
                                "example_id": "54c76f5d-5ea0-4eba-b478-5d87dc869e47",
                                "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                                "text": "„Der Tag nach dem Frostlauf brachte noch einmal drei Umläufe bei der Kirche.“"
                            },
                            {
                                "example_id": "727b7139-0e0a-49c5-914c-0183a36e94ca",
                                "sense_id": "1b35f58e-aa56-3636-9cb5-060b48de4df8",
                                "text": "„Bei mir war es ähnlich. Letzte Woche Samstag hatte ich beim Laufen in kurz mit der Wärme zu kämpfen, gestern waren lange Hose und Mütze angesagt. Dafür aber für mich schönes Laufwetter (Graupelschauer). Schöner Frostlauf mit schönen Bildern und ebensolchen Restsonntag. 🙂“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
