                ],
                "senses": [
                    {
                        "sense_id": "b09dc567-acfe-344c-a2c2-eeb52a4d9503",
                        "entry_id": "8562eb49-b7f7-399b-8813-a2817f51d75a",
                        "glosses": [
                            "umgangssprachlich:"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                        "entry_id": "8562eb49-b7f7-399b-8813-a2817f51d75a",
                        "glosses": [
                            "auf eine aus dem Kontext ersichtliche Eigenschaft hinweisend"
                        ],
                        "tags": [
                            "Demonstrativpronomen"
                        ],
                        "examples": [
                            {
                                "example_id": "edff6adf-2122-4085-93bf-284293c2761f",
                                "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                                "text": "Mit sonem Gehabe kommst du bei mir nicht weiter."
                            },
                            {
                                "example_id": "97910a40-22bc-48e8-8013-c1a09ce9b21d",
                                "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                                "text": "„Was kann ich dafür, daß du in som Haus wohnst?“"
                            },
                            {
                                "example_id": "96e60c77-2334-44bf-8f8f-49dc1b3ebc56",
                                "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                                "text": "„Sind sie etwa auch son Typ, der jeden Arbeiter mit Grips als faul bezeichnet, wenn er sich nicht schleunigst aus der Arbeiterklasse rausqualifiziert?“"
                            },
                            {
                                "example_id": "89fe344a-165f-4ea3-9e49-ee071994a44c",
                                "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                                "text": "„Denn hat man so’nem Mädchen mal was in den Kopf gesetzt, da mag der Vater und der Großvater, der Teufel und seine Großmutter dran rütteln, ihr zieht’s ihr nicht wieder aus dem Kopf heraus, oder aus dem Herzen.“"
                            },
                            {
                                "example_id": "c94950c0-5645-46de-b1b3-b3b2cb930a91",
                                "sense_id": "00537571-8db7-3629-a520-a38aabc2e985",
                                "text": "„‚Sone Leute thun kein gut, wenn man sie gut hält, die verdirbt man dadurch,‘ ist der gewöhnliche Ausruf solcher Hausteufel, die es gar zu gerne vergessen mögten, daß kein Verdienst, sondern allein der blinde Zufall sie von der Nothwendigkeit befreyt hat selbst Magd zu seyn.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "c72a7da4-49bc-3537-980e-0f481de1b368",
                        "entry_id": "8562eb49-b7f7-399b-8813-a2817f51d75a",
                        "glosses": [
                            "auf ein besonderes Ausmaß hinweisend"
                        ],
                        "tags": [
                            "Demonstrativpronomen"
                        ],
                        "examples": [
                            {
                                "example_id": "d38f8931-e67c-490e-baba-97d39b5fea89",
                                "sense_id": "c72a7da4-49bc-3537-980e-0f481de1b368",
                                "text": "Ich hab sone Lust dazu."
                            },
                            {
                                "example_id": "12305b49-eca0-4560-9cfa-c7ea67fce981",
                                "sense_id": "c72a7da4-49bc-3537-980e-0f481de1b368",
                                "text": "„Recht vielen Dank, aber damit kann ich nicht viel anfangen, weil ich nicht sone Ahnung habe.“"
                            },
                            {
                                "example_id": "3ac90206-928b-43ab-946e-dcbab90f0e8c",
                                "sense_id": "c72a7da4-49bc-3537-980e-0f481de1b368",
                                "text": "ruhrdeutsch: „Hömma, dat gab Zeiten, da hatt ich schon sone Krawatte, wenn nur dat Telefon rappelte.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "1624a238-62c0-3e00-ac47-55b051c46640",
                        "entry_id": "8562eb49-b7f7-399b-8813-a2817f51d75a",
                        "glosses": [
                            "unbestimmter Artikel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32cf55fa-7614-49f5-9bc4-8e84533a38be",
                                "sense_id": "1624a238-62c0-3e00-ac47-55b051c46640",
                                "text": "„Ich hab grad n Bild von soner Ische mitm Tattoo gesehen.“"
                            },
                            {
                                "example_id": "de4d998a-932b-4362-b988-9ad5d54fc5ab",
                                "sense_id": "1624a238-62c0-3e00-ac47-55b051c46640",
                                "text": "„Aber du mußt doch mal sone Lust verspüren, son Ziehen im Bauch. Ich meine, kennste das nich? Du sitzt irgendwo und plötzlich haste son Verlangen nachm Orgasmus, und du kannst an nichts anderes mehr denken?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "98aed432-ff66-4e6b-bf3a-4473fa0502ab",
                        "source_entry_id": "8562eb49-b7f7-399b-8813-a2817f51d75a",
                        "source_sense_id": "b09dc567-acfe-344c-a2c2-eeb52a4d9503",
                        "source_sense_description": "auf eine aus dem Kontext ersichtliche Eigenschaft oder auf ein besonderes Ausmaß hinweisend",
                        "target_lang_word": "such",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "such",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                        "entry_id": "df9772ed-b242-338b-bf95-bf983fb8f192",
                                        "glosses": [
                                            "Like this, that, these, those; used to make a comparison with something implied by context."
                                        ],
                                        "tags": [
                                            "demonstrative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dcf6e006-85c3-4d26-bffd-4c97267f2052",
                                                "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                                "text": "I’ve never seen such clouds in the sky before."
                                            },
                                            {
                                                "example_id": "901911e6-fd83-4799-a322-a1571d137e87",
                                                "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                                "text": "Really? Unfortunately, my mind refuses to bring any such memory forward."
                                            },
                                            {
                                                "example_id": "44d0c95f-ba3d-48ab-81a4-49df97bd2cb7",
                                                "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                                "text": "I had occasion […] to make a somewhat long business trip to Chicago, and on my return […] I found Farrar awaiting me in the railway station. He smiled his wonted fraction by way of greeting, […], and finally leading me to his buggy, turned and drove out of town. I was completely mystified at such an unusual proceeding."
                                            },
                                            {
                                                "example_id": "286ddec2-8780-4877-a9c9-34a0fa2216fa",
                                                "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                                "text": "She was a fat, round little woman, richly apparelled in velvet and lace, […]; and the way she laughed, cackling like a hen, the way she talked to the waiters and the maid,[…]—all these unexpected phenomena impelled one to hysterical mirth, and made one class her with such immortally ludicrous types as Ally Sloper, the Widow Twankey, or Miss Moucher."
                                            },
                                            {
                                                "example_id": "3de23488-3d51-491c-a9a0-2a75dd7247ce",
                                                "sense_id": "de3cb75e-508d-3d7d-83ba-a29c2f9fd1da",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea358b5d-ea38-37b2-9f22-304ecd24b29e",
                                        "entry_id": "df9772ed-b242-338b-bf95-bf983fb8f192",
                                        "glosses": [
                                            "Any."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d146e43e-3b12-44fb-94e0-77c762ffd01b",
                                                "sense_id": "ea358b5d-ea38-37b2-9f22-304ecd24b29e",
                                                "text": "the above address or at such other address as may be provided"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                        "entry_id": "df9772ed-b242-338b-bf95-bf983fb8f192",
                                        "glosses": [
                                            "Used as an intensifier roughly equivalent to very much (of), quite or rather."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40a304bc-317b-4d68-9aa0-ac948b6308aa",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "Unfortunately, it wasn't such a good holiday as we thought it would."
                                            },
                                            {
                                                "example_id": "f416cc60-dc21-4152-ae2e-5e7a2443890a",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "The party was such a bore. \"Bottomless\" is such a lie."
                                            },
                                            {
                                                "example_id": "0ef07193-9f04-48e8-9f42-f26f104f72b1",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "You're all such kind people!"
                                            },
                                            {
                                                "example_id": "07955c8b-7212-43e5-a505-5d8315171ca0",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "They burned the old gun that used to stand in the dark corner up in the garret, close to the stuffed fox that always grinned so fiercely. Perhaps the reason why he seemed in such a ghastly rage was that he did not come by his death fairly. Otherwise his pelt would not have been so perfect. And why else was he put away up there out of sight?—and so magnificent a brush as he had too.[…]."
                                            },
                                            {
                                                "example_id": "75ac9b10-2fa0-46b0-94ec-39707af02a6d",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "Mr. Cooke at once began a tirade against the residents of Asquith for permitting a sandy and generally disgraceful condition of the roads. So roundly did he vituperate the inn management in particular, and with such a loud flow of words, that I trembled lest he should be heard on the veranda."
                                            },
                                            {
                                                "example_id": "61619561-38cf-4dc4-a7b9-4c0e8dd1ec0c",
                                                "sense_id": "34c47f84-3dce-3a05-a11e-968b2c74d804",
                                                "text": "Charles had not been employed above six months at Darracott Place, but he was not such a whopstraw as to make the least noise in the performance of his duties when his lordship was out of humour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23c76e34-aeba-3e3a-be7b-8aee4ec4d39d",
                                        "entry_id": "df9772ed-b242-338b-bf95-bf983fb8f192",
                                        "glosses": [
                                            "Used as an intensifier roughly equivalent to very much (of), quite or rather.",
                                            "Used with gradable noun phrases to form exclamations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e48d18bf-e875-4cf7-878e-a7d8b9f2a189",
                                                "sense_id": "23c76e34-aeba-3e3a-be7b-8aee4ec4d39d",
                                                "text": "Such hypocrisy!"
                                            },
                                            {
                                                "example_id": "25247c0d-156a-4168-bfa5-7ece5b3cf26f",
                                                "sense_id": "23c76e34-aeba-3e3a-be7b-8aee4ec4d39d",
                                                "text": "Such bouncy children you have."
                                            },
                                            {
                                                "example_id": "30d8231b-0cf1-4a9e-b9c9-60085bc7a5dd",
                                                "sense_id": "23c76e34-aeba-3e3a-be7b-8aee4ec4d39d",
                                                "text": "Why, I was absolutely spellbound. She sings with such passion!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c154b73e-9ce7-30fb-981d-506a86a7605c",
                                        "entry_id": "df9772ed-b242-338b-bf95-bf983fb8f192",
                                        "glosses": [
                                            "A certain; representing the object as already particularized in terms which are not mentioned."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52c0b051-9f52-41ce-9315-636dfaa585c0",
                                                "sense_id": "c154b73e-9ce7-30fb-981d-506a86a7605c",
                                                "text": "In rushed one and tells him such a knight / Is new arrived."
                                            },
                                            {
                                                "example_id": "7dae1bbc-1b4b-44f0-9146-73f8386bb996",
                                                "sense_id": "c154b73e-9ce7-30fb-981d-506a86a7605c",
                                                "text": "To-day or to-morrow we will go into such a city, and continue there a year."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "such",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                        "entry_id": "bde1bcca-cdc0-3d3a-90aa-4b8b48b99ebb",
                                        "glosses": [
                                            "A person, a thing, people, or things like the one or ones already mentioned."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d97ccea5-dd8c-4322-b205-9e878da862b3",
                                                "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                                "text": "'Twas early June, the new grass was flourishing everywheres, the posies in the yard—peonies and such—in full bloom, the sun was shining, and the water of the bay was blue, with light green streaks where the shoal showed."
                                            },
                                            {
                                                "example_id": "f9744667-00cc-49ff-839d-5d971376c37a",
                                                "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                                "text": "Such is life, such as it is."
                                            },
                                            {
                                                "example_id": "14e88213-ae00-45b2-8917-ba42b69748a7",
                                                "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                                "text": "When applied to women, 'handsome' is used mostly of such as are middle-aged or elderly."
                                            },
                                            {
                                                "example_id": "aa6212c8-1c7a-4397-b3c9-b0120b0f8b5b",
                                                "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                                "text": "These oraculous proficients are day and night employed in deep searches for the direction of such as run astray after their lost goods : but at present they are more particularly serviceable to their country in foretelling the fate of such as have chances in the public lottery."
                                            },
                                            {
                                                "example_id": "f3cfead6-6122-4bd1-bb66-dcc3ff0e7358",
                                                "sense_id": "f5ca972e-b68f-36d1-b078-96d901b5d40c",
                                                "text": "Some are just no-good locals—drunks and such—who’d just as soon beg or steal as work."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "such",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "53da6bb0-7967-3549-9fac-ce484681761e",
                                        "entry_id": "18c77d68-0d7f-3d5a-bb0e-c5dc9c21a974",
                                        "glosses": [
                                            "Something being indicated that is similar to something else."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "981ba741-ec9c-4eab-904a-292ddf01d1f9",
                                                "sense_id": "53da6bb0-7967-3549-9fac-ce484681761e",
                                                "text": "But granted that Plato does not accept the this-such distinction, why saddle him with the view that all things are thises, rather than all suches or perhaps even neither?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
