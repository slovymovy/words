                                "target_lang_word": "understand",
                                "target_lang_sense_clarification": "to empathize with someone's feelings"
                            },
                            {
                                "target_lang_word": "relate to",
                                "target_lang_sense_clarification": "to feel a connection or empathy with someone's situation"
                            }
