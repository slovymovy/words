                "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                "word": "homespun",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "af039a64-cc0e-4956-aeb4-e40d5484649e",
                        "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                        "tags": [
                            "plural"
                        ],
                        "form": "homespuns"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1f24d84a-fd09-31c8-93f0-fb50236140bf",
                        "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                        "glosses": [
                            "Fabric made from homespun yarn. Also, machine made fabrics (usually cottons) similar to homespun fabrics in that solids, plaids, or stripes are created by weaving dyed threads (rather than printing), so that both sides of the fabric look the same."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bd8866bf-993e-453e-a81f-9fa4a29f6292",
                                "sense_id": "1f24d84a-fd09-31c8-93f0-fb50236140bf",
                                "text": "There are four men, heavily bearded and more than a little dirty, and two young women, all of them busy with shovels in or around an opened grave and all dressed identically in shirts and trousers of tattered homespun."
                            }
                        ]
                    },
                    {
                        "sense_id": "50900db8-ae19-3d3e-a288-61d29a0282c1",
                        "entry_id": "726f09c4-7cb4-3ac7-9923-15208a2b7654",
                        "glosses": [
                            "An unpolished, rustic person."
                        ],
                        "tags": [
                            "countable",
                            "obsolete",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "46bafb28-05d0-4063-9929-7636e74eeea4",
                                "sense_id": "50900db8-ae19-3d3e-a288-61d29a0282c1",
                                "text": "What hempen home-ſpuns haue we ſwaggering here, / So neere the Cradle of the Faierie Queene?"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
