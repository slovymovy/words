                ],
                "senses": [
                    {
                        "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                        "entry_id": "3b76aa9d-9cce-3145-baf4-0d0a030233c4",
                        "glosses": [
                            "im Pazifischen Ozean gelegene Insel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34f4ae31-7e29-40c5-9ded-bf6bd8eb5763",
                                "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                                "text": "„Die Pazifikinsel Bougainville, ein ehemaliges deutsches Kolonialgebiet, hat sich für die Unabhängigkeit entschieden.“"
                            },
                            {
                                "example_id": "24a435fc-10e5-4358-927e-19e7b2a5d69a",
                                "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                                "text": "„Auslöser des Tsunamis war ein Seebeben der Stärke 8,0 zwischen den Pazifik-Inseln Bougainville und New Georgia.“"
                            },
                            {
                                "example_id": "8e54ada4-1d47-40c4-8bb4-8e28b7bd8ff6",
                                "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                                "text": "„In den dreißiger Jahren des vergangenen Jahrhunderts schickte der Leiter des Pariser Musée de l‚Homme den maristischen Missionar und Ethnologen Patrick O‘Reilly auf die Insel Bougainville, um völkerkundliche Studien zu betreiben.“"
                            },
                            {
                                "example_id": "5a4253ae-3206-4106-9b10-5b2c782e0cc1",
                                "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                                "text": "„Die Spuren eines Kontakts fanden sich bisher nur bei heutigen Einwohnern von Papua-Neuguinea und der Insel Bougainville: Sie teilen Erbinformationen mit den Denisova-Funden.“"
                            },
                            {
                                "example_id": "da4d106b-1bf1-4253-93ed-3837a91abee5",
                                "sense_id": "d4fa7fcb-9752-335d-924e-a03742dd2ccc",
                                "text": "„Gerade im vergangenen Dezember haben 98 Prozent der Einwohner von Bougainville für die Unabhängigkeit gestimmt, die ihnen laut einem Abkommen nun nach und nach zugestanden werden soll.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
