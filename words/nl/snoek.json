    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81988972-4e9d-385d-bd86-e8d79b01304d",
                    "sense_definition": "Een roofvis die in zoet water leeft, wetenschappelijk bekend als Esox lucius.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vis",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>snoek</w> is een bekende roofvis in Nederlandse sloten.",
                            "target_lang_translations": {
                                "en": "The <w>northern pike</w> is a well-known predatory fish in Dutch ditches.",
                                "ru": "<w>Щука</w> — известная хищная рыба в нидерландских каналах."
                            }
                        },
                        {
                            "text": "Vissers vangen vaak een grote <w>snoek</w> in dit meer.",
                            "target_lang_translations": {
                                "en": "Fishermen often catch a large <w>pike</w> in this lake.",
                                "ru": "Рыбаки часто вылавливают крупную <w>щуку</w> в этом озере."
                            }
                        }
                    ],
                    "common_phrases": [
                        "grote snoek",
                        "gewone snoek"
                    ],
                    "target_lang_definitions": {
                        "en": "A predatory fish that lives in fresh water, scientifically known as Esox lucius.",
                        "ru": "Хищная пресноводная рыба, известная в науке как Esox lucius."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "northern pike",
                                "target_lang_sense_clarification": "The common name for the freshwater predatory fish Esox lucius."
                            },
                            {
                                "target_lang_word": "pike",
                                "target_lang_sense_clarification": "General term for this type of predatory freshwater fish."
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "щука",
                                "target_lang_sense_clarification": "обыкновенная щука (хищная пресноводная рыба)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ebf68d3-6dc0-37cb-a205-8cd25df4dac3",
                    "sense_definition": "Een acrobatische houding waarbij de bovenpersoon horizontaal op de handen of voeten van de onderpersoon ligt.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "acrobatiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De acrobaat voert een perfecte <w>snoek</w> uit tijdens de voorstelling.",
