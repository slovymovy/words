                "senses": [
                    {
                        "sense_id": "11eff74b-d9a2-36cc-a989-b6894cabb05f",
                        "entry_id": "c17cb58b-2724-3040-8a7a-d93be4daa810",
                        "glosses": [
                            "Überproduktion von Rindfleisch, das nicht mehr auf dem Markt abgesetzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6bda7a1-1543-4e58-9db4-48e848b3e90b",
                                "sense_id": "11eff74b-d9a2-36cc-a989-b6894cabb05f",
                                "text": "„Zu Beginn der neunziger Jahre türmten sich immer höhere Rindfleischberge auf, die aufgekauft und eingefroren wurden.“"
                            },
                            {
                                "example_id": "6531358a-8109-4766-b634-52e6038187da",
                                "sense_id": "11eff74b-d9a2-36cc-a989-b6894cabb05f",
                                "text": "„Die EU entsorgt ihren durch den BSE-Skandal angewachsenen Rindfleischberg mit einer Subventionierung von 3250 Mark pro Tonne auf den Märkten Botswanas, Simbabwes oder Namibias.“"
                            },
                            {
                                "example_id": "4aece7e9-7232-4d29-a0f2-ae93170b47ee",
                                "sense_id": "11eff74b-d9a2-36cc-a989-b6894cabb05f",
                                "text": "„Auch in den darauf folgenden Jahren bis 2008 ist weiter mit einem Rindfleischberg von 250000 Tonnen zu rechnen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
