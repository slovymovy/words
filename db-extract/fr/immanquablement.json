        "fr-extract.jsonl": [
            {
                "entry_id": "4f85196d-16f2-3a96-a270-27366925eebe",
                "word": "immanquablement",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                        "entry_id": "4f85196d-16f2-3a96-a270-27366925eebe",
                        "glosses": [
                            "D’une manière immanquable ; inévitablement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a05bd1c-2a5f-4c3a-a03d-2a0d3fca9667",
                                "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                                "text": "La charité nous porte immanquablement à faire quelque chose pour Dieu."
                            },
                            {
                                "example_id": "db0a372f-2bad-4264-b18f-cef489a0fa4a",
                                "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                                "text": "Si l'entaille se creusait plus avant sous la dent du ressac, elle les eût immanquablement entraînés à la dérive!"
                            },
                            {
                                "example_id": "5c9add58-1e4e-4ce6-a83b-73a93b8ac1b8",
                                "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                                "text": "Il me quitte ; il doit acheter du jambon et du vinaigre, car les officiers l'ont naturellement chargé de leur cuisine, comme ils en chargent immanquablement tout professeur, tout prêtre, tout poète."
                            },
                            {
                                "example_id": "5ba997e3-54fe-4482-a095-d69f1851946b",
                                "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                                "text": "À l'antisémitisme politique s'associe immanquablement l'antisémitisme religieux : le chauvinisme exploite le fanatisme et le fanatisme se fait le paravent du chauvinisme."
                            },
                            {
                                "example_id": "299a6771-e1af-4364-9784-9800915045ff",
                                "sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                                "text": "Le roi et les privilégiés auraient voulu que les états délibérassent comme en 1614, c'est-à-dire « par ordre ». Les privilégiés auraient eu immanquablement la majorité et les états auraient été incapables d'opérer aucune réforme sérieuse."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "853e2f91-1e89-46d0-9b1e-5c889d7cb695",
                        "source_entry_id": "4f85196d-16f2-3a96-a270-27366925eebe",
                        "source_sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                        "target_lang_word": "inevitably",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "inevitably",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "In a manner that is impossible to avoid or prevent."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08800aaa-6923-483d-aa77-7be4292fad13",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Inevitably, all creatures eventually die."
                                            },
                                            {
                                                "example_id": "5827a595-83c6-484b-9bc4-c0a5881c1a61",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The sun inevitably rises."
                                            },
                                            {
                                                "example_id": "06bf50fd-b154-4936-9eb2-e3fe5abba149",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "Despite the town's best efforts, the dam inevitably gave way."
                                            },
                                            {
                                                "example_id": "db8f225d-9ab6-4e49-ba19-07d68df88c12",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "The inevitably cold winter approaches."
                                            },
                                            {
                                                "example_id": "409248be-d951-46c3-b7e3-0eca0be61dc0",
                                                "sense_id": "06bfa05c-8336-3459-b526-2f42cdab4246",
                                                "text": "In a period of transition from steam to diesel, many of the schemes are inevitably of an interim nature and only on full dieselisation will the final pattern be determined and full benefit derived."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                        "entry_id": "561f317b-9416-35e8-889e-86305dbb2cd8",
                                        "glosses": [
                                            "As usual; predictably; as expected."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b94f48e5-d72a-4b55-8a4f-83af29ec993e",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Inevitably, the next-door neighbour began to mow his lawn just as she lays down her head after a long night shift."
                                            },
                                            {
                                                "example_id": "0ee46b52-0abd-4d75-a09e-3a3829bb3924",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The child inevitably began to cry when his mother went to work."
                                            },
                                            {
                                                "example_id": "28c305d3-4fc2-4be3-b7f6-117a34258d46",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "The inevitably long line of customers queued for the latest 'Harry Potter'."
                                            },
                                            {
                                                "example_id": "4930ca80-51b7-41c5-8c1a-f41c6cec8d05",
                                                "sense_id": "a5809bc7-8300-399e-a156-d3ac280aa8f0",
                                                "text": "Far from it: direct military intervention by a Western state – even if Prime Minister Nuri al-Maliki is requesting it – would dramatically worsen the situation, and ISIS, contrary to what pro-interventionists might say, would inevitably come out on top."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eabde3d5-6539-474e-ae81-0294d6f99cf2",
                        "source_entry_id": "4f85196d-16f2-3a96-a270-27366925eebe",
                        "source_sense_id": "87f04b9a-84a0-350d-a114-925e3ae1eeb9",
                        "target_lang_word": "without fail",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "without fail",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1251b1f8-27cf-3b30-8a7c-36ede4d8f513",
                                        "entry_id": "b1034a6e-98d8-35b3-83ca-c4dfacb6f9c6",
                                        "glosses": [
                                            "Certainly; by all means; as a matter of importance."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0407e573-90e8-4401-a49f-4c4c7146ddea",
                                                "sense_id": "1251b1f8-27cf-3b30-8a7c-36ede4d8f513",
                                                "text": "You will report to the police every week without fail."
                                            },
                                            {
                                                "example_id": "e45e4e53-9559-4757-afd1-3ebb047859aa",
                                                "sense_id": "1251b1f8-27cf-3b30-8a7c-36ede4d8f513",
                                                "text": "And David enquired at the Lord, saying, Shall I pursue after this troop? shall I overtake them? And he answered him, Pursue: for thou shalt surely overtake them, and without fail recover all."
                                            },
                                            {
                                                "example_id": "1017ab49-eec0-4280-9514-c2f5b9baee59",
                                                "sense_id": "1251b1f8-27cf-3b30-8a7c-36ede4d8f513",
                                                "text": "\"Tuesday by all means.\" \"Tuesday, then, without fail.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cef006da-bc31-3a73-a7e9-4d1a4fca5355",
                                        "entry_id": "b1034a6e-98d8-35b3-83ca-c4dfacb6f9c6",
                                        "glosses": [
                                            "Inevitably."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05351f43-aaef-4e06-965c-9d5d71907470",
                        "source_entry_id": "4f85196d-16f2-3a96-a270-27366925eebe",
