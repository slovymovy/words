                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6e5c2d5a-e5b2-32e5-ad35-4b4364db140c",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
