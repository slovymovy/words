                        "cross_references": [
                            {
                                "target_word": "víčko",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                        "entry_id": "aa39fdbe-7582-37ca-9e40-5870733ec807",
                                        "glosses": [
                                            "víko"
                                        ],
                                        "tags": [
                                            "diminutive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb4ef582-e9d8-4d8a-ba76-98cc952125a8",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "Neviděls víčko od hořčice? Muselo se asi někam zakutálet, nebo co."
                                            },
                                            {
                                                "example_id": "14b4ffe9-eb4b-49b9-855f-a6da35a2b455",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "„Víčko“ tomu, čím se zavírá petka, na Moravě nikdo neřekne – jedině „vršek“!"
                                            },
                                            {
                                                "example_id": "b33d537c-5ef6-4954-b12c-83c8347026d2",
                                                "sense_id": "b449597d-728f-3dde-85a7-5136d5a213f7",
                                                "text": "Nařízení Evropské Unie [správně unie, pozn. wiki] v rámci boje proti jednorázovým plastům ukládá povinné používání neodnímatelných víček od 3. července 2024."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d20660b-f9db-3a82-8a28-25de0eec2e1e",
                                        "entry_id": "aa39fdbe-7582-37ca-9e40-5870733ec807",
                                        "glosses": [
                                            "pohyblivý kožní záhyb chránící oko"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b487a14b-93a3-4d73-b087-ececd50aec72",
                                                "sense_id": "9d20660b-f9db-3a82-8a28-25de0eec2e1e",
                                                "text": "Já vidím nakloněné tvoje líčko a v lilijné dřív tváři růžnou vlnu, to skloněné tvé dlouhobrvé víčko, plachý tvůj pohled, tvář těkavostí plnu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
