                ],
                "senses": [
                    {
                        "sense_id": "3bf9afe9-4cce-3214-b50e-8ec45a57fd60",
                        "entry_id": "93c8f061-0d6d-334c-b067-1e5769472540",
                        "glosses": [
                            "etwas, das aufgrund der puren Zahl oder der Handlungsmöglichkeiten weitaus überlegen ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "482dbc37-c444-43f2-b6d5-58e163b46ba8",
                                "sense_id": "3bf9afe9-4cce-3214-b50e-8ec45a57fd60",
                                "text": "„Der Anblick ihrer endlosen, reichlich ausgerüsteten Kolonnen zeigt uns, gegen welch eine hoffnungslose Übermacht an Menschen und Material wir standgehalten haben.“"
                            },
                            {
                                "example_id": "3ccbdaa1-95a5-4a40-b0d9-92acc5d0fb4f",
                                "sense_id": "3bf9afe9-4cce-3214-b50e-8ec45a57fd60",
                                "text": "„Vanderbrecken hatte zwar gekämpft wie ein trojanischer Held, aber die gegnerische Übermacht war zu groß gewesen.“"
                            },
                            {
                                "example_id": "07cb36e9-5067-4dc0-96dd-b609aea48ec0",
                                "sense_id": "3bf9afe9-4cce-3214-b50e-8ec45a57fd60",
                                "text": "„Angesichts der Übermacht von zwölf mit Kanonen bestückten Schiffen gaben die Portugiesen 1605 ihr Fort Victoria auf Ambon, der wichtigsten Insel der Molukken, kampflos auf - der erste Landgewinn der Niederländer.“"
                            },
                            {
                                "example_id": "3b139ace-a298-4bbd-92e0-7a968c2ebbb7",
                                "sense_id": "3bf9afe9-4cce-3214-b50e-8ec45a57fd60",
                                "text": "„Anderswo begegnen Abnehmerstaaten Chinas Übermacht, indem sie stillgelegte Lagerstätten reaktivieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
