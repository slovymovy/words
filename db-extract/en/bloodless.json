                    {
                        "translation_id": "168225b4-2b15-4206-9a6b-32eb08e2499e",
                        "source_entry_id": "a41af70b-41bd-314a-9008-5988598e74c8",
                        "source_sense_description": "taking place without loss of blood",
                        "target_lang_word": "unblutig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unblutig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "08647f00-f64a-33e1-85de-dbb7ab482e44",
                                        "entry_id": "b593a92b-5b89-3ba6-a900-d133866b0e54",
                                        "glosses": [
                                            "ohne Blut zu verlieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819c8738-ce5e-4a0a-83bc-9852c57d2d28",
                                                "sense_id": "08647f00-f64a-33e1-85de-dbb7ab482e44",
                                                "text": "„Im Klinikum Schönebeck wird jetzt eine ganz neue, moderne Operationstechnik angeboten, die unblutig verläuft und einen schnellen Heilungsprozess verspricht.“"
                                            },
                                            {
                                                "example_id": "7e9ac9f0-2b3c-409b-a915-ed56264e5236",
                                                "sense_id": "08647f00-f64a-33e1-85de-dbb7ab482e44",
                                                "text": "„Unsere Injektion ist ein unblutiger Eingriff im gleichen Sympathikusbereich, der aber den Vorteil hat, daß wir ihn jederzeit mit mindestens ebenso großen Erfolgsaussichten wiederholen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8cc98103-20c7-3bf7-8fb7-fe4e762fdf4d",
                                        "entry_id": "b593a92b-5b89-3ba6-a900-d133866b0e54",
                                        "glosses": [
                                            "ohne Verletzungen/Tote"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "242d2d9d-4853-4437-b2c3-93bc9bea41a6",
                                                "sense_id": "8cc98103-20c7-3bf7-8fb7-fe4e762fdf4d",
                                                "text": "„Es wurde der unblutigste Krieg, den Karl der Große jemals geführt hat.“"
                                            },
                                            {
                                                "example_id": "e0e09dd4-aa37-48b5-b78a-f593cf0fa49a",
                                                "sense_id": "8cc98103-20c7-3bf7-8fb7-fe4e762fdf4d",
                                                "text": "Damit hatte die Konfrontation der Widersacher ein unblutiges Ende genommen."
                                            },
                                            {
                                                "example_id": "01c64a2c-1419-44de-a3a9-7ab2724243be",
                                                "sense_id": "8cc98103-20c7-3bf7-8fb7-fe4e762fdf4d",
                                                "text": "„In Portugal ist eine unblutige Form des Stierspiels populär, bei der alle Kämpfer die Arena lebend verlassen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
