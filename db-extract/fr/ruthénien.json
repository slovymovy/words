                        "entry_id": "850e6f2e-a2eb-3cc5-a982-eef565225f8a",
                        "glosses": [
                            "Relatif à Rodez."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "9b794191-d0ef-44a8-910d-d55a5b435912",
                                "sense_id": "433f9efe-6ecd-35a0-a234-916eb0bab336",
                                "text": "À 26 ans, le ruthénien Alexandre Geniez devrait courir cette saison son deuxième tour de France."
                            },
                            {
                                "example_id": "a6b54ca3-ec0c-4f7b-98d4-4aa41cef3661",
                                "sense_id": "433f9efe-6ecd-35a0-a234-916eb0bab336",
                                "text": "Le chartrier était probablement une des pièces maîtresses de l’ensemble médiéval ruthénien, comme c’était alors l’usage dans tous les couvents."
                            }
                        ]
                    }
