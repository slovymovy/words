                },
                {
                    "sense_id": "fc67e5c5-2583-3f6a-bf0d-7596cb5af5d5",
                    "sense_definition": "iemand aanwijzen voor een functie door middel van een stemming",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leden zullen binnenkort een nieuwe voorzitter <w>kiezen</w> voor de vereniging.",
                            "target_lang_translations": {
                                "en": "The members will soon <w>elect</w> a new chairman for the association.",
                                "de": "Die Mitglieder werden bald einen neuen Vorsitzenden für den Verein <w>wählen</w>."
                            }
                        },
                        {
                            "text": "Het volk zal de nieuwe president van het land <w>kiezen</w> in de komende verkiezingen.",
                            "target_lang_translations": {
                                "en": "The people will <w>choose</w> the country's new president in the upcoming elections.",
                                "de": "Das Volk wird den neuen Präsidenten des Landes in den kommenden Wahlen <w>wählen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "verkiezen"
                    ],
                    "common_phrases": [
                        "een voorzitter kiezen",
                        "een vertegenwoordiger kiezen"
                    ],
                    "target_lang_definitions": {
                        "en": "To appoint someone to a position by means of a vote.",
                        "de": "Jemanden durch eine Abstimmung für ein Amt oder eine Funktion bestimmen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "elect",
                                "target_lang_sense_clarification": "to choose by voting"
                            },
                            {
                                "target_lang_word": "choose",
                                "target_lang_sense_clarification": "to select for a role"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "wählen",
                                "target_lang_sense_clarification": "durch Abstimmung bestimmen"
                            },
                            {
                                "target_lang_word": "ernennen",
                                "target_lang_sense_clarification": "in ein Amt berufen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bec97ae3-299c-3012-be40-13d201723de0",
                    "sense_definition": "het uitbrengen van een stem tijdens een verkiezing",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kiezers gingen naar de stembus om hun voorkeur uit te <w>kiezen</w>.",
                            "target_lang_translations": {
                                "en": "The voters went to the polls to <w>choose</w> their preference.",
                                "de": "Die Wähler gingen an die Urnen, um ihre Präferenz <w>auszuwählen</w>."
                            }
                        },
                        {
                            "text": "Burgers hebben het recht om te <w>kiezen</w> tijdens landelijke verkiezingen.",
                            "target_lang_translations": {
                                "en": "Citizens have the right to <w>vote</w> during national elections.",
                                "de": "Bürger haben das Recht, bei nationalen Wahlen <w>zu wählen</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "stemmen"
                    ],
                    "common_phrases": [
