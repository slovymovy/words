                "senses": [
                    {
                        "sense_id": "969b1792-3160-3d53-a586-2729f5679c04",
                        "entry_id": "09a157e2-871d-3343-b712-8a183e59f1a4",
                        "glosses": [
                            "Habitant de l'Arabie, adepte du wahhabisme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bcc458cf-73a8-4b1c-b4f0-7bdf87f1a5d3",
                                "sense_id": "969b1792-3160-3d53-a586-2729f5679c04",
                                "text": "Les Wahhabites, en Arabie, à la fin du XVIIIᵉ siècle, par exemple, recourant à l’autorité de certains théologiens médiévaux, lancèrent un mouvement virulent d'islam purifié - et puritain - fondé strictement sur les enseignements du Coran et sur la sunna du Prophète, débarrassé des additions séculaires."
                            }
                        ]
                    }
                ],
