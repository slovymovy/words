                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kameraman",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "79f2697e-8fd1-31c0-b898-fd9c6d193cbc",
                                        "entry_id": "c2144e94-8759-352e-8fd0-4a333489d426",
                                        "glosses": [
                                            "osoba obsluhující kameru"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92856b2d-a9cb-4903-bc8a-fd7b1b7f0287",
                                                "sense_id": "79f2697e-8fd1-31c0-b898-fd9c6d193cbc",
                                                "text": "Kameraman se strkal s lidmi, aby mu nepřekáželi v záběru, a pokusy reportérky o komentář tonuly v potlesku a jásotu uchváceného davu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "29bcb278-d3f4-401d-a6dd-f8b73dde4e7f",
                        "source_entry_id": "f5b663b6-835a-301a-857c-eb1d29b2b162",
                        "source_sense_id": "b9e13a29-9f99-33cc-8aad-5fbcb4d402ec",
                        "target_lang_word": "caméraman",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caméraman",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30724525-f390-327c-b2ed-943b919d4837",
                                        "entry_id": "2d7b83f3-8666-3ef5-917f-99109b8949e4",
                                        "glosses": [
                                            "Technicien réalisant les prises de vue cinématographiques ou télévisuelles."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e9c4b1a4-5d0d-4826-ba7b-910c9cbfec6a",
                                                "sense_id": "30724525-f390-327c-b2ed-943b919d4837",
                                                "text": "Vers 11h45, le SPVM a dû à nouveau se rendre à la synagogue où ils étaient intervenus la veille, …, où un homme de 44 ans a été arrêté après avoir menacé un caméraman de TVS Nouvelles."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3460bd93-e351-4c8c-985c-5dafb8082179",
                        "source_entry_id": "f5b663b6-835a-301a-857c-eb1d29b2b162",
                        "source_sense_id": "b9e13a29-9f99-33cc-8aad-5fbcb4d402ec",
                        "target_lang_word": "cámara",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cámara",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "f356fc6d-5cb7-3d93-b855-de1e072aad55",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Aparato que sirve para capturar imágenes estáticas."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd96f0e9-0c7c-4e93-9d6b-0d3427856219",
                                                "sense_id": "f356fc6d-5cb7-3d93-b855-de1e072aad55",
                                                "text": "Por otro lado, cada foto deberá hacerse en un día soleado y, de preferencia, a una hora del día en que el sol no quede frente a la cámara ni en el cenit."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ebf0d588-b235-3d3e-8c96-8be14d40aae3",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Aparato que sirve para capturar imágenes en movimiento."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "660642da-a239-4d87-afbc-9ab9e9cabebf",
                                                "sense_id": "ebf0d588-b235-3d3e-8c96-8be14d40aae3",
                                                "text": "Sí; recuerda la última vez que anduviste por el psiquiátrico, cuando andabas sentado frente a la doctora y ella te dijo que imaginaras que una cámara de cine grababa tu vida, y que le dijeras cómo te gustaría aparecer en ella, en qué situaciones."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Cavidad delimitada por paredes de origen natural o artificial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c95cf98-5a98-4089-9859-eb1319f06bef",
                                                "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                                "text": "El manejo del fusil Robert es muy sencillo: para cargarlo se coge la palanca C por el anillo D y se levanta; por este movimiento la recámara B girando sobre E alrededor del tornillo G, descubre la cámara del cañón; al mismo tiempo el montador j apoyándose por la ruedecilla a sobre el gran resorte L, lo comprime hasta que la muesca b del martillo se detiene debajo de P."
                                            },
                                            {
                                                "example_id": "bf20d992-7cff-46d4-bbd0-a2e19208d088",
                                                "sense_id": "f6bc7db9-431d-32be-9c44-92ce4cf97bfb",
                                                "text": "y deslizandose sucesivamente de los brazos menores á los mayores, se vuelve hácia la cámara derecha ó ventriculo del corazon, necesitando purificacion y renovacion parcial."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9b5d87ae-aa1e-315f-8e9b-a73cd4ffc53b",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Habitáculo destinado a un fin concreto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c31ac01-55dc-4d99-b7fd-0de1c7aa67f4",
                                                "sense_id": "9b5d87ae-aa1e-315f-8e9b-a73cd4ffc53b",
                                                "text": "Como barco de carga destinado al transporte de mercancías, era un tanto pesado; de figura muy redonda, casi igual a proa que a popa, tenía una cubierta, sollado a proa para la marinería, cámaras en popa y todo lo demás preparado para bodega."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "086fab29-cc52-3449-8c30-63d42ecb4ada",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Organización establecida para tratar un determinado asunto."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c4386e01-f1f1-4c9b-9524-58a4e60284c8",
                                                "sense_id": "086fab29-cc52-3449-8c30-63d42ecb4ada",
                                                "text": "Creóse en Sevilla una \"Cámara de Comercio\" (Casa de contratación), encargada de inspeccionar y recibir todas las mercancías de las colonias."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "6bf38597-fa5b-3398-b032-570016020cd5",
                                        "entry_id": "f9adaee2-c541-3028-8796-9c47cabcaf8c",
                                        "glosses": [
                                            "Cada uno de los cuerpos colegisladores en los regímenes representativos."
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7400fb9a-f07f-4505-b768-15f48f732d85",
                                                "sense_id": "6bf38597-fa5b-3398-b032-570016020cd5",
                                                "text": "El Congreso y el Senado, y, en su caso, ambas Cámaras conjuntamente, podrán nombrar Comisiones de investigación sobre cualquier asunto de interés público."
                                            }
