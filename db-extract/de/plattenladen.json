                                "example_id": "cf51c850-44f8-4bbc-8869-4ebf063bc86f",
                                "sense_id": "e4b6e2bf-6676-3c60-9688-f43dbc07ba60",
                                "text": "„Das rothaarige Mädchen, das vor dem Plattenladen Prospekte verteilte, war auch schön.“"
                            }
                        ],
