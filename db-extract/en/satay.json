                            {
                                "target_word": "satay",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ba44225c-d9b6-3cb6-8e3f-fbdaf4124163",
                                        "entry_id": "e50d15ac-49b3-3b3a-9c96-132507f4599f",
                                        "glosses": [
                                            "Condiment d’Asie du Sud-Est composé de cacahuètes, de piments, d’oignons, de tomate et de broyat de crevettes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f26bf58-905a-4fc2-b199-b6c98a8b1bdf",
                                                "sense_id": "ba44225c-d9b6-3cb6-8e3f-fbdaf4124163",
                                                "text": "Puis ajoutez le sucre roux, le curcuma, le satay, la sauce soja et le beurre de cacahuète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "695948a5-f230-3702-a5e8-caef90841d6e",
                                        "entry_id": "e50d15ac-49b3-3b3a-9c96-132507f4599f",
                                        "glosses": [
                                            "Plat malais d’Indonésie et de Malaisie composé de petits morceaux de poulet ou de bœuf braisés et mis en brochette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6feca2f0-8263-4579-ba84-024b6baadf27",
                                                "sense_id": "695948a5-f230-3702-a5e8-caef90841d6e",
                                                "text": "Ce café là-bas vend du nasi lemak chaud, et aussi du curry, du satay, du riz au curcuma, et même du satay de porc."
                                            },
                                            {
                                                "example_id": "3cec1802-78c3-4b65-bc5c-3aa67a1f8523",
                                                "sense_id": "695948a5-f230-3702-a5e8-caef90841d6e",
                                                "text": "Une fois assis à l’extérieur sur de petits tabourets autour d’une simple table de bois, Arnauld, qui semblait vraiment à son aise dans ce décor rudimentaire, commanda la spécialité locale, un « nasi goreng » et des satays."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
