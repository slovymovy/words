                "senses": [
                    {
                        "sense_id": "56dc8b5f-dfc6-368f-a232-45aa256af1a9",
                        "entry_id": "b4e57ade-aca4-3613-9961-8af5f08fd055",
                        "glosses": [
                            "To apply butter to (something) again."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "b9be9500-87a1-4e8b-a5d5-4b0b0f31f674",
                                "sense_id": "56dc8b5f-dfc6-368f-a232-45aa256af1a9",
                                "text": "He dared to rebutter his bread with the original flavor of his stoicism, the western, but has once again left such films behind to die and has moved on."
                            },
                            {
                                "example_id": "a3dbb69d-7c36-4f75-a657-17b8d1dc26af",
                                "sense_id": "56dc8b5f-dfc6-368f-a232-45aa256af1a9",
                                "text": "It consisted of a thick white porridge leavened with yeast and eaten together with a boiled potato. It was often served seven days in a row, which meant it was reheated and rebuttered seven times over."
                            },
                            {
                                "example_id": "5d76d85a-dd9b-4f1d-89f3-0c7d918e5c69",
                                "sense_id": "56dc8b5f-dfc6-368f-a232-45aa256af1a9",
                                "text": "'Holy cow!' Johnny absent-mindedly rebuttered a piece of toast. 'And we thought climate-change was bad!'"
                            }
                        ]
                    }
                ],
