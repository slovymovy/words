                    }
                ],
                "senses": [
                    {
                        "sense_id": "cceb7c2d-80e7-3b80-b580-feeaf62e4818",
                        "entry_id": "69d4e4f3-bdb4-33be-be25-97af3b6e810a",
                        "glosses": [
                            "die Sudetendeutschen betreffend; von Sudetendeutschen stammend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac84c233-63c0-494d-b673-ad75da76f7a5",
                                "sense_id": "cceb7c2d-80e7-3b80-b580-feeaf62e4818",
                                "text": "Wie in den meisten europäischen Ländern, ist die sudetendeutsche Kultur genauso vielschichtig und vielfältig wie z. B. in Bereichen wie Volksmusik und Volkstanz, Trachten, Krippen, aber auch Alltagskultur, Zeitzeugen- und Kunstprojekte."
                            },
                            {
                                "example_id": "60b77c19-8334-4ea0-8a79-a3b0f6ba2512",
                                "sense_id": "cceb7c2d-80e7-3b80-b580-feeaf62e4818",
                                "text": "Obwohl in Hessen unter den Vertriebenen landsmannschaftlich das sudetendeutsche Element überwiegt, beherbergt allein Bayern mehr als doppelt so viele Sudetendeutsche als Hessen."
                            },
                            {
                                "example_id": "fdab50da-a64c-4f67-a98c-9f482193b519",
                                "sense_id": "cceb7c2d-80e7-3b80-b580-feeaf62e4818",
                                "text": "Ein besonderer Krieg wurde gegen die sudetendeutsche Industrie geführt."
                            },
                            {
                                "example_id": "89f252b8-d497-4e86-86b7-7066bf340869",
                                "sense_id": "cceb7c2d-80e7-3b80-b580-feeaf62e4818",
                                "text": "Vitín - auf einer aktuellen tschechischen Landkarte ist der Ort nicht mehr zu finden. Denn die einst sudetendeutsche Gemeinde ist längst verlassen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
