                    }
                ],
                "translations": [
                    {
                        "translation_id": "b3f99189-ced5-4f40-84d7-f68b683be75d",
                        "source_entry_id": "b710ff66-08fc-36ce-b5a6-c5394a96ad65",
                        "source_sense_description": "искажение выражения лица",
                        "target_lang_word": "grimace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grimace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                        "entry_id": "2b3d89a2-2c52-3461-a765-9cda840fd618",
                                        "glosses": [
                                            "A contorted facial expression, often expressing contempt or pain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3d6d649-8eb9-47d6-a56f-8e9050375d12",
                                                "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                                "text": "Her face was twisted in a grimace of disgust."
                                            },
                                            {
                                                "example_id": "847ecff8-e47b-4fe6-bb70-8d177c6ed17d",
                                                "sense_id": "22ecd450-2989-3549-8479-69840c25eae7",
                                                "text": "I trundle off to bed, eyes brimming, face twisted into a grateful glistening grimace, and awaken the next day wondering what all the fuss was about."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                        "entry_id": "2b3d89a2-2c52-3461-a765-9cda840fd618",
                                        "glosses": [
                                            "Affectation, pretence."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d1d314c-955c-4e30-b190-e94254654635",
                                                "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                                "text": "Zeluco considered all this as mere affectation and grimace, and was convinced that she would, in due time, unfold the particular mode in which she wished to be indemnified […]."
                                            },
                                            {
                                                "example_id": "c7552799-58f2-469f-bba3-d95173dce1b0",
                                                "sense_id": "c6939571-dd29-30f6-aafe-52cca89d5161",
                                                "text": "Charlotte was equally insensible to all his fashionable grimace, and indifferent to his conversation."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grimace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c91c4ea-8242-3763-a63e-b8c0de8891b1",
                                        "entry_id": "5f34082c-5c0c-379e-8c6a-fa287c964516",
                                        "glosses": [
                                            "To make grimaces; to distort one's face; to make faces."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d8e730d6-49e8-4c22-85bf-c51be28e223c",
                        "source_entry_id": "b710ff66-08fc-36ce-b5a6-c5394a96ad65",
                        "source_sense_description": "искажение выражения лица",
                        "target_lang_word": "Grimasse",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Grimasse",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                        "entry_id": "9f0977f7-9d88-3130-8a30-ef34de953520",
                                        "glosses": [
                                            "absichtlich verzerrtes Gesicht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8220be-d19e-450f-b5e6-ffb916710c54",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "Zieh nicht immer eine solche Grimasse!"
                                            },
                                            {
                                                "example_id": "82b10b11-cfe6-4c1b-bd2f-c7ace53f5b86",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Niko zog eine Grimasse.“"
                                            },
                                            {
                                                "example_id": "abf6e344-7edf-4aa7-93d5-ca776bd12173",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Sein Großvatergesicht verzerrte sich zu einer Grimasse.“"
                                            },
                                            {
                                                "example_id": "baceb278-1921-49d9-8e3b-8a8736751474",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Manchmal brachte er sie mit einer Grimasse zum Lachen.“"
                                            },
                                            {
                                                "example_id": "8e80e070-10dd-4aef-98be-597266b74718",
                                                "sense_id": "5a802e60-0cad-3773-899b-fade97fef380",
                                                "text": "„Er hörte auf mit seinen Grimassen und beugte sich über sie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "01c7b1b8-c135-453c-bfdc-f89093aa1c94",
                        "source_entry_id": "b710ff66-08fc-36ce-b5a6-c5394a96ad65",
                        "source_sense_description": "искажение выражения лица",
                        "target_lang_word": "grymas",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grymas",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "cdb6a1e9-eabf-3ede-8d45-5eaada8d3056",
                                        "entry_id": "6025b903-1a34-32a3-95b8-676795f7631e",
                                        "glosses": [
                                            "wykrzywienie twarzy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a008af65-a56f-488a-a679-87b1ac6c04a1",
                                                "sense_id": "cdb6a1e9-eabf-3ede-8d45-5eaada8d3056",
                                                "text": "Jego twarz wykrzywił grymas bólu."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "40dd46ba-6d8b-4d21-80c8-407456c9d746",
                        "source_entry_id": "b710ff66-08fc-36ce-b5a6-c5394a96ad65",
                        "source_sense_description": "искажение выражения лица",
                        "target_lang_word": "grimace",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grimace",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                                        "entry_id": "57a61cb2-ce12-37a9-8193-04df9ed08e2b",
                                        "glosses": [
                                            "Contorsion du visage faite souvent à dessein."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7917d5f-0abb-4224-9978-cc85cabdd419",
                                                "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                                                "text": "Un de nos hommes, pour s'amuser, se mit à loucher et à faire des grimaces; aussitôt un des jeunes Fuégiens, dont le visage était peint tout en noir, sauf une bande blanche à la hauteur des yeux, se mit aussi à faire des grimaces et il faut avouer qu'elles étaient bien plus hideuses que celles de notre matelot."
                                            },
                                            {
                                                "example_id": "ed93026e-eb7a-453d-86c6-d4bc93f1c1d1",
                                                "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                                                "text": "Il avait réussi à prendre quelques photos : des CRS à moitié endormis, bottés et casqués, le Mauser lance-grenades à la bretelle, rencognés, non loin du CHU et de la fac de droit, comme une poignée d’oiseaux mouillés, sous les grimaces provocatrices et vengeresses des masques de pierre du vieil hôtel de Cerisy ; un garde-mobile ronflant la bouche ouverte, le visage grotesquement déformé par la vitre du car Berliet le long duquel sa joue s’était ventousée comme une limace ; un gradé en civil, arrogant et sec, juché sur le refuge central du carrefour des Palomières comme un coq sur son fumier."
                                            },
                                            {
                                                "example_id": "d5970a22-89d9-46a9-a9b8-213948b44287",
                                                "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                                                "text": "Cela dura douze heures. Je ne perdis aucun des mouvements, aucune des grimaces, aucun des frissons de cette chair suppliciée."
                                            },
                                            {
                                                "example_id": "680eb27d-a0ea-45c2-9fba-f6af470d49e6",
                                                "sense_id": "415dc4b4-3d91-361d-8f82-c75fcebf0fcf",
                                                "text": "À onze heures il arrivait à Fresnay-les-Chaumes, déjeunait à l'unique bouchon de ce hameau de Pithiviers-le-Vieil, d'un chanteau de pain bis et d'un hareng saur, additionnés d'un petit vin du pays qui lui fit faire une de ces grimaces !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                        "entry_id": "57a61cb2-ce12-37a9-8193-04df9ed08e2b",
                                        "glosses": [
                                            "Feinte ; fausses apparences ; dissimulation ; simagrées."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e70a7daf-19c2-4547-a6f5-1e9efb8f1681",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Malgré toutes leurs grimaces, ils ressemblent à des singes revêtus de pourpre ou à des ânes couverts de peau de lion; ils ont beau faire, il passe toujours quelque petit bout d'oreille qui décèle à la fin, la tête de Midas."
                                            },
                                            {
                                                "example_id": "f2d038b2-9a8a-4148-b2b2-d425edfd2f3b",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Contentez-vous de ces phrases insignifiantes, de ces ravissantes grimaces, et ne demandez pas un sentiment dans les cœurs."
                                            },
                                            {
                                                "example_id": "b13dbca6-18a7-4ba3-aa9b-9ab50b15152a",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Votre maudite flotte est mise en pièces… Et vous avez le toupet de continuer vos grimaces… À d’autres ! avec moi, ça ne prendra pas !… Regardez donc tout le mal que vous avez fait…"
                                            },
                                            {
                                                "example_id": "f34f04e2-1ff5-4040-9ee9-e42b81fb06e6",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Faux pli. […] devant des tables à casiers, chargés à en rompre d’autres paperasseries en désordre, de lourds encriers, de grimaces hérissées d’épingles […] — (Verlaine, Confessions, Ed. du Bateau ivre, 1946, page 193)"
                                            },
                                            {
                                                "example_id": "7661ab88-614f-48dd-93b6-95612c334efc",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Je me rappelle seulement cet interminable voyage dont je connaissais chaque moment, ce train, ces paysages, et, planant sur eux, la pensée d’un printemps à Paris, sans amis (mais cela importait peu), sans femme (mais en avoir demandait bien des grimaces), sans goût pour les sorties, les boissons, les promenades, les gens."
                                            },
                                            {
                                                "example_id": "8ea4adda-3c1a-45b4-a77f-ad53e3a0d4e1",
                                                "sense_id": "a3929d38-55da-3a16-8c11-7e0fe4c1d2d1",
                                                "text": "Il s'amusait de cette grimace faite au destin et se prenait à rêver que les mouches avaient changé d'âne, que la bourrique avait enfin tourné le cul au foin, et que la veine, désormais, lui sourirait toujours."
                                            }
                                        ]
                                    }
                                ]
                            },
