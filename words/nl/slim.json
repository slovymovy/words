                {
                    "sense_id": "d84f074b-462a-3f7b-a73e-0ff94ad5b6ef",
                    "sense_definition": "Intelligent, in staat om snel dingen te begrijpen en te leren.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "intellect",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Anneke is een van de <w>slimste</w> meisjes van de klas.",
                            "target_lang_translations": {
                                "en": "Anneke is one of the <w>smartest</w> girls in the class.",
                                "ru": "Аннеке — одна из самых <w>умных</w> девочек в классе.",
                                "zh": "安内克是班里最<w>聪明</w>的女孩之一。",
                                "it": "Anneke è una delle ragazze più <w>intelligenti</w> della classe."
                            }
                        },
                        {
                            "text": "Mijn broertje is erg <w>slim</w> en haalt altijd goede cijfers op school.",
                            "target_lang_translations": {
                                "en": "My little brother is very <w>smart</w> and always gets good grades at school.",
                                "ru": "Мой братишка очень <w>умный</w> и всегда получает хорошие оценки в школе.",
                                "zh": "我弟弟非常<w>聪明</w>，在学校总是拿高分。",
                                "it": "Mio fratello minore è molto <w>sveglio</w> e prende sempre buoni voti a scuola."
                            }
                        }
