                "senses": [
                    {
                        "sense_id": "384fbc4c-4aa4-3e00-9c51-9905b3a187f3",
                        "entry_id": "88647c7a-e1db-3c92-838b-3a6b003253ab",
                        "glosses": [
                            "A device that emits a short, high-pitched sound burst, such as in sonar or other echo location systems."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "261c4e2b-7b40-492a-8d46-346ad9c5b5da",
                                "sense_id": "384fbc4c-4aa4-3e00-9c51-9905b3a187f3",
                                "text": "We couldn't take the boat into the shallows near the reef because our sonar pinger was broken."
                            }
                        ]
                    },
                    {
                        "sense_id": "812ddc0f-4650-32ce-b95b-b3ac5a64b83c",
                        "entry_id": "88647c7a-e1db-3c92-838b-3a6b003253ab",
                        "glosses": [
                            "A device that periodically emits a signal that can be monitored to permit movement tracking."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a82a90e-d0ae-40e4-b733-4aa36de9aaaf",
                                "sense_id": "812ddc0f-4650-32ce-b95b-b3ac5a64b83c",
                                "text": "The scientist attached a pinger to the carapace of the sea turtle to track its migration."
                            }
                        ]
                    },
                    {
                        "sense_id": "449dc021-e57d-36a7-933f-bf3c1dbc6dbb",
                        "entry_id": "88647c7a-e1db-3c92-838b-3a6b003253ab",
                        "glosses": [
                            "A computer program that sends a ping message over a network."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "785a48e5-01b6-4049-9c19-5993be860f97",
                                "sense_id": "449dc021-e57d-36a7-933f-bf3c1dbc6dbb",
                                "text": "Some people like fancy pingers with extra features, but I always use the default ping application."
                            }
                        ]
                    },
                    {
                        "sense_id": "70c6da1e-8fb0-3e2f-b612-bf6cb240a199",
                        "entry_id": "88647c7a-e1db-3c92-838b-3a6b003253ab",
                        "glosses": [
                            "A user of a ping program; one who pings."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ef7671a-1916-4efc-ac84-36cbb9c3d37c",
                                "sense_id": "70c6da1e-8fb0-3e2f-b612-bf6cb240a199",
                                "text": "Every time we replace the main page, we get flooded with pingers making sure our web site is still there."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5cd6858-519a-3ebc-956f-34f82a104450",
                        "entry_id": "88647c7a-e1db-3c92-838b-3a6b003253ab",
                        "glosses": [
                            "An illicit drug, especially ecstasy, taken for recreational purposes."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "9dd65be1-1cfa-4dc9-b686-f74c15f58d0a",
                                "sense_id": "f5cd6858-519a-3ebc-956f-34f82a104450",
                                "text": "That was a great party. Everyone took a pinger or two."
                            }
                        ]
                    }
