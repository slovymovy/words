                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9876d733-5fbb-41a9-9a38-75ed6ff86a5f",
                                "sense_id": "9cd448a4-153c-3a06-8b5e-f6c862f22145",
                                "text": "The cigarette is analogous to what linguists call a shifter, like the word I ; this device for expressing the irreducible particularity of my innermost self is universally available to every speaker and is thus the least particular thing in the world. The smoker manipulates the cigarette, like the word I, to tell stories to him/herself about him/herself — or to an other."
                            }
                        ]
                    },
