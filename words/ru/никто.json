{
    "word_family": [
        "никтошеньки"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "6a78c233-54d6-3135-ab1e-dcb493083be0",
                    "sense_definition": "ни один человек, ни одно существо",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В пустой комнате <w>никого</w> не было.",
                            "target_lang_translations": {
                                "en": "There was <w>no one</w> in the empty room.",
                                "zh": "空房间里<w>没有人</w>。"
                            }
                        },
                        {
                            "text": "<w>Никто</w> не знает правильного ответа на этот сложный вопрос.",
                            "target_lang_translations": {
                                "en": "<w>Nobody</w> knows the correct answer to this difficult question.",
                                "zh": "<w>没有人</w>知道这个难题的正确答案。"
                            }
                        },
                        {
                            "text": "Я постучал в дверь, но <w>никто</w> не открыл.",
                            "target_lang_translations": {
                                "en": "I knocked on the door, but <w>no one</w> opened it.",
                                "zh": "我敲了门，但<w>谁也没</w>开。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ни души"
                    ],
                    "antonyms": [
                        "кто-то",
                        "кто-нибудь",
                        "кое-кто"
                    ],
                    "common_phrases": [
                        "никто не знает",
                        "никто не забыт",
                        "никто иной"
                    ],
                    "target_lang_definitions": {
                        "en": "Not a single person; no one",
                        "zh": "指没有任何人，用于否定句中。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "not any person"
                            },
                            {
                                "target_lang_word": "no one",
                                "target_lang_sense_clarification": "not a single person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "没有人",
                                "target_lang_sense_clarification": "指代没有任何人"
                            },
                            {
                                "target_lang_word": "谁也不",
                                "target_lang_sense_clarification": "强调没有任何人做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9540b272-8339-3157-b51f-c15eb6851a05",
                    "sense_definition": "человек, не имеющий никакого отношения к кому-либо, ставший чужим",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После той ссоры мы друг другу <w>никто</w>.",
                            "target_lang_translations": {
                                "en": "After that quarrel, we are <w>strangers</w> to each other.",
                                "zh": "那次争吵后，我们对彼此来说就是<w>陌生人</w>。"
                            }
                        },
                        {
                            "text": "Этот человек мне <w>никто</w>, я вижу его впервые.",
                            "target_lang_translations": {
                                "en": "This person is <w>nobody</w> to me; I am seeing him for the first time.",
                                "zh": "这个人我根本不认识，我是第一次见他，他对我来说<w>毫无关系</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "незнакомец"
                    ],
                    "common_phrases": [
                        "мы друг другу никто",
                        "он мне никто"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A person who has no relationship or connection to someone; a stranger",
                        "zh": "指与某人毫无关系、互不相识的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "person of no relation"
                            },
                            {
                                "target_lang_word": "stranger",
                                "target_lang_sense_clarification": "unknown or unrelated person"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陌生人",
                                "target_lang_sense_clarification": "指互不相识的人"
                            },
                            {
                                "target_lang_word": "毫无关系的人",
                                "target_lang_sense_clarification": "指彼此之间没有联系"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf3f6de2-56d0-36f6-9cff-4342367e2354",
                    "sense_definition": "никчёмный, незначительный человек, не имеющий веса или влияния",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Без поддержки своей команды он чувствовал, что он <w>никто</w>.",
                            "target_lang_translations": {
                                "en": "Without the support of his team, he felt like he was a <w>nobody</w>.",
                                "zh": "没有团队的支持，他觉得自己是个<w>无名小卒</w>。"
                            }
                        },
                        {
                            "text": "Не слушай его угрозы, он здесь <w>никто</w> и звать его никак.",
                            "target_lang_translations": {
                                "en": "Don't listen to his threats; he is a <w>nobody</w> here and has no influence.",
                                "zh": "别听他的威胁，他在这里是个<w>微不足道的人</w>，根本没人在乎他。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ничтожество"
                    ],
                    "common_phrases": [
                        "ты здесь никто",
                        "полный никто"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An insignificant person with no influence or status",
                        "zh": "指没有地位、没有影响力或无足轻重的人。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nobody",
                                "target_lang_sense_clarification": "insignificant person"
                            },
                            {
                                "target_lang_word": "nonentity",
                                "target_lang_sense_clarification": "person of no importance"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "无名小卒",
                                "target_lang_sense_clarification": "指没有地位或影响力的人"
                            },
                            {
                                "target_lang_word": "微不足道的人",
                                "target_lang_sense_clarification": "指不重要的人"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}