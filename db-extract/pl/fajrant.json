                "senses": [
                    {
                        "sense_id": "c81e9fc2-d165-3a12-9bf7-cce8be2592b4",
                        "entry_id": "90207f74-7e4d-32f2-bb50-e1ee44247915",
                        "glosses": [
                            "( gw. (Górny Śląsk)) koniec dnia pracy lub przerwa w pracy"
                        ],
                        "tags": [
                            "also",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "85103ea7-55c5-4806-9d98-07d965090a84",
                                "sense_id": "c81e9fc2-d165-3a12-9bf7-cce8be2592b4",
                                "text": "Franek ma teraz fajrant."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3990188a-e510-4f80-806c-d1660b0f351d",
                        "source_entry_id": "90207f74-7e4d-32f2-bb50-e1ee44247915",
                        "source_sense_id": "c81e9fc2-d165-3a12-9bf7-cce8be2592b4",
                        "target_lang_word": "Feierabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Feierabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                        "entry_id": "7fc74b04-d906-3f49-b376-5997cc5fb8d6",
                                        "glosses": [
                                            "Zeitspanne oder Zeitpunkt des Arbeitsendes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3584a29b-fed5-4f76-87f4-f1860db5bc07",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "Ich hab schon mittags Feierabend."
                                            },
                                            {
                                                "example_id": "a2edad76-0911-4a77-8ec3-c81f00d2adbb",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "Mensch, mach doch endlich Feierabend!"
                                            },
                                            {
                                                "example_id": "8af0fce3-ebe0-40bd-a2ef-cae1c6fe14ab",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "Was machst du nach Feierabend?"
                                            },
                                            {
                                                "example_id": "77c85b66-fcb6-4a26-a801-12042ceaf5d7",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "Schluss mit der Diskussion, jetzt ist Feierabend! Ich will kein Wort mehr zu dem Thema hören!"
                                            },
                                            {
                                                "example_id": "355588f9-4cbc-445d-9415-891ddbf1641e",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "„Acht Stockwerke über dem Straßencafé hatte Abyou gerade Feierabend gemacht.“"
                                            },
                                            {
                                                "example_id": "a29db5ce-7c56-41ac-802e-8efd561a9b20",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "Der Anschlag ereignete sich laut Polizei, als die Belegschaft das für den ländlichen Wiederaufbau zuständige Ministerium nach Feierabend verließ."
                                            },
                                            {
                                                "example_id": "4a5dbd97-4f76-4140-be7b-cbd420d3886a",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "„Stattdessen wartete er nach Feierabend vorm Garagentor.“"
                                            },
                                            {
                                                "example_id": "bbefa913-8a94-404c-9198-8347607e962d",
                                                "sense_id": "1a907d90-dc1b-3b77-bb1f-b37796d25519",
                                                "text": "„Ich habe diesen Spruch vom Feierabend des homosexuell veranlagten Menschen sehr gemocht und oft verbreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
