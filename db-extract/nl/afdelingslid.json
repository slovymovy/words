                        "examples": [
                            {
                                "example_id": "4c019ff6-2fd8-48f6-96a4-9bac77e0e1e2",
                                "sense_id": "46f8d80a-f0a8-3b64-987c-a1d08d5f6f57",
                                "text": "Het CDA in Almelo is ernstig verdeeld over het duolijsttrekkerschap. Veel afdelingsleden willen dat slechts één persoon lijsttrekker is bij de gemeenteraadsverkiezingen. Woensdagavond waren tijdens een vergadering evenveel leden vóór als tegen, zodat binnenkort een nieuwe stemming nodig is."
                            },
                            {
                                "example_id": "508461a0-c575-4dce-b1a4-f979d68bae67",
                                "sense_id": "46f8d80a-f0a8-3b64-987c-a1d08d5f6f57",
                                "text": "Betsy Wormgoor uit Noordijk wordt de lijsttrekker van de PvdA bij de komende raadsverkiezingen in Berkelland. De circa dertig afdelingsleden kozen haar donderdagavond unaniem tijdens een vergadering in het Borculose ontmoetingscentrum Het Hof."
                            }
                        ]
