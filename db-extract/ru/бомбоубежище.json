                "senses": [
                    {
                        "sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "glosses": [
                            "специально оборудованное укрытие (в подвалах домов, в земле), защищающее от авиабомб и артиллерийских снарядов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c46bbe18-2b30-4fa0-8119-303e2b23b14f",
                                "sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                                "text": "Часто воздушная тревога настигала нас на улице. Тогда забегаешь в первое попавшееся бомбоубежище."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fbfcf12d-b9c8-434b-9dd3-ea9e635ed1e8",
                        "source_entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "source_sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "target_lang_word": "bomb shelter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bomb shelter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fcb0e71-12dc-3702-b438-6bc4227da705",
                                        "entry_id": "f6d75591-0c67-3121-92d2-b23fd4dc25af",
                                        "glosses": [
                                            "An air-raid shelter, a structure designed to give protection against bombs."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33f3735d-28cb-4e56-9c6b-643ae5728827",
                        "source_entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "source_sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "target_lang_word": "air-raid shelter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "air-raid shelter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "35a9ce1c-9c0c-33c3-8695-fbb288b2318e",
                                        "entry_id": "58c052f0-b209-3da2-a27c-98eafdb780a2",
                                        "glosses": [
                                            "A structure, often a reinforced underground shelter designed to give protection against air raids."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eded9dc-4d3a-44ba-8ae8-5ede2465707b",
                                                "sense_id": "35a9ce1c-9c0c-33c3-8695-fbb288b2318e",
                                                "text": "With the intensification of air raids on London last September, these tube platforms began to be used as an air raid shelter, and shelterers travelled by train (specially stopped there) from other stations in order to gain access."
                                            },
                                            {
                                                "example_id": "d5012973-e108-441a-9af3-f6ec10f51fa7",
                                                "sense_id": "35a9ce1c-9c0c-33c3-8695-fbb288b2318e",
                                                "text": "This tunnel assumed some measure of importance during the second world war, when it was used nightly as an air raid shelter for multiple unit electric trains which were propelled over the branch by a steam engine."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05612218-a81c-4818-81ff-d4ca5b1a1d42",
                        "source_entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "source_sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "target_lang_word": "refugio antiaéreo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "90b0db46-a376-4582-a48d-f7dd9a78b628",
                        "source_entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "source_sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "target_lang_word": "rifugio antiaereo",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e341d053-bec2-49c4-bf43-9d8019ac3a51",
                        "source_entry_id": "9ab5ab04-8303-34ba-8db7-6a93e8b7b5db",
                        "source_sense_id": "4b8e13fc-d6d2-3443-b53b-f49c13eb9ad7",
                        "target_lang_word": "Luftschutzbunker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luftschutzbunker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "33b2118b-aca6-3ec1-952c-d14cb73c22b6",
                                        "entry_id": "fb88c47e-7002-3ff0-8d1a-99eb5105b080",
                                        "glosses": [
                                            "ein gesicherter Raum oder ein gesichertes Gebäude (Bunker), das vor den Folgen von Luftangriffen schützen soll"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd675f22-c477-4b45-8ca6-8bda042d118f",
                                                "sense_id": "33b2118b-aca6-3ec1-952c-d14cb73c22b6",
                                                "text": "„Einer der Stollen war während des Zweiten Weltkriegs als Luftschutzbunker genutzt worden.“"
                                            },
                                            {
                                                "example_id": "5ed1e29a-9516-42f1-a34d-931e4480470b",
                                                "sense_id": "33b2118b-aca6-3ec1-952c-d14cb73c22b6",
                                                "text": "„Sie wurden noch zweimal ausgebomt, verloren alles und erlebten das Ende des Krieges mit einer Tasche und dem, was sie auf dem Leib trugen, in einem öffentlichen Luftschutzbunker.“"
                                            },
                                            {
                                                "example_id": "5d5e2ce9-b581-48c4-b950-44cdeab9b49f",
                                                "sense_id": "33b2118b-aca6-3ec1-952c-d14cb73c22b6",
                                                "text": "„Die SS-Mannschaften waren überall heruntergeklettert und hatten sich in Sicherheit gebracht; sie hatten gute Luftschutzbunker nahe den Kasernen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
