    "entries": [
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "4b5911aa-4db6-3d76-aaf7-ee262c5f67ba",
                    "sense_definition": "В ночное, тёмное время суток.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Летом даже <ночью> на улице бывает очень тепло.",
                            "target_lang_translations": {
                                "en": "In summer, even <at night> it is very warm outside.",
                                "zh": "夏天即使在<w>夜里</w>，外面也非常暖和。"
                            }
                        },
                        {
                            "text": "Мы вернулись домой поздно <ночью> и сразу легли спать.",
                            "target_lang_translations": {
                                "en": "We returned home late <at night> and went straight to sleep.",
                                "zh": "我们<w>深夜</w>才回到家，然后直接就睡了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "днём"
                    ],
                    "common_phrases": [
                        "поздно ночью",
                        "сегодня ночью",
                        "глубокой ночью",
                        "вчера ночью"
                    ],
                    "target_lang_definitions": {
                        "en": "In the night time; during the dark part of the day.",
                        "zh": "在夜间，即一天中天黑的时候。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "at night",
                                "target_lang_sense_clarification": "general adverbial use"
                            },
                            {
                                "target_lang_word": "by night",
                                "target_lang_sense_clarification": "often used in contrast to 'by day'"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "晚上",
                                "target_lang_sense_clarification": "指天黑后的时间段"
                            },
                            {
                                "target_lang_word": "夜里",
                                "target_lang_sense_clarification": "指深夜或夜间"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1fff5557-3496-385c-8bff-c7fae5ed8290",
                    "sense_definition": "Творительный падеж единственного числа существительного <w>ночь</w>.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Он долго любовался звёздной <ночью> из своего окна.",
                            "target_lang_translations": {
                                "en": "He admired the starry <night> for a long time from his window.",
                                "zh": "他从窗户向外看了很久，欣赏着星光灿烂的<w>夜晚</w>。"
                            }
                        },
                        {
                            "text": "Между утром и <ночью> температура воздуха сильно изменилась.",
                            "target_lang_translations": {
                                "en": "Between morning and <night> the air temperature changed significantly.",
                                "zh": "早晨和<w>夜晚</w>之间的气温变化很大。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "instrumental singular"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The instrumental singular form of the noun 'night'.",
                        "zh": "名词“夜晚”的工具格形式，指代夜晚这一时间段。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "night",
                                "target_lang_sense_clarification": "noun form"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "夜晚",
                                "target_lang_sense_clarification": "指代夜晚这一名词概念"
                            }
                        ]
                    }
                }
            ]
        }
    ]
