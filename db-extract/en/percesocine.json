                        "glosses": [
                            "Relating to, or resembling, fish of suborder Percesoces, including gray mullets, barracudas, and silversides."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "b3e88e5e-5779-410c-a7ee-4af1e72b2e44",
                                "sense_id": "c2b8c7cc-9126-3e7c-b1b2-f58d815382fc",
                                "text": "It is possible that it may have been an early offshoot from a Percesocine or Acanthopterygian stock, and cognate with the Hemibranchii; but too little is known of its anatomy to warrant an authoritative opinion."
                            },
                            {
                                "example_id": "61e93ef6-3f18-42b2-8e26-d3c669f5bbfa",
                                "sense_id": "c2b8c7cc-9126-3e7c-b1b2-f58d815382fc",
                                "text": "Regan (1913) classified the percesocine fishes as two suborders of his order Percomorphi."
                            },
                            {
                                "example_id": "850c52a6-af05-4405-ab30-aea663bc497b",
                                "sense_id": "c2b8c7cc-9126-3e7c-b1b2-f58d815382fc",
                                "text": "The placement and relationships of the atherinoid (sometimes called percesocine) fishes are still in dispute."
                            }
