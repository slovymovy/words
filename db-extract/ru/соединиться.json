                                    },
                                    {
                                        "sense_id": "260da772-d3a3-38b0-8f4d-5485ddfc9706",
                                        "entry_id": "cb2ec129-5b94-3e41-b512-6687d1007784",
                                        "glosses": [
                                            "The act of joining something, such as a network."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c938acd6-8a75-4d77-b9d3-cfe432e959c2",
                                                "sense_id": "260da772-d3a3-38b0-8f4d-5485ddfc9706",
                                                "text": "The offline domain join is a three-step process described subsequently: […]"
                                            }
