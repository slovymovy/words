{
    "word_family": [
        "dilation",
        "dilator",
        "dilatant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f9e64b03-81f3-30c8-89c3-47cb4971b9f4",
                    "sense_definition": "To make something larger or wider.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor used special drops to <w>dilate</w> the patient's pupils for the eye examination.",
                            "target_lang_translations": {
                                "tr": "Doktor, göz muayenesi için hastanın göz bebeklerini <w>genişletmek</w> amacıyla özel damlalar kullandı."
                            }
                        },
                        {
                            "text": "Certain medications can <w>dilate</w> blood vessels to help improve circulation throughout the body.",
                            "target_lang_translations": {
                                "tr": "Bazı ilaçlar, vücuttaki kan dolaşımını iyileştirmeye yardımcı olmak için kan damarlarını <w>genişletebilir</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlarge",
                        "widen",
                        "expand"
                    ],
                    "antonyms": [
                        "contract"
                    ],
                    "common_phrases": [
                        "dilate pupils",
                        "dilate blood vessels"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyi daha büyük veya daha geniş hale getirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genişletmek",
                                "target_lang_sense_clarification": "Bir açıklığı veya alanı fiziksel olarak büyütmek."
                            },
                            {
                                "target_lang_word": "büyültmek",
                                "target_lang_sense_clarification": "Bir şeyin boyutlarını artırmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bb0beb27-09f7-39e7-827f-bfbcd8e1db02",
                    "sense_definition": "To become wider or larger.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "expand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pupils of the eyes naturally <w>dilate</w> when entering a dark room to let in more light.",
                            "target_lang_translations": {
                                "tr": "Karanlık bir odaya girildiğinde, daha fazla ışık almak için göz bebekleri doğal olarak <w>genişler</w>."
                            }
                        },
                        {
                            "text": "During intense exercise, the arteries <w>dilate</w> to supply more oxygen to the working muscles.",
                            "target_lang_translations": {
                                "tr": "Yoğun egzersiz sırasında, çalışan kaslara daha fazla oksijen sağlamak için atardamarlar <w>genişler</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "expand",
                        "widen"
                    ],
                    "antonyms": [
                        "contract"
                    ],
                    "common_phrases": [
                        "pupils dilate"
                    ],
                    "target_lang_definitions": {
                        "tr": "Daha geniş veya büyük hale gelmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genişlemek",
                                "target_lang_sense_clarification": "Kendi kendine daha geniş bir duruma gelmek."
                            },
                            {
                                "target_lang_word": "büyümek",
                                "target_lang_sense_clarification": "Hacim veya çap olarak artış göstermek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f93718e4-046f-337c-b1d9-76700c83af11",
                    "sense_definition": "To speak or write at great length about a specific subject.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "speak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor loved to <w>dilate</w> upon the historical significance of the ancient ruins during his lectures.",
                            "target_lang_translations": {
                                "tr": "Profesör, dersleri sırasında antik kalıntıların tarihsel önemi hakkında <w>uzun uzadıya konuşmayı</w> severdi."
                            }
                        },
                        {
                            "text": "He would often <w>dilate</w> on his favorite hobbies whenever he found a willing listener.",
                            "target_lang_translations": {
                                "tr": "Ne zaman istekli bir dinleyici bulsa, en sevdiği hobileri hakkında <w>uzun uzun anlatırdı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "expatiate",
                        "elaborate"
                    ],
                    "common_phrases": [
                        "dilate upon"
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir konu hakkında uzun uzadıya konuşmak veya yazmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uzun uzadıya anlatmak",
                                "target_lang_sense_clarification": "Bir konuyu detaylıca ele almak."
                            },
                            {
                                "target_lang_word": "detaylandırmak",
                                "target_lang_sense_clarification": "Bir konuyu ayrıntılarıyla açıklamak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fbe3b53c-97aa-3c3d-a28c-a9111e02d5f0",
                    "sense_definition": "To use a medical instrument to widen a bodily passage or opening.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "expand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon had to <w>dilate</w> the narrow passage to ensure the procedure could be completed safely.",
                            "target_lang_translations": {
                                "tr": "Cerrah, işlemin güvenli bir şekilde tamamlanabilmesini sağlamak için dar geçidi <w>genişletmek</w> zorundaydı."
                            }
                        },
                        {
                            "text": "Physical therapists may instruct patients on how to <w>dilate</w> the area to reduce muscle tension.",
                            "target_lang_translations": {
                                "tr": "Fizyoterapistler, kas gerginliğini azaltmak için hastalara bölgeyi nasıl <w>genişleteceklerini</w> öğretebilirler."
                            }
                        }
                    ],
                    "synonyms": [
                        "stretch",
                        "widen"
                    ],
                    "target_lang_definitions": {
                        "tr": "Tıbbi bir alet kullanarak vücuttaki bir geçidi veya açıklığı genişletmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "genişletmek",
                                "target_lang_sense_clarification": "Tıbbi müdahale ile bir kanalı açmak veya genişletmek."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "591c98ec-b698-3e4e-99b6-d069dcbad311",
                    "sense_definition": "To delay or defer an action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The council decided not to <w>dilate</w> the decision any further despite the ongoing protests.",
                            "target_lang_translations": {
                                "tr": "Konsey, devam eden protestolara rağmen kararı daha fazla <w>geciktirmemeye</w> karar verdi."
                            }
                        },
                        {
                            "text": "There was no reason to <w>dilate</w> the start of the meeting once all members had arrived.",
                            "target_lang_translations": {
                                "tr": "Tüm üyeler geldikten sonra toplantının başlangıcını <w>ertelemek</w> için hiçbir neden yoktu."
                            }
                        }
                    ],
                    "synonyms": [
                        "delay",
                        "defer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is largely obsolete in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir eylemi ertelemek veya geciktirmek."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "geciktirmek",
                                "target_lang_sense_clarification": "Bir işin zamanını ileriye atmak."
                            },
                            {
                                "target_lang_word": "ertelemek",
                                "target_lang_sense_clarification": "Bir kararı veya eylemi daha sonraya bırakmak."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c0ca925a-a159-3bb3-b776-ff92e8f3c27b",
                    "sense_definition": "To make something last for a longer period of time.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delay",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The author attempted to <w>dilate</w> the narrative, adding unnecessary details to the final chapter.",
                            "target_lang_translations": {
                                "tr": "Yazar, son bölüme gereksiz detaylar ekleyerek anlatıyı <w>uzatmaya</w> çalıştı."
                            }
                        },
                        {
                            "text": "He tried to <w>dilate</w> the pleasant evening by suggesting one last walk through the park.",
                            "target_lang_translations": {
                                "tr": "Parkta son bir yürüyüş daha önererek keyifli akşamı <w>uzatmaya</w> çalıştı."
                            }
                        }
                    ],
                    "synonyms": [
                        "prolong",
                        "lengthen"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in contemporary contexts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Bir şeyin süresini uzatmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "uzatmak",
                                "target_lang_sense_clarification": "Bir süreci veya zaman dilimini daha uzun kılmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "487f07f3-b8ef-3ccd-9aa0-9cc7166c5322",
                    "sense_definition": "Spread out or dispersed.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "expand",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>dilate</w> influence of the empire reached even the most distant provinces.",
                            "target_lang_translations": {
                                "tr": "İmparatorluğun <w>yayılmış</w> etkisi en uzak eyaletlere bile ulaştı."
                            }
                        },
                        {
                            "text": "His <w>dilate</w> thoughts were difficult to follow during the complex presentation.",
                            "target_lang_translations": {
                                "tr": "Karmaşık sunum sırasında onun <w>dağınık</w> düşüncelerini takip etmek zordu."
                            }
                        }
                    ],
                    "synonyms": [
                        "spread",
                        "dispersed"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is found in older literary texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "Yayılmış veya dağılmış."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "yayılmış",
                                "target_lang_sense_clarification": "Bir alana dağılmış durum."
                            },
                            {
                                "target_lang_word": "dağınık",
                                "target_lang_sense_clarification": "Belirli bir merkezden uzaklaşmış."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}