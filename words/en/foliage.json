{
    "word_family": [
        "foliate",
        "foliation",
        "foliated"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5c5fab92-5396-3e97-b268-b630631dd996",
                    "sense_definition": "The leaves of plants or trees collectively.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird hid itself deep within the thick <w>foliage</w> of the oak tree.",
                            "target_lang_translations": {
                                "pl": "Ptak ukrył się głęboko w gęstym <w>listowiu</w> dębu."
                            }
                        },
                        {
                            "text": "Sunlight filtered through the dense <w>foliage</w> of the forest canopy.",
                            "target_lang_translations": {
                                "pl": "Światło słoneczne przenikało przez gęste <w>listowie</w> koron drzew."
                            }
                        }
                    ],
                    "synonyms": [
                        "leaves",
                        "vegetation"
                    ],
                    "common_phrases": [
                        "dense foliage",
                        "green foliage"
                    ],
                    "target_lang_definitions": {
                        "pl": "Ogół liści roślin, zwłaszcza drzew i krzewów."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "listowie",
                                "target_lang_sense_clarification": "zbiorcze określenie na liście roślin"
                            },
                            {
                                "target_lang_word": "liście",
                                "target_lang_sense_clarification": "ogólne określenie na liście drzew"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53df8365-92bb-36dc-98c2-e0d49e700f39",
                    "sense_definition": "The leaves of trees as they change color during the autumn season.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plant_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many tourists travel north to see the beautiful autumn <w>foliage</w>.",
                            "target_lang_translations": {
                                "pl": "Wielu turystów podróżuje na północ, aby zobaczyć piękne <w>jesienne liście</w>."
                            }
                        },
                        {
                            "text": "The hills were covered in vibrant <w>foliage</w> during the fall season.",
                            "target_lang_translations": {
                                "pl": "Wzgórza były pokryte barwnymi <w>jesiennymi liśćmi</w> podczas jesieni."
                            }
                        }
                    ],
                    "synonyms": [
                        "autumn leaves"
                    ],
                    "common_phrases": [
                        "fall foliage",
                        "autumn foliage"
                    ],
                    "target_lang_definitions": {
                        "pl": "Liście drzew zmieniające kolor w okresie jesiennym."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "jesienne liście",
                                "target_lang_sense_clarification": "liście w jesiennych barwach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2080605c-af3e-3afa-8733-c1cdb2ba9d6a",
                    "sense_definition": "A decorative architectural element shaped like leaves or plant parts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The stone columns were decorated with intricate <w>foliage</w> carvings.",
                            "target_lang_translations": {
                                "pl": "Kamienne kolumny były ozdobione misternymi <w>ornamentami roślinnymi</w>."
                            }
                        },
                        {
                            "text": "The sculptor added delicate <w>foliage</w> to the top of the archway.",
                            "target_lang_translations": {
                                "pl": "Rzeźbiarz dodał delikatny <w>motyw roślinny</w> na szczycie łuku."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "pl": "Ozdobny element architektoniczny w kształcie liści lub części roślin."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "motyw roślinny",
                                "target_lang_sense_clarification": "dekoracja architektoniczna inspirowana roślinnością"
                            },
                            {
                                "target_lang_word": "ornament roślinny",
                                "target_lang_sense_clarification": "rzeźbiony wzór w kształcie liści"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}