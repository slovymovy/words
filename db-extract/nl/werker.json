                    },
                    {
                        "translation_id": "4ebb6b4a-ae25-4680-8392-de2b180f3800",
                        "source_entry_id": "e742dac9-55ac-38de-a019-a69674a79144",
                        "target_lang_word": "labourer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "labourer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                        "entry_id": "686513bd-0087-3e33-8f3f-1e4b5010e897",
                                        "glosses": [
                                            "British standard spelling of laborer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c2f587-8786-430f-a6c6-baf52f12fca8",
                                                "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            },
                                            {
                                                "example_id": "aceef10b-dd1d-410a-9495-e5d34ee3d6b9",
                                                "sense_id": "3bda8bd5-212d-3edf-a007-f1dc026fa49c",
                                                "text": "By the mid-19th century, the typical village was sharply divided between the landowning class and the landless, voteless and largely illiterate labourers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d5a0264d-3f9a-4be0-a748-a56fbd065f77",
                        "source_entry_id": "e742dac9-55ac-38de-a019-a69674a79144",
                        "target_lang_word": "worker",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worker",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "One who works: a person who performs labor for a living; traditionally, especially, manual labor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13711fdb-2e40-46b9-80e0-247a5e15e7eb",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Near-synonym: employee"
                                            },
                                            {
                                                "example_id": "5a6399c5-0b3f-4ae8-b142-5fa2bb33b805",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Fret not thy ſelfe becauſe of euill doers, neither bee thou enuious againſt the workers of iniquitie."
                                            },
                                            {
                                                "example_id": "fbc7e998-979d-49b3-b47c-2996222eeb64",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Writer Ta Chen, in a statistical study of industrial labor in China in 1933, recorded that 66.6 percent of the total number of workers in the four main industrial regions of Kwangtung were women. In Shun-te, 81.2 percent of the labor force were women."
                                            },
                                            {
                                                "example_id": "68875285-4c6f-47f6-81e0-48c104c9ee14",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Manganism has been known about since the 19th century, when miners exposed to ores containing manganese […] began to totter, slur their speech and behave like someone inebriated. The poisoning was irreversible, and soon ended in psychosis and death. Nowadays workers are exposed to far lower doses and manganism is rare."
                                            },
                                            {
                                                "example_id": "9f6a7db4-d29c-4779-b9f9-7c7fad265f74",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "Although the radiation levels identified are high, a threat to human health is very unlikely because apart from workers at the site, no-one goes there."
                                            },
                                            {
                                                "example_id": "455b28ad-223f-4925-b8b4-8ab3789d13cc",
                                                "sense_id": "20dd75ff-59b7-3477-8aa1-bc0d6765371b",
                                                "text": "That would allow employers to keep some tip money for themselves, as long as each worker made at least the full federal minimum wage of $7.25 an hour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de39e866-8ea3-3fd0-8c54-2ae731a05a99",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2a901efe-a474-3783-a606-47ae4f5de623",
                                        "entry_id": "3630a45e-6c21-340b-af74-fa6cbb9ceadb",
                                        "glosses": [
                                            "A nonreproductive social insect, such as ant, bee, termite, or wasp.",
                                            "A female ant, bee, termite or wasp."
