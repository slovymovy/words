                ],
                "senses": [
                    {
                        "sense_id": "333219d9-8a27-3070-a403-c892ed4b3c44",
                        "entry_id": "b72c00b2-6a4b-34b0-8849-d41f42572ea5",
                        "glosses": [
                            "деревянный или металлический щит, створ, которым снаружи или изнутри закрывают окна"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3df639ac-e374-4f1b-b5f0-849a0ee844fc",
                                "sense_id": "333219d9-8a27-3070-a403-c892ed4b3c44",
                                "text": "Тихо потрескивал фитиль, снаружи мягко стукала об окно обитая оленьим мехом ставня, ездовые собаки поднимали разноголосый вой."
                            }
                        ]
                    },
                    {
                        "sense_id": "59c8f651-8003-3368-8918-8d8cf504f749",
                        "entry_id": "b72c00b2-6a4b-34b0-8849-d41f42572ea5",
                        "glosses": [
                            "затвор в нижней части плотины для спуска воды"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57403e42-b6dc-4146-8786-420fffc9589c",
                                "sense_id": "59c8f651-8003-3368-8918-8d8cf504f749",
                                "text": "У сплоток хлопнула тяжёлая ставня. Вода с шипением унеслась по шурфу, очистив жёлто-серое дно."
                            }
                        ]
                    }
                ],
