                "senses": [
                    {
                        "sense_id": "eb23d0af-e4fc-3e3d-9683-55af4a8da03c",
                        "entry_id": "80b565d0-4de1-349e-b9bc-01a9dbe2906e",
                        "glosses": [
                            "Relatif au califat, qui œuvre pour le calife."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9b5e5efe-caf9-4db6-b3f2-ae9edf89dae6",
                                "sense_id": "eb23d0af-e4fc-3e3d-9683-55af4a8da03c",
                                "text": "En arrivant au palais califal, l’émissaire s’entendit dire, en termes forts circonstanciés, que le contrat de mariage pouvait être signé, mais que la réunion des deux époux était hors de question, « vu que l’important est l’honneur de l’alliance, et non la rencontre »."
                            },
                            {
                                "example_id": "e73efba1-ce68-43ae-8592-83c824e33a0c",
                                "sense_id": "eb23d0af-e4fc-3e3d-9683-55af4a8da03c",
                                "text": "L’apparition de l’origine territoriale (nisba) du soldat califal français n’est pas anodine : elle affirme que la Normandie ou la France sont potentiellement des provinces du Califat."
                            },
                            {
                                "example_id": "bee20185-d8c5-4eb4-9984-e28838237325",
                                "sense_id": "eb23d0af-e4fc-3e3d-9683-55af4a8da03c",
                                "text": "Les ollas d’époque califale sont des pièces globulaires à deux anses et fond convexe, présentant un décor incisé sur le haut de panse composé d’une ligne de stries parallèles et de vaguelettes (ollas 1, 2, 4, 5, 6)."
                            }
                        ]
                    }
