                "senses": [
                    {
                        "sense_id": "81cac299-032f-3d73-9d3f-a5d925b14bda",
                        "entry_id": "c3c193b8-d668-39b3-b8d1-a9338911e1ff",
                        "glosses": [
                            "Taux de glucose dans le sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbd5b7b-4bb4-4615-a958-891a0a7f1750",
                                "sense_id": "81cac299-032f-3d73-9d3f-a5d925b14bda",
                                "text": "Une glycémie est considérée comme normale si sa valeur est comprise entre 0,7 g/l et 1,1 g/l."
                            },
                            {
                                "example_id": "d6374bb4-7ec3-4962-9551-5ceed2abc961",
                                "sense_id": "81cac299-032f-3d73-9d3f-a5d925b14bda",
                                "text": "Une glycémie stable et modérée apparaît ainsi comme la meilleure condition d'une bonne activité intellectuelle."
                            },
                            {
                                "example_id": "799d9c57-f79a-4bca-a285-7b585d6cc381",
                                "sense_id": "81cac299-032f-3d73-9d3f-a5d925b14bda",
                                "text": "HIV, glycémie, cholestérol, une dépakinémie, trois urines, un bilan sanguin, rien de très intéressant."
                            }
                        ]
                    }
                ],
