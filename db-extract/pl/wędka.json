                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "de02dd8b-672d-4f94-a5fe-8ff7ae82edc9",
                                                "sense_id": "2b36d5ec-d8c3-33a1-9c06-2959648dd4f1",
                                                "text": "Wir brauchen für den Urlaub noch eine neue Angelrute."
                                            },
                                            {
                                                "example_id": "67bbe6ff-95cf-4f80-af5a-5b5abc708ea4",
                                                "sense_id": "2b36d5ec-d8c3-33a1-9c06-2959648dd4f1",
                                                "text": "Noch vor 150 Jahren waren Angelruten bis zu einer Länge von 5m aus Weide, Hasel oder Wacholder gefertigt."
                                            },
                                            {
                                                "example_id": "7475c76a-22cb-491b-bac7-32c88a1cba45",
                                                "sense_id": "2b36d5ec-d8c3-33a1-9c06-2959648dd4f1",
                                                "text": "„Unten am Hafen stehen zwei alte Kerle mit einer Angelrute und fangen Fische.“"
                                            },
                                            {
                                                "example_id": "f0ba169e-c5e6-4117-a40d-e66a646a4539",
                                                "sense_id": "2b36d5ec-d8c3-33a1-9c06-2959648dd4f1",
                                                "text": "„Ich hatte zwei Angelruten außen vor unserem Zimmer an der Wand lehnen sehen.“"
                                            },
                                            {
                                                "example_id": "9df59279-192f-4d36-9234-9529570daee6",
                                                "sense_id": "2b36d5ec-d8c3-33a1-9c06-2959648dd4f1",
                                                "text": "„Das Wort Häme (von ahd. ‚hamo’) bedeutet ursprünglich Angelhaken, Angelrute. Es hat mit dem ‚Hamen’ zu tun, einem Fangnetz mit Stiel […], das zum Fischefangen dient.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
