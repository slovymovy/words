                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "resomation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f5d822e8-3ebd-3deb-bfe8-23a16bbd7509",
                                        "entry_id": "16305d41-65e8-3a6c-a7ed-8797b83c5735",
                                        "glosses": [
                                            "A process for the disposal of a corpse by submerging it in a strong base compound at a high pressure and temperature until it dissolves."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42a2d88a-2e5f-46ad-aa87-7db2316ce18c",
                                                "sense_id": "f5d822e8-3ebd-3deb-bfe8-23a16bbd7509",
                                                "text": "[…] bodies were dissolved by resomation and the fluid evaporated to a powder that was ceremoniously scattered around the roots of newly planted trees."
                                            },
                                            {
                                                "example_id": "f507783e-1bfb-4174-bad8-9a3f0ed9fd08",
                                                "sense_id": "f5d822e8-3ebd-3deb-bfe8-23a16bbd7509",
                                                "text": "Many consumers opt for cremation for environmental reasons, though it too carries the risk for air pollution. Some in the industry are looking to alternatives of body disposal such as freeze-drying (promession) and dissolving (resomation)."
                                            },
                                            {
                                                "example_id": "66fff458-6a4b-42cf-b5ab-b30f5837a708",
                                                "sense_id": "f5d822e8-3ebd-3deb-bfe8-23a16bbd7509",
                                                "text": "Enter resomation, an alternative to cremation for the eco-conscious cadaver. Resomation is a process that liquefies rather than burns body tissues."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
