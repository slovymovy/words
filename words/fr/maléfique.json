    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b6fce49a-4e4f-31fd-9c66-228edaf146c5",
                    "sense_definition": "Qui exerce une influence occulte et malfaisante, qui cause du mal ou porte malheur.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "occulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le jeune aventurier devait briser le sort <w>maléfique</w> qui pesait sur la forêt depuis un siècle."
                        },
                        {
                            "text": "On attribuait autrefois des pouvoirs <w>maléfiques</w> aux animaux nocturnes et aux corbeaux."
                        }
                    ],
                    "synonyms": [
                        "malfaisant",
                        "néfaste",
                        "funeste"
                    ],
                    "antonyms": [
                        "bénéfique",
                        "salutaire"
                    ],
                    "common_phrases": [
                        "sort maléfique",
                        "pouvoirs maléfiques",
                        "forces maléfiques"
                    ]
                },
                {
                    "sense_id": "46380452-6054-31c2-9d8a-e4c3c974e50d",
                    "sense_definition": "Qui relève des forces du démon ou du diable ; diabolique.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "occulte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Selon les récits religieux, un esprit <w>maléfique</w> cherchait à corrompre les âmes innocentes."
                        },
                        {
                            "text": "Les villageois étaient persuadés qu'une créature <w>maléfique</w> rôdait dans les catacombes."
                        }
                    ],
                    "synonyms": [
                        "diabolique",
                        "démoniaque",
                        "satanique"
                    ],
                    "antonyms": [
                        "divin"
                    ],
                    "common_phrases": [
                        "esprit maléfique",
                        "créature maléfique"
                    ]
                },
                {
                    "sense_id": "aa5611e8-1586-3c69-9b5f-3fdca24e25fd",
                    "sense_definition": "En astrologie, qui est réputé exercer une influence pernicieuse ou funeste, en parlant d'un astre.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "astrologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les anciens astrologues considéraient Saturne comme une planète <w>maléfique</w> présageant de sombres malheurs."
                        },
                        {
                            "text": "Selon cette prédiction, un astre <w>maléfique</w> traversait le ciel lors de la chute du roi."
                        }
                    ],
                    "synonyms": [
                        "défavorable",
                        "funeste"
                    ],
                    "antonyms": [
                        "bénéfique"
                    ],
                    "common_phrases": [
                        "astre maléfique",
                        "planète maléfique"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage restreint aux croyances astrologiques traditionnelles"
                        }
                    ]
                }
