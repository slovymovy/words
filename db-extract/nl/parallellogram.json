                                "target_senses": [
                                    {
                                        "sense_id": "57519efe-8f11-3874-9eaf-ceee0808b056",
                                        "entry_id": "0d34d3ee-0599-3343-a311-375acb41be6c",
                                        "glosses": [
                                            "A convex quadrilateral in which each pair of opposite edges are parallel and of equal length."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ea0e1f40-feb6-31af-a504-c04afbbf2bb5",
                                        "entry_id": "0d34d3ee-0599-3343-a311-375acb41be6c",
                                        "glosses": [
                                            "either of two rectangular areas (respectively the large parallelogram and the small parallelogram) abutting the goal line in front of the goal. (Since 1986 officially named the large rectangle and small rectangle, though the older names are still occasionally used.)"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11461559-cb7d-4f50-b88f-0da68aeae06c",
                                                "sense_id": "ea0e1f40-feb6-31af-a504-c04afbbf2bb5",
                                                "text": "2 Marking of ground — … A five yard square shall be marked in front of each goal, having the goal posts at adjacent angles. A five yards square shall be marked out in front of each point space, having a goal post and a point post at adjacent angles. There will be thus formed in front of scoring area a parallelogram fifteen yards by five yards."
                                            },
                                            {
                                                "example_id": "d2f8b3f5-3262-4380-83cd-78a9aa0f68ff",
                                                "sense_id": "ea0e1f40-feb6-31af-a504-c04afbbf2bb5",
                                                "text": "Two parallelograms of the dimensions set out hereunder shall be formed in front of each scoring space. One parallelogram, 14 mts. by 4.5 mts. shall be formed by two lines 4.5 mts. long and at right angles to the end-line, being marked 3.80 mts. from each goal-post, and the ends of these lines being joined. A larger parallelogram 19 mts. by 13 mts. shall be formed by two lines 13 mts. long and at right angles to the end-line, being marked 6.4 mts. from each goal-post, and the ends of these lines being joined."
                                            },
                                            {
                                                "example_id": "8867a0d1-8496-4ed8-bf58-2bcb9dccc97e",
                                                "sense_id": "ea0e1f40-feb6-31af-a504-c04afbbf2bb5",
                                                "text": "Goulding was fouled in the small parallelogram and O’Connor nicked the penalty into the net off the post."
                                            },
                                            {
                                                "example_id": "70d62689-8f3f-4006-b859-3aba0a47f5ad",
                                                "sense_id": "ea0e1f40-feb6-31af-a504-c04afbbf2bb5",
                                                "text": "There are seven Kilkenny players inside the large parallelogram and only two from Tipperary. Yet Tipp have scored a goal."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aee0dc72-31f6-434f-9826-97b5f8ddce97",
                        "source_entry_id": "f8af4c08-fdc2-3b02-9f6f-5d30b100d005",
                        "source_sense_id": "6cab166d-6a77-3f0a-9bae-aba1abd173d7",
