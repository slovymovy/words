                "senses": [
                    {
                        "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                        "entry_id": "01786f16-5bb1-3c14-a36c-1e6c08ced6ab",
                        "glosses": [
                            "weibliche Person mit Glatze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70ca1fba-ee1e-4c55-b6c9-9908f8c2fb0d",
                                "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                                "text": "„»Unser Opfer war schlicht und einfach Glatzenträgerin, ohne dass es dafür einen erkennbaren medizinischen Grund gab. Ebenso rasierte sie sich die Augenbrauen.«“"
                            },
                            {
                                "example_id": "cd18a3b3-9042-45ff-a381-1141807df84b",
                                "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                                "text": "„Der neuen Glatzenträgerin wird derselbe Mut wie der Jungfrau von Orleans attestiert und ein einstimmiges Seufzen hallt durch den weiblichen Freundeskreis: Ich würde auch mal gerne, aber ich trau mich nicht.“"
                            },
                            {
                                "example_id": "8f38f093-8b0f-4b28-ab67-756751669ff4",
                                "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                                "text": "„Alle Völker […], die ihre Haare seltener schneiden, sind glatzenärmer als die friseurhuldigenden Europäer, wie denn auch unter Frauen die Glatzenträgerinnen seltener sind als unter Männern […].“"
                            },
                            {
                                "example_id": "7280081a-dc06-4ad6-9c2d-10aed1b62eab",
                                "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                                "text": "„[…] just als Fiona ihre Schwester wieder für sich entdecken will, trifft Tanja auf Adalbert, den schicken ‚Web Application Designer‘, den die Glatzenträgerin verachtet […].“"
                            },
                            {
                                "example_id": "6dfeaae0-ee2e-4c79-b6df-2d514182ba17",
                                "sense_id": "acb9585e-1373-3003-bd42-2d35e3b9321a",
                                "text": "„Damit das auch der letzte, von überholter Schönheitspropaganda verblödete Zuschauer kapiert, hat man als Kandidatinnen besonders plakative Fälle herausgesucht: Eine siebenfache Mutter mit Naturfrisur, eine übergewichtige Meerjungfrau, eine misshandelte Frühgebärende, eine 65-Jährige mit Edding-umrandeten Augen, eine krankheitsbedingte Glatzenträgerin, eine Bodybuilderin, die mit einem Koffer voller Proteinbottiche anreist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
