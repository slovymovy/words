                    "sense_definition": "het maken van een opening of kuil in de grond door aarde te verplaatsen",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "graven",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij moesten een diepe geul <w>delven</w> voor de nieuwe waterleidingen.",
                            "target_lang_translations": {
