                        "glosses": [
                            "научн. полное описание структуры связей в нервной системе организма"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27170e10-7c76-474b-b10a-2a1e4a7437d8",
                                "sense_id": "40df197b-8b55-337c-b27c-cc3112cd73ac",
                                "text": "Коннектом человека — это подробная карта всех нервных связей в мозге."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6375e5d-3b62-4ed9-902d-de920d4b5dfc",
