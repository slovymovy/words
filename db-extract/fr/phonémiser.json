                "senses": [
                    {
                        "sense_id": "4b4886d7-4e3d-3c92-9b64-45b47b8f983d",
                        "entry_id": "8cf40bb5-c6cb-3b67-8d17-03b44bac8242",
                        "glosses": [
                            "Exprimer vocalement les différents phonèmes d’un mot ou d’un texte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2155fc95-31c5-4a1b-a331-624aa7fdf8ae",
                                "sense_id": "4b4886d7-4e3d-3c92-9b64-45b47b8f983d",
                                "text": "Il est possible de phonémiser un texte, il existe des programmes de lecture à haute voix de textes, un alphabet phonétique international."
                            },
                            {
                                "example_id": "83acdf2e-5ef6-4400-a65d-1d12d696f9df",
                                "sense_id": "4b4886d7-4e3d-3c92-9b64-45b47b8f983d",
                                "text": "2. savoir parfaitement « phonémiser », c'est-à-dire bruiter tous les phonèmes d'une chaîne parlée, assez longue,"
                            },
                            {
                                "example_id": "4e092e34-8185-4be7-832f-62e42bb069ae",
                                "sense_id": "4b4886d7-4e3d-3c92-9b64-45b47b8f983d",
                                "text": "Autant vaudrait alors phonémiser directement."
                            }
                        ]
                    }
