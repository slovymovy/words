                        ],
                        "examples": [
                            {
                                "example_id": "34c332d4-49d1-413a-8539-c7682341706a",
                                "sense_id": "98dbf35b-0899-3261-989d-aa77895b289a",
                                "text": "Пред мои́ми глаза́ми, вдали́, в полутьме́, что́-то мелькну́ло, как тёмная стрела́, пото́м друга́я, тре́тья, и вслед за тем в во́здухе разда́лся протя́жный жа́лобный вой.",
                                "translation": "I saw, in the twilight, something flitting in the distance, like a dark arrow, then another, and a third, and immediately after the air was filled with a long doleful howl.",
                                "english": "I saw, in the twilight, something flitting in the distance, like a dark arrow, then another, and a third, and immediately after the air was filled with a long doleful howl."
                            }
                        ]
                    }
