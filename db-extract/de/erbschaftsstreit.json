                                        "sense_id": "3f008cea-2823-3dd1-ab74-fd44acb654f8",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
                                            "An automobile with a streamlined profile and a folding or detachable soft top, and having the hood or bonnet line raised to be level with the car's waistline, resulting in a straight beltline from front to back."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8ab72d79-447a-32c1-a7d5-e500e252f7bc",
                                        "entry_id": "0425cee7-93b9-3aac-a30c-86d34d60c8a0",
                                        "glosses": [
                                            "A focal ovoid swelling on the axons of Purkinje cells, observed in several diseases such as essential tremor and spinocerebellar ataxia."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64dcba34-08c1-4dd9-8960-1a3b50f57651",
                                                "sense_id": "8ab72d79-447a-32c1-a7d5-e500e252f7bc",
                                                "text": "In several human neurodegenerative diseases, focal axonal swellings on Purkinje cells – known as torpedoes – have been associated with Purkinje cell loss. Interestingly, torpedoes are also reported to appear transiently during development in rat cerebellum."
                                            }
                                        ]
                                    },
