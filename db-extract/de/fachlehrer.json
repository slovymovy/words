                "senses": [
                    {
                        "sense_id": "067c9864-8be9-3bff-927c-e5bbe150d4cd",
                        "entry_id": "775bbf40-6d66-3a8f-b752-8d5aaad893ab",
                        "glosses": [
                            "Lehrer, der für ein oder mehrere bestimmte Fächer eine Lehrbefähigung erworben hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6adc8ab5-7fb1-411a-afa0-2c8c4b48cbaf",
                                "sense_id": "067c9864-8be9-3bff-927c-e5bbe150d4cd",
                                "text": "„In einigen Bundesländern war auch ein Berufseinstieg ohne Studium als Fachlehrer möglich.“"
                            },
                            {
                                "example_id": "16294d8e-41c6-4265-ba99-58642951ec6d",
                                "sense_id": "067c9864-8be9-3bff-927c-e5bbe150d4cd",
                                "text": "„Der Unterricht ist durch Fachlehrer zu erteilen.“"
                            },
                            {
                                "example_id": "cdd67ec8-04d1-4f5e-99d9-96f019fcbfaa",
                                "sense_id": "067c9864-8be9-3bff-927c-e5bbe150d4cd",
                                "text": "„Die Ausbildung der Fachlehrer erfolgt am Staatsinstitut für die Ausbildung von Fachlehrern“"
                            },
                            {
                                "example_id": "2e1a359d-b719-40db-9e57-9088ff95cf78",
                                "sense_id": "067c9864-8be9-3bff-927c-e5bbe150d4cd",
                                "text": "„Der Fachlehrer hat zum Beginn seines Unterrichts bekanntzugeben, wie er in der Regel die verschiedenen Leistungen bei der Notenbildung gewichten wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
