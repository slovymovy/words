                        "glosses": [
                            "Devenir tuberculeux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1508b17-c18c-46f3-a81e-127ec5b7009c",
                                "sense_id": "3e88e3cc-ee3e-3ee8-bb32-61914798ca7d",
                                "text": "Se tuberculosent de préférence, les mal nés, les mal bâtis, organismes dont les matériaux s'usent prématurément."
                            },
                            {
                                "example_id": "b4e2d36b-b22a-40f4-a975-fc13ce0162f2",
                                "sense_id": "3e88e3cc-ee3e-3ee8-bb32-61914798ca7d",
                                "text": "Comme tout le monde, M. Neisser a fait des injections diagnostiques de tuberculine et comme tout le monde il a constaté que parmi ceux qui réagissaient positivement, bon nombre ne se tuberculosaient pas plus tard."
                            },
                            {
                                "example_id": "85dcc787-b3bc-4ae4-8dca-8b2a85bcb84e",
                                "sense_id": "3e88e3cc-ee3e-3ee8-bb32-61914798ca7d",
                                "text": "En sus de ces escapades champêtres de plus en plus fréquentes, pour éviter qu'il s'étiolât, qu'il (« on ne sait jamais ») se tuberculosât dans l'air champignonneux du cagibi, on envoyait J, fort aise, se rechlorophyller pour des périodes longues à la campagne."
                            }
                        ]
                    }
