                    }
                ],
                "senses": [
                    {
                        "sense_id": "3db25a0f-9dad-39a8-bc0e-00e71473a5b5",
                        "entry_id": "d6762d31-1a95-304a-b1b4-181f06eea62b",
                        "glosses": [
                            "Assemblage de poulies et de cordages, dont on se sert soit pour exécuter des manœuvres à bord des navires, soit pour soulever de pesants fardeaux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65ec2c15-5f31-4200-a9d5-fba4092174d8",
                                "sense_id": "3db25a0f-9dad-39a8-bc0e-00e71473a5b5",
                                "text": "Les matelots halèrent le monstrueux squale au moyen d’un palan frappé à l’extrémité de la grande vergue."
                            },
                            {
                                "example_id": "32d5135c-6a9e-454a-91f8-e5ba65b300a7",
                                "sense_id": "3db25a0f-9dad-39a8-bc0e-00e71473a5b5",
                                "text": "Au moyen de palans je « roidis » les étais et j’amarre le beaupré aussi solidement qu’il est possible sur le pont maintenant rasé à l’avant."
                            }
                        ]
                    },
                    {
                        "sense_id": "edc1befc-fdd6-3d3f-bbaf-c8f26f0595c1",
                        "entry_id": "d6762d31-1a95-304a-b1b4-181f06eea62b",
                        "glosses": [
                            "Assemblage de poulies et de cordages ou de chaînes utilisé pour soulever des objets pesants."
                        ],
                        "tags": [
                            "Québec"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "133d525d-ba42-4b56-8962-48552c749ee5",
                        "source_entry_id": "d6762d31-1a95-304a-b1b4-181f06eea62b",
                        "target_lang_word": "Flaschenzug",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flaschenzug",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a8127032-b71f-32c5-8155-29425a3b51d2",
                                        "entry_id": "766500b7-54ec-37cd-b3b0-ae839e521532",
                                        "glosses": [
                                            "eine aus festen Rollen und/oder losen Rollen und einem Seil oder Ähnlichem bestehende technische Vorrichtung zum Bewegen von Lasten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5ee857b-7494-48ad-9590-9f8124d3ce03",
                                                "sense_id": "a8127032-b71f-32c5-8155-29425a3b51d2",
                                                "text": "Kranen ist das mechanische Prinzip des Flaschenzuges zu Grunde gelegt."
                                            },
                                            {
                                                "example_id": "47d06d09-fc9e-4ef3-8f46-9a1bed871d38",
                                                "sense_id": "a8127032-b71f-32c5-8155-29425a3b51d2",
                                                "text": "„Mit dem einen Fuß stand er auf dem schmalen Sims, der andere hing irgendwo in 15 Metern Höhe in der Luft, während er sich nach oben reckte, um den Flaschenzug in dem dafür vorgesehenen Eisenring am Querbalken zu verankern.“"
                                            },
                                            {
                                                "example_id": "fee2c9ad-1f67-4154-8055-8e46594b2e3e",
                                                "sense_id": "a8127032-b71f-32c5-8155-29425a3b51d2",
                                                "text": "„Mit einem Flaschenzug senken sie es dann langsam hinab auf den hölzernen Steg.“"
                                            },
                                            {
                                                "example_id": "b5c38520-872a-4295-9ad5-a225e860059b",
                                                "sense_id": "a8127032-b71f-32c5-8155-29425a3b51d2",
                                                "text": "„Sie montierten einen Flaschenzug an einem Davit, den Mansfield benutzte, um seine Boote aus dem Wasser zu hieven, wenn er sie reinigen und anstreichen wollte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b46c3f41-5654-4adb-ac02-24a7604c10c2",
                        "source_entry_id": "d6762d31-1a95-304a-b1b4-181f06eea62b",
                        "target_lang_word": "palanc",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "9586f1a0-1795-43f0-b391-81ab716ef461",
                        "source_entry_id": "d6762d31-1a95-304a-b1b4-181f06eea62b",
                        "target_lang_word": "hoist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hoist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To raise; to lift; to elevate (especially, to raise or lift to a desired elevation, by means of tackle or pulley, said of a sail, a flag, a heavy package or weight)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0368034-116d-455c-a6a9-1e5f5dc86dd0",
                                                "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                                "text": "For tis the ſport to haue the enginer / Hoiſt with his ovvne petar, an't ſhall goe hard / But I vvill delue one yard belovve their mines, / And blovve them at the Moone: […]",
                                                "translation": "For it's amusing to have the engineer / Lifted into the sky with his own explosive, and if I'm lucky / I will dig one yard below their mines, / And blow them towards the Moon: […]",
                                                "english": "For it's amusing to have the engineer / Lifted into the sky with his own explosive, and if I'm lucky / I will dig one yard below their mines, / And blow them towards the Moon: […]"
                                            },
                                            {
                                                "example_id": "ccb3c2a1-3df6-441e-bcc2-4e7e6455cef4",
                                                "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                                "text": "They land my goods, and hoist my flying sails."
                                            },
                                            {
                                                "example_id": "68fa80e1-04ed-4121-a726-709db07a2a17",
                                                "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                                "text": "[Abasalom's] ambition would needs be fingering the sceptre, and hoisting him into his father's throne"
                                            },
                                            {
                                                "example_id": "c882e716-f9ef-461c-83d7-30237f5b8cbd",
                                                "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                                "text": "[…] but this last was so heavy, I could not hoist it up to get it over the ship's side."
                                            },
                                            {
                                                "example_id": "bb28a741-0fdc-4c1b-b366-5e838858725c",
                                                "sense_id": "99812412-d0e6-3cc7-811b-a6da2b0ab1e1",
                                                "text": "Between us, with much trouble, we managed to hoist him upstairs, and laid him on his bed, where his head fell back on the pillow, as if he were almost fainting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3db8fd15-f769-36e0-b208-b4de46599bbb",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To lift a trophy or similar prize into the air in celebration of a victory."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "often",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "984ed3ad-9731-4a72-8b20-a778c5e2428f",
                                                "sense_id": "3db8fd15-f769-36e0-b208-b4de46599bbb",
                                                "text": "And when skipper Richie McCaw hoisted the Webb Ellis Trophy high into the night, a quarter of a century of hurt was blown away in an explosion of fireworks and cheering."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86f4653-0f20-34b1-b8bb-93ecb7212c69",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To lift someone up to be flogged."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c2b7d61-c97c-4b2d-8949-c49a5a3e21d3",
                                                "sense_id": "d86f4653-0f20-34b1-b8bb-93ecb7212c69",
                                                "text": "Again Pilatus answered them, What shall I do to the Jew’s king? They again cried out and said, Hoist him! Then said Pilatus, What evil did he? They so much the more cried, Hoist him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c25d1597-aec0-3412-a032-63ac7e2f6fc2",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To be lifted up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "208731fd-82b6-3f93-8cf6-59465e4e034c",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To extract (code) from a loop construct as part of optimization."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "67187df8-6796-30f4-98f4-e8f518919ad7",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To steal."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff2e5111-e937-47a8-8dd9-00a7cf0449d3",
                                                "sense_id": "67187df8-6796-30f4-98f4-e8f518919ad7",
                                                "text": "When you’ve reached neutral territory, when you’ve stashed the loot hoisted from the warlord’s mansion – well, he didn't have much use for it any more, did he?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "155ffab3-c689-3cb0-a331-660590a8838b",
                                        "entry_id": "da5685ca-7b81-31ab-b559-0bafb50114c3",
                                        "glosses": [
                                            "To rob."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e5cb235-6ef6-459f-932f-1ac45e76f06a",
                                                "sense_id": "155ffab3-c689-3cb0-a331-660590a8838b",
                                                "text": "Why, it was nothing to travel about the country with fifty grand worth of ice on me. Suppose I hadn’t packed a roscoe—hell, I’d of been hoisted once a week!"
                                            }
                                        ]
                                    }
                                ]
                            },
