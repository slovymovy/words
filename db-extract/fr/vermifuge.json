                            {
                                "target_word": "worming",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27e6b93e-3b7b-3e21-946d-6f0e12105bf3",
                                        "entry_id": "3aa0acb8-8ca8-334b-8c4e-bcebad55922d",
                                        "glosses": [
                                            "The act by which an animal is wormed."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22cec72e-6014-436b-88df-f10e84105fb3",
                                                "sense_id": "27e6b93e-3b7b-3e21-946d-6f0e12105bf3",
                                                "text": "[…] you will need to spend a lot more time training and socializing your Beagle, and must endure the sometimes difficult stages of teething, chewing, adolescent exuberance, and frequent veterinarian visits for vaccinations and wormings."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37d339d4-b94d-3293-b5e8-3e51c6b82b0e",
                                        "entry_id": "3aa0acb8-8ca8-334b-8c4e-bcebad55922d",
                                        "glosses": [
                                            "The tendency of certain yarn or thread to bunch up after being woven."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "745778ed-53cd-45f1-ac86-e43d017d3bd9",
                                                "sense_id": "37d339d4-b94d-3293-b5e8-3e51c6b82b0e",
                                                "text": "The other thing you can do is stick with yarns that don't have a reputation for worming."
                                            },
                                            {
                                                "example_id": "d7d8967c-5710-4c5e-8c8e-c90f5d47cda8",
                                                "sense_id": "37d339d4-b94d-3293-b5e8-3e51c6b82b0e",
                                                "text": "I think the smaller hook gave better results, with the larger leading to the unappetizing \"worming\" of chenille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
