                        "tags": [],
                        "examples": [
                            {
                                "example_id": "517a290b-eee1-4abf-a1fa-dec98e8b7587",
                                "sense_id": "11fd7d64-29f5-3fa8-9f81-2261e55c2b0d",
                                "text": "У этого спектакля был трудный путь, как и у всех тогда пьес Михаила Афанасьевича Булгакова."
                            },
                            {
                                "example_id": "f0778c78-ae14-448a-92c9-c02f5c0ec957",
                                "sense_id": "11fd7d64-29f5-3fa8-9f81-2261e55c2b0d",
                                "text": "Слегка прихрамывая, Григорий Афанасьевич шёл берегом моря."
                            },
                            {
                                "example_id": "021b36b2-ee14-48f6-b925-9954bee27c70",
                                "sense_id": "11fd7d64-29f5-3fa8-9f81-2261e55c2b0d",
                                "text": "Теперь должен я благосклонного читателя познакомить с Гаврилою Афанасьевичем Ржевским."
                            }
                        ]
                    }
