                "senses": [
                    {
                        "sense_id": "f54de656-ed15-399c-8398-08dbad1bcf5c",
                        "entry_id": "bc7b851d-9e93-397f-8193-a3fd5314489c",
                        "glosses": [
                            "Épancher sa hargne ; dire avec hargne."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "8d6ee343-ca7b-4fdc-99f1-0e2e4579f68f",
                                "sense_id": "f54de656-ed15-399c-8398-08dbad1bcf5c",
                                "text": "Toutes les robes sombres, les corsages plats et les faces jaunes, pucelles, veuves et vieilles filles, aigres comme leur cidre, sont accourues pour voir, écouter, hargner."
                            },
                            {
                                "example_id": "3565749f-ca58-49ac-83e5-a913b67e90d8",
                                "sense_id": "f54de656-ed15-399c-8398-08dbad1bcf5c",
                                "text": "C'est ce qui arriva à Fréron, ce voleur mesquin, ce bavard sans talent qui hargnait contre tout le monde: […]."
                            },
                            {
                                "example_id": "cf17cfc3-c5c4-4fff-bab6-5f12b3913be5",
                                "sense_id": "f54de656-ed15-399c-8398-08dbad1bcf5c",
                                "text": "Les dogues grondaient terriblement, hargnaient contre l'énorme bête qui, de ses pattes griffues et du mufle menaçant, les écartait, enlevant, à chaque coup, un peu de chair, de poil et de peau mêlés."
                            }
                        ]
                    }
                ],
