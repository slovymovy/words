                            }
                        },
                        {
                            "text": "De <w>bekroning</w> met een gouden medaille maakte het toernooi onvergetelijk.",
                            "target_lang_translations": {
                                "en": "The <w>award</w> of a gold medal made the tournament unforgettable."
                            }
                        }
                    ],
                    "synonyms": [
