                "senses": [
                    {
                        "sense_id": "0acec347-8098-3deb-a438-f26c5ea224a8",
                        "entry_id": "f20a8665-3ac4-3d7a-bebd-fb46ad95120d",
                        "glosses": [
                            "Wiederbelebung einer ausgestorbenen oder vom Aussterben bedrohten Sprache"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f701cf29-3314-4cf5-8e88-9ac71bc1ff5b",
                                "sense_id": "0acec347-8098-3deb-a438-f26c5ea224a8",
                                "text": "Das Ivrit (modernes Hebräisch) ist ein gutes Beispiel für Sprachrevitalisierung: Hier wurde eine fast ausgestorbene Sprache erfolgreich wiederbelebt und zur Staatssprache Israels erhoben."
                            },
                            {
                                "example_id": "b5eef018-2037-4696-be0b-1a0ad815810c",
                                "sense_id": "0acec347-8098-3deb-a438-f26c5ea224a8",
                                "text": "Als Sprachrevitalisierungen kann man auch die Bemühungen auffassen, die deutschen Dialekte oder Regionalsprachen (z.B. Friesisch, Niederdeutsch) zu erhalten."
                            },
                            {
                                "example_id": "50fc5af8-a15d-4cd9-a4c3-d398ebe84451",
                                "sense_id": "0acec347-8098-3deb-a438-f26c5ea224a8",
                                "text": "Jeroen Darquennes „ist u.a. Mitverfasser von Aufsätzen über Deutsch in Ostbelgien, über die kroatische und ungarische Minderheit im Burgenland und über Sprachrevitalisierung in Europa.“"
                            },
                            {
                                "example_id": "b97b8fb0-b8a8-48c8-94c5-1968392c5e94",
                                "sense_id": "0acec347-8098-3deb-a438-f26c5ea224a8",
                                "text": "Sprachrevitalisierung wird als eines der Ziele des Sorbischunterrichts ausdrücklich so genannt: „Einblick gewinnen in die Sprache der Niedersorben - Sprachvergleich - Literatur - Sprachrevitalisierung“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
