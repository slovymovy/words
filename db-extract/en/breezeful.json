                ],
                "senses": [
                    {
                        "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                        "entry_id": "09efa943-ed01-37b0-a394-6754bf048cfb",
                        "glosses": [
                            "An amount carried in a breeze."
                        ],
                        "tags": [
                            "uncommon"
                        ],
                        "examples": [
                            {
                                "example_id": "89b324ec-8460-41eb-9da3-476e2ba46993",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "Quickly she looked left and right, then left again, like doing her kerb drill. There was no one, only a breezeful of leaves and an empty Embassy cigarette packet in the gutter."
                            },
                            {
                                "example_id": "2d81d602-dfca-4ea6-b057-824edbc4f611",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "For if a cupful of mint tea or a spoonful of mint jelly is a tonic for frayed nerves, how much more powerful its curative properties would be if mixed with a skyful of sunshine and floating clouds and a breezeful of woodsy scents."
                            },
                            {
                                "example_id": "f08d659c-700b-4bc6-bce4-55c9542e9c49",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "One tree could let loose a whole breezeful of millions, even billions, of spores."
                            },
                            {
                                "example_id": "e3aad352-146c-4fb8-bf38-8a553419fa1b",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "Over the border of the dawn\nFar as the blue Atlantic sky,\nThe white birds of the sea go on\nIn breezefuls, wailing as they fly."
                            },
                            {
                                "example_id": "c3325381-74f8-41ae-be11-4ae3d927b2b9",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "She coughed as a breezeful of dust came in from the window."
                            },
                            {
                                "example_id": "9f74a395-9530-4a8c-b2e8-47c5349a6b56",
                                "sense_id": "177a4ebf-7a3f-3910-aae0-0a14e54c6ef2",
                                "text": "He squeezes onto the metal bleacher beside me and I catch a breezeful of his cinnamony smell."
                            }
                        ]
                    }
                ],
