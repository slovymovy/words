                                    },
                                    {
                                        "sense_id": "a76805fc-5a63-3bed-b91c-c681dc9af31c",
                                        "entry_id": "a8bef8af-339c-3637-b2e5-5aa211ad727d",
                                        "glosses": [
                                            "помещать вперемежку с кем-либо, чем-либо, чередуя друг с другом или беспорядочно"
