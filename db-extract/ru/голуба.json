                            {
                                "example_id": "9fa33efa-9104-452e-9307-ecf935502678",
                                "sense_id": "cd18e1e9-9366-3681-a6fa-650c293af693",
                                "text": "Наконец капитан спрашивает: \"А чего вы, голуба, в данный секунд делаете?"
                            },
                            {
                                "example_id": "effb291f-4adc-4791-8091-41f5cab61b32",
                                "sense_id": "cd18e1e9-9366-3681-a6fa-650c293af693",
                                "text": "Отдохни, голуба, запарилась."
                            },
                            {
                                "example_id": "d835d405-0e77-47d3-a2b5-e29bc0dbf267",
                                "sense_id": "cd18e1e9-9366-3681-a6fa-650c293af693",
                                "text": "Эх, Феденька, Феденька, голуба-душа!"
                            }
                        ]
                    }
