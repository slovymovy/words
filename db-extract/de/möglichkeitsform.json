                "senses": [
                    {
                        "sense_id": "2f8b0e29-8bdd-39c0-b6b3-19fe46bbbefc",
                        "entry_id": "eded6d75-ed7e-3069-9e55-a449512a3d13",
                        "glosses": [
                            "deutsche Bezeichnung für Konjunktiv"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2d44d71f-dc4c-4f6b-aad5-6cb7b09751e0",
                                "sense_id": "2f8b0e29-8bdd-39c0-b6b3-19fe46bbbefc",
                                "text": "„Der Mann behauptete, er hätte mich gesehen.“ Das Wort „hätte“ steht in der Möglichkeitsform."
                            },
                            {
                                "example_id": "7218ef68-b2d3-47a4-b95d-eaa25571a723",
                                "sense_id": "2f8b0e29-8bdd-39c0-b6b3-19fe46bbbefc",
                                "text": "„Noch haben wir in Deutschland diese Möglichkeitsform, den Konjunktiv, und können auf diese Weise unterscheiden zwischen dem, was wirklich ist, und dem, was geschehen könnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
