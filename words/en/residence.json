{
    "word_family": [
        "resident",
        "residential",
        "reside",
        "residency",
        "non-resident"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "334fb19c-31f4-3b3d-8e91-82aeebf86d31",
                    "sense_definition": "The place where a person lives or has their home.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "living_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After many years of traveling, he finally established his permanent <w>residence</w> in London.",
                            "target_lang_translations": {
                                "ru": "После многих лет путешествий он, наконец, обосновался на постоянное <w>местожительство</w> в Лондоне.",
                                "zh": "多年漂泊后，他终于在伦敦定居，确立了永久<w>住所</w>。"
                            }
                        },
                        {
                            "text": "The police arrived at the private <w>residence</w> to investigate the noise complaint.",
                            "target_lang_translations": {
                                "ru": "Полиция прибыла в частное <w>жилище</w>, чтобы расследовать жалобу на шум.",
                                "zh": "警察来到这处私人<w>住宅</w>调查噪音投诉。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "private residence",
                        "permanent residence",
                        "place of residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где человек живет или где находится его дом.",
                        "zh": "一个人居住或拥有住所的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местожительство",
                                "target_lang_sense_clarification": "официальное или фактическое место проживания"
                            },
                            {
                                "target_lang_word": "жительство",
                                "target_lang_sense_clarification": "факт или место проживания"
                            },
                            {
                                "target_lang_word": "проживание",
                                "target_lang_sense_clarification": "процесс или место нахождения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "住所",
                                "target_lang_sense_clarification": "正式或实际的居住地"
                            },
                            {
                                "target_lang_word": "住处",
                                "target_lang_sense_clarification": "居住的地方"
                            },
                            {
                                "target_lang_word": "居住地",
                                "target_lang_sense_clarification": "居住的地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6cdc7691-4693-3ae2-8202-7f5be9e3c9d0",
                    "sense_definition": "A large or impressive house or building used as a home.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "living_place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The official <w>residence</w> of the president is heavily guarded at all times.",
                            "target_lang_translations": {
                                "ru": "Официальная <w>резиденция</w> президента круглосуточно находится под усиленной охраной.",
                                "zh": "总统的<w>官邸</w>时刻都有重兵把守。"
                            }
                        },
                        {
                            "text": "They moved into a palatial <w>residence</w> overlooking the cliffs of the coast.",
                            "target_lang_translations": {
                                "ru": "Они переехали в роскошную <w>резиденцию</w> с видом на прибрежные скалы.",
                                "zh": "他们搬进了一座俯瞰海岸悬崖的豪华<w>宅邸</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "official residence",
                        "stately residence",
                        "summer residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой или впечатляющий дом или здание, используемое в качестве жилища.",
                        "zh": "用作住宅的大型或宏伟的房屋或建筑。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резиденция",
                                "target_lang_sense_clarification": "официальное или величественное здание"
                            },
                            {
                                "target_lang_word": "жилище",
                                "target_lang_sense_clarification": "место обитания, дом"
                            },
                            {
                                "target_lang_word": "дом",
                                "target_lang_sense_clarification": "здание для жилья"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "官邸",
                                "target_lang_sense_clarification": "官员的正式住所"
                            },
                            {
                                "target_lang_word": "宅邸",
                                "target_lang_sense_clarification": "宏伟的住宅"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d2535a78-d313-3585-be78-1fee2929ddd8",
                    "sense_definition": "Accommodation provided for students at a university or college.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "accommodation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most first-year students prefer to live in a hall of <w>residence</w> on campus.",
                            "target_lang_translations": {
                                "ru": "Большинство первокурсников предпочитают жить в <w>общежитии</w> на территории кампуса.",
                                "zh": "大多数大一新生更喜欢住在校园里的<w>宿舍</w>。"
                            }
                        },
                        {
                            "text": "The university is building a new student <w>residence</w> to house the growing population.",
                            "target_lang_translations": {
                                "ru": "Университет строит новое студенческое <w>общежитие</w>, чтобы разместить растущее число студентов.",
                                "zh": "大学正在建造一栋新的学生<w>宿舍</w>以容纳不断增加的学生人数。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hall of residence",
                        "student residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Жилье, предоставляемое студентам в университете или колледже.",
                        "zh": "大学或学院为学生提供的住宿。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "общежитие",
                                "target_lang_sense_clarification": "студенческое или рабочее"
                            },
                            {
                                "target_lang_word": "резиденция",
                                "target_lang_sense_clarification": "в контексте студенческого городка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宿舍",
                                "target_lang_sense_clarification": "学生或员工的集体居住场所"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c16ef155-8d02-3ae4-ae0b-1711bc533a41",
                    "sense_definition": "The fact or state of living in a particular place for a period of time.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You must prove five years of continuous <w>residence</w> to apply for citizenship.",
                            "target_lang_translations": {
                                "ru": "Для подачи заявления на гражданство вы должны подтвердить пять лет непрерывного <w>проживания</w>.",
                                "zh": "你必须证明已连续<w>居住</w>五年才能申请公民身份。"
                            }
                        },
                        {
                            "text": "The artist was granted a right of <w>residence</w> in the country after the exhibition.",
                            "target_lang_translations": {
                                "ru": "После выставки художнику было предоставлено право на <w>пребывание</w> в стране.",
                                "zh": "展览结束后，这位艺术家被授予了在该国的<w>居留</w>权。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "right of residence",
                        "continuous residence",
                        "period of residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Факт или состояние проживания в определенном месте в течение определенного периода времени.",
                        "zh": "在特定地点居住一段时间的事实或状态。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проживание",
                                "target_lang_sense_clarification": "факт нахождения в стране или городе"
                            },
                            {
                                "target_lang_word": "пребывание",
                                "target_lang_sense_clarification": "временное нахождение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "居住",
                                "target_lang_sense_clarification": "长期或短期的生活状态"
                            },
                            {
                                "target_lang_word": "居留",
                                "target_lang_sense_clarification": "在某地停留或居住的法律状态"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ac5c099c-1764-315f-ad4a-6b8b1b98d347",
                    "sense_definition": "The location where a corporation or organization is legally established.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "legal_status",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company changed its corporate <w>residence</w> to a country with lower tax rates.",
                            "target_lang_translations": {
                                "ru": "Компания сменила свое юридическое <w>местонахождение</w> на страну с более низкими налоговыми ставками.",
                                "zh": "该公司将其<w>注册地</w>迁至税率较低的国家。"
                            }
                        },
                        {
                            "text": "Determining the legal <w>residence</w> of a multinational firm can be a complex process.",
                            "target_lang_translations": {
                                "ru": "Определение юридического <w>местонахождения</w> транснациональной фирмы может быть сложным процессом.",
                                "zh": "确定跨国公司的法律<w>注册地</w>可能是一个复杂的过程。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate residence",
                        "legal residence"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "legal and business context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Место, где корпорация или организация официально зарегистрирована.",
                        "zh": "公司或组织合法设立的地点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "местонахождение",
                                "target_lang_sense_clarification": "юридический адрес компании"
                            },
                            {
                                "target_lang_word": "местопребывание",
                                "target_lang_sense_clarification": "официальный адрес организации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "注册地",
                                "target_lang_sense_clarification": "公司法律上的注册地点"
                            },
                            {
                                "target_lang_word": "总部所在地",
                                "target_lang_sense_clarification": "机构的主要办公地点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2a275fc7-8f8d-3133-a577-0b3bd0ba2ee1",
                    "sense_definition": "A base of operations for a foreign intelligence service in a country.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "espionage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The spy was recalled to the <w>residence</w> for an urgent briefing on the mission.",
                            "target_lang_translations": {
                                "ru": "Шпион был отозван в <w>резидентуру</w> для срочного инструктажа по заданию.",
                                "zh": "间谍被召回<w>情报站</w>，接受关于任务的紧急简报。"
                            }
                        },
                        {
                            "text": "Intelligence officers often work under cover within a legal <w>residence</w> at an embassy.",
                            "target_lang_translations": {
                                "ru": "Сотрудники разведки часто работают под прикрытием в рамках легальной <w>резидентуры</w> при посольстве.",
                                "zh": "情报官员经常以大使馆的合法<w>驻外机构</w>为掩护进行工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rezidentura"
                    ],
                    "common_phrases": [
                        "legal residence"
                    ],
                    "target_lang_definitions": {
                        "ru": "База операций иностранной разведки в какой-либо стране.",
                        "zh": "外国情报机构在某国的行动基地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "резидентура",
                                "target_lang_sense_clarification": "разведывательный центр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "情报站",
                                "target_lang_sense_clarification": "情报机构的驻外据点"
                            },
                            {
                                "target_lang_word": "驻外机构",
                                "target_lang_sense_clarification": "在国外的秘密据点"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1cfb7f64-8ba1-31a2-afb8-75dd4055c409",
                    "sense_definition": "Matter that settles to the bottom of a liquid; sediment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "physical_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The chemist observed a thick <w>residence</w> at the bottom of the flask after the reaction.",
                            "target_lang_translations": {
                                "ru": "Химик заметил густой <w>осадок</w> на дне колбы после реакции.",
                                "zh": "化学家观察到反应后烧瓶底部有厚厚的<w>沉淀物</w>。"
                            }
                        },
                        {
                            "text": "The muddy <w>residence</w> in the wine indicated that it had not been filtered properly.",
                            "target_lang_translations": {
                                "ru": "Мутный <w>осадок</w> в вине указывал на то, что оно не было отфильтровано должным образом.",
                                "zh": "酒中浑浊的<w>沉淀物</w>表明它没有经过妥善过滤。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "rarely used in modern scientific English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество, которое оседает на дно жидкости; осадок.",
                        "zh": "沉淀在液体底部的物质；沉淀物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осадок",
                                "target_lang_sense_clarification": "вещество на дне"
                            },
                            {
                                "target_lang_word": "отстой",
                                "target_lang_sense_clarification": "осевшая муть"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "沉淀物",
                                "target_lang_sense_clarification": "液体中沉下的物质"
                            },
                            {
                                "target_lang_word": "残渣",
                                "target_lang_sense_clarification": "剩下的渣滓"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}