        "nl-extract.jsonl": [
            {
                "entry_id": "4aae55a4-c7b5-3bbd-9a75-937a319e2909",
                "word": "aangepast",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "2154c1e6-c3a3-332f-aa3d-a1eddc501ff8",
                        "entry_id": "4aae55a4-c7b5-3bbd-9a75-937a319e2909",
                        "glosses": [
                            "geschikt gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb4a10de-d4c8-4292-ac99-5e4225fb5d47",
                                "sense_id": "2154c1e6-c3a3-332f-aa3d-a1eddc501ff8",
                                "text": "„In het aangepaste plan zijn we met de vereniging overeengekomen dat de bestaande buitenmanege wordt uitgebreid en ingepast in de glooiende Rijssense Es”, zegt wethouder Roland Cornelissen."
                            },
                            {
                                "example_id": "6935b2b2-e10c-41bc-bce6-0d1e50211a01",
                                "sense_id": "2154c1e6-c3a3-332f-aa3d-a1eddc501ff8",
                                "text": "Het gaat voorlopig niet om vaccins die aan nieuwe varianten zijn aangepast. \"Zodra er aangepaste vaccins zijn, zullen we die gebruiken\", zegt federaal minister van Volksgezondheid Frank Vandenbroucke. \"We weten wel dat de huidige vaccins nu nog altijd heel goed beschermen tegen ziekenhuisopnames en zware ziekte.\""
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
                    {
                        "linkage_id": "e36caac4-3ce5-4344-9b51-e02106142ddf",
                        "source_entry_id": "4aae55a4-c7b5-3bbd-9a75-937a319e2909",
                        "source_sense_ids": [
                            "2154c1e6-c3a3-332f-aa3d-a1eddc501ff8"
                        ],
