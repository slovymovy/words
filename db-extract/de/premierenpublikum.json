                "senses": [
                    {
                        "sense_id": "8f874eb0-e1fd-3d10-98de-ffed606a831d",
                        "entry_id": "9e92625e-bc40-38a3-b0a0-d633d3fe8af9",
                        "glosses": [
                            "bei einer Premiere anwesendes Publikum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5f6d2bbf-63f0-4a76-9a3b-a5818936bc64",
                                "sense_id": "8f874eb0-e1fd-3d10-98de-ffed606a831d",
                                "text": "Das Premierenpublikum erwartete sehnsüchtig die Öffnung des Vorhangs."
                            },
                            {
                                "example_id": "e7ca3f5c-ccf3-47ef-902c-b61bcaf0bdb8",
                                "sense_id": "8f874eb0-e1fd-3d10-98de-ffed606a831d",
                                "text": "„Charles Chaplins Film »Goldrausch« begeistert das New Yorker Premierenpublikum und wird bald zum populärsten Werk des Komikers.“"
                            },
                            {
                                "example_id": "e5e2b996-7d19-43ed-aae5-2a33bb0ebbb4",
                                "sense_id": "8f874eb0-e1fd-3d10-98de-ffed606a831d",
                                "text": "„Ich hatte das Gefühl, daß der Großteil des Premierenpublikums das Stück (das in Deutschland gut bekannt war und noch ist) und den von den Nazis exilierten Autor wohlwollend aufnehmen werde.“"
                            },
                            {
                                "example_id": "eb86167f-dbd4-47ce-9348-4c422657156e",
                                "sense_id": "8f874eb0-e1fd-3d10-98de-ffed606a831d",
                                "text": "„Viel Jubel des Premierenpublikums, der Autor verbeugt sich mit den Darstellern auf der Bühne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
