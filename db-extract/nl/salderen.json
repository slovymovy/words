                        ],
                        "examples": [
                            {
                                "example_id": "6ef01451-3d7c-4798-9374-d392e882d235",
                                "sense_id": "4047f359-c255-3c35-a444-77aadb0e1bd5",
                                "text": "Je kunt met salderen je zonnepanelen terugverdienen.",
                                "translation": "You can recover the costs of solar panels by net metering.",
