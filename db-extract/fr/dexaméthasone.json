            {
                "entry_id": "cc65ac08-aabb-3674-af44-b1777a384919",
                "word": "dexaméthasone",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                        "entry_id": "cc65ac08-aabb-3674-af44-b1777a384919",
                        "glosses": [
                            "Dénomination commune internationale (D.C.I.) d'un glucocorticoïde de synthèse ayant un effet anti-inflammatoire et immunosuppresseur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7da222be-dc57-4ad0-aeca-2b1b14ab4ed7",
                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                "text": "Le freinage des surrénales est habituellement réalisé par la dexaméthasone."
                            },
                            {
                                "example_id": "f08ee600-5df3-4530-8ad8-5baf35c6c98e",
                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                "text": "L’administration dans ce cas de dexamétazone fait chuter la testostéronémie au taux du premier type."
                            },
                            {
                                "example_id": "c6de549c-2c82-42de-9e9d-3031cf48bf14",
                                "sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
                                "text": "On a découvert un test dit à la dexamétazone, qui est positif si on est déprimé, en ce sens que l’hypophyse ne répond plus."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f3c4ad94-e8b5-478a-be3f-0921694979ab",
                        "source_entry_id": "cc65ac08-aabb-3674-af44-b1777a384919",
                        "source_sense_id": "f9150e52-0b39-3abd-ba13-7143a07b15ea",
