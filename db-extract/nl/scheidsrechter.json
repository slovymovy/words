                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5fc5de2c-bda2-4be4-9e49-a69b1b4f5f68",
                                                "sense_id": "fc2d8b9c-3e9b-3285-a9e9-9de5dbf65225",
                                                "text": "Your application, along with letters from three referees, should be received by January 31."
