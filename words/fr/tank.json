    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c1e09b83-e934-3d53-864e-59fa1c2554cc",
                    "sense_definition": "Véhicule militaire blindé et lourdement armé, monté sur des chenilles.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "militaire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Une colonne de plusieurs <w>tanks</w> avançait lentement vers la frontière."
                        },
                        {
                            "text": "Le soldat a appris à manœuvrer un <w>tank</w> pendant son entraînement militaire."
                        }
                    ],
                    "synonyms": [
                        "char",
                        "char d'assaut",
                        "char de combat"
                    ],
                    "common_phrases": [
                        "colonnes de tanks"
                    ]
                },
                {
                    "sense_id": "4d698cb1-1004-3f12-a84b-b2c293c87422",
                    "sense_definition": "Automobile très grande, lourde, encombrante ou difficile à manœuvrer.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vehicule",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il est particulièrement difficile de se garer en ville avec un tel <w>tank</w>."
                        },
                        {
                            "text": "Sa vieille berline américaine est un vrai <w>tank</w> qui consomme énormément de carburant."
                        }
                    ],
                    "common_phrases": [
                        "un vrai tank"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "familier"
                        }
                    ]
                },
                {
                    "sense_id": "6ff43fe1-f475-3ac7-b5fa-048727795c22",
                    "sense_definition": "Dans un jeu vidéo, personnage doté d'une forte résistance conçu pour attirer et encaisser les attaques ennemies afin de protéger ses partenaires.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "jeu_video",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans notre équipe de jeu en ligne, il joue toujours le rôle de <w>tank</w>."
                        },
                        {
                            "text": "Le chevalier sert de <w>tank</w> pour encaisser les attaques des monstres les plus puissants."
                        }
                    ],
                    "common_phrases": [
                        "rôle de tank"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "jargon des jeux vidéo"
                        }
                    ]
                },
                {
                    "sense_id": "b299aaf6-309d-37f4-b27a-936058e4b8c2",
                    "sense_definition": "Grande cuve fermée utilisée pour entreposer des fluides industriels ou du carburant.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contenant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les ouvriers nettoient régulièrement le grand <w>tank</w> contenant les réserves de mazout."
                        },
                        {
                            "text": "Ce <w>tank</w> industriel peut stocker des milliers de litres de produits chimiques."
                        }
                    ],
                    "synonyms": [
                        "réservoir"
                    ],
                    "common_phrases": [
                        "tank à pétrole",
                        "tank de stockage"
                    ]
                },
                {
                    "sense_id": "419da6f5-2c39-35f8-a361-e7d501bca293",
                    "sense_definition": "Cuve réfrigérée installée dans une exploitation agricole pour conserver le lait après la traite.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après la traite, le fermier verse la production du jour dans le <w>tank</w> à lait."
                        },
                        {
                            "text": "Le lait est conservé au frais dans le <w>tank</w> jusqu'au passage du camion de collecte."
                        }
                    ],
                    "common_phrases": [
                        "tank à lait"
                    ]
                },
                {
                    "sense_id": "d151256d-7413-3383-a656-47308a069b6a",
                    "sense_definition": "Cale ou compartiment étanche d'un navire destiné au transport de cargaisons liquides.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "maritime",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipage a inspecté avec précaution les <w>tanks</w> du navire après la traversée océanique."
                        },
                        {
                            "text": "Le pétrolier transporte des milliers de tonnes de brut réparties dans différents <w>tanks</w>."
                        }
                    ],
                    "synonyms": [
                        "réservoir"
                    ]
                }
            ]
        }
    ]
}