                ],
                "senses": [
                    {
                        "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                        "entry_id": "723c6257-ff87-37de-86c0-048cc7801600",
                        "glosses": [
                            "Lexikon, das Begriffe auflistet und erklärt, die zur Behandlung grammatischer Phänomene dienen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e65891a-931e-478f-b05c-c2dec36e767c",
                                "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                                "text": "„Das kleine Grammatiklexikon gibt rasch und zuverlässig Auskunft über die Grundbegriffe.“"
                            },
                            {
                                "example_id": "9370dfe6-62d5-433d-ac5c-3a69fbb6704e",
                                "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                                "text": "„Für den Weg bis dorthin überreichte der Vereinsvorsitzende, der selbst auf Lehramt studiert, noch ein dickes Paket mit Schulmaterialien, darunter einen ganzen Stapel ‚Duden‘-Bände, vom Wörterbuch über Synonym- bis zum Grammatiklexikon.“"
                            },
                            {
                                "example_id": "33874437-2f9d-4b07-83ea-70fb3e8df7a3",
                                "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                                "text": "„Durch die klare Struktur, die prägnante Darstellungsweise und den schülernahen Aufbau eignet sich Das kleine Grammatiklexikon besonders gut zur Vorbereitung auf Schulaufgaben, Klassenarbeiten und Tests.“"
                            },
                            {
                                "example_id": "50528640-5a2c-4e03-a277-20f889764e63",
                                "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                                "text": "„Daher nutzt man bei diesen Fragen ein Grammatiklexikon, ein Stilwörterbuch oder ein Wörterbuch für sprachliche Zweifelsfälle.“"
                            },
                            {
                                "example_id": "e1b87837-6a47-4e25-8d5c-f784e9d4a6bc",
                                "sense_id": "3f97e266-bca7-3bb6-9079-2b933a22d2b3",
                                "text": "Die Antwerpener Polyglotte enthält ebenfalls Zusätze in Form von einem Sprach- und Grammatiklexikon."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
