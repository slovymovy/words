                "translations": [
                    {
                        "translation_id": "fc784448-efb6-4492-839b-4d2e21476d67",
                        "source_entry_id": "272fa959-d16b-3298-a0de-61a7cc375647",
                        "source_sense_id": "2b2ef68f-5145-384e-be54-be3f459c8366",
                        "target_lang_word": "zentrifugal",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zentrifugal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b1c75418-e4a9-3b6d-837b-e66825da73cb",
                                        "entry_id": "dd97afca-400c-32e6-8e1b-5a6d9ec16f18",
                                        "glosses": [
                                            "von innen (von einer Rotationsachse sich entfernend) nach außen strebend; auch figurativ benutzt (und dann bei Bedarf auch mit Steigerung)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c84a807-b806-475a-8226-e5558306fcaf",
                                                "sense_id": "b1c75418-e4a9-3b6d-837b-e66825da73cb",
                                                "text": "„Das Hauptproblem des verfassten Europa sind die zentrifugalen Kräfte, die mit Macht zutage treten, wenn die Sonne der ökonomischen Prosperität einmal nicht scheint.“"
                                            },
                                            {
                                                "example_id": "3f9bc01d-8930-454f-a97f-555ec9efb22d",
                                                "sense_id": "b1c75418-e4a9-3b6d-837b-e66825da73cb",
                                                "text": "„Wird das zentrifugale Symptom unterdrückt - das zentrifugalste Symptom ist meistens ein Hautausschlag — so geht die Krankheit nach innen auf lebenswichtige Organe über.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9e5b3b3d-e684-43a0-8fd0-81165f88a221",
                        "source_entry_id": "272fa959-d16b-3298-a0de-61a7cc375647",
                        "source_sense_id": "2b2ef68f-5145-384e-be54-be3f459c8366",
