                "senses": [
                    {
                        "sense_id": "c3f6e9cc-f045-3a61-af3c-d8194e9fe349",
                        "entry_id": "6b9f46e5-9676-3a48-8420-3017a5191862",
                        "glosses": [
                            "Belag des Fußbodens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d041bfcc-4775-4469-88ce-bf73452658b2",
                                "sense_id": "c3f6e9cc-f045-3a61-af3c-d8194e9fe349",
                                "text": "„Zum Blockbau-Bio-Programm passt auch der Sölker Marmor, der im Hause Bimashofer als Fußbodenbelag im Erdgeschoß, als Küchenarbeitsfläche, Fliesenersatz im Badezimmer, Zimmerbrunnen und Heizkörper eingesetzt wurde.“"
                            },
                            {
                                "example_id": "5dff79b1-80ec-4a2c-8b67-4a6ded99b1a3",
                                "sense_id": "c3f6e9cc-f045-3a61-af3c-d8194e9fe349",
                                "text": "„\"Asbest und Schadstoffe stecken in Holzschutzmitteln, in der Dachpappe, in der Entlüftungsanlage der Bäder, in Klebern für Fliesen und Fußbodenbelag\", zählt Wolfgang Wulfes vom Bundesverband öffentlich bestellter und vereidigter sowie qualifizierter Sachverständiger auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
