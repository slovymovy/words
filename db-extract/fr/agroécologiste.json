                        "entry_id": "03ee407f-9973-3aa7-9f12-3f4138a47161",
                        "glosses": [
                            "Partisan de l’agroécologie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92c27df0-9691-4317-b06b-2772ab8ad954",
                                "sense_id": "25d33ac8-b358-3585-88e2-e197cdd1ef6d",
                                "text": "Je devins agroécologiste en même temps qu’écologiste soucieux de ce merveilleux phénomène appelé la Vie."
                            },
                            {
                                "example_id": "b7b339be-1d39-48fa-8393-ff68a3c301b6",
                                "sense_id": "25d33ac8-b358-3585-88e2-e197cdd1ef6d",
                                "text": "Quand il ne bine pas, l’agroécologiste globe-trotteur, qui a été l’ami de Thomas Sankara ou Yehudi Menuhin, partage son temps entre interviews, animation de ses fondations, conférences et rédaction d'ouvrages."
                            },
                            {
                                "example_id": "68c76f8e-5755-482b-9ebc-1f0e26071aa6",
                                "sense_id": "25d33ac8-b358-3585-88e2-e197cdd1ef6d",
                                "text": "Les idées que j’essaie de promouvoir depuis des années reposent sur une composante très concrète, je suis un agroécologiste dans la matière, sur la terre."
                            }
                        ]
                    }
                ],
