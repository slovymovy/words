                            },
                            {
                                "target_lang_word": "обрабатывать",
                                "target_lang_sense_clarification": "землю вокруг растений"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çapalamak",
                                "target_lang_sense_clarification": "toprağı havalandırmak için"
                            },
                            {
                                "target_lang_word": "kabartmak",
                                "target_lang_sense_clarification": "toprağı işleyerek havalandırmak"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "bewerken",
                                "target_lang_sense_clarification": "de grond bewerken"
                            },
                            {
                                "target_lang_word": "cultiveren",
                                "target_lang_sense_clarification": "met een cultivator bewerken"
                            },
                            {
                                "target_lang_word": "losmaken",
                                "target_lang_sense_clarification": "van de aarde of bodem"
                            },
                            {
                                "target_lang_word": "schoffelen",
                                "target_lang_sense_clarification": "onkruid wieden en aarde losmaken"
                            }
                        ]
                    }
                }
            ]
        }
