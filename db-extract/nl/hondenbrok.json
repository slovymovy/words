                    {
                        "sense_id": "54e1015c-ce65-3cf6-b975-7946753cc541",
                        "entry_id": "671e1fcc-ec08-3d62-aea3-69171e3ef3bb",
                        "glosses": [
                            "stevig stuk droog voedsel speciaal voor honden gemaakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59085dc7-8476-49e9-8204-a1a9667bb80c",
                                "sense_id": "54e1015c-ce65-3cf6-b975-7946753cc541",
                                "text": "De opheffingsuitverkoop is inmiddels in volle gang en loopt nog tot 4 maart. Dan gaan de deuren van de winkel voorgoed dicht. Tot die tijd kunnen klanten alle producten – van hondenbrokken tot tuinfakkels – tegen flinke kortingen kopen."
                            },
                            {
                                "example_id": "fd8d8c61-68f0-4ab6-8c49-a17bdc58a904",
                                "sense_id": "54e1015c-ce65-3cf6-b975-7946753cc541",
                                "text": "De kinderen die even later met de gids door de gangen vol ruimte-accessoires lopen, hebben echter lak aan de onnauwkeurigheden. Geboeid luisteren ze naar zijn verhalen over de vergiftigde hondenbrokken van ruimtehond Laika, of over Gil Grissom, de astronaut die na zijn ruimtereis bijna verdronk toen zijn capsule in de oceaan landde en volstroomde met water."
                            }
                        ]
                    }
