                        ],
                        "examples": [
                            {
                                "example_id": "9373ca07-ed89-4b10-ba08-40fa02a51db1",
                                "sense_id": "f6fa1244-27dc-3506-8881-58514169bf9f",
                                "text": "Hier, nous avons mangé des tapas dans une bodega.",
                                "translation": "Gestern haben wir Tapas in einer Bodega gegessen."
                            }
                        ],
                        "sense_index_json": "\"1\""
