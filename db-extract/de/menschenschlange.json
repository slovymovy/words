                "senses": [
                    {
                        "sense_id": "c36e6357-2073-36f9-9b38-331a9d845a34",
                        "entry_id": "6c1da12e-3b17-3109-b198-204ddb43887a",
                        "glosses": [
                            "lange Reihe von Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de48f28b-228e-4bef-b19e-1384d1a228c2",
                                "sense_id": "c36e6357-2073-36f9-9b38-331a9d845a34",
                                "text": "„Die Menschenschlange schob sich langsam vorwärts, und sie sah die Leute im Schlund des Ministeriums verschwinden.“"
                            },
                            {
                                "example_id": "59690c01-c62e-421a-8966-721769f877cf",
                                "sense_id": "c36e6357-2073-36f9-9b38-331a9d845a34",
                                "text": "„Die Menschenschlange löste sich auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1323ba84-4f5d-41a1-b89b-b27fb47a92f3",
                        "source_entry_id": "6c1da12e-3b17-3109-b198-204ddb43887a",
                        "source_sense_id": "c36e6357-2073-36f9-9b38-331a9d845a34",
                        "source_sense_description": "lange Reihe von Personen",
                        "target_lang_word": "file d'attente",
