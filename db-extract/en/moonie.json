    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                "word": "Moonie",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ac07c4aa-6582-4f99-b802-0f1b81b02d0e",
                        "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                        "tags": [
                            "plural"
                        ],
                        "form": "Moonies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "79a6bf27-25b1-3293-903e-6a07c260a720",
                        "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                        "glosses": [
                            "A member of the Unification Church; a follower of its founder Sun Myung Moon."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "2c472c2a-5bfc-48ce-bbb5-639faaf61f48",
                                "sense_id": "79a6bf27-25b1-3293-903e-6a07c260a720",
                                "text": "The Unification Church, or the \"Moonies\" as they are commonly known, have a thriving work in South Africa, with their headquarters in Hillbrow and a Moonie farm near Muldersdrift."
                            },
                            {
                                "example_id": "1c6865db-b62c-445b-9a89-47c91716c254",
                                "sense_id": "79a6bf27-25b1-3293-903e-6a07c260a720",
                                "text": "I am a proud Korean – a proud Moonie – and a dedicated anti-Communist and I intend to remain so the rest of my life -Bo Hi Pak"
                            },
                            {
                                "example_id": "72fc5d02-0e28-467d-aa21-e56340440fa1",
                                "sense_id": "79a6bf27-25b1-3293-903e-6a07c260a720",
                                "text": "We \"Moonies\" were willing to sacrifice personal choice to spin gold out of the raw silk of ourselves, to help create world harmony through family harmony."
                            }
                        ]
                    },
                    {
                        "sense_id": "367cf711-aabd-3d58-87c2-969b461ba5c3",
                        "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                        "glosses": [
                            "A person who shows exceptional enthusiasm for a cause or organization, a zealot."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "eaee12c2-adea-429f-ab71-9733de172d05",
                                "sense_id": "367cf711-aabd-3d58-87c2-969b461ba5c3",
                                "text": "CAA agents were sometimes called the \"Moonies\" of the business, famous for walking in lock-step."
                            },
                            {
                                "example_id": "653b11ed-8e23-4c7c-b350-29cef4135706",
                                "sense_id": "367cf711-aabd-3d58-87c2-969b461ba5c3",
                                "text": "From boardroom to terrace via the dug-out, such an evangelical zeal suffuses Manchester City's new mission that they should really be renamed the Blue Moonies."
                            }
                        ]
                    },
                    {
                        "sense_id": "fa31c272-04cd-3f8a-bbba-0b56f80ec670",
                        "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                        "glosses": [
                            "A nickname in English-speaking countries, sometimes for a person who moons around."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "71ac033d-4342-40ad-9ab2-5e44843a51d5",
                                "sense_id": "fa31c272-04cd-3f8a-bbba-0b56f80ec670",
                                "text": "How did Moonie get his nickname? He told us it had something to do with him being born during a full moon."
                            },
                            {
                                "example_id": "8e7be941-d109-4844-8658-e37fa68df574",
                                "sense_id": "fa31c272-04cd-3f8a-bbba-0b56f80ec670",
                                "text": "Michael \"Moonie\" Miller was feeling pretty good about things. The day was beautiful. A little breeze, nice and warm, was blowing in from the desert as if often does this time of year in the Los Angeles basin. Two days before Halloween and it's 81 degrees, mid-afternoon. It can't get much better than this, he thought. \"Moonie\" acquired his nickname years ago but it was hardly relevant anymore."
                            },
                            {
                                "example_id": "c518d086-0403-4335-901e-da423bd5d78b",
                                "sense_id": "fa31c272-04cd-3f8a-bbba-0b56f80ec670",
                                "text": "He was nicknamed Moonie, because he was such a daydreamer in school."
                            }
                        ]
                    },
                    {
                        "sense_id": "a40bf05c-96bc-356f-82b6-81e1d3806f33",
                        "entry_id": "b15aae54-fec5-33ba-949e-bfcebab9c882",
                        "glosses": [
                            "A fan of the Japanese manga and anime franchise Sailor Moon."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b5f592b2-2e65-4652-b21b-0d720d13714c",
                                "sense_id": "a40bf05c-96bc-356f-82b6-81e1d3806f33",
                                "text": "The Moonies and the Dragonballers aren't minorities; they're as large or larger than any other group of animeniacs you're going to find."
                            },
                            {
                                "example_id": "066b9365-1e80-4e2c-ae2f-6656ff13f476",
                                "sense_id": "a40bf05c-96bc-356f-82b6-81e1d3806f33",
                                "text": "Nope, you're not the only Moonie here. Unfortunately, the US Bandai figures are kinda ugly."
                            },
                            {
                                "example_id": "d56a34ab-ab2a-40ac-bd5f-331b2a755af1",
                                "sense_id": "a40bf05c-96bc-356f-82b6-81e1d3806f33",
                                "text": "Mike- who has a Sailor Moon webpage up, carries a Sailor Moon wallet and matching coinpurse irl and is just in general a major Moonie."
                            }
                        ]
                    }
                ],
