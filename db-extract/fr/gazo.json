                        "glosses": [
                            "Pseudonyme d’Ibrahima Diakité, rappeur français."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "881039c5-aada-4d0b-9be3-ab4da941ca49",
                                "sense_id": "910d2d92-26ec-3939-9564-eeb2fb15bff5",
                                "text": "Gazo, nouvelle coqueluche du rap, aux 20 000 albums vendus, a d’abord voulu lancer un pogo, avant de se rétracter pour des raisons de sécurité."
                            },
                            {
                                "example_id": "3dc5c6b3-a2b5-4d34-8153-f65c15d2b59d",
                                "sense_id": "910d2d92-26ec-3939-9564-eeb2fb15bff5",
                                "text": "Gazo est aujourd’hui l’une des figures les plus importantes de la drill dans l’univers du rap français."
                            },
                            {
                                "example_id": "8a9dafb0-5759-4d44-b274-b26524089022",
                                "sense_id": "910d2d92-26ec-3939-9564-eeb2fb15bff5",
                                "text": "De tous les rappeurs ayant importé la drill dans l’hexagone, Gazo est assurément l’un de ceux qui porte le plus haut les couleurs du genre."
                            }
                        ]
                    }
