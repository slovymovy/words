                "senses": [
                    {
                        "sense_id": "0eb49a87-a3aa-3813-82cf-499404e9a935",
                        "entry_id": "a2dc60ee-2c2a-3d9d-8a5b-0337188d70be",
                        "glosses": [
                            "lager gelegen deel in een koeienstal waarin de boer staat zodat hij zonder bukken de uiers van een koe kan behandelen voor het melken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1d6202b-39fd-4ea0-a55b-1f41dc5d826a",
                                "sense_id": "0eb49a87-a3aa-3813-82cf-499404e9a935",
                                "text": "De melkput is een plaats waar de landbouwer kan staan als de koeien worden gemolken, zeggen Ludo Van Pellicom en Martin Regelbrugge van de Bornemse brandweer."
                            },
                            {
                                "example_id": "4a145445-c086-4fcb-82e4-5fd9f800b516",
                                "sense_id": "0eb49a87-a3aa-3813-82cf-499404e9a935",
                                "text": "Ze viert het bescheiden met haar vaste melkveehouders en hun familie. Want als melkmonsternemer krijg je vanzelf een band met de gezinnen waar je eens per maand komt. Lief en leed wordt in de melkput gedeeld, aldus de medewerkster van CR Delta Oost in de krant van woensdag."
                            },
                            {
                                "example_id": "8919c749-3326-47d4-bd9e-cf178ac14ee5",
                                "sense_id": "0eb49a87-a3aa-3813-82cf-499404e9a935",
                                "text": "Rik Walvoort en zijn vrouw Jolanda uit Geesteren hebben een prijs gewonnen met hun zelf bedachte minimelkput. Zij krijgen de prijs van Innovatiefonds Farmers for Farmers (IFFF), dat boeren stimuleert om hun ideeën uit te voeren en die kennis vervolgens te delen."
                            },
                            {
                                "example_id": "f3509770-76dc-490f-a27c-37b9f7259dd0",
                                "sense_id": "0eb49a87-a3aa-3813-82cf-499404e9a935",
                                "text": "Bij Riks snap ik niet wat Eline daar doet. Zijzelf geloof ik ook niet meer. Die twee hebben elkaar duidelijk niets te melden. Nou. Dus. Als ik haar was, hield ik de eer aan mezelf en pakte ik mijn koffers. Tegen Marit valt niet op te boksen. Die is in haar element in de melkput, lacht om Riks' grapjes én brengt ook het speelse in hem naar boven. Hopelijk wordt het langzaam warm daar in besneeuwd Canada."
                            }
                        ]
                    }
