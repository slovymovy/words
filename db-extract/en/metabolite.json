                "entry_id": "fe8f631e-ff4e-3607-8a02-831cf812fec4",
                "word": "metabolite",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "da262a4d-94a4-4ca2-8489-73985dc718f7",
                        "entry_id": "fe8f631e-ff4e-3607-8a02-831cf812fec4",
