                                "target_senses": [
                                    {
                                        "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                        "entry_id": "cdcf5120-04d2-37be-8716-e12c3f585421",
                                        "glosses": [
                                            "Gesamtheit aller von der Psyche beeinflussten Bewegungen und Verhaltensweisen (zum Beispiel Gehen, Sprechen, Schreiben, Mimik, aber auch Haltung und Tonus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b56c2acb-113f-45d3-9663-d41692995788",
                                                "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                                "text": "Angewandt wird Psychomotorik im Gesundheits- und Bildungswesen."
                                            },
                                            {
                                                "example_id": "6672f8b1-771a-473d-9db9-05fe25ddf851",
                                                "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                                "text": "Das ganzheitliche Trainingsprogramm, das die Module Gedächtnisleistung, Psychomotorik und Alltagskompetenz kombiniert, soll die Lebensqualität älterer Menschen nachhaltig verbessern."
                                            },
                                            {
                                                "example_id": "e55266e1-4d55-41da-9d09-9abf75fdf808",
                                                "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                                "text": "Man muss viele Komponenten des Hirns ansprechen, also Multitasking, und die Psychomotorik."
                                            },
                                            {
                                                "example_id": "714ea249-7ce0-4c34-86cd-5ea42df17285",
                                                "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                                "text": "Die Arbeit der Betreuungskräfte würde von der Gestaltung der Aktivitäten wie Malen, Basteln bis hin zu unterrichtsbegleitenden Förderangeboten reichen, zu denen Hausaufgabenhilfe, Psychomotorik, Wahrnehmungs- und Verhaltenstraining zählen."
                                            },
                                            {
                                                "example_id": "52dbe9a4-a10d-4bdd-b5f5-9f65e45674f8",
                                                "sense_id": "03a37ddb-062f-30de-8339-939c2b9302e2",
                                                "text": "Geprüft werden unter anderem die Psychomotorik und Mehrfachbelastung - diese Fähigkeiten sind nur begrenzt erlernbar."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
