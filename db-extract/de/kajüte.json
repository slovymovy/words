                ],
                "senses": [
                    {
                        "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                        "entry_id": "abf5f78d-ae21-33b8-a196-b76b6e317bca",
                        "glosses": [
                            "kleiner Raum auf Schiffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9147ca6-f032-4631-9023-da17f3a70b75",
                                "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                                "text": "Meine Kajüte war sehr eng, daher verbrachte ich die meiste Zeit der Reise an Deck."
                            },
                            {
                                "example_id": "a4def6d5-8601-4bf0-aca4-82cb1ca5f557",
                                "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                                "text": "„Am nächsten Tag führte er mich in einen Kleiderladen, und ich wurde wie ein Matrose aufgetakelt, dann wurde ich in der Kajüte untergebracht, wo ich meine Arbeit auf die übliche Weise beginnen sollte.“"
                            },
                            {
                                "example_id": "e556569e-a4cb-4ec9-b8e8-ad6edf8801f7",
                                "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                                "text": "„Wir hatten ein großes Bullauge in der Kajüte, hoch oben über den an der Außenwand hingleitenden Brechern.“"
                            },
                            {
                                "example_id": "14d8fa5f-cd70-4286-99d1-dbae155fb18e",
                                "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                                "text": "„Er führte uns in die Kajüte und öffnete seine Kästen.“"
                            },
                            {
                                "example_id": "34ce21e7-8ceb-42de-9225-8afee0697d85",
                                "sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                                "text": "„In diesem Augenblick stand Athelney Jones am Eingang und steckte sein breites Vollmondgesicht und seine athletischen Schultern in die winzige Kajüte hinein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "08408591-0d93-4c3f-b7cc-effdc1396558",
                        "source_entry_id": "abf5f78d-ae21-33b8-a196-b76b6e317bca",
                        "source_sense_id": "6bb84558-02ef-3e7f-8184-0d7753dcb153",
                        "source_sense_description": "kleiner Raum auf Schiffen",
                        "target_lang_word": "cabin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cabin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A small dwelling characteristic of the frontier, especially when built from logs with simple tools and not constructed by professional builders, but by those who meant to live in it."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17a6ac8-bdc0-4fdc-abdb-5d12ca2f6422",
                                                "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                                "text": "Abraham Lincoln was born in a log cabin."
                                            },
                                            {
                                                "example_id": "8d580f0b-2e7b-4a5b-aaac-56347ba05aec",
                                                "sense_id": "255631b8-cc11-36b1-a841-c48f821e9abf",
                                                "text": "And that was how long we stayed in the cabin, pressed together, pulling the future out of each other, sweating and groaning and making sure each of us remembered."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69340de9-fe40-32b2-afc2-bcbd3117c386",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A chalet or lodge, especially one that can hold large groups of people."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A private room on a ship."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af685093-1246-4e6c-82b3-b36b66f5ca47",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "the captain’s cabin"
                                            },
                                            {
                                                "example_id": "123116f1-c3e4-4026-9d3e-9d19c32b0168",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "Passengers shall remain in their cabins."
                                            },
                                            {
                                                "example_id": "61a194bb-ec3e-4750-aa2d-3570fd5aa53c",
                                                "sense_id": "43495088-b151-399d-8ff6-7cb6fedda7aa",
                                                "text": "There is an hour or two, after the passengers have embarked, which is disquieting and fussy. Mail bags, so I understand, are being put on board. Stewards, carrying cabin trunks, swarm in the corridors. Passengers wander restlessly about or hurry, with futile energy, from place to place."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdbada18-f576-37cb-9865-b0ef8c2cca2b",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The interior of a boat, enclosed to create a small room, particularly for sleeping."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1032c2d-52c9-4bd9-ae7b-cca8afa40647",
                                                "sense_id": "bdbada18-f576-37cb-9865-b0ef8c2cca2b",
                                                "text": "Mr. Cooke had had a sloop yacht built at Far Harbor, the completion of which had been delayed, and which was but just delivered. […] The Maria had a cabin, which was finished in hard wood and yellow plush, and accommodations for keeping things cold."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44fa17a8-c83c-3f82-a6ac-6acf51401694",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The passenger area of an airplane."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9dbdf248-5df8-3936-8817-28594b0fe1af",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "The section of a passenger plane having the same class of service."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7113bf6f-19a6-36b5-9b95-edd3bdf77270",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A signal box."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "532e421c-dfdd-36ac-8b19-0ce44f33dabd",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A small room; an enclosed place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a00a9c0c-3db2-4b3d-8c8b-125dc4d31094",
                                                "sense_id": "532e421c-dfdd-36ac-8b19-0ce44f33dabd",
                                                "text": "So long in secret cabin there he held her captive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47b01855-0af3-3b5a-a929-3a5b8497e136",
                                        "entry_id": "d1e89efa-a141-3cc1-8809-cccc3885c5b0",
                                        "glosses": [
                                            "A private office; particularly of a doctor, businessman, lawyer, or other professional."
                                        ],
                                        "tags": [
                                            "India"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a12f7097-6681-46d5-b8b4-66f3dac1a2ba",
                                                "sense_id": "47b01855-0af3-3b5a-a929-3a5b8497e136",
                                                "text": "There’s Kaul’s boss, the overweight owner of a pharmaceutical firm who spends his days wolfing down junk food in the privacy of his cabin."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "cabin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f565842-3cae-3d93-8f0a-5859d7a6d5e4",
                                        "entry_id": "58c4fcf3-451b-34b2-acc0-de8ba568f90f",
                                        "glosses": [
                                            "To place in a cabin or other small space."
                                        ],
