                "senses": [
                    {
                        "sense_id": "56206c07-9458-37e8-9f4f-c48d777caf9a",
                        "entry_id": "a5cf745c-eb83-383c-9985-1f86844d4449",
                        "glosses": [
                            "fraza powodująca wygenerowanie raportu z bazy danych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "822cef7c-6d24-4367-9161-b0736a377649",
                                "sense_id": "56206c07-9458-37e8-9f4f-c48d777caf9a",
                                "text": "Symbol oznacza \"wszystkie kolumny\". Tak więc, jeżeli kwerenda ma zwrócić wszystkie dane zapisane w tabeli, możemy albo kolejno zaznaczać wszystkie kolumny, albo wybrać ten symbol"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "9321d4ad-bd69-3944-b70a-450c4a033112",
                        "entry_id": "a5cf745c-eb83-383c-9985-1f86844d4449",
                        "glosses": [
                            ", dziś gromadzenie danych potrzebnych do wyjaśnienia sprawy"
                        ],
                        "tags": [
                            "dated",
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "ab5d21c7-119f-4a7f-8b51-e2f4b65df136",
                                "sense_id": "9321d4ad-bd69-3944-b70a-450c4a033112",
                                "text": "Przyznam, że nie zetknęłam się z tym wyrazem, ale szybka kwerenda internetowa potwierdziła ok. 100 użyć"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "e35aae7a-a679-345e-852e-b564ba85e93f",
                        "entry_id": "a5cf745c-eb83-383c-9985-1f86844d4449",
