                "senses": [
                    {
                        "sense_id": "4ba01d1e-7ba2-3ebb-82f2-3d990ddb2407",
                        "entry_id": "b8441cfb-8fd6-377b-ad3a-e24b6a7cf0e7",
                        "glosses": [
                            "związany z krucjatą - wyprawą krzyżową"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c57ef09c-c858-495f-817b-28e473bf8a48",
                                "sense_id": "4ba01d1e-7ba2-3ebb-82f2-3d990ddb2407",
                                "text": "O ile monarchowie wykorzystywali podatki na cele krucjatowe również do zapełnienia swoich pustych skarbców, Kościół konsekwentnie przeznaczał zebrane pieniądze na właściwy cel"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b3f23d45-c1f6-3629-ade2-140d6a84973e",
                        "entry_id": "b8441cfb-8fd6-377b-ad3a-e24b6a7cf0e7",
                        "glosses": [
                            "związany z krucjatą - ostrą kampanią przeciw komuś lub czemuś"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de7c6638-40b7-4ca2-86b1-5323f5992902",
                                "sense_id": "b3f23d45-c1f6-3629-ade2-140d6a84973e",
                                "text": "Ale czy on z kolei wbije im do głowy, że krucjatowy katolicyzm (…) to autostrada prowadząca prosto w przepaść?"
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
