                "senses": [
                    {
                        "sense_id": "cc628591-c030-34f2-9ed3-84f9c5b68574",
                        "entry_id": "3e5c69f7-4663-3298-adc9-6174b2a8e0f3",
                        "glosses": [
                            "Befestigung (von jemandem oder etwas) mit einer festen Schnur (Leine); zum Beispiel das Anleinen eines Hundes an die Hundeleine"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af5f1773-fb24-4ebc-bde5-f012490c0d75",
                                "sense_id": "cc628591-c030-34f2-9ed3-84f9c5b68574",
                                "text": "„Viele Hundehalter seien mit den von ihnen ausgewählten Hunderassen offenbar auch schlicht überfordert und hätten keine erzieherische Kontrolle über diese, sobald die Anleinung gelöst sei.“"
                            },
                            {
                                "example_id": "2f232042-8e09-44a9-ae5d-d4102201c00b",
                                "sense_id": "cc628591-c030-34f2-9ed3-84f9c5b68574",
                                "text": "„Außerdem sei er unter Verweis auf § 6a Abs 1 des Landespolizeigesetz sogar zur Anleinung verpflichtet gewesen.“"
                            },
                            {
                                "example_id": "f5bb79d2-bc68-4678-baf5-bf9b0a280cf8",
                                "sense_id": "cc628591-c030-34f2-9ed3-84f9c5b68574",
                                "text": "„Im Gegensatz zu andern Anleinungen ist die Chevillette extrem bequem für das Tier.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
