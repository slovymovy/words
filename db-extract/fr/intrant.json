                    {
                        "translation_id": "e2d59d7c-a2cf-4111-b4dc-e7eed3df4c6b",
                        "source_entry_id": "c8a2b55b-c3af-3b04-aa55-668a5a3da329",
                        "source_sense_id": "01abe9bc-4416-34a7-b093-6fffe4ec803a",
                        "source_sense_description": "Agriculteur",
                        "target_lang_word": "landwirtschaftliche Betriebsmittel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "64fc292c-f2f8-4ee3-935b-f85a7fce582a",
                        "source_entry_id": "c8a2b55b-c3af-3b04-aa55-668a5a3da329",
                        "source_sense_id": "01abe9bc-4416-34a7-b093-6fffe4ec803a",
                        "source_sense_description": "Agriculteur",
                        "target_lang_word": "Dünger",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dünger",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                        "entry_id": "5c7b9556-8659-3d6a-9dc2-824400646e00",
                                        "glosses": [
                                            "flüssige oder feste Nährstoffe, die in die Erde gegeben werden, damit Pflanzen besser wachsen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e54203cd-7ac3-45f3-9348-d4b6b48a53b1",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "Mein Onkel verwendet keinen chemischen Dünger, er düngt seinen Boden nur mit dem Mist seiner Schafe und Kühe."
                                            },
                                            {
                                                "example_id": "4e82d321-2a37-4368-83fc-d82e814b9433",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "„Und dann inspizierten Bertram und ich den Jaucheheber, mit dem der Vater alljährlich im März den Inhalt der Senkgrube als Dünger im Garten verteilte.“"
                                            },
                                            {
                                                "example_id": "83563ceb-c157-4062-b79d-11895a074908",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "„Doch die Ernte war tatsächlich unterdurchschnittlich, was einerseits an schlechtem Saatgut, andererseits am fehlenden Dünger lag - das Vieh war aufgrund des Futtermangels stark reduziert worden, und weil künstlicher Dünger aus denselben Rohstoffen bestand wie Pulver und Sprengstoff, stand nicht genügend für die Landwirtschaft zur Verfügung.“"
                                            },
                                            {
                                                "example_id": "66dbdc76-2212-471b-b337-6436e0971ddc",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "„Denn ohne Maschinen und Traktoren, ohne Pferde und Vieh, ohne Saatgut und Dünger läßt sich nichts ausrichten.“"
                                            },
                                            {
                                                "example_id": "2223908b-9585-4e9e-b334-ebe48369d637",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "„Außerdem verwendete man als Dünger Guano, der in großem Mengen an der Küste vorkam und garantierte so gute Ernten.“"
                                            },
                                            {
                                                "example_id": "ae1e4296-9265-46f7-9e02-7a7f1a3fe92b",
                                                "sense_id": "624e50f6-066c-35e2-80e3-79372c33247b",
                                                "text": "[Bodenschutz im Garten:] „Verwenden Sie organischen statt mineralischen Dünger.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
