                                "example_id": "bb1fc0b1-4c39-4a72-bd29-a7a49440d190",
                                "sense_id": "9d949258-7d20-3a60-b926-258139e2fe8b",
                                "text": "“With all his education, mind you. Selling weenies out on the street in the broad daylight.”"
