                                        "glosses": [
                                            "Qui se rapporte à la diphtérie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e19d62b8-25e1-4e83-b4e8-dc3ef8c1107f",
                                                "sense_id": "46c24d8c-df3a-3442-86c0-266e1902b33e",
                                                "text": "Des léthalités fortes (plus de 12 %) sont notées dans les départements du Finistère, de l'Indre-et-Loire, de la Seine-et-Marne, de l'Ardèche, du Gers, de la Haute-Garonne et de l'Aude. Il s'agit de départements dont la morbidité et la mortalité diphtériques ne sont pas élevées."
                                            },
                                            {
                                                "example_id": "9aca6a62-9161-458c-bc2e-7591fd7127df",
                                                "sense_id": "46c24d8c-df3a-3442-86c0-266e1902b33e",
                                                "text": "Angine diphtérique."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "diphtérique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "584babc0-58c8-314d-82b1-555ed5453c5c",
                                        "entry_id": "08ed1683-6de1-3c8e-82c1-7b261ba6a396",
                                        "glosses": [
                                            "Celui, celle qui est atteint de diphtérie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9b0a7f6-83dd-401b-890a-da2839377795",
                                                "sense_id": "584babc0-58c8-314d-82b1-555ed5453c5c",
                                                "text": "Il y a dans cet hôpital une salle de diphtériques."
                                            },
                                            {
                                                "example_id": "4e6721da-183c-4f1b-9051-c760fb28c109",
                                                "sense_id": "584babc0-58c8-314d-82b1-555ed5453c5c",
                                                "text": "En résumé, G., qui vit en contact constant avec les diphtériques, et qui a, actuellement, les amygdales volumineuses et rouges, présente, dans la gorge et le nez, un bacille analogue aux précédents."
                                            }
                                        ]
                                    }
                                ]
                            }
