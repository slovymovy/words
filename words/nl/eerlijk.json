                    "semantic_group_id": "honest_meaning",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wees <w>eerlijk</w> en vertel de waarheid!",
                            "target_lang_translations": {
                                "en": "Be <w>honest</w> and tell the truth!",
                                "ru": "Будь <w>честным</w> и скажи правду!",
                                "pl": "Bądź <w>uczciwy</w> i powiedz prawdę!",
                                "de": "Sei <w>ehrlich</w> und sag die Wahrheit!",
                                "fr": "Sois <w>honnête</w> et dis la vérité !",
                                "it": "Sii <w>onesto</w> e di' la verità!",
                                "cs": "Buď <w>upřímný</w> a řekni pravdu!",
                                "tr": "<w>Dürüst</w> ol ve doğruyu söyle!",
                                "es": "¡Sé <w>honrado</w> y di la verdad!",
                                "zh": "请<w>诚实</w>一点，说出真相！"
                            }
                        },
                        {
                            "text": "Hij gaf een <w>eerlijk</w> antwoord op de moeilijke vraag.",
                            "target_lang_translations": {
