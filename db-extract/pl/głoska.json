                    {
                        "sense_id": "ce45481f-1b07-33ca-b015-2708b48c6b9c",
                        "entry_id": "148e2029-182a-3a07-8299-9efcfda97738",
                        "glosses": [
                            "najmniejszy element dźwiękowej formy wypowiedzi, charakteryzujący się stałym zespołem fonetycznych cech artykulacyjnych i akustycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a442478a-7089-4609-ad21-692c8d1c6d4c",
                                "sense_id": "ce45481f-1b07-33ca-b015-2708b48c6b9c",
                                "text": "Fonemy są realizowane w mowie przez głoski."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "682cc030-f8df-4ad0-b1c1-643ecec6553e",
                        "source_entry_id": "148e2029-182a-3a07-8299-9efcfda97738",
                        "source_sense_id": "ce45481f-1b07-33ca-b015-2708b48c6b9c",
                        "target_lang_word": "speech sound",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "5e970ac5-e2fc-45e8-ab97-0500d4438bb6",
                        "source_entry_id": "148e2029-182a-3a07-8299-9efcfda97738",
                        "source_sense_id": "ce45481f-1b07-33ca-b015-2708b48c6b9c",
                        "target_lang_word": "phone",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                        "entry_id": "79af60ff-0e3f-3809-9a68-84bd7592fa2b",
                                        "glosses": [
                                            "A device for transmitting conversations and other sounds in real time across distances, now often a small portable unit also capable of running software etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ed998575-8f7d-4759-a701-514c9b65a2db",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "Daragh's on the phone at the moment. He'll call you when he's finished."
                                            },
                                            {
                                                "example_id": "e5207909-3890-4461-b3a4-e5e5143ccca7",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "My phone ran out of battery."
                                            },
                                            {
                                                "example_id": "318f3d33-984d-454d-8718-a39fea120dab",
                                                "sense_id": "05f789f6-3e94-3666-bafa-54681f6fab46",
                                                "text": "There's an old-fashioned phone in the doctor's waiting room - it doesn't work anymore, of course."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e39cdaa-5446-3bbf-9663-a39665d53a7d",
                                        "entry_id": "79af60ff-0e3f-3809-9a68-84bd7592fa2b",
                                        "glosses": [
                                            "A person's telephone number (as a means of contact); digits."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f647c94f-2684-4325-96b6-fcbfb59e4dde",
                                                "sense_id": "6e39cdaa-5446-3bbf-9663-a39665d53a7d",
                                                "text": "It was a clear black night, a clear white moon / Warren G was on the streets tryin' to consume / Some skirts for the eve so I can get some phones / Rollin' in my ride, chillin' all alone"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                        "entry_id": "38e42d31-3d09-34aa-aab8-b0a590266ff5",
                                        "glosses": [
                                            "To call (someone) using a telephone."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "377ecea2-32e1-47b1-8fcd-133a9cdd060a",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Phone me as soon as you land at the airport."
                                            },
                                            {
                                                "example_id": "51471a3c-1670-4233-80ff-420184db114f",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "Her father told her to phone him to pick her up in case it started raining heavily."
                                            },
                                            {
                                                "example_id": "1ed1f5fb-6e8c-49e6-b0a1-5f3d2320eb60",
                                                "sense_id": "9d811c22-83a8-3553-9209-d0e4efc1fb85",
                                                "text": "It wasn’t like he was dying to get it off his chest. I think he only phoned because he knew how excited I’d be to hear about it."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "phone",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d02e5199-4002-30b1-a74a-58cc4518d58f",
                                        "entry_id": "39a27697-bef8-390e-bb94-002a3da181b7",
                                        "glosses": [
                                            "A speech segment that possesses distinct physical or perceptual properties, considered as a physical event without regard to its place in the phonology of a language."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
