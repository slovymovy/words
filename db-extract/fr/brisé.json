                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "2ba74512-71d3-3051-8815-2dc42da0d60c",
                        "entry_id": "ce6c1552-7d2b-3b72-b94a-b28aaa12e637",
                        "glosses": [
                            "Qualifie le dos d'une reliure qui se plie à volonté."
