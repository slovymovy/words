                    }
                },
                {
                    "sense_id": "dd67ba94-5e2d-3612-b775-5af2692fbb10",
                    "sense_definition": "Imaginary or intended to be easily defeated, often used to describe an argument or opponent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_fake",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The politician attacked a <w>straw</w> enemy instead of addressing the real issues.",
                            "target_lang_translations": {
                                "ru": "Политик нападал на <w>выдуманного</w> врага вместо того, чтобы решать реальные проблемы.",
                                "tr": "Politikacı gerçek sorunları ele almak yerine <w>göstermelik</w> bir düşmana saldırdı.",
                                "zh": "这位政客攻击了一个<w>虚构的</w>敌人，而不是去解决实际问题。"
                            }
                        },
                        {
                            "text": "His entire presentation was based on a <w>straw</w> argument that collapsed under scrutiny.",
                            "target_lang_translations": {
                                "ru": "Вся его презентация была основана на <w>надуманном</w> аргументе, который развалился при внимательном рассмотрении.",
                                "tr": "Tüm sunumu, inceleme altında çöken <w>nafile</w> bir argümana dayanıyordu.",
                                "zh": "他的整个演讲都基于一个<w>站不住脚的</w>论点，一经推敲便不攻自破。"
                            }
                        }
