                "senses": [
                    {
                        "sense_id": "8dea086e-b6ce-3f29-a977-3e1cfc3e93ef",
                        "entry_id": "826f9fb9-d664-3693-8ce5-201c2d328b8d",
                        "glosses": [
                            "ogół pozostałości po zniszczonych budowlach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a8bcf5b-14ad-4c65-8b8c-e0ad61311130",
                                "sense_id": "8dea086e-b6ce-3f29-a977-3e1cfc3e93ef",
                                "text": "Ludzie opuścili to miasto, wszędzie tylko ruiny i ruiny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "43df2ca2-e661-4e26-bb63-57b659304f56",
                        "source_entry_id": "826f9fb9-d664-3693-8ce5-201c2d328b8d",
                        "source_sense_id": "8dea086e-b6ce-3f29-a977-3e1cfc3e93ef",
                        "target_lang_word": "ruin",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ruin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "The remains of a destroyed or dilapidated construction, such as a house or castle."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bd0f7f1f-b690-4137-a2af-93e1ab39b4dc",
                                                "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                                "text": "The Veian and the Gabian towirs shall fall, / And one promiscuous ruin cover all; / Nor, after length of years, a stone betray / The place where once the very ruins lay."
                                            },
                                            {
                                                "example_id": "baf8fc84-d91f-4753-b084-0e2f78992849",
                                                "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                                "text": "The labour of a day will not build up a virtuous habit on the ruins of an old and vicious character."
                                            },
                                            {
                                                "example_id": "04f169a9-f757-4575-91c8-d46482bd7a21",
                                                "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                                "text": "A canister of flour from the kitchen had been thrown at the looking-glass and lay like trampled snow over the remains of a decent blue suit with the lining ripped out which lay on top of the ruin of a plastic wardrobe."
                                            },
                                            {
                                                "example_id": "553fa2b0-a848-414a-bbf4-4c2ce49e1ba4",
                                                "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                                "text": "Dr. Manuel: No one is saved. The age of humanity is ended. Soon, only ruin and corpses will remain."
                                            },
                                            {
                                                "example_id": "52f7611e-fcf7-467e-85cb-48f32bc59a5a",
                                                "sense_id": "94c29fc2-c1da-37e1-bb41-a9d95da22a3f",
                                                "text": "Not only is Jerusalem not a ruin, but she is at the height of her glory compared to all of Jewish history!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be9d8b39-98c8-3a9e-8b61-36bf0306a8f8",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "The state of being a ruin, destroyed or decayed."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "441858bf-e7b5-4b56-85d7-7d697a44154a",
                                                "sense_id": "be9d8b39-98c8-3a9e-8b61-36bf0306a8f8",
                                                "text": "The monastery has fallen into ruin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97c971e0-22b4-301b-82d5-8089bfc850f1",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "Something that leads to serious trouble or destruction."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6251e79c-ab22-4422-9a7d-b76155401a83",
                                                "sense_id": "97c971e0-22b4-301b-82d5-8089bfc850f1",
                                                "text": "Gambling has been the ruin of many."
                                            },
                                            {
                                                "example_id": "85039511-e1eb-4668-aa9e-9a091f7699d7",
                                                "sense_id": "97c971e0-22b4-301b-82d5-8089bfc850f1",
                                                "text": "The errors of young men are the ruin of business."
                                            },
                                            {
                                                "example_id": "e4ae54e7-cb9f-4d2e-b7d6-fc5a564fc901",
                                                "sense_id": "97c971e0-22b4-301b-82d5-8089bfc850f1",
                                                "text": "The Bat—they called him the Bat.[…]. He[…]played a lone hand,[…]. Most lone wolves had a moll at any rate—women were their ruin—but if the Bat had a moll, not even the grapevine telegraph could locate her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c178a422-20db-37e7-8e80-0a938a33b185",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "The act of ruining something."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c00c7db0-dd9f-3960-a756-46e671902a22",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "A fall or tumble."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa5f1389-cc7c-4486-9566-7ec0f6ef3791",
                                                "sense_id": "c00c7db0-dd9f-3960-a756-46e671902a22",
                                                "text": "His ruin startled th’ other steeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "A change that destroys or defeats something; destruction; overthrow."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e0f74f11-c6de-4638-8965-61c3c793ed2a",
                                                "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                                "text": "the ruin of a ship or an army"
                                            },
                                            {
                                                "example_id": "7fa6c0bb-7bf5-49a6-b62b-81a43d629daa",
                                                "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                                "text": "the ruin of a constitution or a government"
                                            },
                                            {
                                                "example_id": "168eec35-36d1-4946-9294-9b30de8e6a6d",
                                                "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                                "text": "the ruin of health or hopes"
                                            },
                                            {
                                                "example_id": "e735015d-fba1-44b4-b5c1-a3e5196a1921",
                                                "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                                "text": "Oh Portius, is there not some choſen Curſe,\nSome hidden Thunder in the Stores of Heav’n,\nRed with uncommon Wrath, to blaſt the Man\nWho owes his Greatneſs to his Country’s Ruin?"
                                            },
                                            {
                                                "example_id": "e4a1ae16-8d67-4fac-8287-c502bebd4d04",
                                                "sense_id": "4887de0b-585b-3453-a2c5-49dba27c4bf4",
                                                "text": "Ruin seize thee, ruthless king!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a58c61a8-478a-30b7-8d7e-fef8837da70e",
                                        "entry_id": "036cf439-fde7-31db-9a70-f44374f20e9d",
                                        "glosses": [
                                            "Complete financial loss; bankruptcy."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "ruin",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "472ebb51-7d41-377a-a2d3-40251244800e",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To cause the fiscal ruin of; to bankrupt or drive out of business."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd444b10-a8c6-4b3b-8782-c4433e209758",
                                                "sense_id": "472ebb51-7d41-377a-a2d3-40251244800e",
                                                "text": "With all these purchases, you surely mean to ruin us!"
                                            },
                                            {
                                                "example_id": "cc84898b-972b-4c6b-8113-2a94bc74208c",
                                                "sense_id": "472ebb51-7d41-377a-a2d3-40251244800e",
                                                "text": "In one way, indeed, he bade fair to ruin us; for he kept on staying week after week, and at last month after month, so that all the money had been long exhausted..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d93a0c9d-5031-3222-9501-1e68ca1c8e09",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To destroy or render something no longer usable or operable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fcfa222b-d643-4709-b782-6b2c2bf4f04b",
                                                "sense_id": "d93a0c9d-5031-3222-9501-1e68ca1c8e09",
                                                "text": "He ruined his new white slacks by accidentally spilling oil on them."
                                            },
                                            {
                                                "example_id": "854bf59c-bbbd-4533-a192-9d254814f1cd",
                                                "sense_id": "d93a0c9d-5031-3222-9501-1e68ca1c8e09",
                                                "text": "By the fireside there are old men seated, / Seeing ruined cities in the ashes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10e0deef-c189-3b86-8ff3-b2995f3b38f6",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To upset or overturn the plans or progress of, or to have a disastrous effect on something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "08514771-c4c1-4acd-9e2f-e1f5549393bf",
                                                "sense_id": "10e0deef-c189-3b86-8ff3-b2995f3b38f6",
                                                "text": "My car breaking down just as I was on the road ruined my vacation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a6672f8-5e1f-30e2-bc4c-b2af47641870",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To make something less enjoyable or likeable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92f4ad45-66b6-4b24-953a-ff8b5a02d408",
                                                "sense_id": "2a6672f8-5e1f-30e2-bc4c-b2af47641870",
                                                "text": "I used to love that song, but being assaulted when that song was playing ruined the song for me."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b387bb1-3953-3fb7-a951-77740291c66b",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To reveal the ending of (a story); to spoil."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54e3521e-db80-346e-9315-7c0dabe341c9",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To fall into a state of decay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec544361-1ade-47a1-ae01-e29a02eabfdc",
                                                "sense_id": "54e3521e-db80-346e-9315-7c0dabe341c9",
                                                "text": "Though he his house of polisht marble build, / Yet shall it ruine like the Moth's fraile cell"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a91182-e5c5-333d-a715-c83286e57646",
                                        "entry_id": "31959445-a804-3a41-8cb6-3780cd532850",
                                        "glosses": [
                                            "To seduce or debauch, and thus harm the social standing of."
                                        ],
                                        "tags": [
                                            "historical",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b463e15d-f577-4bdd-9ccd-88089fa47e1b",
                                                "sense_id": "a6a91182-e5c5-333d-a715-c83286e57646",
                                                "text": "The young libertine was notorious for ruining local girls."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b41061ff-52c6-4bf5-b3ec-bbcb43066df8",
                        "source_entry_id": "826f9fb9-d664-3693-8ce5-201c2d328b8d",
                        "source_sense_id": "8dea086e-b6ce-3f29-a977-3e1cfc3e93ef",
