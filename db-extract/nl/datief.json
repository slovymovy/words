                                    {
                                        "sense_id": "a64d794b-bb37-3100-aa0e-19f8bdf8092f",
                                        "entry_id": "b4089d12-2367-3bd1-8ba7-f54fcb8673e8",
                                        "glosses": [
                                            "trzeci przypadek deklinacji, odpowiada na pytania: komu? czemu?"
                                        ],
                                        "tags": [],
