            {
                "entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                "word": "onderweg",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "glosses": [
                            "op de weg van A naar B"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9a34d2-41b5-4801-bce1-9a70574c0b7f",
                                "sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                                "text": "Ik vermoed dat ergens onderweg datgene wat Isaac Robles ons wilde vertellen, verloren is geraakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                        "entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "glosses": [
                            "onderweg zijn: bezig zijn zich van plek A naar plek B te verplaatsen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0519eef-1f13-4856-a425-7be9bc25d043",
                                "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                                "text": "Het Utrechtse TivoliVredenburg wordt die week omgetoverd tot het Serious Request-hoofdkwartier. Ook vanuit die plek, met een radiostudio, krijgen de zwervende en onderweg radio makende presentatoren opdrachten ingefluisterd."
                            },
                            {
                                "example_id": "b8264f5b-bc16-49ab-9028-b254c06f94a0",
                                "sense_id": "603db332-2ce7-328c-893a-cd924c888070",
                                "text": "Zo zat er in elke doos ontbijt, lunch en avondeten, maar ook al mijn snacks, repen en noten voor onderweg en papieren landkaarten voor de volgende etappe, nieuw wc-papier en om de 700 kilometer een paar nieuwe schoenen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e23e0a8c-ed80-46be-a7d3-9fd97d258684",
                        "source_entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "source_sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "source_sense_description": "bezig zijn zich van plek A naar plek B te verplaatsen",
                        "target_lang_word": "unterwegs",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterwegs",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                        "entry_id": "0010d0c4-df02-3d72-8c3c-1ffae180289e",
                                        "glosses": [
                                            "auf dem Weg, auf der Strecke"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26935371-5aba-4a93-baee-b6b218683eca",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "Er ist unterwegs, um die Landschaft zu fotografieren."
                                            },
                                            {
                                                "example_id": "355fece3-94ea-419c-a020-9e5ffd7a73a6",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "Sie bereitet ihm Proviant für unterwegs zu."
                                            },
                                            {
                                                "example_id": "4e090bd2-ab1f-4b04-b4c4-a68a9e808b90",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Unterwegs durch die Gassen Krakaus fiel mir auf, was ich noch alles hätte erwähnen können.“"
                                            },
                                            {
                                                "example_id": "aa581593-201d-42c8-b02a-c30268402a90",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Als Cäsar zugetragen wurde, dass Nachschub für die Germanen unterwegs sein sollte, ergriff er die Initiative und brach mit seinen Legionen auf.“"
                                            },
                                            {
                                                "example_id": "a6eba357-7a20-42e5-b1db-bd2a4ce75316",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„1000 Jahre lang wird es keiner anderen europäischen Kultur gelingen, Segler zu konstruieren, die schneller unterwegs sind als die Kriegsschiffe der Wikinger, die Drachenboote.“"
                                            },
                                            {
                                                "example_id": "855d6e65-9376-4445-bcf5-87b7df5c672b",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Etwa 23 Millionen Menschen sind täglich in indischen Zügen unterwegs.“"
                                            },
                                            {
                                                "example_id": "6d0beac0-1217-4d8b-aa69-685b1dc116bb",
                                                "sense_id": "995a02ef-c4cd-3479-81a9-7954f0cdfce3",
                                                "text": "„Rund eine halbe“ [Million] „Fans sind jedes Bundesliga-Wochenende unterwegs, um Fußball im Stadion zu sehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "30800f1f-3eb7-4d35-b924-85b338ee8130",
                        "source_entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "source_sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "source_sense_description": "bezig zijn zich van plek A naar plek B te verplaatsen",
                        "target_lang_word": "on the way",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "on the way",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b907897b-354d-36ee-8082-28591255d2ce",
                                        "entry_id": "0b060b3e-b270-3ecd-b2c6-35833821bf4b",
                                        "glosses": [
                                            "Coming; approaching."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "914e6d3c-7513-4272-937b-3b7ccb9e58cd",
                                                "sense_id": "b907897b-354d-36ee-8082-28591255d2ce",
                                                "text": "Don't worry, Mr. President, help's on the way\nYour brothers are comin', there'll be hell to pay"
                                            },
                                            {
                                                "example_id": "3dd6d74c-4358-4bca-b783-cca66c86c8ac",
                                                "sense_id": "b907897b-354d-36ee-8082-28591255d2ce",
                                                "text": "Spring is on the way."
                                            },
                                            {
                                                "example_id": "a3bd9ba5-9979-4899-a869-81f64196fb6f",
                                                "sense_id": "b907897b-354d-36ee-8082-28591255d2ce",
                                                "text": "Don't panic! Reinforcements are on the way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48bb6ab-0786-3813-ac91-97afd486693e",
                                        "entry_id": "0b060b3e-b270-3ecd-b2c6-35833821bf4b",
                                        "glosses": [
                                            "Heading to a certain place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7a03cfe0-ae22-48bf-8bd1-be6807ab5586",
                                                "sense_id": "e48bb6ab-0786-3813-ac91-97afd486693e",
                                                "text": "We are on our way to the train station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e19d9a72-ba1d-3bcd-811d-6f6491fe33be",
                                        "entry_id": "0b060b3e-b270-3ecd-b2c6-35833821bf4b",
                                        "glosses": [
                                            "On the direct route that one intends to travel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddeca8e9-5a13-4c3f-9491-ec3ad0edb248",
                                                "sense_id": "e19d9a72-ba1d-3bcd-811d-6f6491fe33be",
                                                "text": "I can drop you at the station, as it is on my way home."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "592183b9-70b7-37af-b960-2bc01c88c53b",
                                        "entry_id": "0b060b3e-b270-3ecd-b2c6-35833821bf4b",
                                        "glosses": [
                                            "On one's way."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b7848e31-3b87-3067-bf0e-28abb3af0f03",
                                        "entry_id": "0b060b3e-b270-3ecd-b2c6-35833821bf4b",
                                        "glosses": [
                                            "While travelling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e8e5d40-4f2f-471c-8b51-318a611ab452",
                                                "sense_id": "b7848e31-3b87-3067-bf0e-28abb3af0f03",
                                                "text": "We expressed our readiness, and in ten minutes were in the station wagon, rolling rapidly down the long drive, for it was then after nine. We passed on the way the van of the guests from Asquith."
                                            },
                                            {
                                                "example_id": "aa2b20f7-3739-4850-9704-0883ab8ee032",
                                                "sense_id": "b7848e31-3b87-3067-bf0e-28abb3af0f03",
                                                "text": "We gathered up what was left of the red deer after skinning and cleaning it, and set out upon our return journey toward the U-boat. On the way Olson, von Schoenvorts and I discussed the needs of our immediate future, and we were unanimous in placing foremost the necessity of a permanent camp on shore."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "27ce89ec-4408-457e-ab47-06e23f18f79b",
                        "source_entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "source_sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "source_sense_description": "bezig zijn zich van plek A naar plek B te verplaatsen",
                        "target_lang_word": "en route",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en route",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "85e69d50-45e4-3d99-8886-32d3b198b6b8",
                                        "entry_id": "0100e153-b7e0-327e-b124-bcbfe3345961",
                                        "glosses": [
                                            "On the way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aed85024-7f64-41b0-92f8-8030d934ef53",
                                                "sense_id": "85e69d50-45e4-3d99-8886-32d3b198b6b8",
                                                "text": "The shipment is en route to the buyer."
                                            },
                                            {
                                                "example_id": "474bb941-3992-48ea-bdc1-698a43bb404a",
                                                "sense_id": "85e69d50-45e4-3d99-8886-32d3b198b6b8",
                                                "text": "Nearly a century ago, my grandfather passed through Istanbul en route to Europe along with hordes of other White Russians fleeing the Russian civil war."
                                            },
                                            {
                                                "example_id": "d839a90b-4730-4ff4-b2f5-becf0b88f766",
                                                "sense_id": "85e69d50-45e4-3d99-8886-32d3b198b6b8",
                                                "text": "Italy's potential opponents in Sunday's final might hope this game has taken a lot out of Mancini's men but you would not bank on it from a side who have simply got better and better, now adding Spain to Belgium as they claim victims of the highest class en route to the showpiece."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76a7e968-4b4e-368b-84a8-595de319e3e2",
                                        "entry_id": "0100e153-b7e0-327e-b124-bcbfe3345961",
                                        "glosses": [
                                            "Along the way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "26b8cd31-2839-4e26-9b92-44af7715b311",
                                                "sense_id": "76a7e968-4b4e-368b-84a8-595de319e3e2",
                                                "text": "The army advanced, capturing several cities en route."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "702c18fa-9bb3-4c23-950f-165ba1179bb4",
                        "source_entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "source_sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "source_sense_description": "bezig zijn zich van plek A naar plek B te verplaatsen",
                        "target_lang_word": "en chemin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "en chemin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0df159f-e041-33f1-bd02-ac7e9281f3e7",
                                        "entry_id": "6e4a4afb-39eb-39f4-bff3-5757beffa7b7",
                                        "glosses": [
                                            "Pendant que l’on chemine, durant le voyage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9befe917-18fe-4b3b-b465-4a81ed9b640e",
                                                "sense_id": "d0df159f-e041-33f1-bd02-ac7e9281f3e7",
                                                "text": "En chemin, il croisa Paul qui rejoignait également les volontaires. C’est donc ensemble qu’ils rallièrent la section du veldcornet Roos, une cinquantaine de gaillards bardés de munitions."
                                            },
                                            {
                                                "example_id": "5ea0c34f-a287-40ed-b8dd-c5f49e566c71",
                                                "sense_id": "d0df159f-e041-33f1-bd02-ac7e9281f3e7",
                                                "text": "Peut-être pensait-il qu’un jour les victimes seraient récompensées à la mesure de leur sacrifice, c’est à dire à proportion des molaires abandonnées en chemin. Lui-même avait payé tribut de ses incisives et pouvait en concevoir de grandes espérances."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9c4adc3-1c14-4c56-b16d-2461057519ec",
                        "source_entry_id": "433e9cbd-aade-3b05-8947-9c5e0c212a31",
                        "source_sense_id": "fb19d196-2359-3606-9095-9b35e76a793f",
                        "source_sense_description": "bezig zijn zich van plek A naar plek B te verplaatsen",
                        "target_lang_word": "chemin faisant",
