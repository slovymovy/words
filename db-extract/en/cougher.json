                "entry_id": "9ffba827-9b36-326b-bddb-1fbc31480f52",
                "word": "cougher",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "66cfcb51-c264-4092-8bce-c86dc5d578b8",
                        "entry_id": "9ffba827-9b36-326b-bddb-1fbc31480f52",
