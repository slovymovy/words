                                        "glosses": [
                                            "The figure who introduced Islam, and the man to whom the Qur'an was revealed; considered a prophet by Muslims and Baháʼís."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
