                ],
                "senses": [
                    {
                        "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                        "entry_id": "3bba69d0-4c30-3d11-af73-aef387c8b620",
                        "glosses": [
                            "Bewohner des Balkan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ae68dfc-6d72-43b2-a906-e5ba9d46b70e",
                                "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                                "text": "„Es waren Holz-Fertigteile für die provisorische Siedlung, von der aus die Balkan-Bewohner eine Bahnstation mit Betonhäusern hochziehen.“"
                            },
                            {
                                "example_id": "56e7b446-6238-4e15-b48d-6e99801a141e",
                                "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                                "text": "„Den Individualismus dieser Balkanbewohner hat auch die Partei mit Stalins eisernem Besen nicht restlos auskehren können.“"
                            },
                            {
                                "example_id": "1b1cc0e3-0258-4100-b5a0-2beaa894c27b",
                                "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                                "text": "„Beide haben vielmehr dem Alltag und der Produktion zu dienen: Die Partei stimuliert mit ihrer Hilfe den Stolz dieser ältesten Balkanbewohner auf den Wiederaufstieg aus dem Nichts.“"
                            },
                            {
                                "example_id": "ac592327-8a76-48e2-abfd-af516764264a",
                                "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                                "text": "„Was alle verbindet, ist der grenzenlose nationale Stolz dieser ältesten Balkanbewohner, sich gegen eine imperialistische Umwelt, von Montenegro bis Moskau, von Athen bis Ankara, von Serbien bis Italien, durchgesetzt zu haben.“"
                            },
                            {
                                "example_id": "0d6de99c-e841-4a95-b583-4f022ad78c0f",
                                "sense_id": "e696fe0f-120b-30af-bfa6-68d1785dfe0f",
                                "text": "„Die deutsche Wirtschaft fordert über die am Samstag in Kraft tretende Abschaffung der Visumspflicht für die Staatsbürger Serbiens, Montenegros und Mazedoniens hinaus nun die Reisefreiheit für alle Balkan-Bewohner.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
