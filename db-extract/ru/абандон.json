                "translations": [
                    {
                        "translation_id": "24b59af4-8ade-4f58-9447-b1c6b09d2e19",
                        "source_entry_id": "cc32d5bf-5344-331c-8d41-425cf207fc24",
                        "target_lang_word": "abandon",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abandon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6239ae73-78f5-34fe-ac91-fd02479a11af",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To give up or relinquish control of, to surrender or to give oneself over, or to yield to one's emotions."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaceeda1-5e14-418c-8f60-b156283b35a5",
                                                "sense_id": "6239ae73-78f5-34fe-ac91-fd02479a11af",
                                                "text": "[…] he abandoned himself […] to his favourite vice."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ca33cae-4dce-36a7-9fce-dd38f1480632",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To desist in doing, practicing, following, holding, or adhering to; to turn away from; to permit to lapse; to renounce; to discontinue."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66dfbfd2-ce39-4ac3-a3fd-609806641fda",
                                                "sense_id": "6ca33cae-4dce-36a7-9fce-dd38f1480632",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. […] The public realm is privatised, the regulations restraining the ultra–wealthy and the companies they control are abandoned, and Edwardian levels of inequality are almost fetishised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To leave behind; to desert, as in a ship, a position, or a person, typically in response to overwhelming odds or impending dangers; to forsake, in spite of a duty or responsibility."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a9309fc-85ff-40d8-a121-36f93f9f82f0",
                                                "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                                                "text": "Many baby girls have been abandoned on the streets of Beijing."
                                            },
                                            {
                                                "example_id": "c9b8658b-9d66-4c19-bd2c-64561ad5a8f6",
                                                "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                                                "text": "He was abandoned on the island with no one to help him."
                                            },
                                            {
                                                "example_id": "ebe53a37-bee9-4a19-9878-3f0cde46c21e",
                                                "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                                                "text": "She abandoned her husband for a new man."
                                            },
                                            {
                                                "example_id": "f5a96835-1dc6-406e-a613-ea8d5e539185",
                                                "sense_id": "41a18f65-edd0-3487-b48f-04653a4f284b",
                                                "text": "Hope was overthrown, and yet could not be abandoned."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e26225c5-2dc5-3310-b2ce-0d89fbeaeef9",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To subdue; to take control of."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0c85b6e2-94ef-3caf-9c57-40115bd530da",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To cast out; to banish; to expel; to reject."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e92d7374-20d8-4033-afa0-4f6cde340006",
                                                "sense_id": "0c85b6e2-94ef-3caf-9c57-40115bd530da",
                                                "text": "Being all this time abandoned from your bed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "79a9872d-94c6-3940-96e7-e92fc76ddaac",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To no longer exercise a right, title, or interest, especially with no interest of reclaiming it again; to yield; to relinquish."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6a0ffbf-4336-46b9-9581-c83ae72744e2",
                                                "sense_id": "79a9872d-94c6-3940-96e7-e92fc76ddaac",
                                                "text": "I hereby abandon my position as manager."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fef0eca7-7431-3c42-9991-c8d4305bace7",
                                        "entry_id": "82877cd1-cc30-3a59-b803-ec244f565f2b",
                                        "glosses": [
                                            "To surrender to the insurer (an insured item), so as to claim a total loss."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "abandon",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                                        "entry_id": "27b2e666-8b86-3351-950a-bfbbf4b3ff65",
                                        "glosses": [
                                            "A yielding to natural impulses or inhibitions; freedom from artificial constraint, with loss of appreciation of consequences. (Now especially in the phrase with abandon.)"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4f71dbd-77a5-492f-8378-bf820243af7e",
                                                "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                                                "text": "with gay abandon, with wild abandon"
                                            },
                                            {
                                                "example_id": "0365668a-127b-41b0-a737-e145b87e0d3b",
                                                "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                                                "text": "The Italian painters have an abandon in their chiar' oscuro which mellows up their flesh tints in a way that no other school can imitate : the frigidity of their outline is another remarkable feature, and the harmony of their impasto is unique."
                                            },
                                            {
                                                "example_id": "804e80cf-7f04-42b6-b739-1a83ed58c06e",
                                                "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                                                "text": "I envy those chroniclers who assert with reckless but sincere abandon: 'I was there. I saw it happen. It happened thus.'"
                                            },
                                            {
                                                "example_id": "742cfd36-d986-4e40-8f42-892e94069439",
                                                "sense_id": "677c42da-069b-31ba-94df-9d8f73a7ed6d",
                                                "text": "They needed to have an abandon in their performance that you just can’t get out of people in the middle of the night when they’re barefoot."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd3be12-bdb2-3bac-abe1-89c463c7ad36",
                                        "entry_id": "27b2e666-8b86-3351-950a-bfbbf4b3ff65",
                                        "glosses": [
                                            "Abandonment; relinquishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa1bc8ff-6026-437c-b702-2104c4ecbdbc",
                        "source_entry_id": "cc32d5bf-5344-331c-8d41-425cf207fc24",
                        "target_lang_word": "abandonment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abandonment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "387e8c2e-b4ee-3f9c-be56-38d361fb89ec",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The act of abandoning, or the state of being abandoned; total desertion; relinquishment."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9fa719ab-5271-46e7-ade5-a9eb3c3aef87",
                                                "sense_id": "387e8c2e-b4ee-3f9c-be56-38d361fb89ec",
                                                "text": "To what are we reserved? An adequate compensation \"for the sacrifice of powers the most nearly connected with us;\"— an adequate compensation \"for the direct or indirect annexation to France ot all the ports of the continent, from Dunkirk to Hamburgh;\"— an adequate compensation \"for the abandonment of the independence of Europe!\""
                                            },
                                            {
                                                "example_id": "5b7e40fd-aef0-4390-abd2-1d0a6f95f718",
                                                "sense_id": "387e8c2e-b4ee-3f9c-be56-38d361fb89ec",
                                                "text": "The fate of the railway from Ballater to Braemar has been invested with an air of mystery, which has never been completely dispelled. It has been suggested that Queen Victoria was opposed to a railway in the vicinity of Balmoral Castle, and intervened personally to secure the abandonment of the line beyond Ballater."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c5c9050d-c102-3cb3-8504-76dfc9dcafa0",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The voluntary leaving of a person to whom one is bound by a special relation, as a wife, husband or child; desertion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "67d017e9-a706-4b96-9601-46763dae8590",
                                                "sense_id": "c5c9050d-c102-3cb3-8504-76dfc9dcafa0",
                                                "text": "Since he left her, she's suing him for divorce on grounds of abandonment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86e5df2b-2a14-3795-aabd-43a7bcca99a4",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "An abandoned building or structure."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16636c93-5a54-4033-a057-60842d6e38b2",
                                                "sense_id": "86e5df2b-2a14-3795-aabd-43a7bcca99a4",
                                                "text": "High-profile abandonments are harder to infiltrate for urban explorers due to their heightened security."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c7d6cfc-0063-387d-a8d4-42443450da10",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The relinquishment of a right, claim, or privilege; relinquishment of right to secure a patent by an inventor; relinquishment of copyright by an author."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9e524543-0873-3d50-8735-ae097b2c7993",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The relinquishment by the insured to the underwriters of what may remain of the property insured after a loss or damage by a peril insured against."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28c95c66-232f-3ff3-a2b6-847a888def69",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The cessation of service on a particular segment of the lines of a common carrier, as granted by a government agency."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0d8f4f3-a11a-436b-b74d-3099425158af",
                                                "sense_id": "28c95c66-232f-3ff3-a2b6-847a888def69",
                                                "text": "The railway was in fact shifted in 1937 a little to the west, over a distance of a quarter-mile, to make room for the by-pass at this point, but complete abandonment was firmly vetoed because of the proved strategic value of the line."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "996d43ff-4c96-3888-b382-94309b85212b",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "A refusal to receive freight so damaged in transit as to be worthless and render carrier liable for its value."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f40a0a61-3aef-3306-b2ec-6e2bcbce9045",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "The self-surrender to an outside influence."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cf982cbd-0529-3876-aa93-2fc089611383",
                                        "entry_id": "8f59ad6f-1cfe-3a83-8be1-61afbad1f6e8",
                                        "glosses": [
                                            "Abandon; careless freedom or ease; surrender to one's emotions."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8018921-cda5-49e5-9e06-060a94b8c57a",
                                                "sense_id": "cf982cbd-0529-3876-aa93-2fc089611383",
                                                "text": "Roger, in terms of the strengths he brought to the band, was wild abandonment. So if Howard was in the pocket, Roger was bouncing off the walls, and Nancy was somewhere in the middle."
                                            }
                                        ]
                                    }
