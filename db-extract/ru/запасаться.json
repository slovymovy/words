                ],
                "senses": [
                    {
                        "sense_id": "b5129ee4-c556-366f-9492-de3202828a32",
                        "entry_id": "7e215b45-81ad-3004-a7a3-4f9266a11d66",
                        "glosses": [
                            "запасать для себя что-либо, обеспечивать себя чем-либо на случай необходимости"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32218770-b547-4805-9aee-fe5a478157bb",
                                "sense_id": "b5129ee4-c556-366f-9492-de3202828a32",
                                "text": "Ловцы, по большей части чуваши, черемисы и вотяки, запасаются ягодами с осени и продолжают ловлю во всю зиму."
                            },
                            {
                                "example_id": "ffd1ca25-95fc-4970-82f4-5b13266ed5e6",
                                "sense_id": "b5129ee4-c556-366f-9492-de3202828a32",
                                "text": "Ты умно делаешь, что запасаешься некоторыми необходимыми для тебя вещами."
                            },
                            {
                                "example_id": "6a7444ae-6192-4a8a-b25f-9b4d6473842e",
                                "sense_id": "b5129ee4-c556-366f-9492-de3202828a32",
                                "text": "Школы важное дело, конечно, но школам надобен дух и направление, — вот мы и идем теперь запасаться духом и добывать здоровое направление."
                            }
                        ]
                    },
                    {
                        "sense_id": "3da9e22f-b4ce-343c-85a8-d5d436862798",
                        "entry_id": "7e215b45-81ad-3004-a7a3-4f9266a11d66",
                        "glosses": [
                            "страд. к запасать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "b476e4cc-d30f-4843-b3ea-a28d36909b5c",
                                "sense_id": "3da9e22f-b4ce-343c-85a8-d5d436862798",
                                "text": "Наконец, записывалось жалованье мифическим служащим, существовавшим только, на бумаге; спекулировали на провианте, который запасался рабочим, и т. д."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "62465bbe-3725-4603-9934-325ea363aa71",
                        "source_entry_id": "7e215b45-81ad-3004-a7a3-4f9266a11d66",
                        "source_sense_description": "обеспечивать себя на случай необходимости",
                        "target_lang_word": "provide oneself",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "d67488d0-ab17-4e6d-903e-50e8571b8387",
                        "source_entry_id": "7e215b45-81ad-3004-a7a3-4f9266a11d66",
                        "source_sense_description": "обеспечивать себя на случай необходимости",
                        "target_lang_word": "stock up",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stock up",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c48b0bb3-3f90-35e3-8a78-fbf35c8364ef",
                                        "entry_id": "a7ae9c10-7287-3231-b689-61208df35087",
                                        "glosses": [
                                            "To acquire or increase stock or inventory."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "often",
                                            "with-on"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6bda4c4b-c12f-4e51-9017-8b209111c852",
                                                "sense_id": "c48b0bb3-3f90-35e3-8a78-fbf35c8364ef",
                                                "text": "Q: What about fuel oil? A: We plan to stock up before November."
                                            },
                                            {
                                                "example_id": "ada3edec-3f15-43c6-9d34-97c91ae5ba90",
                                                "sense_id": "c48b0bb3-3f90-35e3-8a78-fbf35c8364ef",
                                                "text": "Q: What about food? A: We're planning to stock up on canned goods before November."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aee0c1ff-6354-37a0-9159-4e6a703476a8",
                                        "entry_id": "a7ae9c10-7287-3231-b689-61208df35087",
                                        "glosses": [
                                            "To swell up (usually refers to edema in a leg)."
                                        ],
                                        "tags": [
