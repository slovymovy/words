                ],
                "senses": [
                    {
                        "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                        "entry_id": "2c505d4e-9ec0-3081-8df9-f8ee47fc6a41",
                        "glosses": [
                            "Situation, die durch (amtliche) Aufzeichnungen untermauert ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3916980-0e23-40e5-9f57-5ebe7a6154c9",
                                "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                                "text": "„Es gab Vorgängereinrichtungen, da gab es kaum einen Aktenbestand, den wir in das neue Institut überführt haben, weil sehr viel diskursiv und dann durch eine wage Protokolllage geklärt worden ist.“"
                            },
                            {
                                "example_id": "604f9eeb-4e7d-4875-abd6-9ac03fd9cecd",
                                "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                                "text": "„Trotz der späteren Berichtigung war also weiterhin von der früheren Protokolllage auszugehen […].“"
                            },
                            {
                                "example_id": "aa916b26-3f58-4a1c-978f-3180d5ad7dc0",
                                "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                                "text": "„Die Entscheidung nach Protokolllage, dass es keine Übereinstimmung zwischen der Spurenauswertung von damals und der eingesandten Bodenprobe geben könne, zerschlug die Hoffnung auf einen tatsicheren Beweis.“"
                            },
                            {
                                "example_id": "b6c100fd-2f52-46c2-83d7-9b6c8f0b31d3",
                                "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                                "text": "„Dieser Leitfaden ersetzt die bisherigen stellplatzbezogenen Dienstanweisungen und Protokolllagen der Bauaufsicht Frankfurt.“"
                            },
                            {
                                "example_id": "88de106b-c5d5-478d-82c7-f6b4e7542132",
                                "sense_id": "64eb513d-fa37-3087-aa7c-d4ea1cf0c77c",
                                "text": "„Auch die Diskussion weiterer Leistungsdaten, wie z. B. Bildungsgangempfehlungen, bildet sich in den Protokolllagen der schulischen Gremien nicht ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
