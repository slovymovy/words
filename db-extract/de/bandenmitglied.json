                            {
                                "example_id": "bcfca804-efe7-413a-86f9-1a79dd2fafbd",
                                "sense_id": "b7651b0b-3784-3b30-b0fe-5ebc55c853be",
                                "text": "Alle Bandenmitglieder konnten verhaftet werden."
                            },
                            {
                                "example_id": "99300449-21fa-42d1-a8e1-649f501b8578",
                                "sense_id": "b7651b0b-3784-3b30-b0fe-5ebc55c853be",
                                "text": "„Referent vermißt nämlich eine Bestimmung darüber, wie es mit einem Bandenmitgliede zu halten, das aus freiem Antriebe sich vor der Entdeckung von derselben losgemacht und einen redlichen Erwerbszweig ergriffen hat, …“ (1827)"
                            }
