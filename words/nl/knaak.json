            "senses": [
                {
                    "sense_id": "e59f2c21-de45-303e-9deb-a5156f670772",
                    "sense_definition": "Een voormalig Nederlands muntstuk met een waarde van tweeënhalve gulden.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "muntstuk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vroeger kon je voor een <w>knaak</w> nog een hele zak snoep kopen bij de lokale winkel.",
                            "target_lang_translations": {
                                "en": "In the past, you could still buy a whole bag of candy for a <w>knaak</w> at the local shop."
                            }
                        },
                        {
                            "text": "Hij vond een oude <w>knaak</w> in de la van zijn grootvader en bewaarde deze als aandenken.",
                            "target_lang_translations": {
                                "en": "He found an old <w>rijksdaalder</w> in his grandfather's drawer and kept it as a souvenir."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijksdaalder"
                    ],
                    "common_phrases": [
                        "een oude knaak"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informele benaming voor een rijksdaalder"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "verwijst naar de guldenperiode"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A former Dutch coin with a value of two and a half guilders."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rijksdaalder",
                                "target_lang_sense_clarification": "the official name of the 2.50 guilder coin"
                            },
                            {
                                "target_lang_word": "knaak",
                                "target_lang_sense_clarification": "slang term for the 2.50 guilder coin"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8999b9f9-43d1-3fd6-b35b-0239bc688385",
                    "sense_definition": "Een groot of waardevol muntstuk in algemene zin.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "muntstuk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De verzamelaar legde een glimmende <w>knaak</w> op tafel om de waarde te laten zien.",
                            "target_lang_translations": {
                                "en": "The collector placed a shiny <w>large coin</w> on the table to show its value."
                            }
                        },
                        {
                            "text": "In die tijd was zo'n zware <w>knaak</w> in je zak een klein fortuin voor een kind.",
                            "target_lang_translations": {
                                "en": "In those days, such a heavy <w>coin</w> in your pocket was a small fortune for a child."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "informeel gebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A large or valuable coin in a general sense."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "large coin",
                                "target_lang_sense_clarification": "referring to physical size and weight"
                            },
                            {
                                "target_lang_word": "big coin",
                                "target_lang_sense_clarification": "informal description of a substantial coin"
                            }
                        ]
                    }
