                                        "glosses": [
                                            "A person who has Tourette syndrome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b963dfea-9a4f-44a6-873b-9bcf06723688",
                                                "sense_id": "38b1d851-f11e-3358-b8e0-0465b5ac4e24",
                                                "text": "Less frequently, Touretters may also perform obscene actions suchas making sexual gestures (copropraxia) or writing obscene material (coprographia) (Freeman et al., 2009)."
                                            },
                                            {
                                                "example_id": "21e03be5-b496-4a3f-9967-df95bd7c28f2",
                                                "sense_id": "38b1d851-f11e-3358-b8e0-0465b5ac4e24",
                                                "text": "Touretters also occasionally suffer from copropraxia, which involves obscene gestures such as giving the finger or crotch grabbing, and coprographia, the urge to make obscene drawings."
                                            }
                                        ]
