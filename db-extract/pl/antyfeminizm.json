                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antifeminismus",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "e3bb51af-6e3f-32c7-a757-875e96f64f4e",
                                        "entry_id": "914604c4-5c91-3b58-b762-f9e0c85fda57",
                                        "glosses": [
                                            "odpor proti ženám a především jejich uplatnění ve veřejném životě, proti feministickému hnutí"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3dd213a1-503a-4923-b918-6fd48fdbf491",
                        "source_entry_id": "f61070e1-3a98-3342-9082-44f90016f470",
                        "source_sense_id": "2e9daf50-6d8d-35a6-895b-0ceafea4b45f",
                        "target_lang_word": "antiféminisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiféminisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6218f4c-2045-360f-a53f-5beca06cbe2a",
                                        "entry_id": "5467f353-05cd-3e69-a72b-ccd9275984bc",
                                        "glosses": [
                                            "Opposition au féminisme et à sa doctrine pour des raisons d’ordre politique, culturel, philosophique ou religieux."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5df9b08a-361c-4324-b140-87fc6958119d",
                                                "sense_id": "b6218f4c-2045-360f-a53f-5beca06cbe2a",
                                                "text": "À peine apparu, le féminisme suscite déjà un mouvement d’opposition : l’antiféminisme."
                                            },
                                            {
                                                "example_id": "78be9743-adec-42c5-aa1d-80ee223b51cd",
                                                "sense_id": "b6218f4c-2045-360f-a53f-5beca06cbe2a",
                                                "text": "Par ailleurs, dans ces deux sociétés, la montée des intégrismes religieux a rendu possible le développement, dans la mouvance conservatrice, d’un antiféminisme aussi virulent que radical."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
