                        "glosses": [
                            "Circuler la nuit sous forme de garou."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "673fa8db-1219-4626-936c-d87c868ab475",
                                "sense_id": "29d3fc53-248e-337d-8af4-d0cf9e084487",
                                "text": "Pris moins tôt il aurait dû garouter sept ans, toutes les nuits, dans sept paroisses."
                            },
