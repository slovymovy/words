                ],
                "senses": [
                    {
                        "sense_id": "bbf9fd32-5322-3d20-80fc-330b4c97d0f2",
                        "entry_id": "5a784006-0b9c-3c9b-b75a-c8e57968ce84",
                        "glosses": [
                            "утрачивать яркость, тускнеть (о красках, тонах)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "400fa74e-8c62-42a6-941a-e6ad533c9085",
                                "sense_id": "bbf9fd32-5322-3d20-80fc-330b4c97d0f2",
                                "text": "Современные краски с течением времени жухнут, теряют яркость."
                            }
                        ]
                    },
                    {
                        "sense_id": "3ce8993f-0608-3346-99b0-0cb850099677",
                        "entry_id": "5a784006-0b9c-3c9b-b75a-c8e57968ce84",
                        "glosses": [
                            "утрачивать свежесть, сохнуть (о траве, листьях, коже)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4030d461-7a10-4c4e-bffb-b8b172dcbd42",
                                "sense_id": "3ce8993f-0608-3346-99b0-0cb850099677",
                                "text": "Так начинается поход: // Ветер листву метёт. // Громче кричит по ночам сова, // Жухнет в лугах трава."
                            },
                            {
                                "example_id": "8b27619d-ae16-497c-a638-ece19bbbceee",
                                "sense_id": "3ce8993f-0608-3346-99b0-0cb850099677",
                                "text": "Раскаленное солнце сухого сезона сжигает траву и листья латаний. Буреет и жухнет бамбук."
                            }
                        ]
                    },
                    {
                        "sense_id": "048565fc-5c34-329f-b318-a2916daf2db2",
                        "entry_id": "5a784006-0b9c-3c9b-b75a-c8e57968ce84",
                        "glosses": [
                            "перен. чахнуть, лишаться силы, кончаться, сходить на нет"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982fc1b9-8166-4e94-9c62-5c0044cffda5",
                                "sense_id": "048565fc-5c34-329f-b318-a2916daf2db2",
                                "text": "И разговор вянет, замолкает, жухнет, словно всё на свете уже сказано."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "14933347-f62b-4d1f-aa19-1ad6cd9572cc",
                        "source_entry_id": "5a784006-0b9c-3c9b-b75a-c8e57968ce84",
                        "source_sense_description": "утрачивать яркость, тускнеть",
                        "target_lang_word": "fade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b215809e-d446-353b-9491-d227691c7767",
                                        "entry_id": "b2945808-b249-3f76-9327-d43e83378dbf",
                                        "glosses": [
                                            "Weak; insipid; tasteless."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d944db4b-a2e9-4545-b10d-39081457766a",
                                                "sense_id": "b215809e-d446-353b-9491-d227691c7767",
                                                "text": "1825, Francis Jeffrey, Lord Jeffrey, review of Theodric by Thomas Campbell\nPassages that are somewhat fade."
                                            },
                                            {
                                                "example_id": "c78cfe53-4976-4cd4-8153-277ed246e615",
                                                "sense_id": "b215809e-d446-353b-9491-d227691c7767",
                                                "text": "His masculine taste gave him a sense of something fade and ludicrous."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b63d481-de7c-31ae-a475-696e53937e4d",
                                        "entry_id": "3cd9dd27-4714-3e1f-8776-e9f324d83746",
                                        "glosses": [
                                            "A golf shot that curves intentionally to the player's right (if they are right-handed) or to the left (if left-handed)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be44e6af-84ab-4e64-875f-326f31e77e75",
                                                "sense_id": "3b63d481-de7c-31ae-a475-696e53937e4d",
                                                "text": "If you confine yourself to hitting straight shots while you are developing your golf swing, you are less likely to develop a preference for hitting a fade or a draw."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "890a5af1-c0b2-3e6f-8ac9-6294fc5ac943",
                                        "entry_id": "3cd9dd27-4714-3e1f-8776-e9f324d83746",
                                        "glosses": [
                                            "A haircut where the hair is short or shaved on the sides of the head and longer on top. See also high-top fade and low fade."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c7499e01-36bd-3fe4-a4cb-52cbbc4725a0",
                                        "entry_id": "3cd9dd27-4714-3e1f-8776-e9f324d83746",
                                        "glosses": [
                                            "A fight."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07e896e9-4189-3872-b577-9e3fec48fefc",
                                        "entry_id": "3cd9dd27-4714-3e1f-8776-e9f324d83746",
                                        "glosses": [
                                            "A gradual decrease in the brightness of a shot or the volume of sound or music (as a means of cutting to a new scene or starting a new song)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "401af2d1-dbeb-387c-9d74-cbdbf64926fb",
                                        "entry_id": "3cd9dd27-4714-3e1f-8776-e9f324d83746",
                                        "glosses": [
                                            "The act of disappearing from a place so as not to be found; covert departure."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "997ce5bf-0990-475c-895d-d3d7fd67511b",
                                                "sense_id": "401af2d1-dbeb-387c-9d74-cbdbf64926fb",
                                                "text": "Ace could have done a fade. Instead, he gathered all his courage — which was not inconsiderable, even in his middle age — and went to see the Flying Corson Brothers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "846eeff5-6ff6-31f5-b4e6-d25cab32686b",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To hit the ball with the shot called a fade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1f104d3c-ebdc-4346-8ef4-c396b3dcbcea",
                                                "sense_id": "846eeff5-6ff6-31f5-b4e6-d25cab32686b",
                                                "text": "The Golden Bear faded the ball from left to right with great consistency, so he seldom had to worry about trouble on the left."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c3a43731-a87c-31da-809a-38f72c1668f2",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To grow weak; to lose strength; to decay; to perish gradually; to wither, as a plant."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbd8574b-d3c0-49b6-83ed-00c66fefc262",
                                                "sense_id": "c3a43731-a87c-31da-809a-38f72c1668f2",
                                                "text": "The earth mourneth and fadeth away."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To lose freshness, color, or brightness; to become faint in hue or tint; hence, to be wanting in color."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbf0bb2a-f1ba-44c1-aedf-e65ae38933da",
                                                "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                                "text": "[flowers] that never fade"
                                            },
                                            {
                                                "example_id": "f5c41b5b-356b-4c60-89c4-b09e82f5adf2",
                                                "sense_id": "5233635d-ad0d-3cb5-983b-d7f794af3604",
                                                "text": "The half-dozen pieces […] were painted white and carved with festoons of flowers, birds and cupids. To display them the walls had been tinted a vivid blue which had now faded, but the carpet, which had evidently been stored and recently relaid, retained its original turquoise."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To sink away; to disappear gradually; to grow dim; to vanish."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a73d6cba-500c-45c8-8b4d-5dacfaa6bf4c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "The milkman's whistling faded into the distance."
                                            },
                                            {
                                                "example_id": "b27975a7-d47e-40d5-a9f0-cdee6d94249c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "He makes a swanlike end, / Fading in music."
                                            },
                                            {
                                                "example_id": "33b3c154-5d41-46b5-a74c-1842febef828",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "1856, Eleanor Marx-Aveling (translator), Gustave Flaubert, Madame Bovary, Part III Chapter XI,\nA strange thing was that Bovary, while continually thinking of Emma, was forgetting her. He grew desperate as he felt this image fading from his memory in spite of all efforts to retain it. Yet every night he dreamt of her; it was always the same dream. He drew near her, but when he was about to clasp her she fell into decay in his arms."
                                            },
                                            {
                                                "example_id": "fcf4cdc0-a3bd-4921-b645-633a1590640c",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "So many people have come and gone\nTheir faces fade as the years go by"
                                            },
                                            {
                                                "example_id": "1b2b002e-bfe1-4a1d-b1d2-03c260f6d8cc",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "They say your love will surely fade girl\nWhen things go wrong and trouble calls"
                                            },
                                            {
                                                "example_id": "6340b265-f4b0-40c2-9569-9c9da7ae966b",
                                                "sense_id": "fd6fadb9-d4ca-336e-93c9-b473217c805c",
                                                "text": "And with that, I think we'll leave 2021's tail lamp to fade into the distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4fdb5406-99d4-35a1-95f9-bb7f39c4ebd4",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To cause to fade."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0990483c-6144-3a8b-8767-39930dd565ff",
                                        "entry_id": "c9b81210-df68-3930-9b97-5fc83a47e47d",
                                        "glosses": [
                                            "To bet against (someone)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87180cb7-9822-43b6-b95d-0f7f787ebdb6",
                                                "sense_id": "0990483c-6144-3a8b-8767-39930dd565ff",
                                                "text": "I tried to get some bets that y'all were fixin' to get married but nobody would fade me."
                                            }
                                        ]
                                    }
                                ]
                            },
