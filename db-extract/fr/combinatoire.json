                                        "entry_id": "925b327b-a6af-31ba-9c08-d0fa5c136717",
                                        "glosses": [
                                            "mathematische Disziplin, die sich mit der Frage befasst, wie viele (und welche) Möglichkeiten (Kombinationen) es gibt, eine bestimmte Anzahl von Dingen auszuwählen und miteinander zu kombinieren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fcc8c01-e59c-44bb-ab2d-abb3fbed6917",
                                                "sense_id": "3c23070e-119b-3212-9b96-b9ab83a3b6d4",
                                                "text": "Kombinatorik wird in der Wahrscheinlichkeitsrechnung verwendet."
                                            },
                                            {
                                                "example_id": "ecbd7a6f-71c9-40a6-8fa4-58b5f164b1eb",
                                                "sense_id": "3c23070e-119b-3212-9b96-b9ab83a3b6d4",
                                                "text": "Die Kombinatorik kann sich zum Beispiel mit der Frage befassen, wie viele Möglichkeiten es gibt, die Buchstaben eines Alphabets bei einer festgelegten Wortlänge anzuordnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
