                        "entry_id": "8fd80ad5-2f11-374e-9dd1-6fcc38f39856",
                        "glosses": [
                            "choroba psychiczna objawiająca się halucynacjami, urojeniami, niezdolnością do współżycia społecznego"
                        ],
