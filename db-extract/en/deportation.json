                        "target_lang_word": "Ausweisung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausweisung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "703e1f75-afa7-327f-a6a2-7df9a1327858",
                                        "entry_id": "288758ec-5d50-313b-8db9-af60c5dbc964",
                                        "glosses": [
                                            "behördliche Aufforderung, das Land zu verlassen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee68cf5a-cb41-44d6-badd-ec8ed651fc69",
                                                "sense_id": "703e1f75-afa7-327f-a6a2-7df9a1327858",
                                                "text": "„Entweder machten sich die Leute, die Zauberwurzeln verkauften, der Hexerei schuldig, oder die Alraune hatte gar keine Zauberkräfte, dann ging es um Betrug.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c8c4e49-f852-3dea-ad55-31d97adc3d30",
                                        "entry_id": "288758ec-5d50-313b-8db9-af60c5dbc964",
                                        "glosses": [
                                            "Festlegung des Status einer Sache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecbec23-75b1-4fdc-b84d-ac212580c4d2",
                                                "sense_id": "3c8c4e49-f852-3dea-ad55-31d97adc3d30",
                                                "text": "Die Ausweisung neuer Baugebiete verzögert sich leider."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bcae1ed4-e321-4102-8e17-70235119a979",
                        "source_entry_id": "4e0c4863-d3a8-396d-9b77-d7473a8cdec0",
                        "source_sense_id": "ab11f41e-cdea-3321-b0df-52a3154cb4c8",
                        "source_sense_description": "act of deporting or exiling",
                        "target_lang_word": "Deportation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Deportation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                        "entry_id": "78453c73-1dc9-3e57-b82e-04ed9c2b86f8",
                                        "glosses": [
                                            "Verbringung einer Person/einer Gruppe von Personen gegen ihren Willen an einen bestimmten, fernen Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63a8e1a9-a225-4e4d-91b8-9b650b9d9856",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Das neue Kabinett von Premierminister William Pitt dem Jüngeren gelangte zu der Einsicht, dass andere, weniger anstößige Wege gefunden werden mussten, um zur Deportation verurteilte Straftäter loszuwerden.“"
                                            },
                                            {
                                                "example_id": "9ca4a556-ec61-4dbe-833d-1959376c5c63",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Zu ihnen gehörte die zwanzigjährige Mary Anderson, die seit ihrer Verurteilung zu sieben Jahren Deportation nach Übersee im Mai 1788 in Newgate einsaß.“"
                                            },
                                            {
                                                "example_id": "eed19b32-9a5b-4a28-a38d-a3558e4c383e",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Ab 1916 setzten zahlreiche Deportationen ein, auch von Frauen und Kindern.“"
                                            },
                                            {
                                                "example_id": "0a1ea02c-e3a9-4193-ac95-c0ff4b14bc47",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Ich glaubte mich zu erinnern, daß vor kurzem ein neues Gesetz verabschiedet worden war, auf Grund dessen die Krone die Möglichkeit hatte, ein Todesurteil in eine Deportation in die Kolonien umzuwandeln.“"
                                            },
                                            {
                                                "example_id": "9dff345e-bde6-4eb1-a6cf-b7104f9e96f6",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Noch vor der Deportation mussten die Juden ein Verzeichnis ihres Besitzes abgeben.“"
                                            },
                                            {
                                                "example_id": "d17b5a83-de33-444b-9a13-6ba82442f521",
                                                "sense_id": "e6ba3947-6488-305e-af1c-1edddb060674",
                                                "text": "„Die zweite Eroberung Jerusalems 587, für die es keine direkten außerbiblischen Zeugnisse gibt, endete mit einer Brandschatzung der Stadt und der Deportation von Judäern nach Babylonien […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
