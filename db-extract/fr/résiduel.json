                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                        "entry_id": "66525574-6961-3546-bbb1-509d450847b3",
                        "glosses": [
                            "Qui reste, qui persiste, qui constitue un résidu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "454f5f85-6114-4d5e-8daa-9564be5cf43c",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "Chômage résiduel : Chômage qui ne peut être éliminé même en période de plein emploi."
                            },
                            {
                                "example_id": "bd375bba-4ebe-45fd-b295-232ccb2620ae",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "Fatigue résiduelle : Fatigue qui ne s’élimine ni par le repos ni par les soins."
                            },
                            {
                                "example_id": "c9e718b4-a96a-42ac-b8f4-cd88b0e81e01",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "Air résiduel : Air qui reste en permanence dans les poumons après l’expiration."
                            },
                            {
                                "example_id": "e708c50d-82fb-4805-a7f3-4492b8c755a5",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "Charge résiduelle : Charge électrique qui subsiste dans un condensateur après une décharge. → voir rayonnement résiduel"
                            },
                            {
                                "example_id": "d32bb928-0b53-4cb7-a722-1ddfac92e2ce",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "Relief résiduel : Relief subsistant malgré l’érosion."
                            },
                            {
                                "example_id": "a2223f4d-bd1a-41bc-8dc8-8387b629a39f",
                                "sense_id": "c8c32f74-6445-3b1e-9a2a-a59ced79c606",
                                "text": "A l'Ouest de la Trappe existent des sols rubéfiés, extrêmement aréneux (avec plus de 90 % de sable), sur grès dunaire. Ils sont probablement d'origine résiduelle et partiellement d'origine d'origine éolienne et colluviale."
                            }
                        ]
                    },
                    {
                        "sense_id": "98d36f00-658d-34c7-8383-6a4f6d618b6c",
                        "entry_id": "66525574-6961-3546-bbb1-509d450847b3",
                        "glosses": [
                            "Qui est extrêmement limité, restreint, borné."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "aeb412cd-c8ca-4fcf-ac92-22dc9e38a7bf",
                                "sense_id": "98d36f00-658d-34c7-8383-6a4f6d618b6c",
                                "text": "[…] la jurisprudence a reconnu aux ministres, comme à tout chef de service, le pouvoir de réglementer l’organisation et le fonctionnement des services placés sous leur autorité. Mais ce pouvoir ne peut s’exercer que de manière résiduelle, sous réserve qu’aucun texte n’ait donné compétence à une autre autorité pour la matière considérée […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "64969cee-27f9-4229-8f95-6c528f8d8c5e",
                        "source_entry_id": "66525574-6961-3546-bbb1-509d450847b3",
                        "target_lang_word": "residual",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "residual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                        "entry_id": "313714ea-6724-30b6-93fd-5eb97da42de4",
                                        "glosses": [
                                            "Of, relating to, or remaining as a residue; left over."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11228b66-2777-4763-a378-aef52d16d0e7",
                                                "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                                "text": "Yet certain films leave a residual memory—such as Psycho: many people still feel uneasy showering in a motel bathroom."
                                            },
                                            {
                                                "example_id": "a75b0bdc-5735-4275-b974-4e055f9bb6d7",
                                                "sense_id": "e9ee953a-a3bb-34a5-bc3c-464f4be2b2df",
                                                "text": "Abolitionists argued that race had no place in a free and democratic society as a dividing line. Economic and social policies and practices, they argued, should be race-neutral and egalitarian. Yet despite these racially egalitarian values, much abolitionist rhetoric exhibited a strong residual commitment to racialist thinking and a palpable devotion to white supremacy."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "residual",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4fa5ec4a-be7f-300e-852b-df01d419b443",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "A remainder left over at the end of some process."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "Payments made to performers, writers and directors when a recorded broadcast is repeated."
                                        ],
                                        "tags": [
                                            "in-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3b4f37a3-0b3b-4d49-aa5d-2cea5ac8ae3d",
                                                "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                                "text": "The tentative deal announced this week by the Writers Guild of America includes many industry-specific aspects, such as the size of writers’ rooms and improved residuals for streaming."
                                            },
                                            {
                                                "example_id": "504d053a-3b35-4431-be07-01bdd7d7f45c",
                                                "sense_id": "e2b4b456-175b-3738-b8e2-3e757fb09f7f",
                                                "text": "Because, despite his very small role as shark victim Alex Kintner when he was 12, Voorhees is still being paid residuals – royalties – 50 years later. Every time Jaws is on TV, he earns money. […] “It pays to die,” is how he put it in a recent interview with Syfy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1a64b7a-b285-3b4e-836a-7d5cf892fd04",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "The difference between the observed value and the estimated value of the quantity of interest."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1014bca8-c7a1-385c-8874-ed1453df2d0c",
                                        "entry_id": "657c3292-f1ee-3ab2-a60f-aaa5192dea4e",
                                        "glosses": [
                                            "A spiritual presence left behind in a place as a result of a person's death or some other significant event."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
