{
    "word_family": [
        "podnosić",
        "podniesienie",
        "podnośnik",
        "podniosły",
        "podniosłość"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c4a88038-517c-318b-a7a8-40a676b49bd8",
                    "sense_definition": "Sprawić, że ktoś lub coś znajdzie się wyżej; wziąć coś do ręki z niższego poziomu.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physical_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Czy możesz mi pomóc <w>podnieść</w> tę ciężką walizkę na półkę?",
                            "target_lang_translations": {
                                "ru": "Ты можешь помочь мне <w>поднять</w> этот тяжелый чемодан на полку?",
                                "en": "Can you help me <w>lift</w> this heavy suitcase onto the shelf?"
                            }
                        },
                        {
                            "text": "Dziecko upuściło zabawkę i natychmiast próbowało ją <w>podnieść</w>.",
                            "target_lang_translations": {
                                "ru": "Ребенок уронил игрушку и тут же попытался ее <w>поднять</w>.",
                                "en": "The child dropped the toy and immediately tried to <w>pick</w> it <w>up</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "unieść",
                        "dźwignąć"
                    ],
                    "common_phrases": [
                        "podnieść rękę",
                        "podnieść głowę",
                        "podnieść ciężar",
                        "podnieść z ziemi"
                    ],
                    "target_lang_definitions": {
                        "ru": "Переместить кого-то или что-то выше; взять что-то в руки с более низкого уровня.",
                        "en": "To move someone or something to a higher position; to take or pick something up from a lower level."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "переместить вверх"
                            },
                            {
                                "target_lang_word": "подобрать",
                                "target_lang_sense_clarification": "взять с земли или пола"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lift",
                                "target_lang_sense_clarification": "to raise something upwards"
                            },
                            {
                                "target_lang_word": "pick up",
                                "target_lang_sense_clarification": "from the ground or a surface"
                            },
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "to move higher (e.g. hand, head)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7494608c-e77b-3823-b8fe-6a533af2976a",
                    "sense_definition": "Wstać z pozycji siedzącej lub leżącej; przyjąć pozycję stojącą (używane z zaimkiem „się”).",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "body_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Po długim odpoczynku musiał w końcu <w>podnieść</w> się z łóżka.",
                            "target_lang_translations": {
                                "ru": "После долгого отдыха ему пришлось наконец <w>подняться</w> с кровати.",
                                "en": "After a long rest, he finally had to <w>get up</w> from bed."
                            }
                        },
                        {
                            "text": "Kiedy dyrektor wszedł do sali, wszyscy uczniowie <w>podnieśli</w> się z krzeseł.",
                            "target_lang_translations": {
                                "ru": "Когда директор вошел в зал, все ученики <w>поднялись</w> со стульев.",
                                "en": "When the headmaster entered the room, all the students <w>stood up</w> from their chairs."
                            }
                        }
                    ],
                    "synonyms": [
                        "wstać",
                        "powstać",
                        "poderwać się"
                    ],
                    "common_phrases": [
                        "podnieść się z krzesła",
                        "podnieść się z łóżka",
                        "podnieść się z kolan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Встать из сидячего или лежачего положения; принять стоячее положение.",
                        "en": "To get up from a sitting or lying position; to stand up (used with the reflexive pronoun 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "встать на ноги"
                            },
                            {
                                "target_lang_word": "встать",
                                "target_lang_sense_clarification": "принять вертикальное положение"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "get up",
                                "target_lang_sense_clarification": "from bed or a seat"
                            },
                            {
                                "target_lang_word": "stand up",
                                "target_lang_sense_clarification": "to assume a standing position"
                            },
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "more formal"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b907f082-9c5a-39cb-a6ba-87ca3e7a3970",
                    "sense_definition": "Zwiększyć wartość, natężenie, poziom lub znaczenie czegoś.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sklep zdecydował się <w>podnieść</w> ceny wszystkich produktów spożywczych.",
                            "target_lang_translations": {
                                "ru": "Магазин решил <w>поднять</w> цены на все продукты питания.",
                                "en": "The shop decided to <w>raise</w> the prices of all food products."
                            }
                        },
                        {
                            "text": "Musiałem <w>podnieść</w> głos, bo w sali nikt mnie nie słyszał.",
                            "target_lang_translations": {
                                "ru": "Мне пришлось <w>повысить</w> голос, потому что в зале меня никто не слышал.",
                                "en": "I had to <w>raise</w> my voice because nobody in the hall could hear me."
                            }
                        }
                    ],
                    "synonyms": [
                        "zwiększyć",
                        "podwyższyć"
                    ],
                    "antonyms": [
                        "obniżyć"
                    ],
                    "common_phrases": [
                        "podnieść głos",
                        "podnieść ceny",
                        "podnieść kwalifikacje",
                        "podnieść standard"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличить стоимость, интенсивность, уровень или значение чего-либо.",
                        "en": "To increase the value, intensity, level, or importance of something."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "повысить",
                                "target_lang_sense_clarification": "увеличить уровень или значение"
                            },
                            {
                                "target_lang_word": "поднять",
                                "target_lang_sense_clarification": "увеличить цену или голос"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "raise",
                                "target_lang_sense_clarification": "prices, voice, standards"
                            },
                            {
                                "target_lang_word": "increase",
                                "target_lang_sense_clarification": "value, quantity, level"
                            },
                            {
                                "target_lang_word": "boost",
                                "target_lang_sense_clarification": "qualifications, morale"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e0f53b12-27ef-3358-8174-74ae8b4253cb",
                    "sense_definition": "Unieść się w powietrze lub poszybować w górę (używane z zaimkiem „się”).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "flight_movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kolorowy balon powoli <w>podniósł</w> się nad łąkę i odleciał w stronę lasu.",
                            "target_lang_translations": {
                                "ru": "Разноцветный воздушный шар медленно <w>поднялся</w> над лугом и улетел в сторону леса.",
                                "en": "The colourful balloon slowly <w>rose</w> above the meadow and drifted towards the forest."
                            }
                        },
                        {
                            "text": "Gęsta mgła <w>podniosła</w> się, odsłaniając piękny widok na góry.",
                            "target_lang_translations": {
                                "ru": "Густой туман <w>поднялся</w>, открывая прекрасный вид на горы.",
                                "en": "The dense fog <w>lifted</w>, revealing a beautiful view of the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "unieść się",
                        "wzlecieć"
                    ],
                    "common_phrases": [
                        "podnieść się do lotu",
                        "mgła się podniosła",
                        "kurz się podniósł"
                    ],
                    "target_lang_definitions": {
                        "ru": "Подняться в воздух или устремиться вверх (о самолете, тумане).",
                        "en": "To rise into the air or soar upwards (used with the reflexive pronoun 'się')."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "переместиться вверх"
                            },
                            {
                                "target_lang_word": "взлететь",
                                "target_lang_sense_clarification": "оторваться от земли"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "rise",
                                "target_lang_sense_clarification": "ascend into the air"
                            },
                            {
                                "target_lang_word": "lift",
                                "target_lang_sense_clarification": "disperse upwards, like fog"
                            },
                            {
                                "target_lang_word": "take off",
                                "target_lang_sense_clarification": "begin flight"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b474341a-add4-365c-8f93-bce9ff674247",
                    "sense_definition": "Stać się słyszalnym; rozlec się nagle i głośno (o dźwiękach, krzyku, hałasie).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na stadionie <w>podniosła</w> się wielka wrzawa po strzeleniu gola.",
                            "target_lang_translations": {
                                "ru": "На стадионе <w>поднялся</w> сильный шум после забитого гола.",
                                "en": "A huge roar <w>went up</w> in the stadium after the goal was scored."
                            }
                        },
                        {
                            "text": "Nagle w tłumie <w>podniósł</w> się krzyk przerażenia.",
                            "target_lang_translations": {
                                "ru": "Внезапно в толпе <w>раздался</w> крик ужаса.",
                                "en": "Suddenly, a cry of terror <w>arose</w> in the crowd."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozbrzmieć",
                        "rozlec się"
                    ],
                    "common_phrases": [
                        "podniósł się krzyk",
                        "podniosła się wrzawa",
                        "podniósł się lament"
                    ],
                    "target_lang_definitions": {
                        "ru": "Стать слышимым; внезапно раздаться (о звуках, крике, шуме).",
                        "en": "To become audible; to ring out suddenly and loudly (of sounds, shouts, clamour)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подняться",
                                "target_lang_sense_clarification": "возникнуть (о шуме)"
                            },
                            {
                                "target_lang_word": "раздаться",
                                "target_lang_sense_clarification": "стать слышимым"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "arise",
                                "target_lang_sense_clarification": "of a shout, clamour, or outcry"
                            },
                            {
                                "target_lang_word": "go up",
                                "target_lang_sense_clarification": "of a cry or cheer from a crowd"
                            },
                            {
                                "target_lang_word": "break out",
                                "target_lang_sense_clarification": "of sudden loud noise"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}