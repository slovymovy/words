                {
                    "sense_id": "695e2f01-75c9-354b-88a9-5ee29ed5bdff",
                    "sense_definition": "To reproach oneself for making a mistake or missing an opportunity.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He is still <w>kicking</w> himself for not investing three years ago.",
                            "target_lang_translations": {
                                "ru": "Он до сих пор <w>корит</w> себя за то, что не инвестировал три года назад.",
                                "zh": "他还在为三年前没投资而<w>自责</w>。"
                            }
                        },
                        {
                            "text": "You will <w>kick</w> yourself later if you miss this chance.",
