                                        "sense_id": "11682045-f9b1-3e6c-befb-310c67716bb1",
                                        "entry_id": "5abf1a6e-d3cd-33f7-9e08-7de622dda2a6",
                                        "glosses": [
                                            "so etwas; etwas Ähnliches; etwas, das (mit dem eben Besprochenen) vergleichbar ist"
                                        ],
