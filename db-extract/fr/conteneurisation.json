                                        "entry_id": "ee458f52-06b3-3e34-9ee8-e66d40fa7c71",
                                        "glosses": [
                                            "The process of containerizing; the use of containers in shipping and transport, especially shipping containers."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "465517eb-f3f4-4305-9ac6-152574ffcbff",
                                                "sense_id": "f2d10a10-97cd-3fab-a29d-5b2f79027f5f",
                                                "text": "Again, because containerisation had yet to arrive, we loaded and unloaded the lot by hand."
                                            }
                                        ]
                                    },
                                    {
