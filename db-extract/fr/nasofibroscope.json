                        "sense_id": "d19ea9a1-ce4e-3543-a7f0-89a1f119be42",
                        "entry_id": "c38f57d4-5a8e-3843-b1dc-1e1caa66ee00",
                        "glosses": [
                            "Appareil utilisé pour l’exploration visuelle de la muqueuse de l’ensemble des fosses nasales et du pharynx."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2dd0634f-6bb5-491b-92df-56a58de72cf7",
                                "sense_id": "d19ea9a1-ce4e-3543-a7f0-89a1f119be42",
                                "text": "Le nasofibroscope est connecté à une minicaméra qui permet l’enregistrement vidéo de l’examen. Il sera introduit dans une narine du locuteur, sur une longueur plus ou moins grande selon l’organe à examiner."
                            },
                            {
                                "example_id": "f0bc9b35-da4a-4e2f-b148-82eb2da356cf",
                                "sense_id": "d19ea9a1-ce4e-3543-a7f0-89a1f119be42",
                                "text": "Le nasofibroscope, de par sa présence, peut déclencher des éternuements et un écoulement clair du nez disparaissant après l’examen."
                            }
                        ]
                    }
                ],
