                {
                    "sense_id": "52229b92-0cd4-3865-a75b-46dd78539239",
                    "sense_definition": "het vallen van neerslag in de vorm van sneeuwvlokken uit de lucht",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "weersomstandigheden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kijk naar buiten, het begint eindelijk te <w>sneeuwen</w> in de stad.",
                            "target_lang_translations": {
                                "en": "Look outside, it is finally starting <w>to snow</w> in the city.",
                                "ru": "Посмотри на улицу, в городе наконец-то начинает <w>идти снег</w>."
                            }
                        },
                        {
                            "text": "Het gaat hard <w>sneeuwen</w> vanavond, dus we moeten voorzichtig rijden op de weg.",
                            "target_lang_translations": {
                                "en": "It is going <w>to snow</w> hard tonight, so we must drive carefully on the road.",
                                "ru": "Сегодня вечером будет <w>сильный снегопад</w>, поэтому нам нужно ехать осторожно."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gaat hard sneeuwen",
                        "begint te sneeuwen"
                    ],
                    "target_lang_definitions": {
                        "en": "the falling of precipitation in the form of snowflakes from the sky",
                        "ru": "выпадение осадков в виде снежинок из облаков"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to snow",
                                "target_lang_sense_clarification": "weather condition"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "идти",
                                "target_lang_sense_clarification": "о снеге"
                            },
                            {
                                "target_lang_word": "снежить",
                                "target_lang_sense_clarification": "безлично, о погоде"
                            }
                        ]
                    }
                }
            ]
        },
