                    {
                        "sense_id": "a49ee547-50a1-3635-8637-a4cbe78800cb",
                        "entry_id": "c16be458-a6fa-38b9-8be3-b4cbb78d5f29",
                        "glosses": [
                            "Forme particulière d’intoxication alimentaire par les chairs de poissons contaminés par la ciguatoxine produite par la microalgue benthique Gambierdiscus toxicus, présente dans les récifs coralliens et dispersée dans la chaîne alimentaire lors de la destruction de ceux-ci."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a011b32b-2aec-4776-b29a-d448d81191f4",
                                "sense_id": "a49ee547-50a1-3635-8637-a4cbe78800cb",
                                "text": "Au-delà des aspects strictement cliniques, la ciguatéra a des retentissements économiques et nutritionnels considérables dans de nombreux archipels."
                            }
                        ]
                    },
                    {
                        "sense_id": "5abb2205-73dc-3556-9f90-1b4fbd7fe967",
                        "entry_id": "c16be458-a6fa-38b9-8be3-b4cbb78d5f29",
                        "glosses": [
                            "ciguatoxine."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "69436f68-d750-4993-adce-80841f2f68c9",
                                "sense_id": "5abb2205-73dc-3556-9f90-1b4fbd7fe967",
                                "text": "La ciguatéra est une toxine extrêmement dangereuse pour l’homme dont la présence dans la chair du requin bouledogue est à l’origine de l’interdiction de sa commercialisation."
                            }
                        ]
                    }
