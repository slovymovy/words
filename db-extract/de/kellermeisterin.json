                "senses": [
                    {
                        "sense_id": "79f2b36e-c451-30a6-a3a8-2b67cb11f89a",
                        "entry_id": "aee2a2fe-de7b-3d54-90ab-55efc785d215",
                        "glosses": [
                            "Fachfrau, die für den Weinkeller und die sachgemäße Behandlung der Weine zuständig ist"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "14b3eb21-1835-460d-8831-17dd5aa229db",
                                "sense_id": "79f2b36e-c451-30a6-a3a8-2b67cb11f89a",
                                "text": "„Die Kellermeisterin war eine vornehme Dame aus thüringischem Adel, die erst ins Stift eingetreten war, nachdem ihr Sohn erwachsen und ihr Gemahl gestorben war.“"
                            },
                            {
                                "example_id": "45e3c7fb-7748-45da-9869-a7dd8855ae58",
                                "sense_id": "79f2b36e-c451-30a6-a3a8-2b67cb11f89a",
                                "text": "„Dann wurde sie Kellermeisterin im Staatlichen Hofkeller Würzburg – bis sie sich entschied, ein komplett neues Weingut zu bauen.“"
                            },
                            {
                                "example_id": "831d8fbb-3af2-48d9-a3e0-1830b2940c20",
                                "sense_id": "79f2b36e-c451-30a6-a3a8-2b67cb11f89a",
                                "text": "„Sie wurde erst Krankenwärterin, dann Kellermeisterin, hierauf Schaffnerin, Novizenmeisterin und endlich Vicarin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a0bd8a68-9038-4377-841c-ebf4585aec75",
                        "source_entry_id": "aee2a2fe-de7b-3d54-90ab-55efc785d215",
                        "source_sense_id": "79f2b36e-c451-30a6-a3a8-2b67cb11f89a",
                        "source_sense_description": "Beruf: Fachfrau, die für den Weinkeller und die sachgemäße Behandlung der Weine zuständig ist",
                        "target_lang_word": "caviste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "caviste",
