                                            {
                                                "example_id": "1f398bde-fd79-476f-b501-35a8761ccff7",
                                                "sense_id": "982586dc-c394-3d10-a3ff-9dee630c9223",
                                                "text": "The gas line in each apartment should have a ball valve for emergency shutoffs."
