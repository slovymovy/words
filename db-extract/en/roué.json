                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roué",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f29cb852-ec96-35cc-9454-db9bf6ef8cab",
                                        "entry_id": "138eea52-cb40-3bcc-92a9-42c6f5839087",
                                        "glosses": [
                                            "ausschweifender, wüster Mann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bce99ed-b570-411d-8945-15b807ff163a",
                                                "sense_id": "f29cb852-ec96-35cc-9454-db9bf6ef8cab",
                                                "text": "„Dafür zwirbelte er seinen Schnurrbart, als er sie im Halbdunkel der schwachbeleuchteten Treppe herunterkommen sah, richtete sich auf und warf ihr den Blick eines altmodischen Roués zu.“"
                                            },
                                            {
                                                "example_id": "a07c102d-b7ae-49a3-b82a-fcb2f3482883",
                                                "sense_id": "f29cb852-ec96-35cc-9454-db9bf6ef8cab",
                                                "text": "„Die Durchschnittslebemänner sind immer Dandys, sei es im bestickten Rock des Hofmanns, sei es in der Soutane des Abbé; die stärkeren und kälteren Begabungen entwickeln sich zum Roué großen Stils, der an Menschenverachtung und Grausamkeit der Auffassung nicht mehr übertroffen werden kann.“"
                                            },
                                            {
                                                "example_id": "1f140e9a-0450-4d32-9dc1-daf210b1a9fa",
                                                "sense_id": "f29cb852-ec96-35cc-9454-db9bf6ef8cab",
                                                "text": "„Nicht nur der glühend werbende Marquis liegt ihr in den Ohren, sondern auch der frivole Abbé, der alte Sünder und eloquente Roué.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d8435d8-503d-357e-b8e8-aec2344bbcd0",
                                        "entry_id": "138eea52-cb40-3bcc-92a9-42c6f5839087",
                                        "glosses": [
                                            "hinterhältiger Mann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
