                                        "glosses": [
                                            "Action de dormir, sommeil."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7cc48ed6-fd0c-4608-b99e-ec00e47a3388",
                                                "sense_id": "6f87ac4e-a879-397f-a178-7226723e6821",
                                                "text": "La modernité est pleine de ces héros de l’extinction et de la dormition qui déploient une exorbitante force d’inertie, érigent léthargie et paresse en valeurs absolues."
                                            },
                                            {
                                                "example_id": "0aa02daf-1c4d-4dd6-b260-52085d5cb7ae",
                                                "sense_id": "6f87ac4e-a879-397f-a178-7226723e6821",
                                                "text": "C’est l’heure de dormition !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf37902b-37a5-3703-848d-018b6f3955c4",
                                        "entry_id": "c92cbdf1-af0c-3619-8c7c-8a4bb62d7be1",
                                        "glosses": [
                                            "(Normalement avec une majuscule initiale) Nom donné à la mort de la Vierge, cette mort étant considérée comme un court sommeil, puisque suivie de l’assomption."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "808caf28-498d-3181-8446-215f7dd885c5",
                                        "entry_id": "c92cbdf1-af0c-3619-8c7c-8a4bb62d7be1",
                                        "glosses": [
                                            "Endormissement."
