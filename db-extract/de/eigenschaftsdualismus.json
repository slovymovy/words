                            "accusative",
                            "plural"
                        ],
                        "form": "die Eigenschaftsdualismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "98ff6ce3-66ca-31cd-8b3f-01134120ce25",
                        "entry_id": "6665cd34-d329-3aab-b573-7974a609b5be",
                        "glosses": [
                            "die auf Aristoteles zurückgehende Ansicht, dass sich mentale Phänomene wie das Denken, das Sich-Erinnern oder das Schmerz-Empfinden nicht auf die physischen Eigenschaften von Lebewesen zurückführen lassen, obwohl das Seelisch-Mentale nicht als eigenständige Substanz angenommen wird"
                        ],
                        "tags": [
                            "Philosophie des Geistes"
                        ],
                        "examples": [
                            {
                                "example_id": "25b04aaf-ec08-427f-9935-8ff7a95c1e06",
                                "sense_id": "98ff6ce3-66ca-31cd-8b3f-01134120ce25",
                                "text": "Aristoteles ist in der Philosophie ein Vertreter des Substanzmonismus gepaart mit einem Eigenschaftsdualismus."
                            },
                            {
                                "example_id": "963d941c-17d5-4e85-be9b-9ac0ff0673a4",
                                "sense_id": "98ff6ce3-66ca-31cd-8b3f-01134120ce25",
                                "text": "„Die These des Substanzdualismus hatte […] historisch eine wesentlich größere Bedeutung als die des Eigenschaftsdualismus […] In der gegenwärtigen Philosophie wird das Problem des Eigenschaftsdualismus mindestens ebenso ernsthaft diskutiert.“"
                            },
                            {
                                "example_id": "eb70ba34-17c8-4f74-bf13-7fca4e4f1e8d",
                                "sense_id": "98ff6ce3-66ca-31cd-8b3f-01134120ce25",
                                "text": "„Der Eigenschaftsdualismus ist ein interaktionistischer Ansatz, weil er davon ausgeht, dass das Physische das Mentale beeinflusst und dass das Mentale das Physische beeinflussen kann; […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
