                "senses": [
                    {
                        "sense_id": "18d04571-f8b1-37c4-9c3c-a15ed54c1013",
                        "entry_id": "ed28e319-7124-396b-9299-bf925784b95f",
                        "glosses": [
                            "Familienname, der dem Träger wegen seiner Herkunft zugeteilt wurde. Vor allem in den mittelalterlichen Städten breitete sich diese Form der Namensgebung aus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5ae27c1-0306-41bb-bde3-f63017890bb9",
                                "sense_id": "18d04571-f8b1-37c4-9c3c-a15ed54c1013",
                                "text": "„Herkunftsnamen geben an, aus welchem Ort die Person oder die Familie ursprünglich stammt oder wo sie längere Zeit gewohnt hatte.“"
                            },
                            {
                                "example_id": "16fed665-0117-4a93-946a-1f55f348c00c",
                                "sense_id": "18d04571-f8b1-37c4-9c3c-a15ed54c1013",
                                "text": "„Aus den Herkunftsnamen lassen sich Ein- und Auszugsgebiete mittelalterlicher Orte rekonstruieren.“"
                            },
                            {
                                "example_id": "ec08e882-d575-4c22-8f25-3cd0a8f453e5",
                                "sense_id": "18d04571-f8b1-37c4-9c3c-a15ed54c1013",
                                "text": "„Im Süden und Westen Deutschlands bevorzugt man bei Herkunftsnamen Bildungen auf -er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
