{
    "word_family": [
        "wpadać",
        "wpadka",
        "padać"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b87360e7-0405-35c8-b8eb-4da57ec316c4",
                    "sense_definition": "złożyć komuś krótką wizytę, zazwyczaj bez wcześniejszej zapowiedzi",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "wizyta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jeśli będziesz miał wolną chwilę po południu, <w>wpadnij</w> do nas na kawę.",
                            "target_lang_translations": {
                                "en": "If you have a free moment this afternoon, <w>drop by</w> for coffee."
                            }
                        },
                        {
                            "text": "Moja siostra niespodziewanie <w>wpadła</w> na chwilę, żeby pożyczyć ode mnie klucze do garażu.",
                            "target_lang_translations": {
                                "en": "My sister unexpectedly <w>popped in</w> for a moment to borrow the garage keys from me."
                            }
                        }
                    ],
                    "synonyms": [
                        "odwiedzić"
                    ],
                    "common_phrases": [
                        "wpaść na kawę",
                        "wpaść na chwilę",
                        "wpaść w odwiedziny"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "potoczne określenie krótkich odwiedzin"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "to pay someone a short, usually unannounced visit"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "drop by",
                                "target_lang_sense_clarification": "informal, casual visit"
                            },
                            {
                                "target_lang_word": "stop by",
                                "target_lang_sense_clarification": "brief visit"
                            },
                            {
                                "target_lang_word": "pop in",
                                "target_lang_sense_clarification": "quick, informal visit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "848681ac-e37e-3848-9c65-beb1e0e90313",
                    "sense_definition": "przypadkowo znaleźć się wewnątrz czegoś, spadając, lub znaleźć się w trudnym stanie emocjonalnym czy życiowym",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fizyczne_i_stany",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Podczas spaceru po ciemnym lesie niespodziewanie <w>wpadł</w> do głębokiego dołu.",
                            "target_lang_translations": {
                                "en": "While walking through the dark forest, he unexpectedly <w>fell</w> into a deep pit."
                            }
                        },
                        {
                            "text": "Kiedy szef odrzucił jego projekt, od razu <w>wpadł</w> w złość i trzasnął drzwiami.",
                            "target_lang_translations": {
                                "en": "When the boss rejected his project, he immediately <w>flew into</w> a rage and slammed the door."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wpaść do dołu",
                        "wpaść w panikę",
                        "wpaść w złość",
                        "wpaść w kłopoty"
                    ],
                    "target_lang_definitions": {
                        "en": "to accidentally fall into something, or enter a difficult emotional state or troublesome situation"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fall into",
                                "target_lang_sense_clarification": "physical drop into an opening or entering a state"
                            },
                            {
                                "target_lang_word": "get into",
                                "target_lang_sense_clarification": "enter trouble or difficulties"
                            },
                            {
                                "target_lang_word": "fly into",
                                "target_lang_sense_clarification": "enter a sudden intense emotional state, like rage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "803df7c8-8f9b-334d-9064-b1c9b5ac8b5d",
                    "sense_definition": "nagle wymyślić coś lub powziąć jakąś myśl bądź pomysł",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mysl",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nasz zespół długo szukał rozwiązania, aż wreszcie ktoś <w>wpadł</w> na genialny pomysł.",
                            "target_lang_translations": {
                                "en": "Our team spent a long time looking for a solution until finally someone <w>came up with</w> a brilliant idea."
                            }
                        },
                        {
                            "text": "Nagle <w>wpadłem</w> na pewien trop, który może pomóc rozwiązać tę zagadkę.",
                            "target_lang_translations": {
                                "en": "Suddenly, I <w>hit upon</w> a clue that might help solve this mystery."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wpaść na pomysł",
                        "wpaść na trop"
                    ],
                    "target_lang_definitions": {
                        "en": "to suddenly come up with or conceive an idea, thought, or clue"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "come up with",
                                "target_lang_sense_clarification": "an idea, solution, or plan"
                            },
                            {
                                "target_lang_word": "hit upon",
                                "target_lang_sense_clarification": "an idea or clue"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6249f65f-ca93-3970-90f8-53850e7eff59",
                    "sense_definition": "spotkać kogoś nieoczekiwanie lub przypadkowo na kogoś natrafić",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spotkanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wczoraj w centrum handlowym przypadkowo <w>wpadłem</w> na dawnego kolegę ze szkoły.",
                            "target_lang_translations": {
                                "en": "Yesterday at the shopping mall, I accidentally <w>bumped into</w> an old school friend."
                            }
                        },
                        {
                            "text": "Gdy wracała do domu, niespodziewanie <w>wpadła</w> na swojego sąsiada przed klatką schodową.",
                            "target_lang_translations": {
                                "en": "As she was returning home, she unexpectedly <w>ran into</w> her neighbor in front of the building entrance."
                            }
                        }
                    ],
                    "synonyms": [
                        "natknąć się",
                        "spotkać"
                    ],
                    "common_phrases": [
                        "wpaść na kogoś"
                    ],
                    "target_lang_definitions": {
                        "en": "to meet someone unexpectedly or run into someone by chance"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bump into",
                                "target_lang_sense_clarification": "meet by accident"
                            },
                            {
                                "target_lang_word": "run into",
                                "target_lang_sense_clarification": "meet unexpectedly"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a914c6d6-e7f0-3eb4-ba92-b7656c9eda10",
                    "sense_definition": "dokonana forma czasownika <w>wpadać</w>, oznaczająca wejście lub wbiegnięcie gdzieś gwałtownie i z dużą prędkością",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ruch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Spóźniony student szybko <w>wpadł</w> do sali wykładowej i zajął pierwsze wolne miejsce.",
                            "target_lang_translations": {
                                "en": "The late student quickly <w>rushed into</w> the lecture hall and took the first available seat."
                            }
                        },
                        {
                            "text": "Gdy tylko usłyszeli alarm, natychmiast <w>wpadli</w> do budynku, aby pomóc mieszkańcom.",
                            "target_lang_translations": {
                                "en": "As soon as they heard the alarm, they immediately <w>burst into</w> the building to help the residents."
                            }
                        }
                    ],
                    "synonyms": [
                        "wtargnąć",
                        "wbiec"
                    ],
                    "common_phrases": [
                        "wpaść do pokoju"
                    ],
                    "target_lang_definitions": {
                        "en": "to rush, burst, or run into a place rapidly and forcefully"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "burst into",
                                "target_lang_sense_clarification": "enter quickly or forcefully"
                            },
                            {
                                "target_lang_word": "rush into",
                                "target_lang_sense_clarification": "hurry inside"
                            },
                            {
                                "target_lang_word": "dash into",
                                "target_lang_sense_clarification": "run inside swiftly"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}