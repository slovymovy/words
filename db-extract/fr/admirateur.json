                    {
                        "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                        "entry_id": "15369a17-9d45-3f59-b36f-7882acc9d1fd",
                        "glosses": [
                            "Celui qui admire, ou qui a coutume d’admirer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2cf3a2fe-6038-4bba-adee-fe28aadc1456",
                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                "text": "Il est de vos admirateurs."
                            },
                            {
                                "example_id": "9fae16ea-df9b-4fdf-89e6-4c621244148e",
                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                "text": "C’est un admirateur de l’antiquité."
                            },
                            {
                                "example_id": "28bcd234-1c4c-406f-9ced-096e95168061",
                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                "text": "C’est un admirateur convaincu."
                            },
                            {
                                "example_id": "bab9f117-5332-453a-ade6-bd962d22049e",
                                "sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                                "text": "La liberté de ton que prenait l'auteur irrita plus d'un admirateur du Roman de la rose."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "551b4970-47c1-4703-8727-bc935311f762",
                        "source_entry_id": "15369a17-9d45-3f59-b36f-7882acc9d1fd",
                        "source_sense_id": "69f82d54-71e2-3744-b34b-c2c17884723d",
                        "source_sense_description": "Celui qui admire, ou qui a coutume d’admirer",
                        "target_lang_word": "Bewunderer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewunderer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                        "entry_id": "62b6887b-68fc-35be-a632-665226ce22d3",
                                        "glosses": [
                                            "(männliche^☆) Person, die jemanden oder etwas sehr verehrt, wertschätzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644bdf00-ae30-4848-bf52-13eb8f7b31ab",
                                                "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                                "text": "„Kann das gut gehen? Zwei Maler als Paar? Oder funktionieren Künstlerehen nur, wenn einer die Muse oder der Bewunderer ist und der andere der Kreative?“"
                                            },
                                            {
                                                "example_id": "136741e7-31f3-4f1a-bfc5-335465977946",
                                                "sense_id": "2fd26e70-8ce1-3cdd-bfa9-29b5fad4880f",
                                                "text": "„Doch darin hatte er sich getäuscht, denn Hitler war ein Bewunderer der britischen Kolonialherrschaft und dachte gar nicht daran, den Indern zu helfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
