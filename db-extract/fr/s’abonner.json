                        "source_sense_id": "d6f789a6-d1ad-3dd7-b2df-e6a2f7d47698",
                        "target_lang_word": "bestellen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bestellen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ed24dc75-fd2f-3491-bf3d-66e94bf45205",
                                        "entry_id": "c1d7b4a4-951d-34e6-a814-d4901fab5783",
                                        "glosses": [
                                            "eine Ware oder Dienstleistung zur Lieferung in Auftrag geben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8cd3ea2-3970-484d-80ba-b1cbd4d1c503",
                                                "sense_id": "ed24dc75-fd2f-3491-bf3d-66e94bf45205",
                                                "text": "Ich habe mir eben eine Pizza bestellt."
                                            },
                                            {
                                                "example_id": "b3bf08b5-a53b-47b8-89cc-c770cad096a7",
                                                "sense_id": "ed24dc75-fd2f-3491-bf3d-66e94bf45205",
                                                "text": "Ich habe beim Italiener für heute Abend einen Tisch bestellt."
                                            },
                                            {
                                                "example_id": "d0d286db-1fb4-4c9e-97e1-d6ddca2997cb",
                                                "sense_id": "ed24dc75-fd2f-3491-bf3d-66e94bf45205",
                                                "text": "Könnten Sie mir bitte ein Taxi bestellen?"
                                            },
                                            {
                                                "example_id": "b6390601-2575-4829-9a84-16192672ede1",
                                                "sense_id": "ed24dc75-fd2f-3491-bf3d-66e94bf45205",
                                                "text": "„Lucy nahm eines der aquamarinblauen Telefone und bestellte Kaffee und etwas zu essen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c26ee257-15d2-37b0-9ef3-379ed8294b24",
                                        "entry_id": "c1d7b4a4-951d-34e6-a814-d4901fab5783",
                                        "glosses": [
                                            "eine Nachricht ausrichten, überbringen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1541fa6-91ac-4c78-9118-6941e059bb5e",
                                                "sense_id": "c26ee257-15d2-37b0-9ef3-379ed8294b24",
                                                "text": "Kannst du ihm einen schönen Gruß bestellen?"
                                            },
                                            {
                                                "example_id": "4c11373d-20e8-41fa-989c-569c6af760a2",
                                                "sense_id": "c26ee257-15d2-37b0-9ef3-379ed8294b24",
                                                "text": "Bestell ihr, sie kann mich mal!"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d9d602cb-15ce-3faf-bcb4-d3afb3469353",
                                        "entry_id": "c1d7b4a4-951d-34e6-a814-d4901fab5783",
                                        "glosses": [
                                            "den Boden bearbeiten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcbe7178-5242-4935-9845-6329dfb9dd3a",
                                                "sense_id": "d9d602cb-15ce-3faf-bcb4-d3afb3469353",
                                                "text": "Im Frühjahr werden die Äcker bestellt."
                                            },
                                            {
                                                "example_id": "57c1caaf-f148-48cf-b5da-c5714dfa8f55",
                                                "sense_id": "d9d602cb-15ce-3faf-bcb4-d3afb3469353",
                                                "text": "Die UN warnen vor einer Hungersnot im Bürgerkriegsland Südsudan. Mehr als eine Million Menschen sind auf der Flucht und konnten ihre Felder nicht bestellen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "2780c5e3-5440-3a2b-9f8f-713b5cd72efc",
                                        "entry_id": "c1d7b4a4-951d-34e6-a814-d4901fab5783",
                                        "glosses": [
                                            "jemandem ein Amt (einen Dienstposten) übertragen"
                                        ],
                                        "tags": [
                                            "jemanden bestellen zu"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a34c5677-9735-4c9d-a98c-edd2621dda6e",
                                                "sense_id": "2780c5e3-5440-3a2b-9f8f-713b5cd72efc",
                                                "text": "„Der Abgeordnete Noonan wurde, 18 Monate nach seinem Einzug ins Parlament, zum Justizminister bestellt, anschließend führte er kurz das Wirtschaftsministerium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
