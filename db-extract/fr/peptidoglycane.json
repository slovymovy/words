                ],
                "senses": [
                    {
                        "sense_id": "0922a1c5-325b-3c10-826f-8bdef29d92fa",
                        "entry_id": "4f6f9323-3818-34bc-97c8-782f32c849fb",
                        "glosses": [
                            "Polymère de la paroi des bactéries, constitué de longues chaînes de dérivés glucidiques reliées par des unités tétrapeptidiques"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0de6020-b7d8-49fc-99b1-4c4fcb71f7e3",
                                "sense_id": "0922a1c5-325b-3c10-826f-8bdef29d92fa",
                                "text": "Or ce qui permet à la très grande majorité des antibiotiques d'empêcher le développement de la bactérie, et finalement de la tuer est le blocage de la synthèse du peptidoglycane."
                            },
                            {
                                "example_id": "6d5b8897-39ad-466b-b83c-434f9f056d8c",
                                "sense_id": "0922a1c5-325b-3c10-826f-8bdef29d92fa",
                                "text": "Ce sont des chercheurs de l'Institut de biologie structurale (CEA/CNRS/Université Joseph-Fourier) ,.. qui ont, pour la première fois, décrit avec précision les mécanismes de synthèse d'une paroi bactérienne. Ils ont ainsi mis en évidence les interactions existant entre le peptidoglycane et une « enzyme tricoteuse » qui attache entre eux les différents fils de peptidoglycane pour en faire un réseau rigide."
                            }
                        ]
                    }
                ],
