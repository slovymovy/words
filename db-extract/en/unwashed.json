                                        "examples": [
                                            {
                                                "example_id": "978cc6e1-7424-4860-b9fa-4289960a40cc",
                                                "sense_id": "92627f97-2b73-3a20-80f6-12fb872dd586",
                                                "text": "De inspectie concludeert dat „onvoldoende zorg en ondersteuning” is geboden. Signalen van verwaarlozing – ongewassen kinderen, stinkende kleren, een vies huis – kwamen vanuit school, huisarts, politie en het ziekenhuis."
                                            },
                                            {
                                                "example_id": "a9630365-f960-4102-8fe1-0456a7c581ed",
                                                "sense_id": "92627f97-2b73-3a20-80f6-12fb872dd586",
                                                "text": "Ik werd brak wakker in een zure lucht van zweetvoeten, ongewassen kleren en halflege pizzadozen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "36de6cd3-4b3e-4306-a411-5db3029663ed",
                        "source_entry_id": "53736a93-5cf7-3476-b382-229e42c72f5a",
