                ],
                "senses": [
                    {
                        "sense_id": "b7ce5a5b-060c-3379-b243-e665e2dd62c8",
                        "entry_id": "00c9e07b-3692-3e95-a404-e25b4f495e11",
                        "glosses": [
                            "Faire un petit bruit de craquement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfc7d08d-5ff2-4d46-a7f0-0837d513136d",
                                "sense_id": "b7ce5a5b-060c-3379-b243-e665e2dd62c8",
                                "text": "Et du coup ça vous les bronze à travers les mailles et les dore en surface, pour craquotter sous la dent et n’y coller point."
                            },
                            {
                                "example_id": "d42802a8-7605-4876-af3c-1b80eaee4aec",
                                "sense_id": "b7ce5a5b-060c-3379-b243-e665e2dd62c8",
                                "text": "Tu sauras que ton lapin est content quand tu l’entendras \"craquotter\" des dents quand tu le caresses."
                            },
                            {
                                "example_id": "54a6572d-ce77-4932-833d-8ff13e69b8d7",
                                "sense_id": "b7ce5a5b-060c-3379-b243-e665e2dd62c8",
                                "text": "Mais j'ai jamais vue un rat craquotter lorsqu'il est en mouvement."
                            },
                            {
                                "example_id": "fedc6a0a-8cb2-44d4-a356-ed5bb2179540",
                                "sense_id": "b7ce5a5b-060c-3379-b243-e665e2dd62c8",
                                "text": "Les néologismes utilisés sont d’ailleurs plus « cramiotés » que prononcés, comme autant d’onomatopées : « il cragouille », « elle croustille » tous les jours, « il farfotte » le matin, « il carcaviole » la nuit, « elle commence à rampionner », il « craquotte au point de remettre » (sic)."
                            }
                        ]
                    }
                ],
