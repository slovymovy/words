                    {
                        "sense_id": "fc11c0ba-18be-3e64-bc97-3ca0a4da6acc",
                        "entry_id": "ee646a73-4cf1-30f3-85f5-41fbd8468ac6",
                        "glosses": [
                            "specjalista w dziedzinie numizmatyki, naukowy badacz historycznych monet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0c857fe-f46b-4b86-9089-8896dbd7f7dd",
                                "sense_id": "fc11c0ba-18be-3e64-bc97-3ca0a4da6acc",
                                "text": "Katalog monet rzymskiej prowincji w Hiszpanii opracował numizmatyk z uniwersytetu w Saragossie we współpracy z muzealnikami z Barcelony."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "1bcbdc8c-6b54-3928-8c72-b1d02087a835",
                        "entry_id": "ee646a73-4cf1-30f3-85f5-41fbd8468ac6",
                        "glosses": [
                            "zbieracz numizmatów"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ce0a4e-9e1f-4688-8633-64b048a19b46",
                                "sense_id": "1bcbdc8c-6b54-3928-8c72-b1d02087a835",
                                "text": "Wymieniłem się monetami z tym starszym numizmatykiem z Katowic."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be5cb03c-87b4-46c0-bfb7-39aa505fa5af",
                        "source_entry_id": "ee646a73-4cf1-30f3-85f5-41fbd8468ac6",
