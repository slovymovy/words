                                "target_word": "mutable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9ac4a40-3bdf-361c-981e-d79ac4b594d5",
                                        "entry_id": "3c5e3a06-8eb0-3d9d-9906-f0275f006d33",
                                        "glosses": [
                                            "Something mutable; a variable or value that can change."
                                        ],
