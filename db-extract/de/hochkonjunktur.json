                "senses": [
                    {
                        "sense_id": "8cf8befd-6878-364f-8ad7-0004a53eaf96",
                        "entry_id": "1404e02d-958a-3a4f-9f60-087dcc590acb",
                        "glosses": [
                            "economic boom"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": [
                            {
                                "example_id": "47745c88-1e8a-4124-8141-a379c2f9d856",
                                "sense_id": "8cf8befd-6878-364f-8ad7-0004a53eaf96",
                                "text": "Hochkonjunktur haben",
                                "translation": "to be on the rise",
                                "english": "to be on the rise"
                            },
                            {
                                "example_id": "cbb7b352-3eab-49f0-af74-dcadc6105d7c",
                                "sense_id": "8cf8befd-6878-364f-8ad7-0004a53eaf96",
                                "text": "Die Retrodiskussion unterschlägt auch den enormen Einfallsreichtum und die Entwicklungen in der Reisebranche. […] Dass Abhängen und Feiern im Freien neue Hochkonjunktur hat, auch weil es spontane Begegnung verspricht."
                            },
                            {
                                "example_id": "f1f61f44-3f8a-40df-ac65-840b8b87120c",
                                "sense_id": "8cf8befd-6878-364f-8ad7-0004a53eaf96",
                                "text": "Was für die Pro­du­zen­t*in­nen Hochkonjunktur bedeutet, verwandelt sich allerdings für die Port­al­be­trei­be­r*in­nen immer mehr zu einer Bedrohung. Denn noch kein Player kann sich durch sein Portfolio refinanzieren."
                            }
                        ]
                    }
                ],
