                                ]
                            },
                            {
                                "target_word": "retire",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2e42e7f-14e4-361f-8113-6a03213017af",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To stop working on a permanent basis, usually because of old age or illness."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6040549-b58d-404c-96d0-0c708f9fe481",
                                                "sense_id": "c2e42e7f-14e4-361f-8113-6a03213017af",
                                                "text": "Having made a large fortune, he retired."
                                            },
                                            {
                                                "example_id": "14920a26-3142-49a7-a352-bfae363bebff",
                                                "sense_id": "c2e42e7f-14e4-361f-8113-6a03213017af",
                                                "text": "He wants to retire at 55."
                                            },
                                            {
                                                "example_id": "ad5af738-3db6-43bc-a14f-ffe8e84b8f17",
                                                "sense_id": "c2e42e7f-14e4-361f-8113-6a03213017af",
                                                "text": "She decided to retire from her banking job due to stress."
                                            },
                                            {
                                                "example_id": "2f2f1e59-a52b-47fe-b657-73a91525b02f",
                                                "sense_id": "c2e42e7f-14e4-361f-8113-6a03213017af",
                                                "text": "Green will never forget \"that was the day I retired - the absolute crowning event of my life and I was very proud of that."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d404b91-dd4c-3f32-b29b-be0e58a3bde6",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To stop playing their sport and in competitions a sports player."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "097ec77b-3911-42fe-a7b8-e011ab69ee0c",
                                                "sense_id": "3d404b91-dd4c-3f32-b29b-be0e58a3bde6",
                                                "text": "I have decided to retire from test cricket at 45."
                                            },
                                            {
                                                "example_id": "7dad5cc4-5edf-4021-ac24-eab78e26333d",
                                                "sense_id": "3d404b91-dd4c-3f32-b29b-be0e58a3bde6",
                                                "text": "I have decided to retire from football at the end of the season after the World Cup."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7a62ed3-6d25-3156-82e4-2087e40fb6e6",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To withdraw; to take away."
                                        ],
                                        "tags": [
                                            "reflexive",
                                            "sometimes",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "736e8aa8-21f4-4db4-af2b-24e0aa09d454",
                                                "sense_id": "a7a62ed3-6d25-3156-82e4-2087e40fb6e6",
                                                "text": "He […] retired himself, his wife, and children into a forest.",
                                                "translation": "The New Arcadia",
                                                "english": "The New Arcadia"
                                            },
                                            {
                                                "example_id": "3c9f4468-4206-4f99-b587-ee46e2697058",
                                                "sense_id": "a7a62ed3-6d25-3156-82e4-2087e40fb6e6",
                                                "text": "As when the sun is present all the year, / And never doth retire his golden ray."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc507994-b330-384a-aef1-11e8ff9703b7",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To cease use or production of something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c6b9146-9178-4d40-809a-91c36e93fc15",
                                                "sense_id": "cc507994-b330-384a-aef1-11e8ff9703b7",
                                                "text": "The steamship made thousands of trips over several decades before it was retired by the shipping company."
                                            },
                                            {
                                                "example_id": "0531ede7-dc62-4da0-a3f2-2ad289a8e451",
                                                "sense_id": "cc507994-b330-384a-aef1-11e8ff9703b7",
                                                "text": "When a hurricane becomes so deadly or destructive that future use would be insensitive, officials may retire the name of the hurricane."
                                            },
                                            {
                                                "example_id": "d04a9cac-e20d-4b08-92ec-2678ae39a3da",
                                                "sense_id": "cc507994-b330-384a-aef1-11e8ff9703b7",
                                                "text": "Only now, due to the COVID-19-associated drop in traffic, are they being retired with 12 of the 30 trains moved to Landore (Swansea) for warm storage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cab9146-e733-3017-92ae-f7a60a1966d8",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To withdraw from circulation, or from the market; to take up and pay."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24a2a67d-17af-410f-b326-9afde8c28681",
                                                "sense_id": "9cab9146-e733-3017-92ae-f7a60a1966d8",
                                                "text": "The central bank retired those notes five years ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "523296e1-80e1-330b-affc-7685162da05f",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To cause to retire; specifically, to designate as no longer qualified for active service; to place on the retired list."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3fec9127-d8a0-4b58-bfec-ba72ba3155cd",
                                                "sense_id": "523296e1-80e1-330b-affc-7685162da05f",
                                                "text": "The board retired the old major."
                                            },
                                            {
                                                "example_id": "10d977a6-86a2-41b1-b835-4f479e125bf5",
                                                "sense_id": "523296e1-80e1-330b-affc-7685162da05f",
                                                "text": "How had it felt, at 28, to be the hottest young actor in town? He [Richard Gere] grinned. “It was great having the attention,” he said. “I thought: ‘This is it! I’ve done it! I’m going to retire my father. I’m putting money away for college for my sisters,’ the whole thing. It’s incredibly euphorious. All of a sudden the rehearsal period of your life is over, and your future has arrived. It’s liberating.”"
                                            },
                                            {
                                                "example_id": "33699eaa-5d1e-44a2-81e8-5f7534431d58",
                                                "sense_id": "523296e1-80e1-330b-affc-7685162da05f",
                                                "text": "By the time I first spoke to Magana in late 2022, 25/7 Media’s success had given him some measure of financial security. “The truth is that I just retired my parents,” he told me two days after Christmas."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c53c00f7-8234-381c-b232-d5b8cf347359",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To voluntarily stop batting before being dismissed so that the next batsman can bat."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a38d4d-5c90-4c17-ac48-31af04932e91",
                                                "sense_id": "c53c00f7-8234-381c-b232-d5b8cf347359",
                                                "text": "Jones retired in favour of Smith."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1caf2236-8350-3a01-a1c3-18e254ce8e86",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To make a play which results in a runner or the batter being out, either by means of a put out, fly out or strikeout. Also, when such an event ends a team's turn at bat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e311240-68c2-4b5a-853a-3a81a4778652",
                                                "sense_id": "1caf2236-8350-3a01-a1c3-18e254ce8e86",
                                                "text": "Jones retired Smith 6-3."
                                            },
                                            {
                                                "example_id": "1cb39747-804b-4004-8c72-f80079ab75ec",
                                                "sense_id": "1caf2236-8350-3a01-a1c3-18e254ce8e86",
                                                "text": "Jones makes the catch for the third out, and that retires the side."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "beddc570-00bc-35ad-9921-8157f9a691bb",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To go back or return; to withdraw or retreat, especially from public view; to go into privacy."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18f2340f-ff2e-44d2-8b8f-8e5db05d241c",
                                                "sense_id": "beddc570-00bc-35ad-9921-8157f9a691bb",
                                                "text": "I will retire to the study."
                                            },
                                            {
                                                "example_id": "712f88bb-9971-4704-b511-2dd6da5b91a3",
                                                "sense_id": "beddc570-00bc-35ad-9921-8157f9a691bb",
                                                "text": "to retire from the world"
                                            },
                                            {
                                                "example_id": "9b48f232-3b9b-456a-a27d-efa4dbfc7576",
                                                "sense_id": "beddc570-00bc-35ad-9921-8157f9a691bb",
                                                "text": "to retire from the public eye"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17116e2c-d2d7-3bca-95c0-008ad3c35bdc",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To retreat from action or danger; to withdraw for safety or pleasure."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "408cd7ac-9103-4d63-95c6-b078ebc3030a",
                                                "sense_id": "17116e2c-d2d7-3bca-95c0-008ad3c35bdc",
                                                "text": "to retire from battle"
                                            },
                                            {
                                                "example_id": "b22de257-6f66-440f-9832-ab05c16de61e",
                                                "sense_id": "17116e2c-d2d7-3bca-95c0-008ad3c35bdc",
                                                "text": "The regiment retired from the fray after the Major was killed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c6d16981-4156-3559-aee5-45d5c729beac",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To recede; to fall or bend back."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3c9f116-07e4-4d6b-b15a-334f03703962",
                                                "sense_id": "c6d16981-4156-3559-aee5-45d5c729beac",
                                                "text": "Past the point, the shore retires into a sequence of coves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7600321c-10ac-3442-9f44-5fd133b60dee",
                                        "entry_id": "dea12abc-bd71-302c-afb9-58a35b8052ee",
                                        "glosses": [
                                            "To go to bed."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5f655f2-ed78-4d28-b1b6-ac3138eebdd2",
                                                "sense_id": "7600321c-10ac-3442-9f44-5fd133b60dee",
                                                "text": "I will retire for the night."
                                            },
                                            {
                                                "example_id": "f9ac9ad1-f6a7-4851-bfb3-aa66c4175938",
                                                "sense_id": "7600321c-10ac-3442-9f44-5fd133b60dee",
                                                "text": "In the daytime the beds are made up but completely out of sight, giving the passenger a comfortable little private room; as the time for retiring comes, after preparing for rest in the same spacious conditions, he is able, practically at a touch, to pull the bed into position ready for use."
                                            }
                                        ]
                                    }
                                ]
                            },
