                "senses": [
                    {
                        "sense_id": "c40a69fc-d564-3598-81b8-123d39b27fdc",
                        "entry_id": "39a14a00-a056-33b7-a146-9eefd48bc236",
                        "glosses": [
                            "устар. либо поэт. колыхать что-либо, производить зыбь на чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "842eb237-c24a-4be2-9d94-c78a4dd0e75a",
                                "sense_id": "c40a69fc-d564-3598-81b8-123d39b27fdc",
                                "text": "Всё утром дышит; ветерок // Играет в Тереке на волнах, // Вздымает зыблемый песок."
                            },
                            {
                                "example_id": "175f8074-8b13-41a4-a6fb-b747e825a51a",
                                "sense_id": "c40a69fc-d564-3598-81b8-123d39b27fdc",
                                "text": "Лавров стройных колыханье зыблет воздух голубой —…"
                            },
                            {
                                "example_id": "86aa73c9-2452-40b1-9309-b5cdaecc6415",
                                "sense_id": "c40a69fc-d564-3598-81b8-123d39b27fdc",
                                "text": "Море, в сладком усыпленьи, // Звучно зыблет лоно вод, // И в туманном отдаленьи // Смутно Капри предстаёт;"
                            }
                        ]
                    },
                    {
                        "sense_id": "909fae2a-4e4b-3a1c-93d0-6515b4be4701",
                        "entry_id": "39a14a00-a056-33b7-a146-9eefd48bc236",
                        "glosses": [
                            "устар. либо поэт. колебать, качать что-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8459ade2-1511-4b55-a603-ba1c424d1067",
                                "sense_id": "909fae2a-4e4b-3a1c-93d0-6515b4be4701",
                                "text": "Злодействы землю потрясают, // Неправда зыблет небеса."
                            },
                            {
                                "example_id": "20fd15a8-8265-41d1-9d01-f0dfc95cad8e",
                                "sense_id": "909fae2a-4e4b-3a1c-93d0-6515b4be4701",
                                "text": "Покрыты слёгшими травами, // Не зыблют колоса поля, // И, пресыщенная дождями, // Не верит солнышку земля."
                            }
                        ]
                    },
                    {
                        "sense_id": "594a9bfa-3899-3537-bd26-8d4e78d1bba3",
                        "entry_id": "39a14a00-a056-33b7-a146-9eefd48bc236",
                        "glosses": [
                            "устар. перен. колебать, внушать кому-нибудь колебания, сомнения"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06c1c7c2-6fe5-48a4-8a32-2b806710da05",
                                "sense_id": "594a9bfa-3899-3537-bd26-8d4e78d1bba3",
                                "text": "И зритель ― зыблемый сомненьем // Меж истиной и заблужденьем ―…"
                            }
                        ]
                    }
                ],
