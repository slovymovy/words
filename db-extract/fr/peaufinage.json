                        ],
                        "examples": [
                            {
                                "example_id": "2f5a8f7f-279b-46a8-8075-f623661c1319",
                                "sense_id": "316ff055-52a3-3672-ab2f-7d057faecdb2",
                                "text": "Un dernier travail de peaufinage consistera à enlever les mots qui ne servent à rien, les adverbes qui alourdissent et vous êtes prêt(e) pour la dernière étape : lisez-le à voix haute, en veillant à garder une tonalité neutre."
                            },
                            {
                                "example_id": "799a8fcb-b53b-4a9d-8b47-25084707d17d",
                                "sense_id": "316ff055-52a3-3672-ab2f-7d057faecdb2",
                                "text": "Le développement d'une stratégie gagnante prend dans la plupart des cas des années, avec des faux départs, des petites découvertes et du peaufinage."
                            }
                        ]
                    }
