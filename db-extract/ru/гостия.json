                "senses": [
                    {
                        "sense_id": "59a1bc35-f455-392f-9a8b-893ba689be8e",
                        "entry_id": "40ad5ade-a7a9-3d8e-9bd7-0a1a944fc146",
                        "glosses": [
                            "религ. у католиков и лютеран — лепёшка (облатка) из пресного пшеничного теста, обычно с изображением Агнца и креста, употребляемая при причастии"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9c6630db-d18e-4a00-b270-d2aca1cd208f",
                                "sense_id": "59a1bc35-f455-392f-9a8b-893ba689be8e",
                                "text": "И возносимая им гостия, как мы видим вот на этой фреске, находящейся практически на том месте, где хранится реликвия, в соборе в Орвието, окрашивается кровью, и корпорал, алтарный покров, оказывается этой кровью запятнан."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e975972c-09ae-4e0e-b395-9f76e8ad29d3",
                        "source_entry_id": "40ad5ade-a7a9-3d8e-9bd7-0a1a944fc146",
                        "source_sense_id": "59a1bc35-f455-392f-9a8b-893ba689be8e",
                        "target_lang_word": "Eucharistic wafer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "3b28db7a-a5ee-488d-a678-027b5ea5fdd4",
                        "source_entry_id": "40ad5ade-a7a9-3d8e-9bd7-0a1a944fc146",
                        "source_sense_id": "59a1bc35-f455-392f-9a8b-893ba689be8e",
                        "target_lang_word": "obley",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obley",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d9eff84-b9a4-380e-a61d-0175556f3984",
                                        "entry_id": "cb3a0b5d-41b0-3897-9931-58df35db36d1",
                                        "glosses": [
                                            "A communion wafer."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bae73c93-7fcc-49ff-85e5-638d43fc7649",
                                                "sense_id": "8d9eff84-b9a4-380e-a61d-0175556f3984",
                                                "text": "And than the bysshop made sembelaunte as thoughe he wolde have gone to the sakeryng of a Masse, and than he toke an obley which was made in lyknesse of brede [...]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18387251-bc6e-4146-83b2-ffac1daa6d9a",
                        "source_entry_id": "40ad5ade-a7a9-3d8e-9bd7-0a1a944fc146",
                        "source_sense_id": "59a1bc35-f455-392f-9a8b-893ba689be8e",
                        "target_lang_word": "Hostie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hostie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                        "entry_id": "9239ac87-748a-35f7-ae0c-db4911e08e88",
                                        "glosses": [
                                            "das zur Eucharistie beziehungsweise zum Abendmahl verwendete Brot (meist als Oblaten; je nach Tradition unterschiedliche Vorstellungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "640f4d17-2162-4dc0-8eb9-7b84a1fa4cf1",
                                                "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                                "text": "„Gemäß der römisch-katholischen Lehre von der Transsubstantiation („Wesensverwandlung“) ist Jesus Christus als Gott und Mensch in jeder Partikel der Hostie wirklich, wahrhaft und wesentlich gegenwärtig, solange diese Partikel ihrer Gestalt nach existiert.“"
                                            },
                                            {
                                                "example_id": "8866fe9a-532a-471d-a796-7ebb13fd0c6d",
                                                "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                                "text": "In der katholischen Kirche werden konsekrierte Hostien streng von unkonsekrierten unterschieden und im Tabernakel aufbewahrt, vor allem für die Kommunion der Kranken und der Sterbenden, aber auch zur stillen Anbetung der Gläubigen."
                                            },
                                            {
                                                "example_id": "a83c15e5-c326-4388-85d1-38cfaa2d5164",
                                                "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                                "text": "„Man weiß bereits, daß an diesem Umzug des höchsten Wesens, das man mit Körper und Seele in der vom Bischof getragenen Hostie darbietet, alle religiösen und weltlichen Verbände teilnehmen.“"
                                            },
                                            {
                                                "example_id": "151e82e0-a17e-430c-8501-c33b9e944e72",
                                                "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                                "text": "„Während der Kommunion sollte es nicht nur die Hostie, sondern auch Wein geben.“"
                                            },
                                            {
                                                "example_id": "c8f04eae-6e7e-4b21-ab32-a4843755ffe8",
                                                "sense_id": "b7cac379-3b6e-37bf-9f49-77704d84d7ac",
                                                "text": "„Zu Lebzeiten Luthers wurden die geweihten Hostien auch in evangelischen Kirchen weiterhin in Tabernakeln aufbewahrt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
