                        ],
                        "form": "die Cembalos"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                        "entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                        "glosses": [
                            "Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "1747224b-1603-461a-b886-b8523e194c95",
                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                "text": "„Ohne es zu merken, war ich aufgestanden und lauschte den glasfeinen Tönen und perlenden Glissandi eines Cembalos oder Spinetts, die wie ein kühler, belebender Lufthauch durch das stickige Treppenhaus des Wehrturms strichen.“"
                            },
                            {
                                "example_id": "7858d390-c157-4a4f-a417-b9760526fb98",
                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                "text": "„Er entdeckte auf dem Cembalo zehn oder zwölf Datteln und aß sie auf.“"
                            },
                            {
                                "example_id": "5ea580cd-9a13-4301-90c2-1519df963d9e",
                                "sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                                "text": "„Der dünne Silberklang des Cembalos zitterte manchmal ein wenig wie das Werk einer Spieldose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31bd57ff-f0ff-44dd-8434-fa204acc6715",
                        "source_entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                        "source_sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                        "source_sense_description": "Musik: Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)",
                        "target_lang_word": "harpsichord",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "harpsichord",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d5f03f8a-544c-3c25-85dc-3d8bf9029e56",
                                        "entry_id": "a3272bae-f119-35c5-9374-846f9bbd7135",
                                        "glosses": [
                                            "A musical instrument with a keyboard that produces sound through a mechanical process. When the performer presses a key, a corresponding plectrum plucks a tuned string. The harpsichord originated in late medieval Europe and is one of the most important instruments used to perform Baroque music."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6b93072c-32df-4c74-b94d-904359219753",
                        "source_entry_id": "9e75ee6e-a456-3546-844b-fbd9578c1423",
                        "source_sense_id": "16e58b37-e9ec-3f6e-8733-172f5d848985",
                        "source_sense_description": "Musik: Tasteninstrument in Form eines Flügels mit Zupfmechanik (Kurzform für Clavicembalo)",
                        "target_lang_word": "clavecin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clavecin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                        "entry_id": "4b2db162-c654-30e8-8edc-66f3518d2ab6",
                                        "glosses": [
                                            "Instrument de musique, longue épinette à un ou plusieurs claviers dont les cordes sont de métal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b5a3f04-91df-4bfb-b1c6-f493bff2e877",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Il entendit Herman jouer sa Coquette, pièce de clavecin qui faisait fureur dans les salons."
                                            },
                                            {
                                                "example_id": "4c7ba97a-9263-4008-82c1-2eaa70f4ce2c",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Tenant dans ses bras Marie, âgée de trois ans, il la présentait avec orgueil aux ambassadeurs étrangers et voulait qu'elle jouât du clavecin en leur présence. C’était merveille de voir courir de si faibles doigts sur les touches avec précision et rapidité."
                                            },
                                            {
                                                "example_id": "5c32dc9e-3b29-4ae9-946a-1aececfeb3f0",
                                                "sense_id": "4f7492ff-33c8-383a-ad42-9a2f0594b1ca",
                                                "text": "Un instant après on entendit Andrée attaquer vigoureusement les touches de son clavecin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
