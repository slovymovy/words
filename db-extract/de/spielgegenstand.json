                "senses": [
                    {
                        "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                        "entry_id": "dd675b7b-97e0-351a-9506-8f643f7eaf95",
                        "glosses": [
                            "etwas (Gerät, Material), mit dem man spielen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e43678e-ae25-44f2-b03b-e8c4feb924a7",
                                "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                                "text": "„Gemüthsverderbniss ist stets damit verbunden, sobald das sich selbst überlassene Kind, welches das Thier nur als einen Spielgegenstand betrachtet, allerhand Quälereien an demselben verschuldet.“"
                            },
                            {
                                "example_id": "f30dc58f-f6e6-43b2-a82b-896bf093fd43",
                                "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                                "text": "„Im Umgang mit Spielgegenständen und Spielmaterial erweitert und differenziert sich das Beobachtungs-, Wahrnehmungs- und Reaktionsvermögen.“"
                            },
                            {
                                "example_id": "ab27c503-18d5-4527-8e35-0a793af746b3",
                                "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                                "text": "„Brock Pierce kümmert sich in Hongkong wenig um Empfindlichkeiten und versucht stattdessen, eine Art virtuelle Supermarktkette für Spielgegenstände aufzubauen.“"
                            },
                            {
                                "example_id": "372abad6-b3e4-4848-a6e1-1ca2e2500d04",
                                "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                                "text": "„Atlantis, das war ein Stück, weil es gar kein Stück sein wollte, nur ein Spielgegenstand.“"
                            },
                            {
                                "example_id": "443d6d6b-66a3-4f0a-a40a-c48c31ec1aae",
                                "sense_id": "be2f3a41-28d4-3aed-842e-370eb19868fb",
                                "text": "„SaBuF wird von einer beliebigen Anzahl von Teilnehmern gespielt, die mit dem Spielgegenstand – hier einfach das Opfer genannt – zumindest flüchtig bekannt sein sollten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
