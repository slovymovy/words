                                        "sense_id": "e73d8cf6-a015-37e3-9cd2-06fac7b59dbc",
                                        "entry_id": "49341bb7-d593-31b7-a603-deebf5d69c61",
                                        "glosses": [
                                            "The state of being three; independence of three things; things divided into three."
                                        ],
