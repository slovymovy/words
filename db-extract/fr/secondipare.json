                                            {
                                                "example_id": "1141f8fb-b756-49ff-a289-52b7f7eb089c",
                                                "sense_id": "38427b62-0e55-383c-9391-6df64b2874b8",
                                                "text": "Fyzioterapie jako prevence bolestivého porodu a protrahované rekonvalescence u druhorodiček"
                                            },
                                            {
                                                "example_id": "2826e038-5d39-4254-a3e0-427ac9c865ec",
                                                "sense_id": "38427b62-0e55-383c-9391-6df64b2874b8",
                                                "text": "Komu je kurz určen. Kurz je určen druhorodičkám a vícerodičkám."
                                            },
                                            {
                                                "example_id": "0ee59c21-b7e1-4318-948f-d6ec7a00bd7d",
                                                "sense_id": "38427b62-0e55-383c-9391-6df64b2874b8",
                                                "text": "Klesalo procento druhorodiček a rodiček s umělým ukončením těhotenství v anamnéze."
                                            },
                                            {
                                                "example_id": "cef49786-a178-4135-83b9-09af4f386d28",
                                                "sense_id": "38427b62-0e55-383c-9391-6df64b2874b8",
                                                "text": "Přesně tak, druhorodičkám, pokud to není nezbytně nutné, se hráz většinou nestříhá."
                                            }
                                        ]
                                    }
