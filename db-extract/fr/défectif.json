                    },
                    {
                        "form_id": "601c6115-d830-405b-9954-e3c66241437f",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "tags": [
                            "singular",
                            "feminine"
                        ],
                        "form": "défective"
                    },
                    {
                        "form_id": "562fff09-c88a-4cde-ab97-7e29a6a2fd56",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "tags": [
                            "plural",
                            "feminine"
                        ],
                        "form": "défectives"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "bb09974a-ed15-39d8-899e-1f7976c48e08",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "glosses": [
                            "Se dit d’un bactériophage ou d’un virus qui, par suite d’une ou plusieurs mutations, est incapable d’accomplir seul son cycle infectieux, il n'a pas la capacité d'effectuer la synthèse des constituants nécessaire à sa réplication."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e933e573-197b-433a-a9aa-a96fc5cbc827",
                                "sense_id": "bb09974a-ed15-39d8-899e-1f7976c48e08",
                                "text": "Parmi ceux-ci, le risque de production de virus réplicatifs virulents, par recombinaison in vivo du vecteur défectif avec un rétrovirus latent ou cryptique, reste un problème majeur."
                            }
                        ]
                    },
                    {
                        "sense_id": "811ec01d-60ea-3c37-aba8-b504f31af9f0",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "glosses": [
                            "Se dit d’un verbe qui ne se conjugue pas du tout, ne se conjugue plus, ou qui ne se conjugue qu’à certaines personnes ou qu’à certains temps."
                        ],
                        "tags": [],
                        "note": "La conjugaison peut être impossible comme falloir ou inusitée comme gésir ou encore chaloir connu aujourd’hui pour l’expression « peu m’en chaut »",
                        "examples": [
                            {
                                "example_id": "157e77a3-425e-416c-88b7-51b09f19532e",
                                "sense_id": "811ec01d-60ea-3c37-aba8-b504f31af9f0",
                                "text": "Le verbe falloir est défectif."
                            },
                            {
                                "example_id": "10da54c2-31af-4666-9948-3f66b325ed44",
                                "sense_id": "811ec01d-60ea-3c37-aba8-b504f31af9f0",
                                "text": "Le verbe issir est défectif."
                            }
                        ]
                    },
                    {
                        "sense_id": "735ebc19-81fb-3ece-838c-0a0c9fd57953",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "glosses": [
                            "Qui n’a qu’une asymptote."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae711c4f-81e4-4e14-b341-6e2a36bf2459",
                                "sense_id": "735ebc19-81fb-3ece-838c-0a0c9fd57953",
                                "text": "Courbe défective."
                            }
                        ]
                    },
                    {
                        "sense_id": "06176133-b407-3934-b85a-5cc3f834aec4",
                        "entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "glosses": [
                            "Déficient."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c0e51296-35ed-47b8-b3a6-b3f35fede9f1",
                        "source_entry_id": "5c497953-c69a-3443-904a-58043fe60b38",
                        "target_lang_word": "defective",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "defective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3412d3b-615c-377f-a672-0455edfa449b",
                                        "entry_id": "623068e0-4c2b-3c06-8b9c-1794044bae45",
                                        "glosses": [
                                            "Having one or more defects."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a45e4e91-b995-4ce1-8c5a-bc46d86c9f30",
                                                "sense_id": "e3412d3b-615c-377f-a672-0455edfa449b",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8376968-2a3c-301f-8077-ccfb6c4dc509",
                                        "entry_id": "623068e0-4c2b-3c06-8b9c-1794044bae45",
                                        "glosses": [
                                            "Lacking some forms; e.g., having only one tense or being usable only in the third person."
                                        ],
                                        "tags": [
                                            "of a lexeme"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ac308469-ea2e-3f92-9f50-a9966ce2b7e4",
                                        "entry_id": "623068e0-4c2b-3c06-8b9c-1794044bae45",
                                        "glosses": [
                                            "Having a root whose final consonant is weak (ي, و, or ء)."
                                        ],
                                        "tags": [
                                            "Arabic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "05d5de75-5f24-39d1-8532-81ebb21586ea",
                                        "entry_id": "623068e0-4c2b-3c06-8b9c-1794044bae45",
                                        "glosses": [
                                            "Not capable of representing all the phonemic distinctions of a language it is used to write."
                                        ],
                                        "tags": [
                                            "of a script"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71a24b6b-1f18-3e6d-9724-970a5b9a96ae",
                                        "entry_id": "623068e0-4c2b-3c06-8b9c-1794044bae45",
                                        "glosses": [
                                            "Spelled without matres lectionis, for example אמץ (ómets, “courage”) as opposed to the plene spelling אומץ where the letter vav ⟨ו⟩ indicates the vowel o."
                                        ],
                                        "tags": [
                                            "of abjad script"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "defective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a4d11bd-0135-3329-af52-7d6e3a29b914",
                                        "entry_id": "270ae1a7-12ba-3cd8-84eb-be6491a43963",
                                        "glosses": [
                                            "Without matres lectionis (letters indicating vowels) written out."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "054e9705-a5ae-4cf5-95a8-70adc5f3b160",
                                                "sense_id": "6a4d11bd-0135-3329-af52-7d6e3a29b914",
                                                "text": "For the sake of comparison, note the distribution of these spellings in some other Hebrew sources: in the MT the vowel o after the first consonant of the root is written defective in approximately 3,600 cases as against 850 cases of plene spelling."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "defective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                        "entry_id": "28f1570a-4335-31bb-947b-291d13d7edf4",
                                        "glosses": [
                                            "A person or thing considered to be defective."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "79e97b57-ddca-4fef-988f-b7cda430e48f",
                                                "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                                "text": "It is an offence, subject to the exception mentioned in this section, for a person to procure a woman who is a defective to have unlawful sexual intercourse in any part of the world."
                                            },
                                            {
                                                "example_id": "c2ebd329-82ec-4693-8831-924882a1d937",
                                                "sense_id": "6929b40d-9dcc-31a2-9fd7-56d5c8b662df",
                                                "text": "There were many more kinds of mental institutions at mid-century, ones for \"mental defectives and epileptics\" and the mentally retarded, psychiatric wards in veterans hospitals, as well as \"psychopathic\" and private mental hospitals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "de8d79c8-8a40-326f-b5e0-f796c12798fe",
                                        "entry_id": "28f1570a-4335-31bb-947b-291d13d7edf4",
                                        "glosses": [
                                            "A word written without matres lectionis (letters indicating vowels)."
                                        ],
                                        "tags": [
                                            "of abjad script"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e839428-61f6-411f-a6bb-382d41e5e014",
                                                "sense_id": "de8d79c8-8a40-326f-b5e0-f796c12798fe",
                                                "text": "Thus, in the Pentateuch and in the earlier prophets the plenes are counted, whilst in the later prophets the defectives are enumerated."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
