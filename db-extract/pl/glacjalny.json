                "translations": [
                    {
                        "translation_id": "a6ad41dc-5812-4ccd-ba83-dcdbb97e3631",
                        "source_entry_id": "45fd47c0-925f-3096-903d-f89134d07975",
                        "source_sense_id": "c93258f6-6c1e-335e-ae4b-e6463d4860ac",
                        "target_lang_word": "glacial",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "glacial",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ee33db4a-60f3-31cd-9908-7adc222740f4",
                                        "entry_id": "64ae29e9-e4ce-3643-8629-ed1691bb1b6f",
                                        "glosses": [
                                            "Of, or relating to glaciers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06108171-4114-4bca-a2a3-f0c5a4f7ddc7",
                                                "sense_id": "ee33db4a-60f3-31cd-9908-7adc222740f4",
                                                "text": "We examined the glacial deposits."
                                            },
                                            {
                                                "example_id": "9d0c1475-e065-4489-8871-5619bc32e609",
                                                "sense_id": "ee33db4a-60f3-31cd-9908-7adc222740f4",
                                                "text": "Wang Shijin is a glacier expert and director of the Yulong Snow Mountain Glacial and Environmental Observation Research Station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                        "entry_id": "64ae29e9-e4ce-3643-8629-ed1691bb1b6f",
                                        "glosses": [
                                            "Very slow."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0525dd6-6f4c-4dd3-92c9-137fa3f70e62",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "He could remember a day that he had spent the whole of (he couldn't have been more than ten) running one of the great, creaking freight elevators at a glacial speed, answering the calls of the bell—one ring, five rings, three rings—with an almost unbearable sense of responsibility."
                                            },
                                            {
                                                "example_id": "5c1b244f-7b48-49d3-b31e-295c5a8ff45c",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "I understand that you commented that the Japanese are moving at glacial speed. This is not the only area where they are moving at glacial speed. They are moving at glacial speed in terms of trade barriers, and it is one thing that the American people recognize."
                                            },
                                            {
                                                "example_id": "f7329396-5352-4a99-8784-64872502aad5",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "Paradoxically, then, the electronic speed offered by computer-based decision-making is often overwhelmed by the glacial speed of data reformatting and checking."
                                            },
                                            {
                                                "example_id": "a2d8c90f-2654-404a-a48f-35ba5a3731ac",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "By all means move at a glacial pace. You know how that thrills me."
                                            },
                                            {
                                                "example_id": "068a930e-5ed7-4918-896e-6c1b4539414f",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "Progress on judicial reform has been glacial, meeting enormous resistance."
                                            },
                                            {
                                                "example_id": "98a80499-137d-4c8c-bab1-a7c45c284ba9",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "Lower-level people added front-line information that ordinarily wouldn't have made it up the hierarchy to the executive committee (or would have made it at glacial speed)."
                                            },
                                            {
                                                "example_id": "4cda353a-e254-4447-8c91-e15349cfcf59",
                                                "sense_id": "d069f337-07a7-3554-8018-c6409fc27925",
                                                "text": "The Gulf States and Saudi Arabia are modernizing but at a glacial speed in a world moving at digital speed."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce1347d7-2e3d-3afe-94eb-088fb91c3943",
                                        "entry_id": "64ae29e9-e4ce-3643-8629-ed1691bb1b6f",
                                        "glosses": [
                                            "Cold and icy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3985669d-bbd5-41de-82ab-007113c52304",
                                                "sense_id": "ce1347d7-2e3d-3afe-94eb-088fb91c3943",
                                                "text": "After the rain and frost, the pavements were glacial."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64d7c16f-875f-3dd5-b559-4cc0fa1dc353",
                                        "entry_id": "64ae29e9-e4ce-3643-8629-ed1691bb1b6f",
                                        "glosses": [
                                            "Having the appearance of ice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db1cfd53-fd3f-465d-8abf-1579184b3dbd",
                                                "sense_id": "64d7c16f-875f-3dd5-b559-4cc0fa1dc353",
                                                "text": "On cold days, glacial acetic acid will freeze in the bottle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1b3be838-3c9a-3f2f-8638-6d4da1de3a29",
                                        "entry_id": "64ae29e9-e4ce-3643-8629-ed1691bb1b6f",
                                        "glosses": [
                                            "Cool and unfriendly."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f29692e-b2d6-4cf7-a7d8-5c1308554f16",
                                                "sense_id": "1b3be838-3c9a-3f2f-8638-6d4da1de3a29",
                                                "text": "He gave me a glacial stare."
                                            }
                                        ]
                                    }
                                ]
                            },
