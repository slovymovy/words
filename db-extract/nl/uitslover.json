                        "entry_id": "7876ee0a-07b6-3a1d-94f0-769ea941c4a2",
                        "glosses": [
                            "iemand die zich op overdreven wijze inspant en dat ook duidelijk toont aan het boven hem gestelde gezag"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "05d8f38f-7a0a-4c6c-954d-3bf57b2460a0",
                                "sense_id": "4194430d-73f0-33f7-98d8-0c388304d8e9",
                                "text": "Die uitslover haalde allemaal negens en tienen terwijl een zesje toch ook voldoende is."
                            }
                        ]
                    }
                ],
                "translations": [
