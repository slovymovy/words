{
    "word_family": [
        "book",
        "mark",
        "marker",
        "marking"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4348c252-8811-395f-9aed-d84f3a1a5ef7",
                    "sense_definition": "A strip of material, such as paper or leather, used to mark a place in a book.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "reading_tools",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He placed a leather <w>bookmark</w> on page 234 to remember where he stopped reading.",
                            "target_lang_translations": {
                                "ru": "Он положил кожаную <w>закладку</w> на страницу 234, чтобы запомнить, где остановился."
                            }
                        },
                        {
                            "text": "I need a paper <w>bookmark</w> because I keep losing my place in this novel.",
                            "target_lang_translations": {
                                "ru": "Мне нужна бумажная <w>закладка</w>, потому что я постоянно теряю место, на котором читаю этот роман."
                            }
                        }
                    ],
                    "synonyms": [
                        "bookmarker"
                    ],
                    "common_phrases": [
                        "paper bookmark",
                        "leather bookmark",
                        "handmade bookmark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Полоска материала, например бумаги или кожи, используемая для отметки места в книге."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладка",
                                "target_lang_sense_clarification": "для бумажных книг"
                            },
                            {
                                "target_lang_word": "ляссе",
                                "target_lang_sense_clarification": "ленточка-закладка, прикрепленная к корешку"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1f61b80d-cd76-31d5-9cf8-c8b2f7f8a7a3",
                    "sense_definition": "A saved shortcut to a specific website or file in a web browser or computer system.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I added the news site to my browser <w>bookmark</w> list for quick access.",
                            "target_lang_translations": {
                                "ru": "Я добавил новостной сайт в список <w>закладок</w> браузера для быстрого доступа."
                            }
                        },
                        {
                            "text": "You can organize every <w>bookmark</w> into different folders to keep your links tidy.",
                            "target_lang_translations": {
                                "ru": "Вы можете распределить каждую <w>закладку</w> по разным папкам, чтобы ваши ссылки были в порядке."
                            }
                        }
                    ],
                    "synonyms": [
                        "favourites"
                    ],
                    "common_phrases": [
                        "browser bookmark",
                        "add a bookmark",
                        "bookmark folder"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохраненная ссылка на определенный веб-сайт или файл в браузере или компьютерной системе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладка",
                                "target_lang_sense_clarification": "в браузере"
                            },
                            {
                                "target_lang_word": "избранное",
                                "target_lang_sense_clarification": "раздел со ссылками"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99d0cec9-09c8-3634-8e9e-b0e3f6de32e3",
                    "sense_definition": "A pointer in a database index used to locate a specific row in a table.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system uses a <w>bookmark</w> to find the data row in the clustered index.",
                            "target_lang_translations": {
                                "ru": "Система использует <w>закладку</w>, чтобы найти строку данных в кластеризованном индексе."
                            }
                        },
                        {
                            "text": "A <w>bookmark</w> lookup can sometimes slow down complex database queries.",
                            "target_lang_translations": {
                                "ru": "Поиск по <w>закладке</w> иногда может замедлять сложные запросы к базе данных."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bookmark lookup"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Указатель в индексе базы данных, используемый для поиска конкретной строки в таблице."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "закладка",
                                "target_lang_sense_clarification": "технический указатель в БД"
                            },
                            {
                                "target_lang_word": "букмарк",
                                "target_lang_sense_clarification": "профессиональный сленг"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0121bd15-21f6-3075-9484-95ce1f8bd5dd",
                    "sense_definition": "To save the address of a website or a location in a document for future reference.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should <w>bookmark</w> this page so you can find the recipe later.",
                            "target_lang_translations": {
                                "ru": "Вам стоит <w>добавить</w> эту страницу <w>в закладки</w>, чтобы позже найти рецепт."
                            }
                        },
                        {
                            "text": "I always <w>bookmark</w> important articles while I am doing research online.",
                            "target_lang_translations": {
                                "ru": "Я всегда <w>добавляю в закладки</w> важные статьи, когда провожу исследование в интернете."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bookmark this page",
                        "bookmark a site"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сохранить адрес веб-сайта или место в документе для последующего обращения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "добавить в закладки",
                                "target_lang_sense_clarification": "сохранить ссылку"
                            },
                            {
                                "target_lang_word": "закласть",
                                "target_lang_sense_clarification": "отметить страницу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}