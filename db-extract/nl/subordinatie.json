                    {
                        "translation_id": "47633c1a-e777-4dd5-b199-8cc51b4c3d87",
                        "source_entry_id": "9c0b82a2-1f01-30d7-a79b-da9f43bdd9ec",
                        "target_lang_word": "Unterordnung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterordnung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce4d77f-4e35-3a0e-8208-a8f137be4ae5",
                                        "entry_id": "c4e42220-679f-3b2e-bdd1-3865c73e91bb",
                                        "glosses": [
                                            "Einnehmen eines niederen Ranges oder Stellung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4de82f2-7ac4-4c9c-a531-29b7ebb7d4ec",
                                                "sense_id": "6ce4d77f-4e35-3a0e-8208-a8f137be4ae5",
                                                "text": "„Autorität, Respekt, Unterordnung kann nur das Ergebnis von Erfahrungsvorsprung, Vorsprung an Sachwissen, an Lebensweisheit, allgemein als Vorsprung an Kompetenz sein.“"
                                            },
                                            {
                                                "example_id": "826f2d63-d13b-4a4b-93a6-d7304a674337",
                                                "sense_id": "6ce4d77f-4e35-3a0e-8208-a8f137be4ae5",
                                                "text": "„Und wer fast ein Jahrtausend lang keine sicheren Grenzen hat, macht eben nicht Freiheit, sondern Sicherheit und die bekannten preußischen Tugenden Gehorsam, Pflichtbewusstsein und Unterordnung zu seinen Leitprinzipien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3a0ef195-a529-3f66-9deb-e00a676a4f7a",
                                        "entry_id": "c4e42220-679f-3b2e-bdd1-3865c73e91bb",
                                        "glosses": [
                                            "Eingliederung, Einordnung eines Teiles in ein größeres System; Taxon zwischen Familie und Ordnung"
                                        ],
                                        "tags": [
                                            "general"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15df7c7-f49b-4e72-9d9e-158aa053adff",
                                                "sense_id": "3a0ef195-a529-3f66-9deb-e00a676a4f7a",
                                                "text": "„Wir beginnen mit den Hasenförmigen im weiteren Sinne, die den ganzen Inhalt der Unterordnung der Doppelzähner ausmachen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4c6a072d-11e0-3ec4-81e0-d8ba7b0794b9",
                                        "entry_id": "c4e42220-679f-3b2e-bdd1-3865c73e91bb",
                                        "glosses": [
                                            "Abhängigkeit eines Teilsatzes von einem höherrangigen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f2004c5-99c3-4a79-b9f2-343139c72ccb",
                                                "sense_id": "4c6a072d-11e0-3ec4-81e0-d8ba7b0794b9",
                                                "text": "„Der Nebensatz, welcher dem Hauptsatze unmittelbar untergeordnet ist, mithin ein Glied des Hauptsatzes umschreibt, steht im ersten Grade der Unterordnung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "dc7def8a-d18d-3720-b536-a77c6981d9f0",
                                        "entry_id": "c4e42220-679f-3b2e-bdd1-3865c73e91bb",
                                        "glosses": [
                                            "Subsumption eines sprachlichen Ausdrucks unter einen anderen"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
