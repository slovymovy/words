                    {
                        "sense_id": "69157832-b3a0-39da-955f-924c44ca5ae4",
                        "entry_id": "ef260225-1680-3e71-a372-d9ca69d51215",
                        "glosses": [
                            "dem jugendlichen Alter, der Unerfahrenheit geschuldete Unvernunft, Naivität"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "e436c253-4e72-47a6-bdbb-9946a98ee35a",
                                "sense_id": "69157832-b3a0-39da-955f-924c44ca5ae4",
                                "text": "„Einem Maler, der über Stümperei erhaben und über Jugendtorheit hinaus ist, genügt ein Modell für alle Gestalten, die er träumt und schafft […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "935d4ce6-2fbe-3246-8cd7-23a53845edc6",
                        "entry_id": "ef260225-1680-3e71-a372-d9ca69d51215",
                        "glosses": [
                            "etwas Törichtes, Unvernünftiges, das jemand in noch jugendlichem Alter (leichtsinnigerweise) getan hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7b59c2b-81c0-434e-af87-fd1945655c94",
                                "sense_id": "935d4ce6-2fbe-3246-8cd7-23a53845edc6",
                                "text": "„Er hatte nur ein halbes Jahr lang der NSDAP angehört, und er überzeugte die Kommission, daß es sich dabei um eine Jugendtorheit gehandelt habe.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
