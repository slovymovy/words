                ],
                "senses": [
                    {
                        "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                        "entry_id": "a96654dd-f4c2-32d8-bf47-9dda2e9dc73d",
                        "glosses": [
                            "Eigenschaft, mit sechs anderen Atomen eine chemische Bindung eingehen zu können"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "e69e3cdb-4890-465a-8d2b-3185e7400bb9",
                                "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                                "text": "„Die Verbindungen der drei Elemente ähneln denen des Chroms, doch dominiert bei ihnen die Sechswertigkeit, die niederen Wertigkeitsstufen sind von geringerer Bedeutung.“"
                            },
                            {
                                "example_id": "f1e9640d-93ae-4cdd-9c19-858071c44155",
                                "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                                "text": "„Die Sechswertigkeit des S in SO₃ besagt nach dieser Auffassung, daß beim Schwefel die 6 Elektronen mit der Hauptquantenzahl 3 sämtlich an der Bindung des Sauerstoffs beteiligt sind.“"
                            },
                            {
                                "example_id": "8dcda854-f48e-453b-b533-7ba8e816a600",
                                "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                                "text": "„Im ganzen zeigen diese Elemente ansteigende Wertigkeiten von der Dreiwertigkeit des Ac über die Vierwertigkeit des Th, Drei- und Fünfwertigkeit des Pa bis zur Vier- und Sechswertigkeit des Urans.“"
                            },
                            {
                                "example_id": "f5ac93e6-6272-4f2a-8dcc-9df6bc2be1f6",
                                "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                                "text": "„In der 8. Nebengruppe ist die maximale Wertigkeit beim Eisen die Sechswertigkeit, beim Kobalt und Nickel die Dreiwertigkeit, während die größte Beständigkeit die Verbindungen des dreiwertigen Eisens und des zweiwertigen Nickels haben.“"
                            },
                            {
                                "example_id": "060ad388-c9af-4ef9-bcc4-93a2fd7177ab",
                                "sense_id": "7430d3c2-f64b-372d-a99a-99c2db4b1c10",
                                "text": "„Durch die unlängst gelungene Darstellung eines Sechsfach-Fluorschwefels: SF₆ ist auch die Sechswertigkeit des Schwefels einwandfrei erwiesen werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
