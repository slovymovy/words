                        "glosses": [
                            "A small amount of liquid, especially alcoholic spirits."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "7f06dfdc-933c-4fc9-94c2-462b4426cd89",
                                "sense_id": "89a9c8bd-a3f5-3f0d-a13c-686ae4d909b0",
                                "text": "“Just the tiniest thimbleful for me,” Annie said, overplaying it, I thought, since she lived on vodka."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4e4e3736-69e0-4357-930b-24bc43996e65",
