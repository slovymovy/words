                "translations": [
                    {
                        "translation_id": "fb7b63cd-53bb-442f-a113-433c999f7ff3",
                        "source_entry_id": "7638fbc3-1e18-36f6-99fc-db3839a2e9cb",
                        "source_sense_id": "0f7e97f4-4cc4-356a-b281-0223c3d3dc47",
                        "source_sense_description": "moralische Verurteilung; Derbheit, Obszönität, Unzüchtigkeit, Unanständigkeit",
                        "target_lang_word": "Derbheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Derbheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b519655-7fb1-34e3-91e8-55598121fec5",
                                        "entry_id": "4e3128bb-c713-3622-a7c1-1b7a566dc08a",
                                        "glosses": [
                                            "Eigenschaft, im Hinblick auf etwas Bestimmtes derb zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df659c5f-e7e9-4983-95ea-151d273bcc80",
                                                "sense_id": "1b519655-7fb1-34e3-91e8-55598121fec5",
                                                "text": "„Hier muß man festhalten, daß O'Neill selbst den ungehobelsten seiner weiblichen Figuren niemals eine derartige Derbheit in den Mund gelegt hätte.“"
                                            },
                                            {
                                                "example_id": "938f9f50-0c39-42f0-909e-1f23878ee19f",
                                                "sense_id": "1b519655-7fb1-34e3-91e8-55598121fec5",
                                                "text": "„Das war das Stichwort für Sandys witzigen Marinekameraden Arnie Goldlieb, er den »wie hypnotisierten« Philip mit seinen fantasievollen Derbheiten begeisterte.“"
                                            },
                                            {
                                                "example_id": "c2777a6b-daec-4c60-88e7-2fd9c1893875",
                                                "sense_id": "1b519655-7fb1-34e3-91e8-55598121fec5",
                                                "text": "„Der Dunkelheit ihres Teints, der Schwärze ihres Scheitels und ihrer still und freundlich blickenden Augen nach hätte man sie für eine Welsche halten können, wenn nicht doch eine gewisse germanische Derbheit der Gesichtsbildung dem widersprochen hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5969e6a-5635-4aa2-95a0-7e6d3482c31c",
                        "source_entry_id": "7638fbc3-1e18-36f6-99fc-db3839a2e9cb",
                        "source_sense_id": "0f7e97f4-4cc4-356a-b281-0223c3d3dc47",
                        "source_sense_description": "moralische Verurteilung; Derbheit, Obszönität, Unzüchtigkeit, Unanständigkeit",
                        "target_lang_word": "Unzüchtigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "be863d76-ac6f-4bc2-a019-06a2b4e72bb3",
                        "source_entry_id": "7638fbc3-1e18-36f6-99fc-db3839a2e9cb",
                        "source_sense_id": "0f7e97f4-4cc4-356a-b281-0223c3d3dc47",
                        "source_sense_description": "moralische Verurteilung; Derbheit, Obszönität, Unzüchtigkeit, Unanständigkeit",
                        "target_lang_word": "Obszönität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Obszönität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0abd266-ff09-38c6-a413-1694a66a31b4",
                                        "entry_id": "cfecca08-f46a-36b9-8e07-0c5960da40c3",
                                        "glosses": [
                                            "obszönes Verhalten, das Schamgefühl verletzende Art, Beschaffenheit"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8eb282b0-2b2f-427a-8bfe-e68b268e4535",
                                                "sense_id": "b0abd266-ff09-38c6-a413-1694a66a31b4",
                                                "text": "Dass die »aggressive Entblößung der Brüste« schon immer eine weibliche und nicht selten wirkungsvolle Waffe gewesen ist, zeigt Hans Peter Duerr in seinem Buch über Obszönität und Gewalt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "000af450-b241-3cc2-863d-30c4e280c015",
                                        "entry_id": "cfecca08-f46a-36b9-8e07-0c5960da40c3",
                                        "glosses": [
                                            "obszöne, das Schamgefühl verletzende Äußerung, Handlung, Darstellung oder Ähnliches"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37a18bf6-b611-4569-b49d-c2b6b930d405",
                                                "sense_id": "000af450-b241-3cc2-863d-30c4e280c015",
                                                "text": "Polizisten riegeln das Schulgelände ab, Schüler brüllen Obszönitäten über den Zaun, Journalisten, aber auch rechtsradikale Provokateure drängen sich vor dem Tor, während sich im Schulgebäude Politprominenz die Klinke in die Hand gibt – die Rütli-Schule im Berliner Stadtteil Neukölln ist im Ausnahmezustand."
                                            },
                                            {
                                                "example_id": "72523d20-b9d4-43d4-9b38-d86a95bc5539",
                                                "sense_id": "000af450-b241-3cc2-863d-30c4e280c015",
                                                "text": "„Er bat sich die Gunst des letzten aus, was genehmigt wurde, und während er erst Margarete und dann Domenika beobachtete, wie sie auftraten und sich entkleideten, fiel ihm auf, daß es ihnen an Oszönität fehlte.“"
                                            },
                                            {
                                                "example_id": "560803cd-ac77-459d-8dee-8f83626281a9",
                                                "sense_id": "000af450-b241-3cc2-863d-30c4e280c015",
                                                "text": "„Murmele ein paar Obszönitäten.“"
                                            },
                                            {
                                                "example_id": "0d970bfe-94cc-4bdd-a59a-e0c1fb7051cb",
                                                "sense_id": "000af450-b241-3cc2-863d-30c4e280c015",
                                                "text": "„Ich selbst bin überaus empfindlich gegen Obszönität, besonders den Sexualwitz, wo er aus einem vitalen Mangel und Ersatzbedürfnis, aus Angeberei oder zerebraler Lüsternheit resultiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc2ca494-3f01-4bbc-bbaa-7e3f2a2213ce",
                        "source_entry_id": "7638fbc3-1e18-36f6-99fc-db3839a2e9cb",
                        "source_sense_id": "28d7948d-7dbb-38f7-9645-843582a1a510",
                        "source_sense_description": "speziell: Unzucht",
                        "target_lang_word": "Unzucht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unzucht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                                        "entry_id": "367c8bc1-c468-37bc-ad5b-feb6f7dd9e6d",
                                        "glosses": [
                                            "sexuelles Verhalten, das gegen das sittliche Empfinden einer Gesellschaft verstößt; illegitimer Geschlechtsverkehr"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df80b7dc-6c54-47f3-bb1d-c393b8694121",
                                                "sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                                                "text": "Weil sie so offen ihre Unzucht trieb und ihre Scham entblößte, wandte auch ich mich jäh von ihr ab, wie ich mich von ihrer Schwester abgewandt hatte."
                                            },
                                            {
                                                "example_id": "d71fe55a-bcc3-4cc5-a37d-dcfb0cc418b5",
                                                "sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                                                "text": "Im Jahre 1912 wurde der Maler Egon Schiele in Wien verhaftet. Man warf ihm vor, er treibe Unzucht mit Kindern und produziere Pornographie."
                                            },
                                            {
                                                "example_id": "c4e05ef2-1365-461e-abfb-dddd7e169651",
                                                "sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                                                "text": "„Die Unzucht zwischen den Bäumen war jedenfalls berüchtigt.“"
                                            },
                                            {
                                                "example_id": "48da4a60-8c09-4154-8bba-c3e054d7ac02",
                                                "sense_id": "99f85fdc-daca-36c1-bf96-2b53db476bb6",
                                                "text": "„Sie nahm also das Verzeichnis der Todsünden in ihre königlichen Hände, fand ihrer sieben und beschloß, daß sie sechs übersehen könne; die Unzucht aber erschien ihr unverzeihlich, und gegen diese wandte sich ihr Eifer und überschlug sich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
