                ],
                "senses": [
                    {
                        "sense_id": "b3ecbf43-9eb5-3fe8-b7fd-e5c52bd95d7d",
                        "entry_id": "a66c891d-1d13-3917-b300-d2c688dd6f48",
                        "glosses": [
                            "im rechten Winkel zum Strandverlauf in das Meer vorgebautes oder quer zum Ufer eines Flusses errichtetes wand- oder dammartiges Bauwerk"
                        ],
                        "tags": [
                            "North German"
                        ],
                        "examples": [
                            {
                                "example_id": "a0d62612-2975-4734-8792-49a9006cfc13",
                                "sense_id": "b3ecbf43-9eb5-3fe8-b7fd-e5c52bd95d7d",
                                "text": "„Was für ein Strohwisch dort, der auf der Spitze der Buhne mitten aus dem Wasser ragt? – deuten die Fremden … Und meinen den Weidenbusch drüben auf der Kribbe, in dem noch die Schlammnester der Überschwemmung kleben.“"
                            },
                            {
                                "example_id": "ae96b078-cca8-48ea-9e47-fc724baf2593",
                                "sense_id": "b3ecbf43-9eb5-3fe8-b7fd-e5c52bd95d7d",
                                "text": "„Wer hätte je einen Vers auf Porree-, Kohl- und Rübenfelder gemacht, Pappeln und Kopfweiden, Kribben, Kiesel, Schlick und Mulm gepriesen?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
