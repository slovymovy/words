                        "examples": [
                            {
                                "example_id": "5be5f3cd-5280-43a3-a293-6caf710bc715",
                                "sense_id": "ddc719c7-dc36-3862-b1bb-c8ef5cd52da8",
                                "text": "Он лежал и курил, и потихоньку сочинял, наслаждаясь утробным теплом постели, тишиной в квартире, ленивым течением времени: Марианна Николаевна ещё не скоро вернётся, а обед — не раньше четверти второго.",
                                "translation": "He lay and smoked, and gently composed, reveling in the womblike warmth of the bed, the quietness of the flat and the lazy passage of time: Marianna Nikolavna would not be returning for a while and dinner was not earlier than one fifteen.",
                                "english": "He lay and smoked, and gently composed, reveling in the womblike warmth of the bed, the quietness of the flat and the lazy passage of time: Marianna Nikolavna would not be returning for a while and dinner was not earlier than one fifteen."
                            }
                        ]
                    }
