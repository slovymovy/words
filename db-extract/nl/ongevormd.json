                        "entry_id": "87c7dd4b-8cbd-355d-b6e8-5605597ac072",
                        "glosses": [
                            "onervaren, onvolwassen, onvolgroeid"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "448c9031-8641-4f0a-8ec1-a9066dd69d65",
