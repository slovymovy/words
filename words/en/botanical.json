    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "0e05c954-0213-3a6a-aa56-a9e37dc41344",
                    "sense_definition": "Of or pertaining to plants or plant life.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The park is famous for its diverse <w>botanical</w> collection of rare flowers.",
                            "target_lang_translations": {
                                "ru": "Парк знаменит своей разнообразной <w>ботанической</w> коллекцией редких цветов."
                            }
                        },
                        {
                            "text": "We spent the afternoon walking through the beautiful <w>botanical</w> gardens.",
                            "target_lang_translations": {
                                "ru": "Мы провели вторую половину дня, гуляя по прекрасным <w>ботаническим</w> садам."
                            }
                        }
                    ],
                    "synonyms": [
                        "plant-based",
                        "plant",
                        "floral"
                    ],
                    "common_phrases": [
                        "botanical gardens",
                        "botanical species"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к растениям или растительной жизни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ботанический",
                                "target_lang_sense_clarification": "относящийся к растениям"
                            },
                            {
                                "target_lang_word": "растительный",
                                "target_lang_sense_clarification": "состоящий из растений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae2b75e7-0f39-3d08-ab88-066582aa3b1b",
                    "sense_definition": "Relating to the scientific study of plants, known as botany.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant-related",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university library has an extensive collection of <w>botanical</w> textbooks.",
                            "target_lang_translations": {
                                "ru": "В университетской библиотеке имеется обширная коллекция <w>ботанических</w> учебников."
                            }
                        },
                        {
                            "text": "She conducted a <w>botanical</w> study on the effects of climate change on local flora.",
                            "target_lang_translations": {
                                "ru": "Она провела <w>ботаническое</w> исследование влияния изменения климата на местную флору."
                            }
                        }
                    ],
                    "common_phrases": [
                        "botanical study",
                        "botanical research"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к научной дисциплине ботанике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ботанический",
                                "target_lang_sense_clarification": "связанный с наукой ботаникой"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c126a5d-d216-3adb-abb4-92dc81ea2324",
                    "sense_definition": "A substance or medicinal preparation derived from a plant source.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "plant-substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gin is flavored with various <w>botanicals</w> including juniper and coriander.",
                            "target_lang_translations": {
                                "ru": "Джин приправлен различными <w>растительными компонентами</w>, включая можжевельник и кориандр."
                            }
                        },
                        {
                            "text": "Many modern skincare products use natural <w>botanicals</w> to soothe the skin.",
                            "target_lang_translations": {
                                "ru": "Во многих современных средствах по уходу за кожей используются натуральные <w>растительные экстракты</w> для успокоения кожи."
                            }
                        }
                    ],
                    "synonyms": [
                        "herbal"
                    ],
                    "common_phrases": [
                        "infused with botanicals",
                        "natural botanicals"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или лекарственный препарат, полученный из растительного сырья."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "растительный компонент",
                                "target_lang_sense_clarification": "ингредиент растительного происхождения"
                            },
                            {
                                "target_lang_word": "растительная добавка",
                                "target_lang_sense_clarification": "в контексте косметики или напитков"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}