                ],
                "translations": [
                    {
                        "translation_id": "dd51a3b1-e10b-4f14-ab5c-b775d9274bd0",
                        "source_entry_id": "707e089c-4b08-3f54-80fd-ded081b6d19a",
                        "source_sense_id": "fdec0b02-77d6-3df5-bdee-e90129d83ee2",
                        "target_lang_word": "fluorescent",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fluorescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3f246d4-81a4-358e-95a5-50e59fb9cb23",
                                        "entry_id": "55c7e39c-abf5-326d-9e7e-e9bddd6935b5",
                                        "glosses": [
                                            "Of or relating to fluorescence."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca5c8c31-8f19-3954-9c3f-f0fad62d0225",
                                        "entry_id": "55c7e39c-abf5-326d-9e7e-e9bddd6935b5",
                                        "glosses": [
                                            "Exhibiting or produced by fluorescence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "288ad2d6-3919-4f33-9931-8aa9c8e8c559",
                                                "sense_id": "ca5c8c31-8f19-3954-9c3f-f0fad62d0225",
                                                "text": "The fluorescent plants shimmered in the darkness."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cce5fa1d-d63c-385a-bbbd-baa7495f0584",
                                        "entry_id": "55c7e39c-abf5-326d-9e7e-e9bddd6935b5",
                                        "glosses": [
                                            "Emitting visible light as a result of the excitation of phosphors by ultraviolet photons produced by the passage of an electrical current through an inert gas infused with mercury."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d84e7af-8bfc-44e0-a77a-f4beb771864d",
                                                "sense_id": "cce5fa1d-d63c-385a-bbbd-baa7495f0584",
                                                "text": "The quality of fluorescent lighting technology has improved dramatically in recent years."
                                            },
                                            {
                                                "example_id": "22a98046-8142-4939-897a-4b66f6d11d8d",
                                                "sense_id": "cce5fa1d-d63c-385a-bbbd-baa7495f0584",
                                                "text": "The shed, a steel-framed structure with a single-span roof devoid of intermediate support, is exceptionally well-lit by continuous glazing on the roof and along much of the sides, while there is fluorescent roof lighting for night work."
                                            },
                                            {
                                                "example_id": "02642ca9-ef1a-4efd-aad2-7634fd115894",
                                                "sense_id": "cce5fa1d-d63c-385a-bbbd-baa7495f0584",
                                                "text": "Rather than burning out as incandescent bulbs do, L.E.D.’s light output dims over tens of thousands of hours. L.E.D.’s are also more resistant to vibration than incandescents or screw-in fluorescent bulbs, and do not flicker or hum."
                                            },
                                            {
                                                "example_id": "f2b78dac-2136-49a2-8108-583f7e9921c1",
                                                "sense_id": "cce5fa1d-d63c-385a-bbbd-baa7495f0584",
                                                "text": "Then they backed the membrane with a gel matrix containing a perfluorocarbon (PFC) propellant and fluorescent \"nanobullets\" about a micron wide, and hit it with ultrasound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c3a781-0cf8-33bb-8292-a25fee490dd8",
                                        "entry_id": "55c7e39c-abf5-326d-9e7e-e9bddd6935b5",
                                        "glosses": [
                                            "Vivid, as if fluorescing; neon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4516ebd-a1b3-49a7-af95-a238fb48a92a",
                                                "sense_id": "70c3a781-0cf8-33bb-8292-a25fee490dd8",
                                                "text": "Her shirt was fluorescent orange."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fluorescent",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e62337f0-dbfe-390e-9cbf-18beb0430906",
                                        "entry_id": "6bd2d0a4-213b-3153-9808-09694412598f",
                                        "glosses": [
                                            "A fluorescent light."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4e20e0-1b0e-4abc-8976-4f067553ad03",
                                                "sense_id": "e62337f0-dbfe-390e-9cbf-18beb0430906",
                                                "text": "The fluorescents hummed day and night."
                                            },
                                            {
                                                "example_id": "a0a9e95d-305a-4354-91a0-599129f42f90",
                                                "sense_id": "e62337f0-dbfe-390e-9cbf-18beb0430906",
                                                "text": "Compact fluorescents are typically rated at 7,500 to 10,000 hours, and incandescents at about 1,500 hours."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
