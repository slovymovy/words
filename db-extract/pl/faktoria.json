                                                "sense_id": "c83b92f5-1621-309d-8299-a715954324ad",
                                                "text": "See how there's another layer of metal there? That's not factory."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8be38e1-d69d-4510-bbe2-502a77233291",
                        "source_entry_id": "d1a7788d-1fb4-3c50-b78c-3db141657c5e",
