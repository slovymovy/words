                        "sense_id": "2265e475-5905-3327-979b-cb4a001fa5fd",
                        "entry_id": "69df9c36-7737-3b4b-b5be-6fa58da6c20c",
                        "glosses": [
                            "Gardien de prison."
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "dcab7923-bf48-4e61-b7d0-3ead711dddff",
                                "sense_id": "2265e475-5905-3327-979b-cb4a001fa5fd",
                                "text": "On a beau lutter contre, les clichés nous habitent. « Gardien de prison », par exemple : cette profession n’évoquait que modérément, pour moi, l’humanisme. C’est une fraternité qu’on ressent, pourtant, chez Luc Rody, maton à la maison d’arrêt d’Amiens et délégué CGT (syndicat majoritaire)."
                            }
                        ]
                    }
                ],
