                "senses": [
                    {
                        "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                        "entry_id": "ccd30677-e439-31ae-80c9-f087c07dec7f",
                        "glosses": [
                            "Behörde, Stelle, die sich mit einkommenden Beschwerden befasst und über diese Entscheidungen trifft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "304bdd68-3f5c-45cc-b562-ecd3003eae0e",
                                "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                                "text": "„Ein in der Beschwerdeinstanz erstmals gestellter Antrag kann an das VollstrGer abgegeben werden, wenn der Antragsteller einverstanden ist.“"
                            },
                            {
                                "example_id": "72f3dc30-d940-412e-981d-8e91e40395e9",
                                "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                                "text": "„Im Kanton Bern nimmt das Kindes- und Erwachsenenschutzgericht die Aufgaben der gerichtlichen Beschwerdeinstanz in Kindes- und Erwachsenenschutzsachen wahr.“"
                            },
                            {
                                "example_id": "1d06846a-d743-49aa-81b9-f98e2c606ce3",
                                "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                                "text": "„Neue Tatsachen können in der Beschwerdeinstanz nicht vorgebracht, auch neue Beweismittel nicht angeboten werden.“"
                            },
                            {
                                "example_id": "0e9aced3-c1e3-43d8-a833-436c6f4990a3",
                                "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                                "text": "„Die gerichtliche Beschwerdeinstanz gibt der Erwachsenenschutzbehörde Gelegenheit zur Vernehmlassung.“"
                            },
                            {
                                "example_id": "ca08847f-d5ee-4d45-890b-e1f4babd537d",
                                "sense_id": "c81a6e4c-d3e9-36d1-a158-18337170e5d2",
                                "text": "„Das Verfahren und damit die Anhörung der Parteien mußte vor der Beschwerdeinstanz wiederholt und so das Verfahren dort ‚fortgesetzt‘ werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
