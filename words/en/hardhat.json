{
    "word_family": [
        "hatter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "af9da293-8a0e-3972-bfa2-226d18f87c52",
                    "sense_definition": "Alternative spelling of <w>hard hat</w>; a protective helmet worn by construction workers and others to prevent injury.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "protective_headgear",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Every visitor must wear a yellow <w>hardhat</w> before entering the construction site.",
                            "target_lang_translations": {
                                "ru": "Каждый посетитель должен надеть желтую <w>каску</w> перед входом на строительную площадку."
                            }
                        },
                        {
                            "text": "He adjusted his protective <w>hardhat</w> to make sure it fit securely on his head.",
                            "target_lang_translations": {
                                "ru": "Он поправил свою защитную <w>каску</w>, чтобы убедиться, что она надежно сидит на голове."
                            }
                        }
                    ],
                    "synonyms": [
                        "safety helmet"
                    ],
                    "common_phrases": [
                        "wear a hardhat",
                        "protective hardhat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защитный шлем, носимый строителями и другими рабочими для предотвращения травм."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "каска",
                                "target_lang_sense_clarification": "защитный головной убор"
                            },
                            {
                                "target_lang_word": "строительная каска",
                                "target_lang_sense_clarification": "каска строителя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed661f58-5d28-31fb-a7e3-3ed240800b10",
                    "sense_definition": "A person who wears a hard hat, especially a construction worker.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "worker",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local diner was filled with hungry <w>hardhats</w> during the lunch hour.",
                            "target_lang_translations": {
                                "ru": "В обеденный перерыв местная закусочная была заполнена голодными <w>строителями</w>."
                            }
                        },
                        {
                            "text": "A group of <w>hardhats</w> gathered near the scaffolding to discuss the blueprint.",
                            "target_lang_translations": {
                                "ru": "Группа <w>строителей</w> собралась у лесов, чтобы обсудить чертеж."
                            }
                        }
                    ],
                    "synonyms": [
                        "construction worker"
                    ],
                    "common_phrases": [
                        "union hardhats"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used to refer to construction workers as a group."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, носящий защитную каску, особенно строительный рабочий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "строитель",
                                "target_lang_sense_clarification": "рабочий на стройке"
                            },
                            {
                                "target_lang_word": "касочник",
                                "target_lang_sense_clarification": "разговорное обозначение строителя или рабочего в каске"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}