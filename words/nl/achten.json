                            },
                            {
                                "target_lang_word": "pay attention",
                                "target_lang_sense_clarification": "to listen to or watch something carefully"
                            },
                            {
                                "target_lang_word": "note",
                                "target_lang_sense_clarification": "to notice or pay particular attention to something"
                            }
                        ]
                    }
                }
            ]
        },
        {
