                ],
                "senses": [
                    {
                        "sense_id": "fad2589e-d9aa-3acf-87b6-a8448aa0ebf4",
                        "entry_id": "9b5f904c-872c-3b9a-b146-c599551df2ce",
                        "glosses": [
                            "Knochen als Teil des Schädels"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bd230ba-536c-49dc-ba57-2b10712f76dd",
                                "sense_id": "fad2589e-d9aa-3acf-87b6-a8448aa0ebf4",
                                "text": "„Das ausgemergelte Fleisch in ihrem Gesicht war straff über die Schädelknochen gezogen, dass es vor Anspannung schimmerte.“"
                            },
                            {
                                "example_id": "fed0a979-d505-4137-ad18-0b04c915b656",
                                "sense_id": "fad2589e-d9aa-3acf-87b6-a8448aa0ebf4",
                                "text": "„Bowman hat ebenfalls keine Probleme - bis sie den Schädel öffnen und das Gehirn herausnehmen, wobei ihm weniger der Anblick zu schaffen macht als das Knirschen der Schädelknochen.“"
                            },
                            {
                                "example_id": "999be012-e92a-4968-a927-2e40d39dc35c",
                                "sense_id": "fad2589e-d9aa-3acf-87b6-a8448aa0ebf4",
                                "text": "„Der Schlag, ein dumpfes Krachen harter Fingerknöchel auf praktisch ungeschützte Schädelknochen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
