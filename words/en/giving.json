                },
                {
                    "sense_id": "379aaf20-c8e5-3c5b-a0b1-a61bb5022d17",
                    "sense_definition": "The act or state of yielding, softening, or breaking under pressure or warmth.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "yield",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The river ice showed signs of <w>giving</w> as the temperature rose.",
                            "target_lang_translations": {
                                "ru": "Речной лед начал проявлять признаки <w>таяния</w> по мере повышения температуры."
                            }
