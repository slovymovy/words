                ],
                "senses": [
                    {
                        "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                        "entry_id": "98133a2f-7c82-36b9-91fa-d1e9c0696b4b",
                        "glosses": [
                            "einzelnes Bauteil oder auch Baugruppe in einer Lüftungstechnischen Anlage oder lüftungstechnischen Einrichtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30799b96-3621-46e4-8959-9240cbc19645",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "Ein einfaches Lüftungsbauteil ist zum Beispiel eine Rohrbogen, ein Drosselklappe oder auch ein Stück Lüftungskanal; hingegen ein kompaktes Lüftungsbauteil wie der Ventilator oder ein RLT-Gerät, bestehen selbst aus verschiedenen technischen Einzelteilen und sind dennoch ein Lüftungsbauteil."
                            },
                            {
                                "example_id": "50f83f58-11ea-4fa7-aec0-f39e77041645",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "„Die strapazierfähige und universell einsetzbare Selbstklebefolie ermöglicht einen schnellen, einfachen und staubdichten Verschluss von Luftkanälen, Wickelfalzrohren und anderen Lüftungsbauteilen. “"
                            },
                            {
                                "example_id": "9d2074b5-76f6-4c73-b757-528424a933c8",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "„Im Folgenden sehen Sie eine Auflistung aller Lüftungsbauteile – Neutrale Wohnraumlüftung mit den Optionen, welche eingestellt werden können.“"
                            },
                            {
                                "example_id": "b1d43c3b-79c9-4c39-82bd-53f2eee69ac6",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "„Erstmals bieten wir Planern und Betreibern von Abluftanlagen mit konstantem oder bedarfsabhängig geregeltem Volumenstrom ein Lüftungsbauteil mit automatischer Luftmengenregelung und selbständig wechselndem Filter an.“"
                            },
                            {
                                "example_id": "ef9bec43-8dc0-410b-bff2-fab62356d680",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "„Mit dieser Version wurde ein neuer Katalog für Lüftungsbauteile ausgeliefert.“"
                            },
                            {
                                "example_id": "85bfb808-54ee-4864-8515-94e702ae2bdd",
                                "sense_id": "93efd8a7-ac79-3d9e-bc23-1a3532761d31",
                                "text": "„Bei verbessertem Wärmeschutz ist dieses Lüftungsbauteil ein aus hygienischen, bauphysikalischen und energieökonomischen Gründen geeignetes Lüftungsbauteil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
