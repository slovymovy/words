                        "glosses": [
                            "S’enchaîner soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4b314ae-669c-4a0b-9182-9adb558277d6",
                                "sense_id": "75bd87a0-c64e-32a3-96d6-9c70ac26cd21",
                                "text": "Puis on apprendra à bricoler le fameux arm-lock, un tube en acier très utile pour s'auto-enchaîner à des voies ferrées ou à des engins de chantier."
                            },
                            {
                                "example_id": "3be5b538-3ae2-4168-ab04-23f51875848c",
                                "sense_id": "75bd87a0-c64e-32a3-96d6-9c70ac26cd21",
                                "text": "Ensuite, et selon le Canard Enchaîné toujours prompt à s'auto-enchaîner lorsque la gauche arrive au pouvoir, il n'y a pas de quoi casser trois pattes à un canard, pensez donc : c’est un prince saoudien qui justement passait par Brive-la-Gaillarde le 6 mai en fin de journée, qui a payé le Falcon !"
                            }
                        ]
                    }
