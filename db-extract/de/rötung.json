                "senses": [
                    {
                        "sense_id": "38b73386-e541-3228-9f60-09e84bf8366c",
                        "entry_id": "caa5b060-02f1-3217-9d2b-7ea27374c496",
                        "glosses": [
                            "das Rotwerden (besonders der Haut)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "65d3a286-d490-43c6-9f92-e0ee24dc2ccb",
                                "sense_id": "38b73386-e541-3228-9f60-09e84bf8366c",
                                "text": "Meist sind vorübergehende Rötungen Zeichen für eine stärkere Durchblutung der Haut durch Erregung, Anstrengung oder Temperatureinflüsse oder treten im Zusammenhang mit Schweißausbrüchen, hormonellen Umstellungen oder innerer Unruhe auf."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2d1ec25b-f5be-3849-aa00-68ab296ea6b0",
                        "entry_id": "caa5b060-02f1-3217-9d2b-7ea27374c496",
                        "glosses": [
                            "gerötete Stelle (besonders auf der Haut)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1980641b-beb5-4fdc-a375-a7d8da343e39",
                                "sense_id": "2d1ec25b-f5be-3849-aa00-68ab296ea6b0",
                                "text": "Rötungen kommen bei allergischen Reaktionen und Unverträglichkeiten, Sonnenbrand, durch Medikamente und Gifte vor, sowie bei Neurodermitis, Ekzemen und gereizter Haut."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
