                    {
                        "sense_id": "c59b0e4c-f392-3f2d-8785-ab5b8284dd88",
                        "entry_id": "9935e362-1ce7-322c-b2d6-52295f2248f0",
                        "glosses": [
                            "Gruppe von Personen mit gemeinsamer Forschungstätigkeit, gemeinsamem Forschungsziel"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d077f9e-f1e6-4cd7-867c-4f03ea260ea3",
                                "sense_id": "c59b0e4c-f392-3f2d-8785-ab5b8284dd88",
                                "text": "„Ein Forschungsteam hat eine völlig neue Art Motor entwickelt. Sie setzen dabei auf ein quantenmechanisches Phänomen statt auf Kraftstoffe oder Strom.“"
                            },
                            {
                                "example_id": "8071ebd4-1192-466e-a7ce-c7c56b7717b3",
                                "sense_id": "c59b0e4c-f392-3f2d-8785-ab5b8284dd88",
                                "text": "„Ein internationales Forschungsteam aus Grönland, den USA und Dänemark hat mit einer umfassenden Genomanalyse die Geschichte der Grönlandhunde untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
