                    {
                        "translation_id": "559424b3-595e-4941-85a9-cc0e570c68a1",
                        "source_entry_id": "c9327475-4520-3f4e-afbf-0d4a877ecdd6",
                        "source_sense_description": "inhabitant of the Moon",
                        "target_lang_word": "Sélénite",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sélénite",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "449afa7e-39d3-3e11-9b24-4acd1c86aeae",
                                        "entry_id": "dbeb73de-8588-30d1-beeb-d73a42c0e2ce",
                                        "glosses": [
                                            "Habitant fictionnel de la Lune."
                                        ],
                                        "tags": [
                                            "Science-fiction"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "670ba973-cc1d-48e4-a847-be59a137ff9c",
                                                "sense_id": "449afa7e-39d3-3e11-9b24-4acd1c86aeae",
                                                "text": "Si l’on exclut aussi les petits Péruviens ou autres Sélénites qui avaient atterri parmi nous et qui ne pigeaient pas un mot de français, on en arrive à trente-quatre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "469d5d55-e8b8-4966-bcff-672889033895",
                        "source_entry_id": "c9327475-4520-3f4e-afbf-0d4a877ecdd6",
                        "source_sense_description": "inhabitant of the Moon",
                        "target_lang_word": "Lunarien",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lunarien",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c7450f07-3089-3cf1-b313-d3239db8250f",
                                        "entry_id": "9fdebdb2-ae4e-3f68-a7ac-a6e4a2a6b334",
                                        "glosses": [
                                            "Habitant imaginaire de la Lune."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "664a31bb-ab3f-4a9c-a8b7-0011f4ac13ed",
                                                "sense_id": "c7450f07-3089-3cf1-b313-d3239db8250f",
                                                "text": "Si l’on retrouve dans ce roman deux éléments « verniens », à savoir le canon —ici un volcan— pour envoyer les hommes sur la Lune (cf. De la Terre à la Lune) et la comète qui « embarque » les voyageurs (cf. Hector Servadac), on trouve surtout d’autres choses : des civilisations extraterrestres, Lunariens, Vénusiens, Martiens ; un périple jusqu’aux confins de l’univers ; et surtout une ambiance qui n’a rien d’idyllique, avec plusieurs assassinats ou tentatives, une guerre qui vire à l’anéantissement de la civilisation de Mars, et même une rivalité amoureuse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4863f219-ba63-495e-be96-392a7e26bdf3",
