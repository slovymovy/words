                    "sense_id": "73840b6b-44b8-39e1-908b-bd3619f3c54b",
                    "sense_definition": "duży, pierwotny, niezamieszkany przez ludzi las",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "las",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W głębi <w>puszczy</w> można spotkać wiele dzikich zwierząt.",
                            "target_lang_translations": {
                                "en": "Deep in the <w>primeval forest</w>, one can encounter many wild animals."
                            }
                        },
                        {
                            "text": "Stara <w>puszcza</w> zachwyca swoim spokojem i majestatem.",
                            "target_lang_translations": {
                                "en": "The old <w>primeval forest</w> enchants with its peace and majesty."
                            }
                        }
                    ],
                    "common_phrases": [
                        "gęsta puszcza",
                        "stara puszcza"
                    ],
                    "target_lang_definitions": {
                        "en": "a large, dense, primeval forest untouched by human activity"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "primeval forest",
                                "target_lang_sense_clarification": "virgin or ancient woodland"
                            },
                            {
                                "target_lang_word": "wilderness",
                                "target_lang_sense_clarification": "dense, uncultivated wild forest"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55a1680e-8982-3f20-abb5-324158a9fa0e",
                    "sense_definition": "niezamieszkany, odludny teren, pustkowie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "teren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jego apel był jak głos wołającego na <w>puszczy</w>.",
                            "target_lang_translations": {
                                "en": "His appeal was like a voice crying in the <w>wilderness</w>."
                            }
                        },
                        {
                            "text": "To miejsce przypominało raczej dziką <w>puszczę</w> niż zamieszkany teren.",
                            "target_lang_translations": {
                                "en": "This place resembled a wild <w>wilderness</w> rather than an inhabited area."
                            }
                        }
                    ],
                    "synonyms": [
                        "pustkowie",
                        "dzicz"
                    ],
                    "target_lang_definitions": {
