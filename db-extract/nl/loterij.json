                                "example_id": "c96a9d7e-6d09-45f9-b232-7ca1751c337f",
                                "sense_id": "84aacff0-3d21-3ae7-ba31-f60eb6d14ff6",
                                "text": "Ze kocht een lot voor de grote loterij en hoopte op een grote prijs.",
                                "translation": "She bought a ticket for the big lottery and hoped for a big prize.",
                                "english": "She bought a ticket for the big lottery and hoped for a big prize."
                            },
                            {
                                "example_id": "a68e2e9d-3795-45d5-a6ce-9a2dabf22c78",
                                "sense_id": "84aacff0-3d21-3ae7-ba31-f60eb6d14ff6",
                                "text": "De winnaar van de loterij was verrast en blij met zijn prijs.",
                                "translation": "The winner of the lottery was surprised and happy with their prize.",
                                "english": "The winner of the lottery was surprised and happy with their prize."
                            },
                            {
                                "example_id": "fa9c052e-61b1-478a-afb7-7f4a07db5ee6",
                                "sense_id": "84aacff0-3d21-3ae7-ba31-f60eb6d14ff6",
                                "text": "De opbrengst van de loterij gaat naar een goed doel.",
                                "translation": "The proceeds of the lottery go to a good cause.",
                                "english": "The proceeds of the lottery go to a good cause."
                            }
                        ]
