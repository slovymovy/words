                "senses": [
                    {
                        "sense_id": "2eb38e8e-66f8-3774-9535-946c38306b09",
                        "entry_id": "a9d10672-f125-3f27-82ae-e5da302762d0",
                        "glosses": [
                            "Orgel, die nicht auf waagerechtem Fußboden aufgebaut ist, sondern in großer Höhe an oder vor einer Innenwand montiert ist"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "8dcb599c-3fbd-42dc-9157-1d6f752307c7",
                                "sense_id": "2eb38e8e-66f8-3774-9535-946c38306b09",
                                "text": "„Bis April 2023 wird die Schwalbennestorgel im südlichen Querhaus gereinigt, repariert, für den Anschluss an die neuen Spieltische vorbereitet und neu intoniert.“"
                            },
                            {
                                "example_id": "0048f6db-5de8-4e8e-800e-6663769ecbc7",
                                "sense_id": "2eb38e8e-66f8-3774-9535-946c38306b09",
                                "text": "„Im Regensburger Dom erklang die größte Schwalbennestorgel der Welt.“"
                            },
                            {
                                "example_id": "bc166d83-b58c-4f21-8657-6b5122b667a9",
                                "sense_id": "2eb38e8e-66f8-3774-9535-946c38306b09",
                                "text": "„Sie wollen improvisieren auf der neuen \"Klais\"-Orgel, einer so genannten Schwalbennestorgel [im Original fälschlicherweise Schwalbennesterorgeln], und auf der in den vergangenen Jahren restaurierten \"Stahlhut\"-Orgel aus der Spätromantik.“"
                            },
                            {
                                "example_id": "3a4a61f1-847b-46d1-8470-bd0f5748ff11",
                                "sense_id": "2eb38e8e-66f8-3774-9535-946c38306b09",
                                "text": "„Nach dem Schlussakkord der weltberühmten Schwalbennestorgel [im Original fälschlicherweise Schwalbennesterorgeln] ging es zur \"Steipe\", einem spätgotischen Bau von 1454/84, der schon immer Repräsentationshaus der Stadt war und heute das Restaurant \"Ratskeller beherbergt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
