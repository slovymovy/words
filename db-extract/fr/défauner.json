                ],
                "senses": [
                    {
                        "sense_id": "3ffecd7f-af45-34f2-935e-56213b076dac",
                        "entry_id": "ed000c74-7776-38f8-9264-de8791c5d5a1",
                        "glosses": [
                            "Enlever la faune parasite de."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a5269ba-e900-48a4-b4eb-c5394d857194",
                                "sense_id": "3ffecd7f-af45-34f2-935e-56213b076dac",
                                "text": "On a donc, par ce procédé, la possibilité de le défauner, autrement dit de le débarrasser de ses parasites, les Protozoaires."
                            },
                            {
                                "example_id": "a3a2524c-5cbd-4ba4-9ab8-822aa7c9415f",
                                "sense_id": "3ffecd7f-af45-34f2-935e-56213b076dac",
                                "text": "De nombreuses tiques adultes (dont la diagnose est évidente) furent notées, mais non récoltées, afin de ne pas « défauner » les cavités en cours d’étude."
                            }
                        ]
                    },
                    {
                        "sense_id": "b6e73d56-55ac-3e1f-9603-e4f703cf3d4b",
                        "entry_id": "ed000c74-7776-38f8-9264-de8791c5d5a1",
                        "glosses": [
                            "Causer la disparition de la macrofaune (en particulier les vertébrés) d'une communauté naturelle."
                        ],
