                {
                    "sense_id": "2641e59d-c2e2-3a85-88cb-ff51630db745",
                    "sense_definition": "Nourriture placée dans un piège ou au bout d'un hameçon pour attirer et capturer des animaux ou des poissons.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "nourriture_capture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le pêcheur a fixé un ver sur son hameçon pour servir d'<w>appât</w>."
                        },
                        {
                            "text": "Nous avons placé un morceau de fromage comme <w>appât</w> dans le piège."
                        }
                    ],
                    "synonyms": [
                        "amorce",
                        "esche"
                    ],
                    "common_phrases": [
