                "word": "vallonnement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "476aff94-3558-3a89-b2ff-56bf45aed11b",
                        "entry_id": "fefd2aeb-4c55-3677-b8ce-9effecff05e8",
                        "glosses": [
                            "Forme de terrain naturel ou artificiel, fait de pentes douces et de vallées peu marquées."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b54a8240-eb4e-4b26-90c4-2ad0da78d5ba",
                                "sense_id": "476aff94-3558-3a89-b2ff-56bf45aed11b",
                                "text": "[…]: c’étaient de hautes falaises rocheuses, des cascades et de larges fleuves bouillonnants et désolés, des bouquets d’arbres et des fourrés de plus en plus rabougris. Et, sur les pentes, de temps à autre, des vallonnements pleins de neige."
                            },
                            {
                                "example_id": "fc59d8e7-2d83-4bff-96da-47c9526f0fcd",
                                "sense_id": "476aff94-3558-3a89-b2ff-56bf45aed11b",
                                "text": "De la crête sur le versant nord, long cheminement sur une piste avec un petit vallonement."
                            },
                            {
                                "example_id": "efa9bf5c-b001-48db-a0f6-b2290ff19ceb",
                                "sense_id": "476aff94-3558-3a89-b2ff-56bf45aed11b",
                                "text": "Vallées et plateaux se succèdent en un léger vallonnement incessant, plus marqué à l'ouest qu'à l'est du département."
                            }
                        ]
                    }
                ],
