                "senses": [
                    {
                        "sense_id": "14d90fc3-09be-37bb-9383-eb13a6e6d354",
                        "entry_id": "1a30b0be-1368-319f-9bf5-a1a1faa684be",
                        "glosses": [
                            "de mogelijkheden om iets te bevatten (begrijpen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ea9ed26-3b80-4ae7-b444-b4cd8f6e4452",
                                "sense_id": "14d90fc3-09be-37bb-9383-eb13a6e6d354",
                                "text": "De nieuwe rekenmethode gaat zijn bevattingsvermogen te boven."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b682c70d-dbbe-48cd-bba3-a0ecbd354f91",
                        "source_entry_id": "1a30b0be-1368-319f-9bf5-a1a1faa684be",
                        "source_sense_id": "14d90fc3-09be-37bb-9383-eb13a6e6d354",
                        "target_lang_word": "intelligence",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "intelligence",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2aacdd74-6ba7-323e-aebc-3012998fde83",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "The capacity of mind, especially to understand principles, truths, facts or meanings, acquire knowledge, and apply it to practice; the ability to comprehend and learn; the ability to process sentient experience to generate true beliefs with a justified degree of confidence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fb2c9c6a-4448-43e7-bd53-c2b599cf1e5e",
                                                "sense_id": "2aacdd74-6ba7-323e-aebc-3012998fde83",
                                                "text": "...the test of a first-rate intelligence is the ability to hold two opposed ideas in the mind at the same time, and still retain the ability to function."
                                            },
                                            {
                                                "example_id": "8bc9c4c4-03d9-4917-ab7a-e37f2fe57e76",
                                                "sense_id": "2aacdd74-6ba7-323e-aebc-3012998fde83",
                                                "text": "Not so, however, with Tarzan, the man-child. His life amidst the dangers of the jungle had taught him to meet emergencies with self-confidence, and his higher intelligence resulted in a quickness of mental action far beyond the powers of the apes."
                                            },
                                            {
                                                "example_id": "ef9e1b31-73a6-4404-9b82-0470211199b9",
                                                "sense_id": "2aacdd74-6ba7-323e-aebc-3012998fde83",
                                                "text": "Irregular bedtimes may disrupt healthy brain development in young children, according to a study of intelligence and sleeping habits."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "27e8bd1f-4179-3552-9806-988eda5a636c",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "The quality of making use or having made use of such capacities: depth of understanding, mental quickness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d8f44d4c-eb1e-48f9-a52e-c17bdc813116",
                                                "sense_id": "27e8bd1f-4179-3552-9806-988eda5a636c",
                                                "text": "From a religious point of view, a bodhisattva with sharp faculties and great intelligence can cause a tremendous upheaval if he or she misuses that power under the influence of negative emotions, like attachment and hatred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "An entity that has such capacities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd881ab4-16a5-4b1d-9a1f-f1919b05a2da",
                                                "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                                                "text": "The great Intelligences fair\n That range above our mortal state,\n In circle round the blessed gate,\nReceived and gave him welcome there."
                                            },
                                            {
                                                "example_id": "ed5cc720-6704-45bd-97af-a650c6e50ef0",
                                                "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                                                "text": "The living intelligence, the Martian within the hood, was slain and splashed to the four winds of heaven, and the thing was now but a mere intricate device of metal whirling to destruction."
                                            },
                                            {
                                                "example_id": "d75ef241-327d-4ae9-9456-b8932e579640",
                                                "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                                                "text": "But there are latent powers within man alone that are not yet fully understood and[…] we cannot definitely state what is, and what is not, due to the interference or influence of discarnate intelligences."
                                            },
                                            {
                                                "example_id": "dd38148d-9d5d-4874-b07a-3d7eea456862",
                                                "sense_id": "d7ade009-1d54-38db-9e9c-34a3725e0c28",
                                                "text": "He passes beyond the projections and thought forms of his own creation to the wholly other and independent world of the angelic intelligences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c72553c-abe8-3969-8ae8-634e2524dcd7",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "Information, often secret, about an enemy or about hostile activities."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5cb717-73aa-4544-9292-0f0c6ecd4751",
                                                "sense_id": "2c72553c-abe8-3969-8ae8-634e2524dcd7",
                                                "text": "Their lack of good intelligence also meant that they vastly overestimated the size of their foes for far too long, hails of armor-piercing shells doing comparatively little damage compared to the high explosive that they should have been using."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "531395de-9fc8-3118-be47-2fe2ed72609e",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "A political or military department, agency or unit designed to gather information, usually secret, about the enemy or about hostile activities."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bda6c580-b674-3fba-9499-79a45af87423",
                                        "entry_id": "2c5b28e1-afd4-3fae-a59d-316ffd8efdb0",
                                        "glosses": [
                                            "Acquaintance; intercourse; familiarity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc75af64-870d-4500-b042-b84d9618acb6",
                                                "sense_id": "bda6c580-b674-3fba-9499-79a45af87423",
                                                "text": "Yet Josephus tells us of Phiala, a ſpring[…] into which Philip the Tetrarch caſt chaffe to try the experiment, and it was rendred up again into the ſtreame of Iordan. Whence he concluded, that this river entertained an underground intelligence with that fountain."
                                            },
                                            {
                                                "example_id": "92635914-cdbb-4406-86c2-074165c48f30",
                                                "sense_id": "bda6c580-b674-3fba-9499-79a45af87423",
                                                "text": "He liv’d rather in a fair Intelligence than any Friendſhip with the Favourites;[…]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a645f6c-c00d-494e-90c6-fedee79906cd",
                        "source_entry_id": "1a30b0be-1368-319f-9bf5-a1a1faa684be",
