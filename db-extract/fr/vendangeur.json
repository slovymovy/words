                                        "glosses": [
                                            "One who gathers the vintage, i.e. a grape harvester."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51307ed5-512e-433a-8dcd-c722aae452ee",
                                                "sense_id": "b7613516-94c2-3fb1-883b-8c8b96a058ee",
                                                "text": "The sun, treading the earth like a vintager, drew from it heady fragrances, crushed out of it new colours."
                                            },
                                            {
                                                "example_id": "78a7188e-63fb-4fb5-b530-97f3b17b4b87",
                                                "sense_id": "b7613516-94c2-3fb1-883b-8c8b96a058ee",
                                                "text": "Matured in all the graces, he is like the ripened Chian clusters that await the vintager in the autumn days."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
