                "senses": [
                    {
                        "sense_id": "ff3446d1-5c48-3420-8bbe-d20198fe3c75",
                        "entry_id": "48f445ec-625a-35dd-9a78-018c8a0789ed",
                        "glosses": [
                            "Action de carder : enlever les matériaux bruts des fibres textiles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc9abaaa-037f-478c-8a31-18c850e9c0a3",
                                "sense_id": "ff3446d1-5c48-3420-8bbe-d20198fe3c75",
                                "text": "Le cardage a pour but de nettoyer les filaments, de les isoler, d'en éliminer les matières étrangères et de paralléliser les fibres pour en former un ruban."
                            },
                            {
                                "example_id": "3dbf0798-7f83-4c84-811a-99c7489ccb78",
                                "sense_id": "ff3446d1-5c48-3420-8bbe-d20198fe3c75",
                                "text": "Après l’égrainage, qui sépare les graines de la fibre végétale à l’aide d’une tige en fer appuyée sur un support en bois, elles peignent la matière entre deux brosses en bois et pics métalliques pour obtenir un coton mousseux, c’est le cardage."
                            }
                        ]
                    }
                ],
