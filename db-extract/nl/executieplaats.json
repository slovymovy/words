                        "examples": [
                            {
                                "example_id": "27b74792-cb39-4b9f-9dbe-f22c77e8bae2",
                                "sense_id": "36a5a31e-6d7d-3445-95e8-ae3007cd9b34",
                                "text": "Toen hij op de terugweg van Vorontsovo over het Bolotnoje-plein reed, zag Pierre een menigte bij de Executieplaats, hij liet halt houden en stapte uit zijn rijtuigje. Er werd een van spionage beschuldigde Franse kok berecht."
                            },
                            {
                                "example_id": "fcd224a9-2e01-490e-beb7-31a04ef13be3",
                                "sense_id": "36a5a31e-6d7d-3445-95e8-ae3007cd9b34",
                                "text": "Op een steenworp afstand staan de al-Aqsamoskee en de Rotskoepel, volgens moslims op de plek waar de profeet Mohammed een nachtreis naar de hemel heeft gemaakt. En ook voor christenen is de stad van bijzondere waarde: volgens hen heeft Jezus er de kruisweg gelopen over de Via Dolorosa naar zijn executieplaats en is hij er begraven geweest, op de plaats waar nu de Heilig Grafkerk staat."
                            }
