                                    {
                                        "sense_id": "add9916f-ba1e-31be-b521-f8c58c001995",
                                        "entry_id": "9023ec75-4136-32a3-94ad-043369516a78",
                                        "glosses": [
                                            "Alternative letter-case form of Fata Morgana."
                                        ],
