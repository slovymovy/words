        "fr-extract.jsonl": [
            {
                "entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                "word": "trivialité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6cd3039d-8e06-4079-b428-bbcfab669cdd",
                        "entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "tags": [
                            "plural"
                        ],
                        "form": "trivialités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2500adf8-89fa-39f9-8058-1f1dfaa7d7b4",
                        "entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "glosses": [
                            "Caractère de ce qui est trivial."
                        ],
                        "tags": [
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "ed993605-3208-4a64-a0e4-8cca3f5f303d",
                                "sense_id": "2500adf8-89fa-39f9-8058-1f1dfaa7d7b4",
                                "text": "[…] une décence qu'on ne trouve pas à ce point dans les campagnes où la trivialité est si commune."
                            }
                        ]
                    },
                    {
                        "sense_id": "7826dc7e-dbaa-3e7f-b7b8-3ad767ad3133",
                        "entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "glosses": [
                            "Chose triviale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c6b27c07-fc03-48ae-8874-f7c3e5f0b05f",
                                "sense_id": "7826dc7e-dbaa-3e7f-b7b8-3ad767ad3133",
                                "text": "Une autre fois, ce confrère (de moins en moins ami) me dit sans rire : « Si Hitler s'était allié aux Juifs, il aurait gagné la guerre. » Ouais, et si ma tante en avait - pardon pour la trivialité -, on l'appellerait mon oncle."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d22a699-f3a6-42d3-835b-e844ef71bfcc",
                        "source_entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "source_sense_id": "2500adf8-89fa-39f9-8058-1f1dfaa7d7b4",
                        "source_sense_description": "(Au singulier) Caractère de ce qui est trivial",
                        "target_lang_word": "Einfachheit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Einfachheit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                        "entry_id": "1091aada-bba1-3d74-9687-41bc3201bf42",
                                        "glosses": [
                                            "die Eigenschaft, einfach zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a2a822-d96a-46e4-b9ac-0e64d94eb6a3",
                                                "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                                "text": "Die Einfachheit der Prüfung war überraschend."
                                            },
                                            {
                                                "example_id": "cc50755c-2cfa-48d4-9b60-4744c7ebfedc",
                                                "sense_id": "fae33c35-642a-3cd4-9f7c-bc3c8d1c9dfb",
                                                "text": "„Die Einfachheit der Wortwahl dieses Gedichts täuscht leicht darüber hinweg, mit welcher Meisterschaft Busch in diesen Versen ein Thema behandelte, das ihn mit zunehmenden Jahren beschäftigte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5641cc24-623a-46f5-a9c0-bdb7c8ea7e7b",
                        "source_entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "source_sense_id": "2500adf8-89fa-39f9-8058-1f1dfaa7d7b4",
                        "source_sense_description": "(Au singulier) Caractère de ce qui est trivial",
                        "target_lang_word": "triviality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "triviality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "30a92add-2f83-315d-81fc-36e74b0076f2",
                                        "entry_id": "7d3cf6e7-03aa-3d7f-bc31-be4dffd22a70",
                                        "glosses": [
                                            "The quality of being trivial or unimportant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4a47f142-7a5a-37d5-8f1d-b83fe2e04119",
                                        "entry_id": "7d3cf6e7-03aa-3d7f-bc31-be4dffd22a70",
                                        "glosses": [
                                            "Something which is trivial or unimportant."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b7eeaaf6-7d27-4beb-ae08-ab897f9647b9",
                                                "sense_id": "4a47f142-7a5a-37d5-8f1d-b83fe2e04119",
                                                "text": "I propose to devote the remainder of mine to it, and can only regret the wasted years that lie behind me, squandered in trivialities."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8d37a36-2cb1-453b-b789-5e3fdde035e3",
                        "source_entry_id": "9660b92c-6f77-3808-a369-ec884266f90d",
                        "source_sense_id": "7826dc7e-dbaa-3e7f-b7b8-3ad767ad3133",
                        "source_sense_description": "Chose triviale",
                        "target_lang_word": "Trivialität",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Trivialität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bb61f029-7783-349a-a0a7-93e149c400f2",
                                        "entry_id": "465b90e4-6c5c-31ce-a9e7-93cecee8156c",
                                        "glosses": [
                                            "etwas nicht Bedeutendes, etwas Gewöhnliches"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c40e647-34f7-47d2-8050-2549e7294551",
                                                "sense_id": "bb61f029-7783-349a-a0a7-93e149c400f2",
                                                "text": "Wichtiges Thema Jandls ist ferner immer wieder das Alltägliche: die Monotonie und Trivialität des Lebens, die Erfahrung von Krankheit, Armut und Gewalt (…), wobei die Texte ihren Effekt aus ihrer oft skizzenhaften Knappheit beziehen."
                                            },
                                            {
                                                "example_id": "1f952c2c-6ccf-4244-84a6-18d0666a5b07",
                                                "sense_id": "bb61f029-7783-349a-a0a7-93e149c400f2",
                                                "text": "Der Höhe des Schadens nach betrachtete sie die Angelegenheit als Trivialität."
                                            },
                                            {
                                                "example_id": "efb6e8eb-8698-4f90-bc0e-fe6b16218bd5",
                                                "sense_id": "bb61f029-7783-349a-a0a7-93e149c400f2",
                                                "text": "„Vor allem wollte ich von den Menschen weg, die meine Zeit mit Trivialitäten verschwendeten.\""
                                            },
                                            {
                                                "example_id": "53adb0f1-b4ab-4e81-92e4-e6e596319c51",
                                                "sense_id": "bb61f029-7783-349a-a0a7-93e149c400f2",
                                                "text": "„Ein großer Teil seines Erfolges beruht auf einem Mißverständnis, und die Legenden, die man um den Dichter gesponnen hat, stehen an Plumpheit und Trivialität in nichts hinter denen zurück, die sich um Villon, Chopin oder Modigliani gerankt haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "795548e6-fd3f-3f50-803a-963799ed13d4",
                                        "entry_id": "465b90e4-6c5c-31ce-a9e7-93cecee8156c",
                                        "glosses": [
                                            "eine nicht sehr geistreiche Äußerung oder Idee"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db6ef733-1fdc-4cf4-abc3-37f6a39a0be2",
                                                "sense_id": "795548e6-fd3f-3f50-803a-963799ed13d4",
                                                "text": "Husserl erklärt, man könne, „gar nicht ohne tiefen Sinn, die Philosophie als die Wissenschaft von den Trivialitäten bezeichnen“."
                                            },
                                            {
                                                "example_id": "27b40dd1-e96c-4969-a876-e1452a5744ed",
                                                "sense_id": "795548e6-fd3f-3f50-803a-963799ed13d4",
                                                "text": "Bereits kursiert eine neue Wunderpädagogik, das «Lernen 2.0». Um sie ranken sich Visionen einer Zukunft des Lernens im Netz, die man mit ein paar Trivialitäten beschweren sollte, damit sie nicht in den didaktischen Himmel wachsen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
