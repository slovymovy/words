{
    "word_family": [
        "decorate",
        "decorative",
        "decorator",
        "decorativeness"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "13d83f39-2ac9-3b9f-bf55-846fb74ab3b9",
                    "sense_definition": "An object or item used to make something look more attractive or festive.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ornamentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We spent the whole afternoon putting up the Christmas <w>decorations</w> in the living room.",
                            "target_lang_translations": {
                                "ru": "Мы провели весь день, развешивая рождественские <w>украшения</w> в гостиной.",
                                "zh": "我们花了一整个下午在客厅里挂圣诞<w>装饰品</w>。"
                            }
                        },
                        {
                            "text": "The colorful <w>decoration</w> on the cake made it look professional and delicious.",
                            "target_lang_translations": {
                                "ru": "Яркое <w>украшение</w> на торте придало ему профессиональный и аппетитный вид.",
                                "zh": "蛋糕上色彩缤纷的<w>装饰</w>让它看起来既专业又美味。"
                            }
                        }
                    ],
                    "synonyms": [
                        "adornment",
                        "ornament",
                        "embellishment"
                    ],
                    "common_phrases": [
                        "Christmas decoration",
                        "party decoration",
                        "interior decoration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предмет или вещь, используемая для того, чтобы сделать что-либо более привлекательным или праздничным.",
                        "zh": "用于使某物看起来更美观或更具节日气氛的物品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшение",
                                "target_lang_sense_clarification": "предмет, придающий красивый вид"
                            },
                            {
                                "target_lang_word": "декорация",
                                "target_lang_sense_clarification": "оформление или элемент оформления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装饰品",
                                "target_lang_sense_clarification": "用于美化环境的物品"
                            },
                            {
                                "target_lang_word": "装饰",
                                "target_lang_sense_clarification": "起装饰作用的物件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5a0f99fd-5529-39b4-93b0-c1cf0b992025",
                    "sense_definition": "The process or act of adding ornaments or beautifying something.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ornamentation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>decoration</w> of the hall took several days to complete before the wedding.",
                            "target_lang_translations": {
                                "ru": "<w>Украшение</w> зала перед свадьбой заняло несколько дней.",
                                "zh": "婚礼前，大厅的<w>装饰</w>工作花了几天才完成。"
                            }
                        },
                        {
                            "text": "She is very skilled in the <w>decoration</w> of pottery with traditional patterns.",
                            "target_lang_translations": {
                                "ru": "Она очень искусна в <w>декорировании</w> керамики традиционными узорами.",
                                "zh": "她非常擅长用传统图案<w>装饰</w>陶器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ornamentation",
                        "embellishment"
                    ],
                    "common_phrases": [
                        "style of decoration",
                        "method of decoration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс или акт добавления орнаментов или украшения чего-либо.",
                        "zh": "添加装饰或美化某物的过程或行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "украшение",
                                "target_lang_sense_clarification": "процесс придания нарядного вида"
                            },
                            {
                                "target_lang_word": "декорирование",
                                "target_lang_sense_clarification": "процесс художественного оформления"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装饰",
                                "target_lang_sense_clarification": "美化某物的动作或过程"
                            },
                            {
                                "target_lang_word": "装潢",
                                "target_lang_sense_clarification": "对物体或空间进行艺术性修饰"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "29b3052f-bfaf-3c95-936f-500e73451559",
                    "sense_definition": "The work of painting or wallpapering a room or building to improve its appearance.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "renovation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The house is in need of some internal <w>decoration</w> after the leak.",
                            "target_lang_translations": {
                                "ru": "Дому требуется внутренняя <w>отделка</w> после протечки.",
                                "zh": "漏水之后，这栋房子需要进行一些内部<w>装修</w>。"
                            }
                        },
                        {
                            "text": "They hired a professional for the interior <w>decoration</w> of their new office.",
                            "target_lang_translations": {
                                "ru": "Они наняли профессионала для <w>оформления</w> интерьера своего нового офиса.",
                                "zh": "他们聘请了一位专业人士来负责新办公室的室内<w>装潢</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "interior decoration",
                        "home decoration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работы по покраске или оклейке обоями комнаты или здания для улучшения их внешнего вида.",
                        "zh": "通过粉刷或贴壁纸来改善房间或建筑物外观的工作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделка",
                                "target_lang_sense_clarification": "ремонтные работы по оформлению интерьера"
                            },
                            {
                                "target_lang_word": "косметический ремонт",
                                "target_lang_sense_clarification": "обновление внешнего вида помещения"
                            },
                            {
                                "target_lang_word": "декор",
                                "target_lang_sense_clarification": "внутреннее оформление помещения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "装修",
                                "target_lang_sense_clarification": "房屋内部的修缮与美化"
                            },
                            {
                                "target_lang_word": "装潢",
                                "target_lang_sense_clarification": "室内设计与布置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b215e8f-4f29-3380-855c-aa22ed3ed2e4",
                    "sense_definition": "A medal or award given to someone as a mark of honor, especially for bravery in the military.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "honor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldier received a high military <w>decoration</w> for his courage during the battle.",
                            "target_lang_translations": {
                                "ru": "Солдат получил высокую военную <w>награду</w> за мужество в бою.",
                                "zh": "那名士兵因在战斗中的英勇表现而获得了一枚高级军事<w>勋章</w>。"
                            }
                        },
                        {
                            "text": "He proudly wore every <w>decoration</w> he had earned during his long career.",
                            "target_lang_translations": {
                                "ru": "Он с гордостью носил каждый <w>орден</w>, который заслужил за свою долгую карьеру.",
                                "zh": "他自豪地佩戴着他在漫长职业生涯中获得的每一枚<w>勋章</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "military decoration",
                        "highest decoration"
                    ],
                    "target_lang_definitions": {
                        "ru": "Медаль или награда, вручаемая в знак почета, особенно за храбрость в армии.",
                        "zh": "作为荣誉标志授予某人的奖章或奖项，尤指在军事中因英勇表现而获得。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "награда",
                                "target_lang_sense_clarification": "официальный почетный знак"
                            },
                            {
                                "target_lang_word": "орден",
                                "target_lang_sense_clarification": "знак отличия за особые заслуги"
                            },
                            {
                                "target_lang_word": "знак отличия",
                                "target_lang_sense_clarification": "медаль или другой почетный символ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "勋章",
                                "target_lang_sense_clarification": "表彰功绩的荣誉奖章"
                            },
                            {
                                "target_lang_word": "奖章",
                                "target_lang_sense_clarification": "作为奖励颁发的金属徽章"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "202e3ede-de06-33a9-b6f0-1fb7cffa0648",
                    "sense_definition": "The biological process where exotic sugars are used to distract a host's immune system.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pathogen uses surface <w>decoration</w> to evade the host's primary immune response.",
                            "target_lang_translations": {
                                "ru": "Патоген использует <w>декорирование</w> поверхности, чтобы избежать первичного иммунного ответа хозяина.",
                                "zh": "病原体利用表面<w>修饰</w>来逃避宿主的初级免疫反应。"
                            }
                        },
                        {
                            "text": "Researchers studied the molecular <w>decoration</w> of the virus to understand its resistance.",
                            "target_lang_translations": {
                                "ru": "Исследователи изучили молекулярную <w>модификацию</w> вируса, чтобы понять его устойчивость.",
                                "zh": "研究人员通过研究病毒的分子<w>修饰</w>来了解其抗药性。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологический процесс, при котором экзотические сахара используются для отвлечения иммунной системы хозяина.",
                        "zh": "一种生物学过程，即利用外源糖类来干扰宿主免疫系统。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "декорирование",
                                "target_lang_sense_clarification": "молекулярная модификация поверхности"
                            },
                            {
                                "target_lang_word": "модификация",
                                "target_lang_sense_clarification": "изменение структуры поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "修饰",
                                "target_lang_sense_clarification": "生物分子表面的化学改变"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}