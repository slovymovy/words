{
    "word_family": [
        "diner",
        "dinette",
        "dinnerware",
        "dinner-time"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a45408e2-87ca-3ae5-8116-35856d515794",
                    "sense_definition": "The main meal of the day, often eaten in the evening.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I wonder what is for <w>dinner</w> tonight because I am very hungry.",
                            "target_lang_translations": {
                                "ru": "Интересно, что сегодня на <w>ужин</w>, потому что я очень голоден."
                            }
                        },
                        {
                            "text": "We usually <w>cook</w> <w>dinner</w> together as a family after work.",
                            "target_lang_translations": {
                                "ru": "Обычно мы всей семьей вместе <w>готовим</w> <w>ужин</w> после работы."
                            }
                        }
                    ],
                    "synonyms": [
                        "supper",
                        "tea"
                    ],
                    "common_phrases": [
                        "cook dinner",
                        "eat dinner",
                        "for dinner",
                        "ready for dinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основной прием пищи в течение дня, часто принимаемый вечером."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужин",
                                "target_lang_sense_clarification": "вечерний прием пищи"
                            },
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "основной прием пищи, иногда переносимый на вечер"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33b11957-bd94-3d8e-ada1-c372d8c745ef",
                    "sense_definition": "A formal meal for many people eaten for a special occasion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company held a <w>formal</w> <w>dinner</w> to celebrate the successful end of the year.",
                            "target_lang_translations": {
                                "ru": "Компания провела <w>торжественный</w> <w>обед</w>, чтобы отпраздновать успешное завершение года."
                            }
                        },
                        {
                            "text": "My family gathers twice a year, namely at Christmas and Thanksgiving <w>dinners</w>.",
                            "target_lang_translations": {
                                "ru": "Моя семья собирается дважды в год, а именно на рождественский и благодарственный <w>обеды</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "banquet",
                        "feast",
                        "luncheon"
                    ],
                    "common_phrases": [
                        "formal dinner",
                        "charity dinner",
                        "annual dinner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Торжественный прием пищи для большого количества людей, устраиваемый по особому случаю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "банкет",
                                "target_lang_sense_clarification": "торжественный званый обед или ужин"
                            },
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "официальное мероприятие с угощением"
                            },
                            {
                                "target_lang_word": "ужин",
                                "target_lang_sense_clarification": "официальный вечерний прием"
                            },
                            {
                                "target_lang_word": "званый ужин",
                                "target_lang_sense_clarification": "прием гостей с едой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a49e433d-3591-3521-9499-b4e609c1d1ac",
                    "sense_definition": "A midday meal, especially in contexts where the evening meal is called supper or tea.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In some regions, people eat their main <w>dinner</w> at noon and have a light snack later.",
                            "target_lang_translations": {
                                "ru": "В некоторых регионах люди едят свой основной <w>обед</w> в полдень, а позже слегка перекусывают."
                            }
                        },
                        {
                            "text": "The school children were excited to go home for <w>dinner</w> during the long break.",
                            "target_lang_translations": {
                                "ru": "Школьники были рады пойти домой на <w>обед</w> во время большой перемены."
                            }
                        }
                    ],
                    "synonyms": [
                        "lunch",
                        "luncheon"
                    ],
                    "common_phrases": [
                        "sunday dinner",
                        "school dinner"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Common in certain British and rural dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полуденный прием пищи, особенно в контекстах, где вечерняя еда называется supper или tea."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обед",
                                "target_lang_sense_clarification": "основной дневной прием пищи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a858e55d-47b4-38fb-94e6-0e36745c2736",
                    "sense_definition": "A meal given to an animal.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "meal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is time to <w>give</w> the <w>dog</w> its <w>dinner</w> before we go for a walk.",
                            "target_lang_translations": {
                                "ru": "Пора <w>дать</w> <w>собаке</w> её <w>еду</w> перед тем, как мы пойдем на прогулку."
                            }
                        },
                        {
                            "text": "The cat finished its <w>dinner</w> and then fell asleep on the rug.",
                            "target_lang_translations": {
                                "ru": "Кошка доела свой <w>корм</w> и уснула на коврике."
                            }
                        }
                    ],
                    "synonyms": [
                        "chow"
                    ],
                    "common_phrases": [
                        "dog dinner"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used when personifying pets"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Порция еды, выдаваемая животному."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корм",
                                "target_lang_sense_clarification": "пища для животных"
                            },
                            {
                                "target_lang_word": "еда",
                                "target_lang_sense_clarification": "пища, продовольствие"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1b84ff44-3ca3-3793-a8d2-44d933215d91",
                    "sense_definition": "To eat a dinner; to dine.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The workers were <w>dinnering</w> out in the field because they were too far from the camp.",
                            "target_lang_translations": {
                                "ru": "Рабочие <w>обедали</w> прямо в поле, потому что были слишком далеко от лагеря."
                            }
                        },
                        {
                            "text": "We spent the evening <w>dinnering</w> and talking about our future plans.",
                            "target_lang_translations": {
                                "ru": "Мы провели вечер, <w>ужиная</w> и обсуждая наши планы на будущее."
                            }
                        }
                    ],
                    "synonyms": [
                        "dine"
                    ],
                    "common_phrases": [
                        "dinnering out"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обедать или ужинать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обедать",
                                "target_lang_sense_clarification": "принимать основной прием пищи"
                            },
                            {
                                "target_lang_word": "ужинать",
                                "target_lang_sense_clarification": "принимать вечернюю пищу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c8201cbb-3e66-3db1-916f-3abb5de3bc13",
                    "sense_definition": "To provide someone with a dinner; to host someone for a meal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She had <w>dinnered</w> her guests at the finest club in the city.",
                            "target_lang_translations": {
                                "ru": "Она <w>потчевала</w> своих гостей в лучшем клубе города."
                            }
                        },
                        {
                            "text": "The hostess was busy <w>dinnering</w> up every possible partner for her daughters.",
                            "target_lang_translations": {
                                "ru": "Хозяйка была занята тем, что <w>зазывала на обед</w> каждого потенциального партнера для своих дочерей."
                            }
                        }
                    ],
                    "common_phrases": [
                        "dinnering up"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Primarily found in older literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Обеспечивать кого-либо обедом; принимать кого-либо в качестве гостя на трапезу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "угощать обедом",
                                "target_lang_sense_clarification": "принимать гостей"
                            },
                            {
                                "target_lang_word": "потчевать",
                                "target_lang_sense_clarification": "устаревшее, кормить гостя"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}