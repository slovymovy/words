                        "sense_id": "934f312e-b511-34aa-94a6-0ec8a832a4b7",
                        "entry_id": "11455d2c-71be-3086-98b9-975a04fd963d",
                        "glosses": [
                            "mass transit"
                        ],
                        "tags": [
                            "inanimate",
