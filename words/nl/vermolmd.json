                    "sense_definition": "aangetast door houtrot of vergaan",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "vergaan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude schuur was volledig <w>vermolmd</w> en moest worden afgebroken.",
