                                        "sense_id": "53505622-47b3-3573-aa79-e3f8e6248a1e",
                                        "entry_id": "493eb22e-70a9-3291-acf7-79052bad9d2d",
                                        "glosses": [
                                            "An instance of a disease or poor health."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db92e1fd-f07e-4239-a5e2-518fd16d7ee8",
                                                "sense_id": "53505622-47b3-3573-aa79-e3f8e6248a1e",
                                                "text": "Her grandmother had passed away after a long illness."
                                            },
                                            {
                                                "example_id": "07b0e153-ad08-45d1-bb9b-5c6ac3dad5df",
                                                "sense_id": "53505622-47b3-3573-aa79-e3f8e6248a1e",
                                                "text": "suffer form a severe illness"
                                            },
                                            {
                                                "example_id": "b7af7a66-6473-4aef-8aee-43c07193a3b4",
                                                "sense_id": "53505622-47b3-3573-aa79-e3f8e6248a1e",
                                                "text": "a mild illness"
                                            },
                                            {
                                                "example_id": "de975903-6ec2-4e18-aa8d-2e957b46d8ae",
                                                "sense_id": "53505622-47b3-3573-aa79-e3f8e6248a1e",
                                                "text": "This further exacerbated the diagnostic challenge posed by undifferentiated febrile illness during a “twindemic” of both COVID-19 and dengue, as both illnesses could potentially present with febrile syndromes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa02e63f-ecdb-3232-a9f2-daf9bbdc2178",
                                        "entry_id": "493eb22e-70a9-3291-acf7-79052bad9d2d",
                                        "glosses": [
                                            "A state of bad health or disease."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08cd052b-45d8-41ad-87b8-2500759640ac",
                                                "sense_id": "fa02e63f-ecdb-3232-a9f2-daf9bbdc2178",
                                                "text": "Many working days this year have been lost through illness."
                                            },
                                            {
                                                "example_id": "409ba22c-8e60-4d0e-92db-8f87161bdabe",
                                                "sense_id": "fa02e63f-ecdb-3232-a9f2-daf9bbdc2178",
                                                "text": "Illness is a wholistic reality, just as health is wholistic, and healing is the process of moving from illness to health."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
