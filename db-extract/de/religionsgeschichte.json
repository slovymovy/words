                        "sense_id": "e6cf5d30-90d9-3311-a532-09281015c76e",
                        "entry_id": "bea6a58e-e233-3792-a05c-b8aa96206bc3",
                        "glosses": [
                            "Wissenschaft von der Geschichte der Religionen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d8f9f74-50b3-4cb6-a270-276920737ff3",
                                "sense_id": "e6cf5d30-90d9-3311-a532-09281015c76e",
                                "text": "„Aber nicht nur die Christen standen auf Fett. Wenn Sie in der Religionsgeschichte weiter zurückgehen, etwa in die frühe biblische Phase, stoßen Sie auf äußerst interessante Sachen. Lesen Sie die Geschichten über den biblischen König Salomo, einen berühmten Frauenheld mit gut 1.000 Liebhaberinnen, und Sie werden sehen, dass keine dieser Frauen dünn war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "00a50038-90cc-3e9c-8b20-fb74b9b561fa",
                        "entry_id": "bea6a58e-e233-3792-a05c-b8aa96206bc3",
                        "glosses": [
                            "Wissenschaftliches Werk, das die Geschichte der Religionen thematisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0ad97237-5763-4783-9484-099557f5f4f2",
                                "sense_id": "00a50038-90cc-3e9c-8b20-fb74b9b561fa",
                                "text": "„Hubert Canciks einschlägige Aufsätze liegen jetzt in zwei Bänden vor, die die programmatischen Titel «Römische Religion im Kontext» und «Religionsgeschichten» tragen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
