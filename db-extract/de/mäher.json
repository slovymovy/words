                            {
                                "example_id": "76b60572-8878-4435-8f89-b9e5341500fd",
                                "sense_id": "5b2e0c07-34d6-35ed-b47b-579a61e6e0df",
                                "text": "Wir haben zehn verschiedene automatische Mäher getestet."
                            },
