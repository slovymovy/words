                        "examples": [
                            {
                                "example_id": "e3db2e64-fe4e-48d5-b3df-9d9c63c3dcc3",
                                "sense_id": "1fe29f2d-512d-3dbe-af15-fb7ee7804807",
                                "text": "Ben, il reneigeotte aussi…"
                            },
                            {
                                "example_id": "bab30c9f-305c-4f41-9717-fbc5f3a66d16",
                                "sense_id": "1fe29f2d-512d-3dbe-af15-fb7ee7804807",
                                "text": "De plus cela reneigeotte et cela rendra notre route vers Montélimar (pour choisir le matériel de bains et de cuisine) plus patiente."
                            },
                            {
                                "example_id": "d2ea9515-79b5-4121-ad62-1012a6b7503c",
                                "sense_id": "1fe29f2d-512d-3dbe-af15-fb7ee7804807",
                                "text": "Il reneigeotte ce soir, je suis passée aux travaux pratiques : rouler sur la neige, glisser sur le verglas, éviter les fossés."
                            }
                        ]
                    }
