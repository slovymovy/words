        "fr-extract.jsonl": [
            {
                "entry_id": "3b1bf3dc-ee98-3b1e-af40-4742108e3601",
                "word": "squamous",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b415a695-5118-4ca5-b21e-a09fc5c1f7c4",
                        "entry_id": "3b1bf3dc-ee98-3b1e-af40-4742108e3601",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more squamous"
                    },
                    {
                        "form_id": "33f3a70f-39f4-42e6-8732-52c436588552",
                        "entry_id": "3b1bf3dc-ee98-3b1e-af40-4742108e3601",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most squamous"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2e15ae08-372f-3a71-93a8-1202d5fd18ed",
                        "entry_id": "3b1bf3dc-ee98-3b1e-af40-4742108e3601",
                        "glosses": [
                            "Squameux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "221edea7-c0cf-4d2f-b747-48b77d8d992e",
                                "sense_id": "2e15ae08-372f-3a71-93a8-1202d5fd18ed",
                                "text": "In the squamous heads of Scabius, Knapweed, and the elegant Jacea Pinea, and in the Scaly composure of the Oak-Rose, which some years most aboundeth."
                            },
                            {
                                "example_id": "028cc1ba-baa5-40c6-b55a-06ace990cb1b",
                                "sense_id": "2e15ae08-372f-3a71-93a8-1202d5fd18ed",
                                "text": "I might call it gigantic - tentacled - proboscidian - octopus-eyed - semi-amorphous - plastic - partly squamous and partly rugose - ugh!"
                            },
                            {
                                "example_id": "debd4e9c-bf66-4151-9c85-b6614f3efb94",
                                "sense_id": "2e15ae08-372f-3a71-93a8-1202d5fd18ed",
                                "text": "We spread the papers on the least squamous section of the floor and lay down; the smell was not so bad at ground level."
                            },
                            {
                                "example_id": "e8b3fae2-4e69-44e6-85c0-9e07338533e7",
                                "sense_id": "2e15ae08-372f-3a71-93a8-1202d5fd18ed",
                                "text": "(And we’ll never find out whether the last thought to pass through the mind of the captain of the Thresher was, \"It’s squamous and rugose,\" or simply, \"It’s squamous!\")"
                            }
                        ]
                    },
                    {
                        "sense_id": "e914b414-06dc-3ee7-82e4-f8aa512da764",
                        "entry_id": "3b1bf3dc-ee98-3b1e-af40-4742108e3601",
                        "glosses": [
                            "Relatif à l’os squamosal."
                        ],
                        "tags": [],
                        "examples": []
                    }
