                                "target_senses": [
                                    {
                                        "sense_id": "70a4a9b5-5dc7-327f-9ee9-f1b11ef99195",
                                        "entry_id": "79da556f-5f5e-39d1-be39-01dad3af7daa",
                                        "glosses": [
                                            "A romantic quality, spirit or action."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d801f9cf-8dbe-4626-9570-ef146f901d4d",
                                                "sense_id": "70a4a9b5-5dc7-327f-9ee9-f1b11ef99195",
                                                "text": "Sure, maybe. We know — have long known — that romanticism and fatalism are dialectical lovers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
