{
    "word_family": [
        "mariage",
        "mariable",
        "remarier",
        "remariage",
        "démarier",
        "marieur",
        "marieuse"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70b71abf-a995-30df-a35f-fd56997cea59",
                    "sense_definition": "Se marier : contracter un mariage, devenir l'époux ou l'épouse de quelqu'un lors d'une cérémonie civile ou religieuse.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mariage_union_conjugale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ma voisine va se <w>marier</w> demain."
                        },
                        {
                            "text": "Ils veulent se <w>marier</w> à la mairie au mois de juin."
                        },
                        {
                            "text": "Quand vous <w>marierez</w>-vous ? Avez-vous déjà choisi une date ?"
                        }
                    ],
                    "synonyms": [
                        "se dire oui",
                        "faire une fin"
                    ],
                    "common_phrases": [
                        "se marier à la mairie",
                        "se marier en blanc",
                        "se marier civilement",
                        "se marier religieusement"
                    ]
                },
                {
                    "sense_id": "3b748d1c-6e35-34b7-abe2-508f57c5c660",
                    "sense_definition": "Unir deux personnes par le mariage, en tant que maire ou ministre du culte, selon la loi ou la religion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mariage_union_conjugale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le maire <w>marie</w> le couple devant tous les invités."
                        },
                        {
                            "text": "Le prêtre a <w>marié</w> les jeunes gens dans la petite chapelle du village."
                        }
                    ],
                    "common_phrases": [
                        "marier un couple",
                        "marier les futurs époux"
                    ]
                },
                {
                    "sense_id": "24e07618-f6c3-326d-b825-f51b33535890",
                    "sense_definition": "Arranger le mariage de quelqu'un, notamment de ses enfants, ou le donner en mariage.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mariage_union_conjugale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ils ont <w>marié</w> leur fille à un riche commerçant du village."
                        },
                        {
                            "text": "Autrefois, les parents <w>mariaient</w> leurs enfants sans leur demander leur avis."
                        }
                    ],
                    "common_phrases": [
                        "marier sa fille",
                        "marier son fils",
                        "marier ses enfants"
                    ]
                },
                {
                    "sense_id": "564c4b88-83c1-3311-b12c-b2bf5fbbb210",
                    "sense_definition": "Épouser quelqu'un (emploi transitif direct, hors du sens habituel de « se marier »).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "mariage_union_conjugale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son oncle a <w>marié</w> une jeune fille du village voisin."
                        },
                        {
                            "text": "Il a <w>marié</w> la fille du boulanger il y a dix ans."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "emploi transitif direct surtout attesté au Québec et en français populaire"
                        }
                    ]
                },
                {
                    "sense_id": "4990597b-95e3-3262-9f5c-31f991d2fc34",
                    "sense_definition": "Assortir harmonieusement des couleurs, des saveurs, des sonorités, des odeurs ou des textures.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "assemblage_association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La décoratrice <w>marie</w> habilement le bleu et le jaune dans cette chambre."
                        },
                        {
                            "text": "Ce cuisinier <w>marie</w> les saveurs sucrées et salées dans tous ses plats."
                        }
                    ],
                    "common_phrases": [
                        "marier les couleurs",
                        "marier les saveurs",
                        "marier les textures"
                    ]
                },
                {
                    "sense_id": "d0206d80-223c-3781-b78c-1c12663c5a3e",
                    "sense_definition": "Joindre ou associer deux choses matérielles ou deux éléments abstraits pour former un ensemble.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "assemblage_association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce chef sait <w>marier</w> tradition et modernité dans ses recettes."
                        },
                        {
                            "text": "Cet architecte <w>marie</w> le bois et le verre avec beaucoup d'élégance."
                        }
                    ],
                    "common_phrases": [
                        "marier tradition et modernité"
                    ]
                },
                {
                    "sense_id": "42126725-8187-3c69-a26f-9eec15e4a12e",
                    "sense_definition": "Réunir ou rassembler des personnes, souvent par le hasard ou le sort.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "assemblage_association",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le hasard nous a <w>mariés</w> à la même table pour le dîner."
                        },
                        {
                            "text": "Depuis deux heures, le sort nous <w>marie</w> dans cette étrange aventure."
                        }
                    ]
                }
            ]
        }
    ]
}