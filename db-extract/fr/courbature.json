        "fr-extract.jsonl": [
            {
                "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                "word": "courbature",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c0e88d31-c631-43e7-b18e-8569eda84aa4",
                        "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "tags": [
                            "plural"
                        ],
                        "form": "courbatures"
                    },
                    {
                        "form_id": "9cc1ef14-374b-4584-828c-0e50b08022b1",
                        "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "tags": [
                            "orthographe rectifiée de 1990"
                        ],
                        "form": "courbatture"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "69e83a90-0e1f-3200-8eaf-932b74abdfc4",
                        "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "glosses": [
                            "Lassitude extrême du corps et surtout des jambes provoquée par la fatigue, la maladie ou l’excès de sport."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19250ba7-a8ef-4eb3-a67b-b9dab679469b",
                                "sense_id": "69e83a90-0e1f-3200-8eaf-932b74abdfc4",
                                "text": "Le lendemain, c'est la roupillade prolongée, la courbature au réveil, l'impossibilité de besogner utilement."
                            }
                        ]
                    },
                    {
                        "sense_id": "fc9968f4-72be-33f8-bdf0-1f4e11aa83cd",
                        "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "glosses": [
                            "Douleurs musculaires sans gravité, consécutives à un effort physique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "924205b3-14a8-4a77-adae-016e59d42b44",
                                "sense_id": "fc9968f4-72be-33f8-bdf0-1f4e11aa83cd",
                                "text": "Elle se leva, étira la courbature de ses épaules, et toisa son mari."
                            }
                        ]
                    },
                    {
                        "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                        "entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "glosses": [
                            "Lassitude de l'esprit."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "44b712ad-9604-444e-989c-6f9b488fb9cc",
                                "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                                "text": "Nous étions secoués comme ces souris que l’on ballotte pour les étourdir et les tuer contre les parois de la souricière, et il fallait toute la sévère beauté du paysage pour ne pas nous laisser aller à la mélancolie et à la courbature."
                            },
                            {
                                "example_id": "a74a82a9-1c4f-40b8-88ad-60adf1a870b5",
                                "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                                "text": "Quelques lignes d’écriture avaient apaisé son âme, nourrie d’images, moins sensible aux choses qu’aux signes des choses. Mais il lui restait au cœur une courbature."
                            },
                            {
                                "example_id": "d43adf04-2131-4f15-bab9-cacb0c694f62",
                                "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                                "text": "Mais quelle courbature que d’avoir ainsi joué le rôle de monsieur gosse jusque dans un âge avancé, que d’avoir distribué à la ronde tant de verres de guimauve et de coquelicot !"
                            },
                            {
                                "example_id": "4ea662b8-87a3-4509-a066-594595c90b9c",
                                "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                                "text": "Je gagnai la hutte-salle de bain. Mais ni l’eau chaude ni l’eau froide ne purent, comme elles le faisaient à l’ordinaire, détendre mes muscles ni mon humeur. La courbature était d’ordre moral. Tout m’irritait et particulièrement moi-même."
                            },
                            {
                                "example_id": "c8c4ec51-0433-42a0-b6f2-d7ce9e673a1a",
                                "sense_id": "d34ccfff-27fd-3f22-881d-6878a64e00a5",
                                "text": "Ils sont enfoncés dans un de ces immenses débats métaphysiques qui ne laissent derrière eux qu’une courbature de l’esprit et le sentiment d’une ardeur retombée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "92d0e59c-693e-42bc-b6ff-5be8ce2be82c",
                        "source_entry_id": "f69d4bd1-f889-3226-96b1-cc8bfad353a0",
                        "source_sense_description": "Douleurs musculaires",
                        "target_lang_word": "Muskelkater",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muskelkater",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                        "entry_id": "50f9d6c3-5e7a-380e-8db5-aba5f1eed6e7",
                                        "glosses": [
                                            "vorübergehende Schmerzen in den Muskeln, die, nach (ungewohnter) körperlicher Anstrengung, durch zur Verhärtung des Muskelgewebes führende kleine Risse in Teilen der Muskelfasern sowie nachfolgender Bildung lokaler Ödeme entstehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca716bbc-5dc8-4182-96c0-0f63504bd2fa",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "Ich habe einen Muskelkater vom Joggen."
                                            },
                                            {
                                                "example_id": "86711619-64bc-41fa-ac43-d56011341c15",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Früher war ich viel geritten, und deswegen wußte ich, daß ich morgen einen gehörigen Muskelkater haben würde, und noch mehr Michael, der vorher kaum jemals auf einem Pferd gesessen hatte.“"
                                            },
                                            {
                                                "example_id": "889197c6-7380-4e5a-9bbe-605c53d44ec0",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Die Tage zuvor und der Weg hinauf freilich waren, wenn schon nicht mit Steinen gepflastert, so doch mit Bauch-, Becken- und Steißlandungen, Kniefällen und Rutschpartien, Schnee-Pflugscharen und Muskelkatern prächtig ausgefüllt.“"
                                            },
                                            {
                                                "example_id": "d35b1e09-4d6b-4b70-ad0a-713870dd71f3",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Die Ost-Berliner Meldestellen-Leiterin Sigrid Exner (am Telefon) erholte sich gestern vom Visa-Stempeln. ‚Wir haben einen richtigen Muskelkater‘ sagt sie, ‚viele bedankten sich für das Visum mit Blumen oder einem Kuß‘.“"
                                            },
                                            {
                                                "example_id": "ee3d3d19-0bf3-4fee-ac4c-99d9eb36019d",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Die Muskeln an Waden und Oberschenkeln taten ihr weh, ein Muskelkater, ganz normal nach solch langen Fußmärschen, trotzdem fühlte sie sich, wenigstens in diesem Moment, seltsam gelassen.“"
                                            },
                                            {
                                                "example_id": "6801f44a-278b-4533-b1b3-814f51019935",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Die Ursachen des Muskelkaters sind sehr wohl erforscht.“"
                                            },
                                            {
                                                "example_id": "12894455-4c5e-498e-9b7f-c79fd84507ff",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Die abendlichen Wanderungen hatten mir einen ordentlichen Muskelkater beschert, und so war ich heilfroh, dass ich zu meinem Abendessen mit Ton nicht auch noch radeln musste.“"
                                            },
                                            {
                                                "example_id": "6265cc56-0201-47b7-8d17-52c4f1ccfbe4",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Da waren sie also, die Folgen meiner ersten Kilometer, ein ordentlicher Muskelkater.“"
                                            },
                                            {
                                                "example_id": "9769afb7-636f-435e-973d-b9e419b70a07",
                                                "sense_id": "9affc0c3-e088-35cb-a7e9-5a2339c40736",
                                                "text": "„Du hast danach Muskelkater an Stellen, von denen du gar nicht wusstest, dass du da Muskeln hast.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
