                ],
                "senses": [
                    {
                        "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                        "entry_id": "fc30b4d2-fee0-3aa0-ac9d-efe59176c913",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3563967-19e4-407a-aa2e-cd50daa15427",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Frau Büren ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "524fb637-2d5c-41aa-acc6-2d86effb1c8c",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Herr Büren wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "eb684a4c-90f7-4d86-a4bf-2dc2ec0e8da8",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Die Bürens fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "9cc98136-5886-428e-b789-a37a1240ba04",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Der Büren trägt nie die Schals, die die Büren ihm strickt."
                            },
                            {
                                "example_id": "20b55a3c-c554-4ebf-ac5e-9107bd12ef1c",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Büren kommt, geht der Herr Büren.“"
                            },
                            {
                                "example_id": "720a0341-0eca-4e4a-9de1-15516c11595c",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Büren kommt und geht."
                            },
                            {
                                "example_id": "964ab650-82d7-49ca-bf23-a07f2526e217",
                                "sense_id": "84cafa22-fa05-3453-a071-fc8c10bc0058",
                                "text": "Bürens kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
