                    },
                    {
                        "translation_id": "5748d1f8-7576-47bf-9cd9-d43f91b5998d",
                        "source_entry_id": "3cda6661-eac3-3839-a83b-08f6dc2cefcb",
                        "source_sense_id": "f92a24c9-4cd7-3c15-a253-ac3d7ff5b028",
                        "source_sense_description": "spanning, geestelijke druk.",
                        "target_lang_word": "stress",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stress",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d1e9cf20-46de-3829-825c-4643c63ae863",
                                        "entry_id": "154ca7ea-936e-31bc-bd59-4e83fabf1322",
                                        "glosses": [
                                            "Tension exercée sur un matériau."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "00fa9b00-f2ce-4d6d-a6e1-dd545076ed2e",
                                                "sense_id": "d1e9cf20-46de-3829-825c-4643c63ae863",
                                                "text": "Il fallait consacrer plus de temps à l'évolution du concept de stress, emprunté au vocabulaire des ingénieurs, transformé en psycho-pop. … Quand le métal est soumis à un stress (poids, chaleur ou fatigue), sa résistance tient jusqu'à un certain coefficient. Le stress du matérialisme occidental va bientôt faire sauter le cadenas politique socialiste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fb23e363-a98c-3a43-9084-b21cf97af651",
                                        "entry_id": "154ca7ea-936e-31bc-bd59-4e83fabf1322",
                                        "glosses": [
                                            "Réaction à une agression par un agent extérieur, dont l’intensité dépend à la fois des facteurs internes à l’entité stressée (capacité d’interprétation d’un élément comme stressant) et externes à l’entité stressée (les caractéristiques des agents extérieurs)."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e89b109-22bf-4217-98e6-d5451e0ab71e",
                                                "sense_id": "fb23e363-a98c-3a43-9084-b21cf97af651",
                                                "text": "Le syndrome général d’adaptation dit Hans Selye, le théoricien du Stress, passe par trois phases : la réaction d’alarme, le stade de résistance, le stade de l’épuisement."
                                            },
                                            {
                                                "example_id": "d5b469a3-21e8-4639-97e4-30d244b4bbf9",
                                                "sense_id": "fb23e363-a98c-3a43-9084-b21cf97af651",
                                                "text": "L'aération de l'eau peut être maintenue au moyen de bulleurs. Il est conseillé de placer les bulleurs à des endroits où ils n'entraînent pas de stress excessif chez les têtards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d6e2a2d0-93d7-30da-8dbb-be9ca7c6a392",
                                        "entry_id": "154ca7ea-936e-31bc-bd59-4e83fabf1322",
                                        "glosses": [
                                            "Sentiment de tension continue causée par une situation inconfortable plus ou moins intense."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03d5b62a-1ffc-404b-8b29-5485a549db7b",
                                                "sense_id": "d6e2a2d0-93d7-30da-8dbb-be9ca7c6a392",
                                                "text": "… ce qu'on appelle le stress, cette guerre d'usure microscophique, faite de contrariétés, de menus soucis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c60b3a6-53ee-3532-b6b1-8761660d8c94",
                                        "entry_id": "154ca7ea-936e-31bc-bd59-4e83fabf1322",
                                        "glosses": [
                                            "L’agression en elle-même."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "93f6f6cd-19b2-39c7-bbb8-4ee3768cce09",
                                        "entry_id": "154ca7ea-936e-31bc-bd59-4e83fabf1322",
                                        "glosses": [
                                            "État d’une plante ou d’une culture lorsque l’un des facteurs de sa croissance (eau, engrais, chaleur, etc.) vient à manquer."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4786a01c-4708-4503-a0f2-975a64098ac0",
                                                "sense_id": "93f6f6cd-19b2-39c7-bbb8-4ee3768cce09",
                                                "text": "Le desmédiphame peut causer un retard de croissance temporaire et/ou la chlorose ou la brûlure de la pointe des feuilles de la betterave à sucre lorsqu’on l’applique sur des plants soumis à un stress. La croissance normale reprend 10 jours après le traitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
