                "senses": [
                    {
                        "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                        "entry_id": "8ac25495-5de1-374f-bdfa-304c8df5b27b",
                        "glosses": [
                            "Öffnung, durch die Luft austreten, entweichen kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "05ca109f-79c1-439e-9c00-261a7133ceff",
                                "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                                "text": "„Im Allgemeinen bedeutet ein austauschendes Lüftungssystem mit einer geringen Geschwindigkeit des Luftstroms und dem Lüftungsauslass in Bodennähe eine geringere Deckenverschmutzung als ein umwälzendes System mit dem Lüftungsauslass in Deckennähe.“"
                            },
                            {
                                "example_id": "5553ecc2-8a52-4d23-95b7-6b54c1bf8fe5",
                                "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                                "text": "„Mit einem Lüftungsauslass in der Fensterleibung lassen sich auch höchste architektonische Ansprüche erfüllen.“"
                            },
                            {
                                "example_id": "39eb7a44-e52d-4489-a8f6-d68ba92bde37",
                                "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                                "text": "„Die fachgerechte Reinigung der Deckenleuchten sowie der Lüftungsauslässe runden das komplette Service ab.“"
                            },
                            {
                                "example_id": "fa38a297-2133-446c-bb99-b5f68dd5dc44",
                                "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                                "text": "„Andernfalls hätten die Lüftungsauslässe die Geometrie des Tonnendaches optisch gestört.“"
                            },
                            {
                                "example_id": "1d1c4b60-c88f-451f-a4d7-e03c97df1ae3",
                                "sense_id": "0ffa9c17-88f6-3c7e-a9d0-ff661f68057e",
                                "text": "„Das Messen von Luftströmungen und die richtige Berechnung des Volumenstroms an Lüftungsauslässen können eine Herausforderung sein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
