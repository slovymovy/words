                "senses": [
                    {
                        "sense_id": "b2449bdd-284e-3886-9e6b-d8882b570911",
                        "entry_id": "b27f6fd4-0945-3bad-aba8-91847efcd94a",
                        "glosses": [
                            "literarische Figur, deren Name im Titel des Werks enthalten ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d55f108e-f706-42ab-8451-1eeae467ddb0",
                                "sense_id": "b2449bdd-284e-3886-9e6b-d8882b570911",
                                "text": "„Die Titelfigur des Drachen in dem gleichnamigen Stück kann ihre Gestalt zwischen Tier- und Menschenform changieren lassen […].“"
                            },
                            {
                                "example_id": "c31d8696-ec86-4f5f-87ed-f4b0ee278397",
                                "sense_id": "b2449bdd-284e-3886-9e6b-d8882b570911",
                                "text": "„Durch die kindgerechte Gestaltung und viele Illustrationen soll den Kindern ein anregendes und lustbetontes Lernen ermöglicht werden. Dabei begleitet die Titelfigur des kleinen Monsters durch das ganze Buch.“"
                            },
                            {
                                "example_id": "576b96b6-48b3-4cab-9bcb-83d55be5a64f",
                                "sense_id": "b2449bdd-284e-3886-9e6b-d8882b570911",
                                "text": "„Das Gespräch mit Puto zeigt deutlich, dass eine innere Veränderung bei der Titelfigur im Gang ist und dass er seinen früheren Beruf als Soldat einfach ironisiert: Der Kriegsruhm wird aus seiner Sicht als etwas Unsinniges angesehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
