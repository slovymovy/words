                    {
                        "sense_id": "cedd8cf0-483a-3c83-89eb-c19e7cff3b63",
                        "entry_id": "0770b1ac-c56a-3cf6-811e-ed14d1e9e3ba",
                        "glosses": [
                            "(männliche^☆) Person, die beruflich Filme vorführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fe1be6c0-f1e9-4c1f-89c4-6a52563ba38a",
                                "sense_id": "cedd8cf0-483a-3c83-89eb-c19e7cff3b63",
                                "text": "„Neben dem Zusammen- und Auseinanderbauen der Filme, der Bedienung und Kontrolle des Filmprojektors sind Filmvorführer auch für die Wartung verantwortlich und für kleinere Reparaturen.“"
                            },
                            {
                                "example_id": "73b70b10-348f-43f8-9266-5680630d543e",
                                "sense_id": "cedd8cf0-483a-3c83-89eb-c19e7cff3b63",
                                "text": "„Tyler arbeitete aushilfsweise als Filmvorführer.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
