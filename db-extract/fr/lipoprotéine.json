                "entry_id": "330669bb-8427-38b5-a3ed-f988752f7c1e",
                "word": "lipoprotéine",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e73f16ee-6c0f-4949-bc86-13f4ad922975",
                        "entry_id": "330669bb-8427-38b5-a3ed-f988752f7c1e",
                        "tags": [
