                "senses": [
                    {
                        "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                        "entry_id": "b8962358-2558-3e7b-a378-2ccaedbec8b3",
                        "glosses": [
                            "An artillery soldier who maintains and operates (historical) a cannon, or (now) some other piece of heavy artillery."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "320e0503-1030-4614-a18b-a85edea1b095",
                                "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                                "text": "Luckily, the cannoneer was only mildly injured when his cannon malfunctioned."
                            },
                            {
                                "example_id": "1afcd991-2d1c-465b-be42-52c7aa49b620",
                                "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                                "text": "Then ſe the bringing of our ordinance / Along the trench into the battery, / VVhere vve vvil haue gabions of ſix foot broad / To ſaue our Cannoniers from muſket ſhot, […]"
                            },
                            {
                                "example_id": "5357f2b2-9532-4909-8673-a13bcf03ec53",
                                "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                                "text": "The Irish cannoneers stood gallantly to their pieces till they were cut down to a man."
                            },
                            {
                                "example_id": "5f0530cd-04db-4839-8eee-7412dc6a2f45",
                                "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                                "text": "Just as the spring came laughing through the strife / With all its gorgeous cheer; / In the bright April of historic life / Fell the great cannoneer."
                            },
                            {
                                "example_id": "28596fa3-b3d7-43bb-946f-e90d9579c54c",
                                "sense_id": "3ea4ae29-206d-3345-9837-c5e49887a944",
                                "text": "The American cannoneers, normally positioned well behind the front lines, found themselves unexpectedly thrust into a firefight. The cannoneers slammed shell after shell at the big German tanks, but the 105mm high-explosive rounds burst with little effect."
                            }
                        ]
                    }
