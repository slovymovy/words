                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fe915c8-c6cc-46b9-a579-93f227bb0017",
                                                "sense_id": "f14be6ec-6b40-3114-b8cd-52f381360fc7",
                                                "text": "Bitte, gern geschehen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8f4908f0-b930-3475-8da5-f76628ec0629",
                                        "entry_id": "5d125fe8-c482-302c-a76e-91fc5e9f4ff1",
                                        "glosses": [
                                            "Aufforderung zum Eintreten"
                                        ],
                                        "tags": [],
                                        "examples": [
