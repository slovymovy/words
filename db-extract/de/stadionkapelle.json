                "senses": [
                    {
                        "sense_id": "c5fcad84-ff8b-360a-b10a-7cae22ef51d0",
                        "entry_id": "415f9497-4a6e-3a7b-9c08-9e05a601d830",
                        "glosses": [
                            "einfach gestaltetes Gotteshaus oder abgeteilter Bereich in einer Arena, der für persönliche Andachten oder auch Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436b5cba-61fd-4c5f-9cbe-d5744885e28a",
                                "sense_id": "c5fcad84-ff8b-360a-b10a-7cae22ef51d0",
                                "text": "„Der 57-Jährige ist Pfarrer der Stadionkapelle in der Arena in Frankfurt.“"
                            },
                            {
                                "example_id": "4009631c-e7eb-4397-9a87-0d8800882843",
                                "sense_id": "c5fcad84-ff8b-360a-b10a-7cae22ef51d0",
                                "text": "„Über das wachsende Interesse an der Arbeit in der Stadionkapelle aus der Fangemeinde der Eintracht und unter sportbegeisterten Eltern freut sich Stadionpfarrer Eugen Eckert.“"
                            },
                            {
                                "example_id": "e8975d74-9e23-435c-a101-288563997d61",
                                "sense_id": "c5fcad84-ff8b-360a-b10a-7cae22ef51d0",
                                "text": "„Im fünften Teil der Serie zeigen wir euch, was an Heimspieltagen in der Stadionkapelle passiert.“"
                            },
                            {
                                "example_id": "9570f226-fcad-4ba6-b3a5-f9412d814102",
                                "sense_id": "c5fcad84-ff8b-360a-b10a-7cae22ef51d0",
                                "text": "„Die einen protestantisch, die anderen katholisch - es handelt sich um eine ökumenische Stadionkapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
