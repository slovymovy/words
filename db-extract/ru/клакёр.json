                                    {
                                        "sense_id": "9378c865-e332-3817-a44a-181d25717891",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "One who claps; a person who applauds by clapping the hands."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6aaf28f0-f42f-374d-95fe-ec7dd2b21a6d",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "An object so suspended inside a bell that it may hit the bell and cause it to ring; a clanger or tongue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7ce89826-a8eb-3cc1-b2c3-b5bab0a7712d",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "A wooden mechanical device used as a scarecrow; bird-scaring rattle, a wind-rattle or a wind-clapper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c7c5fc5a-f8f5-42c1-ba5e-c686ca914997",
                                                "sense_id": "7ce89826-a8eb-3cc1-b2c3-b5bab0a7712d",
                                                "text": "\"Sir, sir! folks' tongues go like the clappers in the fields to drive away the blackbirds. A very little wind makes 'em rattle wonderfully.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97341a73-91a2-3c47-afe9-bce5c19483d7",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "A clapstick (musical instrument)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2499e5d2-2953-380e-ad6b-6a0c5c0622b8",
                                        "entry_id": "8685ab7b-1a83-32dc-9ba8-7a56e62ac2b5",
                                        "glosses": [
                                            "A pounding block."
