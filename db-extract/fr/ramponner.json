                ],
                "senses": [
                    {
                        "sense_id": "8f17f250-7385-3ec9-9a3e-cbe36cd194a7",
                        "entry_id": "0c9cf90d-53c9-3df9-9d47-0b2be78075cc",
                        "glosses": [
                            "Donner des ramponeaux, des coups."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "571312be-022e-4b17-b3b5-e8766fcb23fe",
                                "sense_id": "8f17f250-7385-3ec9-9a3e-cbe36cd194a7",
                                "text": "Je le ramponne par terre…"
                            },
                            {
                                "example_id": "bc1d4f5c-fbd3-4f33-9d6a-7c344a208262",
                                "sense_id": "8f17f250-7385-3ec9-9a3e-cbe36cd194a7",
                                "text": "J’ai l’impression de m’être fait ramponner le bidon par une douzaine de quidams irrités."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e42fa6c-0cb6-389f-88f3-4b9891b0dd28",
                        "entry_id": "0c9cf90d-53c9-3df9-9d47-0b2be78075cc",
                        "glosses": [
                            "Se moquer. ^([1])"
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "161737a7-a772-3090-b234-9a42274142ac",
                        "entry_id": "0c9cf90d-53c9-3df9-9d47-0b2be78075cc",
                        "glosses": [
                            "Boire de l'alcool avec excès."
                        ],
                        "tags": [
                            "obsolete",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "06c2ce14-13f4-4721-a1a7-dac400972b51",
                                "sense_id": "161737a7-a772-3090-b234-9a42274142ac",
                                "text": "Les guinguettes parisiennes se situent surtout proches des faubourgs populaires, aux Pocherons, à la Nouvelle-France, à Vaugirard et à la Cortille, fief du père Ramponneau, dont la réputation est si grande, selon Louis-Sébastien Mercier, que le verbe ramponner a été inventer pour marquer le fait de boire à la guinguette hors de la ville, et un peu plus qu'il ne faut."
                            }
                        ]
                    },
                    {
                        "sense_id": "ad42c9a4-7128-3bdc-ba20-1ad84c5ffdd6",
                        "entry_id": "0c9cf90d-53c9-3df9-9d47-0b2be78075cc",
                        "glosses": [
                            "Entrer en contact, en parlant d'éléments."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dca8bd5e-2238-45cb-aba0-9320c32aff1b",
                                "sense_id": "ad42c9a4-7128-3bdc-ba20-1ad84c5ffdd6",
                                "text": "La bielle ramponne le carter."
                            }
                        ]
                    }
