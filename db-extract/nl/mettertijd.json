                    },
                    {
                        "translation_id": "34fd73a8-84d5-4f8b-9b14-5af4e5439b79",
                        "source_entry_id": "a03dca77-01af-3f1b-bbd1-45f28dd2cb97",
                        "source_sense_id": "5c56b443-70c1-3807-9f8e-7d749bc0b471",
                        "source_sense_description": "na verloop van (een zekere) tijd",
                        "target_lang_word": "à la longue",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à la longue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                        "entry_id": "f3c474e8-0387-3ce8-a938-cfd1fa8e3cdc",
                                        "glosses": [
                                            "Avec le temps."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fab0a27b-0427-4ddf-8c60-37ab9ecb9919",
                                                "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                                "text": "S’assoupissant à la longue, elle glissait dans la chute molle et insinuante du premier sommeil, quand un bruit la réveilla en sursaut."
                                            },
                                            {
                                                "example_id": "d7bd90d8-980d-4c6b-a8f2-826de4993ed9",
                                                "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                                "text": "Mais, à la longue, elle se vit contrainte de renoncer à ses méthodes iniques, parce trop d'enquêtes s'étaient tournées à sa confusion […]."
                                            },
                                            {
                                                "example_id": "5016a064-5e8e-4c08-880b-39e9e7a083f0",
                                                "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                                "text": "Dolosal et palfium sont épileptogènes à la longue, comme tous les stupéfiants."
                                            },
                                            {
                                                "example_id": "f790a998-9ec5-4f79-ae9c-40fddcc572c5",
                                                "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                                "text": "Oh, tu sais, ce n'est qu'une des innombrables révolutions qui secouent l'île depuis tant d'années! On s'habitue, à la longue..."
                                            },
                                            {
                                                "example_id": "fabfbb63-2703-4532-b3a3-cb90116f1352",
                                                "sense_id": "cc22acb5-b147-3063-bd90-986670957bd5",
                                                "text": "Je remarquai qu’à la longue les corrections de Mrs Dubose se faisaient plus rares, qu’à un moment Jem avait même laissé une phrase en suspens. Elle n’écoutait plus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
