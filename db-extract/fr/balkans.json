                "senses": [
                    {
                        "sense_id": "f569e98b-3e4a-39eb-9413-bf0fbee151e9",
                        "entry_id": "0f44e0b6-655e-3d89-a652-f059bb9104d7",
                        "glosses": [
                            "Territoires situés en Europe, au sud du Danube et au nord de la mer Méditerranée, comprenant l’Albanie, la Bosnie-Herzégovine, la Bulgarie, la Croatie, la Grèce, le Kosovo, la Macédoine du Nord, la Serbie et la Turquie européenne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9804002-9eb1-4442-8742-53e900eabdd7",
                                "sense_id": "f569e98b-3e4a-39eb-9413-bf0fbee151e9",
                                "text": "On cite Picea Omorica, largement répandu en Europe avant les glaciations et maintenant localisé aux Balkans en stations restreintes."
                            }
                        ]
                    },
                    {
                        "sense_id": "5786ab8f-75e8-353c-995a-dd3745a13cb1",
                        "entry_id": "0f44e0b6-655e-3d89-a652-f059bb9104d7",
                        "glosses": [
                            "Régions précédentes incluant aussi la Roumanie et la Slovénie."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a709864e-3e5a-415c-8724-950b57098597",
                        "source_entry_id": "0f44e0b6-655e-3d89-a652-f059bb9104d7",
                        "target_lang_word": "Balkan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Balkan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                        "entry_id": "d4561737-ad85-3ca7-b9b9-b1ca07603203",
                                        "glosses": [
                                            "geografisch unterschiedlich definierte Region im Südosten Europas"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ec867d23-2028-4dcf-9270-a5507a517fc0",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "Auf dem Balkan ist immer noch kein Friede eingekehrt."
                                            },
                                            {
                                                "example_id": "1cae4b66-6971-404b-b714-788a66a3d823",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Die Sitte, den politischen Gegner umzubringen, hatte sich vor allem in Deutschland, Italien, Rußland und auf dem Balkan eingebürgert.“"
                                            },
                                            {
                                                "example_id": "c41dd782-c5f6-41b3-8833-f024fc553467",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Die russisch-österreichische Rivalität auf dem Balkan begann sich zum erstenmal klar abzuzeichnen.“"
                                            },
                                            {
                                                "example_id": "0316a8a8-1e4e-4491-8c5e-dd6db167bc12",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Mit bedauerlicher Hilflosigkeit standen wir auch dem Ausbruch nationalistischer Feindseligkeiten gegenüber, die - wie auf dem Balkan - der Auflösung aufgezwungener kommunistischer Disziplin folgten.“"
                                            },
                                            {
                                                "example_id": "466a0bc9-9670-4590-8e9e-822157af2c48",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Auch wenn sich die deutsche Regierung darum bemühte, wegen des Balkans nicht zum dritten Mal in diesem Jahrhundert gegen die Westmächte zu operieren, sah sie sich zusammen mit Italien doch alsbald genötigt, eher für Zagreb Partei zu ergreifen.“"
                                            },
                                            {
                                                "example_id": "65ec2251-7ec8-4055-a3a4-f5ae3ad59e4f",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Mein Geschichtslehrer erklärte eines Tages, dass Bulgarien im 10. Jahrhundert das größte Königreich auf dem Balkan gewesen war.“"
                                            },
                                            {
                                                "example_id": "dba30bc1-95e7-43fe-9a4a-ed3c2657a0c4",
                                                "sense_id": "9ec3cfb7-dafa-3c7a-b34f-c8dd2df0a485",
                                                "text": "„Sie konvertierten erst nach der Eroberung des Balkans durch die Osmanen ab dem 17. Jahrhundert zum Islam.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ca044d0-bd1e-3d24-a3fd-8ca0086fc653",
                                        "entry_id": "d4561737-ad85-3ca7-b9b9-b1ca07603203",
                                        "glosses": [
                                            "Gebirge, das Bulgarien in Ost-West-Richtung durchzieht"
                                        ],
                                        "tags": [
                                            "geography"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f73ff2a-81aa-483e-a011-3af7427e5ed1",
                                                "sense_id": "7ca044d0-bd1e-3d24-a3fd-8ca0086fc653",
                                                "text": "[Zar Nikolaj II.:] „Nikolaj war entgegen herrschenden Meinungen gar nicht begeistert davon, auf der Seite Serbiens den Konflikt auf dem Balkan mit austragen zu müssen.“"
                                            },
                                            {
                                                "example_id": "5d1e736e-3a41-4433-bf66-47f3cefa7fa6",
                                                "sense_id": "7ca044d0-bd1e-3d24-a3fd-8ca0086fc653",
                                                "text": "„Das Donauhügelland steigt nach Süden immer mehr an, geht dann in den Vorbalkan, der schon Höhen von 1500 Metern erreicht, und schließlich in den Balkan über.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7cc061a-f522-4806-9112-24310cde0137",
