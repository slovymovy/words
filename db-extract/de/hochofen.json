                ],
                "senses": [
                    {
                        "sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                        "entry_id": "9e7feb42-822b-39ae-bf70-5be415f26724",
                        "glosses": [
                            "Anlage in Schachtofenbauweise, in der Eisen durch Reduktion von Eisenoxid gewonnen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bee79cff-5b08-42c2-8106-67cda0f4e669",
                                "sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                                "text": "Viele Hochöfen sind inzwischen stillgelegt."
                            },
                            {
                                "example_id": "a688437f-e221-449c-93ec-73f21364aa65",
                                "sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                                "text": "„Einen Hochofen herunterzufahren, ist das Ärgste, was einem in der Stahlindustrie passieren kann.“"
                            },
                            {
                                "example_id": "8b3b14d1-e292-48d5-a59e-0d0d603cd4f0",
                                "sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                                "text": "„US Steel kündigte im Juni an, in Granite City, einem alten Stahlstandort im Bundesstaat Illinois, den stillgelegten zweiten Hochofen wieder in Gang zu setzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "51614bfc-c183-4fd0-b52c-9da3fb5479aa",
                        "source_entry_id": "9e7feb42-822b-39ae-bf70-5be415f26724",
                        "source_sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                        "source_sense_description": "Anlage in Schachtofenbauweise, in der Eisen durch Reduktion von Eisenoxid gewonnen wird",
                        "target_lang_word": "blast furnace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blast furnace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ded8b9b3-981e-3c6d-b8eb-8cf76cb068da",
                                        "entry_id": "09a36e3e-405f-3fc3-aa8e-e5bb30109ab7",
                                        "glosses": [
                                            "An industrial furnace in which ore is smelted to metal, the process being intensified by a blast of hot air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae4832f-24b8-4722-9c3d-91fb0beb210d",
                                                "sense_id": "ded8b9b3-981e-3c6d-b8eb-8cf76cb068da",
                                                "text": "Holonyms: ironworks, steelworks"
                                            },
                                            {
                                                "example_id": "76f30ae3-c0b5-4e74-a833-29392ec619c8",
                                                "sense_id": "ded8b9b3-981e-3c6d-b8eb-8cf76cb068da",
                                                "text": "Meronym: tuyeres"
                                            },
                                            {
                                                "example_id": "91c68846-674f-4bae-9644-2226193b4f6e",
                                                "sense_id": "ded8b9b3-981e-3c6d-b8eb-8cf76cb068da",
                                                "text": "Just before Bloworth Crossing, you'll walk a short distance along the trackbed of the old mineral railway that connected the old ironstone mines at Rosedale with the blast furnaces of Middlesbrough."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb831d52-3066-3fdb-bc97-d810deffd14b",
                                        "entry_id": "09a36e3e-405f-3fc3-aa8e-e5bb30109ab7",
                                        "glosses": [
                                            "An industrial furnace in which ore is smelted to metal, the process being intensified by a blast of hot air.",
                                            "As above, but specifically such a furnace where the fuel and the ore are intermixed, as for example when coke and iron ore are burned together."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f1088d8-1db5-44d2-a1bf-9e262d5d6d44",
                        "source_entry_id": "9e7feb42-822b-39ae-bf70-5be415f26724",
                        "source_sense_id": "0b527ed3-5775-394a-9a73-e54cda3a9742",
                        "source_sense_description": "Anlage in Schachtofenbauweise, in der Eisen durch Reduktion von Eisenoxid gewonnen wird",
                        "target_lang_word": "haut fourneau",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "haut fourneau",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cae1bd9c-f09e-3c18-a321-c2f639cfc3ae",
                                        "entry_id": "790ba1c0-8cac-3f95-bfc3-ab4aeca0f987",
                                        "glosses": [
                                            "Fourneau destiné à fondre le minerai de fer à une haute température."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5788a8-5ea5-43c5-9617-bb26e24c09d7",
                                                "sense_id": "cae1bd9c-f09e-3c18-a321-c2f639cfc3ae",
                                                "text": "– Il lui promettait de lui montrer, entre autres choses, les hauts fourneaux et de lui expliquer les différences qu'il y a entre le système Cowper et le système Whitwell."
                                            },
                                            {
                                                "example_id": "c7201872-0b2b-497b-9f77-a0b64ad0ba52",
                                                "sense_id": "cae1bd9c-f09e-3c18-a321-c2f639cfc3ae",
                                                "text": "Le laitier des hauts fourneaux, donne aussi l'acier fondu , mais ce flux ne vaut pas le verre alkalin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "805cca6d-9b49-32ba-95d0-c41ca1cd58f8",
                                        "entry_id": "790ba1c0-8cac-3f95-bfc3-ab4aeca0f987",
                                        "glosses": [
                                            "Usine où se trouve ce fourneau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fc6c2d84-5775-4cb5-a669-688f7df65383",
                                                "sense_id": "805cca6d-9b49-32ba-95d0-c41ca1cd58f8",
                                                "text": "Au-dessous, le pays s’étendait, immobile et muet, dans une obscurité que pointillaient et pailletaient des groupes de hauts fourneaux et les rues lumineuses des grandes villes."
                                            },
                                            {
                                                "example_id": "a580919c-7cfb-4f38-95bd-fbec311784c6",
                                                "sense_id": "805cca6d-9b49-32ba-95d0-c41ca1cd58f8",
                                                "text": "Les hauts fourneaux dont les masses orgueilleuses barrent l’horizon dans les pays d’usine, les hauts fourneaux dont la construction a absorbé des sommes considérables passeront en quelques années à l’état de ruines romantiques."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44605258-68fc-4a1e-b8cc-1c54a71255f3",
