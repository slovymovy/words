                        "sense_id": "a19e5cc1-0cd9-3c01-8b32-b950c3133fc6",
                        "entry_id": "bb58e4ce-287a-3bc2-a44a-6b0225065885",
                        "glosses": [
                            "een term uit de ecologie die verwijst naar de zaden die wel in de grond aanwezig zijn, maar niet actief deelnemen aan het leven in het bovenliggende milieu en wachten tot de omstandigheden veranderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9507988-4438-4c87-a15a-5abeac6eedb2",
                                "sense_id": "a19e5cc1-0cd9-3c01-8b32-b950c3133fc6",
                                "text": "Diep in de grond ligt er een zaadbank van tropische plantzaden."
                            },
                            {
                                "example_id": "90ad46d9-1e46-4db0-8b71-84ea4cabde19",
                                "sense_id": "a19e5cc1-0cd9-3c01-8b32-b950c3133fc6",
                                "text": "Ger wijst naar een helling die nog niet begraasd mag worden: \"Dat zijn zaadbanken! Hier zitten zeldzame plantensoorten die op de rode lijst staan, al negentig jaar in de grond."
                            }
                        ]
                    }
