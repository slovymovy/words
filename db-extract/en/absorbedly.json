                        "glosses": [
                            "In a manner as if wholly engrossed or engaged."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13196605-5c8b-4f39-9667-69a3a42feb8b",
                                "sense_id": "e0e38575-5ee6-3df9-a478-22b8440beaf3",
                                "text": "Michael O’Shea continued absorbedly gazing on the picture, till the welcome smell of a tumbler of Mr. Hoolagan’s whisky suddenly restored him to comparative serenity."
                            },
                            {
                                "example_id": "19951245-261f-4a7d-8dff-63d08d963635",
                                "sense_id": "e0e38575-5ee6-3df9-a478-22b8440beaf3",
                                "text": "Fanny, red-cheeked and bright-eyed from her recent mental struggles, listened interestedly, then intently, then absorbedly."
                            },
                            {
                                "example_id": "ab8e43a9-b8a8-40e3-8c51-99dba1d88a5f",
                                "sense_id": "e0e38575-5ee6-3df9-a478-22b8440beaf3",
                                "text": "Carey could see her expression. It was the face of one who was deeply and absorbedly interested."
                            },
                            {
                                "example_id": "37d2ef60-f47d-4dcc-9830-dbcc3959257f",
                                "sense_id": "e0e38575-5ee6-3df9-a478-22b8440beaf3",
                                "text": "Treslove was no Finkler. He could not lose his heart to more than one woman at a time. He loved too absorbedly for that. But he always knew when he was about to be thrown over and was quick to make provision, where he could, to love absorbedly again."
                            }
                        ]
                    }
