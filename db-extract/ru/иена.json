                "senses": [
                    {
                        "sense_id": "c6ff367b-54c1-3484-b501-194f29730ed0",
                        "entry_id": "f2ced60f-5e48-3c53-b756-79c9df8ef8b7",
                        "glosses": [
                            "денежная единица Японии и (во время японского колониального правления) Кореи"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9748a7bc-50c2-4691-ad0d-4fdaefa14f47",
                                "sense_id": "c6ff367b-54c1-3484-b501-194f29730ed0",
                                "text": "Обменный курс иены."
                            },
                            {
                                "example_id": "52581d2f-a876-4233-a31c-385246712384",
                                "sense_id": "c6ff367b-54c1-3484-b501-194f29730ed0",
                                "text": "Укрепление иены по отношению к доллару."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e474b39e-4d4a-49f3-9b10-29a944b45f8a",
                        "source_entry_id": "f2ced60f-5e48-3c53-b756-79c9df8ef8b7",
                        "source_sense_id": "c6ff367b-54c1-3484-b501-194f29730ed0",
                        "target_lang_word": "yen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c202d2d9-f062-3d0c-b818-ab31a9bfde5c",
                                        "entry_id": "0fe1baf6-6a57-398d-b0b4-9cd241672843",
                                        "glosses": [
                                            "To have a strong desire for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b9aa0d37-c052-45d1-adfa-710f55edd1c1",
                                                "sense_id": "c202d2d9-f062-3d0c-b818-ab31a9bfde5c",
                                                "text": "Yenning, groaning, longing after."
                                            },
                                            {
                                                "example_id": "5ca444b1-ce25-4462-93a1-6423ee5e2e41",
                                                "sense_id": "c202d2d9-f062-3d0c-b818-ab31a9bfde5c",
                                                "text": "\"Listen, I'm in Tom Bleutcher's suite at The Brompton House. Been here the whole Almighty morning. Olga wants you to have lunch with us.\" / \"Olga? Who's she?\" / \"His daughter. You made a big hit with her last time they was in town. Come on down.\" / \"Get the new writer.\" / \"I got no new writer. Anyway she yens for you. Come on down.\""
                                            },
                                            {
                                                "example_id": "2b11a11e-e794-4b95-a270-f8908ee385a1",
                                                "sense_id": "c202d2d9-f062-3d0c-b818-ab31a9bfde5c",
                                                "text": "C. S. Lewis warned, \"The yen to publish is spiritually dangerous.\" The \"yen\" in this case is spread around, so perhaps the danger is diminished! This book has been \"yenned\" into existence by many, and is a two-team effort …."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "25acff8a-1d3c-37ac-87f3-a56bb1bae2b8",
                                        "entry_id": "0fa2186c-7e47-30d0-a9f3-6f0a01a6b4a4",
                                        "glosses": [
                                            "The unit of Japanese currency (symbol: ¥) since 1871, divided into 100 sen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "48b24fbb-cfe0-448c-88c2-4e9b3aeb3d5b",
                                                "sense_id": "25acff8a-1d3c-37ac-87f3-a56bb1bae2b8",
                                                "text": "Passing by those clauses of it which demand no notice, we arrive at that which provides that \"each proposal (for purchase) must state the price per picul of rice in gold yen.\" But why in gold yen, a coin as yet so scarce as to be almost beyond the ken of the foreign merchant?",
                                                "translation": "Japan Meru Shinbunsha",
                                                "english": "Japan Meru Shinbunsha"
                                            },
                                            {
                                                "example_id": "a2fbdb70-6792-40d4-8fdc-62d84163e298",
                                                "sense_id": "25acff8a-1d3c-37ac-87f3-a56bb1bae2b8",
                                                "text": "Does any one however believe that Japan's glorious achievements would have been possible, if the Government of that country had merely poured money like water on its standing battalions, unaugmented by reserves, and the magnificent spirit of every man, woman and child in that country had not been behind the Army to support it? Japan's ordinary budget for the Army is only about 37.3 millions yen, or a little under six crores of rupees."
                                            },
                                            {
                                                "example_id": "e7386c93-9a1a-4855-9f50-1a6416c46117",
                                                "sense_id": "25acff8a-1d3c-37ac-87f3-a56bb1bae2b8",
                                                "text": "Taking the cue from his neighbours, Paul fed three 1000 yen notes into a machine beside the TV screen and the silent screen immediately exploded into a kaleidoscope of colours and instructions in Japanese below at least twenty pictures of sexy girls. […] Paul hesitated staring intently at the screen and the waiting girl while the 3,000 yen he had fed into the machine steadily dwindled at the rate of 50 yen a minute."
                                            },
                                            {
                                                "example_id": "0ad94a5f-b7d6-4a8d-9b9f-ca148ae36f4d",
                                                "sense_id": "25acff8a-1d3c-37ac-87f3-a56bb1bae2b8",
                                                "text": "Micron said in a statement that it would bring extreme ultraviolet (EUV) technology to Japan, becoming the first semiconductor company to do so, and expected to invest up to 500 billion yen ($3.6 billion) with support from the Japanese government."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e175468-1362-35e9-869b-502cd9c52c54",
                                        "entry_id": "0fa2186c-7e47-30d0-a9f3-6f0a01a6b4a4",
                                        "glosses": [
                                            "A coin or note worth one yen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5793de74-d3f7-4c71-bd56-29db228fa906",
                                                "sense_id": "1e175468-1362-35e9-869b-502cd9c52c54",
                                                "text": "When banks lend, they create money out of nothing, without withdrawing it from other parts of the economy. This way, fiscal policy would not have crowded out private-sector activity yen by yen, as actually happened."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                        "entry_id": "1eb759ef-6712-3e59-a285-3e3937ef93da",
                                        "glosses": [
                                            "A strong desire, urge, or yearning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63f61f6a-1555-4a7c-a821-6c25fb85fe0c",
                                                "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                                "text": "humankind's yen for knowledge"
                                            },
                                            {
                                                "example_id": "227ef24a-d9ff-421f-899b-9da9bf6f4743",
                                                "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                                "text": "She repeated the words: \"You for me and me for you,\" then hummed: \"Two for tea and tea for two …\" Her voice trailed off … \"All I got is a yen for Diana and my sweet little cute little Zigzag.\""
                                            },
                                            {
                                                "example_id": "918b5fd4-bb5b-445c-9679-1d2c0ad34e1c",
                                                "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                                "text": "Like most middle-westerners, I have never had any but the vaguest race prejudices—I always had a secret yen for the lovely Scandinavian blondes who sat on porches in St. Paul but hadn’t emerged enough economically to be part of what was then society."
                                            },
                                            {
                                                "example_id": "2bf32d73-bf5f-4e17-b49f-36df470cf51c",
                                                "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                                "text": "And Clocklan with a nurse for sure again. Always with nurses. Always with blonde hair. His maid has black and I guess he thrives on variety. And over there are some elderly ones with diamonds on their chests in lieu of the other things. Sometimes have a yen to get one of them in bed. Old age no object."
                                            },
                                            {
                                                "example_id": "3bed2bac-49e7-4a9a-87b7-e6a62aa56ce1",
                                                "sense_id": "cad81514-2078-344e-89bb-f199f31520d5",
                                                "text": "If a fellow chooses to tell himself that his yen for the fetching young intern in his office and his concomitant disgruntlement with his aging wife's housekeeping lacunae make perfect Darwinian sense, who am I to argue with him?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "yen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f00043e4-fe35-33d2-a961-fbba08558453",
                                        "entry_id": "b1139fc7-943b-31c3-b79b-050662f21e0a",
                                        "glosses": [
                                            "Opium."
                                        ],
                                        "tags": [
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
