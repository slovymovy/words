                                        "sense_id": "116ee827-6bdd-3d1d-965e-0125b6d6876f",
                                        "entry_id": "a53d6a31-272c-39d0-adf5-424345bf84a0",
                                        "glosses": [
                                            "Antenne zum Empfang von Richtfunk, insbesondere von Satelliten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "10bf504d-43d4-4b7f-8c8d-15f337e49f85",
                                                "sense_id": "116ee827-6bdd-3d1d-965e-0125b6d6876f",
                                                "text": "Wir haben jetzt eine Parabolantenne installiert."
                                            },
                                            {
                                                "example_id": "6e135774-7981-4c3a-ba89-ff3c66d5a350",
                                                "sense_id": "116ee827-6bdd-3d1d-965e-0125b6d6876f",
                                                "text": "„Für technische Einbauten an der Fassade, zu denen neben Parabolantennen übrigens auch Klimaanlagen, Alarmanlagen und Videokameras zählen, muss je nach Standort und Größe eine Bewilligung seitens der Baubehörde eingeholt werden.“"
                                            },
                                            {
                                                "example_id": "b8c85922-b079-4523-a3fa-d8b679684d23",
                                                "sense_id": "116ee827-6bdd-3d1d-965e-0125b6d6876f",
                                                "text": "„Die Mieter montierten eine Parabolantenne, mit der sie fünf Programme aus ihrer Heimat empfangen konnten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
