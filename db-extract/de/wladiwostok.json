                        "source_sense_description": "Großstadt am Japanischen Meer im russischen Föderationskreis Ferner Osten",
                        "target_lang_word": "海參崴",
                        "target_lang_code": "zh",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "海參崴",
