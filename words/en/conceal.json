            "senses": [
                {
                    "sense_id": "fc965c31-4895-3ba8-821c-ddc07291df4c",
                    "sense_definition": "To prevent something from being seen or known; to keep something secret.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He tried to <w>conceal</w> the truth about his health from his family.",
                            "target_lang_translations": {
                                "ru": "Он пытался <w>скрыть</w> правду о своем здоровье от семьи."
                            }
                        },
                        {
                            "text": "The spy used a fake passport to <w>conceal</w> identity while traveling abroad.",
                            "target_lang_translations": {
                                "ru": "Шпион использовал поддельный паспорт, чтобы <w>скрыть</w> свою личность во время поездки за границу."
                            }
                        },
                        {
                            "text": "She wore a large hat to <w>conceal</w> her face from the cameras.",
                            "target_lang_translations": {
                                "ru": "Она надела большую шляпу, чтобы <w>спрятать</w> лицо от камер."
                            }
                        },
                        {
                            "text": "The law allows citizens to carry a <w>concealed</w> weapon with a proper permit.",
                            "target_lang_translations": {
                                "ru": "Закон позволяет гражданам носить <w>скрытое</w> оружие при наличии соответствующего разрешения."
                            }
                        }
                    ],
                    "synonyms": [
                        "hide",
                        "cover up",
                        "obfuscate",
                        "secrete"
                    ],
                    "antonyms": [
                        "reveal",
                        "uncover",
                        "admit"
                    ],
                    "common_phrases": [
                        "conceal the truth",
                        "conceal identity",
                        "concealed weapon",
                        "conceal emotions"
                    ],
                    "target_lang_definitions": {
                        "ru": "Предотвращать возможность увидеть или узнать что-либо; хранить в секрете."
                    },
