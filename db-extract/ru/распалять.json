                                "example_id": "054fd315-69e9-46a1-8512-857cb2a22055",
                                "sense_id": "a619912c-bb7f-37b1-a0f5-a5c77c166e8f",
                                "text": "В сущности, он «распалял» себя на Арцимовича."
                            }
                        ]
                    },
