                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Randnotiz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "910cafe8-939a-37f2-a4f6-4ee5b750254d",
                                        "entry_id": "41d6ba3b-a379-3c57-b145-00e6bca943fb",
                                        "glosses": [
                                            "Notiz am Rand einer Seite/eines Textes"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "14607261-f69e-4fe4-9f91-c3c09bf3fde1",
                                                "sense_id": "910cafe8-939a-37f2-a4f6-4ee5b750254d",
                                                "text": "In vielen meiner Arbeitsbücher habe ich mir Randnotizen gemacht."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "aa64ff0b-62b3-3508-a918-5bf588d1c7eb",
                                        "entry_id": "41d6ba3b-a379-3c57-b145-00e6bca943fb",
                                        "glosses": [
                                            "wenig beachtete/wenig bedeutsame Anmerkung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "434d9f42-f592-41e0-8f99-726346b89d3a",
                                                "sense_id": "aa64ff0b-62b3-3508-a918-5bf588d1c7eb",
                                                "text": "„Seit vielen Jahrzehnten wird deshalb die Abtrennung eines gewaltigen Staatsgebiets – etwa ein Viertel des deutschen Territoriums – und das Los von mehr als zwölf Millionen Flüchtlingen und Vertriebenen, unter ihnen mindestens 600000 Todesopfer, als Randnotiz des deutschen Jahrhundertverbrechens behandelt, als Fußnote der Nationalerzählung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0a284d0f-812f-4d27-80a7-89ea5b532959",
                        "source_entry_id": "d93bf828-fb45-390e-a20d-47f3dd840af5",
