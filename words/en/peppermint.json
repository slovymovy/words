{
    "word_family": [
        "mint"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9b8aa4e1-08cb-34d8-be55-5d3c30d81563",
                    "sense_definition": "A hybrid herb of the mint family with a high menthol content and a sharp flavor, used in cooking and teas.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She added fresh <w>peppermint</w> leaves to her hot tea for a refreshing taste.",
                            "target_lang_translations": {
                                "zh": "她在热茶里加了新鲜的<w>薄荷</w>叶，喝起来很清爽。"
                            }
                        },
                        {
                            "text": "The garden is filled with the strong scent of <w>peppermint</w> growing near the path.",
                            "target_lang_translations": {
                                "zh": "花园里种在小路旁的<w>薄荷</w>散发出浓郁的香气。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mentha"
                    ],
                    "common_phrases": [
                        "fresh peppermint"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种薄荷科杂交草本植物，含有高浓度的薄荷醇，味道辛辣，常用于烹饪和茶饮。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "薄荷",
                                "target_lang_sense_clarification": "指薄荷属植物，通常指胡椒薄荷"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b479009-364d-3960-b1a6-bd006c0f44f2",
                    "sense_definition": "A sweet or candy flavored with the extract of the peppermint herb.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "food",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He sucked on a <w>peppermint</w> to freshen his breath after lunch.",
                            "target_lang_translations": {
                                "zh": "午饭后，他含了一颗<w>薄荷糖</w>来清新口气。"
                            }
                        },
                        {
                            "text": "The children enjoyed eating a sweet <w>peppermint</w> after their dinner.",
                            "target_lang_translations": {
                                "zh": "孩子们晚饭后很喜欢吃一颗甜甜的<w>薄荷糖</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mint"
                    ],
                    "common_phrases": [
                        "peppermint candy"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用薄荷提取物调味的糖果。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "薄荷糖",
                                "target_lang_sense_clarification": "指带有薄荷味的糖果"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8ea73dc2-6c04-388d-a724-786fbc64657b",
                    "sense_definition": "Any of various Australian eucalyptus trees that produce leaves with a scent similar to peppermint.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "plant",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The forest was dominated by tall <w>peppermint</w> trees that smelled strongly of menthol.",
                            "target_lang_translations": {
                                "zh": "森林里长满了高大的<w>薄荷桉</w>，空气中弥漫着浓烈的薄荷醇气味。"
                            }
                        },
                        {
                            "text": "In the hissing flames, they boiled the bark from <w>peppermint</w> gums.",
                            "target_lang_translations": {
                                "zh": "在嘶嘶作响的火焰中，他们煮了<w>薄荷桉</w>的树皮。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Used in Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "澳大利亚产的多种桉树，其叶片散发出类似薄荷的香气。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "薄荷桉",
                                "target_lang_sense_clarification": "指澳大利亚特有的具有薄荷气味的桉树"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}