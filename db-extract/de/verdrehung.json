                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d7086bb8-8bfa-4abf-be68-e32212ebd3f2",
                                "sense_id": "cd1151f4-00bf-316d-b1ce-5ed996d3e132",
                                "text": "„Es bestehen grundsätzliche Unterschiede zwischen der Verdrehung eines Kreiszylinders und von Prismen mit beliebigem Querschnitt.“"
