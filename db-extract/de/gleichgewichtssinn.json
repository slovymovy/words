                ],
                "senses": [
                    {
                        "sense_id": "2ea74669-1f90-3ad4-bb29-d6da895595da",
                        "entry_id": "c331155e-7afe-33b3-92eb-eecec1ef7331",
                        "glosses": [
                            "Gespür/Sinn für die Kontrolle der Körperhaltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe2b6dc-1410-4483-a1b4-af48e42f8620",
                                "sense_id": "2ea74669-1f90-3ad4-bb29-d6da895595da",
                                "text": "„Die Lampen waren mit Tüchern verhängt, der Graubart bediente das Grammophon, dessen Lautsprecher mit hineingestopfter Wäsche gedämpft war, und Streptomycin-Lilly saß auf dem Boden in einer Ecke, weil ihr Gleichgewichtssinn durch die Droge unsicher geworden war und sie leicht umfiel.“"
                            },
                            {
                                "example_id": "ec0675d3-dbbc-4b09-9d44-99adc5fec9a9",
                                "sense_id": "2ea74669-1f90-3ad4-bb29-d6da895595da",
                                "text": "„Die Forschungsschwerpunkte liegen auf dem Gebiet der Integration von Informationen der Seh-, Tast- und Gleichgewichtssinne sowie auf der Entwicklung von effizienten Algorithmen für Assistentssysteme.“"
                            }
                        ],
