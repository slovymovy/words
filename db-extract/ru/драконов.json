                            {
                                "example_id": "9b63b3c0-a82a-471b-bd08-40b196015fd8",
                                "sense_id": "2a478418-fe5f-3758-9387-d1f0e77e16d5",
                                "text": "Потомки говорили: «Драконовы законы писаны не чернилами, а кровью»."
