                "senses": [
                    {
                        "sense_id": "0cc5e2cd-b646-3576-8667-3fcb90143f56",
                        "entry_id": "de0fdba2-8242-3904-b861-dba22d9e194a",
                        "glosses": [
                            "staatliche Einrichtung, die die Aufsichtsfunktionen über andere staatliche Einrichtungen oder private Institutionen ausübt und diesen gegenüber weisungsbefugt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6affeccd-5ca8-46e0-a290-a8746df76d9d",
                                "sense_id": "0cc5e2cd-b646-3576-8667-3fcb90143f56",
                                "text": "Die Aufsichtsbehörde kontrolliert die Ausführung dieses Gesetzes sowie anderer Vorschriften über den Datenschutz, soweit diese …"
                            },
                            {
                                "example_id": "c3187e46-9bd9-4206-b74e-b2f3174601cd",
                                "sense_id": "0cc5e2cd-b646-3576-8667-3fcb90143f56",
                                "text": "Nun muss die Aufsichtsbehörde BVA entscheiden, ob sie der Kasse eigenständig eine Zukunft gibt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
