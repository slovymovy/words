                "senses": [
                    {
                        "sense_id": "633b89dc-67f9-3603-9668-2378305931b3",
                        "entry_id": "05783505-a888-388c-b697-64e35d12dd00",
                        "glosses": [
                            "eine von mehreren Bedeutungen eines Wortes, die nicht als Hauptbedeutung aufgefasst wird; zusätzliche Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f4fb8b5-5bd7-491b-98e6-f9e27f6482c9",
                                "sense_id": "633b89dc-67f9-3603-9668-2378305931b3",
                                "text": "„Es ist ein lexikographisches Problem, ob sich Sememe eines polysemen Wortes in Haupt- und Nebenbedeutungen gliedern lassen; denn dadurch müßte die Reihenfolge der Bedeutungsangaben im Wörterbuch geregelt werden.“"
                            },
                            {
                                "example_id": "a6b61b5d-2154-4c33-a875-c288c5c9e4b2",
                                "sense_id": "633b89dc-67f9-3603-9668-2378305931b3",
                                "text": "„Die zuletzt genannten Bedeutungen … sind die Nebenbedeutungen.“"
                            },
                            {
                                "example_id": "c7ceaa2f-a7c7-4175-b9ca-43e0f2dfb6cf",
                                "sense_id": "633b89dc-67f9-3603-9668-2378305931b3",
                                "text": "„Denn bei der Gebärde für Bock schwingt auch die negative Nebenbedeutung von Ziege mit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
