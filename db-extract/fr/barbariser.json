                "senses": [
                    {
                        "sense_id": "84b32140-6d26-37cc-958c-dfa9472b891a",
                        "entry_id": "2cc5c404-e55a-30da-8773-a06bc4d7a78b",
                        "glosses": [
                            "Rendre barbare. ^([1])"
                        ],
                        "tags": [
                            "dated",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "fc84856a-1aca-4f3b-a151-962ad44e6da6",
                                "sense_id": "84b32140-6d26-37cc-958c-dfa9472b891a",
                                "text": "Anéantir tous les monuments qui honorent le génie français…. en un mot nous barbariser."
                            },
                            {
                                "example_id": "375260a6-0cb0-43a4-8d46-9bb7777571a6",
                                "sense_id": "84b32140-6d26-37cc-958c-dfa9472b891a",
                                "text": "Mais, ma petite, c’est à nous de civiliser et je ne permettrai pas à un Arabe de barbariser une représentante du peuple français…"
                            },
                            {
                                "example_id": "c335ab0b-ef1b-4f98-bed7-5bae4ea3e482",
                                "sense_id": "84b32140-6d26-37cc-958c-dfa9472b891a",
                                "text": "Le proverbe grec, que aussy bien barbarisoit Solon entre les Scythes que Anacharsis entre les Grecs. — (BONIVARD, Advis et devis des langues, page 51.) ^([1])"
                            }
                        ]
                    },
