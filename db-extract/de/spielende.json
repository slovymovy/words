                "senses": [
                    {
                        "sense_id": "f54d4607-87ab-3e3b-b7c6-e53ee7a93b90",
                        "entry_id": "3a1f942b-a949-32f0-ac5e-7e1728a084f5",
                        "glosses": [
                            "Zeitpunkt, in dem ein sportlicher Wettkampf zwischen zwei gegnerischen Teilnehmern oder Mannschaften beendet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "946fa487-1a21-456a-b0c8-b59528943922",
                                "sense_id": "f54d4607-87ab-3e3b-b7c6-e53ee7a93b90",
                                "text": "Nach Spielende prügelten sich die Mannschaften auf dem Platz."
                            },
                            {
                                "example_id": "49ab6b17-45cf-44b7-a693-e37bd2f66942",
                                "sense_id": "f54d4607-87ab-3e3b-b7c6-e53ee7a93b90",
                                "text": "Unmittelbar vor dem Spielende schoss der Abwehrspieler das entscheidende Tor."
                            },
                            {
                                "example_id": "c8cd3778-35d6-403f-be65-36a2135e48df",
                                "sense_id": "f54d4607-87ab-3e3b-b7c6-e53ee7a93b90",
                                "text": "„Von Spielanfang bis Spielende muß jedes Zehnpfennigstück Kontakt zu mindestens zwei weiteren Münzen haben.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
