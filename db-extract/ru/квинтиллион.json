                        "sense_id": "849b01e5-1bb5-3c90-9561-94a32b8b3088",
                        "entry_id": "b8159fea-cf46-3813-9f53-a928b9bde946",
                        "glosses": [
                            "тысяча квадриллионов; тысяча в шестой степени; число, равное 10¹⁸ и записываемое в десятичной системе как единица с 18 нулями"
                        ],
                        "tags": [
                            "короткая шкала"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "614e2ba3-aa95-3f3d-9c49-8f9288ef96cf",
                        "entry_id": "b8159fea-cf46-3813-9f53-a928b9bde946",
                        "glosses": [
                            "миллион квадриллионов; миллион в пятой степени; число, равное 10³⁰ и записываемое в десятичной системе как единица с 30 нулями"
                        ],
                        "tags": [
                            "длинная шкала"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6027c65-fe16-40e4-aa93-ac1cbf3cc18b",
                        "source_entry_id": "b8159fea-cf46-3813-9f53-a928b9bde946",
                        "source_sense_description": "10¹⁸",
                        "target_lang_word": "quintillion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "quintillion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "Either of two very large amounts:",
                                            "A billion billion: 1 followed by eighteen zeros, 10¹⁸."
                                        ],
                                        "tags": [
                                            "Australian",
                                            "British",
                                            "US",
                                            "modern"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b87f9ba-7c57-45cb-8793-8f4af2880815",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "Last week, we used[…]the BBC News website's biggest number: 9,223,372,036,854,775,808, that's 9.2 quintillion[…][the maximum video viewer count on YouTube's] updated counter software."
                                            },
                                            {
                                                "example_id": "a512979d-47e1-4a1a-9d20-a3bd76ce8c52",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "“I’m not sure I understand why we have to send a quadrillion-credit mission to another galaxy.”\nHe looked fleetingly amused. “Quintillion... and we don’t have a choice, Harper. Any of us, really, but humanity especially.”"
                                            },
                                            {
                                                "example_id": "414ea0b3-d8d1-40c4-8d44-e0ba2d2fea04",
                                                "sense_id": "c5eb9802-e3f7-359a-84d2-6155aa808eea",
                                                "text": "You are currently logged on to the largest version of the internet that has ever existed. By clicking and scrolling, you’re one of the 5 billion–plus people contributing to an unfathomable array of networked information—quintillions of bytes produced each day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a49bae7-5b69-328e-9842-6b579b14ada4",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "Either of two very large amounts:",
                                            "A million quadrillion: 1 followed by 30 zeros, 10³⁰."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                        "entry_id": "d3fdaaef-cfda-3725-a355-cb60dcfb7fdd",
                                        "glosses": [
                                            "An unspecified very large number."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "excessive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e09f436a-90e6-4121-b97f-5485c4935d3e",
                                                "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                                "text": "Near-synonyms: gazillion; see also Thesaurus:zillion"
                                            },
                                            {
                                                "example_id": "691d3726-1781-43be-a514-71c84001d339",
                                                "sense_id": "164e0bae-1c5a-34a6-8362-99180548f75b",
                                                "text": "He had like a quintillion excuses for why he couldn't meet his obligation to me."
                                            }
                                        ]
                                    }
                                ]
                            },
