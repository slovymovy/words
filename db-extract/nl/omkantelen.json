                    },
                    {
                        "translation_id": "664fb0fe-3c84-40d0-8e78-30323b04ca14",
                        "source_entry_id": "b421fed9-29be-36cd-8dd1-a04965906d10",
                        "source_sense_id": "975cd075-caa7-3af7-9f3b-1ecc02a9ca78",
                        "target_lang_word": "topple over",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "topple over",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3e1e4726-d754-3b58-b83c-6acab31e9128",
                                        "entry_id": "691eec3f-8f8f-3faa-9bf2-df11a775b266",
                                        "glosses": [
                                            "To fall over (to fall from an upright or standing position to a horizontal or prone position)."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4139192a-4e2e-457a-b4d9-35d42943b2f3",
                                                "sense_id": "3e1e4726-d754-3b58-b83c-6acab31e9128",
                                                "text": "Moreover, some innocently untattooed people in the yoga class – who would otherwise be totally ace at balancing – find the light of self-satisfaction that radiates off their classmates' tattoos is so blinding they topple over."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
                    {
                        "linkage_id": "0cec88cd-0f6d-46ff-88b0-6ac79d4f9fe0",
