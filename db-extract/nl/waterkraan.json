                                    {
                                        "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                        "entry_id": "c9fae7c8-7abb-3d5a-bb33-5f738195fac2",
                                        "glosses": [
                                            "Abschlussstück, verschließbares Endstück einer Wasserleitung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc46a904-a6f7-40a6-b924-62d7e50f2669",
                                                "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                                "text": "Dreh mal den Wasserhahn zu!"
                                            },
                                            {
                                                "example_id": "d1048d39-57cf-4fb9-a7f0-e48073521dd4",
                                                "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                                "text": "„Ich dachte daran, dass ich mir noch nie Gedanken über die Trinkwasserqualität gemacht und das Wasser aus rumänischen Brunnen und türkischen Wasserhähnen getrunken hatte.“"
                                            },
                                            {
                                                "example_id": "ec8c5212-d949-4e46-890d-de053d599c4e",
                                                "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                                "text": "„Wilke wirft es in den Hof und geht zum Wasserhahn, um sich die Pfoten zu waschen.“"
                                            },
                                            {
                                                "example_id": "0b78a805-9671-4335-821d-192c53bba5e1",
                                                "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                                "text": "„Es tropfte aus dem Wasserhahn in der Küche.“"
                                            },
                                            {
                                                "example_id": "9ec52529-9711-4fcc-af12-fa1dd0592591",
                                                "sense_id": "5641d136-b2d8-3b7b-bfed-011ecaeea638",
                                                "text": "„Die Innenausstattung war aus Oslo bestellt worden: Stabparkett für die Wohnzimmer, Strohtapete für die Bibliothek, Wasserhähne aus Messing und das erste Wasserklosett im Dorf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
