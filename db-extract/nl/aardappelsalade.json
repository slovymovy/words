                "senses": [
                    {
                        "sense_id": "08b1abe1-c71e-376a-b172-43104aef6545",
                        "entry_id": "55e2f11c-56ce-356f-9ffb-642b51251663",
                        "glosses": [
                            "een salade die gemaakt wordt uit aardappelen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ecca7c5-7d7d-4728-b56f-549ee88a522e",
                                "sense_id": "08b1abe1-c71e-376a-b172-43104aef6545",
                                "text": "De aardappelsalade smaakt erg lekker."
                            },
                            {
                                "example_id": "f8e27c2c-c80c-4faa-b1ec-8bae2d5d60cb",
                                "sense_id": "08b1abe1-c71e-376a-b172-43104aef6545",
                                "text": "Toen Frederik haar een knuffel wilde geven, duwde ze hem weg en zette hem aan het werk: witte wijn, aardappelsalade, daarna koffie en gebak."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f20f26a8-fbae-4b30-8d25-cc77cad467bd",
                        "source_entry_id": "55e2f11c-56ce-356f-9ffb-642b51251663",
                        "source_sense_id": "08b1abe1-c71e-376a-b172-43104aef6545",
                        "source_sense_description": "een salade die gemaakt wordt uit aardappelen",
                        "target_lang_word": "Kartoffelsalat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kartoffelsalat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                        "entry_id": "7bf43b97-d649-3c67-83f6-8fff80659dcc",
                                        "glosses": [
                                            "Salat aus (gekochten) Kartoffeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c978d661-a87b-4c0f-ba98-d2831af9171e",
                                                "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                                "text": "Der Kartoffelsalat schmeckt heute überhaupt nicht nach Kartoffeln!"
                                            },
                                            {
                                                "example_id": "e843f5cc-0550-4bbb-b11a-4635447b8b6c",
                                                "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                                "text": "„Den Kartoffelsalat kippte ich aus dem Fenster.“"
                                            },
                                            {
                                                "example_id": "171832e4-6ff3-40b5-87f1-602ec6028852",
                                                "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                                "text": "„Als ich in meiner Wohnung war, machte ich mich über das Hähnchen und den Kartoffelsalat her.“"
                                            },
                                            {
                                                "example_id": "1cc98ae7-1d28-45b1-b560-9918fa0f2f91",
                                                "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                                "text": "„Der Duft von saurem Kartoffelsalat und heißen Würstchen, die unsere Gastgeberin, eine üppige indische Göttin, in einem silbernen Kessel hereintrug, stieg mir wohlig in die Nase.“"
                                            },
                                            {
                                                "example_id": "af686941-184d-4903-a82f-5872db623d0e",
                                                "sense_id": "3e00224c-d7ec-3a50-b144-3ecaae80e0d6",
                                                "text": "„Meistens gingen wir freitags zu Wienekens, da gab es immer Kartoffelsalat, und Frau Wieneken häufte uns den Teller besonders hoch voll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
