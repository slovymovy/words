                    {
                        "sense_id": "339e5c2e-5217-38aa-8a6a-f17e9ec4b080",
                        "entry_id": "08f64100-fdf0-370e-988e-2ca6c04e7e55",
                        "glosses": [
                            "Experiencing a feeling of irritation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee7ca3c3-ccf2-43ad-afe0-cb6c03b1f5ee",
                                "sense_id": "339e5c2e-5217-38aa-8a6a-f17e9ec4b080",
                                "text": "She felt irritated by the constant noise."
                            },
                            {
                                "example_id": "b4d42235-dfbc-4136-b181-c0fffb308e1c",
                                "sense_id": "339e5c2e-5217-38aa-8a6a-f17e9ec4b080",
                                "text": "His irritated tone made the situation worse."
                            }
                        ]
                    },
