                                            {
                                                "example_id": "a3daa87e-0647-41c0-a1be-38ac74b502b0",
                                                "sense_id": "f81143e9-457c-3b90-b72f-4e6fa76833fb",
                                                "text": "\"Well, we'll meet in New York and you can see what's left of me! Bon voyage\" the ganglings smirked & just beyond Grand, bang into not — da."
