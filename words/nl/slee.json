                {
                    "sense_id": "327309ee-6ec1-35d1-bc81-6d3c54e8bc54",
                    "sense_definition": "een voertuig zonder wielen dat over sneeuw of ijs glijdt op twee lopers",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "vervoermiddel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kinderen gingen de heuvel af met hun nieuwe <w>slee</w>.",
