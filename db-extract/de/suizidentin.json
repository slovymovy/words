                "senses": [
                    {
                        "sense_id": "90016501-7672-3ffc-b65f-65f3b7916f09",
                        "entry_id": "3c792efd-4d7a-3baf-8314-77d038566e35",
                        "glosses": [
                            "weibliche Person, die sich umbringt oder umbringen will, Selbstmord begeht"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "e5d06a10-6058-48be-8e65-32d60630f226",
                                "sense_id": "90016501-7672-3ffc-b65f-65f3b7916f09",
                                "text": "„Schließlich ist der Angeklagte auch nicht deswegen eines vollendeten, aktiv begangenen Tötungsdelikts schuldig, weil er die Zeugin P. und den Zeugen F. in Telefongesprächen über den jeweils aktuellen Zustand der Suizidentin und deren Todeswunsch unterrichtete.“"
                            },
                            {
                                "example_id": "93da3ff3-049b-4dc4-8d0a-f68e86f66936",
                                "sense_id": "90016501-7672-3ffc-b65f-65f3b7916f09",
                                "text": "„Es geht hierbei um die Bestattung Clarissas, der als Suizidentin zunächst der kirchliche Segen versagt bleibt.“"
                            },
                            {
                                "example_id": "a6c5f831-a4ce-48f5-8f27-a47dd2c5435b",
                                "sense_id": "90016501-7672-3ffc-b65f-65f3b7916f09",
                                "text": "„So wurde 1984 ein Arzt, der es unterlassen hatte, den Suizid einer Patientin gegen ihren schriftlich erklärten Willen zu verhindern, wegen Tötung auf Verlangen durch Unterlassung angeklagt und nur deshalb freigesprochen, weil im konkreten Fall eine Rettung der Suizidentin nicht mehr möglich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
