                    {
                        "translation_id": "1984ed21-d930-4669-b63a-6f0576fbf947",
                        "source_entry_id": "4432a66a-8353-37ee-a025-cb22cf5cae39",
                        "source_sense_id": "5538cc20-a597-3a60-88b0-8c35a4c93dab",
                        "target_lang_word": "monokini",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "monokini",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                        "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                                        "glosses": [
                                            "The lower part of a bikini without the upper part (i.e., topless)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5de06d7-0cc0-4e9b-b64d-16206d5ecb21",
                                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                                "text": "All this so impressed the Appellate Court in Aix-en-Provence that it reversed the convictions. \"Inasmuch as the spectacle of the nudity of the human body has nothing intrinsic in it that would outrage normal, even delicate decency, and since Claudine Durand concealed her sexual parts with a sufficiently opaque monokini, we acquit her.\""
                                            },
                                            {
                                                "example_id": "6ef745fe-7b62-455c-a695-421ce287bf8c",
                                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                                "text": "French academics and historians have spent the early summer months pondering the sociological meaning of the demise of France's once-favourite piece of beachwear, the \"monokini\" – the bottom half of a bikini with no top."
                                            },
                                            {
                                                "example_id": "e13cf6f9-300c-4062-a137-5d0b7fa93132",
                                                "sense_id": "09820e34-ba81-3f9b-a7a5-edf626e3400c",
                                                "text": "In fact, the San Francisco Chronicle featured a photo of a woman in a monokini — her exposed breasts clearly visible — on its front page."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7074ef2a-f67b-3723-a27e-3662442be5e7",
                                        "entry_id": "9465b86c-3828-3cdb-80af-65e537baed10",
                                        "glosses": [
                                            "A one-piece swimsuit, which may cover both the chest and the crotch (as contrasted with a bikini, which consists of two pieces)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "545de3a4-2ca8-4bbf-ab49-32b3e51ede84",
                                                "sense_id": "7074ef2a-f67b-3723-a27e-3662442be5e7",
                                                "text": "[Psylocke is] wearing a mix between a monokini and cut-out swimwear, a wardrobe change[.]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
