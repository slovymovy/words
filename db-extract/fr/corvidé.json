                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b94837b5-50a9-4d45-93c8-d05ceaecd20a",
                                                "sense_id": "00c862c6-efb6-3053-95e3-4ffd22295c69",
                                                "text": "Frau Rabe ist nett."
                                            },
                                            {
                                                "example_id": "b7e6dcd4-8a9e-454d-b683-93eb42b7fe3a",
                                                "sense_id": "00c862c6-efb6-3053-95e3-4ffd22295c69",
                                                "text": "Wir sind heute Abend bei Rabes eingeladen."
                                            },
                                            {
                                                "example_id": "b25481c1-f642-4ff6-9088-2f2f67d92994",
                                                "sense_id": "00c862c6-efb6-3053-95e3-4ffd22295c69",
                                                "text": "die Rabes von nebenan"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9c6593d7-4bc2-4b73-9b81-22140e15f948",
                        "source_entry_id": "dacedb1a-bb3c-31b5-82c7-8a43a9159caf",
                        "source_sense_id": "b22a1c13-86fa-3a36-96b6-522028dcc6ca",
                        "target_lang_word": "Krähe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Krähe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                        "entry_id": "614c44e4-295e-39ed-99fa-ecc12acfd193",
                                        "glosses": [
                                            "ein Rabenvogel mit starkem Schnabel (mittelgroße Arten der Gattung Corvus)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0ed908e7-84eb-4e02-be08-6749498c4478",
                                                "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                                "text": "Die schwarzblaue Saatkrähe horstet kolonieweise."
                                            },
                                            {
                                                "example_id": "f0455df4-e30a-45ac-991c-fb677d3c88b8",
                                                "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                                "text": "„Die Krähen haben es gut. Die Krähen fliegen abends nach Hause.“"
                                            },
                                            {
                                                "example_id": "3ac8c6a9-579e-423d-9258-3327ac1c856c",
                                                "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                                "text": "„Bald nach dieser Empfehlung ergänzten denn auch Krähen das Angebot auf den Märkten überall in Deutschland.“"
                                            },
                                            {
                                                "example_id": "3e6a79cf-4894-4715-84d6-407863e7e4ad",
                                                "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                                "text": "„Die Krähen versammelten sich bereits.“"
                                            },
                                            {
                                                "example_id": "a0dc41b2-47ea-4e4a-aa8b-181b24d59b44",
                                                "sense_id": "320f5df5-bdd5-3a54-8c77-fd03298fe45f",
                                                "text": "„Ein paar Krähen flatterten wie dunkle Lappen darin herum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
