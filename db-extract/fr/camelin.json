                    }
                ],
                "senses": [
                    {
                        "sense_id": "4100365f-d407-3cc2-9297-0a3481c57916",
                        "entry_id": "3bdc30f7-5ec4-34cc-a41c-25e2fbc1738d",
                        "glosses": [
                            "Drap de laine fine, à double face, primitivement fait de poils de chameau ou de chèvre, mêlés de laine et de soie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7114d789-8793-4e6d-ab69-473f993adcb1",
                                "sense_id": "4100365f-d407-3cc2-9297-0a3481c57916",
                                "text": "Voici donc écartée une erreur souvent répétée par les glossaires techniques depuis que le Dictionnarius de Jehan de Garlande a défini le camelin comme un tissu de couleur semblable au chameau."
                            },
                            {
                                "example_id": "4e4e1d85-ee8b-45f6-b299-500d2a719c24",
                                "sense_id": "4100365f-d407-3cc2-9297-0a3481c57916",
                                "text": "Certains lainages très légers sont importés d’Italie et le camelin, fin tissage de poils de chameau arrive directement d’Orient."
                            },
                            {
                                "example_id": "c149f64e-b1eb-43e0-b46d-a545ba0d4c33",
                                "sense_id": "4100365f-d407-3cc2-9297-0a3481c57916",
                                "text": "Broderies, dentelles, soieries, velours et camelins, passementeries, articles de parure et de petite joaillerie s'entassaient, chatoyaient, miroitaient sur les comptoirs de chêne dont le soir on relevait l'abattant, ou chargeaient des tables à tréteaux, ou pendaient à des perches."
                            }
                        ]
                    }
