                                "target_senses": [
                                    {
                                        "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "Any arthropod of class Chilopoda, which have a segmented body with one pair of legs per segment and from about 20 to 300 legs in total."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4374c3fb-5dba-480a-b4ab-17f20ac3ece1",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "Centipedes differ from millipedes by having a single pair of legs on each body segment."
                                            },
                                            {
                                                "example_id": "96686866-bb91-476d-8614-ac4c115e709b",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "The existence of millipedes, centipedes, insects, and spiders along-side the first tetrapods sustained a robust ecosystem in which most animals were predators or scavengers."
                                            },
                                            {
                                                "example_id": "30ad95fa-d7c9-4868-aaff-4d6249ef810a",
                                                "sense_id": "56fbf60b-b6b8-30e2-bcd8-66bca7bf2dcc",
                                                "text": "All centipedes (Chilopoda) and spiders (Aranea) are predatory and although they are often found on corpses their impact on the other fauna is not known."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9bfa6b51-06ed-3ac0-951a-91d9272d4b90",
                                        "entry_id": "4e9afd66-0b9a-3a59-a21b-dc308533c030",
                                        "glosses": [
                                            "A many-oared Chinese smuggling boat."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c9c3617-18c7-49be-b8df-54b8aa2e0fa0",
                        "source_entry_id": "7c428ae0-1fc6-3b8b-9b96-26066d02441a",
                        "source_sense_id": "432ecc5f-f7dc-3126-9211-d99dddb93ac3",
                        "source_sense_description": "geleedpotig dier met een groot aantal poten uit de klasse Chilopoda",
                        "target_lang_word": "mille-pattes",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mille-pattes",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                        "entry_id": "b4e6d066-4580-3b87-8dfe-f62873744251",
                                        "glosses": [
                                            "Nom d’un sous-embranchement d’arthropodes qui ont un très grand nombre de pattes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb7a035b-3294-4ee8-8a90-27681db8dd99",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Un serpent rim rock crowned snake (Tantilla oolitica) a été retrouvé mort avec un mille-pattes des Caraïbes dans la gueule."
                                            },
                                            {
                                                "example_id": "b0cc4cf0-880b-45f8-af81-c51ed2573518",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Une créature fossilisée ressemblant à un mille-pattes mise au jour en Écosse est devenue le plus ancien animal terrestre découvert jusqu'à maintenant. Ce pionnier de la vie a vécu il y a 425 millions d'années."
                                            },
                                            {
                                                "example_id": "0ebd4850-b959-4132-b65e-b43ca0fa4312",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Il me tardait que ce fût fini. Je me faisais horreur de prolonger cette scène (comme quand on n’ose pas appuyer le talon sur le mille-pattes)."
                                            },
                                            {
                                                "example_id": "3d63e066-8294-4314-91f5-501059bcf89c",
                                                "sense_id": "4f65e8e7-1689-3af0-ac35-84b56e737023",
                                                "text": "Les mille-pattes étaient parmi les premiers animaux à respiration aérienne sur Terre, note l'étude, et certaines espèces éteintes ont atteint plus de deux mètres de long."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "255c2255-383f-3b67-a8ac-6ff42f3b68e7",
                                        "entry_id": "b4e6d066-4580-3b87-8dfe-f62873744251",
                                        "glosses": [
                                            "Poids lourd, notamment semi-remorque."
                                        ],
                                        "tags": [
                                            "CB"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
