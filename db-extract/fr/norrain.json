                        "glosses": [
                            "Membre du peuple originaire de Scandinavie qui parlait le vieux norrois."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "b5b82bab-12fd-4be2-8962-7931b05959c4",
                                "sense_id": "70984344-3863-3fd4-872c-ddd738b8ba38",
                                "text": "Quatre femmes sont là, quatre épouses de chefs ;\nLa Franke Gudruna, l’inconsolable veuve,\nEt la reine des Huns, errant loin de son fleuve,\nEt celle des Norrains, hardis monteurs de nefs."
                            }
                        ]
                    }
