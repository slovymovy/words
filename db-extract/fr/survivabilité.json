                        "entry_id": "80c8426c-3c7c-3b24-a353-6e235b716d35",
                        "glosses": [
                            "Capacité à survivre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "b9ab7f31-a3bc-41a4-9ab7-193c728c7d36",
                                "sense_id": "ab0ff86e-9190-3fbf-b00e-bbaf388764cb",
                                "text": "Renault Trucks Défense a donc développé et breveté une solution innovante pour transporter 15 200 lires de carburants sous haute protection tout en assurant la survivabilité des équipages en cas d'embuscade."
                            }
                        ]
                    },
                    {
                        "sense_id": "c5310572-4c20-3dbb-b4c0-976ed2050141",
                        "entry_id": "80c8426c-3c7c-3b24-a353-6e235b716d35",
                        "glosses": [
                            "Capacité à rester utilisable malgré des destructions."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "44eff798-0a78-46d6-8556-116cbfc67792",
                                "sense_id": "c5310572-4c20-3dbb-b4c0-976ed2050141",
                                "text": "La survivabilité du système dissuasif chinois est une caractéristique critique étant donnée la précision des armées américaines, d'autant que les capacités de détection d'attaque de la Chine sont incertaines."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12bbedc1-4a38-4d98-af6c-b40814841e58",
                        "source_entry_id": "80c8426c-3c7c-3b24-a353-6e235b716d35",
