                        "glosses": [
                            "Accumuler de façon exagérée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba20311f-398e-49fb-9d86-8e3bf89b9312",
                                "sense_id": "8177d6a6-1549-3874-bf53-e387222ab15d",
                                "text": "La défense, dans un premier temps, consiste à accélérer la substitution du capital au travail, suraccumuler, investir, donc emprunter."
                            },
                            {
                                "example_id": "1009a699-2acd-4dda-a12e-a21dd5729f87",
                                "sense_id": "8177d6a6-1549-3874-bf53-e387222ab15d",
                                "text": "Mais est-il donc si nécessaire de suraccumuler les promesses et d'affirmer que demain, dans le radieux univers socialiste, on rasera gratis?"
                            }
                        ]
                    }
