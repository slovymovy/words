{
    "word_family": [
        "develop",
        "developer",
        "developing",
        "developmental",
        "redevelopment",
        "underdevelopment"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "47abd0ce-ffb2-37d4-ae78-2754d2dacda4",
                    "sense_definition": "The process of growing, changing, or becoming more advanced.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "process_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Education plays a vital role in the <w>development</w> of a country.",
                            "target_lang_translations": {
                                "ru": "Образование играет жизненно важную роль в <w>развитии</w> страны.",
                                "zh": "教育在国家的<w>发展</w>中起着至关重要的作用。"
                            }
                        },
                        {
                            "text": "The <w>development</w> of the new software took over two years to complete.",
                            "target_lang_translations": {
                                "ru": "<w>Разработка</w> нового программного обеспечения заняла более двух лет.",
                                "zh": "这款新软件的<w>开发</w>耗时两年多才完成。"
                            }
                        }
                    ],
                    "synonyms": [
                        "growth",
                        "advancement",
                        "progress",
                        "evolution",
                        "expansion",
                        "improvement",
                        "nurturing"
                    ],
                    "antonyms": [
                        "decline",
                        "stagnation",
                        "regression"
                    ],
                    "common_phrases": [
                        "economic development",
                        "professional development",
                        "sustainable development",
                        "child development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс роста, изменения или перехода на более высокий уровень развития.",
                        "zh": "事物成长、变化或变得更加先进的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "процесс роста или совершенствования"
                            },
                            {
                                "target_lang_word": "совершенствование",
                                "target_lang_sense_clarification": "улучшение качеств"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发展",
                                "target_lang_sense_clarification": "事物由小到大、由简单到复杂、由低级到高级的变化"
                            },
                            {
                                "target_lang_word": "进步",
                                "target_lang_sense_clarification": "在原有基础上取得的提升"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2b2b00c-7d9a-3af2-bc6f-bad5b2bbf119",
                    "sense_definition": "The process of creating new products, ideas, or systems, or improving existing ones.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "process_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company invests a significant amount of money in research and <w>development</w>.",
                            "target_lang_translations": {
                                "ru": "Компания вкладывает значительные средства в исследования и <w>разработки</w>.",
                                "zh": "该公司投入大量资金用于研究与<w>开发</w>。"
                            }
                        },
                        {
                            "text": "She works in the product <w>development</w> department of a large tech firm.",
                            "target_lang_translations": {
                                "ru": "Она работает в отделе <w>разработки</w> продукции крупной технологической фирмы.",
                                "zh": "她在一家大型科技公司的产品<w>开发</w>部门工作。"
                            }
                        }
                    ],
                    "synonyms": [
                        "innovation",
                        "design"
                    ],
                    "common_phrases": [
                        "research and development",
                        "product development",
                        "software development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс создания новых продуктов, идей или систем, либо улучшение существующих.",
                        "zh": "创造新产品、新想法或新系统，或改进现有事物的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разработка",
                                "target_lang_sense_clarification": "создание продуктов или технологий"
                            },
                            {
                                "target_lang_word": "создание",
                                "target_lang_sense_clarification": "процесс творения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发",
                                "target_lang_sense_clarification": "以新的方式利用或创造产品、技术"
                            },
                            {
                                "target_lang_word": "研制",
                                "target_lang_sense_clarification": "研究并制造"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6c9b9e36-fea5-3111-b943-9ae6ddc22ddf",
                    "sense_definition": "A recent event, occurrence, or piece of news that changes a situation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "event_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We are waiting for further <w>developments</w> before making a decision.",
                            "target_lang_translations": {
                                "ru": "Мы ждем дальнейшего <w>развития событий</w>, прежде чем принимать решение.",
                                "zh": "我们正在等待进一步的<w>进展</w>，然后再做决定。"
                            }
                        },
                        {
                            "text": "The news channel reported the latest <w>developments</w> in the peace negotiations.",
                            "target_lang_translations": {
                                "ru": "Новостной канал сообщил о последних <w>событиях</w> в мирных переговорах.",
                                "zh": "新闻频道报道了和平谈判的最新<w>进展</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "event",
                        "incident",
                        "occurrence",
                        "change"
                    ],
                    "common_phrases": [
                        "latest developments",
                        "recent developments",
                        "new development",
                        "further developments"
                    ],
                    "target_lang_definitions": {
                        "ru": "Недавнее событие, происшествие или новость, меняющие текущую ситуацию.",
                        "zh": "改变当前局势的近期事件、发生的事情或新闻。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "событие",
                                "target_lang_sense_clarification": "происшествие или случай"
                            },
                            {
                                "target_lang_word": "поворот событий",
                                "target_lang_sense_clarification": "изменение ситуации"
                            },
                            {
                                "target_lang_word": "изменение",
                                "target_lang_sense_clarification": "перемена в обстановке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "进展",
                                "target_lang_sense_clarification": "事情向前发展的情况"
                            },
                            {
                                "target_lang_word": "事态",
                                "target_lang_sense_clarification": "事情发展的状态或情况"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ed2791ab-14e1-35bf-8c09-f63315264663",
                    "sense_definition": "The biological process by which a plant or animal grows and matures.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "process_growth",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Good nutrition is essential for the healthy <w>development</w> of the fetus.",
                            "target_lang_translations": {
                                "ru": "Хорошее питание необходимо для здорового <w>развития</w> плода.",
                                "zh": "良好的营养对于胎儿的健康<w>发育</w>至关重要。"
                            }
                        },
                        {
                            "text": "Scientists are studying the early stages of embryonic <w>development</w> in frogs.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают ранние стадии эмбрионального <w>развития</w> у лягушек.",
                                "zh": "科学家们正在研究青蛙胚胎<w>发育</w>的早期阶段。"
                            }
                        }
                    ],
                    "synonyms": [
                        "maturation"
                    ],
                    "common_phrases": [
                        "brain development",
                        "fetal development",
                        "physical development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Биологический процесс, посредством которого растение или животное растет и созревает.",
                        "zh": "植物或动物生长和成熟的生物学过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "биологический рост организма"
                            },
                            {
                                "target_lang_word": "созревание",
                                "target_lang_sense_clarification": "процесс становления взрослым"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发育",
                                "target_lang_sense_clarification": "生物体从低级到高级、从简单到复杂的生长过程"
                            },
                            {
                                "target_lang_word": "生长",
                                "target_lang_sense_clarification": "生物体体积或数量的增加"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b174572-5a81-3f67-9d91-0b87945b28b4",
                    "sense_definition": "An area of land containing new houses, shops, or offices built as a planned project.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "event_result",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They bought a house in a new residential <w>development</w> outside the city.",
                            "target_lang_translations": {
                                "ru": "Они купили дом в новом жилом <w>комплексе</w> за городом.",
                                "zh": "他们在城外的一个新<w>住宅区</w>买了一栋房子。"
                            }
                        },
                        {
                            "text": "The council approved a large commercial <w>development</w> near the river.",
                            "target_lang_translations": {
                                "ru": "Совет одобрил крупный проект коммерческой <w>застройки</w> у реки.",
                                "zh": "市政委员会批准了河边的一项大型商业<w>开发项目</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "complex",
                        "estate",
                        "project"
                    ],
                    "common_phrases": [
                        "housing development",
                        "residential development",
                        "commercial development"
                    ],
                    "target_lang_definitions": {
                        "ru": "Участок земли с новыми домами, магазинами или офисами, построенный как единый проект.",
                        "zh": "作为规划项目建造的包含新住宅、商店或办公室的土地区域。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "застройка",
                                "target_lang_sense_clarification": "территория строительства"
                            },
                            {
                                "target_lang_word": "жилой комплекс",
                                "target_lang_sense_clarification": "группа жилых зданий"
                            },
                            {
                                "target_lang_word": "микрорайон",
                                "target_lang_sense_clarification": "жилой район"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "开发区",
                                "target_lang_sense_clarification": "经过规划建设的特定区域"
                            },
                            {
                                "target_lang_word": "住宅区",
                                "target_lang_sense_clarification": "专门用于居住的建筑群"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5dfa90-18f1-3d5c-8fb8-c12301ecfc6e",
                    "sense_definition": "The chemical processing of photographic film to make latent images visible.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a darkroom in his basement for the <w>development</w> of black and white film.",
                            "target_lang_translations": {
                                "ru": "У него в подвале есть темная комната для <w>проявки</w> черно-белой пленки.",
                                "zh": "他在地下室有一个暗房，专门用于<w>冲洗</w>黑白胶片。"
                            }
                        },
                        {
                            "text": "The <w>development</w> of these old negatives requires specific chemicals.",
                            "target_lang_translations": {
                                "ru": "<w>Проявка</w> этих старых негативов требует особых химикатов.",
                                "zh": "<w>冲洗</w>这些旧底片需要特定的化学药剂。"
                            }
                        }
                    ],
                    "synonyms": [
                        "processing"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "mostly replaced by digital photography"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Химическая обработка фотопленки для того, чтобы сделать скрытые изображения видимыми.",
                        "zh": "对摄影胶片进行化学处理，使潜影显现出来的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "проявка",
                                "target_lang_sense_clarification": "обработка фотоматериалов"
                            },
                            {
                                "target_lang_word": "проявление",
                                "target_lang_sense_clarification": "процесс в фотографии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "冲洗",
                                "target_lang_sense_clarification": "对胶片进行化学处理以显影"
                            },
                            {
                                "target_lang_word": "显影",
                                "target_lang_sense_clarification": "使影像在胶片上显现出来的技术过程"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e50539a9-cd40-3df9-97d1-1493c32d9cd1",
                    "sense_definition": "A section of a musical piece, especially in sonata form, where original themes are altered and explored.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The symphony's <w>development</w> section is complex and full of energy.",
                            "target_lang_translations": {
                                "ru": "Секция <w>разработки</w> симфонии сложна и полна энергии.",
                                "zh": "这部交响曲的<w>展开部</w>结构复杂，充满活力。"
                            }
                        },
                        {
                            "text": "Beethoven is famous for his masterful <w>development</w> of simple musical themes.",
                            "target_lang_translations": {
                                "ru": "Бетховен известен своей мастерской <w>разработкой</w> простых музыкальных тем.",
                                "zh": "贝多芬以其对简单音乐主题的精湛<w>展开</w>而闻名。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "music"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел музыкального произведения, особенно в сонатной форме, где варьируются и исследуются исходные темы.",
                        "zh": "音乐作品（尤其是奏鸣曲式）中对原始主题进行变奏和探索的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разработка",
                                "target_lang_sense_clarification": "музыкальный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开部",
                                "target_lang_sense_clarification": "奏鸣曲式中对主题进行发展的段落"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "54fab80e-ee92-3df7-9bb1-2b5730ea9a13",
                    "sense_definition": "The act of moving chess pieces into active positions to prepare for the middle game.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Rapid <w>development</w> of your knights and bishops is crucial in the opening.",
                            "target_lang_translations": {
                                "ru": "Быстрое <w>развитие</w> коней и слонов имеет решающее значение в дебюте.",
                                "zh": "在开局阶段，迅速<w>出子</w>（马和象）至关重要。"
                            }
                        },
                        {
                            "text": "White had a lead in <w>development</w>, which allowed for a strong attack.",
                            "target_lang_translations": {
                                "ru": "У белых было преимущество в <w>развитии</w>, что позволило провести сильную атаку.",
                                "zh": "白方在<w>出子</w>方面领先，这使得他能够发起强有力的进攻。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "chess"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по перемещению шахматных фигур на активные позиции для подготовки к миттельшпилю.",
                        "zh": "在国际象棋中，将棋子移动到活跃位置以准备中局的行动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "шахматный термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出子",
                                "target_lang_sense_clarification": "国际象棋开局阶段将棋子调动到有利位置"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}