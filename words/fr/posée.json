                    "sense_id": "1b11178c-3f6b-31dc-9343-bced5bb2648e",
                    "sense_definition": "Participe passé féminin singulier de <w>poser</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La mouette s'est <w>posée</w> sur le sable doré au bord de la mer.",
                            "target_lang_translations": {
                                "en": "The seagull <w>landed</w> on the golden sand at the edge of the sea.",
                                "ru": "Чайка <w>села</w> на золотистый песок на берегу моря.",
                                "de": "Die Möwe hat sich auf dem goldgelben Sand am Meeresufer <w>niedergelassen</w>.",
                                "es": "La gaviota <w>se posó</w> sobre la arena dorada a la orilla del mar.",
                                "zh": "海鸥<w>停落</w>在海边金黄色的沙滩上。"
                            }
                        },
                        {
                            "text": "Cette question essentielle a été <w>posée</w> au ministre lors de la conférence de presse.",
                            "target_lang_translations": {
                                "en": "This essential question was <w>raised</w> with the minister at the press conference.",
                                "ru": "Этот важный вопрос был <w>задан</w> министру на пресс-конференции.",
                                "de": "Diese wesentliche Frage wurde dem Minister auf der Pressekonferenz <w>gestellt</w>.",
                                "es": "Esta pregunta esencial fue <w>planteada</w> al ministro durante la rueda de prensa.",
                                "zh": "在记者招待会上，有人向部长<w>提出</w>了这个重要问题。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
