                        "examples": [
                            {
                                "example_id": "209584f3-28de-4a41-b669-770e811b18fe",
                                "sense_id": "a95b7ce7-3af9-34bb-a038-8a7719e238f6",
                                "text": "Vlad Țepeș, Fürst der Walachei, stand Pate für die Romanfigur Graf Dracula."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "008b434c-a9a7-3064-b2e0-c4f8d867c929",
                        "entry_id": "5ed9549f-6ebc-3c57-8335-2f2c19fbdc0b",
                        "glosses": [
                            "abgelegene, zivilisationsarme Gegend"
                        ],
                        "tags": [
                            "colloquial",
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "7b7071e4-d31e-4320-bb5b-9fb4252d8afb",
                                "sense_id": "008b434c-a9a7-3064-b2e0-c4f8d867c929",
                                "text": "Da sind wir mitten in der Walachei angekommen!"
                            },
                            {
                                "example_id": "d63cc317-0896-4ca0-ac2d-46e51e2b96ff",
                                "sense_id": "008b434c-a9a7-3064-b2e0-c4f8d867c929",
                                "text": "Ich bin ein Stadtkind, aber dann in die Walachei gezogen, ans Ende der Welt."
                            },
                            {
                                "example_id": "c467bd47-078c-43ce-90ea-ef42e9081c2b",
                                "sense_id": "008b434c-a9a7-3064-b2e0-c4f8d867c929",
                                "text": "Zum Glück hat das Handy hier Empfang: \"Hallo, ich bin gerade mitten in der Walachei mit meinem Auto liegen geblieben.\""
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
