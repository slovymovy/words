        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "019f6598-76a4-3a81-8f44-28f8241197bf",
                    "sense_definition": "Exprime l'étonnement, l'incrédulité ou la demande de confirmation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "exclamation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tu as gagné le premier prix, <w>vraiment</w> ?",
                            "target_lang_translations": {
                                "en": "You won first prize, <w>really</w>?",
                                "ru": "Ты выиграл первый приз, <w>неужели</w>?",
                                "nl": "Je hebt de eerste prijs gewonnen, <w>echt</w>?",
                                "de": "Du hast den ersten Preis gewonnen, <w>wirklich</w>?",
                                "pl": "Wygrałeś pierwszą nagrodę, <w>naprawdę</w>?",
                                "it": "Hai vinto il primo premio, <w>davvero</w>?",
                                "cs": "Vyhrál jsi první cenu, <w>opravdu</w>?",
                                "tr": "Birinci ödülü kazandın, <w>sahi mi</w>?",
                                "es": "¿Ganaste el primer premio, <w>de verdad</w>?",
                                "zh": "你拿到了一等奖，<w>真的吗</w>？"
                            }
                        },
                        {
                            "text": "Ah <w>vraiment</w>, je ne savais pas que tu partais demain !",
                            "target_lang_translations": {
                                "en": "Oh, <w>really</w>? I didn't know you were leaving tomorrow!",
                                "ru": "Ах, <w>правда</w>? Я не знал, что ты завтра уезжаешь!",
                                "nl": "Ah, <w>echt</w>? Ik wist niet dat je morgen weggaat!",
                                "de": "Ach <w>wirklich</w>? Ich wusste nicht, dass du morgen abreist!",
                                "pl": "Ach, <w>naprawdę</w>? Nie wiedziałem, że jutro wyjeżdżasz!",
                                "it": "Ah <w>davvero</w>, non sapevo che partissi domani!",
                                "cs": "Ach <w>vážně</w>, nevěděl jsem, že zítra odjíždíš!",
                                "tr": "Ah <w>sahi mi</w>, yarın gideceğini bilmiyordum!",
                                "es": "¡Ah, <w>en serio</w>? ¡No sabía que te ibas mañana!",
                                "zh": "啊，<w>是吗</w>？我还不知道你明天要走呢！"
                            }
                        }
