                        "glosses": [
                            "het ontstaan van rook bij een brand"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0bad919-6214-408a-85a5-bcad407f074e",
                                "sense_id": "77f390e2-a728-3f57-97ed-a1c76983b22f",
                                "text": "In Maassluis is op de zolder van een woning brand uitgebroken. Volgens de Veiligheidsregio Rotterdam-Rijnmond ging het om een zeer complexe brand. Bewoners van 20 tot 25 woningen moesten hun huis uit vanwege rookontwikkeling."
                            },
                            {
                                "example_id": "f347e73c-75df-4f03-b225-7e7036a935d2",
                                "sense_id": "77f390e2-a728-3f57-97ed-a1c76983b22f",
                                "text": "Bij de brand kwam geruime tijd veel rook vrij, die onder meer richting de Polderbaan van Schiphol trok. Vanwege de rookontwikkeling besloot Luchtverkeersleiding Nederland de baan op Schiphol tijdelijk te sluiten."
                            }
                        ]
                    }
