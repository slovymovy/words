                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "38bef75b-cb07-4c8d-88f4-1e97e5e9266a",
                                "sense_id": "a248b5c5-dfee-36d5-8b70-ca84872e10be",
