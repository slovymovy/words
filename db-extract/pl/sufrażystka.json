                    }
                ],
                "senses": [
                    {
                        "sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "glosses": [
                            "działaczka walcząca o prawa wyborcze dla kobiet na przełomie XIX i XX wieku (głównie w krajach anglosaskich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fe0b1e2-6f31-46a3-8ae8-b68ceaedce52",
                                "sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                                "text": "Po tym, jak angielska sufrażystka Emmeline Pankhurst poprowadziła marsz na parlament i wraz ze swoimi towarzyszkami stoczyła kilkugodzinną bitwę z policją, było wiadomo, że kobiety już nie ustąpią"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3b4d73bf-36a5-4353-b736-7ea75b5f2992",
                        "source_entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "source_sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "target_lang_word": "suffragette",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffragette",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                                        "entry_id": "89eae3b0-e7a4-326a-91fa-8bb62b012cad",
                                        "glosses": [
                                            "A female supporter, often militant, of women's right to vote in the early 20th century, especially in Great Britain."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f3308d5a-4598-4331-98c2-e396ca968d34",
                                                "sense_id": "c4bb3106-c750-3739-a42a-473497b4f47b",
                                                "text": "Perhaps no single location resonates for women’s rights campaigners today as much as Holloway, the first female-only prison, where militant suffragettes were incarcerated, went on hunger strike and were savagely force-fed."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0b94b2c5-1283-4037-ad7e-c1e8769d9dc5",
                        "source_entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "source_sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "target_lang_word": "sufražetka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufražetka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "738eae15-7889-3891-aa19-740ec98cce7a",
                                        "entry_id": "e6c63cdb-9ee7-391f-b9f3-0afca05b85e6",
                                        "glosses": [
                                            "bojovnice za ženská práva"
                                        ],
                                        "tags": [
                                            "dříve"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "970ae993-7295-4bd7-80ee-421c58794a94",
                                                "sense_id": "738eae15-7889-3891-aa19-740ec98cce7a",
                                                "text": "Přes všechno úsilí si až do první světové války sufražetky volební právo nevybojovaly. Stejně jako jejich předchůdkyně."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f1e57215-e27c-4ce5-a8c3-cb54110a8aa4",
                        "source_entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "source_sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "target_lang_word": "suffragette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "suffragette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                        "entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
                                        "glosses": [
                                            "Femme qui militait pour obtenir le droit de voter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bef4ecbc-791e-480d-9842-e118d3a8481a",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "Bien entendu, je n’entends pas parler, en ces termes flatteurs, des « suffragettes » ni des « sottes pécores » qui rêvent de prendre une part active au « suffrage universel », cet attrape-nigaud sublime grâce auquel un gouvernement français « pince-sans-rire » est arrivé à faire croire aux Français qu’ils se gouvernent eux-mêmes ; je parle ici aux femmes de bon sens, à l’esprit éclairé et scientifique, qui pressentent qu’elles ont une grande et mystérieuse mission à remplir."
                                            },
                                            {
                                                "example_id": "eb9c31ac-ad9b-4208-b51a-dea8d84d013b",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "Or, ce n’est pas seulement dans ce bulletin-là, mais deux fois encore que George Sand se prononça dans la presse contre les réclamations féminines, hors de propos, lorsque les droits de l’homme ne sont pas encore conquis, et en particulier contre le point pour lequel, de nos jours, les suffragettes anglaises combattirent avec une énergie extravagante : contre la participation des femmes aux élections et à la députation."
                                            },
                                            {
                                                "example_id": "e72e2958-11a5-4509-924f-73b493aa99a2",
                                                "sense_id": "d6835d23-0733-37d4-af65-03700095b9b1",
                                                "text": "A l’époque où le suffragettes ont essayé d’investir la Chambre des communes , où elles ont cassé les vitres des bureaux gouvernementaux et des magasins principaux de Londres […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                        "entry_id": "04efa7b5-4947-3aa2-baf5-e32b664b0da3",
                                        "glosses": [
                                            "Féministe, femme qui milite pour l’admission des femmes dans une institution ou un ordre qui lui est jusqu’alors fermé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d75aa1eb-f9b1-4d34-8cec-291821e1619b",
                                                "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                                "text": "Que penseraient-elles de moi, ces dames du « tout-ou-rien », suffragettes intransigeantes de l’amour ?"
                                            },
                                            {
                                                "example_id": "f92d0b27-a6db-42b9-b605-4d374da09861",
                                                "sense_id": "b469729b-a08f-3150-9509-0d66e9910aa8",
                                                "text": "— Je crois qu’elle met de l’argent de côté pour suivre une formation professionnelle.\n— Elle ferait pourtant une bonne épouse…\nSur cette parole qui aurait indigné une suffragette, elle retomba de nouveau dans les bras de Morphée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a5012a1-8609-4b1a-9f9b-94921657f3bb",
                        "source_entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "source_sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "target_lang_word": "sufragista",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sufragista",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "dc54bf0b-5f53-3936-bf27-05077f77093b",
                                        "entry_id": "113a77aa-1007-3145-8835-795c2da1a40a",
                                        "glosses": [
                                            "Relacionado con el sufragismo (movimiento político que reclamaba el voto para las mujeres)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c136e668-97d5-4fde-a219-bf3228b771da",
                                                "sense_id": "dc54bf0b-5f53-3936-bf27-05077f77093b",
                                                "text": "en casi todo el orbe se ridiculizaba a las sufragistas con caricaturas que las representaban como solteronas o como figuras masculinizadas queriendo ocupar el papel de los hombres"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "10e94a0b-7fb3-3f0d-9bc2-4e06c1c0351f",
                                        "entry_id": "113a77aa-1007-3145-8835-795c2da1a40a",
                                        "glosses": [
                                            "En la Inglaterra de principios del siglo XX, partidario de que las mujeres pudieran votar."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9afb8b64-30e4-4f4e-a59a-d6a37b23311e",
                                                "sense_id": "10e94a0b-7fb3-3f0d-9bc2-4e06c1c0351f",
                                                "text": "Margarette Nevinson, sufragista convencida, veía los discursos en la calle como algo vulgar y violento: se había educado a las mujeres en la necesidad de ser discretas fuera de sus hogares, y convertirse en el centro de atención les resultaba, como poco, extraño y vergonzoso"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4b104561-8400-4e06-b1a7-e5f893ce6f42",
                        "source_entry_id": "756bf46d-7ac9-3621-bf1e-d7ea5c2be04c",
                        "source_sense_id": "718f8b17-eaee-35c1-b07d-902761c45cd7",
                        "target_lang_word": "суфражистка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "суфражистка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                        "entry_id": "5b808534-1f33-3532-bf9e-3b72562f86a1",
                                        "glosses": [
                                            "истор. сторонница и участница суфражизма, то есть движения за предоставление женщинам избирательных прав, распространенное во второй половине XIX века"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56f8f17f-cc60-44c1-ac18-e72fcf46411e",
                                                "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                                "text": "Арестовано 121 суфражистка, в том числе их вождь г-жа Пангаерст, которая заявила, что демонстрация произведена с целью «обратить внимание общества на беспомощное положение женщин»."
                                            },
                                            {
                                                "example_id": "52070017-e3e7-4a27-84e7-aaf1fa75bfd8",
                                                "sense_id": "97343c57-9e3f-3ec9-8c32-432f9aac5368",
                                                "text": "Такие слова под стать какой-нибудь суфражистке. А я-то полагал, что вы ветреная Коломбина, игрушка в руках злого Арлекина."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
