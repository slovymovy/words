                {
                    "sense_id": "fc7b6b8b-9499-39c9-9d3f-eff98053c984",
                    "sense_definition": "Used to refer to an indefinite quantity or number, usually in questions or negative sentences.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantifier_existential",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Do you have <w>any</w> brothers or sisters?",
                            "target_lang_translations": {
                                "ru": "У тебя есть <w>какие-нибудь</w> братья или сестры?",
                                "nl": "Heb je <w>enkele</w> broers of zussen?",
                                "pl": "Czy masz <w>jakichś</w> braci lub siostry?",
                                "de": "Hast du <w>irgendwelche</w> Brüder oder Schwestern?",
                                "fr": "As-tu <w>des</w> frères ou des sœurs ?",
                                "it": "Hai <w>dei</w> fratelli o delle sorelle?",
                                "cs": "Máš <w>nějaké</w> bratry nebo sestry?",
                                "tr": "<w>Hiç</w> erkek veya kız kardeşin var mı?",
                                "es": "¿Tienes <w>algún</w> hermano o hermana?"
                            }
                        },
                        {
                            "text": "I do not have <w>any</w> money in my wallet.",
                            "target_lang_translations": {
                                "ru": "У меня в кошельке нет <w>никаких</w> денег.",
                                "nl": "Ik heb <w>geen</w> geld in mijn portemonnee.",
                                "pl": "Nie mam <w>żadnych</w> pieniędzy w portfelu.",
                                "de": "Ich habe <w>kein</w> Geld in meiner Brieftasche.",
                                "fr": "Je n'ai <w>aucun</w> argent dans mon portefeuille.",
                                "it": "Non ho <w>alcun</w> soldo nel portafoglio.",
                                "cs": "Nemám v peněžence <w>žádné</w> peníze.",
                                "tr": "Cüzdanımda <w>hiç</w> para yok.",
                                "es": "No tengo <w>ningún</w> dinero en mi cartera."
                            }
                        }
                    ],
                    "antonyms": [
                        "no"
                    ],
                    "common_phrases": [
                        "any questions",
                        "any idea",
                        "any luck",
                        "any good"
                    ],
                    "target_lang_definitions": {
                        "ru": "Используется для обозначения неопределенного количества или числа, обычно в вопросах или отрицательных предложениях.",
                        "nl": "Gebruikt om te verwijzen naar een onbepaalde hoeveelheid of aantal, meestal in vragen of ontkennende zinnen.",
                        "pl": "Używane do określenia nieokreślonej ilości lub liczby, zazwyczaj w pytaniach lub zdaniach przeczących.",
                        "de": "Wird verwendet, um sich auf eine unbestimmte Menge oder Anzahl zu beziehen, meist in Fragen oder verneinten Sätzen.",
                        "fr": "Utilisé pour désigner une quantité ou un nombre indéterminé, généralement dans des questions ou des phrases négatives.",
                        "it": "Usato per riferirsi a una quantità o numero indefinito, di solito in domande o frasi negative.",
                        "cs": "Používá se k vyjádření neurčitého množství nebo počtu, obvykle v otázkách nebo záporných větách.",
                        "tr": "Genellikle soru veya olumsuz cümlelerde, belirsiz bir miktar veya sayıyı belirtmek için kullanılır.",
                        "es": "Se usa para referirse a una cantidad o número indefinido, generalmente en preguntas o frases negativas."
