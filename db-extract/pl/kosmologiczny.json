                "senses": [
                    {
                        "sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                        "entry_id": "37dc42b8-2fdf-372b-98b0-1b1d09894e2c",
                        "glosses": [
                            "związany z kosmologią, dotyczący kosmologii"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d774fe37-2a84-478a-94ce-23429b4bb768",
                                "sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                                "text": "Argumenty kosmologiczne wychodzą od pewnego oczywistego i ogólnego, ale aposteriorycznego faktu dotyczącego wszechświata, na przykład tego, że istnieją byty przygodne, albo tego, że rzeczy się poruszają lub zmieniają."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f6f29f3a-433a-4d6d-bbcf-747f15b37a6d",
                        "source_entry_id": "37dc42b8-2fdf-372b-98b0-1b1d09894e2c",
                        "source_sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                        "target_lang_word": "cosmological",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cosmological",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3be9780-3256-3007-a94f-7e69a2bc80ec",
                                        "entry_id": "52fd50b9-bebd-3465-8f9c-320187eb7e12",
                                        "glosses": [
                                            "Of or pertaining to cosmology, or to the overall structure of the universe."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b5c377d0-a3a7-4de2-9064-6083c3b6b7ae",
                                                "sense_id": "c3be9780-3256-3007-a94f-7e69a2bc80ec",
                                                "text": "Within the standard cosmological framework, however, the new satellite data underscored the existence of puzzling anomalies that may yet lead theorists back to the drawing board."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "635dabc7-bdfa-4ba0-b3f3-0db5f55b69de",
                        "source_entry_id": "37dc42b8-2fdf-372b-98b0-1b1d09894e2c",
                        "source_sense_id": "ab8a5cb6-13af-3fe5-a67a-bdaf3ecd4dfa",
                        "target_lang_word": "cosmologic",
