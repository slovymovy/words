                "forms": [],
                "senses": [
                    {
                        "sense_id": "da57936a-6f29-3f43-9497-4c19c569e4d7",
                        "entry_id": "441fbfad-0c4a-3458-b877-8ffb402b63bf",
                        "glosses": [
                            "langzaam doorbrandend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "895135e4-ac97-485b-9dfd-a1f31e3c88f6",
                                "sense_id": "da57936a-6f29-3f43-9497-4c19c569e4d7",
                                "text": "Ook bij Boksem strijden opluchting en zorgen om voorrang. Het doorgaan van het vreugdevuur is immers aan strenge voorwaarden verbonden, zoals tank- of gierwagens met voldoende water op het terrein. En bewaking voor het geval er nog smeulende resten zijn die opnieuw oplaaien."
                            },
                            {
                                "example_id": "50107edc-663e-427d-8c70-8e010d52ed8b",
                                "sense_id": "da57936a-6f29-3f43-9497-4c19c569e4d7",
                                "text": "Hoofdschuddend staan Paul Klein Goldewijk en Wilfried Klein Gunnewiek van de organisatie bij de smeulende houtresten op De Maat. Hier en daar brandt nog een plukje, een stevige wind blaast de witte dampen richting woonwijk Op De Bleek."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1ea9f3b-425d-3083-96ab-8ffdaab88c97",
                        "entry_id": "441fbfad-0c4a-3458-b877-8ffb402b63bf",
                        "glosses": [
                            "in het geheim; in het verborgene"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e61cb98-2d12-402e-bfab-4e7103ed07aa",
                        "source_entry_id": "441fbfad-0c4a-3458-b877-8ffb402b63bf",
                        "source_sense_id": "da57936a-6f29-3f43-9497-4c19c569e4d7",
                        "source_sense_description": "langzaam doorbrandend",
                        "target_lang_word": "smouldering",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "smouldering",
                                "target_lang_code": "en",
