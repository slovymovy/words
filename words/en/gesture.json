{
    "word_family": [
        "gestural",
        "gesticulate",
        "gesticulation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cf32aedf-ec12-3cfa-9eae-ac850d0b209e",
                    "sense_definition": "A movement of part of the body, especially a hand or the head, to express an idea or meaning.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She made a <w>gesture</w> of annoyance with her hand.",
                            "target_lang_translations": {
                                "ru": "Она сделала <w>жест</w> раздражения рукой.",
                                "zh": "她用手做了一个表示恼火的<w>手势</w>。"
                            }
                        },
                        {
                            "text": "He communicated with a simple <w>gesture</w>.",
                            "target_lang_translations": {
                                "ru": "Он объяснился простым <w>жестом</w>.",
                                "zh": "他用一个简单的<w>手势</w>表达了意思。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "make a gesture",
                        "hand gesture",
                        "dramatic gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение частью тела, особенно рукой или головой, для выражения идеи или смысла.",
                        "zh": "用身体的一部分，尤其是手或头的动作，来表达某种想法或意思。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "движение тела"
                            },
                            {
                                "target_lang_word": "телодвижение",
                                "target_lang_sense_clarification": "физическое движение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手势",
                                "target_lang_sense_clarification": "用身体部位表达意思，尤指手部动作"
                            },
                            {
                                "target_lang_word": "示意动作",
                                "target_lang_sense_clarification": "表示某种意思或情绪的身体动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "53146f17-ba40-338a-af61-bc1ade3c6ec1",
                    "sense_definition": "An action performed to convey a feeling or intention, often as a formality.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sending flowers was a lovely <w>gesture</w>.",
                            "target_lang_translations": {
                                "ru": "Отправка цветов была красивым <w>жестом</w>.",
                                "zh": "送花是个很贴心的<w>举动</w>。"
                            }
                        },
                        {
                            "text": "It was a <w>gesture</w> of peace between the two countries.",
                            "target_lang_translations": {
                                "ru": "Это был <w>жест</w> мира между двумя странами.",
                                "zh": "这是两国之间表示和平的<w>姿态</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gesture of goodwill",
                        "gesture of support",
                        "nice gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие, совершаемое для выражения чувства или намерения, часто как формальность.",
                        "zh": "为传达某种感情或意图而做出的行为，常常带有礼节性或象征性。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "поступок с подтекстом"
                            },
                            {
                                "target_lang_word": "поступок",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "举动",
                                "target_lang_sense_clarification": "为表达情感、态度或意图而做出的行为"
                            },
                            {
                                "target_lang_word": "姿态",
                                "target_lang_sense_clarification": "带有象征性或礼节意味的表示"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c42a0489-cb7d-3223-8ec4-f6134e0cabfa",
                    "sense_definition": "A specific movement on a touchscreen or with a device that a computer recognizes as a command.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can zoom in using a pinch <w>gesture</w>.",
                            "target_lang_translations": {
                                "ru": "Вы можете увеличить масштаб, используя <w>жест</w> сведения пальцев.",
                                "zh": "你可以用捏合<w>手势</w>来放大。"
                            }
                        },
                        {
                            "text": "The app supports various multi-touch <w>gestures</w>.",
                            "target_lang_translations": {
                                "ru": "Приложение поддерживает различные мультитач-<w>жесты</w>.",
                                "zh": "这个应用支持各种多点触控<w>手势</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mouse gesture",
                        "swipe gesture",
                        "touch gesture"
                    ],
                    "target_lang_definitions": {
                        "ru": "Особое движение по сенсорному экрану или с устройством, распознаваемое компьютером как команда.",
                        "zh": "在触摸屏上或使用设备时做出的、能被计算机识别为指令的特定动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жест",
                                "target_lang_sense_clarification": "команда интерфейса"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手势",
                                "target_lang_sense_clarification": "触摸屏或设备上可被识别为指令的操作动作"
                            },
                            {
                                "target_lang_word": "手势操作",
                                "target_lang_sense_clarification": "用于操控界面的手部操作方式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "768afe71-b9f8-3944-a610-7be1225e0c6b",
                    "sense_definition": "The manner of carrying the body; position of the body or limbs.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "4",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His noble <w>gesture</w> commanded respect from the crowd.",
                            "target_lang_translations": {
                                "ru": "Его благородная <w>осанка</w> внушала уважение толпе.",
                                "zh": "他高贵的<w>仪态</w>令众人肃然起敬。"
                            }
                        },
                        {
                            "text": "The knight stood with a proud <w>gesture</w>.",
                            "target_lang_translations": {
                                "ru": "Рыцарь стоял в гордой <w>позе</w>.",
                                "zh": "骑士以骄傲的<w>姿态</w>站着。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Манера держать тело; положение тела или конечностей.",
                        "zh": "身体的保持方式；身体或四肢所处的姿势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поза",
                                "target_lang_sense_clarification": "положение тела"
                            },
                            {
                                "target_lang_word": "осанка",
                                "target_lang_sense_clarification": "манера держаться"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "姿态",
                                "target_lang_sense_clarification": "身体或四肢所呈现出的样子"
                            },
                            {
                                "target_lang_word": "仪态",
                                "target_lang_sense_clarification": "举止和身体姿势所表现出的风度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ffc7c6e-45f2-3d35-ae0e-e5698c2a7b77",
                    "sense_definition": "To move the hands, head, or body to express an idea or feeling.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My dad told me never to <w>gesture</w> with my hands when I talk.",
                            "target_lang_translations": {
                                "ru": "Папа говорил мне никогда не <w>жестикулировать</w> руками во время разговора.",
                                "zh": "我爸爸告诉我说话时别总是<w>打手势</w>。"
                            }
                        },
                        {
                            "text": "She <w>gestured</w> at the empty chair.",
                            "target_lang_translations": {
                                "ru": "Она <w>указала</w> на пустой стул.",
                                "zh": "她朝那把空椅子<w>比画</w>了一下。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gesticulate"
                    ],
                    "common_phrases": [
                        "gesture wildly",
                        "gesture towards"
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигать руками, головой или телом для выражения идеи или чувства.",
                        "zh": "通过手、头或身体的动作来表达某种想法或感情。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестикулировать",
                                "target_lang_sense_clarification": "активно двигать руками"
                            },
                            {
                                "target_lang_word": "делать жесты",
                                "target_lang_sense_clarification": "совершать движения"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "打手势",
                                "target_lang_sense_clarification": "用手、头或身体动作表达意思或情感"
                            },
                            {
                                "target_lang_word": "比画",
                                "target_lang_sense_clarification": "用动作进行示意"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8aab2f84-77f1-301c-9827-d301826c13b1",
                    "sense_definition": "To direct or invite someone to do something by making a motion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The waiter <w>gestured</w> us to a table near the window.",
                            "target_lang_translations": {
                                "ru": "Официант <w>жестом указал</w> нам на столик у окна.",
                                "zh": "服务员<w>示意</w>我们去窗边的一张桌子。"
                            }
                        },
                        {
                            "text": "She <w>gestured</w> him to come closer.",
                            "target_lang_translations": {
                                "ru": "Она <w>подозвала</w> его поближе жестом.",
                                "zh": "她<w>招手让</w>他走近一点。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "gesture to someone",
                        "gesture for silence"
                    ],
                    "target_lang_definitions": {
                        "ru": "Указывать или приглашать кого-то сделать что-то с помощью движения.",
                        "zh": "通过一个动作来指引或示意某人做某事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "указывать",
                                "target_lang_sense_clarification": "направлять жестом"
                            },
                            {
                                "target_lang_word": "подавать знак",
                                "target_lang_sense_clarification": "сигнализировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "示意",
                                "target_lang_sense_clarification": "用动作引导、指示或示意别人做某事"
                            },
                            {
                                "target_lang_word": "招手让",
                                "target_lang_sense_clarification": "用手势招呼别人进行某动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "46805cfe-2340-30ee-9b1e-bc708fb125b8",
                    "sense_definition": "To express a feeling or idea through a physical movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>gestured</w> his disgust.",
                            "target_lang_translations": {
                                "ru": "Он <w>выразил жестом</w> свое отвращение.",
                                "zh": "他用动作<w>表示</w>了自己的厌恶。"
                            }
                        },
                        {
                            "text": "The player <w>gestured</w> his frustration to the referee.",
                            "target_lang_translations": {
                                "ru": "Игрок <w>показал жестом</w> свое разочарование судье.",
                                "zh": "那名球员向裁判用手势<w>表达</w>了自己的懊恼。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выражать чувство или идею через физическое движение.",
                        "zh": "通过身体动作来表达某种感情或意思。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выражать жестом",
                                "target_lang_sense_clarification": "показывать чувства"
                            },
                            {
                                "target_lang_word": "показывать",
                                "target_lang_sense_clarification": "демонстрировать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "表示",
                                "target_lang_sense_clarification": "通过动作或手势表达情感或意思"
                            },
                            {
                                "target_lang_word": "表达",
                                "target_lang_sense_clarification": "借助身体动作把感受或想法传达出来"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a43ba02a-7b3c-3d96-a40c-1270f244547f",
                    "sense_definition": "To accompany or illustrate speech with action.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The orator <w>gestured</w> every point of his speech.",
                            "target_lang_translations": {
                                "ru": "Оратор <w>сопровождал жестами</w> каждый пункт своей речи.",
                                "zh": "演说者讲到每一点时都<w>用手势配合</w>。"
                            }
                        },
                        {
                            "text": "It is not orderly read nor <w>gestured</w> as beseemeth.",
                            "target_lang_translations": {
                                "ru": "Это не читается по порядку и не <w>сопровождается жестами</w>, как подобает.",
                                "zh": "这篇东西读起来不合章法，也不<w>用手势配合</w>，和应有的样子不符。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сопровождать или иллюстрировать речь действиями.",
                        "zh": "用动作来配合或说明言语内容。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жестикулировать",
                                "target_lang_sense_clarification": "сопровождать речь жестами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "用手势配合",
                                "target_lang_sense_clarification": "说话时以手势作辅助说明"
                            },
                            {
                                "target_lang_word": "配以手势",
                                "target_lang_sense_clarification": "用动作来配合讲话或说明内容"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}