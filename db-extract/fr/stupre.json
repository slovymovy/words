                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "69940f5c-e3dd-3598-ba48-760aaca636c9",
                                        "entry_id": "b18a640c-18da-3928-8237-7ae74034abb7",
                                        "glosses": [
                                            "sexueller Missbrauch; Vergewaltigung"
                                        ],
                                        "tags": [
                                            "veraltet insbesondere"
                                        ],
                                        "examples": [
                                            {
