                "pos": "name",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "3c172cff-17e6-4c30-8f55-2d825ca891ab",
                        "entry_id": "c49f21ab-1660-32a6-9037-66f0e313356c",
