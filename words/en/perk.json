{
    "word_family": [
        "perky",
        "perkiness",
        "percolate",
        "percolation"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a2c989e-e455-3b6e-aa15-8afc03c6f37c",
                    "sense_definition": "An extra benefit or advantage given to an employee in addition to their salary.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "benefits",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Free coffee is one of the <w>perks</w> of the job.",
                            "target_lang_translations": {
                                "cs": "Káva zdarma je jedním z <w>zaměstnaneckých benefitů</w> této práce."
                            }
                        },
                        {
                            "text": "Company cars and health insurance are common <w>perks</w> for executives.",
                            "target_lang_translations": {
                                "cs": "Firemní auta a zdravotní pojištění jsou běžné <w>benefity</w> pro vedoucí pracovníky."
                            }
                        }
                    ],
                    "synonyms": [
                        "benefit",
                        "bonus",
                        "advantage"
                    ],
                    "common_phrases": [
                        "job perks"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dodatečná výhoda nebo benefit poskytovaný zaměstnanci nad rámec platu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zaměstnanecký benefit",
                                "target_lang_sense_clarification": "obecné označení pro výhody v práci"
                            },
                            {
                                "target_lang_word": "výhoda",
                                "target_lang_sense_clarification": "obecný význam výhody"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0666429f-ac10-3a59-bd4b-7f9b6c51abe1",
                    "sense_definition": "A special ability or bonus power that a character can gain in a video game.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The player unlocked a new <w>perk</w> that increases movement speed.",
                            "target_lang_translations": {
                                "cs": "Hráč odemkl nový <w>perk</w>, který zvyšuje rychlost pohybu."
                            }
                        },
                        {
                            "text": "Choosing the right <w>perks</w> is essential for winning the game.",
                            "target_lang_translations": {
                                "cs": "Výběr správných <w>perků</w> je pro vítězství ve hře zásadní."
                            }
                        }
                    ],
                    "synonyms": [
                        "bonus",
                        "power-up"
                    ],
                    "common_phrases": [
                        "unlock perks"
                    ],
                    "target_lang_definitions": {
                        "cs": "Speciální schopnost nebo bonus, který může postava získat ve videohře."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "perk",
                                "target_lang_sense_clarification": "přejatý termín používaný v herní komunitě"
                            },
                            {
                                "target_lang_word": "bonusová schopnost",
                                "target_lang_sense_clarification": "popisný název pro herní vylepšení"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "64e209e4-c725-37d1-a736-740ccca2baa0",
                    "sense_definition": "A coffee maker that uses a percolator to brew coffee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "kitchenware",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She cleaned the old <w>perk</w> before making breakfast.",
                            "target_lang_translations": {
                                "cs": "Před snídaní vyčistila starý <w>perkolátor</w>."
                            }
                        },
                        {
                            "text": "The kitchen counter was cluttered with a toaster and a <w>perk</w>.",
                            "target_lang_translations": {
                                "cs": "Kuchyňská linka byla zastavěná toustovačem a <w>perkolátorem</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "percolator"
                    ],
                    "target_lang_definitions": {
                        "cs": "Kávovar, který využívá perkolátor k přípravě kávy."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "perkolátor",
                                "target_lang_sense_clarification": "přístroj na přípravu kávy"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a835272-ca5b-303f-a745-74afbfa0f5fe",
                    "sense_definition": "To prepare coffee using a percolator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I will <w>perk</w> some fresh coffee for the guests.",
                            "target_lang_translations": {
                                "cs": "Hostům <w>překapu</w> čerstvou kávu."
                            }
                        },
                        {
                            "text": "It takes a few minutes to <w>perk</w> a strong pot of coffee.",
                            "target_lang_translations": {
                                "cs": "Příprava silné konvice kávy <w>překapáním</w> trvá několik minut."
                            }
                        }
                    ],
                    "synonyms": [
                        "brew"
                    ],
                    "common_phrases": [
                        "perk coffee"
                    ],
                    "target_lang_definitions": {
                        "cs": "Připravovat kávu pomocí perkolátoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "překapávat",
                                "target_lang_sense_clarification": "příprava kávy v kávovaru"
                            },
                            {
                                "target_lang_word": "vařit",
                                "target_lang_sense_clarification": "obecný význam přípravy kávy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cd0c41fe-0278-341d-a181-5183b07a9e44",
                    "sense_definition": "To be in the process of being brewed in a percolator.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The coffee is <w>perking</w> in the kitchen right now.",
                            "target_lang_translations": {
                                "cs": "Káva se právě v kuchyni <w>překapává</w>."
                            }
                        },
                        {
                            "text": "While the coffee <w>perked</w>, she read the morning news.",
                            "target_lang_translations": {
                                "cs": "Zatímco se káva <w>překapávala</w>, četla si ranní zprávy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "coffee perking"
                    ],
                    "target_lang_definitions": {
                        "cs": "Být v procesu přípravy v perkolátoru."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "překapávat se",
                                "target_lang_sense_clarification": "proces přípravy kávy"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bcfd6508-f097-3f88-8179-2bdc1c0153ac",
                    "sense_definition": "To lift or straighten up, often to show interest or alertness.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The dog <w>perked</w> its ears when it heard the door open.",
                            "target_lang_translations": {
                                "cs": "Pes <w>nastražil</w> uši, když uslyšel otevření dveří."
                            }
                        },
                        {
                            "text": "She <w>perked</w> her head up at the sound of her name.",
                            "target_lang_translations": {
                                "cs": "Při zaslechnutí svého jména <w>vztyčila</w> hlavu."
                            }
                        }
                    ],
                    "synonyms": [
                        "prick",
                        "erect"
                    ],
                    "common_phrases": [
                        "perk ears"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvednout nebo napřímit, často pro vyjádření zájmu nebo pozornosti."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "nastražit",
                                "target_lang_sense_clarification": "používá se zejména ve spojení s ušima"
                            },
                            {
                                "target_lang_word": "vztyčit",
                                "target_lang_sense_clarification": "zvednutí hlavy nebo uší"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5686f2d1-7bd6-320a-b307-0dc21dd774cb",
                    "sense_definition": "To appear or emerge suddenly from behind or below something.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Small green shoots <w>perked</w> through the soil after the rain.",
                            "target_lang_translations": {
                                "cs": "Po dešti <w>vyrazily</w> z půdy malé zelené výhonky."
                            }
                        },
                        {
                            "text": "A small feather <w>perked</w> from her hat as she walked by.",
                            "target_lang_translations": {
                                "cs": "Když procházela kolem, z klobouku jí <w>vyčnívalo</w> malé pírko."
                            }
                        }
                    ],
                    "synonyms": [
                        "emerge",
                        "pop up"
                    ],
                    "target_lang_definitions": {
                        "cs": "Náhle se objevit nebo vykouknout zpoza něčeho."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "vykouknout",
                                "target_lang_sense_clarification": "objevit se zpoza něčeho"
                            },
                            {
                                "target_lang_word": "vyrazit",
                                "target_lang_sense_clarification": "v kontextu rostlin"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "83758068-5396-3252-a496-e7aee03c0655",
                    "sense_definition": "Having a smart, jaunty, or spruce appearance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bird looked <w>perk</w> as it sat on the fence.",
                            "target_lang_translations": {
                                "cs": "Pták vypadal na plotě <w>švihácky</w>."
                            }
                        },
                        {
                            "text": "He wore a <w>perk</w> hat that made him look quite stylish.",
                            "target_lang_translations": {
                                "cs": "Měl na sobě <w>švihácký</w> klobouk, díky kterému vypadal velmi stylově."
                            }
                        }
                    ],
                    "synonyms": [
                        "jaunty",
                        "spruce"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely outdated."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mít elegantní, švihácký nebo upravený vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "švihácký",
                                "target_lang_sense_clarification": "elegantní a stylový vzhled"
                            },
                            {
                                "target_lang_word": "upravený",
                                "target_lang_sense_clarification": "úhledný vzhled"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}