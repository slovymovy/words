                    "sense_id": "1b2ef974-e631-3a5f-84cb-09420e8112f9",
                    "sense_definition": "rozłączać, izolować lub rozgraniczać jedną rzecz od drugiej",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "rozdzielanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wysoki płot skutecznie <w>oddziela</w> nasz ogród od ruchliwej ulicy.",
                            "target_lang_translations": {
                                "ru": "Высокий забор надёжно <w>отделяет</w> наш сад от оживлённой улицы."
                            }
                        },
                        {
                            "text": "Podczas przygotowywania ciasta musisz ostrożnie <w>oddzielać</w> żółtka od białek.",
                            "target_lang_translations": {
                                "ru": "При приготовлении теста нужно аккуратно <w>отделять</w> желтки от белков."
                            }
                        }
                    ],
                    "synonyms": [
                        "rozdzielać",
                        "separować",
                        "odgraniczać"
                    ],
                    "antonyms": [
                        "łączyć"
                    ],
                    "common_phrases": [
                        "oddzielać grubą kreską",
                        "oddzielać żółtka od białek"
                    ],
                    "target_lang_definitions": {
                        "ru": "разъединять, изолировать или разграничивать предметы, части или пространства"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделять",
                                "target_lang_sense_clarification": "разграничивать, создавать преграду или делить на составные части"
                            },
                            {
                                "target_lang_word": "разделять",
                                "target_lang_sense_clarification": "служить границей между чем-либо"
                            },
                            {
                                "target_lang_word": "отграничивать",
                                "target_lang_sense_clarification": "устанавливать границу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0fa22857-3f30-3540-b3a7-36c5266af64e",
                    "sense_definition": "separować kogoś od innych ludzi lub wyłączać z określonej grupy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozdzielanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Lekarze musieli natychmiast <w>oddzielać</w> chorych pacjentów od zdrowych osób.",
                            "target_lang_translations": {
                                "ru": "Врачи должны были немедленно <w>изолировать</w> больных пациентов от здоровых людей."
                            }
                        },
                        {
                            "text": "Wychowawca nie powinien <w>oddzielać</w> tego chłopca od reszty grupy.",
                            "target_lang_translations": {
                                "ru": "Воспитателю не следует <w>отделять</w> этого мальчика от остальной группы."
                            }
                        }
                    ],
                    "synonyms": [
                        "izolować",
                        "separować"
                    ],
                    "antonyms": [
                        "integrować"
                    ],
                    "common_phrases": [
                        "oddzielać od grupy"
                    ],
                    "target_lang_definitions": {
                        "ru": "изолировать кого-либо от других людей или исключать из группы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отделять",
                                "target_lang_sense_clarification": "держать порознь от других"
                            },
                            {
                                "target_lang_word": "изолировать",
                                "target_lang_sense_clarification": "ограничивать контакты с остальными"
                            },
                            {
                                "target_lang_word": "отстранять",
                                "target_lang_sense_clarification": "держать на расстоянии от группы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "637a6abc-2552-3612-9e78-53cf4e2abfa6",
                    "sense_definition": "powodować, że pewien fragment przestaje tworzyć całość z resztą obiektu",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rozdzielanie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kucharz zaczął powoli <w>oddzielać</w> mięso od kości ostrym nożem.",
                            "target_lang_translations": {
                                "ru": "Повар начал медленно <w>отделять</w> мясо от кости острым ножом."
                            }
                        },
                        {
                            "text": "Robotnicy musieli ostrożnie <w>oddzielać</w> stare warstwy farby od ściany.",
                            "target_lang_translations": {
                                "ru": "Рабочим приходилось осторожно <w>отслаивать</w> старые слои краски от стены."
                            }
                        }
                    ],
                    "synonyms": [
