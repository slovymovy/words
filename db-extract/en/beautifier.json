    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "48e5bde3-1d9e-3a04-95ff-260361c4cd4e",
                "word": "beautifier",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "6bba1000-12d3-401a-b9d2-1d70e52b3392",
                        "entry_id": "48e5bde3-1d9e-3a04-95ff-260361c4cd4e",
                        "tags": [
                            "plural"
                        ],
                        "form": "beautifiers"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                        "entry_id": "48e5bde3-1d9e-3a04-95ff-260361c4cd4e",
                        "glosses": [
                            "A person who or a thing which beautifies or makes beautiful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b877161-b6fd-410c-bd9d-a0b36209f4fd",
                                "sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                                "text": "Anthonie Becke […] was (by the report of Iohn Leland) either the very Author, or the first beautifier, of this the Princes house here at Eltham, also."
                            },
                            {
                                "example_id": "ecb23552-b987-4ff0-ae3f-701e8b966b47",
                                "sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                                "text": "1753, Arthur Murphy, The Gray’s Inn Journal, No. 24, 31 March, 1753, in Volume 1, London: P. Vaillant, 1756, p. 160,\nTo cultivate, therefore, and cherish the natural Affections, to direct them to worthy Objects, to keep them all in Harmony, so that not one of them shall grow out of due Proportion, or contract any whimsical Habit, is the best Preserver and Beautifier of the female Form, it gives that pleasing Turn of Mind which we call Sweetness of Temper, prevents Wrinkles, Distortion of the Features, and gives an agreeable Air to the whole Person […]"
                            },
                            {
                                "example_id": "780fd6f1-5582-4cf3-8908-4cabb40cc10e",
                                "sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                                "text": "The sea is no beautifier, certainly; sailors do grow old betimes; I have often observed it; they soon lose the look of youth."
                            },
                            {
                                "example_id": "24b99253-c326-402a-a0ad-d651da104796",
                                "sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                                "text": "Meg had spent the time in working as well as waiting, growing womanly in character, wise in housewifery arts, and prettier than ever; for love is a great beautifier."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6c7e2be-b20c-4cb7-8d5e-6cd2e1e5e4fc",
                        "source_entry_id": "48e5bde3-1d9e-3a04-95ff-260361c4cd4e",
                        "source_sense_id": "9eca6643-3302-3b69-9c19-48451219e898",
                        "source_sense_description": "someone or something which makes beautiful",
