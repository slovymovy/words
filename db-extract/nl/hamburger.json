                                        "sense_id": "a88692a9-b2a1-39cf-a717-dcc71d9ac265",
                                        "entry_id": "f6649d07-03b6-371f-bfe1-9381760c9e1e",
                                        "glosses": [
                                            "Sandwich composé de deux pains ronds, généralement garnis d'une galette de viande hachée, de crudités et d'une sauce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2d9650e-fb11-4c3c-8ada-7a0b1c969c46",
                                                "sense_id": "a88692a9-b2a1-39cf-a717-dcc71d9ac265",
                                                "text": "À côté du vaste océan, flottent de petits océans d'odeurs, fritures italiennes, sauces anglaises, hamburgers et saucisses allemandes."
                                            },
                                            {
                                                "example_id": "d25b5415-3759-4cb9-9e4a-1d21c606c37a",
                                                "sense_id": "a88692a9-b2a1-39cf-a717-dcc71d9ac265",
                                                "text": "Lula prit un chickenburger, moi un cheeseburger, Cal et Junior, rien. Je suppose qu'ils ne mangent jamais pendant le service. Ils ne veulent pas avoir les mains prises par un hamburger au cas où ils devraient dégainer leur arme."
                                            },
                                            {
                                                "example_id": "b0513c9c-9958-44ec-91c2-2f9e440af71c",
                                                "sense_id": "a88692a9-b2a1-39cf-a717-dcc71d9ac265",
                                                "text": "La restauration rapide est le lieu de la transgression ordinaire. On y joue avec la nourriture, on y mange avec les mains, dans une espèce de corps-à-corps avec le hamburger."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
