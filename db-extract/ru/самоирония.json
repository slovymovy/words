                                    },
                                    {
                                        "sense_id": "17243f37-91dd-3db0-b0ba-40d883f39d63",
                                        "entry_id": "50434528-726f-3c88-845c-8cdfed5c752a",
                                        "glosses": [
                                            "scherzare lievemente, quasi sino al punto di provare disagio però invero con equilibrio e sane risa"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43f6ceb7-8d9d-4d27-bb85-43d7e94b04b6",
                                                "sense_id": "17243f37-91dd-3db0-b0ba-40d883f39d63",
                                                "text": "con autoironia si è vestito da donna per fare un po' ridere gli amici"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b225c94c-d892-3699-b615-4f22d345a4bd",
                                        "entry_id": "50434528-726f-3c88-845c-8cdfed5c752a",
                                        "glosses": [
                                            "prendersi un po' in giro, sinonimo di autoironismo [fonte: G.F., nuovo dizionario degli italiani]"
                                        ],
                                        "tags": [
                                            "familiare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3bcc2f2-00e1-4cdf-851e-7d1e3b2dc6a0",
                                                "sense_id": "b225c94c-d892-3699-b615-4f22d345a4bd",
                                                "text": "\"Pipetto è così serioso, fissato e frustrato, nonché fanatico, da non concepire nemmeno cosa sia l'autoironia!\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa407c61-0c5d-43b0-8147-6967b8d7512a",
                        "source_entry_id": "4afb98fd-8e5d-31ae-ba43-f6de705b2c99",
                        "source_sense_id": "0c20fe7f-aa24-3782-b370-8530c61e0362",
                        "target_lang_word": "Selbstironie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Selbstironie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                        "entry_id": "7f288d52-8985-3178-9696-1bafa2eb64a3",
                                        "glosses": [
                                            "Ironie, die sich auf die eigenen Ansichten, Werte oder Handlungen bezieht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d9550793-1229-4b20-b23e-532c73735aec",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "Peter liebt die Selbstironie, er nimmt sich immer wieder gekonnt selbst auf den Arm."
                                            },
                                            {
                                                "example_id": "19619216-53e4-47e9-b0f5-9bccf14de90d",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "Da ist wenig zu merken vom Wortwitz, von der Selbstironie und der Frechheit, die ihm Freunde attestieren."
                                            },
                                            {
                                                "example_id": "43f9dcc7-22d3-400c-a512-0c4545e71eb4",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Sie verfolgen stattdessen eine Karriere als Unternehmerin, Designerin und Anwältin, wobei ihnen, wie den meisten Männern, dabei erst die Leichtigkeit und dann die Selbstironie abhandenkommt.“"
                                            },
                                            {
                                                "example_id": "e583504d-9966-4bdc-8626-d53ab606444e",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Er lachte voller Selbstironie und fummelte dann an den Knöpfen des Autoradios herum.“"
                                            },
                                            {
                                                "example_id": "1ea92cc9-31f1-432e-acde-1a700d94e4a8",
                                                "sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
                                                "text": "„Man kann sagen, mit den Juden reisten ihr Witz, ihre skeptische Klugheit, ihre Selbstironie und ihre Geschicklichkeit.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8422eca-31d5-4b54-89a5-a291f4c88cdf",
                        "source_entry_id": "4afb98fd-8e5d-31ae-ba43-f6de705b2c99",
                        "source_sense_id": "0c20fe7f-aa24-3782-b370-8530c61e0362",
                        "target_lang_word": "zelfspot",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zelfspot",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                        "entry_id": "d7646115-647d-3f66-a1aa-41f4bf0c13c1",
                                        "glosses": [
                                            "jezelf belachelijk maken met humoristische intentie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47abc406-8771-4e94-b5ae-7f9ab3644c31",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "Want het is zeer goed mogelijk even fijn uit te spinnen en toch wijs te blijven, wanneer men slechts een tintje van zelf-ironie, een tintje van zelfspot, een greintje gelach over de eigen doordraverij in zijn werk brengt."
                                            },
                                            {
                                                "example_id": "b3c52abd-c8f8-4544-8332-e0ecbdcea50f",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "Zelfspot (zelfhumor) is zeer gezond. Zichzelf wat kunnen relativeren is een gezonde reflex in een maatschappij die kreunt onder prestatiedruk. Dat de anderen mijn zelfspot beamen, moet ik er maar bij nemen."
                                            },
                                            {
                                                "example_id": "b251b558-a475-4423-a363-0aa26b36d5ea",
                                                "sense_id": "b9829ebe-145f-3bad-bfdb-62c5fdf8f65b",
                                                "text": "De beroemdste sprekers hebben in elk geval dit met elkaar gemeen: ze hebben een goed ontwikkeld gevoel voor humor en zijn niet bang voor een beetje zelfspot. Door zelfspot wordt de afstand tussen publiek en spreker verkleind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "75979ed3-64f3-4d6c-880f-b1b400f2d039",
                        "source_entry_id": "4afb98fd-8e5d-31ae-ba43-f6de705b2c99",
                        "source_sense_id": "0c20fe7f-aa24-3782-b370-8530c61e0362",
