                "senses": [
                    {
                        "sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                        "entry_id": "83181052-87e2-3632-9fd2-fbd99029b2a1",
                        "glosses": [
                            "algemene term voor personen, huishoudens die goederen en diensten verbruiken die worden geproduceerd in de economie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33a20129-d3dd-443c-84ae-a66370fb747e",
                                "sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                                "text": "De consument merkt weinig van de daling van de olieprijzen."
                            },
                            {
                                "example_id": "154da6b6-b8f7-460b-85dc-d96e031b20ad",
                                "sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                                "text": "Ten eerste was er het conservatieve vakantiegedrag van de consument waardoor te veel geld in verkeerde zakken terechtkwam."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "997be51f-ff92-4992-8f04-0e085e056efd",
                        "source_entry_id": "83181052-87e2-3632-9fd2-fbd99029b2a1",
                        "source_sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                        "source_sense_description": "algemene term voor personen, huishoudens die goederen en diensten verbruiken ...",
                        "target_lang_word": "Konsument",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konsument",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4c64b06a-8e0a-3b83-ba70-108b600767d9",
                                        "entry_id": "605faaf4-0441-3a5d-9a2e-b611252416ab",
                                        "glosses": [
                                            "Person, die etwas verbraucht, konsumiert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62ab3821-9dc4-43b8-92d4-da23ebd5d339",
                                                "sense_id": "4c64b06a-8e0a-3b83-ba70-108b600767d9",
                                                "text": "Ich, als Konsument, kaufe, was billig ist."
                                            },
                                            {
                                                "example_id": "9cb8e5df-c563-4f96-bd0f-d080a6226b0e",
                                                "sense_id": "4c64b06a-8e0a-3b83-ba70-108b600767d9",
                                                "text": "„Die Schöne Frau war zwar der Ansicht, dass der eine oder andere Konsument aus medizinischen Gründen absolut keinen Liter Zuckerlösung zu sich nehmen sollte, aber das behielt sie für sich.“"
                                            },
                                            {
                                                "example_id": "a166d5e8-ef4e-4fcf-bb15-0e0594457070",
                                                "sense_id": "4c64b06a-8e0a-3b83-ba70-108b600767d9",
                                                "text": "„Der typische saudische Konsument ist männlich, zwischen 20 und 30 Jahre alt, frustriert von der Verbotskultur seines Landes und gut bei Kasse.“"
                                            },
                                            {
                                                "example_id": "709f5899-eb7d-42f2-8356-659d57e44555",
                                                "sense_id": "4c64b06a-8e0a-3b83-ba70-108b600767d9",
                                                "text": "„Die Hinrichtung erledigen die Konsumenten dann später ohnehin selbst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4d305003-5ddf-3ea8-9ad7-6addeb613c15",
                                        "entry_id": "605faaf4-0441-3a5d-9a2e-b611252416ab",
                                        "glosses": [
                                            "Tiere in einem Ökosystem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e23bbc7-167d-42df-bbc9-62f9f6fa0542",
                                                "sense_id": "4d305003-5ddf-3ea8-9ad7-6addeb613c15",
                                                "text": "Alle Konsumenten, die anderen als Nahrung dienen, werden auch als Sekundärproduzenten bezeichnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "910bc1ef-7f77-419c-90c1-37461e4f8fae",
                        "source_entry_id": "83181052-87e2-3632-9fd2-fbd99029b2a1",
                        "source_sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                        "source_sense_description": "algemene term voor personen, huishoudens die goederen en diensten verbruiken ...",
                        "target_lang_word": "consumer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consumer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4dd7249d-0298-3910-8a84-02f735a7c34c",
                                        "entry_id": "1bdfc660-20e6-3f53-8245-6eb7cd9d21f8",
                                        "glosses": [
                                            "One who, or that which, consumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f80904c-d7d8-4c9a-896c-b01e31a7220e",
                                                "sense_id": "4dd7249d-0298-3910-8a84-02f735a7c34c",
                                                "text": "But through the oligopoly, charcoal fuel proliferated throughout London's trades and industries. By the 1200s, brewers and bakers, tilemakers, glassblowers, pottery producers, and a range of other craftsmen all became hour-to-hour consumers of charcoal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4127e714-4004-3666-92e5-495310811437",
                                        "entry_id": "1bdfc660-20e6-3f53-8245-6eb7cd9d21f8",
                                        "glosses": [
                                            "Someone who trades money for goods or services as an individual."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cef24e3d-5c53-4a96-a605-6a47c4413952",
                                                "sense_id": "4127e714-4004-3666-92e5-495310811437",
                                                "text": "This new system favours the consumer over the producer."
                                            },
                                            {
                                                "example_id": "4d558263-b59c-49a2-b702-d26306928c01",
                                                "sense_id": "4127e714-4004-3666-92e5-495310811437",
                                                "text": "Almost two-thirds of American consumers have at least one unspent gift card tucked away in a drawer, pocket, wallet or purse."
                                            },
                                            {
                                                "example_id": "bfd18e8f-cfe0-4cb2-9d9c-956c74f214f5",
                                                "sense_id": "4127e714-4004-3666-92e5-495310811437",
                                                "text": "A second estimate of gross domestic product, released Thursday, showed that consumer spending was weaker in the first three months of the year than initially reported."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "399f5fb3-7038-3220-b2a7-e6d51e0d7c10",
                                        "entry_id": "1bdfc660-20e6-3f53-8245-6eb7cd9d21f8",
                                        "glosses": [
                                            "The consumer base of a product, service or business."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95b23743-4ac1-4d9c-b50d-e13380915dba",
                                                "sense_id": "399f5fb3-7038-3220-b2a7-e6d51e0d7c10",
                                                "text": "Our consumers are upwardly mobile and middle-class."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32d6b7e2-2219-3cca-bb4e-8de7f7d479b6",
                                        "entry_id": "1bdfc660-20e6-3f53-8245-6eb7cd9d21f8",
                                        "glosses": [
                                            "An organism (heterotroph) that uses other organisms for food in order to gain energy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8b0dcce1-ff33-4724-8218-ab4514b8f22d",
                        "source_entry_id": "83181052-87e2-3632-9fd2-fbd99029b2a1",
                        "source_sense_id": "d0f76991-fc2e-308d-94e6-1c3503474e78",
                        "source_sense_description": "algemene term voor personen, huishoudens die goederen en diensten verbruiken ...",
                        "target_lang_word": "consommateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "consommateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40e721b5-a16a-3390-8aa1-f5190e3fc137",
                                        "entry_id": "2c8d91e2-980a-356f-9645-358683958399",
                                        "glosses": [
                                            "Celui qui acquiert des produits pour son usage personnel, et non pour les revendre, par opposition à revendeur, ou bien pour les incorporer dans un processus de production, comme les acheteurs professionnels."
                                        ],
                                        "tags": [
                                            "Économie politique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24e396fc-f729-4558-8978-861b6d3536ba",
                                                "sense_id": "40e721b5-a16a-3390-8aa1-f5190e3fc137",
                                                "text": "Québec, qui a conservé des parcelles de compétences sur le contenu (protection du consommateur, langue), n’a même pas à attendre quelque accord avec Ottawa avant d’agir."
                                            },
                                            {
                                                "example_id": "755ff0b0-8670-49a7-9052-4854323f93ea",
                                                "sense_id": "40e721b5-a16a-3390-8aa1-f5190e3fc137",
                                                "text": "Il y a plusieurs années, certaines personnes croyaient que les salles de cinéma manipulaient les consommateurs en leur présentant des messages subliminaux, comme « Mangez un maïs éclaté » ou « Buvez un Coca-Cola »."
                                            },
                                            {
                                                "example_id": "33e4f00c-a4c7-48ce-87c1-1e7c67988889",
                                                "sense_id": "40e721b5-a16a-3390-8aa1-f5190e3fc137",
                                                "text": "Ces tensions entre citoyens et élus traduisent le pourrissement de la situation depuis l’installation, le 24 septembre 2021, des consommateurs de crack du jardin d’Éole sur le site de Forceval, adjacent à la porte de la Villette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "013b020d-16ee-3b40-975a-aec149f13f8d",
                                        "entry_id": "2c8d91e2-980a-356f-9645-358683958399",
                                        "glosses": [
                                            "Celui qui boit, qui mange, qui dépense dans un café, un restaurant ou tout autre lieu de consommation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ee85423-e83c-4ee2-9a63-1c644647d210",
                                                "sense_id": "013b020d-16ee-3b40-975a-aec149f13f8d",
                                                "text": "Si la buvette est ouverte, il me paraît que les consommateurs n’y peuvent trouver qu’un choix restreint de consommations."
                                            },
                                            {
                                                "example_id": "c88d7d81-d6dd-4084-91fc-0bddd35481f5",
                                                "sense_id": "013b020d-16ee-3b40-975a-aec149f13f8d",
                                                "text": "[…]; des grappes de consommateurs pleins de quiétude, goûtaient aux tables des terrasses toute l’exquisité de l'heure apéritive."
                                            },
                                            {
                                                "example_id": "0897fb2d-1865-4323-851e-bc5c6bc52e16",
                                                "sense_id": "013b020d-16ee-3b40-975a-aec149f13f8d",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f0ae100-1e68-3af9-a59c-f5096e3e8db0",
                                        "entry_id": "2c8d91e2-980a-356f-9645-358683958399",
                                        "glosses": [
                                            "Celui qui aime à consommer."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3d8b4de9-18ac-47c4-a11e-43cdb9fa72f8",
                                                "sense_id": "6f0ae100-1e68-3af9-a59c-f5096e3e8db0",
                                                "text": "Peu de consommateurs savent que les choux d'York, pain de sucre et cœur de bœuf, sont préférables sous le rapport de la saveur a toutes les autres espèces, quand on les laisse pommer complétement."
                                            },
                                            {
                                                "example_id": "7b24194f-1fce-4782-806b-126da819d750",
                                                "sense_id": "6f0ae100-1e68-3af9-a59c-f5096e3e8db0",
                                                "text": "C’est un petit être impulsif, le consommateur."
                                            },
                                            {
                                                "example_id": "c1d52c9c-bb7e-49e6-b4e7-20be00fd21ad",
                                                "sense_id": "6f0ae100-1e68-3af9-a59c-f5096e3e8db0",
                                                "text": "On peut dire que nous sommes ici sur le terrain de la morale des consommateurs; il ne faut pas s'étonner si les théologiens catholiques trouvent encore la morale d'Aristote excellente, car ils se placent, eux aussi, au même point de vue des consommateurs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb9a209e-07f5-315d-bac5-5423a9a49eee",
                                        "entry_id": "2c8d91e2-980a-356f-9645-358683958399",
                                        "glosses": [
                                            "Celui qui mène une œuvre à sa perfection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39407bf1-1b8a-4cec-865c-eed152eb134d",
                                                "sense_id": "cb9a209e-07f5-315d-bac5-5423a9a49eee",
                                                "text": "Jésus-Christ est l’auteur et le consommateur de notre foi."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
