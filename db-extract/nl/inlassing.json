                        "entry_id": "d718c230-6587-31d9-baf9-0de11a7fd432",
                        "glosses": [
                            "iets toevoegen in iets anders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ce971c8-c08f-44ee-90b9-5471dbb93d72",
                                "sense_id": "4658ea9c-8c9f-3ef4-afe6-2e43f3628521",
                                "text": "In juli werd afgesproken dat private investeerders 21 procent op hun Grieks staatspapier zouden moeten afschrijven. De ECB schrijft in een voetnoot in het rapport „het niet eens te zijn met de inlassing van deze illustratieve scenario’s met betrekking tot een hogere bijdrage van de private sector in dit rapport.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
