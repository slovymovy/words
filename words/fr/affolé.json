                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "forme_verbale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le bruit assourdissant des sirènes a <w>affolé</w> tous les animaux du quartier.",
                            "target_lang_translations": {
                                "en": "The deafening sound of the sirens <w>panicked</w> all the animals in the neighborhood.",
                                "ru": "Оглушительный шум сирен <w>перепугал</w> всех животных в округе.",
                                "de": "Der ohrenbetäubende Lärm der Sirenen hat alle Tiere in der Nachbarschaft <w>aufgescheucht</w>.",
                                "es": "El ensordecedor ruido de las sirenas ha <w>espantado</w> a todos los animales del barrio.",
                                "zh": "震耳欲聋的警笛声<w>惊扰</w>了附近所有的动物。"
                            }
                        },
                        {
                            "text": "L'attaquant a totalement <w>affolé</w> la défense adverse par ses accélérations soudaines.",
                            "target_lang_translations": {
