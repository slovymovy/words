                "forms": [
                    {
                        "form_id": "b8be745d-6b70-4125-a697-05841938aec3",
                        "entry_id": "da64ddbf-1d7e-3638-aba6-c18296161eb9",
                        "tags": [
                            "plural"
                        ],
                        "form": "gags"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2b871623-1856-34ff-ad63-a1e48fc70e66",
                        "entry_id": "da64ddbf-1d7e-3638-aba6-c18296161eb9",
                        "glosses": [
                            "Effet comique, blague."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "e23c85a3-9c9c-47a2-8591-8e4c5c7327b5",
                                "sense_id": "2b871623-1856-34ff-ad63-a1e48fc70e66",
                                "text": "Prétendre qu’un gag se doit d’être obligatoirement comique est apporter une restriction humiliante à sa toute puissante indépendance."
                            },
                            {
                                "example_id": "8811511a-27b8-41cf-b549-f0f35a81fc28",
                                "sense_id": "2b871623-1856-34ff-ad63-a1e48fc70e66",
                                "text": "Les Allemands ont inscrit un but gag, qui plus est au pire moment pour les Olympiens."
                            },
                            {
                                "example_id": "2eb2e16f-a641-4f36-9456-7bd736efa1e5",
                                "sense_id": "2b871623-1856-34ff-ad63-a1e48fc70e66",
                                "text": "Chaque épisode est une suite de gags absurdes, de situations grand-guignolesques, d’humour ironique."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1aff9d77-0be2-4f58-8ff6-8c6cec8f0e2f",
                        "source_entry_id": "da64ddbf-1d7e-3638-aba6-c18296161eb9",
                        "source_sense_id": "2b871623-1856-34ff-ad63-a1e48fc70e66",
                        "target_lang_word": "gag",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "240ef8d3-cd40-3296-8efe-2e44f9b5f968",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "A device to restrain speech, such as a rag in the mouth secured with tape or a rubber ball threaded onto a cord or strap."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2155ea73-1439-41b7-a32d-f4bed5f8b166",
                                                "sense_id": "240ef8d3-cd40-3296-8efe-2e44f9b5f968",
                                                "text": "Blood may seep to the back of the throat and may clot, producing an “artificial gag” of clotted blood."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3e1b9a1-7272-33da-a639-aafa70055ea7",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "An order or rule forbidding discussion of a case or subject."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6afcbcd6-5354-3ba2-9108-9dabf77556d9",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "Any suppression of freedom of speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e231e09-abfa-4241-9752-1e683e76e2cb",
                                                "sense_id": "6afcbcd6-5354-3ba2-9108-9dabf77556d9",
                                                "text": "Civil Court blocks PM's gag on free speech"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e13a62bc-8065-3460-8729-5ea363717a62",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "A joke or other mischievous prank."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258d6cdc-2972-4b5a-b0b9-148d9e31e250",
                                                "sense_id": "e13a62bc-8065-3460-8729-5ea363717a62",
                                                "text": "We all know how genius “Kamp Krusty,” “A Streetcar Named Marge,” “Homer The Heretic,” “Itchy & Scratchy: The Movie” and “Mr. Plow” are, but even the relatively unheralded episodes offer wall-to-wall laughs and some of the smartest, darkest, and weirdest gags ever Trojan-horsed into a network cartoon with a massive family audience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d86292c-b508-35d5-b7a6-cb566d671d06",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "a device or trick used to create a practical effect; a gimmick"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cf2e6e4-2a96-4f37-9fb2-04a8fab80d4b",
                                                "sense_id": "8d86292c-b508-35d5-b7a6-cb566d671d06",
                                                "text": "On Hacksaw Ridge, Oliver and his team of effects artisans devised gags for that spectacular flamethrower shot along with other devastating body and bullet hits, and several mortar and full-scale explosions, all aimed at communicating the reality of battle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ebcaa8c6-ad51-3796-b2b3-3f261f41465a",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "A convulsion of the upper digestive tract."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f38976df-9b5d-3da4-a673-5e28fa886108",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "A mouthful that makes one retch or choke."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d599f87d-4ddc-43a0-a4ac-2b5b726632fa",
                                                "sense_id": "f38976df-9b5d-3da4-a673-5e28fa886108",
                                                "text": "L. has recorded the repugnance of the school to gags, or the fat of fresh beef boiled, and sets it down to some superstition."
                                            },
                                            {
                                                "example_id": "d9128443-d2b0-43ff-9f67-a5d52ce2cf54",
                                                "sense_id": "f38976df-9b5d-3da4-a673-5e28fa886108",
                                                "text": "...and to take that fire behind the bony bars of the chest and into the tower of the windpipe, in one breath, before you choke on a gag of air thickened from the last breath of the executed the breathing of hot barrels and blood streaming on concrete,..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1007d8ed-bdae-3c3a-954a-185b8befcfa3",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "Unscripted lines introduced by an actor into his part."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b54babd7-8c4c-47f6-bf92-cddd817a95e8",
                                                "sense_id": "1007d8ed-bdae-3c3a-954a-185b8befcfa3",
                                                "text": "\"The Critic\" has long been known in the theatre as a \"gag-piece;\" that is, a play which the performers consider themselves entitled to treat with the most merciless licence."
                                            },
                                            {
                                                "example_id": "b3550d50-11b3-47b1-8184-9696d9d09342",
                                                "sense_id": "1007d8ed-bdae-3c3a-954a-185b8befcfa3",
                                                "text": "[…] and my actors imbibe a reverence for their author, sir, which reverence I regret to observe is fast vanishing, in other places, under the baneful influence of gag, sir, gag! We play no pranks with the text, sir, in my company; if you cannot improve your author, which is generally doubtful, don't make him worse than he is."
                                            },
                                            {
                                                "example_id": "b306c388-f3a7-427f-852e-c4a99e714132",
                                                "sense_id": "1007d8ed-bdae-3c3a-954a-185b8befcfa3",
                                                "text": "The intelligent perfumer will evolve \"gag\" as he goes to suit the circumstances,[…]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c35ed8e-3868-3db0-9e15-7e9d32a686a7",
                                        "entry_id": "a8d8f861-b463-36ba-83fc-8eb0baa3a03e",
                                        "glosses": [
                                            "Mycteroperca microlepis, a species of grouper."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "63a07a27-1671-40f1-9e0b-ab4f74a5a542",
                                                "sense_id": "5c35ed8e-3868-3db0-9e15-7e9d32a686a7",
                                                "text": "The shallow water groups (Family Serranidae), including gag (Mycteroperca microlepis), black grouper (M. bonaci), scamp (M. phenax), and red grouper (Epinephalus morio), support major commercial and recreational fisheries in the southeastern United States."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "gag",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5792622d-77ce-386c-98fc-24bb8177f451",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To experience the vomiting reflex."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd201846-1ecb-4982-81a9-8178793e07e7",
                                                "sense_id": "5792622d-77ce-386c-98fc-24bb8177f451",
                                                "text": "He gagged when he saw the open wound."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "242eabde-7aa1-38c3-b24e-d22a343bedb1",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To cause to heave with nausea."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d15bc26c-17db-4c72-8ebf-7dd202996ec8",
                                                "sense_id": "242eabde-7aa1-38c3-b24e-d22a343bedb1",
                                                "text": "His empty stomach was suddenly full of butterflies, and for the first time since arriving here at scenic Durkin Grove Village, he felt an urge to gag himself. He would be able to think more clearly about this if he just stuck his fingers down his throat […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08dc6ad6-1e87-3860-8484-130c3b18045d",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To restrain someone's speech by blocking his or her mouth."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f189a71-d422-453d-8611-40c3b7cb89af",
                                                "sense_id": "08dc6ad6-1e87-3860-8484-130c3b18045d",
                                                "text": "“[…] Captain Markam had been found lying half-insensible, gagged and bound, on the floor of the sitting-room, his hands and feet tightly pinioned, and a woollen comforter wound closely round his mouth and neck ; whilst Mrs. Markham's jewel-case, containing valuable jewellery and the secret plans of Port Arthur, had disappeared. […]”"
                                            },
                                            {
                                                "example_id": "e48f26ec-6ff2-4b7a-84fc-a009b10e13d3",
                                                "sense_id": "08dc6ad6-1e87-3860-8484-130c3b18045d",
                                                "text": "They said no word to the landlord, they drank his ale instead, / But they gagged his daughter and bound her to the foot of her narrow bed; / Two of them knelt at her casement, with muskets at their side!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8ed1908d-1db1-3123-9e9c-9fdb335cfe60",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To pry or hold open by means of a gag."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6341a1c1-228a-453a-ac2b-77aa8bab0058",
                                                "sense_id": "8ed1908d-1db1-3123-9e9c-9fdb335cfe60",
                                                "text": "1917, Francis Gregor (translator), De Laudibus Legum Angliae, Sir John Fortescue, written 1468–1471, first published 1543.\n[…] some have their mouths gagged to such a wideness, for a long time, whereat such quantities of water are poured in, that their bellies swell to a prodigious degree […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "653c00cc-957c-3664-b8be-850bd3b6a7fd",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To restrain someone's speech without using physical means."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a55f3d59-343b-4014-8748-6af563640a06",
                                                "sense_id": "653c00cc-957c-3664-b8be-850bd3b6a7fd",
                                                "text": "When the financial irregularities were discovered, the CEO gagged everyone in the accounting department."
                                            },
                                            {
                                                "example_id": "ce76c600-2b8b-4bc7-8830-73c20551e49d",
                                                "sense_id": "653c00cc-957c-3664-b8be-850bd3b6a7fd",
                                                "text": "The time was not yet come when eloquence was to be gagged, and reason to be hoodwinked."
                                            },
                                            {
                                                "example_id": "019bc614-d9bd-4d1b-830f-eb39ea9905aa",
                                                "sense_id": "653c00cc-957c-3664-b8be-850bd3b6a7fd",
                                                "text": "Vaid blasted the Bush administration for gagging doctors from discussing abortion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2a4bf34-b878-3260-bbc4-c7028bf6563a",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To choke; to retch."
                                        ],
                                        "tags": [
                                            "ambitransitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "19835fdb-d93c-3d71-a9ac-deaccf0fd61c",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To deceive (someone); to con."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4cb5af20-2b2e-4de6-92b3-0476dd696204",
                                                "sense_id": "19835fdb-d93c-3d71-a9ac-deaccf0fd61c",
                                                "text": "I endeavoured what I could to soften off the affectation of her sudden change of Disposition; and I gagged the Gentleman with as much ease as my very little ease would allow me to assume."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68ef5c34-d596-315e-8e75-2ee6c1a6c708",
                                        "entry_id": "356836f6-992d-3076-9fcc-aef8aac5795d",
                                        "glosses": [
                                            "To astonish (someone); to leave speechless."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "27737138-2ed5-43c9-b1ca-75572a45741a",
                                                "sense_id": "68ef5c34-d596-315e-8e75-2ee6c1a6c708",
                                                "text": "I knew who you were as a [RuPaul's] Drag Race fan. So I was gagged personally and I still am gagged, but it was quite divine intervention. Thom Kerr, the photographer, really got the ball rolling and I had no idea what to expect of this shoot besides greatness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
