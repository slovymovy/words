                        "glosses": [
                            "Condamné à la guillotine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41aca1d-8c0d-469e-b2f1-c04d73d290b2",
                                "sense_id": "aaceb4b5-986d-3acc-94f3-63720c1c6232",
                                "text": "La cigarette sans cravate\nQu’on fume à l’aube démocrate\nEt le remords des cous-de-jatte\nAvec la peur qui tend la patte…"
                            },
                            {
                                "example_id": "e91c0de5-8963-4405-ba12-bd156193e78c",
                                "sense_id": "aaceb4b5-986d-3acc-94f3-63720c1c6232",
                                "text": "Nous sommes les galériens et les questionnés de toutes les tortures. Nous sommes les bagnards et les casseurs de cailloux, les guillotinés et autres « cous-de-jatte ». Nous portons en nous cette souvenance collective, bras dessus, bras dessous. Pareils aux bonnes mœurs hantant la nuit désertique de nos geôliers."
                            }
                        ]
                    }
