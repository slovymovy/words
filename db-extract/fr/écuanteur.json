                        "entry_id": "03268543-9d65-3ac1-8000-53ad8caba04e",
                        "glosses": [
                            "Valeur de l'écart entre le plan médian de la roue et le plan d’appui de la roue."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "fbd1fa05-9b1c-37b8-999c-ce312152ca65",
                        "entry_id": "03268543-9d65-3ac1-8000-53ad8caba04e",
                        "glosses": [
                            "Mesure qui caractérise la distance (en millimètres) entre la face d’appui du voile de la roue à hauteur des écrous (ou boulons) de fixation et le plan médian de la jante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a316ceb-c391-4f38-89ba-af8a42469e29",
                                "sense_id": "fbd1fa05-9b1c-37b8-999c-ce312152ca65",
                                "text": "L’écuanteur peut être positive, négative ou nulle."
                            },
                            {
                                "example_id": "384dd0af-469c-456e-8582-cd0bb9c72b7a",
                                "sense_id": "fbd1fa05-9b1c-37b8-999c-ce312152ca65",
                                "text": "Si l’écuanteur est nulle, la roue est dite symétrique."
                            }
                        ]
                    }
                ],
