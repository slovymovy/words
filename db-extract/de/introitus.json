                    {
                        "sense_id": "17c9e1b7-521b-37e8-92a8-06cfc2da35ec",
                        "entry_id": "d4d4d797-c61a-3d34-a15b-e965265f0a94",
                        "glosses": [
                            "Psalm oder Psalmvers, der zu Beginn einer Messe beim Einzug des Priesters gesungen oder zur Eröffnung gesprochen wird"
                        ],
                        "tags": [
                            "Liturgie"
                        ],
                        "examples": [
                            {
                                "example_id": "442e96a3-6cf2-423b-b49e-5f36fb10f52e",
                                "sense_id": "17c9e1b7-521b-37e8-92a8-06cfc2da35ec",
                                "text": "Psalm 1 wird als Introitus gesungen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "7d51d950-913d-3d20-9c3b-76920cf9694c",
                        "entry_id": "d4d4d797-c61a-3d34-a15b-e965265f0a94",
                        "glosses": [
                            "Eingang eines Hohlorgans des Körpers (insbesondere der Scheideneingang)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1380b95e-1440-4db0-8c76-afae49b4972c",
                                "sense_id": "7d51d950-913d-3d20-9c3b-76920cf9694c",
                                "text": "Der Introitus vaginae ist bei Schwangeren geweitet."
