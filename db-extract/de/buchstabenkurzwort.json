                "senses": [
                    {
                        "sense_id": "790e2ea6-5224-3bc1-ab40-30a12eefdacf",
                        "entry_id": "9046c69a-38f1-3d23-b4e7-d452c620d2d5",
                        "glosses": [
                            "Wort, das aus Anfangsbuchstaben (der Wortbestandteile eines Wortes oder mehrerer Wörter eines zugrundeliegenden Ausdrucks) besteht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e76c92d-cf47-47d9-9cd8-c2c3611d4ece",
                                "sense_id": "790e2ea6-5224-3bc1-ab40-30a12eefdacf",
                                "text": "„CDU“ (für „Christlich Demokratische Union“) und „LKW“ (für „Lastkraftwagen“) sind Beispiele für Buchstabenkurzwörter."
                            },
                            {
                                "example_id": "e453c660-b26b-4757-abdb-0fbcde8879d4",
                                "sense_id": "790e2ea6-5224-3bc1-ab40-30a12eefdacf",
                                "text": "„Wenn man nun (sinnvollerweise) zunächst strikt die Qualität der Segmente betrachtet, kommt man entsprechend zu vier Typen von Kurzwörtern: Buchstabenkurzwörtern, Silbenkurzwörtern, Mischtypen aus beiden und Morphem- bzw. Wortkurzwörtern.“"
                            },
                            {
                                "example_id": "17729512-ba73-43ab-aad7-f3e37aa3055d",
                                "sense_id": "790e2ea6-5224-3bc1-ab40-30a12eefdacf",
                                "text": "„Während die Schreibung der unisegmentalen Kurzwörter nicht schwierig ist, …, treten bei den Buchstabenkurzwörtern Schwankungen v.a. bei der Groß- und Kleinschreibung auf…“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
