    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "90f33e82-25e0-3aa5-b6b0-a818abca60d1",
                    "sense_definition": "Имеющий приятный вкус, свойственный сахару или мёду.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Этот <w>сладкий</w> чай очень вкусный.",
                            "target_lang_translations": {
                                "en": "This <w>sweet</w> tea is very delicious."
                            }
                        },
                        {
                            "text": "Спелые груши всегда очень <w>сладкие</w>.",
                            "target_lang_translations": {
                                "en": "Ripe pears are always very <w>sweet</w>."
                            }
                        }
                    ],
                    "antonyms": [
                        "горький",
                        "кислый",
                        "солёный"
                    ],
                    "common_phrases": [
                        "сладкий чай",
                        "сладкие фрукты"
                    ],
                    "target_lang_definitions": {
                        "en": "Having a pleasant taste characteristic of sugar or honey."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweet",
                                "target_lang_sense_clarification": "tasting of sugar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "882fe46f-b6cb-3bf4-9cd7-b4d5a13a9003",
                    "sense_definition": "Приготовленный с добавлением сахара.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На десерт мы заказали <w>сладкое</w> блюдо.",
                            "target_lang_translations": {
                                "en": "We ordered a <w>sweet</w> dish for dessert."
                            }
                        },
                        {
                            "text": "Для этого пирога нужно <w>сладкое</w> тесто.",
                            "target_lang_translations": {
                                "en": "This pie requires <w>sweet</w> dough."
                            }
                        }
                    ],
                    "synonyms": [
                        "подслащённый"
                    ],
                    "antonyms": [
                        "несладкий"
                    ],
                    "common_phrases": [
                        "сладкое блюдо",
                        "сладкий чай"
                    ],
                    "target_lang_definitions": {
                        "en": "Prepared with added sugar."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweet",
                                "target_lang_sense_clarification": "containing sugar"
                            },
                            {
                                "target_lang_word": "sweetened",
                                "target_lang_sense_clarification": "made sweet by adding sugar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bebfbd06-54f9-3170-a0a7-cf7521e1c5b4",
                    "sense_definition": "Приятный, нежный, доставляющий удовольствие.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После долгого дня наступил <w>сладкий</w> сон.",
                            "target_lang_translations": {
                                "en": "After a long day, a <w>sweet</w> sleep followed."
                            }
                        },
                        {
                            "text": "Их ждали <w>сладкие</w> мечты о будущем.",
                            "target_lang_translations": {
                                "en": "They were waiting for <w>sweet</w> dreams of the future."
                            }
                        }
                    ],
                    "synonyms": [
                        "приятный"
                    ],
                    "antonyms": [
                        "неприятный"
                    ],
                    "common_phrases": [
                        "сладкий сон"
                    ],
                    "target_lang_definitions": {
                        "en": "Pleasant, gentle, or providing enjoyment."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweet",
                                "target_lang_sense_clarification": "pleasant or agreeable"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bd1b0d3-7ab7-3ebd-8cfb-00377c59611a",
                    "sense_definition": "Умильный, приторно-нежный или льстивый.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pleasure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Она говорила с ним <w>сладким</w> голоском.",
                            "target_lang_translations": {
                                "en": "She spoke to him in a <w>saccharine</w> voice."
                            }
                        },
                        {
                            "text": "Его <w>сладкая</w> улыбка казалась неискренней.",
                            "target_lang_translations": {
                                "en": "His <w>saccharine</w> smile seemed insincere."
                            }
                        }
                    ],
                    "synonyms": [
                        "приторный"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "неодобрительно"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Overly sentimental, cloyingly gentle, or insincerely flattering."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "saccharine",
                                "target_lang_sense_clarification": "excessively sweet or sentimental"
                            },
                            {
                                "target_lang_word": "cloying",
                                "target_lang_sense_clarification": "excessively sweet to the point of being unpleasant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "78ca2177-a8bb-3ec2-b7ca-de6d985d7b0f",
                    "sense_definition": "Свежий, не солёный, не кислый, не консервированный.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "freshness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Для салата нужны только <w>сладкие</w> огурцы.",
                            "target_lang_translations": {
                                "en": "The salad needs only <w>fresh</w> cucumbers."
                            }
                        },
                        {
                            "text": "Утром мы пили <w>сладкое</w> молоко прямо с фермы.",
                            "target_lang_translations": {
                                "en": "In the morning we drank <w>fresh</w> milk straight from the farm."
                            }
                        }
                    ],
                    "synonyms": [
                        "свежий",
                        "пресный"
                    ],
                    "antonyms": [
                        "солёный",
                        "кислый",
                        "консервированный"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "используется в некоторых диалектах"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Fresh, not salty, not sour, or not preserved."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "fresh",
                                "target_lang_sense_clarification": "not preserved or spoiled"
                            },
                            {
                                "target_lang_word": "unsalted",
                                "target_lang_sense_clarification": "not containing salt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da110268-3337-32ae-9a23-55ea6233604e",
                    "sense_definition": "Ласковое обращение к любимому человеку.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "affection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Иди сюда, мой <w>сладкий</w>, я скучала.",
                            "target_lang_translations": {
                                "en": "Come here, my <w>sweetheart</w>, I missed you."
                            }
                        },
                        {
                            "text": "Не грусти, мой <w>сладкий</w>, всё будет хорошо.",
                            "target_lang_translations": {
                                "en": "Don't be sad, my <w>darling</w>, everything will be fine."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An affectionate term of address for a loved one."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "sweetheart",
                                "target_lang_sense_clarification": "term of endearment"
                            },
                            {
                                "target_lang_word": "darling",
                                "target_lang_sense_clarification": "term of endearment"
                            }
                        ]
                    },
                    "synonyms": [
                        "милый",
                        "дорогой"
                    ],
                    "common_phrases": [
                        "мой сладкий"
                    ]
                }
            ]
        }
    ]
