                            }
                        },
                        {
                            "text": "You will receive a monthly <w>bank</w> <w>statement</w> showing all your recent transactions.",
                            "target_lang_translations": {
                                "ru": "Вы будете получать ежемесячную банковскую <w>выписку</w> со всеми вашими последними операциями."
                            }
