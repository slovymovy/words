                "senses": [
                    {
                        "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                        "entry_id": "bc32f6ed-7ad4-331b-a930-1fb167cc7305",
                        "glosses": [
                            "Region in Sachsen und Brandenburg, im Osten Deutschlands, historisch auch Teile davon in Polen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf307637-3d4a-4fad-98e4-b412a36bba2c",
                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                "text": "Die Lausitz ist die Heimat der Sorben."
                            },
                            {
                                "example_id": "87242445-953d-49ad-8b19-465e2796d06e",
                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                "text": "Beide Lausitzen teilten jahrhundertelang eine gemeinsame Geschichte."
                            },
                            {
                                "example_id": "99960b26-3f69-4f42-a62a-1d22fcb60c1b",
                                "sense_id": "723d1bef-3c85-3d05-9d6b-e76da9d9fdae",
                                "text": "„Die Lausitz ist seit dem beschlossenen Kohleausstieg spätestens im Jahr 2038 in den Fokus der Öffentlichkeit geraten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
