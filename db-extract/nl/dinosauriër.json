                                        "sense_id": "4ce60319-b0d3-34f2-86ea-741e6af09005",
                                        "entry_id": "8c5f6701-0639-394d-a765-cb3a20785de3",
                                        "glosses": [
                                            "nach dem Mesozoikum ausgestorbenes Reptil, umfasst neben den Vertretern der zoologisch abgegrenzten Dinosauriern auch andere fossile Großreptilien"
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a862dae-20e2-40be-b0b5-fb461a23aab0",
                                                "sense_id": "4ce60319-b0d3-34f2-86ea-741e6af09005",
                                                "text": "„Der Dinosaurus war größer und stärker als jedes andere Tier; er mag sogar friedlicher gewesen sein, aber er war auch dümmer. Und was wurde aus ihm?“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
