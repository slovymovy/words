                                "target_senses": [
                                    {
                                        "sense_id": "39fc123d-1c89-3758-8b70-108fccee566f",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "Anything that is hollow and cylindrical in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ef86c14-c481-4c94-8f92-247f6e255176",
                                                "sense_id": "39fc123d-1c89-3758-8b70-108fccee566f",
                                                "text": "But then I had the [massive] flintlock by me for protection. ¶[…]The linen-press and a chest on the top of it formed, however, a very good gun-carriage; and, thus mounted, aim could be taken out of the window […], and a 'bead' could be drawn upon Molly, the dairymaid, kissing the fogger behind the hedge, little dreaming that the deadly tube was levelled at them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97de5408-cd41-3240-a1a2-ac6d4d408d88",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "An approximately cylindrical container, usually with a crimped end and a screw top, used to contain and dispense semiliquid substances."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f17c56f2-fe94-4edc-823a-a68fb3aedf45",
                                                "sense_id": "97de5408-cd41-3240-a1a2-ac6d4d408d88",
                                                "text": "A tube of toothpaste."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4c685db-4e2e-3788-b82a-67a4e17c9ed1",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "The London Underground railway system, originally referred to the lower level lines that ran in tubular tunnels as opposed to the higher ones which ran in rectangular section tunnels. (Often the tube.)"
                                        ],
                                        "tags": [
                                            "British",
                                            "capitalized",
                                            "colloquial",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf63a0bd-c428-41d3-bfc3-e1b1116bd952",
                                                "sense_id": "b4c685db-4e2e-3788-b82a-67a4e17c9ed1",
                                                "text": "I took the tube to Waterloo and walked the rest of the way."
                                            },
                                            {
                                                "example_id": "713902ef-09ef-4d86-8f92-98501ebbd542",
                                                "sense_id": "b4c685db-4e2e-3788-b82a-67a4e17c9ed1",
                                                "text": "He took the tube to Westminster and disappeared."
                                            },
                                            {
                                                "example_id": "d399a28a-71ac-4be5-9b3c-e813db575788",
                                                "sense_id": "b4c685db-4e2e-3788-b82a-67a4e17c9ed1",
                                                "text": "The economist also observed that some of the Victoria Line's cost should be debited to existing lines, as they would benefit from the rebuilding of their interchange stations with the new tube."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "661f9309-f39a-3871-aa82-ba7c5c4cc094",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "The London Underground railway system, originally referred to the lower level lines that ran in tubular tunnels as opposed to the higher ones which ran in rectangular section tunnels. (Often the tube.)",
                                            "One of the tubular tunnels of the London Underground."
                                        ],
                                        "tags": [
                                            "British",
                                            "capitalized",
                                            "colloquial",
                                            "obsolete",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "381ee914-7162-4574-8e83-9f402ad70735",
                                                "sense_id": "661f9309-f39a-3871-aa82-ba7c5c4cc094",
                                                "text": "And thus it came about that on that October morning I found myself in the deep level tube with the Professor speeding to the North of London in what proved to be one of the most singular experiences of my remarkable life."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e23c2c47-ae87-32c4-a749-ef107d4f552c",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "A tin can containing beer."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0164468b-232b-467f-a2d4-ad87f2f0ea83",
                                                "sense_id": "e23c2c47-ae87-32c4-a749-ef107d4f552c",
                                                "text": "It's alright to cop a warm tube of Fosters and a cold pie 'n' peas when you're dated by one of the locals[.]"
                                            },
                                            {
                                                "example_id": "5cd758a8-d047-4303-9fad-e6ba5b8636c5",
                                                "sense_id": "e23c2c47-ae87-32c4-a749-ef107d4f552c",
                                                "text": "Tinnie: a tin of beer — also called a tube."
                                            },
                                            {
                                                "example_id": "9b6a1d80-96c4-48e9-9517-43e42d511d30",
                                                "sense_id": "e23c2c47-ae87-32c4-a749-ef107d4f552c",
                                                "text": "Beer is also available from bottleshops (or bottle-o's) in cases (or 'slabs') of 24-36 cans (‘tinnies' or ‘tubes') or bottles (‘stubbies') of 375ml each."
                                            },
                                            {
                                                "example_id": "5a4687c3-c9be-427f-9f86-9f4b6ecf92eb",
                                                "sense_id": "e23c2c47-ae87-32c4-a749-ef107d4f552c",
                                                "text": "That Humphries should imply that, in the Foster's ads, Hogan's ocker appropriated McKenzie's discourse (specifically the idiom \"crack an ice-cold tube\") reinforces my contention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0a77008-b1dc-3565-96f7-b63839f00f91",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "A wave which pitches forward when breaking, creating a hollow space inside."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ce6036-1d6e-4107-85d5-2eaeaad6615c",
                                                "sense_id": "d0a77008-b1dc-3565-96f7-b63839f00f91",
                                                "text": "It seemed like Butch was invincible, like he could do nothing wrong, coming through one unbelievable tube after another."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "424c8ca2-d023-3be0-ab23-0c76e16c4673",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "A television. Compare cathode ray tube and picture tube."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8850c795-cfb3-4d35-af59-3231e6816434",
                                                "sense_id": "424c8ca2-d023-3be0-ab23-0c76e16c4673",
                                                "text": "Right now, there is a whole, an entire generation that never knew anything that didn't come out of this tube. This tube is the gospel, the ultimate revelation; this tube can make or break presidents, popes, prime ministers; this tube is the most awesome goddamn propaganda force in the whole godless world, […]"
                                            },
                                            {
                                                "example_id": "22fbc40d-bdcb-41b4-87fe-79d13848764f",
                                                "sense_id": "424c8ca2-d023-3be0-ab23-0c76e16c4673",
                                                "text": "I sit around and watch the tube, but nothing's on. I change the channels for an hour or two."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5397be71-d5da-304e-b908-ff8253997a6b",
                                        "entry_id": "46c67ae9-94fb-387d-8d97-b8a606c6f3de",
                                        "glosses": [
                                            "An idiot."
                                        ],
                                        "tags": [
                                            "Scotland",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ad9dd62-4195-4b39-9dde-d75eae16ffe6",
                                                "sense_id": "5397be71-d5da-304e-b908-ff8253997a6b",
                                                "text": "'Don't be a bloody tube, Jack,' she told me. (I always loved it when she used Scottish terms of abuse in that English accent of hers.)"
                                            },
                                            {
                                                "example_id": "8441b92b-7bb6-4594-9073-9415b34c1fb5",
                                                "sense_id": "5397be71-d5da-304e-b908-ff8253997a6b",
                                                "text": "I'm a tube? Who got done for speeding? Who got lifted for bloody assault?"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tube",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3cd03023-f5b7-3422-b18d-05e5507136e8",
