                    {
                        "sense_id": "28a3e3ca-c57b-3ae8-aaa4-1ac19028fc74",
                        "entry_id": "c59e62a2-07da-3614-ac42-60350c0d3127",
                        "glosses": [
                            "Bergland, Mittelgebirge im Mainviereck im Südwesten Deutschlands (in den Bundesländern Bayern und Hessen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9aa24b5-180b-407b-bf28-eb6600a1fdb9",
                                "sense_id": "28a3e3ca-c57b-3ae8-aaa4-1ac19028fc74",
                                "text": "„Mitten durch den Spessart verläuft eine alte Handelsstraße – der Eselsweg. Von Schlüchtern im oberen Kinzigtal zieht er sich in südlicher Richtung bis hin nach Miltenberg am Main-, an Schlössern, hellgrünen Wäldern und beschaulichen Städtchen vorbei.“"
                            },
                            {
                                "example_id": "8bcb6ee1-736e-4dba-8e93-1a0fc3e4951b",
                                "sense_id": "28a3e3ca-c57b-3ae8-aaa4-1ac19028fc74",
                                "text": "„Im angrenzenden Spessart soll es sogar Dörfer geben, in denen die Zeit seit Jahren komplett stehengeblieben ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
