                "senses": [
                    {
                        "sense_id": "00ca98fc-f83b-3f5a-b585-5a2f5ddcef63",
                        "entry_id": "20104ab8-2d9d-3952-bd22-b8f26a1ea503",
                        "glosses": [
                            "Espèce d’antilope de la sous-famille des Cephalophinae."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c02e9cf-e27b-4605-aa47-a8916576fa58",
                                "sense_id": "00ca98fc-f83b-3f5a-b585-5a2f5ddcef63",
                                "text": "Nous parcourions le veld en quête de tortues, de mues de serpent translucides, de crânes blanchis de bestiaux morts depuis longtemps, de duikers, de suricates ou de lièvres."
                            },
                            {
                                "example_id": "52ff83fb-9bb2-4b84-8402-3ed7a0d770cb",
                                "sense_id": "00ca98fc-f83b-3f5a-b585-5a2f5ddcef63",
                                "text": "Mais jamais il ne vit plus intensément que par ces petits matins où lui et son père partent avec leurs fusils, remontent le lit de la Boesmanrivier en quête de gibier : de petites antilopes, steenbok, duiker, des lièvres et, sur les versants pelés des collines, des korhaan, des outardes."
                            },
                            {
                                "example_id": "6143f632-f377-467c-bc5a-46540eb499db",
                                "sense_id": "00ca98fc-f83b-3f5a-b585-5a2f5ddcef63",
                                "text": "Le jour suivant, je tuai un duiker (Cephalophus ocularis), petite antilope qui ne va que par bonds énormes de 2 ou 3 mètres et qui vous part souvent entre les jambes, comme un lièvre ; sa taille n’excède pas 50 centimètres au garrot."
                            }
                        ]
                    }
                ],
