    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7c8866a-49fd-3233-95a2-4244c2743b5e",
                    "sense_definition": "klagende, huilende geluiden maken om verdriet of pijn te uiten",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "klagen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zij <w>jammerde</w> dat haar geld gestolen was.",
                            "target_lang_translations": {
                                "en": "She <w>wailed</w> that her money had been stolen."
                            }
                        },
                        {
                            "text": "Het kind begon luid te <w>jammeren</w> toen het zijn knie schaafde.",
                            "target_lang_translations": {
                                "en": "The child began to <w>wail</w> loudly when it scraped its knee."
                            }
                        }
                    ],
                    "synonyms": [
                        "weeklagen",
                        "lamenteren",
                        "janken",
                        "grienen",
                        "kermen",
                        "klagen"
                    ],
                    "common_phrases": [
                        "luid jammeren",
                        "jammeren over verlies"
                    ],
                    "target_lang_definitions": {
                        "en": "to make complaining or crying sounds to express grief, sorrow, or pain"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wail",
                                "target_lang_sense_clarification": "to cry out loudly in grief or pain"
                            },
                            {
                                "target_lang_word": "lament",
                                "target_lang_sense_clarification": "to express deep sorrow or regret"
                            },
                            {
                                "target_lang_word": "whine",
                                "target_lang_sense_clarification": "to complain in a high-pitched, annoying way"
                            },
                            {
                                "target_lang_word": "moan",
                                "target_lang_sense_clarification": "to make a low sound of suffering or complaint"
                            }
                        ]
                    }
                }
            ]
        },
