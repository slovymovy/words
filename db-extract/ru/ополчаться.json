                        "translation_id": "a94cc9c0-8a51-47f3-b251-eae7cc78660b",
                        "source_entry_id": "53944444-bbf3-3fb9-8f8b-2eb454869d4e",
                        "source_sense_description": "вооружаться для войны с кем-либо",
                        "target_lang_word": "zu Felde ziehen",
