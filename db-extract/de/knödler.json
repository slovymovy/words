                ],
                "senses": [
                    {
                        "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                        "entry_id": "94fb7a34-372f-307d-88ec-1010bf5c49c0",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3263399b-c44a-45a1-8f70-8ec1e025fef0",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Frau Knödler ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "54545cff-70b9-4016-8c94-2f1ad27c51e8",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Herr Knödler wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1b29c705-b3b3-4801-8664-964848fdc46b",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Die Knödlers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "3e5c621a-6671-4484-a2c2-0963c2f60fae",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Der Knödler trägt nie die Schals, die die Knödler ihm strickt."
                            },
                            {
                                "example_id": "e0796451-9db3-409c-9902-d02dae781200",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knödler kommt, geht der Herr Knödler.“"
                            },
                            {
                                "example_id": "e204e0ea-9203-498f-b77d-a846b560d6ea",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Knödler kommt und geht."
                            },
                            {
                                "example_id": "8e8e3344-b214-49bb-a4de-852143b29739",
                                "sense_id": "c1a8673a-fa63-3e40-a358-0c11de8a0e89",
                                "text": "Knödlers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
