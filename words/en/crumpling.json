    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcf8c4a1-6975-3d98-ac40-c5c1abdf1d71",
                    "sense_definition": "The act of crushing or folding something into irregular wrinkles.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>crumpling</w> of the paper made a loud noise in the quiet room.",
                            "target_lang_translations": {
                                "cs": "<w>Mačkání</w> papíru vydalo v tiché místnosti hlasitý zvuk."
                            }
                        },
                        {
                            "text": "She watched the <w>crumpling</w> of the fabric as it was pushed into the small box.",
                            "target_lang_translations": {
                                "cs": "Sledovala <w>mačkání</w> látky, jak byla vtlačována do malé krabice."
                            }
                        }
                    ],
                    "synonyms": [
                        "crushing",
                        "wrinkling"
                    ],
                    "target_lang_definitions": {
                        "cs": "Činnost, při které se něco mačká nebo skládá do nepravidelných záhybů."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "mačkání",
                                "target_lang_sense_clarification": "obecný proces deformace materiálu tlakem"
                            },
                            {
                                "target_lang_word": "zmačkání",
                                "target_lang_sense_clarification": "dokončený akt vytvoření záhybů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0415c16d-0bc9-342a-905a-738398be0f92",
                    "sense_definition": "A shape or structure characterized by irregular folds or wrinkles.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shape",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geologist studied the complex <w>crumplings</w> in the ancient rock layers.",
                            "target_lang_translations": {
                                "cs": "Geolog studoval složité <w>záhyby</w> ve starých vrstvách hornin."
                            }
                        },
                        {
                            "text": "The metal sheet showed deep <w>crumplings</w> after the impact.",
                            "target_lang_translations": {
                                "cs": "Kovový plech vykazoval po nárazu hluboké <w>zmačkaniny</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "fold",
                        "wrinkle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Tvar nebo struktura charakterizovaná nepravidelnými záhyby nebo vráskami."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "záhyby",
                                "target_lang_sense_clarification": "místa, kde je materiál přehnutý"
                            },
                            {
                                "target_lang_word": "zmačkaniny",
                                "target_lang_sense_clarification": "výsledné nepravidelné tvary na povrchu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
