                "senses": [
                    {
                        "sense_id": "038c8ca9-2970-3ac0-b760-c2fdf282d4ad",
                        "entry_id": "be0a6265-24f0-3ebd-b4d3-504c655aeabf",
                        "glosses": [
                            "Fixer un radical farnésyl dans une protéine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e4b127e-8b98-44ce-8920-7a277e892b5c",
                                "sense_id": "038c8ca9-2970-3ac0-b760-c2fdf282d4ad",
                                "text": "La FTase est capable de reconnaître des tétrapeptides de type CAAX et de les farnésyler aussi efficacement que la protéine entière (Reiss et al., 1990)."
                            },
                            {
                                "example_id": "a94f88c2-2c6c-4026-b842-f06cfc911d47",
                                "sense_id": "038c8ca9-2970-3ac0-b760-c2fdf282d4ad",
                                "text": "La protéine Ras est une GTPase monomérique qui doit être farnésylée pour exercer ses fonctions transformantes."
                            },
                            {
                                "example_id": "4fed230f-dc1d-4824-95b7-74a797f28afc",
                                "sense_id": "038c8ca9-2970-3ac0-b760-c2fdf282d4ad",
                                "text": "Étape 3 : carboxyméthylation de la cystéine farnésylée par l’isoprenylcystéine-carboxy-méthyl-transférase (ICMT)."
                            }
                        ]
                    }
