                ],
                "senses": [
                    {
                        "sense_id": "6a7cd46d-f9d8-38a8-89cf-18ef63a920e4",
                        "entry_id": "adf2d331-dc62-30fe-be1f-978a49960414",
                        "glosses": [
                            "Tag im August"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a05ecf1-604b-49a6-8967-a63fbaf65f3e",
                                "sense_id": "6a7cd46d-f9d8-38a8-89cf-18ef63a920e4",
                                "text": "Milena kam an einem Augusttag."
                            },
                            {
                                "example_id": "539b578f-9ae5-424f-9d66-627668a949e3",
                                "sense_id": "6a7cd46d-f9d8-38a8-89cf-18ef63a920e4",
                                "text": "„In den letzten Augusttagen verließen sie das Lager bei Smolensk.“"
                            },
                            {
                                "example_id": "02638273-7c9e-483e-9368-d4c77db34fce",
                                "sense_id": "6a7cd46d-f9d8-38a8-89cf-18ef63a920e4",
                                "text": "„In den ersten Augusttagen des Jahres 1733 setzte mein Erinnerungsvermögen ein.“"
                            },
                            {
                                "example_id": "37d27d1d-e6d7-4411-ae6e-4f9055b6688d",
                                "sense_id": "6a7cd46d-f9d8-38a8-89cf-18ef63a920e4",
                                "text": "„An jenem letzten Augusttag kam ich spät nach Hause, ich war müde und ging gleich zu Bett.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
