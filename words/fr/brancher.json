                    "semantic_group_id": "arbres",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le seigneur ordonna sans délai de <w>brancher</w> le voleur au grand orme."
                        },
                        {
                            "text": "Les gardes menaçaient de <w>brancher</w> tous les fuyards au premier arbre venu."
