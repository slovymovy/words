                    {
                        "sense_id": "901e3421-0b0b-330a-bf89-38c682c11153",
                        "entry_id": "a31efdcf-0b71-3536-a0b6-9f88904baee0",
                        "glosses": [
                            "Erythroxylum coca blad van de cocaplant waaruit cocaïne geproduceerd kan worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66362cd9-e1da-44c4-b3b6-54169b66bd25",
                                "sense_id": "901e3421-0b0b-330a-bf89-38c682c11153",
                                "text": "Eind 2017 werd in Colombia op 171.000 hectare land coca verbouwd. Met het geoogste cocablad kan bijna 1400 ton cocaïne worden geproduceerd. In Nederland zou die hoeveelheid cocaïne een straatwaarde hebben van ongeveer honderd miljard euro."
                            },
                            {
                                "example_id": "ef9c967c-aa71-4d5e-8ca5-8044c5cd7aa6",
                                "sense_id": "901e3421-0b0b-330a-bf89-38c682c11153",
                                "text": "Sunshine Earth Labs zei in een verklaring dat het toestemming heeft gekregen van overheidsorganisatie Health Canada om ,,legaal cocablad en cocaïne te bezitten, produceren, verkopen en te distribueren”. Dat geldt ook voor morfine, MDMA (ecstasy) en heroïne. In februari kreeg het bedrijf Adastra Labs een vergelijkbare licentie. Dit eveneens Canadese bedrijf had zich tot dan toe gericht op het maken van cannabisextracten. Met de licentie kan Adastra Labs nu ook psilocybine en psilocine, beter bekend als paddo’s, produceren en verkopen."
                            }
                        ]
                    }
