                ],
                "senses": [
                    {
                        "sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                        "entry_id": "072110b6-1263-345c-920a-298724c1d850",
                        "glosses": [
                            "Relatif à l’Amazone ou à l’Amazonie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bbbe47-e848-4e96-9de0-07c87af38534",
                                "sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                                "text": "La sirène meugle. Les non-voyageurs descendent. Derniers cris. L’Itabera s'enfonce dans la nuit amazonienne."
                            },
                            {
                                "example_id": "4f6fbe7c-85cb-47e7-b2f5-0d86728ad8c4",
                                "sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                                "text": "Dans le Nord-Ouest amazonien, par exemple, environ un siècle après l'abattis, il devient à peu près impossible à un botaniste professionnel de distinguer la végétation secondaire de la forêt primaire environnante (Sastre 1975)."
                            },
                            {
                                "example_id": "0cdfd0c7-3237-40a6-897d-0cfc30eb1dfb",
                                "sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                                "text": "En Guyane, les peuplements faunistiques et floristiques montrent des éléments issus des reliefs de l'intérieur du pays, qui auraient hébergé des refuges forestiers, d'autres éléments issus de la région de l’embouchure amazonienne, et enfin d'autres provenant de refuges localisés dans la région Surinam-Guyana- Venezuela."
                            },
                            {
                                "example_id": "a4364611-ff70-46cc-b64b-beeea572323e",
                                "sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                                "text": "Une partie des sédiments amazoniens repris par le courant des Guyanes s’accumule en crème de vase plus ou moins fluide et forme des bancs larges de 10 à 20 km qui se déplacent le long de la côte ; le reste est surtout en suspension."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c50ef318-8c6b-4740-990e-78e8e4f7c354",
                        "source_entry_id": "072110b6-1263-345c-920a-298724c1d850",
                        "source_sense_id": "dbab68ab-d36e-3f98-a890-b905ae6a8d97",
                        "target_lang_word": "Amazonian",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Amazonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e0a2576-7804-3e5b-94eb-de23c60b4c17",
                                        "entry_id": "75194ac5-b278-31f8-b3ad-27411563e620",
                                        "glosses": [
                                            "An Amazon."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98114998-8521-3555-a5b7-68d065d33d76",
                                        "entry_id": "75194ac5-b278-31f8-b3ad-27411563e620",
                                        "glosses": [
                                            "An employee of Amazon.com, Inc.."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e87bdef-0169-49e9-acea-28f7a95ebabb",
                                                "sense_id": "98114998-8521-3555-a5b7-68d065d33d76",
                                                "text": "[…] Amazonians like David Risher, who lead^([sic]) the first expansion into retail in the 1990s; Warren Jenson, Covey's short-lived successor as CFO; and Rick Dalzell, the former Army Ranger who was Amazon's CIO for a decade."
                                            },
                                            {
                                                "example_id": "8d2571af-0d86-4acf-ac02-9552f69ace79",
                                                "sense_id": "98114998-8521-3555-a5b7-68d065d33d76",
                                                "text": "In a memo to his company’s 180,000 workers late Sunday, Amazon founder and CEO Jeff Bezos called the practices depicted in the story as “shockingly callous,” but said: “The article doesn’t describe the Amazon I know or the caring Amazonians I work with every day.”"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Amazonian",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9af701ae-800f-3588-bc58-90702676158f",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Of or relating to the Amazons; aggressive and warlike."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c74f7e3-6419-3660-b47e-f48fb3429eaf",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Having to do with the Amazon River in South America, and its surrounding region."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a215fd-e77c-48af-b877-8accabe0eb0c",
                                                "sense_id": "8c74f7e3-6419-3660-b47e-f48fb3429eaf",
                                                "text": "The new numbers, showing almost 10,000 sq kms were lost in the year to August, were released as emboldened farm owners scuffled with forest defenders in Altamira, the Amazonian city at the heart of the recent devastation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "60dd57fc-b1c5-38a3-bb83-23b9872f534e",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Of or relating to the most recent Martian geological time period."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1ed10220-52d9-352d-93dc-f3727e397940",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Very tall, strong and athletic."
                                        ],
                                        "tags": [
                                            "of a woman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "852a7462-49e6-430c-a2a9-6e5a6cf40b5a",
                                                "sense_id": "1ed10220-52d9-352d-93dc-f3727e397940",
                                                "text": "Women's Tennis champions Maria Sharapova and Venus Williams are noted for their Amazonian physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Requiring a huge amount of work; of extraordinary difficulty; Herculean."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c8028c3-aa38-43c3-8d2b-c40e4d33ddd0",
                                                "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                                                "text": "It's to their credit that they are capable of such \"transformations,\" as well as performing the amazonian task of surviving and working as a small theater."
                                            },
                                            {
                                                "example_id": "44e2bcda-ad0d-4536-b428-ad8dc0974ec4",
                                                "sense_id": "e0002e09-7dc3-3d8b-a254-386fe4193269",
                                                "text": "Russian capitalism created an exploited economic class that was up against these common enemies at every turn and was forced to take on the Amazonian task of battling class rule, its ideology and state."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3a957a68-d487-3ba8-a3dc-2d196af29e9f",
                                        "entry_id": "2065580c-3928-3be2-95f3-839e105d1dee",
                                        "glosses": [
                                            "Of or relating to Amazon.com, Inc.."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dec6400d-a6f6-48d7-8fe1-8ba1e1840172",
                                                "sense_id": "3a957a68-d487-3ba8-a3dc-2d196af29e9f",
                                                "text": "I’ve […] languidly sipped merlot while my Amazonian inamorato responds to a high-priority event."
                                            }
                                        ]
                                    }
                                ]
                            },
