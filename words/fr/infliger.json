    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4c93dbd7-820c-361e-af07-7fbd8b93cd70",
                    "sense_definition": "Condamner quelqu'un à une peine ou lui appliquer une sanction juridique ou disciplinaire.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sanction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le juge a décidé d'<w>infliger</w> une amende record à cette entreprise polluante."
                        },
                        {
                            "text": "Le tribunal correctionnel lui a <w>infligé</w> une peine de prison ferme."
                        }
                    ],
                    "synonyms": [
                        "imposer",
                        "appliquer"
                    ],
                    "common_phrases": [
                        "infliger une peine",
                        "infliger une amende",
                        "infliger une sanction"
                    ]
                },
                {
                    "sense_id": "2f90e352-91fe-36f7-a4e3-ff57b4c1693b",
                    "sense_definition": "Faire subir à autrui quelque chose de pénible, de douloureux ou de désagréable.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "faire_subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'équipe locale a <w>infligé</w> une défaite cuisante à ses adversaires lors de la finale."
                        },
                        {
                            "text": "Il refusait d'<w>infliger</w> des souffrances inutiles aux animaux dans son laboratoire."
                        }
                    ],
                    "synonyms": [
                        "faire subir"
                    ],
                    "antonyms": [
                        "épargner"
                    ],
                    "common_phrases": [
                        "infliger une défaite",
                        "infliger des souffrances"
                    ]
                }
            ]
        }
    ]
}