                                "target_senses": [
                                    {
                                        "sense_id": "265fac59-4504-30f3-be3e-b13de758debc",
                                        "entry_id": "8f0dec70-8922-3ab5-b4ac-47c50983b853",
                                        "glosses": [
                                            "Advocating or supporting a republic as a form of government, advocating or supporting republicanism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "232b2539-a88e-45b4-942a-9ad8725ac817",
                                                "sense_id": "265fac59-4504-30f3-be3e-b13de758debc",
                                                "text": "Republican ideology had no obvious institutional focus and ideological carrier as was the case with the discourse of reason (the monarchy) and the discourse of law (the parlements)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "244fcad8-9b24-3a80-b654-315c188275f9",
                                        "entry_id": "8f0dec70-8922-3ab5-b4ac-47c50983b853",
                                        "glosses": [
                                            "Of or belonging to a republic."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c600bbd0-db55-4e47-aa63-31a481d8aae0",
                                                "sense_id": "244fcad8-9b24-3a80-b654-315c188275f9",
                                                "text": "The Roman emperors were republican magistrates named by the senate."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "296728e8-8135-33b1-b63a-1b12009bdd4a",
                                        "entry_id": "8f0dec70-8922-3ab5-b4ac-47c50983b853",
                                        "glosses": [
                                            "Alternative letter-case form of Republican."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "republican",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                                        "entry_id": "7e8d00f6-9634-3b32-83b4-f96a44ecfa55",
                                        "glosses": [
                                            "Someone who favors a republic as a form of government."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1959893f-8630-472f-9e39-36ff16d4af3a",
                                                "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                                                "text": "Sir, there is one Mrs Macaulay in this town, a great republican. One day when I was at her house, I put on a very grave countenance, and said to her, 'Madam, I am now become a convert to your way of thinking. I am convinced that all mankind are upon an equal footing...'"
                                            },
                                            {
                                                "example_id": "2a2854ec-e700-427e-97f4-66b0d7c96b5d",
                                                "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                                                "text": "I guess I am a bit of a republican at heart but I would love to be introduced to the Prince just to be able to grip him off about seeing the Noisy Scrub-bird."
                                            },
                                            {
                                                "example_id": "4e4b8771-6b47-405b-9923-e53de193fe55",
                                                "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                                                "text": "Nationalists and republicans need to adopt a new approach to convince unionists of the merits of uniting Ireland, Gerry Adams has said."
                                            },
                                            {
                                                "example_id": "639fcce6-f241-470d-b8c9-4d725377ab64",
                                                "sense_id": "3c8e4180-e5f3-39ef-a628-9ce1e13dc0f1",
                                                "text": "A son of slain republicans Dominic and Mary McGlinchey has brought High Court actions claiming the State has failed to properly investigate his parents' murders."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "53d73e38-2647-3562-a8fe-d7672a8e6a52",
                                        "entry_id": "7e8d00f6-9634-3b32-83b4-f96a44ecfa55",
                                        "glosses": [
                                            "Synonym of American cliff swallow."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "28698d9e-2f03-3948-91a2-3ce8ce8aac06",
                                        "entry_id": "7e8d00f6-9634-3b32-83b4-f96a44ecfa55",
                                        "glosses": [
                                            "Synonym of sociable weaver."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5686d6e8-d949-4d0a-a0a0-caea2ca5eae3",
                        "source_entry_id": "42a92973-6735-3604-a6ec-8d2bf1ab8cd1",
                        "target_lang_word": "républicain",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "républicain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d99be003-1d7d-322b-b4ee-8949457c58d7",
                                        "entry_id": "12eb1a6d-43c9-324e-a0c5-066462feb4a3",
                                        "glosses": [
                                            "Qui appartient à la république."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd3512cd-adc4-4693-9de4-d661b8622783",
                                                "sense_id": "d99be003-1d7d-322b-b4ee-8949457c58d7",
                                                "text": "Gouvernement républicain."
                                            },
                                            {
                                                "example_id": "513cfb74-3d5d-4722-9e18-74674604ae30",
                                                "sense_id": "d99be003-1d7d-322b-b4ee-8949457c58d7",
                                                "text": "Constitution républicaine."
                                            },
                                            {
                                                "example_id": "e58dd2d1-632f-4850-88e1-798061d74a3e",
                                                "sense_id": "d99be003-1d7d-322b-b4ee-8949457c58d7",
                                                "text": "Institutions républicaines."
                                            },
                                            {
                                                "example_id": "730f8375-bdc2-4885-9b88-1b8b51172007",
                                                "sense_id": "d99be003-1d7d-322b-b4ee-8949457c58d7",
                                                "text": "Admettre cette préséance, c’est léser l’esprit républicain, porter atteinte aux principes de 89, faire fi des sacrifices consentis par les révolutionnaires de 1830 à 1871 !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                        "entry_id": "12eb1a6d-43c9-324e-a0c5-066462feb4a3",
                                        "glosses": [
                                            "Qui affectionne la république, qui lui est favorable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3814ca0-1d9b-4675-9965-f7f1da46bac8",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Ce qui sauva Genève, ce fut l’esprit républicain, l’amour des lois avec la liberté."
                                            },
                                            {
                                                "example_id": "e0000005-2f61-4029-966d-443b27a619a4",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "C’est pourquoi, justement, j’ai toujours cru que les manouvriers seront tous républicains, dès qu’il seront en état de comprendre que le seul gouvernement qui puisse leur être favorable, celui qui rendra les impôts proportionnels à ce que l’on a et non à ce que l’on mange, celui qui les mettra le plus promptement à même de devenir propriétaires du sol qu’ils cultivent à si grand’peine, et qui par conséquent leur garantira la vraie liberté — c’est la République."
                                            },
                                            {
                                                "example_id": "9c8db76e-5a61-43c3-9ae2-7c30de901977",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Il était républicain depuis l’Empire et l’était resté avec passion, parce qu’il lui semblait que la République eût encore besoin d’être défendue"
                                            },
                                            {
                                                "example_id": "bcbcd118-a33c-4337-a1d0-39ec16b348d2",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Cependant, les injures recommencent de voler. Par une inspiration soudaine, Nestor Rousselier se met à chanter, et tous ceux de l’alouette reprennent avec lui sur un air imité de celui des lampions :\n« Républicains. – Gueule sans pain. – Trempe ton cul dans du purin. – Pour (e) r’laver ta peau de putain. – Peau de putain... »"
                                            },
                                            {
                                                "example_id": "ea393a2b-0e24-411b-bbfc-55c750f1d314",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Et que fait un républicain s’il a le bonheur de vivre en république ? Il se tourne les pouces ou bien il enseigne le grec et décrit les monuments d’Aurillac à ses moments perdus."
                                            },
                                            {
                                                "example_id": "f3331828-62d0-41fc-8888-c7281c00a033",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Les unionistes nord-irlandais du DUP craignent que l’appartenance au Royaume-Uni soit menacée depuis la progression des nationalistes républicains du Sinn Féin, partisans d’une réunification avec la République d’Irlande voisine."
                                            },
                                            {
                                                "example_id": "3d842d09-78d9-4763-a8bd-f8b769a7ceed",
                                                "sense_id": "c0226472-c738-379b-be10-be59dcbab6c4",
                                                "text": "Il semble que les principes gérontocratiques et kakistocratiques, qui nous caractérisent, ont prévalu sur les principes démocratiques et républicains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0052a6d-ef0c-367b-a5ec-f03c696277e7",
                                        "entry_id": "12eb1a6d-43c9-324e-a0c5-066462feb4a3",
                                        "glosses": [
                                            "Qui concerne le Parti républicain, ou qui en approuve les idées."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "da9f9d26-2e77-38d2-bc1e-886681d27dc4",
                                        "entry_id": "12eb1a6d-43c9-324e-a0c5-066462feb4a3",
                                        "glosses": [
                                            "Qui s’oppose aux extrémismes, en particulier à l’extrême-droite."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85b8ed85-9edf-4b58-b675-1b90220d6d76",
                                                "sense_id": "da9f9d26-2e77-38d2-bc1e-886681d27dc4",
                                                "text": "Entre partis républicains, la mobilisation contre l’extrême droite ne saurait être invoquée au gré des circonstances. Le parti de M. Macron ne peut appeler à lui faire barrage pour accéder ou se maintenir au pouvoir, puis ne pas s’appliquer à lui-même cet impératif, sauf à renier son identité et les valeurs qu’il prétend siennes."
                                            },
                                            {
                                                "example_id": "85841d73-ed48-41f3-880f-00eea4e9c2cf",
                                                "sense_id": "da9f9d26-2e77-38d2-bc1e-886681d27dc4",
                                                "text": "En 2017, 110 candidats du Front National s’étaient qualifiés pour le second tour des législatives. Mais seuls 8 étaient devenus députés. Cinq ans plus tard, le parti de Marine Le Pen, devenu RN, a pulvérisé ce qui restait du front républicain."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "républicain",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                        "entry_id": "8a033ae9-ad02-3258-a75f-17aeb2146a9f",
                                        "glosses": [
                                            "Personne attachée à la république, au parti républicain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfa4da69-05bf-4cdb-aa10-6ce24eceb576",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "On ne persuadera jamais à des républicains, vraiment libres, de se donner un maître ; car ils vous diront toujours : Il vaut mieux dépendre des lois que du caprice d’un seul homme."
                                            },
                                            {
                                                "example_id": "c9c3b449-8f9d-4891-86d7-f3381dde3ac3",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "Charette, qui, depuis la prise de Noirmoutiers par les républicains , ne disposait plus que de faibles bandes, sévit de nouveau à la tête d’une armée; et, le 26 nivôse (15 janvier), il fut en mesure de battre les bleus à Chancé et à Légé : […]."
                                            },
                                            {
                                                "example_id": "e6ebe8f5-22ad-4d2b-923a-c7f5b665484c",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "La veille du jour où il arrêta Eugène sur le cours Sauvaire, il avait publié, dans l’Indépendant, un article terrible sur les menées du clergé, en réponse à un entrefilet de Vuillet, qui accusait les républicains de vouloir démolir les églises."
                                            },
                                            {
                                                "example_id": "2263106d-c9ca-42dc-8889-5191ca3aed2f",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "Les républicains triomphants ne déshonorèrent pas leur triomphe : ils veillèrent eux-mêmes à la sûreté de la bourgeoisie, qui tremblait pour sa vie et pour ses biens."
                                            },
                                            {
                                                "example_id": "8292eb87-978b-41d4-a7dc-7827f47e070f",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "Je vous l’ai dit, monsieur l’employé supérieur, répondit Jean-Pierre : j’étais républicain avant le général Bonaparte ; je suis républicain, maintenant que le premier consul ne l’est plus guère ; je resterai républicain quand l’empereur ne le sera plus du tout."
                                            },
                                            {
                                                "example_id": "55107995-27a4-431d-8046-1b8184c1bbc4",
                                                "sense_id": "84b8d261-9af8-3783-b0ea-d0c730281e7f",
                                                "text": "Déroutés, les hommes du 24 mai cherchèrent une issue. On a dit qu’ils se rabattirent sur un expédient : la République sans les républicains. Ce n’est pas tout à fait cela. Ils essayèrent de fonder le mac-mahonisme qui, dans leur esprit devait préparer l’orléanisme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3493883d-ca61-3d8d-81d1-e360fee5e145",
                                        "entry_id": "8a033ae9-ad02-3258-a75f-17aeb2146a9f",
                                        "glosses": [
                                            "Membre ou partisan du Parti républicain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "230ce92e-e96d-413b-b571-463c0deef606",
                                                "sense_id": "3493883d-ca61-3d8d-81d1-e360fee5e145",
                                                "text": "Les démocrates le trouvent [Eisenhower] trop réactionnaire en politique intérieure et les républicains trop internationaliste […] en politique étrangère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c91e044-cc96-3bc4-a645-d99730c9dc15",
                                        "entry_id": "8a033ae9-ad02-3258-a75f-17aeb2146a9f",
                                        "glosses": [
                                            "Membre ou partisan des Républicains (LR)."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "98e2e1ee-68e0-353f-9452-4a50f57a5eaa",
                                        "entry_id": "8a033ae9-ad02-3258-a75f-17aeb2146a9f",
                                        "glosses": [
                                            "Espèce de passereaux qui vivent en communauté dans de grands nids suspendus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e7bf99-194a-475a-aff6-86fa412959b7",
                                                "sense_id": "98e2e1ee-68e0-353f-9452-4a50f57a5eaa",
                                                "text": "Républicain de Cabanis"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
