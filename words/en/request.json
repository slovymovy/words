{
    "word_family": [
        "requester",
        "requestable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "874bdd30-5184-3c0a-af18-af6fddb166c8",
                    "sense_definition": "To ask for something in a polite or formal way.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "asking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager <w>requested</w> additional staff to help with the busy holiday season.",
                            "target_lang_translations": {
                                "ru": "Менеджер <w>запросил</w> дополнительный персонал, чтобы помочь в напряженный праздничный сезон."
                            }
                        },
                        {
                            "text": "You can <w>request</w> a refund if the product you received is damaged.",
                            "target_lang_translations": {
                                "ru": "Вы можете <w>запросить</w> возврат средств, если полученный вами товар поврежден."
                            }
                        }
                    ],
                    "synonyms": [
                        "ask",
                        "desire",
                        "call for"
                    ],
                    "common_phrases": [
                        "request a refund",
                        "request more information",
                        "request assistance"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вежливо или официально просить о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрашивать",
                                "target_lang_sense_clarification": "официально обращаться за сведениями или вещами"
                            },
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "обращаться с просьбой"
                            },
                            {
                                "target_lang_word": "ходатайствовать",
                                "target_lang_sense_clarification": "официально просить перед властями"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7056d133-2c3c-34cc-a4e6-e83d6bb726f3",
                    "sense_definition": "To ask someone to do something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "asking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher <w>requested</w> the students to remain quiet during the exam.",
                            "target_lang_translations": {
                                "ru": "Учитель <w>попросил</w> учеников соблюдать тишину во время экзамена."
                            }
                        },
                        {
                            "text": "She <w>requested</w> him to wait in the lobby until the meeting was over.",
                            "target_lang_translations": {
                                "ru": "Она <w>попросила</w> его подождать в вестибюле до окончания встречи."
                            }
                        }
                    ],
                    "synonyms": [
                        "ask",
                        "beseech"
                    ],
                    "common_phrases": [
                        "request someone to wait"
                    ],
                    "target_lang_definitions": {
                        "ru": "Просить кого-либо сделать что-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "просить",
                                "target_lang_sense_clarification": "предлагать сделать что-то"
                            },
                            {
                                "target_lang_word": "попросить",
                                "target_lang_sense_clarification": "вежливо обратиться с предложением"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9769ea16-903b-30e1-9634-e6520834e161",
                    "sense_definition": "A formal or polite act of asking for something.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "asking_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company received a formal <w>request</w> for a price reduction from the client.",
                            "target_lang_translations": {
                                "ru": "Компания получила от клиента официальный <w>запрос</w> на снижение цены."
                            }
                        },
                        {
                            "text": "I submitted a <w>request</w> for leave to my supervisor last week.",
                            "target_lang_translations": {
                                "ru": "На прошлой неделе я подал своему руководителю <w>заявление</w> на отпуск."
                            }
                        }
                    ],
                    "synonyms": [
                        "petition",
                        "asking",
                        "wish"
                    ],
                    "antonyms": [
                        "demand"
                    ],
                    "common_phrases": [
                        "formal request",
                        "submit a request",
                        "written request"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный или вежливый акт обращения с просьбой о чем-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "официальное требование сведений или услуг"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "вежливое обращение"
                            },
                            {
                                "target_lang_word": "заявка",
                                "target_lang_sense_clarification": "сообщение о потребностях или намерениях"
                            },
                            {
                                "target_lang_word": "прошение",
                                "target_lang_sense_clarification": "письменное официальное заявление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6582b389-a85c-3a43-880c-48fd1d7ca9b2",
                    "sense_definition": "The thing that has been asked for.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "asking_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The radio station played his <w>request</w> right after the news broadcast.",
                            "target_lang_translations": {
                                "ru": "Радиостанция исполнила его <w>заявку</w> сразу после выпуска новостей."
                            }
                        },
                        {
                            "text": "It took several weeks for the library to fulfill my <w>request</w> for the rare book.",
                            "target_lang_translations": {
                                "ru": "Библиотеке потребовалось несколько недель, чтобы выполнить мой <w>запрос</w> на редкую книгу."
                            }
                        }
                    ],
                    "synonyms": [
                        "wish"
                    ],
                    "common_phrases": [
                        "fulfill a request",
                        "song request"
                    ],
                    "target_lang_definitions": {
                        "ru": "То, о чем попросили (предмет просьбы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "заявка",
                                "target_lang_sense_clarification": "оформленное пожелание или заказ"
                            },
                            {
                                "target_lang_word": "просьба",
                                "target_lang_sense_clarification": "содержание того, о чем просят"
                            },
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "требование на выдачу чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e661e9af-b76d-33d3-8304-6705abae5d30",
                    "sense_definition": "A message sent over a network to a server to perform an action.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The browser sends an HTTP <w>request</w> to the server to load the webpage.",
                            "target_lang_translations": {
                                "ru": "Браузер отправляет HTTP-<w>запрос</w> на сервер для загрузки веб-страницы."
                            }
                        },
                        {
                            "text": "The server was unable to process the <w>request</w> due to a timeout error.",
                            "target_lang_translations": {
                                "ru": "Сервер не смог обработать <w>запрос</w> из-за ошибки тайм-аута."
                            }
                        }
                    ],
                    "common_phrases": [
                        "server request",
                        "network request",
                        "process a request"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сообщение, отправляемое по сети на сервер для выполнения действия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "техническая команда серверу"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2c5eee10-3100-3dfb-9dcd-484a5ca0d3be",
                    "sense_definition": "The state of being wanted or sought after by many people.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "popularity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In those days, skilled craftsmen were in great <w>request</w> across the entire country.",
                            "target_lang_translations": {
                                "ru": "В те времена квалифицированные ремесленники пользовались большим <w>спросом</w> по всей стране."
                            }
                        },
                        {
                            "text": "The singer's latest album is in high <w>request</w> at all the local music stores.",
                            "target_lang_translations": {
                                "ru": "Последний альбом певца пользуется огромным <w>спросом</w> во всех местных музыкальных магазинах."
                            }
                        }
                    ],
                    "synonyms": [
                        "demand"
                    ],
                    "common_phrases": [
                        "in great request",
                        "in high request"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often used in the phrase 'in request'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Состояние востребованности или популярности среди многих людей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "спрос",
                                "target_lang_sense_clarification": "потребность в товарах или услугах"
                            },
                            {
                                "target_lang_word": "запрос",
                                "target_lang_sense_clarification": "потребность или стремление"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}