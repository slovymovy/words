                    {
                        "translation_id": "4e962794-b2b4-46c6-9783-5983d1566418",
                        "source_entry_id": "6e966809-44d1-36be-bcf0-18a5efd3c5dd",
                        "source_sense_id": "4c55c590-310d-3181-b67b-6fe3c58fd329",
                        "target_lang_word": "taktil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taktil",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                        "entry_id": "b89c6987-73e8-3c76-ba55-69f90c304b28",
                                        "glosses": [
                                            "das Tasten, den Tastsinn betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7537dab4-980a-4d84-95ba-336af436218a",
                                                "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                                "text": "Die taktilen Fähigkeiten sind nur ungenügend ausgeprägt."
                                            },
                                            {
                                                "example_id": "63ce444d-370a-40a9-9ab4-c5b5a23500db",
                                                "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                                "text": "Die Funktion des taktil-protopathischen Systems ist die Nutzung taktiler Informationen für das Wohlbefinden im eigenen Körper."
                                            },
                                            {
                                                "example_id": "32359efd-dcef-4b7d-80b9-2d5adfbb714b",
                                                "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                                "text": "Die Schmerzempfindung bei taktiler Hypersensibilität/Überempfindlichkeit ist paradox."
                                            },
                                            {
                                                "example_id": "e2c98e96-680e-4398-a434-d88749b6364f",
                                                "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                                "text": "Obwohl sich Zähne im Laufe des Lebens ihres „Wirtes“ durch 18 Tonnen Nahrung geradezu durchbeißen, gehören sie doch zu den taktilsten Organen und sind nichts weiter als modifizierte Tastwerkzeuge, wie sich Prof. Dr. Georg Meyer, Greifswald, nach einem Zitat von Sigmund (1867) ausdrückte."
                                            },
                                            {
                                                "example_id": "13021d12-779b-44bb-bcf5-a3ae14573455",
                                                "sense_id": "eda8a201-f5e3-3b8c-a82b-56e12d770424",
                                                "text": "Noch einmal: \"Nicht-Einmischung\" lieferte das spanische Volk auf Gedeih und Verderb an Franco aus und schützte Hitler in der taktilsten Phase seiner Kriegsvorbereitung."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
