            "pos": "verb",
            "senses": [
                {
                    "sense_id": "27419ccd-8943-318d-8330-93a5f98b3ae2",
                    "sense_definition": "een verplichting hebben of noodzaak voelen om iets te doen, vaak gebruikt in ontkennende zinnen of met beperkende woorden zoals slechts",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noodzaak",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "U <w>behoeft</w> de formulieren niet vandaag in te leveren.",
                            "target_lang_translations": {
                                "en": "You do not <w>need</w> to hand in the forms today."
                            }
                        },
                        {
                            "text": "Hij <w>behoeft</w> slechts een seintje te geven om de vergadering te starten.",
                            "target_lang_translations": {
                                "en": "He <w>only needs</w> to give a signal to start the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoeven",
                        "moeten"
                    ],
                    "common_phrases": [
                        "slechts te behoeven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To have an obligation or feel a necessity to do something, often used in negative sentences or with restrictive words like 'only'."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "need",
                                "target_lang_sense_clarification": "to be required or obliged"
                            },
                            {
                                "target_lang_word": "have to",
                                "target_lang_sense_clarification": "to be required to do something"
                            },
                            {
                                "target_lang_word": "must",
                                "target_lang_sense_clarification": "to be mandatory"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2e029be2-dd3c-344a-ad07-2a0c77096fe2",
                    "sense_definition": "iets vereisen of noodzakelijk vinden voor een bepaald doel",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "vereiste",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit complexe onderwerp <w>behoeft</w> een nadere toelichting voor de studenten.",
                            "target_lang_translations": {
                                "en": "This complex subject <w>requires</w> further explanation for the students."
                            }
                        },
                        {
                            "text": "Het plan <w>behoeft</w> geen verdere uitleg omdat alles al duidelijk is.",
                            "target_lang_translations": {
                                "en": "The plan <w>needs</w> no further explanation because everything is already clear."
                            }
                        }
                    ],
                    "synonyms": [
                        "nodig hebben"
                    ],
                    "common_phrases": [
                        "geen uitleg behoeven",
                        "toelichting behoeven"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To require or find something necessary for a specific purpose."
                    },
                    "translations": {
