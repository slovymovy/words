                "senses": [
                    {
                        "sense_id": "587de5bb-e27f-3dc1-bd86-162a2587f31f",
                        "entry_id": "3095274e-315c-3751-80c0-bd8cd99cc2ec",
                        "glosses": [
                            "Affluent du Rhin coulant en Rhénanie."
                        ],
                        "tags": [
                            "Cours d’eau"
                        ],
                        "examples": [
                            {
                                "example_id": "d3bd0e7b-135e-4d69-89fb-eca3a11fb21a",
                                "sense_id": "587de5bb-e27f-3dc1-bd86-162a2587f31f",
                                "text": "Des nuages de poussière apparaissent derrière les premières maisons qui surplombent la partie basse de la bourgade, installée sur les berges de l’Ahr."
                            }
                        ]
                    },
                    {
                        "sense_id": "3020c9db-16ba-3a78-93be-e8a5f77624a8",
                        "entry_id": "3095274e-315c-3751-80c0-bd8cd99cc2ec",
                        "glosses": [
                            "Affluent du Rienz coulant dans le Sud-Tyrol."
                        ],
                        "tags": [
