                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3f23b081-1793-3302-9e55-a2bfbee59e4f",
                                        "entry_id": "e6b00133-e080-331d-afdb-40d1b2158167",
                                        "glosses": [
                                            "Nom de nombreuses herbes aromatiques ou arbrisseaux, quelques-unes des 150 à 200 espèces contiennent des édulcorants, en particulier Stevia rebaudiana, originaire du Paraguay et au pouvoir sucrant exceptionnel.→ voir Stevia"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "593bda64-a6a7-4ac2-b668-e1218687cb14",
                                                "sense_id": "3f23b081-1793-3302-9e55-a2bfbee59e4f",
                                                "text": "Remplacez les sucres raffinés par les édulcorants naturels : stévia, sucre de bouleau, xylitol, sirop d’agave."
                                            },
                                            {
                                                "example_id": "b6c538a9-3258-44d9-959e-daa219936fcc",
                                                "sense_id": "3f23b081-1793-3302-9e55-a2bfbee59e4f",
                                                "text": "Une bouteille de 20 cl de Coca-Cola Life, qui est sucrée pour moitié avec de la stévia, contient l’équivalent de 3 morceaux de sucres, contre 6 pour une bouteille de Coca-Cola classique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
