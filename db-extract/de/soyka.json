                ],
                "senses": [
                    {
                        "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                        "entry_id": "b1fc4c6e-c658-3b1d-90a9-916a690407a6",
                        "glosses": [
                            "Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "296a54b8-0513-4b29-b601-7c1bcd6aa5ab",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Die Soykas haben dem Kampf gegen ihr Übergewicht aufgenommen."
                            },
                            {
                                "example_id": "147c441e-6863-4fca-b62b-8a313eded501",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Der alte Soyka litt an Alzheimer."
                            },
                            {
                                "example_id": "816a5b43-a0e6-4ad8-bcab-3d19a8c2b0f9",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Herrn Soykas ausufernder Alkoholkonsum ist ein Problem."
                            },
                            {
                                "example_id": "d8e114f2-0574-4a2e-a711-a017e1ade6e0",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Du kannst bei Frau Soyka ab sofort Yogakurse belegen."
                            },
                            {
                                "example_id": "5964cb93-39f3-4229-99bc-a5962e406e06",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Als Soyka aufgerufen wurde, reagierte sie nicht."
                            },
                            {
                                "example_id": "bbd8ba3b-7648-4800-b831-14f58daa9bbf",
                                "sense_id": "b0d500e4-5cc4-3cfc-ac4e-ef021bcd5c15",
                                "text": "Des Soykas liebster Zeitvertreib ist das Einsammeln von Nacktschnecken im Garten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
