                "senses": [
                    {
                        "sense_id": "b01bf061-8739-3d64-b26e-afbb53fe64b5",
                        "entry_id": "1ffff41b-257c-35ca-8229-9aa4dbcb3d55",
                        "glosses": [
                            "oficjalnie przekazana informacja"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a48c58fc-d721-41ea-8678-7aa8ec7e7ab6",
                                "sense_id": "b01bf061-8739-3d64-b26e-afbb53fe64b5",
                                "text": "Od pięciu tygodni radiostacja nadaje fałszywe meldunki. Rozumiesz? Trzeba oczyścić siatkę, wyeliminować tego, kto zdradził"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f4ee222e-374d-3d63-aad6-0c49114f6b91",
                        "entry_id": "1ffff41b-257c-35ca-8229-9aa4dbcb3d55",
                        "glosses": [
                            "zapis w książce meldunkowej osoby mieszkającej w jakimś miejscu"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    },
                    {
                        "sense_id": "98b6c7c8-7f44-326d-a082-ca575fc0c249",
                        "entry_id": "1ffff41b-257c-35ca-8229-9aa4dbcb3d55",
                        "glosses": [
                            "w tysiącu: król i dama jednakowego koloru będące w posiadaniu jednego z graczy"
                        ],
                        "tags": [
                            "karc."
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "006d7a09-e109-44aa-99e6-148e58724b52",
                        "source_entry_id": "1ffff41b-257c-35ca-8229-9aa4dbcb3d55",
                        "source_sense_id": "b01bf061-8739-3d64-b26e-afbb53fe64b5",
                        "target_lang_word": "Meldung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Meldung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e52be7e5-73db-3c6b-adaf-7ff27684bb32",
                                        "entry_id": "bd1a7611-1be3-3875-9ea5-c4d80764b1ee",
                                        "glosses": [
                                            "Weitergabe einer Information, Nachricht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf8975d0-84bd-4b86-a682-6d594c32b3ae",
                                                "sense_id": "e52be7e5-73db-3c6b-adaf-7ff27684bb32",
                                                "text": "Eine Meldung sollte kurz und präzise sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5201354-2fde-3c3d-bae5-2f59e189218b",
                                        "entry_id": "bd1a7611-1be3-3875-9ea5-c4d80764b1ee",
                                        "glosses": [
                                            "amtliche, dienstliche, nicht private Mitteilung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b30ff1b-7f66-4938-9c92-05bd8965e57e",
                                                "sense_id": "c5201354-2fde-3c3d-bae5-2f59e189218b",
                                                "text": "Der Chef empfing die Meldung mit Unwillen."
                                            },
                                            {
                                                "example_id": "e259a236-6db4-4f46-b1eb-89bae410321c",
                                                "sense_id": "c5201354-2fde-3c3d-bae5-2f59e189218b",
                                                "text": "„Und über seine Meldungen beim Jugendamt gab es sicher Aufzeichnungen oder Vermerke.“"
                                            },
                                            {
                                                "example_id": "64d8d474-b6e8-48b5-ba72-994bdd0c285c",
                                                "sense_id": "c5201354-2fde-3c3d-bae5-2f59e189218b",
                                                "text": "„Fürst Andrej ging zu Kutusow, um diesem davon Meldung zu machen, und blieb dann im Zimmer, da Kutusow ihm gestattet hatte, beim Kriegsrat zugegen zu sein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "83c991d6-872c-3568-96d6-a104121a96b7",
                                        "entry_id": "bd1a7611-1be3-3875-9ea5-c4d80764b1ee",
                                        "glosses": [
                                            "journalistische Textsorte; Klasse kurzer Nachrichtentexte"
                                        ],
                                        "tags": [
                                            "Journalismus",
                                            "Medienwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3b23855-6bed-47ca-8c7c-fa77c4a1e48c",
                                                "sense_id": "83c991d6-872c-3568-96d6-a104121a96b7",
                                                "text": "Meldungen sind kurze Nachrichtentexte."
                                            },
                                            {
                                                "example_id": "f1bd74e0-6a8f-4d31-8b80-533785086b61",
                                                "sense_id": "83c991d6-872c-3568-96d6-a104121a96b7",
                                                "text": "„Die ersten Meldungen lauteten, dass Serbien sich dem Ultimatum wider Erwarten beugen werde.“"
                                            },
                                            {
                                                "example_id": "89dab1c3-1069-45ae-8a98-ba5f5b958fe2",
                                                "sense_id": "83c991d6-872c-3568-96d6-a104121a96b7",
                                                "text": "„Am Abend des 23. Juni 1957 tickten Fernschreiber die Meldung über seine Verhaftung und Bedeutung an Zeitungsredaktionen auf fünf Kontinenten und in alle Welt hinaus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "9243f408-c025-33f9-95f6-883d4abba229",
                                        "entry_id": "bd1a7611-1be3-3875-9ea5-c4d80764b1ee",
                                        "glosses": [
                                            "Aktion, um die Bereitschaft zur Mitarbeit/Aussage zu erklären"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ec52cbd-e900-4573-8740-2ee0f2300984",
                                                "sense_id": "9243f408-c025-33f9-95f6-883d4abba229",
                                                "text": "Es werden weitere Meldungen zu freiwilligen Mitarbeit erwartet."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c018aa63-fb46-40e1-bb60-27bb189f4123",
                        "source_entry_id": "1ffff41b-257c-35ca-8229-9aa4dbcb3d55",
