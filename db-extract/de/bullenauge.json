                                    },
                                    {
                                        "sense_id": "310a2234-d3f3-3b44-8ccd-666ca40a5a0b",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A reproductive bud in a potato."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a42f9024-a848-3b81-bd95-6898d5791df3",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "The dark brown centre of a black-eyed Susan flower."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7e008d90-3421-3da6-83f3-75bb8d45adf5",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "That which resembles the eye in relative beauty or importance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "644ff0ef-717a-4e94-a9f4-0d548bb7d4e1",
                                                "sense_id": "7e008d90-3421-3da6-83f3-75bb8d45adf5",
                                                "text": "the very eye of that proverb"
                                            },
                                            {
                                                "example_id": "54f7b9ab-c5c9-484d-9792-532131130fbd",
                                                "sense_id": "7e008d90-3421-3da6-83f3-75bb8d45adf5",
                                                "text": "Athens, the eye of Greece, mother of arts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14c29c11-e873-3dbe-b6c8-4dcb3f9e9ccc",
                                        "entry_id": "a8ec1ec6-761b-3359-90d7-bc0a4eeee90f",
                                        "glosses": [
                                            "A shade of colour; a tinge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0aedaa46-1829-42dd-94c0-cd194a81c63b",
                                                "sense_id": "14c29c11-e873-3dbe-b6c8-4dcb3f9e9ccc",
