            {
                "entry_id": "f6729596-34e1-39f1-9af9-86d6f8c5931d",
                "word": "uitmoorden",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "1f3692d5-6dd6-381e-9425-455fb4b02b2f",
                        "entry_id": "f6729596-34e1-39f1-9af9-86d6f8c5931d",
                        "glosses": [
                            "door doodmaken zorgen dat een groep mensen helemaal verdwenen is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7b282140-67b9-48d2-81fa-42cd82a94f4f",
                                "sense_id": "1f3692d5-6dd6-381e-9425-455fb4b02b2f",
                                "text": "Dat een mensenleven niets waard is voor justitie,bewijst het proefverlof van X. die zijn ex-vriendin en hele schoonfamilie uitmoordde. Na dertien jaar ruikt deze moordenaar al weer aan zijn vrijheid en dat terwijl de slachtoffers levenslang krijgen."
                            },
                            {
                                "example_id": "24976ae9-307f-48d5-bab2-395c02421e01",
                                "sense_id": "1f3692d5-6dd6-381e-9425-455fb4b02b2f",
                                "text": "Volgens schattingen van de organisatie worden nog ongeveer 1500 jezidi-vrouwen en -meisjes vastgehouden door IS. De jezidi's zijn sinds 2014 slachtoffer van IS dat de mannen uitmoordt en de vrouwen en meisjes als slaven houdt. IS beschouwt de leden van de etnische minderheid, die een heel eigen geloof aanhangen, als duivelsaanbidders."
                            }
                        ]
                    }
