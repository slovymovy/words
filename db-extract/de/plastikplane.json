                "senses": [
                    {
                        "sense_id": "d58bdf86-e1f8-3b19-ad41-f1e07a144108",
                        "entry_id": "e50d73f1-cf0b-3694-af28-f1beb11ec1ea",
                        "glosses": [
                            "Decke aus Plastik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "768417e2-1fd4-48eb-a347-39b92bac695e",
                                "sense_id": "d58bdf86-e1f8-3b19-ad41-f1e07a144108",
                                "text": "„Das Küchenfenster hinten im Haus hatte noch immer keine neue Scheibe und war nur mit einer Plastikplane abgedeckt.“"
                            },
                            {
                                "example_id": "57c0b328-5a97-4c67-aeba-b18cd6958896",
                                "sense_id": "d58bdf86-e1f8-3b19-ad41-f1e07a144108",
                                "text": "„Das Mädchen lebt mit seiner Familie in einer Hütte aus Ästen, Lehm, Plastikplanen und Wellblech.“"
                            },
                            {
                                "example_id": "e0ac972e-5855-43d1-ada6-77e1fd2f6051",
                                "sense_id": "d58bdf86-e1f8-3b19-ad41-f1e07a144108",
                                "text": "„Die Plastikplanen der Zelte konnten den Sandstürmen tatsächlich nicht trotzen.“"
                            },
                            {
                                "example_id": "390f49fc-ab21-4c92-a0f2-a6081abde4a1",
                                "sense_id": "d58bdf86-e1f8-3b19-ad41-f1e07a144108",
                                "text": "„Der aus unverputzten Betonblöcken bestehende fensterlose Raum war leer bis auf drei Maschinentische auf Rädern. Auf zweien lagen mit Plastikplanen abgedeckte Leichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
