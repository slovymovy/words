                        "glosses": [
                            "Celui qui tisse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97074818-1215-4392-bae7-57bde81f8988",
                                "sense_id": "9b1f0e22-a621-3a4c-ae30-9555f83c1309",
                                "text": "Les Monts du Lyonnais et du Beaujolais, qui abritaient depuis un temps immémorial le tissage domestique des toiles, furent pour la métropole de la soie une réserve inépuisable d'ouvriers héréditairement façonnés à l'austère existence du tisseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e6c42de3-d0e3-4125-8f23-3964124728c0",
                        "source_entry_id": "5f632e80-e52e-3eb7-be74-db62b0a1f63f",
                        "source_sense_id": "9b1f0e22-a621-3a4c-ae30-9555f83c1309",
                        "target_lang_word": "Weber",
