{
    "word_family": [
        "lead",
        "leaded",
        "unlead"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bab39d1c-cc6e-3670-94af-18706a2e4bca",
                    "sense_definition": "Not containing lead, especially of petrol or gasoline.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Most modern cars are designed to run on <w>unleaded</w> petrol to reduce harmful emissions.",
                            "target_lang_translations": {
                                "ru": "Большинство современных автомобилей рассчитаны на работу на <w>неэтилированном</w> бензине для снижения вредных выбросов."
                            }
                        },
                        {
                            "text": "He pulled up to the petrol station and filled his tank with <w>unleaded</w> fuel.",
                            "target_lang_translations": {
                                "ru": "Он подъехал к заправке и наполнил бак <w>неэтилированным</w> топливом."
                            }
                        }
                    ],
                    "synonyms": [
                        "lead-free",
                        "leadless",
                        "nonleaded"
                    ],
                    "antonyms": [
                        "leaded"
                    ],
                    "common_phrases": [
                        "unleaded petrol",
                        "unleaded fuel",
                        "unleaded gasoline"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не содержащий свинца (особенно о бензине или топливе)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неэтилированный",
                                "target_lang_sense_clarification": "о бензине или топливе"
                            },
                            {
                                "target_lang_word": "без содержания свинца",
                                "target_lang_sense_clarification": "о топливе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bd4017f-25af-3960-9d25-439cc5d76040",
                    "sense_definition": "Decaffeinated, especially of coffee.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would prefer an <w>unleaded</w> coffee since it is already late in the evening.",
                            "target_lang_translations": {
                                "ru": "Я бы предпочел кофе <w>без кофеина</w>, так как уже поздний вечер."
                            }
                        },
                        {
                            "text": "The diner only had regular coffee left, so she couldn't get her usual <w>unleaded</w> brew.",
                            "target_lang_translations": {
                                "ru": "В закусочной оставался только обычный кофе, поэтому она не смогла получить свой привычный напиток <w>без кофеина</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "decaffeinated",
                        "caffeine-free",
                        "decaf"
                    ],
                    "common_phrases": [
                        "unleaded coffee"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used humorously or informally to refer to decaffeinated drinks"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Без кофеина (особенно о кофе, в разговорной речи)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "без кофеина",
                                "target_lang_sense_clarification": "о кофе"
                            },
                            {
                                "target_lang_word": "декофеинизированный",
                                "target_lang_sense_clarification": "о кофе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6063b3a-8b4b-3630-a588-48d91e6725c2",
                    "sense_definition": "Having a low alcohol content.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beverage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since he was the designated driver for the night, he ordered an <w>unleaded</w> beer.",
                            "target_lang_translations": {
                                "ru": "Поскольку в этот вечер он был за рулем, он заказал <w>безалкогольное</w> пиво."
                            }
                        },
                        {
                            "text": "They offer a selection of <w>unleaded</w> drinks for those who prefer not to consume alcohol.",
                            "target_lang_translations": {
                                "ru": "Они предлагают выбор <w>безалкогольных</w> напитков для тех, кто предпочитает не употреблять алкоголь."
                            }
                        }
                    ],
                    "synonyms": [
                        "light"
                    ],
                    "common_phrases": [
                        "unleaded beer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used informally to refer to low-alcohol or non-alcoholic beverages"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "С низким содержанием алкоголя или безалкогольный (разговорное)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безалкогольный",
                                "target_lang_sense_clarification": "о пиве или напитках"
                            },
                            {
                                "target_lang_word": "слабоалкогольный",
                                "target_lang_sense_clarification": "о напитках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "09fb65ea-3c8a-36f6-97a9-ec2b1a81f992",
                    "sense_definition": "Containing no more than 0.05 grams of lead per gallon.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fuel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Environmental regulations specify that <w>unleaded</w> fuel must not exceed strict chemical limits.",
                            "target_lang_translations": {
                                "ru": "Экологические нормы предписывают, что <w>неэтилированное</w> топливо не должно превышать строгие химические лимиты."
                            }
                        },
                        {
                            "text": "The laboratory tested the fuel sample to confirm it met the legal standard for <w>unleaded</w> gasoline.",
                            "target_lang_translations": {
                                "ru": "Лаборатория протестировала образец топлива, чтобы подтвердить его соответствие установленному стандарту для <w>неэтилированного</w> бензина."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Содержащий не более 0,05 грамма свинца на галлон (технический стандарт)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неэтилированный",
                                "target_lang_sense_clarification": "соответствующий экологическим нормам"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb275228-1f6d-3060-b24a-93d36a4abfd8",
