                        ],
                        "form": "die Katerfrühstücke"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                        "entry_id": "5b4fb5c6-1546-3a98-a827-1a04b0a5a8cc",
                        "glosses": [
                            "spezielle Mahlzeit, die man meist am Vormittag nach einer Nacht mit viel Alkoholkonsum, wenn der Kopf schmerzt, zu sich nimmt (zum Beispiel etwas Salziges wie Rollmops oder etwas Saures wie Sauerkraut, saure Gurken oder etwas mit einer Zitrone)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cb2fbad-4625-4af7-b3aa-2cede789986b",
                                "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                                "text": "Beim Katerfrühstück am Sonntagmorgen waren alle ziemlich schweigsam."
                            },
                            {
                                "example_id": "14bc1a96-1554-4e92-abc1-eecd79c0691a",
                                "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                                "text": "Die Übernachtung im Doppelzimmer kostet inklusive reichhaltigem Katerfrühstück am Neujahrsmorgen 99,90 Euro für zwei Personen."
                            },
                            {
                                "example_id": "182e8091-937b-467b-aa31-10c4b2648414",
                                "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                                "text": "Neujahr: Sie haben Kopfschmerzen und fühlen sich verkatert? Kein Problem. Mit unseren Tipps fürs Katerfrühstück sind Sie bald wieder fit - und schaffen einen guten Start ins neue Jahr."
                            },
                            {
                                "example_id": "2b5cbd10-c96e-49f4-898d-59dec817d273",
                                "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                                "text": "Manche schwören auf Kopfschmerztabletten und Wasser, andere auf Gemüsesäfte oder einen Löffel Honig vorm Schlafengehen. Und auch der Hering als klassisches Katerfrühstück hat seine Anhänger."
                            },
                            {
                                "example_id": "63eb2f4f-5986-4c72-bd85-9573fdc86b77",
                                "sense_id": "fb375d04-f763-372f-9d80-7c51ca74ac0e",
                                "text": "Das Katerfrühstück [nach dem Karneval sollte] viel Fett und Eiweiß enthalten, außerdem Mineralstoffe. Ein Rollmops ist eine gute Idee, oder auch eine heiße Tasse Suppe oder Salzbrezel."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
