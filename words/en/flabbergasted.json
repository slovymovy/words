{
    "word_family": [
        "flabbergast"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "bba1a30d-1f42-3db0-826b-b87750ee7658",
                    "sense_definition": "Extremely surprised, shocked, or astonished.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "surprise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>flabbergasted</w> when she heard the news about the sudden promotion.",
                            "target_lang_translations": {
                                "cs": "Byla <w>ohromená</w>, když slyšela zprávy o tom náhlém povýšení."
                            }
                        },
                        {
                            "text": "The audience was <w>flabbergasted</w> by the magician's incredible final trick.",
                            "target_lang_translations": {
                                "cs": "Publikum bylo <w>v šoku</w> z kouzelníkova neuvěřitelného závěrečného triku."
                            }
                        }
                    ],
                    "synonyms": [
                        "astonished",
                        "amazed",
                        "dumbfounded",
                        "shocked"
                    ],
                    "common_phrases": [
                        "completely flabbergasted"
                    ],
                    "target_lang_definitions": {
                        "cs": "Extrémně překvapený, šokovaný nebo ohromený."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ohromený",
                                "target_lang_sense_clarification": "vyjadřuje stav velkého údivu"
                            },
                            {
                                "target_lang_word": "v šoku",
                                "target_lang_sense_clarification": "vyjadřuje stav náhlého překvapení"
                            },
                            {
                                "target_lang_word": "paf",
                                "target_lang_sense_clarification": "hovorový výraz pro naprosté překvapení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "559d08a2-34a4-3d88-9eb3-88f718d65bf5",
