                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ecologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wetenschappers waarschuwen dat de <w>belastbaarheid</w> van onze planeet bijna is bereikt.",
                            "target_lang_translations": {
                                "en": "Scientists warn that our planet's <w>carrying capacity</w> has almost been reached."
                            }
                        },
                        {
                            "text": "De ecologische <w>belastbaarheid</w> van het natuurgebied staat onder grote druk door het toerisme.",
                            "target_lang_translations": {
