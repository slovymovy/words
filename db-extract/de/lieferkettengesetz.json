                "senses": [
                    {
                        "sense_id": "3892927d-3df3-360d-9378-6da62db49305",
                        "entry_id": "d9f7489f-9e67-36e8-b1e2-67ce410358c0",
                        "glosses": [
                            "Gesetz, das Unternehmen verpflichtet, auf bestimmte Dinge in der Lieferkette zu achten, zum Beispiel die Einhaltung von Menschenrechten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9474d600-05a2-4800-b595-79fd68fb3e26",
                                "sense_id": "3892927d-3df3-360d-9378-6da62db49305",
                                "text": "„Das europaweite Lieferkettengesetz kommt: Die Mitgliedstaaten haben Plänen zugestimmt, große Unternehmen zur Rechenschaft zu ziehen, wenn sie von Menschenrechtsverstößen bei Zulieferern und Subunternehmern profitieren.“"
                            },
                            {
                                "example_id": "b6b6de73-d133-4acd-a7ec-a251d335a9f8",
                                "sense_id": "3892927d-3df3-360d-9378-6da62db49305",
                                "text": "„Menschenrechte über den Rechtsweg durchzusetzen, scheint nicht einfach: Das neue deutsche Lieferkettengesetz sieht nur eine auf direkte Zulieferer begrenzte Verantwortung für hiesige Unternehmen vor – und dem Generalbundesanwalt, fürchtet Saage-Maaß, könnten solche Fälle womöglich zu komplex vorkommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
