                "senses": [
                    {
                        "sense_id": "09049d0c-995a-36b4-8a24-995926fbe9a0",
                        "entry_id": "d41d3e56-3b5e-3e58-b03b-ec91104de5e9",
                        "glosses": [
                            "Animal imaginaire ressemblant à un taureau dont les cornes retournées sont inoffensives et qui se défend en émettant un gaz nauséabond."
                        ],
                        "tags": [
                            "Fantastique"
                        ],
                        "examples": [
                            {
                                "example_id": "65dfefa3-02a2-4bea-8cc8-e063647943e7",
                                "sense_id": "09049d0c-995a-36b4-8a24-995926fbe9a0",
                                "text": "Comme un avertissement aux voyageurs, le bonacon figure sur au moins deux cartes du monde, celle de Hereford (fin du XIIᵉ siècle) et celle d’Ebstorf, dessinée au XIIᵉ, qu’a longuement étudiée Chiara Frugoni […], où il fait fuir un guerrier pourtant pourvu d’une lance et d’un écu."
                            }
                        ]
                    }
