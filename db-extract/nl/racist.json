                    {
                        "translation_id": "0325dd93-c251-460f-9aa7-e4e3a3755f6e",
                        "source_entry_id": "cefb949b-6b1e-39ae-9192-1ca00b3e0134",
                        "source_sense_id": "c8ede134-b06c-3bb7-b4b1-164b992e3174",
                        "source_sense_description": "Rassist, Rassistin",
                        "target_lang_word": "Rassist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Rassist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                        "entry_id": "731851a1-b39b-3a80-883a-0830075ace72",
                                        "glosses": [
                                            "Person, die die eigene Volksgruppe für überlegen und/oder Angehörige anderer Völker für minderwertig hält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "857da409-c95e-4be4-8349-1a263d800e73",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "„Weiße Rassisten verüben Bombenanschläge, um wahllos Tod und Verderben zu stiften.“"
                                            },
                                            {
                                                "example_id": "19d15001-73c9-419f-8f99-3f6ab6cc2372",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "Wegen seiner radikalen Ansichten wurde er schon oft als Rassist beschimpft."
                                            },
                                            {
                                                "example_id": "32317e3f-65d1-4e68-af5d-a1323c279fa6",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "„Ich bin mir nicht sicher, ob mein Lehrer ein Rassist war.“"
                                            },
                                            {
                                                "example_id": "bc474a83-ae12-4bec-b624-08ab26bd3790",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "„Unabhängig von meinem Versagen als Rassist war mir klar, daß ich im Süden nicht willkommen war.“"
                                            },
                                            {
                                                "example_id": "d94cfe14-02aa-4d87-9434-27bee637ecf8",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "„Von ein paar barmherzigen Missionaren abgesehen, zeigten sich die Deutschen als Rassisten.“"
                                            },
                                            {
                                                "example_id": "db514262-0fdf-4480-a4c1-75db40889e2a",
                                                "sense_id": "df099572-b0fc-3f1d-91bb-f42603c3c123",
                                                "text": "„Donald Trump ist kein taktischer Rassist, wie es bisher häufig hieß, der aus wahltaktischen Überlegungen heraus mit Bedacht und Geschick rassistische Reflexe seiner überwiegend weißen und männlichen Wählerschicht bedient. Jetzt ist Gewissheit: Donald Trump ist tatsächlich ein Rassist. Er meint, was er sagt. Aus voller Überzeugung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9afe7ed9-8a98-487a-acbe-11ff9318fc6d",
                        "source_entry_id": "cefb949b-6b1e-39ae-9192-1ca00b3e0134",
                        "source_sense_id": "c8ede134-b06c-3bb7-b4b1-164b992e3174",
