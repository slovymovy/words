                ],
                "senses": [
                    {
                        "sense_id": "0f88169b-dfbe-3a95-9467-b9de821c7462",
                        "entry_id": "f90ca979-db80-3b7d-a642-7599c82fc246",
                        "glosses": [
                            "Einstellung/Geisteshaltung einer Person, wissenschaftlichen Prinzipien entsprechende Anstrengungen neue Erkenntnisse zu gewinnen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb0e09f7-2902-4e03-8af9-f25ef055affa",
                                "sense_id": "0f88169b-dfbe-3a95-9467-b9de821c7462",
                                "text": "„Wallace’ Forschergeist war geweckt, denn aus der botanischen Fachliteratur wusste er, dass allein auf den Britischen Inseln mehr als 3000 Käferarten herumkrabbelten.“"
                            },
                            {
                                "example_id": "697ded98-2907-4e69-a97a-1eaf8bfa597c",
                                "sense_id": "0f88169b-dfbe-3a95-9467-b9de821c7462",
                                "text": "„Rastlos ist der Schritt der Zeit! Immer neue Bahnen bricht sie dem Forschergeiste des Menschen, in Höhen und Tiefen enthüllt sie seinem Auge neue Wunder, neue Räthsel, und die Wissenschaft strebt eben so rastlos, jene zu erfassen, zu begreifen, diese zu lösen.“"
                            },
                            {
                                "example_id": "eba42a26-f4b5-48bf-89ea-e14e51e1cc59",
                                "sense_id": "0f88169b-dfbe-3a95-9467-b9de821c7462",
                                "text": "„So jungenhaft begeisterungsfähig war er, so sehr von Forschergeist beseelt, dass sich seine Untergebenen davon anstecken ließen wie von einem Fieber, sich flugs aus seiner Gegenwart entfernten und ihr gelehrtes und höchst kultiviertes Leben den primitivsten Stämmen in Regionen anvertrauten, wo ein Fremder immer noch mit Argwohn betrachtet wurde und stets Gefahr lief, Ungemach über sich zu bringen.“"
                            },
                            {
                                "example_id": "3ecc0551-0329-4a9a-a2f9-f8c5cd28cc99",
                                "sense_id": "0f88169b-dfbe-3a95-9467-b9de821c7462",
                                "text": "„Und ich will mich nicht beklagen, die beiden waren wunderbare Vorbilder in Fragen des Forschergeists, der Partnerschaftlichkeit, akademischer Leidenschaft und Leistungsbereitschaft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "1521beb1-4813-3053-961a-aef0c5ef8fb1",
                        "entry_id": "f90ca979-db80-3b7d-a642-7599c82fc246",
                        "glosses": [
                            "Person, die das Verlangen hat, sich neues Wissen anzueignen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a02a42c0-fd6e-4783-9155-722d60226e4c",
                                "sense_id": "1521beb1-4813-3053-961a-aef0c5ef8fb1",
                                "text": "„Vermöge der Erkenntnis unserer inneren Gesetze können und müssen wir Staat und Kirche einrichten, in beiden aber dem Forschergeiste, der alles in Frage stellen darf, freien Spielraum lassen, sonst legen wir wieder durch äußere Gesetze unsere innere Freiheit in Banden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
