                "senses": [
                    {
                        "sense_id": "526c2fea-82ba-3196-8d16-f50851a9c6fd",
                        "entry_id": "d1e2bd5e-0af5-3249-a1cc-eb171c8e7dcb",
                        "glosses": [
                            "Couplage de dynamo et d’alternateur qui transforme les courants alternatifs en courants continus, ou inversement."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "da715acd-0615-4d73-86e4-a8330da7ac44",
                                "sense_id": "526c2fea-82ba-3196-8d16-f50851a9c6fd",
                                "text": "L’inconvénient de la commutatrice est que le facteur de puissance du courant qui l’alimente doit varier avec la charge, tandis que dans les groupes transformateurs le compoundage de la tension continue est indépendant du courant alternatif."
                            },
                            {
                                "example_id": "a9e7f645-546a-4e53-a3fd-6dbb0099ac53",
                                "sense_id": "526c2fea-82ba-3196-8d16-f50851a9c6fd",
                                "text": "Voici quelques années , ces appareils nécessitaient une commutatrice fournissant le courant à la périodicité requise pour les vibrateurs. Actuellement on dispose de redresseurs plus simples et moins coûteux."
                            }
                        ]
                    }
                ],
