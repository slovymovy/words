                    {
                        "sense_id": "13ff7b15-f2f0-3c30-87b9-31ee24ac192b",
                        "entry_id": "bcd5a4cd-ef66-3fce-945b-9df3be233d96",
                        "glosses": [
                            "Einrichtung, in der man seine Fitness verbessern kann"
                        ],
                        "tags": [
                            "colloquial",
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "27034208-b677-4633-8dbd-2f77a53d1537",
                                "sense_id": "13ff7b15-f2f0-3c30-87b9-31ee24ac192b",
                                "text": "Manch einer meint, man müsse täglich in die Muckibude gehen, um körperlich fit zu bleiben."
                            },
                            {
                                "example_id": "491dddb6-4181-4914-9bb9-f0e4a4c1ae23",
                                "sense_id": "13ff7b15-f2f0-3c30-87b9-31ee24ac192b",
                                "text": "Morgen gehe ich nach der Schule noch für ein paar Stunden in die Muckibude."
                            },
                            {
                                "example_id": "ec795d75-8fd9-48ab-913d-472eec35aafc",
                                "sense_id": "13ff7b15-f2f0-3c30-87b9-31ee24ac192b",
                                "text": "„Fred will ja unheimlich gern cool sein und deswegen rennt er dauernd in diese gehobene Muckibude, wo er sein Trophy-Girl auch kennen gelernt hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
