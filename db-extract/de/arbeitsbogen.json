                ],
                "senses": [
                    {
                        "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                        "entry_id": "1680f51b-83bc-3c3b-b3cc-d7022abc1ddc",
                        "glosses": [
                            "Seite mit Aufgabenstellungen (für den Schulunterricht)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e77edbb3-7934-49d5-a73c-6de3814aa6a3",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„In der zwölften Aufgabe soll das Kind mit einem Stift den eingezeichneten Linien in einem Feld im Arbeitsbogen folgen, während der Testleiter dazu Anweisungen gibt.“"
                            },
                            {
                                "example_id": "aaa86425-b7e7-44f7-8ebd-746266d960ef",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„Auf diesem Arbeitsbogen, auf dem ein Periskop vorgegeben wird, soll es um das Einzeichnen der Lichtstrahlen gehen.“"
                            },
                            {
                                "example_id": "92fbef79-6317-439d-b68c-db496402a66c",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„Ich merke, dass der Sturm auf die Bastille noch besprochen werden muss, bevor ich die neuen Arbeitsbogen austeile.“"
                            },
                            {
                                "example_id": "88de9831-fbb8-4831-b23e-469b354d6cf2",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„Bitte nehmen Sie diese Einschätzung auf dem Arbeitsbogen vor, den ich Ihnen nun austeile.““"
                            },
                            {
                                "example_id": "f13f337f-accd-4b91-8e05-6642dc7e50fa",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„Diese umfangreiche Übungssammlung enthält Materialien und Arbeitsbögen für jugendliche und erwachsene Menschen, die stottern.“"
                            },
                            {
                                "example_id": "95c9b936-1ba7-42c8-8a21-09a68b5575c2",
                                "sense_id": "32019a0b-0310-3e22-b3f5-ca4fffe581ba",
                                "text": "„Die Arbeitsbögen können während des Unterrichts oder als Hausaufgabe ausgefüllt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
