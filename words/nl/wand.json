            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8990863d-221d-31a1-8b9b-deda3617b5bf",
                    "sense_definition": "een verticale afscheiding tussen twee vertrekken in een gebouw",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "architectuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je kunt deze <w>wand</w> beter een lichtere kleur geven om de kamer groter te laten lijken.",
                            "target_lang_translations": {
                                "en": "It is better to give this <w>wall</w> a lighter color to make the room look larger.",
                                "ru": "Эту <w>стену</w> лучше покрасить в более светлый цвет, чтобы комната казалась больше."
                            }
                        },
                        {
                            "text": "De schilder heeft de <w>wand</w> van de woonkamer gisteren wit gemaakt.",
                            "target_lang_translations": {
                                "en": "The painter made the living room <w>wall</w> white yesterday.",
                                "ru": "Маляр вчера покрасил <w>стену</w> в гостиной в белый цвет."
                            }
                        }
                    ],
                    "synonyms": [
                        "muur",
                        "tussenwand"
                    ],
                    "common_phrases": [
                        "glazen wand",
                        "houten wand"
                    ],
                    "target_lang_definitions": {
                        "en": "a vertical partition between two rooms in a building",
                        "ru": "вертикальная перегородка между двумя помещениями в здании"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wall",
                                "target_lang_sense_clarification": "interior or exterior structure of a building"
                            },
                            {
                                "target_lang_word": "partition",
                                "target_lang_sense_clarification": "a thin wall dividing a room"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "стена",
                                "target_lang_sense_clarification": "внутренняя или внешняя конструкция здания"
                            },
                            {
                                "target_lang_word": "перегородка",
                                "target_lang_sense_clarification": "тонкая стена, разделяющая комнату"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "95d938cc-88e2-38d8-a78a-9d2000da3cce",
                    "sense_definition": "een verticaal oprijzend vlak, zoals de zijde van een berg",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geografie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De noordelijke <w>wand</w> van de berg is erg steil en gevaarlijk voor klimmers.",
                            "target_lang_translations": {
                                "en": "The northern <w>face</w> of the mountain is very steep and dangerous for climbers.",
                                "ru": "Северный <w>склон</w> горы очень крутой и опасный для альпинистов."
                            }
                        },
                        {
                            "text": "Vanaf het dal kun je de grijze <w>wand</w> van de rotsen goed zien.",
                            "target_lang_translations": {
                                "en": "From the valley, you can clearly see the gray <w>wall</w> of the rocks.",
                                "ru": "Из долины хорошо видна серая <w>стена</w> скал."
                            }
                        }
                    ],
                    "synonyms": [
                        "bergwand",
                        "rotswand",
                        "muur"
                    ],
                    "common_phrases": [
                        "steile wand"
                    ],
                    "target_lang_definitions": {
                        "en": "a vertically rising surface, such as the side of a mountain",
                        "ru": "вертикально поднимающаяся поверхность, например, склон горы"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "face",
                                "target_lang_sense_clarification": "the side of a mountain or cliff"
                            },
                            {
                                "target_lang_word": "wall",
                                "target_lang_sense_clarification": "a very steep slope of rock or ice"
                            },
                            {
                                "target_lang_word": "precipice",
                                "target_lang_sense_clarification": "a very steep rock face"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "склон",
                                "target_lang_sense_clarification": "сторона горы или утеса"
                            },
                            {
                                "target_lang_word": "стена",
                                "target_lang_sense_clarification": "очень крутой склон скалы или льда"
                            },
                            {
                                "target_lang_word": "отвес",
                                "target_lang_sense_clarification": "вертикальная скалистая поверхность"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a1040ce0-5b8e-3a52-a777-fde68ed8902e",
                    "sense_definition": "de buitenste laag of omsluiting van een object of organisme",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structuur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>wand</w> van de slagader is dikker dan die van een ader.",
                            "target_lang_translations": {
                                "en": "The <w>wall</w> of the artery is thicker than that of a vein.",
                                "ru": "<w>Стенка</w> артерии толще, чем у вены."
                            }
                        },
                        {
                            "text": "De dunne <w>wand</w> van de cel beschermt de inhoud tegen invloeden van buitenaf.",
                            "target_lang_translations": {
                                "en": "The thin <w>wall</w> of the cell protects the contents from outside influences.",
                                "ru": "Тонкая <w>стенка</w> клетки защищает содержимое от внешних воздействий."
                            }
                        }
                    ],
                    "synonyms": [
                        "omhulsel",
                        "vlies"
                    ],
                    "common_phrases": [
                        "dubbele wand",
                        "dunne wand"
                    ],
                    "target_lang_definitions": {
                        "en": "the outermost layer or enclosure of an object or organism",
                        "ru": "внешний слой или оболочка объекта или организма"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "wall",
                                "target_lang_sense_clarification": "the containing structure of an organ, cell, or vessel"
                            },
                            {
                                "target_lang_word": "lining",
                                "target_lang_sense_clarification": "the inner layer of an organ or container"
                            },
                            {
                                "target_lang_word": "shell",
                                "target_lang_sense_clarification": "the hard outer layer of an object"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "стенка",
                                "target_lang_sense_clarification": "структура органа, клетки или сосуда"
                            },
                            {
