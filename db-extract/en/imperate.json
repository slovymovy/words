                            {
                                "example_id": "5ac104e2-c932-4079-a6fb-d91213582b2e",
                                "sense_id": "e41cb575-e738-3e82-9ef0-bb86a7c1389d",
                                "text": "There be duties […] imperated or governed by religion."
                            }
