                        "entry_id": "0fec463f-1638-31b8-b109-8e2eca6a79f2",
                        "glosses": [
                            "het vermogen hebbend gemakkelijk van persoon op persoon overgedragen te worden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8a93cde-924d-400a-afb0-7eeb7a5b0fa3",
                                "sense_id": "83e0477a-39c4-39d6-9b92-290309b246e9",
                                "text": "Dit is de besmettelijkste vorm van het virus."
                            },
                            {
                                "example_id": "00d54983-21f9-41a5-af2b-9817f5179d6a",
                                "sense_id": "83e0477a-39c4-39d6-9b92-290309b246e9",
                                "text": "Omdat overal besmettelijke Giardia-parasieten in het water konden zitten, was het noodzakelijk om het water te zuiveren alvorens het te drinken."
                            }
                        ]
                    }
                ],
