                "translations": [
                    {
                        "translation_id": "fdc10183-feb7-4739-b962-813f865955ba",
                        "source_entry_id": "aca82e35-e05b-3e9b-8c0b-a916b719a256",
                        "source_sense_id": "207c521f-4e59-34d6-8b48-3e0bcb10ce1f",
                        "target_lang_word": "physicality",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physicality",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                        "entry_id": "3e0c92de-bd4c-3b54-8511-6b8b882ac05a",
                                        "glosses": [
                                            "Physical attributes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75d52984-81f9-4097-a6cf-7994572fe6d3",
                                                "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                                "text": "Their bodies started to melt, and lost what physicality they had. Pretty soon, all of the test subjects had melted together into … Those."
                                            },
                                            {
                                                "example_id": "9a67316b-ed7e-4f34-b41e-aa03a8d128db",
                                                "sense_id": "09c98cb1-a756-3d1d-a375-49e67033bfd6",
                                                "text": "At the heart of that was McTominay, using his physicality to break down Spanish momentum, and his reading of the game to stymie their attacks."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "63a16da1-eb51-32a2-974b-6fd55cb53b0c",
                                        "entry_id": "3e0c92de-bd4c-3b54-8511-6b8b882ac05a",
                                        "glosses": [
                                            "Obsession with physical urges."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0bdd8c0-70e3-4075-81e4-d20ba758e9de",
                        "source_entry_id": "aca82e35-e05b-3e9b-8c0b-a916b719a256",
                        "source_sense_id": "207c521f-4e59-34d6-8b48-3e0bcb10ce1f",
                        "target_lang_word": "physique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ade113fb-f4de-30a5-a30a-c8c7ee543908",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Qui s’exprime dans le monde matériel sous une forme mesurable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "18090b4a-7da3-4c75-afc0-9dcfa7071d2c",
                                                "sense_id": "ade113fb-f4de-30a5-a30a-c8c7ee543908",
                                                "text": "Phénomènes physiques."
                                            },
                                            {
                                                "example_id": "076568d7-2a23-44f5-b373-b489c0601199",
                                                "sense_id": "ade113fb-f4de-30a5-a30a-c8c7ee543908",
                                                "text": "Propriétés physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39ea435d-ee6a-3d89-a400-4d5b46787ec8",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Relatif à la science de la physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3be3a536-c92f-43c4-a390-4aa83b735256",
                                                "sense_id": "39ea435d-ee6a-3d89-a400-4d5b46787ec8",
                                                "text": "Il y a impossibilité morale et impossibilité physique à ce qu’un pareil événement ait eu lieu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bacd1853-490a-351e-9db4-89dec8830e45",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Qui se rapporte au corps humain."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0d6bb61e-3189-4b1d-8d53-24b396545262",
                                                "sense_id": "bacd1853-490a-351e-9db4-89dec8830e45",
                                                "text": "Le soir, dédaignant les taxis, je rentrais à bord presque toujours en courant pour me maintenir en bonne condition physique."
                                            },
                                            {
                                                "example_id": "01cde5eb-155e-41eb-bce8-7b078c1e24d3",
                                                "sense_id": "bacd1853-490a-351e-9db4-89dec8830e45",
                                                "text": "Exercices physiques. — Qualités physiques."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3745c9af-6f30-36b3-ad6b-6a71dc1a82fb",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Ressenti matériellement dans son propre corps, dans sa chair."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9029bccb-444e-42e9-bd16-004e15710858",
                                                "sense_id": "3745c9af-6f30-36b3-ad6b-6a71dc1a82fb",
                                                "text": "La douleur physique."
                                            },
                                            {
                                                "example_id": "bcffe2a5-330e-40d3-b6c1-1a916dc6c11b",
                                                "sense_id": "3745c9af-6f30-36b3-ad6b-6a71dc1a82fb",
                                                "text": "Une sensation physique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2f2b125-6f1f-3d47-8f84-8f936caa8a86",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Ressenti matériellement dans son propre corps, dans sa chair.",
                                            "Sensuel, charnel (par opposition à sentimental) ; sexuel."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0aba26e3-69cb-4bb5-b7e9-3fd82669ee63",
                                                "sense_id": "b2f2b125-6f1f-3d47-8f84-8f936caa8a86",
                                                "text": "L’ardeur que mettait John Wesley à convertir des femmes jeunes et jolies tenait à la fois du zèle religieux le plus sincère et d’un désir physique, peut-être inconnu de lui même."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f2201af0-2cc0-3255-96c4-50729ba296cf",
                                        "entry_id": "6b245e7f-9c86-351f-8867-dd30ff1204c0",
                                        "glosses": [
                                            "Ressenti matériellement dans son propre corps, dans sa chair.",
                                            "Incontrôlable, qui est de l’ordre du réflexe, viscéral (en parlant d’une réaction de rejet)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf92d501-70d0-4563-af69-5beb3015b8ca",
                                                "sense_id": "f2201af0-2cc0-3255-96c4-50729ba296cf",
                                                "text": "C’est physique, je ne peux pas supporter cette personne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "physique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94a7c901-a781-38d0-8206-7ea6fa867175",
                                        "entry_id": "1bef3f22-543d-33f8-9c09-dd2edfb93094",
                                        "glosses": [
                                            "Science qui étudie la nature de la matière, de l’énergie et de leurs interactions."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80df35a8-f5af-419f-b28b-035fe618db6e",
                                                "sense_id": "94a7c901-a781-38d0-8206-7ea6fa867175",
                                                "text": "Les lois de la physique ne permettent pas de filer plus vite que la vitesse de la lumière."
                                            },
                                            {
                                                "example_id": "82b9289a-a70c-4678-b943-922bf202f45f",
                                                "sense_id": "94a7c901-a781-38d0-8206-7ea6fa867175",
                                                "text": "Les recherches sur la constitution de l’atome appartiennent à la fois à la physique et à la chimie."
                                            },
                                            {
                                                "example_id": "909a5ff7-2b7a-4781-95fe-7b23aff57367",
                                                "sense_id": "94a7c901-a781-38d0-8206-7ea6fa867175",
                                                "text": "Physique expérimentale."
                                            },
                                            {
                                                "example_id": "a8eef83f-553d-4677-8e15-323a6d8d92c3",
                                                "sense_id": "94a7c901-a781-38d0-8206-7ea6fa867175",
                                                "text": "Suivre un cours de physique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58c5edf1-64ff-3098-bff8-a24b2981cb1b",
                                        "entry_id": "1bef3f22-543d-33f8-9c09-dd2edfb93094",
                                        "glosses": [
                                            "Ouvrages qui traitent de cette science."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6bb01b7b-63f8-4f59-a05f-64f5fc54a617",
                                                "sense_id": "58c5edf1-64ff-3098-bff8-a24b2981cb1b",
                                                "text": "La physique de Nollet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93568e92-184f-3e5c-8627-2bd146df7fbb",
                                        "entry_id": "1bef3f22-543d-33f8-9c09-dd2edfb93094",
                                        "glosses": [
                                            "Étude de la nature."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "041c8c4c-ddb1-4c4d-87a3-3f4cbd426cfb",
                                                "sense_id": "93568e92-184f-3e5c-8627-2bd146df7fbb",
                                                "text": "Sainte Hildegarde donne peut-être le motif de cette insistance, lorsque parlant, dans le quatrième livre de sa Physique, des gemmes, elle dit que le Diable les hait, les abhorre et les dédaigne, […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "physique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96196fbb-2720-3d5e-aa16-eb5fb54e2bf1",
                                        "entry_id": "f1f01a78-fcc0-3920-8957-52f2c4748e3a",
                                        "glosses": [
                                            "Aspect extérieur d’une personne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eaef0e-228e-40ba-b76d-d492d9175a3e",
                                                "sense_id": "96196fbb-2720-3d5e-aa16-eb5fb54e2bf1",
                                                "text": "Ces garçons présentaient des physiques avenants."
                                            },
                                            {
                                                "example_id": "4bf1aa05-5c3a-4022-b496-43a2b02875bd",
                                                "sense_id": "96196fbb-2720-3d5e-aa16-eb5fb54e2bf1",
                                                "text": "Le physique influe beaucoup sur le moral."
                                            },
                                            {
                                                "example_id": "6c94bb12-a726-4ffa-b883-c6bf22a56ca7",
                                                "sense_id": "96196fbb-2720-3d5e-aa16-eb5fb54e2bf1",
                                                "text": "Il a le physique de l’emploi se dit, au théâtre, d’un acteur qui a une figure, un extérieur convenable à son rôle. Il se dit aussi familièrement d’un Homme dont l’extérieur répond bien aux fonctions qu’il exerce."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
