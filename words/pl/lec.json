                {
                    "sense_id": "45881e67-795f-3c0e-b8ba-04e479f4ad87",
                    "sense_definition": "stracić życie w walce lub na polu bitwy",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smierc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wielu dzielnych żołnierzy <w>legło</w> na polu bitwy za wolność swojego kraju.",
                            "target_lang_translations": {
                                "ru": "Многие храбрые солдаты <w>пали</w> на поле битвы за свободу своей страны."
                            }
                        },
                        {
                            "text": "Jego pradziadek <w>legł</w> w walce podczas obrony rodzinnego miasta przed najeźdźcą.",
                            "target_lang_translations": {
                                "ru": "Его прадед <w>погиб</w> в бою при обороне родного города от захватчиков."
                            }
                        }
                    ],
                    "synonyms": [
                        "polec",
                        "polegnąć",
                        "paść"
                    ],
                    "common_phrases": [
                        "lec na polu bitwy",
                        "lec w boju",
                        "lec za ojczyznę"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "często w tonie podniosłym lub historycznym"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "погибнуть в бою или на поле битвы"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пасть",
