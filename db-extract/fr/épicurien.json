            {
                "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                "word": "épicurien",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "04651590-36cb-491c-b500-93fb129a2c2b",
                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "tags": [
                            "plural"
                        ],
                        "form": "épicuriens"
                    },
                    {
                        "form_id": "25dfb0c5-d4d7-4791-98a0-28a4dd6e60f5",
                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "tags": [
                            "feminine"
                        ],
                        "form": "épicurienne"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "glosses": [
                            "Celui qui est partisan de la doctrine d’Épicure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fe2161e-a6dc-48b8-b5f4-09a75685e2f9",
                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                "text": "Vivre comme un dieu exige que l'on cesse de croire aux dieux. Ainsi, la leçon des épicuriens est que la philosophie change les hommes en dieux en leur enseignant qu'il n'y a pas sur cette terre d'autres dieux qu'eux-mêmes dès lors qu'ils auront cessé de croire et vainement d'espérer."
                            },
                            {
                                "example_id": "64208465-de81-4f0d-b037-0b649dc057c5",
                                "sense_id": "4bf29514-9639-36fa-a709-ec6c75842d44",
                                "text": "On s’aperçoit que les épicuriens était d'une grande culture ; ils n'étaient absolument pas les rustres que les stoïciens aimaient à décrire, ces fameux « pourceaux d’Épicure » comme on a dit pour les discréditer."
                            }
                        ]
                    },
                    {
                        "sense_id": "a6cd4382-3872-3bf0-a5db-37827739bd25",
                        "entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "glosses": [
                            "Celui qui aime le plaisir, la jouissance."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2be6d59b-f096-43fb-90eb-66ccfa348dc2",
                        "source_entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "target_lang_word": "Epikureer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Epikureer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                        "entry_id": "85249ea9-1eee-3825-9835-d9bfb638035d",
                                        "glosses": [
                                            "ein Vertreter des Epikureismus"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8f88ec6-e684-4b1b-a974-c2cbf098bd4e",
                                                "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                                "text": "Aus Sicht der Epikureer ist die Lust das höchste Gut."
                                            },
                                            {
                                                "example_id": "ccc4a653-09c5-47da-bf9a-3995c7a3c630",
                                                "sense_id": "aa933c76-fbdf-399f-9437-55ad1c2cb5eb",
                                                "text": "„Im Gegensatz zu den Stoikern interessierten sich die Epikureer nur wenig für Politik und Gesellschaft.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c428f348-7723-3f46-bf0a-be74beaf2ee0",
                                        "entry_id": "85249ea9-1eee-3825-9835-d9bfb638035d",
                                        "glosses": [
                                            "jemand, der die Freuden des Daseins unbedenklich genießt; Genussmensch"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "849a49b3-0e45-40a5-9578-a2f3ff5831b5",
                                                "sense_id": "c428f348-7723-3f46-bf0a-be74beaf2ee0",
                                                "text": "„Er war Epikureer und Christ, in dieser Reihenfolge, ein Mann des Glaubens, der an die Gastronomie und an Gott, an seine Frau und seine Kinder glaubte, und an die Franzosen und Amerikaner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "64ff10d5-4b65-4003-be1f-995c5039df91",
                        "source_entry_id": "c1c0ce5a-07b4-3b11-a921-4fd896dd2c13",
                        "target_lang_word": "Genussmensch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Genussmensch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "048d8caa-c4fc-3b5a-a0af-98f8d559442d",
                                        "entry_id": "2582973e-f948-38c2-a4ad-4d3c57118d73",
                                        "glosses": [
                                            "Person, die besonders genussorientiert lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4f7c7e6-10c6-4320-bdb6-54fb9d053b0a",
                                                "sense_id": "048d8caa-c4fc-3b5a-a0af-98f8d559442d",
                                                "text": "„Beide hatten eine unübersehbar stramme Figur und waren Genussmenschen, sie knabberten pausenlos Nüsse oder Süßes.“"
                                            },
                                            {
                                                "example_id": "1ac040d4-ec9f-42a9-9633-ac8229f049d4",
                                                "sense_id": "048d8caa-c4fc-3b5a-a0af-98f8d559442d",
                                                "text": "„Als Genussmenschen schätzten alle Familienmitglieder ihre zeitgemäßen Kochkünste und leckeren Gerichte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "670b4f9e-9621-410f-b392-cf4d0844fb13",
