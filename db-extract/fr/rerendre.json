                ],
                "senses": [
                    {
                        "sense_id": "4d8e7337-0e4b-38ce-b8df-9fc2f17f939c",
                        "entry_id": "e018389e-c8d6-350a-8572-92881950ba7e",
                        "glosses": [
                            "Ramener un objet ou une personne à un état antérieur."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "c13c99a7-7535-4904-8737-7904167a0813",
                                "sense_id": "4d8e7337-0e4b-38ce-b8df-9fc2f17f939c",
                                "text": "Il est difficile de rerendre amoureuse une personne qui ne l’est plus."
                            },
                            {
                                "example_id": "e9ac5af6-f144-4ba4-b4e2-693a2d0dcaef",
                                "sense_id": "4d8e7337-0e4b-38ce-b8df-9fc2f17f939c",
                                "text": "Comment dois-je faire pour rerendre à mes plantes la vitalité qu’elles avaient avant l’hiver ?"
                            }
                        ]
                    },
                    {
                        "sense_id": "9f1385ae-d058-32be-8ca2-e7a37bf224df",
                        "entry_id": "e018389e-c8d6-350a-8572-92881950ba7e",
                        "glosses": [
                            "Retourner dans un lieu où on a déjà été."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b46145b8-36b4-4955-91fe-5eb996becc53",
                                "sense_id": "9f1385ae-d058-32be-8ca2-e7a37bf224df",
                                "text": "Je me suis rerendu sur la plage, pensant t’y trouver."
                            }
                        ]
                    },
                    {
                        "sense_id": "536acf8e-ebd1-39d2-ae12-e76373513e90",
                        "entry_id": "e018389e-c8d6-350a-8572-92881950ba7e",
                        "glosses": [
                            "Ne se retrouve guère que dans des expressions comme se rerendre compte de quelque chose, se rerendre disponible…"
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "3e5882ac-cee9-4a51-ae9a-d181fb4bb15c",
                                "sense_id": "536acf8e-ebd1-39d2-ae12-e76373513e90",
                                "text": "Penses-tu qu’il puisse se rerendre compte de ses erreurs ?"
                            },
                            {
                                "example_id": "b8938847-0adb-4c87-aa9f-0e83285e6c18",
                                "sense_id": "536acf8e-ebd1-39d2-ae12-e76373513e90",
                                "text": "Ce serait bien que tu te rerendes disponible aux prochaines vacances."
                            }
                        ]
                    }
                ],
