                        "glosses": [
                            "A writer of antinovels."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37aff4bc-a696-4f4c-8b3c-f1a37db7a8c0",
                                "sense_id": "27574a7a-e486-37a8-bd40-a4b75a46915d",
                                "text": "The difference between a modern novelist like Roth and an eighteenth-century moralist and antinovelist like Rousseau […]"
                            },
                            {
                                "example_id": "745089d8-3d61-4a6d-9c35-50771794b4cd",
                                "sense_id": "27574a7a-e486-37a8-bd40-a4b75a46915d",
                                "text": "But for Augustine, as for the harsher Puritans who followed him, there is no real point in saying what some humanist antinovelists very much wished to say […]"
                            },
                            {
                                "example_id": "8747dab3-7ec9-4c25-a985-787f73df5429",
                                "sense_id": "27574a7a-e486-37a8-bd40-a4b75a46915d",
                                "text": "At no point in her writing does Mary Lee Settle become an antinovelist or a player of literary games."
                            }
                        ]
                    }
                ],
