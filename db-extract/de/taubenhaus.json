                        "entry_id": "96a2e413-49f9-3abd-87fa-ca365c0629f6",
                        "glosses": [
                            "голубятня"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46842eac-197d-489d-8210-a992a1876383",
                                "sense_id": "08140b49-b2ac-35cf-903a-1504215818e7",
                                "text": "Nun wartete der Königssohn, bis der Vater kam, und sagte ihm, dass das fremde Mädchen in das Taubenhaus gesprungen war.",
                                "translation": "И дождался королевич до тех пор, пока не пришел отец, и сказал ему королевич, что какая-то неизвестная девушка взобралась на голубятню."
                            }
                        ]
                    }
