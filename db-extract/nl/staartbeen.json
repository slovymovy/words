                "translations": [
                    {
                        "translation_id": "4cd1bbeb-a400-4451-95eb-d43b2a35fff4",
                        "source_entry_id": "fc39e09e-887c-369c-92ff-7a29c25e1264",
                        "source_sense_id": "8375690f-c8e2-3cde-86f9-cefcde1ddf1f",
                        "target_lang_word": "Steißbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steißbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "04f157ac-c3ce-3e94-bdb0-7fad4b86619c",
                                        "entry_id": "f1fafbd2-df6a-3730-a7c9-74d3922396f2",
                                        "glosses": [
                                            "die untere Spitze der Wirbelsäule, anschließend an das Kreuzbein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e6a2a80-bc0a-4079-a355-3c42893ff3ae",
                                                "sense_id": "04f157ac-c3ce-3e94-bdb0-7fad4b86619c",
                                                "text": "Beim Menschen sind die Steißwirbel zum Steißbein verschmolzen."
                                            },
                                            {
                                                "example_id": "f09ef77f-a445-42bf-8df4-4fc8fcba3a0d",
                                                "sense_id": "04f157ac-c3ce-3e94-bdb0-7fad4b86619c",
                                                "text": "„Da könnten die Mädchen zur Schule gehen, setzte sie hinzu, bekam einen trockenen Mund, und es kribbelte leicht am Steißbein, wie es das manchmal tat, wenn sie sehr aufgeregt oder wegen etwas beklommen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a0a7f40a-5630-4f0b-9219-0d7286242723",
                        "source_entry_id": "fc39e09e-887c-369c-92ff-7a29c25e1264",
                        "source_sense_id": "8375690f-c8e2-3cde-86f9-cefcde1ddf1f",
                        "target_lang_word": "coccyx",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coccyx",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5ca2608-44f0-369b-87a2-68df17855bdf",
                                        "entry_id": "fee6d912-e0a2-3f1a-a019-e3038e98bdbb",
                                        "glosses": [
                                            "The final (bottom-most) fused vertebrae at the base of the spine, the tailbone."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eccf4967-9c8c-4b83-a69e-5dd3ba140fe1",
                                                "sense_id": "b5ca2608-44f0-369b-87a2-68df17855bdf",
                                                "text": "He lands on the concrete path and bounces on his coccyx, which cracks the base of his spine."
                                            },
                                            {
                                                "example_id": "c96ca18b-39e2-43e9-986a-c4812ef4d5c0",
                                                "sense_id": "b5ca2608-44f0-369b-87a2-68df17855bdf",
                                                "text": "An actor herself, McAlpine was hands-on, demonstrating “how you penetrate” on screen: “If you can move your coccyx, just arch your back slightly, it looks fantastic,” she says happily. “Those orgy scenes were amazing.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5f2656b4-ff51-4f0e-b0e1-15883f7338c1",
                        "source_entry_id": "fc39e09e-887c-369c-92ff-7a29c25e1264",
                        "source_sense_id": "8375690f-c8e2-3cde-86f9-cefcde1ddf1f",
                        "target_lang_word": "coccyx",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "coccyx",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "68efb4a5-3306-372d-94c2-c95036f7cd19",
                                        "entry_id": "26fac61d-cd71-37b4-b664-ce247f2a8025",
                                        "glosses": [
                                            "Petit os des hominoïdes qui est comme un appendice de l’os sacrum, à l’extrémité duquel il est attaché, formé de quatre à six vertèbres coccygiennes soudées chez l’humain, vestige de la queue (appendice caudal) atrophiée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d5be4fc-1362-4c30-9277-1cec5405760e",
                                                "sense_id": "68efb4a5-3306-372d-94c2-c95036f7cd19",
                                                "text": "La queue des animaux n’est qu’un coccyx prolongé."
                                            },
                                            {
                                                "example_id": "3679f992-5f51-47b7-aae3-6207ee361f3c",
                                                "sense_id": "68efb4a5-3306-372d-94c2-c95036f7cd19",
                                                "text": "Au total, le coccyx possède quinze points d’ossification. cinq primitifs et dix complémentaires."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
