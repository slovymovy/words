                        "tags": [],
                        "examples": [
                            {
                                "example_id": "621ae2cc-15c2-4ddb-98a8-d0a141d72b77",
                                "sense_id": "eedd865c-e59a-341d-bd18-bbbbaf76b558",
                                "text": "„Er verfehlte einen gewagten Sprung vor einem Milchwagen und wurde von einem Radfahrer, der dahinter hervorschoß, angefahren.“"
