                    {
                        "translation_id": "02c1293a-d3a7-4dd8-8ff6-484f613baa24",
                        "source_entry_id": "653e20c8-5fff-3b05-a962-7f1442794165",
                        "source_sense_description": "movements to gain favour — see also advances",
                        "target_lang_word": "заи́грывание",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "заи́грывание",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "68f96ffe-b800-35ec-8868-7b4cf5ffaa10",
                                        "entry_id": "c2b403e5-2e0d-3226-bba6-b8195730f5f4",
                                        "glosses": [
                                            "разг. действие по значению гл. заигрыватьᴵ"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bbfbf91e-6dcb-3007-921e-c8df4098b3ec",
                                        "entry_id": "c2b403e5-2e0d-3226-bba6-b8195730f5f4",
                                        "glosses": [
                                            "разг. действие по значению гл. заигрыватьᴵᴵ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bffd518-53d7-4ea6-8252-90710cee79a4",
                                                "sense_id": "bbfbf91e-6dcb-3007-921e-c8df4098b3ec",
                                                "text": "Так, с итальянкой продолжались заигрывания, но дальше взглядов и улыбочек дело не шло, да и не могло идти, потому что уже один билет в третьем ряду был непосильным расходом."
                                            },
                                            {
                                                "example_id": "113ec240-579c-4f08-af4a-a02bce1ea6a4",
                                                "sense_id": "bbfbf91e-6dcb-3007-921e-c8df4098b3ec",
                                                "text": "А на самом-то деле посулы и заигрывания хозяйской дочери до какого-то даже неистовства распалили его воображение."
                                            },
                                            {
                                                "example_id": "8d20d785-bb9d-4b52-b637-81ab99d7b28b",
                                                "sense_id": "bbfbf91e-6dcb-3007-921e-c8df4098b3ec",
                                                "text": "Валуев допустил политику заигрывания с поляками, и она-то и привела к мятежу 1863 года…"
                                            },
                                            {
                                                "example_id": "10f592be-13a2-4fbf-b60a-50a40744b38e",
                                                "sense_id": "bbfbf91e-6dcb-3007-921e-c8df4098b3ec",
                                                "text": "Его заигрывание с «добром» напоминает ухаживание гоголевского дьяка за Солохой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
