                                    },
                                    {
                                        "sense_id": "b5ce5479-d1ce-34b8-af0f-f595cb5d105a",
                                        "entry_id": "a967afd7-1a62-3093-b846-e1f38c7fa1ae",
                                        "glosses": [
                                            "widerspruchsfrei, folgerichtig"
                                        ],
                                        "tags": [
                                            "von Theorien",
                                            "Argumenten"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d38576bb-eb53-420b-b92b-8bea13de89b4",
                                                "sense_id": "b5ce5479-d1ce-34b8-af0f-f595cb5d105a",
                                                "text": "Es kann nicht bewiesen werden, ob die Mengenlehre konsistent ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff98de78-5a58-4cb9-84ad-7747b768e3d3",
                        "source_entry_id": "20ffc0e1-5942-382b-9163-10509a2f57fd",
                        "target_lang_word": "handfest",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "handfest",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b423a03-b8e9-342c-98ec-da6f8571cfc8",
                                        "entry_id": "752c53d3-fca2-3601-89dc-b9fc2f20179d",
                                        "glosses": [
                                            "über Körperkraft verfügend, robust"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "468f269a-da16-41d4-81fc-0675c1fd19af",
                                                "sense_id": "4b423a03-b8e9-342c-98ec-da6f8571cfc8",
                                                "text": "Für einen handfesten Mann wie ihn sollten die schweren Säcke kein Problem sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c5eec7cf-7a9d-3c2b-a5fe-c2cca25bd939",
                                        "entry_id": "752c53d3-fca2-3601-89dc-b9fc2f20179d",
                                        "glosses": [
                                            "unwiderlegbar, nicht anfechtbar"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b477e3b-0da8-4078-9fdd-165797786925",
                                                "sense_id": "c5eec7cf-7a9d-3c2b-a5fe-c2cca25bd939",
                                                "text": "Mit seinem handfesten Beweis konnte er den Prozess nur gewinnen."
                                            },
                                            {
                                                "example_id": "063425e0-5553-44c7-9e85-a6503594fd5c",
                                                "sense_id": "c5eec7cf-7a9d-3c2b-a5fe-c2cca25bd939",
                                                "text": "„Da soll etwas geschieden werden, das eigentlich noch gar nicht angefangen hat, es ist ein Mittelding zwischen einer handfesten Ehescheidung und einer zurückgegangenen Verlobung.“"
                                            },
                                            {
                                                "example_id": "f4d4747d-c94c-45dc-996f-09811b166769",
                                                "sense_id": "c5eec7cf-7a9d-3c2b-a5fe-c2cca25bd939",
                                                "text": "„Doch seine Schwärmerei für die Gastronomie hat eigentlich einen recht handfesten Hintergrund.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "28362381-078c-313e-bf0b-61a1f978f61d",
                                        "entry_id": "752c53d3-fca2-3601-89dc-b9fc2f20179d",
                                        "glosses": [
                                            "deftig, herzhaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0b34b2-9a46-49fe-990f-aae257807886",
                                                "sense_id": "28362381-078c-313e-bf0b-61a1f978f61d",
                                                "text": "Nach der Feldarbeit freute er sich auf das handfeste Essen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "171a77a3-e26f-3488-9777-dd30fbdf70d7",
                                        "entry_id": "752c53d3-fca2-3601-89dc-b9fc2f20179d",
                                        "glosses": [
                                            "ohne weitere Hebel oder Verlängerungen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28f66b6b-1eac-4408-94ca-69a7f1058ced",
                                                "sense_id": "171a77a3-e26f-3488-9777-dd30fbdf70d7",
                                                "text": "Die Kontermutter ist handfest anzuziehen."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f4a06c22-034a-4332-86bf-3966240b4582",
                        "source_entry_id": "20ffc0e1-5942-382b-9163-10509a2f57fd",
                        "target_lang_word": "deftig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "deftig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4eff9e-44c4-3690-8884-d8b4bdf173a6",
                                        "entry_id": "62cb5bd0-cb28-393c-bc1a-12ae263fb3fb",
                                        "glosses": [
                                            "nahrhafte, gehaltvolle und gut gewürzte Speisen"
                                        ],
                                        "tags": [
                                            "Nahrung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "529995e0-1e82-4889-9e7b-d281bf0dc465",
                                                "sense_id": "0d4eff9e-44c4-3690-8884-d8b4bdf173a6",
                                                "text": "Für die Alemannen darf bei einem richtigen Essen vor allem eins nicht fehlen: Fleisch. Denn dort, wo Alemannisch geschwätzt wird, mag man's richtig herzhaft und deftig."
                                            },
                                            {
                                                "example_id": "483f91c4-647d-4e8d-b90c-d1c25dde50fe",
                                                "sense_id": "0d4eff9e-44c4-3690-8884-d8b4bdf173a6",
                                                "text": "Typisch [in Ostwestfalen] ist eine deftige, einfache Küche und Bier."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7631820f-97c5-331f-b49c-cd85c8744a1e",
                                        "entry_id": "62cb5bd0-cb28-393c-bc1a-12ae263fb3fb",
                                        "glosses": [
                                            "grob und direkt"
                                        ],
                                        "tags": [
                                            "Sprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c1082eb-e650-4f0e-bbfa-a4c9233677ce",
                                                "sense_id": "7631820f-97c5-331f-b49c-cd85c8744a1e",
                                                "text": "„Wir erzählen hier am Arbeitsplatz keine deftigen frauenfeindlichen Witze, bitte unterlassen sie das!“"
                                            },
                                            {
                                                "example_id": "7f71b556-da30-4a8b-a3c6-9863b1f4507b",
                                                "sense_id": "7631820f-97c5-331f-b49c-cd85c8744a1e",
                                                "text": "So oft werden die F-Wörter benutzt, so viel wird deftig geflucht und gefurzt, dass man als Erziehungsberechtigter gehörig rot werden muss."
                                            },
                                            {
                                                "example_id": "4cc2f965-414f-44f0-a283-baed04b97d5d",
                                                "sense_id": "7631820f-97c5-331f-b49c-cd85c8744a1e",
                                                "text": "In türkischen Wahlkämpfen gehen die Politiker stets relativ deftig zu Werke, wenn es um die Beschimpfung ihrer Gegner geht."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b504017f-6530-32a0-8268-d5dd5cee1905",
                                        "entry_id": "62cb5bd0-cb28-393c-bc1a-12ae263fb3fb",
                                        "glosses": [
                                            "unangemessen hoch"
                                        ],
                                        "tags": [
                                            "Wert",
                                            "Niederlage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545aaf8c-5b0b-4e40-9378-ce9a4f082a05",
                                                "sense_id": "b504017f-6530-32a0-8268-d5dd5cee1905",
                                                "text": "„Die Preise in Schweizer Hotels sind dermaßen deftig, Winterurlaub kann sich hier doch keiner mehr leisten.“"
                                            },
                                            {
                                                "example_id": "201927b9-a65b-4237-ab64-e3a5ac2d1284",
                                                "sense_id": "b504017f-6530-32a0-8268-d5dd5cee1905",
                                                "text": "\"Bemerkenswerte Rückschritte\", \"besorgniserregende Entwicklungen\", \"unzureichende Bemühungen\", \"Stillstand\" - der jüngste Fortschrittsbericht 2015 der EU-Kommission über die Türkei fällt überraschend deftig aus."
                                            },
                                            {
                                                "example_id": "24d61539-56be-4c64-a866-af4de2359b39",
                                                "sense_id": "b504017f-6530-32a0-8268-d5dd5cee1905",
                                                "text": "Das erste Heimspiel der Saison von Bundesligarückkehrer Fortuna Düsseldorf gegen Borussia Mönchengladbach findet ohne Zuschauer statt. Zudem muss der Verein eine deftige Geldstrafe zahlen."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
