                "senses": [
                    {
                        "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                        "glosses": [
                            "In a pleasant manner; so as to achieve a pleasant result."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "046fc853-fe0c-4053-a0c9-a1bc30964366",
                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                "text": "He smiled pleasantly at passersby."
                            },
                            {
                                "example_id": "490f1d8d-bd48-46ec-8701-881bbdf95b55",
                                "sense_id": "52ce259f-d7a6-3efc-94c2-fe1053b4b91d",
                                "text": "They were pleasantly surprised at the result."
                            }
                        ]
                    },
                    {
                        "sense_id": "f90d169c-2574-3dc9-90b0-9c86da04dff9",
                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                        "glosses": [
                            "Lightly"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                        "entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                        "glosses": [
                            "Ludicrously; facetiously."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "37e76f5c-1a0f-407d-b67a-7c5a8538377b",
                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                "text": "In workhouses, pleasantly so named, because work cannot be done in them."
                            },
                            {
                                "example_id": "389bf3c6-5c3e-417a-86c0-97c7326d6681",
                                "sense_id": "10b01372-9dca-3f7c-be15-e731c1c5172f",
                                "text": "Mr Venus, reminded of the duties of hospitality, produced some rum. In answer to the inquiry, 'Will you mix it, Mr Wegg?' that gentleman pleasantly rejoined, 'I think not, sir. On so auspicious an occasion, I prefer to take it in the form of a Gum-Tickler.'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36d8e7ff-e9e7-4422-b691-8f2843572b3c",
                        "source_entry_id": "7318edcd-9e1b-3c5b-b281-80c8b1f9d583",
                        "source_sense_description": "in a pleasant manner",
                        "target_lang_word": "agréablement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "agréablement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                        "entry_id": "53217bdc-f7bc-3ead-960c-3df06e63d635",
                                        "glosses": [
                                            "D’une manière agréable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c04d9ac-7948-4b43-b25d-99fdab06e945",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Très surpris, non, madame, répondit le lieutenant Hobson, mais je le serais agréablement, je l'avoue."
                                            },
                                            {
                                                "example_id": "e20258f7-c59f-4ea4-ae91-1f64f1808630",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Cet éclat et ces honneurs dont le monde est si jaloux et dont il cherche à repaître si agréablement son orgueil…"
                                            },
                                            {
                                                "example_id": "b9136c26-8507-49c2-b35f-31c63954000e",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "[Le maître d’une maison délicieuse] Il n'est plus, il n'en a pas joui si agréablement ni si tranquillement que vous ; il n'y a jamais eu un jour serein…"
                                            },
                                            {
                                                "example_id": "b89c218f-bca3-4a74-a1a5-b4c6e3102a7d",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "Cet art de donner agréablement qu’elle avait si bien pratiqué durant sa vie, l’a suivie, je le sais, jusqu’entre les bras de la mort"
                                            },
                                            {
                                                "example_id": "7bc11e55-7344-4c48-9082-3504600b1032",
                                                "sense_id": "05042a74-2aa1-3c82-adbe-7b2439483c2b",
                                                "text": "On hait la médisance, la galanterie grossière : pourvu qu’on la tourne agréablement, on n'en a plus horreur"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
