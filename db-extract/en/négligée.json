                    {
                        "sense_id": "3ffe2640-2875-32b9-aea9-45f3a31d0fbb",
                        "entry_id": "937a907e-74d3-31bd-a927-1001edf784d1",
                        "glosses": [
                            "A woman's lightweight gown of the eighteenth century."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0934bbd5-8737-49fe-98ad-cf5be842ffa9",
                                "sense_id": "3ffe2640-2875-32b9-aea9-45f3a31d0fbb",
                                "text": "[S]he had on a lilac Negligee, Gause Cuffs trimmed richly, with Flowers and spangles, spangled shoes, Bows of Gause and Flowers, and a Cap!"
                            }
                        ]
                    },
                    {
                        "sense_id": "a0bc0726-1897-3bef-ba02-7122f5752cbe",
                        "entry_id": "937a907e-74d3-31bd-a927-1001edf784d1",
                        "glosses": [
                            "A necklace of beads, pearls etc."
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b4adb69a-8a94-3849-a616-3010bc979018",
                        "entry_id": "937a907e-74d3-31bd-a927-1001edf784d1",
                        "glosses": [
                            "A state of careless undress or very informal attire."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "0ce8bf48-1611-4489-b86c-5ccb11aaa21f",
                                "sense_id": "b4adb69a-8a94-3849-a616-3010bc979018",
                                "text": "“Good! My lady will be sitting in her boudoir, very much in negligee, about now.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "5f561d35-13d8-3e87-827a-e96526206624",
                        "entry_id": "937a907e-74d3-31bd-a927-1001edf784d1",
                        "glosses": [
                            "A woman's loose-fitting nightgown, especially when short, lacy and/or revealing; a nightie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "60d5af89-75fc-4bbf-ad7c-ea96382cd57f",
                                "sense_id": "5f561d35-13d8-3e87-827a-e96526206624",
                                "text": "Enkhbayar has promised more jobs, free education and higher public service wages to the poverty-ravaged country. But who needs those when you've got dancing girls in black negligees?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
