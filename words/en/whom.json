{
    "word_family": [
        "who",
        "whoever",
        "whomever",
        "whose"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "08464c6b-2a69-39e9-abb3-c1bd4f507185",
                    "sense_definition": "A relative pronoun used to refer to a person or people previously mentioned, acting as the object of a verb or preposition.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "relative-pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The woman <w>whom</w> I met yesterday is a famous scientist.",
                            "target_lang_translations": {
                                "ru": "Женщина, <w>которую</w> я встретил вчера, — известный ученый."
                            }
                        },
                        {
                            "text": "He is a colleague with <w>whom</w> I work closely on this project.",
                            "target_lang_translations": {
                                "ru": "Он коллега, с <w>которым</w> я тесно работаю над этим проектом."
                            }
                        }
                    ],
                    "synonyms": [
                        "who",
                        "that"
                    ],
                    "common_phrases": [
                        "with whom I work",
                        "to whom I spoke"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относительное местоимение, используемое для обозначения ранее упомянутого человека или людей, выступающее в роли дополнения к глаголу или предлогу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "которого",
                                "target_lang_sense_clarification": "винительный падеж, мужской род"
                            },
                            {
                                "target_lang_word": "которую",
                                "target_lang_sense_clarification": "винительный падеж, женский род"
                            },
                            {
                                "target_lang_word": "которым",
                                "target_lang_sense_clarification": "творительный падеж"
                            },
                            {
                                "target_lang_word": "которому",
                                "target_lang_sense_clarification": "дательный падеж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7bd58fc0-7446-3701-8161-942d7955837b",
                    "sense_definition": "An interrogative pronoun used to ask which person or people is the object of a preposition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "interrogative-pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>whom</w> are you referring in your latest report?",
                            "target_lang_translations": {
                                "ru": "На <w>кого</w> вы ссылаетесь в своем последнем отчете?"
                            }
                        },
                        {
                            "text": "With <w>whom</w> were you talking when I entered the room?",
                            "target_lang_translations": {
                                "ru": "С <w>кем</w> вы разговаривали, когда я вошел в комнату?"
                            }
                        }
                    ],
                    "synonyms": [
                        "who"
                    ],
                    "common_phrases": [
                        "to whom",
                        "with whom",
                        "for whom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное местоимение, используемое для выяснения того, какой человек или люди являются объектом предлога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кем",
                                "target_lang_sense_clarification": "творительный падеж (с кем)"
                            },
                            {
                                "target_lang_word": "кому",
                                "target_lang_sense_clarification": "дательный падеж (кому)"
                            },
                            {
                                "target_lang_word": "ком",
                                "target_lang_sense_clarification": "предложный падеж (о ком)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "36caa3f3-3012-3c0c-a0c4-cc9bed1731c6",
                    "sense_definition": "An interrogative pronoun used to ask which person or people is the object of a verb.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "interrogative-pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Whom</w> did you ask for directions to the museum?",
                            "target_lang_translations": {
                                "ru": "<w>Кого</w> вы спросили о дороге к музею?"
                            }
                        },
                        {
                            "text": "<w>Whom</w> shall we invite to the wedding ceremony?",
                            "target_lang_translations": {
                                "ru": "<w>Кого</w> нам пригласить на свадебную церемонию?"
                            }
                        }
                    ],
                    "synonyms": [
                        "who"
                    ],
                    "common_phrases": [
                        "whom did you",
                        "whom shall we"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вопросительное местоимение, используемое для выяснения того, какой человек или люди являются объектом глагола."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кого",
                                "target_lang_sense_clarification": "винительный падеж"
                            },
                            {
                                "target_lang_word": "кому",
                                "target_lang_sense_clarification": "дательный падеж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1ab5be51-9563-3a6a-9226-a107a74f9368",
                    "sense_definition": "The person or people that; used as a free relative pronoun meaning <w>whomever</w>.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relative-pronoun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "To <w>whom</w> it may concern, the office will be closed tomorrow.",
                            "target_lang_translations": {
                                "ru": "Всем, <w>кого</w> это касается: завтра офис будет закрыт."
                            }
                        },
                        {
                            "text": "You may give the prize to <w>whom</w> you choose.",
                            "target_lang_translations": {
                                "ru": "Вы можете отдать приз <w>тому, кого</w> выберете."
                            }
                        }
                    ],
                    "synonyms": [
                        "whomever"
                    ],
                    "common_phrases": [
                        "to whom it may concern"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in formal correspondence"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тот человек или те люди, которые; используется как свободное относительное местоимение в значении «кто бы ни»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кому",
                                "target_lang_sense_clarification": "в официальных обращениях"
                            },
                            {
                                "target_lang_word": "кого",
                                "target_lang_sense_clarification": "в значении «того, кого»"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5bf0c8b3-4fb3-3a2f-964c-95b2c11c8b16",
                    "sense_definition": "A capitalized form used as an honorific when referring to a deity or God.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "honorific",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We offer our prayers to Him, <w>Whom</w> we worship with all our hearts.",
                            "target_lang_translations": {
                                "ru": "Мы возносим наши молитвы Ему, <w>Кого</w> мы почитаем всем сердцем."
                            }
                        },
                        {
                            "text": "The believers sought guidance from the Almighty, in <w>Whom</w> they trusted.",
                            "target_lang_translations": {
                                "ru": "Верующие искали руководства у Всевышнего, на <w>Которого</w> они уповали."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Форма с заглавной буквы, используемая как почтительное обращение при упоминании божества или Бога."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Которого",
                                "target_lang_sense_clarification": "по отношению к Богу"
                            },
                            {
                                "target_lang_word": "Кому",
                                "target_lang_sense_clarification": "по отношению к Богу"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}