                        "glosses": [
                            "To tear, rip or wound."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "c8b85160-85ba-427d-9ae6-53aa632ae9f0",
                                "sense_id": "118ea4a4-17a1-361d-a02e-0332a10d9a0d",
                                "text": "Machinery, surgical precision / Lacerate the limbs of the poorest of the children / Watch them scatter through the fields of departed"
