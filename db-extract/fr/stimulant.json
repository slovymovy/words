            {
                "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                "word": "stimulant",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "5e1a4bff-84d7-46f2-a893-e5a72079fb2a",
                        "entry_id": "5064b394-d103-3afd-bdfe-860cc583d486",
                        "tags": [
