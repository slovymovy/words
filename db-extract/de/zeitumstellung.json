                "senses": [
                    {
                        "sense_id": "dad44667-8521-3000-b7f1-e1990c31efb2",
                        "entry_id": "9f772450-a6c2-3751-b39e-c9c576b9a1d2",
                        "glosses": [
                            "die Umstellung von Normal- auf Sommerzeit am letzten Sonntag im März; ebenso die umgekehrte Umstellung von Sommer- auf Normalzeit am letzten Sonntag im Oktober"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1232b885-e90d-458c-a51d-8cdfef2a0ac5",
                                "sense_id": "dad44667-8521-3000-b7f1-e1990c31efb2",
                                "text": "„Eingeführt wurde die Zeitumstellung erstmals am 30. April 1916 im Deutschen Reich, in Österreich-Ungarn und noch im selben Jahr auch in Irland.“"
                            },
                            {
                                "example_id": "a8bf3b08-da74-4156-b3ff-af41675da76e",
                                "sense_id": "dad44667-8521-3000-b7f1-e1990c31efb2",
                                "text": "„Die Behörden zogen daraus Konsequenzen und verlegten die Zeitumstellung im kommenden Jahr auf die Nacht zum dritten Montag im April, und zwar auf zwei Uhr morgens.“"
                            },
                            {
                                "example_id": "5d8aa4d5-205c-47de-a865-d0231f6caf7d",
                                "sense_id": "dad44667-8521-3000-b7f1-e1990c31efb2",
                                "text": "Perfektionisten behaupten, bei der Zeitumstellung könne man nicht die Zeit umstellen, sondern nur die Uhren; doch wird die gesetzliche Uhrzeit umgestellt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
