                "senses": [
                    {
                        "sense_id": "068ca24d-854e-3f23-b601-76239bb0b7c8",
                        "entry_id": "638d113e-0d12-375b-9a40-05f29ff0f08c",
                        "glosses": [
                            "Bourdonnement, son sourd et confus."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8597332e-ef75-4b7b-b012-9d492787b534",
                                "sense_id": "068ca24d-854e-3f23-b601-76239bb0b7c8",
                                "text": "Entendez-vous ce zonzonnement aigre et félé – pipiens – encore presque indistinct, comme la voix grêle d’une cigale qu’on entendrait de très loin dans la forêt ?"
                            },
                            {
                                "example_id": "7cb32cc3-bf1f-4e4e-ae6c-bf852f049bd0",
                                "sense_id": "068ca24d-854e-3f23-b601-76239bb0b7c8",
                                "text": "Et pendant un long moment, on n’entendit plus que le zonzonnement des abeilles."
                            },
                            {
                                "example_id": "5d9843bf-0677-4136-a12b-1d318f97c4bd",
                                "sense_id": "068ca24d-854e-3f23-b601-76239bb0b7c8",
                                "text": "Tout de suite après, un brouhaha parmi la clientèle s’éleva tel un zonzonnement d’abeilles."
                            }
                        ]
                    }
                ],
