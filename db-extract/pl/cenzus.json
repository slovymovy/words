                    {
                        "translation_id": "99ff8feb-f36b-4a56-9e66-922312f6f3fa",
                        "source_entry_id": "f0ddc15d-00fe-3588-86d2-787c22d24c3c",
                        "source_sense_id": "951e064a-a0a8-37d9-9c48-fcbf8b994a5e",
                        "target_lang_word": "qualification",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "qualification",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "The act or process of qualifying for a position, achievement etc."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c303af27-40ee-424f-89b1-daa94579040d",
                                                "sense_id": "b007744b-19a2-3ef6-be5b-b846b41d5940",
                                                "text": "Qualification for this organization is extraordinarily difficult."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "An ability or attribute that aids someone's chances of qualifying for something; specifically, completed professional training."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b43f924b-4eca-4be8-85e3-3e64061f856d",
                                                "sense_id": "bdda4da4-91f4-3f4c-ac53-343b868c1b2a",
                                                "text": "What are your qualifications for this job?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfcbcd5c-72ce-3ee2-a1a1-235e67e56d5c",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A certificate, diploma, or degree awarded after successful completion of a course, training, or exam."
                                        ],
                                        "tags": [
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A clause or condition which qualifies something; a modification, a limitation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "034b37ee-d831-40d1-a455-0f4e2a797da3",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "I accept your offer, but with the following qualification."
                                            },
                                            {
                                                "example_id": "a94504b6-8682-4929-9fbd-9fb3f7f1b9bd",
                                                "sense_id": "4e2797a8-1b91-37cc-bb64-c4651de991fc",
                                                "text": "Before a vowel (as in rib, brake) r is usually pronounced as a fricative consonant by all groups of speakers. But the qualification 'usually' is necessary, for the Negroes tend to weaken r after a consonant; and they omit it, as do illiterate white speakers, in throat, throw, through."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                        "entry_id": "b4ee4e93-99e2-3ee6-8a70-5c5736c593a7",
                                        "glosses": [
                                            "A quality or attribute."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3e68ae6-611e-44bd-886f-5cabb834ca7e",
                                                "sense_id": "74d50006-2d59-3626-947c-3ec19a463c86",
                                                "text": "To shew, that these Qualfications, which we all pretend to be asham'd of, are the great support of a flourishing Society has been the subject of the foregoing Poem."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5202a9d9-22f9-4a9e-8c7d-d5e1044ccace",
                        "source_entry_id": "f0ddc15d-00fe-3588-86d2-787c22d24c3c",
                        "source_sense_id": "951e064a-a0a8-37d9-9c48-fcbf8b994a5e",
                        "target_lang_word": "Qualifikation",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Qualifikation",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6239ef81-4f79-36d7-a77f-88ac3e322241",
                                        "entry_id": "38b9cf00-0ce4-340d-a1f8-7f5d8aa81685",
                                        "glosses": [
                                            "Berechtigung oder Erwerb der Berechtigung zur Teilnahme an einem Wettbewerb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "29690d5b-1897-41fd-b6f6-79f58eace714",
                                                "sense_id": "6239ef81-4f79-36d7-a77f-88ac3e322241",
                                                "text": "Der Sportler konnte die Qualifikation trotz großer Anstrengung nicht bestehen."
                                            },
                                            {
                                                "example_id": "25048c55-1a74-4234-bba5-b8d74c07a6c4",
                                                "sense_id": "6239ef81-4f79-36d7-a77f-88ac3e322241",
                                                "text": "Erlander unterstrich in der Qualifikation seine gute Form."
                                            },
                                            {
                                                "example_id": "adeace61-c6a5-4a02-81f9-a0df6a2f2ba1",
                                                "sense_id": "6239ef81-4f79-36d7-a77f-88ac3e322241",
                                                "text": "„Die Prämie für den Sieg in der Qualifikation in Garmisch-Partenkirchen fiel für die Skispringerinnen dürftig aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c5b13d0-7fc1-3bea-8eb9-c5dce3dcc039",
                                        "entry_id": "38b9cf00-0ce4-340d-a1f8-7f5d8aa81685",
                                        "glosses": [
                                            "Erfüllung der Voraussetzungen für eine bestimmte Tätigkeit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06001a8d-d633-4951-98cd-92ce3b378ff5",
                                                "sense_id": "3c5b13d0-7fc1-3bea-8eb9-c5dce3dcc039",
                                                "text": "Für diese Stelle fehlt ihm jegliche Qualifikation."
                                            },
                                            {
                                                "example_id": "6df7188b-ca5c-4ee8-ae02-8c32e95f8b89",
                                                "sense_id": "3c5b13d0-7fc1-3bea-8eb9-c5dce3dcc039",
                                                "text": "Welche Qualifikationen bringen Sie mit?"
                                            },
                                            {
                                                "example_id": "be4ce316-d411-45be-b9c6-0b3b9fdf88a5",
                                                "sense_id": "3c5b13d0-7fc1-3bea-8eb9-c5dce3dcc039",
                                                "text": "„Spielfähigkeit, mehrperspektivisch verstanden und als Leitidee der Vermittlung von Sportspielen interpretiert, beinhaltet eine doppelte Zielsetzung: Während es zum einen um eine allgemeine und spezifische Perspektive der Qualifikation geht, zielen entsprechende Vermittlungsprozesse zum anderen auf persönlichkeitsbildende Aspekte ab.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "59659acd-b6c4-4a95-be9f-5f046e110958",
                        "source_entry_id": "f0ddc15d-00fe-3588-86d2-787c22d24c3c",
