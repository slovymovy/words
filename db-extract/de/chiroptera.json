                                        "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                        "entry_id": "78cd95d6-9fbb-3af8-8eac-408c9e0affe3",
                                        "glosses": [
                                            "fliegendes Säugetier (Ordnung Chiroptera)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f734e8d-7a88-4e83-9b17-7f5b53d9ef7a",
                                                "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                                "text": "Im Dachstuhl sind Fledermäuse."
                                            },
                                            {
                                                "example_id": "593d4312-62e3-4b24-86ba-8f495bfaed26",
                                                "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                                "text": "„Die Nacht war erfüllt vom Flattern der Fledermäuse, dem Zirpen der Insekten, den Rufen der Reiher und dem Rascheln der Flusspferde, die unter meiner Schlafplattform im Schilf weideten.“"
                                            },
                                            {
                                                "example_id": "b69639df-0be3-4292-b781-7d3e3de352bf",
                                                "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                                "text": "„Die einzige Gesellschaft, die sie hatte, waren die Fledermäuse, die kopfüber von der Decke hingen.“"
                                            },
                                            {
                                                "example_id": "56f7a3fe-90cf-420f-a4e6-eee49c7ff5cf",
                                                "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                                "text": "Guck mal Mama, Fledermäuse!"
                                            },
                                            {
                                                "example_id": "311f88dc-6526-4cb9-886c-9a7c7f39594d",
                                                "sense_id": "641fb58e-40a0-3c3f-862a-f3610e23f10f",
                                                "text": "„Sie hatten eine Pelerine über sich gezogen und wirkten so wie eine traurige Fledermaus mit zwei Köpfen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
