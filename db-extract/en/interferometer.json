                        "entry_id": "04c1d979-63a1-3acf-89be-f4389fa3147e",
                        "glosses": [
                            "Any of several instruments that use the interference of waves to determine wavelengths and wave velocities, determine refractive indices, measure small distances, temperature changes, stresses, and many other useful measurements."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd942983-d3cf-4445-95af-0eb097c32756",
                        "source_entry_id": "04c1d979-63a1-3acf-89be-f4389fa3147e",
                        "source_sense_id": "e0f49fc0-6474-3001-bd3b-9f3802fa788f",
                        "source_sense_description": "instrument",
                        "target_lang_word": "interféromètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "interféromètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "228472c5-31bc-3443-bb15-4f0c6c876f6f",
                                        "entry_id": "f2bfff19-14c9-3dae-969e-73c9b0f8c65c",
                                        "glosses": [
                                            "Instrument formant des franges d’interférence lumineuses."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80898a4f-09c7-4134-9060-bc371859f959",
                                                "sense_id": "228472c5-31bc-3443-bb15-4f0c6c876f6f",
                                                "text": "Interféromètre de Michelson, interféromètre dans lequel la lumière est divisée en plusieurs faisceaux suivant des trajets de longueur différente avant d’être recombinée pour former des franges."
                                            },
                                            {
                                                "example_id": "0189cfe4-0538-450a-99eb-b245094b92d0",
                                                "sense_id": "228472c5-31bc-3443-bb15-4f0c6c876f6f",
                                                "text": "Interféromètre d’Young, interféromètre dans lequel la lumière passe par deux ou plusieurs trous avant de former des franges."
                                            },
                                            {
                                                "example_id": "eae481c5-1796-44ba-a427-05b18530d2e8",
                                                "sense_id": "228472c5-31bc-3443-bb15-4f0c6c876f6f",
                                                "text": "Interféromètre de Fabry-Perot, système filtrant certaines longueurs d’onde en faisant passer la lumière dans une cavité à surfaces internes fortement réfléchissantes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "001bc58e-2379-331d-9d5f-50b59a1de450",
                                        "entry_id": "f2bfff19-14c9-3dae-969e-73c9b0f8c65c",
                                        "glosses": [
                                            "Instrument de mesure composé de plusieurs télescopes (ou radiotélescopes) qui permet d’obtenir des informations sur la géométrie de l’astre observé en formant des franges d’interférence à partir du flux obtenu par chaque télescope."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4078d6e8-cbcc-45ac-907f-a4c504f387a8",
                                                "sense_id": "001bc58e-2379-331d-9d5f-50b59a1de450",
                                                "text": "Interféromètre optique à longue base, instrument composé de plusieurs télescopes optiques."
                                            },
                                            {
                                                "example_id": "645ae768-f073-4780-aff3-3e48f922eb90",
                                                "sense_id": "001bc58e-2379-331d-9d5f-50b59a1de450",
                                                "text": "Interféromètre radio, instrument composé de plusieurs antennes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
