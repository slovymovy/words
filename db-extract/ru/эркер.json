                    },
                    {
                        "translation_id": "f27657ca-f18b-45c0-b808-bcd58bb79ab9",
                        "source_entry_id": "ad2f1548-4b4e-3ff7-8e02-ebdc1ef2d62d",
                        "source_sense_id": "e76673ef-5fba-336f-8dfc-656b2604856c",
