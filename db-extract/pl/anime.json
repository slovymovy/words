                "translations": [
                    {
                        "translation_id": "2dfc8366-d54e-4221-94b1-784007f1ed94",
                        "source_entry_id": "7ffa60ea-87d1-3e5d-aa01-041ea2f51d8f",
                        "source_sense_id": "0d196d54-7b16-3cb9-b1b0-e1354b23dc2a",
