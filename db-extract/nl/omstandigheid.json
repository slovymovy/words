                ],
                "senses": [
                    {
                        "sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                        "entry_id": "768c0c84-06b2-3599-b2c8-71384858d097",
                        "glosses": [
                            "hoe de zaken er voorliggen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f92de49f-df34-4eb2-a9ab-b1e3c3ac787d",
                                "sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                                "text": "Onder deze omstandigheid ga ik niet op vakantie."
                            },
                            {
                                "example_id": "c94670ef-ca68-4138-bb25-80c2f09bc157",
                                "sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                                "text": "We waren niet goed voorbereid op deze omstandigheden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2e2c0bc1-222c-4fa1-af7a-3f6638340c76",
                        "source_entry_id": "768c0c84-06b2-3599-b2c8-71384858d097",
                        "source_sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "Umstand",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Umstand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                        "entry_id": "ea522238-2e9f-3e1b-aee9-83c430b2a97d",
                                        "glosses": [
                                            "Situation und besondere Verhältnisse, die für ein Geschehen bemerkenswert sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4bc0ab35-47a2-4c64-8759-50b10ee7384b",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "Wenn es die Umstände erlauben, werden wir die Arbeit rechtzeitig beenden."
                                            },
                                            {
                                                "example_id": "d8391725-ea53-4821-aaab-f42a2d6e9cb8",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "Dieses Computerprogramm hat einen kritischen Fehler in der Behandlung der Texteingabe. Dieser Umstand kann ausgenutzt werden, um beliebigen Programmcode auszuführen."
                                            },
                                            {
                                                "example_id": "7cbb3ed6-2cff-40ce-b5d9-0ad0afb0b2c6",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "„Der Umstand, dass eine Opernkarte in Berlin mit 150 Euro subventioniert wird, ist ein Thema für den Finanzsenator“. (Quelle: Der Spiegel ONLINE)"
                                            },
                                            {
                                                "example_id": "68af81c6-5df1-4562-a98c-63449557cfa7",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "„So war es auch ein eher ungewöhnlicher Umstand, bei dem die Sängerin schließlich entdeckt wurde: Auf einer Sportveranstaltung der Harlemer Polizei“. (Quelle: Der Spiegel ONLINE)"
                                            },
                                            {
                                                "example_id": "7f6ddefc-a771-43d5-bcbd-487ef3adf535",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "„Unfälle sind keine Zufälle, wie so manche Zeitungsnotiz verharmlosend wahrhaben möchte. Unfälle entstehen stets im Zusammenlaufen mehrerer Kausallinien, im Schnittpunkt einer Reihe ungünstiger Umstände und Fehlverhaltensweisen.“"
                                            },
                                            {
                                                "example_id": "521b6a97-62e1-4302-8006-e13e57141b80",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "„Wegen des hohen Wertes des Diebesguts und der Umstände der Tat hätte eigentlich die Todesstrafe über sie verhängt werden müssen.“"
                                            },
                                            {
                                                "example_id": "2c308a0e-28b2-438a-b63c-1c6fad954aa5",
                                                "sense_id": "296e3637-0938-322f-b753-ca927f409209",
                                                "text": "„Trotz der schwierigen Umstände entstand ein Meisterwerk, das erst Jahre später wirklich verstanden wurde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "c6885cbf-c7c2-383a-9429-2127627ec9ee",
                                        "entry_id": "ea522238-2e9f-3e1b-aee9-83c430b2a97d",
                                        "glosses": [
                                            "ausführliche, zeitraubende Vorbereitungen"
                                        ],
                                        "tags": [
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "885401de-673e-4dbb-83b1-8a45ae1bfde4",
                                                "sense_id": "c6885cbf-c7c2-383a-9429-2127627ec9ee",
                                                "text": "Mach dir meinetwegen keine Umstände; ich benötige keine Förmlichkeiten."
                                            },
                                            {
                                                "example_id": "fcc03af2-5e9f-4e92-937f-0f7319528c9a",
                                                "sense_id": "c6885cbf-c7c2-383a-9429-2127627ec9ee",
                                                "text": "„Nachdem in mehreren Anläufen die zweifelsfrei höchste Stelle des Kibo ermittelt werden konnte, kommt es am 6. Oktober 1889 endlich und ohne weitere Umstände zur Erstbesteigung der höchsten Erhebung des Kilimandscharo-Massivs durch Meyer und Putscheller.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f8b149a6-751b-4096-a8d4-be7b20cf6089",
                        "source_entry_id": "768c0c84-06b2-3599-b2c8-71384858d097",
                        "source_sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "circumstance",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circumstance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                                        "entry_id": "fe12b72e-9559-3e02-94f6-e36df77d133b",
                                        "glosses": [
                                            "Something which is related to, or in some way affects, a fact or event."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7413ba22-bd6d-4bc6-9381-69eeaf4a14f9",
                                                "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                                                "text": "The report should focus on to the current circumstances of the organisation, to help us find a way to grow in the future."
                                            },
                                            {
                                                "example_id": "0a929baf-b5a2-4ae2-b784-020386962b1a",
                                                "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                                                "text": "She went missing in somewhat spooky circumstances."
                                            },
                                            {
                                                "example_id": "109f0165-fa67-4faa-a9e2-732791ff3571",
                                                "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                                                "text": "The circumstances are well known in the country where they happened."
                                            },
                                            {
                                                "example_id": "cbf4511f-9218-4ad1-8d8b-1d5030516124",
                                                "sense_id": "392fe0bf-d3d5-3e67-ae7a-91dd530eda80",
                                                "text": "The story of this adoption is, of course, the pivot round which all the circumstances of the mysterious tragedy revolved. Mrs. Yule had an only son, namely, William, to whom she was passionately attached; but, like many a fond mother, she had the desire of mapping out that son's future entirely according to her own ideas. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3c075e09-a119-3448-9180-0c37b47c37be",
                                        "entry_id": "fe12b72e-9559-3e02-94f6-e36df77d133b",
                                        "glosses": [
                                            "An event; a fact; a particular incident, occurrence, or condition (status)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f3200ee-a266-4e92-b0d3-e2be115c55d5",
                                                "sense_id": "3c075e09-a119-3448-9180-0c37b47c37be",
                                                "text": "I have ſeen Two or Three antique Buſts of Alexander in the ſame Air and Poſture, and am apt to think the Sculptor had in his Thoughts the Conqueror's weeping for new Worlds, or ſome other the like Circumſtance of his History."
                                            },
                                            {
                                                "example_id": "fc0d6406-509f-42cd-80e5-19467a3f3dcd",
                                                "sense_id": "3c075e09-a119-3448-9180-0c37b47c37be",
                                                "text": "Then another circumstance happened, which made a lasting impression on my memory, though I was but a small child."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc5e80ff-a23d-3d4d-b748-a2aca42a0f95",
                                        "entry_id": "fe12b72e-9559-3e02-94f6-e36df77d133b",
                                        "glosses": [
                                            "Evasive or indirect language; circumlocution."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0303a40-5fb9-4416-8e3e-781a3defefb9",
                                                "sense_id": "cc5e80ff-a23d-3d4d-b748-a2aca42a0f95",
                                                "text": "Right, you are in the right, and therefore / I holde it meet without more circumſtance at all, / Wee ſhake hands and part; […]"
                                            },
                                            {
                                                "example_id": "61df56f6-06e5-40b0-96f7-4e5a661fb71e",
                                                "sense_id": "cc5e80ff-a23d-3d4d-b748-a2aca42a0f95",
                                                "text": "But he (as louing his owne pride, and purpoſes) / Euades them, with a bumbaſt Circumſtance, / Horribly ſtufft with Epithites of warre,"
                                            },
                                            {
                                                "example_id": "52d4bbc4-ab9a-4a4d-9d5c-c46f0f03d852",
                                                "sense_id": "cc5e80ff-a23d-3d4d-b748-a2aca42a0f95",
                                                "text": "Old Ger. You put vs to a needeleſſe labour ſir, / To runne and winde about for circumſtance, / When the plaine word, I thanke you, would have ſeru'd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7cf034b-9194-3d6b-9ce1-ee90f9cc0afb",
                                        "entry_id": "fe12b72e-9559-3e02-94f6-e36df77d133b",
                                        "glosses": [
                                            "Condition in regard to worldly estate; state of property; situation; surroundings."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eec18f44-e657-4aec-b48b-f7566a4cd6de",
                                                "sense_id": "f7cf034b-9194-3d6b-9ce1-ee90f9cc0afb",
                                                "text": "She was born into comfortable circumstances."
                                            },
                                            {
                                                "example_id": "1f2e14ed-52f2-407e-87ac-bde564cda0ef",
                                                "sense_id": "f7cf034b-9194-3d6b-9ce1-ee90f9cc0afb",
                                                "text": "When men are eaſy in their circumſtances, they are naturally enemies to innovations: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "circumstance",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31b3a7b9-06c2-3110-900d-7b87edb0c1f9",
                                        "entry_id": "34390d23-22b7-3044-8bdc-481953c8983f",
                                        "glosses": [
                                            "To place in a particular situation, especially with regard to money or other resources."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd8440f9-ab12-4ce3-b38f-7c2839c11ec6",
                                                "sense_id": "31b3a7b9-06c2-3110-900d-7b87edb0c1f9",
                                                "text": "Frank muttered something. Tidings had in some shape reached his ears that his father was not comfortably circumstanced as regarded money."
                                            },
                                            {
                                                "example_id": "6d786e97-ca5f-4f25-9a07-c60877094fe6",
                                                "sense_id": "31b3a7b9-06c2-3110-900d-7b87edb0c1f9",
                                                "text": "While also taxing Ferrein with the same motives, Diderot's account of his doings is much more circumstanced than La Mettrie's, and also much more amusing, thanks to the interpolation of the «bijoux» motif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "44c69685-b172-4e49-97d9-77a6ba3ed3b7",
                        "source_entry_id": "768c0c84-06b2-3599-b2c8-71384858d097",
                        "source_sense_id": "6a756702-b892-3290-b327-89aa08b04e62",
                        "source_sense_description": "hoe de zaken er voorliggen",
                        "target_lang_word": "circonstance",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "circonstance",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                        "entry_id": "de0a4bfc-6684-3c66-b6a3-872947aa7780",
                                        "glosses": [
                                            "Particularité qui accompagne et distingue un fait, une situation, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f85545f-1263-4d85-a9e0-87097d31e9d7",
                                                "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                                "text": "Apprécier les circonstances dans chaque cas particulier, tel est donc le rôle essentiel du chef. Du fait qu’il les connaît, qu’il les mesure, qu’il les exploite, il est vainqueur ; du fait qu’il les ignore, qu’il les juge mal, qu’il les néglige, il est vaincu."
                                            },
                                            {
                                                "example_id": "4267ea87-ef36-4040-86e3-72ca78f25c56",
                                                "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                                "text": "Le flot et le jusant courant au large, sans interruption, pendant 2 ou 3 heures après la haute ou basse mer sur la côte, circonstance dont il faut soigneusement tenir compte en franchissant les bancs."
                                            },
                                            {
                                                "example_id": "8a930382-d8ed-4050-a877-272dc8ff2420",
                                                "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                                "text": "Jamais Président n’avait été inauguré dans des circonstances aussi dramatiques. Quatorze millions de sans-travail, et leur nombre augmentant chaque jour,..."
                                            },
                                            {
                                                "example_id": "ad4eb56c-601e-4ed0-9831-5bfb33ae2fda",
                                                "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                                "text": "C’est un garçon fort agréable que Bernard. Soigné, rasé de près, le teint clair, il s’exprime dans une langue choisie et ne fait usage de l’argot qu’en d’exceptionnelles circonstances."
                                            },
                                            {
                                                "example_id": "984781e3-3df2-4acc-b158-765cc38cc07d",
                                                "sense_id": "088d472b-daf7-35f9-a614-44a4b55f357e",
                                                "text": "Il est expliqué plus bas que le scandale n’est qu’un mot, qu’on fait naitre la chose selon les besoins et les circonstances et que le plus scandaleux n’est point que tel banquier couche, un beau jour à la Santé, mais que tant d’autres dorment paisibles dans leurs draps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6bef95a6-4515-35ba-ac06-4bfeef89dd7a",
                                        "entry_id": "de0a4bfc-6684-3c66-b6a3-872947aa7780",
                                        "glosses": [
                                            "Événement particulier ; occasion particulière."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f57714a9-65f5-42c8-b7cc-0fe21c9ebf08",
                                                "sense_id": "6bef95a6-4515-35ba-ac06-4bfeef89dd7a",
                                                "text": "[…], puis M. Goulden tira de l’armoire une bouteille de son vin de Metz, qu’il gardait pour les grandes circonstances, et nous soupâmes en quelque sorte comme deux camarades ; […]."
                                            },
                                            {
                                                "example_id": "8a68973e-1594-422e-8704-2024f7f0b5b0",
                                                "sense_id": "6bef95a6-4515-35ba-ac06-4bfeef89dd7a",
                                                "text": "Dans les circonstances difficiles il ne faut pas dédaigner de faire appel, comme autrefois les Germains, aux conseils des femmes ; car elles ont une manière de concevoir les choses toute différente de la nôtre."
                                            },
                                            {
                                                "example_id": "7bc3829a-4864-4689-96e5-578b8fc67c88",
                                                "sense_id": "6bef95a6-4515-35ba-ac06-4bfeef89dd7a",
                                                "text": "Une anecdote locale plutôt symbolique raconte que le coq du clocher de l'église de Saint-Vincent, dont la construction fut commencée en 1934, aurait disparu dans de bien mystérieuses circonstances, qu'on attribue à l’archevêque O’Leary."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0e163efe-b3b5-3c72-8b52-69cd35d90742",
                                        "entry_id": "de0a4bfc-6684-3c66-b6a3-872947aa7780",
                                        "glosses": [
                                            "Rapports de temps, de lieu, de manière, de cause, etc., qui entourent l’action ou l’état exprimé par un verbe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "63570012-1a82-4047-aa56-6897dbdd395c",
                                                "sense_id": "0e163efe-b3b5-3c72-8b52-69cd35d90742",
                                                "text": "Compléments de circonstance ou compléments circonstanciels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af40cf18-7807-35ad-b7e1-5c8f3eab1596",
                                        "entry_id": "de0a4bfc-6684-3c66-b6a3-872947aa7780",
                                        "glosses": [
                                            "Conjoncture présente ; situation actuelle des choses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b4c4305-7cff-4a52-a110-4aad76e7fe4c",
                                                "sense_id": "af40cf18-7807-35ad-b7e1-5c8f3eab1596",
                                                "text": "Tous ont successivement combattu pour ou contre les Jacobins, selon les temps & les circonstances."
                                            },
                                            {
                                                "example_id": "02cb06ed-f677-464a-b0cf-468535aa0f9b",
                                                "sense_id": "af40cf18-7807-35ad-b7e1-5c8f3eab1596",
                                                "text": "Entre les philosophes, dont l’habileté en affaires était devenue suspecte, et les praticiens, dont la routine venait d’être convaincue d’impuissance, M. Necker s’offrait comme un moyen terme: il était l’homme de la circonstance : il fut choisi."
                                            },
                                            {
                                                "example_id": "9e7889ad-af4f-4e6a-ad64-943652513034",
                                                "sense_id": "af40cf18-7807-35ad-b7e1-5c8f3eab1596",
                                                "text": "Il n'y a pas de corporation ecclésiastique qui ait plus asservi aux circonstances ses doctrines et sa conduite que le haut clergé anglican."
                                            },
                                            {
                                                "example_id": "f7fd3726-a01e-4b8a-bd74-685a2ed03354",
                                                "sense_id": "af40cf18-7807-35ad-b7e1-5c8f3eab1596",
                                                "text": "Je savais bien que ces protestations ne servaient à rien et que, dans ces circonstances, en appeler au respect de la légalité devant ces brutes était ridicule […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
