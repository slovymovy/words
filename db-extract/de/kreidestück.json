                "senses": [
                    {
                        "sense_id": "c577206d-a79e-3c7b-9e98-e22b87cfd405",
                        "entry_id": "81bbca80-1044-329f-8b98-84ae5f399fed",
                        "glosses": [
                            "Stück Kreide (vorrangig Mal- oder Schreibkreide)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1cac931-2a95-4c66-b06f-4ed7162918d5",
                                "sense_id": "c577206d-a79e-3c7b-9e98-e22b87cfd405",
                                "text": "Unser Lehrer zeichnete mit dem letzten verbliebenen Kreidestück zwei unförmige Quader an die Tafel."
                            },
                            {
                                "example_id": "26d11a1e-fff1-4bbf-b977-055686b6e213",
                                "sense_id": "c577206d-a79e-3c7b-9e98-e22b87cfd405",
                                "text": "„Das Kreidestück in meiner Hand ist nass vom Schweiß meiner Hände und ein paar Jungs auf den hinteren Bänken lachen.“"
                            },
                            {
                                "example_id": "dc35be4e-b4ba-42ac-b17f-ceb2118dc6c7",
                                "sense_id": "c577206d-a79e-3c7b-9e98-e22b87cfd405",
                                "text": "„Das Kreidestück empfindet höchstes Glück, wenn ein Kind ‚Schlösser, Gärten mit Pavillons und das Meer mit der Sonne‘ malt und dabei das Kreidestück aufbraucht und verschwinden lässt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
