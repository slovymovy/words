{
    "word_family": [
        "tulipomania"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "585fd6b3-bb30-3fb2-b7ef-f84cb55b7378",
                    "sense_definition": "A type of flowering plant in the genus Tulipa.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with colorful <w>tulips</w> that bloomed every spring.",
                            "target_lang_translations": {
                                "ru": "Сад был полон разноцветных <w>тюльпанов</w>, которые расцветали каждую весну.",
                                "nl": "De tuin stond vol met kleurrijke <w>tulpen</w> die elk voorjaar bloeiden."
                            }
                        },
                        {
                            "text": "She planted many <w>tulips</w> along the edge of the walkway.",
                            "target_lang_translations": {
                                "ru": "Она посадила много <w>тюльпанов</w> вдоль края дорожки.",
                                "nl": "Ze plantte veel <w>tulpen</w> langs de rand van het pad."
                            }
                        }
                    ],
                    "common_phrases": [
                        "red tulips",
                        "spring tulips"
                    ],
                    "target_lang_definitions": {
                        "ru": "Многолетнее луковичное растение семейства лилейных с крупными красивыми цветками.",
                        "nl": "Een bolgewas uit het geslacht Tulipa met opvallende, kleurrijke bloemen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюльпан",
                                "target_lang_sense_clarification": "ботаническое название растения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tulp",
                                "target_lang_sense_clarification": "de plant"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e19560f3-a189-3c36-bdc7-3246df1f2a8c",
                    "sense_definition": "The flower produced by the tulip plant.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "flower",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He bought a beautiful bouquet of fresh <w>tulips</w> for his mother.",
                            "target_lang_translations": {
                                "ru": "Он купил красивый букет свежих <w>тюльпанов</w> для своей мамы.",
                                "nl": "Hij kocht een prachtig boeket verse <w>tulpen</w> voor zijn moeder."
                            }
                        },
                        {
                            "text": "The <w>tulip</w> petals were soft and bright yellow.",
                            "target_lang_translations": {
                                "ru": "Лепестки <w>тюльпана</w> были мягкими и ярко-жёлтыми.",
                                "nl": "De bloembladen van de <w>tulp</w> waren zacht en heldergeel."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cut tulips",
                        "tulip bulb"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цветок, который производит растение тюльпан.",
                        "nl": "De bloem die door de tulpenplant wordt geproduceerd."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тюльпан",
                                "target_lang_sense_clarification": "цветок растения"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "tulp",
                                "target_lang_sense_clarification": "de bloem"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51527e64-1c31-3261-91ec-065e6bca0f25",
                    "sense_definition": "An acronym representing the five points of Calvinist doctrine.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "theology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor explained the <w>TULIP</w> framework during the theology lecture.",
                            "target_lang_translations": {
                                "ru": "Профессор объяснил концепцию <w>TULIP</w> во время лекции по теологии.",
                                "nl": "De professor legde tijdens het theologiecollege het <w>TULIP</w>-kader uit."
                            }
                        },
                        {
                            "text": "Many reformed churches base their teachings on the <w>TULIP</w> acronym.",
                            "target_lang_translations": {
                                "ru": "Многие реформатские церкви основывают своё учение на акрониме <w>TULIP</w>.",
                                "nl": "Veel gereformeerde kerken baseren hun leer op het <w>TULIP</w>-acroniem."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акроним, представляющий пять пунктов кальвинистского вероучения.",
                        "nl": "Een acroniem voor de vijf punten van het calvinisme."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "TULIP",
                                "target_lang_sense_clarification": "богословский акроним (обычно используется в латинице)"
                            }
                        ],
                        "nl": [
                            {
                                "target_lang_word": "TULIP",
                                "target_lang_sense_clarification": "theologisch acroniem"
                            }
                        ]
                    }
                }
            ]
        },
        {
