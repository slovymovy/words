                                        "entry_id": "d3761827-e1d1-338b-8594-66cb4d789ce5",
                                        "glosses": [
                                            "Schwefel enthaltend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0af45d57-6aa4-45bb-8b6e-a2eea6603514",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Cystein […] ist eine schwefelhaltige proteinogene α-Aminosäure mit der Seitenkette –CH2–SH, die beim Erwachsenen in der Leber gebildet werden kann.“"
                                            },
                                            {
                                                "example_id": "af110a6c-ec3f-4d22-b96a-df9e11635a47",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Die schwefelhaltigen Aerosole schirmten das Sonnenlicht teilweise ab.“"
                                            },
                                            {
                                                "example_id": "6bf63938-39b5-4702-bdb0-2909186263d9",
                                                "sense_id": "755e60fb-77da-3eec-a4a5-dea55a2d6906",
                                                "text": "„Schwefelhaltigere Brennstoffe (Kohle) werden durch Schwefelärmere (Gas, Erdöl ) Brennstoffe sowie durch den in seiner Verwendung emissionsfreien Input Elektrizität ersetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3ae468d9-f7fd-417a-b207-2a61bd1586aa",
