                "senses": [
                    {
                        "sense_id": "80e84596-10a0-3845-b370-ff0571e41332",
                        "entry_id": "f56867d7-d92d-3853-a5a0-3433e3631b2f",
                        "glosses": [
                            "Donner un caractère faillible à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2ae88d7-19f9-40fe-bd23-91cba2c4bb30",
                                "sense_id": "80e84596-10a0-3845-b370-ff0571e41332",
                                "text": "L’universel pragmatique est engagé dans la procédure qui, si l’on peut dire, « faillibilise » systématiquement l’accord intersubjectif."
                            },
                            {
                                "example_id": "34b88984-e2d5-46b9-b30b-4d23d9233dac",
                                "sense_id": "80e84596-10a0-3845-b370-ff0571e41332",
                                "text": "La vocation de cette base documentaire est également de permettre à l’internaute de vérifier les analyses que je propose mais aussi de les mettre en perspective, voire de les critiquer, de les faillibiliser et pourquoi pas de les infirmer tout en bâtissant sa propre conception de la dynamique des réseaux d'influence."
                            }
                        ]
                    }
