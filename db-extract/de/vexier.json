                "senses": [
                    {
                        "sense_id": "270a7154-faf3-3baa-8364-3c33f88459a6",
                        "entry_id": "0bde9606-9be6-3196-95c0-d9ff0cf5af6a",
                        "glosses": [
                            "etwas, das eine Plage darstellt, eine Fopperei, eine schwierig zu lösende Aufgabe; speziell ein Teil an/in einem Schloss, das das unrechtmäßige Öffnen verhindert"
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "f0eb1185-ca00-4a0f-8256-68918b833f9d",
                                "sense_id": "270a7154-faf3-3baa-8364-3c33f88459a6",
                                "text": "„Erwähnt müssen hier noch die Vexiere werden, welche in früherer Zeit allgemeinere Anwendung fanden, jetzt aber nur noch vereinzelt vorkommen. Unter Vexieren sind Vorrichtungen zu verstehen, deren Handhabung bekannt sein muß, wenn das Schloß, selbst mit dem richtigen Schlüssel, geöffnet werden soll.“ (1878)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "241fce51-adb5-3bd3-9ad3-ce813bb1de2a",
                        "entry_id": "0bde9606-9be6-3196-95c0-d9ff0cf5af6a",
                        "glosses": [
                            "Geduldspiel, bei dem man zum Beispiel Schnüre entwirren oder Teile trennen muss"
                        ],
                        "tags": [
                            "Spiel"
                        ],
                        "examples": [
                            {
                                "example_id": "86e45b93-5a43-4c1a-8796-addedc1f9580",
                                "sense_id": "241fce51-adb5-3bd3-9ad3-ce813bb1de2a",
                                "text": "„Vexiere sind Spiele, bei denen anscheinend unlösbar ineinandergreifende Teile zu trennen sind. Bei Ring-Kordel-Kugel-Vexieren geht es darum, ein Element zu befreien.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
