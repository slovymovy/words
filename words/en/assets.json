                            {
                                "target_lang_word": "优势",
                                "target_lang_sense_clarification": "有利条件或强项"
                            },
                            {
                                "target_lang_word": "宝贵财富",
                                "target_lang_sense_clarification": "指对团队或组织有价值的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b418e66d-6835-388d-97bb-859b1aec6d59",
                    "sense_definition": "The section of a balance sheet where the value of property and property rights is recorded.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "financial_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In double-entry bookkeeping, <w>assets</w> must always equal liabilities plus equity.",
                            "target_lang_translations": {
                                "ru": "В двойной бухгалтерии <w>активы</w> всегда должны быть равны сумме обязательств и собственного капитала.",
                                "zh": "在复式记账法中，<w>资产</w>必须始终等于负债加所有者权益。"
                            }
                        },
                        {
                            "text": "The accountant checked the <w>assets</w> column for any discrepancies.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер проверил графу \"<w>активы</w>\" на наличие расхождений.",
                                "zh": "会计核对了<w>资产</w>栏，查看是否有任何差异。"
                            }
                        }
                    ],
                    "antonyms": [
                        "liabilities"
                    ],
                    "common_phrases": [
                        "assets and liabilities"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел бухгалтерского баланса, в котором отражается стоимость имущества и имущественных прав организации.",
                        "zh": "资产负债表中记录财产和财产权价值的部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "актив",
                                "target_lang_sense_clarification": "бухгалтерский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "资产",
                                "target_lang_sense_clarification": "会计术语"
                            }
                        ]
                    }
                },
