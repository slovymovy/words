                "translations": [
                    {
                        "translation_id": "a6dc50ac-e109-4d85-81a8-fe75a55c8353",
                        "source_entry_id": "556786a3-a6d3-3f15-8e08-5d54bfa0af4d",
                        "source_sense_description": "of a person",
                        "target_lang_word": "abandonné",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abandonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "078b2e9b-6862-3469-ab58-551c675d59bc",
                                        "entry_id": "ad0322e2-abf1-35e6-83fc-93f903af40ae",
                                        "glosses": [
                                            "Qui a été laissé seul."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c58d816-5483-420b-8ec1-ec05693de1cb",
                                                "sense_id": "078b2e9b-6862-3469-ab58-551c675d59bc",
                                                "text": "Il essaya de se persuader qu’il était à l’aise et en sécurité ; mais bientôt, l’indéfinissable inquiétude de l’animal sociable, abandonné dans la solitude, le tourmenta."
                                            },
                                            {
                                                "example_id": "875747e3-63de-4ecc-a9af-5b6947948c57",
                                                "sense_id": "078b2e9b-6862-3469-ab58-551c675d59bc",
                                                "text": "Rares et maigres, pauvres et silencieuses étaient les localités traversées et, dans celles-ci, nombreuses étaient les demeures manifestement abandonnées, les bicoques délabrées où tout en fait des ruines."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7461f17-5c11-3407-8f0f-6212f96b147f",
                                        "entry_id": "ad0322e2-abf1-35e6-83fc-93f903af40ae",
                                        "glosses": [
                                            "Qui est laissé à l’abandon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87f65361-bb87-46c6-a627-676ce7cb553e",
                                                "sense_id": "c7461f17-5c11-3407-8f0f-6212f96b147f",
                                                "text": "Mais cela peut même aller jusqu’à la désertification lorsque les familles ont pu à leur tour migrer : la montagne kabyle ou libanaise est ainsi constellée de fermes abandonnées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6f7c866f-79f7-38d9-a9f2-c75806a53e7d",
                                        "entry_id": "ad0322e2-abf1-35e6-83fc-93f903af40ae",
                                        "glosses": [
                                            "Qui manifeste un certain laisser-aller."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbbcd638-bc5c-437a-9cf3-5b20d2d7a90a",
                                                "sense_id": "6f7c866f-79f7-38d9-a9f2-c75806a53e7d",
                                                "text": "Émilienne restait debout. Elle n’était pas faite pour les fauteuils et les poses abandonnées."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abandonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "472d26ef-6dc2-3b06-8aeb-77dd82c5ec1e",
                                        "entry_id": "8c7e8bfc-fa5b-3cb0-8d0a-e699eebbc571",
                                        "glosses": [
                                            "Personne qui a été laissée seule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8db3002-17dd-4ce7-98cb-64956ca4e3ee",
                                                "sense_id": "472d26ef-6dc2-3b06-8aeb-77dd82c5ec1e",
                                                "text": "Eh bien! ma jolie Martine, ne souffrez point qu’un pauvre abandonné passe la nuit au soleil des loups."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abandonné",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "068d6ca1-e41a-3488-ac86-a2bf201e0681",
                                        "entry_id": "eec25bdc-7c56-3d9e-96e7-c8e3f1136629",
                                        "glosses": [
                                            "Participe passé masculin singulier de abandonner."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5688d24-ff1c-42e1-89d1-354053f22be0",
                                                "sense_id": "068d6ca1-e41a-3488-ac86-a2bf201e0681",
                                                "text": "Oh certes, il aurait tout abandonné dans la seconde à Dieu, sans l’ombre d'une hésitation, mais certainement pas aux hommes censés le représenter ; afin qu’ils pètent dans la soie, entretiennent sur un grand pied leurs catins ou damoiseaux, ou dilapident son argent en mangeries et en beuveries ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
