                "senses": [
                    {
                        "sense_id": "f1d64b40-fd18-34c9-9e42-393493dbb733",
                        "entry_id": "55302c21-8ede-33c8-bfe7-c1e44241b045",
                        "glosses": [
                            "большой гурт овец"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08d0ab66-cebe-410c-afc2-08486bafdf8c",
                                "sense_id": "f1d64b40-fd18-34c9-9e42-393493dbb733",
                                "text": "У широкой степной дороги, называемой большим шляхом, ночевала отара овец."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c26256f7-0ad3-469d-97a8-7746dc59b222",
                        "source_entry_id": "55302c21-8ede-33c8-bfe7-c1e44241b045",
                        "source_sense_id": "f1d64b40-fd18-34c9-9e42-393493dbb733",
                        "target_lang_word": "herd",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                                        "entry_id": "942e4f69-8c15-3acc-ac3e-7991b1955054",
                                        "glosses": [
                                            "A number of domestic animals assembled together under the watch or ownership of a keeper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9029b13c-ba13-4f79-860b-a00f162f0b11",
                                                "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                                                "text": "a herd of cattle"
                                            },
                                            {
                                                "example_id": "b439890e-8e52-4caf-9b08-919525b027fe",
                                                "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                                                "text": "a herd of sheep"
                                            },
                                            {
                                                "example_id": "f17e8e13-5a5b-49bc-8beb-e0616730815c",
                                                "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                                                "text": "a herd of goats"
                                            },
                                            {
                                                "example_id": "985dd5ca-564e-4b06-8baf-0277aeffa42e",
                                                "sense_id": "0b42047e-441f-3ae7-af78-47c2eb7ddc07",
                                                "text": "The lowing herd wind slowly o’er the lea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca40ee3b-f77d-33a3-af8f-ce117e621579",
                                        "entry_id": "942e4f69-8c15-3acc-ac3e-7991b1955054",
                                        "glosses": [
                                            "Any collection of animals gathered or travelling in a company."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d166a4bc-3689-4f45-beca-dacb7c08aca2",
                                                "sense_id": "ca40ee3b-f77d-33a3-af8f-ce117e621579",
                                                "text": "Zakouma is the last place on Earth where you can see more than a thousand elephants on the move in a single, compact herd."
                                            },
                                            {
                                                "example_id": "68017589-2bd5-48d6-9564-c56454a2702c",
                                                "sense_id": "ca40ee3b-f77d-33a3-af8f-ce117e621579",
                                                "text": "Zebras can also be called a herd or a zeal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                                        "entry_id": "942e4f69-8c15-3acc-ac3e-7991b1955054",
                                        "glosses": [
                                            "A crowd, a mass of people or things; a rabble."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4dfbfad8-db3e-4c96-b8f6-5eb831111f29",
                                                "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                                                "text": "I was never one to follow the herd."
                                            },
                                            {
                                                "example_id": "de79cd7d-9c05-4dda-90ce-1f3e57a43d09",
                                                "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                                                "text": "But far more numerous was the Herd of ſuch, / Who think too little, and who talk too much."
                                            },
                                            {
                                                "example_id": "5417674a-af4f-4b22-99de-3deaa481d71e",
                                                "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                                                "text": "You can never interest the common herd in the abstract question."
                                            },
                                            {
                                                "example_id": "97ef9ff3-83cc-4edf-b76a-7b22922f46d8",
                                                "sense_id": "8012dfd7-71a7-327d-a96d-992e12abfaaa",
                                                "text": "There were herds of leather sofas and enough computers to ensure that no prospective matriculant or visiting parent could enter a room and not see at least one available keyboard, not even in the dining hall or field house."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "herd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1907dc67-0d94-3b65-a044-80494d6f672d",
                                        "entry_id": "80c64973-f43d-3e71-96d1-b116d69d3680",
                                        "glosses": [
                                            "To unite or associate in a herd; to feed or run together, or in company."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3a6ef35-3e8a-450c-bbeb-ab3151263a75",
                                                "sense_id": "1907dc67-0d94-3b65-a044-80494d6f672d",
                                                "text": "Sheep herd on many hills."
                                            },
                                            {
                                                "example_id": "7eaf35b4-392a-48b9-9ea6-1c3e3b521185",
                                                "sense_id": "1907dc67-0d94-3b65-a044-80494d6f672d",
                                                "text": "The women bunched up in little droves and let their tongues clack, and the men herded together and passed a jug around and, to tell the truth, let their tongues clack too."
                                            },
                                            {
                                                "example_id": "c18efa4b-04de-41b9-9b8c-88357a0bd668",
                                                "sense_id": "1907dc67-0d94-3b65-a044-80494d6f672d",
                                                "text": "Any predator that preys on animals that herd or school, has to be able to single out one individual to attack."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96c598d6-dcfc-3927-86ae-d98706b27451",
                                        "entry_id": "80c64973-f43d-3e71-96d1-b116d69d3680",
                                        "glosses": [
                                            "To unite or associate in a herd"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e86dfced-4f9d-3201-af8a-b935473d2cdf",
                                        "entry_id": "80c64973-f43d-3e71-96d1-b116d69d3680",
                                        "glosses": [
                                            "To manage, care for or guard a herd"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d7068520-37c8-43a2-b089-cbd77b26c94c",
                                                "sense_id": "e86dfced-4f9d-3201-af8a-b935473d2cdf",
                                                "text": "He is employed to herd the goats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6a65dce-13d8-350f-ba3f-fb2437edd4db",
                                        "entry_id": "80c64973-f43d-3e71-96d1-b116d69d3680",
                                        "glosses": [
                                            "To associate; to ally oneself with, or place oneself among, a group or company."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18967d0d-9ea1-4e4d-b623-bf6165bffade",
                                                "sense_id": "a6a65dce-13d8-350f-ba3f-fb2437edd4db",
                                                "text": "I’ll herd among his Friends, and ſeem\nOne of the Number, […]"
                                            },
                                            {
                                                "example_id": "a582a7bd-98fe-4162-8dc2-79c630dc421f",
                                                "sense_id": "a6a65dce-13d8-350f-ba3f-fb2437edd4db",
                                                "text": "\"[W]hy, I say, oh stranger, dost thou think that I herd here with barbarians lower than the beasts?\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5898ee11-e406-331c-a23e-49a2084f1000",
                                        "entry_id": "80c64973-f43d-3e71-96d1-b116d69d3680",
                                        "glosses": [
                                            "To move, or be moved, in a group. (of both animals and people)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c232c911-938b-493f-ad4e-91c300c17601",
                                                "sense_id": "5898ee11-e406-331c-a23e-49a2084f1000",
                                                "text": "On alighting at the station, we were all herded over the footbridge and through a side exit."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "herd",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "50b82f09-1443-309f-8f5e-d9523b3f9987",
                                        "entry_id": "c7932572-36b0-3547-84c9-7e096d8cbbbf",
                                        "glosses": [
                                            "Someone who keeps a group of domestic animals."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a6e10d2-a387-4ff2-89c0-7c6b6af3250c",
                                                "sense_id": "50b82f09-1443-309f-8f5e-d9523b3f9987",
                                                "text": "John Dodds, the herd who bode in the place, was standing at the door, and he looked to see who was on the road so late."
                                            },
                                            {
                                                "example_id": "09dcd203-8cab-4b7a-bd08-f1cf49780f5f",
                                                "sense_id": "50b82f09-1443-309f-8f5e-d9523b3f9987",
                                                "text": "Any talent which gives a good new thing to others is a miracle, but commentators have thought it extra miraculous that England's first known poet was an illiterate herd."
                                            }
                                        ]
                                    }
                                ]
