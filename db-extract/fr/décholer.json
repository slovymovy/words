                "senses": [
                    {
                        "sense_id": "a94cd6fc-8859-39f3-aaac-8dffe9f4c124",
                        "entry_id": "2ad2f250-5c74-3009-9f09-352266b32e77",
                        "glosses": [
                            "Au jeu de la crosse, envoyer la cholette à un endroit qui complique la tâche des adversaires."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "abeb8e83-b241-4672-89fd-aba685992438",
                                "sense_id": "a94cd6fc-8859-39f3-aaac-8dffe9f4c124",
                                "text": "S’il m’attaquait je l’aurais bientôt décholé !"
                            },
                            {
                                "example_id": "eaf9c939-45ba-4ac9-a6e9-c71d02c3d1e1",
                                "sense_id": "a94cd6fc-8859-39f3-aaac-8dffe9f4c124",
                                "text": "À Tournai, le jour du Mardi gras, on allait « sans décholer » jusqu’au haut du mont Saint-Aubert et le but final était le portail de l'église (Ravez)."
                            },
                            {
                                "example_id": "fb31b76e-175d-40fd-a4ad-6aa3fec4bebf",
                                "sense_id": "a94cd6fc-8859-39f3-aaac-8dffe9f4c124",
                                "text": "Pour corser le jeu, les équipes sont divisées en deux camps : ceux qui cholent en direction de la tonne et ceux qui décholent, renvoyant la cholette au diable vauvert selon une fréquence invariable."
                            }
                        ]
                    }
