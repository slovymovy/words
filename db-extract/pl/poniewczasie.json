                                ]
                            },
                            {
                                "target_word": "tard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                        "entry_id": "8aecfc21-e7ce-3bfb-b20f-5d227db6b0f6",
                                        "glosses": [
                                            "Après le moment voulu ; après le temps ordinaire et accoutumé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "05ac1488-cde5-4000-9dbc-89b334c04f5f",
                                                "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                                "text": "Bakounine se levait tard, nous ne pouvions donc nous rendre chez lui que vers les dix heures."
                                            },
                                            {
                                                "example_id": "80a766f9-8e45-4f85-bb81-11577c804ed8",
                                                "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                                "text": "Louis le pieux meurt en 840 sur le Rhin. Un an plus tard, la flotte danoise embouque l’estuaire de la Seine."
                                            },
                                            {
                                                "example_id": "8ef5a4f5-c119-48c4-977c-0fddc56db1da",
                                                "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                                "text": "Vous venez un peu tard. — Il arriva tard."
                                            },
                                            {
                                                "example_id": "b1838538-3160-4393-93e5-e0e9f9262add",
                                                "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                                "text": "Vous avez attendu bien tard."
                                            },
                                            {
                                                "example_id": "6a221edb-32d4-4311-a1ed-53b65ac3d849",
                                                "sense_id": "413d4765-b708-3755-8669-f7d40c434fca",
                                                "text": "Nous ne pouvons vous arriver que tard."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "55b10aa5-7368-36c3-9640-8193db3ab292",
                                        "entry_id": "8aecfc21-e7ce-3bfb-b20f-5d227db6b0f6",
                                        "glosses": [
                                            "À un moment avancé, vers la fin de la journée, de l’année, de la vie, d’une période quelconque."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d14cd21-17f1-409b-8ae0-0fd983b60bd9",
                                                "sense_id": "55b10aa5-7368-36c3-9640-8193db3ab292",
                                                "text": "Il fait beau tard cette année."
                                            },
                                            {
                                                "example_id": "f4e25f94-9ad4-4269-bb4b-90e0e732ccfd",
                                                "sense_id": "55b10aa5-7368-36c3-9640-8193db3ab292",
                                                "text": "Se lever, se coucher tard."
                                            },
                                            {
                                                "example_id": "bc384b08-fd4a-4567-a46d-1886dbe2315b",
                                                "sense_id": "55b10aa5-7368-36c3-9640-8193db3ab292",
                                                "text": "Les vendanges se font tard cette année."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tard",
                                "target_lang_code": "fr",
                                "target_senses": [
