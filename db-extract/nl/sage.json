                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cb05dbbf-4871-486e-898e-0e7203341715",
                        "source_entry_id": "d36c6b5e-3fd2-3285-84e9-9b2877e7388e",
                        "source_sense_id": "0d2ebf0e-f169-3cf9-a202-4353573f1c51",
                        "target_lang_word": "saga",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "saga",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2835d207-c9aa-3999-a1b5-e48662a4e7cb",
                                        "entry_id": "5d65fbf2-1354-3a89-8955-854da38950cf",
                                        "glosses": [
                                            "Textes traditionnels mythologiques et historiques des peuples scandinaves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c24a570-dde6-4eab-8092-0224520f803e",
                                                "sense_id": "2835d207-c9aa-3999-a1b5-e48662a4e7cb",
                                                "text": "Les compagnons fabuleux de Charlemagne, les courtois chevaliers de la Table ronde prirent place dans la littérature islandaise à côté de Sigurd, de Théodoric et d’Attila, et les sagas s’étonnèrent de mêler des récits de tournois et d’aventures aux lugubres tragédies qui les ensanglantaient."
                                            },
                                            {
                                                "example_id": "f0285057-dabc-4924-94e0-bb723370cb09",
                                                "sense_id": "2835d207-c9aa-3999-a1b5-e48662a4e7cb",
                                                "text": "La saga de Gretté est aussi populaire dans le nord de l'Islande que la saga de Njal l'est dans le sud."
                                            },
                                            {
                                                "example_id": "7c3c6c0a-6fd9-4bb9-a97b-a46cea606434",
                                                "sense_id": "2835d207-c9aa-3999-a1b5-e48662a4e7cb",
                                                "text": "Contrairement aux vieilles sagas scandinaves où bouillonne le sang des Vikings, Le Kalevala est un récit plutôt pacifique."
                                            },
                                            {
                                                "example_id": "0cb17f7e-2b81-443c-900c-8f87265fd568",
                                                "sense_id": "2835d207-c9aa-3999-a1b5-e48662a4e7cb",
                                                "text": "Les sagas nordiques — ce mot vient du verbe segia qui signifie « raconter » en vieux norrois — forment le coeur de la littérature scandinave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff9bdb46-a195-36ed-9177-8ed9395422c5",
                                        "entry_id": "5d65fbf2-1354-3a89-8955-854da38950cf",
                                        "glosses": [
                                            "Histoire, épopée plus ou moins légendaire d’une même famille sur plusieurs générations ou d’un personnage remarquable."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0975440b-f2e1-44ef-a7e3-4d346ffa00b5",
                                                "sense_id": "ff9bdb46-a195-36ed-9177-8ed9395422c5",
                                                "text": "Dans cette saga, Alain Mercier nous offre les biographies simultanées du footballeur Zacharie, du tennisman Yannick et du basketteur Joakim."
                                            },
                                            {
                                                "example_id": "7a49b6e8-c99d-413a-86f1-82db8398fc6e",
                                                "sense_id": "ff9bdb46-a195-36ed-9177-8ed9395422c5",
                                                "text": "Henri a probablement hérité de lui le goût de la lecture et surtout des livres retraçant l'épopée des luttes ouvrières en Ardenne, avec Jean-Baptiste Clément et la saga des \"Mamert\" de Jean Rogissart."
                                            },
                                            {
                                                "example_id": "94c90f5e-b90a-412b-b990-f0477480c4df",
                                                "sense_id": "ff9bdb46-a195-36ed-9177-8ed9395422c5",
                                                "text": "« Si à chaque fois qu’on avait fini un film ou une saga il avait fallu qu’on se dise : « Oh bah ça va ; l’histoire, elle est terminée ; il n’y a plus rien à raconter. », on aurait jamais eu la saga Retour vers le futur, la saga Alien, la saga Rambo, la saga Rocky, la saga Die Hard ; les douze films Star Trek. On peut toujours aller plus loin. »"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
