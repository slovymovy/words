                                "example_id": "7244090c-a133-414c-aaf0-bc93eb92b663",
                                "sense_id": "10afe5d5-216f-3e4f-b65f-4f30ab42b220",
                                "text": "Claudia verwendet macht zum Brötchenbacken gern Mehl aus Vollkorn."
                            },
                            {
                                "example_id": "f28db43b-eb16-44f4-9da6-05449e167f55",
                                "sense_id": "10afe5d5-216f-3e4f-b65f-4f30ab42b220",
                                "text": "„Die Teilnehmer der ersten Gruppe ernährten sich bewusster: mehr fettarme Milchprodukte, Obst, Vollkorn, Geflügel, Fisch und Gemüse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
