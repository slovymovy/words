                                        "glosses": [
                                            "Espèce de poisson osseux, marin et carnivore, carangidé du genre Trachurus, au corps fuselé, avec lignes latérales accessoires, aux opercules tachés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9c3837b-9abe-4abc-abb0-bba60cb27119",
                                                "sense_id": "38698f27-6a79-3889-82e2-bb468689ba26",
                                                "text": "Le chinchard a le corps allongé et ovale, teinté d’un bleu foncé métallique au-dessus de la ligne latérale."
                                            },
                                            {
                                                "example_id": "1217cbb3-fa1d-4f77-af3a-f044b2e6b15e",
                                                "sense_id": "38698f27-6a79-3889-82e2-bb468689ba26",
                                                "text": "Des lieus, des chinchards, des aiguillettes, parfois des maquereaux, des bars…"
                                            }
                                        ]
                                    }
                                ]
                            }
