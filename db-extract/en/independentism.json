                "senses": [
                    {
                        "sense_id": "e33c5acc-898d-306e-b86f-9fbc848ee943",
                        "entry_id": "4a7e2c0f-7da5-355d-9345-e0a8175c4431",
                        "glosses": [
                            "Independency"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "030eb3e2-9ad7-4df8-bb27-5983270f6ed9",
                                "sense_id": "e33c5acc-898d-306e-b86f-9fbc848ee943",
                                "text": "pre-1662, Bishop John Gauden\nIn the Brownist system, each congregation is independent of every other; hence the origin of the terms Congregationalism and Independentism."
                            }
                        ]
                    }
                ],
                "translations": [],
