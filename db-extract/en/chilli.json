                        "sense_id": "095dfce8-7b32-30d4-8286-3a68e9d3eefa",
                        "entry_id": "f8fce0c2-1440-362f-8727-3ba4701ac6fe",
                        "glosses": [
                            "Món thịt bò hầm đậu đỏ kèm ớt cay khô, thường sốt hành tây và cà chua."
