                "senses": [
                    {
                        "sense_id": "0ed99339-a9fa-357b-a842-d9e936b5b2c1",
                        "entry_id": "cb3342d5-bcf8-3fc0-adf8-e3523eb41d93",
                        "glosses": [
                            "Any branch of learning, especially one ending in “-logy”."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "25c0791c-462d-4499-8663-2357e4bb26fe",
                                "sense_id": "0ed99339-a9fa-357b-a842-d9e936b5b2c1",
                                "text": "Dr Ehrhart protested no country under the sun equalled Portugal for curiosities in mineralogy, theology, and wineology – which ology he was convinced was the best of them all."
                            },
                            {
                                "example_id": "42f3ce95-312a-4a3d-96da-3d01dab6b6e4",
                                "sense_id": "0ed99339-a9fa-357b-a842-d9e936b5b2c1",
                                "text": "You learnt a great deal, Louisa, and so did your brother. Ologies of all kinds, from morning to night. If there is an Ology left, of any description, that has not been worn to rags..."
                            },
                            {
                                "example_id": "c30a948e-39da-467f-8a3e-338a7d8d705f",
                                "sense_id": "0ed99339-a9fa-357b-a842-d9e936b5b2c1",
                                "text": "The ideal world, for them, is not a world of facts, but only of the meaning of facts; it is a point of view for judging facts. It appertains to a different \"-ology,\" […]"
                            },
                            {
                                "example_id": "b95aeb3d-b7a5-4943-a4a8-c21104628011",
                                "sense_id": "0ed99339-a9fa-357b-a842-d9e936b5b2c1",
                                "text": "An ology! He gets an ology and he says he's failed. You get an ology, you're a scientist!"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
