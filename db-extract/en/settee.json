            {
                "entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                "word": "settee",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "ba59d9bb-66d2-4274-a221-925584646c25",
                        "entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                        "tags": [
                            "plural"
                        ],
                        "form": "settees"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                        "entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                        "glosses": [
                            "A long seat with a back, made to accommodate several persons at once; a sofa."
                        ],
                        "tags": [
                            "Texas",
                            "UK"
                        ],
                        "examples": [
                            {
                                "example_id": "3c92f380-e8f9-4f21-96cd-f7ef0bcf31a1",
                                "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                                "text": "The lounge was furnished in old English oak and big Knole settees. There were rugs from Tabriz and Kerman on the highly polished floor. […] A table lamp was fashioned from a silver Egyptian hookah."
                            },
                            {
                                "example_id": "66ec73f5-7e73-4a50-aaf4-2975c445a21c",
                                "sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                                "text": "“You might have to calm this down, my darling. I'm not sure this settee can take it.” “This settee has taken centuries of our love.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "69856f41-b489-4b83-90ed-9471b0c526ee",
                        "source_entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                        "source_sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                        "source_sense_description": "long seat",
                        "target_lang_word": "Sitzbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sitzbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                        "entry_id": "4931a35e-88be-3d95-8fd3-46807b8ba180",
                                        "glosses": [
                                            "ein Sitzmöbel zumeist für mehrere Personen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24ff4ba2-2205-4d65-aba9-64bb7b2d9bb0",
                                                "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                                "text": "Die Sitzbank am Fenster ist der perfekte Platz zum Lesen. Komfortabel, gut beleuchtet und platzsparend – die Sitzbank kann schnell zum Lieblingsplatz im ganzen Haus werden. Doch nicht alle Fenster sind für eine Sitzbank geeignet."
                                            },
                                            {
                                                "example_id": "81f32512-ef7a-4224-b039-ee43e9c53a8a",
                                                "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                                "text": "Zuvor hatte die westfranzösische Stadt Angoulême für Empörung gesorgt: Sie hatte kurz vor Weihnachten Sitzbänke mit Gittern abgesperrt, diese Maßnahme nach Protesten aber wieder zurückgezogen."
                                            },
                                            {
                                                "example_id": "8c69dea4-dc27-4c45-8b99-680305789a18",
                                                "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                                "text": "Unterwegs: Im spanischen Taxi sitzen die Fahrgäste auf der hinteren Sitzbank. Der Beifahrersitz ist für die Zeitung oder den Lunch des Fahrers bestimmt."
                                            },
                                            {
                                                "example_id": "fb184836-6e32-48be-9edb-893bcf29ac9b",
                                                "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                                "text": "Der Christian-Broda-Platz zu Beginn der Mariahilfer Straße bietet einige der wenigen Sitzbänke im Grätzel."
                                            },
                                            {
                                                "example_id": "5709177a-c3e1-4170-bbef-ae363d404dc0",
                                                "sense_id": "f51a1fd7-fa84-3e4e-ae4c-4bb2d5c8c46d",
                                                "text": "Prägend wurden nun vor allem die halbrunden roten Sitzbänke, die dem Kaffeehaus einen gemütlichen Wohnzimmercharakter verliehen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd4d5cc2-6736-4b19-9663-bdf99c835c11",
                        "source_entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                        "source_sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                        "source_sense_description": "long seat",
                        "target_lang_word": "Sofa",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sofa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                        "entry_id": "b8b10dd5-9053-3f63-b833-e08e3d8d370d",
                                        "glosses": [
                                            "gepolstertes Sitzmöbel für mindestens zwei Personen mit Arm- und Rückenlehnen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "931b87bd-241a-40fd-82a7-8423de72c7d2",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "Auf dem Sofa saßen schon meine Tanten."
                                            },
                                            {
                                                "example_id": "5dc09a8a-5459-41d6-b0ee-75bb6f1bb4d6",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "Was ist denn hier passiert? Hier sieht es ja aus wie bei Hempels unterm Sofa!"
                                            },
                                            {
                                                "example_id": "854f359b-22c3-4aa5-b746-e14fd1be1f01",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Vor dem Sofa bleibt Klose stehen und blickt auf den schlafenden Lassehn.“"
                                            },
                                            {
                                                "example_id": "fa14bd5b-da9b-4bcd-9436-29b040aaba0a",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Dem Sofa gegenüber waren ein mit blauem Samt bezogener Zweisitzer und zwei Esszimmerstühle aus Rattan aufgestellt.“"
                                            },
                                            {
                                                "example_id": "6136881f-647e-43dd-93cc-beba2af56a04",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Frau von Carayon kniete neben dem Sofa nieder und sprach ihr zu.“"
                                            },
                                            {
                                                "example_id": "52253d77-f115-4114-86cd-6861fb0e12f4",
                                                "sense_id": "d4cf4924-fb68-3263-9b6e-8f6f1a213aca",
                                                "text": "„Er holte seine Geige aus der Ecke hervor, und als ich mich auf dem Sofa ausgestreckt hatte, begann er eine leise, verträumte Melodie zu spielen, vermutlich seine eigene Erfindung, denn er konnte vozüglich improvisieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa3b0470-32d8-4e4a-8be7-c564624cbe5a",
                        "source_entry_id": "5bf0c527-3719-3fbb-9e28-9f39fc629d64",
                        "source_sense_id": "ba2502fb-2bca-3867-902f-e3bd7ee7ddc5",
                        "source_sense_description": "long seat",
                        "target_lang_word": "Couch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Couch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                        "entry_id": "1201fb0c-2a7d-3a71-8456-14d7774ba556",
                                        "glosses": [
                                            "„breiteres Liegesofa“ mit zwei oder mehr Sitzplätzen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7aeec38f-923f-4f87-8f36-d0991ed27f2c",
                                                "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                                "text": "„King Kong taumelte nach vorn, fiel mit dem Gesicht auf die Couch und war k.o.“"
                                            },
                                            {
                                                "example_id": "fb808a7d-8fe8-4e10-ab86-3ced73a6357a",
                                                "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                                "text": "Auf der Couch ist genug Platz für drei Personen."
                                            },
                                            {
                                                "example_id": "9d2951ac-c9b7-4cd0-8fa1-2424add99a90",
                                                "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                                "text": "„Er hatte sich gerade auf die Couch im Zimmer seines Gartenhäuschens gesetzt, das spärlich eingerichtet ist.“"
                                            },
                                            {
                                                "example_id": "5a5b3b9e-63f7-427b-9e0e-3c8b7888cfcc",
                                                "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                                "text": "„In dem langen, reich möblierten Salon sitzen die beiden Frauen auf der Couch.“"
                                            },
                                            {
                                                "example_id": "865bebc9-e38b-4801-80e1-ed046ebc26cb",
                                                "sense_id": "a5349db5-799f-35a2-9920-44d1376ed6ec",
                                                "text": "„Bevor sie fort müssen in ihr für die Nacht verschlossenes Lager, schleppen die Männer vom Dachboden, aus Abstellkammern oder Kellerverschlägen herbei, was da aufbewahrt liegt: eine alte Couch, Tisch und Stühle, einen Kanonenofen samt Rohr, das in die Fensterhöhle hinausgeleitet wird, Holz zum Heizen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "de072d66-c42e-49f9-a37c-f03bebb39427",
