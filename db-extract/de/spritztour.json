                "senses": [
                    {
                        "sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                        "entry_id": "04040754-e934-38c0-9649-4395a3f29da0",
                        "glosses": [
                            "kurzer, spontaner, vergnüglicher Ausflug mit einem Fahrzeug"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d9147bd9-d4f1-4676-9fcf-7934131a3882",
                                "sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                                "text": "Wir machen heute eine Spritztour."
                            },
                            {
                                "example_id": "ccc81650-5ab7-4a94-8648-dd8338d1637d",
                                "sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                                "text": "„Abends spielten wir Casino, und tagsüber unternahm ich Spritztouren, um die Fjorde ringsum zu sehen.“"
                            },
                            {
                                "example_id": "805d162a-0b05-4d1b-a40b-fa6788d0075b",
                                "sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                                "text": "„Nach dieser angenehmen Spritztour wollte ich durch das Goldene Valley fahren, angelockt von seinem Namen.“"
                            },
                            {
                                "example_id": "157c6a28-bc76-400d-8b00-5dd3026075b8",
                                "sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                                "text": "„Jedenfalls machte ich mit dem motorisierten Freund eine Spritztour zum schwedischen Möbelhaus in Lichtenberg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a095266-1b89-4dbf-bbf1-b462fdf69b45",
                        "source_entry_id": "04040754-e934-38c0-9649-4395a3f29da0",
                        "source_sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                        "source_sense_description": "umgangssprachlich: kurzer, spontaner, vergnüglicher Ausflug mit einem Fahrzeug",
                        "target_lang_word": "joyride",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "joyride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5938ae94-e5c7-32f6-bc09-2da9b6d99a96",
                                        "entry_id": "307c839a-52f8-3ea6-9239-d733f3c0db2a",
                                        "glosses": [
                                            "A ride in a vehicle taken solely for pleasure or enjoyment, especially a vehicle ride taken with no particular goal or purpose and just for the pleasure or enjoyment of a vehicle ride."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c6ba3d0-00a7-44fa-9e6b-c45ed14e61a3",
                                                "sense_id": "5938ae94-e5c7-32f6-bc09-2da9b6d99a96",
                                                "text": "Joyrides and hikes: Commuters keep these 11 new Thomson-East Coast Line stations buzzing on the first day of operations"
                                            },
                                            {
                                                "example_id": "912b1b7e-4072-490e-bdc9-f2a75082f6a1",
                                                "sense_id": "5938ae94-e5c7-32f6-bc09-2da9b6d99a96",
                                                "text": "Launched last March, the H.C.C. is similar to a country club-except, instead of playing golf, members take joyrides or leisurely weekend trips in any of the top-of-the-line cars housed in a Century City garage."
                                            },
                                            {
                                                "example_id": "af6c5114-e326-44e9-87f7-021109f75788",
                                                "sense_id": "5938ae94-e5c7-32f6-bc09-2da9b6d99a96",
                                                "text": "It's called the Beast for a reason: You literally hold on to your hat -- and your sunglasses, and anything else that isn't secured -- for a 30-minute joyride. Painted to look like a bright green, sharp-toothed shark, this 70-foot racing boat zips down the Hudson, skips over waves and zooms past the Empire State Building and other landmarks at up to 45 mph."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0d9ba1f0-db33-3897-a80d-e49cfc5be55a",
                                        "entry_id": "307c839a-52f8-3ea6-9239-d733f3c0db2a",
                                        "glosses": [
                                            "An instance of driving a motor vehicle in a carefree or reckless manner, especially a vehicle which has been taken without the permission of the owner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a0e30ca-e6ba-4db5-a458-a34e78b6bdb0",
                                                "sense_id": "0d9ba1f0-db33-3897-a80d-e49cfc5be55a",
                                                "text": "Thieves took three go-karts for a joyride through the streets of Norwich."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0185c6af-6927-3abe-8c2e-e6194261fec1",
                                        "entry_id": "307c839a-52f8-3ea6-9239-d733f3c0db2a",
                                        "glosses": [
                                            "A very pleasant experience."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e87c2d96-3837-4aec-99f7-efae9a0ad072",
                                                "sense_id": "0185c6af-6927-3abe-8c2e-e6194261fec1",
                                                "text": "Hello, you fool, I love you / Come on, join the joyride"
                                            },
                                            {
                                                "example_id": "4763698b-c831-4663-a533-e8e3855d6ce5",
                                                "sense_id": "0185c6af-6927-3abe-8c2e-e6194261fec1",
                                                "text": "Treat your taste buds. A good meal is a three-hour joyride for the senses — as rich as visiting an art gallery and as stimulating as a good massage."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "joyride",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d95c4416-760c-3f84-8988-1988079e85a0",
                                        "entry_id": "0117fc02-47da-3368-b7ce-0d6d55d28ab9",
                                        "glosses": [
                                            "To take a joyride."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa83905d-4889-4a65-8b78-59787cb4f569",
                                                "sense_id": "d95c4416-760c-3f84-8988-1988079e85a0",
                                                "text": "You joyride around for a while listening / to the radio, and then abandon death, walk / away, and leave death for the police / to find."
                                            },
                                            {
                                                "example_id": "7702c74f-5921-4029-b07c-fd35a6d8e0b0",
                                                "sense_id": "d95c4416-760c-3f84-8988-1988079e85a0",
                                                "text": "His parents were out shopping and he used the opportunity to snatch the keys to the 1999 Suzuki Esteem and joyride around the neighborhood."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "da3ae871-95f8-4ce1-870a-9e118bd2921a",
                        "source_entry_id": "04040754-e934-38c0-9649-4395a3f29da0",
                        "source_sense_id": "4e82db8c-c934-3c28-b105-d46c8a17de50",
                        "source_sense_description": "umgangssprachlich: kurzer, spontaner, vergnüglicher Ausflug mit einem Fahrzeug",
                        "target_lang_word": "virée",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "virée",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8318367a-6b59-3738-9d2e-925936262e34",
                                        "entry_id": "d7d77b12-97b7-34a1-a246-42f760a4cc7c",
                                        "glosses": [
                                            "Sortie dans un but de promenade ou d’amusement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a76173b0-1716-4ed0-9c6f-309497a8b049",
                                                "sense_id": "8318367a-6b59-3738-9d2e-925936262e34",
                                                "text": "Pino, tel une ombre, était de toutes les fêtes, de toutes les virées, de tous les bals en plein air préludant au troussement des filles moins farouches depuis l'invention de la pilule."
                                            },
                                            {
                                                "example_id": "b6f048f3-16a3-404b-9ff1-01ca83e3c46e",
                                                "sense_id": "8318367a-6b59-3738-9d2e-925936262e34",
                                                "text": "Enton Genius : Avant tout, nos textes évoquent la teuf, la chouille entre potes, les virées, les grosses cuites, l'amour, la mort…"
                                            },
                                            {
                                                "example_id": "398acfb7-2737-4c1f-ab8e-dd849f427447",
                                                "sense_id": "8318367a-6b59-3738-9d2e-925936262e34",
                                                "text": "Faute de mieux, Marçais a suivi sa mère comme son ombre, avec le maigre espoir qu’elle retrouve son fils : la promenade du clébard, un horrible cocker court sur pattes, les courses au Codec voisin, et même la virée en bus dans l’après-midi, jusqu’au Prisunic des Champs-Élysées, où elle a acheté tout un tas de produits de beauté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f7e4907-8b0b-3f23-a5e7-0df6f8d85099",
                                        "entry_id": "d7d77b12-97b7-34a1-a246-42f760a4cc7c",
                                        "glosses": [
                                            "Bande virtuelle de terrain, permettant l’organisation en lignes d’un travail sur des parcelles forestières."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17d1a191-84ae-4e57-bb9a-a48211535503",
                                                "sense_id": "2f7e4907-8b0b-3f23-a5e7-0df6f8d85099",
                                                "text": "Avant de procéder au balivage, il est fort utile de diviser la coupe en virées parallèles dans chacune desquelles on opérera successivement."
                                            },
                                            {
                                                "example_id": "cca2aa3c-82c3-4747-96a4-6f6049e464f0",
                                                "sense_id": "2f7e4907-8b0b-3f23-a5e7-0df6f8d85099",
                                                "text": "Le comptage des tiges repérées est indispensable pour pouvoir contrôler son travail : un point en fin de virée permet d’ajuster les consignes si nécessaire."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "virée",
                                "target_lang_code": "fr",
