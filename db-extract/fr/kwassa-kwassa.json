                "senses": [
                    {
                        "sense_id": "caabddef-15ab-3557-b6d9-e9dabacc202a",
                        "entry_id": "41b80644-d0a3-33fd-a678-4afe86f142b5",
                        "glosses": [
                            "Barque de pêcheur, originaire des Comores."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f37973b-800b-423f-a8e8-6c7669f2b554",
                                "sense_id": "caabddef-15ab-3557-b6d9-e9dabacc202a",
                                "text": "Elle se souvient de leur traversée, une nuit, sur l’océan Indien depuis une autre île des Comores, la famille trempée sur le kwassa-kwassa, ces embarcations de fortune qui convoient les clandestins."
                            },
                            {
                                "example_id": "966d06ac-8d7e-461c-9501-aced0481d80d",
                                "sense_id": "caabddef-15ab-3557-b6d9-e9dabacc202a",
                                "text": "Un kwassa-kwassa est un bateau de pêche utilisé par des passeurs pour emmener clandestinement des migrants originaires des Comores sur l’île de Mayotte."
                            },
                            {
                                "example_id": "d6b61c87-bdb3-4b06-83d8-da6aede67f2d",
                                "sense_id": "caabddef-15ab-3557-b6d9-e9dabacc202a",
                                "text": "Et il a cette phrase : « Le kwassa-kwassa pêche peu, il amène du Comorien », rapport à tous les pauvres des Comores qui tentent de rejoindre Mayotte en kwassa-kwassa."
                            },
                            {
                                "example_id": "bf20cdc7-ea32-4a36-af10-01e768108250",
                                "sense_id": "caabddef-15ab-3557-b6d9-e9dabacc202a",
                                "text": "Ce dernier évoque les kwassa-kwassas, de petits canots également utilisés à Mayotte par les passeurs pour acheminer des migrants comoriens sur l’île française."
                            }
                        ]
                    }
                ],
