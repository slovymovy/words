                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699bb17d-696f-4d77-97ab-60774ce5d1be",
                                                "sense_id": "af682411-cf4f-3e34-bd32-ab8b66e9ef91",
                                                "text": "Utrata Stalingradu mogła zatem pociągnąć za sobą nieobliczalne konsekwencje dla całego systemu radzieckiej obrony"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "8c15d410-35dd-356d-9489-528597b0b0d7",
                                        "entry_id": "1c82b4f6-522a-3858-a590-f2a669e0c106",
                                        "glosses": [
                                            "reagujący w sposób nieoczekiwany"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c9d8212-e2a2-4e50-9e25-21afdfa2495f",
                                                "sense_id": "8c15d410-35dd-356d-9489-528597b0b0d7",
                                                "text": "Demoniczne występy sprawiły, że Reznora okrzyknięto najbardziej charyzmatyczną i nieobliczalną postacią sceny alternatywnej"
                                            }
                                        ],
