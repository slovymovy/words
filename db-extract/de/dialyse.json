                        "entry_id": "9c1d3995-7a6c-3bf0-9aa1-c9b1993cc8f3",
                        "glosses": [
                            "Verfahren, mit dem kleine Teilchen mittels einer Membran aus einer Lösung gefiltert werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d14508c8-604c-493b-97d1-eb9ef25e77e8",
                                "sense_id": "d20cde72-64e9-39ce-a30e-91d32f4a3fec",
                                "text": "Mit der Dialyse werden die Salze wieder herausgefiltert."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f74e7c98-4ceb-32f0-aa76-459769f7b7bb",
                        "entry_id": "9c1d3995-7a6c-3bf0-9aa1-c9b1993cc8f3",
                        "glosses": [
                            "Anwendung der Dialyse^([1]), vor allem zur Reinigung von Blut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c355e26-f5d6-416e-9789-3d58a1771bc4",
                                "sense_id": "f74e7c98-4ceb-32f0-aa76-459769f7b7bb",
                                "text": "Als Folge seines Medikamentenmissbrauchs muss Walter nun jede Woche zur Dialyse."
                            },
                            {
                                "example_id": "7a3ffd0a-0691-4880-b68b-80a5e38445ca",
                                "sense_id": "f74e7c98-4ceb-32f0-aa76-459769f7b7bb",
                                "text": "Bis zur Transplantation einer neuen Niere ist der Patient auf die Dialyse angewiesen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
