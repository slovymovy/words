                                                "example_id": "6ac551fd-4b1b-479b-8e01-de0cb7f31986",
                                                "sense_id": "4b91112f-1343-3fe0-818b-ca646b46a7c8",
                                                "text": "Van dat weerbarstige haar valt geen kapsel te maken."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33c3b8bd-dfcf-4f1c-9bb3-7554455aa829",
                        "source_entry_id": "281a418b-848c-38dd-92e8-dd09d0ce7265",
                        "source_sense_description": "refusing to move, especially in a forward direction",
                        "target_lang_word": "rétif",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rétif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                        "entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                                        "glosses": [
                                            "Qui s’arrête ou qui recule au lieu d’avancer. Se dit généralement au propre pour les chevaux et autres montures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c353176-1df9-45e7-a3e9-e5d936ab8b34",
                                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                                "text": "Un cheval rétif."
                                            },
                                            {
                                                "example_id": "1090e563-5d68-4880-823f-cffaa6b12e7d",
                                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                                "text": "Les mules sont ordinairement rétives et quinteuses."
                                            },
                                            {
                                                "example_id": "0cc4fed0-5de7-43b9-832a-8fc25e7d6a50",
                                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                                "text": "Joseph avait le regard rétif d’un cheval qui ne veut pas sauter l’obstacle."
                                            },
                                            {
                                                "example_id": "16f46ff4-31e4-4508-9f15-4b057a414430",
                                                "sense_id": "f824dd8f-4bc9-3d66-a242-30bd5a167665",
                                                "text": "Des chauffeurs en sueur donnaient les derniers coups de manivelle pour faire partir les moteurs rétifs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                        "entry_id": "e034da32-50e0-31d9-b4ac-f3cf8f9b8c19",
                                        "glosses": [
                                            "Qui est indocile, difficile à conduire, à persuader."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b39211-acb3-423b-9021-bb24593207e5",
                                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                                "text": "\"L'Éternel dit à Moïse : \"Je vois que ce peuple est un peuple rétif.\""
                                            },
                                            {
                                                "example_id": "40a94e2c-8ba9-4283-b80d-6989203baead",
                                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                                "text": "Il est rétif à la censure, à la louange."
                                            },
                                            {
                                                "example_id": "4f5d20f5-0fc3-4420-a7a3-b5ef4144297f",
                                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                                "text": "Ce soir-là, je pensais que cette mélodie agréable l’avait enfin décidée à pousser l’aventure jusqu’au bout. J’en remerciai voluptueusement feu M. Strauss, dont la musique voluptueuse fait fondre les vertus rétives et hâte la chute des Allemandes dans les bras des touristes désœuvrés."
                                            },
                                            {
                                                "example_id": "005d033d-7300-4904-9eef-7b3efc1bc411",
                                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                                "text": "Mais la pensée est rétive ; impossible de l’empêcher de courir où elle veut."
                                            },
                                            {
                                                "example_id": "76cb1e4a-f8e9-4115-be9b-165d8bedbfa5",
                                                "sense_id": "5595eaac-9400-345f-889a-260ae00a0c80",
                                                "text": "À toute exhibition, ma nature est rétive,\nSouffrant d'une modestie quasiment maladive,\nJe ne fais voir mes organes procréateurs\nÀ personne, excepté mes femmes et mes docteurs."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rétif",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "86f49b7c-1ddf-3c88-8e76-5799ac803c31",
                                        "entry_id": "74196826-9bb0-329d-9357-a86dfae63ed2",
                                        "glosses": [
                                            "Animal ou personne rétive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c294014d-008d-4b59-b95e-86ab1f26257c",
                                                "sense_id": "86f49b7c-1ddf-3c88-8e76-5799ac803c31",
                                                "text": "Il a beau faire le rétif, il faudra bien qu’il en passe par là."
                                            },
                                            {
                                                "example_id": "d52a1579-7f8e-4cae-8b28-925e3f1a0dd3",
                                                "sense_id": "86f49b7c-1ddf-3c88-8e76-5799ac803c31",
                                                "text": "Ce fut toujours un ombrageux et un rétif."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
