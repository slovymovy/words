                        "entry_id": "e63b93c1-897e-3857-9f4f-d7c94f6b354b",
                        "glosses": [
                            "Relatif à la ville de Mégare ou aux Mégariens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad54df14-f47a-4018-adc5-2db984277b3d",
                                "sense_id": "8316568d-ea49-3ed5-a84e-bf803c451e35",
                                "text": "Il y avait en outre un petit nombre d’exilés mégariens, que leur malheureuse situation avait amenés à combattre contre les Sélinontins, Mégariens d’origine."
                            },
                            {
                                "example_id": "b73f7717-9f60-4508-9849-8c0e062539ce",
                                "sense_id": "8316568d-ea49-3ed5-a84e-bf803c451e35",
                                "text": "En quittant Théognis pour Pindare, nous abandonnons les furieux combats de la noblesse, qu’elle soit mégarienne ou autre, pour nous élever vers les sommets de l’existence calme, orgueilleuse, pure de tout contact, que mena l’ancienne aristocratie hellénique."
                            }
                        ]
                    }
