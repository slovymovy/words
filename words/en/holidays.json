                {
                    "sense_id": "cc18b153-da44-3e5d-9e80-952aa74aec5e",
                    "sense_definition": "A period of time off work or school, especially if spent travelling away from home; a vacation.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vacation_time",
                    "name_type": "no",
                    "examples": [
                        {
