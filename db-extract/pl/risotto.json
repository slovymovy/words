                                "target_senses": [
                                    {
                                        "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                        "entry_id": "7e1ca8cb-5d72-3b10-bd6b-53abbffe5319",
                                        "glosses": [
                                            "An Italian savoury dish made with rice and other ingredients."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "efe0847a-6805-4653-bf8d-273215fba1bf",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "The secret to a creamy risotto is letting the rice absorb one cup of broth at a time."
                                            },
                                            {
                                                "example_id": "032dba73-8de7-40cd-ba36-b25867be0d21",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "Risotti are another Alvaro passion, and there’s a different special each week, as well as a legendary strawberry risotto in season."
                                            },
                                            {
                                                "example_id": "d70eac5c-27aa-4df4-bc75-9daa063c6bfa",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "Risotti are made with fat, short-grain rice; […]"
                                            },
                                            {
                                                "example_id": "ef5838b4-e399-4817-9cd7-480bd10fe4b1",
                                                "sense_id": "564d810e-e111-3da3-af7a-186dd7e1a2d7",
                                                "text": "This is one of the biggest chapters in this book because there are just so many vegetables that marry well with rice to make fantastic risotti!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e08aff2e-d607-36d1-a63e-5fc0f740b790",
                                        "entry_id": "7e1ca8cb-5d72-3b10-bd6b-53abbffe5319",
                                        "glosses": [
                                            "A similar dish made without rice."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2cb7498d-6639-420d-8f0b-a799ed9f1dd8",
                                                "sense_id": "e08aff2e-d607-36d1-a63e-5fc0f740b790",
                                                "text": "a pearl barley risotto"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "affcc3db-68e8-4ddd-8f23-1673c012d0c6",
                        "source_entry_id": "6dae0e85-4083-369c-88d4-ab5a11952a46",
                        "source_sense_id": "85f81d75-6104-3948-9e31-737722a7e16a",
                        "target_lang_word": "risotto",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "risotto",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "332c53a2-8e54-3a67-a58f-779e91585f87",
                                        "entry_id": "eb093be0-e63b-3633-8840-2d2c1534d448",
                                        "glosses": [
                                            "Plat italien à base de riz, revenu à l’huile d’olive, puis cuit au bouillon ajouté de façon progressive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "310847bb-e3b1-48e4-8856-291c373e91ac",
                                                "sense_id": "332c53a2-8e54-3a67-a58f-779e91585f87",
                                                "text": "Le risotto était superbe. Bébé me dit qu’elle n’avait encore jamais goûté de truffes blanches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4383e907-f5b6-41c5-a3f2-21bce815cae4",
                        "source_entry_id": "6dae0e85-4083-369c-88d4-ab5a11952a46",
                        "source_sense_id": "85f81d75-6104-3948-9e31-737722a7e16a",
                        "target_lang_word": "ризотто",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ризотто",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                        "entry_id": "48afdb30-cf77-3f3a-b54f-259eedd52ec1",
                                        "glosses": [
                                            "кулин. блюдо итальянской кухни из риса с различными компонентами"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "246131c9-7eba-489c-89cc-cefd3c037516",
                                                "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                                "text": "— .. здесь есть маленький кабачок, где подают прекрасную салями и делают ризотто с куриными печёнками, как нигде в Италии .."
                                            },
                                            {
                                                "example_id": "10b4d4a1-29e9-4b83-bb64-9ddd835eb380",
                                                "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                                "text": "— Тогда я знаю, что вы будете кушать… Ризотто по-милански с шампиньонами и раковыми шейками. // — Да ведь там рис? // — Рис. Форменный рис."
                                            },
                                            {
                                                "example_id": "aade4176-1435-4506-b8d1-c5dac1b6cb84",
                                                "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                                "text": "Эта милая женщина — мой прекрасный друг: у неё я отдыхал с её матерью, старой Рахилью; мы часами могли разговаривать о способах приготовления миланского ризотто."
                                            },
                                            {
                                                "example_id": "938da768-d16d-4837-8d58-a04802f9c754",
                                                "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                                "text": "Чаще всего они обретались в Италии .., вывезя оттуда несколько всегда милых итальянских обычаев и рецепт приготовления ризотто."
                                            },
                                            {
                                                "example_id": "2a6a7de2-4f6a-4270-98ba-dcc8b4c5fd45",
                                                "sense_id": "124a22ee-4fe5-37cb-9995-a45cd2986a5b",
                                                "text": "Она была итальянка, .. у неё была .. старуха мать, умевшая великолепно приготовлять миланское ризотто .."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
