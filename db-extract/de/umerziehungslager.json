                        "source_sense_id": "27dd4eb8-3640-3587-90e2-1ac851d4cb92",
                        "source_sense_description": "Gebäudekomplex, in dem Personen oft unter Zwang dazu gebracht werden sollen, ihr Verhalten zu ändern",
                        "target_lang_word": "reeducation camp",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reeducation camp",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a29fdf36-6301-3def-ba78-24bd0a63b93e",
                                        "entry_id": "53a6ee5e-722c-356d-9763-97562c3d00ac",
                                        "glosses": [
                                            "A camp or prison where ideological dissidents undergo reeducation or indoctrination."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "344ba282-b36a-412e-9dff-1446d9d85fc2",
                                                "sense_id": "a29fdf36-6301-3def-ba78-24bd0a63b93e",
                                                "text": "Although the Socialist Republic of Vietnam now encourages Vietnamese refugees to visit their native land, many refuse to do so, fearing that [...] they would be hustled off to reeducation camps to face starvation, over-work, and slow death."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce901450-d424-3a59-9033-6d49a3575f71",
                                        "entry_id": "53a6ee5e-722c-356d-9763-97562c3d00ac",
                                        "glosses": [
                                            "A camp where people are rehabilitated to health, especially after injury."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "847d4e50-4d86-4be2-8de7-1e44bdd5a872",
                                                "sense_id": "ce901450-d424-3a59-9033-6d49a3575f71",
                                                "text": "By degrees the seriously wounded were concentrated in this hospital, which remained open till 1919, and the discharged drafted to a Belgian reeducation camp in France."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
