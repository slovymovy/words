                "senses": [
                    {
                        "sense_id": "61a50206-8034-38b9-a829-e14c4d30aeb4",
                        "entry_id": "012fa883-a419-3203-a1df-77801f6f485b",
                        "glosses": [
                            "należący do Jana"
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "0f0de87b-d214-4232-b1d2-5097e26b1e2e",
                                "sense_id": "61a50206-8034-38b9-a829-e14c4d30aeb4",
                                "text": "Przypuszcza się, że rozdział ten pochodzi od kogoś z kręgu Janowego, ponieważ szereg elementów wskazuje na łączność z całą Ewangelią"
                            },
                            {
                                "example_id": "e7121bb8-2f4f-4abd-856f-5841f2c4cded",
                                "sense_id": "61a50206-8034-38b9-a829-e14c4d30aeb4",
                                "text": "Przed Janową chałupą rosną stare lipy."
                            },
                            {
                                "example_id": "63fbe0e1-cd7a-4177-904c-0d776f9c6f6c",
                                "sense_id": "61a50206-8034-38b9-a829-e14c4d30aeb4",
                                "text": "Sąsiadował z Maciejową zagrodą z jednej strony i z Janowym polem z drugiej."
                            },
                            {
                                "example_id": "f3546603-4727-48f5-85f0-68f71ffebd44",
                                "sense_id": "61a50206-8034-38b9-a829-e14c4d30aeb4",
                                "text": "Janowi synowie wyrośli na dorodnych mężczyzn."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
