                                        "sense_id": "13b8b38f-2f37-39ef-9bc5-620c87b5984d",
                                        "entry_id": "f1ab6cc8-6ac3-3cd8-9635-233eac709b6f",
                                        "glosses": [
                                            "die Wanderung einer Seele durch verschiedene (menschliche oder tierische) Körper in aufeinanderfolgenden Leben"
                                        ],
                                        "tags": [
                                            "meist Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a600661-873f-4721-8363-54bb1f2c7996",
                                                "sense_id": "13b8b38f-2f37-39ef-9bc5-620c87b5984d",
                                                "text": "„Daß der bestimmte Zeitraum, welchen die Aegypter angaben, schlechterdings keinen Grund hatte und eine Neuerung der ursprünglichen Lehre von der Metempsychose war, erhellt daraus, daß der Zeitraum von der Auflösung des menschlichen Körpers an, bis dahin, da dem Geiste die Gnade gewährt wird, überhaupt irgend einen sterblichen Körper wieder beleben zu dürfen nicht bestimmt ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
