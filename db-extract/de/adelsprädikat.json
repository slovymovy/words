                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "d1bd3bbf-8bde-456f-8e4d-54ec0d4cbc07",
                                "sense_id": "fb509565-dffe-3def-9595-e6559edcc0e8",
                                "text": "Der gelernte Schwiegersohn, der einst im Nebenfach Betriebsnudel mit Schwerpunkt Tourismus studierte und ein Adelsprädikat sein Eigen nennt, ist am Ziel seiner schlaflosen Träume angelangt: Berlin klappt wieder die Bürgersteige runter, kurz BKWDBR!"
                            }
                        ]
                    },
                    {
                        "sense_id": "506eac2c-c7cd-3b83-ae16-fb8c60a04de7",
                        "entry_id": "3bde9703-154c-3e01-9baa-16f38b762eff",
                        "glosses": [
                            "mark of excellence"
                        ],
                        "tags": [
                            "broadly",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "e3d3634b-977c-4037-aff4-24a3d5039094",
                                "sense_id": "506eac2c-c7cd-3b83-ae16-fb8c60a04de7",
                                "text": "Bauhaus und die Teilnahme an der Ausstellung „Entartete Kunst“ – zwei Adelsprädikate und für Famulla, Schütze und Kuhr junior eine einmalige Chance, die Kassen klingeln zu lassen."
                            }
                        ]
                    }
