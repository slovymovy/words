                                        "entry_id": "b3333aca-991a-36c4-b2a3-7bcf837db476",
                                        "glosses": [
                                            "A falling or letting fall in drops; act of dripping."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
