                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4d361753-ee53-4960-ac87-c92e050b9ffa",
                        "entry_id": "c98c9d5b-9185-3722-b8ba-8e52d1a50dc9",
                        "tags": [
                            "plural"
                        ],
                        "form": "cubilots"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                        "entry_id": "c98c9d5b-9185-3722-b8ba-8e52d1a50dc9",
                        "glosses": [
                            "Four à cuve cylindrique portant plusieurs tuyères sur les côtés pour y insuffler l’air nécessaire à la combustion et permettre la fusion rapide de la fonte."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d124d44-2ab7-47dd-8314-626a40226fc9",
                                "sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                                "text": "Dans quelques cas assez rares, et pour de grosses pièces seulement, on fond dans un petit cubilot ou dans une calebasse, on fait des moules en sable d'étuve ou en sable vert un peu séché."
                            },
                            {
                                "example_id": "ef52b05a-fb32-4ad2-889e-73ba77c490de",
                                "sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                                "text": "Il y a lieu de remarquer que le coke lavé peut, pour certaines provenances, apporter dans le haut-fourneau ou dans le cubilot des fondeurs, plus de soufre et de phosphore que des cokes même très cendreux, des cokeries minières françaises."
                            },
                            {
                                "example_id": "3e991c78-dd89-41a1-885a-266ba6d40291",
                                "sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                                "text": "Le poêle grondait aussi fort qu’un cubilot."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "60bc117e-5d60-409f-9ddc-841c0e023e67",
                        "source_entry_id": "c98c9d5b-9185-3722-b8ba-8e52d1a50dc9",
                        "source_sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                        "target_lang_word": "Kupolofen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "e37ef537-87b2-48c7-aec8-f1af45c81018",
                        "source_entry_id": "c98c9d5b-9185-3722-b8ba-8e52d1a50dc9",
                        "source_sense_id": "ea43b1fa-fa24-39f7-89c2-7d256232c799",
                        "target_lang_word": "cupola",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cupola",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f10f18-8fb9-34f5-b9ea-d593d3647462",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A dome-shaped ornamental structure located on top of a larger roof or dome."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61de0ae1-98c6-4142-a138-a4dd4b3e61e8",
                                                "sense_id": "c9f10f18-8fb9-34f5-b9ea-d593d3647462",
                                                "text": "the light falling dimly through the foggy cupola."
                                            },
                                            {
                                                "example_id": "c04962bd-cd33-443f-b8ee-f79ded7c7a75",
                                                "sense_id": "c9f10f18-8fb9-34f5-b9ea-d593d3647462",
                                                "text": "The stations on the City & South London were small but pretty, with cupolas to accommodate the winding gear of the small and claustrophobic hydraulic lifts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97cc9598-d250-34a4-b38e-544b30e5bce0",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A small turret, usually on a hatch of an armoured fighting vehicle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5eeae3a8-b6fa-36ef-ab68-bc47ab62ee93",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "An upward-projecting mass of plutonic rock extending from a larger batholith."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a3175b26-d72f-3f70-8716-8ad36b8471b3",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A solid formed by joining two polygons, one (the base) with twice as many edges as the other, by an alternating band of isosceles triangles and rectangles."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7824ca7d-bc17-3a42-aa46-f320f7a98018",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A type of furnace used for smelting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a412891f-8696-42fd-a506-a2bd40af4b38",
                                                "sense_id": "7824ca7d-bc17-3a42-aa46-f320f7a98018",
                                                "text": "The cupola has a small cylindrical chimney-like bore that is lined with a refractory material."
                                            },
                                            {
                                                "example_id": "8b6fca84-acae-4ba9-b11a-3895efe95327",
                                                "sense_id": "7824ca7d-bc17-3a42-aa46-f320f7a98018",
                                                "text": "Cast iron produced in a cupola possesses the following advantages : The cost of melting is low. The control of chemical composition is better. Temperature control is easier. Molten metals can be tapped from the cupola at regular intervals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25e1ef31-c987-3548-80db-b892e49dade6",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A small cap over a structure that is shaped like a dome or inverted cup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70cb880d-40e3-44f1-8585-ab6116f6d0c9",
                                                "sense_id": "25e1ef31-c987-3548-80db-b892e49dade6",
                                                "text": "the posterior cupola of the cartilaginous nasal capsule"
                                            },
                                            {
                                                "example_id": "02590b3d-304e-4b2a-a5b6-f315bd54d8ef",
                                                "sense_id": "25e1ef31-c987-3548-80db-b892e49dade6",
                                                "text": "From each anterior cupola there projects forwards the processus prenasalis lateralis inferior."
                                            },
                                            {
                                                "example_id": "6fc80ec0-2d76-45aa-a6ec-47257c1a4347",
                                                "sense_id": "25e1ef31-c987-3548-80db-b892e49dade6",
                                                "text": "The cupola of the lung is mostly medial and posterior to the vein as it begins to course deeper into the thorax (Fig. 5.7)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2a1621b5-c462-3585-a98d-a9415b9a747b",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "a small viewing window in the top of the caboose for looking over the train, or the part of the caboose where one looks through this window."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "563e139e-a304-3a51-b0f3-1399d9195d04",
                                        "entry_id": "2b4553f2-52df-3145-9a85-8fe7266ad720",
                                        "glosses": [
                                            "A body of members of the Sicilian Mafia who make decisions and settle disputes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
