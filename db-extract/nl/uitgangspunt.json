                "senses": [
                    {
                        "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                        "entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                        "glosses": [
                            "de aannames en veronderstellingen waar men van uitgaat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "879fd1c0-7726-4337-9673-b78e0f7b2256",
                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                "text": "De dualiteit van golf en deeltje is het uitgangspunt van de kwantummechanica."
                            },
                            {
                                "example_id": "11bc5ccb-b45c-45d3-a0a1-a545917c1f74",
                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                "text": "Waar het in het advies aan ontbreekt, is een inhoudelijke beschouwing ten aanzien van ouderen, hun zorgvraag alsmede de zorgverlening. ‘Betaalbaarheid’ en ‘organiseerbaarheid’ zijn de uitgangspunten."
                            },
                            {
                                "example_id": "bbf2309a-14e3-45a5-94a9-0568c0259485",
                                "sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                                "text": "Dat was in 1905. Nu was het 1940 en was je terug bij het uitgangspunt. Het was alsof je de Kleivebron opnieuw bouwde."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a888d4a-3388-4066-97a9-8e6d65a4d46e",
                        "source_entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                        "source_sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                        "source_sense_description": "de aannames en veronderstellingen waar men van uitgaat",
                        "target_lang_word": "Ausgangspunkt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Ausgangspunkt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                        "entry_id": "2532a89f-ce50-30f3-a654-ad18c351fa46",
                                        "glosses": [
                                            "Beginn, Ursprung von etwas"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "163127e4-90df-4d09-ae56-8b176c38ace1",
                                                "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                                "text": "Das Attentat von Sarajevo markierte den Ausgangspunkt des Ersten Weltkriegs."
                                            },
                                            {
                                                "example_id": "dbec2def-3577-4277-92ad-9b484ee78489",
                                                "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                                "text": "„Die Fundamentalgleichung der Thermodynamik (auch Gibbssche Fundamentalgleichung genannt) ist Ausgangspunkt der formalen Thermodynamik.“"
                                            },
                                            {
                                                "example_id": "7ef35653-b0cc-4924-bcd7-835b05d53c6a",
                                                "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                                "text": "„Bei einem Ausgangspunkt verharrt man nicht.“"
                                            },
                                            {
                                                "example_id": "eab9f8cb-5318-4dc7-b7cd-202c17e105ed",
                                                "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                                "text": "„Der Hängegleiter, so die amtliche Bezeichnung, ist zu einem ausgereiften Luftfahrtgerät und selbst wieder zum Ausgangspunkt einer neuen Sparte der Luftfahrt geworden.“"
                                            },
                                            {
                                                "example_id": "2646ff5a-1aec-4961-990e-bc12a8412c70",
                                                "sense_id": "8f87d24c-a94e-3975-a843-c2daa2de2dd6",
                                                "text": "„Der Vertrag war der Ausgangspunkt für die deutsche Kolonialherrschaft in Kamerun.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "327abc1d-7d90-324f-b60b-b7b0f6ded925",
                                        "entry_id": "2532a89f-ce50-30f3-a654-ad18c351fa46",
                                        "glosses": [
                                            "Ort, an dem man eine Reise oder Ähnliches beginnt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64a4221e-6819-422d-af5a-4453944c8ea1",
                                                "sense_id": "327abc1d-7d90-324f-b60b-b7b0f6ded925",
                                                "text": "Bei der Wanderung durch den Wald hatten wir Probleme, unseren Ausgangspunkt wiederzufinden."
                                            },
                                            {
                                                "example_id": "2d4df2e0-ea58-4bd4-b531-d9642c568f7a",
                                                "sense_id": "327abc1d-7d90-324f-b60b-b7b0f6ded925",
                                                "text": "„Und schon waren sie wieder am Ausgangspunkt ihrer kleinen Wanderung angekommen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "41cc2532-034d-4e64-8e17-1f10da1299b6",
                        "source_entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                        "source_sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                        "source_sense_description": "de aannames en veronderstellingen waar men van uitgaat",
                        "target_lang_word": "point of departure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point of departure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db49b0cb-3e95-35fe-9fb1-8e9148c23d19",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "Synonym of starting point."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94cac7cd-ec64-4e2d-b562-f9315a1b5773",
                                                "sense_id": "db49b0cb-3e95-35fe-9fb1-8e9148c23d19",
                                                "text": "[…] the point of departure is Hong Kong International Airport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "of abstract processes that can be compared to a voyage: initial circumstances. Frequent collocations include, but are not limited to"
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "334a79d0-319d-4c87-8c04-706fc249643a",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "[…] so “going back to the way things were” is not a useful point of departure."
                                            },
                                            {
                                                "example_id": "4016349e-3768-4d5a-ad4b-8557887843a0",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "Its point of departure is the view that conceptions of agency are […]"
                                            },
                                            {
                                                "example_id": "a894cede-6e67-43fd-9f10-05f1dc6a4ab5",
                                                "sense_id": "38bdb741-6ec8-39c4-87e8-2e03c7ef993b",
                                                "text": "[…] choosing to be childfree was a huge point of departure from my community […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf61030e-93f4-32ee-ad89-af58d8d72880",
                                        "entry_id": "1877ea37-086d-317d-b3c2-0f58be1857f8",
                                        "glosses": [
                                            "a dosage level at which additional administration of an agent significantly loses its efficacy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02765568-4caf-49d8-88bd-b6d3b47ca7d4",
                                                "sense_id": "cf61030e-93f4-32ee-ad89-af58d8d72880",
                                                "text": "In toxicology, point of departure (POD) is defined as the point on a toxicological dose-response curve […] generally corresponding to an estimated low effect level or no effect level."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c35061fd-3ff5-4ae8-a39a-74e122cf83b2",
                        "source_entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                        "source_sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                        "source_sense_description": "de aannames en veronderstellingen waar men van uitgaat",
                        "target_lang_word": "starting point",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "starting point",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9977192b-3f52-3c88-a3f2-02576a095675",
                                        "entry_id": "cb81e757-177d-3980-9f36-99826926668e",
                                        "glosses": [
                                            "The place where a journey starts."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65f00c5b-952a-4f4e-bb57-fe64734a46f2",
                                                "sense_id": "9977192b-3f52-3c88-a3f2-02576a095675",
                                                "text": "King's Cross Station proved to be the starting point of a journey that took me around the world."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                        "entry_id": "cb81e757-177d-3980-9f36-99826926668e",
                                        "glosses": [
                                            "The first steps when commencing an activity."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62e5b61b-2e2e-4a41-87d0-57ba531770a3",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "Examining the data and facts will be a good starting point."
                                            },
                                            {
                                                "example_id": "0a1dde27-f377-490a-93e3-643fa6897081",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "What Loehr called the Middle Western Chou is the probable starting point, that is, during the mid-eleventh century B.C.⁵⁸ when a breakdown in the old order of Phase I can be documented. For instance, a yu found at T'un-hsi, Anhui, (Plate 19) is decorated with intertwining birds both on the belly and lid and exemplifies this conversion."
                                            },
                                            {
                                                "example_id": "30201199-11b9-4ae8-8fd9-d3c4281c20bd",
                                                "sense_id": "59138b7a-ce66-3f6f-a995-b9f12ba83556",
                                                "text": "Creating a complete map of the human connectome would therefore be a monumental milestone but not the end of the journey to understanding how our brains work. The achievement will transform neuroscience and serve as the starting point for asking questions we could not otherwise have answered, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "254971a6-f7c2-41ca-a7c9-0bf1cdc701b6",
                        "source_entry_id": "09b194d8-f4b0-3fab-9363-b2d95d9a0167",
                        "source_sense_id": "a7ecf586-2cc1-33cd-8a8c-dfd14cce459a",
                        "source_sense_description": "de aannames en veronderstellingen waar men van uitgaat",
                        "target_lang_word": "point de départ",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "point de départ",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "[Sens spatial] Lieu d'où l'on est parti."
                                        ],
                                        "tags": [
                                            "literally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30c0f6b3-a553-4163-883b-d681ab9b3fc2",
                                                "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                                "text": "Enfin il revint à son point de départ et examina une dernière fois si tout correspondait bien : la traînée d'herbes sèches à la traînée de poudre, et la traînée de poudre du sol avec la poudre contenue dans les anfractuosités du mur."
                                            },
                                            {
                                                "example_id": "9c46820e-731d-4561-96a3-29876d33806e",
                                                "sense_id": "2aaa20ee-65be-3f57-9979-be063070bf01",
                                                "text": "Mon père dit toujours que mon sens de l’orientation en forêt est troublant – tout comme mon aptitude à retrouver mon chemin jusqu'au point de départ – mais je ne m'y fiais pas à cet instant. Je m'arrêtai sous un arbre gigantesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f467fca9-7b17-3313-b2bb-0490a09713b4",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "[Sens temporel] Point d’origine dans le temps."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                        "entry_id": "e39761d8-2e55-356b-afdd-612cfdb6d7d1",
                                        "glosses": [
                                            "Début ou commencement d’une action."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3bd0fa23-abf9-4f41-8bc1-d53669312ce1",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "Prenant pour point de départ notre point de vue, c’est-à-dire la Terre où nous sommes, nous pouvons de là nous diriger vers les autres planètes de notre système."
                                            },
                                            {
                                                "example_id": "ab4a83b3-38d0-40ee-8380-e888d9e742f8",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "En 1888, Baur prenait un brevet pour la fabrication de musc artificiel, en prenant comme point de départ un composé appelé toluène, qui est extrait du goudron de houille."
                                            },
                                            {
                                                "example_id": "6f6fb6a2-15d8-45c2-823d-757e32753b2e",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "Tandis que le Midi, qui a, de tout temps, été un foyer de vie intellectuelle très intense et où les juifs cultivaient toutes les sciences, a été le point de départ d’une agitation antiphilosophique et antiscientifique."
                                            },
                                            {
                                                "example_id": "af71d76b-5f7b-4530-a6cd-84f5229ed613",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "La doctrine mercantiliste, sur les relations entre économie et politique des nations, a pour point de départ, pour principe la formule célèbre : « L’argent est le nerf de la guerre. »"
                                            },
                                            {
                                                "example_id": "f39aec43-37fd-433a-a4f3-db9b817b2448",
                                                "sense_id": "5340e016-9aaa-3f54-8f87-f6f120bcd3fb",
                                                "text": "La conquête facile de la Mandchourie et de la Corée constituait le point de départ de la grande aventure qui devait s'illustrer par l'effondrement des États-Unis d'Amérique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7aeb8b46-2f70-4faa-865f-aedb25dc9962",
