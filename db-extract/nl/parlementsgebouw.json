                        "sense_id": "e5d7799d-25e9-3521-9a7a-abd228b6871f",
                        "entry_id": "6f7ad4e1-99a8-308c-8b7f-58be11e1d92d",
                        "glosses": [
                            "bouwwerk waarin de volksvertegenwoordiging vergadert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3fddd95-af82-4628-aad0-d600eecb6e12",
                                "sense_id": "e5d7799d-25e9-3521-9a7a-abd228b6871f",
                                "text": "De afgelopen dagen gingen bijna zestig gebouwen in vlammen op, waaronder veel winkels en een politiepost. Ook in het parlementsgebouw werden brand gesticht. Vooral in de Chinese buurt werden winkels geplunderd."
                            },
                            {
                                "example_id": "49f51960-f9b1-45bc-b527-85d171d51949",
                                "sense_id": "e5d7799d-25e9-3521-9a7a-abd228b6871f",
                                "text": "De vicepresident kwam deze week in opspraak omdat lijfwachten van hem een journalist mishandelden. Jason Pinas van de krant De Ware Tijd maakte bij het parlementsgebouw foto's van Brunswijk toen die in zijn auto stapte. Volgens Brunswijk drong Pinas tot in de auto door. Hij was daar niet van gediend en er ontstond onenigheid."
                            }
                        ]
                    }
