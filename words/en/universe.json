{
    "word_family": [
        "universal",
        "universality",
        "universalize",
        "universally"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8115397f-6622-3372-abd2-47c5f4b5e71b",
                    "sense_definition": "The sum of everything that exists, including all matter, energy, space, and time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cosmos_physical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Astronomers use powerful telescopes to study the expansion of the <w>universe</w>.",
                            "target_lang_translations": {
                                "ru": "Астрономы используют мощные телескопы для изучения расширения <w>Вселенной</w>.",
                                "zh": "天文学家利用强大的望远镜来研究<w>宇宙</w>的膨胀。"
                            }
                        },
                        {
                            "text": "Do you believe the <w>universe</w> was created by a specific event like the Big Bang?",
                            "target_lang_translations": {
                                "ru": "Вы верите, что <w>Вселенная</w> была создана в результате конкретного события, такого как Большой взрыв?",
                                "zh": "你相信<w>宇宙</w>是由像大爆炸那样的特定事件创造的吗？"
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmos"
                    ],
                    "common_phrases": [
                        "expanding universe",
                        "origin of the universe",
                        "center of the universe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Совокупность всего существующего, включая всю материю, энергию, пространство и время.",
                        "zh": "指包含所有物质、能量、空间和时间的万事万物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вселенная",
                                "target_lang_sense_clarification": "космос, пространство"
                            },
                            {
                                "target_lang_word": "мироздание",
                                "target_lang_sense_clarification": "мир как единое целое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙",
                                "target_lang_sense_clarification": "指物理空间和万物"
                            },
                            {
                                "target_lang_word": "天地",
                                "target_lang_sense_clarification": "指自然界或世界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b3829421-f6c0-38ff-af9c-055ef8e0a39c",
                    "sense_definition": "An imaginary world or collection of stories where specific characters, settings, and events exist.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fictional_setting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The characters in this cinematic <w>universe</w> often cross over into each other's movies.",
                            "target_lang_translations": {
                                "ru": "Персонажи этой кинематографической <w>вселенной</w> часто пересекаются в фильмах друг друга.",
                                "zh": "这个电影<w>宇宙</w>中的角色经常出现在彼此的电影里。"
                            }
                        },
                        {
                            "text": "The author created a rich fantasy <w>universe</w> filled with magic and mythical creatures.",
                            "target_lang_translations": {
                                "ru": "Автор создал богатую фэнтезийную <w>вселенную</w>, наполненную магией и мифическими существами.",
                                "zh": "作者创造了一个充满魔法和神话生物的丰富奇幻<w>世界</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cinematic universe",
                        "fictional universe",
                        "comic book universe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вымышленный мир или совокупность историй, где существуют определенные персонажи, места и события.",
                        "zh": "指虚构的故事世界，包含特定的角色、背景和事件。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вселенная",
                                "target_lang_sense_clarification": "вымышленный мир франшизы (напр. Marvel)"
                            },
                            {
                                "target_lang_word": "мир",
                                "target_lang_sense_clarification": "вымышленная реальность"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙",
                                "target_lang_sense_clarification": "指虚构的系列世界观"
                            },
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "指虚构的背景设定"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5b57db59-1774-38dd-9a89-16d73b642072",
                    "sense_definition": "A person's individual sphere of life, experience, interest, or influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "personal_sphere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "When she lost her job, she felt like her entire <w>universe</w> was falling apart.",
                            "target_lang_translations": {
                                "ru": "Когда она потеряла работу, она почувствовала, что рушится весь её <w>мир</w>.",
                                "zh": "当她失业时，她感觉整个<w>世界</w>都要崩塌了。"
                            }
                        },
                        {
                            "text": "For a newborn baby, the mother is the center of the <w>universe</w>.",
                            "target_lang_translations": {
                                "ru": "Для новорожденного ребенка мать — это центр <w>вселенной</w>.",
                                "zh": "对于新生儿来说，母亲就是他们的<w>世界</w>中心。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "center of my universe",
                        "rock someone's universe"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used hyperbolically"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Индивидуальная сфера жизни, опыта, интересов или влияния человека.",
                        "zh": "指个人生活、经验、兴趣或影响力的范围。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мир",
                                "target_lang_sense_clarification": "внутренний мир или окружение"
                            },
                            {
                                "target_lang_word": "вселенная",
                                "target_lang_sense_clarification": "центр чьей-либо жизни (метафорически)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "世界",
                                "target_lang_sense_clarification": "指个人的生活圈子"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0d576a0f-a398-36e2-8714-e44676309276",
                    "sense_definition": "The entire group, set, or population of things being considered or studied.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "logic_stats",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this <w>universe</w> of possibilities, there is only one feasible option for us.",
                            "target_lang_translations": {
                                "ru": "В этом <w>множестве</w> возможностей для нас есть только один приемлемый вариант.",
                                "zh": "在这一系列的可能性中，我们只有一个可行的选择。"
                            }
                        },
                        {
                            "text": "The survey results may not represent the entire <w>universe</w> of voters accurately.",
                            "target_lang_translations": {
                                "ru": "Результаты опроса могут неточно отражать всю <w>генеральную совокупность</w> избирателей.",
                                "zh": "调查结果可能无法准确代表选民的<w>总体</w>情况。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "universe of discourse",
                        "statistical universe"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical: statistics or logic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Полная группа, набор или совокупность рассматриваемых или изучаемых объектов.",
                        "zh": "指被研究或考虑的全部对象集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "генеральная совокупность",
                                "target_lang_sense_clarification": "статистика"
                            },
                            {
                                "target_lang_word": "универсум",
                                "target_lang_sense_clarification": "логика"
                            },
                            {
                                "target_lang_word": "множество",
                                "target_lang_sense_clarification": "общая совокупность вариантов"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "总体",
                                "target_lang_sense_clarification": "统计学用语"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "指考虑的全部可能性"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "3de5782e-29cf-32ff-a62f-8c6f4e161063",
                    "sense_definition": "The specific cosmos in which we live, treated as a unique entity.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cosmos_physical",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Powerful telescopes look far back into the distant reaches of the <w>Universe</w>.",
                            "target_lang_translations": {
                                "ru": "Мощные телескопы заглядывают далеко в отдаленные уголки <w>Вселенной</w>.",
                                "zh": "强大的望远镜回望向<w>宇宙</w>深处。"
                            }
                        },
                        {
                            "text": "Many scientists dedicate their lives to understanding the laws that govern the <w>Universe</w>.",
                            "target_lang_translations": {
                                "ru": "Многие ученые посвящают свою жизнь пониманию законов, управляющих <w>Вселенной</w>.",
                                "zh": "许多科学家毕生致力于理解支配<w>宇宙</w>的规律。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cosmos"
                    ],
                    "common_phrases": [
                        "history of the Universe",
                        "age of the Universe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Космос, в котором мы живем, рассматриваемый как уникальная сущность.",
                        "zh": "指我们所处的特定宇宙，被视为一个独特的实体。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вселенная",
                                "target_lang_sense_clarification": "астрономическое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "宇宙",
                                "target_lang_sense_clarification": "天文学专有名词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}