                        "entry_id": "f7b3a672-470b-3b5d-a4d1-5435a1761430",
                        "glosses": [
                            "Prestataire de services, par distinction avec un fournisseur de pièces ou de matière."
                        ],
                        "tags": [
                            "Industrie"
                        ],
                        "examples": [
                            {
                                "example_id": "ace0bd12-adc6-424a-b816-d2b345def846",
                                "sense_id": "59016d41-9857-37ee-a569-48838dce15cf",
                                "text": "Dienstleister (oder Dienstleistungsunternehmen) sind Unternehmen des Tertiärsektors und eine Betriebsform, durch die eine oder mehrere Dienstleistungen erbracht werden.",
                                "translation": "Les prestataires de services (ou entreprises prestataires de service) sont des entreprises du secteur tertiaire et un type d’exploitation, par lequel un ou plusieurs services sont accomplis."
                            }
                        ]
                    }
