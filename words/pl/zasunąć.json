                            "comment": "potoczne"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "сказать что-то неожиданное, неуместное или поразительное"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ляпнуть",
                                "target_lang_sense_clarification": "сказать не подумав или не к месту"
                            },
                            {
                                "target_lang_word": "выдать",
                                "target_lang_sense_clarification": "сказать неожиданную фразу, шутку"
                            },
                            {
                                "target_lang_word": "сморозить",
                                "target_lang_sense_clarification": "сказать глупость или странность"
                            }
                        ]
                    }
                }
            ]
