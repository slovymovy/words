                "senses": [
                    {
                        "sense_id": "57da6676-0428-3e09-94ed-b1229df65d16",
                        "entry_id": "d4071e11-429e-359b-9849-71a627617ece",
                        "glosses": [
                            "Chef des portiers du sérail, exécuteur des firmans de mort."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46c3afca-dc12-43aa-aee7-f6e9b4726cb0",
                                "sense_id": "57da6676-0428-3e09-94ed-b1229df65d16",
                                "text": "Il y a dans le sérail environ cinq cents capigis ou portiers partagés en deux troupes: l'une de trois cents, sous un chef appellé capigi-bassa, qui a de provision trois ducats par jour; & l'autre de deux cents appellés cuccicapigi, de leur chef cuccicapigi-bassi, qui a deux ducats d'appointement."
                            },
                            {
                                "example_id": "0e5cecf7-2db7-4cc0-a4e9-246760a17e7b",
                                "sense_id": "57da6676-0428-3e09-94ed-b1229df65d16",
                                "text": "Les capigis-bachis sont subordonnés au capi-aga ou capou-agassi, & sont au nombre de douze; leur fonction est de monter la garde deux à deux à la troisième porte du sérail, avec une brigade de simples capigis ou portiers."
                            }
                        ]
                    }
