                                "sense_id": "ac50567a-8199-348d-9acc-5e3b37b8346e",
                                "text": "De teelt van tarwe is een belangrijke industrie in dit gebied.",
                                "translation": "The cultivation of wheat is a major industry in this area.",
                                "english": "The cultivation of wheat is a major industry in this area."
                            },
                            {
                                "example_id": "375cd9f4-b80f-492b-955c-27b72e642247",
                                "sense_id": "ac50567a-8199-348d-9acc-5e3b37b8346e",
                                "text": "Door klimaatverandering kan de teelt van bepaalde gewassen moeilijker worden.",
                                "translation": "Due to climate change, the culture of certain crops may become more difficult.",
                                "english": "Due to climate change, the culture of certain crops may become more difficult."
                            }
