                        "glosses": [
                            "The condition of being precious."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "37412350-fa7b-43ec-abb8-f5ad5d95a564",
                                "sense_id": "acf8714a-666c-3a29-bf17-80adba603eb5",
                                "text": "In a fascinating growth, when the preciousness of the new fades with no one noticing, the room had changed, evolving into something else."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c56e1e6e-492c-4241-a324-92efa7eeb4d2",
                        "source_entry_id": "a68fea85-591b-3a42-a439-4cdc2e914bcd",
                        "source_sense_id": "acf8714a-666c-3a29-bf17-80adba603eb5",
                        "source_sense_description": "the condition of being precious",
                        "target_lang_word": "kostbaarheid",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kostbaarheid",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d0e0baca-e589-3c5c-99a6-7e1b1191155e",
                                        "entry_id": "c670d576-2813-3db9-9efd-8157d7e386d8",
                                        "glosses": [
                                            "vooral gebruikt als meervoud: voorwerpen die veel waard zijn, voorwerpen die veel kosten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f93cfccc-d789-4226-8188-eaffd493e9c5",
                                                "sense_id": "d0e0baca-e589-3c5c-99a6-7e1b1191155e",
                                                "text": "Ruim 100 rechercheurs, speurders van de opsporingsdienst van de Belastingen (FIOD) en militairen, gespecialiseerd in het vinden van verborgen ruimtes, vielen gisteren binnen op negen locaties in Brabant. Het ging om woningen en bedrijven in onder meer Kaatsheuvel, Rijen, Waalwijk, Almkerk en Aalst. Het doel was het verzamelen van bewijs tegen vier verdachten tegen wie een onderzoek loopt. Daarbij moesten volgens de politie zoveel mogelijk kostbaarheden in beslag genomen worden omdat die mogelijk verkregen waren met crimineel geld."
                                            },
                                            {
                                                "example_id": "4be38179-b717-42a2-8a7d-c175297e80ea",
                                                "sense_id": "d0e0baca-e589-3c5c-99a6-7e1b1191155e",
                                                "text": "Haar ideale oefening draaide ze zondag niet. Die begint met een risicovolle arabier flikflak met hele schroef, van de springplank op de balk van 10 cm breed, gevolgd door nog eens twee flikflaks. Een plus van 0,4 is het gevolg. Dan volgt haar drievoudige pirouette, nog zo'n kostbaarheid. Wevers: 'Die kan niemand in de wereld.'"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "20bfe978-81f3-4a3a-9262-d11a001f9514",
                        "source_entry_id": "a68fea85-591b-3a42-a439-4cdc2e914bcd",
                        "source_sense_id": "acf8714a-666c-3a29-bf17-80adba603eb5",
                        "source_sense_description": "the condition of being precious",
                        "target_lang_word": "préciosité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "préciosité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1f54a347-eac8-38ab-b559-b16941f85834",
                                        "entry_id": "dac822c6-064d-37de-896b-b0a582bae599",
                                        "glosses": [
                                            "Attitude en vogue au XVIIᵉ siècle et consistant à faire preuve d’un grand soin dans ses manières et son langage selon certaines règles pointues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec885933-d497-450d-9e90-72669d583394",
                                                "sense_id": "1f54a347-eac8-38ab-b559-b16941f85834",
                                                "text": "Molière ne fut pas le seul à critiquer la dérive de la préciosité."
                                            },
                                            {
                                                "example_id": "929dc100-4f8f-44cb-9beb-847e6f944f2d",
                                                "sense_id": "1f54a347-eac8-38ab-b559-b16941f85834",
                                                "text": "— Il donne dans la préciosité, ce n’est pas un mauvais garçon, dit Brichot. — Je n’ai pas dit que c’était un mauvais garçon, j’ai dit que c’était un imbécile », riposta avec aigreur M. Verdurin."
                                            },
                                            {
                                                "example_id": "9b2d805c-55e1-4c3a-b426-4b4178fd2e14",
                                                "sense_id": "1f54a347-eac8-38ab-b559-b16941f85834",
                                                "text": "La nouvelle façon de sentir du monde baroque … commandait un nouveau langage. Ce langage fut la préciosité, à mi-chemin entre le culte du néologisme et la révérence envers les archaïsmes …. La préciosité, limitée à vrai dire à certains salons …, est un véritable jeu de société au centre duquel on retrouve le langage. Ce jeu linguistique est authentiquement poétique, dans la mesure où il est créateur non seulement de façons de dire, mais aussi d’œuvres littéraires collectives, où le langage et son usage deviennent presque un personnage en soi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf682bbf-e889-389a-b4ed-4e52cfbb75fb",
                                        "entry_id": "dac822c6-064d-37de-896b-b0a582bae599",
                                        "glosses": [
                                            "Délicatesse extrême, voire excessive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6243af2-2f1c-4e00-8b6d-684e4a30de13",
                                                "sense_id": "bf682bbf-e889-389a-b4ed-4e52cfbb75fb",
                                                "text": "Il s’habillait avec recherche sinon avec préciosité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2d147f8-ab9f-3797-b102-cdd77b11ad3a",
                                        "entry_id": "dac822c6-064d-37de-896b-b0a582bae599",
                                        "glosses": [
                                            "Qualité de ce qui est précieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "78d3eb23-7efe-4232-a880-19baf37f12c5",
                                                "sense_id": "a2d147f8-ab9f-3797-b102-cdd77b11ad3a",
                                                "text": "Ce qui peut être perçu comme trop fastidieux ou risqué pour ce qui est de protéger un « informateur de bas niveau » dont la préciosité n’a pas encore été évaluée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89584788-ba21-4c38-9327-467fefc71662",
                        "source_entry_id": "a68fea85-591b-3a42-a439-4cdc2e914bcd",
                        "source_sense_id": "acf8714a-666c-3a29-bf17-80adba603eb5",
