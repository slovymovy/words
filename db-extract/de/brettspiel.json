                                        "glosses": [
                                            "Jeu de société se jouant sur plateau."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "note": "Le terme « plateau » désigne ici un tablier de jeu. Il s’agit d’une traduction littérale de l’anglais",
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c37b91ce-bdaa-322d-b045-47ef7504a8ac",
                                        "entry_id": "e99f0ac6-bb35-3e29-9abc-37cb61a36e52",
                                        "glosses": [
                                            "Jeu de société moderne pour les distinguer des jeux de société traditionnels comme les échecs, les dames, le go, l’awalé…"
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "note": "Quand bien même des jeux traditionnels usent d’un « plateau », et des jeux modernes n’en usent pas",
                                        "examples": []
                                    },
