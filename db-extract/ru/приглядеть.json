                        "entry_id": "b4cb1c82-3f2b-3b01-aa22-aa0d84a07da9",
                        "glosses": [
                            "посмотреть, последить с целью надзора, ухода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04fefbd-24dc-4395-9274-7a5c2da528d5",
                                "sense_id": "a8c7bccf-273a-3ed1-804b-5c2c637cd903",
                                "text": "Лично пригляжу за филейчиками."
                            }
                        ]
                    },
                    {
                        "sense_id": "0ba5dc02-e8ad-3a5a-af25-66a1ddf44c89",
                        "entry_id": "b4cb1c82-3f2b-3b01-aa22-aa0d84a07da9",
                        "glosses": [
                            "подыскать, выбрать для использования, употребления"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "41eed8e7-ee0d-4389-bb69-144ebb27b4b6",
                                "sense_id": "0ba5dc02-e8ad-3a5a-af25-66a1ddf44c89",
                                "text": "― Хватило бы на всех вас, ― уже обреченно говорил отец, ― ведь и девушку тебе хорошую мы с матерью приглядели, с приходом, с землей и с образованием, между прочим, ― Ярославское епархиальное училище закончила."
                            }
                        ]
                    }
