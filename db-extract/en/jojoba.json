                        "form_id": "e1178a19-7c19-4206-a6ea-33d9808795f6",
                        "entry_id": "0b7c7e30-e40f-3fd4-a0f4-2992724bcf95",
                        "tags": [
                            "plural"
                        ],
                        "form": "jojobas"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "20e6d299-6b6f-3f89-94a0-0f65008b8b5c",
                        "entry_id": "0b7c7e30-e40f-3fd4-a0f4-2992724bcf95",
                        "glosses": [
                            "Any of species Simmondsia chinensis of shrubs native to the southwestern United States and to Mexico, the only plant known to store liquid wax in its seed."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3425c9-cf2a-470b-b1c3-ef4468ff5310",
                                "sense_id": "20e6d299-6b6f-3f89-94a0-0f65008b8b5c",
                                "text": "The ground was bad – rocky and hard. That was why we used it for jojoba plants. The plants are tough. They donʼt need much."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7aa4148-f9f5-44c1-a926-55dc1bef6a5d",
                        "source_entry_id": "0b7c7e30-e40f-3fd4-a0f4-2992724bcf95",
                        "source_sense_id": "20e6d299-6b6f-3f89-94a0-0f65008b8b5c",
                        "source_sense_description": "Simmondsia chinensis",
                        "target_lang_word": "jojoba",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jojoba",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b61c497-7760-3168-b998-1f3518038223",
                                        "entry_id": "00926172-b9d9-35d7-9427-fea55687995f",
                                        "glosses": [
                                            "Arbuste de la famille des Simmondsiaceae originaire d’Arizona et du Mexique, cultivé pour la cire contenue dans ses graines, appelée « huile de jojoba »."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "568efd41-9e60-463f-9253-ea7f897788d1",
                                                "sense_id": "3b61c497-7760-3168-b998-1f3518038223",
                                                "text": "Le jojoba est un arbrisseau des déserts californiens et mexicains, intéressant à utiliser dans les préparations cosmétiques, surtout parce qu’il est produit non loin de chez nous."
                                            },
                                            {
                                                "example_id": "4c73e7b4-4369-4ba6-b6c4-bed8b1dc9fe1",
                                                "sense_id": "3b61c497-7760-3168-b998-1f3518038223",
                                                "text": "Quelques longues minutes, je distinguai la pluie, dans la faible lumière, si proche de la terre, si évidemment faite pour elle, que c’eût été pitié qu’elle ne forcât pas sa course. C’était pitié. Le propriétaire des jojobas, à la vue plus aiguë, la tint plus longtemps que moi sous son regard."
                                            },
                                            {
                                                "example_id": "671b97ca-9397-4b0f-aa32-7501654bf248",
                                                "sense_id": "3b61c497-7760-3168-b998-1f3518038223",
                                                "text": "Le Jojoba (Simmondsia californica Nutt.), Euphorbiacée à graine comestible (Revue des sciences naturelles appliquées, Paris, 1895 : 685-687) ; (...)"
                                            },
                                            {
                                                "example_id": "1902509e-e196-4268-8dad-b5fd542f5045",
                                                "sense_id": "3b61c497-7760-3168-b998-1f3518038223",
                                                "text": "Parmi ces plantes, il signale le Jojoba qui produit de petites amandes dont les animaux sont très friands et dont les Indiens papajos font une sorte de chocolat."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
