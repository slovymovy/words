                                    {
                                        "sense_id": "7c641b85-1e44-3927-a7f9-515713addd6f",
                                        "entry_id": "cc5aa85d-91c3-36fc-b2b1-e1819aa5d895",
                                        "glosses": [
                                            "Entschleierung eines Gegenstandes durch Entfernung bedeckender Materialien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "30c73891-d898-4268-b501-cab15f29ecfc",
                                                "sense_id": "7c641b85-1e44-3927-a7f9-515713addd6f",
                                                "text": "Die Enthüllung des Denkmals wird zur Eröffnung der Feier stattfinden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d8cd1a20-27a5-369b-973a-6342b36f26b8",
                                        "entry_id": "cc5aa85d-91c3-36fc-b2b1-e1819aa5d895",
                                        "glosses": [
                                            "Aufdeckung von bis dahin geheimgehaltenen Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9e151c6-b539-4c78-bb36-d1429df41df0",
                                                "sense_id": "d8cd1a20-27a5-369b-973a-6342b36f26b8",
                                                "text": "„Aber die Enthüllungen über seine Kontakte zu Edelprostituierten bestätigte viele Spekulationen.“"
                                            },
                                            {
                                                "example_id": "9c3d0ddf-10a9-48a4-8597-e8d029b5b9c0",
                                                "sense_id": "d8cd1a20-27a5-369b-973a-6342b36f26b8",
                                                "text": "„Diese Enthüllung traf mich wie ein Blitzschlag."
                                            },
                                            {
                                                "example_id": "cb58dbd9-9bd0-40f5-9070-0d6604718f9d",
                                                "sense_id": "d8cd1a20-27a5-369b-973a-6342b36f26b8",
                                                "text": "„Diese Enthüllungen machten die Männer traurig, die nur Augen für die Karosserie der Königin der durchzechten Nächte hatten.“"
                                            },
                                            {
                                                "example_id": "6af39b7a-c6b8-47b3-9934-712a8fd40ded",
                                                "sense_id": "d8cd1a20-27a5-369b-973a-6342b36f26b8",
                                                "text": "„Mr. Irishs Enthüllungen waren bitter, als der Lotse uns später erzählte, wie es sich wirklich abgespielt hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "18e7523a-270b-4faa-bbdb-dd3a803284f9",
                        "source_entry_id": "6fbb7ef7-4cf3-3cd2-96b4-a4759d9a6330",
