                            "past"
                        ],
                        "form": "разлага́вшись"
                    },
                    {
                        "form_id": "1a1d5d8a-6bb3-4124-8944-db1a85257f91",
                        "entry_id": "be108b0f-55fd-3ce3-b304-5bc7e454c6e6",
                        "tags": [
                            "future"
                        ],
                        "form": "буду/будешь… разлага́ться"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "19f1223d-189b-3195-b54b-c255badd6782",
                        "entry_id": "be108b0f-55fd-3ce3-b304-5bc7e454c6e6",
                        "glosses": [
                            "разделяться на части, распадаться на составные элементы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "172cae60-93b3-4f7f-9e46-5640bfa4e95c",
                                "sense_id": "19f1223d-189b-3195-b54b-c255badd6782",
                                "text": "Белый свет в призме разлагается в спектр; то же происходит и в миниатюрных призмочках линзы Френеля."
                            },
                            {
                                "example_id": "1ba0e369-4d44-4ade-b75d-af7bcc12d860",
                                "sense_id": "19f1223d-189b-3195-b54b-c255badd6782",
                                "text": "Белки сначала разлагаются на аминокислоты, а затем те распадаются с выделением аммиака NH3, который крайне токсичен для всех морских животных."
                            }
                        ]
                    },
                    {
                        "sense_id": "48156ae5-b3ff-3883-baa6-a0f29d7aad51",
                        "entry_id": "be108b0f-55fd-3ce3-b304-5bc7e454c6e6",
                        "glosses": [
                            "подвергаться распаду под действием бактерий; гнить"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0d1252-97ca-41d8-9190-562adf35a9ae",
                                "sense_id": "48156ae5-b3ff-3883-baa6-a0f29d7aad51",
                                "text": "В настоящее время чётко установлено, что органические вещества полностью разлагаются в лиственных лесах умеренной зоны за 2-4 года."
                            },
                            {
                                "example_id": "23924d6d-a3b9-46f5-894d-1e7a98e4a14b",
                                "sense_id": "48156ae5-b3ff-3883-baa6-a0f29d7aad51",
                                "text": "Но наряду с этим разлагаются и трупы убиенных, не похороненных по-человечески."
                            }
                        ]
                    },
                    {
                        "sense_id": "79a0a965-33ff-3cd5-ad1c-b7b2a0ab0a96",
                        "entry_id": "be108b0f-55fd-3ce3-b304-5bc7e454c6e6",
                        "glosses": [
                            "перен. приходить в состояние упадка, терять моральный дух, становиться безнравственным"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ee23819-c57a-429e-ad0b-19cfad6eb805",
                                "sense_id": "79a0a965-33ff-3cd5-ad1c-b7b2a0ab0a96",
                                "text": "И как всякая временная, практическая идея с достижением своей высшей точки классический сионизм стал стремительно разлагаться."
                            },
                            {
                                "example_id": "6291f7b4-5f5c-4d12-a040-5aa756af18af",
                                "sense_id": "79a0a965-33ff-3cd5-ad1c-b7b2a0ab0a96",
                                "text": "Очевидно, что армия, пережившая собственную страну, стремительно теряет боеспособность и разлагается, что бы по этому поводу ни заявляли её новые министры и сам президент."
                            }
                        ]
                    },
                    {
                        "sense_id": "a8c8a660-213b-3c3b-8b78-33aa11e91a8d",
                        "entry_id": "be108b0f-55fd-3ce3-b304-5bc7e454c6e6",
                        "glosses": [
                            "страд. к разлагать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": []
                    }
                ],
