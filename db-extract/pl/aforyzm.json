                                        "entry_id": "bbe82dd9-bacd-38c1-a461-0e206c72a90c",
                                        "glosses": [
                                            "Declaración o sentencia concisa; acordada por un gran número de personas (foro); que pretende expresar un principio o la verdad en una manera breve, pensativa y aparentemente cerrada."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5e8cdb70-99eb-354f-bfe9-e9b33a295d25",
                                        "entry_id": "bbe82dd9-bacd-38c1-a461-0e206c72a90c",
                                        "glosses": [
                                            "Proposición que encierra mucho sentido en pocas palabras."
                                        ],
                                        "tags": [],
