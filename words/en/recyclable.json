    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dcb30761-d90a-3f5e-bb85-4addbe3a98b0",
                    "sense_definition": "Able to be treated or processed so that it can be used again.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "recyclable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please check if the plastic bottle is made from <w>recyclable</w> material before throwing it away.",
                            "target_lang_translations": {
                                "pl": "Przed wyrzuceniem sprawdź, czy ta plastikowa butelka jest zrobiona z materiału <w>nadającego się do recyklingu</w>."
                            }
                        },
                        {
                            "text": "Many cities encourage citizens to separate <w>recyclable</w> packaging from ordinary household garbage.",
                            "target_lang_translations": {
                                "pl": "Wiele miast zachęca mieszkańców do oddzielania opakowań <w>nadających się do recyklingu</w> od zwykłych odpadów domowych."
                            }
                        }
                    ],
                    "antonyms": [
                        "non-recyclable",
                        "unrecyclable"
                    ],
                    "common_phrases": [
                        "recyclable materials",
                        "recyclable packaging",
                        "recyclable waste"
                    ],
                    "target_lang_definitions": {
                        "pl": "Nadający się do przetworzenia i ponownego wykorzystania."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "nadający się do recyklingu",
                                "target_lang_sense_clarification": "o materiale lub opakowaniu"
                            },
                            {
                                "target_lang_word": "recyklingowalny",
                                "target_lang_sense_clarification": "możliwy do poddania recyklingowi"
                            },
                            {
                                "target_lang_word": "przetwarzalny",
                                "target_lang_sense_clarification": "nadający się do przetworzenia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6e6a05ae-1245-38ae-bdae-53fea2b3686d",
                    "sense_definition": "An item or material that can be collected and processed for reuse.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "recyclable",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garbage and <w>recyclables</w> need to be taken out to the street tomorrow morning.",
                            "target_lang_translations": {
                                "pl": "Śmieci i <w>surowce wtórne</w> muszą zostać wystawione na ulicę jutro rano."
                            }
                        },
                        {
                            "text": "You should rinse every <w>recyclable</w> thoroughly before putting it into the blue bin.",
                            "target_lang_translations": {
                                "pl": "Powinieneś dokładnie wypłukać każdy <w>odpad do recyklingu</w>, zanim wrzucisz go do niebieskiego pojemnika."
                            }
                        }
                    ],
                    "common_phrases": [
                        "household recyclables",
                        "collect recyclables"
                    ],
                    "target_lang_definitions": {
                        "pl": "Przedmiot lub materiał nadający się do powtórnego przetworzenia (surowiec wtórny)."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "surowiec wtórny",
                                "target_lang_sense_clarification": "materiał zdatny do ponownego wykorzystania"
                            },
                            {
                                "target_lang_word": "odpad do recyklingu",
                                "target_lang_sense_clarification": "przedmiot podlegający segregacji i ponownemu przetworzeniu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
