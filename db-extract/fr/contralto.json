            {
                "entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                "word": "contralto",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "d8889022-a8ae-4954-befb-3043ae78d428",
                        "entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                        "tags": [
                            "plural"
                        ],
                        "form": "contraltos"
                    },
                    {
                        "form_id": "db9f1588-cce1-40d9-9abe-b40dee779224",
                        "entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                        "tags": [],
                        "form": "contralte"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                        "entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                        "glosses": [
                            "La plus grave des voix de femme."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61cf4f80-e4d1-4a17-8ae2-8bf61fa5a678",
                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                "text": "Vous connaissez quelqu’une de ces voix harmonieuses et mâles qui rappellent en un registre plus grave le contralto de la femme."
                            },
                            {
                                "example_id": "277d2a42-ce32-4a22-87c2-88e7c51a6f8e",
                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                "text": "Il atteint des régions qu’il avait jusque-là réservées à ses grandes œuvres chorales, telles que le Requiem allemand et la Rhapsodie pour contralto, à laquelle il est impossible de ne pas associer ce diptyque."
                            },
                            {
                                "example_id": "9af035af-459b-4faf-88d4-241caae3f52f",
                                "sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                                "text": "Elle récitait ce poème, toujours le même, avec une voix de contralto."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c04c52df-9582-45b8-a2c1-598923e864fe",
                        "source_entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                        "source_sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                        "target_lang_word": "contralto",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contralto",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "00069890-ad36-3e6a-9b31-7c09e0967a18",
                                        "entry_id": "be3c17d4-f5dc-3c1f-93f2-edcae529f383",
                                        "glosses": [
                                            "The lowest female voice or voice part, falling between tenor and mezzo-soprano. The terms contralto and alto refer to the same musical pitch range, but among singers, the term contralto is reserved for female singers; the equivalent male form is counter-tenor. Originally the contratenor altus was a high countermelody sung against the tenor or main melody."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68c35a90-3984-4c49-a39b-e7e6fcb4d4b0",
                                                "sense_id": "00069890-ad36-3e6a-9b31-7c09e0967a18",
                                                "text": "As for her dress, it was invariably rich, effective, and chic, yet in good taste. Lastly, her feet and hands were astonishing, and her voice a deep contralto."
                                            },
                                            {
                                                "example_id": "14d0f266-da6f-420b-ad0c-b685a286ae14",
                                                "sense_id": "00069890-ad36-3e6a-9b31-7c09e0967a18",
                                                "text": "Out in the yard a womanʼs hoarse contralto intoned a hymn."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1482f850-17a9-4dfd-a9dd-ae0a73626ed4",
                        "source_entry_id": "3a2d14c6-b7a3-355e-b93c-7e0b47e45893",
                        "source_sense_id": "4bff9279-67a5-34c7-99dc-02645a8a91ec",
                        "target_lang_word": "contralto",
                        "target_lang_code": "es",
