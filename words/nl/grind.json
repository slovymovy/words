            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7996bd3c-25e9-3242-9b5e-6408974053f5",
                    "sense_definition": "Kleine, door water gladgesleten steentjes; kiezelstenen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "gesteente",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De auto reed langzaam over het knisperende <w>grind</w> van de oprijlaan.",
                            "target_lang_translations": {
                                "en": "The car drove slowly over the crunching <w>gravel</w> of the driveway."
                            }
                        },
                        {
                            "text": "We hebben besloten om een pad van <w>grind</w> in onze tuin aan te leggen.",
                            "target_lang_translations": {
                                "en": "We decided to lay a <w>gravel</w> path in our garden."
                            }
                        }
                    ],
                    "common_phrases": [
                        "pad van grind",
                        "fijn grind"
                    ],
                    "target_lang_definitions": {
                        "en": "Small, water-worn stones; pebbles."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "gravel",
                                "target_lang_sense_clarification": "small fragments of rock used for paths or roads"
                            },
                            {
                                "target_lang_word": "pebbles",
                                "target_lang_sense_clarification": "small, smooth stones"
                            },
                            {
                                "target_lang_word": "shingle",
                                "target_lang_sense_clarification": "small pebbles on a beach"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70aa888f-cdd5-3483-bbcc-b4dbf27a6622",
                    "sense_definition": "Een besmettelijke huidziekte veroorzaakt door schurftmijt; schurft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ziekte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De hond had last van <w>grind</w> en moest door de dierenarts behandeld worden.",
                            "target_lang_translations": {
                                "en": "The dog was suffering from <w>mange</w> and had to be treated by the vet."
                            }
                        },
                        {
                            "text": "Vroeger werd deze huidaandoening vaak aangeduid als het <w>grind</w>.",
                            "target_lang_translations": {
                                "en": "In the past, this skin condition was often referred to as the <w>itch</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "schurft"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "voornamelijk in bepaalde dialecten gebruikt voor schurft"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An infectious skin disease caused by the itch mite; scabies."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "scabies",
                                "target_lang_sense_clarification": "infectious skin disease"
                            },
                            {
                                "target_lang_word": "mange",
                                "target_lang_sense_clarification": "skin disease in animals"
                            },
                            {
                                "target_lang_word": "itch",
                                "target_lang_sense_clarification": "informal term for scabies"
                            }
                        ]
                    }
                }
            ]
        },
        {
