            "senses": [
                {
                    "sense_id": "83adc218-bb79-3b32-82bf-02f8255b49c6",
                    "sense_definition": "Gebaseerd zijn op iets; steunen op een bepaald fundament (meestal figuurlijk gebruikt met 'op').",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zijn theorie <w>stoelt</w> op jarenlang wetenschappelijk onderzoek.",
                            "target_lang_translations": {
                                "en": "His theory <w>is based</w> on years of scientific research.",
                                "ru": "Его теория <w>основывается</w> на многолетних научных исследованиях.",
                                "fr": "Sa théorie <w>repose sur</w> des années de recherche scientifique."
                            }
                        },
                        {
                            "text": "Die uitspraak is <w>gestoeld</w> op feiten en niet op geruchten.",
                            "target_lang_translations": {
                                "en": "That statement is <w>founded</w> on facts and not on rumors.",
                                "ru": "Это утверждение <w>основано</w> на фактах, а не на слухах.",
                                "fr": "Cette déclaration est <w>fondée</w> sur des faits et non sur des rumeurs."
                            }
                        }
                    ],
                    "synonyms": [
                        "berusten",
                        "steunen"
                    ],
                    "common_phrases": [
                        "stoelen op",
                        "gestoeld op",
                        "gestoeld zijn"
                    ],
                    "target_lang_definitions": {
                        "en": "To be based on something; to rely on a specific foundation (usually used figuratively).",
                        "ru": "Быть основанным на чем-либо; опираться на определенный фундамент (обычно используется в переносном смысле).",
                        "fr": "Être fondé ou basé sur quelque chose ; reposer sur une base solide (généralement employé au figuré avec 'op')."
                    },
