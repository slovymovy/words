        "fr-extract.jsonl": [
            {
                "entry_id": "befff75f-47ff-3837-ae10-35418c7ed058",
                "word": "pétrochimie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "350334ae-29c6-4cc8-ab86-b65496c31b38",
                        "entry_id": "befff75f-47ff-3837-ae10-35418c7ed058",
                        "tags": [
                            "plural"
                        ],
                        "form": "pétrochimies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6dfaa72f-0210-3359-a7d8-43f6ba5fc12e",
                        "entry_id": "befff75f-47ff-3837-ae10-35418c7ed058",
                        "glosses": [
                            "Science qui s’intéresse à l’utilisation des composés chimiques de base issus du pétrole pour fabriquer d’autres composés synthétiques qui peuvent exister ou non dans la nature."
                        ],
                        "tags": [
                            "Chimie organique"
                        ],
                        "examples": [
                            {
                                "example_id": "153ab608-384f-42ca-bb9e-c563a2d7e91d",
                                "sense_id": "6dfaa72f-0210-3359-a7d8-43f6ba5fc12e",
                                "text": "Le mot pétrochimie a été utilisé dès le début pour marquer la différence entre l’industrie classique du pétrole (le raffinage) et une utilisation de certains produits ou sous-produits de l’industrie du raffinage, différente des utilisations classiques des produits pétroliers. — (École nationale supérieure du pétrole et des moteurs, Pétrole et pétrochimie, éditions TECHNIP, 1970)"
                            },
                            {
                                "example_id": "005473b7-ca9a-4cae-a414-80baeb3ba100",
                                "sense_id": "6dfaa72f-0210-3359-a7d8-43f6ba5fc12e",
                                "text": "En effet, la pétrochimie a produit en quelques décennies plus de cent mille molécules qui n’existent pas dans l’environnement et dont certaines, parfois très toxiques pour l’environnement et les êtres humains, ne peuvent pas être décomposées - ou très difficilement - par des agents naturels."
                            },
                            {
                                "example_id": "00c37526-de69-491f-86ab-208ef309e38e",
                                "sense_id": "6dfaa72f-0210-3359-a7d8-43f6ba5fc12e",
                                "text": "Si elle impacte les pays développés, voire chacun des pays du globe indépendamment de sa classification industrielle, la question ne saurait toutefois se limiter qu’à une question énergétique, compte tenu des multiples usages du pétrole et de ses dérivés dans la pétrochimie. Dépendance au pétrole sur Wikipédia."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ffa9f91-6421-40ec-bacb-1126d13aa266",
                        "source_entry_id": "befff75f-47ff-3837-ae10-35418c7ed058",
                        "source_sense_id": "6dfaa72f-0210-3359-a7d8-43f6ba5fc12e",
                        "target_lang_word": "Petrochemie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Petrochemie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                                        "entry_id": "07eb5be0-2ee4-3fe8-a547-e33b828bbd74",
                                        "glosses": [
                                            "der sich mit der Verarbeitung von Erdöl und Erdgas befassende Zweig der Chemie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efa60ad2-5391-4288-8933-53cf74eda682",
                                                "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                                                "text": "Da petrochemische Produkte den Endverbraucher jedoch nicht erreichen, sondern zuerst an andere Industrien verkauft werden und erst nach unzähligen Veränderungen und Umwandlungen in Produkten verarbeitet werden, die keinerlei Beziehung mehr zu den Ausgangsstoffen zu haben scheinen, ist die Bedeutung der Petrochemie dem Mann auf der Straße kaum bekannt."
                                            },
                                            {
                                                "example_id": "e5049122-fe88-4c2a-b18c-23407fd8c3b6",
                                                "sense_id": "3e6d35ed-60d0-3682-8684-efa510b079dd",
                                                "text": "„Überdies setzte Bhutto die Verstaatlichung von Großbetrieben in den wichtigsten Industriesektoren (Stahl, Petrochemie, Elektromaterial) um.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "554d46d0-ca8a-3434-a566-e313227dcf57",
                                        "entry_id": "07eb5be0-2ee4-3fe8-a547-e33b828bbd74",
                                        "glosses": [
                                            "die Wissenschaft rund um die chemische Zusammensetzung von Gestein"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20648d80-fc82-4b51-80f0-665ac9e55eb4",
                                                "sense_id": "554d46d0-ca8a-3434-a566-e313227dcf57",
                                                "text": "Heute gibt es in Hamburg keinen Lehrstuhl für Petrochemie mehr."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
