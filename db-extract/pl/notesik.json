                        "sense_id": "65988805-5706-3965-95a5-85ee2035d12e",
                        "entry_id": "485c4286-f3b9-318f-9d4b-89b2afe37e38",
                        "glosses": [
                            "mały notes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e03cac69-7c0b-40db-a24b-a7f46d88b600",
                                "sense_id": "65988805-5706-3965-95a5-85ee2035d12e",
                                "text": "Woźna zapisała nasze nazwiska w swoim notesiku."
                            }
