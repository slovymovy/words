                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ebbcd77-710c-4cba-afa5-2e2053341b18",
                                "sense_id": "2418abf0-07dc-3f04-8d07-880feba2bbd6",
                                "text": "Na ogół do powstania trwałej emulsji niezbędny jest trzeci związek chemiczny zwany emulgatorem."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "f3a9e911-3e33-3c0e-80cd-f5c8d4b7fc9c",
                        "entry_id": "086978f0-c6dd-3ad0-a18d-f5b0f37f3118",
                        "glosses": [
                            "farba emulsyjna"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "20acbe4d-8ab9-49ae-bd59-e2242e4fbb22",
                                "sense_id": "f3a9e911-3e33-3c0e-80cd-f5c8d4b7fc9c",
                                "text": "Przy malowaniu emulsjami do gruntowania można stosować emulsję tego samego rodzaju lecz rozcieńczoną wodą w odpowiednim stosunku."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    }
                ],
