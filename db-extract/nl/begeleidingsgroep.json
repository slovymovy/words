                        "sense_id": "56e35edc-46b6-38f0-83c3-0feb93861db9",
                        "entry_id": "0b8ff8e6-1d6c-3c70-8d5a-93420008d756",
                        "glosses": [
                            "groep begeleiders die anderen helpt hun taak te volbrengen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca3a8cbb-3320-4d1b-94a5-5422cbdb5624",
                                "sense_id": "56e35edc-46b6-38f0-83c3-0feb93861db9",
                                "text": "Daarnaast wil Hodgson een psycholoog toevoegen aan zijn WK-begeleidingsgroep om de mentale weerbaarheid van zijn spelers te vergroten. En natuurlijk ook om af te komen van het penaltysyndroom op grote toernooien."
                            },
                            {
                                "example_id": "59855b61-3da3-4ee0-b0e1-122b30806e6c",
                                "sense_id": "56e35edc-46b6-38f0-83c3-0feb93861db9",
                                "text": "\"Van Gaal heeft zowel nationaal als internationaal zijn sporen verdiend en wij kennen hem als een toegewijd en een zeer gedreven coach. Binnenkort zullen we ons buigen over de verdere invulling van de begeleidingsgroep van Oranje\", verklaarde Van Oostveen."
                            }
                        ]
                    },
                    {
                        "sense_id": "c56f7f16-ad52-3c4f-8dc4-4410a09d9178",
                        "entry_id": "0b8ff8e6-1d6c-3c70-8d5a-93420008d756",
                        "glosses": [
                            "groep muzikanten die een zanger of zangeres begeleidt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f7ad324-ebd1-440a-9da7-2785396eec22",
                                "sense_id": "c56f7f16-ad52-3c4f-8dc4-4410a09d9178",
                                "text": "Anouk maakte tijdens haar optreden een ontspannen indruk. Ze stond voor op het podium, ver voor haar begeleidingsgroep."
                            }
                        ]
                    }
