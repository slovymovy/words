                "senses": [
                    {
                        "sense_id": "e5079cd9-265f-3367-bfed-0e98ba8e0363",
                        "entry_id": "7d653cb8-1e9c-36b3-9618-5008781fb59a",
                        "glosses": [
                            "Faire perdre son caractère américain à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25e5c083-bde8-4666-bac1-661c75f6d36e",
                                "sense_id": "e5079cd9-265f-3367-bfed-0e98ba8e0363",
                                "text": "“Dés-américaniser” le monde"
                            },
                            {
                                "example_id": "f59eedb6-4bec-4bed-87f6-ff8537276010",
                                "sense_id": "e5079cd9-265f-3367-bfed-0e98ba8e0363",
                                "text": "Par conséquent, mettre fin à la Seconde Guerre mondiale signifie aujourd’hui dés-américaniser l’Europe, ce qui signifie la dés-otaniser, c’est-à-dire la démilitariser."
                            },
                            {
                                "example_id": "bef29639-ef2c-4982-ad89-520c623c4b1b",
                                "sense_id": "e5079cd9-265f-3367-bfed-0e98ba8e0363",
                                "text": "À Jérusalem, Israël se « dé-russifie », et se « dés-américanise » pour se « levantiniser »."
                            }
                        ]
                    }
