                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Haspel</w> je het snoer na gebruik altijd meteen weer op?",
                            "target_lang_translations": {
                                "en": "Do you always <w>wind up</w> the cord again immediately after use?"
                            }
                        },
                        {
                            "text": "Waarom <w>haspel</w> je de draad zo gehaast af?",
                            "target_lang_translations": {
