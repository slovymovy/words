{
    "word_family": [
        "replication",
        "replicator",
        "replica"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "802a8e01-6683-365c-a0d3-389bbac84766",
                    "sense_definition": "To make an exact copy of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist tried to <w>replicate</w> the style of the old masters in her own paintings.",
                            "target_lang_translations": {
                                "nl": "De kunstenaar probeerde de stijl van de oude meesters in haar eigen schilderijen te <w>nabootsen</w>."
                            }
                        },
                        {
                            "text": "Scientists are working to <w>replicate</w> the conditions of the early Earth in a controlled environment.",
                            "target_lang_translations": {
                                "nl": "Wetenschappers werken eraan om de omstandigheden van de vroege aarde in een gecontroleerde omgeving te <w>repliceren</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "duplicate",
                        "reproduce"
                    ],
                    "common_phrases": [
                        "replicate a design"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een exacte kopie van iets maken."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "repliceren",
                                "target_lang_sense_clarification": "algemeen woord voor het maken van een kopie"
                            },
                            {
                                "target_lang_word": "nabootsen",
                                "target_lang_sense_clarification": "iets imiteren of kopiëren, vaak gebruikt voor stijlen of omstandigheden"
                            },
                            {
                                "target_lang_word": "kopiëren",
                                "target_lang_sense_clarification": "een directe kopie maken"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "01456cbe-2aac-3b39-b92c-ac2249a62b31",
                    "sense_definition": "To perform an experiment or procedure again to see if the same results occur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Other researchers were unable to <w>replicate</w> the findings of the original study.",
                            "target_lang_translations": {
                                "nl": "Andere onderzoekers waren niet in staat de bevindingen van het oorspronkelijke onderzoek te <w>repliceren</w>."
                            }
                        },
                        {
                            "text": "It is essential to <w>replicate</w> the experiment several times to ensure the data is reliable.",
                            "target_lang_translations": {
                                "nl": "Het is essentieel om het experiment meerdere keren te <w>herhalen</w> om ervoor te zorgen dat de gegevens betrouwbaar zijn."
                            }
                        }
                    ],
                    "synonyms": [
                        "reproduce",
                        "repeat"
                    ],
                    "common_phrases": [
                        "replicate results"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een experiment of procedure opnieuw uitvoeren om te zien of dezelfde resultaten optreden."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "repliceren",
                                "target_lang_sense_clarification": "wetenschappelijke term voor het herhalen van een onderzoek"
                            },
                            {
                                "target_lang_word": "herhalen",
                                "target_lang_sense_clarification": "opnieuw uitvoeren"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "55224d5c-aaae-3fb8-9a9e-e1bc5e72b34b",
                    "sense_definition": "To provide a response or answer to something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lawyer was asked to <w>replicate</w> to the claims made by the opposing party.",
                            "target_lang_translations": {
                                "nl": "De advocaat werd gevraagd te <w>reageren</w> op de claims van de tegenpartij."
                            }
                        },
                        {
                            "text": "He did not <w>replicate</w> when he was insulted by his colleague.",
                            "target_lang_translations": {
                                "nl": "Hij <w>antwoordde</w> niet toen hij door zijn collega werd beledigd."
                            }
                        }
                    ],
                    "synonyms": [
                        "reply",
                        "respond",
                        "answer"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Reageren of antwoorden op iets (archaïsch)."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "antwoorden",
                                "target_lang_sense_clarification": "een antwoord geven"
                            },
                            {
                                "target_lang_word": "reageren",
                                "target_lang_sense_clarification": "een reactie geven"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "8a2a1149-c9c6-31a5-b575-b81466c20162",
                    "sense_definition": "An exact copy or duplicate of something.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "copying",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory used several <w>replicates</w> to ensure the accuracy of the test.",
                            "target_lang_translations": {
                                "nl": "Het laboratorium gebruikte verschillende <w>replica's</w> om de nauwkeurigheid van de test te garanderen."
                            }
                        },
                        {
                            "text": "Each <w>replicate</w> must be handled with the same care as the original sample.",
                            "target_lang_translations": {
                                "nl": "Elke <w>replica</w> moet met dezelfde zorg worden behandeld als het oorspronkelijke monster."
                            }
                        }
                    ],
                    "synonyms": [
                        "copy",
                        "replica",
                        "duplicate"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een exacte kopie of duplicaat van iets."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "replica",
                                "target_lang_sense_clarification": "een exacte kopie"
                            },
                            {
                                "target_lang_word": "duplicaat",
                                "target_lang_sense_clarification": "een tweede exemplaar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df8136e6-a9d2-3fe4-b021-4750b70f813c",
                    "sense_definition": "A musical tone that is one or more octaves higher or lower than a reference tone.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The note played by the flute is a <w>replicate</w> of the one played by the cello.",
                            "target_lang_translations": {
                                "nl": "De noot die door de fluit wordt gespeeld is een <w>octaaf</w> van die van de cello."
                            }
                        },
                        {
                            "text": "In music theory, a <w>replicate</w> shares the same pitch class as the original note.",
                            "target_lang_translations": {
                                "nl": "In de muziektheorie deelt een <w>octaaf</w> dezelfde toonklasse als de oorspronkelijke noot."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een muzikale toon die een of meer octaven hoger of lager is dan een referentietoon."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "octaaf",
                                "target_lang_sense_clarification": "in de context van toonhoogte"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "efcac95b-61ca-3dad-a32d-e214e2147936",
                    "sense_definition": "Folded back upon itself.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The botanist identified the plant by its <w>replicate</w> leaves.",
                            "target_lang_translations": {
                                "nl": "De botanicus identificeerde de plant aan de hand van zijn <w>teruggevouwen</w> bladeren."
                            }
                        },
                        {
                            "text": "The shell has a <w>replicate</w> margin that curves inward.",
                            "target_lang_translations": {
                                "nl": "De schelp heeft een <w>teruggevouwen</w> rand die naar binnen buigt."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Teruggevouwen op zichzelf."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "teruggevouwen",
                                "target_lang_sense_clarification": "beschrijvend voor een vorm"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}