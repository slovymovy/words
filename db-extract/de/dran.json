                        ],
                        "tags": [
                            "an etwas dran sein"
                        ],
                        "examples": [
                            {
                                "example_id": "340ad08f-218d-46ae-b506-7d97403e3ac3",
                                "sense_id": "326df86f-1d2c-3646-8bef-8f970f3b8c95",
                                "text": "„Was hältst Du von den Gerüchten?“ – „Ich denke, an denen ist etwas dran.“"
                            },
                            {
                                "example_id": "1fccdfa0-975c-41aa-8ca6-189ae884d1a4",
                                "sense_id": "326df86f-1d2c-3646-8bef-8f970f3b8c95",
                                "text": "„Die SPD erklärte die Linke als nicht regierungswillig und –fähig. Was ist da dran?“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "fa9c3d93-03e1-357c-afa7-2dc9ddd6ba34",
                        "entry_id": "7d3fd7e2-f398-3394-bed9-50d7c53306de",
                        "glosses": [
                            "an der Reihe sein"
                        ],
                        "tags": [
                            "dran sein"
                        ],
                        "examples": [
                            {
                                "example_id": "3444f51c-a7b4-4b39-a6e2-0266d8e2e981",
                                "sense_id": "fa9c3d93-03e1-357c-afa7-2dc9ddd6ba34",
                                "text": "Hast Du schon gewürfelt, bin ich dran?"
                            },
                            {
                                "example_id": "fd0c3c03-fb0c-4f0e-9434-f08511a3bfd5",
                                "sense_id": "fa9c3d93-03e1-357c-afa7-2dc9ddd6ba34",
                                "text": "Sind wir eigentlich diese Woche dran mit dem Hausputz?"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "ce7d410c-ac91-352d-8b7d-de8be26ce598",
                        "entry_id": "7d3fd7e2-f398-3394-bed9-50d7c53306de",
                        "glosses": [
                            "bald schlimme Folgen für etwas erleiden"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b1824a54-332a-4331-afe1-005a44a98e91",
                                "sense_id": "ce7d410c-ac91-352d-8b7d-de8be26ce598",
                                "text": "„Jetzt bist du dran!“ rief er, bevor er zuschlug."
                            },
                            {
                                "example_id": "d99aa42d-9b4d-4d3d-84a6-988c187843b0",
                                "sense_id": "ce7d410c-ac91-352d-8b7d-de8be26ce598",
                                "text": "Wenn uns die Polizei auf die Schliche kommt, sind wir beide dran!"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2626bd84-32e1-4781-98f5-ffda7ae33df1",
                        "source_entry_id": "7d3fd7e2-f398-3394-bed9-50d7c53306de",
                        "source_sense_id": "fa9c3d93-03e1-357c-afa7-2dc9ddd6ba34",
