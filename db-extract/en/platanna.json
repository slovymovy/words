                    {
                        "sense_id": "abc50de2-5436-3e96-b73f-e84e413e5df2",
                        "entry_id": "8aa12629-0bc1-3ce5-b7a5-83ac79c271a4",
                        "glosses": [
                            "Any of several clawed frogs of the genus Xenopus which spend most of their time in water and rarely emerge onto land, especially the common platanna, Xenopus laevis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "366b9cae-168f-42d5-8263-7384f6a86284",
                                "sense_id": "abc50de2-5436-3e96-b73f-e84e413e5df2",
                                "text": "[…]leading medical pathologist, Dr Louis P. Bosman, became so concerned at the depletion of the local platanna population that he petitioned the Provincial Administration to introduce protective legislation and to investigate the possibility of the artificial culture of these animals at the Jonkershoek Hatchery.[…]For many years scientists observed that there was only one species of platanna, Xenopus laevis. Dr Walter Rose, who devoted many years of study to the amphibians of the Western Cape, had questioned this, and had eventually became convinced that there was another species, similar in appearance, but smaller, shyer and less aggressive. This he named X. gilli after Dr L. Gill, director of the South African Museum."
                            },
                            {
                                "example_id": "536d0be1-badb-429a-87b9-eda63703fa80",
                                "sense_id": "abc50de2-5436-3e96-b73f-e84e413e5df2",
                                "text": "Some frogs, like the Platanna (Xenopus laevis), are wholly aquatic, living, feeding and breeding under water."
                            },
                            {
                                "example_id": "2597a9d4-9f86-4384-a8ce-d1db677f1510",
                                "sense_id": "abc50de2-5436-3e96-b73f-e84e413e5df2",
                                "text": "Platannas are found almost permanently in water and can remain submerged for hours without needing to surface."
                            }
                        ]
                    }
                ],
