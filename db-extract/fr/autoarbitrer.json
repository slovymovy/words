                        "glosses": [
                            "Arbitrer soi-même."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "66f1196f-8fb4-3124-b3d4-c1b9877c03c3",
                        "entry_id": "5a2d2d1d-ebac-3c49-b076-09e29364b400",
                        "glosses": [
                            "S’arbitrer soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867644af-6b61-4945-8db1-4d371a5c91bc",
                                "sense_id": "66f1196f-8fb4-3124-b3d4-c1b9877c03c3",
                                "text": "Ils doivent s’autogérer, s’autoarbitrer, s’automobiliser dans un gigantesque embouteillage sans sémaphore ni warning."
                            },
                            {
                                "example_id": "7819f9d5-bf4c-4435-9b75-6567407bbfbe",
                                "sense_id": "66f1196f-8fb4-3124-b3d4-c1b9877c03c3",
                                "text": "A l'école primaire française, on encourage les enfants à apprendre à s'autoarbitrer."
                            },
                            {
                                "example_id": "526470a9-18d4-493e-bd03-0fd295bf7ecb",
                                "sense_id": "66f1196f-8fb4-3124-b3d4-c1b9877c03c3",
                                "text": "Afin de garder un jeu très alerte et très vivant chacun doit s'efforcer de suivre la règle et de s'autoarbitrer."
                            }
                        ]
                    }
