                            {
                                "example_id": "1543d824-e136-4158-9d7e-39270fc31434",
                                "sense_id": "dbac1f7d-4b6d-31cb-9983-4fd4b23aff53",
                                "text": "‘And you're going to marry her, are you? Or have you knocked her up?’\n‘No. Neither.’\n‘So you’re just going out? You’re not lumbered?’"
                            }
                        ]
                    },
                    {
                        "sense_id": "44769e7e-7c0f-3f75-94b5-9bf96451903f",
                        "entry_id": "ee8d886c-042d-365b-89ad-4ff303d7f134",
                        "glosses": [
