            {
                "entry_id": "302700bd-ae38-3eb4-8ee0-9911c7aa9fae",
                "word": "widrigenfalls",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "563a8765-9a30-3007-872e-5c26a20db8f4",
                        "entry_id": "302700bd-ae38-3eb4-8ee0-9911c7aa9fae",
                        "glosses": [
                            "sollte das Gesagte nicht zutreffen, im anderen Falle"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "4ed54baa-f44e-4c83-ab70-2d3bc8a7f2e8",
                                "sense_id": "563a8765-9a30-3007-872e-5c26a20db8f4",
                                "text": "„Mit kaltblütiger Ruhe stieg der Postbote die Treppe hinauf und erklärte Herrn Pfeifer, daß diesem Unfug ein Ende gemacht werden müsse, widrigenfalls er keine Briefe mehr hierher zu besorgen brauche.“"
                            },
                            {
                                "example_id": "715b4477-524b-4079-971a-1786c1150a6e",
                                "sense_id": "563a8765-9a30-3007-872e-5c26a20db8f4",
                                "text": "„Die Einzelheiten des Vergleichs, der Polanski von einem Richter in Los Angeles unter der Drohung aufgezwungen wurde, widrigenfalls werde man dessen Einnahmen aus amerikanischen Kinos beschlagnahmen, sind unbekannt, weil vertraulich.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a01583c1-fa3b-405e-8ca0-ff157146fb30",
                        "source_entry_id": "302700bd-ae38-3eb4-8ee0-9911c7aa9fae",
                        "source_sense_id": "563a8765-9a30-3007-872e-5c26a20db8f4",
                        "source_sense_description": "meist Amtssprache: sollte das Gesagte nicht zutreffen, im anderen Falle",
                        "target_lang_word": "dans le cas contraire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "550147e0-1c79-4365-b6d2-48b77eb87b72",
                        "source_entry_id": "302700bd-ae38-3eb4-8ee0-9911c7aa9fae",
                        "source_sense_id": "563a8765-9a30-3007-872e-5c26a20db8f4",
                        "source_sense_description": "meist Amtssprache: sollte das Gesagte nicht zutreffen, im anderen Falle",
                        "target_lang_word": "sinon",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinon",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                        "entry_id": "f7325782-e104-3f70-8152-43c5933d2c02",
                                        "glosses": [
                                            "Si ce n’est : si ce qui est énoncé est faux, alors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "77b5b874-14f2-4a38-99a1-aa8536b93539",
                                                "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                                "text": "Des communications fréquentes, sinon continues, existaient à l’Éocène entre les contrées du Sud de l’Europe et le continent africain."
                                            },
                                            {
                                                "example_id": "37a2c052-c351-4bb1-b615-335ffa552d07",
                                                "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                                "text": "J'ai juré à ma mère, brisée par vous, de vous tuer. Sinon de ma propre main, du moins par celle de l'homme que j'aime !"
                                            },
                                            {
                                                "example_id": "a5493a3a-71ed-4cc7-9c21-b7f03cdac28a",
                                                "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                                "text": "Les lettres demeurèrent donc dans la famille, destinées à être sinon détruites, du moins à tout jamais impubliées."
                                            },
                                            {
                                                "example_id": "02e3de93-160f-4feb-8fab-bb47b62f5852",
                                                "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                                "text": "Ces deux édifices, qui ont été étudiés par Frédéric Sartiaux, ont été bâtis à la fin du XIVᵉ siècle sinon par la même personne, du moins par la même famille."
                                            },
                                            {
                                                "example_id": "55088bfe-be4c-4377-86a7-1ba710c4c5be",
                                                "sense_id": "7c9b4fa8-daec-3abd-b3d6-1abe14c9c37f",
                                                "text": "Comment expliquer ce qui ne peut pas ne pas apparaître comme, au mieux, une négligence, sinon une malhonnêteté ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0686455e-f465-30f3-b3ba-cbaf89b20c11",
                                        "entry_id": "f7325782-e104-3f70-8152-43c5933d2c02",
                                        "glosses": [
                                            "Faute de quoi ; sans quoi."
                                        ],
                                        "tags": [
                                            "Absolument"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8967f303-2fc6-4091-8b46-83dda105339d",
                                                "sense_id": "0686455e-f465-30f3-b3ba-cbaf89b20c11",
                                                "text": "Faire mine de rien, surtout faire mine de rien, il ne devait pas savoir que je savais, sinon j’étais grillé."
                                            },
                                            {
                                                "example_id": "1eba5172-1993-47c5-916a-f4235b6ca42c",
                                                "sense_id": "0686455e-f465-30f3-b3ba-cbaf89b20c11",
                                                "text": "Si vous êtes sage, je vous récompenserai; sinon, non."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
