                "senses": [
                    {
                        "sense_id": "fa31c345-224a-30d0-a392-95cde0ded358",
                        "entry_id": "a0b5bc41-5b68-31a2-8967-88a51521adb7",
                        "glosses": [
                            "eine Gans, die in der freien Natur lebt und dort auch meist geboren wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "743b78e4-f623-48ca-9ea4-97187c7c0b54",
                                "sense_id": "fa31c345-224a-30d0-a392-95cde0ded358",
                                "text": "Jutta hat vorhin einen Schwarm Wildgänse am Himmel fliegen sehen."
                            },
                            {
                                "example_id": "5f0101d6-dc8b-4306-a44f-cf89caf5b6b7",
                                "sense_id": "fa31c345-224a-30d0-a392-95cde0ded358",
                                "text": "„In dieses Rot hinein flogen Wildgänse, ihre Schreie verebbten über dem weiten Land, das hier begann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4eebea9d-7ade-414d-a70e-f532d4323fa1",
                        "source_entry_id": "a0b5bc41-5b68-31a2-8967-88a51521adb7",
                        "source_sense_id": "fa31c345-224a-30d0-a392-95cde0ded358",
                        "source_sense_description": "Zoologie: eine Gans, die in der freien Natur lebt und dort auch meist geboren wurde",
                        "target_lang_word": "wild goose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wild goose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cd1f2806-331d-3ba2-8176-7270e1c651f2",
                                        "entry_id": "e696e72a-059d-3ec1-b4ea-0cb85c1b4595",
                                        "glosses": [
                                            "any of many species of wildlife goose, such as the greylag goose or the Canada goose, whose wedge fly in a wedge or V form, or cuneiform, as opposed to the domesticated goose that would not fly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7633c830-199a-4e75-a258-5841327b0fc8",
                        "source_entry_id": "a0b5bc41-5b68-31a2-8967-88a51521adb7",
                        "source_sense_id": "fa31c345-224a-30d0-a392-95cde0ded358",
                        "source_sense_description": "Zoologie: eine Gans, die in der freien Natur lebt und dort auch meist geboren wurde",
                        "target_lang_word": "oie sauvage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "oie sauvage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2caa2ac-604c-38a4-aa8a-137931fb245e",
                                        "entry_id": "1381941d-464b-30ae-a597-72e499a8a946",
                                        "glosses": [
                                            "Nom donné communément à l’oie cendrée sous sa forme sauvage, pour la différencier des formes domestiques qui en sont issues."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "622c9b01-9910-4cac-8f23-62c97af32e52",
                                                "sense_id": "f2caa2ac-604c-38a4-aa8a-137931fb245e",
                                                "text": "On trouve aussi le Flamet, qui est un grand & bel oiseau de la grosseur d’une oie sauvage, …."
                                            },
                                            {
                                                "example_id": "3eb5e154-7cfb-4fcb-8566-43a4bac2470e",
                                                "sense_id": "f2caa2ac-604c-38a4-aa8a-137931fb245e",
                                                "text": "L’oie sauvage est maigre & de taille plus légère que l’oie domestique …."
                                            },
                                            {
                                                "example_id": "99946226-af1e-44df-b4c8-39fef580ae41",
                                                "sense_id": "f2caa2ac-604c-38a4-aa8a-137931fb245e",
                                                "text": "Nous aurions attendu que le chrétien fût figuré par l’oie domestique plutôt que par l’oie sauvage, mais pour Kierkegaard, s’il est figuré par l’oie sauvage, c’est parce qu’il est libre de fuir la médiocrité de la vie domestique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
