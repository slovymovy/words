                ],
                "senses": [
                    {
                        "sense_id": "ac00949e-79cf-36e6-84a4-3296c70a1ed0",
                        "entry_id": "00b537a0-270b-3f1c-bfc2-6b47df3b6f57",
                        "glosses": [
                            "Kirchengebäude eines Klosters"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a7be60a-8ccd-4b9d-bfbf-bcf3f1beea6e",
                                "sense_id": "ac00949e-79cf-36e6-84a4-3296c70a1ed0",
                                "text": "„Der stattliche Mittelpunkt des Ganzen, die zahlreichen Giebel überragend, war und blieb die hohe Klosterkirche, deren mit Kupfer gedeckter Mittelturm dunkel bronzefarben in der Sonne glänzte.“"
                            },
                            {
                                "example_id": "327a4620-0f9d-4245-ab90-8f4c834f23b6",
                                "sense_id": "ac00949e-79cf-36e6-84a4-3296c70a1ed0",
                                "text": "„In diesem Kloster hätten im Mittelalter einmal viele Nonnen gelebt, mit der Zeit sei das Kloster aber verfallen und jetzt sei von dem ganzen Kloster kaum noch etwas zu sehen außer der alten Klosterkirche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
