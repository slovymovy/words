                    {
                        "translation_id": "2d59b525-2388-4184-b67d-dd8a0f6efdfe",
                        "source_entry_id": "7c6d8dec-06ce-3546-a42e-fa858a7db959",
                        "source_sense_id": "89ed537c-0f52-3f4e-afa8-0d7897a5f8cf",
                        "source_sense_description": "en 2. (zaden van) plant Secale cereale",
                        "target_lang_word": "Roggen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Roggen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "250ea59d-86a6-31ca-aa18-2e9f96d8655b",
                                        "entry_id": "077eecfd-5fe9-3c9d-9955-7f34ac1f8aed",
                                        "glosses": [
                                            "langstielige Getreideart mit relativ langen Ähren und Grannen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a239cfaf-7fd7-4a98-a977-e26eaf995b82",
                                                "sense_id": "250ea59d-86a6-31ca-aa18-2e9f96d8655b",
                                                "text": "Roggen ist nur mit Sauerteig backfähig."
                                            },
                                            {
                                                "example_id": "17b9bc17-db9a-43ff-8a84-90f6a43a1f9a",
                                                "sense_id": "250ea59d-86a6-31ca-aa18-2e9f96d8655b",
                                                "text": "„Vom Roggen und der Wintergerste abgesehen, die noch im Herbst eingesät wurden, von ein paar Bauernäckern noch dazu, über die jetzt die Polen gebieten, ist auf den Feldern nur das Unkraut gediehen.“"
                                            },
                                            {
                                                "example_id": "bee0bcc4-281a-4785-98b4-09fddc98d2fb",
                                                "sense_id": "250ea59d-86a6-31ca-aa18-2e9f96d8655b",
                                                "text": "„Er betrachtete sich die Felder rechts und links, die mit schon gelbem Roggen, die mit dichtem, noch grünem Hafer, und die noch schwarzen, mit deren Umackerung eben erst begonnen worden war.“"
                                            },
                                            {
                                                "example_id": "ce7e4395-bfba-4898-b7a7-0260dd9c8ca6",
                                                "sense_id": "250ea59d-86a6-31ca-aa18-2e9f96d8655b",
                                                "text": "„Er führte »die Herren« auf ein anderes Feld, auf dem vierzehn Schnitter mit nackter Brust und gespreizten Beinen Roggen mähten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48316dd3-be6e-40da-b008-6371a33cae03",
                        "source_entry_id": "7c6d8dec-06ce-3546-a42e-fa858a7db959",
