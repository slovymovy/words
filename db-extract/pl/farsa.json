                                        "sense_id": "9b41ab2f-8618-3305-9929-78c76c9f5768",
                                        "entry_id": "317fc635-acfa-3156-9df4-42cbad24e1e8",
                                        "glosses": [
                                            "směšná podívaná typická spíše nepravděpodobnými situacemi a výroky, zejména hra divadelního žánru vaudeville"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b60ab44c-525e-36e6-a245-80911c7fc4c7",
                                        "entry_id": "317fc635-acfa-3156-9df4-42cbad24e1e8",
                                        "glosses": [
                                            "směšná, ale zároveň urážlivá podívaná předkládaná jako něco seriózního, např. k uvěření"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "634101d2-1702-4c4c-aa43-8c374f1cf0ce",
                                                "sense_id": "b60ab44c-525e-36e6-a245-80911c7fc4c7",
                                                "text": "To co se stalo v Monaku to byla hotová fraška a výsměch všech fandům co si koupili lístek a zapnuli televizory s placenými kanály."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e4e4198-b4c7-4aa9-9f1c-1c5e60eda4a2",
                        "source_entry_id": "552554aa-8d51-31d8-b7ff-3be623b186c6",
                        "source_sense_id": "c19b5c8e-45e0-324a-ae75-202c1c0a56c8",
                        "target_lang_word": "Farce",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Farce",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3e42f6ea-f2a1-314c-80de-b9a9e86d0ffe",
                                        "entry_id": "e626c466-e9f2-35b7-9ead-1119c9184c48",
                                        "glosses": [
                                            "derb-komisches Lustspiel, Füllstück zwischen Schauspielen"
                                        ],
                                        "tags": [
                                            "Theater"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd3d6005-c15a-468b-84a8-0f8284bc86b6",
                                                "sense_id": "3e42f6ea-f2a1-314c-80de-b9a9e86d0ffe",
                                                "text": "Der Auftritt der Laienspielgruppe zeigte eine gelungene Interpretation der Farce von George Tabori."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5bc99c77-d59a-3872-ab95-8aa43ef16dae",
                                        "entry_id": "e626c466-e9f2-35b7-9ead-1119c9184c48",
                                        "glosses": [
                                            "eine Füllung zum Beispiel für Pasteten oder Geflügel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066d9f84-c1f5-45cc-8e81-629a23d0e5b7",
                                                "sense_id": "5bc99c77-d59a-3872-ab95-8aa43ef16dae",
                                                "text": "Die gebratenen Forellen waren mit einer leckeren Farce aus Wurzelgemüse gefüllt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "a1e45d0a-344d-31ea-98f2-c89c1f18826c",
                                        "entry_id": "e626c466-e9f2-35b7-9ead-1119c9184c48",
                                        "glosses": [
                                            "lächerliche Sache oder Szene, Unsinn, ein durch unangemessene Herangehensweise verfehlter, abgewerteter oder auch abwertender Vorgang"
                                        ],
                                        "tags": [
                                            "metaphorisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20120845-5d70-43f5-bf51-94df2a241321",
                                                "sense_id": "a1e45d0a-344d-31ea-98f2-c89c1f18826c",
                                                "text": "Der Auftritt des Vorstandsvorsitzenden war eine einzige Farce."
                                            },
                                            {
                                                "example_id": "78d43994-d472-4f98-a49e-03e9a23acd38",
                                                "sense_id": "a1e45d0a-344d-31ea-98f2-c89c1f18826c",
                                                "text": "„Die Prohibition ist in vollem Gang, letzte Farce eines puritanischen Amerika, durch die das Entstehen illegaler Treffpunkte, eines lukrativen Schwarzhandels und einer anmaßenden Mafia gefördert wird.“"
                                            },
                                            {
                                                "example_id": "33817828-b785-4466-8f40-2cceb2eb0310",
                                                "sense_id": "a1e45d0a-344d-31ea-98f2-c89c1f18826c",
                                                "text": "„Auch Menachem Mendels Tragödie ließ sich nur als Farce kaschieren, weil der Spekulant als eine Witzfigur konzipiert war, die unverantwortlich handeln durfte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7b903639-b76b-4dcd-b58c-d6381be6972e",
                        "source_entry_id": "552554aa-8d51-31d8-b7ff-3be623b186c6",
