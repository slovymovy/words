            {
                "entry_id": "93407187-3650-353d-ba77-453ed7ecd2ca",
                "word": "FAF",
                "pos": "name",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "3189afa0-5e36-34d1-90e6-02d0c117049b",
                        "entry_id": "93407187-3650-353d-ba77-453ed7ecd2ca",
                        "glosses": [
                            "Association regroupant les clubs de football d’Algérie et organisant les compétitions nationales et les matchs internationaux de la sélection d’Algérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5465302c-95ba-4535-a646-2b0ce0f29569",
                                "sense_id": "3189afa0-5e36-34d1-90e6-02d0c117049b",
                                "text": "Sous l’égide du président Kheïreddine Zetchi, la fédération (FAF) avait même mis en place en mars 2020 la cellule FAF Radar."
                            },
                            {
                                "example_id": "f51c877b-6a98-49de-a4d8-8b7e4e628245",
                                "sense_id": "3189afa0-5e36-34d1-90e6-02d0c117049b",
                                "text": "L’équipe féminine de l’Algérie ne disputera pas les Jeux Olympiques de la catégorie en 2024 à Paris. Il ne s’agit pas là d’un problème lié à la formation, ni même d’une sanction, non, mais d’un oubli de la FAF !"
                            },
                            {
                                "example_id": "acfa6c29-6d14-4d6c-ad29-8ced54fa3dc3",
                                "sense_id": "3189afa0-5e36-34d1-90e6-02d0c117049b",
                                "text": "La FAF réagit à la participation d’une prétendue « équipe d’Algérie » à la Coupe du monde de mini-foot"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
