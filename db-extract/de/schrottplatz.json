                "senses": [
                    {
                        "sense_id": "3c07db45-dda5-39f3-9def-0171371f8f12",
                        "entry_id": "6309b1b6-4c47-33f7-b655-634ba70f2d3f",
                        "glosses": [
                            "Stelle, an der Schrott gesammelt, sortiert und weiterverkauft wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df178b30-1c6a-406b-990b-159fd98c012f",
                                "sense_id": "3c07db45-dda5-39f3-9def-0171371f8f12",
                                "text": "Auf dem Schrottplatz fand er die benötigten Ersatzteile für sein altes Auto."
                            },
                            {
                                "example_id": "38e33d3a-1f3d-4b92-9f85-9333fc33ccf4",
                                "sense_id": "3c07db45-dda5-39f3-9def-0171371f8f12",
                                "text": "„Der Schrottplatz dient zum Sammeln und zur Sortierung von Schrott jeglicher Art.“"
                            },
                            {
                                "example_id": "7f98c973-435a-447c-aa09-6100c3241ff1",
                                "sense_id": "3c07db45-dda5-39f3-9def-0171371f8f12",
                                "text": "„Eines Tages beschloss die Regierung eines amerikanischen Bundesstaates, inmitten einer Wüstenei einen riesigen Schrottplatz einzurichten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
