                        "entry_id": "26d9be58-805d-39e4-a6e4-f98c8f81fb6d",
                        "glosses": [
                            "The act by which any animal is milked."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "6b0f7a99-c1c6-4a49-851c-c52b286d6aa5",
                                "sense_id": "84f892db-0a4c-3660-bd82-3db1a5c05b46",
                                "text": "We try to finish milking early in the morning so we can turn the cows out to pasture during the day."
                            },
                            {
                                "example_id": "dd5b43f6-a378-4d03-b729-38df46e780ef",
                                "sense_id": "84f892db-0a4c-3660-bd82-3db1a5c05b46",
                                "text": "The snake milker massages the glands to extract the full measure of venom during each milking."
                            }
                        ]
                    },
                    {
                        "sense_id": "02176d4f-d905-3539-b792-3fb879e5293c",
                        "entry_id": "26d9be58-805d-39e4-a6e4-f98c8f81fb6d",
                        "glosses": [
                            "Male masturbation (or fellatio) that leads to the release of semen, especially when performed on a milking table."
                        ],
