                "senses": [
                    {
                        "sense_id": "08e7f2e0-f301-34c1-8982-1111b843abfd",
                        "entry_id": "bcea7325-44d7-319e-99fb-78cb8a3a725e",
                        "glosses": [
                            "Miete, die für den Zeitraum von einem Monat verlangt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b8745417-2c65-4efe-bdb6-e770782aef28",
                                "sense_id": "08e7f2e0-f301-34c1-8982-1111b843abfd",
                                "text": "Der Makler bekommt eine Vermittlungsprovision in der Höhe von drei Monatsmieten."
                            },
                            {
                                "example_id": "02b8b3fc-ae72-4b84-b68f-f4c92b43707a",
                                "sense_id": "08e7f2e0-f301-34c1-8982-1111b843abfd",
                                "text": "„Der Bundesgerichtshof in Karlsruhe (BGH) hat jetzt klargestellt, dass Vermieter die Wohnung bereits kündigen können, wenn mehr als eine Monatsmiete auf dem Konto fehlt – allerdings per fristgerechter Kündigung; dabei müssen die gesetzlichen oder die vereinbarten Fristen beachtet werden.“"
                            },
                            {
                                "example_id": "b8aaafc8-85d3-4968-83a6-8138692de742",
                                "sense_id": "08e7f2e0-f301-34c1-8982-1111b843abfd",
                                "text": "„Einen Teil ihres Lohns schickt sie ihrer Mutter, aber die Existenz dieses kleinen Bündels Banknoten, ein paar Monatsmieten, mehr ist es nicht, ist irgendwie rührend.“"
                            },
                            {
                                "example_id": "2a733206-7462-420d-bac5-7012f84e048e",
                                "sense_id": "08e7f2e0-f301-34c1-8982-1111b843abfd",
                                "text": "„Den Brief legte er zusammen mit einer Monatsmiete und einigen Landschaftsbildern auf den Küchentisch.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
