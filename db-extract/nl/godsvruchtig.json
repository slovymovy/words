                        "examples": [
                            {
                                "example_id": "f9707e05-dd83-48a1-9cd1-afaee1736e1f",
                                "sense_id": "9170bdf7-2f81-3c1c-9e53-54494ee0f27a",
                                "text": "Hij sprak over zielenheil, een ziel die er is, of je het nu gelooft of niet. Hij sprak als een godsvruchtig man. Hij zag eruit als een duivelaanbidder"
                            },
                            {
                                "example_id": "1085b85d-47a7-47fd-a123-7e3dd449e253",
                                "sense_id": "9170bdf7-2f81-3c1c-9e53-54494ee0f27a",
                                "text": "Het is de eerste Mariakapel ooit in de buurtschap die van oudsher een katholiek en godsvruchtig bolwerk is. In de Ageler Es staat al enkele honderden jaren een landkruis waar nog elk jaar door de Ageler boeren wordt gebeden om een goed gewas."
                            }
                        ]
                    }
