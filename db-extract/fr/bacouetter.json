                        "examples": [
                            {
                                "example_id": "8a5aa827-43e9-42df-8865-2e930f418511",
                                "sense_id": "3f65cd13-6042-3271-879a-9decdfcf0d0d",
                                "text": "Ben, vous êtes là à bacouetter tous les deux, comme deux amoureux, révérence parler, vu que vous en avez passé l’âge, bien sûr."
                            },
                            {
                                "example_id": "def07625-8c79-4984-b4de-e9294efc4d58",
                                "sense_id": "3f65cd13-6042-3271-879a-9decdfcf0d0d",
                                "text": "Fini de bacouetter, je vais me couler dans ce magasin, en face l’arrêt des cars, pour acheter une carte neuve à ma fille."
                            }
                        ]
                    }
