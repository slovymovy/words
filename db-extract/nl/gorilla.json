                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gorilla",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0d4a25cc-455e-3cfa-bb32-6332aac0f6bc",
                                        "entry_id": "1b821909-11ca-3327-a95c-10add3410e43",
                                        "glosses": [
                                            "The largest of the primates, belonging to the genus Gorilla; an ape native to the forests of central Africa and known for their trait of knuckle-walking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4579fa19-eba8-498e-8ad1-383fbad8af15",
                                                "sense_id": "0d4a25cc-455e-3cfa-bb32-6332aac0f6bc",
                                                "text": "In three of these twenty gorillæ 14 ribs are present, and the additional rib in each of them is below. […] The conclusion that the usual place of commencement of the dorsal type in the gorilla is between the 12th and 13th dorsal vertebræ is founded on notes taken of this character in 13 of these gorillæ."
                                            },
                                            {
                                                "example_id": "64665e1c-d652-4033-b823-3cfa26b3b269",
                                                "sense_id": "0d4a25cc-455e-3cfa-bb32-6332aac0f6bc",
                                                "text": "“They are wicked people—neither white like you nor black like me, but covered with hair as is Bolgani, the gorilla. Yes, they are very bad people indeed, and Chowambi was glad to get out of their country.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6be2c477-f5b7-306a-807a-bea33ebf6da9",
                                        "entry_id": "1b821909-11ca-3327-a95c-10add3410e43",
                                        "glosses": [
                                            "A big and brutish man or a thug; a goon or ruffian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80e1dd56-e2f7-4171-80f8-44eed2800133",
                                                "sense_id": "6be2c477-f5b7-306a-807a-bea33ebf6da9",
                                                "text": "\"I'll do the old gorilla the justice to say that he is open-handed with money.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1fc8070-4b18-3023-a05b-a2fd291ab22e",
                                        "entry_id": "1b821909-11ca-3327-a95c-10add3410e43",
                                        "glosses": [
                                            "A powerful person or organization; a heavyweight or behemoth."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77352f56-68ab-4d1d-b2a9-762fb5994d33",
                                                "sense_id": "a1fc8070-4b18-3023-a05b-a2fd291ab22e",
                                                "text": "The two industry gorillas — IBM and AT&T — will get together to decide who will provide different communications services, Biddle stated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be4a6f6f-87fc-34d5-a1ac-b41a8ff4d666",
                                        "entry_id": "1b821909-11ca-3327-a95c-10add3410e43",
                                        "glosses": [
                                            "1000 pounds sterling or dollar."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
