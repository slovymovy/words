{
    "word_family": [
        "utter"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "914ad404-cfe4-3d55-8601-0f8eedd12de7",
                    "sense_definition": "Situated at the most distant limit; farthest or outermost.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "extreme_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The explorers reached the <w>utmost</w> limits of the frozen land.",
                            "target_lang_translations": {
                                "pl": "Odkrywcy dotarli do <w>najdalszych</w> granic zamarzniętej krainy."
                            }
                        },
                        {
                            "text": "They traveled to the <w>utmost</w> edge of the remote island.",
                            "target_lang_translations": {
                                "pl": "Podróżowali do <w>skrajnego</w> krańca odległej wyspy."
                            }
                        }
                    ],
                    "synonyms": [
                        "outmost",
                        "uttermost",
                        "yondermost"
                    ],
                    "common_phrases": [
                        "utmost limit"
                    ],
                    "target_lang_definitions": {
                        "pl": "Położony w najbardziej oddalonym punkcie; najdalszy lub skrajny."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "najdalszy",
                                "target_lang_sense_clarification": "odnoszący się do fizycznej odległości lub krańca"
                            },
                            {
                                "target_lang_word": "skrajny",
                                "target_lang_sense_clarification": "odnoszący się do granicy lub krawędzi"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7ecc9e5-864e-3f8b-b694-6ed80cb2bca6",
                    "sense_definition": "The greatest or most extreme degree of something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extreme_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The situation requires the <w>utmost</w> care and attention from everyone.",
                            "target_lang_translations": {
                                "pl": "Sytuacja wymaga od wszystkich <w>najwyższej</w> troski i uwagi."
                            }
                        },
                        {
                            "text": "It is of the <w>utmost</w> importance that we finish this project today.",
                            "target_lang_translations": {
                                "pl": "To sprawa <w>najwyższej</w> wagi, abyśmy ukończyli ten projekt dzisiaj."
                            }
                        }
                    ],
                    "common_phrases": [
                        "utmost importance",
                        "utmost care"
                    ],
                    "target_lang_definitions": {
                        "pl": "Najwyższy lub najbardziej ekstremalny stopień czegoś."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "najwyższy",
                                "target_lang_sense_clarification": "używane w kontekście wagi, znaczenia lub jakości"
                            },
                            {
                                "target_lang_word": "ogromny",
                                "target_lang_sense_clarification": "używane w kontekście intensywności uczuć lub uwagi"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "03b09e9e-b204-39c0-906d-2f32023c093d",
                    "sense_definition": "The greatest possible capability, extent, or quantity.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "extreme_limit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried her <w>utmost</w> to finish the race despite her injury.",
                            "target_lang_translations": {
                                "pl": "Zrobiła <w>wszystko co w jej mocy</w>, aby ukończyć wyścig pomimo kontuzji."
                            }
                        },
                        {
                            "text": "The team was stretched to the <w>utmost</w> during the busy season.",
                            "target_lang_translations": {
                                "pl": "Zespół był wystawiony na <w>maksimum</w> swoich możliwości podczas pracowitego sezonu."
                            }
                        }
                    ],
                    "common_phrases": [
                        "try one's utmost",
                        "to the utmost"
                    ],
                    "target_lang_definitions": {
                        "pl": "Największa możliwa zdolność, zakres lub ilość."
                    },
                    "translations": {
                        "pl": [
                            {
                                "target_lang_word": "wszystko co w czyjejś mocy",
                                "target_lang_sense_clarification": "w kontekście wysiłku"
                            },
                            {
                                "target_lang_word": "maksimum",
                                "target_lang_sense_clarification": "w kontekście zakresu lub granicy możliwości"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}