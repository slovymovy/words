                        "glosses": [
                            "Schlagstock, der üblicherweise von indischen Ordnungskräften verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6b32168-c702-4c8c-a414-c4733b7b585c",
                                "sense_id": "4a328e0a-5299-3bcd-8f87-8e8eb8caf7cc",
                                "text": "„Ich bin unmöglich, dachte er, nicht Fisch, nicht Fleisch, und er drehte sich schuldbewusst zu den vier Polizisten um, die in identischer Haltung auf der Rückbank des Gypsy saßen, die zwei Gewehre und die zwei Lathis an die Brust gedrückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
