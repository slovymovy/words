                "senses": [
                    {
                        "sense_id": "9777da8d-1e22-3314-a3e0-3e8b222e372d",
                        "entry_id": "79470013-a450-3324-8d26-0424a156b795",
                        "glosses": [
                            "Zeitabschnitt, in dem etwas (zum Beispiel ein Feld) ungenutzt/leer ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745ef39f-ce0c-403f-9d80-00f79eab4f65",
                                "sense_id": "9777da8d-1e22-3314-a3e0-3e8b222e372d",
                                "text": "„Dies hatte Auswirkungen auf das Mikroklima, erhöhte das Risiko der Bodenerosion und auch das Risiko der Viehseuchen, denn nun wurden in der Brachezeit die Herden gemeinsam auf die Weide geführt.“"
                            },
                            {
                                "example_id": "5b32cd2d-8dd6-4058-bf7c-62b0e11ae436",
                                "sense_id": "9777da8d-1e22-3314-a3e0-3e8b222e372d",
                                "text": "„Offenbar leidet der Boden unter dem Fehlen von Naturdünger und einer ausreichenden Brachezeit.“"
                            },
                            {
                                "example_id": "2bbe6f6f-a191-4170-a2b5-ca6af8963730",
                                "sense_id": "9777da8d-1e22-3314-a3e0-3e8b222e372d",
                                "text": "„Darüber hinaus kann die langjährige Brachezeit kaum mehr eingehalten werden, was die Bodenqualität verschlechtert.“"
                            },
                            {
                                "example_id": "9da4ab54-312e-46fa-9b07-21c9628f7c6a",
                                "sense_id": "9777da8d-1e22-3314-a3e0-3e8b222e372d",
                                "text": "„Durch Luzernen wurde die Landnutzung in der Dreifelderwirtschaft intensiviert, denn in der Brachezeit konnten die Landwirte das Feld als Viehweide benutzen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
