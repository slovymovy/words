                "translations": [
                    {
                        "translation_id": "bd9b81cf-1845-448a-b7a3-87b75deb5963",
                        "source_entry_id": "c5385204-3fb5-376a-9499-beefe861f949",
                        "source_sense_id": "6fbc423d-906a-32eb-8d51-ae1447d91512",
                        "target_lang_word": "jaunir",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jaunir",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1529439b-09c8-3aa1-adfd-bc25232d62ef",
                                        "entry_id": "e9e861f8-eb17-3c6b-b1c9-9d2e07681208",
                                        "glosses": [
                                            "Rendre jaune, peindre ou teindre en jaune."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1841f30-95ae-4ed7-a951-06a97448e7d8",
                                                "sense_id": "1529439b-09c8-3aa1-adfd-bc25232d62ef",
                                                "text": "Quoique ses travaux à la Bibliothèque de la Ville échappassent à l’attention, il enfouissait dans son âme ses pensées de gloire, car elles pouvaient lui nuire ; mais il tenait encore plus profondément enseveli le secret de son cœur, une passion qui lui creusait les joues et lui jaunissait le front."
                                            },
                                            {
                                                "example_id": "59376cd1-ea91-4d38-a504-ad8b19b103d7",
                                                "sense_id": "1529439b-09c8-3aa1-adfd-bc25232d62ef",
                                                "text": "Albert.– Ah ! vous m’accusiez de faire la cour à madame Gargaret… tandis que vous jaunissiez les cheveux blancs de cet excellent marquis !…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                        "entry_id": "e9e861f8-eb17-3c6b-b1c9-9d2e07681208",
                                        "glosses": [
                                            "Devenir jaune."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "922cd151-a11e-4ba7-a346-df8dafa8c486",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "La comtesse était une grande femme maigre et se tenant fort droite, malgré son grand âge. Lucien remarqua que ses dentelles n’étaient point jaunies ; il avait en horreur les dentelles jaunies."
                                            },
                                            {
                                                "example_id": "5844fa1a-9e3a-49d0-840b-16f18eff5001",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "On récolte les échalotes lorsque les feuilles jaunissent ; on arrache les plants et on les laisse ressuyer deux ou trois jours sur le sol ; […]."
                                            },
                                            {
                                                "example_id": "ae8a838c-ad81-4e0d-9079-5cb0fc33356c",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "L’avoine et le blé jaunirent avant d’avoir atteint leur croissance."
                                            },
                                            {
                                                "example_id": "be1613f6-a866-4ab9-9f74-69f0a67e185e",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "Ces fruits commencent à jaunir."
                                            },
                                            {
                                                "example_id": "03172506-c716-4db2-97a2-9e9be1a8aac7",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "Les blés jaunissent."
                                            },
                                            {
                                                "example_id": "8b57ddfb-55b3-4852-b0bc-93589f493710",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "Toute la campagne jaunissait."
                                            },
                                            {
                                                "example_id": "c7cf1500-c737-4890-8deb-9d7d8d1d0877",
                                                "sense_id": "2dda16b0-2e82-3761-ad91-010a49787bf6",
                                                "text": "Les feuilles jaunies par l’automne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f602cbf5-43b0-3c67-b58c-4559bfe7bd89",
                                        "entry_id": "e9e861f8-eb17-3c6b-b1c9-9d2e07681208",
                                        "glosses": [
                                            "Prendre une teinte jaune sous l'effet du temps et de l'étude."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "383b55a7-c402-4d77-8466-bc0e6ad193e5",
                                                "sense_id": "f602cbf5-43b0-3c67-b58c-4559bfe7bd89",
                                                "text": ". – Et nous autres vieux rêveurs, quelle tache originelle avons-nous lavée sur la face humaine depuis quatre ou cinq mille ans que nous jaunissons avec nos livres ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
