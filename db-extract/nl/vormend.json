                                    {
                                        "sense_id": "e5b09b11-8890-30aa-889b-b1e383a46edd",
                                        "entry_id": "06ed4678-db2c-3e68-bb88-ba581f027414",
                                        "glosses": [
                                            "Capable of forming something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0bccc7f1-a59c-4126-ab4c-178e074f1717",
                                                "sense_id": "e5b09b11-8890-30aa-889b-b1e383a46edd",
                                                "text": "[I]ts thought, that, in the Seed are alvvaies potentially ſeuerall indiuiduating Qualities deriu'd from diuers of the neere Anceſtors, vvhich by the formatiue povver of the Parents may be expreſt in the Children, vvith reſpectiue habitude to either Sex; […]"
                                            },
                                            {
                                                "example_id": "85caec2c-0605-46e2-96ba-2f7a88951ad6",
                                                "sense_id": "e5b09b11-8890-30aa-889b-b1e383a46edd",
                                                "text": "Hybrids, […] have their reproductive organs functionally impotent, as may be clearly seen in the state of the male element in both plants and animals; though the formative organs themselves are perfect in structure, as far as the microscope reveals."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cc06796e-58b6-36cc-8907-326f12e1d222",
                                        "entry_id": "06ed4678-db2c-3e68-bb88-ba581f027414",
                                        "glosses": [
                                            "Capable of forming something.",
                                            "Capable of producing new tissue."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f977d5b3-4411-37ab-95b3-41f4aa40298e",
                                        "entry_id": "06ed4678-db2c-3e68-bb88-ba581f027414",
                                        "glosses": [
                                            "Capable of forming something.",
                                            "Pertaining to the formation of words; specifically, of an affix: forming words through inflection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "391bd9f4-00cf-3e54-8ace-5d610a436c9f",
                                        "entry_id": "06ed4678-db2c-3e68-bb88-ba581f027414",
                                        "glosses": [
                                            "Of or pertaining to the formation and subsequent growth of something."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43972dd2-4de9-47b0-a0e1-1fa31a0c5e8e",
                                                "sense_id": "391bd9f4-00cf-3e54-8ace-5d610a436c9f",
                                                "text": "My formative years were spent in an inner city."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d8b514b7-005d-30f8-bc49-499bad67783b",
                                        "entry_id": "06ed4678-db2c-3e68-bb88-ba581f027414",
                                        "glosses": [
                                            "Of a form of assessment: used to guide learning rather than to quantify educational outcomes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "formative",
