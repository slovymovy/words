                    {
                        "translation_id": "36fc06f2-99e5-4ed0-9508-778fc1f7fd86",
                        "source_entry_id": "c47e322a-1050-3619-bfdf-a291aa303644",
                        "source_sense_id": "7b94a84e-ccb6-3e2c-9a5c-e6eb239df046",
                        "target_lang_word": "dirty",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dirty",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1aa037f9-7c87-3f1f-91eb-db8dcbf0d70d",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Unclean; covered with or containing unpleasant substances such as dirt or grime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ab6174dd-cd41-4f54-a7e8-106b2d515414",
                                                "sense_id": "1aa037f9-7c87-3f1f-91eb-db8dcbf0d70d",
                                                "text": "Despite a walk in the rain, my shoes weren't too dirty."
                                            },
                                            {
                                                "example_id": "5a483721-98ff-4d8a-adeb-525b441ee31b",
                                                "sense_id": "1aa037f9-7c87-3f1f-91eb-db8dcbf0d70d",
                                                "text": "Many persons are more comfortable when they are dirty than when they are clean; but that does not recommend dirt as a national policy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e5207a65-d707-3466-bcec-1b63117aed5f",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "That makes one unclean; corrupting, infecting."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6d165c9-a513-4717-8084-54c33e875bbc",
                                                "sense_id": "e5207a65-d707-3466-bcec-1b63117aed5f",
                                                "text": "Don't put that in your mouth, dear. It's dirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf5348df-0c8e-3d58-82d5-8ba204ff0ac4",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Morally unclean; obscene or indecent, especially sexually."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "577e37c1-a7cc-4db9-80c2-3cfee768d621",
                                                "sense_id": "bf5348df-0c8e-3d58-82d5-8ba204ff0ac4",
                                                "text": "At the reception, Uncle Nick got drunk and told dirty jokes to the bridesmaids."
                                            },
                                            {
                                                "example_id": "0a983913-0bb4-4c7e-863d-de5a3c4f4e36",
                                                "sense_id": "bf5348df-0c8e-3d58-82d5-8ba204ff0ac4",
                                                "text": "We have quite a playful and fun relationship in general, but it’s still surprising how dirty our sex can be in the things we say or do or pretend. We often laugh about it afterwards."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c05fa53-11da-384a-987f-270a03b5344f",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Dishonorable; violating accepted standards or rules."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb98b5db-1490-4fe6-b977-5f75136377ff",
                                                "sense_id": "5c05fa53-11da-384a-987f-270a03b5344f",
                                                "text": "He might have scored, but it was a dirty trick that won him the penalty."
                                            },
                                            {
                                                "example_id": "0f2b7914-bcd7-4dcf-9b92-75ce41b566f8",
                                                "sense_id": "5c05fa53-11da-384a-987f-270a03b5344f",
                                                "text": "The world 'as got me snouted jist a treat; Crool Forchin's dirty left 'as smote me soul."
                                            },
                                            {
                                                "example_id": "c48cd87f-687b-4f85-9f68-f9f86497d101",
                                                "sense_id": "5c05fa53-11da-384a-987f-270a03b5344f",
                                                "text": "The dirty secret of the internet is that all this distraction and interruption is immensely profitable.[…]Partly, this is a result of how online advertising has traditionally worked: advertisers pay for clicks, and a click is a click, however it's obtained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a0ea0d4-6766-3b17-a315-bcc3f86f39b0",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Corrupt, illegal, or improper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "820e2100-7c68-4c5b-884a-e4474b2677b4",
                                                "sense_id": "8a0ea0d4-6766-3b17-a315-bcc3f86f39b0",
                                                "text": "I won't accept your dirty money!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70f5f15d-b43e-3010-8987-df74e584cfa4",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Out of tune."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4667aade-874b-4781-9a75-1f8a8e5fd287",
                                                "sense_id": "70f5f15d-b43e-3010-8987-df74e584cfa4",
                                                "text": "You need to tune that guitar: the G string sounds dirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9be1f7a-d8d7-377f-a7f3-8ef9a6e88148",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of color, discolored by impurities."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3bcd8cd6-d431-4da2-8b6d-92043061aa78",
                                                "sense_id": "f9be1f7a-d8d7-377f-a7f3-8ef9a6e88148",
                                                "text": "The old flag was a dirty white."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9f6ac6f-d7ed-3eec-8dc7-f5fde2937dd4",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Containing data needing to be written back to memory or disk."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "478e7622-7812-4f6e-854d-6c6905fd2998",
                                                "sense_id": "c9f6ac6f-d7ed-3eec-8dc7-f5fde2937dd4",
                                                "text": "Occasionally it reads the sector into a dirty buffer, which means it needs to sync the dirty buffer first."
                                            },
                                            {
                                                "example_id": "9dc7b50f-ac5a-407b-bcbb-c2f820659138",
                                                "sense_id": "c9f6ac6f-d7ed-3eec-8dc7-f5fde2937dd4",
                                                "text": "Notice that an asterisk has been added to the filename in the edit window tabs. This is a simple reminder that the file is “dirty” and needs saving."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e4f3c26-cdd6-3491-9d32-81dea657fca4",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Carrying illegal drugs among one's possessions or inside of one's bloodstream."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "06c44723-cc31-4d11-8494-db3cbca6e70d",
                                                "sense_id": "1e4f3c26-cdd6-3491-9d32-81dea657fca4",
                                                "text": "None of y'all get into my car if you're dirty."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe6406b5-76be-3e39-900d-7ed2d42b9c2f",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Used as an intensifier, especially in conjunction with \\\"great\\\"."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b6f0f52-9185-4987-8f9e-621452578792",
                                                "sense_id": "fe6406b5-76be-3e39-900d-7ed2d42b9c2f",
                                                "text": "He lives in a dirty great mansion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Sleety; gusty; stormy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4311143a-b003-473a-851b-00109dcb62fa",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "dirty weather"
                                            },
                                            {
                                                "example_id": "dd12b51e-b902-48c3-9e07-5e96384e637d",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "Storms of wind, clouds of dust, an angry, dirty sea."
                                            },
                                            {
                                                "example_id": "96a411d7-a38e-4662-bdcb-236a619c61c7",
                                                "sense_id": "efc97cc5-6b12-309e-85d0-d1f9898ed4ed",
                                                "text": "Rain type 17 was a dirty blatter battering against his windscreen so hard that it didn't make much odds whether he had his wipers on or off."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03b5f603-bbbc-308b-b470-c3b05abfd4f1",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of an alcoholic beverage, especially a cocktail or mixed drink: served with the juice of olives."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "77250346-07f0-468d-8976-3d8c15d1d2bd",
                                                "sense_id": "03b5f603-bbbc-308b-b470-c3b05abfd4f1",
                                                "text": "dirty martini"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of food, indulgent in an unhealthy way."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3d280c1c-1fc8-4807-9447-db1bd28a8adb",
                                                "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                                "text": "You can call it quick-and-dirty if you like, but there are billions of dollars out there riding on the supposition that fast food is not necessarily dirty food."
                                            },
                                            {
                                                "example_id": "6fbb4055-7e45-4056-aded-d812c31249d3",
                                                "sense_id": "9aeef58f-1224-3797-9597-f0fe46bd55ec",
                                                "text": "Dirty keto refers to an approach that follows the typical keto macro ratios, but the components include “dirty” foods like fast food, packaged convenience foods, processed meats, artificially sweetened diet sodas and sports drinks, and unhealthy […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                        "entry_id": "f6524f0b-e1a1-3622-8fa2-c949b9fbaff0",
                                        "glosses": [
                                            "Of food, covered in an array of indulgent toppings."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db11af5c-d352-4af2-816a-219789baffea",
                                                "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                                "text": "Lardo in Portland, Oregon, serves \"dirty fries\" topped with fried rosemary, peppers, lardons, and Parmesan."
                                            },
                                            {
                                                "example_id": "b270dbcd-1d68-40f9-8718-05c2a43a056f",
                                                "sense_id": "d21aec0c-4e77-344a-b5ad-ada1f4ab65c7",
                                                "text": "Piled high and oozing all the trimmings, the dirty burgers here are decidedly good – spice things up with jalapeños, brie or a seriously sticky BBQ sauce."
                                            }
                                        ]
                                    },
