                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d19a554-a5b7-44d9-9dd6-28de3305bcbd",
                                "sense_id": "89e331ec-b65a-3d47-a333-b57f0459fd0c",
                                "text": "„Offenbar hat Michael Schumacher bei seinem schweren Sturz eine Helmkamera getragen.“"
                            },
                            {
                                "example_id": "12690f5b-37d6-4035-b9b9-1226e8173831",
                                "sense_id": "89e331ec-b65a-3d47-a333-b57f0459fd0c",
                                "text": "„Der Flug wurde durch eine Helmkamera und begleitende Helikopter dokumentiert.“"
                            },
                            {
                                "example_id": "cb8753b8-b123-486b-884c-6fdb5b890ef9",
                                "sense_id": "89e331ec-b65a-3d47-a333-b57f0459fd0c",
                                "text": "„Einem Radfahrer aus Deutschland wurde seine Helmkamera nämlich genau deswegen zum Verhängnis: Eigentlich wollte er durch die Vorlage eines Videos seine eigene Unschuld beweisen. Im Endeffekt bewies er damit aber genau das Gegenteil und wurde schuldig gesprochen.“"
                            }
                        ],
