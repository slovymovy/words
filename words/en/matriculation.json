{
    "word_family": [
        "matriculate",
        "matriculant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "cb2c27bd-c1a5-38e2-ae55-af49bb1d4939",
                    "sense_definition": "The process of enrolling as a student in a college or university.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "academic_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The university requires all new students to complete their <w>matriculation</w> before the start of the semester.",
                            "target_lang_translations": {
                                "zh": "大学要求所有新生在学期开始前完成<w>入学注册</w>。"
                            }
                        },
                        {
                            "text": "She felt a sense of pride during her <w>matriculation</w> ceremony at the university.",
                            "target_lang_translations": {
                                "zh": "在大学的<w>入学</w>典礼上，她感到非常自豪。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enrollment",
                        "registration"
                    ],
                    "common_phrases": [
                        "matriculation ceremony",
                        "complete matriculation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指学生在大学或学院正式注册入学的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "入学注册",
                                "target_lang_sense_clarification": "指学生办理正式入学手续的过程。"
                            },
                            {
                                "target_lang_word": "注册",
                                "target_lang_sense_clarification": "指在学校登记成为在校生的行为。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f720cd40-fd25-3a11-a9fa-be53ac36d06c",
                    "sense_definition": "A successful result in specific university entrance or qualifying examinations.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "academic_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He celebrated his <w>matriculation</w> after passing the final entrance exams with high marks.",
                            "target_lang_translations": {
                                "zh": "他在以高分通过最终入学考试后，庆祝自己获得了<w>入学资格</w>。"
                            }
                        },
                        {
                            "text": "The <w>matriculation</w> results were posted on the main notice board for all candidates to see.",
                            "target_lang_translations": {
                                "zh": "<w>入学考试</w>结果已张贴在主公告栏上，供所有考生查看。"
                            }
                        }
                    ],
                    "synonyms": [
                        "qualification"
                    ],
                    "common_phrases": [
                        "matriculation results"
                    ],
                    "target_lang_definitions": {
                        "zh": "指在大学入学考试或资格考试中取得合格成绩。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "入学资格",
                                "target_lang_sense_clarification": "指通过考试后获得的进入大学的资格。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c62ef45f-2a34-3287-9c98-e12d86e79060",
                    "sense_definition": "The official registration or recording of armorial bearings or coats of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family sought the <w>matriculation</w> of their ancient coat of arms with the heraldic authority.",
                            "target_lang_translations": {
                                "zh": "该家族向纹章管理机构申请对其古老纹章进行<w>注册</w>。"
                            }
                        },
                        {
                            "text": "Proper <w>matriculation</w> ensures that the armorial bearings are legally recognized and protected.",
                            "target_lang_translations": {
                                "zh": "妥善的<w>纹章注册</w>能确保这些徽章受到法律认可与保护。"
                            }
                        }
                    ],
                    "synonyms": [
                        "registration"
                    ],
                    "target_lang_definitions": {
                        "zh": "指对纹章或家族徽章进行官方登记或记录。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "纹章注册",
                                "target_lang_sense_clarification": "指纹章学中对徽章的官方登记。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}