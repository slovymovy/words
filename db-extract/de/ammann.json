                ],
                "senses": [
                    {
                        "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                        "entry_id": "648ca30d-0d70-3f0f-88ec-e284b815c0cf",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "201aed5a-c89f-443c-b12c-a0408d62e954",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Frau Ammann ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2892bcce-fbd4-4f83-97bc-0ed84062cebb",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Herr Ammann wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "bc93d3d9-d3c2-48a1-a7cf-b264498987fb",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Die Ammanns fahren heute nach Rotterdam."
                            },
                            {
                                "example_id": "3d61acd8-9acc-430c-9d8b-027d4522c02f",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Der Ammann trägt nie die Pullover, die die Ammann ihm strickt."
                            },
                            {
                                "example_id": "a6fdcfa4-c0ee-437e-a343-0029a32b2d2a",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ammann kommt, geht der Herr Ammann.“"
                            },
                            {
                                "example_id": "68f3ab1f-ce78-4ad2-b079-f9935d0380c3",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Ammann kommt und geht."
                            },
                            {
                                "example_id": "678309a0-b8b6-4ff5-9603-3bb4ad8c56a0",
                                "sense_id": "9c49ea68-a881-3f24-ad30-602a8312d04d",
                                "text": "Ammanns kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
