                    "sense_id": "fc7fd705-c3a0-381e-b4df-c244243445df",
                    "sense_definition": "In a manner that represents the sounds of speech rather than standard spelling.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "manner",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The difficult words in the textbook were written <w>phonetically</w> to help students with pronunciation.",
                            "target_lang_translations": {
                                "zh": "教科书里的生词都<w>按发音</w>标注了，以帮助学生掌握读音。"
                            }
                        },
                        {
                            "text": "He spelled his name <w>phonetically</w> so the clerk would write it down correctly.",
                            "target_lang_translations": {
                                "zh": "他<w>根据读音</w>拼出了自己的名字，好让办事员能准确地写下来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "soundly"
                    ],
                    "target_lang_definitions": {
                        "zh": "以反映语音而非标准拼写的方式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "按发音",
