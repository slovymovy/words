                        "examples": [
                            {
                                "example_id": "e3cc171c-014a-4b89-bd39-2fb59d97fcdf",
                                "sense_id": "aa3f12c8-f677-32a1-9000-ec84f49f9540",
                                "text": "Whenever the Bobbies heard my step on the long outside stair, every body electrified. Tongues drew in, ears squared, noses lifted. The peer from all the eyes under all the bangs of crimpy hair concentrated into one enormous “looking,” riveted upon the turning of the stair where I would first show."
                            },
                            {
                                "example_id": "d74b5417-42a8-431e-9af9-31fd982be94f",
                                "sense_id": "aa3f12c8-f677-32a1-9000-ec84f49f9540",
                                "text": "“I can't see if you do that,” Margaret said, disengaging the earpiece of her glasses and a clump of her red, crimpy hair from the baby's fist […]."
                            },
                            {
                                "example_id": "04e6addd-bb71-47d0-b43d-0cee5e1b0327",
                                "sense_id": "aa3f12c8-f677-32a1-9000-ec84f49f9540",
                                "text": "the crimpy wool of the Saxony sheep"
