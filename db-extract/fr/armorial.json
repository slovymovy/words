                "senses": [
                    {
                        "sense_id": "778b2a6a-f05f-3bf8-ac00-ef23cb924b92",
                        "entry_id": "263a8743-5178-3f42-9832-e63b409db44e",
                        "glosses": [
                            "Livre contenant les armoiries de la noblesse d’un royaume, d’une province."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3bc59162-783c-44fc-ad2d-a7d7830bf0de",
                                "sense_id": "778b2a6a-f05f-3bf8-ac00-ef23cb924b92",
                                "text": "Le roi Jean leur confirma, en 1357, leurs privilèges et, au début du XVᵉ siècle, leurs armes furent enregistrées à l’armorial général."
                            },
                            {
                                "example_id": "bfda4f9c-ef8f-412e-8b80-a6e79faf7bab",
                                "sense_id": "778b2a6a-f05f-3bf8-ac00-ef23cb924b92",
                                "text": "L’armorial de France."
                            },
                            {
                                "example_id": "845277e0-aa3c-47cc-968e-8d07be388826",
                                "sense_id": "778b2a6a-f05f-3bf8-ac00-ef23cb924b92",
                                "text": "L’armorial d’Espagne."
                            },
                            {
                                "example_id": "93239f9f-43c3-43ee-b9bd-12a6b0f32bb5",
                                "sense_id": "778b2a6a-f05f-3bf8-ac00-ef23cb924b92",
                                "text": "Armorial de Normandie, de Bretagne, du Dauphiné, etc."
                            }
                        ]
                    },
                    {
                        "sense_id": "ada04e8c-e721-3b84-9309-858d6169149d",
                        "entry_id": "263a8743-5178-3f42-9832-e63b409db44e",
                        "glosses": [
                            "L’ensemble des noms contenus dans un tel livre."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "f0fb4901-11aa-422f-bab6-809887948e5b",
                                "sense_id": "ada04e8c-e721-3b84-9309-858d6169149d",
                                "text": "Une partie de l’armorial de l’armée française n’hésite pas à participer à la collecte qui prend le caractère d’un défi."
                            }
                        ]
                    }
                ],
