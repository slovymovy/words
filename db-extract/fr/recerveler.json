                "senses": [
                    {
                        "sense_id": "e6ffc08e-7521-3db9-b2d2-8e78c9652470",
                        "entry_id": "30fe8b5f-5e8d-32ae-847c-2bf1f3928827",
                        "glosses": [
                            "Reconstituer le cerveau de (quelqu’un qui avait été décervelé)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4fa21cd-7a04-4c7a-b661-ee63bf07c660",
                                "sense_id": "e6ffc08e-7521-3db9-b2d2-8e78c9652470",
                                "text": "C'est bien dommage mais ce n'est pas évident de recerveler les décervelés."
                            },
                            {
                                "example_id": "e1f447b5-77b7-4d38-8b2f-53cf01c29dca",
                                "sense_id": "e6ffc08e-7521-3db9-b2d2-8e78c9652470",
                                "text": "Décerveler pour recerveler, voilà une formule que je proposerais volontiers, comme exprimant les ambitions conjuguées de MM. Daudet et Pujo (décervelage) et de MM. Maurras et Bainville (recervelage)."
                            },
                            {
                                "example_id": "c689513b-0785-4fa1-bfd5-b53ca745e65b",
                                "sense_id": "e6ffc08e-7521-3db9-b2d2-8e78c9652470",
                                "text": "J’ai actionné, pour ma génération, la manette de la machine à recerveler."
                            }
                        ]
                    }
