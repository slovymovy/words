                                        "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To place to the side(s) of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e3cd8a2-abbb-4791-8a7d-a1f8ff40b756",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "Stately colonnades are flank'd with trees."
                                            },
                                            {
                                                "example_id": "5d1ddcbb-e4af-43c0-a24b-2dd62cde0f2f",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "[...] Mr. M. N. Rollason points out that on four-track lines on which the fast lines, in the centre, are flanked by the slow lines, and running at speed is permissible on all four, the traveller can enjoy some quite exciting experiences when trains are doing a \"neck-and-neck\" on adjacent lines."
                                            },
                                            {
                                                "example_id": "d7aaef51-f5ac-4010-850a-57b35fb4a549",
                                                "sense_id": "14889803-3f7a-36fb-9c42-139aeb693fe2",
                                                "text": "It was a rural railway that served the fertile Fens of Cambridgeshire and Norfolk. But because it flanked public roads and was unfenced (to save costs), it was deemed a tramway and its locomotives had to be fitted with a cowcatcher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a771d42e-8502-371d-9a39-35845362cbf9",
                                        "entry_id": "61201eca-3252-3810-a0de-b109a24f90cf",
                                        "glosses": [
                                            "To be placed to the side(s) of something (usually in terms of two objects, one on each side)."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
