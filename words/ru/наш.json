{
    "word_family": [
        "по-нашему",
        "нашенский"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "729dfed6-45c9-3c58-8c2e-b587a8de5de9",
                    "sense_definition": "Принадлежащий нам или имеющий отношение к нам.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Это <w>наш</w> новый дом.",
                            "target_lang_translations": {
                                "en": "This is <w>our</w> new house.",
                                "zh": "这是<w>我们的</w>新家。"
                            }
                        },
                        {
                            "text": "<w>Наши</w> дети ходят в одну школу.",
                            "target_lang_translations": {
                                "en": "<w>Our</w> children go to the same school.",
                                "zh": "<w>我们的</w>孩子在同一所学校上学。"
                            }
                        },
                        {
                            "text": "Мы защищаем <w>нашу</w> страну.",
                            "target_lang_translations": {
                                "en": "We are defending <w>our</w> country.",
                                "zh": "我们正在保卫<w>我们的</w>国家。"
                            }
                        }
                    ],
                    "antonyms": [
                        "ваш",
                        "их",
                        "чужой"
                    ],
                    "common_phrases": [
                        "наш дом",
                        "наша страна",
                        "наше время",
                        "наш город"
                    ],
                    "target_lang_definitions": {
                        "en": "Belonging to us or relating to us.",
                        "zh": "属于我们或与我们有关的。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "our",
                                "target_lang_sense_clarification": "determiner indicating possession"
                            },
                            {
                                "target_lang_word": "ours",
                                "target_lang_sense_clarification": "pronoun indicating possession"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "我们的",
                                "target_lang_sense_clarification": "表示所属关系的代词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf399b98-dfba-3aa0-9645-c75980f85846",
                    "sense_definition": "Тот, о котором идёт речь; упоминаемый или подразумеваемый в данном контексте.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "contextual",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "А вот и <w>наш</w> герой вернулся.",
                            "target_lang_translations": {
                                "en": "And here <w>our</w> hero has returned.",
                                "zh": "看，<w>我们的</w>英雄回来了。"
                            }
                        },
                        {
                            "text": "<w>Наш</w> пациент чувствует себя намного лучше.",
                            "target_lang_translations": {
                                "en": "<w>Our</w> patient is feeling much better.",
                                "zh": "<w>我们的</w>病人感觉好多了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "наш герой",
                        "наш случай",
                        "наш клиент"
                    ],
                    "target_lang_definitions": {
                        "en": "The one being discussed; mentioned or implied in the given context.",
                        "zh": "指代在当前语境中被提及或暗示的人或事物。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "our",
                                "target_lang_sense_clarification": "referring to a specific person mentioned or implied"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "我们的",
                                "target_lang_sense_clarification": "用于指代特定语境中的人或物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9dbca003-ad08-3473-b09d-127fe1d5a917",
                    "sense_definition": "Близкие нам люди: родственники, друзья, соотечественники или солдаты своей армии.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "people_group",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вчера <w>наши</w> выиграли важный матч.",
                            "target_lang_translations": {
                                "en": "Yesterday <w>our team</w> won an important match.",
                                "zh": "昨天<w>我们的人</w>赢了一场重要的比赛。"
                            }
                        },
                        {
                            "text": "Скоро <w>наши</w> вернутся с дачи.",
                            "target_lang_translations": {
                                "en": "Soon <w>our folks</w> will return from the dacha.",
                                "zh": "很快<w>我们的人</w>就会从别墅回来了。"
                            }
                        },
                        {
                            "text": "Он сразу стал для нас <w>нашим</w>.",
                            "target_lang_translations": {
                                "en": "He immediately became one of <w>us</w>.",
                                "zh": "他很快就成了<w>我们自己人</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "чужой",
                        "враг"
                    ],
                    "common_phrases": [
                        "наши победили",
                        "и вашим и нашим"
                    ],
                    "target_lang_definitions": {
                        "en": "People close to us: relatives, friends, compatriots, or soldiers of one's own army.",
                        "zh": "与我们关系亲近的人：亲戚、朋友、同胞或自己一方的士兵。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ours",
                                "target_lang_sense_clarification": "referring to one's own group, team, or troops"
                            },
                            {
                                "target_lang_word": "our people",
                                "target_lang_sense_clarification": "relatives, friends, or compatriots"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "我们的人",
                                "target_lang_sense_clarification": "指代属于同一群体、团队或阵营的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4659190a-7c0d-37f0-85ac-75a5bb871701",
                    "sense_definition": "То, что принадлежит нам, свойственно нам или является нашей долей.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "substantivized_property",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>нашего</w> никому не отдадим.",
                            "target_lang_translations": {
                                "en": "We won't give <w>ours</w> to anyone.",
                                "zh": "我们不会把<w>属于我们的东西</w>给任何人。"
                            }
                        },
                        {
                            "text": "Поживи с <w>наше</w>, тогда и будешь судить.",
                            "target_lang_translations": {
                                "en": "Live as long as <w>us</w>, then you can judge.",
                                "zh": "等你像<w>我们</w>一样经历过这些，再来评判吧。"
                            }
                        }
                    ],
                    "antonyms": [
                        "чужой"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "That which belongs to us, is characteristic of us, or is our share.",
                        "zh": "属于我们的东西、我们的份额或我们的特质。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ours",
                                "target_lang_sense_clarification": "that which belongs to us"
                            },
                            {
                                "target_lang_word": "what is ours",
                                "target_lang_sense_clarification": "our property or share"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "我们的东西",
                                "target_lang_sense_clarification": "指代属于我们的财产或份额"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ea2d2dc1-497d-312b-a6cf-433b00f06139",
                    "sense_definition": "Старинное название буквы «Н» в кириллице.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "alphabet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В старой азбуке эта буква называлась <w>наш</w>.",
                            "target_lang_translations": {
                                "en": "In the old alphabet, this letter was called <w>nash</w>.",
                                "zh": "在旧字母表中，这个字母被称为<w>纳什</w>。"
                            }
                        },
                        {
                            "text": "Ученик с трудом выводил на бумаге <w>наш</w>.",
                            "target_lang_translations": {
                                "en": "The student struggled to write <w>nash</w> on the paper.",
                                "zh": "学生费力地在纸上写着<w>纳什</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        },
                        {
                            "trait_type": "dated",
                            "comment": "historical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The old name for the letter \"N\" in the Cyrillic alphabet.",
                        "zh": "西里尔字母中字母“Н”的古称。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nash",
                                "target_lang_sense_clarification": "historic name of the Cyrillic letter"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纳什",
                                "target_lang_sense_clarification": "西里尔字母名称的音译"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f083642f-7e99-3699-8a82-e07a4c2ee945",
                    "sense_definition": "Мужское имя.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Моего иностранного друга зовут <w>Наш</w>.",
                            "target_lang_translations": {
                                "en": "My foreign friend is called <w>Nash</w>.",
                                "zh": "我的外国朋友叫<w>纳什</w>。"
                            }
                        },
                        {
                            "text": "<w>Наш</w> приехал в город вчера вечером.",
                            "target_lang_translations": {
                                "en": "<w>Nash</w> arrived in town last night.",
                                "zh": "<w>纳什</w>昨天晚上到了城里。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A male name.",
                        "zh": "男性名字。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "Nash",
                                "target_lang_sense_clarification": "given name"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "纳什",
                                "target_lang_sense_clarification": "人名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}