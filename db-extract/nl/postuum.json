                "senses": [
                    {
                        "sense_id": "8b4f5dd1-fe5f-3987-8409-a2e43f45a336",
                        "entry_id": "af17eede-1fc9-34a5-aa20-e7d91d57e372",
                        "glosses": [
                            "na het overlijden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "983cdf1c-9667-4ab7-9e39-6bf23db1c7f5",
                                "sense_id": "8b4f5dd1-fe5f-3987-8409-a2e43f45a336",
                                "text": "De ridderorde was een postuum eerbewijs voor de heldhaftige man die zovele mensen had gered."
                            },
                            {
                                "example_id": "1281e4c9-54ed-48aa-aefd-369bff73b357",
                                "sense_id": "8b4f5dd1-fe5f-3987-8409-a2e43f45a336",
                                "text": "Ook wil ik Eefje Brugman postuum bedanken voor het vertrouwen dat ze vanaf het begin in dit boek had."
                            }
                        ]
                    },
                    {
                        "sense_id": "56c185dc-b2a0-3040-9a1e-54e662d71ff6",
                        "entry_id": "af17eede-1fc9-34a5-aa20-e7d91d57e372",
                        "glosses": [
                            "gepubliceerd na het overlijden van de auteur of componist"
                        ],
                        "tags": [
                            "van een werk"
                        ],
                        "examples": [
                            {
                                "example_id": "166d7ff1-7cf2-4226-bc42-456cc9b129b8",
                                "sense_id": "56c185dc-b2a0-3040-9a1e-54e662d71ff6",
                                "text": "Een postuum solostuk van Chopin."
                            },
                            {
                                "example_id": "2494f465-6604-40de-afc7-26efce87c694",
                                "sense_id": "56c185dc-b2a0-3040-9a1e-54e662d71ff6",
                                "text": "Bij de uitgeverij van het Vaticaan is ook een postuum boek van Benedictus XVI verschenen."
                            }
                        ]
                    }
