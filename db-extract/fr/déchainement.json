                        "entry_id": "c7f1766d-b187-3bd1-984e-c8c7327ad0fa",
                        "glosses": [
                            "Action de déchainer, de se déchainer ; résultat de cette action."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19f158da-0e96-4c6d-8c03-14dd43e333f5",
                                "sense_id": "e900ba18-2a62-32ba-8d1d-c4ea8043f2a5",
                                "text": "Il est dans un perpétuel déchainement contre vous."
                            },
                            {
                                "example_id": "408c6741-bd40-432d-af90-c8cec961e231",
                                "sense_id": "e900ba18-2a62-32ba-8d1d-c4ea8043f2a5",
                                "text": "Ce fut contre lui un déchainement d’attaques, d’injures, de calomnies."
                            },
                            {
                                "example_id": "b882719f-ca50-4087-9b1f-6d6dfe2d0bf3",
                                "sense_id": "e900ba18-2a62-32ba-8d1d-c4ea8043f2a5",
                                "text": "Le déchainement de l’opinion."
                            },
                            {
                                "example_id": "e31fd329-2ce1-486a-9a5b-d31b56005f3d",
                                "sense_id": "e900ba18-2a62-32ba-8d1d-c4ea8043f2a5",
                                "text": "Le déchainement des flots, de la tempête."
                            }
                        ]
                    }
