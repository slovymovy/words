                "senses": [
                    {
                        "sense_id": "a69f6af0-c7a6-32a2-b2d1-c2e35f7973d7",
                        "entry_id": "57b05bc2-ae1e-3a60-9c36-f959009564e2",
                        "glosses": [
                            "(Maschinen-)Element aus Polymer zum Abdichten von Etwas; Material zum Abdichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39992682-8818-4c56-baec-372b1217dacd",
                                "sense_id": "a69f6af0-c7a6-32a2-b2d1-c2e35f7973d7",
                                "text": "„Die Stellklappe mit Kunststoffdichtung schließt luftdicht gemäß DIN EN 1751, Klasse 4 (NW 125 Klasse 3) .“"
                            },
                            {
                                "example_id": "8549013f-bd55-4b5d-9340-261a39882e0d",
                                "sense_id": "a69f6af0-c7a6-32a2-b2d1-c2e35f7973d7",
                                "text": "„Die einzige Kunststoffdichtung ist eine Kolbendichtung aus UHMWPE (Ultra High Molecular Weight Polyethylene). Die einzige Kunststoffdichtung ist ein Teflonring zur Abdichtung des Homogenisierventilsystems.“"
                            },
                            {
                                "example_id": "51636547-40f2-4bc4-9f3d-cc655a87eea5",
                                "sense_id": "a69f6af0-c7a6-32a2-b2d1-c2e35f7973d7",
                                "text": "„Der Stoff entstehe beim Aufschäumen von Kunststoffdichtungen in Metalldeckeln, schreibt die Stiftung in ihrem März-Heft.“"
                            },
                            {
                                "example_id": "0fada7d8-cfc4-47b5-8a62-d4c88a28bebc",
                                "sense_id": "a69f6af0-c7a6-32a2-b2d1-c2e35f7973d7",
                                "text": "„Kronkorken werden aus Weißblech gestanzt, bedruckt und mit einer Kunststoffdichtung versehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
