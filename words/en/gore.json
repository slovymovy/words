                        {
                            "text": "The community of <w>Gore</w> is located near the river.",
                            "target_lang_translations": {
                                "ru": "Община <w>Гор</w> расположена недалеко от реки.",
                                "de": "Die Gemeinde <w>Gore</w> liegt in der Nähe des Flusses."
                            }
                        }
