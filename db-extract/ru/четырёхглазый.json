                                "target_senses": [
                                    {
                                        "sense_id": "a6cb1195-ced3-3c40-a148-487046e6b886",
                                        "entry_id": "53bc22df-c7df-376d-a97a-1252c09ef6a9",
                                        "glosses": [
                                            "vier Augen habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7bf7b454-a98f-49fb-a5f9-3c6344a1b827",
                                                "sense_id": "a6cb1195-ced3-3c40-a148-487046e6b886",
                                                "text": "„Im Volksglauben der Zigeuner lebt auch eine vieräugige Hündin, deren Gebell man manchmal im Berge vernimmt.“"
