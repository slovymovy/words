{
    "word_family": [
        "scrag",
        "scraggy"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "f65e4de5-5047-340c-9291-51e30ea1188b",
                    "sense_definition": "Rough, scruffy, or unkempt in appearance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He had a <w>scraggly</w> beard that looked like it had not been trimmed in months.",
                            "target_lang_translations": {
                                "cs": "Měl <w>rozcuchaný</w> plnovous, který vypadal, že nebyl měsíce zastřižen."
                            }
                        },
                        {
                            "text": "The garden was full of <w>scraggly</w> bushes that needed to be cut back.",
                            "target_lang_translations": {
                                "cs": "Zahrada byla plná <w>neupravených</w> keřů, které bylo potřeba prořezat."
                            }
                        }
                    ],
                    "synonyms": [
                        "scruffy",
                        "unkempt",
                        "ragged"
                    ],
                    "antonyms": [
                        "neat",
                        "tidy"
                    ],
                    "common_phrases": [
                        "scraggly beard",
                        "scraggly hair"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající neupravený, rozcuchaný nebo zanedbaný vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rozcuchaný",
                                "target_lang_sense_clarification": "zejména o vlasech nebo vousech"
                            },
                            {
                                "target_lang_word": "neupravený",
                                "target_lang_sense_clarification": "obecně o vzhledu či porostu"
                            },
                            {
                                "target_lang_word": "zanedbaný",
                                "target_lang_sense_clarification": "o vzhledu, který působí dojmem nedostatku péče"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7357d73e-23d3-3b25-9929-3700d3a1a0e1",
                    "sense_definition": "Having a jagged, uneven, or thin appearance.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The student struggled to read the <w>scraggly</w> handwriting on the old document.",
                            "target_lang_translations": {
                                "cs": "Student měl potíže přečíst <w>kostrbaté</w> písmo na starém dokumentu."
                            }
                        },
                        {
                            "text": "We sat in the shade of a <w>scraggly</w> tree at the edge of the field.",
                            "target_lang_translations": {
                                "cs": "Seděli jsme ve stínu <w>řídkého</w> stromu na kraji pole."
                            }
                        }
                    ],
                    "synonyms": [
                        "jagged",
                        "uneven",
                        "scraggy"
                    ],
                    "common_phrases": [
                        "scraggly handwriting"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající zubatý, nerovnoměrný nebo řídký vzhled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "roztřesený",
                                "target_lang_sense_clarification": "o písmu, které je neúhledné a kostrbaté"
                            },
                            {
                                "target_lang_word": "řídký",
                                "target_lang_sense_clarification": "o porostu nebo větvích, které nejsou husté"
                            },
                            {
                                "target_lang_word": "kostrbatý",
                                "target_lang_sense_clarification": "o nerovném, neúhledném tvaru či písmu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}