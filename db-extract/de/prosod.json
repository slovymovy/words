                        "entry_id": "ce13a02d-dfec-3603-9853-fc6f0f234798",
                        "glosses": [
                            "jede einzelne Realisierung eines Prosodems (Einheit der Sprachverwendung, der parole)"
                        ],
                        "tags": [
                            "speziell Prosodik"
                        ],
                        "examples": [
                            {
                                "example_id": "e3062c46-2a0c-444a-a168-f4733385af72",
                                "sense_id": "928f6f04-822c-3edc-b8bf-2dafa5bf31f4",
                                "text": "Heike definiert das Prosod als „die konkrete Realisation eines Prosodems.“"
                            },
                            {
                                "example_id": "85c5c73b-67b5-49d7-b0ad-ef5136d71ec2",
                                "sense_id": "928f6f04-822c-3edc-b8bf-2dafa5bf31f4",
                                "text": "„Diese Verläufe beziehen sich (auditiv bestimmt) auf Höhe, Lautheit, Qualität und Länge von simultanen Teilen des Prosods.“"
                            },
                            {
                                "example_id": "94ddb641-4cca-48b0-85fa-3f0caa5a9da3",
                                "sense_id": "928f6f04-822c-3edc-b8bf-2dafa5bf31f4",
                                "text": "„Die Realisierung des Prosodems ist das Prosod.“"
                            }
                        ],
