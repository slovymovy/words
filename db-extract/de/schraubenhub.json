                        "examples": [
                            {
                                "example_id": "6420382b-0af1-4654-a2de-48badcd700f4",
                                "sense_id": "e1b70347-f1af-32c7-9a2c-5db239023613",
                                "text": "„Der Anschlag […] verhindert, daß die Blattsteigung und damit der Schraubenhub beim Drosseln unzulässig stark abnimmt.“"
                            },
                            {
                                "example_id": "35e096b7-00b5-4343-ac0d-63d53c6692cc",
                                "sense_id": "e1b70347-f1af-32c7-9a2c-5db239023613",
                                "text": "„Die Peripherie desselben besteht aus 200 Zähnen; der Umdrehung des Rades um einen Zahn entspricht ein Schraubenhub um 0'0025 mm.“"
                            },
                            {
                                "example_id": "90ef1658-a9fe-49d7-bc5c-09d98af8c9cb",
                                "sense_id": "e1b70347-f1af-32c7-9a2c-5db239023613",
                                "text": "„Der Schraubenhub wird durch ein Kugeldrucklager aufgenommen.“"
                            },
                            {
                                "example_id": "62f61df5-ca52-479c-aa8a-f9a823b993c8",
                                "sense_id": "e1b70347-f1af-32c7-9a2c-5db239023613",
                                "text": "„Wird statt des Winkels v der Schraubenhub des Eichtisches eingeführt, so gilt in guter Näherung […]“"
                            }
                        ],
