                "senses": [
                    {
                        "sense_id": "9deb5f85-f69e-3ef2-b8a5-78b3634f90b5",
                        "entry_id": "79f52cd8-0afa-3788-b924-d6269f554207",
                        "glosses": [
                            "Frau, die bei geplanten Maßnahmen gelegentlich um Stellungnahme gebeten wird, ob Elfen beeinträchtigt werden könnten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b9492ac-6834-4a97-ad8c-e3e950198aed",
                                "sense_id": "9deb5f85-f69e-3ef2-b8a5-78b3634f90b5",
                                "text": "„Ja, natürlich gibt es eine Elfenbeauftragte, die eine einzige, seltsame Aufgabe hat: Sie kontrolliert (nach Gefühl), wo Elfen leben.“"
                            }
                        ],
