                "senses": [
                    {
                        "sense_id": "9b72033d-7682-3dd4-9e02-e350154730a8",
                        "entry_id": "c8478778-6e23-360f-b8ae-bb01654bfa88",
                        "glosses": [
                            "jemand, der verwerfliche Handlungen an einem Grab vornimmt, vorgenommen hat, Grabschändung begeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96bb5f79-f8f5-42e9-a0a3-2dc057702a78",
                                "sense_id": "9b72033d-7682-3dd4-9e02-e350154730a8",
                                "text": "„In der Gruft [des Speyerer Doms] ruhen vier Kaiser, drei Kaiserinnen, eine Prinzessin und vier Könige, nur selten gestört von Grabschändern und Denkmalschützern.“"
                            },
                            {
                                "example_id": "141fbc3c-a86c-42bb-9748-b2883864814e",
                                "sense_id": "9b72033d-7682-3dd4-9e02-e350154730a8",
                                "text": "„Maria sorgt für ein Grab, das den Toten vor den Würmern und dem Zugriff der Grabschänder schützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
