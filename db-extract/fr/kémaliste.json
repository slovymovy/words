                    {
                        "sense_id": "a886e7af-970c-3c83-ac66-7933783e5b2f",
                        "entry_id": "f37170ad-6601-35d5-94a7-7a41d8b6555e",
                        "glosses": [
                            "Dénomme et caractérise les partisans de Mustafa Kemal Atatürk, président de la Turquie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82495d36-0a7d-4a99-a46c-9685c15be7b3",
                                "sense_id": "a886e7af-970c-3c83-ac66-7933783e5b2f",
                                "text": "Les milieux kémalistes évoquaient depuis au moins un an la possibilité d’un coup d’État, à cause du «mécontentement populaire» et de la «violation des règles fondamentales de la République et du kémalisme»."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "eb43ccdf-be57-39ec-8627-1b09d0aca188",
