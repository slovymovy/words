            {
                "entry_id": "f32ea7e1-cfb9-3b60-9d9d-18a25369ece2",
                "word": "spotter",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c90094d5-42d6-4a37-a7ee-a060346438e7",
                        "entry_id": "f32ea7e1-cfb9-3b60-9d9d-18a25369ece2",
                        "tags": [
                            "plural"
                        ],
                        "form": "spotters"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b0736e41-67f0-3a0c-8b0f-37d74c246fdf",
                        "entry_id": "f32ea7e1-cfb9-3b60-9d9d-18a25369ece2",
                        "glosses": [
                            "Personne qui a l’habitude de spotter, de répertorier les avions."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "00d201ce-ecda-379b-9212-92eb082ef8cd",
                        "entry_id": "f32ea7e1-cfb9-3b60-9d9d-18a25369ece2",
                        "glosses": [
                            "Observateur sportif ou artistique, personne chargée de repérer des nouveaux talents."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "0289c3ec-1fd3-3a57-914a-bbe0aacee169",
                        "entry_id": "f32ea7e1-cfb9-3b60-9d9d-18a25369ece2",
                        "glosses": [
                            "Observateur associé à un tireur de précision militaire."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b08e6d29-dcda-46fb-b16e-bc2540a29022",
                                "sense_id": "0289c3ec-1fd3-3a57-914a-bbe0aacee169",
                                "text": "Les snipers sont les héros, ceux sur lesquels on fait des films, ceux que décrit Stephen Hunter dans ses romans, mais ce sont les spotters qui font le vrai boulot."
                            },
                            {
                                "example_id": "a25f543b-c6f4-4fbc-a022-3e8ebc9e1142",
                                "sense_id": "0289c3ec-1fd3-3a57-914a-bbe0aacee169",
                                "text": "Le rôle du spotter est d’accompagner le tireur et, entre autres, d’estimer pour lui la vitesse du vent et la distance de la cible."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
