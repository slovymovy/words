                        "target_lang_word": "zweigleisig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zweigleisig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a9d10dd2-888f-3f52-823a-ea944e64508c",
                                        "entry_id": "de969450-e748-3f24-861b-7859372b0a18",
                                        "glosses": [
                                            "mit zwei (parallel laufenden) Gleisen versehen"
                                        ],
                                        "tags": [
                                            "Eisenbahnwesen",
                                            "in Bezug auf eine Bahnstrecke"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e61d6b4-bd52-4a6f-9a2c-39613bfe5c36",
                                                "sense_id": "a9d10dd2-888f-3f52-823a-ea944e64508c",
                                                "text": "„Die Bahnstrecke München–Rosenheim ist eine zweigleisige, elektrifizierte Hauptbahn in Bayern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b9b500ce-4000-3e36-b70d-e3254d2433e7",
                                        "entry_id": "de969450-e748-3f24-861b-7859372b0a18",
                                        "glosses": [
                                            "sich zwei Optionen offenhaltend, gleichzeitig zwei (Lösungs-)Wege verfolgend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f16b9ef-f09a-43bb-a4b4-b9f01f987dc8",
                                                "sense_id": "b9b500ce-4000-3e36-b70d-e3254d2433e7",
                                                "text": "„Frankreichs Präsident Macron fährt zweigleisig: Er will neue, kleine Atomkraftwerke bauen und erneuerbare Energien ausbauen.“"
                                            },
                                            {
                                                "example_id": "ee44af1e-5d5a-43f6-8df1-eb478a9830f2",
                                                "sense_id": "b9b500ce-4000-3e36-b70d-e3254d2433e7",
                                                "text": "„In Medellín hatte er ein zweigleisiges Justizwesen geschaffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
