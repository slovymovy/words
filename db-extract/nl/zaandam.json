                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zacharias",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0b3d61b6-142b-3131-8ba1-2497eacf1ad5",
                                        "entry_id": "464ed907-140a-392c-a48d-bc1710109d42",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d408c927-3576-4976-9909-263029600af8",
                                                "sense_id": "0b3d61b6-142b-3131-8ba1-2497eacf1ad5",
                                                "text": "Bei der nächsten Bürgermeisterwahl wird Zacharias kandidieren."
                                            },
                                            {
                                                "example_id": "2c9d1719-bd29-4854-b404-9ed8cb729076",
                                                "sense_id": "0b3d61b6-142b-3131-8ba1-2497eacf1ad5",
                                                "text": "„Zu der Zeit des Herodes, des Königs von Judäa, lebte ein Priester von der Ordnung Abija, mit Namen Zacharias, und seine Frau war aus dem Geschlecht Aaron und hieß Elisabeth.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05a9a618-3d04-4eeb-9667-83f0d15edf83",
                        "source_entry_id": "ceac7296-dabe-393f-9bd3-420b5bd752d0",
                        "source_sense_id": "d254a1b7-4634-3d59-8d2c-e7f05d745c70",
                        "source_sense_description": "spelwoord voor de letter z",
                        "target_lang_word": "Zeppelin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                        "entry_id": "523fd728-a170-3f3a-babd-178b788c9637",
                                        "glosses": [
                                            "bekanntester Luftschifftyp"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "75c374d2-39f7-4c80-8b4c-330e8d3b6d34",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "Im Ersten Weltkrieg wurden Zeppeline zur Bombardierung der englischen Zivilbevölkerung eingesetzt."
                                            },
                                            {
                                                "example_id": "08f03a26-b036-41be-9680-fc08123471f7",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Nobile war mit dem Luftschiff ‚Italia‘ erneut zum Nordpol aufgebrochen, diesmal ohne Amundsen. Auf dem Rückweg stürzte der Zeppelin ab.“"
                                            },
                                            {
                                                "example_id": "6bf95538-1d40-46c6-b6c4-1895251909a6",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Bei Cuxhaven war ein Zeppelin durch Blitzschlag vernichtet.“"
                                            },
                                            {
                                                "example_id": "fa6bef46-0d10-4a46-8bb7-7304b0f0e902",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Aber der Zeppelin fliegt nicht los, Eckener will ihn nicht unnütz gefährden.“"
                                            },
                                            {
                                                "example_id": "4c70c79b-bc3e-4434-bb19-cc3ca1bb1d40",
                                                "sense_id": "0ec5d2ac-f3a6-3803-bc9a-a779a056fc95",
                                                "text": "„Auch der Zeppelin erschien in Mainz, wenn auch mit etwas Verspätung, auf dem ersten Flug, der ihn vom Bodensee bis fast zur Nordsee hätte führen sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Zeppelin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                        "entry_id": "144d7ead-45be-36af-a453-9c771fe27d8e",
                                        "glosses": [
                                            "deutschsprachiger Nachname, Familienname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c25c2b41-582d-4a9f-9047-cfdb88707188",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Frau Zeppelin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "e48b10fb-2fee-41af-88c1-7da4ecf8e5ae",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Herr Zeppelin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "dbbc3bf2-f612-4eee-8b3f-9ff926b69799",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Die Zeppelins fliegen heute nach La Paz."
                                            },
                                            {
                                                "example_id": "a2b1ac64-88f1-4f77-b013-4e43944c5431",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Der Zeppelin trägt nie die Schals, die die Zeppelin ihm strickt."
                                            },
                                            {
                                                "example_id": "f836ea5d-773d-4e36-ba9b-3d8ae10cbaf8",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Zeppelin kommt, geht der Herr Zeppelin.“"
                                            },
                                            {
                                                "example_id": "988e924e-f851-4e39-ad75-74d82050ce9b",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelin kommt und geht."
                                            },
                                            {
                                                "example_id": "b841a79e-ee05-47b4-94f6-6b4a3c61d5ac",
                                                "sense_id": "8aa7c028-63e1-31ed-b407-ae30687fb92b",
                                                "text": "Zeppelins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
