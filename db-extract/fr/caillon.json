                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "7b52a20a-ace4-3b17-8cb0-e2fae073a92d",
                        "entry_id": "ceea688a-0d16-38d2-ad24-66f9d08b5bbb",
                        "glosses": [
                            "Grand désordre, bordel."
                        ],
                        "tags": [
