                    {
                        "sense_id": "33a4d256-0188-3f46-8976-14faecd95687",
                        "entry_id": "abb8be66-3c98-3f90-9f5c-4ff06acbfbc6",
                        "glosses": [
                            "extreem in mate"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e612c3e4-ed13-421d-b79d-8bf58761fc70",
                                "sense_id": "33a4d256-0188-3f46-8976-14faecd95687",
                                "text": "De overstroming was des te heftiger omdat de stortbui kwam na een lange droogte."
                            },
                            {
                                "example_id": "027d9a43-e5b4-40ae-b478-13c5c9771c80",
                                "sense_id": "33a4d256-0188-3f46-8976-14faecd95687",
                                "text": "Hij kon erg geestig en beeldend vertellen en beschreef hoe hij twintig jaar geleden in Londen zwaar in de ‘underground acid dance scene’ had gezeten, op illegale feesten in verlaten pakhuizen die soms wel drie dagen duurden. Nu gaf hij zich helemaal over aan de bergen die volgens hem even heftig waren als de feesten van destijds."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e3f6e17-1008-4de6-a0ae-258ff3af6ca4",
                        "source_entry_id": "abb8be66-3c98-3f90-9f5c-4ff06acbfbc6",
                        "source_sense_id": "33a4d256-0188-3f46-8976-14faecd95687",
