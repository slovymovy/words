    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bcb58c88-dead-3e94-b934-ee3f182d9066",
                    "sense_definition": "Verkleinwoord van <w>kat</w>; een jonge of kleine kat.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "kat_diminutive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het kleine <w>katje</w> speelde de hele middag met een bolletje wol.",
                            "target_lang_translations": {
                                "en": "The little <w>kitten</w> played with a ball of wool all afternoon."
                            }
                        },
                        {
                            "text": "We hebben gisteren een schattig <w>katje</w> uit het asiel gehaald.",
                            "target_lang_translations": {
                                "en": "Yesterday we got a cute <w>kitten</w> from the shelter."
                            }
                        }
                    ],
                    "common_phrases": [
                        "schattig katje",
                        "klein katje"
                    ],
                    "target_lang_definitions": {
                        "en": "Diminutive of cat; a young or small cat."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kitten",
                                "target_lang_sense_clarification": "a young cat"
                            },
                            {
                                "target_lang_word": "kitty",
                                "target_lang_sense_clarification": "informal or affectionate term for a cat"
                            },
                            {
                                "target_lang_word": "little cat",
                                "target_lang_sense_clarification": "a small cat"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bc1a767-b0a9-3a40-8aad-9be9ed90424e",
                    "sense_definition": "De aarvormige, hangende bloeiwijze van bepaalde bomen zoals de wilg, berk en hazelaar.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "plant_part",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het vroege voorjaar verschijnt het eerste <w>katje</w> aan de wilgentakken.",
                            "target_lang_translations": {
                                "en": "In early spring, the first <w>catkin</w> appears on the willow branches."
                            }
                        },
                        {
                            "text": "De kinderen verzamelden zachte <w>katjes</w> tijdens hun wandeling in het bos.",
                            "target_lang_translations": {
                                "en": "The children collected soft <w>catkins</w> during their walk in the forest."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zachte katjes",
                        "katjes van de wilg"
                    ],
                    "target_lang_definitions": {
                        "en": "The spike-like, drooping inflorescence of certain trees such as willow, birch, and hazel."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "catkin",
                                "target_lang_sense_clarification": "botanical flower cluster"
                            },
                            {
                                "target_lang_word": "pussy willow",
                                "target_lang_sense_clarification": "specifically referring to willow catkins"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3c0bca44-01af-3e31-ab19-9a2d1f34de07",
                    "sense_definition": "Benaming voor verschillende soorten slakken uit de familie Cypraeidae met glanzend gekleurde schelpen, vaak gebruikt als versiering of ruilmiddel.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "shellfish",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In sommige culturen werd het <w>katje</w> vroeger als betaalmiddel gebruikt.",
                            "target_lang_translations": {
                                "en": "In some cultures, the <w>cowrie</w> was used as currency in the past."
                            }
                        },
                        {
                            "text": "De verzamelaar zocht naar een zeldzaam <w>katje</w> voor zijn schelpenverzameling.",
                            "target_lang_translations": {
                                "en": "The collector was looking for a rare <w>cowrie</w> for his shell collection."
                            }
                        }
                    ],
                    "synonyms": [
                        "kauri",
                        "porseleinhoorn"
                    ],
                    "target_lang_definitions": {
                        "en": "Name for various types of sea snails from the Cypraeidae family with glossy, colored shells, often used as decoration or currency."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "cowrie",
                                "target_lang_sense_clarification": "marine gastropod shell"
                            },
                            {
                                "target_lang_word": "cowry",
                                "target_lang_sense_clarification": "alternative spelling of cowrie"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}