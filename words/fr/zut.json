                {
                    "sense_id": "0fb4e32b-bab9-345a-aa1c-d20341effc39",
                    "sense_definition": "Exclamation marquant le mépris, le rejet ou l'envoi promener d'une personne ou d'une situation.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Agacé par ces remarques constantes, il a fini par leur dire <w>zut</w>.",
                            "target_lang_translations": {
                                "en": "Annoyed by these constant remarks, he finally told them to <w>get lost</w>.",
                                "ru": "Раздражённый этими постоянными замечаниями, он в конце концов махнул рукой и сказал им: <w>тьфу</w>.",
                                "de": "Genervt von diesen ständigen Bemerkungen, sagte er ihnen schließlich nur: <w>Pah</w>!",
                                "es": "Molesto por aquellos comentarios constantes, acabó por espetarles un ¡<w>bah</w>!",
                                "zh": "这些没完没了的议论让他很烦，最后他干脆朝他们<w>呸</w>了一声。"
                            }
                        },
                        {
                            "text": "Elle a décidé de dire <w>zut</w> aux convenances et de vivre comme elle l'entend.",
                            "target_lang_translations": {
                                "en": "She decided to say <w>to hell with</w> convention and live as she sees fit.",
                                "ru": "Она решила сказать условностям «<w>фи</w>» и жить так, как считает нужным.",
                                "de": "Sie beschloss, den Konventionen mit einem <w>Pah</w> den Rücken zu kehren und so zu leben, wie sie es wollte.",
                                "es": "Decidió mandar <w>a la porra</w> las convenciones y vivir a su manera.",
                                "zh": "她决定对世俗的规矩说一声<w>呸</w>，按自己的心意生活。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "dire zut"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "registre familier"
                        }
                    ],
                    "target_lang_definitions": {
