                        ],
                        "form": "den Grips"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                        "entry_id": "326be6f5-882b-3b88-8211-26a260b7a837",
                        "glosses": [
                            "kognitive Leistungsfähigkeit"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "89b6117f-ebee-478b-b1dd-59b5603ecb7a",
                                "sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                                "text": "Sein Grips ist nicht überragend."
                            },
                            {
                                "example_id": "0d42166c-5333-4f2e-a85e-074df7b0833e",
                                "sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                                "text": "„Die Bürger müssen ihrer Stadt unter die Arme greifen, mit Grips und Gemeinsinn.“"
                            },
                            {
                                "example_id": "89158915-1208-4cd2-bfee-c589961d0115",
                                "sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                                "text": "„Ich strengte meinen Grips an und sortierte die Fakten.“"
                            },
                            {
                                "example_id": "4d240526-419a-4885-9099-cba244a790fb",
                                "sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                                "text": "„Du hast Grips in der Birne und solltest als Philosoph tätig sein, anstatt dubiosen Geschäftspartnern Triebwerke zu verhökern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "ee790d47-1a81-35a2-9bdf-4a2ae8f3cb97",
                        "entry_id": "326be6f5-882b-3b88-8211-26a260b7a837",
                        "glosses": [
                            "Menge der Gehirnmasse"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "e81b976d-b62f-4ed2-a88c-3cf6903a6581",
                                "sense_id": "ee790d47-1a81-35a2-9bdf-4a2ae8f3cb97",
                                "text": "Der hat nicht viel Grips."
                            },
                            {
                                "example_id": "65ae949e-8fcb-4848-bb12-f96a0e0ccafc",
                                "sense_id": "ee790d47-1a81-35a2-9bdf-4a2ae8f3cb97",
                                "text": "„Wenn ich ein bisschen Grips hätte, würde ich mit Patti hinfahren.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7600db72-7f9f-4330-9ad3-6fc9dccb1f41",
                        "source_entry_id": "326be6f5-882b-3b88-8211-26a260b7a837",
                        "source_sense_id": "1de7428b-b200-364d-89ac-0c6f77bfbfef",
                        "source_sense_description": "umgangssprachlich: kognitive Leistungsfähigkeit",
                        "target_lang_word": "jugeotte",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jugeotte",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "046b0941-21cd-350f-992e-cd4dd43ad1fc",
                                        "entry_id": "ab625293-46ea-3f85-818e-df302fb14d7b",
                                        "glosses": [
                                            "Variante orthographique de jugeote."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "14b552f6-4b73-48d5-8a67-d90911740d96",
                                                "sense_id": "046b0941-21cd-350f-992e-cd4dd43ad1fc",
                                                "text": "On t’a désigné pour cette corvée, parce que tu as de la poigne et de la jugeotte quand tu n’es pas soûl."
                                            },
                                            {
                                                "example_id": "e7f5bd54-4159-486a-a8cc-0b7106441c2f",
                                                "sense_id": "046b0941-21cd-350f-992e-cd4dd43ad1fc",
                                                "text": "Toi, Sofron, t’as de la jugeotte, mais quand même, fais bien attention : ya pas de fumée sans feu."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "943570c5-f9bf-424e-80ed-7967630b33ab",
                        "source_entry_id": "326be6f5-882b-3b88-8211-26a260b7a837",
                        "source_sense_id": "ee790d47-1a81-35a2-9bdf-4a2ae8f3cb97",
                        "source_sense_description": "umgangssprachlich: Menge der Gehirnmasse",
                        "target_lang_word": "cervelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cervelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "62956675-3ebf-3d68-b36f-02aeabf309d2",
                                        "entry_id": "472dfcff-388a-3051-a90a-ba480e6b3c49",
                                        "glosses": [
                                            "Substance du cerveau, particulièrement quand celui-ci perd son intégrité."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d485c81-51e2-4fa4-a5d6-5fcc7c03ce3d",
                                                "sense_id": "62956675-3ebf-3d68-b36f-02aeabf309d2",
                                                "text": "Or, non loin des figuiers, les fils de Bélial\nFrappent le vigneron avec de lourdes pierres ;\nLa cervelle et le sang souillent ce lieu fatal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82d21df5-1406-305b-a6d3-c1ad9a8a8c6a",
                                        "entry_id": "472dfcff-388a-3051-a90a-ba480e6b3c49",
                                        "glosses": [
                                            "Le cerveau lui-même, surtout chez l’être humain."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "metonymically",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "66ddd593-bd76-468e-8a15-cefbe1dafe08",
                                                "sense_id": "82d21df5-1406-305b-a6d3-c1ad9a8a8c6a",
                                                "text": "Cette cervelle gélatineuse, qu’a-t-elle à voir avec l’idée, la religion, la philosophie, la bonté, la pitié, l’amour, la poésie, la liberté ?"
                                            },
                                            {
                                                "example_id": "3c8045e8-d6a8-4029-8cbd-180da776f1d6",
                                                "sense_id": "82d21df5-1406-305b-a6d3-c1ad9a8a8c6a",
                                                "text": "Ces hommes-là n’ont vraiment rien dans la cervelle !"
                                            },
                                            {
                                                "example_id": "d6c15389-f36d-407b-9334-900b700bea34",
                                                "sense_id": "82d21df5-1406-305b-a6d3-c1ad9a8a8c6a",
                                                "text": "Foutue cervelle. Où ai-je mis ce document?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1c9552bc-21b1-3640-ba1b-9f82d66ec201",
                                        "entry_id": "472dfcff-388a-3051-a90a-ba480e6b3c49",
                                        "glosses": [
                                            "Cerveau des animaux tués, destiné à servir de mets."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "215b822d-9d4c-47ca-a63a-84341f16c630",
                                                "sense_id": "1c9552bc-21b1-3640-ba1b-9f82d66ec201",
                                                "text": "Les oreilles de veau ont de commun avec les pieds et les cervelles, l'avantage de pouvoir être frites ou mangées à la poulette; et de plus elles se laissent farcir , accommoder aux pois , aux oignons, au fromage, etc."
                                            },
                                            {
                                                "example_id": "ef9510cc-4e1b-4318-99f4-3c8ea732af06",
                                                "sense_id": "1c9552bc-21b1-3640-ba1b-9f82d66ec201",
                                                "text": "Ce qu’elle essaie de lui faire avaler, c’est de la cervelle… il n’y a que Lili qui a le droit d’en avoir, elle est si fragile, il lui faut ce mets fortifiant et délicat…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                        "entry_id": "472dfcff-388a-3051-a90a-ba480e6b3c49",
                                        "glosses": [
                                            "Organe de la pensée et, par suite, l’intelligence, le jugement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "03f91ec1-64a1-470c-bd83-789df03824c8",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "Cet homme, béatifié par ses jouissances gastronomiques, n’avait sans doute pas deux idées dans la cervelle, et ne songeait à rien. Aussi eus-je en quelque sorte, honte de prodiguer ma science divinatoire in anima vili d’un épais financier."
                                            },
                                            {
                                                "example_id": "12b9d3ab-2121-4d5c-8d0d-d3fc1a87a704",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "Cette idée s’était si bien ancrée dans ma cervelle que, malgré tous mes efforts pour la chasser, elle revenait sans cesse plus tenace et plus incisive."
                                            },
                                            {
                                                "example_id": "bf153c8d-3391-427e-af68-8ebf360e91fc",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "Ces conjectures et ces raisonnements se pressaient dans la cervelle de Scaër, pendant que les assassins fuyaient en emportant ce qu'on appelle en style judiciaire le corps du délit."
                                            },
                                            {
                                                "example_id": "b405943e-6b8c-4f04-9e7f-b9cb5c2ea4cf",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "Les maîtres d’école prétendent que ce qu’on écrit se fourre plus avant dans la cervelle que ce qu'on apprend par cœur, et que c'est pour ça qu'ils font faire des devoirs aux enfants, au lieu de se contenter de leur faire réciter des leçons."
                                            },
                                            {
                                                "example_id": "b97806db-114c-49dc-9dd6-3cb3b63a97a9",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "De ces cervelles fines, la plus fine était la petite Brulette, emmi les filles, et des plus épaisses, la plus épaisse paraissait celle de Joseph, emmi les garçons."
                                            },
                                            {
                                                "example_id": "8bf931d9-4f81-4fb5-9e70-11ad3eb1e19a",
                                                "sense_id": "70c10dbd-6cdb-3355-a9f3-93572c05ff7b",
                                                "text": "L'ensemble de ces pseudo-vérités, happeuses de cervelles faibles, M. Marcello-Fabri le compare à une gigantesque barre aimantée attirant les humaines limailles ; çà et là quelques atomes tentent de résister au courant magnétique, mais au prix de quels efforts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
