                        "examples": [
                            {
                                "example_id": "cba8fed5-af78-4d4e-9705-1c90dee54b6a",
                                "sense_id": "beecaaa8-c6fc-3ccb-8733-23295be16124",
                                "text": "clysmic fault"
                            },
                            {
                                "example_id": "459a9d49-e6ef-4899-8e48-c865707a0e0d",
                                "sense_id": "beecaaa8-c6fc-3ccb-8733-23295be16124",
                                "text": "These huge faults quite often possess a trend parallel to the Gulf of Suez (clysmic faults), but important cross faults occur in the Gulf of Suez area too."
                            },
                            {
                                "example_id": "49b776ea-b512-4b1f-b780-62be7fed2ac9",
                                "sense_id": "beecaaa8-c6fc-3ccb-8733-23295be16124",
                                "text": "This shows that the tectonic pattern of the Suez rift changed at the end of the Early Clysmic stage, that is about 16-17 m.y. ago (cf. Table 2) ."
                            },
                            {
                                "example_id": "9cb84e78-dcc8-422c-a2dd-2a89d4cbb8c2",
                                "sense_id": "beecaaa8-c6fc-3ccb-8733-23295be16124",
                                "text": "Summary of fault orientation data in the Gulf of Suez showing the four main trends: northwest oblique, clysmic, north oblique and cross."
                            },
                            {
                                "example_id": "00bcf89f-18c5-49bb-afc1-e44d4b8840a4",
                                "sense_id": "beecaaa8-c6fc-3ccb-8733-23295be16124",
                                "text": "Deposition of group B follows an important structural development, for which the most striking consequence is the development of groups of large titled blocks of clysmic direction relayed by submeridian faults and N 100°-120°."
                            }
                        ]
