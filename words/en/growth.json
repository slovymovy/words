    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "acdfb455-e211-3902-82fe-24abb24566bf",
                    "sense_definition": "The natural process of getting bigger, taller, or more developed over time.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor is monitoring the child's <w>growth</w> to ensure they are healthy.",
                            "target_lang_translations": {
                                "ru": "Врач следит за <w>ростом</w> ребенка, чтобы убедиться, что он здоров."
                            }
                        },
                        {
                            "text": "Adequate sunlight and water are essential for the rapid <w>growth</w> of these plants.",
                            "target_lang_translations": {
                                "ru": "Достаточное количество солнечного света и воды необходимы для быстрого <w>роста</w> этих растений."
                            }
                        }
                    ],
                    "synonyms": [
                        "development",
                        "maturation"
                    ],
                    "antonyms": [
                        "nondevelopment"
                    ],
                    "common_phrases": [
                        "rapid growth",
                        "stunted growth",
                        "growth rate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Естественный процесс увеличения размера, высоты или развития с течением времени."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "физическое увеличение организма"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "процесс созревания"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04e7dcf2-82e6-3dd5-9d59-747774a45e83",
                    "sense_definition": "An increase in size, number, value, or strength of something.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "increase",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company has seen a significant <w>growth</w> in sales over the last quarter.",
                            "target_lang_translations": {
                                "ru": "В последнем квартале компания зафиксировала значительный <w>рост</w> продаж."
                            }
                        },
                        {
                            "text": "The city is struggling to provide enough housing for the <w>growth</w> in population.",
                            "target_lang_translations": {
                                "ru": "Город с трудом обеспечивает жильем <w>прирост</w> населения."
                            }
                        }
                    ],
                    "synonyms": [
                        "enlargement",
                        "expansion",
                        "increase",
                        "increment"
                    ],
                    "antonyms": [
                        "contraction",
                        "decrease",
                        "decrement",
                        "reduction"
                    ],
                    "common_phrases": [
                        "population growth",
                        "growth in sales",
                        "steady growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличение размера, количества, значения или силы чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "увеличение показателей"
                            },
                            {
                                "target_lang_word": "прирост",
                                "target_lang_sense_clarification": "количественное увеличение"
                            },
                            {
                                "target_lang_word": "возрастание",
                                "target_lang_sense_clarification": "усиление или увеличение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "449d4ad8-a473-301e-ac05-efbcf67f7fb0",
                    "sense_definition": "The increase in the production of goods and services in an economy.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "economics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government is implementing new policies to stimulate economic <w>growth</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство внедряет новую политику для стимулирования экономического <w>роста</w>."
                            }
                        },
                        {
                            "text": "The company failed to meet its ambitious <w>growth</w> targets this year.",
                            "target_lang_translations": {
                                "ru": "В этом году компании не удалось достичь своих амбициозных целей по <w>развитию</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "expansion"
                    ],
                    "antonyms": [
                        "reduction"
                    ],
                    "common_phrases": [
                        "economic growth",
                        "growth targets",
                        "annual growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Увеличение производства товаров и услуг в экономике."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "экономический подъем"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "расширение экономики"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "99d6ecc0-18b0-3bc8-8bce-b9c3d7a075cf",
                    "sense_definition": "An increase in psychological strength, maturity, or the ability to handle difficult situations.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "personal_development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Traveling alone for the first time led to a lot of personal <w>growth</w>.",
                            "target_lang_translations": {
                                "ru": "Первое одиночное путешествие привело к значительному личностному <w>росту</w>."
                            }
                        },
                        {
                            "text": "She showed great emotional <w>growth</w> by forgiving those who had hurt her.",
                            "target_lang_translations": {
                                "ru": "Она проявила большую эмоциональную <w>зрелость</w>, простив тех, кто причинил ей боль."
                            }
                        }
                    ],
                    "synonyms": [
                        "development",
                        "maturation"
                    ],
                    "common_phrases": [
                        "personal growth",
                        "emotional growth",
                        "spiritual growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Повышение психологической устойчивости, зрелости или способности справляться с трудностями."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рост",
                                "target_lang_sense_clarification": "личностное или духовное развитие"
                            },
                            {
                                "target_lang_word": "развитие",
                                "target_lang_sense_clarification": "внутреннее совершенствование"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3f95cda-fc03-3ac6-a6e3-c4ef1d813652",
                    "sense_definition": "Something that has grown or is currently growing, such as a covering of hair or plants.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_object",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He decided to shave off the thick <w>growth</w> of beard on his chin.",
                            "target_lang_translations": {
                                "ru": "Он решил сбрить густую <w>растительность</w> на подбородке."
                            }
                        },
                        {
                            "text": "The old stone wall was hidden under a dense <w>growth</w> of ivy.",
                            "target_lang_translations": {
                                "ru": "Старая каменная стена была скрыта под густой <w>порослью</w> плюща."
                            }
                        }
                    ],
                    "synonyms": [
                        "vegetation",
                        "outgrowth"
                    ],
                    "common_phrases": [
                        "dense growth",
                        "thick growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что выросло или растет в данный момент, например, волосяной или растительный покров."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поросль",
                                "target_lang_sense_clarification": "густая растительность"
                            },
                            {
                                "target_lang_word": "растительность",
                                "target_lang_sense_clarification": "покров из растений или волос"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "079e84b8-f486-3df6-a5b6-20c519b970bb",
                    "sense_definition": "An abnormal mass of tissue, such as a tumor, growing on or inside the body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surgeon successfully removed a small <w>growth</w> from the patient's lung.",
                            "target_lang_translations": {
                                "ru": "Хирург успешно удалил небольшое <w>новообразование</w> из легкого пациента."
                            }
                        },
                        {
                            "text": "Tests were conducted to determine if the cancerous <w>growth</w> had spread.",
                            "target_lang_translations": {
                                "ru": "Были проведены анализы, чтобы определить, не распространилась ли раковая <w>опухоль</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "outgrowth",
                        "cancer",
                        "mass"
                    ],
                    "common_phrases": [
                        "cancerous growth",
                        "benign growth",
                        "abnormal growth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Аномальная масса ткани, такая как опухоль, растущая на теле или внутри него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "новообразование",
                                "target_lang_sense_clarification": "медицинский термин для опухоли"
                            },
                            {
                                "target_lang_word": "нарост",
                                "target_lang_sense_clarification": "болезненное уплотнение или опухоль"
                            },
                            {
                                "target_lang_word": "опухоль",
                                "target_lang_sense_clarification": "патологическое разрастание тканей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}