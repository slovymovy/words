                "senses": [
                    {
                        "sense_id": "157d433a-b111-3af8-8cc9-43a4e4312e72",
                        "entry_id": "d160d5e9-ed52-344d-85a5-040de5356e21",
                        "glosses": [
                            "een Italiaanse versterkte wijn die gemaakt wordt in de omgeving van Marsala op het westelijk deel van Sicilië"
                        ],
                        "tags": [
                            "wikidata: marsala"
                        ],
                        "examples": [
                            {
                                "example_id": "4c05e10f-f84e-4b06-aa90-4797460f4a2e",
                                "sense_id": "157d433a-b111-3af8-8cc9-43a4e4312e72",
                                "text": "Ik probeerde me te herinneren wat we de vorige avond gegeten hadden. Kalfsvlees, want er was een saus van marsalawijn bij — nee, voor de scaloppina marsala gebruikte Mirjam tegenwoordig, uit ecologische overwegingen, filet van de biokip."
                            },
                            {
                                "example_id": "a133390b-b858-4d4b-a914-ca53697a8692",
                                "sense_id": "157d433a-b111-3af8-8cc9-43a4e4312e72",
                                "text": "Bak de paddenstoelen, de knoflook en de tijm 5 minuten in het bakvet van het vlees. Voeg de overige boter toe en blus af met de marsala. Laat de wijn 5 minuten inkoken."
                            },
                            {
                                "example_id": "19dee160-4a19-4ff6-8922-4e68f5eeb901",
                                "sense_id": "157d433a-b111-3af8-8cc9-43a4e4312e72",
                                "text": "Keer de kip en witlof. Giet de marsala erbij en roer alle aanbaksels los van de bodem."
                            }
                        ]
                    }
                ],
