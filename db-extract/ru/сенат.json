                                    },
                                    {
                                        "sense_id": "831311f3-d6aa-3586-ad92-b89bb6d289b6",
                                        "entry_id": "6cb41dc1-7f2c-3695-9946-f3eb15270f39",
                                        "glosses": [
                                            "eine Kammer des Parlaments"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1760a68-58f7-4467-b30c-7ced98bf5865",
                                                "sense_id": "831311f3-d6aa-3586-ad92-b89bb6d289b6",
                                                "text": "„Der Senat der Vereinigten Staaten ist neben dem Repräsentantenhaus eine der beiden Kammern des Kongresses der Vereinigten Staaten, eines Zweikammer-Parlaments (Bikameralismus) nach britischer Tradition.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6ab12687-bf40-3857-873e-cab2a758f737",
                                        "entry_id": "6cb41dc1-7f2c-3695-9946-f3eb15270f39",
                                        "glosses": [
                                            "Verwaltungsbehörde an Hochschulen"
                                        ],
                                        "tags": [
                                            "Ausbildung"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c18a4841-bb24-440f-bb41-679fda7b1d6a",
                                                "sense_id": "6ab12687-bf40-3857-873e-cab2a758f737",
                                                "text": "„An Hochschulen ist der Akademische Senat ein Selbstverwaltungsorgan und das oberste Gremium.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "49e5c3a8-e4ae-3e42-b9df-a18776a843e3",
                                        "entry_id": "6cb41dc1-7f2c-3695-9946-f3eb15270f39",
                                        "glosses": [
                                            "Entscheidungsgremium höherer deutscher Gerichte"
                                        ],
                                        "tags": [
                                            "Rechtswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4b396aee-170a-42d5-85d4-80a2fdcc782f",
                                                "sense_id": "49e5c3a8-e4ae-3e42-b9df-a18776a843e3",
                                                "text": "Das Verfahren liegt dem ersten Senat zur Entscheidung vor."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "25a19605-c621-3059-a93c-58a55b970444",
                                        "entry_id": "6cb41dc1-7f2c-3695-9946-f3eb15270f39",
                                        "glosses": [
                                            "städtische Regierungsbehörde von Berlin, Bremen und Hamburg"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "720649ae-517c-430c-a343-69db9b309f66",
                                                "sense_id": "25a19605-c621-3059-a93c-58a55b970444",
                                                "text": "Nach den Wahlen wird es im Senat einige Änderungen geben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "d364c976-7d58-35e2-92f8-b1e3eba7e30c",
                                        "entry_id": "6cb41dc1-7f2c-3695-9946-f3eb15270f39",
