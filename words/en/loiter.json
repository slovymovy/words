{
    "word_family": [
        "loiterer"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "454498e3-460c-368d-ab3c-0c43e729fdc4",
                    "sense_definition": "To stand or wait around somewhere idly or without an apparent purpose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "linger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A sign on the wall warned that people were not permitted to <w>loiter</w> outside the shop.",
                            "target_lang_translations": {
                                "es": "Un cartel en la pared advertía que no se permitía <w>merodear</w> frente a la tienda."
                            }
                        },
                        {
                            "text": "Several teenagers began to <w>loiter</w> near the entrance of the cinema after the movie ended.",
                            "target_lang_translations": {
                                "es": "Varios adolescentes empezaron a <w>hacer tiempo</w> cerca de la entrada del cine después de que terminó la película."
                            }
                        }
                    ],
                    "synonyms": [
                        "hang around",
                        "hang about",
                        "linger"
                    ],
                    "antonyms": [
                        "leave"
                    ],
                    "common_phrases": [
                        "loiter outside",
                        "loitering with intent"
                    ],
                    "target_lang_definitions": {
                        "es": "Permanecer o esperar en un lugar sin hacer nada o sin un propósito aparente."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "merodear",
                                "target_lang_sense_clarification": "rondar un lugar, a menudo con sospecha"
                            },
                            {
                                "target_lang_word": "hacer tiempo",
                                "target_lang_sense_clarification": "pasar el rato esperando sin propósito claro"
                            },
                            {
                                "target_lang_word": "holgazanear",
                                "target_lang_sense_clarification": "estar ocioso o sin ocupación"
                            },
                            {
                                "target_lang_word": "vagar",
                                "target_lang_sense_clarification": "estar deambulando o sin rumbo fijo"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bd756bf4-9339-3670-833d-eb68176654c0",
                    "sense_definition": "To delay or remain at a place rather than proceeding or departing.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We cannot afford to <w>loiter</w> on the platform if we want to catch the next train.",
                            "target_lang_translations": {
                                "es": "No podemos permitirnos <w>demorarnos</w> en el andén si queremos tomar el próximo tren."
                            }
                        },
                        {
                            "text": "She chose to <w>loiter</w> behind the group to admire the historic architecture.",
                            "target_lang_translations": {
                                "es": "Prefirió <w>quedarse rezagada</w> detrás del grupo para admirar la arquitectura histórica."
                            }
                        }
                    ],
                    "synonyms": [
                        "dally",
                        "dawdle",
                        "linger",
                        "tarry"
                    ],
                    "antonyms": [
                        "leave",
                        "make a move"
                    ],
                    "target_lang_definitions": {
                        "es": "Demorarse o quedarse en un lugar en vez de continuar o marcharse."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "demorarse",
                                "target_lang_sense_clarification": "tardarse o retrasarse al irse"
                            },
                            {
                                "target_lang_word": "entretenerse",
                                "target_lang_sense_clarification": "retrasarse por distraerse"
                            },
                            {
                                "target_lang_word": "quedarse rezagado",
                                "target_lang_sense_clarification": "permanecer atrás retrasando la marcha"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2c8389d-f74f-3e3e-ab27-a03cf3fc18d3",
                    "sense_definition": "To stroll or wander slowly without any clear direction or objective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "wander",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On Sunday afternoons, he liked to <w>loiter</w> along the quiet riverbanks.",
                            "target_lang_translations": {
                                "es": "Los domingos por la tarde, le gustaba <w>pasear</w> por las tranquilas orillas del río."
                            }
                        },
                        {
                            "text": "Tourists often <w>loiter</w> through the old streets while looking at the souvenir displays.",
                            "target_lang_translations": {
                                "es": "Los turistas a menudo <w>deambulan</w> por las calles antiguas mientras miran los escaparates de recuerdos."
                            }
                        }
                    ],
                    "synonyms": [
                        "dally",
                        "wander"
                    ],
                    "target_lang_definitions": {
                        "es": "Pasear o caminar lentamente y sin una dirección u objetivo fijos."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "vagar",
                                "target_lang_sense_clarification": "caminar sin rumbo ni prisa"
                            },
                            {
                                "target_lang_word": "deambular",
                                "target_lang_sense_clarification": "pasear calmadamente sin rumbo"
                            },
                            {
                                "target_lang_word": "pasear",
                                "target_lang_sense_clarification": "caminar pausadamente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9554fd4-63ed-3488-8e0d-4a08643aeeaa",
                    "sense_definition": "To remain airborne over an operational area or near a target.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The surveillance drone was designed to <w>loiter</w> above the designated sector for hours.",
                            "target_lang_translations": {
                                "es": "El dron de vigilancia estaba diseñado para <w>mantenerse en vuelo</w> sobre el sector designado durante horas."
                            }
                        },
                        {
                            "text": "Pilots received orders to <w>loiter</w> near the coast until further instructions were issued.",
                            "target_lang_translations": {
                                "es": "Los pilotos recibieron órdenes de <w>patrullar</w> cerca de la costa hasta nuevo aviso."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Mantenerse en el aire volando en círculos o en espera sobre un área o blanco."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "merodear",
                                "target_lang_sense_clarification": "volar en espera en torno a una zona"
                            },
                            {
                                "target_lang_word": "patrullar",
                                "target_lang_sense_clarification": "mantenerse en vuelo de vigilancia"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "245199a1-027d-35ac-8a1f-037514f9bd52",
                    "sense_definition": "An act or period of standing or strolling around idly without purpose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "linger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a brief <w>loiter</w> through the garden, he went inside to prepare dinner.",
                            "target_lang_translations": {
                                "es": "Tras un breve <w>paseo</w> por el jardín, entró a preparar la cena."
                            }
                        },
                        {
                            "text": "A pleasant <w>loiter</w> around the village square helped clear her mind.",
                            "target_lang_translations": {
                                "es": "Una agradable <w>vuelta</w> por la plaza del pueblo le ayudó a despejar la mente."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "es": "Acción o momento de permanecer o pasear ociosamente sin ningún propósito."
                    },
                    "translations": {
                        "es": [
                            {
                                "target_lang_word": "paseo",
                                "target_lang_sense_clarification": "caminata tranquila y sin prisa"
                            },
                            {
                                "target_lang_word": "deambular",
                                "target_lang_sense_clarification": "acto de caminar sin rumbo fijo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}