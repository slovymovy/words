                    {
                        "sense_id": "d4bafaa3-6b8e-303f-ae13-c75ef54358a4",
                        "entry_id": "6fd4bcfa-8302-3888-ab09-52ceae469fd5",
                        "glosses": [
                            "Impatience."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "350456f4-cebc-4aff-8121-a13b1b4f8257",
                                "sense_id": "d4bafaa3-6b8e-303f-ae13-c75ef54358a4",
                                "text": "Sie wartete mit großer Ungeduld, bis sie endlich an der Reihe war.",
                                "translation": "Elle attendait avec beaucoup d’impatience d’être enfin en bout de file."
                            },
                            {
                                "example_id": "8f5b894e-8173-41ea-9bad-e5a3551b113f",
                                "sense_id": "d4bafaa3-6b8e-303f-ae13-c75ef54358a4",
                                "text": "Ohne Nachricht von Elena in den nächsten Tagen vergeht Eduard vor Ungeduld, dann hält er es nicht mehr aus und geht eines Abends zu ihr.",
                                "translation": "Sans nouvelles d’Elena les jours suivants, Édouard se ronge, n’y tient plus et, un soir, va chez elle."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
