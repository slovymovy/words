{
    "word_family": [
        "agitateur",
        "agiter"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "c4ea2172-36ae-3730-aa95-a1005575a48c",
                    "sense_definition": "Trouble de l'esprit caractérisé par la nervosité, l'anxiété ou l'impatience.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "esprit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Malgré ses efforts pour paraître calme, son <w>agitation</w> intérieure était évidente pour tout le monde."
                        },
                        {
                            "text": "La mauvaise nouvelle a provoqué une vive <w>agitation</w> chez les parents de l'enfant disparu."
                        }
                    ],
                    "synonyms": [
                        "anxiété",
                        "fébrilité",
                        "inquiétude",
                        "nervosité"
                    ],
                    "antonyms": [
                        "calme",
                        "sérénité",
                        "tranquillité"
                    ],
                    "common_phrases": [
                        "état d'agitation",
                        "grande agitation"
                    ]
                },
                {
                    "sense_id": "7533bd29-0e51-3c41-b4ed-c90c3764e5c8",
                    "sense_definition": "Activité fébrile, mouvement continuel et désordonné régnant dans un lieu.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le touriste fuyait l'<w>agitation</w> du centre-ville pour se reposer dans un parc tranquille."
                        },
                        {
                            "text": "À l'approche de Noël, l'<w>agitation</w> dans les grands magasins devient particulièrement intense."
                        }
                    ],
                    "synonyms": [
                        "animation",
                        "effervescence",
                        "tumulte"
                    ],
                    "antonyms": [
                        "calme",
                        "immobilité",
                        "silence"
                    ],
                    "common_phrases": [
                        "agitation de la foule",
                        "agitation urbaine"
                    ]
                },
                {
                    "sense_id": "c75379b5-f0b0-3df5-8a96-be1ca8d2837b",
                    "sense_definition": "Mouvement collectif de contestation, de protestation ou de rébellion politique et sociale.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "politique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>agitation</w> sociale s'est rapidement étendue à toutes les usines du pays cette semaine."
                        },
                        {
                            "text": "Le gouvernement redoute une nouvelle vague d'<w>agitation</w> populaire après l'annonce de la réforme."
                        }
                    ],
                    "synonyms": [
                        "effervescence",
                        "révolte",
                        "trouble"
                    ],
                    "antonyms": [
                        "ordre",
                        "paix"
                    ],
                    "common_phrases": [
                        "agitation politique",
                        "agitation sociale"
                    ]
                },
                {
                    "sense_id": "e67a3873-250f-3139-9f4f-af6c7ea68e83",
                    "sense_definition": "Mouvement violent, désordonné ou continuel de l'eau, de l'air ou d'une autre matière.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "matiere",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En raison de l'<w>agitation</w> de la mer, plusieurs traversées en ferry ont été annulées aujourd'hui."
                        },
                        {
                            "text": "Une forte <w>agitation</w> du mélange est nécessaire pour dissoudre complètement la poudre."
                        }
                    ],
                    "synonyms": [
                        "houle",
                        "remous",
                        "turbulence"
                    ],
                    "antonyms": [
                        "calme",
                        "immobilité"
                    ],
                    "common_phrases": [
                        "agitation de la mer"
                    ]
                },
                {
                    "sense_id": "0d7b0a28-da76-38c9-a006-075b7447609e",
                    "sense_definition": "Mouvement corporel désordonné et involontaire provoqué par la souffrance, la fièvre ou une maladie.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "corps",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'<w>agitation</w> du patient pendant la nuit a beaucoup inquiété le personnel soignant de garde."
                        },
                        {
                            "text": "Une crise d'<w>agitation</w> nocturne a réveillé l'enfant qui souffrait d'une très forte fièvre."
                        }
                    ],
                    "synonyms": [
                        "crispation",
                        "fébrilité"
                    ],
                    "antonyms": [
                        "calme",
                        "immobilité"
                    ],
                    "common_phrases": [
                        "agitation motrice",
                        "crise d'agitation"
                    ]
                }
            ]
        }
    ]
}