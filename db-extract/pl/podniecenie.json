                                                "example_id": "1d490174-e209-4a7d-ac63-3c418cd1b12b",
                                                "sense_id": "a7a9b9e3-1485-3687-9b1f-e818ff8a54cc",
                                                "text": "to get caught up in the excitement"
                                            },
                                            {
                                                "example_id": "8de84e21-01bd-4a26-af7c-948f16def18a",
                                                "sense_id": "a7a9b9e3-1485-3687-9b1f-e818ff8a54cc",
                                                "text": "By late accounts from Rotterdam, that city seems to be in a high state of philosophical excitement."
                                            },
                                            {
                                                "example_id": "f1e7e810-0cf5-4412-9614-e54c29bcc7f1",
                                                "sense_id": "a7a9b9e3-1485-3687-9b1f-e818ff8a54cc",
                                                "text": "In 1825, the first public railway carried passengers across the English countryside, setting in motion not just an engineering revolution, but an industrial one too. Imagine the awe and excitement of those first passengers as they boarded the train, unaware that they were witnessing the dawn of a new era."
                                            }
                                        ]
                                    },
