                    {
                        "sense_id": "22b15312-729e-3588-aec1-2b3dee816c6f",
                        "entry_id": "90cd9d72-82c5-3551-87c9-4c2013d0f605",
                        "glosses": [
                            "Bereitschaft und Art und Weise einer Gesellschaft, Zuwanderer aufzunehmen und zu integrieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fa9725b-f68f-4c1d-b269-8e2ba6c62a25",
                                "sense_id": "22b15312-729e-3588-aec1-2b3dee816c6f",
                                "text": "„Doch ohne Willkommenskultur werden wir weder die Integrationsprobleme überwinden noch qualifizierte Mitarbeiter finden.“"
                            },
                            {
                                "example_id": "44b0aba0-0fc3-4010-b803-68d7507c14c5",
                                "sense_id": "22b15312-729e-3588-aec1-2b3dee816c6f",
                                "text": "„Ungeachtet der bundes- und landesweiten Anstrengungen erfahren Migrantinnen und Migranten in Deutschland sowohl verschiedene Willkommenskulturen als auch unterschiedliche Akzeptanz bei der Eingliederung in die Gesellschaft bzw. in das Arbeitsleben.“"
                            }
                        ],
