                "translations": [
                    {
                        "translation_id": "235ea7dc-8b8b-4671-b4c2-33a4cf8c5a8e",
                        "source_entry_id": "9a03fa47-a3b6-3e74-a1f5-158b6c15084b",
                        "source_sense_description": "Homme chargé de l’accueil des passagers d’un avion.",
                        "target_lang_word": "Flugbegleiter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flugbegleiter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95ba67db-9228-3c25-a33d-abf97afb440a",
                                        "entry_id": "f5c40825-ca71-3e60-adf7-34867e7e50f5",
                                        "glosses": [
                                            "Betreuer von Gästen auf einer Flugreise"
                                        ],
                                        "tags": [
                                            "Beruf",
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "784e9769-57d1-4f2c-a43c-197787071815",
                                                "sense_id": "95ba67db-9228-3c25-a33d-abf97afb440a",
                                                "text": "Der Streik der Flugbegleiter löst ein großes Chaos auf dem Flughafen aus, da viele Flüge abgesagt werden mussten."
                                            },
                                            {
                                                "example_id": "9717f1a8-427c-42b8-9807-6ec3f1f961b5",
                                                "sense_id": "95ba67db-9228-3c25-a33d-abf97afb440a",
                                                "text": "„Irgendwann hat der Flugbegleiter es geschafft und muss nur noch die freien Plätze abziehen.“"
                                            },
                                            {
                                                "example_id": "428a81d3-c57f-43eb-9740-7d9e4df215ac",
                                                "sense_id": "95ba67db-9228-3c25-a33d-abf97afb440a",
                                                "text": "„Der Flugbegleiter geht ins Cockpit und erklärt dem Piloten und Co-Piloten, dass in der ersten Klasse eine Blonde sitzt, die in die Economy Class gehört.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "0279524b-cb2b-440a-8dff-d965070b3f93",
                        "source_entry_id": "9a03fa47-a3b6-3e74-a1f5-158b6c15084b",
                        "source_sense_description": "Homme chargé de l’accueil des passagers d’un avion.",
                        "target_lang_word": "Steward",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Steward",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6efd44ab-bf1f-3fd9-a74d-e1b85a47c9e3",
                                        "entry_id": "7e8db843-7c78-3f87-8a2b-27aefd220c11",
                                        "glosses": [
                                            "Betreuer von Gästen, vor allem in Flugzeugen und auf Schiffen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "325a2db0-9bdf-451d-a5d3-cb28728b9c1e",
                                                "sense_id": "6efd44ab-bf1f-3fd9-a74d-e1b85a47c9e3",
                                                "text": "Der Steward brachte ihm ein Glas Wasser."
                                            },
                                            {
                                                "example_id": "8e50f410-0541-41c5-87c6-0b0430efd589",
                                                "sense_id": "6efd44ab-bf1f-3fd9-a74d-e1b85a47c9e3",
                                                "text": "„Elisabeth beobachtete unterdessen die Mitpassagiere, die Stewardessen und Stewards, die durch den Gang glitten, lauschte dem Gemurmel und blickte aus dem Fenster, obwohl draußen alles schwarz war.“"
                                            },
                                            {
                                                "example_id": "511c004b-bc65-4d55-b859-85ba0d36a260",
                                                "sense_id": "6efd44ab-bf1f-3fd9-a74d-e1b85a47c9e3",
                                                "text": "„Der blonde Steward kommt beim Nachzählen dummerweise nicht weiter als bis zur zwölften Reihe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ef4ca826-af26-3eea-bfbd-61c21eca73db",
                                        "entry_id": "7e8db843-7c78-3f87-8a2b-27aefd220c11",
                                        "glosses": [
                                            "Rennbeobachter, die strittige Situationen kontrollieren und gegebenenfalls Strafen aussprechen"
                                        ],
                                        "tags": [
                                            "Motorsport"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4944dc9a-833c-4673-aac4-42c43176a751",
                                                "sense_id": "ef4ca826-af26-3eea-bfbd-61c21eca73db",
                                                "text": "„Rubens Barrichello wurde als Sechster nachträglich von den Stewards disqualifiziert, weil er die Boxengasse bei Rot verlassen hatte.“"
                                            },
                                            {
                                                "example_id": "94130029-c1d7-45fb-b5b2-026398dc9e64",
                                                "sense_id": "ef4ca826-af26-3eea-bfbd-61c21eca73db",
                                                "text": "„Die Rennkommissare werfen Hamilton und McLaren-Mercedes vor, sie hätten \"absichtlich Beweise\" geliefert, die die Stewards in die Irre geführt hätten.“"
                                            },
                                            {
                                                "example_id": "bf853d06-98a7-42b6-a9ae-d3ad611ffbfa",
                                                "sense_id": "ef4ca826-af26-3eea-bfbd-61c21eca73db",
                                                "text": "„Die FIA hat für 2010 bei allen F1-Rennen den Stewards einen Berater mit fahrerischer Kompetenz zur Seite gestellt, der die Schiedsrichter sachkundig unterstützen sollen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b83454ca-83ca-435d-8f7e-4219fe063972",
                        "source_entry_id": "9a03fa47-a3b6-3e74-a1f5-158b6c15084b",
