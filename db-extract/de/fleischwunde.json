                "senses": [
                    {
                        "sense_id": "4aa2fde8-1258-3002-84e5-271b8fde5508",
                        "entry_id": "abead33a-89ba-3379-8a4c-9c9cb68c4f8d",
                        "glosses": [
                            "durch äußerliche Gewalt verursachte Verletzung des Muskelgewebes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dae5a31-6a83-4699-ad08-7b4a6b749182",
                                "sense_id": "4aa2fde8-1258-3002-84e5-271b8fde5508",
                                "text": "\"Eine Fleischwunde ist eine Verletzung, bei der Muskelgewebe, jedoch keine anderen lebenswichtigen Organe, in Mitleidenschaft gezogen wird.\""
                            },
                            {
                                "example_id": "14b2b785-0965-483d-8541-a2d866491f97",
                                "sense_id": "4aa2fde8-1258-3002-84e5-271b8fde5508",
                                "text": "„Die Spitze des Entermessers glitt über meine Hüfte und verursachte eine tiefe Fleischwunde.“"
                            },
                            {
                                "example_id": "8d0e4011-f605-492f-8b85-05bde7c14934",
                                "sense_id": "4aa2fde8-1258-3002-84e5-271b8fde5508",
                                "text": "„Ihre Finger berührten kaum die tiefe Fleischwunde, und mit so vieler Geschicklichkeit und Schonung verrichtete sie ihre Aufgabe, daß ihr Patient unter ihren Händen wieder einschlief.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
