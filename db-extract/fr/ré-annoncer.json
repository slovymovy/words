                "senses": [
                    {
                        "sense_id": "3087ab22-e8a0-386e-b5eb-722f6bd329a2",
                        "entry_id": "14a993b9-7638-3753-9759-4a3440d9784e",
                        "glosses": [
                            "Autre orthographe, parfois rencontrée, de réannoncer (annoncer à nouveau)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7d2641d4-6da3-41f6-941b-dcad0d6de81d",
                                "sense_id": "3087ab22-e8a0-386e-b5eb-722f6bd329a2",
                                "text": "D’où les initiatives, comme la soiré parisienne « Holy Wins » lancée en 2002, de ré-annoncer la victoire lumineuse du Christ sur la mort."
                            },
                            {
                                "example_id": "e5111b18-c87f-4df3-b3cf-32003be7415d",
                                "sense_id": "3087ab22-e8a0-386e-b5eb-722f6bd329a2",
                                "text": "Annoncer et ré-annoncer les mauvaises nouvelles."
                            },
                            {
                                "example_id": "38f41584-a53a-4545-a683-bc2cb343e1d6",
                                "sense_id": "3087ab22-e8a0-386e-b5eb-722f6bd329a2",
                                "text": "De plus, vous pouvez grâce à la touche répétition, annoncer et ré-annoncer le résultat si nécessaire."
                            }
                        ]
                    }
