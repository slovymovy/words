                "senses": [
                    {
                        "sense_id": "2fc4b1cd-6bf0-3a9f-b5b8-1be1c6e91de8",
                        "entry_id": "272014df-0a2a-3878-a34b-a6b88289c243",
                        "glosses": [
                            "Qui se fait dans l’intérieur d’une veine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ccba3115-01f6-4687-b1e1-71d89a21345c",
                                "sense_id": "2fc4b1cd-6bf0-3a9f-b5b8-1be1c6e91de8",
                                "text": "L’urographie intraveineuse montrait, de son côté, une dilatation de l’uretère, le non-fonctionnement du rein droit cependant que la radiographie du thorax révélait des métastases circutuelles…"
                            },
                            {
                                "example_id": "c78d4300-475e-4694-b545-490a165e9982",
                                "sense_id": "2fc4b1cd-6bf0-3a9f-b5b8-1be1c6e91de8",
                                "text": "La peroxydase du raifort en intraveineux ne passe pas dans le tissu cérébral, alors qu’elle diffuse très facilement dedans lorsqu’elle est injectée dans le LCR et pompée par les astrocytes."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3a263232-c7f7-4c28-b020-cefcbe39fd9f",
                        "source_entry_id": "272014df-0a2a-3878-a34b-a6b88289c243",
                        "source_sense_id": "2fc4b1cd-6bf0-3a9f-b5b8-1be1c6e91de8",
                        "target_lang_word": "intravenös",
