    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "78f18d89-5546-34a8-93fa-c34dde4c34d4",
                    "sense_definition": "to emit moisture through the pores of the skin, typically as a result of heat, physical exertion, or fear",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The runners began to <w>sweat</w> profusely as the sun rose higher in the sky.",
                            "target_lang_translations": {
                                "ru": "Бегуны начали обильно <w>потеть</w>, когда солнце поднялось выше в небе.",
                                "zh": "随着太阳越升越高，跑步者们开始大汗淋漓地<w>出汗</w>。"
                            }
                        },
                        {
                            "text": "I always <w>sweat</w> a lot when I am nervous during a presentation.",
                            "target_lang_translations": {
                                "ru": "Я всегда сильно <w>потею</w>, когда нервничаю во время презентации.",
                                "zh": "做演讲时我一紧张就会<w>出汗</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "perspire"
                    ],
                    "common_phrases": [
                        "sweat profusely",
                        "start to sweat"
                    ],
                    "target_lang_definitions": {
                        "ru": "выделять влагу через поры кожи, обычно в результате жары, физических нагрузок или страха",
                        "zh": "指因受热、体力劳动或恐惧而从皮肤毛孔排出水分"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потеть",
                                "target_lang_sense_clarification": "выделять пот"
                            },
                            {
                                "target_lang_word": "вспотеть",
                                "target_lang_sense_clarification": "покрыться потом"
                            },
                            {
                                "target_lang_word": "покрываться испариной",
                                "target_lang_sense_clarification": "о легком поте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "出汗",
                                "target_lang_sense_clarification": "指身体排出汗液"
                            },
                            {
                                "target_lang_word": "流汗",
                                "target_lang_sense_clarification": "指汗水流出"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d3ac7581-a19f-34f5-9d7c-b11a1510b06c",
                    "sense_definition": "to worry or feel anxious about something",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "worry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should not <w>sweat</w> the small stuff and focus on what really matters.",
                            "target_lang_translations": {
                                "ru": "Тебе не стоит <w>париться</w> по пустякам, лучше сосредоточься на том, что действительно важно.",
                                "zh": "你不应该为琐事<w>发愁</w>，而应专注于真正重要的事情。"
                            }
                        },
                        {
                            "text": "Don't <w>sweat</w> it; I am sure everything will work out in the end.",
                            "target_lang_translations": {
                                "ru": "Не <w>парься</w>; я уверен, что в конце концов всё наладится.",
                                "zh": "别<w>担心</w>，我相信一切最终都会好起来的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fret",
                        "worry"
                    ],
                    "common_phrases": [
                        "don't sweat it",
                        "sweat the small stuff"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in the phrase 'don't sweat it'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "беспокоиться или испытывать тревогу по поводу чего-либо",
                        "zh": "对某事感到担忧或焦虑"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "париться",
                                "target_lang_sense_clarification": "сленг: переживать, беспокоиться"
                            },
                            {
                                "target_lang_word": "беспокоиться",
                                "target_lang_sense_clarification": "тревожиться"
                            },
                            {
                                "target_lang_word": "париться",
                                "target_lang_sense_clarification": "жарг. нервничать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "担心",
                                "target_lang_sense_clarification": "感到忧虑"
                            },
                            {
                                "target_lang_word": "发愁",
                                "target_lang_sense_clarification": "因忧虑而感到烦恼"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ae37a3ad-fcd8-36bc-919a-b9bfda75100a",
                    "sense_definition": "to work very hard or put in a great deal of effort",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "hard-work",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have been <w>sweating</w> over this project for weeks to get it finished.",
                            "target_lang_translations": {
                                "ru": "Я неделями <w>потел</w> над этим проектом, чтобы его закончить.",
                                "zh": "为了完成这个项目，我这几周一直在<w>苦干</w>。"
                            }
                        },
                        {
                            "text": "He had to <w>sweat</w> blood to earn enough money for his tuition.",
                            "target_lang_translations": {
                                "ru": "Ему пришлось <w>пахать</w> как проклятому, чтобы заработать достаточно денег на обучение.",
                                "zh": "他必须<w>卖力</w>工作才能赚够学费。"
                            }
                        }
                    ],
                    "synonyms": [
                        "slave",
                        "slog"
                    ],
                    "common_phrases": [
                        "sweat blood",
                        "sweat over something"
                    ],
                    "target_lang_definitions": {
                        "ru": "очень усердно работать или прилагать огромные усилия",
                        "zh": "非常努力地工作或付出巨大精力"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потеть",
                                "target_lang_sense_clarification": "перен. усердно трудиться над чем-либо"
                            },
                            {
                                "target_lang_word": "вкалывать",
                                "target_lang_sense_clarification": "разг. много и тяжело работать"
                            },
                            {
                                "target_lang_word": "пахать",
                                "target_lang_sense_clarification": "разг. тяжело работать на совесть"
                            },
                            {
                                "target_lang_word": "горбатиться",
                                "target_lang_sense_clarification": "жарг. много и тяжело работать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "苦干",
                                "target_lang_sense_clarification": "艰苦地工作"
                            },
                            {
                                "target_lang_word": "卖力",
                                "target_lang_sense_clarification": "尽力工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a9de5eab-3bc9-3cf5-bd9f-bf36bcd09e8f",
                    "sense_definition": "to cook vegetables slowly in a little fat in a closed pan until they are soft",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gently <w>sweat</w> the onions in butter until they are soft and translucent.",
                            "target_lang_translations": {
                                "ru": "Аккуратно <w>пассерируйте</w> лук в сливочном масле до мягкости и прозрачности.",
                                "zh": "用黄油轻轻<w>煸炒</w>洋葱，直到它们变软且呈半透明状。"
                            }
                        },
                        {
                            "text": "You need to <w>sweat</w> the vegetables before adding the stock to the soup.",
                            "target_lang_translations": {
                                "ru": "Вам нужно <w>припустить</w> овощи перед тем, как добавлять бульон в суп.",
                                "zh": "在往汤里加高汤之前，你需要先将蔬菜<w>焖</w>一下。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweat the onions"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "culinary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "медленно готовить овощи в небольшом количестве жира в закрытой сковороде до мягкости",
                        "zh": "将蔬菜放入加了少量油脂的锅中，盖上盖子小火慢煮至变软"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пассеровать",
                                "target_lang_sense_clarification": "кулинарный термин"
                            },
                            {
                                "target_lang_word": "припускать",
                                "target_lang_sense_clarification": "готовить в малом количестве жира или жидкости"
                            },
                            {
                                "target_lang_word": "томить",
                                "target_lang_sense_clarification": "медленно тушить"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "煸炒",
                                "target_lang_sense_clarification": "用少量油炒至变软"
                            },
                            {
                                "target_lang_word": "焖",
                                "target_lang_sense_clarification": "盖上盖子小火慢煮"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "097a7815-061e-3dff-a693-110b620bc42c",
                    "sense_definition": "to put someone under pressure or interrogate them intensely",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "pressure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The detectives <w>sweated</w> the suspect for hours until he finally confessed.",
                            "target_lang_translations": {
                                "ru": "Детективы часами <w>мариновали</w> подозреваемого, пока он наконец не сознался.",
                                "zh": "侦探们对嫌疑人进行了数小时的<w>逼问</w>，直到他最终招供。"
                            }
                        },
                        {
                            "text": "Stop <w>sweating</w> me about the money; I will pay you back tomorrow.",
                            "target_lang_translations": {
                                "ru": "Хватит меня <w>прессовать</w> из-за денег; я верну их завтра.",
                                "zh": "别再为了钱的事对我<w>施压</w>了，我明天就还你。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sweat the suspect"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "informal usage meaning to harass or pressure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "оказывать на кого-либо давление или подвергать интенсивному допросу",
                        "zh": "对某人施加压力或进行严厉审讯"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мариновать",
                                "target_lang_sense_clarification": "разг. заставлять долго ждать или томить"
                            },
                            {
                                "target_lang_word": "прессовать",
                                "target_lang_sense_clarification": "жарг. оказывать сильное давление"
                            },
                            {
                                "target_lang_word": "парить",
                                "target_lang_sense_clarification": "жарг. мучить допросами или давлением"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "逼问",
                                "target_lang_sense_clarification": "严厉地追问"
                            },
                            {
                                "target_lang_word": "施压",
                                "target_lang_sense_clarification": "给某人压力"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "27fdbddf-b557-385a-8572-ed8efd7ad050",
                    "sense_definition": "the salty colorless liquid that comes through your skin when you are hot, ill, or afraid",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "perspiration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He wiped the <w>sweat</w> from his forehead with the back of his hand.",
                            "target_lang_translations": {
                                "ru": "Он вытер <w>пот</w> со лба тыльной стороной ладони.",
                                "zh": "他用手背擦去了额头上的<w>汗</w>。"
                            }
                        },
                        {
                            "text": "The athlete was covered in <w>sweat</w> after finishing the marathon.",
                            "target_lang_translations": {
                                "ru": "Атлет был весь в <w>поту</w> после завершения марафона.",
                                "zh": "跑完马拉松后，运动员全身都是<w>汗水</w>。"
                            }
