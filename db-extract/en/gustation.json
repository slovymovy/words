                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "cadfb31e-df38-4cf8-87b3-e89c386e1420",
                                "sense_id": "2d4cbc05-bf71-3201-87c8-d47e52498b0a",
                                "text": "The organ of gustation is not, therefore, restricted to the production of that sense, but participates in the sense of touch."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e388aba-ad42-31f4-8b81-ef37814117a0",
                        "entry_id": "a78fddd8-f56b-3282-bb12-fde0fe6fa295",
