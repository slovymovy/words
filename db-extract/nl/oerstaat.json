                        "examples": [
                            {
                                "example_id": "715ddf56-34f0-49fd-abce-015b0480a61d",
                                "sense_id": "99cf9745-9612-36b3-b1e4-e9b397a0002d",
                                "text": "Sommige verlichte en romantische pedagogen zagen in het onbedorven kind zelfs de oerstaat van de gelukkige mens. „Het kind is de vader van de mens”, schreef een Duitse pedagoog."
                            },
                            {
                                "example_id": "71ff69a0-b3ce-486a-a2f6-1a863320d57c",
                                "sense_id": "99cf9745-9612-36b3-b1e4-e9b397a0002d",
                                "text": "“De baard staat voor de man in zijn oerstaat: de Jager. Het haar op de kin is de vrijheidsvlag van de oerman, die zich verbonden voelt met zijn voorvaderen. Zie ook baardige apen als de brazzameerkat, de baardaap (macaca silenus) en de orang-oetan. Scheren is tegennatuurlijk.”"
                            }
                        ]
                    }
