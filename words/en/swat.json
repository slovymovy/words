    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "80afa887-84b1-3d03-b95e-8f81dc08934d",
                    "sense_definition": "To hit or strike something, often an insect, with a quick motion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>swatted</w> the mosquito that was buzzing around in his bedroom.",
                            "target_lang_translations": {
                                "cs": "Zabil <w>plácnutím</w> komára, který mu bzučel v ložnici."
                            }
                        },
                        {
                            "text": "The cat <w>swatted</w> at the feather.",
                            "target_lang_translations": {
                                "cs": "Kočka <w>plácla</w> po pírku."
                            }
                        }
                    ],
                    "synonyms": [
                        "slap",
                        "smack",
                        "strike"
                    ],
                    "common_phrases": [
                        "swat a fly"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udeřit nebo plácnout něco, často hmyz, rychlým pohybem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "plácnout",
                                "target_lang_sense_clarification": "obecné vyjádření úderu rukou nebo předmětem"
                            },
                            {
                                "target_lang_word": "plesknout",
                                "target_lang_sense_clarification": "úder s charakteristickým zvukem"
                            }
