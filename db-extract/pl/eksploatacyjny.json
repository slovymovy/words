                    {
                        "translation_id": "d2729a16-a8e0-49af-85f6-a8f07f1a34bb",
                        "source_entry_id": "dbadee67-38a6-3b3d-a890-651750d60a28",
                        "source_sense_id": "0fa90fec-6563-3e35-882d-78e5b7bd6929",
                        "target_lang_word": "betrieblich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "betrieblich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                        "entry_id": "de4d2c52-ab35-3b32-ac91-b13cddf91723",
                                        "glosses": [
                                            "zu einem/einer oder vielen Betrieben/Firmen/Unternehmen gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da20cbf6-c74c-4175-9f7e-3ed4a91af355",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Die Deutsche Bahn hat erhebliche Schwierigkeiten, betriebliche Störungen, beispielsweise Hitze oder Kälte, zu bewältigen."
                                            },
                                            {
                                                "example_id": "c36c1a08-3126-47d7-a88f-b81976b3462a",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Der gesamte Güterverkehr in Deutschland könnte […] bis zum Jahr 2030 ein Fünftel weniger Treibhausgase verursachen – nämlich jährlich etwa 9 Millionen Tonnen Kohlendioxid –, wenn der Schienengüterverkehr umfassend technisch und betrieblich modernisiert würde."
                                            },
                                            {
                                                "example_id": "5884efae-6120-4699-ab74-a8f40e1582f6",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Ein Arbeitgeber darf bereits gewährten Urlaub stornieren, wenn betriebliche Gründe dies verlangen und er auf Ihre Arbeitskraft angewiesen ist."
                                            },
                                            {
                                                "example_id": "110c3c81-1fa5-4d2e-a765-072787542dee",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Grundsätzlich ist Ihr Chef dazu verpflichtet, Ihre Urlaubswünsche zu berücksichtigen und Ihren Urlaub in dem von Ihnen angegebenen Zeitraum zu genehmigen. Nur wenn dringende betriebliche Belange oder vorrangig zu berücksichtigende Interessen Ihrer Kolleginnen und Kollegen mit Ihrem Urlaubswunsch kollidieren, kann er die Genehmigung verweigern."
                                            },
                                            {
                                                "example_id": "657af092-5808-4b49-9b7d-126f84fea708",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Fast jede zweite Neueinstellung ist befristet. […] Insgesamt stieg der Anteil befristeter Jobs an der betrieblichen Gesamtbeschäftigung damit von 7,7 Prozent im Jahr 2015 auf 7,8 Prozent im vergangenen Jahr […]."
                                            },
                                            {
                                                "example_id": "1e7e58ad-986e-4974-a054-ed3c1fd87898",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Das Finanzamt Frankfurt am Main hatte bereits Ende Oktober 2017 entschieden, dass die 6,7 Millionen vom DFB an Louis-Dreyfus steuerlich „unzutreffend“ behandelt worden seien. […] Der DFB […] beharrt weiterhin darauf, die Zahlung sei betrieblich veranlasst gewesen."
                                            },
                                            {
                                                "example_id": "4f053c8f-780b-4ba4-bff6-2e7cdf6880e9",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "„Rechtsverbindliche Tarifverträge, die Menschen schützen und Belegschaften, die betriebliche Mitbestimmung wollen, will die Konzernleitung [von Amazon] nicht.“"
                                            },
                                            {
                                                "example_id": "a74a1b1f-f377-475b-a3e8-b71b9f9a4f47",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "Das Öko-Audit ist darauf ausgerichtet, eine kontinuierliche Verbesserung des betrieblichen Umweltschutzes herbeizuführen. […] die Unternehmen bestimmen selbst die für sie relevanten Ziele ihrer betrieblichen Umweltpolitik und bestimmen selbst den Weg, der dorthin führen soll."
                                            },
                                            {
                                                "example_id": "e1d18c0d-88c5-4f02-8165-20fdbd0019de",
                                                "sense_id": "50ddc4c6-091e-39fa-b0c2-713820b8cf51",
                                                "text": "[…] die betriebliche Altersvorsorge [ist] in Deutschland längst nicht so stark verbreitet, wie die Politik sich das wünschen würde. Gerade einmal 60 Prozent der Angestellten haben einen solchen Sparvertrag fürs Alter."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
