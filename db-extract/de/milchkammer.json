                            {
                                "example_id": "39ff7fad-300b-4e76-bfc1-98e7f5bb7832",
                                "sense_id": "e0e6f446-ab50-329c-8676-91861e3a5505",
                                "text": "„Unser Proviant wurde knapp, und in der Nacht, die wir auf dem Bauernhof verbrachten, zog ich zusammen mit Barnet los, und wir drangen in die Milchkammer ein.“"
                            },
                            {
                                "example_id": "4fbbc82b-2938-4929-9550-bf920997788f",
                                "sense_id": "e0e6f446-ab50-329c-8676-91861e3a5505",
                                "text": "„Besonders die Milchkammer setzte sie in Erstaunen.“"
                            }
