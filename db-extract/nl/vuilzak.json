                "senses": [
                    {
                        "sense_id": "ea39b9d0-9ab8-34ff-ab7b-2c976f1796f1",
                        "entry_id": "dd9a2295-bcd7-3b76-ba71-3b66843d940e",
                        "glosses": [
                            "plastic zak waarin men vuilnis kan doen en die later door de vuilnisophaaldienst wordt opgehaald"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57f8b301-16d3-4fdf-a189-334e06e831fb",
                                "sense_id": "ea39b9d0-9ab8-34ff-ab7b-2c976f1796f1",
                                "text": "De regen stroomt langs de ruiten, maar zijn moeder heeft de vuilzakken en laarzen al klaargezet."
                            },
                            {
                                "example_id": "37758d01-c1a9-4f83-8a06-07aa00f5c51a",
                                "sense_id": "ea39b9d0-9ab8-34ff-ab7b-2c976f1796f1",
                                "text": "'Het belangrijkste is om je comfortabel en zelfzeker te voelen. Dus als je kledij draagt die te klein is, niet flatteert, te ingewikkeld is of niet geschikt voor je leeftijd: stop daarmee. De beste stijl is zelfzekerheid: je kan een vuilzak er mooi laten uitziet als je hem draagt met trots.'"
                            }
                        ]
                    }
