                "senses": [
                    {
                        "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                        "entry_id": "cf0f646f-b657-3ffe-aa17-7c5c90fa490c",
                        "glosses": [
                            "organisierter Marathonlauf; Sportereignis, bei dem die Teilnehmer die klassische Marathondistanz (42,195 km) zurücklegen"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "320c9ab1-5db9-498f-bed2-02c36bbb0842",
                                "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                                "text": "„Im Jahre 2006 wurde der Berliner Marathon unter den fünf weltgrößten Marathonveranstaltungen der World Marathon Majors eingetragen.“"
                            },
                            {
                                "example_id": "9094dc8d-c428-4499-b496-d31b4357fc0e",
                                "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                                "text": "„Damit gehört der Königsforst-Marathon zu den ältesten Marathonveranstaltungen in Deutschland.“"
                            },
                            {
                                "example_id": "07e7ea40-95fd-41b1-a72a-930537e96381",
                                "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                                "text": "„2005 wurden in Deutschland 153 Marathonveranstaltungen angeboten und der harte Kern der Marathonläufer wird vom Deutschen Leichtathletikverband auf rund 100.000 Aktive geschätzt.“"
                            },
                            {
                                "example_id": "016f785b-f20f-4c5c-aaf9-ebdab6105bd3",
                                "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                                "text": "„Nach dem Ende seiner Sportlerkarriere begann er bei Eurosport zusammen mit Dirk Thiele Marathonveranstaltungen zu kommentieren.“"
                            },
                            {
                                "example_id": "430226e7-b193-445b-8da2-270844f30e09",
                                "sense_id": "a60991fc-9f37-33ff-89e6-9a8f7c77b88f",
                                "text": "„Der Vienna City Marathon (VCM) wurde 1984 ins Leben gerufen und ist seitdem exponentiell gewachsen und hat sich zu einer der prestigeträchtigsten Marathonveranstaltungen weltweit entwickelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                        "entry_id": "cf0f646f-b657-3ffe-aa17-7c5c90fa490c",
                        "glosses": [
                            "sehr lang andauernde Veranstaltung"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "3daf50e1-af39-409f-8938-6517a38c049f",
                                "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                                "text": "„Eine Marathonveranstaltung in Sachen Television, die die Teilnehmer täglich zwölf Stunden auf ihren Plätzen hielt.“"
                            },
                            {
                                "example_id": "b9d2645a-9b3a-4bdf-848b-4e82fa85f11f",
                                "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                                "text": "„Die Teilnehmer des ersten Fernsehfestivals, das in einem sozialistischen Land stattfand, haben in einer fünftägigen Marathonveranstaltung insgesamt 68 Programme aus 25 Ländern miteinander vergleichen können.“"
                            },
                            {
                                "example_id": "e9b27a01-616f-41d4-a4dd-3faf2a873b67",
                                "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                                "text": "„Die Mitgliederversammlung im Bürgerhaus Zähringen, an der rund 40 Menschen teilnahmen, wurde zur Marathonveranstaltung, die sich letztlich von 19.30 bis 23.10 Uhr hinzog.“"
                            },
                            {
                                "example_id": "0ab4f087-576e-41e1-a5c6-8059241305c6",
                                "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                                "text": "„Die 30-stündige Marathonveranstaltung beinhaltet Konzerte, Performances, Live- Elektronik sowie eine Klang- und Videoinstallation.“"
                            },
                            {
                                "example_id": "36cec6df-368f-4d79-9da0-529150ca699f",
                                "sense_id": "65d7797c-caa5-31a0-99e1-b5db8c320d08",
                                "text": "„In einer Marathonveranstaltung gab Stefan Obermeier vom Amt für Flurneuordnung und Umwelt aus Ravensburg, im Dorfgemeinschaftshaus einen Überblick, was ein Flurbereinigungsverfahren bedeutet und wie es abläuft.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
