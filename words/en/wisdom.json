{
    "word_family": [
        "wise",
        "wisely",
        "unwise",
        "wizard"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b856049f-de1a-36c5-8021-6440e9488ed8",
                    "sense_definition": "The ability to make sensible decisions and judgments based on personal knowledge, experience, and understanding.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "intellectual_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She showed great <w>wisdom</w> by deciding to save her money for the future instead of spending it all now.",
                            "target_lang_translations": {
                                "ru": "Она проявила большую <w>мудрость</w>, решив откладывать деньги на будущее, а не тратить всё сразу."
                            }
                        },
                        {
                            "text": "The elderly man was respected by everyone in the village for his deep <w>wisdom</w> and kind heart.",
                            "target_lang_translations": {
                                "ru": "Старика уважали все в деревне за его глубокую <w>мудрость</w> и доброе сердце."
                            }
                        }
                    ],
                    "synonyms": [
                        "sagacity",
                        "understanding",
                        "wiseness",
                        "prudence",
                        "insight"
                    ],
                    "antonyms": [
                        "foolishness",
                        "folly",
                        "stupidity"
                    ],
                    "common_phrases": [
                        "words of wisdom",
                        "conventional wisdom",
                        "infinite wisdom",
                        "gain wisdom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность принимать разумные решения и суждения на основе личных знаний, опыта и понимания."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мудрость",
                                "target_lang_sense_clarification": "качество личности"
                            },
                            {
                                "target_lang_word": "благоразумие",
                                "target_lang_sense_clarification": "рассудительность в поступках"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b130fdf-59ab-354b-ae73-84046442449d",
                    "sense_definition": "A specific piece of wise advice or a wise saying.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My grandmother shared a bit of <w>wisdom</w> with me that I have never forgotten.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка поделилась со мной житейской <w>мудростью</w>, которую я никогда не забуду."
                            }
                        },
                        {
                            "text": "The book is full of ancient <w>wisdoms</w> that are still relevant in the modern world.",
                            "target_lang_translations": {
                                "ru": "Книга полна древних <w>мудростей</w>, которые до сих пор актуальны в современном мире."
                            }
                        }
                    ],
                    "synonyms": [
                        "insight",
                        "understanding"
                    ],
                    "common_phrases": [
                        "pearls of wisdom",
                        "nugget of wisdom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный мудрый совет или высказывание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мудрость",
                                "target_lang_sense_clarification": "мудрое изречение"
                            },
                            {
                                "target_lang_word": "совет",
                                "target_lang_sense_clarification": "наставление"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "365b29cd-afb5-3aa6-8cab-0e96e980e239",
                    "sense_definition": "The capacity to understand and apply spiritual or divine truths.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "intellectual_capacity",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The monk spent his entire life in meditation seeking spiritual <w>wisdom</w>.",
                            "target_lang_translations": {
                                "ru": "Монах провел всю свою жизнь в медитации, ища духовную <w>мудрость</w>."
                            }
                        },
                        {
                            "text": "In many traditions, <w>wisdom</w> is seen as a gift from the divine to those who are humble.",
                            "target_lang_translations": {
                                "ru": "Во многих традициях <w>мудрость</w> рассматривается как дар свыше тем, кто смиренен."
                            }
                        }
                    ],
                    "synonyms": [
                        "sapience",
                        "sophy"
                    ],
                    "common_phrases": [
                        "divine wisdom",
                        "spiritual wisdom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способность понимать и применять духовные или божественные истины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мудрость",
                                "target_lang_sense_clarification": "духовное познание"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a02f722b-1be2-36b7-a0ab-c62bf224bdac",
                    "sense_definition": "An informal, shortened term for a <w>wisdom</w> tooth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "dentistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I have to go to the dentist next week to have my <w>wisdoms</w> removed.",
                            "target_lang_translations": {
                                "ru": "На следующей неделе мне нужно пойти к стоматологу, чтобы удалить <w>зубы мудрости</w>."
                            }
                        },
                        {
                            "text": "Her <w>wisdoms</w> are coming in at an angle and causing her a lot of pain.",
                            "target_lang_translations": {
                                "ru": "Ее <w>восьмерки</w> растут под углом и причиняют ей сильную боль."
                            }
                        }
                    ],
                    "common_phrases": [
                        "having wisdoms removed"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used as a shorthand for wisdom teeth"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разговорное сокращение для зуба мудрости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зубы мудрости",
                                "target_lang_sense_clarification": "разговорное обозначение восьмых зубов"
                            },
                            {
                                "target_lang_word": "восьмерки",
                                "target_lang_sense_clarification": "стоматологический сленг"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "156b1d85-30b5-3bea-a90b-153e846b29d2",
                    "sense_definition": "A collective noun used to describe a group of owls.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_nouns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the sun set, a <w>wisdom</w> of owls began to hoot from the trees surrounding the field.",
                            "target_lang_translations": {
                                "ru": "На закате <w>стая</w> сов начала ухать с деревьев, окружающих поле."
                            }
                        },
                        {
                            "text": "The poet described the gathering of birds as a <w>wisdom</w> of owls perched in the old barn.",
                            "target_lang_translations": {
                                "ru": "Поэт описал собрание птиц как <w>мудрость</w> сов, усевшихся в старом амбаре."
                            }
                        }
                    ],
                    "synonyms": [
                        "parliament"
                    ],
                    "common_phrases": [
                        "wisdom of owls"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "traditional collective noun"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для обозначения группы сов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мудрость",
                                "target_lang_sense_clarification": "архаичное название стаи сов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d71738f9-79b6-358c-a164-cfd06751fc37",
                    "sense_definition": "A collective noun used to describe a group of wombats.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "collective_nouns",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We were lucky enough to spot a <w>wisdom</w> of wombats grazing near the burrow entrance.",
                            "target_lang_translations": {
                                "ru": "Нам посчастливилось заметить <w>группу</w> вомбатов, пасущихся у входа в нору."
                            }
                        },
                        {
                            "text": "The documentary featured a <w>wisdom</w> of wombats navigating the Australian bush at night.",
                            "target_lang_translations": {
                                "ru": "В документальном фильме была показана <w>группа</w> вомбатов, пробирающихся через австралийский буш ночью."
                            }
                        }
                    ],
                    "common_phrases": [
                        "wisdom of wombats"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in Australian contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Собирательное существительное для обозначения группы вомбатов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "группа",
                                "target_lang_sense_clarification": "сообщество вомбатов"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "a5b79a60-c25b-327a-874c-10da1365fa3c",
                    "sense_definition": "The <w>Wisdom</w> of Solomon, a deuterocanonical book of the Old Testament.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_texts",
                    "name_type": "work_of_art_name",
                    "examples": [
                        {
                            "text": "The priest read a passage from the Book of <w>Wisdom</w> during the morning service.",
                            "target_lang_translations": {
                                "ru": "Священник прочитал отрывок из Книги <w>Премудрости</w> во время утренней службы."
                            }
                        },
                        {
                            "text": "Scholars often compare the themes in <w>Wisdom</w> with other Hellenistic Jewish literature.",
                            "target_lang_translations": {
                                "ru": "Ученые часто сравнивают темы Книги <w>Премудрости</w> с другой эллинистической еврейской литературой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "Book of Wisdom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Книга Премудрости Соломона, одна из книг Ветхого Завета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Премудрость",
                                "target_lang_sense_clarification": "в названии библейской книги"
                            }
                        ]
                    }
                }
            ]
        }
    ]
