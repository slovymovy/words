                    {
                        "sense_id": "7bea5faa-4539-3298-8024-c81e36ac3593",
                        "entry_id": "a6e70bb5-bee3-3d2b-9ae0-343d5972ab9a",
                        "glosses": [
                            "geowissenschaftliches Fachgebiet, das sich mit den Relief der Erdoberfläche beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88b95c38-0cac-44d0-80d5-fc3a8949e126",
                                "sense_id": "7bea5faa-4539-3298-8024-c81e36ac3593",
                                "text": "„Abgesehen von der Ebene des Rhein-Main-Gebiets mit einer Höhe von 100–200 m. ü. NN., ist die Orografie Hessens von hügeligem Gelände mit Höhen von 400–600 m. ü. NN. geprägt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4918e57-0ff4-49ce-8e73-e455411ac8bb",
                        "source_entry_id": "a6e70bb5-bee3-3d2b-9ae0-343d5972ab9a",
                        "source_sense_id": "7bea5faa-4539-3298-8024-c81e36ac3593",
                        "source_sense_description": "geowissenschaftliches Fachgebiet, das sich mit den Relief der Erdoberfläche beschäftigt",
                        "target_lang_word": "orography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a4d4a8c-e933-329e-930d-c6b55832f071",
                                        "entry_id": "4b4e3c8b-3033-33d6-8a76-2d132f85f748",
                                        "glosses": [
                                            "The scientific study, or a physical description of mountains."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f9298cb-77da-4de4-9dd5-42c0c2fc350e",
                                                "sense_id": "3a4d4a8c-e933-329e-930d-c6b55832f071",
                                                "text": "A knowledge of the Hydrography of a country aids as much in determining its geology as does its Orography, — that is, a description of its mountains."
                                            },
                                            {
                                                "example_id": "396f331c-8287-4b15-8ce6-6e3474530b4c",
                                                "sense_id": "3a4d4a8c-e933-329e-930d-c6b55832f071",
                                                "text": "Orography: A description of mountains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9072489f-aa5b-328b-8560-b576e085cd0a",
                                        "entry_id": "4b4e3c8b-3033-33d6-8a76-2d132f85f748",
                                        "glosses": [
                                            "The orographic features of a region."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7251711f-eb9b-4834-bdfe-8c864d648b80",
                                                "sense_id": "9072489f-aa5b-328b-8560-b576e085cd0a",
                                                "text": "Morocco was in 1883-1884 the scene of important explorations by de Foucauld, a Frenchman who, disguised as a Jew, crossed and re-crossed the Atlas and supplied the first trustworthy information as to the orography of many parts of the chain."
                                            },
                                            {
                                                "example_id": "3e377ca2-ec6b-4e98-8366-0df9f85d12fd",
                                                "sense_id": "9072489f-aa5b-328b-8560-b576e085cd0a",
                                                "text": "Most flows actually occur, of course, over non-uniform orography and consequently in numerical models of such flows it is necessary to transform the coordinates so that the equations accurately represent flows in such terrain (Gal-Chen and Somerville 1975)."
                                            },
                                            {
                                                "example_id": "916282a7-cfa6-4996-b7fc-fbfde12ce45b",
                                                "sense_id": "9072489f-aa5b-328b-8560-b576e085cd0a",
                                                "text": "The independent scientists of the Scientific Advisory Committee (SAC) expressed concerns about how the spectral model would deal with steep mountains.[…]It was this work that lead to development of the envelope orography outlined below."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
