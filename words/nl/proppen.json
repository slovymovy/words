    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "eaabd994-d9de-3c34-ab14-9dd5c9508827",
                    "sense_definition": "Iets met kracht en zonder veel overleg samendrukken tot een slordige massa of prop.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "proppen_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je moet je kleren niet zo in de kast <w>proppen</w>, want dan gaan ze kreuken.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>stuff</w> your clothes into the closet like that, because they will wrinkle."
                            }
                        },
                        {
                            "text": "Hij <w>propte</w> het papier in zijn zak nadat hij het snel had gelezen.",
                            "target_lang_translations": {
                                "en": "He <w>crammed</w> the paper into his pocket after reading it quickly."
                            }
                        }
                    ],
                    "synonyms": [
                        "proppen",
                        "verfrommelen"
                    ],
                    "antonyms": [
                        "opvouwen",
                        "gladstrijken"
                    ],
                    "common_phrases": [
                        "in de kast proppen",
                        "in je zak proppen"
                    ],
                    "target_lang_definitions": {
                        "en": "To compress something with force and without much care into a messy mass or ball."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "stuff",
                                "target_lang_sense_clarification": "to push something into a small space"
                            },
                            {
                                "target_lang_word": "cram",
                                "target_lang_sense_clarification": "to force something into a space"
                            },
                            {
                                "target_lang_word": "crumple",
                                "target_lang_sense_clarification": "to crush into a ball"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "87962ce9-d3be-33d0-a83e-c313d44cf5fb",
                    "sense_definition": "Mensen of dingen heel dicht op elkaar duwen in een beperkte ruimte.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "proppen_fysiek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Tijdens het spitsuur werden alle passagiers in de kleine treinwagon <w>gepropt</w>.",
                            "target_lang_translations": {
                                "en": "During rush hour, all the passengers were <w>squashed</w> into the small train carriage."
                            }
                        },
                        {
                            "text": "We stonden met het hele kantoor in de kleine kantine <w>gepropt</w> voor de borrel.",
                            "target_lang_translations": {
                                "en": "We were <w>squeezed</w> into the small canteen with the whole office for drinks."
                            }
                        }
                    ],
                    "synonyms": [
                        "stouwen",
                        "proppen",
                        "dringen"
                    ],
                    "antonyms": [
                        "verspreiden"
                    ],
                    "common_phrases": [
                        "in een ruimte proppen",
                        "vol gepropt staan"
                    ],
                    "target_lang_definitions": {
                        "en": "To push people or things very close together in a limited space."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "squash",
                                "target_lang_sense_clarification": "to squeeze into a small space"
                            },
                            {
                                "target_lang_word": "cram",
                                "target_lang_sense_clarification": "to pack tightly"
                            },
                            {
                                "target_lang_word": "squeeze",
                                "target_lang_sense_clarification": "to fit into a tight area"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1ec0a7f4-e8e6-3328-8d21-3b550d1f9569",
                    "sense_definition": "Meervoud van het zelfstandig naamwoord <w>prop</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er lagen overal <w>proppen</w> papier op de vloer van het klaslokaal.",
                            "target_lang_translations": {
                                "en": "There were <w>wads</w> of paper everywhere on the classroom floor."
                            }
                        },
                        {
                            "text": "De vogel maakte een nestje van kleine takjes en zachte <w>proppen</w> wol.",
                            "target_lang_translations": {
                                "en": "The bird made a nest out of small twigs and soft <w>balls</w> of wool."
                            }
                        }
                    ],
