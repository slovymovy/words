                    "sense_id": "65c0c5fd-e023-3e17-bf22-5c94f434e6ab",
                    "sense_definition": "Находясь на небольшом расстоянии от кого-либо или чего-либо; рядом, около.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "spatial",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы решили остановиться на ночлег <w>близ</w> небольшого лесного озера.",
                            "target_lang_translations": {
                                "en": "We decided to stop for the night <w>near</w> a small forest lake.",
                                "de": "Wir beschlossen, <w>nahe</w> einem kleinen Waldsee zu übernachten."
                            }
                        },
                        {
                            "text": "Старинная церковь была построена <w>близ</w> центральной площади города.",
                            "target_lang_translations": {
                                "en": "The old church was built <w>near</w> the city's central square.",
                                "de": "Die alte Kirche wurde <w>in der Nähe</w> des zentralen Stadtplatzes erbaut."
                            }
                        }
                    ],
                    "synonyms": [
                        "около",
                        "возле",
                        "у",
                        "рядом с",
                        "вблизи"
                    ],
                    "antonyms": [
                        "вдалеке от"
                    ],
                    "common_phrases": [
                        "близ города",
                        "близ реки",
                        "близ дороги"
                    ],
                    "target_lang_definitions": {
                        "en": "Located at a short distance from someone or something; nearby.",
                        "de": "In geringer Entfernung von jemandem oder etwas; in der Nähe."
                    },
                    "translations": {
