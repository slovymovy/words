                "senses": [
                    {
                        "sense_id": "9d6ab681-cd63-34ed-bc8f-948ebb4d5e44",
                        "entry_id": "7f94bc39-a043-34e3-98b1-b8ccb9608e04",
                        "glosses": [
                            "Eisenbahnwagen zum Transport von Tieren"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34ac4683-cb46-4beb-a0ed-00ec322a54db",
                                "sense_id": "9d6ab681-cd63-34ed-bc8f-948ebb4d5e44",
                                "text": "„Wir wussten nämlich nicht, wohin wir mit Viehwaggons gebracht werden sollten, es war wie eine Münze hochwerfen.“"
                            },
                            {
                                "example_id": "69c51f43-390e-4dc9-a488-124d31595057",
                                "sense_id": "9d6ab681-cd63-34ed-bc8f-948ebb4d5e44",
                                "text": "„Und nicht gerade friedensmäßig sieht er aus, widersprüchlich ist er zusammengesetzt: vorn Personenwagen mit vernagelten Fenstern, hinten Viehwaggons.“"
                            },
                            {
                                "example_id": "aef30e76-c31b-4021-ab89-26ddb0ecea79",
                                "sense_id": "9d6ab681-cd63-34ed-bc8f-948ebb4d5e44",
                                "text": "„Es gab insgesamt mehr als 50 weitere Transporte in Viehwaggons, bewacht von der Feldgendarmerie und französischen Polizisten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
