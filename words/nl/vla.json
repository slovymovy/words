                    "frequency": "High",
                    "semantic_group_id": "zuiveltoetje",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je zo je <w>vla</w> nog wilt, moet je wel je bord leegeten!",
                            "target_lang_translations": {
                                "en": "If you still want your <w>custard</w> in a bit, you need to finish your plate!"
                            }
                        },
                        {
                            "text": "We eten vanavond vanille met chocolade als <w>vla</w> na de maaltijd.",
                            "target_lang_translations": {
                                "en": "Tonight we are having vanilla and chocolate <w>custard</w> after dinner."
                            }
                        }
                    ],
                    "synonyms": [
                        "pudding"
                    ],
                    "common_phrases": [
                        "een kommetje vla",
                        "pak vla"
                    ],
                    "target_lang_definitions": {
                        "en": "A sweet, thick dairy dessert made from milk, eggs, starch, and flavourings, typically eaten cold."
                    },
