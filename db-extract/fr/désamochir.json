                "senses": [
                    {
                        "sense_id": "1b31cda7-11a5-37a6-9013-f650c938db74",
                        "entry_id": "3f81ecae-3293-3a72-b08d-59e74e042be0",
                        "glosses": [
                            "Rendre moins moche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0055f94e-f96f-4013-b520-88d2b3fb6193",
                                "sense_id": "1b31cda7-11a5-37a6-9013-f650c938db74",
                                "text": "C'est l'histoire d'un gentil brigand, Charlix, qui aide une sorcière à « désamochir » une princesse vraiment très laide…"
                            },
                            {
                                "example_id": "703b8451-bdb0-4a15-b84c-40d860d0deff",
                                "sense_id": "1b31cda7-11a5-37a6-9013-f650c938db74",
                                "text": "Je suis partie du motif des mes p'tites étiquettes récemment reçues pour essayer de désamochir mon blog."
                            },
                            {
                                "example_id": "219fc79c-31ed-44ba-957b-487a70541711",
                                "sense_id": "1b31cda7-11a5-37a6-9013-f650c938db74",
                                "text": "On peut juste essayer de le \"désamochir\" en y mettant un maximum de plantations."
                            },
                            {
                                "example_id": "cab8ba32-72fe-458e-92ac-4902c3f3d42d",
                                "sense_id": "1b31cda7-11a5-37a6-9013-f650c938db74",
                                "text": "Merci à Laeti pour le maquillage (dur dur de me désamochir !)"
                            }
                        ]
                    }
