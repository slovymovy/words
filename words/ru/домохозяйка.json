    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "182b8831-c36c-3a80-b855-cfc9970212f9",
                    "sense_definition": "Женщина, которая ведёт домашнее хозяйство своей семьи и не работает по найму",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "быт",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После рождения второго ребёнка она решила уйти с работы и стать <w>домохозяйкой</w>.",
                            "target_lang_translations": {
                                "nl": "Na de geboorte van haar tweede kind besloot ze haar baan op te zeggen en <w>huisvrouw</w> te worden."
                            }
                        },
                        {
                            "text": "Опытная <w>домохозяйка</w> знает множество способов быстро навести порядок в доме.",
                            "target_lang_translations": {
                                "nl": "Een ervaren <w>huisvrouw</w> kent veel manieren om het huis snel op te ruimen."
                            }
                        }
                    ],
                    "synonyms": [
                        "хозяйка"
                    ],
                    "common_phrases": [
                        "примерная домохозяйка",
                        "опытная домохозяйка"
                    ],
                    "target_lang_definitions": {
                        "nl": "Vrouw die het huishouden van haar gezin doet en niet buitenshuis werkt"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huisvrouw",
                                "target_lang_sense_clarification": "meest gebruikelijke term voor een vrouw die het huishouden runt"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3b97f42f-0a25-323e-9597-edfbacb71a49",
                    "sense_definition": "Женщина, являющаяся владелицей дома или жилья; женск. к <w>домохозяин</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "владение_имуществом",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Пожилая <w>домохозяйка</w> строго предупредила жильцов о соблюдении тишины в вечернее время.",
                            "target_lang_translations": {
                                "nl": "De bejaarde <w>huisbazin</w> waarschuwde de huurders streng om 's avonds stil te zijn."
                            }
                        },
                        {
                            "text": "Новая <w>домохозяйка</w> показала арендаторам свободные комнаты на втором этаже.",
                            "target_lang_translations": {
                                "nl": "De nieuwe <w>huisbazin</w> liet de huurders de vrije kamers op de tweede verdieping zien."
                            }
                        }
                    ],
                    "synonyms": [
                        "домовладелица"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "разговорное значение"
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Vrouw die eigenaar is van een woning of woonruimte verhuurt"
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "huiseigenares",
                                "target_lang_sense_clarification": "vrouwelijke eigenaar van een huis"
                            },
                            {
                                "target_lang_word": "huisbazin",
                                "target_lang_sense_clarification": "vrouw die woonruimte verhuurt aan huurders"
                            },
                            {
                                "target_lang_word": "verhuurster",
                                "target_lang_sense_clarification": "vrouw die een woning verhuurt"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}