                "senses": [
                    {
                        "sense_id": "60914dc4-a5a4-359a-8060-66b409349aa0",
                        "entry_id": "49c89fa1-373f-3083-8962-7e5b1340706d",
                        "glosses": [
                            "Person, die sich mit der Erforschung von Sprichwörtern befasst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6e1def9f-4174-4621-95c4-d084615215e5",
                                "sense_id": "60914dc4-a5a4-359a-8060-66b409349aa0",
                                "text": "„Neben den Sprichwortforschern, den sogenannten »Parömiologen« und den Volkskundlern kümmern sich Disziplinen wie Literaturwissenschaft, Sprachgeschichte und Linguistik, Anthropologie uns Soziologie, Psychologie und Pädagogik um das Sujet.“"
                            },
                            {
                                "example_id": "24f7856a-cb03-4703-8d8d-1554594b6ee1",
                                "sense_id": "60914dc4-a5a4-359a-8060-66b409349aa0",
                                "text": "„Wolfgang Mieder (* 17. Februar 1944 in Nossen) ist Professor für deutsche Sprache und Folklore an der US-amerikanischen University of Vermont in Burlington (Vermont) sowie international anerkannter Parömiologe.“"
                            },
                            {
                                "example_id": "895c0b73-de84-453c-bbde-c63b95170ddd",
                                "sense_id": "60914dc4-a5a4-359a-8060-66b409349aa0",
                                "text": "„Als Sie Ihre Kindheit in Lübeck verbracht haben, haben Sie daran gedacht, dass Sie Parömiologe werden könnten?“"
                            },
                            {
                                "example_id": "65635ae3-df5e-4cd4-bd9b-95d49d9d50d2",
                                "sense_id": "60914dc4-a5a4-359a-8060-66b409349aa0",
                                "text": "„Archer Taylor (1890 - 1973) war ein US - amerikanischer Germanist, Volkskundler und Parömiologe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
