                "senses": [
                    {
                        "sense_id": "88876a5d-6293-3c07-b923-d8ce315f9cc6",
                        "entry_id": "f83204ae-248a-3c01-b89a-af25ba2f3867",
                        "glosses": [
                            "Personne appartenant au peuple des Micmacs."
                        ],
                        "tags": [
                            "Ethnonymie"
                        ],
                        "examples": [
                            {
                                "example_id": "28d99b3d-9f42-473b-b404-256dee407b04",
                                "sense_id": "88876a5d-6293-3c07-b923-d8ce315f9cc6",
                                "text": "M. Gloade explique que chaque recoin du Mi’kma’ki – le territoire traditionnel non cédé des Mi’kmaq – peut avoir des significations différentes et que les mois et les thèmes peuvent donc différer."
                            },
                            {
                                "example_id": "09510b01-88c7-497a-8555-3d40158060a1",
                                "sense_id": "88876a5d-6293-3c07-b923-d8ce315f9cc6",
                                "text": "Les Mi’kmaw croient à l’utilisation de tout ce qu’ils récoltent, des animaux aux plantes, alors les familles ont commencé à fabriquer des outils et des instruments à partir du bois supplémentaire."
                            },
                            {
                                "example_id": "28830d49-855a-498e-9788-00434751826c",
                                "sense_id": "88876a5d-6293-3c07-b923-d8ce315f9cc6",
                                "text": "Ryan Francis, un Mi’kmaw de 27 ans, est un des trois finalistes pour le prix Willie O'Ree, héros de la communauté, remis par la Ligue nationale de hockey (LNH) pour son travail avec le programme de hockey destiné aux filles autochtones de la Nouvelle-Écosse."
                            }
                        ]
                    }
