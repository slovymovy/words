{
    "word_family": [
        "wąsaty",
        "wąsik",
        "wąsisko"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "937641c3-c020-340e-8ec2-56f01b1b084b",
                    "sense_definition": "zarost rosnący nad górną wargą u mężczyzn",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "zarost",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mój dziadek zawsze nosił gęste <w>wąsy</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка всегда носил густые <w>усы</w>."
                            }
                        },
                        {
                            "text": "Młody chłopak zapuścił sobie pierwsze <w>wąsy</w>.",
                            "target_lang_translations": {
                                "ru": "Молодой парень отрастил себе первые <w>усы</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "podkręcać wąsy",
                        "golić wąsy"
                    ],
                    "target_lang_definitions": {
                        "ru": "волосы, растущие над верхней губой у мужчин"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усы",
                                "target_lang_sense_clarification": "растительность на лице"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fb75314c-aa0a-363b-8076-576061fb32e3",
                    "sense_definition": "długi, sztywny włos czuciowy na pysku zwierzęcia",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kot porusza swoimi <w>wąsami</w>, gdy wyczuwa zapach jedzenia.",
                            "target_lang_translations": {
                                "ru": "Кот шевелит своими <w>усами</w>, когда чувствует запах еды."
                            }
                        },
                        {
                            "text": "Długie <w>wąsy</w> pomagają zwierzętom orientować się w ciemności.",
                            "target_lang_translations": {
                                "ru": "Длинные <w>усы</w> (вибриссы) помогают животным ориентироваться в темноте."
                            }
                        }
                    ],
                    "synonyms": [
                        "wibrys",
                        "włos czuciowy"
                    ],
                    "target_lang_definitions": {
                        "ru": "длинный, жесткий чувствительный волос на морде животного"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вибриссы",
                                "target_lang_sense_clarification": "биологический термин для чувствительных волос"
                            },
                            {
                                "target_lang_word": "усы",
                                "target_lang_sense_clarification": "разговорное название чувствительных волос у животных"
                            }
                        ]
                    },
                    "common_phrases": [
                        "kocie wąsy"
                    ]
                },
                {
                    "sense_id": "c1bc59e0-5e59-3aa8-84f1-dde57db9ccc5",
                    "sense_definition": "giętki wyrostek rośliny pnącej służący do czepiania się podpór",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Winorośl owija się wokół kratki za pomocą swoich <w>wąsów</w>.",
                            "target_lang_translations": {
                                "ru": "Виноградная лоза обвивается вокруг решетки с помощью своих <w>усиков</w>."
                            }
                        },
                        {
                            "text": "Delikatne <w>wąsy</w> grochu szukają oparcia na płocie.",
                            "target_lang_translations": {
                                "ru": "Нежные <w>усики</w> гороха ищут опору на заборе."
                            }
                        }
                    ],
                    "synonyms": [
                        "wić",
                        "witka"
                    ],
                    "target_lang_definitions": {
                        "ru": "гибкий отросток вьющегося растения, служащий для закрепления на опоре"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усики",
                                "target_lang_sense_clarification": "ботанический термин для органов прикрепления растений"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0f38734e-ae9d-37d2-9cf1-e808207cd944",
                    "sense_definition": "ostra, sztywna wypustka na kłosie zboża",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "botanika",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Kłosy jęczmienia mają bardzo długie i kłujące <w>wąsy</w>.",
                            "target_lang_translations": {
                                "ru": "Колосья ячменя имеют очень длинные и колючие <w>ости</w>."
                            }
                        },
                        {
                            "text": "Wiatr porusza <w>wąsami</w> dojrzałego żyta na polu.",
                            "target_lang_translations": {
                                "ru": "Ветер колышет <w>ости</w> созревшей ржи в поле."
                            }
                        }
                    ],
                    "synonyms": [
                        "ość"
                    ],
                    "target_lang_definitions": {
                        "ru": "острый, жесткий отросток на колосе злака"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ость",
                                "target_lang_sense_clarification": "ботанический термин для отростка на колосе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dcde3a8-ef94-3dc4-98ce-22404ced95ee",
                    "sense_definition": "długi, cienki wyrostek u niektórych zwierząt wodnych",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biologia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Krewetka używa swoich <w>wąsów</w> do badania otoczenia w wodzie.",
                            "target_lang_translations": {
                                "ru": "Креветка использует свои <w>усики</w> для исследования окружающей среды в воде."
                            }
                        },
                        {
                            "text": "Niektóre ryby posiadają długie <w>wąsy</w> przy otworze gębowym.",
                            "target_lang_translations": {
                                "ru": "Некоторые рыбы имеют длинные <w>усики</w> возле ротового отверстия."
                            }
                        }
                    ],
                    "synonyms": [
                        "cirrus"
                    ],
                    "target_lang_definitions": {
                        "ru": "длинный, тонкий отросток у некоторых водных животных"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "усики",
                                "target_lang_sense_clarification": "органы осязания у ракообразных и рыб"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f330d511-febf-3d07-b0ff-50ed5af75431",
                    "sense_definition": "polskie nazwisko męskie",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "nazwisko",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Pan <w>Wąs</w> jest naszym nowym sąsiadem z trzeciego piętra.",
                            "target_lang_translations": {
                                "ru": "Господин <w>Вонс</w> — наш новый сосед с третьего этажа."
                            }
                        },
                        {
                            "text": "Na spotkanie przyszedł dzisiaj tylko pan <w>Wąs</w>.",
                            "target_lang_translations": {
                                "ru": "На встречу пришел сегодня только господин <w>Вонс</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "nazwisko"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "польская мужская фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Вонс",
                                "target_lang_sense_clarification": "транслитерация польской фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}