{
    "word_family": [
        "knikken",
        "geknakt",
        "knikje"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d6dc81a0-0161-379b-9dfb-be901b2d1021",
                    "sense_definition": "Een snelle neerwaartse beweging met het hoofd als bevestiging of groet.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "hoofdbeweging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf me een vriendelijke <w>knik</w> toen hij de kamer binnenkwam.",
                            "target_lang_translations": {
                                "en": "He gave me a friendly <w>nod</w> when he entered the room."
                            }
                        },
                        {
                            "text": "Met een korte <w>knik</w> van zijn hoofd liet hij weten dat hij het begreep.",
                            "target_lang_translations": {
                                "en": "With a brief <w>nod</w> of his head, he let it be known that he understood."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoofdknik"
                    ],
                    "common_phrases": [
                        "een korte knik",
                        "met een knik"
                    ],
                    "target_lang_definitions": {
                        "en": "A quick downward movement of the head as a sign of agreement, acknowledgment, or greeting."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nod",
                                "target_lang_sense_clarification": "a gesture of the head"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7e0bfc0a-9774-3d5d-a4ef-f88c74acfee4",
                    "sense_definition": "Een scherpe buiging of geknakte plek in een voorwerp of lijn.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "buiging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er zit een scherpe <w>knik</w> in de tuinslang, waardoor er geen water meer doorheen stroomt.",
                            "target_lang_translations": {
                                "en": "There is a sharp <w>kink</w> in the garden hose, preventing water from flowing through."
                            }
                        },
                        {
                            "text": "De weg maakt na de spoorwegovergang een plotselinge <w>knik</w> naar links.",
                            "target_lang_translations": {
                                "en": "The road makes a sudden <w>bend</w> to the left after the railway crossing."
                            }
                        }
                    ],
                    "synonyms": [
                        "bocht",
                        "vouw",
                        "knikje"
                    ],
                    "common_phrases": [
                        "een scherpe knik"
                    ],
                    "target_lang_definitions": {
                        "en": "A sharp bend, fold, or kink in an object, line, or path."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "kink",
                                "target_lang_sense_clarification": "in a hose, rope, or pipe"
                            },
                            {
                                "target_lang_word": "bend",
                                "target_lang_sense_clarification": "sharp turn in a road or line"
                            },
                            {
                                "target_lang_word": "fold",
                                "target_lang_sense_clarification": "crease or sharp bend in material"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ee878d62-0790-3fa8-9039-8f55a1c6d461",
                    "sense_definition": "Eerste-persoon enkelvoud tegenwoordige tijd van <w>knikken</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>knik</w> vriendelijk naar de buurman als ik hem op straat tegenkom.",
                            "target_lang_translations": {
                                "en": "I <w>nod</w> friendly to the neighbor when I run into him on the street."
                            }
                        },
                        {
                            "text": "Als men mij vraagt of ik akkoord ga, <w>knik</w> ik meestal zwijgend.",
                            "target_lang_translations": {
                                "en": "When people ask me if I agree, I usually <w>nod</w> silently."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "first-person singular present indicative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "First-person singular present indicative of the verb 'knikken' (to nod)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nod",
                                "target_lang_sense_clarification": "first-person singular present tense"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7c865767-39f8-34e6-8cf0-d6e6345fa68e",
                    "sense_definition": "Gebiedende wijs van <w>knikken</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "vervoeging",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Knik</w> even als je me kunt horen, want het is hier erg luidruchtig.",
                            "target_lang_translations": {
                                "en": "<w>Nod</w> for a moment if you can hear me, because it is very noisy here."
                            }
                        },
                        {
                            "text": "<w>Knik</w> ja als je akkoord gaat met dit voorstel.",
                            "target_lang_translations": {
                                "en": "<w>Nod</w> yes if you agree to this proposal."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "imperative"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Imperative form of the verb 'knikken' (to nod)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "nod",
                                "target_lang_sense_clarification": "imperative command"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}