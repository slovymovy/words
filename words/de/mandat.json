            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b756c71c-bd06-326f-bd53-dddf639716c6",
                    "sense_definition": "Durch eine Wahl erteilter Auftrag und Sitz in einem Parlament oder einer anderen politischen Vertretung.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "politik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nach der erfolgreichen Wahl konnte die Abgeordnete ihr neues <w>Mandat</w> im Bundestag antreten."
                        },
                        {
                            "text": "Der Politiker entschied sich dazu, sein <w>Mandat</w> aus gesundheitlichen Gründen vorzeitig niederzulegen."
                        }
                    ],
                    "synonyms": [],
                    "common_phrases": [
                        "ein Mandat erringen",
                        "ein Mandat niederlegen",
                        "sein Mandat ausüben"
                    ]
                },
                {
                    "sense_id": "30021e50-9cce-336a-a420-3401ce36d7ac",
                    "sense_definition": "Auftrag an einen Rechtsanwalt oder eine Kanzlei zur rechtlichen Vertretung und Beratung eines Mandanten.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "recht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Rechtsanwältin erklärte sich bereit, das anspruchsvolle <w>Mandat</w> vor dem Gericht zu übernehmen."
                        },
                        {
                            "text": "Wegen schwerwiegender Differenzen mit dem Mandanten musste die Kanzlei das <w>Mandat</w> niederlegen."
                        }
                    ],
                    "synonyms": [
                        "Vertretungsauftrag"
                    ],
                    "common_phrases": [
                        "ein Mandat übernehmen",
                        "ein Mandat erteilen",
                        "das Mandat niederlegen"
                    ]
                },
                {
                    "sense_id": "ff97e325-4689-3509-aaa7-3d948f96841a",
                    "sense_definition": "Völkerrechtlicher Auftrag einer internationalen Organisation an Staaten zur treuhänderischen Verwaltung oder Friedenssicherung.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "voelkerrecht",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die internationalen Friedenstruppen operieren in der Krisenregion unter einem klaren <w>Mandat</w> der Vereinten Nationen."
                        },
                        {
                            "text": "Der UN-Sicherheitsrat verlängerte das <w>Mandat</w> der Blauhelmtruppe um ein weiteres Jahr."
                        }
                    ],
                    "common_phrases": [
                        "ein Mandat verlängern",
                        "ein Mandat erteilen"
                    ]
                },
                {
                    "sense_id": "93e13ceb-1c06-37b8-a081-06b8ee5e9d91",
                    "sense_definition": "Schriftlicher Befehl oder rechtskräftiger Erlass eines Herrschers an Amtsträger oder Untertanen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historisch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Der Fürst erließ ein strenges <w>Mandat</w> an die Verwalter aller Provinzen."
                        },
                        {
                            "text": "In seinem kaiserlichen <w>Mandat</w> forderte der Regent die bedingungslose Treue seiner Untertanen."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historische Verwendung für herrschaftliche Erlasse"
                        }
                    ]
                }
            ]
        }
    ]
