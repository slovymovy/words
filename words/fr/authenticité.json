            "senses": [
                {
                    "sense_id": "b72196e9-229a-3d12-8d8b-45f28902055e",
                    "sense_definition": "Caractère de ce qui est authentique, dont la vérité, l'origine ou la conformité est formellement établie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conformite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Un expert d'art a minutieusement examiné le tableau ancien afin d'en confirmer l'<w>authenticité</w>."
                        },
                        {
                            "text": "Le notaire a immédiatement vérifié l'<w>authenticité</w> de la signature figurant en bas du contrat."
                        }
                    ],
                    "synonyms": [
                        "légitimité",
                        "véracité"
                    ],
                    "antonyms": [
                        "fausseté",
                        "inauthenticité"
                    ],
                    "common_phrases": [
                        "certificat d'authenticité",
                        "garantir l'authenticité",
                        "prouver l'authenticité"
                    ]
                },
                {
                    "sense_id": "9edcb612-3941-399d-a331-ccd1bdb9a4d6",
                    "sense_definition": "Qualité d'une personne, d'un lieu ou d'une attitude qui fait preuve de sincérité et de naturel, sans faux-semblant.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "sincerite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les spectateurs ont été particulièrement émus par l'<w>authenticité</w> et la sincérité de cette jeune actrice."
                        },
                        {
                            "text": "Ce vieux village de pêcheurs a su préserver toute son <w>authenticité</w> malgré l'afflux touristique."
                        }
                    ],
                    "synonyms": [
                        "naturel",
                        "sincérité",
                        "spontanéité"
                    ],
                    "antonyms": [
                        "affectation",
                        "artifice",
                        "hypocrisie"
                    ],
                    "common_phrases": [
                        "manquer d'authenticité",
                        "perdre son authenticité",
                        "touche d'authenticité"
                    ]
                }
            ]
        }
