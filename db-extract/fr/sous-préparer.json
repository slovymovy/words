                "senses": [
                    {
                        "sense_id": "300130c7-b85c-318a-8799-37d6139b0040",
                        "entry_id": "1e73ff27-a317-3a34-a9ed-8279ecbc8ba1",
                        "glosses": [
                            "Préparer de façon insuffisante."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "725ff444-28f1-44e6-8565-acf0adf570e2",
                                "sense_id": "300130c7-b85c-318a-8799-37d6139b0040",
                                "text": "Les gens sous-estiment, et donc sous-préparent, leurs frais de santé à la retraite."
                            },
                            {
                                "example_id": "13c583c9-1adc-46c9-b8f5-8c37fbd37a3a",
                                "sense_id": "300130c7-b85c-318a-8799-37d6139b0040",
                                "text": "Et je vois que beaucoup de chefs débutants mettent trop l'accent sur le bâton et sous-préparent l'analyse réelle de la musique."
                            },
                            {
                                "example_id": "7f230203-e09f-41c0-b3c2-7b578d73126a",
                                "sense_id": "300130c7-b85c-318a-8799-37d6139b0040",
                                "text": "Mais comme pour toutes les activités rituelles, il est facile de se sous-préparer et de partir dans de mauvaises directions"
                            }
                        ]
                    }
