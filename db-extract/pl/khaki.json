                                "example_id": "f7a653b4-d17c-40d2-8fbd-cafc87eda537",
                                "sense_id": "3a8e5b86-9243-3d96-8850-10500f343440",
                                "text": "Moja sukienka jest w kolorze khaki."
                            },
                            {
                                "example_id": "e614faca-3ec1-41f9-951c-c191ed25612d",
                                "sense_id": "3a8e5b86-9243-3d96-8850-10500f343440",
