        "fr-extract.jsonl": [
            {
                "entry_id": "d4446504-3ac9-3f9b-92af-1f08bb43f0bd",
                "word": "polymathe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dd1c32fe-b09b-49b5-a08c-9b4f19b3d833",
                        "entry_id": "d4446504-3ac9-3f9b-92af-1f08bb43f0bd",
                        "tags": [
                            "plural"
                        ],
                        "form": "polymathes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                        "entry_id": "d4446504-3ac9-3f9b-92af-1f08bb43f0bd",
                        "glosses": [
                            "Personne aux connaissances variées et approfondies, en particulier des connaissances en art et en science."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76dfc052-fdfb-48df-a0ab-d40146c16308",
                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                "text": "Imhotep, Pic de la Mirandole, Léonard de Vinci et Isaac Asimov sont des polymathes célèbres."
                            },
                            {
                                "example_id": "d7950a52-ea21-40da-aefc-4c542f7ab474",
                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                "text": "Les polymathes ont parfois été appelés hommes d'esprit universel."
                            },
                            {
                                "example_id": "070883bf-d4a4-44db-b7b8-ed57f728c79b",
                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                "text": "Un polymathe, c’est une personne qui a des connaissances approfondies dans des domaines qui n’ont pas de liens apparents (« Math » signifie apprentissage en grec). C’est typiquement un « Homme de la Renaissance », ou un « Homo Universalis », esprit ouvert, curieux de tout."
                            },
                            {
                                "example_id": "8fa14b7a-feea-4253-89c0-6a9274a15317",
                                "sense_id": "353346d6-d796-311f-833f-93fba877230e",
                                "text": "Cette maîtrise du réel est renforcée par le fait que Sherlock Holmes est un esprit polymathe, c’est-à-dire curieux de tout, aux connaissances qui s’étendent bien au-delà de son champ d’élection, la détection policière."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3d90a873-2b04-4e35-b801-95ad44d4afcb",
                        "source_entry_id": "d4446504-3ac9-3f9b-92af-1f08bb43f0bd",
                        "source_sense_id": "353346d6-d796-311f-833f-93fba877230e",
                        "target_lang_word": "Universalgelehrter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Universalgelehrter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "244d84e8-e152-31b4-a72a-b9bfc48bd28e",
                                        "entry_id": "34c25faa-d38f-3491-969b-9e4df9d9e99f",
                                        "glosses": [
                                            "Gelehrter, der in besonders hohem Maße über das Wissen seiner Zeit verfügt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3badb165-feba-4b9f-a9df-fbbee89df440",
                                                "sense_id": "244d84e8-e152-31b4-a72a-b9bfc48bd28e",
                                                "text": "„Eine Ausnahme ist der griechische Universalgelehrte Poseidonios.“"
                                            },
                                            {
                                                "example_id": "ede4dc2b-1a1c-481d-b64a-52609157349b",
                                                "sense_id": "244d84e8-e152-31b4-a72a-b9bfc48bd28e",
                                                "text": "„Der Nachlaß ist nicht nur wegen seiner Vollständigkeit so bedeutend, er gibt, da Leibniz der letzte Universalgelehrte war, der diesen Namen verdient, zudem auch einen Überblick über den gesamten Wissensstand des ausgehenden 17. Jahrhunderts, da es in der Tat keine Wissenschaft der Zeit gab, für die Leibniz sich nicht interessiert hätte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
