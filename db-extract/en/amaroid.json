                        "glosses": [
                            "Any bitter substance extracted from a plant (other than an alkaloid or glycoside)."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2e984a86-dc3c-4a44-ab64-33d666877cf7",
                                "sense_id": "7d32740d-b2b6-37dd-b117-3e9a295ec86e",
                                "text": "The name Amaroid is suggested for such bodies as these, in order to avoid confusion with glucosides and alkaloids, so many of which are also bitter."
                            },
                            {
                                "example_id": "70bb2204-1d73-4fcf-b51b-1aa1b1d429c1",
                                "sense_id": "7d32740d-b2b6-37dd-b117-3e9a295ec86e",
                                "text": "Picrotoxin is classed by Schon as an amaroid or bitter principle, although by some it is looked upon as a glucoside."
                            }
                        ]
                    }
