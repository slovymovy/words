                        {
                            "text": "De boze leraar <w>snauwde</w> tegen de leerlingen die alweer hun huiswerk niet hadden gemaakt.",
                            "target_lang_translations": {
                                "en": "The angry teacher <w>snapped</w> at the students who hadn't done their homework again.",
                                "ru": "Сердитый учитель <w>рявкнул</w> на учеников, которые снова не сделали домашнее задание."
                            }
                        },
                        {
                            "text": "Je moet niet zo <w>snauwen</w> tegen je moeder als ze je alleen maar een vraag stelt.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>snap</w> at your mother like that when she's only asking you a question.",
                                "ru": "Тебе не стоит так <w>огрызаться</w> на мать, когда она всего лишь задает тебе вопрос."
                            }
                        }
                    ],
                    "synonyms": [
