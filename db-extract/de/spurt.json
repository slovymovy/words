                    },
                    {
                        "translation_id": "f3addec5-5aaa-417c-ae6c-ab8f89032a34",
                        "source_entry_id": "f14e0709-6fd9-3b85-af4a-346e2f419dfe",
                        "source_sense_id": "49e2a9aa-08aa-3cdb-871b-2eba00b2f9a0",
                        "source_sense_description": "kurzzeitige Beschleunigung beim Laufen",
                        "target_lang_word": "sprint",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sprint",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1b5909b2-ebd2-3b61-8941-c4afcf631080",
                                        "entry_id": "046068c0-a9eb-3e62-b62b-d497b2490786",
                                        "glosses": [
                                            "Course sur une courte distance où l’athlète va le plus vite possible."
                                        ],
                                        "tags": [
                                            "Course à pied"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "85fc69a8-ecb4-4cc1-8571-801636ec092b",
                                                "sense_id": "1b5909b2-ebd2-3b61-8941-c4afcf631080",
                                                "text": "Les règles du sprint en athlétisme stipulent depuis 2002 que, si un athlète quitte les starting blocks en moins de 100 ms (0,1 s) après le coup de feu, il sera sanctionné d'un faux départ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef60cdab-0c21-33c6-846e-05eaaeda2f45",
                                        "entry_id": "046068c0-a9eb-3e62-b62b-d497b2490786",
                                        "glosses": [
                                            "Moment d’une course où les coureurs accélèrent pour remporter la première place."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cea330bd-078f-4028-b68b-fcd0f1f552bf",
                                                "sense_id": "ef60cdab-0c21-33c6-846e-05eaaeda2f45",
                                                "text": "En trois jours, en trois arrivées totalement différentes, le patron du Tour a marqué les esprits : adroit et offensif sur les pavés, surpuissant dans un sprint en côte, ultra-déterminé et impitoyable après les 7 km d’ascension de la Planche."
                                            },
                                            {
                                                "example_id": "ed7eab23-096f-4d23-8528-ffae84deb8f0",
                                                "sense_id": "ef60cdab-0c21-33c6-846e-05eaaeda2f45",
                                                "text": "Au sprint, le Bressan passa tout le monde et franchit le premier la ligne d’arrivée. Lenoir et le Lyonnais suivirent à deux roues. Busard arriva quatrième, à dix mètres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6433d2c9-d5f1-3050-a2a5-cb942b1ec7e6",
                                        "entry_id": "046068c0-a9eb-3e62-b62b-d497b2490786",
                                        "glosses": [
                                            "Course rapide."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "566d513a-8993-4137-9821-4944890d9ef3",
                                                "sense_id": "6433d2c9-d5f1-3050-a2a5-cb942b1ec7e6",
                                                "text": "Il a piqué un sprint pour arriver à l’heure"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "08d45c69-ed31-3b32-93ef-35914ef94e03",
                                        "entry_id": "046068c0-a9eb-3e62-b62b-d497b2490786",
                                        "glosses": [
                                            "Unité de temps délimitant un lot de travail des approches agiles et scrum, durant lequel une équipe de développeurs réalise des développements logiciels."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f6e3b6c9-faf6-47ab-b1e9-e251bbce8b60",
                                                "sense_id": "08d45c69-ed31-3b32-93ef-35914ef94e03",
                                                "text": "Lorsque les équipes se bousculent pour respecter les délais d’un sprint, cela se traduit généralement par des méthodes fastidieuses, des routines inefficaces ou un code de mauvaise qualité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
