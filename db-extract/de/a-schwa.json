                ],
                "senses": [
                    {
                        "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                        "entry_id": "549d759b-2699-319f-b977-3d828a1921a3",
                        "glosses": [
                            "Vokal, der zwischen einem [a] und einem [ə] (Schwa) liegt und im Deutschen nur unbetont vorkommt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fba665c2-dfc5-4476-88ee-33885297cc48",
                                "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                                "text": "„Sie würde allerdings als Vokal a-Schwa bzw. Lehrer-Schwa notiert.“"
                            },
                            {
                                "example_id": "f07df101-09c8-4827-9909-78f413797957",
                                "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                                "text": "„Der Vokal a-Schwa kommt silbisch und nicht silbisch vor, z.B. Lehrer und Tür.“"
                            },
                            {
                                "example_id": "aa82fcc9-9ac7-47cb-aea0-1df0e4b4ca99",
                                "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                                "text": "„[ɐ] ['le:.rɐ] Lehrer: am Wortende wird als sog. a-Schwa realisiert.“"
                            },
                            {
                                "example_id": "13487fde-8db4-4c55-89df-986f6cf19309",
                                "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                                "text": "„Schwa und a-Schwa treten nur in Silben auf, die nicht betonbar sind (s. Kap. I.5.1). Sie werden auch als Reduktionsvokale bezeichnet.“"
                            },
                            {
                                "example_id": "5a9b8c76-1ce1-42c0-9b40-f3f525e0c07d",
                                "sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                                "text": "„Unter den wVN sind Auslaute auf a-Schwa sehr selten, unter den mVN machen sie dagegen einen stabilen, wenn auch kleinen Anteil aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5656bac0-467c-418a-ac9d-dbbd87fb9768",
                        "source_entry_id": "549d759b-2699-319f-b977-3d828a1921a3",
                        "source_sense_id": "21302ea5-425b-3c54-a22f-99da980bb449",
                        "source_sense_description": "Vokal, der zwischen einem [a] und einem [ə] (Schwa) liegt und im Deutschen nur unbetont vorkommt",
                        "target_lang_word": "a-schwa",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "a-schwa",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb3802d-ca32-343b-bfa1-5ed875dbbcf8",
                                        "entry_id": "6f3a515d-ff14-32b3-947d-4194f3992ca2",
                                        "glosses": [
                                            "The vowel [ɐ], which lies between [a] and [ə] (true schwa)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e83c1573-57a3-429e-9c1c-9a2e5bbde726",
                                                "sense_id": "3eb3802d-ca32-343b-bfa1-5ed875dbbcf8",
                                                "text": "Fact is that non-low vowels before /R/ are lowered or form falling diphthongs with an a-schwa, which apparently calls for a spreading analysis."
                                            },
                                            {
                                                "example_id": "f771cb3a-ec74-47f3-89da-1896158a5df5",
                                                "sense_id": "3eb3802d-ca32-343b-bfa1-5ed875dbbcf8",
                                                "text": "Similar to German, the a'''-schwa plural suffix may combine with Umlaut, and Umlaut can also be the only plural marker (i.e. \"combine with zero\")."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
