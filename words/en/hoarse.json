{
    "word_family": [
        "hoarsely",
        "hoarseness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "78bbdbb5-4779-314c-8a01-42274d609ea5",
                    "sense_definition": "Having a dry, harsh, or rough tone to the voice, often caused by a sore throat, illness, or strong emotion.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "voice_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After shouting at the concert, he woke up with a <w>hoarse</w> voice.",
                            "target_lang_translations": {
                                "cs": "Poté, co na koncertě křičel, se probudil s <w>chraptivým</w> hlasem."
                            }
                        },
                        {
                            "text": "She tried to speak, but her <w>hoarse</w> throat made it difficult to be heard clearly.",
                            "target_lang_translations": {
                                "cs": "Pokusila se promluvit, ale kvůli <w>ochraptělému</w> hrdlu bylo těžké jí jasně rozumět."
                            }
                        }
                    ],
                    "synonyms": [
                        "raspy",
                        "husky",
                        "gruff"
                    ],
                    "antonyms": [
                        "clear",
                        "smooth"
                    ],
                    "common_phrases": [
                        "hoarse voice",
                        "hoarse throat"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající suchý, drsný nebo chraplavý hlas, často způsobený bolestí v krku, nemocí nebo silnými emocemi."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chraptivý",
                                "target_lang_sense_clarification": "obecné označení pro hlas znějící drsně kvůli namoženým hlasivkám"
                            },
                            {
                                "target_lang_word": "chraplavý",
                                "target_lang_sense_clarification": "časté označení pro drsný, nečistý zvuk hlasu"
                            },
                            {
                                "target_lang_word": "ochraptělý",
                                "target_lang_sense_clarification": "stav, kdy někdo ztratil čistotu hlasu v důsledku nemoci nebo křiku"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ba05235f-feb9-3cc9-8734-07267b85b3d2",
                    "sense_definition": "To speak or utter something in a dry, harsh, or rough voice.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "voice_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Get out of here, she <w>hoarsed</w> while struggling to catch her breath.",
                            "target_lang_translations": {
                                "cs": "„Vypadni odsud,“ <w>zachraptěla</w>, zatímco se snažila popadnout dech."
                            }
                        },
                        {
                            "text": "I am fine, he <w>hoarsed</w> through a dry and painful throat.",
                            "target_lang_translations": {
                                "cs": "„Jsem v pořádku,“ <w>zachraptěl</w> přes suché a bolestivé hrdlo."
                            }
                        }
                    ],
                    "synonyms": [
                        "croak"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used as a verb in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Mluvit nebo vyslovovat něco chraplavým, drsným hlasem."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chraptět",
                                "target_lang_sense_clarification": "vydávat chraplavé zvuky při mluvení"
                            },
                            {
                                "target_lang_word": "říci chraplavě",
                                "target_lang_sense_clarification": "způsob vyjádření mluveného slova s chraplavým zabarvením"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3417ed97-885f-318d-a3a5-f9ed0a7911b0",
                    "sense_definition": "An obsolete spelling of <w>horse</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "no",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old document contained a record regarding the stray <w>hoarses</w> found in the village.",
                            "target_lang_translations": {
                                "cs": "Starý dokument obsahoval záznam o toulavých <w>koních</w> nalezených v obci."
                            }
                        },
                        {
                            "text": "Historical texts often used the spelling <w>hoarse</w> to refer to the animal.",
                            "target_lang_translations": {
                                "cs": "Historické texty často používaly pravopis <w>hoarse</w> pro označení tohoto zvířete."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "This spelling is no longer in use."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zastaralý pravopis slova kůň."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "kůň",
                                "target_lang_sense_clarification": "zvíře, ke kterému se tento zastaralý anglický výraz vztahoval"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}