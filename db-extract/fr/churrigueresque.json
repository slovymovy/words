                        "sense_id": "4903513a-9048-3f71-809d-3f0529c66e83",
                        "entry_id": "fef2822e-a37a-398c-a347-6a9709ab61f9",
                        "glosses": [
                            "Art baroque hispanisant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0774098e-f77b-4f35-81c7-c11ef2513971",
                                "sense_id": "4903513a-9048-3f71-809d-3f0529c66e83",
                                "text": "Le churrigueresque, une manifestation spécifique du baroque entre les années 1730 et 1780. au Mexique il se distinguait par ses constructions architecturales chargées."
                            },
                            {
                                "example_id": "5d3a49d9-4f15-447c-a462-32ac011c1325",
                                "sense_id": "4903513a-9048-3f71-809d-3f0529c66e83",
                                "text": "Cette école andalouse du baroque servira de répertoire formel pour les spéculations du churrigueresque dans la Nouvelle- Espagne, car Séville était la grande métropole, siège de l’administration des Indes."
                            }
                        ]
                    }
