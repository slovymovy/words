                        "entry_id": "8eaaf99d-8c5a-3a8a-885b-5415c3d7b9c4",
                        "glosses": [
                            "Gefäße, die Blut durch den menschlichen Körper oder durch einen Organismus leiten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0db89a53-70bc-4024-814e-3f1fb42d3fb0",
                                "sense_id": "3e70f07b-3351-3da7-9622-bc7a866f0cf0",
                                "text": "Die Blutbahn bildet einen Kreislauf, in dessen Mittelpunkt das Herz steht."
                            },
                            {
                                "example_id": "be7cd0de-7c0d-4eba-b409-b4a6230285f6",
                                "sense_id": "3e70f07b-3351-3da7-9622-bc7a866f0cf0",
                                "text": "„Theoretisch ist es bei einer subkutanen Insulinresistenz auch möglich, das Hormon in die Blutbahn zu spritzen, aber das ist nur eine Notlösung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
