                ],
                "senses": [
                    {
                        "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                        "entry_id": "2747760a-646c-35d4-a7e5-056849d8489a",
                        "glosses": [
                            "Handlung (und ihr Ergebnis), fremdes Gebiet widerrechtlich in Besitz nehmen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1c546fe-07bd-472e-94c9-b3abe97a98ba",
                                "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                                "text": "„Ihre Lage war am Ende des ersten Jahrhunderts der Kolonisierung katastrophal.“"
                            },
                            {
                                "example_id": "178aca84-e539-476e-9d6a-5e702f6045da",
                                "sense_id": "18cbae96-e533-3003-84e9-a17429984c7b",
                                "text": "„An eine dauerhafte Besetzung, gar Kolonisierung der nordafrikanischen Regentschaft aber denkt niemand in Paris.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "752545ce-23b5-32e8-84d8-39656a5c5584",
                        "entry_id": "2747760a-646c-35d4-a7e5-056849d8489a",
                        "glosses": [
                            "Handlung (und ihr Ergebnis), rückständiges Gebiet erschließen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7aeac541-9dc8-458b-a6e3-9df442db0a40",
                                "sense_id": "752545ce-23b5-32e8-84d8-39656a5c5584",
                                "text": "„František Palacký, der erste große moderne Historiker der Tschechen und »Vater der Nation« im 19. Jahrhundert, verfestigte diese Auffassungen, obwohl er natürlich mit seinem klaren, gerechten Kopf auch den Aufschwung von Gewerbe und Handel sah, den die Kolonisierung gebracht hatte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
