    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2542fc45-a9e6-3e5b-aa02-ae6d8fcfa509",
                    "sense_definition": "Ensemble des lois fondamentales qui établissent la forme d'un gouvernement et régissent l'organisation des pouvoirs publics d'un État.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "politique_droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le peuple a voté pour modifier plusieurs articles de la <w>constitution</w>."
                        },
                        {
                            "text": "Cette nouvelle loi doit respecter les principes énoncés dans la <w>constitution</w>."
                        }
                    ],
                    "common_phrases": [
                        "réforme de la constitution",
                        "respecter la constitution"
                    ]
                },
                {
                    "sense_id": "718ee8fb-387a-3db0-af03-a96d992fd0dc",
                    "sense_definition": "Action de former, d'établir ou d'organiser légalement ou formellement une entité ou un groupe.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "creation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les associés se sont réunis pour finaliser la <w>constitution</w> de l'entreprise."
                        },
                        {
                            "text": "La <w>constitution</w> d'un nouveau groupe parlementaire a pris plusieurs semaines."
                        }
                    ],
                    "synonyms": [
                        "création",
                        "fondation"
                    ],
                    "antonyms": [
                        "dissolution"
                    ],
                    "common_phrases": [
                        "constitution d'un dossier",
                        "constitution d'une équipe",
                        "constitution d'une société"
                    ]
                },
                {
                    "sense_id": "889ab92a-032e-3fa2-a45c-0124bc4dad7a",
                    "sense_definition": "État général, force et résistance physique habituelle du corps humain.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet enfant est de bonne <w>constitution</w> et tombe rarement malade en hiver."
                        },
                        {
                            "text": "Le médecin a remarqué que sa <w>constitution</w> robuste l'a aidé à récupérer très vite."
                        }
                    ],
                    "common_phrases": [
                        "de bonne constitution",
                        "constitution robuste",
                        "constitution fragile"
                    ]
                },
                {
                    "sense_id": "2746fa4a-440c-3b92-b25a-37fc484dadfc",
                    "sense_definition": "Manière dont les éléments d'une chose s'assemblent pour former un tout ; structure interne.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "structure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les chercheurs étudient en détail la <w>constitution</w> chimique de ce minéral rare."
                        },
                        {
                            "text": "La <w>constitution</w> interne du sol influence la qualité des récoltes chaque année."
                        }
                    ],
