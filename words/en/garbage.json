{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3bbf285-e5d6-3b27-8ede-5ebfbb335c29",
                    "sense_definition": "Waste material of any kind, such as food waste or discarded objects.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waste_material",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please take out the <w>garbage</w> before you go to sleep.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, вынеси <w>мусор</w> перед сном.",
                                "tr": "Lütfen uyumadan önce <w>çöpü</w> dışarı çıkar."
                            }
                        },
                        {
                            "text": "The <w>garbage</w> truck comes to our street every Tuesday morning.",
                            "target_lang_translations": {
                                "ru": "<w>Мусоровоз</w> приезжает на нашу улицу каждый вторник утром.",
                                "tr": "<w>Çöp</w> kamyonu her salı sabahı sokağımıza geliyor."
                            }
                        }
                    ],
                    "synonyms": [
                        "trash",
                        "rubbish",
                        "waste",
                        "refuse",
                        "junk"
                    ],
                    "antonyms": [
                        "treasure",
                        "asset",
                        "resource"
                    ],
                    "common_phrases": [
                        "garbage truck",
                        "garbage can",
                        "take out the garbage",
                        "garbage bag",
                        "household garbage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отходы любого вида, такие как пищевые отходы или выброшенные предметы.",
                        "tr": "Yiyecek atıkları veya atılmış eşyalar gibi her türlü atık madde."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "общее значение"
                            },
                            {
                                "target_lang_word": "отбросы",
                                "target_lang_sense_clarification": "пищевые или биологические отходы"
                            },
                            {
                                "target_lang_word": "хлам",
                                "target_lang_sense_clarification": "старые вещи, рухлядь"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çöp",
                                "target_lang_sense_clarification": "genel anlamda atık"
                            },
                            {
                                "target_lang_word": "süprüntü",
                                "target_lang_sense_clarification": "süpürülüp atılan küçük atıklar"
                            },
                            {
                                "target_lang_word": "atık",
                                "target_lang_sense_clarification": "kullanılmaz hale gelmiş madde"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "367e9ab7-7754-35ff-a87b-c7be1efab4c5",
                    "sense_definition": "A container or place where waste material is put.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "waste_container",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He crumpled the paper and threw it into the <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Он скомкал бумагу и бросил её в <w>мусорное ведро</w>.",
                                "tr": "Kağıdı buruşturdu ve <w>çöp kutusuna</w> attı."
                            }
                        },
                        {
                            "text": "Is the <w>garbage</w> full, or can I fit this box in?",
                            "target_lang_translations": {
                                "ru": "<w>Мусорное ведро</w> полное, или я могу втиснуть туда эту коробку?",
                                "tr": "<w>Çöp kovası</w> dolu mu yoksa bu kutuyu sığdırabilir miyim?"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in the garbage",
                        "throw in the garbage"
                    ],
                    "target_lang_definitions": {
                        "ru": "Контейнер или место, куда выбрасывают отходы.",
                        "tr": "Atık maddelerin konulduğu kap veya yer."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусорное ведро",
                                "target_lang_sense_clarification": "контейнер в помещении"
                            },
                            {
                                "target_lang_word": "помойка",
                                "target_lang_sense_clarification": "разговорное, место сбора мусора"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çöp kutusu",
                                "target_lang_sense_clarification": "içine atık konulan kap"
                            },
                            {
                                "target_lang_word": "çöplük",
                                "target_lang_sense_clarification": "çöplerin biriktirildiği yer"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6fe96da-1b43-3b28-8eda-c5c12f9be681",
                    "sense_definition": "Something that is of very poor quality, worthless, or untrue.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "worthless_thing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't listen to him, he is just talking <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Не слушай его, он несет полную <w>чушь</w>.",
                                "tr": "Onu dinleme, sadece <w>saçmalıyor</w>."
                            }
                        },
                        {
                            "text": "That movie was absolute <w>garbage</w> and a waste of time.",
                            "target_lang_translations": {
                                "ru": "Этот фильм был полным <w>мусором</w> и пустой тратой времени.",
                                "tr": "O film tam anlamıyla bir <w>çöptü</w> ve zaman kaybıydı."
                            }
                        }
                    ],
                    "synonyms": [
                        "rubbish",
                        "trash",
                        "junk"
                    ],
                    "antonyms": [
                        "treasure",
                        "prize",
                        "asset"
                    ],
                    "common_phrases": [
                        "talk garbage",
                        "absolute garbage",
                        "piece of garbage"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used to describe nonsense or low quality items"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то очень низкого качества, бесполезное или не соответствующее действительности.",
                        "tr": "Çok kalitesiz, değersiz veya gerçek dışı olan bir şey."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чушь",
                                "target_lang_sense_clarification": "о словах или информации"
                            },
                            {
                                "target_lang_word": "дрянь",
                                "target_lang_sense_clarification": "о вещах плохого качества"
                            },
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "переносное значение"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "saçmalık",
                                "target_lang_sense_clarification": "gerçek dışı veya mantıksız sözler için"
                            },
                            {
                                "target_lang_word": "çöp",
                                "target_lang_sense_clarification": "mecazi, değersiz veya kalitesiz şey"
                            },
                            {
                                "target_lang_word": "zırva",
                                "target_lang_sense_clarification": "anlamsız söz"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6392df68-80fd-37e3-9e12-ed0e01d5d8c3",
                    "sense_definition": "Data in a computer's memory that is no longer in use or is incorrect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "computing_data",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The system performs <w>garbage</w> collection to free up memory.",
                            "target_lang_translations": {
                                "ru": "Система выполняет сборку <w>мусора</w> для освобождения памяти.",
                                "tr": "Sistem, bellekte yer açmak için <w>çöp</w> toplama işlemini gerçekleştirir."
                            }
                        },
                        {
                            "text": "If you input bad data, the output will be <w>garbage</w>.",
                            "target_lang_translations": {
                                "ru": "Если вы введете неверные данные, на выходе получится <w>мусор</w>.",
                                "tr": "Hatalı veri girerseniz, çıktı da <w>çöp</w> olacaktır."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garbage collection",
                        "garbage in garbage out"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Данные в памяти компьютера, которые больше не используются или некорректны.",
                        "tr": "Bilgisayar belleğinde artık kullanılmayan veya hatalı olan veriler."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мусор",
                                "target_lang_sense_clarification": "термин в информатике"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çöp",
                                "target_lang_sense_clarification": "bilgisayar terimi, gereksiz veri"
                            },
                            {
                                "target_lang_word": "gereksiz veri",
                                "target_lang_sense_clarification": "bellekte yer kaplayan kullanılmayan veri"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f6adaa00-d063-3d55-8bee-82cb08e2a81e",
                    "sense_definition": "Easy points scored in a game, often when the outcome is already decided.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "sports_term",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team scored some <w>garbage</w> points in the final minute of the match.",
                            "target_lang_translations": {
                                "ru": "Команда набрала несколько <w>бесполезных</w> очков на последней минуте матча.",
                                "tr": "Takım, maçın son dakikasında birkaç <w>önemsiz</w> puan kaydetti."
                            }
                        },
                        {
                            "text": "He picked up a <w>garbage</w> goal after the defense stopped playing.",
                            "target_lang_translations": {
                                "ru": "Он забил <w>случайный</w> гол после того, как защита бросила играть.",
                                "tr": "Savunma oynamayı bıraktıktan sonra <w>ucuz</w> bir gol attı."
                            }
                        }
                    ],
                    "common_phrases": [
                        "garbage time",
                        "garbage goal"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sports"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкие очки, набранные в игре, часто когда исход матча уже предрешен.",
                        "tr": "Genellikle maçın sonucu zaten belliyken bir oyunda kolayca kazanılan puanlar."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ничего не значащие очки",
                                "target_lang_sense_clarification": "в контексте счета"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "değersiz puan",
                                "target_lang_sense_clarification": "sonucu etkilemeyen puan"
                            },
                            {
                                "target_lang_word": "önemsiz sayı",
                                "target_lang_sense_clarification": "fark açıldıktan sonra atılan sayı"
                            }
                        ]
                    }
                }
            ]
        },
        {
