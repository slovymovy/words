                            },
                            {
                                "target_lang_word": "Seilwinde",
                                "target_lang_sense_clarification": "Hebevorrichtung mit Seil"
                            },
                            {
                                "target_lang_word": "Haspel",
                                "target_lang_sense_clarification": "Drehvorrichtung, z.B. am Brunnen"
                            }
                        ]
                    }
                }
            ]
