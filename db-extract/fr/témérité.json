        "fr-extract.jsonl": [
            {
                "entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                "word": "témérité",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "6a273060-aa64-4788-abe1-1b474d959cdb",
                        "entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                        "tags": [
                            "plural"
                        ],
                        "form": "témérités"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0e1e545f-fd90-3c09-8e1c-ade2147aceb7",
                        "entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                        "glosses": [
                            "Hardiesse imprudente et présomptueuse, courage inconsidéré."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3786d31b-be64-4da6-a24a-035927272171",
                                "sense_id": "0e1e545f-fd90-3c09-8e1c-ade2147aceb7",
                                "text": "Il y a beaucoup de témérité à avancer cette proposition."
                            },
                            {
                                "example_id": "8f32b637-199a-4a12-a217-b33dde0e0257",
                                "sense_id": "0e1e545f-fd90-3c09-8e1c-ade2147aceb7",
                                "text": "Profitant d'un rare moment favorable, et non sans témérité, car les brisants étaient violents et la levée dépassait 2 mètre, la baleinière approcha…"
                            },
                            {
                                "example_id": "f561e267-e4b0-43e2-aec3-0ea425168ea8",
                                "sense_id": "0e1e545f-fd90-3c09-8e1c-ade2147aceb7",
                                "text": "Il faut un plus grand courage au père qui se jette à l'eau en sachant à peine nager (s'il ne sait pas du tout nager, c'est de la témérité) qu'à celui qui est sauveteur breveté."
                            },
                            {
                                "example_id": "2e0e932e-7333-4686-82b4-14e187b37add",
                                "sense_id": "0e1e545f-fd90-3c09-8e1c-ade2147aceb7",
                                "text": "Un grave accident probablement causé par la témérité d’un jeune conducteur a fait trois blessés graves et a créé un important bouchon de circulation sur l’autoroute 15 Nord à Sainte-Thérèse, au nord de Montréal."
                            }
                        ]
                    },
                    {
                        "sense_id": "9de6231c-c019-31ce-8944-c45d1af4c140",
                        "entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                        "glosses": [
                            "Hardiesse imprudente et présomptueuse, courage inconsidéré.",
                            "Action, discours téméraire."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "1857857c-f27e-4bdd-8396-26e7e0b5c700",
                                "sense_id": "9de6231c-c019-31ce-8944-c45d1af4c140",
                                "text": "C’est une témérité condamnable de mal juger des intentions d’autrui."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "aac17131-379a-431b-9c93-0fa5670b8722",
                        "source_entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                        "target_lang_word": "Waghalsigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Waghalsigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                                        "entry_id": "2c86f415-161c-3a09-937d-b91d1bc6317a",
                                        "glosses": [
                                            "risikoreiche, leichtsinnige, Gefahren nicht scheuende Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46f3a6ac-307d-4ec1-a3b7-30023aaddbe4",
                                                "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                                                "text": "Seine sportlichen Leistungen im Extremklettern sind an Waghalsigkeit kaum zu überbieten."
                                            },
                                            {
                                                "example_id": "9098330d-0e23-4197-92da-22a31cb19ae9",
                                                "sense_id": "770309eb-1052-3419-b891-cc64b9f19509",
                                                "text": "„Waghalsigkeit […] ist in unserer sicherheitsorientierten Zeit als Vabanque-Spiel verpönt; sie trägt den Makel tollkühnen, d.h. verrückt-verantwortungslosen Handelns und findet sich nicht selten in den Mutproben Jugendlicher.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73924f1b-f488-436e-9a73-4c6e59136d07",
                        "source_entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
                        "target_lang_word": "temerity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "temerity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                        "entry_id": "d891c896-1cae-3287-86f2-11103413ffe4",
                                        "glosses": [
                                            "Reckless boldness; foolish bravery."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cfafee14-090c-44ad-974f-4ce93f246009",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "1569, Thomas Pearson, trans., \"The Second Paradox,\" in The booke of Marcus Tullius Cicero entituled Paradoxa Stoicorum, T. Marshe (London),\nNeyther the spightfull temerity and rashnes of variable fortune, nor the envious hart burning and in iurious hatred of mine enemies shold be able once to damnify me."
                                            },
                                            {
                                                "example_id": "d21820fc-8ef4-43b6-898c-4eb7d60ab3eb",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "Jewan Sadit, who ſtood before the prince, obſerving his youthful temerity, threw himſelf between him and danger, and with a nervous arm, wielding a ſharp ſabre, of the hard tempered ſteel of Damiſk, ruſhing upon the tyger, he ſtruck him acroſs the forehead."
                                            },
                                            {
                                                "example_id": "b8be6d7e-20f6-498c-88d8-93f1f35285d6",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "One day when he knew old Lobbs was out, Nathaniel Pipkin had the temerity to kiss his hand to Maria Lobbs."
                                            },
                                            {
                                                "example_id": "fa2761d5-2a96-49cc-a025-6bb495ed1643",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "Elizabeth trotted through the open door in the dusk, but becoming alarmed at her own temerity, she went quickly out again by another which stood open in the lofty wall of the back court."
                                            },
                                            {
                                                "example_id": "b04f0e47-34d3-46bc-a78e-bb55ab6bd758",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "Terror seized me, a horror of my temerity."
                                            },
                                            {
                                                "example_id": "d17e66c5-6817-4b91-aa58-ecc8a577e8c2",
                                                "sense_id": "886e012d-e8b3-343e-a273-a2fb915b945e",
                                                "text": "I am surprised that you, sir, a man of letters yourself, should have the temerity so to interrupt the progress of science."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b423ab2-acc6-3bf4-8da8-b710c3939e80",
                                        "entry_id": "d891c896-1cae-3287-86f2-11103413ffe4",
                                        "glosses": [
                                            "An act or case of reckless boldness."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d44665d6-9096-4f6d-b14a-41fe06d853aa",
                                                "sense_id": "3b423ab2-acc6-3bf4-8da8-b710c3939e80",
                                                "text": "Draper, dear lad, had the illusion of an \"intellectual sympathy\" between them.... Draper's temerities would always be of that kind."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fdd8b47-04ad-38a2-9c99-a90d445d7660",
                                        "entry_id": "d891c896-1cae-3287-86f2-11103413ffe4",
                                        "glosses": [
                                            "Effrontery; impudence."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "430b84af-e1c7-41a9-bf75-8895aab6b478",
                                                "sense_id": "2fdd8b47-04ad-38a2-9c99-a90d445d7660",
                                                "text": "He had very nearly been guilty of the temerity of arrogating to himself another title in the presence of those he most respected."
                                            },
                                            {
                                                "example_id": "9d6ed631-40aa-4860-8a4f-0e1b056cbf97",
                                                "sense_id": "2fdd8b47-04ad-38a2-9c99-a90d445d7660",
                                                "text": "That's jejune? You have the temerity to say that I'm talking to you out of jejunosity? I am one of the most june people in all of the Russias!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6875d43c-f4a5-461c-8a8f-6d59318ecc98",
                        "source_entry_id": "808b702e-e29c-318e-ad49-73e3d8c38dcf",
