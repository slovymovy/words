                                "sense_id": "2605dbcf-16e2-37cc-8f0e-a5d409449e10",
                                "text": "Hipisi siedzieli wokół ogniska i śpiewali protest songi."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
