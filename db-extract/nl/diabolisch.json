                                "target_senses": [
                                    {
                                        "sense_id": "2e8666e8-6d99-3b6b-a553-5af93f325d2d",
                                        "entry_id": "b14dfdf9-d946-33c2-9ae9-a265c715d2a0",
                                        "glosses": [
                                            "Of, being, or pertaining to a devil or the Devil."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39ba87a4-4fa8-4276-bf84-028af080c7d3",
                                                "sense_id": "2e8666e8-6d99-3b6b-a553-5af93f325d2d",
                                                "text": "diabolic magic square"
                                            },
                                            {
                                                "example_id": "5cf93f98-a7fe-4eaa-b0a1-aedd68560722",
                                                "sense_id": "2e8666e8-6d99-3b6b-a553-5af93f325d2d",
                                                "text": "\"The Sovereign Council of Wisdom,\" or the Order of Palladium, founded in Paris, was a diabolic order claiming masonic origin."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75d2c2d7-474d-3eda-8f46-89ebc42e5021",
                                        "entry_id": "b14dfdf9-d946-33c2-9ae9-a265c715d2a0",
                                        "glosses": [
                                            "Having qualities traditionally attributed to devils."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "341939d6-24c5-369a-9da1-1f8d667bcdc6",
                                        "entry_id": "b14dfdf9-d946-33c2-9ae9-a265c715d2a0",
                                        "glosses": [
                                            "Having qualities traditionally attributed to devils.",
                                            "Wicked; evil; cruel."
                                        ],
                                        "tags": [
                                            "especially",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6540271b-c225-42d0-94a8-a417514c774b",
                                                "sense_id": "341939d6-24c5-369a-9da1-1f8d667bcdc6",
                                                "text": "a cunning and diabolic plot"
                                            },
                                            {
                                                "example_id": "f47c6b14-4b55-4dff-825f-e856d3b2e68a",
                                                "sense_id": "341939d6-24c5-369a-9da1-1f8d667bcdc6",
                                                "text": "fires lit up a diabolic scene"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc0b4df3-ca56-4179-a067-b0471f1a741a",
                        "source_entry_id": "bf1a29c1-94f1-3413-b9a9-48b934afc889",
                        "source_sense_id": "f5805779-87a4-3abf-8765-4b3af3aad098",
                        "target_lang_word": "diabolique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diabolique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est relatif au diable, qui vient du diable, qui ressemble au diable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f0e93434-f0db-4ab6-9dbc-d16d343d4824",
                                                "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                                "text": "Jamais, peut-être, pareille orgie ne s'était déroulée à la face du ciel depuis les tristes âges du paganisme, et, si je n'avais été prévenu, je me serais cru transporté par un songe diabolique dans les sentines de Suburre, dans les lupanars de Capoue."
                                            },
                                            {
                                                "example_id": "94d62a6a-abab-4f24-9422-72014e64f280",
                                                "sense_id": "70869882-5613-33c1-96a5-1df8e45b7d6d",
                                                "text": "Comment, avec une force numérique aussi faible, résister aux Indiens dont il voyait les diaboliques silhouettes se dessiner fantastiquement aux reflets sinistres de l’incendie ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est extrêmement méchant, pernicieux dans son genre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62d6030d-7eff-43a1-9138-a7cea946e49d",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "En prenant position devant madame Mignon, madame Latournelle avait, avec sa diabolique intelligence de dévote, isolé Modeste."
                                            },
                                            {
                                                "example_id": "a7545de9-6787-4356-b715-d3f3a410e752",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "La lampe éteinte, Félicité ne put dormir. Les yeux fermés, elle faisait de merveilleux châteaux en Espagne. Les vingt mille francs de rente dansaient devant elle, dans l’ombre, une danse diabolique. Elle habitait un bel appartement de la ville neuve, avait le luxe de M. Peirotte, donnait des soirées, éclaboussait de sa fortune la ville entière. Ce qui chatouillait le plus ses vanités, c’était la belle position que son mari occuperait alors."
                                            },
                                            {
                                                "example_id": "938e071f-c128-4021-972a-547847673f25",
                                                "sense_id": "f40de0eb-854f-3f50-997f-cae6ce9da65a",
                                                "text": "J'accuse, en un mot, reprit-il, j'accuse la ballerine nommée Mirabelle d'avoir machiné une intrigue diabolique dans le but d'entraîner à l'abîme une âme que tant de soins et de piété paternelle avaient conservée à l'état de candeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c21a54f-3c1f-3a2b-8086-de11872df328",
                                        "entry_id": "f0586ab6-c52d-3ae4-882f-52539e870054",
                                        "glosses": [
                                            "Qui est très difficile, très pénible, très dangereux."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b17bc620-f96b-481e-a0dc-030f5f5bef80",
                                                "sense_id": "5c21a54f-3c1f-3a2b-8086-de11872df328",
                                                "text": "C’est un travail diabolique. Il nous a menés par un chemin diabolique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
