        "de-extract.jsonl": [
            {
                "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                "word": "Trunkenheit",
                "pos": "noun",
                "lang_code": "de",
                "forms": [
                    {
                        "form_id": "8507ac8d-b1ca-4da9-b1ef-c23254556e3d",
                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "tags": [
                            "nominative",
                            "singular"
                        ],
                        "form": "die Trunkenheit"
                    },
                    {
                        "form_id": "8710b370-89fa-40aa-bf75-93e52fdc80bb",
                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "tags": [
                            "genitive",
                            "singular"
                        ],
                        "form": "der Trunkenheit"
                    },
                    {
                        "form_id": "d8f7b6d0-b99f-46c7-b5ab-de46c449660f",
                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "tags": [
                            "dative",
                            "singular"
                        ],
                        "form": "der Trunkenheit"
                    },
                    {
                        "form_id": "a83dc448-4daf-4a9a-9ca1-f4bfbdcda4f9",
                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Trunkenheit"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                        "entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "glosses": [
                            "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "24032876-19c6-4ce9-af7a-aecc25b3a85c",
                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                "text": "„Ich kann jedoch nicht sagen, ich hätte ihre Trunkenheit mißbraucht, denn in ihrer starken Sinnlichkeit kam sie allen Genüssen, zu denen ich sie bis zwei Uhr morgens anspornte, bereitwillig entgegen, bis wir beide nicht mehr konnten und uns trennten.“"
                            },
                            {
                                "example_id": "1fa49106-ffc2-4565-b1df-e81e931a8344",
                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                "text": "„Ganz oben am Pyramidion wird dargestellt, wie der Pharao den Göttern Wein, der göttliche Trunkenheit herbeiführt, oder reinigendes Wasser opfert.“"
                            },
                            {
                                "example_id": "6b186f5a-494e-4b4c-9eb1-eb0f7722dc8b",
                                "sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                                "text": "„Wie Roth bald erfahren würde, hatte sie das Sorgerecht für ihre Kinder verloren, weil sie Alkoholikerin war und man sie mehrfach wegen Trunkenheit am Steuer verurteilt hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3fec92ad-c810-42bb-838d-cab810baf9ea",
                        "source_entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "source_sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                        "source_sense_description": "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke",
                        "target_lang_word": "пьянство",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пьянство",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                        "entry_id": "4c9824be-8e2d-3c01-b0e7-5e3c56ff3cb6",
                                        "glosses": [
                                            "постоянное употребление спиртных напитков; алкоголизм"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44db94d7-6205-4e16-86fc-0efd2c6e342e",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Он дошел до той чёрточки пьянства, когда иным пьяным, дотоле смирным, непременно вдруг захочется разозлиться и себя показать."
                                            },
                                            {
                                                "example_id": "a8f1070e-accb-447b-b969-807ee2304672",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Вашему Величеству известно, какую страшную язву в нашем народе составляет пьянство, с каждым годом возрастающее."
                                            },
                                            {
                                                "example_id": "0c92545d-94cd-45dc-85a4-92edc3633533",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Ты… лечись! От пьянства нынче лечат, слышь! Бесплатно, браток, лечат… такая уж лечебница устроена для пьяниц… чтобы, значит, даром их лечить…"
                                            },
                                            {
                                                "example_id": "5f90b269-2bac-42cf-bb73-be511e91f98a",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Только один ребенок ― сирота, у остальных матери и отцы лишены родительских прав (в основном из-за беспробудного пьянства)."
                                            },
                                            {
                                                "example_id": "df3a49d0-c699-4b47-aa78-9d8eaa212e18",
                                                "sense_id": "38ae80ed-318a-3435-8575-6349fb865511",
                                                "text": "Пьянство и алкоголизм ― абсолютно разные вещи. Алкоголизм ― это болезнь, чаще всего наследственная. И чаще всего неизлечимая.〈…〉 Пьянство ― это совсем другое. Это ― бытовая распущенность. Вот с пьянством можно бороться."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c686093c-803e-43c6-b9ba-2be937947681",
                        "source_entry_id": "db0c3eee-2e50-3940-bbf6-040e85ecc18c",
                        "source_sense_id": "fd9faf6c-7f7c-33b7-a6b8-ec109212e325",
                        "source_sense_description": "Zustand nach dem übermäßigen Konsum alkoholhaltiger Getränke",
                        "target_lang_word": "sarhoşluk",
                        "target_lang_code": "tr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sarhoşluk",
                                "target_lang_code": "tr",
                                "target_senses": [
                                    {
                                        "sense_id": "5b58e342-d955-319f-82c3-ef272c2cb57c",
                                        "entry_id": "04104c0d-391e-3a7f-82e3-8345482bf594",
                                        "glosses": [
                                            "sarhoş olma durumu, esriklik, mestlik, sermestlik, sermesti, fazla miktarda alkollü içecek tüketiminden kaynaklanan durum"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fae70e08-7816-4e97-b0ea-0a418c796913",
                                                "sense_id": "5b58e342-d955-319f-82c3-ef272c2cb57c",
                                                "text": "Sarhoşluğu hicvetmek, hiciv silahıyla sarhoşluğa saldırmak gerekmektedir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da72d635-ff5b-375b-a508-ab8b6d03bbac",
                                        "entry_id": "04104c0d-391e-3a7f-82e3-8345482bf594",
                                        "glosses": [
                                            "dalgınlık, şaşkınlık"
                                        ],
                                        "tags": [
                                            "metaphoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07f8da25-0f2c-4695-8234-b0a0a00fc2cd",
                                                "sense_id": "da72d635-ff5b-375b-a508-ab8b6d03bbac",
                                                "text": "Deniz rüzgârı yüzümdeki sarhoşluğu yıkadı."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
