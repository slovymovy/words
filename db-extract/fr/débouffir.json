                "senses": [
                    {
                        "sense_id": "38b1053f-6d94-3437-a264-cdd2b524f325",
                        "entry_id": "3e589259-f710-35b1-9ccd-ebeed5ab2bb5",
                        "glosses": [
                            "Faire perdre son caractère bouffi à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d0fc1cd-6b8f-4aff-bc95-56097d5ac3e1",
                                "sense_id": "38b1053f-6d94-3437-a264-cdd2b524f325",
                                "text": "La fondation, conclut notre confrère, était jugée comme un moyen excellent pour engraisser les maigres sans les bouffir et débouffir les gras sans les émacier."
                            },
                            {
                                "example_id": "689edf93-ef8c-4300-a0d5-fe551608777c",
                                "sense_id": "38b1053f-6d94-3437-a264-cdd2b524f325",
                                "text": "Au dix-huitième bain, il essaya de l’action de la lumière d’une lampe, et sa vue supporta bien cette épreuve. Son teint d’ailleurs était éclairci, et son visage semblait débouffi."
                            }
                        ]
                    }
                ],
