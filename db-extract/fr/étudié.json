                        "entry_id": "5579d0a7-151c-3db9-9089-8c4c0389d395",
                        "glosses": [
                            "Qui est fait avec soin et application, bien travaillé, bien fini."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4100601e-f5bd-47a1-8f6f-3cd926203388",
                                "sense_id": "0b497976-7def-3ca9-a6b9-43616002de8a",
                                "text": "Un rapport bien étudié."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f018a66-30e7-3702-82cb-fb13e0ac063b",
                        "entry_id": "5579d0a7-151c-3db9-9089-8c4c0389d395",
                        "glosses": [
                            "Qui est feint, recherché, affecté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d6c9eee-3607-4069-8cfd-53c065eca6d3",
                                "sense_id": "1f018a66-30e7-3702-82cb-fb13e0ac063b",
                                "text": "Une joie, une douleur étudiée."
                            },
                            {
                                "example_id": "140a78cb-1a92-46ed-94f9-7da03905d924",
                                "sense_id": "1f018a66-30e7-3702-82cb-fb13e0ac063b",
                                "text": "Une langage étudié."
                            },
                            {
                                "example_id": "e841ec06-38d4-40de-a11b-76190426972b",
                                "sense_id": "1f018a66-30e7-3702-82cb-fb13e0ac063b",
                                "text": "Un geste étudié."
                            },
                            {
                                "example_id": "5cef10fb-b7f2-4c61-a697-77478b0af216",
                                "sense_id": "1f018a66-30e7-3702-82cb-fb13e0ac063b",
                                "text": "Le jeu de cet acteur est trop étudié."
                            }
                        ]
                    }
                ],
