                                        "glosses": [
                                            "To pull hard repeatedly."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75f4b18c-b1fa-47c0-8f46-328a10bc089b",
                                                "sense_id": "6b5221e9-0243-3dc8-9d93-eaf75649ae6f",
                                                "text": "He lost his patience trying to undo his shoe-lace, but tugging it made the knot even tighter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56e5ed56-195a-3287-a83d-4c7a9601f886",
                                        "entry_id": "13bec376-9fa9-3af8-bd78-3b291e2c29d6",
                                        "glosses": [
                                            "To tow by tugboat."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "46619f0e-9e66-3522-857c-bdb58e00a708",
                                        "entry_id": "13bec376-9fa9-3af8-bd78-3b291e2c29d6",
                                        "glosses": [
                                            "To masturbate."
                                        ],
                                        "tags": [
                                            "ambitransitive",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "tug",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A sudden powerful pull."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38a11f90-ac22-4525-8304-5ec6f041f7f1",
                                                "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                                                "text": "At the tug he falls, / Vast ruins come along, rent from the smoking walls."
                                            },
                                            {
                                                "example_id": "71db601e-8aa0-486c-aa4b-60afabb9b77d",
                                                "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                                                "text": "Even though the authors note that they have not \"exhausted the subject of San Francisco's queer history,\" the hope is that enough of \"us\" outside the Bay Area will find something of ourselves represented in the book and will feel that tug of connection to and solidarity with the gay capital's community."
                                            },
                                            {
                                                "example_id": "7f4624ff-84a4-4050-b44d-06b8aee3260d",
                                                "sense_id": "6ce527bd-1819-3ff5-b463-fa84576d5efe",
                                                "text": "But Van Persie slotted home 40 seconds after the break before David Wheater saw red for a tug on Theo Walcott."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "25b6d3bc-0567-31fb-94f3-c0a22dac738e",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A tugboat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a5aef8e-7255-4fd0-9457-645796c562bd",
                                                "sense_id": "25b6d3bc-0567-31fb-94f3-c0a22dac738e",
                                                "text": "Shipping of every sort, from passenger liners to ferry steamers, tramps to tugs and trailing barges, feluccas to speedboats and yachts, from warships to caiques, chugs, hoots, glides or churns its way in all directions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c40ecf-d426-3b5c-8eaa-fcad07509f45",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A type of tractor used for moving trailers."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bb1c71ce-b2df-4d7b-926b-0b9fd3a25519",
                                                "sense_id": "a3c40ecf-d426-3b5c-8eaa-fcad07509f45",
                                                "text": "Trailers are delivered by road to Poole, Portsmouth, or Rosslare in Ireland. They are then loaded onto ferries by dockyard tractors called \"tugs\". After crossing the Channel, the driverless loads are disembarked by tug and taken to the specially constructed freight terminal in Cherbourg port. Each rail wagon holds two lorry trailers and features a new 'pivoting pocket' which moves through 45° to allow the tug to push the trailer onto the wagon from alongside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a29bd3e5-f8c1-3b06-b401-bf6c2aec140e",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A kind of vehicle used for conveying timber and heavy articles."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62f4d332-0999-431b-b85a-7b5b3ac7217b",
                                                "sense_id": "a29bd3e5-f8c1-3b06-b401-bf6c2aec140e",
                                                "text": "Cattiwi came down the steep lane with his five-horse timber-tug"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "075f6ba3-ab81-3785-a3ce-a3f7045e7d73",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A trace, or drawing strap, of a harness."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0d727e75-accd-36f5-bbc3-ba93b353271c",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "A dog toy consisting of a rope, often with a knot in it."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a94bd8c0-b0fd-3673-82c5-f5f440b2c7a9",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "An iron hook of a hoisting tub, to which a tackle is affixed."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f3d0d11-2cb6-373c-b520-3bd333d39ff7",
                                        "entry_id": "384ea4ca-6afd-3cdc-afe4-a6176a1053b8",
                                        "glosses": [
                                            "An act of male masturbation."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4963d6e4-1ccc-4b6f-9e96-02a375a90a8f",
                                                "sense_id": "5f3d0d11-2cb6-373c-b520-3bd333d39ff7",
                                                "text": "He had a quick tug to calm himself down before his date."
                                            }
                                        ]
                                    }
                                ]
                            },
