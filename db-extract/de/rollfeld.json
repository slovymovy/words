                "senses": [
                    {
                        "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                        "entry_id": "6446b1e4-bcdf-314f-a8ae-cdf7b819776d",
                        "glosses": [
                            "alle Bereiche auf einem Flugplatz, die von Flugzeugen befahren werden können"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0d773ad-47ab-4296-87f3-2a7de5bc36ec",
                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                "text": "„Am Abend wollten wir mit Royal Air Maroc weiter nach Marrakesch, und es war ein so herrliches Gefühl, ohne Liebeskummer über das Rollfeld zu gehen.“"
                            },
                            {
                                "example_id": "f04723c6-8295-4550-8cdd-2a194e04c96f",
                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                "text": "„Auf dem Rollfeld nimmt die Militärpolizei von Katanga die blutverschierten Häftlinge in Empfang.“"
                            },
                            {
                                "example_id": "8e1b5b54-0a34-45a9-90a2-ac8a011b3c85",
                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                "text": "„In der späten Morgendämmerung stand das Kreuz des Südens klar und schön über der Betonbahn des Rollfeldes.“"
                            },
                            {
                                "example_id": "371fc3fc-cb43-4aa8-9d45-3cbe6e0f4a4d",
                                "sense_id": "757a6943-5763-3ea1-8c26-3c921d2ca783",
                                "text": "„Mit dem Feldstecher verschaffte er sich einen Überblick vom Rollfeld.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
