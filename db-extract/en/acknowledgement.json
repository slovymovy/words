                "senses": [
                    {
                        "sense_id": "d9a5770e-572b-3c11-b223-b4993f1721e8",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "признание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e9fb20c-fa47-4445-97bd-8930f7e4a101",
                                "sense_id": "d9a5770e-572b-3c11-b223-b4993f1721e8",
                                "text": "The President's resignation appears to be an acknowledgment that we have lost all hope of keeping the country together",
                                "translation": "Уход президента в отставку это признание того, что у нас нет надежды сохранить целостность государства"
                            }
                        ]
                    },
                    {
                        "sense_id": "e74ef858-bd2a-359b-8073-c33d105c74c2",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "подтверждение, расписка в получении (чего-либо)"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "e0be0789-50fd-3f91-9607-bd73bd62b2b2",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "узнавание"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a3dc0ea-3137-44c4-804d-db90ad04a829",
                                "sense_id": "e0be0789-50fd-3f91-9607-bd73bd62b2b2",
                                "text": "Stuart smiled in acknowledgment and gave me a bow",
                                "translation": "Стюарт улыбнулся в знак того, что узнал меня, и поклонился"
                            }
                        ]
                    },
                    {
                        "sense_id": "62260851-2dde-3c55-ab74-94a71bf4d414",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "благодарность, признательность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "85bad2bc-ccd3-4862-bd9a-757f120c8ac5",
                                "sense_id": "62260851-2dde-3c55-ab74-94a71bf4d414",
                                "text": "Maggie nodded a perfunctory acknowledgment as her glass was filled",
                                "translation": "Мэгги небрежно кивнула в знак благодарности, когда её стакан был наполнен"
                            }
                        ]
                    },
                    {
                        "sense_id": "9df1f6fc-ec26-3437-a7a0-f93c9ee21bca",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "юр. официальное заявление, подтверждение"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9fba9496-d718-3465-95c5-446c68efb161",
                        "entry_id": "9006852d-fe13-3173-8632-2f262a4d4dbe",
                        "glosses": [
                            "награждение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1314ed0c-e4d0-4229-9f2f-30ca7853b7fb",
                                "sense_id": "9fba9496-d718-3465-95c5-446c68efb161",
                                "text": "He acknowledged an early-afternoon customer with a be-with-you-in-a-minute nod. (D. U.)",
                                "translation": "Он наградил первого дневного покупателя кивком, говорящим: «буду у вас через минуту»."
                            }
                        ]
                    }
