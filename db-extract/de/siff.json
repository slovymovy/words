                                                "sense_id": "1fd45c5e-e71d-372a-9ed7-3257060180bf",
                                                "text": "Weź uprzątnij ten syf w pokoju!"
                                            },
                                            {
                                                "example_id": "ae3d5ca2-e7cf-4a90-9069-07ef3a5174a6",
                                                "sense_id": "1fd45c5e-e71d-372a-9ed7-3257060180bf",
                                                "text": "Ale syf, chodźmy stąd lepiej."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "650e476b-fa0b-389f-996d-b16f271eff36",
                                        "entry_id": "a3b65081-4589-3f0c-826f-3c158b8f66ae",
                                        "glosses": [
                                            "rzecz lub zjawisko oceniane skrajnie negatywnie"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "commonly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "18e4f8e1-8833-40f1-a475-5e5ec6b61df8",
                                                "sense_id": "650e476b-fa0b-389f-996d-b16f271eff36",
                                                "text": "Mówię wam, narkotyki nie są warte waszego życia, nie bierzcie tego syfu!"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
