                                        "entry_id": "549f21f7-1dff-3a6e-be10-1b7fc6d01b1c",
                                        "glosses": [
                                            "Grand couteau utilisé par les cuisiniers, par ceux qui font la cuisine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89b78c8b-e1e7-4fdb-a429-b806709053fa",
                                                "sense_id": "d2a66911-8cd3-3657-876f-aa6e1427dc43",
                                                "text": "On l'a tuée d'un coup de couteau en plein cœur, sans doute un couteau de cuisine, avant de la jeter dans la benne à ordures."
                                            },
                                            {
                                                "example_id": "6cba1490-0802-4d3f-8956-d0554737e149",
                                                "sense_id": "d2a66911-8cd3-3657-876f-aa6e1427dc43",
                                                "text": "À Seki, une petite ville du centre du Japon autrefois réputée pour ses sabres de samouraïs, des artisans affûtent et polissent des couteaux de cuisine à tour de bras."
                                            }
