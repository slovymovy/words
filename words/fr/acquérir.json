    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ae853aa8-2c9a-33a9-ad61-6f145747d3e0",
                    "sense_definition": "Devenir propriétaire d'un bien matériel, généralement par achat ou contrat.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "possession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle souhaite <w>acquérir</w> une maison à la campagne pour y passer ses vacances."
                        },
                        {
                            "text": "Cette entreprise a <w>acquis</w> du matériel moderne pour améliorer sa production."
                        }
                    ],
                    "synonyms": [
                        "acheter",
                        "obtenir"
                    ],
                    "common_phrases": [
                        "acquérir un bien",
                        "acquérir du matériel"
                    ]
                },
                {
                    "sense_id": "08757b5b-ea58-382f-a427-8dc5f38a8913",
                    "sense_definition": "Parvenir à posséder des connaissances, des compétences ou de l'expérience par l'apprentissage ou la pratique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "apprentissage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce premier stage lui a permis d'<w>acquérir</w> de l'expérience dans le domaine bancaire."
                        },
                        {
                            "text": "Les étudiants <w>acquièrent</w> de nouvelles compétences techniques tout au long de l'année."
                        }
                    ],
                    "synonyms": [
                        "obtenir"
                    ],
                    "common_phrases": [
                        "acquérir de l'expérience",
                        "acquérir des compétences"
                    ]
                },
                {
                    "sense_id": "057998e3-da5b-30fc-ae19-b1400d616a60",
                    "sense_definition": "Obtenir ou développer des avantages immatériels tels que l'estime, la réputation ou une certitude.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "avantage_moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Au fil des années, cette avocate a <w>acquis</w> une réputation d'intégrité remarquable."
                        },
                        {
                            "text": "Les enquêteurs ont vite <w>acquis</w> la certitude que le suspect mentait délibérément."
                        }
                    ],
                    "synonyms": [
                        "obtenir"
                    ],
                    "common_phrases": [
                        "acquérir une réputation",
                        "acquérir la certitude"
                    ]
                },
                {
                    "sense_id": "ccfa6d2c-7080-33cb-9321-cae659e3e9a9",
                    "sense_definition": "Gagner ou s'attirer par son comportement la sympathie, le respect ou les faveurs d'autrui.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Par son attitude modeste, il s'est <w>acquis</w> l'estime de tous ses collègues."
                        },
                        {
                            "text": "Le jeune candidat a cherché à s'<w>acquérir</w> les bonnes grâces des électeurs."
                        }
                    ],
                    "synonyms": [
                        "obtenir"
                    ],
                    "common_phrases": [
                        "s'acquérir l'estime",
                        "s'acquérir les bonnes grâces"
                    ]
                }
            ]
        }
    ]
}