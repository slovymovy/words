    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                "word": "comorbidity",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "1ee7bce0-b8b3-4cb2-8781-1194dcc70b0b",
                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "tags": [
                            "plural"
                        ],
                        "form": "comorbidities"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "glosses": [
                            "The presence of one or more disorders (or diseases) in addition to a primary disease or disorder."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "feb01312-b929-4823-8a38-6092de7a6328",
                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                "text": "Extensive comorbidity is the hallmark of immunodeficiencies."
                            },
                            {
                                "example_id": "78a45686-9d1d-4171-ba66-2111788e2b84",
                                "sense_id": "13eae68b-c915-356e-a376-d71fd25271e8",
                                "text": "The reported comorbidity between categorical personality disorders and OCD ranges between 33 and 87 percent (Bejerot et al, 1998)."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "glosses": [
                            "A disease thus coexisting."
                        ],
                        "tags": [
                            "countable"
                        ],
                        "examples": [
                            {
                                "example_id": "b2a9e448-0f4e-4703-8919-4d4872a5da43",
                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                "text": "Coronary artery disease is often a comorbidity of diabetes mellitus."
                            },
                            {
                                "example_id": "a667cd72-8ee3-451e-9c99-ee0e07042791",
                                "sense_id": "9f219ee0-c591-39cd-ab83-46c3ebc87772",
                                "text": "Yet in private conversations, members of his staff were also candid that the president has comorbidities that could make him more susceptible to a severe bout of the virus."
                            }
                        ]
                    },
                    {
                        "sense_id": "e0b53b04-c313-3ca5-b602-e1c743a411b2",
                        "entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "glosses": [
                            "The effect of such additional disorders or diseases."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46ef75a2-3249-4b04-a568-5f29ea33a9f9",
                        "source_entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "source_sense_description": "presence of one or more disorders in addition to a primary one",
                        "target_lang_word": "komorbidita",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "4240cc2c-3907-48f7-9a07-157e0bf1b1b8",
                        "source_entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "source_sense_description": "presence of one or more disorders in addition to a primary one",
                        "target_lang_word": "comorbiditeit",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comorbiditeit",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "6633dc0b-13f0-3dd8-bf22-bcbfd4ff7392",
                                        "entry_id": "39f38be0-7384-3d78-afe9-51beccb05a32",
                                        "glosses": [
                                            "Comorbiditeit is het tegelijkertijd hebben van twee of meer stoornissen of aandoeningen bij een patiënt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "673cc9a3-15b4-4630-8750-55ce5b2d52f7",
                                                "sense_id": "6633dc0b-13f0-3dd8-bf22-bcbfd4ff7392",
                                                "text": "Van der Goes stelt dat een patiëntspecifieke behandeling met glucocorticoïden bij reumatische ziekten de voorkeur verdient. De onderliggende ziekte, de aanwezigheid van comorbiditeit, de initiële reactie op de behandeling en de ontwikkeling van bijwerkingen zullen deze behandelbeslissingen beïnvloeden. Het gaat dan continu om het vinden van een goede balans tussen voor- en nadelen van deze therapie."
                                            },
                                            {
                                                "example_id": "c0333945-fa7f-4ff3-862f-d5b7fa45ff8d",
                                                "sense_id": "6633dc0b-13f0-3dd8-bf22-bcbfd4ff7392",
                                                "text": "Da Lima: \"Vrouwen vragen meestal pas veel later hulp dan mannen. Als zij dan eenmaal in behandeling komen, zijn ze er vaak zowel fysiek als psychisch slechter aan toe dan de meeste mannen die bij ons komen. Verder is er bij vrouwen meestal sprake van comorbiditeit. We zien verslaving vaak in combinatie met bijvoorbeeld depressie, ptss of een borderlinestoornis. Deze diagnoses worden vaak later in de behandeling gesteld, omdat ze gemaskeerd werden door de verslaving.\""
                                            },
                                            {
                                                "example_id": "1fd08d97-6186-4733-8c25-52753793d553",
                                                "sense_id": "6633dc0b-13f0-3dd8-bf22-bcbfd4ff7392",
                                                "text": "De gezondheidszorg is slecht ingesteld op mensen met meer dan één chronische ziekte. Doordat de zorg overwegend gericht is op specifieke ziektebeelden, moet de patiënt met zogeheten comorbiditeit meestal de eigen zorg coördineren."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fff60cc9-80fb-4006-91e0-1e576c6a1b5a",
                        "source_entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
                        "source_sense_description": "presence of one or more disorders in addition to a primary one",
                        "target_lang_word": "comorbidité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comorbidité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                        "entry_id": "32c8a10f-9a91-3f5a-871d-c1a0250bbf74",
                                        "glosses": [
                                            "Présence simultanée chez quelqu’un de plusieurs troubles ou de plusieurs diagnostics, pouvant découler d’une maladie initiale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f25722e-c8ae-425e-93b4-8f41b9d333f0",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "le diabète est une maladie présentant une forte comorbidité : il est fréquent que d'autres maladies y soient associées."
                                            },
                                            {
                                                "example_id": "48de9c9b-0be8-4ace-bde6-8635abd0bbe6",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "D’une manière générale, les patients présentant une comorbidité entre trouble addictologique et trouble mental sont à risque de ne pas être diagnostiqués pour l’une des deux conditions."
                                            },
                                            {
                                                "example_id": "23b31570-20eb-40eb-a16b-8be8820a5fc8",
                                                "sense_id": "6c14def5-561b-37a7-bea6-4371037eb95d",
                                                "text": "De plus, le vaccin semble fonctionner chez l’ensemble des sous-populations étudiées, incluant les personnes âgées, les minorités ethniques et les personnes présentant des comorbidités (diabète, maladie cardiovasculaire) qui les rendent à haut risque de développer des formes graves de COVID-19."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cc4e89cc-4398-4436-82a5-ba595a59f48c",
                        "source_entry_id": "b319863f-b4fe-3c17-9308-2320976be181",
