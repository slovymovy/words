                    {
                        "translation_id": "3376ae4d-7625-4ba7-be85-ff1324f2f149",
                        "source_entry_id": "bf3c5599-8eec-3924-a301-c6dc69c496fb",
                        "source_sense_id": "93ee11a6-b811-38c2-a4d2-614959313593",
