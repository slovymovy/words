            {
                "entry_id": "5629fdbd-15c0-3b11-9d21-34f86e332d00",
                "word": "yous",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "fcf88aec-4824-360d-8199-e1ad50068029",
                        "entry_id": "5629fdbd-15c0-3b11-9d21-34f86e332d00",
                        "glosses": [
                            "plural of you"
                        ],
                        "tags": [
                            "dialectal",
                            "form-of",
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "d939054a-a4d3-496c-9a6b-6785612b80cb",
                                "sense_id": "fcf88aec-4824-360d-8199-e1ad50068029",
                                "text": "There are two yous — the visible you and the real you. The visible you is the you that is known by others."
                            },
                            {
                                "example_id": "61e95666-733f-4ab0-8d83-04b2f2b55213",
                                "sense_id": "fcf88aec-4824-360d-8199-e1ad50068029",
                                "text": "Most of your life after babyhood has been played out by the several yous."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "b5b79300-8dd3-3596-8a26-b7f755bde3ee",
                "word": "yous",
                "pos": "pron",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "133264f2-6e63-3a78-be6e-3ed9462bb034",
                        "entry_id": "b5b79300-8dd3-3596-8a26-b7f755bde3ee",
                        "glosses": [
                            "You."
                        ],
                        "tags": [
                            "dialectal",
                            "in-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "64f56080-7556-41cd-bc3c-7287be31fa8e",
                                "sense_id": "133264f2-6e63-3a78-be6e-3ed9462bb034",
                                "text": "What are yous up to tonight?"
                            }
                        ]
                    },
                    {
                        "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                        "entry_id": "b5b79300-8dd3-3596-8a26-b7f755bde3ee",
                        "glosses": [
                            "You."
                        ],
                        "tags": [
                            "colloquial",
                            "dialectal",
                            "singular"
                        ],
                        "examples": [
                            {
                                "example_id": "1a7c36d7-7e6f-489a-a651-b2cc31404ec9",
                                "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                                "text": "‘Dere ain't no use for me dis side, Mr. Chames,’ he said. ‘New York's de spot. Youse don't want none of me, now you're married.’"
                            },
                            {
                                "example_id": "cc14b769-4323-4c9f-a334-3c3afbe60468",
                                "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                                "text": "‘Yous will meet us here outside this pub,’ Harry Curniskey said."
                            },
                            {
                                "example_id": "e73f72f3-491a-4d53-a547-539e5e378537",
                                "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                                "text": "‘But what I also seen is that youse have never had a real man before, datin' all them boys. Youse have never had anyone who'd stand up to youse.’"
                            },
                            {
                                "example_id": "f45bb90f-a8e9-4cd4-86a4-957565a2a41d",
                                "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                                "text": "You think yous can live wi'oot money! Few months doon this hell, you'll murder for money!"
                            },
                            {
                                "example_id": "8573e2e3-4248-4927-b05e-24be4a100614",
                                "sense_id": "057dfaa7-db02-3d85-a4db-a416d9d3525d",
                                "text": "He tossed off half of the drink and I gave him a refill. \"What can I do for youse?\" \"First off, information.\""
                            }
                        ]
                    }
                ],
                "translations": [],
