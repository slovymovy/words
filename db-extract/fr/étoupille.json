                "senses": [
                    {
                        "sense_id": "762987cd-0dd1-3147-8266-ecdb24c1183c",
                        "entry_id": "b0c5c882-a17f-34dc-b2b5-bd76dc4a25b5",
                        "glosses": [
                            "Petite mèche facilement inflammable, servant à la mise à feu d'explosif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06f1577e-1fc2-4ea2-a9de-c6832c19dcdd",
                                "sense_id": "762987cd-0dd1-3147-8266-ecdb24c1183c",
                                "text": "Dans le chargement du pot de la fusée, on a soin que le serpenteau soit placé perpendiculairement, l’étoupille en bas.\nOn varie l'effet des serpenteaux, soit en dégorgeant les deux étranglements et établissant une communication entre eux par un brin d’étoupille que l'on lie en dehors du cartouche […]."
                            },
                            {
                                "example_id": "63187c09-c4fb-4bc3-ac8b-c2c6f077ebe0",
                                "sense_id": "762987cd-0dd1-3147-8266-ecdb24c1183c",
                                "text": "Suivant le chevalier de Ville, le plus ancien mode d’inflammation des mines en usage étaient la traînée de poudre et l’étoupille ou estoupin."
                            }
                        ]
                    },
                    {
                        "sense_id": "3fc24cf2-20ad-343a-8394-456831393ff8",
                        "entry_id": "b0c5c882-a17f-34dc-b2b5-bd76dc4a25b5",
                        "glosses": [
                            "Autrefois mèche utilisée pour la mise à feu des canons."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "92c8cd43-09c2-3f5f-830f-0c8aaa0de43f",
                        "entry_id": "b0c5c882-a17f-34dc-b2b5-bd76dc4a25b5",
                        "glosses": [
                            "Actuellement petit tube métallique renfermant du fulminate de mercure et qui sert à propager le feu à la charge de poudre d’une cartouche."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2a426d96-27d5-497e-93ae-f98a1e4a1784",
                                "sense_id": "92c8cd43-09c2-3f5f-830f-0c8aaa0de43f",
                                "text": "Le fulminate contenu dans l'étoupille s’enflamme par percussion."
                            }
                        ]
                    }
