                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "22adf684-f857-4041-b9da-a5bcfc69470d",
                                "sense_id": "11f403c9-58a6-3183-b247-48f6453ef66a",
                                "text": "Vrouwen gaan langer kreukvrij door het leven dan mannen, bij wie het verval al rond hun vijftigste duidelijk zichtbaar is. Dat blijkt uit Rotterdams rimpel-onderzoek."
                            }
                        ]
