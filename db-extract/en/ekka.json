                        "entry_id": "6f9b7832-dc62-32b4-9abe-ea37a389deca",
                        "glosses": [
                            "A small vehicle used in India, pulled by a single horse."
                        ],
                        "tags": [
                            "India"
                        ],
                        "examples": [
                            {
                                "example_id": "8dc9fb0f-9579-4ac1-9a10-eb26f0cf96d6",
                                "sense_id": "35edb76d-d5db-3933-bf73-7aea033eda87",
                                "text": "He said that he was ‘going to shoot big game’, and left at half-past ten o'clock in an ekka."
                            },
                            {
                                "example_id": "603b04bc-a09c-45ea-975a-2a52df85a598",
                                "sense_id": "35edb76d-d5db-3933-bf73-7aea033eda87",
                                "text": "Throughout India the ekka is the ordinary vehicle in which the natives travel, and until recent times was the only one available to Europeans."
                            }
                        ]
                    }
