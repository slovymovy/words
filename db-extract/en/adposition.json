                                            {
                                                "example_id": "7a166be2-8ec9-4b64-ad11-be189007afe9",
                                                "sense_id": "815a7f01-b23c-3e9b-b5b2-782217e37e5c",
                                                "text": "Radar pokazuje pozycję samolotu względem lotniska."
