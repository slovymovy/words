                        "target_lang_word": "proclitic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "proclitic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "21bfdf52-f77e-3cb4-8760-00a6fc0fe96e",
                                        "entry_id": "bf501fb8-f586-3433-838b-e4568e829bd0",
                                        "glosses": [
                                            "A clitic that joins with the following word phonetically, graphically, or both."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eefb116-12b1-4656-a015-d387d537c19d",
                                                "sense_id": "21bfdf52-f77e-3cb4-8760-00a6fc0fe96e",
                                                "text": "In dialectal or poetic English, the article the or preposition to can become the proclitic t'."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d60a96d2-bf8b-4eca-9637-35f589545bde",
                        "source_entry_id": "54839505-7703-3809-9cd8-bdc0567565ec",
                        "source_sense_id": "830fccaf-6329-3911-8290-16df26a876e2",
                        "target_lang_word": "Proklitikon",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Proklitikon",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                        "entry_id": "26e63ef4-b4d1-3c0d-9b47-9edb2e2d1dfb",
                                        "glosses": [
                                            "Wörter oder Wortteile, die am Anfang eines anderen Wortes angefügt werden, dabei oft einen Teil ihrer Lautsubstanz verlieren und unbetont sind"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b8295a5-cdbf-4a83-be82-7f9555e3ea95",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "Proklitika bilden zusammen mit dem Wort, an das sie angefügt sind, ein phonetisches Wort."
                                            },
                                            {
                                                "example_id": "49e1d1ea-8096-41b0-978c-5277b62d4686",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "Der Vorgang, der zu einem Proklitikon führt, heißt Proklise."
                                            },
                                            {
                                                "example_id": "99119cdc-f7ae-4b4b-bfef-40e79f33b41f",
                                                "sense_id": "f43641d2-4106-3962-955f-b2b7157f353c",
                                                "text": "„Eine weitere Auswertung der Position der Betonung bezogen auf Wortformen (phonologisches Wort unter Einschluss von Pro- und Enklitika) zeigt, dass bei ungerader Silbenanzahl eines Wortes genau die in der Mitte liegende Silbe die Betonung trägt, während bei gerader Silbenanzahl eine der zwei mittleren Silben eine Betonung (…) auf sich nimmt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8d6dbf25-2455-4dc2-a380-bee2449186fa",
                        "source_entry_id": "54839505-7703-3809-9cd8-bdc0567565ec",
                        "source_sense_id": "830fccaf-6329-3911-8290-16df26a876e2",
                        "target_lang_word": "proclitique",
