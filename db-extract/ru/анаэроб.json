                "senses": [
                    {
                        "sense_id": "51f0df96-bac4-3e01-b447-5acd82857c80",
                        "entry_id": "9f180492-850f-3509-8dee-54eee6dc5789",
                        "glosses": [
                            "биол. организм, который способен жить, расти и развиваться при отсутствии свободного кислорода"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "745cb018-02d8-4762-820d-c492e79a3d88",
                                "sense_id": "51f0df96-bac4-3e01-b447-5acd82857c80",
                                "text": "Почти все они ― облигатные анаэробы и не переносят молекулярный кислород в концентрации даже меньшей, чем в воздухе."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "080d40bd-0240-4daa-87f9-457666fccac3",
                        "source_entry_id": "9f180492-850f-3509-8dee-54eee6dc5789",
                        "source_sense_id": "51f0df96-bac4-3e01-b447-5acd82857c80",
                        "target_lang_word": "anaérobie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anaérobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d0b996a4-ca2e-3582-9496-7c5b6d167d99",
                                        "entry_id": "4a872d43-251c-31be-ab3e-1c3833ba691b",
                                        "glosses": [
                                            "Qui vit sans air atmosphérique."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fd19a1c7-8eb4-3abd-9c60-4237a553095a",
                                        "entry_id": "4a872d43-251c-31be-ab3e-1c3833ba691b",
                                        "glosses": [
                                            "Relatif à une activité biologique qui demande peu ou pas d’oxygène."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c6513b4f-3dd6-48f5-baa2-cb5083e5c6fb",
                                                "sense_id": "fd19a1c7-8eb4-3abd-9c60-4237a553095a",
                                                "text": "L’entraînement anaérobie améliore aussi l’efficacité du mouvement."
                                            },
                                            {
                                                "example_id": "77723038-973f-4c42-a9b1-8ba73c6e7601",
                                                "sense_id": "fd19a1c7-8eb4-3abd-9c60-4237a553095a",
                                                "text": "Sur notre planète, la phosphine est synthétisée par des processus industriels mais aussi par certains organismes anaérobies que l’on trouve par exemple dans les rizières."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anaérobie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ce924748-f690-37f2-8bb0-ca8e10e817e1",
                                        "entry_id": "025b8a77-dc47-3657-b623-1d6ceafa31eb",
                                        "glosses": [
                                            "Environnement privé d’air."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b53c3a59-27a8-48d3-94ce-87811e9be0ef",
                                                "sense_id": "ce924748-f690-37f2-8bb0-ca8e10e817e1",
                                                "text": "Si le sarcophage a effectué le voyage jusqu’à la Villette, le corps est resté en raison de sa fragilité au musée de la Civilisation du Caire dans un caisson en anaérobie, un environnement privé d’air, pour sa conservation."
                                            },
                                            {
                                                "example_id": "d73b16a3-5994-41d3-b735-9a72b0248a74",
                                                "sense_id": "ce924748-f690-37f2-8bb0-ca8e10e817e1",
                                                "text": "Au-delà, on passe dans l’anaérobie totale et le corps change de mode de production énergétique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
