                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e57aad3-c580-4e42-8762-5c250dd03516",
                                                "sense_id": "badeb214-a894-3e78-a5dd-1975a2722bc7",
                                                "text": "Nie ma co wyciągać starych brudów na wierzch."
                                            }
