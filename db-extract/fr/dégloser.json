                "senses": [
                    {
                        "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                        "entry_id": "d315b38f-f512-3ad3-86c2-f40e0f813bd6",
                        "glosses": [
                            "Parler, dire. Définition manquante ou à compléter. (Ajouter)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "db401c04-1c6b-4f84-8a40-cf60df370764",
                                "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                                "text": "Les cris et appels parachevés, rentrèrent les hérauts à l’hôtel, laissant les manants dégloser à foison et raisonner à tort et à travers sur l’étrange procès."
                            },
                            {
                                "example_id": "68588ad7-45ec-4901-a154-704212ea27fb",
                                "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                                "text": "Chacun déglose à sa manière sur la besogne qui fut faite."
                            },
                            {
                                "example_id": "39bea178-2e3e-4646-a223-0b93756a2704",
                                "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                                "text": "Sur ce qu’elle a déglosé, il affûte un loup sur les friches."
                            },
                            {
                                "example_id": "3b578a3a-a425-4f59-a9ef-48babf35dcbb",
                                "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                                "text": "l’homme défoule et déglose il éclope c’est tout"
                            },
                            {
                                "example_id": "e26567fc-bbcd-4ded-883e-57286f6f99b0",
                                "sense_id": "77162081-737c-3a3d-b119-04da87ae1bd9",
                                "text": "Dans une mimique des grands circulaires du XXᵉ siècle, il typographie, il déglose, de Marges à Glas."
                            }
                        ]
                    }
