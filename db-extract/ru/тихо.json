        "ru-extract.jsonl": [
            {
                "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                "word": "тихо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "aa485952-9766-3bb7-919e-9ff4bee0fce2",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "не издавая громких звуков"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31aa31cd-44c4-482b-9bb0-38b010be1d09",
                                "sense_id": "aa485952-9766-3bb7-919e-9ff4bee0fce2",
                                "text": "Вокруг было тихо, слышался мирный стрёкот кузнечиков."
                            },
                            {
                                "example_id": "113dd963-d73a-40e7-8937-c429a2f03ae3",
                                "sense_id": "aa485952-9766-3bb7-919e-9ff4bee0fce2",
                                "text": "Она поднимает голову и потом очень тихо говорит: «Нет»."
                            }
                        ]
                    },
                    {
                        "sense_id": "4277dbae-df51-361c-9782-65b7fd3828d7",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "перен. медленно, постепенно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ce6c617-256f-4ea8-9040-8e926c4ca58c",
                                "sense_id": "4277dbae-df51-361c-9782-65b7fd3828d7",
                                "text": "Знаете, как какой-нибудь мощный современный автомобиль с двигателем литров на пять и лошадиных сил на четыреста: он так тихо едет, километров 70 в час, но может дать и 170."
                            },
                            {
                                "example_id": "5276dedb-c1f6-4289-ac19-816c49d02820",
                                "sense_id": "4277dbae-df51-361c-9782-65b7fd3828d7",
                                "text": "[…] профессор тихо стал звереть. И неожиданно перешёл от крика на тихий, зловеще-вкрадчивый голос […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "4b9b026a-5ac7-3d6c-af0d-bc824add0836",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "перен. незаметно, украдкой, без лишнего шума, стараясь не привлекать внимания"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "432a7c42-3435-46a0-a1ee-6bd5387850a7",
                                "sense_id": "4b9b026a-5ac7-3d6c-af0d-bc824add0836",
                                "text": "В конце концов реформу тихо свернули."
                            },
                            {
                                "example_id": "d64d1927-588a-4376-9c4f-4f6f875d93d2",
                                "sense_id": "4b9b026a-5ac7-3d6c-af0d-bc824add0836",
                                "text": "Георгия Хижу вскоре тихо убрали с высокой должности и пересадили на менее заметную."
                            }
                        ]
                    },
                    {
                        "sense_id": "e3d20291-d1c4-38a3-834b-67ef5f0975f1",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "предик., безл. безмятежно, спокойно, мирно, без общественных волнений или беспорядков, без боевых действий"
                        ],
                        "tags": [
                            "об обстановке или о душевном состоянии"
                        ],
                        "examples": [
                            {
                                "example_id": "ad601bde-85d1-446d-86ad-d5f52e1055be",
                                "sense_id": "e3d20291-d1c4-38a3-834b-67ef5f0975f1",
                                "text": "Стражи порядка, перекрыв движение, арестовали 20 человек. В самой Италии было тихо."
                            }
                        ]
                    },
                    {
                        "sense_id": "606a69e4-651a-3a95-ae74-95e0c848b866",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "предик., безл. без ветра, без волн"
                        ],
                        "tags": [
                            "о погоде"
                        ],
                        "examples": [
                            {
                                "example_id": "3600b50d-fe21-49d1-8c3a-721ac62ec73d",
                                "sense_id": "606a69e4-651a-3a95-ae74-95e0c848b866",
                                "text": "На море тихо, и только лёгкая зыбь бежит по его простору."
                            },
                            {
                                "example_id": "bf6596eb-fed5-4f8f-9ae8-88634c45ee11",
                                "sense_id": "606a69e4-651a-3a95-ae74-95e0c848b866",
                                "text": "Когда она уходила с работы, было тихо, ни дождя, ни ветра."
                            }
                        ]
                    },
                    {
                        "sense_id": "a0c18302-453c-3b94-a576-6717dd3cc3b3",
                        "entry_id": "599c6b2c-fbb3-3afc-8a56-8bc6c7574e9b",
                        "glosses": [
                            "призыв к молчанию, к сохранению тишины или к осторожности"
                        ],
                        "tags": [
                            "в значении междометия"
                        ],
                        "examples": [
                            {
                                "example_id": "ae13a1bb-787a-4254-9299-ddf0226496fd",
                                "sense_id": "a0c18302-453c-3b94-a576-6717dd3cc3b3",
                                "text": "Когда они подошли к тяжёлой, обитой железом двери, седой охранник услышал что-то внутри и предостерегающе поднял руку. ― Тихо! ― сказал он."
                            },
                            {
                                "example_id": "96934db0-186f-4a32-8493-6fb598504504",
                                "sense_id": "a0c18302-453c-3b94-a576-6717dd3cc3b3",
                                "text": "Люда ещё прикрикнула: «Мужчины, тихо!», и полные, с седеющими висками на полуслове оборвали разговор и притихли."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": [
