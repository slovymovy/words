                        "glosses": [
                            "een reeks lessen die als doel hebben om te leren een maaltijd te bereiden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5cefd3ad-1005-45ea-aa77-cf1609184514",
                                "sense_id": "bf5218d9-a94d-367c-b5b0-f1e5f4d399a2",
                                "text": "Ik probeer plezier te hebben in kleine, alledaagse dingen: een liedje waar ik van houd; mijn ochtendwandeling; de rommel die ik maak bij de kookcursus."
                            },
                            {
                                "example_id": "d706e1c6-dd7c-4821-8519-cbcc1e48385a",
                                "sense_id": "bf5218d9-a94d-367c-b5b0-f1e5f4d399a2",
                                "text": "Bij de kookcursus zijn de bewoners blij dat bijna alle kosten worden gesubsidieerd, al noemen velen de overgang wel wennen. \"Ik vind het te snel gaan\", zegt een cursist. \"Een beetje een rustig tempo had van mij wel gemogen.\""
                            }
                        ]
                    }
