                                    },
                                    {
                                        "sense_id": "facc7310-5755-3038-8f08-d99a4b9f3e56",
                                        "entry_id": "a96ff9ef-71d6-33e5-ae74-425225febde5",
                                        "glosses": [
                                            "A state of awareness, concentration, or focus that filters experience and information (for example, a state of meditation or possession by some being)."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1405c8b4-543a-44cf-b107-42eb4e32f987",
                                                "sense_id": "facc7310-5755-3038-8f08-d99a4b9f3e56",
                                                "text": "And he became very hungry, and would have eaten; but while they made ready, he fell into a trance."
                                            },
                                            {
                                                "example_id": "5234d97f-210f-4667-a863-19c96e459c44",
                                                "sense_id": "facc7310-5755-3038-8f08-d99a4b9f3e56",
                                                "text": "My soul was ravished quite as in a trance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d234ad4a-2469-30ab-a131-0b876559e8f4",
                                        "entry_id": "a96ff9ef-71d6-33e5-ae74-425225febde5",
                                        "glosses": [
                                            "A state of low response to stimulus and diminished, narrow attention; particularly one induced by hypnosis."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b2be8e08-0a99-3a54-835e-2152089e6a22",
                                        "entry_id": "a96ff9ef-71d6-33e5-ae74-425225febde5",
                                        "glosses": [
                                            "Ellipsis of trance music (“genre of electronic dance music”)."
                                        ],
                                        "tags": [
