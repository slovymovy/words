                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a115a6c7-d13a-4e43-a963-301ac21cb6f0",
                                "sense_id": "ae75111d-8031-3c16-906a-b4bc42717356",
                                "text": "Как один из зачинщиков старик сослан был в каторжную работу."
                            },
                            {
                                "example_id": "29d677d1-f541-4b89-8938-5915b7947454",
                                "sense_id": "ae75111d-8031-3c16-906a-b4bc42717356",
                                "text": "Им всё кажется, что тут действуют какие-то зачинщики и подстрекатели, без тайных козней которых всё шло бы как по маслу."
                            }
                        ]
                    }
