                "senses": [
                    {
                        "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                        "entry_id": "254e345d-6b40-3b0b-b4dd-1658fdf2a8ae",
                        "glosses": [
                            "Haus, in dem eine oder mehrere Gewerkschaften ihre Verwaltung haben"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d53a247-e0f4-4481-92e6-3c211237ae50",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Der Mann, der den Kreml-Oligarchen diese Angst nahm, der politische Kontrolle und militärische Tüchtigkeit unermüdlich auf einen Nenner zu bringen wußte, der dem Kreml das Raketenschach mit Amerika ermöglichen half, aber dann auch die eigenen, übereifrigen Offiziere in Schach hielt – dieser Mann wurde am vergangenen Wochenende im Moskauer Kolonnensaal des Gewerkschaftshauses aufgebahrt.“"
                            },
                            {
                                "example_id": "7008ce03-01d7-4ab8-8314-09881465afd5",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Der Eisenerzer Gemeinderat tauschte die Gemeindestube gegen das Innerberger Gewerkschaftshaus für eine Gemeinderatssitzung, eine besondere.“"
                            },
                            {
                                "example_id": "dd005306-3b0e-4072-824b-ec8eb5269a57",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Und ja, dieser Text ist lang geworden und müsste noch viel länger werden, weil dieses Projekt eine gewaltige Reise war, die ihren ersten Höhepunkt hatte, als im Rechtsschutzsaal in Friedrichsthal, dem ältesten Gewerkschaftshaus Deutschlands, den Release gefeiert werden durfte.“"
                            },
                            {
                                "example_id": "438136cc-aa80-479e-aba1-6c20b8e4f8cc",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Es ist gut, dass es im Gewerkschaftshaus ein Helene-Grünberg-Zentrum gibt, damit ihre Arbeit sichtbarer wird.“"
                            },
                            {
                                "example_id": "c676a6ae-33c5-485f-8c81-e95b86055fb3",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Etwa 300 Personen kommen zur Auftaktveranstaltung im Gewerkschaftshaus, darunter viele aus dem europäischen Ausland angereiste Aktivist:innen [sic].“"
                            },
                            {
                                "example_id": "558f3c8c-2b6d-465c-ba8d-3cab9afbb2ca",
                                "sense_id": "9f6281fb-51d1-326e-bfa1-1515a4709508",
                                "text": "„Die Demonstranten skandieren Hochrufe auf das Deutsche Reich und hissen eine Hakenkreuzflagge auf dem Dach des Gewerkschaftshauses.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
