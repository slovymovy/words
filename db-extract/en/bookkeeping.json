                ],
                "translations": [
                    {
                        "translation_id": "c919ab05-669c-467e-a05e-c5b262dc680e",
                        "source_entry_id": "ab0923cf-6a9c-3ca8-b872-ac23ed1bc88a",
                        "source_sense_description": "skill of keeping records of financial transactions",
                        "target_lang_word": "comptabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "comptabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                        "entry_id": "dd1b226d-7bfa-3ba4-975b-8117413dc832",
                                        "glosses": [
                                            "Tenue des comptes, la manière, l’action de rendre et d’établir des comptes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23fc4e9e-941d-4751-a19f-639ad52d9fc6",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Si Ripoil tombe, je risque gros. On va enquêter, fouiller dans la comptabilité. Et le bougre est capable de manger le morceau. Nous avons touché Barnold et moi. L'extorsion de fonds est indéniable."
                                            },
                                            {
                                                "example_id": "8fcc903e-69be-40e1-aff6-3aee23a9c975",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Les chiffres publiés relèvent de la comptabilité publique, qui diffère de la comptabilité nationale, publiée par l’Institut national de la statistique (INE) et traditionnellement utilisée dans les comparaisons internationales."
                                            },
                                            {
                                                "example_id": "40fc9667-8662-4c36-8013-27571b2e673e",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Après un gigot flageolets avalé chez belle-maman, qu'il appelle « ma mère », monsieur met à profit l'après-midi dominical pour s'immerger dans la comptabilité familiale."
                                            },
                                            {
                                                "example_id": "374bd4a2-b4ac-4f07-bdd6-6418fc6a73a9",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Il a mis beaucoup d’ordre dans sa comptabilité."
                                            },
                                            {
                                                "example_id": "e1d6cfe2-8506-43dc-a7ae-217f545496c2",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Il aime bien la comptabilité."
                                            },
                                            {
                                                "example_id": "ec915d2d-52f1-493d-951f-b34a04b2e786",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Être chargé de la comptabilité."
                                            },
                                            {
                                                "example_id": "fee8fea9-74a0-4ccf-9ae8-2fc34825c529",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Bureau de la comptabilité."
                                            },
                                            {
                                                "example_id": "3f589ede-86a5-4a2f-8572-cea43a4b6226",
                                                "sense_id": "d314d5d9-1bf8-36b5-afa5-427f4884f778",
                                                "text": "Le chef de la comptabilité va comptabiliser cette facture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c8ee928-296e-4135-acf6-31f1a1469e82",
                        "source_entry_id": "ab0923cf-6a9c-3ca8-b872-ac23ed1bc88a",
                        "source_sense_description": "skill of keeping records of financial transactions",
                        "target_lang_word": "Buchhaltung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Buchhaltung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1cece673-2423-3623-9506-5081e7c90e64",
                                        "entry_id": "5f448c38-4043-3828-a953-fd02f540017e",
                                        "glosses": [
                                            "Organisationseinheit eines Unternehmens, welche alle Geschäftsvorgänge des Letzteren aufzeichnet"
                                        ],
                                        "tags": [
                                            "Rechnungswesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e4b7b0b4-9eb1-4582-898e-2c8b4a1ffe87",
                                                "sense_id": "1cece673-2423-3623-9506-5081e7c90e64",
                                                "text": "Mein Vater arbeitet in der Buchhaltung."
                                            },
                                            {
                                                "example_id": "81038e27-80b8-4518-b025-f3e51d633d17",
                                                "sense_id": "1cece673-2423-3623-9506-5081e7c90e64",
                                                "text": "„Die in der Buchhaltung angefallene Arbeit wurde während ihrer Abwesenheit von anderen Mitarbeitern erledigt.“"
                                            },
                                            {
                                                "example_id": "d320078f-2c8f-4059-a721-756d1a53990a",
                                                "sense_id": "1cece673-2423-3623-9506-5081e7c90e64",
                                                "text": "„Schweren Herzens meldete sie sich bei der »Landfrauenschule« im bayrischen Miesbach an, und als sie nach einem Jahr zurückkehrte, übernahm sie in Götzlack die Buchhaltung, die Zuchtbücher, die Korrespondenz und den Garten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7c53149e-e1d3-3867-8f06-df6b89a046a3",
                                        "entry_id": "5f448c38-4043-3828-a953-fd02f540017e",
                                        "glosses": [
                                            "in Zahlenwerten vorgenommene Aufzeichnung aller Geschäftsvorgänge in einem Unternehmen"
                                        ],
                                        "tags": [
                                            "nur Singular"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "432a17eb-0d18-40e4-a607-df1f7a40dcd4",
                                                "sense_id": "7c53149e-e1d3-3867-8f06-df6b89a046a3",
                                                "text": "Schon vor Jahren hat mein Onkel die Buchhaltung erlernt."
                                            },
                                            {
                                                "example_id": "785ed909-6061-4d48-8062-2386109694cf",
                                                "sense_id": "7c53149e-e1d3-3867-8f06-df6b89a046a3",
                                                "text": "„Aufgabe der Buchhaltungsagentur ist die Führung der Buchhaltung des Bundes für die haushaltsführenden Stellen […] unter Anwendung der Haushaltsvorschriften des Bundes, insbesondere des BHG 2013.“"
                                            },
                                            {
                                                "example_id": "e23d77d3-008f-41b4-a39f-04a0f1498cea",
                                                "sense_id": "7c53149e-e1d3-3867-8f06-df6b89a046a3",
                                                "text": "„Wie sie Buchhaltung hasste.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
