{
    "word_family": [
        "uitsluiten",
        "uitsluitbaar"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4128f923-cff8-3ca6-b0ec-7bb870dfa503",
                    "sense_definition": "Het niet toelaten of buitensluiten van personen of groepen uit een gemeenschap, activiteit of proces.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitsluiting_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Miljoenen mensen lopen wereldwijd nog steeds het risico op sociale <w>uitsluiting</w>.",
                            "target_lang_translations": {
                                "en": "Millions of people worldwide are still at risk of social <w>exclusion</w>."
                            }
                        },
                        {
                            "text": "De systematische <w>uitsluiting</w> van minderheden leidde tot grote maatschappelijke onrust.",
                            "target_lang_translations": {
                                "en": "The systematic <w>exclusion</w> of minorities led to major social unrest."
                            }
                        }
                    ],
                    "synonyms": [
                        "buitensluiting",
                        "exclusie",
                        "wering"
                    ],
                    "antonyms": [
                        "inclusie",
                        "opname",
                        "integratie"
                    ],
                    "common_phrases": [
                        "sociale uitsluiting"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of not allowing or shutting out individuals or groups from a community, activity, or process."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclusion",
                                "target_lang_sense_clarification": "the act of shutting out or keeping out"
                            },
                            {
                                "target_lang_word": "marginalization",
                                "target_lang_sense_clarification": "social exclusion of a group"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "df8b755a-bfe2-3203-8ac8-048c869a52d5",
                    "sense_definition": "De handeling waarbij iets of iemand formeel wordt weggelaten of niet meegerekend.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "uitsluiting_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De polisvoorwaarden bevatten een expliciete <w>uitsluiting</w> van schade door natuurrampen.",
                            "target_lang_translations": {
                                "en": "The policy conditions contain an explicit <w>exclusion</w> of damage caused by natural disasters."
                            }
                        },
                        {
                            "text": "Bij <w>uitsluiting</w> van andere kandidaten werd zij direct gekozen voor de functie.",
                            "target_lang_translations": {
                                "en": "To the <w>exclusion</w> of other candidates, she was immediately chosen for the position."
                            }
                        }
                    ],
                    "synonyms": [
                        "exclusie"
                    ],
                    "antonyms": [
                        "insluiting",
                        "opname"
                    ],
                    "common_phrases": [
                        "bij uitsluiting van"
                    ],
                    "target_lang_definitions": {
                        "en": "The act of formally omitting or not including someone or something."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exclusion",
                                "target_lang_sense_clarification": "formal omission or exception"
                            },
                            {
                                "target_lang_word": "exemption",
                                "target_lang_sense_clarification": "being freed from an obligation or coverage"
                            }
                        ]
                    }
                }
            ]
        }
    ]
