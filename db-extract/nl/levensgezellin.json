                "senses": [
                    {
                        "sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                        "entry_id": "d7b1671d-a780-3300-8beb-df9c959187e5",
                        "glosses": [
                            "vrouw waarmee men samenleeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbace895-2265-41fe-b5c9-6c2703533eb4",
                                "sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                                "text": "En deze vrouw, viel Nikolaj Levin hem in de rede, op haar wijzend, is mijn levensgezellin, Masja Nikolajevna."
                            },
                            {
                                "example_id": "13db6824-2c1e-41d8-b912-12e2db871c93",
                                "sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                                "text": "Zijn Russische levensgezellin heeft bekend er een relatie met de priester op na te hebben gehouden. Maar ze wist niets van de gewelddadige plannen van Georgi, vertelde ze tijdens haar verhoor."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ac2b6aa8-dbf0-492d-a0c4-8e0fd3c99382",
                        "source_entry_id": "d7b1671d-a780-3300-8beb-df9c959187e5",
                        "source_sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                        "source_sense_description": "vrouw waarmee men samenleeft",
                        "target_lang_word": "life companion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f77571f2-af32-4fa9-8619-5368b2e03baf",
                        "source_entry_id": "d7b1671d-a780-3300-8beb-df9c959187e5",
                        "source_sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                        "source_sense_description": "vrouw waarmee men samenleeft",
                        "target_lang_word": "wife",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                        "entry_id": "55c25e4f-8af5-361c-9a35-db5ba1c68b54",
                                        "glosses": [
                                            "A married woman, especially in relation to her spouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "567ec276-23b9-4fef-9e1d-e292abc9ee49",
                                                "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                                "text": "The Fisherman and His Wife"
                                            },
                                            {
                                                "example_id": "c6003ec1-6d71-4a7f-962f-cfc59550ba11",
                                                "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                                "text": "And I geue vnto the ſame Elizabeth my wif the ſparuers and hangings of the ſame twoo beddes vſuallye occupied, and hanging ouer and about the ſame twoo beddes[…]"
                                            },
                                            {
                                                "example_id": "38fe0693-46cb-4f07-a2f3-695be2dc97ef",
                                                "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                                "text": "It was a joy to snatch some brief respite, and find himself in the rectory drawing–room. Listening here was as pleasant as talking; just to watch was pleasant. The young priests who lived here wore cassocks and birettas; their faces were fine and mild, yet really strong, like the rector's face; and in their intercourse with him and his wife they seemed to be brothers."
                                            },
                                            {
                                                "example_id": "dc29d780-453d-43c4-b374-82f683ea0cc2",
                                                "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                                "text": "1952, P. G. Wodehouse, Big Business, in 'A Few Quick Ones', Everyman, London: 2009, p 127-8.\nAll through Reginald's deeply moving performance she had sat breathless, her mind in a whirl and her soul stirred to her very depths. With each low note that he pulled up from the soles of his shoes she could feel the old affection and esteem surging back into her with a whoosh, and long before he had taken his sixth bow she knew ... that it would be madness to try to seek happiness elsewhere, particularly as the wife of a man with large ears and no chin, who looked as if he were about to start in the two-thirty race at Kempton Park."
                                            },
                                            {
                                                "example_id": "2a6db7cc-e00a-40b2-9e8e-03153dfa7d28",
                                                "sense_id": "f14768a4-d8c9-3500-9248-38e3d3f70bca",
                                                "text": "Despite personal schisms and differences in spiritual experience, there is a very coherent theology of Snape shared between the wives. To examine this manifestation of religious fandom, I will first discuss the canon scepticism and anti-Rowling sentiment that helps to contextualise the wider belief in Snape as a character who extends beyond book and film."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d84f8217-dca0-3a65-8f7a-29dbdc056148",
                                        "entry_id": "55c25e4f-8af5-361c-9a35-db5ba1c68b54",
                                        "glosses": [
                                            "The female of a pair of mated animals."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fa3e9ea-9d86-4127-8931-8e90363bef04",
                                                "sense_id": "d84f8217-dca0-3a65-8f7a-29dbdc056148",
                                                "text": "A new wife for the gander is introduced into the pen."
                                            },
                                            {
                                                "example_id": "7176851f-f3a5-425b-99bb-aeacbdb5c589",
                                                "sense_id": "d84f8217-dca0-3a65-8f7a-29dbdc056148",
                                                "text": "I stepped out and advanced valiantly upon a long-maned bull in the midst of his wives. I was armed with the regular club with which the boat-pullers killed the wounded seals gaffed aboard by the hunters."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "57fc1bec-f20b-34d7-a38a-4b19d5488ab8",
                                        "entry_id": "55c25e4f-8af5-361c-9a35-db5ba1c68b54",
                                        "glosses": [
                                            "Synonym of woman."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "wife",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3c25b406-3e38-3eba-906c-420416c01c4b",
                                        "entry_id": "7490b078-4202-3ff6-bbbf-04de3f2475f8",
                                        "glosses": [
                                            "To marry (a woman)."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "406ac747-367e-41c5-9a28-a5408a5ef971",
                                                "sense_id": "3c25b406-3e38-3eba-906c-420416c01c4b",
                                                "text": "But I told you that you're not a wifeable woman, and I told him so, and he wanted to wife you anyway."
                                            },
                                            {
                                                "example_id": "74fbd49e-604a-427e-a310-ec58c1d4b8ba",
                                                "sense_id": "3c25b406-3e38-3eba-906c-420416c01c4b",
                                                "text": "Mentally scarred for life, love is war / And some chicks are just too hard to wife"
                                            },
                                            {
                                                "example_id": "4abef76b-810e-4191-a343-0b33e38c8866",
                                                "sense_id": "3c25b406-3e38-3eba-906c-420416c01c4b",
                                                "text": "Mecca knew she wasn't lying. She had the type of beauty that made niggas want to wife her."
                                            },
                                            {
                                                "example_id": "d3c5ea27-b169-44a8-9866-e0c0f02a9600",
                                                "sense_id": "3c25b406-3e38-3eba-906c-420416c01c4b",
                                                "text": "I thought that I was going to wife her, but because of the new news with my brother I couldn't do it."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7e87e223-8346-464b-902e-812b72d4a734",
                        "source_entry_id": "d7b1671d-a780-3300-8beb-df9c959187e5",
                        "source_sense_id": "07cba75a-e5e3-358d-9d8a-fee322a68f9c",
                        "source_sense_description": "vrouw waarmee men samenleeft",
                        "target_lang_word": "spouse",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "spouse",
