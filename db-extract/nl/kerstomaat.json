                                    {
                                        "sense_id": "909eb149-63be-354e-aff6-b4f6e251a080",
                                        "entry_id": "8da06808-48f2-340b-9397-fcb76b5e33c2",
                                        "glosses": [
                                            "kleine, süßliche Tomatensorte"
                                        ],
