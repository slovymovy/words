                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                        "entry_id": "5ff641ab-81ca-395e-94dd-522236585031",
                                        "glosses": [
                                            "воен. оптический прибор для наблюдения из укрытия (окопов, блиндажей и др.), танков, подводных лодок и т. п."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "20da6eaf-2eb6-4b6c-afc1-5670eef99e99",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "На рейде, среди играющих дельфинов, появлялись перископы германских подводных лодок."
                                            },
                                            {
                                                "example_id": "fdf7fdbf-e65c-47bd-ae6f-3d28ee8a9f7a",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "Перископ виден; он торчит всё же из воды, и от него, как усы, в обе стороны расходятся от ходу тонкие волны."
                                            },
                                            {
                                                "example_id": "535916ea-0628-4402-b159-70bdf595343b",
                                                "sense_id": "7ac17660-c9cb-31d8-b411-04e254321e0f",
                                                "text": "В это время генерал Дрынов сидел в блиндаже под тремя накатами и следил за происходящим сквозь перископ."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ab45b9b-8ba7-3155-a2e9-f9fd6081f273",
                                        "entry_id": "5ff641ab-81ca-395e-94dd-522236585031",
                                        "glosses": [
                                            "фотогр. фотографический объектив, состоящий из двух выпукло-вогнутых линз, симметрично расположенных по отношению к плоскости помещённой между ними диафрагмы"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
