                "senses": [
                    {
                        "sense_id": "0a6165cf-caa5-3268-946d-54e22dcbc07d",
                        "entry_id": "6aedb32e-1542-3a88-bbd5-f0b624cb70f8",
                        "glosses": [
                            "kleines Tablett, zum Beispiel zum Servieren von Tee"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f84f3029-ab5c-44b0-a610-fd66542dbd36",
                                "sense_id": "0a6165cf-caa5-3268-946d-54e22dcbc07d",
                                "text": "„»Nun, denn, meinetwegen, ein Täßchen«, sagte Iwan Iwanowitsch und streckte die Hand nach dem Teebrett aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfe33363-a757-3a34-932e-56b40b9bcb4e",
                        "entry_id": "6aedb32e-1542-3a88-bbd5-f0b624cb70f8",
                        "glosses": [
                            "ein Teil, das bei einer japanischen Teezeremonie verwendet wird, ein Auffangbehälter mit Gitterrost darüber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de5212e4-c819-418b-a89c-9afbd0757a78",
                                "sense_id": "cfe33363-a757-3a34-932e-56b40b9bcb4e",
                                "text": "„Das Teebrett ist sozusagen die Basis der Teezeremonie, da alle weiteren Gegenstände auf dem Teebrett angeordnet werden und der Tee auf dem Brett zubereitet wird. Da bei Gong Fu cha der erste Aufguss nicht getrunken und ausgeschüttet wird, braucht es eine Auffangschale, welche das überschüssige Wasser auffängt. Im Bild ist sie in schwarz zu sehen, sie ist aus stabilem Plastik gefertigt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
