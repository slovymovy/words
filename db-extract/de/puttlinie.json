                "senses": [
                    {
                        "sense_id": "79553d29-b975-382d-931e-491ede509e49",
                        "entry_id": "6d0ff309-3020-3d73-b0dc-1ce9a0d35e07",
                        "glosses": [
                            "gedachte Bahn, auf der ein auf dem Grün liegender Ball ins Loch rollen soll"
                        ],
                        "tags": [
                            "Golf"
                        ],
                        "examples": [
                            {
                                "example_id": "869a058c-3398-4c12-a51b-d0e119f82409",
                                "sense_id": "79553d29-b975-382d-931e-491ede509e49",
                                "text": "„Spieler dürfen nicht in die Puttlinie des Mitspielers oder Gegners treten“."
                            },
                            {
                                "example_id": "a3092e10-1a75-43f7-af28-6503cd495eb5",
                                "sense_id": "79553d29-b975-382d-931e-491ede509e49",
                                "text": "„Die Visualisierung der Puttlinie, die Vorstellung von einem Putt, der todsicher ins Loch läuft, ist entscheidend.“"
                            },
                            {
                                "example_id": "9d7d8f51-6c80-493b-8b2a-2be6a2841af7",
                                "sense_id": "79553d29-b975-382d-931e-491ede509e49",
                                "text": "„In Santa Margerita di Pula habe ich mal eine Gottesanbeterin aus der Puttlinie gehoben, eine Glück bringende Heuschrecke. Vielleicht hätte ich sie sitzen lassen sollen. Der Ball eierte so eigentümlich, dass er sie ohnehin nicht getroffen hätte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
