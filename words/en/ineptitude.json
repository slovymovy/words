{
    "word_family": [
        "inept"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "29b5141f-0c03-3966-93a9-c684a2333057",
                    "sense_definition": "The quality or state of being inept or lacking skill.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "ineptness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The manager's <w>ineptitude</w> caused the entire project to fail.",
                            "target_lang_translations": {
                                "ru": "<w>Некомпетентность</w> менеджера привела к провалу всего проекта."
                            }
                        },
                        {
                            "text": "His <w>ineptitude</w> at handling the situation led to a public apology.",
                            "target_lang_translations": {
                                "ru": "Его <w>неумелость</w> в разрешении этой ситуации привела к публичным извинениям."
                            }
                        }
                    ],
                    "synonyms": [
                        "incompetence",
                        "ineptness"
                    ],
                    "common_phrases": [
                        "sheer ineptitude",
                        "total ineptitude"
                    ],
                    "target_lang_definitions": {
                        "ru": "Качество или состояние неумелости, отсутствие навыков или способностей."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "неспособность",
                                "target_lang_sense_clarification": "отсутствие умения или возможности что-либо сделать"
                            },
                            {
                                "target_lang_word": "неумелость",
                                "target_lang_sense_clarification": "отсутствие навыков или мастерства"
                            },
                            {
                                "target_lang_word": "некомпетентность",
                                "target_lang_sense_clarification": "отсутствие знаний или квалификации для выполнения задачи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a2d8daf-6fe8-3096-9fc0-70782ceea190",
                    "sense_definition": "A specific act or instance of being inept.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "ineptness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The report listed several <w>ineptitudes</w> committed by the staff during the crisis.",
                            "target_lang_translations": {
                                "ru": "В отчете был перечислен ряд <w>неумелых действий</w>, совершенных персоналом во время кризиса."
                            }
                        },
                        {
                            "text": "He was fired for his repeated <w>ineptitudes</w> in the workplace.",
                            "target_lang_translations": {
                                "ru": "Его уволили за неоднократные <w>промахи</w> на рабочем месте."
                            }
                        }
                    ],
                    "synonyms": [
                        "incompetence",
                        "ineptness"
                    ],
                    "target_lang_definitions": {
                        "ru": "Конкретный случай или проявление неумелости или ошибки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "промах",
                                "target_lang_sense_clarification": "конкретная ошибка или неудача"
                            },
                            {
                                "target_lang_word": "неумелое действие",
                                "target_lang_sense_clarification": "конкретный поступок, свидетельствующий о некомпетентности"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}