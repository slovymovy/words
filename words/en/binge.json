                {
                    "sense_id": "107c607c-c324-3116-ac33-f6d48fbc58a8",
                    "sense_definition": "A short period of excessive and often uncontrolled consumption of food, alcohol, or drugs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "excessive consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor warned him that a sugar <w>binge</w> could be very dangerous for his health condition.",
                            "target_lang_translations": {
                                "ru": "Врач предупредил его, что сахарное <w>обжорство</w> может быть очень опасным для его здоровья.",
                                "zh": "医生警告他，<w>暴饮暴食</w>糖分可能会对他的健康状况造成严重危害。"
                            }
                        },
                        {
                            "text": "He felt terrible the next morning after his eating <w>binge</w> at the holiday party.",
                            "target_lang_translations": {
                                "ru": "На следующее утро он чувствовал себя ужасно после <w>переедания</w> на праздничной вечеринке.",
                                "zh": "在节日派对上<w>暴饮暴食</w>后，他第二天早上感觉糟透了。"
                            }
                        }
                    ],
                    "synonyms": [
