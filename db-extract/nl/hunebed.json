                                            "Dativ Plural des Substantivs Dolm"
                                        ],
                                        "tags": [
                                            "dative",
                                            "form-of",
                                            "plural"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1676e282-bc6c-4d85-befa-cd22438481e8",
                        "source_entry_id": "910a9b49-cf9e-3223-9986-50d5e95cb231",
                        "source_sense_id": "b99501fe-8de1-3595-b9ed-a514a915611b",
                        "source_sense_description": "neolithische begraafplaats",
                        "target_lang_word": "Großsteingrab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Großsteingrab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "433385f9-4221-3145-9891-eb67e9d83604",
                                        "entry_id": "1a031c63-3583-3121-a366-8a0630bbd817",
                                        "glosses": [
                                            "Grab aus der Jungsteinzeit, das aus großen Steinen besteht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "967e04f7-88c4-4a66-bea5-5a8355aabf33",
                                                "sense_id": "433385f9-4221-3145-9891-eb67e9d83604",
                                                "text": "„Während Urnenfunde und ein auf 4000 v. Chr. datiertes Großsteingrab eine lange Siedlungsgeschichte des Landstrichs belegen, ist die Stadt Cuxhaven im Vergleich zu anderen Städten Deutschlands noch relativ jung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e77958c3-c819-4581-926a-fd8322066788",
                        "source_entry_id": "910a9b49-cf9e-3223-9986-50d5e95cb231",
                        "source_sense_id": "b99501fe-8de1-3595-b9ed-a514a915611b",
                        "source_sense_description": "neolithische begraafplaats",
                        "target_lang_word": "Hünengrab",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hünengrab",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1002bd68-38f5-36ba-aed3-86a636821ca0",
                                        "entry_id": "4d2d7d3a-5545-3c21-ad57-243402283252",
                                        "glosses": [
                                            "Grabanlage aus der Vorgeschichte, die aus großen, unbehauenen Steinen besteht und zumeist mit einem Erdhügel bedeckt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3e7654-3273-4ff6-a77f-c1442751554a",
                                                "sense_id": "1002bd68-38f5-36ba-aed3-86a636821ca0",
                                                "text": "„Daher pflegte man auch, wenn der Mann ſtarb, ſein Lieblingspferd zu ſchlachten, und mit ihm in die Erde zu legen. Davon iſt es gekommen, daß man ſonſt wohl, wenn man in den alten heidniſchen Graͤbern uͤbermenſchlich große Knochen fand, glaubte, daß da Rieſen begraben laͤgen, und ein ſolches Grab ein Rieſen- oder Huͤnengrab nannte, deren es noch viele, beſonders im noͤrdlichen Deutſchland, giebt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2074cfa1-e09c-490d-a080-0dc495e666cb",
