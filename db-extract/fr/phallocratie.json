                                                "example_id": "9353434f-eded-4322-960e-f12ea2c668b0",
                                                "sense_id": "3d1f15e2-91cb-3fbc-9b96-090560601f77",
                                                "text": "„Seine Skepsis und Kritik an der Androkratie ließen seine Emanzipationsschrift weiter in Vergessenheit geraten.“"
                                            },
                                            {
                                                "example_id": "833781c9-ea03-40af-8f70-71bbee8425e8",
                                                "sense_id": "3d1f15e2-91cb-3fbc-9b96-090560601f77",
                                                "text": "Halten Sie die Bezeichnung „Androkratie“ für die Bundesrepublik Deutschland für angemessen?"
                                            }
