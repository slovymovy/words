                ],
                "senses": [
                    {
                        "sense_id": "f3b5cefc-85a5-3ade-8b8f-3564a09fea76",
                        "entry_id": "6b728618-31b1-3f01-b951-315dd37bc0f3",
                        "glosses": [
                            "Donner à quelque chose des caractéristiques qui rappellent Athènes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "992b3f24-3d51-457a-ae66-2e0074ac8b68",
                                "sense_id": "f3b5cefc-85a5-3ade-8b8f-3564a09fea76",
                                "text": "Cela ne veut pas dire américaniser le monde, mais l’athéniser."
                            },
                            {
                                "example_id": "0d9acda7-d857-4612-bb72-550904a25c27",
                                "sense_id": "f3b5cefc-85a5-3ade-8b8f-3564a09fea76",
                                "text": "En quoi l’oraison funèbre permet-elle d’athéniser l’Argos dramatique ?"
                            },
                            {
                                "example_id": "b3527206-8a2d-4a48-9a77-9aee35545b9b",
                                "sense_id": "f3b5cefc-85a5-3ade-8b8f-3564a09fea76",
                                "text": "Et le précédent pourrait soumettre certains à la tentation de s’athéniser, ce qui serait alors la porte ouverte à la chienlit généralisée."
                            }
                        ]
                    }
                ],
