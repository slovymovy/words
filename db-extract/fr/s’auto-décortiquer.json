                                "example_id": "8b64b6e4-8172-4321-95f2-9b988d9df92f",
                                "sense_id": "175a0a57-4555-3f41-8cda-ea6138ea7686",
                                "text": "Tu vois, on finit même par s'auto-décortiquer dis-donc !"
