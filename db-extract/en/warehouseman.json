                    {
                        "translation_id": "f6d33ea0-83e1-4aa4-a58a-8f46b94fc777",
                        "source_entry_id": "84659d98-5008-329f-a373-5c915ec7a6fb",
                        "source_sense_description": "person who manages or works in a warehouse",
                        "target_lang_word": "Lagerist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lagerist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                        "entry_id": "22fda4de-489b-325e-a536-fb6558e73941",
                                        "glosses": [
                                            "Dienstnehmer, der ein Warenlager verwaltet (Annahme, Einladen, Umladen, Ausladen sowie Versand von Waren)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "018bdf6f-ae17-4e40-9416-23dc1713ffe9",
                                                "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                                "text": "Der Lagerist ist mit den wichtigsten Lagersystemen vertraut, weiss mit Elektrofahrzeugen, Hub- und Gabelstaplern umzugehen und kann computergesteuerte Förder- und Transportanlagen fachmännisch bedienen."
                                            },
                                            {
                                                "example_id": "0c190774-9fac-4435-b7c4-8b5ee116df15",
                                                "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                                "text": "Vom zukünftigen Lageristen wird ein ausgeprägter Ordnungssinn und organisatorische Fähigkeiten erwartet."
                                            },
                                            {
                                                "example_id": "88eb0a1f-5bf6-4df8-b2fa-7c59286536c5",
                                                "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                                "text": "Schächter ist das fünfte von sechs Kindern, sein Vater arbeitete als Lagerist in einer Schuhfabrik."
                                            },
                                            {
                                                "example_id": "514e1d18-4813-4936-a6da-268d4439b71c",
                                                "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                                "text": "Und auch bei neuen Ersatzteilen muss das Kopfschütteln des Lageristen nicht das Aus für die Reparatur bedeuten."
                                            },
                                            {
                                                "example_id": "cddd6d6d-3e4f-4aff-bf79-06e7f1253067",
                                                "sense_id": "ad36206f-5393-3ec7-aa7e-3926dcfd59d5",
                                                "text": "Wie sensationell, das wird erst klar, wenn man weiß: Der Lagerist aus der Steiermark hatte mit 18 Jahren einen Starkstromunfall, in dessen Folge beide Arme amputiert werden mussten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
