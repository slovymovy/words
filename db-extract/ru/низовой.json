                                "example_id": "5f15b34d-8b30-45ca-bd36-7975bed29bb8",
                                "sense_id": "5ef9e49f-2f5f-3ddb-83a1-92c4fb8c8cc8",
                                "text": "Низовой хлеб."
                            }
