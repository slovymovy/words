{
    "word_family": [
        "ход",
        "ходить",
        "расход",
        "расходный",
        "расходиться"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e464c978-66b4-3c5a-9b13-e07b1cc82c70",
                    "sense_definition": "Уйти в разные стороны, покинуть место сбора.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "После окончания лекции студенты быстро <w>разошлись</w> по домам.",
                            "target_lang_translations": {
                                "en": "After the lecture ended, the students quickly <w>dispersed</w> to their homes."
                            }
                        },
                        {
                            "text": "Гости <w>разошлись</w> поздно ночью, когда праздник закончился.",
                            "target_lang_translations": {
                                "en": "The guests <w>left</w> late at night when the party was over."
                            }
                        }
                    ],
                    "synonyms": [
                        "рассредоточиться"
                    ],
                    "antonyms": [
                        "сойтись"
                    ],
                    "common_phrases": [
                        "разойтись по домам"
                    ],
                    "target_lang_definitions": {
                        "en": "To leave a place in different directions; to disperse."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "disperse",
                                "target_lang_sense_clarification": "to scatter or move away in different directions"
                            },
                            {
                                "target_lang_word": "go home",
                                "target_lang_sense_clarification": "specifically used when people leave a gathering to return to their homes"
                            },
                            {
                                "target_lang_word": "break up",
                                "target_lang_sense_clarification": "to end a meeting or gathering"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4359727b-c044-3c2a-96fc-e27699a8c190",
                    "sense_definition": "Перестать жить вместе, официально расторгнуть брак.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "relationships",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Они прожили вместе пять лет, но в итоге <w>разошлись</w>.",
                            "target_lang_translations": {
                                "en": "They lived together for five years, but eventually <w>broke up</w>."
                            }
                        },
                        {
                            "text": "После того как супруги <w>разошлись</w>, они остались хорошими друзьями.",
                            "target_lang_translations": {
                                "en": "After the spouses <w>separated</w>, they remained good friends."
                            }
                        }
                    ],
                    "synonyms": [
                        "развестись",
                        "расстаться"
                    ],
                    "target_lang_definitions": {
                        "en": "To stop living together or to end a romantic relationship or marriage."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "break up",
                                "target_lang_sense_clarification": "to end a romantic relationship"
                            },
                            {
                                "target_lang_word": "separate",
                                "target_lang_sense_clarification": "to stop living together as a couple"
                            },
                            {
                                "target_lang_word": "divorce",
                                "target_lang_sense_clarification": "to legally end a marriage"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f4782c6d-f656-329f-ba10-14c41e913bfe",
                    "sense_definition": "Иметь разные мнения или взгляды на что-либо.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "opinions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В этом вопросе наши мнения <w>разошлись</w>.",
                            "target_lang_translations": {
                                "en": "On this issue, our opinions <w>differed</w>."
                            }
                        },
                        {
                            "text": "Коллеги <w>разошлись</w> во взглядах на стратегию развития компании.",
                            "target_lang_translations": {
                                "en": "The colleagues <w>disagreed</w> on the company's development strategy."
                            }
                        }
                    ],
                    "common_phrases": [
                        "мнения разошлись"
                    ],
                    "target_lang_definitions": {
                        "en": "To have different opinions or views on a subject."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "differ",
                                "target_lang_sense_clarification": "to have a different opinion"
                            },
                            {
                                "target_lang_word": "disagree",
                                "target_lang_sense_clarification": "to have a different view or opinion"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "066126d2-0e98-397e-815c-e1f8599fe79e",
                    "sense_definition": "Перестать быть видимым, рассеяться (о тумане, облаках).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "weather",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "К полудню густой туман наконец <w>разошёлся</w>.",
                            "target_lang_translations": {
                                "en": "By noon, the thick fog finally <w>cleared</w>."
                            }
                        },
                        {
                            "text": "Солнце выглянуло, когда облака <w>разошлись</w> над горами.",
                            "target_lang_translations": {
                                "en": "The sun came out when the clouds <w>dissipated</w> over the mountains."
                            }
                        }
                    ],
                    "synonyms": [
                        "рассеяться"
                    ],
                    "target_lang_definitions": {
                        "en": "To cease to be visible; to clear or dissipate (of fog or clouds)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "clear",
                                "target_lang_sense_clarification": "to become free of clouds or fog"
                            },
                            {
                                "target_lang_word": "dissipate",
                                "target_lang_sense_clarification": "to gradually disappear or scatter"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}