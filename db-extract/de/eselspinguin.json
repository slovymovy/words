                "senses": [
                    {
                        "sense_id": "9a08f9df-74ce-31b1-b514-a3c3c833a0e9",
                        "entry_id": "f7a03f42-15ee-36a6-a746-72eaa21fb881",
                        "glosses": [
                            "in der Antarktis heimische Pinguinart der Gattung der Langschwanzpinguine, die eine Körperhöhe von bis zu 80 cm erreicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2f1450e-ca18-4920-985e-25f6f06024be",
                                "sense_id": "9a08f9df-74ce-31b1-b514-a3c3c833a0e9",
                                "text": "Der Eselspinguin ist sehr scheu."
                            },
                            {
                                "example_id": "a7d22a71-1bfa-4205-8806-5635559c2194",
                                "sense_id": "9a08f9df-74ce-31b1-b514-a3c3c833a0e9",
                                "text": "„Eselpinguine gelten als die buntesten Pinguine der Gattung Pygoscelis, da sich verschiedenste Farbtöne zu einer typischen schwarz - weißen Pinguinfärbung zusammensetzen.“"
                            },
                            {
                                "example_id": "c4ca64ca-86b8-4202-beff-bea486f21211",
                                "sense_id": "9a08f9df-74ce-31b1-b514-a3c3c833a0e9",
                                "text": "„Eselspinguine (Pygoscelis papua) werden im Aquazoo Düsseldorf bereits seit 1987 in einem \"Indoor\"-Gehege gepflegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
