{
    "word_family": [
        "petrify",
        "petrification"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "87113368-f39d-301c-9771-34b4b87b29cc",
                    "sense_definition": "Extremely frightened or terrified, often to the point of being unable to move or act.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was absolutely <w>petrified</w> of spiders and refused to enter the basement.",
                            "target_lang_translations": {
                                "tr": "Örümceklerden kesinlikle <w>ölesiye korkuyordu</w> ve bodruma girmeyi reddetti."
                            }
                        },
                        {
                            "text": "The little boy stood completely <w>petrified</w> with fear when the loud thunder struck.",
                            "target_lang_translations": {
                                "tr": "Şiddetli gök gürültüsü patladığında küçük çocuk korkudan tamamen <w>donakalmıştı</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "afraid"
                    ],
                    "common_phrases": [
                        "petrified of",
                        "petrified with fear",
                        "absolutely petrified"
                    ],
                    "target_lang_definitions": {
                        "tr": "Genellikle hareket edemeyecek veya tepki veremeyecek derecede aşırı derecede korkmuş, dehşete düşmüş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "donakalmış",
                                "target_lang_sense_clarification": "korkudan kaskatı kesilmiş"
                            },
                            {
                                "target_lang_word": "ödü kopmuş",
                                "target_lang_sense_clarification": "aşırı korkmuş"
                            },
                            {
                                "target_lang_word": "taş kesilmiş",
                                "target_lang_sense_clarification": "dehşetten hareket edemeyen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ba436a61-22f0-3c13-a115-94ba6f94e1bf",
                    "sense_definition": "Changed into a stony substance through mineralization; turned to stone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We hiked through the national park to see the ancient <w>petrified</w> wood.",
                            "target_lang_translations": {
                                "tr": "Kadim <w>taşlaşmış</w> odunları görmek için milli park boyunca yürüdük."
                            }
                        },
                        {
                            "text": "The museum displayed a remarkably preserved <w>petrified</w> tree trunk from the prehistoric era.",
                            "target_lang_translations": {
                                "tr": "Müze, tarih öncesi çağdan kalma olağanüstü derecede iyi korunmuş <w>taşlaşmış</w> bir ağaç gövdesini sergiledi."
                            }
                        }
                    ],
                    "common_phrases": [
                        "petrified wood",
                        "petrified forest"
                    ],
                    "target_lang_definitions": {
                        "tr": "Mineralleşme yoluyla taşlaşmış, taşa dönüşmüş."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "taşlaşmış",
                                "target_lang_sense_clarification": "minerallerle taşa dönüşmüş"
                            },
                            {
                                "target_lang_word": "fosilleşmiş",
                                "target_lang_sense_clarification": "taş halini almış"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f5617000-462b-3292-833c-220a0a798f93",
                    "sense_definition": "Simple past and past participle of <w>petrify</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sudden noise in the darkness <w>petrified</w> the young campers.",
                            "target_lang_translations": {
                                "tr": "Karanlıktaki ani ses genç kampçıların <w>ödünü patlattı</w>."
                            }
                        },
                        {
                            "text": "Millennia of intense mineral pressure had slowly <w>petrified</w> the ancient fallen logs.",
                            "target_lang_translations": {
                                "tr": "Binlerce yıllık yoğun mineral basıncı, devrilmiş kadim kütükleri yavaş yavaş <w>taşlaştırmıştı</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "tr": "'Petrify' fiilinin geçmiş zaman ve geçmiş zaman sıfat-fiil biçimi; korkutmak ya da taşlaştırmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "taş kesilmek",
                                "target_lang_sense_clarification": "korkudan hareket edemez hale gelmek"
                            },
                            {
                                "target_lang_word": "ödünü patlatmak",
                                "target_lang_sense_clarification": "birini aşırı derecede korkutmak"
                            },
                            {
                                "target_lang_word": "taşlaştırmak",
                                "target_lang_sense_clarification": "taşa dönüştürmek"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}