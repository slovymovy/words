                ],
                "senses": [
                    {
                        "sense_id": "5aba0162-6302-3d1b-8754-d8360855d46a",
                        "entry_id": "ade1bb23-fb7c-3bff-8e94-ed19204e6e72",
                        "glosses": [
                            "Représentation de Cupidon, putto ailé armé d'un arc, chérubin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e036499f-2296-4a9f-9800-101c8d0c40cc",
                                "sense_id": "5aba0162-6302-3d1b-8754-d8360855d46a",
                                "text": "Ah! ces plafonds (…) Où Cupidon voltige avec sa cupidonne."
                            },
                            {
                                "example_id": "43a5a3bc-baaa-4868-a4ef-24dd369851b1",
                                "sense_id": "5aba0162-6302-3d1b-8754-d8360855d46a",
                                "text": "Une féerie avec une confusion de chérubins et de cupidons au-dessus de la tête des mariés."
                            },
                            {
                                "example_id": "b031730f-ade6-4172-b3e9-9b1aaa98019d",
                                "sense_id": "5aba0162-6302-3d1b-8754-d8360855d46a",
                                "text": "La légende la plus répandue prétend que le cuberdon, ou neuzeke (« petit nez ») en néerlandais, a été créé par un membre du clergé vivant dans la région de Bruges, d’où ses autres noms de « bonnet de curé » et « boudenne de nonnette », mais aussi « cupidon »."
                            }
                        ]
                    },
                    {
                        "sense_id": "22d94bd0-e807-3e6f-8494-6e0c316e49bd",
                        "entry_id": "ade1bb23-fb7c-3bff-8e94-ed19204e6e72",
                        "glosses": [
                            "Symbole de désir, d'amour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0047586a-c2d2-4e48-b9b6-a0e37ab859af",
                                "sense_id": "22d94bd0-e807-3e6f-8494-6e0c316e49bd",
                                "text": "L'Amour aussi est charmant [dans le tableau de Gérard], et ses grandes ailes d'épervier lui ôtent l'air poupin d'un Cupidon de boudoir."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bb1adff-882c-31a5-84d3-b4be915208e1",
                        "entry_id": "ade1bb23-fb7c-3bff-8e94-ed19204e6e72",
                        "glosses": [
                            "Enfant ou adolescent d'une grande beauté, amour."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50933a71-4504-4633-b51b-36f134c1d764",
                                "sense_id": "7bb1adff-882c-31a5-84d3-b4be915208e1",
                                "text": "Un petit qui était un chérubin de gentillesse, et qui jouait les cupidons."
                            },
                            {
                                "example_id": "72d43e46-4ac5-4368-bd83-56d9396fb447",
                                "sense_id": "7bb1adff-882c-31a5-84d3-b4be915208e1",
                                "text": "Ce hurlement ne me fit point désempoigner mes cupidons voués à la noyade, tout juste s’il me fit réagir."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d9823b3-99bd-3aec-8d58-28a13f6ac9ed",
                        "entry_id": "ade1bb23-fb7c-3bff-8e94-ed19204e6e72",
                        "glosses": [
                            "Bellâtre de tout âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "51c7aa2f-d796-4972-a270-050caa4edbae",
                                "sense_id": "3d9823b3-99bd-3aec-8d58-28a13f6ac9ed",
                                "text": "Trois douzaines de cupidons\nQu'une actrice a mis sur la paille."
                            }
                        ]
                    },
                    {
                        "sense_id": "5d89ab66-91ac-3a65-adc3-402072fcc315",
                        "entry_id": "ade1bb23-fb7c-3bff-8e94-ed19204e6e72",
                        "glosses": [
                            "Chiffonnier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07d9d398-7b33-4135-86e7-40fa5872c57b",
                                "sense_id": "5d89ab66-91ac-3a65-adc3-402072fcc315",
                                "text": "Un de ces Cupidons à carquois d'osier."
                            }
                        ]
                    }
                ],
