                            }
                        },
                        {
                            "text": "I decided to read <w>ahead</w> to see what happens next.",
                            "target_lang_translations": {
                                "ru": "Я решил прочитать <w>наперёд</w>, чтобы узнать, что будет дальше.",
                                "pl": "Postanowiłem poczytać trochę <w>naprzód</w>, żeby zobaczyć, co wydarzy się dalej.",
                                "tr": "Sonra ne olacağını görmek için <w>önceden</w> okumaya karar verdim.",
                                "zh": "我决定<w>预先</w>阅读，看看接下来会发生什么。"
                            }
