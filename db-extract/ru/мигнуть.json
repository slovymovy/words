                                "sense_id": "37f682bd-29e9-3de9-85e2-0ad150d6f7f3",
                                "text": "мигну́ть кому́-либо",
                                "translation": "to wink at someone; blink an eye at someone",
                                "english": "to wink at someone; blink an eye at someone"
                            },
                            {
