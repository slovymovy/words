                        "très content",
                        "bien content",
                        "pas content",
                        "content de soi"
                    ]
                },
                {
                    "sense_id": "2cef4cc5-1204-37dd-976f-f327c635ceac",
                    "sense_definition": "Qui ne désire rien de plus ni de mieux et se satisfait de ce qu'il a.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "satisfaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père est <w>content</w> de peu : un bon repas et un livre lui suffisent."
                        },
                        {
                            "text": "Elle est <w>contente</w> de sa condition et ne cherche pas à gagner plus d'argent."
                        }
                    ],
                    "synonyms": [
