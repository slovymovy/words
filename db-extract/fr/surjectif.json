                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "surjective",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "20a80b94-e8bc-3f66-b197-28e4851de92d",
                                        "entry_id": "2d531d26-1ff0-3e29-a185-3a4f7a977761",
                                        "glosses": [
                                            "Of, relating to, or being a surjection."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af0b2a96-c7f8-49ae-afd7-d36ce96adaff",
                                                "sense_id": "20a80b94-e8bc-3f66-b197-28e4851de92d",
                                                "text": "1974, Thomas W. Hungerford, Algebra, Springer, page 5,\nA function f is surjective (or onto) provided f(A)=B; in other words,\nfor each b∈B,b=f(a) for some a∈A.\nA function f is said to be bijective (or a bijection or a one-to-one correspondence) if it is both injective and surjective."
                                            },
                                            {
                                                "example_id": "8a893f67-83be-43b3-a38c-9b74b6da48b8",
                                                "sense_id": "20a80b94-e8bc-3f66-b197-28e4851de92d",
                                                "text": "The Garden of Eden Theorem (Theorem 5.3.1) implies that every surjective cellular automaton with finite alphabet over an amenable group is necessarily pre-injective. In this section, we give an example of a surjective but not pre-injective cellular automaton with finite alphabet over the free group #92;textstyleF#95;2."
                                            },
                                            {
                                                "example_id": "8aab9ed4-54a7-4178-8f10-57666642c5c2",
                                                "sense_id": "20a80b94-e8bc-3f66-b197-28e4851de92d",
                                                "text": "This function is surjective and injective, and hence bijective."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
