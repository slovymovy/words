                "senses": [
                    {
                        "sense_id": "18926b55-9955-3697-9c7c-f0caf8aba72b",
                        "entry_id": "8455447d-4d36-3d31-a814-dcbad672c255",
                        "glosses": [
                            "weibliche Person, die sich wissenschaftlich mit der Geschichte der Literatur beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1fb8008-c3e1-400e-8d8e-c9278074630c",
                                "sense_id": "18926b55-9955-3697-9c7c-f0caf8aba72b",
                                "text": "„Die Schriftstellerin, die Literarhistorikerin und Geschichtenerzählerin Sigrid Damm, das zeigt dieses Buch, ist eine Liebende.“"
                            },
                            {
                                "example_id": "6103f63b-c9f6-4de9-85ee-992a505de9b7",
                                "sense_id": "18926b55-9955-3697-9c7c-f0caf8aba72b",
                                "text": "„Daß Renée Lang an die Originale der Briefe sowie an die Frage-und-Antwort -Schreiben der Herzogin herankam und von Rilkes Briefpartnerin die Publikationserlaubnis erlangte, verdankte sie dem Eingreifen ihrer italienischen Fachkollegin Lavinia Mazzucchetti, einer auf Rilke spezialisierten Literarhistorikerin und langjährigen Freundin der Herzogin Gallarati Scotti.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
