                        "source_sense_id": "03114f1c-bb2c-3b67-88a9-e28075731860",
                        "target_lang_word": "studio",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "studio",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An artist’s or photographer’s workshop or the room in which an artist works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae716b34-e328-4b2e-8954-92a5d5f7bccd",
                                                "sense_id": "07e7afdc-49f9-3e56-8de9-9ae3ee988a5e",
                                                "text": "His studio was cramped when he began as an artist."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "An establishment where an art is taught."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a61d982f-0191-49a0-97f0-617506bdb573",
                                                "sense_id": "9cbb2e01-85c1-317c-9f52-09b116226f89",
                                                "text": "As he gained a reputation, he took larger space and took students into his studio,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A place where radio or television programs, records or films are made."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64bf6f4f-6370-421d-b18b-4596593ee1a4",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The recording studio had some slight echo, but was good enough to make a demo."
                                            },
                                            {
                                                "example_id": "631d0afd-713c-4ff6-a1a7-dfbf20daea60",
                                                "sense_id": "82ca99f4-1ed9-3a6a-915b-3f727b716b96",
                                                "text": "The studio was dark and cool, with thick cords running from one end to the other and huge cameras on either side, each primed to swivel and record what the lights from above illuminated."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A company or organization that makes films, records or other artistic works."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d4507543-b4af-4928-bb57-a20c876f2a56",
                                                "sense_id": "0577c3be-8d75-39d5-ae2c-c39c28fc1306",
                                                "text": "The studios still make films, but they rely on the strength of their distribution."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                        "entry_id": "3122c50a-4211-3297-a026-e7ee3e9dca45",
                                        "glosses": [
                                            "A studio apartment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee61de42-7a79-45d1-8bbd-09699b5af2e1",
                                                "sense_id": "6753a559-9530-3f83-a2cf-0cf47c3c60e9",
                                                "text": "It’s a lovely little studio with almost a river view."
                                            }
                                        ]
                                    }
                                ]
