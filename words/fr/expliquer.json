{
    "word_family": [
        "explication",
        "explicatif",
        "explicable",
        "inexplicable",
        "expliciter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2c837545-4bf7-3a1f-9ffc-48d0cf134c77",
                    "sense_definition": "Rendre une chose claire et compréhensible en fournissant des détails ou des explications.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le professeur <w>explique</w> la nouvelle règle de grammaire aux élèves."
                        },
                        {
                            "text": "Pouvez-vous m'<w>expliquer</w> comment fonctionne cet appareil dans le bureau ?"
                        }
                    ],
                    "synonyms": [
                        "éclaircir",
                        "élucider"
                    ],
                    "antonyms": [
                        "embrouiller",
                        "obscurcir"
                    ],
                    "common_phrases": [
                        "expliquer en détail",
                        "expliquer la situation",
                        "expliquer la règle"
                    ]
                },
                {
                    "sense_id": "f6efd848-ab76-3ae3-9a46-e5e5f3512312",
                    "sense_definition": "Constituer la cause, le motif ou la justification d'un fait.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La fatigue accumulée <w>explique</w> son manque de concentration ce matin."
                        },
                        {
                            "text": "Son retard à la réunion s'<w>explique</w> par des embouteillages imprévus."
                        }
                    ],
                    "synonyms": [
                        "justifier",
                        "motiver"
                    ],
                    "common_phrases": [
                        "expliquer le succès",
                        "s'expliquer par"
                    ]
                },
                {
                    "sense_id": "cdfe839c-05f6-3780-a9ab-05272713a451",
                    "sense_definition": "Faire connaître nettement sa pensée, formuler ses intentions ou régler un désaccord.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Laissez-le <w>expliquer</w> son point de vue avant de porter un jugement."
                        },
                        {
                            "text": "Il a demandé un rendez-vous pour s'<w>expliquer</w> directement avec son directeur."
                        }
                    ],
                    "synonyms": [
                        "préciser",
                        "exprimer"
                    ],
                    "common_phrases": [
                        "expliquer son point de vue",
                        "s'expliquer avec quelqu'un"
                    ]
                },
                {
                    "sense_id": "3d4620c8-4ec0-31b3-bd2d-1ae7404068b4",
                    "sense_definition": "Commenter, analyser ou interpréter oralement un texte ou la pensée d'un auteur.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les étudiants de lettres doivent <w>expliquer</w> ce passage difficile de Platon."
                        },
                        {
                            "text": "Le professeur a passé deux heures à <w>expliquer</w> ce long poème médiéval."
                        }
                    ],
                    "synonyms": [
                        "commenter",
                        "interpréter"
                    ],
                    "common_phrases": [
                        "expliquer un texte"
                    ]
                }
            ]
        }
    ]
}