                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19aa4743-50f5-44e3-9239-e3f87b87f710",
                                "sense_id": "56145a4f-83ea-32d0-9e37-595598250ae8",
                                "text": "Проблемы соотношения формы и функции в истории органического мира, экогении, прогресса в истории органического мира, вымирания организмов с дарвинистских позиций осветил Л. Ш. Давиташвили."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "939972ab-6b85-4cfe-83e5-17af8e71a735",
                        "source_entry_id": "779317f8-c56b-36ee-bc1f-a4e6887bfd71",
                        "source_sense_id": "56145a4f-83ea-32d0-9e37-595598250ae8",
                        "target_lang_word": "dying out",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dying out",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "af981a47-7407-39a1-b1f8-1dc738884149",
                                        "entry_id": "8d033efc-cc1b-3c93-a20f-c4ca18aca923",
