                    {
                        "sense_id": "75bb6a5b-3c82-33cd-84a0-98f2e371446d",
                        "entry_id": "265747b1-3ae4-3b2a-a8a5-048f85a25a36",
                        "glosses": [
                            "Dispositif destiné à transformer un courant alternatif en courant continu."
