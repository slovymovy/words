        "fr-extract.jsonl": [
            {
                "entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                "word": "dévaluation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e25245e3-7021-4c5e-bcac-e9ed25d4f2a7",
                        "entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                        "tags": [
                            "plural"
                        ],
                        "form": "dévaluations"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f444994c-a738-35cb-9f39-9e4b2512d5a2",
                        "entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                        "glosses": [
                            "Baisse intentionnelle ou délibérée de la valeur officielle de la monnaie d’un pays par rapport à la monnaie d’un autre pays ou d’une valeur de référence, comme par exemple celle de l’or."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dc98f4fc-94e4-460b-be87-872bbb23ee5d",
                                "sense_id": "f444994c-a738-35cb-9f39-9e4b2512d5a2",
                                "text": "À la fin d’avril […], le Président fit venir à la Maison Blanche les « garçons de la presse » et annonça à des correspondants enthousiasmés par l’importance des nouvelles à transmettre qu’il allait abandonner l’étalon-or et mettre le cap sur la dévaluation du dollar."
                            },
                            {
                                "example_id": "9d893dff-3058-4e90-b015-3f349cbb08bc",
                                "sense_id": "f444994c-a738-35cb-9f39-9e4b2512d5a2",
                                "text": "Les différentes dévaluations, dont la dernière en vigueur datait du 8 juin 1306, étaient loin de lui avoir rapporté ce qu’il en avait espéré."
                            },
                            {
                                "example_id": "c846b3a1-7ca3-430e-b97b-5286fd72d46a",
                                "sense_id": "f444994c-a738-35cb-9f39-9e4b2512d5a2",
                                "text": "En 1921, un triumvirat dirigé par le général José Maria Orellana (1921-1926) renversa Herrera. Orellana entreprit de renégocier avec l'entreprise d'électricité Bond & Share ; il créa le quetzal comme monnaie en parité avec le dollar, ce qui était une dévaluation de fait, au bénéfice des producteurs de café."
                            }
                        ]
                    },
                    {
                        "sense_id": "11992048-4c79-345e-8f8c-adeb8e0166a3",
                        "entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                        "glosses": [
                            "Diminution de la valeur d’un objet."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "a00564e6-ff3e-3ddc-af89-41ed784cb081",
                        "entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                        "glosses": [
                            "Dépréciation."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e24fe00-6658-495b-96a9-9f45a881b2bb",
                        "source_entry_id": "bab11287-03e9-3f53-a5b7-8cc0ee9f22ec",
                        "target_lang_word": "Abwertung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abwertung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Verringerung des Wertes einer Währung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "510a7eef-c497-4add-ac27-e5236e4deab8",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "Die folgende Abwertung bewirkte, daß die Währungen in der ganzen Region mit nach unten gezogen wurden."
                                            },
                                            {
                                                "example_id": "b5eba18b-0d2c-4137-8c3a-445a7ccb74af",
                                                "sense_id": "176837b2-4c40-3768-ac9a-29e04ac8187e",
                                                "text": "„Die ING Groep hat ihre Kursprognose zum zweiten Mal innerhalb weniger Tage gesenkt und geht von einem künftigen Kurs von 7 Yuan für den Dollar aus da die Zentralbank den Marktkräften erlaube, die Geschwindigkeit der Abwertung zu bestimmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                        "entry_id": "f0372139-490e-3e27-8e6a-30d7068aed81",
                                        "glosses": [
                                            "Absprechung von Wert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f43ef25b-1964-4259-8454-189ba9324fa8",
                                                "sense_id": "1867910b-16ef-3379-8630-26b678afaf2f",
                                                "text": "Glaubt man, solche gefunden zu haben, dann greifen die feinen Mechanismen von Ausgrenzung, Abwertung, Diffamierung wie eh und je, wenn auch heute wohl nicht mehr so stark mit existenzgefährdenden Folgen wie in der Adenauerzeit."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "151f38d2-520f-4784-bfc1-53db47ceb784",
