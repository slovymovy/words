    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6cb3985e-e823-3d3a-82fb-18f7e117a8d8",
                    "sense_definition": "Occurring, appearing, or done every day or every weekday.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "frequency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He follows a strict <w>daily</w> routine to stay productive throughout the week.",
                            "target_lang_translations": {
                                "ru": "Он соблюдает строгий <w>ежедневный</w> распорядок, чтобы оставаться продуктивным в течение всей недели.",
                                "zh": "他遵循严格的<w>日常</w>作息，以保持一周的高效。"
                            }
                        },
                        {
                            "text": "The <w>daily</w> newspaper arrives at our doorstep every morning before breakfast.",
                            "target_lang_translations": {
                                "ru": "<w>Ежедневная</w> газета появляется у нашего порога каждое утро перед завтраком.",
                                "zh": "<w>每日</w>的报纸每天早餐前都会送到我们家门口。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quotidian"
                    ],
                    "antonyms": [
                        "nightly"
                    ],
                    "common_phrases": [
                        "daily routine",
                        "daily life",
                        "daily basis",
                        "daily bread"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий, появляющийся или выполняемый каждый день или каждый будний день.",
                        "zh": "每天发生、出现或进行的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ежедневный",
                                "target_lang_sense_clarification": "происходящий каждый день"
                            },
                            {
                                "target_lang_word": "каждодневный",
                                "target_lang_sense_clarification": "повторяющийся изо дня в день"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "日常的",
                                "target_lang_sense_clarification": "形容词，指每天的"
                            },
                            {
                                "target_lang_word": "每日的",
                                "target_lang_sense_clarification": "形容词，指每一天的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70377466-f8fc-37a2-ba00-ae684f75f326",
                    "sense_definition": "Happening during the period of daylight rather than at night.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "time_of_day",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientists observed the <w>daily</w> habits of the birds during the sunlit hours.",
                            "target_lang_translations": {
                                "ru": "Ученые наблюдали за <w>дневными</w> привычками птиц в светлое время суток.",
                                "zh": "科学家们在阳光充足的时段观察了这些鸟类的<w>日间</w>习性。"
                            }
                        },
                        {
                            "text": "Certain flowers only open during their <w>daily</w> cycle when the sun is high.",
                            "target_lang_translations": {
                                "ru": "Некоторые цветы раскрываются только во время своего <w>дневного</w> цикла, когда солнце стоит высоко.",
                                "zh": "某些花卉只在太阳高照的<w>白天</w>周期内开放。"
                            }
                        }
                    ],
                    "antonyms": [
                        "at night"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходящий в светлое время суток, а не ночью.",
                        "zh": "发生在白天而非夜晚的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дневной",
                                "target_lang_sense_clarification": "относящийся к светлой части суток"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "白天的",
                                "target_lang_sense_clarification": "指在白天发生的"
                            },
                            {
                                "target_lang_word": "日间的",
                                "target_lang_sense_clarification": "指在日间进行的"
                            }
                        ]
                    }
                }
            ]
        },
        {
