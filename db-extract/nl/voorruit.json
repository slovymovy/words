                                "target_senses": [
                                    {
                                        "sense_id": "1f726b27-229a-3b35-86dc-8ebb14ccabca",
                                        "entry_id": "dbfc928a-1575-3fd4-a328-afeb40676d4d",
                                        "glosses": [
                                            "A transparent screen made of glass, located at the front of a vehicle in order to protect its occupants from the wind and weather."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9be7ca5b-16a5-4475-8a57-bcfac081e180",
                                                "sense_id": "1f726b27-229a-3b35-86dc-8ebb14ccabca",
                                                "text": "Oh no! A vandal has just smashed our windscreen! Susan, can you go and call the insurance company?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b2c15df3-e549-3376-b70d-f3acc78bfbad",
