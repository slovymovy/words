                        "form": "die Chimären"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7d453df1-ea2a-309b-bb9a-73be6e969276",
                        "entry_id": "6ebbd4e2-7669-365a-8b12-33e05744d3df",
                        "glosses": [
                            "Wahrnehmung, die man sich nur einbildet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fce39c59-7b00-47f8-a312-92face454f08",
                                "sense_id": "7d453df1-ea2a-309b-bb9a-73be6e969276",
                                "text": "Der See am Horizont entpuppte sich als reine Chimäre."
                            },
                            {
                                "example_id": "08fc5ca0-2914-4dae-a4ee-16dddc483987",
                                "sense_id": "7d453df1-ea2a-309b-bb9a-73be6e969276",
                                "text": "„Erneuerung wird aber unmöglich, wenn man von Konstanten ausgeht, die keine sind – Sicherheit zum Beispiel oder Geld und Macht. Dann klammert man sich an Chimären, von denen man nur betrogen werden kann, und die ganze Hoffnung auf Freiheit – ihre ganze Möglichkeit – verschwindet.“"
                            },
                            {
                                "example_id": "d301b764-f3c1-49de-b0d4-a499a2420516",
                                "sense_id": "7d453df1-ea2a-309b-bb9a-73be6e969276",
                                "text": "„Deutschlands Vizekanzler Robert Habeck (Grüne) hatte bereits vor der Kundgebung scharfe Kritik an den Forderungen von Schwarzer und Wagenknecht geübt. Sie wollten etwas als Frieden verkaufen, das ein «imperialistischer Diktator» Europa aufzwinge, sagte er in der ARD. Wenn sich das durchsetze, wäre das eine Einladung an den russischen Präsidenten Wladimir Putin, die nächsten Länder zu überfallen. «Das ist kein Frieden, das ist eine Chimäre, die da aufgebaut wird, das ist eine politische Irreführung der Bevölkerung.»“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "d64310e5-0ae4-3a80-83df-dc0afe23f425",
                        "entry_id": "6ebbd4e2-7669-365a-8b12-33e05744d3df",
                        "glosses": [
                            "Organismus oder Trieb, der aus genetisch verschiedenen Zellen aufgebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e38639f-08aa-4cf3-985e-672e91966909",
                                "sense_id": "d64310e5-0ae4-3a80-83df-dc0afe23f425",
                                "text": "Die Fruchtkörper von Schleimpilzen sind Chimären."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1a28edca-a0c1-3aec-944f-ced22e279fed",
                        "entry_id": "6ebbd4e2-7669-365a-8b12-33e05744d3df",
                        "glosses": [
                            "Lebewesen, dessen Zellen abweichende Chromosomenstruktur besitzen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "bafc3993-7374-37a6-bd4b-c817aab6f255",
                        "entry_id": "6ebbd4e2-7669-365a-8b12-33e05744d3df",
                        "glosses": [
                            "mythologisches Mischwesen, das aus verschiedenen Tieren zusammengesetzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ab19a9a0-4a90-4827-ab7a-8509d452e3e3",
                                "sense_id": "bafc3993-7374-37a6-bd4b-c817aab6f255",
                                "text": "In der antiken Mythologie gab es eine Vielzahl von Chimären."
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "d9ee54b7-136d-358a-ba56-5afaf8f6234f",
                        "entry_id": "6ebbd4e2-7669-365a-8b12-33e05744d3df",
                        "glosses": [
                            "Vertreter einer Ordnung der Knorpelfische"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d902edc-4211-4fa5-b44a-e30f1486edb0",
                                "sense_id": "d9ee54b7-136d-358a-ba56-5afaf8f6234f",
                                "text": "Chimären leben in der Tiefsee."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
