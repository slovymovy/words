                ],
                "senses": [
                    {
                        "sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                        "entry_id": "b343b551-05cf-3b2e-b6d7-409395f963f5",
                        "glosses": [
                            "Très belle femme, toutefois le suffixe -asse donne un côté légèrement péjoratif à ce mot que l'on utilise plutôt, pour une belle femme que l'on trouve, personnellement, vulgaire."
                        ],
                        "tags": [
                            "pejorative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "ff5407ad-dd50-4ea9-a49e-19841c4f3cbf",
                                "sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                                "text": "Un vieil ado dépressif tombe amoureux d’une belle blonde tandis qu’une bombasse brune lui propose de l’épouser."
                            },
                            {
                                "example_id": "e1f5d407-b7ca-4b85-849e-ae08c673722f",
                                "sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                                "text": "Seulement, voilà Elyas avait déjà rompu avec Manon depuis un bon bout de temps et souhaitait vivement recoller les morceaux avec sa brune, sa « bombasse »."
                            },
                            {
                                "example_id": "88fe7aab-ca39-4130-8aa2-05e0f191cada",
                                "sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                                "text": "Ma nana, c'était une déesse. Une poupée de cire. Mes potes me disaient: « Mais pourquoi tu l'emmènes pas dans tes sorties, ta bombasse ? »."
                            },
                            {
                                "example_id": "42ab9adb-94db-4f84-a82d-a85235dd4384",
                                "sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                                "text": "Des émissions de bonne année suivaient leur cours sur les principales chaînes de divertissement, mais je ne connaissais aucune des chanteuses, il m’apparut cependant que la bombasse latino cédait du terrain par rapport à la Celtique concernée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7e30637-4007-461c-bb08-fdeda909fa41",
                        "source_entry_id": "b343b551-05cf-3b2e-b6d7-409395f963f5",
                        "source_sense_id": "a80d9698-d4fb-3d6c-ae23-c73bd3a9b011",
                        "target_lang_word": "Sexbombe",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sexbombe",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "af0e9119-5be5-3384-b955-03980845fff4",
                                        "entry_id": "b381326a-58cf-390e-bb42-7cfa660d0b43",
                                        "glosses": [
                                            "weibliche Person mit sehr starker erotischer Ausstrahlung"
                                        ],
                                        "tags": [
                                            "casual"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1ff57143-2bfa-4bb4-bc26-bdfd096597c5",
                                                "sense_id": "af0e9119-5be5-3384-b955-03980845fff4",
                                                "text": "„Nur abends kam ein bisschen Erlösung: als ich Anna – als Sexbombe in meinem Kopf – in die Dusche mitnahm und sie ordentlich durchbürstete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
