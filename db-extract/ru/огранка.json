                "senses": [
                    {
                        "sense_id": "d13c5cb6-5504-3e2a-81b0-3731dadb003e",
                        "entry_id": "d5e6db75-9652-3e43-86b7-52135c7ae83c",
                        "glosses": [
                            "действие по значению гл. огранить"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6f5ece00-70b6-3a4b-8538-2e6f4cc92448",
                        "entry_id": "d5e6db75-9652-3e43-86b7-52135c7ae83c",
                        "glosses": [
                            "особенность, качество шлифовки, обработки граней; совокупность граней чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca8837dc-4717-4555-abcc-a72564b21e66",
                                "sense_id": "6f5ece00-70b6-3a4b-8538-2e6f4cc92448",
                                "text": "Сам огранённый камень также принято называть огранкой."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a3462222-6045-49b9-b5b7-9679925d2112",
                        "source_entry_id": "d5e6db75-9652-3e43-86b7-52135c7ae83c",
                        "target_lang_word": "taille",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taille",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "9f715ad2-32a9-3e36-a30c-fa859cb025d3",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Coupe ; manière dont on coupe certaines choses, dont elles sont taillées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00ebd47c-ee8b-425e-8be9-337239e59ffd",
                                                "sense_id": "9f715ad2-32a9-3e36-a30c-fa859cb025d3",
                                                "text": "Le même vieillard goutteux allait procéder à la taille des cheveux."
                                            },
                                            {
                                                "example_id": "e42634d3-244f-43ad-8fec-fc1682ca21ee",
                                                "sense_id": "9f715ad2-32a9-3e36-a30c-fa859cb025d3",
                                                "text": "Sur les tiges élevées, inabordables à la main ou à l'échelle, exécuter la taille en vert avec l’échenilloir ou le sécateur attaché au bout d'une perche."
                                            },
                                            {
                                                "example_id": "6ff7d946-0817-47cf-9caa-520c2e29ad8a",
                                                "sense_id": "9f715ad2-32a9-3e36-a30c-fa859cb025d3",
                                                "text": "– Viens, Mélie, ramasser les « tailles » de l’abricotier, Milien est après les espaliers…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "af530c63-309a-3595-8fcc-577fc48277e1",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Bois, pierre ou marbre que l’on coupe avec art et selon certaines dimensions, pour les employer dans une construction."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92031e80-cbef-4950-891a-a7ea4faa0dc1",
                                                "sense_id": "af530c63-309a-3595-8fcc-577fc48277e1",
                                                "text": "La taille des pierres."
                                            },
                                            {
                                                "example_id": "76a69075-806e-420b-b2a6-ba550d3198f0",
                                                "sense_id": "af530c63-309a-3595-8fcc-577fc48277e1",
                                                "text": "Une maison en pierre de taille."
                                            },
                                            {
                                                "example_id": "58dce95c-d555-4ac4-8380-6164063e0848",
                                                "sense_id": "af530c63-309a-3595-8fcc-577fc48277e1",
                                                "text": "La taille croissante des voitures a des conséquences concrètes dans nos rues: les gros SUV (Sport utility vehicle) et les pick-up à l’américaine ne tiennent pas dans les emplacements prévus et empiètent sur les trottoirs ou sur la route, commente Nicolas Raffin, porte-parole de Transports & Environnement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcd04600-2580-3304-8467-17a94588f482",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Manière dont on travaille les pierres précieuses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8d252e3d-f1d7-4f26-ac68-27e5fc2e6320",
                                                "sense_id": "fcd04600-2580-3304-8467-17a94588f482",
                                                "text": "La taille des pierreries est différente, selon les différents pays."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7185ef0-ae04-34b7-a5b4-13bfab1a2933",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Incision qui se fait avec le burin dans le cuivre ou toute autre matière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "632a81f1-463d-4b0f-a039-1c16c2a0a8df",
                                                "sense_id": "a7185ef0-ae04-34b7-a5b4-13bfab1a2933",
                                                "text": "Des tailles profondes, légères, bien nettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1ef9dc-dfff-3ccf-869b-772d5165a45c",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Étape d'un jeu de cartes où le banquier achève de retourner toutes les cartes."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2be68417-2d86-4716-b31b-78b52222a86c",
                                                "sense_id": "8f1ef9dc-dfff-3ccf-869b-772d5165a45c",
                                                "text": "Je commence à ponter à dix ducats sur une seule carte, elle perd quatre fois de suite, et il m'arrive la même chose dans la taille suivante. À la troisième taille personne ne veut couper."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1add3162-548d-3e92-a7f9-6b24a37d932e",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Opération qu’on pratique pour extraire les calculs qui se sont formés dans la vessie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfbc7a2d-3cbf-3547-865f-96703540c779",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Tranchant de l’épée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7cab6b55-603d-4d07-9923-2f4f02435585",
                                                "sense_id": "dfbc7a2d-3cbf-3547-865f-96703540c779",
                                                "text": "Ils frappent de pointe et de taille, à droite, à gauche, sur la tête, sur la poitrine."
                                            },
                                            {
                                                "example_id": "0c20c1b3-938d-479f-a0a8-418ff838cd61",
                                                "sense_id": "dfbc7a2d-3cbf-3547-865f-96703540c779",
                                                "text": "Il fut donc défendu aux champions de se servir de l’estoc ; il ne devait frapper que de taille."
                                            },
                                            {
                                                "example_id": "37f88091-1d6e-4872-a170-88dea0e86cd7",
                                                "sense_id": "dfbc7a2d-3cbf-3547-865f-96703540c779",
                                                "text": "De plus, avec leurs épées, ils ne pouvaient donner que des coups de taille, puisque le plus généralement elles n'étaient pas pointues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b9f52579-bc1d-332f-86b9-2f88dd5d4df9",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Coup porté par ce même tranchant d’une épée, d’un sabre ou autre arme blanche dans le but de trancher l'adversaire (en opposition à un coup d'estoc porté par la pointe de la lame dans le but de transpercer son adversaire)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "69096511-da8f-33bd-8136-f05ce28ea861",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Longueur du corps humain, de la plante des pieds au sommet de la tête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d70638f-23dc-4b6f-8285-f5d3c1cd1870",
                                                "sense_id": "69096511-da8f-33bd-8136-f05ce28ea861",
                                                "text": "M. de Paris, avec lequel je fis connaissance cette même nuit, est aussi chenu et de la même taille que moi."
                                            },
                                            {
                                                "example_id": "946a9942-15ac-47b3-8034-7b0774359940",
                                                "sense_id": "69096511-da8f-33bd-8136-f05ce28ea861",
                                                "text": "[…], et deux pages parurent, portant des flambeaux et éclairant une femme d’une taille imposante, d’un maintien majestueux, et surtout d’une admirable beauté."
                                            },
                                            {
                                                "example_id": "f9de4fa3-33f8-4929-8869-47c09dca2622",
                                                "sense_id": "69096511-da8f-33bd-8136-f05ce28ea861",
                                                "text": "Personne de vraiment grand, sentait-on, n’aurait eu une expression si virulente et si agressive, bien qu’en réalité Butteridge eût une taille de six pieds deux pouces (1ᵐ88) et un poids exactement proportionnel."
                                            },
                                            {
                                                "example_id": "a05a88c3-5db8-4c6c-a14b-34e59c724b1a",
                                                "sense_id": "69096511-da8f-33bd-8136-f05ce28ea861",
                                                "text": "Kinkin, vers la quarantaine, était un gaillard de taille moyenne qui dissimulait sous des dehors chétifs et une allure pataude une force herculéenne et une agilité de singe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9332a449-5084-3f32-b0c7-550c655af306",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Hauteur et grosseur des animaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f513a8c7-d192-45ca-933c-746d2a6b4b86",
                                                "sense_id": "9332a449-5084-3f32-b0c7-550c655af306",
                                                "text": "Le canard de Rouen est des plus recommandables par sa taille, sa rusticité, sa précocité et son aptitude à l'engraissement. Il est aussi le plus répandu."
                                            },
                                            {
                                                "example_id": "15a2c94f-7adc-47f7-b13d-57cee1c3f925",
                                                "sense_id": "9332a449-5084-3f32-b0c7-550c655af306",
                                                "text": "Le développement de cette espèce est de type hétérométabole : l’accroissement de la taille se fait progressivement au cours de quatre mues juvéniles et d’une mue imaginale et s’accompagne de changements dans les proportions du corps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Conformation du corps humain depuis les épaules jusqu’aux hanches."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574fc995-56da-4c34-91a9-c46fb2ddb31a",
                                                "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                                "text": "Cette singulière fille, maintenant soumise au corset, faisait fine taille, consommait de la bandoline pour sa chevelure lissée, acceptait ses robes telles que les lui livrait la couturière, portait des brodequins de choix et des bas de soie gris, d’ailleurs compris par les fournisseurs dans les mémoires de Valérie, et payés par qui de droit."
                                            },
                                            {
                                                "example_id": "f3560db8-a091-499c-b7b0-5fc378fcb6e1",
                                                "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                                "text": "Ce qui venait de tomber sur le lit, en un mince lambeau soyeux, léger et lent, c’était le corsage qui la serrait doucement au cou, et fort à la taille…"
                                            },
                                            {
                                                "example_id": "392e8040-c264-4789-91c6-dcabd70e5c39",
                                                "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                                "text": "C'était une grande femme qui avec moins d'embonpoint eût eu la taille belle, et une beauté romaine que bien des gens préféraient à celle de sa sœur."
                                            },
                                            {
                                                "example_id": "2fcce9c9-4b78-443c-87da-f3d94df96f5b",
                                                "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                                "text": "Cette femme n’a point de taille, elle est grosse et courte."
                                            },
                                            {
                                                "example_id": "0a093a29-3b5d-487c-90c9-9b8d4eac386d",
                                                "sense_id": "6badaf0a-d131-32fc-b359-4e562e0e8d58",
                                                "text": "Un vêtement à taille, vêtement qui dessine, qui souligne la taille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "165badcb-dc79-3403-8d5b-41502d80f69e",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "La partie la plus étroite de l'abdomen humain."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "16e9eb9d-1aea-4e03-b74e-b0e1715ec773",
                                                "sense_id": "165badcb-dc79-3403-8d5b-41502d80f69e",
                                                "text": "Le gars aux biques portait, sous une limousine de roulier, un bourgeron bleu serré à la taille par une ceinture rouge qui maintenait un pantalon de velours à l'instar des charbonniers auvergnats, […]."
                                            },
                                            {
                                                "example_id": "11062fa5-a83f-4b67-993d-a7a66f8b00de",
                                                "sense_id": "165badcb-dc79-3403-8d5b-41502d80f69e",
                                                "text": "De joyeuse humeur, le mari cause avec force gestes, prend parfois les mains de sa femme, la taille aussi."
                                            },
                                            {
                                                "example_id": "2e73c212-7fb3-423d-847d-5f55fcc1538d",
                                                "sense_id": "165badcb-dc79-3403-8d5b-41502d80f69e",
                                                "text": "Elle était avec une amie, peut-être qu’elles se tenaient par la taille, qu’elles regardaient d’autres femmes, qu’elles avaient en effet un « genre » que je n’avais jamais vu à Albertine en ma présence."
                                            },
                                            {
                                                "example_id": "7f1b65dc-3767-40c2-b449-cb8d82d0e5ef",
                                                "sense_id": "165badcb-dc79-3403-8d5b-41502d80f69e",
                                                "text": "Là où, par exemple, on tient à mettre en valeur les caractères gynoïdes de la taille et du bassin (comme dans la littérature au tournant du XXᵉ siècle), on va privilégier les vertugadins, les crinolines, les tournures et les corsets, lesquels vont finir par reconfigurer les corps en retour."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11d2f197-5d9a-3b7d-9ec7-6f48a00e9fc4",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Bois qui commence à repousser après avoir été taillé, coupé ; taillis."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28a4d0b2-19d2-4780-84c9-6b46e1246336",
                                                "sense_id": "11d2f197-5d9a-3b7d-9ec7-6f48a00e9fc4",
                                                "text": "Une taille de deux ans."
                                            },
                                            {
                                                "example_id": "9fe0b10f-064c-4b1c-810c-11519969ee4d",
                                                "sense_id": "11d2f197-5d9a-3b7d-9ec7-6f48a00e9fc4",
                                                "text": "Une jeune taille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0763614a-8a8a-3ecc-a0a6-ca165e6b164b",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Bûchette fendue sur sa longueur puis séparée en deux parties, sur laquelle sont entaillées des coches qui comptabilisent soit une quantité de marchandise fournie, soit des paiements d’impôt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454254d4-87f3-4b8e-b8ec-8909a64640ba",
                                                "sense_id": "0763614a-8a8a-3ecc-a0a6-ca165e6b164b",
                                                "text": "La taille était constituée de deux planchettes s’encastrant exactement l’une dans l’autre. Le client en possédait une, le boulanger conservait l’autre. Lorsque je prenais deux kilos de pain, je donnais ma planchette à la boulangère qui l’appliquait contre la sienne et, de son grand couteau, faisait deux entailles, une par kilo, dans le bois des deux tailles accolées, ainsi chacun d’elles conservait autant d’entailles que nous avions consommé de kilos de pain."
                                            },
                                            {
                                                "example_id": "31334217-b9c8-476e-a102-ab69263b43e2",
                                                "sense_id": "0763614a-8a8a-3ecc-a0a6-ca165e6b164b",
                                                "text": "Prendre à la taille le pain chez le boulanger."
                                            },
                                            {
                                                "example_id": "94272649-c66c-4f45-a77a-7918a67bccd3",
                                                "sense_id": "0763614a-8a8a-3ecc-a0a6-ca165e6b164b",
                                                "text": "Ils prennent à leurs gages un fromager qu’ils appellent le grurin ; — le grurin reçoit le lait des associés trois fois par jour et marque les quantités sur une taille double."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d64743bf-9707-3152-9a88-1d5bcf81a441",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Impôt direct féodal qu’on levait sur toutes les personnes qui n’étaient pas nobles ou ecclésiastiques, ou qui ne jouissaient pas de quelque exemption, sous l’Ancien Régime."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f19e1cc-ce43-4d88-a6b7-67fe0761c701",
                                                "sense_id": "d64743bf-9707-3152-9a88-1d5bcf81a441",
                                                "text": "Bourgeois et manants acquittaient la taille, la capitation, les vingtièmes, les aides."
                                            },
                                            {
                                                "example_id": "e479b39d-7bf5-4a30-8200-e82a6a95b872",
                                                "sense_id": "d64743bf-9707-3152-9a88-1d5bcf81a441",
                                                "text": "C'est un fait très caractéristique, nous l'avons vu, que, ni dans les listes électorales de 1790, ni dans les rôles des tailles, ni dans les registres d’état-civil antérieur à la Révolution, on ne trouve le terme de « cultivateur »."
                                            },
                                            {
                                                "example_id": "78dc2776-8ce0-4c59-9547-3a1a43ec7abf",
                                                "sense_id": "d64743bf-9707-3152-9a88-1d5bcf81a441",
                                                "text": "Le rôle des tailles de Barques pour 1719 porte 41 feux, dont 33 masculins ; celui de Marques : 66 feux, dont 56 masculins."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fdd09e5f-e66d-3103-b3ff-0e9975f21d8f",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Chantier d’abattage de la mine où travaillent en commun plusieurs ouvriers à veine."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "695db839-1370-453d-87a8-bd12bd8b2131",
                                                "sense_id": "fdd09e5f-e66d-3103-b3ff-0e9975f21d8f",
                                                "text": "Dans les gîtes puissants, on pratique souvent l’exploitation par tranches horizontales, et les mineurs travaillent debout dans la taille, en soutenant le toit du chantier au moyen de bois, et en remblayant ensuite les vides, si l’on veut éviter la dislocation des terrains."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98981615-2a67-3ffc-8afd-c770accfb475",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Voix d’homme qu’on appelle aujourd’hui ténor."
                                        ],
                                        "tags": [
                                            "baroque jargon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b0b20f5b-040b-3830-b258-e088ece270a8",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "Taille de hautbois, hautbois ténor de l’époque baroque, en fa."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abf3f86e-1240-31f7-9898-9869d4e01d80",
                                        "entry_id": "bf4e3351-7800-380a-b212-3087ca3d6def",
                                        "glosses": [
                                            "(De manière générale) Registre alto ou ténor d’une famille d’une famille d’instruments."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d1df82-37ff-4fba-9791-1cdb7ae4c246",
                                                "sense_id": "abf3f86e-1240-31f7-9898-9869d4e01d80",
                                                "text": "Le mélange si particulier du jeu de Tierce, en taille (= ténor) accompagné généralement par l’ensemble du Fond d’orgue 16-8-4 sur le clavier de Grand-Orgue, apparut vers les années 1675."
                                            }
                                        ]
                                    }
                                ]
