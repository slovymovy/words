                "senses": [
                    {
                        "sense_id": "c8e49cbe-eaba-3019-aa6f-84c9eceb77d7",
                        "entry_id": "476af5d4-8644-3740-b8bd-808737ab0a4a",
                        "glosses": [
                            "сделанный из эмали"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f8384d9e-ff07-41f2-8a1e-68ee8a83c7a2",
                                "sense_id": "c8e49cbe-eaba-3019-aa6f-84c9eceb77d7",
                                "text": "Эмалевый жетон."
                            },
                            {
                                "example_id": "c440b538-e3f8-449d-8c6e-d17a758f08c5",
                                "sense_id": "c8e49cbe-eaba-3019-aa6f-84c9eceb77d7",
                                "text": "На смену расписным эмалевым изделиям пришли одноцветные с серебряными накладками."
                            }
                        ]
                    },
                    {
                        "sense_id": "92535961-5c04-314a-ae9a-88825e56b16a",
                        "entry_id": "476af5d4-8644-3740-b8bd-808737ab0a4a",
                        "glosses": [
                            "перен. напоминающий эмаль внешним видом"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc568d10-872d-434e-a76a-77afcc1e7c17",
                                "sense_id": "92535961-5c04-314a-ae9a-88825e56b16a",
                                "text": "Эмалевый блеск высокого неба в кронах платанов и тополей."
                            }
                        ]
                    }
