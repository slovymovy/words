                "translations": [
                    {
                        "translation_id": "0b9dbde6-aefb-4b34-abf6-067a7d9129c2",
                        "source_entry_id": "32cac309-da55-31f4-adb7-2f1d607ea113",
                        "source_sense_id": "2a936304-fc97-3120-8f6d-4c38a2367dc7",
                        "target_lang_word": "grant",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0cceee86-b6cf-3aef-8d57-8839375b764c",
                                        "entry_id": "55001304-b5cf-3306-856f-906a074c5d22",
                                        "glosses": [
                                            "To give (permission or wish)."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a924291-a744-4c58-b5ff-3e6b09f37074",
                                                "sense_id": "0cceee86-b6cf-3aef-8d57-8839375b764c",
                                                "text": "He was granted permission to attend the meeting."
                                            },
                                            {
                                                "example_id": "cfeccbc9-4deb-4906-aec5-8ab77f78c75d",
                                                "sense_id": "0cceee86-b6cf-3aef-8d57-8839375b764c",
                                                "text": "The genie granted him three wishes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "202957dc-1e59-345c-abf6-10a824c3d7c8",
                                        "entry_id": "55001304-b5cf-3306-856f-906a074c5d22",
                                        "glosses": [
                                            "To give (bestow upon or confer, particularly in answer to prayer or request)."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4550956a-af77-4e89-9a03-14db979b9a85",
                                                "sense_id": "202957dc-1e59-345c-abf6-10a824c3d7c8",
                                                "text": "He Suſpends on theſe Reaſons, that Thomas Rue had granted a general Diſcharge to Adam Muſhet, who was his Conjunct, and correus debendi, after the alleadged Service, which Diſcharged Muſhet, and conſequently Houstoun his Partner."
                                            },
                                            {
                                                "example_id": "c26e30f3-9f0f-421c-8e50-9b5a79806291",
                                                "sense_id": "202957dc-1e59-345c-abf6-10a824c3d7c8",
                                                "text": "c. 1930, Serenity Prayer\nGod, grant me the serenity[…]"
                                            },
                                            {
                                                "example_id": "d9de2821-8356-42e1-8224-930897e3329d",
                                                "sense_id": "202957dc-1e59-345c-abf6-10a824c3d7c8",
                                                "text": "In order to grant the rich these pleasures, the social contract is reconfigured. The welfare state is dismantled. […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce3ff5f0-e286-3156-92cc-3b66c81c4f10",
                                        "entry_id": "55001304-b5cf-3306-856f-906a074c5d22",
                                        "glosses": [
                                            "To agree with (someone) on (something); to accept (something) for the sake of argument; to admit to (someone) that (something) is true."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170318f9-8e4b-429e-bfa2-5025a510ab3f",
                                                "sense_id": "ce3ff5f0-e286-3156-92cc-3b66c81c4f10",
                                                "text": "The universe exists, said the father: somebody must have made it. If that somebody exists, said I, somebody must have made him. I grant that for the sake of argument, said the Oratorian."
                                            },
                                            {
                                                "example_id": "1f288168-9a93-4f74-9f3f-515f930acf43",
                                                "sense_id": "ce3ff5f0-e286-3156-92cc-3b66c81c4f10",
                                                "text": "\"They are tall, certainly,\" said Sir Chetwynd... \"I grant you they are tall. That is, the majority of them are. But I have seen short men among them. The Khedive is not taller than I am. And the Egyptian face is very deceptive. The features are often fine,—occasionally classic,—but intelligent expression is totally lacking.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a0911832-6ce4-30f4-9b1a-63a4fdff5537",
                                        "entry_id": "55001304-b5cf-3306-856f-906a074c5d22",
                                        "glosses": [
                                            "To assent; to consent."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c44b613-0075-4039-af00-c866890421d4",
                                                "sense_id": "a0911832-6ce4-30f4-9b1a-63a4fdff5537",
                                                "text": "Before I would have granted to that act.\nBut thou preferr'st thy life before thine honor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "grant",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6ea11411-400b-3bdb-a57e-85b7b11406b1",
                                        "entry_id": "2f356967-332c-3cc9-a3e4-000b26aafe90",
                                        "glosses": [
