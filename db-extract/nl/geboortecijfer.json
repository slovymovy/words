                        "glosses": [
                            "een getal dat aangeeft hoeveel geboorten er in een gebied in een bepaalde tijd hebben plaatsgevonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2293443f-b74f-40f3-9018-6a0012591de3",
                                "sense_id": "1c150162-8054-32ba-a255-7fd9b269cbf9",
                                "text": "Het geboortecijfer is in veel arme landen uitzonderlijk hoog."
