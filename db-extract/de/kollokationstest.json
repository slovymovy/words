                ],
                "senses": [
                    {
                        "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                        "entry_id": "8c23131a-8a7f-3b43-a3bc-7170b8a65c21",
                        "glosses": [
                            "Methode zur Beschreibung von Bedeutungsunterschieden im kontextuellen Zusammenhang, wobei die zu untersuchenden Lexeme auf verträgliche und unverträgliche Umgebungen hin untersucht werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36a5940b-6c62-45a5-aa8a-395c5b5e92fe",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "Anhand des Adjektivs ‚grün‘ kann beim Kollokationstest gezeigt werden, dass es im Zusammenhang mit den verwendeten Substantiven ‚Baum‘, ‚Hering‘ und ‚Junge‘ verschiedene Bedeutungen erhält."
                            },
                            {
                                "example_id": "d0b747af-0670-4ca4-b651-0340e75e0839",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "„Der Kollokationstest greift zurück auf die Entdeckung W. PORZIGs, die dieser zuerst \"wesenhafte Bedeutungsbeziehungen\" genannt hat, und untersucht die Wörter nach ihren Verträglichkeiten mit anderen Wörtern im Kontext.“"
                            },
                            {
                                "example_id": "53cdf8bd-cf2d-4dfd-be9c-f990a0b43c16",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "„E.A.NIDA hat darauf hingewiesen, daß man mit dem Substitutionstest zu gleichen Ergebnissen komme, damit aber nicht zur Sammlung eines so großen Korpus gezwungen sei wie beim Kollokationstest.“"
                            },
                            {
                                "example_id": "1b067d8b-9895-469f-808a-c6ffb84b4ece",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "„Bei der Überprüfung der Kollokabilität einzelner Adjektive in verschiedenen Kollokationstests hat sich nämlich gezeigt: 'rein' als eine Lesart im Bereich der Sauberkeit ist heute schon veraltet: üblich ist lediglich noch die Verwendung von 'rein' in der Verbindung 'reine Luft'.“"
                            },
                            {
                                "example_id": "b8dbd2e1-73ae-49e4-b3bb-92160f912549",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "„Während für die Beschreibung der semantischen Kompatibilität z. B. die Monosemierung der untersuchten Lexeme vorausgesetzt wird, hat Joos in Form des Kollokationstests gerade umgekehrt mit Hilfe der semantischen Verträglichkeit bzw. Unverträglichkeit von Lexemen deren inhaltsseitige Internbeschreibung vorgenommen, d.h. polyseme Strukturen beschrieben (Joos 1958).“"
                            },
                            {
                                "example_id": "bf339d8c-3b0a-4e42-a3f7-94b406b84b6f",
                                "sense_id": "a723c667-12d2-31d7-92e0-226f2c68ed5a",
                                "text": "„Die Sememstrukturen können durch Kontextanalysen, Substitutionstests, Kollokationstests und Wörterbuchvergleiche ermittelt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
