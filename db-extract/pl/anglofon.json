                                "target_senses": [
                                    {
                                        "sense_id": "15e3fa18-4d99-36db-8092-4fb7d752c0de",
                                        "entry_id": "e060b2a3-b745-3581-a19d-c7018fd7ffd8",
                                        "glosses": [
                                            "Alternative letter-case form of Anglophone."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24fdf866-314c-48d6-b7fa-8d77269ca3c2",
                                                "sense_id": "15e3fa18-4d99-36db-8092-4fb7d752c0de",
                                                "text": "“What is this? ‘Why are you talking to me in English?’” I prodded, mimicking my mother, who would scold us when, around guests of the anglophone persuasion, we accidentally addressed her in English."
                                            }
                                        ]
                                    }
