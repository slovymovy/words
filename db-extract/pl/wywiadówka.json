                        "cross_references": []
                    },
                    {
                        "translation_id": "4f01b07e-a38b-44ad-91da-81cf74664bc5",
                        "source_entry_id": "2b9cee6d-a8fb-3587-86f2-164608656dde",
                        "source_sense_id": "7fa3dac4-4f1b-3b93-b132-de6d51b61dc2",
                        "target_lang_word": "Elternabend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Elternabend",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "13b91e6e-fe5e-32e5-b677-ea9ce5e51980",
                                        "entry_id": "b15d0eb8-2dd8-3f1c-b91e-ea979e36eef5",
                                        "glosses": [
                                            "Versammlung, bei der die Eltern von Schülern Gelegenheit bekommen, mit deren Lehrern über die schulischen Leistungen und das allgemeine Betragen ihrer Kinder sowie über organisatorische Angelegenheiten zu sprechen und sich mit anderen Eltern auszutauschen – aus Gründen der Vereinbarkeit mit der Arbeitszeit meist am Abend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2840d500-9dca-4bfb-97cd-5db50e8d9572",
                                                "sense_id": "13b91e6e-fe5e-32e5-b677-ea9ce5e51980",
                                                "text": "Von manchen Zensuren ihrer Kinder erfahren die Eltern frühestens beim nächsten Elternabend."
                                            },
                                            {
                                                "example_id": "1eca515c-5746-47eb-9aae-0a6afa4106c3",
                                                "sense_id": "13b91e6e-fe5e-32e5-b677-ea9ce5e51980",
                                                "text": "„Und wenn er dann in die Schule gehen wird, wird sie zum Elternabend gehen und sich erkundigen, ob er sich auch anstrengt und sich anständig benimmt.“"
                                            },
                                            {
                                                "example_id": "09f0a2d7-0948-4ff9-ba7b-092ed65022ac",
                                                "sense_id": "13b91e6e-fe5e-32e5-b677-ea9ce5e51980",
                                                "text": "„Amalia hatte gesagt, dass er Autist sei, nachdem sie vom Elternabend zurückgekommen war und Milena dann erklärt hatte, was das bedeutete.“"
                                            },
                                            {
                                                "example_id": "99932899-429b-4d92-acda-614ff5e2f888",
                                                "sense_id": "13b91e6e-fe5e-32e5-b677-ea9ce5e51980",
                                                "text": "„Ich konnte mich nicht erinnern, dass Mama die Tasche benutzt hatte, wenn sie zu Hause war, nicht bei Schulabschlussfeiern oder bei Elternabenden, nicht im Gesundheitszentrum oder beim Einkaufen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d83ed0e-bbb8-48f5-a01c-8c15f38c5688",
                        "source_entry_id": "2b9cee6d-a8fb-3587-86f2-164608656dde",
                        "source_sense_id": "7fa3dac4-4f1b-3b93-b132-de6d51b61dc2",
