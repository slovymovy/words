{
    "word_family": [
        "vouwen",
        "opvouwen",
        "ontvouwing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "692289c4-438e-3815-9000-767d8a4dae2f",
                    "sense_definition": "iets dat gevouwen is openmaken of platmaken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysiek_openen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij wilde de grote landkaart <w>ontvouwen</w> om de juiste route te zoeken.",
                            "target_lang_translations": {
                                "en": "He wanted to <w>unfold</w> the large map to look for the correct route."
                            }
                        },
                        {
                            "text": "Leg er een tijdje een zwaar boek op om de brief netjes te <w>ontvouwen</w>.",
                            "target_lang_translations": {
                                "en": "Place a heavy book on it for a while to <w>unfold</w> the letter neatly."
                            }
                        }
                    ],
                    "synonyms": [
                        "openvouwen",
                        "uitslaan"
                    ],
                    "antonyms": [
                        "opvouwen",
                        "vouwen"
                    ],
                    "common_phrases": [
                        "een brief ontvouwen",
                        "een kaart ontvouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To open up or flatten something that has been folded."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unfold",
                                "target_lang_sense_clarification": "to open up something folded, like a map or letter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "14000a09-3f0b-3f6f-b90c-cbccd5c20604",
                    "sense_definition": "plannen, ideeën of gedachten in detail aan anderen uitleggen of presenteren",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "uitleggen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De directeur zal morgen zijn nieuwe plannen voor de toekomst van het bedrijf <w>ontvouwen</w>.",
                            "target_lang_translations": {
                                "en": "The director will <w>unfold</w> his new plans for the future of the company tomorrow."
                            }
                        },
                        {
                            "text": "Het plan werd volledig door hem <w>ontvouwen</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "The plan was fully <w>unfolded</w> by him during the meeting."
                            }
                        }
                    ],
                    "synonyms": [
                        "uiteenzetten",
                        "verklaren",
                        "toelichten",
                        "openbaren"
                    ],
                    "antonyms": [
                        "verhullen",
                        "verzwijgen"
                    ],
                    "common_phrases": [
                        "een plan ontvouwen",
                        "een visie ontvouwen"
                    ],
                    "target_lang_definitions": {
                        "en": "To explain or present plans, ideas, or thoughts in detail to others."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unfold",
                                "target_lang_sense_clarification": "to reveal or explain a plan or design in detail"
                            },
                            {
                                "target_lang_word": "reveal",
                                "target_lang_sense_clarification": "to make a plan or secret known to others"
                            },
                            {
                                "target_lang_word": "disclose",
                                "target_lang_sense_clarification": "to make information or plans public"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "534b94c2-09d9-3e18-bfed-81d91e3fe2b0",
                    "sense_definition": "zich langzaam aan de toeschouwer openbaren of zichtbaar worden",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "zichtbaar_worden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Een prachtig landschap <w>ontvouwde</w> zich voor onze ogen toen we de bergtop bereikten.",
                            "target_lang_translations": {
                                "en": "A beautiful landscape <w>unfolded</w> before our eyes when we reached the mountain peak."
                            }
                        },
                        {
                            "text": "Het breekbare, pastelkleurige cliché van de stad aan het groene water <w>ontvouwde</w> zich onbekommerd voor mij.",
                            "target_lang_translations": {
                                "en": "The fragile, pastel-colored cliché of the city on the green water <w>unfolded</w> lightheartedly before me."
                            }
                        }
                    ],
                    "synonyms": [
                        "openbaren",
                        "verschijnen",
                        "zich openbaren"
                    ],
                    "antonyms": [
                        "verdwijnen"
                    ],
                    "common_phrases": [
                        "zich voor de ogen ontvouwen",
                        "een landschap ontvouwt zich"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Vaak wederkerend gebruikt: 'zich ontvouwen'"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To slowly reveal itself or become visible to the observer."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unfold",
                                "target_lang_sense_clarification": "to gradually develop or be revealed to the eye or mind"
                            },
                            {
                                "target_lang_word": "reveal itself",
                                "target_lang_sense_clarification": "to become visible or known"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}