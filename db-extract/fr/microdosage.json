                        "entry_id": "201f9132-3f24-33e1-b2cf-e128fa8553b7",
                        "glosses": [
                            "Action de doser un élément présent en très petite quantité dans un produit."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75243067-6795-4f7a-84a3-b6b07711ff01",
                                "sense_id": "7a746ce9-739e-3d3e-84c4-5d9f2c97813f",
                                "text": "Modifications de l’appareil du professeur Deserez pour le carbone total en vue d’un microdosage par alcalimètre."
                            },
                            {
                                "example_id": "6eed2784-6df0-4650-9605-6a88e857b063",
                                "sense_id": "7a746ce9-739e-3d3e-84c4-5d9f2c97813f",
                                "text": "Une technique simple de microdosage du cuivre par la réaction de Delépine"
                            }
                        ]
                    },
                    {
                        "sense_id": "589fddb3-c941-3fbb-893b-3bb7941a7d40",
                        "entry_id": "201f9132-3f24-33e1-b2cf-e128fa8553b7",
                        "glosses": [
                            "Mesure précise d’une très petite quantité d’ingrédient."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5ea01fd1-a5fc-435f-b3df-a6c2f3d6569c",
                                "sense_id": "589fddb3-c941-3fbb-893b-3bb7941a7d40",
                                "text": "Système de microdosage MDS. Pour une lubrification contrôlée en continu avec des quantités d’huile minimales."
                            },
                            {
                                "example_id": "2a6f9db5-6c65-4d94-8eb3-0c20f6cf8650",
                                "sense_id": "589fddb3-c941-3fbb-893b-3bb7941a7d40",
                                "text": "La gamme des microdoseurs DMP a été spécialement conçue pour le microdosage de très haute précision de tous les produits pulvérulents."
                            }
                        ]
                    },
                    {
                        "sense_id": "b10fab71-a74c-3dc0-ab8a-83f247e7faca",
                        "entry_id": "201f9132-3f24-33e1-b2cf-e128fa8553b7",
                        "glosses": [
                            "Administration ou consommation de substances toxiques et/ou psychotropes à des doses très faibles."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68ddb867-debd-442f-b333-e946ab0c12e1",
                                "sense_id": "b10fab71-a74c-3dc0-ab8a-83f247e7faca",
                                "text": "Une des pistes explorées dans le cadre de ces recherches est le microdosage."
                            },
                            {
                                "example_id": "b71f06ef-8d51-4e06-8e01-d7e840b02d5c",
                                "sense_id": "b10fab71-a74c-3dc0-ab8a-83f247e7faca",
                                "text": "Le microdosage émerge aussi dans les milieux étudiants, où l’on connaît déjà le phénomène du dopage intellectuel avec le détournement de certains médicaments comme la Ritaline, un traitement contre les troubles du déficit de l’attention également employé pour stimuler ses capacités cognitives."
                            }
                        ]
                    }
