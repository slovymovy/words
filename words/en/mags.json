                            "target_lang_translations": {
                                "ru": "Все в семье зовут ее <w>Мэгс</w> вместо Маргарет."
                            }
                        },
                        {
                            "text": "I am meeting <w>Mags</w> for lunch at the cafe today.",
                            "target_lang_translations": {
