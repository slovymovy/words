                        "sense_id": "b10ef026-a7bb-32e9-b59b-019607945ec0",
                        "entry_id": "a4093faf-a6ac-3b70-8b40-17f5afec668b",
                        "glosses": [
                            "прост., экспр. однокр. к скакать"
