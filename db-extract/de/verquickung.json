                "senses": [
                    {
                        "sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                        "entry_id": "fc2f10c1-90d7-3eb2-a354-08c30b818fef",
                        "glosses": [
                            "enge, verflochtene Verbindung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "495a6319-ca66-4973-93c7-c52b2786ee63",
                                "sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                                "text": "Die enge Verquickung zwischen Unternehmensleitung und Stadtrat lässt nichts Gutes ahnen und sollte schnellstens untersucht werden."
                            },
                            {
                                "example_id": "72e3f82e-a2ef-40ca-9ee3-2127235611dc",
                                "sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                                "text": "Durch eine Verquickung unglücklicher Umstände stand die Ärmste am Ende ohne Arbeit und Dach über dem Kopf da."
                            },
                            {
                                "example_id": "5c6cc208-e928-4643-903c-6164569a3a46",
                                "sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                                "text": "„Gleichzeitig ist sie ökonomisch hochgradig ineffizient und steht exemplarisch für die Verquickung von Politik, persönlichen Netzwerken und wirtschaftlichem Protektionismus.“"
                            },
                            {
                                "example_id": "83302637-d7fd-4c7f-b3f7-f98a511ca2e3",
                                "sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                                "text": "„Denn die enge Verquickung der beiden großen Kirchen mit dem Staat hat den unangenehmen Nebeneffekt, neue spirituelle Ideen zu disqualifizieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "06be57fb-71d0-4cfd-87b1-7e9d910fc9ba",
                        "source_entry_id": "fc2f10c1-90d7-3eb2-a354-08c30b818fef",
                        "source_sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                        "source_sense_description": "enge, verflochtene Verbindung",
                        "target_lang_word": "amalgamation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amalgamation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c5178a01-9e8d-3440-be19-79f7e25450aa",
                                        "entry_id": "b3c12e71-fe92-399c-84c8-08e647124cac",
                                        "glosses": [
                                            "The process of amalgamating; a mixture, merger or consolidation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a98079a9-2dfe-47ae-b45e-8d763f9c8454",
                                                "sense_id": "c5178a01-9e8d-3440-be19-79f7e25450aa",
                                                "text": "In 1908 Sheng obtained imperial approval for the amalgamation of the Hanyang Ironworks and the Ta-yeh and P'ing-hsiang mines to form the Han-Yeh-P'ing Coal and Iron Company Limited (Han-Yeh-P'ing mei-t'ieh ch'ang-k'uang yu-hsien kung-ssu)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f69a49e7-4469-3493-aa93-19b27c9d3822",
                                        "entry_id": "b3c12e71-fe92-399c-84c8-08e647124cac",
                                        "glosses": [
                                            "The result of amalgamating; a mixture or alloy."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6d4b9ab2-fbf4-3205-afcb-4edaa802cf19",
                                        "entry_id": "b3c12e71-fe92-399c-84c8-08e647124cac",
                                        "glosses": [
                                            "The result of amalgamating; a mixture or alloy.",
                                            "The production of an alloy of mercury and another metal, especially used in antiquity to extract gold and silver from ores."
                                        ],
                                        "tags": [
                                            "countable",
                                            "specifically",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3adf4534-2cd9-3fd8-93b8-e62cc523e793",
                                        "entry_id": "b3c12e71-fe92-399c-84c8-08e647124cac",
                                        "glosses": [
                                            "The intermarriage and interbreeding of different ethnicities or races."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83db3d90-9f0a-43cf-9628-e3ab001db3b0",
                                                "sense_id": "3adf4534-2cd9-3fd8-93b8-e62cc523e793",
                                                "text": "All the circumstances of William, on the great house farm, show him to have occupied a different position from the other slaves, and, certainly, there is nothing in the supposed hostility of slaveholders to amalgamation, to forbid the supposition that William Wilks was the son of Edward Lloyd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a4be268b-afca-49a6-8576-757621727ba9",
                        "source_entry_id": "fc2f10c1-90d7-3eb2-a354-08c30b818fef",
                        "source_sense_id": "5617b97c-aac0-3428-b3c7-c9db7c2ce7fa",
                        "source_sense_description": "enge, verflochtene Verbindung",
                        "target_lang_word": "fusion",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "01c6bd88-38da-3b7f-bcad-c6428185f96a",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Liquéfaction d’un corps par l’action de la chaleur."
                                        ],
                                        "tags": [
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "790bf500-3f54-40d6-adb3-c02b043abd3d",
                                                "sense_id": "01c6bd88-38da-3b7f-bcad-c6428185f96a",
                                                "text": "La fusion de l’acier pour qu’il ait les qualités qu’on recherche ne peut se faire avec un flux où il entre des matières charbonneuses; celles-ci dans la fusion le rendent intraitable."
                                            },
                                            {
                                                "example_id": "bd0a3c15-4f46-445e-b134-98b504282985",
                                                "sense_id": "01c6bd88-38da-3b7f-bcad-c6428185f96a",
                                                "text": "Je vous demande pardon […], mais cette eau ne peut aucunement provenir de la fusion de la glace."
                                            },
                                            {
                                                "example_id": "fc9083a8-a62c-4636-802f-acf50d7342ee",
                                                "sense_id": "01c6bd88-38da-3b7f-bcad-c6428185f96a",
                                                "text": "La valeur la plus forte pour les échantillons obtenus par voie électrolytique ne peut être attribuée à un état allotropique particulier du métal, car après fusion, le coefficient d’aimantation de ces échantillons n’a pas changé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "425b9b08-8c90-325a-b3a2-5ba4d10e5de7",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Dissolution d’un corps dans un liquide auquel on le mélange."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f2bbffb0-75fa-364c-8a6c-459e0dc9c130",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Regroupement de deux entreprises en une seule."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a84c5e4-25df-4311-bfc4-fe2a50233748",
                                                "sense_id": "f2bbffb0-75fa-364c-8a6c-459e0dc9c130",
                                                "text": "CERALIMENT.LU.BRUN à Augy fabrique des biscottes, du pain grillé, des biscuits et réalise de la panification fraîche. C’est une filiale de la GÉNÉRALE BISCUIT, l’un un des premiers groupes européens né de la fusion successive de plusieurs entreprises concurrentes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40ff153f-c3f2-302a-8ac9-02a2517bd998",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Regroupement de deux entités politiques pour en faire une seule."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8b77585-f36c-47c1-b8c4-c7047296d67c",
                                                "sense_id": "40ff153f-c3f2-302a-8ac9-02a2517bd998",
                                                "text": "De même que les duchés de France, jadis indépendants, durent se fusionner en une nation, de même à présent les nations auraient dû s’adapter à une fusion plus vaste, […]. # Alliance ; mélange."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "69423d2e-75eb-33ba-b174-cf54b5a5f0af",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Regroupement de deux ou plusieurs municipalités ou communes pour en faire une seule."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c110a72a-ffcb-4031-a1b8-253529b26bad",
                                                "sense_id": "69423d2e-75eb-33ba-b174-cf54b5a5f0af",
                                                "text": "Par arrêté préfectoral du 20 juin 1978, la fusion-association intervenue entre les anciennes communes de Boissy-sur-Damville, de Créton et de Morainville-sur-Damville pour donner naissance à la commune de Buis-sur-Damville a été transformée en fusion simple."
                                            },
                                            {
                                                "example_id": "de6f8e75-5244-4943-8405-3e0f8b08e23e",
                                                "sense_id": "69423d2e-75eb-33ba-b174-cf54b5a5f0af",
                                                "text": "Les communes bruxelloises sont fières comme Artaban de ne pas avoir fusionné. Une fusion, ce serait une atteinte autoritaire à la démocratie communale, qui existe depuis des siècles dans nos contrées."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1724f59-cb78-3006-8c78-d7b2dc984352",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Addition de deux éléments distincts pour en faire un tout."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "887e4fec-3c31-47fa-99ce-57ad9052f16b",
                                                "sense_id": "b1724f59-cb78-3006-8c78-d7b2dc984352",
                                                "text": "La fusion mer-montagne est le miracle de certaines îles – la Corse, la Réunion, les Canaries –, de la Riviera italienne et française, du Pays basque espagnol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552c4cdb-4a97-360e-85e3-3d9d00dcfb95",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "Fusion nucléaire."
                                        ],
                                        "tags": [
                                            "Fusion nucléaire"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "11aee8d6-ddf2-4dea-8356-39332afd6dd4",
                                                "sense_id": "552c4cdb-4a97-360e-85e3-3d9d00dcfb95",
                                                "text": "Aujourd’hui, la spectroscopie du plasma solaire coronal est étroitement tributaire de celles des plasmas de fusion, et réciproquement."
                                            },
                                            {
                                                "example_id": "b8cb3ab0-2e28-42c2-a84b-1d6ed92f5c70",
                                                "sense_id": "552c4cdb-4a97-360e-85e3-3d9d00dcfb95",
                                                "text": "De récentes images satellites révèlent un gigantesque centre de fusion nucléaire par laser dans les montagnes rocheuses de Mianyang, dans le sud-ouest de la Chine. Le centre dispose de quatre bras périphériques à partir desquels des lasers seront dirigés vers une chambre contenant des isotopes d’hydrogène."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "536bf239-a35b-34ae-af22-fb975f41a764",
                                        "entry_id": "c4a5fcf7-2fa9-3d43-bc72-f3225676d7de",
                                        "glosses": [
                                            "État dans lequel une personne confond ses désirs et ses sentiments avec ceux d'un proche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fedebbd-02ff-41a7-9298-26dce09a5449",
                                                "sense_id": "536bf239-a35b-34ae-af22-fb975f41a764",
                                                "text": "Dans la fusion, deux personnalités sont mélangées, il n'y a pas de séparation : l'enfant, l'adulte restent emprisonnés dans une matrice qui empêche d'être véritablement soi-même. Celui qui se laisse prendre dans la fusion n'a plus son désir propre, il intègre le désir de l'autre comme le sien. […] Il peut y avoir emprise sans fusion alors que dans la fusion il y a toujours emprise."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fusion",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "99ead7d6-1028-3f07-8477-fec60fc6359f",
                                        "entry_id": "952f8673-71f7-3a66-9b54-716ff58c889a",
                                        "glosses": [
                                            "Ellipse de jazz fusion, courant musical lancé vers 1970, mêlant le jazz avec d'autres genres musicaux."
                                        ],
                                        "tags": [
                                            "Jazz"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79819365-0062-4af3-afaf-1657336b63fa",
                                                "sense_id": "99ead7d6-1028-3f07-8477-fec60fc6359f",
                                                "text": "Tout d’un coup, j’entrevois la possibilité d’une nouvelle forme de musique fortement ancrée dans la tradition du blues, funky mais pas fusion, et faite de structures polytonales se déplaçant constamment au-dessus d’une ligne de basse stricte et suffisamment simple pour pouvoir être jouée par un orchestre de rhythm and blues."
                                            },
                                            {
                                                "example_id": "f2b3b29a-beca-4a20-a342-7431bb64a75a",
                                                "sense_id": "99ead7d6-1028-3f07-8477-fec60fc6359f",
                                                "text": "Évidemment le jazz-funk de Herbie Hancock n'est pas du tout de la même teneur que celui, plus léger, moins tourné vers le fusion, de Donald Byrd et consorts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
