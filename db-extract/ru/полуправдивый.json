                "senses": [
                    {
                        "sense_id": "fa609807-d754-3a6c-8789-6d9272c1f531",
                        "entry_id": "3162261a-1121-372a-93fb-3eccab52b616",
                        "glosses": [
                            "правдивый наполовину или отчасти, содержащий полуправду"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a1124933-581d-4b62-84dd-d32f87f21477",
                                "sense_id": "fa609807-d754-3a6c-8789-6d9272c1f531",
                                "text": "Разные соседские люди, вызванные на суд, не спасали полуправдивыми рассказами."
                            },
                            {
                                "example_id": "01703bc6-095f-4848-95db-138d9beec3cb",
                                "sense_id": "fa609807-d754-3a6c-8789-6d9272c1f531",
                                "text": "Фильм сделан хорошо, но как всегда выдержан в полуправдивых тонах."
                            }
                        ]
                    }
