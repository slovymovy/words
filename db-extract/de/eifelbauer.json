                                "example_id": "c8a398fd-ac92-4315-8255-f5eb95f0e075",
                                "sense_id": "a5b4bdc8-ad0e-3a04-8e1f-1b4974fe01a0",
                                "text": "„Seine Nachbarn, die vernünftigen Eifelbauern, hielten Kühe.“"
                            },
                            {
                                "example_id": "e13e9f8d-8bcf-4cfa-84aa-cde9bd9d6cc6",
                                "sense_id": "a5b4bdc8-ad0e-3a04-8e1f-1b4974fe01a0",
                                "text": "„Ihr fiel auf, dass die Eifelbauern sehr arm waren, und dass sie sehr schöne Stoffe weben konnten, das sogenannte ‚Maartuch‘.“"
                            }
