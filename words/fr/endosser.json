{
    "word_family": [
        "adosser",
        "adossement",
        "dossier",
        "endossement",
        "endosseur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "22589234-b8e8-331f-b2f7-b30c6a517cb4",
                    "sense_definition": "Mettre un vêtement ou une armure sur son dos, s'habiller de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "vetement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant de sortir dans le froid matinal, il décide d'<w>endosser</w> un manteau bien chaud."
                        },
                        {
                            "text": "Le comédien s'apprête à <w>endosser</w> son costume quelques minutes avant le début du spectacle."
                        }
                    ],
                    "synonyms": [
                        "enfiler",
                        "revêtir"
                    ],
                    "antonyms": [
                        "enlever",
                        "ôter"
                    ],
                    "common_phrases": [
                        "endosser un manteau",
                        "endosser une veste",
                        "endosser un uniforme"
                    ]
                },
                {
                    "sense_id": "9987ea0b-37e4-399d-af85-28a7eecfb516",
                    "sense_definition": "Prendre à sa charge une responsabilité, une faute ou un rôle difficile.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "responsabilite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le directeur a accepté d'<w>endosser</w> la responsabilité de cette grave erreur stratégique."
                        },
                        {
                            "text": "Personne dans l'équipe ne voulait <w>endosser</w> une faute commise par un autre employé."
                        }
                    ],
                    "synonyms": [
                        "assumer",
                        "revendiquer"
                    ],
                    "antonyms": [
                        "décliner",
                        "rejeter"
                    ],
                    "common_phrases": [
                        "endosser la responsabilité",
                        "endosser une faute",
                        "endosser un rôle"
                    ]
                },
                {
                    "sense_id": "6dcd30cb-17ab-31a3-b398-59f01f4df802",
                    "sense_definition": "Signer ou inscrire une mention au verso d'un chèque ou d'un effet de commerce pour en transmettre la propriété.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous devez impérativement <w>endosser</w> ce chèque avant de pouvoir le déposer à la banque."
                        },
                        {
                            "text": "Le commerçant a oublié d'<w>endosser</w> la lettre de change transmise par son client."
                        }
                    ],
                    "common_phrases": [
                        "endosser un chèque"
                    ]
                },
                {
                    "sense_id": "e5785095-3207-346a-9b7e-507803e588e6",
                    "sense_definition": "En reliure, arrondir et rabattre le dos d'un livre pour lui donner sa forme définitive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reliure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artisan relieur utilise un marteau spécifique pour <w>endosser</w> l'ouvrage sans abîmer les cahiers."
                        },
                        {
                            "text": "Après avoir cousu les pages, il faut soigneusement <w>endosser</w> le volume avant de fixer la couverture."
                        }
                    ]
                }
            ]
        }
    ]
}