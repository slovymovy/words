                                        "glosses": [
                                            "A botanist who specializes in paleobotany; someone who studies plant fossils."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53a04a3c-6549-42bb-830f-3471a5f23eda",
                                                "sense_id": "9e3268d7-3fbb-3918-9736-caf879494029",
                                                "text": "How and when the earliest plants made the first move on to land is always a hot topic for palaeobotanists."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
