                "senses": [
                    {
                        "sense_id": "a460012d-d34c-3ea1-8f15-b617ae1b991e",
                        "entry_id": "a9473b81-eeb6-3929-938b-dd81dea3946f",
                        "glosses": [
                            "ein kleiner Löffel, der zum Kaffeegeschirr passt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bac78c80-b5bb-4c7d-84d6-2fc3ff5916f8",
                                "sense_id": "a460012d-d34c-3ea1-8f15-b617ae1b991e",
                                "text": "„Wir aßen von richtigen Porzellantellern und wir tranken aus Porzellantassen mit Untertassen und hatten einen schönen kleinen Kaffeelöffel dazu und saßen stundenlang in bequemen gepolsterten Sesseln.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "692820dd-3b50-4ed4-9c2f-84c4ad3a82de",
                        "source_entry_id": "a9473b81-eeb6-3929-938b-dd81dea3946f",
                        "source_sense_id": "a460012d-d34c-3ea1-8f15-b617ae1b991e",
                        "source_sense_description": "ein kleiner Löffel, der zum Kaffeegeschirr passt",
                        "target_lang_word": "cuillère à café",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cuillère à café",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fde01fee-7dca-3f09-a7d5-8225376857e7",
                                        "entry_id": "9c09b6ef-8f95-3b58-8ec2-221ddd54f0ae",
                                        "glosses": [
                                            "Petite cuillère pour touiller un liquide (thé, café, etc.) pour en dissoudre le sucre ou pour en accélérer le refroidissement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8b5eaa42-5a5d-4ae1-860e-b94ea759b96e",
                                                "sense_id": "fde01fee-7dca-3f09-a7d5-8225376857e7",
                                                "text": "Le docteur tapait machinalement, avec sa cuillère à café, sur le bord de la table et la vieille bonne desservait lentement en cherchant à parler avec ses maîtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a6e24c5d-60a7-3a96-85dd-b2ae98ee2e0f",
                                        "entry_id": "9c09b6ef-8f95-3b58-8ec2-221ddd54f0ae",
                                        "glosses": [
                                            "Mesure de volume définie par la contenance d'une cuillère à café (généralement environ 3 ou 5 ml)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "58b6f6d9-8c28-41f6-addd-d165ef3dda3c",
                                                "sense_id": "a6e24c5d-60a7-3a96-85dd-b2ae98ee2e0f",
                                                "text": "De même aussi, il y a des digestifs médicamenteux et des digestifs hygiéniques. Je citerai, parmi les premiers, l'usage, immédiatement après le repas; d'une infusion chaude d’anis, d’angélique, de menthe, d’une cuillerée à café d’anisette, de curaçao ou d’élixir de Garus, dans une tasse à thé d’eau chaude, […]."
                                            },
                                            {
                                                "example_id": "6a4b3e33-636a-4148-85cb-91d718997503",
                                                "sense_id": "a6e24c5d-60a7-3a96-85dd-b2ae98ee2e0f",
                                                "text": "Préparation du massala : 1 cuillère à café de poivre du moulin, 1 cuillère à café de sel, 1 cuillère à café d’amchur (poudre de mangue séchée), 1 cuillère à café de cumin en poudre, 1/2 cuillère à café d’asafoetidia."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
