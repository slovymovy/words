                    },
                    {
                        "translation_id": "527fdb52-4114-49fd-98ae-70a8c65263d0",
                        "source_entry_id": "8cb38847-7a7b-3941-8b38-34073bee66fb",
                        "source_sense_id": "da87a8da-8281-3098-8dc4-e0d1011d7164",
                        "target_lang_word": "massette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "massette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "766b5bbe-e791-3736-ae87-f20fb45c8cb1",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Roseau de la famille des typhacées, des milieux humides dont l’inflorescence est en forme d’épi cylindrique, allongé et dense, situé au bout d’une longue tige."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87944f06-4399-47a4-8523-1f44bda81fdb",
                                                "sense_id": "766b5bbe-e791-3736-ae87-f20fb45c8cb1",
                                                "text": "Le sol s’affaisse en s’asséchant. Pour l’affermir, il faut d’abord brûler les choins, massettes, roseaux, et, pour cela, tenir le marais le plus à sec possible."
                                            },
                                            {
                                                "example_id": "c1665055-7bae-48bb-8c27-d93f06930618",
                                                "sense_id": "766b5bbe-e791-3736-ae87-f20fb45c8cb1",
                                                "text": "Les sentiers bordés de ronces, les massettes de roseaux, les lacets de souliers en pâte de réglisse, les chats –bref tout ce que j’aime encore aujourd’hui me redevint cher."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ef251116-dbb3-382e-ab9e-548f78f9ee88",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Gros marteau, (plus léger et avec un manche plus court que la masse), de tailleur de pierre, de cantonnier, de maçon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eb7ede55-31b7-4194-a0b0-40f3f69df15d",
                                                "sense_id": "ef251116-dbb3-382e-ab9e-548f78f9ee88",
                                                "text": "Les casseurs travaillent tantôt assis en utilisant une massette à manche court, tantôt debout avec une massette au manche long et flexible dont l’élasticité permet d’imprimer à la petite massette une force vive très grande."
                                            },
                                            {
                                                "example_id": "d5245c3a-f028-4e60-abb6-adf33c49e4ca",
                                                "sense_id": "ef251116-dbb3-382e-ab9e-548f78f9ee88",
                                                "text": "J’ai sur ma table de travail un précieux presse-papiers. C’est un cube allongé, en fer, percé en son centre d’un trou ovale. Sur chacune des faces extrêmes, un entonnoir assez profond est creusé dans le métal refoulé. C’est la massette du grand-père André, qui frappa pendant cinquante ans la dure tête des ciseaux d’acier."
                                            },
                                            {
                                                "example_id": "a55bd105-6e6b-4502-8dd5-d12671462700",
                                                "sense_id": "ef251116-dbb3-382e-ab9e-548f78f9ee88",
                                                "text": "Sol considéra la burette, la massette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7607b828-a59b-34d2-bf11-8dff91c9a5d6",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Marteau équipant les machines casse-pierres."
                                        ],
                                        "tags": [
                                            "Industrie minière"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "461849c4-2f68-3e58-ba9a-d4b11b56a7fb",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Couteau grattoir utilisé en maroquinerie pour la préparation des peaux."
                                        ],
                                        "tags": [
                                            "Travail du cuir"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "627e655a-3283-347c-afa7-63bf2ab12817",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Massue légère et cannelée utilisée dans les tournois de chevalerie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "046c284a-9954-3723-8ca2-a258e3e0e962",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Baguette de tambourin."
                                        ],
                                        "tags": [
                                            "Provence"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e031a9fd-a4b0-3adc-9412-6f64b0a787b6",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Voir roseau à massette."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2fdecba5-c214-3cbf-b7ca-facc0484b2cf",
                                        "entry_id": "e3564ec1-ba04-3743-810f-ce9113e6f5db",
                                        "glosses": [
                                            "Meuble représentant l’outil de frappe du même nom dans les armoiries. Similaire à la masse dont elle ne se distingue que par un rapport de proportionnalité entre le manche et le fer plus faible (le manche de la masse est plus long que celui de la massette). Mais il est difficile de choisir entre les deux tant les représentations sont proches. À rapprocher de maillet, marteau et masse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "096555e6-7c00-45e7-b08a-23b6bd96a411",
                                                "sense_id": "2fdecba5-c214-3cbf-b7ca-facc0484b2cf",
                                                "text": "Coupé d’azur, à un aqueduc à huit arches d’or maçonné de sable, et de gueules, à une massette de carrier d’or emmanchée d’argent, mise en pal la tête en bas, adextrée d’un fer de moulin d’or et sénestrée d’une tête en rencontre de bélier d’argent accornée d’or, qui est de la commune de Le Syndicat des Vosges"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
