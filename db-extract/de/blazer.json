                                    },
                                    {
                                        "sense_id": "82a656a5-77b4-3656-9f4a-cc810c26026f",
                                        "entry_id": "06171539-ca97-3aab-9551-5f61c3f1db85",
                                        "glosses": [
                                            "One who spreads news, or blazes matters abroad."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94c8a177-f59a-411b-b688-0092e8de9813",
                                                "sense_id": "82a656a5-77b4-3656-9f4a-cc810c26026f",
                                                "text": "blazers of crime"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c43ada1a-415c-3717-b861-69e09fefce51",
                                        "entry_id": "06171539-ca97-3aab-9551-5f61c3f1db85",
                                        "glosses": [
                                            "An older member of a sporting club, often with old-fashioned or conservative views."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc937dcc-2d69-35d4-abb7-4cd62c431ac3",
                                        "entry_id": "06171539-ca97-3aab-9551-5f61c3f1db85",
                                        "glosses": [
                                            "A con or swindle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9011568c-505a-45ae-8da9-af291f1ea858",
                                                "sense_id": "cc937dcc-2d69-35d4-abb7-4cd62c431ac3",
                                                "text": "\"What'd I tell you?\" said Bill. \"The old wolverine was tryin' to run a blazer on us. All he needed was to be showed we meant business. And he can't make no trouble for us when he gets out, 'cause our two words are better'n his.\""
                                            },
                                            {
                                                "example_id": "e7dd7a75-ad40-46b4-aee8-30f6f54dcdc4",
                                                "sense_id": "cc937dcc-2d69-35d4-abb7-4cd62c431ac3",
                                                "text": "These folks don't take kindly to no brash stranger comin' in here tryin' to run a blazer on 'em."
                                            },
                                            {
                                                "example_id": "a7fec2f3-48de-49ec-add4-c38568c314fb",
                                                "sense_id": "cc937dcc-2d69-35d4-abb7-4cd62c431ac3",
                                                "text": "Bad, he doubtless was. But when he tried to run a blazer on this grim little cowman, Slaughter had run him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
