                "senses": [
                    {
                        "sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
                        "entry_id": "960885f3-3342-3d36-ab11-a5e6d070830e",
                        "glosses": [
                            "ein bewegtes Band, das zum Transport dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aac38e69-abd6-4a31-8cf6-6815032d151b",
                                "sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
                                "text": "Moderne Supermärkte haben an den Kassen Fließbänder, welche die Ware zu den Kassiererinnen tragen."
                            },
                            {
                                "example_id": "d5c07b5d-f410-4461-a450-9b241204bd0c",
                                "sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
                                "text": "„Die Tischplatte war aus Gummi, der Tisch bewegte sich, der Tisch war ein Fließband.“"
                            },
                            {
                                "example_id": "7df64f68-87d0-43d5-a8e3-9b44e7d02801",
                                "sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
                                "text": "„Tagsüber baute er am Fließband standardisierte Teile zusammen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf5219be-b845-4d78-bf97-fb712b1fa71b",
                        "source_entry_id": "960885f3-3342-3d36-ab11-a5e6d070830e",
                        "source_sense_id": "4267a7c8-7564-39c3-8248-aea7117d87b9",
