                        "form": "das Hohlspitzgeschoss"
                    },
                    {
                        "form_id": "55f6e74c-1250-40bd-b52a-cb62ef899151",
                        "entry_id": "c8514c7f-a933-35c1-b733-583eca41ef4a",
                        "tags": [
                            "accusative",
