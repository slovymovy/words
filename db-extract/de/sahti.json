                ],
                "senses": [
                    {
                        "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                        "entry_id": "6e535181-8fb1-3e0a-ba3e-e32a05d97afe",
                        "glosses": [
                            "traditionelle finnische Biersorte, die mit Wacholder gewürzt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "466d6c05-5019-4a5a-8529-c4b801de641e",
                                "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                                "text": "Sahti ist heute wieder ein Bierstil, den viele finnische Brauer herstellen."
                            },
                            {
                                "example_id": "9a5deddd-f834-4927-8674-ecf2465e32dd",
                                "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                                "text": "Das finnische Bier Sahti, das bereits seit über 1000 Jahren existiert, ist das älteste Bier, das nach wie vor hergestellt wird."
                            },
                            {
                                "example_id": "9a5152af-471c-4bf3-87a8-702d88dc545b",
                                "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                                "text": "Sahti – die finnische Spezialität: Stark eingemaischt, über Wacholderzweigen geläutert und mit Wacholder zusätzlich zum oder anstelle von Hopfen gewürzt, mit robuster Hefe (teilweise sogar Bäckerhefe) kurz und kräftig vergoren (oder zunächst unvergoren zum daheim weiter Vergären verkauft), und schließlich nahezu ungespundet getrunken – mit einem Alkoholgehalt von 8 bis 10 Prozent."
                            },
                            {
                                "example_id": "6600fae0-3138-44bb-90f8-619c8efbf06e",
                                "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                                "text": "Die Kleinbrauerei \"Lammin Sahti\" kann sich durch ihr beliebtes, traditionell gebrautes Bier \"Sahti\" jedoch sehr gut gegen die zahlreichen Großbrauereien behaupten."
                            },
                            {
                                "example_id": "d50366c8-7f71-4169-b796-a2ed15efa670",
                                "sense_id": "5c1702ed-dfab-3680-bbd1-83228b09dd6b",
                                "text": "Wer nicht weiss was Sahti ist: Ein fast ausgestorbener Bierstil aus Finnland."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
