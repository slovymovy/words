                                        ],
                                        "tags": [
                                            "in Redewendungen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b7aaf78-3ee7-4f35-b1be-b7c3e9ba458a",
                                                "sense_id": "9b2a7f43-f7a5-3e6a-8e4e-9f271fa4cb8d",
                                                "text": "Wir müssen unbedingt Zeit schinden, um mit dem Problem noch fertig zu werden."
                                            },
                                            {
                                                "example_id": "bf1bb93b-5791-42d2-9cd3-ee29ee6ac0e3",
                                                "sense_id": "9b2a7f43-f7a5-3e6a-8e4e-9f271fa4cb8d",
                                                "text": "Er band sorgfältig seine Fliege, denn heute galt es, Eindruck zu schinden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "84d51d8e-e478-32c0-8c50-9225cdadf273",
                                        "entry_id": "c781f5fc-055a-3d89-8d4a-64258a8f517f",
                                        "glosses": [
                                            "Haut oder Rinde abziehen"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e50e8cd0-78b6-43bb-bbc2-4a11457f61fd",
                                                "sense_id": "84d51d8e-e478-32c0-8c50-9225cdadf273",
                                                "text": "„Die beiden Männer trennen die Haut an Bauch und Beinen entlang auf und fangen an, das Tier zu schinden.“"
                                            }
