                                    },
                                    {
                                        "sense_id": "45f48528-82e6-39d6-9ef7-30312419c089",
                                        "entry_id": "e3be59a9-5521-3fa9-b1f7-c75beaa47d40",
                                        "glosses": [
                                            "A line showing where the water has been, usually a line separating dry land and wet areas; a watermark or tidemark."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "420b82e8-e84a-489d-a946-6e424e583e64",
                                                "sense_id": "45f48528-82e6-39d6-9ef7-30312419c089",
                                                "text": "Down here along the waterline, the Enterprise has a belt of thick antitorpedo armor. It's not too promising."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "89014ce3-11fe-3fb9-9ccd-fa38b455cce9",
