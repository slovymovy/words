                ],
                "senses": [
                    {
                        "sense_id": "706d9c67-dc44-3aed-abbe-8751cd344db1",
                        "entry_id": "3b22633a-73fc-347f-80d7-c5c168211b3b",
                        "glosses": [
                            "действие по значению гл. формировать; образование, установление, организация чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "888f2f0a-1aae-4870-877b-d0921b1d2207",
                                "sense_id": "706d9c67-dc44-3aed-abbe-8751cd344db1",
                                "text": "Второй фактор, влияющий на формирование цены не в пользу покупателя, — таможенные тарифы и пошлины."
                            },
                            {
                                "example_id": "78bfee7a-9f04-4f0b-a3bd-6e3d03131bb6",
                                "sense_id": "706d9c67-dc44-3aed-abbe-8751cd344db1",
                                "text": "Жители Львова, напуганные приходом казаков, Сейм, влиятельнейшие польские вельможи — все требуют от короля прекратить формирование странного войска."
                            }
                        ]
                    },
                    {
                        "sense_id": "1a1d6ae2-dff0-3650-8e8f-1a2d3f1e6c8d",
                        "entry_id": "3b22633a-73fc-347f-80d7-c5c168211b3b",
                        "glosses": [
                            "канц. то же, что отряд, подразделение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a845fc6d-9121-4e61-b169-e7e8f91529ae",
                                "sense_id": "1a1d6ae2-dff0-3650-8e8f-1a2d3f1e6c8d",
                                "text": "В нашем бараке сорок ребят записались в добровольческое формирование."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a44eb443-3dc1-4a49-9acd-ea369901bc73",
                        "source_entry_id": "3b22633a-73fc-347f-80d7-c5c168211b3b",
                        "source_sense_description": "создание",
                        "target_lang_word": "Aufstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aufstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dadf8aa5-eefc-3f9e-826b-56047e65ea02",
                                        "entry_id": "f48d4515-5a94-3092-9644-a55c5a99c36d",
                                        "glosses": [
                                            "Auflistung von Daten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5278fa5-417a-42bf-b102-ed5fc6fce92e",
                                                "sense_id": "dadf8aa5-eefc-3f9e-826b-56047e65ea02",
                                                "text": "Wir benötigen dringend eine vollständige Aufstellung aller Außenstände."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "4341d713-7b51-3229-ad35-39077d07bbe6",
                                        "entry_id": "f48d4515-5a94-3092-9644-a55c5a99c36d",
                                        "glosses": [
                                            "Zusammenstellung einer Mannschaft"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3d2b5c9-4200-4766-8cdd-05635b2d255f",
                                                "sense_id": "4341d713-7b51-3229-ad35-39077d07bbe6",
                                                "text": "Die Aufstellungen der Mannschaften wurden erst kurz vor Beginn des Spiels veröffentlicht."
                                            },
                                            {
                                                "example_id": "1a7ad067-9f82-4ec5-9315-1bb96efd2a6a",
                                                "sense_id": "4341d713-7b51-3229-ad35-39077d07bbe6",
                                                "text": "„Auch bei der Aufstellung seiner Mitarbeiter ließ man ihm freie Hand.“"
                                            },
                                            {
                                                "example_id": "e625cd62-7194-480c-a771-7043101ef676",
                                                "sense_id": "4341d713-7b51-3229-ad35-39077d07bbe6",
                                                "text": "„Der Fußballspieler Lucien Favre ist in den frühen Siebzigern sozialisiert worden, die Aufstellung der brasilianischen Weltmeistermannschaft von 1970 rasselt er immer noch im Schlaf herunter.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "544323fd-3446-374e-826a-6158c5f48372",
                                        "entry_id": "f48d4515-5a94-3092-9644-a55c5a99c36d",
                                        "glosses": [
                                            "Vorschlag eines Kandidaten zur Wahl"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9573686-0797-4f1b-a58a-c0edf308f802",
                                                "sense_id": "544323fd-3446-374e-826a-6158c5f48372",
                                                "text": "Auf der nächsten Versammlung wird die Aufstellung des Kandidaten/der Kandidatin beraten."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f09278f2-6e42-4ce6-a17f-014b067a7767",
                        "source_entry_id": "3b22633a-73fc-347f-80d7-c5c168211b3b",
                        "source_sense_description": "создание",
                        "target_lang_word": "Auflistung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Auflistung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                                        "entry_id": "23edd679-3515-3461-820d-ba0f07cc476c",
                                        "glosses": [
                                            "listenartige Anordnung von Informationen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d3b8bc8-2246-474b-901e-147d1acb0de4",
                                                "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                                                "text": "Hier finden Sie eine Auflistung unserer Sponsoren."
                                            },
                                            {
                                                "example_id": "c8aae5db-2b9c-4263-97a8-b393d2d11b8f",
                                                "sense_id": "683065bc-90c5-38bf-b554-c6543a439220",
                                                "text": "„In Lernets Baron Bagge gibt es eine Auflistung ungarischer Ortsnamen, die so suggestiv wirkt wie leise wirbelnde pentatonische Musik.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc0532c4-b1cf-40c7-8699-5b47ec274de7",
                        "source_entry_id": "3b22633a-73fc-347f-80d7-c5c168211b3b",
                        "source_sense_description": "создание",
                        "target_lang_word": "Zusammenstellung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zusammenstellung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "62d2426a-1984-345b-9b20-76b448752ebe",
                                        "entry_id": "5cee8cc0-ee20-3fd4-8132-f893aa8caed4",
                                        "glosses": [
                                            "die Anordnung von Ausgewähltem"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "516168fb-f52b-4d64-81b5-86355391c621",
                                                "sense_id": "62d2426a-1984-345b-9b20-76b448752ebe",
                                                "text": "Die Zusammenstellung der Bilder kann als gelungen betrachtet werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                        "entry_id": "5cee8cc0-ee20-3fd4-8132-f893aa8caed4",
                                        "glosses": [
                                            "das Anordnen von Ausgewähltem, der Vorgang von ^([1])"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "53dc72f6-fdf1-41d8-9cfd-9bbb4a721b4f",
                                                "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                                "text": "Die Zusammenstellung der Bilder übernahm der Künstler selbst."
                                            },
                                            {
                                                "example_id": "170c678c-858f-453b-886e-6c8ad01b7488",
                                                "sense_id": "be20deb2-dbf1-3359-8384-9214b619ecb1",
                                                "text": "„Nicht von ungefähr sind es, zumindest in Deutschland, vor allem unterbeschäftigte Postbeamte, die durch die Zusammenstellung und private Publikation von Eisenbahnkursbüchern ihr schmales Salär aufbessern.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
