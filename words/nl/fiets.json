                    "sense_id": "590d882e-6eaf-3099-a470-75292730f2c3",
                    "sense_definition": "Tweewielig vervoermiddel dat door middel van spierkracht via pedalen wordt voortbewogen",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "vehicle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik ga elke ochtend met de <w>fiets</w> naar mijn werk.",
                            "target_lang_translations": {
                                "en": "I go to work by <w>bike</w> every morning.",
                                "ru": "Я каждое утро езжу на работу на <w>велосипеде</w>.",
                                "pl": "Każdego ranka jeżdżę do pracy <w>rowerem</w>.",
                                "de": "Ich fahre jeden Morgen mit dem <w>Fahrrad</w> zur Arbeit.",
                                "fr": "Je vais au travail à <w>vélo</w> tous les matins.",
                                "it": "Vado al lavoro in <w>bicicletta</w> ogni mattina.",
                                "cs": "Každé ráno jezdím do práce na <w>kole</w>.",
                                "tr": "Her sabah işe <w>bisikletle</w> giderim.",
                                "es": "Voy al trabajo en <w>bicicleta</w> todas las mañanas."
                            }
                        },
                        {
                            "text": "Zet je <w>fiets</w> goed op slot als je de stad in gaat.",
                            "target_lang_translations": {
                                "en": "Lock your <w>bike</w> securely when you go into town.",
                                "ru": "Хорошо пристегни свой <w>велосипед</w>, когда отправляешься в город.",
                                "pl": "Dobrze przypnij swój <w>rower</w>, kiedy idziesz do miasta.",
                                "de": "Schließe dein <w>Fahrrad</w> gut ab, wenn du in die Stadt gehst.",
                                "fr": "Attache bien ton <w>vélo</w> quand tu vas en ville.",
                                "it": "Lega bene la tua <w>bici</w> quando vai in città.",
                                "cs": "Když jdeš do města, dobře si <w>kolo</w> zamkni.",
                                "tr": "Şehre gittiğinde <w>bisikletini</w> iyi kilitle.",
                                "es": "Asegura bien tu <w>bici</w> con candado cuando vayas al centro."
                            }
                        }
                    ],
                    "synonyms": [
                        "rijwiel",
                        "tweewieler",
                        "stalen ros"
                    ],
                    "common_phrases": [
                        "op de fiets",
                        "met de fiets",
                        "elektrische fiets",
                        "nieuwe fiets",
                        "fiets huren"
