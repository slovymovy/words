{
    "word_family": [
        "resilience",
        "resiliency",
        "resiliently"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6e4c7556-76e4-3136-b782-4508e42ab12f",
                    "sense_definition": "Able to recover quickly from difficult conditions, setbacks, or damaging events.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "recovery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local economy proved to be <w>resilient</w> despite the global financial crisis.",
                            "target_lang_translations": {
                                "ru": "Местная экономика оказалась <w>стойкой</w>, несмотря на мировой финансовый кризис."
                            }
                        },
                        {
                            "text": "She is a <w>resilient</w> person who always finds a way to stay positive after a failure.",
                            "target_lang_translations": {
                                "ru": "Она <w>жизнестойкий</w> человек, который всегда находит способ сохранять позитив после неудачи."
                            }
                        }
                    ],
                    "synonyms": [
                        "strong"
                    ],
                    "antonyms": [
                        "fragile"
                    ],
                    "common_phrases": [
                        "resilient person",
                        "resilient economy",
                        "remain resilient"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный быстро восстанавливаться после трудных условий, неудач или разрушительных событий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойкий",
                                "target_lang_sense_clarification": "о характере или системе"
                            },
                            {
                                "target_lang_word": "жизнестойкий",
                                "target_lang_sense_clarification": "способный преодолевать трудности"
                            },
                            {
                                "target_lang_word": "несокрушимый",
                                "target_lang_sense_clarification": "устойчивый к внешним воздействиям"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "131c7ac2-026c-3530-a8e2-148d284092b6",
                    "sense_definition": "Returning quickly to its original shape after being bent, stretched, or compressed.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical properties",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This <w>resilient</w> material is perfect for making high-quality running shoes.",
                            "target_lang_translations": {
                                "ru": "Этот <w>упругий</w> материал идеально подходит для изготовления высококачественных кроссовок."
                            }
                        },
                        {
                            "text": "The <w>resilient</w> fibers of the carpet allow it to bounce back after heavy furniture is moved.",
                            "target_lang_translations": {
                                "ru": "<w>Упругие</w> волокна ковра позволяют ему восстанавливать форму после того, как передвинули тяжелую мебель."
                            }
                        }
                    ],
                    "synonyms": [
                        "bendable",
                        "flexible"
                    ],
                    "antonyms": [
                        "brittle"
                    ],
                    "common_phrases": [
                        "resilient material",
                        "resilient fabric"
                    ],
                    "target_lang_definitions": {
                        "ru": "Быстро возвращающийся в первоначальную форму после сгибания, растяжения или сжатия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "упругий",
                                "target_lang_sense_clarification": "о материале или ткани"
                            },
                            {
                                "target_lang_word": "эластичный",
                                "target_lang_sense_clarification": "способный растягиваться и восстанавливаться"
                            },
                            {
                                "target_lang_word": "гибкий",
                                "target_lang_sense_clarification": "легко гнущийся без повреждений"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}