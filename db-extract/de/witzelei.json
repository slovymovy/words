                "senses": [
                    {
                        "sense_id": "3319ff48-4011-3e34-99e1-f771084dc8cc",
                        "entry_id": "0dc00faa-6d59-3ecb-abff-0d236ee8f934",
                        "glosses": [
                            "witzige Bemerkung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f55d0d1c-4e70-4974-b0e1-c30f2256d546",
                                "sense_id": "3319ff48-4011-3e34-99e1-f771084dc8cc",
                                "text": "„Die vielen Jahre hindurch, in denen sie seine Geliebte war, haben sie aus ihrem Verhältnis nicht das geringste Geheimnis gemacht, aber die Ehe läßt sie jetzt erröten, und sie flüchten sich in Witzeleien.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "8f6ee444-1a99-3068-8961-dc2a2ecad9d5",
                        "entry_id": "0dc00faa-6d59-3ecb-abff-0d236ee8f934",
                        "glosses": [
                            "anhaltendes/wiederholtes Witzemachen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b529b3fd-8c41-4e36-9480-b227a1e5e24a",
                                "sense_id": "8f6ee444-1a99-3068-8961-dc2a2ecad9d5",
                                "text": "Diese ständige Witzelei gefällt mir nicht mehr."
                            },
                            {
                                "example_id": "d17f5a28-7eec-47a0-97a3-44a4ed7bd0ac",
                                "sense_id": "8f6ee444-1a99-3068-8961-dc2a2ecad9d5",
                                "text": "„Auf das Lieblingsthema des Vaters, geringschätzige Witzeleien über die Militärs der Gegenwart und besonders über Bonaparte, ging er nicht ein.“"
                            },
                            {
                                "example_id": "47f81697-a2b2-4f71-ac3d-4507ba7a40b5",
                                "sense_id": "8f6ee444-1a99-3068-8961-dc2a2ecad9d5",
                                "text": "„Spott und superiore Witzelei waren allein der richtige Ton, und als ihm dies feststand, fiel zum erstenmal der Vorhang.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
