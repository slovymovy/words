                    {
                        "translation_id": "d56f6c5f-ecff-4d67-998f-b7abd15c5c53",
                        "source_entry_id": "c14d8bf2-575e-3195-90cc-1bcb1dc58f3d",
                        "source_sense_id": "5eed6d4f-b0f2-3c51-ad7f-2bf288db5e07",
