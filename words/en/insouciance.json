{
    "word_family": [
        "insouciant"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0536c22a-f64b-3c88-8a9f-eb5bc89874c7",
                    "sense_definition": "A state of being indifferent, careless, or lacking concern.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He treated the serious situation with a surprising <w>insouciance</w> that angered his colleagues.",
                            "target_lang_translations": {
                                "nl": "Hij ging met een verrassende <w>onverschilligheid</w> om met de ernstige situatie, wat zijn collega's boos maakte."
                            }
                        },
                        {
                            "text": "The politician faced the scandal with a total <w>insouciance</w> that shocked the public.",
                            "target_lang_translations": {
                                "nl": "De politicus ging het schandaal tegemoet met een totale <w>achteloosheid</w> die het publiek schokte."
                            }
                        }
                    ],
                    "synonyms": [
                        "indifference",
                        "carelessness",
                        "heedlessness"
                    ],
                    "antonyms": [
                        "concern",
                        "anxiety"
                    ],
                    "common_phrases": [
                        "total insouciance",
                        "surprising insouciance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een toestand van onverschilligheid, zorgeloosheid of een gebrek aan bezorgdheid."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "onverschilligheid",
                                "target_lang_sense_clarification": "het gebrek aan interesse of bezorgdheid"
                            },
                            {
                                "target_lang_word": "achteloosheid",
                                "target_lang_sense_clarification": "het niet oplettend of zorgvuldig zijn"
                            },
                            {
                                "target_lang_word": "zorgeloosheid",
                                "target_lang_sense_clarification": "het gebrek aan bezorgdheid of ernst"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e431d892-59bd-3bb2-a1f3-d0dd957cfca7",
                    "sense_definition": "A relaxed and calm state of being; nonchalance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "indifference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She walked onto the stage with an easy <w>insouciance</w> that charmed the entire audience.",
                            "target_lang_translations": {
                                "nl": "Ze betrad het podium met een vanzelfsprekende <w>nonchalance</w> die het hele publiek bekoorde."
                            }
                        },
                        {
                            "text": "The cat watched the dog with complete <w>insouciance</w> while resting on the fence.",
                            "target_lang_translations": {
                                "nl": "De kat keek vanaf het hek met volkomen <w>onbekommerdheid</w> toe naar de hond."
                            }
                        }
                    ],
                    "synonyms": [
                        "nonchalance",
                        "composure",
                        "coolness"
                    ],
                    "antonyms": [
                        "nervousness",
                        "agitation"
                    ],
                    "common_phrases": [
                        "easy insouciance",
                        "complete insouciance"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een ontspannen en kalme houding; nonchalance."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "nonchalance",
                                "target_lang_sense_clarification": "ontspannen, schijnbaar ongeïnteresseerde houding"
                            },
                            {
                                "target_lang_word": "onbekommerdheid",
                                "target_lang_sense_clarification": "vrij van zorgen of spanning"
                            },
                            {
                                "target_lang_word": "luchtigheid",
                                "target_lang_sense_clarification": "ontspannen, niet al te serieuze houding"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}