                "senses": [
                    {
                        "sense_id": "4b67f657-cc14-359c-8bf7-2f87215ad6a8",
                        "entry_id": "efec2f81-3082-3286-a4a7-aec9dbb6ae94",
                        "glosses": [
                            "Krampus (beast in the folklore of Alpine countries)"
                        ],
                        "tags": [
                            "Austria",
                            "Bavaria",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "f71626c3-2c4a-4746-8e0e-e8095cdc1f8c",
                                "sense_id": "4b67f657-cc14-359c-8bf7-2f87215ad6a8",
                                "text": "Nikolo der leibhaftige Krampus gekommen und habe, anstatt ein Geschenk zu bringen, nur „Geld und Blut“ gefordert.",
                                "translation": "Saint Nicholas became the Krampus personified and, instead of bringing a gift, just demanded \"gold and blood\".",
                                "english": "Saint Nicholas became the Krampus personified and, instead of bringing a gift, just demanded \"gold and blood\"."
                            },
                            {
                                "example_id": "d2a5cda0-c1de-46a7-bbb7-0dc869af71dd",
                                "sense_id": "4b67f657-cc14-359c-8bf7-2f87215ad6a8",
                                "text": "Dann kamen sie, der Krampus und - voran - der Nikolo.",
                                "translation": "Then they came, the Krampus and - before him - Saint Nicholas.",
                                "english": "Then they came, the Krampus and - before him - Saint Nicholas."
                            },
                            {
                                "example_id": "2a3fc24b-959f-4b4d-a689-ab1c3ce5758d",
                                "sense_id": "4b67f657-cc14-359c-8bf7-2f87215ad6a8",
                                "text": "Doch Weihnachten rückte immer näher und die Krampusse zogen wütend durch die Reichenhaller Fußgängerzone.",
                                "translation": "But Christmas was drawing ever closer and the Krampuses milled furiously around the pedestrian precinct of Bad Reichenhall.",
                                "english": "But Christmas was drawing ever closer and the Krampuses milled furiously around the pedestrian precinct of Bad Reichenhall."
                            }
                        ]
                    }
