{
    "word_family": [
        "born",
        "bear"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "5e602cbd-9712-31c5-8d14-8a78bfddabf5",
                    "sense_definition": "Existing naturally in someone or something from birth; innate.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She displayed an <w>inborn</w> talent for playing the piano at an early age.",
                            "target_lang_translations": {
                                "zh": "她在很小的时候就展现出弹钢琴的<w>天生</w>才华。"
                            }
                        },
                        {
                            "text": "Most animals rely on an <w>inborn</w> instinct to survive in the wild.",
                            "target_lang_translations": {
                                "zh": "大多数动物依靠<w>与生俱来</w>的本能在野外生存。"
                            }
                        }
                    ],
                    "synonyms": [
                        "innate"
                    ],
                    "antonyms": [
                        "acquired",
                        "learned"
                    ],
                    "common_phrases": [
                        "inborn talent",
                        "inborn instinct"
                    ],
                    "target_lang_definitions": {
                        "zh": "与生俱来的；天生的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "天生的",
                                "target_lang_sense_clarification": "指能力、特质自然生来就具有"
                            },
                            {
                                "target_lang_word": "与生俱来的",
                                "target_lang_sense_clarification": "指本能、特性等出生时就自带"
                            },
                            {
                                "target_lang_word": "生来的",
                                "target_lang_sense_clarification": "指自出生起就具有的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7d58e5f8-da1b-34ac-894d-099ea63437ec",
                    "sense_definition": "Transmitted genetically from parents to offspring; hereditary.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "nature_origin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The child was diagnosed with an <w>inborn</w> error of metabolism shortly after delivery.",
                            "target_lang_translations": {
                                "zh": "这个孩子在出生后不久就被诊断出患有<w>先天性</w>代谢缺陷。"
                            }
                        },
                        {
                            "text": "Doctors suspected that the heart condition was <w>inborn</w> rather than caused by an infection.",
                            "target_lang_translations": {
                                "zh": "医生怀疑这种心脏疾病是<w>先天性</w>的，而不是由感染引起的。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "inborn error of metabolism"
                    ],
                    "target_lang_definitions": {
                        "zh": "（疾病或缺陷）先天的；遗传的"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "先天的",
                                "target_lang_sense_clarification": "医学上指自胚胎或出生时即存在的生理、遗传缺陷"
                            },
                            {
                                "target_lang_word": "遗传的",
                                "target_lang_sense_clarification": "由父母基因遗传的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}