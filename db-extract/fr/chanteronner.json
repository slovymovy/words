                ],
                "senses": [
                    {
                        "sense_id": "66eee1d7-f93f-39b8-b9b6-c1c001cd991a",
                        "entry_id": "6074d3d5-9fa6-3d96-89f7-d6fead64d194",
                        "glosses": [
                            "Chantonner à mi-voix."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3187796c-27e1-4a86-bc65-8cdc656e0826",
                                "sense_id": "66eee1d7-f93f-39b8-b9b6-c1c001cd991a",
                                "text": "Charles, après avoir fait mille tours dans sa chambre en chanteronnant, descendit enfin."
                            },
                            {
                                "example_id": "67f604df-b852-47ce-b016-84cd7e87aa46",
                                "sense_id": "66eee1d7-f93f-39b8-b9b6-c1c001cd991a",
                                "text": "Et l’Illustre Gaudissart s’en alla sautillant, chanteronnant le Roi des mers, prends plus bas ! à l’auberge du Soleil-d’Or, où il causa naturellement avec l’hôte en attendant le dîner."
                            },
                            {
                                "example_id": "fa5a9cc2-9ebb-4825-8bf4-d24c95877996",
                                "sense_id": "66eee1d7-f93f-39b8-b9b6-c1c001cd991a",
                                "text": "David, qui de sa vie n’avait su ce qu’était un air, sortit en chanteronnant, ce qui surprit l’honnête Postel, et lui donna de violents soupçons sur les relations d’Ève et de l’imprimeur."
                            },
                            {
                                "example_id": "11069221-bbb2-4c77-8168-b0fbc8b27b44",
                                "sense_id": "66eee1d7-f93f-39b8-b9b6-c1c001cd991a",
                                "text": "L’amour ne connaît pas ces distances-là, chanteronna Adrien."
                            }
                        ]
                    }
                ],
