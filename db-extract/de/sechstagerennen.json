                        "tags": [],
                        "examples": [
                            {
                                "example_id": "13fbfb39-0719-4c2d-a564-5b2a9f2f5588",
                                "sense_id": "79de1ba7-ba20-3dbc-a6a1-13222c4a483a",
                                "text": "„Zudem wurde er mehrfach Weltmeister in der Einerverfolgung auf der Bahn und fuhr bei insgesamt 23 Sechstagerennen Siege ein.“"
                            },
                            {
                                "example_id": "d61470ab-b95c-437a-ad06-807ac698f726",
                                "sense_id": "79de1ba7-ba20-3dbc-a6a1-13222c4a483a",
                                "text": "„Ernest und Sylvia sprachen eine Weile über das aufregende Finale des Sechstagerennens im Vél d'Hiv, das sie sich Anfang des Monats angesehen hatten.“"
                            },
                            {
                                "example_id": "b0af4eeb-187c-44bb-9f4f-ab3d637f431d",
                                "sense_id": "79de1ba7-ba20-3dbc-a6a1-13222c4a483a",
                                "text": "„Das alles und die Sechstagerennen kommen noch."
                            }
