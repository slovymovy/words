                "senses": [
                    {
                        "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                        "entry_id": "0bb70db0-0450-3f9b-abf3-c5bce4ae82f4",
                        "glosses": [
                            "An example; a pattern or model for imitation."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "4c0da429-50df-42b4-a904-6b4cb3df4fb9",
                                "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                                "text": "1899, Dante Gabriel Rossetti (transl.), The New Life (La Vita Nuova) of Dante Alighieri, Siddall edition, page 111.\nBy which ensamples this thing shall be made manifest unto such as may be offended at any part of this my book."
                            },
                            {
                                "example_id": "d7aa14c9-5ff0-48e7-9f61-ce88c4353a74",
                                "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                                "text": "1662 Book of Common Prayer, Collect for the Second Sunday after Easter\nAlmighty God, who hast given thine only Son to be unto us both a sacrifice for sin, and also an ensample of godly life:"
                            },
                            {
                                "example_id": "8b19307f-2708-4ca5-a359-8d988f073b84",
                                "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                                "text": "I hope that it may be taken by all of us as a lesson, and an ensample, and a teaching of the Lord's mercy."
                            },
                            {
                                "example_id": "878194f4-c117-46bf-b74a-138e4af99b6e",
                                "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                                "text": "Being ensamples to the flock."
                            },
                            {
                                "example_id": "1c5f461f-dfa9-4d34-8d28-e278fc520535",
                                "sense_id": "159c1b17-7971-3f23-90b7-fe617ff086fe",
                                "text": "The bold ensample of their father's might / Their weapons whetted and their wrath increas'd."
                            }
                        ]
                    }
                ],
