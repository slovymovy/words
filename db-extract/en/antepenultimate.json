    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "a8838677-ed59-3754-b2b6-0a6ff622e1a9",
                "word": "antepenultimate",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                        "entry_id": "a8838677-ed59-3754-b2b6-0a6ff622e1a9",
                        "glosses": [
                            "Two before the last, i.e., the one immediately before the penultimate, in a series."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "0964f95b-0b6a-4298-9873-552bf6be3d4a",
                                "sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                                "text": "This book has ten chapters — chapter 8 is the antepenultimate one."
                            },
                            {
                                "example_id": "fac978e0-0f8b-4ec6-bda0-eee54cf8613e",
                                "sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                                "text": "[…] they [the sounds of an echo] next strike the ultimate secondary object, then the penultimate and antepenultimate; […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "db868be1-3e9a-48c3-8c23-fe53d039df0e",
                        "source_entry_id": "a8838677-ed59-3754-b2b6-0a6ff622e1a9",
                        "source_sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                        "source_sense_description": "two before the last",
                        "target_lang_word": "derdelaatste",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "f84c6cb8-9276-4278-9b9b-22f26d8eaeb1",
                        "source_entry_id": "a8838677-ed59-3754-b2b6-0a6ff622e1a9",
                        "source_sense_id": "0ad9de70-e2a5-3f23-b8ac-4f0b5112d4fd",
                        "source_sense_description": "two before the last",
                        "target_lang_word": "antépénultième",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antépénultième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                        "entry_id": "122c1bb2-0a59-3707-b4bc-e6b4fd34f679",
                                        "glosses": [
                                            "Troisième en comptant de la fin. Qui précède immédiatement le pénultième."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddc8b2c4-3a31-4e38-8f89-d79751e65450",
                                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                                "text": "C’est, selon la terminologie de Fourier, l’état antépénultième du refroidissement."
                                            },
                                            {
                                                "example_id": "ac64d07c-413b-4a12-8a20-67eba76a0827",
                                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                                "text": "Vince Taylor passa en vedette à l’Olympia, avec, en vedette américaine, Henri Tisot, l’imitateur du général De Gaulle et en vedette anglaise, à l’antépénultième place, Rosalie Dubois une ancienne poissonnière […]"
                                            },
                                            {
                                                "example_id": "5a165429-e98a-4402-a4cf-c586fde3a6ea",
                                                "sense_id": "14cf71c0-5a60-399b-aaca-238662a87764",
                                                "text": "Les lois de programmation mentionnées à l’antépénultième alinéa de l’article 34 de la Constitution ont pour objet de déterminer « les objectifs de l’action de l’État »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antépénultième",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32c38f08-ec79-3fd8-8749-6c85fccbcefc",
                                        "entry_id": "da257ebb-38d4-3b3a-938d-7c2fc9179aa0",
                                        "glosses": [
                                            "Troisième depuis la fin."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9ba78ff1-8228-3f68-92aa-b68c0b05606a",
                                        "entry_id": "da257ebb-38d4-3b3a-938d-7c2fc9179aa0",
                                        "glosses": [
                                            "Troisième syllabe en comptant de la fin d’un mot."
                                        ],
                                        "tags": [
                                            "Au féminin"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a72cff05-c535-4af7-b5f3-cfbaa87a39bd",
                                                "sense_id": "9ba78ff1-8228-3f68-92aa-b68c0b05606a",
                                                "text": "Dans ces mots, l’accent est sur une antépénultième."
                                            },
                                            {
                                                "example_id": "ccad5355-e4e2-4ff6-b039-17839cfd4040",
                                                "sense_id": "9ba78ff1-8228-3f68-92aa-b68c0b05606a",
                                                "text": "« L’antépénultième…, fit-il.\nUn léger sourire sépara les lèvres de David, qui reprit :\n« C’est-à-dire la syllabe précédant l’avant-dernière du mot."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
