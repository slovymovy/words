    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "247e5e78-98b5-3e47-a277-e5d3ffccb281",
                    "sense_definition": "iemand ontslaan van een verplichting of taak die normaal gesproken verplicht is",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "ontheffing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De student werd voor het examen <w>vrijgesteld</w> vanwege zijn eerdere resultaten.",
                            "target_lang_translations": {
                                "ru": "Студент был <w>освобожден</w> от экзамена благодаря своим предыдущим результатам."
                            }
                        },
                        {
                            "text": "De overheid kan bepaalde groepen <w>vrijstellen</w> van belasting.",
                            "target_lang_translations": {
                                "ru": "Правительство может <w>освободить</w> определенные группы от уплаты налогов."
                            }
                        }
                    ],
                    "antonyms": [
                        "verplichten"
                    ],
                    "common_phrases": [
                        "vrijstellen van belasting",
                        "vrijstellen van examen"
                    ],
                    "target_lang_definitions": {
                        "ru": "освобождать кого-либо от обязанности или задачи, которая обычно является обязательной"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "от обязательств, налогов или экзаменов"
                            },
                            {
                                "target_lang_word": "давать освобождение",
                                "target_lang_sense_clarification": "официально разрешать не выполнять что-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "15d72466-b5cd-306a-a83d-d4d9bf7b4036",
                    "sense_definition": "iemand uit gevangenschap of slavernij halen en de vrijheid teruggeven",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "bevrijding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Na jaren van gevangenschap besloot de koning de politieke gevangenen eindelijk <w>vrij</w> te <w>stellen</w>.",
                            "target_lang_translations": {
                                "ru": "После многих лет заключения король решил наконец <w>освободить</w> политических заключенных."
                            }
                        },
                        {
                            "text": "In de negentiende eeuw werden veel mensen die in slavernij leefden officieel <w>vrijgesteld</w>.",
                            "target_lang_translations": {
                                "ru": "В девятнадцатом веке многие люди, жившие в рабстве, были официально <w>освобождены</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijlaten",
                        "laten gaan"
                    ],
                    "antonyms": [
                        "gevangenzetten",
                        "opsluiten"
                    ],
                    "common_phrases": [
                        "gevangenen vrijstellen"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "In de context van slavernij of gevangenschap is dit gebruik minder gangbaar dan 'vrijlaten'."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "выпускать кого-либо из плена или рабства, возвращая свободу"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "освобождать",
                                "target_lang_sense_clarification": "из заключения или рабства"
                            },
                            {
                                "target_lang_word": "отпускать на волю",
                                "target_lang_sense_clarification": "даровать свободу"
                            }
                        ]
                    }
                }
