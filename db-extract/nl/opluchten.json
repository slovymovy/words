        "nl-extract.jsonl": [
            {
                "entry_id": "6099b9d8-4f28-3ffd-9587-70bae0d2615c",
                "word": "opluchten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72ef0abc-7639-3672-84a8-013230821354",
                        "entry_id": "6099b9d8-4f28-3ffd-9587-70bae0d2615c",
                        "glosses": [
                            "geruststellen, doen verdwijnen van een angst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2ca14a9-53d1-4c6b-9554-db17acd61dd7",
                                "sense_id": "72ef0abc-7639-3672-84a8-013230821354",
                                "text": "Het geeft verlichting als hun zorgen gedeeld worden, zegt Brunekreeft. „Het praten kan al opluchten. Het is belangrijk om in vertrouwen en in openheid over de problemen te praten. Kerkenraadsleden hebben een zwijgplicht.”"
                            },
                            {
                                "example_id": "6e254369-4a7e-466c-a254-b60362a1f9a2",
                                "sense_id": "72ef0abc-7639-3672-84a8-013230821354",
                                "text": "Het kan jongeren opluchten als ze horen dat hun ouders ook zelf hun weg moesten zoeken. Jongeren kunnen veel aan de gesprekken over seksualiteit met ouders hebben, maar zullen dit waarschijnlijk niet laten merken omdat dit niet bij hun leeftijdsfase past."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "228f1f35-d16d-4410-81ab-add4a083467a",
                        "source_entry_id": "6099b9d8-4f28-3ffd-9587-70bae0d2615c",
                        "source_sense_id": "72ef0abc-7639-3672-84a8-013230821354",
                        "target_lang_word": "reassure from worries",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "63673a60-b541-4dc1-9998-ffb9ffb379bc",
                        "source_entry_id": "6099b9d8-4f28-3ffd-9587-70bae0d2615c",
                        "source_sense_id": "72ef0abc-7639-3672-84a8-013230821354",
                        "target_lang_word": "relieve",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "relieve",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31aeba25-4956-33e4-bbbb-1cac8880bc3f",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To ease (a person, person's thoughts etc.) from mental distress; to stop (someone) feeling anxious or worried, to alleviate the distress of."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dc1cb7c4-46ed-46a5-ba75-cf89e4d82073",
                                                "sense_id": "31aeba25-4956-33e4-bbbb-1cac8880bc3f",
                                                "text": "I was greatly relieved by the jury's verdict."
                                            },
                                            {
                                                "example_id": "46ff54ab-9aff-44a2-a638-12c7a5bd10c3",
                                                "sense_id": "31aeba25-4956-33e4-bbbb-1cac8880bc3f",
                                                "text": "Then we relapsed into a discomfited silence, and wished we were anywhere else. But Miss Thorn relieved the situation by laughing aloud, and with such a hearty enjoyment that instead of getting angry and more mortified we began to laugh ourselves, and instantly felt better."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1390ac20-679e-38f7-a588-40197ccbb57f",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To ease (someone, a part of the body etc.) or give relief from physical pain or discomfort."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5fcbd19a-cd2d-3277-ab6b-a6eaafc051b0",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To alleviate (pain, distress, mental discomfort etc.)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6633ef20-dcdc-3534-897c-3a2150d34850",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To provide comfort or assistance to (someone in need, especially in poverty)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0fe4a863-0722-35da-8004-c575467ba738",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To lift up; to raise again."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "21c76428-fab4-3165-a5ab-036b146a5d13",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To raise (someone) out of danger or from (a specified difficulty etc.)."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3a830a7c-8ae4-3373-8d00-eb29ac70a7e2",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To free (someone) from debt or legal obligations; to give legal relief to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "159913d2-0370-4058-a11f-1556a10e19d8",
                                                "sense_id": "3a830a7c-8ae4-3373-8d00-eb29ac70a7e2",
                                                "text": "This shall not relieve either Party of any obligations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0cc7eb1e-7a9c-3939-a292-1722c4aa1dbb",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To bring military help to (a besieged town); to lift the siege on."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8369fb4-9366-4c83-b693-34180d886e8f",
                                                "sense_id": "0cc7eb1e-7a9c-3939-a292-1722c4aa1dbb",
                                                "text": "In 1574, the duke of Alva laid siege to Leiden to gain control of Holland's most beautiful and prosperous city. To relieve the siege, William of Orange and his followers opened the city's protective dikes to flush out—literally—the surrounding Spanish forces."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4360d032-0379-3f19-b277-cab62208afd7",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To release (someone) from or of a difficulty, unwanted task, responsibility etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "df95ca68-b94e-42f2-abd4-ce1c50a4b5f8",
                                                "sense_id": "4360d032-0379-3f19-b277-cab62208afd7",
                                                "text": "They had thought it obsolete, but, were relieved of this misapprehension by Yule’s friend Major Trotter."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "247ea11a-24f3-3a9e-9e04-43357fdbc953",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To free (someone) from their post, task etc. by taking their place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "168347fb-8b52-3462-bc31-3f466167e469",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To make (something) stand out; to make prominent, bring into relief."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bdbd38d-1a01-4b53-9510-c2781a4cb287",
                                                "sense_id": "168347fb-8b52-3462-bc31-3f466167e469",
                                                "text": "The henna should be deeply dyed to make / The skin relieved appear more fairly fair […]"
                                            },
                                            {
                                                "example_id": "0161d95c-0fa4-4934-86ec-a0008ac447a3",
                                                "sense_id": "168347fb-8b52-3462-bc31-3f466167e469",
                                                "text": "The night whose sable breast relieves the stark / White stars is no less lovely being dark"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68404c10-1bda-38ae-af48-2ac4016ab001",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To urinate or defecate."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1bafebb1-acd8-4e58-821c-d406816abdbc",
                                                "sense_id": "68404c10-1bda-38ae-af48-2ac4016ab001",
                                                "text": "1989, Snyder v. Harmon, 562 A.2d 307 (Pa. 1989) (Zappala, J., writing for the majority), Pennsylvania Supreme Court\nAs they traveled along L.R. 33060, one of the passengers mentioned he had to relieve himself, so Barrett stopped the car along the berm of the road, which, unbeknown to the travelers, was directly adjacent to a strip mine."
                                            },
                                            {
                                                "example_id": "9f38d598-167b-411f-9b3d-d1256a4ea6a6",
                                                "sense_id": "68404c10-1bda-38ae-af48-2ac4016ab001",
                                                "text": "For example, the times and locales for defecation and urination have come under tighter regulation in the modern West to meet an increasing demand – explicitly articulated in workplace rules and regulations – that people relieve themselves not whenever or wherever they feel like it but at an appropriate time and place (Inglis & Holmes, 2000)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4f2edacc-6d45-3d8e-9a1e-737c311b270a",
                                        "entry_id": "4d0763d3-59a0-3f10-ad05-880e334c1082",
                                        "glosses": [
                                            "To ease one's own desire to orgasm, often through masturbation to orgasm."
                                        ],
                                        "tags": [
                                            "euphemistic",
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "962cd42a-32a1-430e-af5a-eba7cbd536a3",
                                                "sense_id": "4f2edacc-6d45-3d8e-9a1e-737c311b270a",
                                                "text": "Nevertheless, to relieve oneself takes the edge off the desire and doesn't take advantage of others."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
