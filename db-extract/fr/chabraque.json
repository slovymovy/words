                                            {
                                                "example_id": "d83c0f63-c536-4f2b-8ced-1884a19bd3f4",
                                                "sense_id": "0fdbadaa-635a-37e4-a9d3-6a4af8de69a9",
                                                "text": "Handlarz wyłożył na ladę trzy czapraki."
                                            }
                                        ],
