                            "beroep"
                        ],
                        "examples": [
                            {
                                "example_id": "130b2dea-5d98-46e3-986d-9ca3bdd8e4a2",
                                "sense_id": "58fef9a1-e500-337b-ae50-b92a730df873",
                                "text": "Inpakkers Amazon: ’We lijken wel slaven’"
                            },
                            {
                                "example_id": "e0ad7e78-d800-4d83-b1ed-2aca10505587",
                                "sense_id": "58fef9a1-e500-337b-ae50-b92a730df873",
                                "text": "Vooral medewerkers bloemen- en plantenteelt (-16%), productiemedewerkers (-17%), hoveniers (-32%) en tractorchauffeurs (-48%) klopten in 2016 minder vaak aan bij het UWV. Daarentegen groeide het aantal WW’ers dat op zoek is naar een baan als inpakker handmatig (+9%), medewerker groenteteelt (+9%) en agrarisch seizoenskracht groente en fruit (+7%)."
                            },
                            {
                                "example_id": "90809959-91b1-4a3b-860a-22a4e876338d",
                                "sense_id": "58fef9a1-e500-337b-ae50-b92a730df873",
                                "text": "De meeste kinderen doe je geen plezier met een bezoek aan een witlofmuseum, maar liefhebbers van deze bladgroente zullen een rondleiding zeker waarderen. Telers, inpakkers en opkopers vertellen hun verhaal en het leukst is natuurlijk het culinaire hoekje, waar je lekkere recepten kunt uitzoeken."
                            },
                            {
                                "example_id": "a3c28a09-4354-4acf-8f36-d8c82943f25f",
                                "sense_id": "58fef9a1-e500-337b-ae50-b92a730df873",
                                "text": "Afgelopen januari overleed hasjbaron Zwolsman in zijn cel. In het onderzoek naar zijn hasjorganisatie werden in totaal 100 verdachten opgepakt, van wie de belangrijkste de afgelopen weken terechtstonden. Een grote klant uit Engeland hoorde 5 jaar cel eisen. Zes mensen die hielpen witwassen, moeten van het OM tot 21 maanden de cel in. Bouwers en verzorgers van wietkwekerijen en persers, inpakkers en transporteurs van hasj en wiet hoorden tot 4 jaar cel eisen."
                            }
                        ]
                    },
                    {
                        "sense_id": "cd878fef-6b03-35b2-8057-6e0bfbf25ac6",
                        "entry_id": "39ff9d09-3860-3585-9065-a1af34374fc6",
                        "glosses": [
                            "iemand die zijn koffer inpakt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "523e0f3c-acf2-4c01-a345-a9bcd45b407e",
                                "sense_id": "cd878fef-6b03-35b2-8057-6e0bfbf25ac6",
                                "text": "Nederlanders zijn behoorlijke ‘last-minute’ inpakkers. Ruim 44% geeft aan pas de dag voor vertrek de koffers te pakken (44.9%). Sommigen nemen nog wat minder de tijd en beginnen slechts een paar uur voor vertrek de koffer pas te pakken (14.3%)."
                            }
                        ]
                    }
