                "senses": [
                    {
                        "sense_id": "a0f56ac4-0ec7-38c0-ba08-deb9388daf86",
                        "entry_id": "8407dd92-9061-3d75-8eaa-d5f07dc91562",
                        "glosses": [
                            "фин. посредническая банковская операция по передаче денежных средств от плательщика к получателю через банк с зачислением этих средств на счёт получателя"
                        ],
                        "tags": [],
