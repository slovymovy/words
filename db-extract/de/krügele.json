                "senses": [
                    {
                        "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                        "entry_id": "2edfca9c-e841-31a5-9bcc-1e291aad138b",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c52c67a7-0aa6-46eb-a282-f68fb199e60c",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Frau Krügele ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c9d78d2f-c5da-4482-a1d5-1f84e3e3cf50",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Herr Krügele wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "a9854075-3ff2-4bcf-aef9-45af128bc1a0",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Die Krügeles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "a54e004f-2bd4-42ad-a765-3d98fdaf2005",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Der Krügele trägt nie die Schals, die die Krügele ihm strickt."
                            },
                            {
                                "example_id": "e5fc93bb-f42e-4be8-89d1-85793e47e7c1",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Krügele kommt, geht der Herr Krügele.“"
                            },
                            {
                                "example_id": "75e06e46-2a18-4fab-b395-725ffa59c99a",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Krügele kommt und geht."
                            },
                            {
                                "example_id": "9e8af9e4-ada6-4568-9995-8a7fcc51987e",
                                "sense_id": "b93b960c-a83f-34af-9bdb-5464d6a157b8",
                                "text": "Krügeles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
