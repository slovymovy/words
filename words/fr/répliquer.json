    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "7c2a8fd3-db6a-3b0e-8d15-40047614bea2",
                    "sense_definition": "Répondre vivement ou opposer un argument à ce qui vient d'être dit.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a su <w>répliquer</w> avec beaucoup d'esprit aux critiques de son collègue."
                        },
                        {
                            "text": "Face à ses accusations injustes, il n'a pas tardé à <w>répliquer</w> fermement."
                        }
                    ],
                    "synonyms": [
                        "répondre",
                        "rétorquer"
                    ],
                    "common_phrases": [
                        "répliquer du tac au tac",
                        "sans rien répliquer"
                    ]
                },
                {
                    "sense_id": "6eae82d3-5aea-33da-9ed6-0d81d93ecd0b",
                    "sense_definition": "Répondre avec humeur ou contester un ordre au lieu d'obéir en silence.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les parents ont demandé aux enfants d'obéir immédiatement sans <w>répliquer</w>."
                        },
                        {
                            "text": "Quand le professeur lui a fait une remarque, l'élève a osé <w>répliquer</w>."
                        }
                    ],
                    "synonyms": [
                        "contester",
                        "rouspéter"
                    ],
                    "antonyms": [
                        "obéir"
                    ],
                    "common_phrases": [
                        "obéir sans répliquer",
                        "oser répliquer"
                    ]
                },
                {
                    "sense_id": "440d5d29-2a0b-3b39-8abc-74609eea3797",
                    "sense_definition": "Riposter à une attaque ou réagir par une action défensive ou offensive.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'armée a décidé de <w>répliquer</w> immédiatement après les tirs ennemis."
                        },
                        {
                            "text": "L'équipe a su <w>répliquer</w> en marquant deux buts en seconde période."
                        }
                    ],
                    "synonyms": [
                        "riposter",
                        "contre-attaquer"
                    ],
                    "common_phrases": [
                        "répliquer à une attaque",
                        "répliquer par la force"
                    ]
                },
                {
                    "sense_id": "af23bda0-34dd-3c79-b339-27570975a9c0",
                    "sense_definition": "Reproduire, dupliquer ou recréer un phénomène, une expérience ou une donnée.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "reproduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les scientifiques tentent de <w>répliquer</w> cette expérience dans d'autres laboratoires."
                        },
                        {
                            "text": "Le développeur n'arrive pas à <w>répliquer</w> l'erreur signalée sur l'application."
                        }
                    ],
                    "synonyms": [
                        "dupliquer",
                        "reproduire"
                    ],
                    "common_phrases": [
                        "répliquer une expérience",
                        "répliquer un bug"
                    ]
                },
                {
                    "sense_id": "d50c71ca-5d16-3d69-898e-f164c7ca9941",
                    "sense_definition": "Fournir une réponse formelle aux conclusions ou arguments de la partie adverse.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "discours",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat de la défense dispose de deux semaines pour <w>répliquer</w> au mémoire adverse."
                        },
                        {
                            "text": "Après la plaidoirie du procureur, la défense a demandé la parole afin de <w>répliquer</w>."
                        }
                    ],
                    "common_phrases": [
                        "droit de répliquer",
                        "répliquer aux conclusions"
                    ]
                }
            ]
        }
    ]
