                    "frequency": "Low",
                    "semantic_group_id": "small_amount",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His harsh criticism did not bother her one <w>jot</w>."
                        },
                        {
                            "text": "The sudden change in schedule does not matter a <w>jot</w> to the rest of the team."
                        }
                    ],
                    "synonyms": [
                        "bit",
                        "iota",
                        "mite",
                        "modicum",
                        "speck",
                        "whit"
                    ],
                    "common_phrases": [
                        "not care a jot",
                        "not matter a jot",
                        "not one jot"
                    ]
                },
                {
                    "sense_id": "da226997-d575-3de8-b01c-ec66b774e39d",
                    "sense_definition": "The smallest letter, mark, or stroke in writing; an iota.",
