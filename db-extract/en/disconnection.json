                ],
                "senses": [
                    {
                        "sense_id": "5b64f41f-2f05-31e5-8c71-51631afac131",
                        "entry_id": "d3ec2746-0796-3961-b0f1-86daea019bb8",
                        "glosses": [
                            "Severance of a physical connection."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "fb6fbad0-3758-4c72-ac44-0fe78e237bfd",
                                "sense_id": "5b64f41f-2f05-31e5-8c71-51631afac131",
                                "text": "The disconnection of the power cable shut down all the computers."
                            }
                        ]
                    },
                    {
                        "sense_id": "19385123-8c45-3135-84dc-92e2e4dd919c",
                        "entry_id": "d3ec2746-0796-3961-b0f1-86daea019bb8",
                        "glosses": [
                            "Unexpected termination of a telephone connection."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ccdf6652-a7d1-4eab-ad28-9a2fe0f77864",
                                "sense_id": "19385123-8c45-3135-84dc-92e2e4dd919c",
                                "text": "A sudden disconnection cut me off in mid-phrase."
                            }
                        ]
                    },
                    {
                        "sense_id": "9deed1cf-48fe-310f-aabb-21af9e4c3e9c",
                        "entry_id": "d3ec2746-0796-3961-b0f1-86daea019bb8",
                        "glosses": [
                            "Absence of rapport; the nonexistence of, or a breakdown of, effective communication."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "bc1fa6a4-4c6f-436b-9093-b5609dd35a70",
                                "sense_id": "9deed1cf-48fe-310f-aabb-21af9e4c3e9c",
                                "text": "There was a hopeless disconnection between the weary, old teacher and the spirited, young students."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f002815b-90f5-43bd-a4fd-8c3374e8f55d",
                        "source_entry_id": "d3ec2746-0796-3961-b0f1-86daea019bb8",
                        "source_sense_description": "to have no connections",
                        "target_lang_word": "Unterbrechung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterbrechung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2d4e85e7-627b-3a28-a28e-e1f34570df2e",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Zerteilung einer Verbindung; Öffnung einer Leitung, eines Rohres, eines Seils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fdcab69-d2ca-431e-b73b-aa296bfcd0b8",
                                                "sense_id": "2d4e85e7-627b-3a28-a28e-e1f34570df2e",
                                                "text": "Die Unterbrechung im Leitungssystem führte zu einem Stromausfall."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Störung einer Kommunikation, eines Gesprächs"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1668b79b-ed21-4eb9-ba14-88adef7f9db1",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "Bitte entschuldigen Sie die Unterbrechung, aber da ist jemand am Telefon für Sie."
                                            },
                                            {
                                                "example_id": "54a17ec1-e548-4c80-bd3b-61799f7fe377",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "Weitere Unterbrechungen werde ich in meinem Gerichtssaal nicht dulden."
                                            },
                                            {
                                                "example_id": "1476bb8c-7da1-43b3-bd64-ee478f97ba06",
                                                "sense_id": "21a14f97-10f2-3965-90df-17b2e86d441a",
                                                "text": "„Wiegand hat die Unterbrechung unwillig abgeschüttelt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "kurzzeitige Aussetzung einer Handlung, um diese später wieder aufzunehmen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f047bf5-598f-4932-b56f-190c7c37e635",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Um zwölf Uhr gibt es eine kurze Unterbrechung, damit ihr alle mal zur Toilette gehen könnt."
                                            },
                                            {
                                                "example_id": "b84486c2-9380-4c5a-8465-29b727aea1a8",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Danach werden wir ohne Unterbrechung fortfahren."
                                            },
                                            {
                                                "example_id": "bf330d5e-c80a-45d0-b1a6-0f50b66e4f0d",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "Das Unwetter führte zu einer längeren Unterbrechung der Versorgungsflüge."
                                            },
                                            {
                                                "example_id": "385a1789-480d-4098-8e5c-df2fc8136d22",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "„Jetzt wurde sehr schnell und ohne jede Unterbrechung marschiert und erst bei Sonnenuntergang wieder halt gemacht.“"
                                            },
                                            {
                                                "example_id": "3ba61431-6ff1-421b-b359-b04b3693fb45",
                                                "sense_id": "b072d9b4-95e6-3997-95e7-533afb691d71",
                                                "text": "„Da er sich der Behauptung von Raspail entsann, daß man durch Unterbrechung der Diät das Fieber herabdrücke, verordnete er Fleischbrühe und sogar ein wenig Fleisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "af2944ba-fb0c-3649-83a0-8cb7c25d4ae7",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "Aussetzen einer vertraglich vereinbarten Frist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f38e89df-6c95-483a-ad90-77c234191fe8",
                                                "sense_id": "af2944ba-fb0c-3649-83a0-8cb7c25d4ae7",
                                                "text": "Die rechtzeitige Schadensmeldung führt nicht zu einer Unterbrechung der Verjährungsfrist."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "920cec29-c64c-32e1-973a-1b55a07065a3",
                                        "entry_id": "d61b2d40-ccb6-3fdf-bcf2-20a7c52a6f42",
                                        "glosses": [
                                            "kurzfristige Aussetzung eines Programms, um eine höherpriorisierte und damit zeitkritische Verarbeitung durchzuführen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0baf1ce-340f-45d6-b1bd-c6de38ca7234",
                                                "sense_id": "920cec29-c64c-32e1-973a-1b55a07065a3",
                                                "text": "Ein Systemaufruf, der im Kernel-Modus läuft, führt zur Unterbrechung des im Benutzer-Modus laufenden Programms."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
