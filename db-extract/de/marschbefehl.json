                "senses": [
                    {
                        "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                        "entry_id": "6008d6dd-c34a-3154-86ee-c706716ddd6c",
                        "glosses": [
                            "Befehl, sich zu einem bestimmten Ziel in Marsch zu setzen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3775fb1f-b49c-475b-a6ee-f8f25a1fb058",
                                "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                                "text": "Richard erhielt seinen Marschbefehl."
                            },
                            {
                                "example_id": "f97f436f-3a30-421b-a084-666a73b274d2",
                                "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                                "text": "„Sein Marschbefehl lautete schon für den nächsten Tag, sie konnten sich gerade noch einmal treffen, in Käthes Zimmer in Steglitz.“"
                            },
                            {
                                "example_id": "fe8c85a4-228c-49c2-8f75-8dde12c4734a",
                                "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                                "text": "„Da hab ich meine alte Uniform aus dem Mottenschrank geholt und den verjährten Marschbefehl aus der Schatulle.“"
                            },
                            {
                                "example_id": "4db9d0b6-6197-40a7-b6fe-53f26c56a7ff",
                                "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                                "text": "„Sie fühlte sich wie ein Soldat, der nach langem Warten einen Marschbefehl erhalten hat.“"
                            },
                            {
                                "example_id": "f28896fe-97ec-4ed9-8509-da23d9fe808d",
                                "sense_id": "6ecc9fe4-f685-34f2-a75b-b18d57708f10",
                                "text": "„Wo habe ich eigentlich meinen Marschbefehl hingesteckt?“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
