    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "ac61135f-a7a6-307e-802c-8f7d405047ed",
                    "sense_definition": "To cause someone to feel intense irritation, annoyance, or frustration.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "irritate",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant noise from the construction site began to <w>exasperate</w> the local residents.",
                            "target_lang_translations": {
                                "tr": "Şantiyeden gelen sürekli gürültü, yerel sakinleri <w>çileden çıkarmaya</w> başladı."
                            }
                        },
                        {
                            "text": "It <w>exasperates</w> me when people refuse to listen to simple instructions.",
                            "target_lang_translations": {
                                "tr": "İnsanlar basit talimatları dinlemeyi reddettiğinde bu beni <w>çileden çıkarıyor</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoy",
                        "irritate",
                        "frustrate",
                        "provoke",
                        "vex",
                        "irk"
                    ],
                    "common_phrases": [
                        "exasperate the public",
                        "exasperate the situation"
                    ],
                    "target_lang_definitions": {
                        "tr": "Birini yoğun bir şekilde rahatsız etmek, kızdırmak veya çileden çıkarmak."
                    },
                    "translations": {
                        "tr": [
                            {
                                "target_lang_word": "çileden çıkarmak",
                                "target_lang_sense_clarification": "Birini aşırı derecede sinirlendirmek anlamında."
                            },
                            {
                                "target_lang_word": "bıktırmak",
                                "target_lang_sense_clarification": "Sürekli rahatsızlık vererek sabrını zorlamak anlamında."
                            },
                            {
                                "target_lang_word": "tepesini attırmak",
                                "target_lang_sense_clarification": "Deyimsel olarak birini çok kızdırmak."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "fddca1e3-aff4-3de2-b162-758fbc4155b1",
                    "sense_definition": "Feeling or showing intense irritation or annoyance.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "irritated",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>exasperate</w> king demanded an immediate explanation for the failed military campaign.",
                            "target_lang_translations": {
                                "tr": "<w>Bıkkın</w> kral, başarısız askeri harekat için derhal bir açıklama talep etti."
                            }
                        },
                        {
                            "text": "She gave an <w>exasperate</w> sigh after hearing the same excuse for the third time.",
                            "target_lang_translations": {
                                "tr": "Aynı bahaneyi üçüncü kez duyduktan sonra <w>bıkkın</w> bir iç çekti."
                            }
                        }
                    ],
                    "synonyms": [
                        "annoyed",
                        "frustrated",
                        "irritated"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This usage is largely historical or literary."
                        }
                    ],
                    "target_lang_definitions": {
