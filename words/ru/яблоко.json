{
    "word_family": [
        "яблоня",
        "яблочный",
        "яблочко"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1b5e3274-4edf-32c1-9d47-8273fe3313be",
                    "sense_definition": "Съедобный плод яблони, обычно округлой формы.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "fruit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "На столе лежало спелое красное <w>яблоко</w>.",
                            "target_lang_translations": {
                                "en": "A ripe red <w>apple</w> was lying on the table."
                            }
                        },
                        {
                            "text": "Каждый день полезно съедать хотя бы одно <w>яблоко</w>.",
                            "target_lang_translations": {
                                "en": "It is healthy to eat at least one <w>apple</w> every day."
                            }
                        }
                    ],
                    "common_phrases": [
                        "спелое яблоко",
                        "зеленое яблоко"
                    ],
                    "target_lang_definitions": {
                        "en": "An edible, typically round fruit produced by an apple tree."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "apple",
                                "target_lang_sense_clarification": "The common fruit of the Malus domestica tree."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4a6e186d-b1ee-3f84-a3b3-6dc2cffdedca",
                    "sense_definition": "Анатомический орган зрения, глазное <w>яблоко</w>.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "anatomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "При травме пострадало глазное <w>яблоко</w>.",
                            "target_lang_translations": {
                                "en": "The <w>eyeball</w> was injured during the trauma."
                            }
                        },
                        {
                            "text": "Врач внимательно осмотрел глазное <w>яблоко</w> пациента.",
                            "target_lang_translations": {
                                "en": "The doctor carefully examined the patient's <w>eyeball</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "глазное яблоко"
                    ],
                    "target_lang_definitions": {
                        "en": "The anatomical organ of vision; the eyeball."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "eyeball",
                                "target_lang_sense_clarification": "The entire spherical structure of the eye."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bc3208c-168a-3d62-aa1c-06602a7313ac",
                    "sense_definition": "Круглое пятно на шерсти животного или на ткани.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pattern",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Серый конь в <w>яблоках</w> выглядел очень эффектно.",
                            "target_lang_translations": {
                                "en": "The grey <w>dappled</w> horse looked very striking."
                            }
                        },
                        {
                            "text": "Ткань была украшена узором в <w>яблоках</w>.",
                            "target_lang_translations": {
                                "en": "The fabric was decorated with a <w>dapple</w> pattern."
                            }
                        }
                    ],
                    "common_phrases": [
                        "конь в яблоках"
                    ],
                    "target_lang_definitions": {
                        "en": "A round spot or marking on an animal's coat or on fabric."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dapple",
                                "target_lang_sense_clarification": "A spot or patch of color, often used to describe horse coats."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "77d92c37-f2d7-30d1-bb49-258c10952521",
                    "sense_definition": "Декоративный элемент в форме шара, венчающий шпиль или купол.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Золотое <w>яблоко</w> сияло на вершине шпиля.",
                            "target_lang_translations": {
                                "en": "A golden <w>orb</w> shone at the top of the spire."
                            }
                        },
                        {
                            "text": "Шпиль собора завершается медным <w>яблоком</w>.",
                            "target_lang_translations": {
                                "en": "The cathedral spire is topped with a copper <w>orb</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A decorative spherical element crowning a spire or dome."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "finial",
                                "target_lang_sense_clarification": "An ornamental top piece on a building or structure."
                            },
                            {
                                "target_lang_word": "orb",
                                "target_lang_sense_clarification": "A spherical object used as a decorative architectural feature."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f78cb21-3569-31bd-a854-8b61a1957713",
                    "sense_definition": "Символ монархической власти в виде шара с крестом, держава.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "regalia",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Царь держал в руках скипетр и <w>яблоко</w>.",
                            "target_lang_translations": {
                                "en": "The tsar held a scepter and an <w>orb</w> in his hands."
                            }
                        },
                        {
                            "text": "Державное <w>яблоко</w> является символом власти монарха.",
                            "target_lang_translations": {
                                "en": "The royal <w>orb</w> is a symbol of the monarch's power."
                            }
                        }
                    ],
                    "synonyms": [
                        "держава"
                    ],
                    "common_phrases": [
                        "державное яблоко"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Устаревшее обозначение державы."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A symbol of monarchical power in the form of a sphere topped with a cross; an orb."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "orb",
                                "target_lang_sense_clarification": "A golden sphere surmounted by a cross, representing royal power."
                            },
                            {
                                "target_lang_word": "globus cruciger",
                                "target_lang_sense_clarification": "The formal historical term for the royal orb."
                            }
                        ]
                    }
                }
            ]
        }
    ]
