                                        "entry_id": "fffcfdcc-0075-3ec2-a3ab-2cf6b81b85c3",
                                        "glosses": [
                                            "Person, die man nur schwer ertragen kann, weil sie einem „auf die Nerven geht“"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c10fcd0-d2e8-41fd-a9ac-f63851fe4202",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "Du bist heute wieder eine richtige Nervensäge."
                                            },
                                            {
                                                "example_id": "4897ecae-16f0-46f6-9b2c-f4bd7ed34ed8",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Hoffentlich kommt die blöde Nervensäge nicht auf die Idee, mir von hinten eine Kugel in den Kopf zu jagen, dachte Wilson.“"
                                            },
                                            {
                                                "example_id": "47b43966-6d21-4d7d-a5ed-fc1710297dac",
                                                "sense_id": "e45b2699-2d99-34e1-af51-59968c741a7a",
                                                "text": "„Die Nummern der schlimmsten Nervensägen habe ich eingespeichert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7035b17e-5894-45ad-afac-3ae4a46a3832",
