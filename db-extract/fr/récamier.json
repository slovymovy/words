                        "sense_id": "8d1cd658-83e5-35d7-8abe-932b55b16a15",
                        "entry_id": "1575f83b-df61-3dc6-8c9c-021fb29bbbf0",
                        "glosses": [
                            "Méridienne, divan."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af101b75-a2d1-4b0c-98db-5e9241392584",
                                "sense_id": "8d1cd658-83e5-35d7-8abe-932b55b16a15",
                                "text": "Son mode de vie détermina un style, le style Récamier, qui influença le mobilier et que l'on appréciait surtout dans le confort d'un récamier, un fauteuil dans lequel on fait agréablement la conversation."
                            },
                            {
                                "example_id": "a3942cdc-06c9-40ad-a58d-c870515195cd",
                                "sense_id": "8d1cd658-83e5-35d7-8abe-932b55b16a15",
                                "text": "Pas besoin de Freud et d'un récamier en cuir capitonné. Une étude sommaire de la famille de ce dernier brossait un portrait on ne peut plus évident."
                            },
                            {
                                "example_id": "bef9aeb1-8e2d-4a3f-9288-4bfd6ad1dea7",
                                "sense_id": "8d1cd658-83e5-35d7-8abe-932b55b16a15",
                                "text": "Michel l’attendait sur un récamier dans le couloir et paraissait anxieux."
                            },
                            {
                                "example_id": "b734b9fe-4ba0-497c-a467-368a98d2324e",
                                "sense_id": "8d1cd658-83e5-35d7-8abe-932b55b16a15",
                                "text": "[…] incluant un canapé-lit (double), un fauteuil, un récamier et coussins assortis."
                            }
                        ]
                    }
