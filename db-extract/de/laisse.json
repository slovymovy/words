                "senses": [
                    {
                        "sense_id": "dbeec601-0184-3a04-986f-eb8623e37278",
                        "entry_id": "cff3507e-5815-3272-a79b-de596b1d4005",
                        "glosses": [
                            "Einheit von beliebig vielen, meist 5 bis 35, isometrischen Versen, die durch Assonanzen und später durch identischen Reim verbunden ist und in der mittelalterlichen französischen, provenzalischen und spanischen Erzähldichtung verwendet wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97ae613b-cdd1-4beb-a964-129a08279a2f",
                                "sense_id": "dbeec601-0184-3a04-986f-eb8623e37278",
                                "text": "Die Laisses sind die Grundbausteine der Chansons de Geste."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dfa7e974-7ff7-46ef-91bb-a42310802db7",
                        "source_entry_id": "cff3507e-5815-3272-a79b-de596b1d4005",
                        "source_sense_id": "dbeec601-0184-3a04-986f-eb8623e37278",
                        "target_lang_word": "laisse",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "laisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "fe4d5298-6ab6-3e89-bdd7-529db3076d57",
                                        "entry_id": "5a7d2f11-4c0e-3d13-ad61-c035c65dc673",
                                        "glosses": [
                                            "Espace que la mer laisse à découvert à chaque marée et qui s’affermit peu à peu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5f2197e-da0f-49b9-8007-12d770fc4440",
                                                "sense_id": "fe4d5298-6ab6-3e89-bdd7-529db3076d57",
                                                "text": "Elle attend toute la soirée. Elle frotte l’intérieur de son pied contre la voûte de l’autre. Sa chair est sèche et tannée, et quand elle arque le pied, la plante est striée d’ondulations. La chair est grainée tel un nœud dans le bois, et des fissures constellent les cals comme autant de trous le long de la laisse de mer."
                                            },
                                            {
                                                "example_id": "ea02e9e8-6c38-4206-bbe1-edcf6299d973",
                                                "sense_id": "fe4d5298-6ab6-3e89-bdd7-529db3076d57",
                                                "text": "On eût dit que les eaux croupies qui baignaient les pilotis de la ville basse se retiraient à leur laisse extrême, et mettaient au jour la forêt tourbeuse et rongée de mauvaises fièvres qui lui servait de support."
                                            },
                                            {
                                                "example_id": "5496f6a8-34fe-4435-ae63-b9c4b242aaab",
                                                "sense_id": "fe4d5298-6ab6-3e89-bdd7-529db3076d57",
                                                "text": "Il me semblait que le flux qui me portait venait de se retirer à sa laisse la plus basse, et que la pièce se vidait lentement par le trou noir de ce sommeil hanté de mauvais songes."
                                            },
                                            {
                                                "example_id": "68e58ebf-5a31-418c-b828-70f63ea94703",
                                                "sense_id": "fe4d5298-6ab6-3e89-bdd7-529db3076d57",
                                                "text": "2. La zone maritime est comprise entre le littoral et une limite extérieure située en mer à 12 milles marins mesurés à partir des lignes de base de la mer territoriale. Les lignes de base sont la laisse de basse mer ainsi que les lignes de base droites et les lignes de fermeture des baies qui sont déterminées par décret."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf29bb8f-0b15-3445-b375-72f3f1c98f8a",
                                        "entry_id": "5a7d2f11-4c0e-3d13-ad61-c035c65dc673",
                                        "glosses": [
                                            "Mélange de vase et de sable et des débris de plantes marines que chaque vague dépose en sillons sur la plage."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7cdc027e-355c-3280-be4a-8c8a5ea97b29",
                                        "entry_id": "5a7d2f11-4c0e-3d13-ad61-c035c65dc673",
                                        "glosses": [
                                            "Zone d’alluvion des bords de cours d’eau."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eba09a1e-875e-48b4-afdf-c20f4b4968e8",
                                                "sense_id": "7cdc027e-355c-3280-be4a-8c8a5ea97b29",
                                                "text": "Représentée dans notre région par des individus disséminés dans les noues et les laisses de la Lanterne, l’association à Limnanthemum ne saurait être étroitement délimitée […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da2527e8-0f60-3e52-9566-318be7cef5a9",
                                        "entry_id": "5a7d2f11-4c0e-3d13-ad61-c035c65dc673",
                                        "glosses": [
                                            "Lavures."
                                        ],
                                        "tags": [
                                            "Fonderie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bc98a953-b49a-3bdb-a599-8327cbbf2adf",
                                        "entry_id": "628432df-7344-3be3-98d0-311573116d67",
                                        "glosses": [
                                            "Corde ou lanière dont on se sert pour mener un chien seul ou des chiens attachés ensemble."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3b2821a1-1c9d-4829-8f5e-277d3954e10b",
                                                "sense_id": "bc98a953-b49a-3bdb-a599-8327cbbf2adf",
                                                "text": "Après le décès de sa mère et de son beau-père, la fortune du susnommé s’élèvera à cent mille francs de rente. Cette fortune solide, ou crue telle, est la laisse du chien. « Il tient trop à ce qu’il possède pour ne pas servir loyalement le gouvernement de l’Empereur. » Le mot « loyalement » fait sourire dans ce contexte."
                                            },
                                            {
                                                "example_id": "1c17ba79-4e8e-49f1-a0cf-742ef9dbdaff",
                                                "sense_id": "bc98a953-b49a-3bdb-a599-8327cbbf2adf",
                                                "text": "En ville, ce sont les chiens qui tiennent leur maître en laisse, quoique personne ne semble comprendre que le fait de s’être volontairement encombré d’un chien qu’il faut promener deux fois par jour, qu’il pleuve qu’il vente ou qu’il neige, revient à s’être soi-même passé une laisse autour du cou."
                                            },
                                            {
                                                "example_id": "14c3ac3f-ec83-45e1-b852-af5a9f2e22a5",
                                                "sense_id": "bc98a953-b49a-3bdb-a599-8327cbbf2adf",
                                                "text": "Nô Eusébio siffla les limiers qu’il réunit par une laisse."
                                            },
                                            {
                                                "example_id": "90cabc52-5c98-4907-80ec-8d20bc97871c",
                                                "sense_id": "bc98a953-b49a-3bdb-a599-8327cbbf2adf",
                                                "text": "Pour «tester» la police après l'entrée en vigueur d'un couvre-feu strict samedi au Québec, un automobiliste a conduit en état d'ébriété à Sherbrooke et une jeune femme a promené son ami en laisse. Résultat: une amende de 1550$ chacun."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6b1ec2ad-41ca-3a59-aa3b-6bb610205cbd",
                                        "entry_id": "628432df-7344-3be3-98d0-311573116d67",
                                        "glosses": [
                                            "Sorte de cordon de chapeau fait le plus souvent de fil de soie."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "laisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3ef32f1c-7a03-31d0-a842-e295f24a66bf",
                                        "entry_id": "7dc72ee5-9c58-3406-9091-1920ce91a3ef",
                                        "glosses": [
                                            "Couplet, groupe de vers des anciennes chansons de gestes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b59e5cc9-2daf-45b3-80fb-ed9d374392d3",
                                                "sense_id": "3ef32f1c-7a03-31d0-a842-e295f24a66bf",
                                                "text": "Les laisses de la Chanson de Roland."
                                            },
                                            {
                                                "example_id": "23115e20-af5f-483b-a22f-34f41ab06797",
                                                "sense_id": "3ef32f1c-7a03-31d0-a842-e295f24a66bf",
                                                "text": "Au seuil de la littérature, en France comme ailleurs, se tient l'épopée. Rédigés d'abord en laisses assonancées, puis en vers décasyllabiques rimés, de longs poèmes, destinés à être déclamés par des jongleurs, chantent les faits glorieux (gesta, d'où chanson de geste) dont on veut perpétuer le souvenir."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "laisse",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d4d629f8-3ab3-3346-ae7b-f69b318976fb",
                                        "entry_id": "f5866cfc-7b43-3ff2-a359-414f73b1943f",
                                        "glosses": [
                                            "Première personne du singulier du présent de l’indicatif de laisser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "39fa6c40-3397-4836-9410-df557e077411",
                                                "sense_id": "d4d629f8-3ab3-3346-ae7b-f69b318976fb",
                                                "text": "Je laisse toujours un pull et un chèche au bureau."
                                            },
                                            {
                                                "example_id": "48223383-a03c-4f79-a464-e2a851a39fa6",
                                                "sense_id": "d4d629f8-3ab3-3346-ae7b-f69b318976fb",
                                                "text": "Je me laisse gâter, archigâter on m’y oblige sous peine de péché mortel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ebc825e-5003-32ec-b85f-cde523e492ef",
                                        "entry_id": "f5866cfc-7b43-3ff2-a359-414f73b1943f",
                                        "glosses": [
                                            "Troisième personne du singulier du présent de l’indicatif de laisser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0607bb8-f1be-44f8-96bd-adfde005eec8",
                                                "sense_id": "5ebc825e-5003-32ec-b85f-cde523e492ef",
                                                "text": "On sent, lorsqu’il en laisse échapper quelque chose, avec quelle joie il se renfermait dans sa coquille, comme ces insectes qui se cachent à l’approche de l’homme."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39aa8979-275c-344e-8139-0b87e26bf84a",
                                        "entry_id": "f5866cfc-7b43-3ff2-a359-414f73b1943f",
                                        "glosses": [
                                            "Première personne du singulier du présent du subjonctif de laisser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cd9e33b4-22dd-3c83-82fd-80166170a512",
                                        "entry_id": "f5866cfc-7b43-3ff2-a359-414f73b1943f",
                                        "glosses": [
                                            "Troisième personne du singulier du présent du subjonctif de laisser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b053fb2-5ffe-4645-a251-67aa44db85a9",
                                                "sense_id": "cd9e33b4-22dd-3c83-82fd-80166170a512",
                                                "text": "Alors, est-ce qu’elle ne suffirait pas pour qu’on nous laisse au moins vivoter et crevoter à notre guise dans les limites de l’hexagone ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c395563-b278-3a95-b393-92eda75cbd36",
                                        "entry_id": "f5866cfc-7b43-3ff2-a359-414f73b1943f",
                                        "glosses": [
                                            "Deuxième personne du singulier de l’impératif de laisser."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d03f5d3a-c6dd-451e-8dc9-ee8e2178191a",
                                                "sense_id": "4c395563-b278-3a95-b393-92eda75cbd36",
                                                "text": "Laisse-nous; essuie tes yeux, nous en reparlerons."
                                            }
                                        ]
                                    }
                                ]
                            }
