                        ],
                        "examples": [
                            {
                                "example_id": "6e4515a0-05f5-4140-be9f-e0fcee8dcab2",
                                "sense_id": "41ae8da8-16c1-3172-a6cc-8dffde82033d",
                                "text": "Elles sont cependant bien tentantes, ces jolies collinettes tarasconnaises, toutes parfumées de myrte, de lavande de romarin ; […]."
                            },
                            {
                                "example_id": "22bf21d4-553e-4b4c-8baf-06207ba900f1",
                                "sense_id": "41ae8da8-16c1-3172-a6cc-8dffde82033d",
                                "text": "Nous habitons le même quartier au nord de Montpellier, dont les collinettes se sont couvertes de pins et de cyprès pour ressembler à la Toscane."
                            }
                        ]
                    }
                ],
                "translations": [
