{
    "word_family": [
        "flikkeren",
        "geflikker"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6246daf3-d4b0-3151-ae6b-283724f44349",
                    "sense_definition": "Een homoseksuele man (vaak pejoratief of als scheldwoord gebruikt, maar soms ook geuzennaam).",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "homoseksueel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij werd op straat uitgescholden voor vuile <w>flikker</w>.",
                            "target_lang_translations": {
                                "en": "He was insulted on the street as a dirty <w>faggot</w>."
                            }
                        },
                        {
                            "text": "Sommige homo's gebruiken het woord <w>flikker</w> tegenwoordig als een geuzennaam.",
                            "target_lang_translations": {
                                "en": "Some gay people nowadays use the word <w>queer</w> as a badge of pride."
                            }
                        }
                    ],
                    "synonyms": [
                        "homo",
                        "janet",
                        "mietje",
                        "zemmel"
                    ],
                    "common_phrases": [
                        "vuile flikker"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Often used as a derogatory term or reclaimed slang."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A homosexual man (often used pejoratively or as an insult, but sometimes reclaimed as a badge of pride)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "faggot",
                                "target_lang_sense_clarification": "highly offensive slur"
                            },
                            {
                                "target_lang_word": "queer",
                                "target_lang_sense_clarification": "sometimes reclaimed, but can be offensive depending on context"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e369b589-7139-3c71-b282-89b2fcefa661",
                    "sense_definition": "Een gemene, vervelende man; een klootzak.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "scheldwoord",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wat een <w>flikker</w> is dat toch, om ons zo in de steek te laten!",
                            "target_lang_translations": {
                                "en": "What a <w>bastard</w> he is, leaving us in the lurch like that!"
                            }
                        },
                        {
                            "text": "Hij gedroeg zich als een echte <w>flikker</w> tijdens de vergadering.",
                            "target_lang_translations": {
                                "en": "He behaved like a real <w>asshole</w> during the meeting."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a general insult."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "A mean, annoying man; an asshole or bastard."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "bastard",
                                "target_lang_sense_clarification": "obnoxious or unpleasant person"
                            },
                            {
                                "target_lang_word": "asshole",
                                "target_lang_sense_clarification": "vulgar term for a contemptible person"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "25b3e64b-37e6-3b27-a6ad-34d89553865b",
                    "sense_definition": "Helemaal niets, geen zier (vrijwel uitsluitend gebruikt in ontkennende zinnen).",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "niets",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het maakt me echt geen <w>flikker</w> uit wat we vanavond gaan eten.",
                            "target_lang_translations": {
                                "en": "I don't give a <w>shit</w> what we are eating tonight."
                            }
                        },
                        {
                            "text": "Ik snap er werkelijk geen <w>flikker</w> van.",
                            "target_lang_translations": {
                                "en": "I don't understand a single <w>thing</w> about it."
                            }
                        }
                    ],
                    "synonyms": [
                        "zier"
                    ],
                    "common_phrases": [
                        "geen flikker uitmaken"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Informal and slightly vulgar."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Absolutely nothing, not a single bit (almost exclusively used in negative sentences)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shit",
                                "target_lang_sense_clarification": "nothing at all, in negative contexts"
                            },
                            {
                                "target_lang_word": "damn",
                                "target_lang_sense_clarification": "not giving a damn / caring at all"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c39b2eb0-7e5d-3940-b125-6df2154ef80e",
                    "sense_definition": "Het menselijk lichaam of achterwerk, met name in de uitdrukking 'op zijn flikker geven' (slaan of berispen).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lichaam",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Als je nu niet luistert, krijg je dadelijk op je <w>flikker</w>.",
                            "target_lang_translations": {
                                "en": "If you don't listen now, you're going to get your <w>ass</w> kicked in a minute."
                            }
                        },
                        {
                            "text": "De leraar gaf de ondeugende leerlingen flink op hun <w>flikker</w>.",
                            "target_lang_translations": {
                                "en": "The teacher gave the naughty students a good <w>scolding</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "lijf"
                    ],
                    "common_phrases": [
                        "op je flikker krijgen",
                        "op zijn flikker geven"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Mainly used in specific idioms."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "The human body or backside, especially in the idiom 'op zijn flikker geven' (to beat or scold someone)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ass",
                                "target_lang_sense_clarification": "backside, used in idioms of punishment"
                            },
                            {
                                "target_lang_word": "hide",
                                "target_lang_sense_clarification": "skin or body, as in 'to tan someone's hide'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3190b856-709e-3c94-8712-ff6657e17818",
                    "sense_definition": "Iemand die spullen repareert of lapt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "beroep",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De oude schoenlapper was een bekende <w>flikker</w> in de buurt.",
                            "target_lang_translations": {
                                "en": "The old cobbler was a well-known <w>mender</w> in the neighborhood."
                            }
                        },
                        {
                            "text": "Als handige <w>flikker</w> wist hij elk kapot apparaat weer aan de praat te krijgen.",
                            "target_lang_translations": {
                                "en": "As a handy <w>fixer</w>, he knew how to get every broken device working again."
                            }
                        }
                    ],
                    "synonyms": [
                        "fikser",
                        "reparateur"
                    ],
                    "traits": [
                        {
                            "trait_type": "obsolete",
                            "comment": "Historically used for a mender."
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Someone who repairs or mends things; a fixer or cobbler."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "mender",
                                "target_lang_sense_clarification": "someone who repairs things"
                            },
                            {
                                "target_lang_word": "tinker",
                                "target_lang_sense_clarification": "historical term for a traveling repairer"
                            }
                        ]
                    }
                }
            ]
        },
        {
