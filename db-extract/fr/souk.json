        "fr-extract.jsonl": [
            {
                "entry_id": "32f149ba-915b-30f5-9949-f7ffc99cccfc",
                "word": "souk",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "380a01ef-835d-4cd3-8cfc-f02c210fb170",
                        "entry_id": "32f149ba-915b-30f5-9949-f7ffc99cccfc",
                        "tags": [
                            "plural"
                        ],
                        "form": "souks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                        "entry_id": "32f149ba-915b-30f5-9949-f7ffc99cccfc",
                        "glosses": [
                            "Quartier commerçant d’une ville arabe, chaque rue étant spécialisée dans un type de produits."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84ff5639-08b8-4596-9183-6c0f48777d13",
                                "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                                "text": "Entre les deux camps se trouve le souk avec tous les éléments d’un marché indigène : marchands, conteurs d’histoires, jongleurs, charmeurs de serpents, danseuses, etc."
                            },
                            {
                                "example_id": "04f77a48-2508-47e1-9349-d5770453eeb0",
                                "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                                "text": "Celle que le Pacha ce soir m’a préférée,\nJ’en veux faire une mule et lui mettre un harnais\nPour la conduire au souk charrier la denrée !"
                            },
                            {
                                "example_id": "a47c766b-a4db-48cc-ab6a-32402cca3d0b",
                                "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                                "text": "Nazira et sa mère se trouvèrent enfin dans la rue Sagha, au souk de l’or."
                            },
                            {
                                "example_id": "5c23c5b7-0bb6-4262-8156-596d511ab94c",
                                "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                                "text": "Mais, le plus souvent, ils ne quittaient Sfax que pour retrouver, quelques dizaines ou quelques centaines de kilomètres plus loin, les mêmes rues mornes, les mêmes souks grouillants et incompréhensibles, les mêmes lagunes, les mêmes palmiers laids, la même aridité."
                            },
                            {
                                "example_id": "0ebcc60a-9ceb-44af-a1c0-5422a28f01ee",
                                "sense_id": "ba66a1ed-90fe-3bd7-aab1-9a2e013d9e6f",
                                "text": "À Jaffa, ce village de pêcheurs à côté de Tel-Aviv, je visitais le souk. Je me fis arnaquer en achetant des bijoux prétendument yéménites, mais je vis surtout des djellabas blanches, comme celles qu’il portait."
                            }
                        ]
                    },
                    {
                        "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                        "entry_id": "32f149ba-915b-30f5-9949-f7ffc99cccfc",
                        "glosses": [
                            "Grand désordre."
                        ],
                        "tags": [
                            "figuratively",
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "877945c2-cb65-46b2-a180-3a58a5af7322",
                                "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                                "text": "Non! Moi, je ne travaille pas dans ce souk…"
                            },
                            {
                                "example_id": "6615fce5-056c-47f7-a782-7b84bc378b37",
                                "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                                "text": "Tout sera bien rangé, personne ne viendra foutre le souk chez moi."
                            },
                            {
                                "example_id": "cc7da412-a810-478d-a089-994525e05a32",
                                "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                                "text": "Les enfants couchés tous ensemble dans la même chambre s’en donnaient à cœur joie de sottises multiples, malgré l’ordre proféré pour la forme de ne pas « faire le souk »."
                            },
                            {
                                "example_id": "371b672c-3113-460b-ae9a-8e777b139db6",
                                "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                                "text": "[…] bref il a « mis le souk » comme on dit de nos jours partout sauf dans les souks."
                            },
                            {
                                "example_id": "4d57eb71-2540-4b6a-9ec3-eae8a063595a",
                                "sense_id": "d8ca1c2d-01a5-3d0b-bc95-b9cdeb2bff8b",
                                "text": "L’odeur lui rappelle la fumerie de crack qui s’est montée l’année précédente dans une des tours de la cité, un souk d’enfer, plein de mecs à moitié morts – et même qu’une fois il y en a eu un qui a clamsé pour de bon, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3bd142a7-4e43-4bda-8c7e-59156a44ce32",
                        "source_entry_id": "32f149ba-915b-30f5-9949-f7ffc99cccfc",
                        "target_lang_word": "Souk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
