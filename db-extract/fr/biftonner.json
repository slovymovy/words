                        "glosses": [
                            "Écrire un billet pour correspondre, en particulier de façon clandestine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02c33e7c-0068-4851-829f-d092ef35c65d",
                                "sense_id": "8d3e37d9-835c-3359-8bb7-02a9afa054e9",
                                "text": "Je vous disais : nous avons déjà fait pas mal de boîtes ensemble et nous avons toujours trouvé une cheville pour biftonner : par les cuistots, les comptables, les visiteurs même."
