                                        "entry_id": "604f09ee-cc33-3f7c-8b77-07c76a3ac1b3",
                                        "glosses": [
                                            "auf dem Bildschirm in einzelnen Fragmenten (Pixeln) darstellen"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "69b76536-fc98-4efb-8734-9bf7b441a9d8",
                                                "sense_id": "35d9a3d9-97b5-31e4-8c4e-ef146d5914b6",
                                                "text": "Wieso pixelt das Fernsehbild jetzt? Wir haben doch Breitband."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ea42f932-f33f-3230-8dd4-99e591d1da34",
                                        "entry_id": "604f09ee-cc33-3f7c-8b77-07c76a3ac1b3",
                                        "glosses": [
                                            "durch die Darstellungsweise unscharf und dadurch unkenntlich machen"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a996e3a2-b2f9-4d6e-b08e-ad50aaf9824c",
                                                "sense_id": "ea42f932-f33f-3230-8dd4-99e591d1da34",
                                                "text": "Die Ansicht unseres Hauses bei Google würde ich schon gerne pixeln lassen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96c9b7a-743a-48f6-8848-762fefb1f681",
