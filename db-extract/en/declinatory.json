                "senses": [
                    {
                        "sense_id": "0b5dfe7c-3d08-385d-b725-7095d2987d02",
                        "entry_id": "dd157b13-1b54-3102-b74b-c43ade7c4fcc",
                        "glosses": [
                            "Containing or involving a declination or refusal, as of submission to a charge or sentence."
                        ],
                        "tags": [
                            "historical",
                            "not-comparable",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "88cedf27-7614-4ee3-8ff5-c21c37d867a9",
                                "sense_id": "0b5dfe7c-3d08-385d-b725-7095d2987d02",
                                "text": "[…] that the prisoner should first be arraigned, and might either then claim his benefit of clergy, by way of declinatory plea, or after conviction by way of arresting judgment."
                            },
                            {
                                "example_id": "507671f2-f1db-40a4-8f72-719b988a13fc",
                                "sense_id": "0b5dfe7c-3d08-385d-b725-7095d2987d02",
                                "text": "Declinatory exceptions do not tend to defeat the demand, but only to decline the jurisdiction of the judge before whom it is brought."
                            },
                            {
                                "example_id": "03df969d-2a5d-4e7f-b99b-4acfcb4e38c9",
                                "sense_id": "0b5dfe7c-3d08-385d-b725-7095d2987d02",
                                "text": "That case, like the present one, involved a declinatory exception by the respondent State when it was sued for fees for legal services and for an accounting."
                            }
                        ]
                    }
                ],
