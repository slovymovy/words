                "senses": [
                    {
                        "sense_id": "d6cd56e4-f168-3348-a48c-feb7d4152ae3",
                        "entry_id": "0080c761-77f8-35d3-80f4-53143567f31f",
                        "glosses": [
                            "eine Person, die Briefe zustellt; Briefträger"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c481d71e-dcf1-4ec5-83f4-3e445f6a521b",
                                "sense_id": "d6cd56e4-f168-3348-a48c-feb7d4152ae3",
                                "text": "Der Briefzusteller teilt die vielen Briefe zu langsam aus."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "258a25a5-f898-44b7-8067-69e6b37cad9c",
                        "source_entry_id": "0080c761-77f8-35d3-80f4-53143567f31f",
                        "source_sense_id": "d6cd56e4-f168-3348-a48c-feb7d4152ae3",
                        "source_sense_description": "eine Person, die Briefe zustellt; Briefträger",
                        "target_lang_word": "postman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "postman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "Someone who delivers the post (mail) to, and/or collects the post from, residential or commercial addresses, or from public mailboxes."
                                        ],
                                        "tags": [
                                            "Commonwealth",
                                            "Ireland",
                                            "UK"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8a34950-5ffd-4a12-a236-5afb01ed97cd",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The total of their members amounts to 342,723 for 1875. Among these number … 6,968 male and sixty-three female postmen, imperial railway, telegraph, and post officials, railway workmen, dependent boatmen, waiters, &c.; …"
                                            },
                                            {
                                                "example_id": "f98ffdbf-5275-4153-9fbe-b21c1e32242d",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "A single narrow iron-clamped door formed the only means of entrance. On this our guide knocked with a peculiar postman-like rat-tat."
                                            },
                                            {
                                                "example_id": "4a3da9dc-1c66-4e45-a759-de689c6e549f",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Please, Mr. Postman, look and see / Is there a letter in your bag for me? / Please, please, Mr. Po-o-ostman"
                                            },
                                            {
                                                "example_id": "dacf7bd5-b854-41f0-81b4-ad8a20107b86",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "The headmistress entered and told the girls \"I want you to do everything you can to help the war effort—you are old enough to do it now.\" The girls changed into women postmen, head waiters, soldiers, landgirls, butchers and carpenters."
                                            },
                                            {
                                                "example_id": "0543c322-f292-439a-80ee-d9afe2d3d659",
                                                "sense_id": "80555d8b-c812-34b9-b342-1ca97035d7c7",
                                                "text": "Postmen, binmen, dock workers, even barristers are now on strike. Where will all this end?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                        "entry_id": "805a16e7-f3d6-3ef7-8b6b-1d37cf434926",
                                        "glosses": [
                                            "One of the two most experienced barristers in the Court of Exchequer, who have precedence in motions, so called from the place where he sits, the other of the two being the tubman."
                                        ],
                                        "tags": [
                                            "England",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62483e68-5cd2-4ed3-9881-88c730d3bc6a",
                                                "sense_id": "fcf5011e-7293-3ea6-9743-1774571cd720",
                                                "text": "Postman of the Court of Exchequer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85428de8-3182-4eef-8a39-a93af797d8a7",
                        "source_entry_id": "0080c761-77f8-35d3-80f4-53143567f31f",
                        "source_sense_id": "d6cd56e4-f168-3348-a48c-feb7d4152ae3",
                        "source_sense_description": "eine Person, die Briefe zustellt; Briefträger",
                        "target_lang_word": "facteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "facteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "83046c67-def6-3a17-aad3-ad4c42692b5f",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Nombre ou variable constitutive d’un produit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "56778d9d-1b7a-4400-9e4e-23aca8b1fbde",
                                                "sense_id": "83046c67-def6-3a17-aad3-ad4c42692b5f",
                                                "text": "Les facteurs premiers d’un nombre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Les éléments qui concourent à un résultat."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cb58dbaf-8355-409d-926d-2a47aa785881",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "La préservation de la mémoire, dans le débat européen, doit être comprise comme un facteur de compréhension de l’autre."
                                            },
                                            {
                                                "example_id": "28379548-e6ad-47dc-8d4a-c1045fc7e1ce",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "Je pourrais choisir d’autres exemples, pour montrer que le facteur le plus déterminant de la politique sociale est la poltronnerie du gouvernement."
                                            },
                                            {
                                                "example_id": "74f2161e-ae1b-4178-8e5a-f0db3286a350",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "Le facteur le plus important, en dehors de la robustesse de mon navire et de tout son matériel, était la possibilité de « capayer » à la voile pendant un temps presque infini sans dépense de charbon, […]"
                                            },
                                            {
                                                "example_id": "19637010-b3ca-4fca-a4c7-9c6ee6e3106b",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "La germination de ces plantes exotiques dépend en effet d’un certain nombre de facteurs, les uns connus (…), les autres impondérables. Ces conditions n’étant réalisées qu’exceptionnellement, ainsi s’explique la fugacité de la plupart des espèces introduites."
                                            },
                                            {
                                                "example_id": "f42d78e4-22fb-403e-81a2-9b2d42261253",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "Prélavez le textile, qui tend à rétrécir au lavage, et prenez en compte ce facteur au moment de votre achat : le retrait du denim peut être important."
                                            },
                                            {
                                                "example_id": "65100a03-05dd-402b-8ea5-2285288bc3ef",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "L’objectif majeur de cette étude était d’identifier l’influence de différents facteurs dynamiques sur la distribution spatiale des matières en suspension dans une région côtière macrotidale et fortement influencée par les apports fluviaux."
                                            },
                                            {
                                                "example_id": "00029142-5e80-4290-9599-7a887848e8f0",
                                                "sense_id": "2c7ac398-11e9-307a-91b3-b34518d1d116",
                                                "text": "Laissées à l’abandon, les structures minières dégageraient du monoxyde de carbone et des hydrocarbures, responsables de l'épidémie de sommeil. Trois facteurs clés selon le centre national de sureté nucléaire qui a mené les recherches : le manque d'oxygène, le monoxyde de carbone et le taux d'hydrocarbure. Pris un par un, les taux étaient normaux, mais combinés, ils provoqueraient ces endormissements généralisés."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4cfc1991-f267-39ad-8fa1-38b2fdc2a990",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Fabricant d’instruments de musique autres que les instruments de la famille du luth et les instruments de la famille du violon (pour lesquels on parle de luthier)."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28aec199-3a79-4a63-be87-ef7c52f7f467",
                                                "sense_id": "4cfc1991-f267-39ad-8fa1-38b2fdc2a990",
                                                "text": "Sa réputation est bien établie dans l’histoire de la facture des instruments à vent, étant donné qu’il est le premier et le plus important facteur de sarrussophones."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6efe236f-286b-329d-85c3-33c224ab48d1",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Celui qui fabrique quelque chose."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0da3c0a-add4-4c6b-a5c9-e6b391583c7c",
                                                "sense_id": "6efe236f-286b-329d-85c3-33c224ab48d1",
                                                "text": "Étant le seul autorisé à porter une arme à feu, Gabriel Morange avait décidé que les garçons chasseraient à l’arc. Aussi avait-il demandé à un Dineh – réputé bon facteur d’arc – d’en confectionner deux, suffisamment petits pour pouvoir être aisément maniés par des enfants, mais assez puissants pour pouvoir transpercer la peau d’un cerf. Il sourit au souvenir, encore frais, de la joie qui avait inondé les enfants quand il leur avait offert ces armes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Agent qui est chargé de distribuer, de remettre à leurs adresses les lettres, objets et valeurs transmis par la poste."
                                        ],
                                        "tags": [
                                            "Métier",
                                            "Poste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c908995-9e3a-4b3b-b3a9-c1f416bdc689",
                                                "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                                "text": "Ils arrivèrent au manoir en même temps que le facteur rural qui apportait une lettre adressée M. le baron de Scaër."
                                            },
                                            {
                                                "example_id": "788b502c-8070-43d6-a02a-5a2de04b859f",
                                                "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                                "text": "Il descend dans le pays en songeant qu’il est facteur. C’est une bonne place, un bon métier. On peut dire tout ce qu’on voudra sur le métier de facteur — et au fond, il n’y a rien à dire — mais c’est un bon métier. L’uniforme, il faut en avoir soin, bien entendu, mais pour celui qui en a soin, il fait propre. Quand on rencontre un facteur, on voit tout de suite qu’il est facteur."
                                            },
                                            {
                                                "example_id": "a2a9159a-ba4c-4ef6-9c1f-08fe652e6d7e",
                                                "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                                "text": "Quand il entrait dans les maisons, c’était l’habitude de rire. On disait : « Voilà le facteur. » Et il répondait : « Oui, c’est moi. » On riait parce que c’était plaisir de voir entrer un bon facteur."
                                            },
                                            {
                                                "example_id": "9c691508-0627-49be-b94a-7a6c0d1c7c63",
                                                "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                                "text": "Honoré regardait le facteur et lui voyait bonne face, large et pleine, une face d’homme tranquille qui ne voit pas plus loin que son nez, mais qui voit son nez, et qui le voit bien ; une face de bon facteur qui arrive, à force de suivre son nez, à finir sa tournée sans se tromper une fois."
                                            },
                                            {
                                                "example_id": "1dbb9056-f2b1-4e73-b096-d9604959c2fb",
                                                "sense_id": "e89570c3-49e8-3aa5-877d-c92ad78761f4",
                                                "text": "Aujourd’hui, chacun calé dans sa bulle électromagnétique de Wi-Fi, c’est une autre vie qui commence. Une incarcération chez soi, dans laquelle il sera possible d’avoir accès à tout sans jamais voir personne - pas même son facteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf567766-00c5-3239-b370-0a4680a52702",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Employé qui, dans une gare de chemin de fer ou dans une entreprise de messagerie, charge, décharge, porte à leur destination les colis."
                                        ],
                                        "tags": [
                                            "Métier"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc1bbc84-23eb-4f99-badb-f1e9d229986c",
                                                "sense_id": "bf567766-00c5-3239-b370-0a4680a52702",
                                                "text": "— Voici la quarante-deuxième caisse qui arrive », me répond-il. Et, en effet, ladite caisse est au dos d’un facteur, engagé déjà sur le pont de l’embarcadère."
                                            },
                                            {
                                                "example_id": "29e891c5-071a-46a9-bc0b-9a11e65d4559",
                                                "sense_id": "bf567766-00c5-3239-b370-0a4680a52702",
                                                "text": "Le rapide de Marseille était formé sur le quai, où couraient les facteurs et roulaient les camions dans la fumée et le bruit, sous la clarté livide qui tombait des vitrages."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091920fe-21c5-3dcd-a712-c48127de3389",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Celui qui est chargé de la vente en gros à la criée des denrées apportées aux halles."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "db4a171d-4d45-49ff-9df2-0b8d7f821d41",
                                                "sense_id": "091920fe-21c5-3dcd-a712-c48127de3389",
                                                "text": "Facteur des halles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f29ced16-d355-34b9-85ba-64ea8f6c7c78",
                                        "entry_id": "7d7ee44b-419e-3b06-a4bb-ec5aa5937e04",
                                        "glosses": [
                                            "Celui qui agit pour le compte d’autrui dans un trafic, dans un négoce."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f51140d6-3dfb-40ee-93f7-0479006fb5d7",
                                                "sense_id": "f29ced16-d355-34b9-85ba-64ea8f6c7c78",
                                                "text": "Riches par leur sol, le commerce est pour eux un moyen d’échange, et le désir du gain ne les porte pas à se faire les facteurs de leurs voisins."
                                            },
                                            {
                                                "example_id": "67a9b542-f4dd-4ef2-82cc-d4bcc645f102",
                                                "sense_id": "f29ced16-d355-34b9-85ba-64ea8f6c7c78",
                                                "text": "Trois ans après la prise de Québec, en 1766, le commerce des pelleteries reprit avec un nouvel entrain. Les facteurs anglais s’étaient familiarisés avec les difficultés de ce genre de trafic : ils connaissaient les moeurs du pays, les habitudes des Indiens, le mode qu’ils employaient dans leurs échanges."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
