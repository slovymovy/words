                "senses": [
                    {
                        "sense_id": "eef61a53-84b4-3a67-aef1-5ba0863931db",
                        "entry_id": "5ff4eb7c-f2e3-3b3a-baf2-debf60980136",
                        "glosses": [
                            "Verhandlung zwischen Arbeitgeber- und Arbeitnehmervertretung über die Höhe der Entlohnung der Arbeitnehmer"
                        ],
                        "tags": [
                            "Germany"
                        ],
                        "examples": [
                            {
                                "example_id": "66bd3322-a7ab-479f-87f6-57a717520173",
                                "sense_id": "eef61a53-84b4-3a67-aef1-5ba0863931db",
                                "text": "Die stundenlangen Tarifverhandlungen führten zu keinem befriedigenden Ergebnis."
                            },
                            {
                                "example_id": "75c294c9-34e8-427e-85ee-17de4bb8348c",
                                "sense_id": "eef61a53-84b4-3a67-aef1-5ba0863931db",
                                "text": "„Im Falle kollektivvertraglicher Änderungen hat der Bundesminister für Justiz die Arbeitsvergütung innerhalb eines Vierteljahres nach Abschluß der Tarifverhandlungen durch Verordnung anzupassen.“"
                            },
                            {
                                "example_id": "11b35758-6809-487f-b766-068c54075585",
                                "sense_id": "eef61a53-84b4-3a67-aef1-5ba0863931db",
                                "text": "„Der Arbeitgeberverband führt gemeinsame Tarifverhandlungen für alle Bundesländer außer Hessen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
