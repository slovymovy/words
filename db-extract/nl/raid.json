                "senses": [
                    {
                        "sense_id": "cef8daf1-76f2-3958-bf09-b9c7e8e3de9b",
                        "entry_id": "26e5719c-4d47-3145-85cb-04f9c6ef8636",
                        "glosses": [
                            "kortdurende militaire expeditie"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "dfce8fe0-607d-3557-8af4-8dd25374dcae",
                        "entry_id": "26e5719c-4d47-3145-85cb-04f9c6ef8636",
                        "glosses": [
                            "kortdurende gewelddadige actie in vredestijd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b54af23-b299-42e6-a547-c5f8bb3751d5",
                                "sense_id": "dfce8fe0-607d-3557-8af4-8dd25374dcae",
                                "text": "H. stond bekend als geradicaliseerd, had contacten met geradicaliseerde medegevangenen en riep tijdens zijn moordende raid door Luik herhaaldelijk allahu akbar. Volgens het federaal parket duidt ook de modus operandi, de manier waarop H. met messen en later politiewapens de politie te lijf ging, op een terreuraanslag."
                            },
                            {
                                "example_id": "290ea861-404f-46d2-a9b9-a7ed99b7188f",
                                "sense_id": "dfce8fe0-607d-3557-8af4-8dd25374dcae",
                                "text": "Het incident lijkt te passen in het patroon van steeds brutaler wordende stroperijpraktijken. In februari vielen stropers een Zuid-Afrikaans neushoornweeshuis binnen en vermoordden ze twee babyneushoorns voor hun hoorn. In maart pleegden stropers een hallucinante raid in een Franse zoo. Ze drongen het park binnen, schoten de vijf jaar oude neushoorn Vince dood en sneden met een kettingzaag de hoorn van het dier af."
                            },
                            {
                                "example_id": "f5c565b6-3ef2-4fb5-8cb4-47f39717c75a",
                                "sense_id": "dfce8fe0-607d-3557-8af4-8dd25374dcae",
                                "text": "Zo werden er in februari 83 nieuwe pokemon toegevoegd aan de app en kunnen trainers sinds twee weken zeldzame pokemon vangen door met een groep deel te nemen aan raids (een gezamenlijk gevecht om zeldzame pokemon te vangen). Want hoewel de grote hype voorbij is, is Pokemon Go met 750 miljoen downloads en 12 miljoen dagelijkse gebruikers nog lang geen verleden tijd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9ffe9307-73d1-4e44-b156-9bcb6e522832",
                        "source_entry_id": "26e5719c-4d47-3145-85cb-04f9c6ef8636",
                        "source_sense_id": "cef8daf1-76f2-3958-bf09-b9c7e8e3de9b",
                        "source_sense_description": "kortdurende militaire expeditie",
                        "target_lang_word": "raid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "raid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "A quick hostile or predatory incursion or invasion in a battle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5fd2c82a-500b-493a-9c12-03e660926dd3",
                                                "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                                "text": "Marauding chief! his sole delight / The moonlight raid, the morning fight."
                                            },
                                            {
                                                "example_id": "aa179b6f-3f0b-4b34-becd-01ab335adf36",
                                                "sense_id": "12537c1a-7293-3f49-aeb7-285e5879ef0e",
                                                "text": "There are permanent conquests, temporary occupation, and occasional raids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An attack or invasion for the purpose of making arrests, seizing property, or plundering."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b21622b0-1367-4cc9-bcab-579bf7158ba1",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "a police raid of a narcotics factory"
                                            },
                                            {
                                                "example_id": "ea096cae-271a-4bd4-adf4-622402042171",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "a raid of contractors on the public treasury"
                                            },
                                            {
                                                "example_id": "3c9ebcca-34b5-451a-b7d7-a32eedad3487",
                                                "sense_id": "945adb23-65b4-3f59-b775-aec5647f1ac3",
                                                "text": "For Lothian and Borders Police, the early-morning raid had come at the end one of biggest investigations carried out by the force, which had originally presented a dossier of evidence on the murder of Jodi Jones to the Edinburgh procurator-fiscal, William Gallagher, on 25 November last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5751eb3d-44e4-3d93-a9e2-5d7812897c15",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An attacking movement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3a08824-5387-4c0f-8be1-9d263bd8b55c",
                                                "sense_id": "5751eb3d-44e4-3d93-a9e2-5d7812897c15",
                                                "text": "The athletic Walker, one of Tottenham's more effective attacking elements with his raids from right-back, made a timely intervention after Rose had been dispossessed and even Aaron Lennon was needed to provide an interception in the danger zone to foil another attempt by the Russians."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An activity initiated at or towards the end of a live broadcast by the broadcaster that sends its viewers to a different broadcast, primarily intended to boost the viewership of the receiving broadcaster. This is frequently accompanied by a message in the form of a hashtag that is posted in the broadcast's chat by the viewers."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12510d2c-180e-459b-966f-834670a4d5de",
                                                "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                                "text": "Now that Twitch is making raids an official part of the platform, however, some streamers think the new feature will make it easier to participate in the positive aspects of raiding."
                                            },
                                            {
                                                "example_id": "e3b36658-0093-4967-a2b4-b32901ee4a26",
                                                "sense_id": "c0c1ce5a-a199-39b1-9a20-118a9057f9db",
                                                "text": "Now streamers can use a new feature that lets their viewers join a raid then drive traffic to another streamer with just a click."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71c84ab9-8871-3f8c-b42c-3d8bf694b38b",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "A large group in a massively multiplayer online game, consisting of multiple parties who team up to defeat a powerful enemy."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                        "entry_id": "782476c2-aef2-3049-929b-bd3605c16ef2",
                                        "glosses": [
                                            "An event involving a group of users, often using bots and scripts, who join a server to harm it or harass its members."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "162d50de-57dd-40cf-8846-da65a97ac668",
                                                "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                                "text": "I used the tools discord gave me to prevent raids but he somehow knows a bypass, I use bots and they do help prevent it but just having him ping 90 guys once makes people bash me for an entire hour."
                                            },
                                            {
                                                "example_id": "eb81a46a-059f-4604-929a-fefc565af40a",
                                                "sense_id": "957eaa73-c868-3143-9ead-f5dd0f243c6b",
                                                "text": "Raids are a problem on Guilded. I have been in many servers that have been raided by a user with an account gen or even just some users looking to cause trouble and ruin the communities for us [...]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "raid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To engage in a raid against."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a4ecc1-2302-447c-82ce-e8c0c0de8b63",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "The police raided the gambling den."
                                            },
                                            {
                                                "example_id": "4d5c8f8b-dde5-4f5f-a108-ee794e2fab5b",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "The soldiers raided the village and burned it down."
                                            },
                                            {
                                                "example_id": "10478980-3a24-4c84-84c6-1dc1269beb73",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "A group of mobsters raided an art museum and stole a bunch of paintings."
                                            },
                                            {
                                                "example_id": "03685b44-5799-492e-ba7e-7640c6f6a217",
                                                "sense_id": "ff9b6b82-dcf6-3264-8c24-1940cebb30ce",
                                                "text": "Someone has been banned from Discord for raiding a server."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d415cfe3-e8d2-300c-a52f-e04ed2ab2866",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To lure from another; to entice away from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26ee00d4-79d4-31d6-bce8-eff2ad6f5a58",
                                        "entry_id": "9dd04e0d-3d2d-3512-aa26-d9d663ffe70d",
                                        "glosses": [
                                            "To indulge oneself by taking from."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "900c6a50-347c-4c7d-a5e1-1be38d103259",
                                                "sense_id": "26ee00d4-79d4-31d6-bce8-eff2ad6f5a58",
                                                "text": "I raided the fridge for snacks."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "053501cf-8cc2-4d3c-8440-52da37cd4395",
                        "source_entry_id": "26e5719c-4d47-3145-85cb-04f9c6ef8636",
                        "source_sense_id": "cef8daf1-76f2-3958-bf09-b9c7e8e3de9b",
                        "source_sense_description": "kortdurende militaire expeditie",
                        "target_lang_word": "foray",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "foray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9925469-ae56-3152-80a0-196bc0d29feb",
                                        "entry_id": "eff39acc-e2eb-32d0-ac33-810fb21a24f6",
                                        "glosses": [
                                            "A sudden or irregular incursion in border warfare; hence, any irregular incursion for war or spoils; a raid."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c937d718-cd50-36e4-945d-016829e86791",
                                        "entry_id": "eff39acc-e2eb-32d0-ac33-810fb21a24f6",
                                        "glosses": [
                                            "A brief excursion or attempt, especially outside one's accustomed sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb449c4-3a03-4beb-b28d-0b053caef1c9",
                                                "sense_id": "c937d718-cd50-36e4-945d-016829e86791",
                                                "text": "Bastian Schweinsteiger and Muller were among many who should have added the third, and City were limited to rare forays with the excellent Boateng pinching the ball off Aguero and Aleksandar Kolarov shooting wide in stoppage time."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "foray",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8c876c8e-6e79-3fd3-9a50-ea43c7481c2d",
                                        "entry_id": "3c696578-3a7a-307b-8677-82092cf29196",
                                        "glosses": [
                                            "To participate in a foray."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e5aefa0-4f2f-4a00-81ed-5b545f3f8d89",
                                                "sense_id": "8c876c8e-6e79-3fd3-9a50-ea43c7481c2d",
                                                "text": "The people of Granada resumed all at once their ancient activity, foraying into the Christian territories, surprising Alhendin and some other places of less importance, and stirring up the spirit of revolt in Guadix and other conquered cities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1a7a1f8a-d4f9-3f28-ae6e-64354716811d",
                                        "entry_id": "3c696578-3a7a-307b-8677-82092cf29196",
                                        "glosses": [
                                            "To do or attempt something outside one's typical area of expertise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39648a66-ac4d-4fb0-b8de-324f8985a5b4",
                                                "sense_id": "1a7a1f8a-d4f9-3f28-ae6e-64354716811d",
                                                "text": "\"It seems as though I have lived this life always. The world of books and bookish folk is very vague, more like a dream memory than an actuality. I surely have hunted and forayed and fought all the days of my life. And you, too, seem a part of it. You are -- \" I was on the verge of saying, \"my woman, my mate,\" but glibly changed it to -- \"standing the hardship well.\""
                                            },
                                            {
                                                "example_id": "2146efcf-79d4-4dc8-83a0-666c6b87a20d",
                                                "sense_id": "1a7a1f8a-d4f9-3f28-ae6e-64354716811d",
                                                "text": "Over the summer, I'd been following the news cycle, foraying into online journalism, and I wrote a couple of pieces on male victims of sexual violence, who are often left to the margins or forgotten altogether in feminist accounts of rape culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88bead4e-7bd0-308e-af1b-2d64d3717e40",
                                        "entry_id": "3c696578-3a7a-307b-8677-82092cf29196",
                                        "glosses": [
                                            "To scour an area for goods as part of a foray."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "109d27f8-33bf-487a-9165-2e6c06df1f23",
                                                "sense_id": "88bead4e-7bd0-308e-af1b-2d64d3717e40",
                                                "text": "He bad to open wyde his brazen gate,\n Which long time had bene shut, and out of hond\n Proclaymed joy and peace through all his state;\n For dead now was their foe which them forrayed late."
                                            },
                                            {
                                                "example_id": "98d267be-551b-42a1-9faf-68e5ef1bae58",
                                                "sense_id": "88bead4e-7bd0-308e-af1b-2d64d3717e40",
                                                "text": "Bruce forayed Cumberland, and threatened Berwick, so that the poor Countess of Buchan was removed from thence to a more secure place of captivity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
