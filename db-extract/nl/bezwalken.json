                        "cross_references": [
                            {
                                "target_word": "sully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c2257b60-6fb7-313a-ba32-d6d4120fa4bf",
                                        "entry_id": "8b6519f2-03bb-3cfe-81b3-d78469a26342",
                                        "glosses": [
                                            "To soil or stain; to dirty."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "943d9ed5-3df0-4109-8357-e942fecc2fbd",
                                                "sense_id": "c2257b60-6fb7-313a-ba32-d6d4120fa4bf",
                                                "text": "He did not wish to sully his hands with gardening."
                                            },
                                            {
                                                "example_id": "972a5e55-51a3-44e5-bc9f-43f04c43b085",
                                                "sense_id": "c2257b60-6fb7-313a-ba32-d6d4120fa4bf",
                                                "text": "THoſe Ills your Anceſtors have done, / Romans, are now become your own ; / And they will coſt you dear, / Unleſs you ſoon repair / The falling Temples which the Gods provoke, / And Statues ſully’d yet with Sacrilegious Smoke."
                                            },
                                            {
                                                "example_id": "a984a6ac-8b35-4506-9e04-21ccddcf7b01",
                                                "sense_id": "c2257b60-6fb7-313a-ba32-d6d4120fa4bf",
                                                "text": "His nether garment was of yellow nankeen, closely fitted to the shape, and tied at his bunches of knees by large knots of white ribbon, a good deal sullied by use."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f6b4989-8e6e-399a-b174-0d2b847b80b5",
                                        "entry_id": "8b6519f2-03bb-3cfe-81b3-d78469a26342",
                                        "glosses": [
                                            "To corrupt or damage."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "24bb34d9-5c38-47ca-bf63-eeac01471e77",
                                                "sense_id": "8f6b4989-8e6e-399a-b174-0d2b847b80b5",
                                                "text": "She tried to sully her rival’s reputation with a suggestive comment."
                                            },
                                            {
                                                "example_id": "3334beb1-2022-4a29-af5d-75669ec4cff0",
                                                "sense_id": "8f6b4989-8e6e-399a-b174-0d2b847b80b5",
                                                "text": "Ken Starr would later conclude that it was a mistake for him to expand into the Monica Lewinsky matter, largely because of the disastrous impact it would have on his Whitewater/Madison investigation and in sullying his otherwise sterling professional reputation."
                                            },
                                            {
                                                "example_id": "77754b03-7c80-46e6-8ab4-3f564d32326e",
                                                "sense_id": "8f6b4989-8e6e-399a-b174-0d2b847b80b5",
                                                "text": "As a child, Jane [Eyre] is completely bereft of love, living a loveless existence, which sullies her character. Her emotions are raw and, on the surface, completely out of control."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "764a58dc-c30c-3fe2-b06d-8f10a4756796",
                                        "entry_id": "8b6519f2-03bb-3cfe-81b3-d78469a26342",
                                        "glosses": [
                                            "To become soiled or tarnished."
                                        ],
                                        "tags": [
                                            "ergative",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "55ef8de5-0a0b-4028-902b-ecff01b02fb4",
                                                "sense_id": "764a58dc-c30c-3fe2-b06d-8f10a4756796",
                                                "text": "[G]old bears the fire, which ſilver doth not: but that is an excellency in nature, but it is nothing at all in uſe; for any dignity in uſe I know none, but that ſilvering will ſully and canker more than gilding; […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sully",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb04a6bc-547d-3ec4-9892-2cde3fc1db82",
                                        "entry_id": "d9d46ebd-c9e2-395a-a120-ef79fb7fb08e",
                                        "glosses": [
                                            "A blemish."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71b9b660-5f99-4eca-884f-9104e70f4596",
                                                "sense_id": "cb04a6bc-547d-3ec4-9892-2cde3fc1db82",
                                                "text": "You laying these ſlight ſallies on my ſonne, / As t'were a thing a little ſoyld with working, […]"
                                            },
                                            {
                                                "example_id": "9ddf3f23-7998-4811-9bc9-822439f59ff4",
                                                "sense_id": "cb04a6bc-547d-3ec4-9892-2cde3fc1db82",
                                                "text": "After all, it must be confessed, that a noble and triumphant merit often breaks through and dissipates these little spots and sullies in its reputation; but if, by a mistaken pursuit after fame, or through human infirmity any false step be made in the more momentous concerns of life, the whole scheme of ambitious designs is broken and disappointed."
                                            },
                                            {
                                                "example_id": "0cb48a55-6146-4e95-ba40-8bc4f937c3ee",
                                                "sense_id": "cb04a6bc-547d-3ec4-9892-2cde3fc1db82",
                                                "text": "Roses, ere their crimson breast / Throws aside its green moss vest; / Young hearts, or ere toil, or care, / Or gold, has left a sully there."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
