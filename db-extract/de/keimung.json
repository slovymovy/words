                "senses": [
                    {
                        "sense_id": "bc922531-093e-3199-aacb-efca2d016550",
                        "entry_id": "7e8f9e31-ee10-3c94-9e0f-b199f151210e",
                        "glosses": [
                            "Vorgang des keimen; Keime ausbilden und zu sprießen beginnen; Beginn des Wachstums einer Samenpflanze"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9299ab70-5ffc-4c0a-8fbd-c76b3559c3e9",
                                "sense_id": "bc922531-093e-3199-aacb-efca2d016550",
                                "text": "„Die Keimung vieler Samen hängt nicht nur von einem kritischen Wassergehalt, sondern auch von der Lichteinstrahlung ab.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3a4eaccf-5a4e-35df-a80a-ee8b36e6f4f3",
                        "entry_id": "7e8f9e31-ee10-3c94-9e0f-b199f151210e",
                        "glosses": [
                            "etwas entsteht als Gefühl oder als Gedanke in jemandem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a33dc10-67d9-4384-a3b4-743d434076fb",
                                "sense_id": "3a4eaccf-5a4e-35df-a80a-ee8b36e6f4f3",
                                "text": "Alle Ideen und Gedanken reifen im Denker und führen zur Keimung einer zündenden Idee; die wiederum ein Schöpfungsgedanke darstellt und die Welt verändert."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6a015650-4c7c-4acc-9091-1a90e5192ca8",
                        "source_entry_id": "7e8f9e31-ee10-3c94-9e0f-b199f151210e",
                        "source_sense_id": "bc922531-093e-3199-aacb-efca2d016550",
                        "target_lang_word": "germination",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "germination",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fb603f29-af97-3eb6-971e-f899194c456d",
                                        "entry_id": "9673a719-d2da-3bb7-ad94-7d7b8f04f395",
                                        "glosses": [
                                            "The process of germinating; the beginning of vegetation or growth from a seed or spore; the first development of germs, either animal or vegetable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83c3a062-c226-4b58-9b05-754fd0ae569d",
                                                "sense_id": "fb603f29-af97-3eb6-971e-f899194c456d",
                                                "text": "Both groups, also, have already evolved precocious (intracapsular) spore germination."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d600c630-4104-41ee-ba24-71156034e17b",
                        "source_entry_id": "7e8f9e31-ee10-3c94-9e0f-b199f151210e",
                        "source_sense_id": "bc922531-093e-3199-aacb-efca2d016550",
                        "target_lang_word": "germination",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "germination",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ec1e6f32-b217-39f5-8c05-9a36c247c673",
                                        "entry_id": "b38c4336-6dfa-32fd-b5dc-12af1dfa46ce",
                                        "glosses": [
                                            "Processus par lequel une graine ou une spore reprend son développement après une phase de dormance, sous l’effet de conditions favorables (eau, oxygène, température, lumière), et donne naissance à un nouvel individu végétal."
                                        ],
                                        "tags": [
                                            "Biologie végétale",
                                            "Physiologie végétale"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0bed839f-7030-4b5c-853f-539d6a65a196",
                                                "sense_id": "ec1e6f32-b217-39f5-8c05-9a36c247c673",
                                                "text": "Quand l'orge est bien germée, on la porte dans une étuve à courant d'air chaud, appelée touraille ; la chaleur arrête immédiatement la germination."
                                            },
                                            {
                                                "example_id": "c3709a43-f6fc-4598-a341-9795d084ecd4",
                                                "sense_id": "ec1e6f32-b217-39f5-8c05-9a36c247c673",
                                                "text": "Plusieurs savants se sont occupés du rôle de l’huile dans la germination des graines oléagineuses. Ils ont examiné la question de deux manières différentes : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fd428b5-35c2-3a95-827f-166fb5e1fd3d",
                                        "entry_id": "b38c4336-6dfa-32fd-b5dc-12af1dfa46ce",
                                        "glosses": [
                                            "Formation initiale d’un germe cristallin dans une solution, un fondu ou une vapeur, qui précède la croissance du cristal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dab1a6d9-3182-4f10-a758-7afa4769793c",
                                                "sense_id": "7fd428b5-35c2-3a95-827f-166fb5e1fd3d",
                                                "text": "Il se crée une période de latence très longue avant que des cristaux ne soient visibles en suspension. Cette période de latence se décompose en deux (ROQUES, 1964 ; GIROU et ROQUES, 1971) :\n — la première étape est la germination, qui correspond à la phase de plus forte sursaturation ; elle dure environ un mois en 1975 ;\n— la deuxième étape, qui se déroule également en un mois, est la croissance des cristaux à partir des germes cristallins extrêmement fins ; à ce moment la sursaturation diminue et s'annule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b555ebbd-b392-301f-a178-0e72bded91bf",
                                        "entry_id": "b38c4336-6dfa-32fd-b5dc-12af1dfa46ce",
                                        "glosses": [
                                            "Apparition, développement initial d’une idée, d’un phénomène ou d’un mouvement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33a7d9a0-6462-44df-9d9d-afa2bd0722fd",
                                                "sense_id": "b555ebbd-b392-301f-a178-0e72bded91bf",
                                                "text": "Des hommes poussaient, une armée noire, vengeresse, qui germait lentement dans les sillons, grandissant pour les récoltes du siècle futur, et dont la germination allait faire bientôt éclater la terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
