                    {
                        "translation_id": "9388739d-b374-469e-af01-0b5a3fd6bfda",
                        "source_entry_id": "deb22ff6-0416-37b0-b797-1c14fa603b79",
                        "source_sense_description": "province",
                        "target_lang_word": "Pawia",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pawia",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "1f3e308d-3a05-33e5-af90-b9ce61543f9e",
                                        "entry_id": "ee0cdb65-7349-36b8-b3ec-ecacb2354ae4",
                                        "glosses": [
                                            "miasto i gmina we Włoszech, w Lombardii, położone w zachodniej części Niziny Padańskiej nad rzeką Ticino"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787de175-c07f-429e-9120-12c5d601c55c",
                                                "sense_id": "1f3e308d-3a05-33e5-af90-b9ce61543f9e",
                                                "text": "W bitwie pod Pawią (1525) 3000 arkebuzerów pokonało 8000 francuskich rycerzy, czym ostatecznie zasygnalizowali koniec ery rycerstwa i dominacji ciężkiej kawalerii na polach bitew Europy"
                                            },
                                            {
                                                "example_id": "6147cd48-081d-4e8e-b609-fd13115d366a",
                                                "sense_id": "1f3e308d-3a05-33e5-af90-b9ce61543f9e",
                                                "text": "Wenecja wysyłała swoje statki po jedwab i korzenie, Pawia była wielkim punktem rozdzielczym towarów ze Wschodu"
                                            },
                                            {
                                                "example_id": "a42da332-ecc9-4602-8b2b-cdade7078e0c",
                                                "sense_id": "1f3e308d-3a05-33e5-af90-b9ce61543f9e",
                                                "text": "Dzięki pewnej stabilizacji politycznej w XI w. zaczęły powstawać szkoły prawnicze. Najważniejszą szkołą prawa w XI w. stała się Pawia — dawna stolica królestwa Longobardów. Prawnicy z Pawii zajmowali się jednak przede wszystkim prawem longobardzkim, tak jak zostało ono opisane w «Liber Papiensis»"
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "39786850-b230-3725-b11b-43fb876dd2b2",
                                        "entry_id": "ee0cdb65-7349-36b8-b3ec-ecacb2354ae4",
                                        "glosses": [
                                            "włoska prowincja położona na północy kraju, w Lombardii"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            },
