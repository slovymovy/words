{
    "word_family": [
        "border"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cdbd4cec-4e9b-33d4-867a-be42b4eb03db",
                    "sense_definition": "Nearly or not clearly on one side or the other of a boundary; ambiguous.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I would rather hire a talented person than a graduate with <w>borderline</w> qualifications.",
                            "target_lang_translations": {
                                "ru": "Я бы лучше нанял талантливого человека, чем выпускника с <w>сомнительной</w> квалификацией."
                            }
                        },
                        {
                            "text": "The business case for the new railway project was at best <w>borderline</w>.",
                            "target_lang_translations": {
                                "ru": "Экономическое обоснование нового железнодорожного проекта было в лучшем случае <w>спорным</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "marginal",
                        "ambiguous",
                        "uncertain"
                    ],
                    "common_phrases": [
                        "borderline case"
                    ],
                    "target_lang_definitions": {
                        "ru": "Находящийся на грани, едва удовлетворяющий требованиям или неоднозначный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пограничный",
                                "target_lang_sense_clarification": "находящийся на грани нормы или соответствия"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "неоднозначный, вызывающий вопросы"
                            },
                            {
                                "target_lang_word": "спорный",
                                "target_lang_sense_clarification": "на грани приемлемости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7db8e016-8e42-31ee-ad5f-182a16c23d1a",
                    "sense_definition": "Of questionable taste or acceptability; approaching bad taste.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Your <w>borderline</w> remarks about the dress were quite rude.",
                            "target_lang_translations": {
                                "ru": "Ваши замечания по поводу платья были <w>на грани приличия</w> и довольно грубыми."
                            }
                        },
                        {
                            "text": "The comedian made several <w>borderline</w> jokes that offended many people.",
                            "target_lang_translations": {
                                "ru": "Комик отпустил несколько шуток <w>на грани фола</w>, которые задели многих людей."
                            }
                        }
                    ],
                    "synonyms": [
                        "questionable",
                        "inappropriate"
                    ],
                    "target_lang_definitions": {
                        "ru": "Балансирующий на грани приличия или хорошего вкуса; рискованный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "на грани приличия",
                                "target_lang_sense_clarification": "о шутках, высказываниях"
                            },
                            {
                                "target_lang_word": "рискованный",
                                "target_lang_sense_clarification": "сомнительного вкуса"
                            },
                            {
                                "target_lang_word": "двусмысленный",
                                "target_lang_sense_clarification": "почти неприличный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aa9d8e65-f1ae-3c4b-baf2-abe7103ccff3",
                    "sense_definition": "Exhibiting borderline personality disorder.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She meets the clinical criteria for being <w>borderline</w>.",
                            "target_lang_translations": {
                                "ru": "Она соответствует клиническим критериям <w>пограничного расстройства</w>."
                            }
                        },
                        {
                            "text": "The patient shows <w>borderline</w> features alongside other anxiety symptoms.",
                            "target_lang_translations": {
                                "ru": "У пациента наблюдаются <w>пограничные</w> черты наряду с другими симптомами тревожности."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к пограничному расстройству личности или проявляющий его признаки."
                    },
                    "translations": {
                        "ru": [
                            {
