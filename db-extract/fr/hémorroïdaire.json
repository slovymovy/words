                        "sense_id": "e1ca98de-bdad-30de-87c3-948a18e189e9",
                        "entry_id": "17e11d5b-acdf-3699-be39-159f0f1d5374",
                        "glosses": [
                            "Qui est sujet aux hémorroïdes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b594a02-9ac1-4f18-aefc-66a5f9171b08",
                                "sense_id": "e1ca98de-bdad-30de-87c3-948a18e189e9",
                                "text": "Se dessina au fil de son imagination une galerie de fesses à la blancheur douteuse, de trous de balle hémorroïdaires, de derches de fiotes, de popotins pratiques, de croupes rétives, de derrières voluptueux, de raies au parfum de crevettes avariées."
                            },
                            {
                                "example_id": "2d43fba5-e163-4035-8f49-375207cb68df",
                                "sense_id": "e1ca98de-bdad-30de-87c3-948a18e189e9",
                                "text": "Agnès et Bruno ressentirent un étonnement chagriné à ne pas avoir vu venir cette mort que Pompidou portait sur lui, corps alourdi, visage bouffi, ils avaient voulu croire aux grippes à répétition et aux crises hémorroïdaires qui expliquaient sa démarche embarrassée."
                            }
                        ]
                    }
