                "senses": [
                    {
                        "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                        "entry_id": "c7fc2008-43d7-3779-91ab-bd14bb545d87",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b37aaa1f-9dd5-4798-96ae-fdb5037adfd1",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Frau Buuck ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bc3a10e8-4d6e-451c-adc9-0a584d2ca86c",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Herr Buuck wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dc7ff337-bcbc-46c3-91ec-243be2405e16",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Die Buucks fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d01e82fd-e92e-49ef-9be6-8ad2e5945ce0",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Der Buuck trägt nie die Schals, die die Buuck ihm strickt."
                            },
                            {
                                "example_id": "1de02dd6-5c46-4afa-9caa-5cf7d7205d84",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Buuck kommt, geht der Herr Buuck.“"
                            },
                            {
                                "example_id": "cb085675-e4aa-4243-84e1-f8ab022222a0",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Buuck kommt und geht."
                            },
                            {
                                "example_id": "f0025343-e018-4ed6-b125-1d12dde9b4a6",
                                "sense_id": "752d6404-0ba1-3121-b003-1daa1b61716a",
                                "text": "Buucks kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
