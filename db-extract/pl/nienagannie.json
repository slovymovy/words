                                "target_senses": [
                                    {
                                        "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                        "entry_id": "00020e77-8794-3d7c-9ba0-40b4901e068d",
                                        "glosses": [
                                            "In a perfect or flawless manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16b52299-5ed0-49a6-b433-a31ecf71074f",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "Arley's ferry boat has been replaced by a single-span pedestrian bridge. This leads to the old Harbour Inn and the impeccably restored railway station, now part of the privately run steam-operated Severn Valley Railway."
                                            },
                                            {
                                                "example_id": "2d4df45f-85c0-480a-97ce-5ddff84be33d",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "The great pianist was a prolific composer, who wrote impeccably for the piano."
                                            },
                                            {
                                                "example_id": "7ae703ec-a095-4f5c-8eeb-e5e0cf39546e",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "It is difficult to distinguish one bourgeois from another: the grande bourgeoisie are impeccably dressed at all times and don't speak to anyone outside their own class; the bonne bourgeoisie are impeccably dressed and speak to everyone; the petite bourgeoisie are impeccably dressed and speak only to complain[…]"
                                            },
                                            {
                                                "example_id": "d5cf2606-f436-4863-bf33-f5ce69c3f385",
                                                "sense_id": "3a2b5a5e-f4c6-33b9-9099-e3840237d9c1",
                                                "text": "In fact, even when I did make some small mistakes with grammar, people still said I spoke impeccably."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
