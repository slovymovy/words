                "senses": [
                    {
                        "sense_id": "10c5978f-7005-382c-8cd6-89b3a70d77e5",
                        "entry_id": "dc84f571-b27e-3d36-a740-1c938e7fddaa",
                        "glosses": [
                            "die bekannteste Pokémon-Spezies, vom Typ Elektro, mit der Nummer 025"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0765bf00-7ce8-409d-bd26-fcd7c46c990f",
                                "sense_id": "10c5978f-7005-382c-8cd6-89b3a70d77e5",
                                "text": "Pikachu entwickelt sich aus Pichu und kann sich zu Raichu weiterentwickeln."
                            },
                            {
                                "example_id": "cac5ac26-1fde-488d-90ab-e77c0d2c5231",
                                "sense_id": "10c5978f-7005-382c-8cd6-89b3a70d77e5",
                                "text": "Wenn sich mehrere Pikachu versammeln, kann ihre Energie Blitzgewitter erzeugen. (Beschreibung im Pokédex der Editionen Rot/Blau)"
                            },
                            {
                                "example_id": "78b05146-677b-48dd-8f2c-7d37ce719b39",
                                "sense_id": "10c5978f-7005-382c-8cd6-89b3a70d77e5",
                                "text": "Ist Pikachu angespannt, setzt es knisternd Elektrizität aus seinen Backentaschen frei. (Beschreibung im Pokédex der Edition Perl)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
