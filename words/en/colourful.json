                    "sense_id": "1242c24c-f507-3a06-821f-90f53020a0ee",
                    "sense_definition": "Having many bright colors; full of variety and interest.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "appearance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The garden was filled with <w>colourful</w> flowers that attracted many butterflies.",
                            "target_lang_translations": {
                                "ru": "Сад был полон <w>ярких</w> цветов, которые привлекали множество бабочек.",
                                "zh": "花园里开满了<w>色彩斑斓</w>的花朵，吸引了许多蝴蝶。"
                            }
                        },
                        {
                            "text": "She wore a <w>colourful</w> dress to the summer party.",
                            "target_lang_translations": {
                                "ru": "На летнюю вечеринку она надела <w>разноцветное</w> платье.",
                                "zh": "她穿了一条<w>色彩斑斓</w>的连衣裙去参加夏日派对。"
                            }
                        }
                    ],
                    "synonyms": [
                        "vibrant",
                        "bright",
                        "multicoloured"
                    ],
                    "antonyms": [
                        "colourless",
                        "drab",
                        "plain"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "British spelling"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Включающий грубые или оскорбительные слова, особенно нецензурную лексику.",
                        "nl": "Met veel heldere kleuren; vol variatie en interessant.",
                        "pl": "Posiadający wiele jasnych kolorów; pełen różnorodności i ciekawych elementów.",
                        "de": "Mit vielen hellen Farben versehen oder abwechslungsreich und interessant.",
                        "fr": "Qui présente de nombreuses couleurs vives ou qui est riche en variété et en intérêt.",
                        "it": "Che presenta molti colori vivaci, oppure che è ricco di varietà, interesse o elementi non convenzionali, o ancora, riferito al linguaggio, che contiene espressioni forti o volgari.",
                        "cs": "Mající mnoho jasných barev; plný rozmanitosti a zajímavosti.",
                        "tr": "Birçok parlak renge sahip; çeşitlilik ve ilgi çekici özelliklerle dolu.",
                        "es": "Que tiene muchos colores brillantes o que es variado e interesante.",
                        "zh": "具有多种鲜艳色彩的；充满多样性和趣味的；包含粗鲁或冒犯性词汇的。"
                    },
