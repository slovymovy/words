                            {
                                "target_lang_word": "обалдевший",
                                "target_lang_sense_clarification": "сильно удивленный или потрясенный"
                            },
                            {
                                "target_lang_word": "полуживой",
                                "target_lang_sense_clarification": "в контексте физического удара"
                            }
                        ],
                        "tr": [
