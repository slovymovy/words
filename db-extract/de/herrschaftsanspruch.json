                "senses": [
                    {
                        "sense_id": "dade48ae-9033-3ba8-b967-c4e3501bea8f",
                        "entry_id": "b3fdb09c-5622-37ac-934a-e9a60272feb9",
                        "glosses": [
                            "Anspruch auf Herrschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59e933f5-f4e8-4da3-a0c0-70d0cd397d66",
                                "sense_id": "dade48ae-9033-3ba8-b967-c4e3501bea8f",
                                "text": "„Der Herausforderer war der Hindu Hemu, der sich zur Legitimation seines Herrschaftsanspruchs den Königsnamen Vikramaditya zulegte.“"
                            },
                            {
                                "example_id": "4be8c0cd-978d-47d3-bf0d-d53a85df09d4",
                                "sense_id": "dade48ae-9033-3ba8-b967-c4e3501bea8f",
                                "text": "„Vor allem die Kleinstaaten der Rajputen verstanden es, sich immer wieder dem Herrschaftsanspruch der Großmoguln zu entziehen.“"
                            },
                            {
                                "example_id": "eb703e38-4157-4fe4-859f-101290fdd07e",
                                "sense_id": "dade48ae-9033-3ba8-b967-c4e3501bea8f",
                                "text": "„Als visuelle Manifestationen des kulturellen Gedächtnisses konnten Bilder nicht nur das Andenken an den Stifter garantieren, sondern zugleich im Hier und Jetzt Macht- oder Herrschaftsansprüche legitimieren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
