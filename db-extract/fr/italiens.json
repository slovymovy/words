                "senses": [
                    {
                        "sense_id": "a55ce48c-e666-3eda-bfe1-9eefd609ad5b",
                        "entry_id": "d184869c-b3d7-375c-94d5-37c34989763e",
                        "glosses": [
                            "Pluriel de Italien."
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "6eb33bb8-499b-4d26-b75b-a49c5acc1bab",
                                "sense_id": "a55ce48c-e666-3eda-bfe1-9eefd609ad5b",
                                "text": "Alain Ughetto rend hommage à sa famille dans Interdit aux chiens et aux Italiens, réalisé en stop motion (animation image par image), doublement récompensé au festival d’Annecy."
                            }
                        ]
                    },
                    {
                        "sense_id": "2a8c6ec7-4467-3628-ac0d-35d6ce9072b8",
                        "entry_id": "d184869c-b3d7-375c-94d5-37c34989763e",
                        "glosses": [
                            "Le peuple italien."
                        ],
                        "tags": [
                            "collectively"
                        ],
                        "examples": [
                            {
                                "example_id": "cca821b3-0f3d-41d5-9b74-8b4adcaadb72",
                                "sense_id": "2a8c6ec7-4467-3628-ac0d-35d6ce9072b8",
                                "text": "Si le reste de l’Europe voit en cette probable victoire l’ombre d’un « Italexit », les Italiens, eux, préfèrent rester optimistes."
                            },
                            {
                                "example_id": "c6ca2a71-c447-4c18-850c-ae82f69dca63",
                                "sense_id": "2a8c6ec7-4467-3628-ac0d-35d6ce9072b8",
                                "text": "Mené sur tout le territoire national, et destiné à frapper un grand coup contre la ’Ndrangheta, la mafia calabraise, ce « blitz » (comme disent les Italiens) avait pour épicentre Reggio de Calabre."
                            }
                        ]
                    }
