                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0954e850-aa21-42f0-8f60-924f659e215a",
                                                "sense_id": "9cb2970d-6b4e-3b8d-ae5c-dac7c7869048",
                                                "text": "Wanna be a trapper? Never serve a nigga where you live"
