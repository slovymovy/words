                        "glosses": [
                            "Mannequin représentant un géant, porté notamment à Douai lors de certaines manifestations locales."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a7a3e9ca-fdde-4f2d-a4a3-1e870bf5bd94",
                                "sense_id": "1cbed9ee-fdcf-3808-8bc5-205af5e7b600",
                                "text": "DOUAI – Les servantes lavent et nettoient partout. Les plus pauvres gens eux-mêmes, une fois au moins par an, à la fête de Gayant, lavent toute leur maison, intérieur et extérieur. Il faut retenir six mois à l’avance les peintres et les vernisseurs."
                            },
                            {
                                "example_id": "6642b14a-e536-4f84-aed4-a37a1c95ea33",
                                "sense_id": "1cbed9ee-fdcf-3808-8bc5-205af5e7b600",
                                "text": "Frédéric Masson avait, chose extraordinaire, grandi et blanchi en se voûtant, comparable à ces « gayants » grotesques des fêtes du nord qui font peur aux petits enfants."
                            }
                        ]
                    }
