                "senses": [
                    {
                        "sense_id": "456209ef-93a9-3ce1-b0db-d5e675e58b5e",
                        "entry_id": "643304c7-3b1b-32a2-bca2-fdf21f673891",
                        "glosses": [
                            "Tag, mit dem ein Monat beginnt; erster Tag eines Monats"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "83456c6c-01f9-4096-9a37-df1b5c38ae4c",
                                "sense_id": "456209ef-93a9-3ce1-b0db-d5e675e58b5e",
                                "text": "„Er fuhr nach Hause und erzählte seiner Frau Tanja empört, was vorgefallen war. Die hörte geduldig zu, nickte an den richtigen Stellen und sagte dann vorsichtig: »Schatz, morgen ist der Monatserste. Wenn du das heute nicht klärst, haben wir morgen kein Geld.«“"
                            },
                            {
                                "example_id": "4c33b792-597a-49bd-ac7b-6f35b4b5e746",
                                "sense_id": "456209ef-93a9-3ce1-b0db-d5e675e58b5e",
                                "text": "„Es ist immer Montag und immer der Monatserste im Kafeneion „Odysseus“ am Hafen von Vathy auf Ithaka, dort, wo alles Warten seinen Anfang hat, dort, wo einst Penelope ausharrte und sich der Schar dreister Freier erwehrte, bis Odysseus endlich heimkam, der Göttergleiche, dann war Ruhe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
