                        "sense_id": "41701258-3b9f-3636-8b12-8cd8ab723696",
                        "entry_id": "95be8d69-4616-3708-b417-4e4893bc232d",
                        "glosses": [
                            "Totality; completeness."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "c95d6fc0-a31b-4eb8-96c6-930b8a25d387",
                                "sense_id": "41701258-3b9f-3636-8b12-8cd8ab723696",
                                "text": "The REASON […] is the science of the universal, having the ideas of ONENESS and ALLNESS as its two elements or primary factors."
                            },
                            {
                                "example_id": "88ea440d-0e0e-40fe-8d5a-e60730bd17c8",
                                "sense_id": "41701258-3b9f-3636-8b12-8cd8ab723696",
                                "text": "The “allness” of God, including his absolute spirituality, supremacy, and eternity."
                            },
                            {
                                "example_id": "992c6e9b-6b5a-4968-bb5f-1255b87f1acb",
                                "sense_id": "41701258-3b9f-3636-8b12-8cd8ab723696",
                                "text": "1912, Rabindranath Tagore (translator), Gitanjali by Rabindranath Tagore, London: The India Society, poem 87, p. 51,\nOh, dip my emptied life into that ocean, plunge it into the deepest fulness. Let me for once feel that lost sweet touch in the allness of the universe."
                            },
                            {
                                "example_id": "111aa09b-bf12-40d9-9d7d-0fad14dcdd97",
                                "sense_id": "41701258-3b9f-3636-8b12-8cd8ab723696",
                                "text": "The moment he entered the pullman he was transported instantly from the vast allness of general humanity in the station into the familiar geography of his home town."
                            }
                        ]
                    }
                ],
