                                        "entry_id": "e3ecd5f3-258e-3285-a081-4acabe0d6ca9",
                                        "glosses": [
                                            "eine Stadt in Saudi-Arabien, der heiligste Ort des Islams und Ziel der obligatorischen Pilgerfahrt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "398ed2e2-99cb-4497-a81f-ed5ae3042211",
                                                "sense_id": "4935cf6b-2de2-3cd6-912b-04b5b127d023",
                                                "text": "Der Prophet Mohammed floh mit seinen Anhängern von Mekka nach Medina."
                                            },
                                            {
                                                "example_id": "ea0cad5d-90f4-4d49-a8b5-99f121b85432",
                                                "sense_id": "4935cf6b-2de2-3cd6-912b-04b5b127d023",
                                                "text": "„Anlass für hitzige Debatten über das bereits im Dezember ausgesprochene Schach-Verbot ist das am Freitag in Mekka stattfindende Schachturnier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Mekka",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fc102d58-b910-3a46-be3d-ad6b271b98c6",
                                        "entry_id": "fa5eb306-929f-3895-9676-c80cb2d5548c",
                                        "glosses": [
                                            "ein wichtiger Ort für Menschen einer bestimmten Zielgruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b57ba2b-4bce-4e33-9f03-305ed78b8d29",
                                                "sense_id": "fc102d58-b910-3a46-be3d-ad6b271b98c6",
                                                "text": "In den Sommermonaten wird Sylt jedes Jahr zum Mekka der High Society."
                                            },
                                            {
                                                "example_id": "88364878-5807-4db5-85f2-43f2e801120e",
                                                "sense_id": "fc102d58-b910-3a46-be3d-ad6b271b98c6",
                                                "text": "„Der Berg zieht Profikletterer genauso an wie Hobbyalpinisten, er ist zum Mekka von Sinnsuchern geworden.“"
                                            },
                                            {
                                                "example_id": "d5e271e4-e8e2-4eaa-bb7c-48696caf614a",
                                                "sense_id": "fc102d58-b910-3a46-be3d-ad6b271b98c6",
                                                "text": "„Erste Standorte waren die Kawarau-Bridge und die Skippers Canyon Bridge. Seitdem entwickelte sich Neuseeland zum Mekka der Bungeespringer und des Abenteuer-Tourismus schlechthin.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
