                ],
                "senses": [
                    {
                        "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                        "entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "glosses": [
                            "Wende in die entgegengesetzte Richtung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca13c31c-5a89-4977-b656-75fe47811e10",
                                "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                                "text": "Die wichtigste Frage, wer die Kehrtwende von einer Fünf-Prozent-Rezession in diesem Jahr zu einem 1,2-Prozent-Wachstum im kommenden herbeizaubern soll, bleibt offen."
                            },
                            {
                                "example_id": "fb1e42ee-46aa-4e05-ac4a-0b0a40670e8a",
                                "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                                "text": "„Die Havarie-Reaktoren haben die Kanzlerin zur schnellsten politischen Kehrtwende der Nachkriegsgeschichte bewogen und ihre staunende Union mit einer neuen bürgerlichen Anti-AKW-Bewegung konfrontiert.“"
                            },
                            {
                                "example_id": "5437dc9a-b134-4eec-b309-9066ecefb4c3",
                                "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                                "text": "„Man ahnte, dass die nächste Kehrtwende in der Versorgungspolitik rasch kommen würde.“"
                            },
                            {
                                "example_id": "2d8f6141-d966-41c9-9a78-ac916ad130ff",
                                "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                                "text": "„Man hatte Ständer aufgestellt und so mit gelbem Absperrband verbunden, dass sie einen Korridor mit labyrinthartigen Kehrtwendungen bildeten.“"
                            },
                            {
                                "example_id": "7510fc97-bd95-490e-8dff-f87231605a99",
                                "sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                                "text": "„Nun aber hat sie eine Kehrtwende vollzogen und gemeinsam mit der AfD den Begriff übernommen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66f08b49-837a-4d40-a560-a6c5e96a5bcf",
                        "source_entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "source_sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
                        "source_sense_description": "Wende in die entgegengesetzte Richtung",
                        "target_lang_word": "U-turn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "U-turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2206a519-20f3-3b7e-a64b-2d2975a7f6b3",
                                        "entry_id": "90e89974-77e8-373d-8a0a-4edeab15fed0",
                                        "glosses": [
                                            "A turn in a vehicle carried out by driving in a semicircle in order to travel in the opposite direction."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "963503ac-2ab8-4e2d-9041-676bfa47e423",
                                                "sense_id": "2206a519-20f3-3b7e-a64b-2d2975a7f6b3",
                                                "text": "What's disappointing about all this doom and gloom is that the franchise has made the kind of whiplashing U-turn you might see in its car-chase sequences."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                        "entry_id": "90e89974-77e8-373d-8a0a-4edeab15fed0",
                                        "glosses": [
                                            "A reversal of policy or opinion."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d45cd7c3-ddcc-440f-a033-c70f0819d373",
                                                "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                                "text": "The government have done a U-turn and are now supporting greater European integration instead of opposing it."
                                            },
                                            {
                                                "example_id": "4085e311-f18e-4537-b992-61ea220679ae",
                                                "sense_id": "5ab024b5-4aa6-32c4-84d8-30f16ad74a21",
                                                "text": "Rishi Sunak, the UK prime minister, announced a major U-turn on the government’s climate commitments last month, pushing back the deadline for selling new petrol and diesel cars and the phasing out of gas boilers."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "U-turn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b977e62d-caff-3a10-93f5-f0de9162aeed",
                                        "entry_id": "a4551d5b-c036-3a2d-929a-648d025181da",
                                        "glosses": [
                                            "To turn a vehicle in a semicircle so as to face the opposite direction (∩))."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "88b8479a-2a79-3f96-ade0-86a1d2494aa5",
                                        "entry_id": "a4551d5b-c036-3a2d-929a-648d025181da",
                                        "glosses": [
                                            "To shift from one opinion or decision to its opposite."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1a96ef82-8aa5-46c6-9597-e08a9d658fc9",
                                                "sense_id": "88b8479a-2a79-3f96-ade0-86a1d2494aa5",
                                                "text": "She made the case for cutting taxes as “the right thing to do morally and economically”, despite having just U-turned over her decision to abolish the 45p top rate of income tax."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5c2d82fd-e555-4810-a0c7-3bbe1a2e17eb",
                        "source_entry_id": "25957ae2-daeb-30cc-8fc3-27f2fc3a6d93",
                        "source_sense_id": "64317205-d7db-3917-850e-e2f38c72762c",
