                        "sense_id": "6275572e-a400-3f31-8472-9d4cc72b0995",
                        "entry_id": "b9802005-6956-3551-a4b1-523e6826f96a",
                        "glosses": [
                            "Qui souffre de nanocéphalie."
                        ],
                        "tags": [
                            "Génétique"
                        ],
                        "examples": [
                            {
                                "example_id": "cca0c4d2-3470-4b28-9268-aad073b3c748",
                                "sense_id": "6275572e-a400-3f31-8472-9d4cc72b0995",
                                "text": "Un individu est qualifié de nanocéphale lorsque sa tête présente une taille exagérément petite. Cette pathologie est généralement associée, du fait de la petitesse de l’encéphale, à un retard mental plus ou moins marqué."
                            },
                            {
                                "example_id": "83da4a8c-e488-4765-90ff-ecceb445f410",
                                "sense_id": "6275572e-a400-3f31-8472-9d4cc72b0995",
                                "text": "Certains spermatozoïdes sont aussi qualifiés de nanocéphales, lorsque la tête est anormalement petite."
                            }
                        ]
                    }
                ],
