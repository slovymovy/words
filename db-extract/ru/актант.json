                    },
                    {
                        "translation_id": "5c8bfc94-8475-42b7-abd2-f701d3724196",
                        "source_entry_id": "21f81c32-c31c-34d4-b4bc-acfe1f60cccc",
                        "source_sense_description": "активный, значимый участник ситуации",
                        "target_lang_word": "Aktant",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Aktant",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                        "entry_id": "049cadbf-ceee-30eb-8bf4-d363412f96b9",
                                        "glosses": [
                                            "von der Valenz einer Wortart, insbesondere eines Verbs abhängiges, für die Bildung eines grammatikalischen Satzes obligatorisches oder fakultatives Satzglied"
                                        ],
                                        "tags": [
                                            "Dependenzgrammatik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32079e98-b6b9-4a85-8371-73f3868d9033",
                                                "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                                "text": "Das trivalente (dreiwertige) Verb „verkaufen“ erfordert folgende Aktanten: das Subjekt „Verkäufer“, das Akkusativobjekt „Verkaufsgegenstand“ und das Dativobjekt „Käufer“."
                                            },
                                            {
                                                "example_id": "30c056cf-2bc0-4caf-9ead-7348e8bbf224",
                                                "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                                "text": "Im Satz „Paul döst.“ ist Paul der erste und einzig erforderliche Aktant."
                                            },
                                            {
                                                "example_id": "a05267da-aee3-40d5-ba63-de6c0ef6f20e",
                                                "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                                "text": "Aktanten sind semantisch betrachtet Agens und Patiens, syntaktisch Subjekt und Objekt."
                                            },
                                            {
                                                "example_id": "703b76a5-16f8-4467-a775-9dce86c4f8c4",
                                                "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                                "text": "Witterungsimpersonalia, wie zum Beispiel „blitzen, donnern, hageln, nieseln, regnen, schneien“, erfordern keinen Aktanten."
                                            },
                                            {
                                                "example_id": "efe15d97-e4c3-4835-b46f-d9a242576b65",
                                                "sense_id": "428c86dd-05b1-396f-98f0-e07009ba4b1a",
                                                "text": "Bei Imperativsätzen wird die Wertigkeit eines Verbs nicht vollständig gesättigt, da der erste Aktant nicht auftritt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "acc3f8c5-6281-4c9e-9caf-2a0ee6848ec3",
                        "source_entry_id": "21f81c32-c31c-34d4-b4bc-acfe1f60cccc",
                        "source_sense_description": "активный, значимый участник ситуации",
                        "target_lang_word": "actant",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ecbd83d2-d549-3a0d-8f3b-b1e6553de39d",
                                        "entry_id": "59dea2d1-eda7-3791-8183-cd8c5fed48fa",
                                        "glosses": [
                                            "Constituant syntaxique imposé comme paramètre par la valence de certaines classes lexicales, comme le verbe principalement, mais aussi l’adjectif, la préposition, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4274cd4f-720a-4243-9b0b-58382882f7ce",
                                                "sense_id": "ecbd83d2-d549-3a0d-8f3b-b1e6553de39d",
                                                "text": "Chaque actant, outre son rôle grammatical, joue un rôle sémantique."
                                            },
                                            {
                                                "example_id": "187b4ca3-489e-49a0-944d-bc03c897b44a",
                                                "sense_id": "ecbd83d2-d549-3a0d-8f3b-b1e6553de39d",
                                                "text": "Dans la phrase Il pleut , il n’y a pas d’actant."
                                            },
                                            {
                                                "example_id": "00c5ae1b-0a6f-4f90-8663-8d033a877352",
                                                "sense_id": "ecbd83d2-d549-3a0d-8f3b-b1e6553de39d",
                                                "text": "Comme à l’accoutumée, c’est dans le lieu par excellence de la manifestation sémantique, le discours, que nous rencontrerons l’actant comme une force non plus inerte mais en pleine phase de transitivité."
                                            },
                                            {
                                                "example_id": "4168bd6b-5ddb-4187-abd8-1c030bb722fd",
                                                "sense_id": "ecbd83d2-d549-3a0d-8f3b-b1e6553de39d",
                                                "text": "On se demande pourquoi l’Université s’obstine à enseigner les principes narratifs à coups de Propp, Greimas ou autres pensums au lieu d’investir dans une salle de projection. Prémices, intrigue, actants, péripéties, quête, héros et autres adjuvants : il vous suffit d’un Sean Connery en uniforme de sous-marinier russe et de quelques porte-avions bien placés."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "actant",
                                "target_lang_code": "fr",
                                "target_senses": [
