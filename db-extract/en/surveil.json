                                        "entry_id": "3536a0a8-3e39-3e64-bdd5-0e8f92e5b6f0",
                                        "glosses": [
                                            "jemanden oder etwas zu einem Zweck auf Veränderungen hin beobachten, jemanden zu einem Zweck bei Handlungen beobachten"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "227169fe-6aac-48e8-8a26-cb459c166a8d",
                                                "sense_id": "15fe8690-0e9b-3d9b-a1ec-378bf556748e",
                                                "text": "Die Temperatur und die Luftfeuchtigkeit im Gewächshaus sollte immer überwacht werden."
                                            },
                                            {
                                                "example_id": "62b53534-64b2-4293-aaed-7e7ae3be2be4",
                                                "sense_id": "15fe8690-0e9b-3d9b-a1ec-378bf556748e",
                                                "text": "An vielen öffentlichen Plätzen sind Kameras installiert, die das Gelände und Personen auf kriminelle Handlungen hin überwachen."
                                            },
                                            {
                                                "example_id": "731c06c3-f76f-4b60-9950-7ffd8267a972",
                                                "sense_id": "15fe8690-0e9b-3d9b-a1ec-378bf556748e",
                                                "text": "„Den allgegenwärtigen Terror bekommen auch die Soldaten der UN-Mission Minusma zu spüren, die in Gao und anderen Städten den Friedensprozess überwachen.“"
                                            }
