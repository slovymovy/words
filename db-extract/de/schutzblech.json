                    }
                ],
                "senses": [
                    {
                        "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                        "entry_id": "65239c0a-d41c-38cd-be54-1a8a24967440",
                        "glosses": [
                            "über dem Vorder- und Hinterrad angebrachte Schutzeinrichtung, die den Fahrradfahrer vor Spritzwasser schützt"
                        ],
                        "tags": [
                            "Fahrradtechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "2390ee11-61ba-4b25-900a-10e8aaf69c1b",
                                "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                                "text": "„Das Canyon Commuter kommt zwar mausgrau lackiert daher, hat es aber in sich. Hier waren Designer am Werk, die wissen, dass ein Rad im Alltag auch Beleuchtung und Schutzbleche braucht. Diese Ingredienzien sind am und im Rahmen unauffällig integriert und stören nicht den Look, ganz im Gegenteil.“"
                            },
                            {
                                "example_id": "c5fa1613-7883-4856-bd1f-2eb7767e15aa",
                                "sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                                "text": "„Die Handbremse funktionierte jetzt, auch der Dynamo und beide Scheinwerfer, die Kette war frisch geölt und das vordere Schutzblech saß wieder fest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "f7a45e7e-5825-3418-93a9-951746ded6c0",
                        "entry_id": "65239c0a-d41c-38cd-be54-1a8a24967440",
                        "glosses": [
                            "schützende Blechvorrichtung über beweglichen Maschinenteilen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f85bf86f-693b-43f1-b2af-8186786e288a",
                        "source_entry_id": "65239c0a-d41c-38cd-be54-1a8a24967440",
                        "source_sense_id": "93f50dda-b0f2-364d-b80c-76c7781167b7",
                        "target_lang_word": "fender",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fender",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b5de405f-c67a-3f9a-9d37-31c7a39e9412",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "panel of a car which encloses the wheel area, especially the front wheels."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "de55e4e1-c447-3eb6-b39f-516fcf966cf4",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "a shield, usually of plastic or metal, on a bicycle that protects the rider from mud or water"
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3b4715a8-8fb2-326e-ae11-30cc457eb529",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "any shaped cushion-like object normally made from polymers, rubber or wood that is placed along the sides of a boat to prevent damage when moored alongside another vessel or jetty, or when using a lock, etc. Modern variations are cylindrical although older wooden version and rubbing strips can still be found; old tyres are used as a cheap substitute"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                        "entry_id": "9663b740-8df0-3c5d-a3bb-353c11be2d1d",
                                        "glosses": [
                                            "a low metal framework in front of a fireplace, intended to catch hot coals, soot, and ash"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a57dec2-2113-4b34-8b20-d9696445abc6",
                                                "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                                "text": "Now and then he would make a motion with his feet as if he were running quickly backward upstairs, and would tread on the edge of the fender, so that the fire-irons went flying and the buttered-bun dishes crashed against each other in the hearth."
                                            },
                                            {
                                                "example_id": "1d0564cf-6508-415a-9ead-194a91933ac7",
                                                "sense_id": "bd8afe4e-a515-30de-ac95-5a4b7ced1acc",
                                                "text": "Our solid, shiny chairs, our immense, dingy sofas, our heavy mahogany tables and our cast-iron fenders, often bearing the initials of long-dead railway companies, likewise our plaster walls of chocolate and duck-egg green and our hissing gasoliers have their roots deep in our national history."
                                            }
                                        ]
                                    }
                                ]
                            },
