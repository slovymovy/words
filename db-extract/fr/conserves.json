        "fr-extract.jsonl": [
            {
                "entry_id": "94f1bcfa-5f5c-3740-91de-8a3213126cc4",
                "word": "conserves",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "661ceb5a-c0a1-304a-a941-162b26480642",
                        "entry_id": "94f1bcfa-5f5c-3740-91de-8a3213126cc4",
                        "glosses": [
                            "Lunettes qui grossissent peu les objets et qui sont spécialement préparées pour ne pas fatiguer ou pour conserver la vue."
                        ],
                        "tags": [
                            "plural"
                        ],
                        "examples": [
                            {
                                "example_id": "26016c7c-8399-4536-a81a-e5b2e9b86d8a",
                                "sense_id": "661ceb5a-c0a1-304a-a941-162b26480642",
                                "text": "Il se sert de conserves. Il met des conserves."
                            },
                            {
                                "example_id": "b18794c3-a28f-4b70-b80b-2911b744ebc5",
                                "sense_id": "661ceb5a-c0a1-304a-a941-162b26480642",
                                "text": "— Je vais rejoindre le Gouvernement ! Allez-vous m’arrêter ? a-t-il crié avec des regards furibonds sous ses conserves.\nEh non ! on ne t’arrêtera pas ! Tu le sais bien, lâcheur ! toi qui n’as pas même le courage de suivre des yeux Paris en fièvre."
                            }
                        ]
                    }
                ],
