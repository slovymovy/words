                                "example_id": "eeb5d8dd-f26f-4a13-92fe-da4a63f23b18",
                                "sense_id": "5c1fcc88-e254-3406-ac9c-7ee45a47396f",
                                "text": "„Bei Stalkerinnen seien dagegen eher Rachegedanken ausschlaggebend für ein Nachstellen.“"
                            }
                        ],
