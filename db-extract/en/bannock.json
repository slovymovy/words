    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                "word": "bannock",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "cf6691cb-622c-4ba4-9c0b-8334d4bad8ab",
                        "entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "tags": [
                            "plural"
                        ],
                        "form": "bannocks"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d3904e56-895e-30a6-926d-6435e5fdab18",
                        "entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "glosses": [
                            "An unleavened bread, usually made with barleymeal, wheatmeal, or oatmeal; sometimes of peasemeal or otherwise."
                        ],
                        "tags": [
                            "Northern-England",
                            "Scotland",
                            "especially",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bac88888-a4e1-4888-af51-4a3b5fca7ecb",
                                "sense_id": "d3904e56-895e-30a6-926d-6435e5fdab18",
                                "text": "So she baked two oatmeal bannocks, and set them on to the fire to harden. After a while, the old man came in, and sat down beside the fire, and takes one of the bannocks, and snaps it through the middle."
                            }
                        ]
                    },
                    {
                        "sense_id": "433fb844-5845-3bc4-9ccc-7dc03ba06f0c",
                        "entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "glosses": [
                            "A biscuit bread made of wheat flour or cornmeal, fat, and sometimes baking powder, typically baked over a fire, wrapped around a stick or in a pan."
                        ],
                        "tags": [
                            "Canada",
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "f1ef0319-7117-4e9c-895f-f836a6d2bee5",
                                "sense_id": "433fb844-5845-3bc4-9ccc-7dc03ba06f0c",
                                "text": "“The boats are coming!” The cry rang through the village. Women left their bannock-baking, their basketweaving and hurried to the shore."
                            },
                            {
                                "example_id": "fc18fdec-6a1e-4859-9155-8e97ce164bad",
                                "sense_id": "433fb844-5845-3bc4-9ccc-7dc03ba06f0c",
                                "text": "My father’s bannock was nothing but lard, flour, salt, and baking powder patted into big rounds and cooked on sticks over a campfire."
                            }
                        ]
                    },
                    {
                        "sense_id": "a395af42-869d-3705-9e7c-51b895c5fd43",
                        "entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "glosses": [
                            "A biscuit bread made of wheat flour or cornmeal, fat, and sometimes baking powder, typically baked over a fire, wrapped around a stick or in a pan.",
                            "This or any similar traditional bread when made by indigenous Americans, originally from native sources such as maize or pseudocereals and plants with starchy roots"
                        ],
                        "tags": [
                            "Canada",
                            "specifically",
                            "uncountable",
                            "usually"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f7c02029-aabc-4e7e-9282-0c2deb897880",
                        "source_entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "source_sense_description": "English/Scottish bread",
                        "target_lang_word": "bannique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bannique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "595194f1-3955-31b7-9418-8817a556dfa4",
                                        "entry_id": "c5d16b65-169f-3145-8c95-c309df789de6",
                                        "glosses": [
                                            "Variante orthographique de banique."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dbf5283e-f0e2-4a74-b5d6-3c7d2266a142",
                                                "sense_id": "595194f1-3955-31b7-9418-8817a556dfa4",
                                                "text": "Le petit seau à sirop d’érable de Patrice, jaune et raclé jusqu’au métal, était plein de pâte à pain crue. Parfaitement. Elle l’avait pris au passage en sortant de chez elle, tellement secouée par la diatribe de son père qu’elle était partie précipitamment, oubliant qu’avant le petit-déjeuner elle avait prévu de frire la pâte à pain bannique dans la poêle de sa mère."
                                            },
                                            {
                                                "example_id": "362e2cee-ce4d-4151-959b-c24cc4c5a149",
                                                "sense_id": "595194f1-3955-31b7-9418-8817a556dfa4",
                                                "text": "La bannique est un aliment important chez les Premières Nations, Inuit et Métis, partout au Canada."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5e9637ea-6777-4140-9d16-8428027896ff",
                        "source_entry_id": "8036964e-0897-343b-bfbd-d05b9c32fdaa",
                        "source_sense_description": "Indigenous Canadian breads",
                        "target_lang_word": "beigne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "beigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "61b10a86-0092-3b23-a236-7c2d359afc56",
                                        "entry_id": "48ff5f40-3fe1-3a5b-aeeb-ce4c684cbaf9",
                                        "glosses": [
                                            "Bosse résultant d’un coup."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b0a6a7e-7c66-45a9-8442-a12115a90000",
                                                "sense_id": "61b10a86-0092-3b23-a236-7c2d359afc56",
                                                "text": "Et la jeune femme qui accourait reçut un coup de poing entre les deux yeux qui la fit pivoter sur elle-même et s’étaler de tout son long… L’homme parti, la femme se relevait. Elle avait une beigne sur l’œil."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                        "entry_id": "48ff5f40-3fe1-3a5b-aeeb-ce4c684cbaf9",
                                        "glosses": [
                                            "Coup à la tête, baffe, gifle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25911fe0-ada6-4d0a-90d8-20c217d3eabd",
                                                "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                                "text": "Ils ont tout ramassé\nDes beignes et des pavés\nIls ont gueulé si fort\nQu’ils peuvent gueuler encore"
                                            },
                                            {
                                                "example_id": "c6c21944-fedf-430e-8b25-afdeff1e52bd",
                                                "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                                "text": "Y m’a filé une beigne\nJ’lui ai filé une torgnole\nY m’a filé une châtaigne\nJ’lui ai filé mes grolles"
                                            },
                                            {
                                                "example_id": "e552b288-4114-4972-a4d5-4f4029d8e625",
                                                "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                                "text": "Je ne sais pas si les autres tantes étaient heureuses, mais elles n’avaient pas l’air éteint de Solange et elles ne se laissaient pas envoyer des beignes."
                                            },
                                            {
                                                "example_id": "e9e0189c-15ee-4c11-a0ea-13ff49d1c2c1",
                                                "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                                "text": "Ses incantations vénéneuses s’accompagnaient de beignes choisies qui ponctuaient ses doux poèmes. À la surprenante, en fin de tirade. À la ligne. Pan ! Dans la gueule."
                                            },
                                            {
                                                "example_id": "6f27f49f-c8b0-4602-b181-ef3f8576bffc",
                                                "sense_id": "7df94832-ac97-3afe-ae6d-9b2c522b432d",
                                                "text": "Et il leva le bras comme s'il voulait donner la beigne à son interlocuteur. Sans insister, celui-ci s'en alla de lui-même au sol, parmi les jambes des gens. Il avait une grosse envie de pleurer."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c0646cd8-d650-322e-9265-3505a9b316d8",
                                        "entry_id": "fb9bb0b7-6ee9-3654-89ee-2aa3cc8cab62",
                                        "glosses": [
                                            "Beignet sucré et toroïdal, d’origine nord-américaine."
                                        ],
                                        "tags": [
                                            "Amérique du Nord"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62402e93-79ad-424c-868b-8a22dbd9affa",
                                                "sense_id": "c0646cd8-d650-322e-9265-3505a9b316d8",
                                                "text": "Le tilapia d’élevage ne serait pas meilleur qu’un beigne ou un hamburger pour la santé."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "beigne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "43d40bd8-04ac-366d-a769-fb71e42f6e9c",
                                        "entry_id": "491b2bec-6ff8-3450-af6b-f7d4e3a095da",
