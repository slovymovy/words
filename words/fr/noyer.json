            "senses": [
                {
                    "sense_id": "0b858586-d6da-3fb3-b745-87eed650cf61",
                    "sense_definition": "Faire périr par asphyxie dans l'eau ou un autre liquide, ou y mourir soi-même.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mort_liquide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant a failli se <w>noyer</w> avant l'arrivée rapide des maîtres-nageurs."
                        },
                        {
                            "text": "Le marin imprudent est tombé du bateau et s'est <w>noyé</w> dans la mer agitée."
                        }
                    ],
                    "common_phrases": [
                        "risquer de se noyer"
                    ]
                },
                {
                    "sense_id": "5ef49b56-60ed-3da5-a26b-7cddb7b7e5cd",
