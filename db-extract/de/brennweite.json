                "translations": [
                    {
                        "translation_id": "77a10790-8efc-417e-b225-75c9bc17d1f4",
                        "source_entry_id": "167c108c-9d88-3b66-ae1e-bfaabbda5040",
                        "source_sense_id": "326bae49-144d-37f5-889c-028be1dbb4af",
                        "source_sense_description": "Optik: Abstand des Brennpunkts von der Hauptebene eines optischen Systems",
                        "target_lang_word": "focal length",
