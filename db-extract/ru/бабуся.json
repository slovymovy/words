                    },
                    {
                        "translation_id": "7105fd77-d1d5-4366-9a5f-fc45584f0d65",
                        "source_entry_id": "5252c866-5346-325b-8646-3a62882d18d8",
                        "source_sense_description": "ласк. к бабушка",
                        "target_lang_word": "Omi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Omi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7122a8c2-f8ab-3035-8774-d8e0604b7a27",
                                        "entry_id": "9db9a496-6211-37ab-80a8-8273d454adac",
                                        "glosses": [
                                            "Kosewort für Oma"
                                        ],
                                        "tags": [
                                            "familiär"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2b3c3be-cbf6-4080-bdc7-62c812a376a5",
                                                "sense_id": "7122a8c2-f8ab-3035-8774-d8e0604b7a27",
                                                "text": "Das ist meine Omi."
                                            },
                                            {
                                                "example_id": "bb5814c3-712f-49cd-b16d-bc6352c58627",
                                                "sense_id": "7122a8c2-f8ab-3035-8774-d8e0604b7a27",
                                                "text": "Hab keine Angst vor Omi, sie ist sehr nett."
                                            },
                                            {
                                                "example_id": "ec9f7ce5-bfc0-4272-b01a-9a2113c4fcbd",
                                                "sense_id": "7122a8c2-f8ab-3035-8774-d8e0604b7a27",
                                                "text": "Omis Apfelkuchen schmeckt am allerbesten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "81c3f78a-8f16-31b4-a946-1b9fa76cbfe4",
                                        "entry_id": "9db9a496-6211-37ab-80a8-8273d454adac",
                                        "glosses": [
                                            "ältere Frau"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b061d887-94e8-406f-9602-6c8fd3b6316b",
                                                "sense_id": "81c3f78a-8f16-31b4-a946-1b9fa76cbfe4",
                                                "text": "„Desorientiert watscheln die Omis und Opis durch die schicken Straßen, voller junger dynamischer Menschen. Längst wurden sie von den Wellen der Zeit überrollt.“"
                                            },
                                            {
                                                "example_id": "212aba45-bfa0-4c59-9f00-a42bc887d500",
                                                "sense_id": "81c3f78a-8f16-31b4-a946-1b9fa76cbfe4",
                                                "text": "„Die Jüngeren fragte man besser nur nach zehn oder zwanzig Cent, alles andere wäre ihnen unverschämt vorgekommen, während die alten Omis auch mal 'n bisschen tiefer in die Tasche griffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c488bf6-b7bb-4a3e-bb29-a93e16728fc9",
                        "source_entry_id": "5252c866-5346-325b-8646-3a62882d18d8",
                        "source_sense_description": "ласк. к бабушка",
                        "target_lang_word": "mémé",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mémé",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "76768623-5be1-3125-8f69-d325a7ac5eff",
                                        "entry_id": "4a16a1de-0f4a-3dbf-9b46-73bef66f8156",
                                        "glosses": [
                                            "Grand-mère."
                                        ],
                                        "tags": [],
                                        "note": "Considéré comme affectueux ou avilissant selon les perceptions et les sensibilités",
                                        "examples": [
                                            {
                                                "example_id": "2c511757-844e-47ea-9d10-3a8a3d83c948",
                                                "sense_id": "76768623-5be1-3125-8f69-d325a7ac5eff",
                                                "text": "Mémé a dit à papa que tu l’avais peut-être emmasqué pendant la partie, et qu’il devrait aller voir le vieux berger des collines de la Faralade pour le désemmasquer."
                                            },
                                            {
                                                "example_id": "dad3ea4e-6827-48e1-b63c-b9a5920027c7",
                                                "sense_id": "76768623-5be1-3125-8f69-d325a7ac5eff",
                                                "text": "Dis donc, mon garçon, sois poli. Veux-tu que j’appelle « lou peilharot », le menaça mémé Maguy en riant."
                                            },
                                            {
                                                "example_id": "fa7f1b59-d979-47b6-891d-eccba2f0e81d",
                                                "sense_id": "76768623-5be1-3125-8f69-d325a7ac5eff",
                                                "text": "La mémé Lucie rapetasse la blouse de son homme."
                                            },
                                            {
                                                "example_id": "80a99ffb-b479-448b-803e-d34cc845753b",
                                                "sense_id": "76768623-5be1-3125-8f69-d325a7ac5eff",
                                                "text": "Son gâté ! C’était lui. C’était son Fabio. Son petit-fils chéri. Et c’était aussi pour cela qu’il l’avait appelée Mémé Gâté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44851b33-0ec9-31d3-9bfb-a1cd9e8537de",
                                        "entry_id": "4a16a1de-0f4a-3dbf-9b46-73bef66f8156",
                                        "glosses": [
                                            "Femme vieille, ou manquant de dynamisme ou de souplesse d’esprit."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62a004f0-ce66-46b8-a656-fd65f3102210",
                                                "sense_id": "44851b33-0ec9-31d3-9bfb-a1cd9e8537de",
                                                "text": "Savez-vous pourquoi on dit qu’une banlieue ou une cité est chaude ? Pas à cause de la chaleur qu’il y fait comme la canicule de l’été 2003 qui a emporté la moitié des mémés et des pépés blancs abandonnés à eux-mêmes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
