                "senses": [
                    {
                        "sense_id": "93d91f1f-f8d5-36fd-a042-11a374b10557",
                        "entry_id": "7e574b33-4a40-3609-81ae-74bcd91a3760",
                        "glosses": [
                            "To become less or not crisp."
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "07abfba7-64e8-4b37-a442-72ff5e3b2d63",
                                "sense_id": "93d91f1f-f8d5-36fd-a042-11a374b10557",
                                "text": "[The] metal [of the coach], jouncing on the track, massaged his behind and his pants, uncrisping, were as wet from the mangy dog as from the sweat pouring out between his legs."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a407485-32be-3c9c-bc98-5af0ba80c7de",
                        "entry_id": "7e574b33-4a40-3609-81ae-74bcd91a3760",
                        "glosses": [
                            "To stop contorting or tensing (a part of one's body); to cause to be no longer contorted or tensed."
                        ],
                        "tags": [
                            "dated",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "e5688c92-5e53-455e-a025-11c62e672f44",
                                "sense_id": "9a407485-32be-3c9c-bc98-5af0ba80c7de",
                                "text": "When his miserable life is over they lay him out—that is, they pull his legs, and try to uncrisp his fingers,"
                            },
                            {
                                "example_id": "f316d2b0-67d2-4300-83c6-6b1c3d20731f",
                                "sense_id": "9a407485-32be-3c9c-bc98-5af0ba80c7de",
                                "text": "She also lay white and twisting on a couch, crisping and uncrisping her little hands."
                            }
                        ]
                    },
                    {
                        "sense_id": "e054dd15-caea-3178-a6c0-2d761c0bb863",
                        "entry_id": "7e574b33-4a40-3609-81ae-74bcd91a3760",
                        "glosses": [
                            "To stop being contorted or tensed (of a part of the body)."
                        ],
                        "tags": [
                            "dated",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "d0e4e810-e367-47b6-832e-11c4c63818b8",
                                "sense_id": "e054dd15-caea-3178-a6c0-2d761c0bb863",
                                "text": "She saw his fingers uncrisp, then grip the shelf again."
                            }
                        ]
                    },
                    {
                        "sense_id": "81552e33-60ff-3366-9c06-f1b1e0a51990",
                        "entry_id": "7e574b33-4a40-3609-81ae-74bcd91a3760",
                        "glosses": [
                            "To stop (something) from rippling or undulating."
                        ],
                        "tags": [
                            "archaic",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0b740853-9428-4f1c-bdf7-b6d3e528aef6",
                                "sense_id": "81552e33-60ff-3366-9c06-f1b1e0a51990",
                                "text": "Behold your Neptune, with his Trident there,\nVncrisps the Billows, smoothing them like Glass;"
                            }
                        ]
                    }
                ],
