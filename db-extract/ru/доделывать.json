                ],
                "translations": [
                    {
                        "translation_id": "9b89dc20-e984-4674-972b-0b53ba609048",
                        "source_entry_id": "a7752949-70db-3ec3-9f30-b5e1f103aac5",
                        "target_lang_word": "achever",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "achever",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Finir une chose commencée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5cfae55-762e-4446-966b-cf0beff57efb",
                                                "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                                                "text": "Et d'autres lames s’abattaient sans cesse sur l’épave. La mer achevait son œuvre. Encore quelques chocs, et la coque effondrée allait disparaître dans le gouffre tourbillonnant du chenal."
                                            },
                                            {
                                                "example_id": "d696394e-0046-4b11-8117-09a7a130f9cf",
                                                "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                                                "text": "Quand la cristallisation est achevée on sépare les cristaux de la liqueur mère qui se compose principalement d’acide oléique, on les fait recristalliser dans l’alcool à plusieurs reprises."
                                            },
                                            {
                                                "example_id": "92cc5c42-becd-4fcc-94c6-d93d18eabf98",
                                                "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                                                "text": "Le XIVᵉ siècle […] s’achève, ainsi qu’il a préludé, se tord dans des convulsions religieuses atroces."
                                            },
                                            {
                                                "example_id": "13033cbf-1881-4dcc-900e-f1c373c97e49",
                                                "sense_id": "aca74d70-4bd9-35f8-bfbb-85413c30a84c",
                                                "text": "Mᵉ Demange achève sa plaidoirie, dont la péroraison très sobre, très courte, mais puissante par la chaleur de l'accent et de l’élévation de la pensée, touche visiblement le cœur des juges : […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba64dd4a-d8b9-3ac2-ad29-93a2b09085d2",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Cesser quelque chose."
                                        ],
                                        "tags": [
                                            "Acadie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e95a60c-e75e-4c03-9263-34c4e63addd2",
                                                "sense_id": "ba64dd4a-d8b9-3ac2-ad29-93a2b09085d2",
                                                "text": "Tu as assez parlé, achève !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a0b1f7c-a968-3603-a163-750993cef15b",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Consommer la ruine, la perte, le malheur (de quelqu’un)."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "baf66d70-2fb0-484e-9f98-392d937dde71",
                                                "sense_id": "7a0b1f7c-a968-3603-a163-750993cef15b",
                                                "text": "Libéré des bracelets infamants, j'écoute peu le réquisitoire du ministère public, dont le Zorro commis d'office m'avait annoncé la sévérité. Le robin, qui n’a aucune considération pour l’assassin, m’achève au cours de son délire."
                                            },
                                            {
                                                "example_id": "c4bfbdb7-5d81-4274-9ed1-5a0d156d706e",
                                                "sense_id": "7a0b1f7c-a968-3603-a163-750993cef15b",
                                                "text": "Voilà de quoi l’achever."
                                            },
                                            {
                                                "example_id": "2d10010a-deba-4c87-b1a9-d96c5078e2cb",
                                                "sense_id": "7a0b1f7c-a968-3603-a163-750993cef15b",
                                                "text": "Il ne lui fallait plus que cela pour achever de le perdre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46a4afcf-f656-3665-8986-4855e7080d3e",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Frapper à mort quelqu’un qui est déjà blessé."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ff188e58-3799-4b4d-b4b6-9f4546798e4c",
                                                "sense_id": "46a4afcf-f656-3665-8986-4855e7080d3e",
                                                "text": "Mordi ! dit-il, j’espère qu’il est mort, ou sans cela je retournerais au Louvre pour l’achever."
                                            },
                                            {
                                                "example_id": "b2a55877-1fab-49a3-9684-3769441aa18e",
                                                "sense_id": "46a4afcf-f656-3665-8986-4855e7080d3e",
                                                "text": "Les deux malandrins alors ont essayé de l’achever avec leurs crosses d’armes et leurs poignards."
                                            },
                                            {
                                                "example_id": "7032a1be-a0dd-47f8-8954-1c0e13fbbf94",
                                                "sense_id": "46a4afcf-f656-3665-8986-4855e7080d3e",
                                                "text": "La flagellation avait pour fonction déterminante de « préparer » le supplice de la crucifixion. Elle supposait un abominable raffinement puisque tout l’art du bourreau consistait à châtier le condamné, sans l’achever prématurément."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28339fdd-e817-3ce6-8809-260d82de1609",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Précipiter la mort d’une personne déjà malade ou vulnérable, par malveillance ou négligence."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2da59624-0af0-4472-a140-fab91dfee31a",
                                                "sense_id": "28339fdd-e817-3ce6-8809-260d82de1609",
                                                "text": "Pétrifiée devant l’écran, je me vois avec ma mère en fauteuil roulant sur le parking de l’hôpital, forcées d’accepter la première solution qui se présente, d’appeler à notre secours des escrocs en blouse blanche. Je nous imagine propulsées dans un film apocalyptique où une administration bananière prononcerait de beaux discours pendant qu’elle achèverait ses vieux dans des zones de non-droit. Ce n’est pas une hallucination, c’est une tactique."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "deb575de-c725-3dd8-9709-24841d8f88f9",
                                        "entry_id": "89683e36-3cfc-324f-bd25-a0a5902efc3a",
                                        "glosses": [
                                            "Se finir, se terminer."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "671977dc-fa6c-4f8c-aa2d-b6e905b38801",
                                                "sense_id": "deb575de-c725-3dd8-9709-24841d8f88f9",
                                                "text": "L’histoire s’achève sur une note optimiste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c4181c3a-b356-43b7-9d92-c90aa591a33a",
                        "source_entry_id": "a7752949-70db-3ec3-9f30-b5e1f103aac5",
                        "target_lang_word": "terminer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "terminer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8cb3e61d-c5db-30c3-9fb0-170f02e42260",
                                        "entry_id": "b0dbf7be-d1a2-3811-bccb-b9f7f143d9d1",
                                        "glosses": [
                                            "Borner, limiter."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ea99988-8d89-49cb-865a-8c9a527d5c71",
                                                "sense_id": "8cb3e61d-c5db-30c3-9fb0-170f02e42260",
                                                "text": "Ce bois termine agréablement la vue."
                                            },
                                            {
                                                "example_id": "d4a67b14-e807-46e3-9fb6-f67c6dade7c3",
                                                "sense_id": "8cb3e61d-c5db-30c3-9fb0-170f02e42260",
                                                "text": "Ces montagnes terminent heureusement l’horizon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7f78d80-e0ed-38de-becc-30514a8b7ede",
                                        "entry_id": "b0dbf7be-d1a2-3811-bccb-b9f7f143d9d1",
                                        "glosses": [
                                            "Être à la fin, marquer la fin, mettre un terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "132fc18d-9cc6-4d83-a6aa-52a95b9f6811",
                                                "sense_id": "c7f78d80-e0ed-38de-becc-30514a8b7ede",
                                                "text": "La description qui termine le premier chant de son poème."
                                            },
                                            {
                                                "example_id": "31e73ea9-24ab-4efb-9913-ee665117b24d",
                                                "sense_id": "c7f78d80-e0ed-38de-becc-30514a8b7ede",
                                                "text": "La mort termina les conquêtes d’Alexandre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                        "entry_id": "b0dbf7be-d1a2-3811-bccb-b9f7f143d9d1",
                                        "glosses": [
                                            "Achever ; finir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "91b71bd9-0b88-4544-a554-c74d72fcde2d",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Les opérations cadastrales ont été commencées dans le département du Rhône en 1808, et ont été terminées en 1830."
                                            },
                                            {
                                                "example_id": "c2169b73-911c-4fb5-99a1-0f45d5dd0fdc",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Mais le Firecrest faisait toujours un peu d'eau, et je décidai de le remettre une nouvelle fois à terre et de terminer par là où j'aurais dû commencer en enlevant complétement le doublage en cuivre et en refaisant le calfatage de la coque."
                                            },
                                            {
                                                "example_id": "c19bbcb3-07e9-45cc-9fd1-c1f651ae10c8",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Ils avaient terminé leur repas et sirotaient un café-filtre, en regardant de loin le mouvement de la rue."
                                            },
                                            {
                                                "example_id": "4d61a4eb-03da-4aac-833a-d7d2dc10b668",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Il a terminé heureusement sa vie, sa carrière."
                                            },
                                            {
                                                "example_id": "71d06cb2-2b3a-4a9d-844a-363f434f5b14",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Terminer une campagne par une victoire."
                                            },
                                            {
                                                "example_id": "1aef2d8b-f1f2-464c-9755-1831e07c323a",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Terminer un ouvrage, une lecture."
                                            },
                                            {
                                                "example_id": "3b34fb9f-748a-43fe-9694-40a437e1c933",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Cette campagne ne se termina pas sans combat."
                                            },
                                            {
                                                "example_id": "75a6fea2-82ec-410a-b336-63ccb3a44220",
                                                "sense_id": "d36fc1c7-1625-30fa-8364-cf4d40ad2309",
                                                "text": "Tout cela s’est heureusement terminé."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea2305dd-5f0d-3517-a1e2-713c89f16c2e",
                                        "entry_id": "b0dbf7be-d1a2-3811-bccb-b9f7f143d9d1",
                                        "glosses": [
                                            "Prendre fin."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42aab2ea-b296-4cc0-9386-dae417545bf7",
                                                "sense_id": "ea2305dd-5f0d-3517-a1e2-713c89f16c2e",
                                                "text": "Il jeta un rapide coup d’œil sur la victime et hocha la tête ; il eût préféré que la partie se terminât sans ce coup de feu."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "03a61cb7-7bba-3812-89a0-4ef6dcc268d6",
                                        "entry_id": "b0dbf7be-d1a2-3811-bccb-b9f7f143d9d1",
                                        "glosses": [
                                            "Être terminé (par)."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "460841f1-45be-404a-bdda-b60fce055be0",
                                                "sense_id": "03a61cb7-7bba-3812-89a0-4ef6dcc268d6",
                                                "text": "Les verbes dont l’infinitif se termine en er, en ir, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
