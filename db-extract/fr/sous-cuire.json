                ],
                "senses": [
                    {
                        "sense_id": "32cd0671-a64f-3d2a-8144-ef1bb6a19425",
                        "entry_id": "485e6c77-5ce9-3404-bf82-f2ce574bc087",
                        "glosses": [
                            "Cuire moins que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "902c7f67-a42a-453c-be25-0ad000d309b7",
                                "sense_id": "32cd0671-a64f-3d2a-8144-ef1bb6a19425",
                                "text": "Le truc, c'est de légèrement sous-cuire votre viande, car le temps de repos que vous allez désormais lui laisser va prolonger un peu la cuisson."
                            },
                            {
                                "example_id": "66079249-ed43-499a-9d99-4fa8312eac5e",
                                "sense_id": "32cd0671-a64f-3d2a-8144-ef1bb6a19425",
                                "text": "Autant les sous-cuire légèrement quitte à se rattraper par la suite."
                            },
                            {
                                "example_id": "8b8f85c9-dda2-42f9-8b33-dca95a95597a",
                                "sense_id": "32cd0671-a64f-3d2a-8144-ef1bb6a19425",
                                "text": "Je vous recommande par contre de légèrement les sous-cuire avant de les congeler et de les passer un petit peu au four après décongélation."
                            }
                        ]
                    }
                ],
