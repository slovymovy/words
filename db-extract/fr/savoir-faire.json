        "fr-extract.jsonl": [
            {
                "entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                "word": "savoir-faire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                        "entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                        "glosses": [
                            "Connaissance pratique d'un domaine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a57a7f4-e8bd-48b2-a92e-18da359fdb7e",
                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                "text": "La célèbre mirabelle de Lorraine est le fruit d’un savoir-faire ancestral qui respecte le rythme des saisons."
                            },
                            {
                                "example_id": "9605518d-e757-4666-8cf8-167d59b5f461",
                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                "text": "Voilà un bel exemple du fait que le savoir-faire peut très bien précéder le savoir. C'est ainsi que l'on a inventé le levier bien avant qu'Archimède n'en explique le principe."
                            },
                            {
                                "example_id": "64e662b1-7a1e-41d6-aecc-27d1ea9ae76f",
                                "sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                                "text": "Il n’a pas de véritable talent, il n’a que du savoir-faire."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89213c09-b1d6-4aa1-a573-a53107ffa67f",
                        "source_entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                        "source_sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                        "source_sense_description": "Habileté pour faire réussir",
                        "target_lang_word": "Routine",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Routine",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                        "entry_id": "1b43b1e3-fbff-306e-8542-870ef1843a9c",
                                        "glosses": [
                                            "erprobtes, gewohnheitsmäßiges, übliches Handeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52618aa0-725c-4c42-bd03-5af058366a00",
                                                "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                                "text": "Wir sollten Sport zu einer Routine werden lassen."
                                            },
                                            {
                                                "example_id": "8246cd6c-8262-4797-82ac-4ee34d614181",
                                                "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                                "text": "„Noch war alles Routine.“"
                                            },
                                            {
                                                "example_id": "1960dc4a-1af4-4ed1-9126-9f46d4e851b0",
                                                "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                                "text": "„Die Routinen schoben sich über die Stunden und ich wusste nicht mehr, welcher Wochentag war.“"
                                            },
                                            {
                                                "example_id": "d783f8fd-e9d8-43f4-a178-ec292756d24a",
                                                "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                                "text": "„Ich hatte keine Lust, und nur aus Routine oder Pflicht wollte ich's nicht tun.“"
                                            },
                                            {
                                                "example_id": "6f06b427-46c9-44b3-bfba-bac8bb089ebf",
                                                "sense_id": "a734078b-e9cc-3fe1-ba31-dcd242bc482a",
                                                "text": "„Nur weil man Routinen mag, muss das noch lange nicht heißen, dass die Routinen selbst so öde und traurig sein müssen wie ein Job beim Finanzamt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bdc04d07-61e4-3df9-982f-e10fc0c4059c",
                                        "entry_id": "1b43b1e3-fbff-306e-8542-870ef1843a9c",
                                        "glosses": [
                                            "feststehender (kurzer) Ablauf, kleines Programm"
                                        ],
                                        "tags": [
                                            "EDV",
                                            "Organisation"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1883a08d-dc40-4bb0-baae-16f5584e27d4",
                                                "sense_id": "bdc04d07-61e4-3df9-982f-e10fc0c4059c",
                                                "text": "„Wenn Sie nur einen Index für spezielle Zwecke haben, wie etwa eine monatliche Wartungsroutine, können Sie den Index anlegen, die Routine laufen lassen und dann den Index bis zum nächsten Mal wieder löschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b95ecae-906f-4c83-8f6e-9775be5e69b4",
                        "source_entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                        "source_sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
                        "source_sense_description": "Habileté pour faire réussir",
                        "target_lang_word": "expertise",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Great skill or knowledge in a particular field or hobby."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb3588e1-9cb7-4066-a838-5d7a5f439856",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "The scientist has expertise in the field of nuclear fusion."
                                            },
                                            {
                                                "example_id": "30102674-40bc-4984-bed0-da42f31bb88d",
                                                "sense_id": "7f311914-04b3-3b6d-88e4-be2c3656583a",
                                                "text": "He spoke of Scotland's hydroelectric projects in Africa, local expertise shared with the world's poor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "75e8364a-5033-37d9-992e-43e8dccfb53c",
                                        "entry_id": "ddf85587-62f9-3bdc-9635-1129e2bf826b",
                                        "glosses": [
                                            "Advice, or opinion, of an expert."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "expertise",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                        "entry_id": "b36247dd-27aa-3a33-b204-7b32d9202072",
                                        "glosses": [
                                            "To supply with expert knowledge or advice."
                                        ],
                                        "tags": [
                                            "rare",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0efa1b9e-4425-4802-9130-3cd2d8132125",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Since 1979, we have developed a method for expertising the design of the processes and improving them."
                                            },
                                            {
                                                "example_id": "194c4253-a0b4-41f6-ba81-64bf17e31296",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "Including a plurality of different expertise in the decision-making processes corresponds to expertising the democratic procedures."
                                            },
                                            {
                                                "example_id": "326b8146-d7c9-4040-a40e-2f4e65d14bda",
                                                "sense_id": "dd04e261-693d-39e6-832e-af11254c9b9d",
                                                "text": "If experts shall lose their expertise, wherewith shall they be expertised? The fact that only the rare economists can be entrusted with economics is not reason to discard economics, but to go and find the rare men."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1a75b298-e45c-463b-94f6-3070e215da6b",
                        "source_entry_id": "b2a1c941-4e48-361f-84bf-36fc3912e5e6",
                        "source_sense_id": "663f9ff9-ed95-3f06-95d6-6a18c915e556",
