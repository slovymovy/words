                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2cbebbf-53df-4f7a-bedb-0500c66de6d8",
                                "sense_id": "467d07c0-7247-38d6-949b-7ee583381b61",
                                "text": "Zij sliep tot haar twintigste nog altijd met een teddybeer in bed."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "66be6e0b-8b32-4536-bf7c-b57f8edc2ddc",
                        "source_entry_id": "7822f909-e57d-337d-a668-62c3d44d2dd9",
                        "source_sense_id": "467d07c0-7247-38d6-949b-7ee583381b61",
                        "source_sense_description": "zachte pluizige speelgoedbeer",
                        "target_lang_word": "Teddybär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teddybär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                        "entry_id": "ca912246-5c6b-3705-8220-237ea7a16098",
                                        "glosses": [
                                            "vor allem als Kuschel- und Schlaftier verwendetes Stofftier für Kinder, dessen Form und Aussehen einem Bären nachgebildet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ebdedfb0-9c71-48da-b93b-85ee1165e968",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "Sie kuschelte mit ihrem Teddybären."
                                            },
                                            {
                                                "example_id": "ce5a091a-c351-41ce-baed-1cc093368308",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Du, kauf mir doch so einen Teddybären!“"
                                            },
                                            {
                                                "example_id": "8d15657f-f4fa-4e4d-9526-a8fe63576646",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Neben dem Schreibbürochef steht eine Wiege mit Puppen und Teddybären, die einmal der fünf Monate alten Elvira gehören sollen.“"
                                            },
                                            {
                                                "example_id": "6d32ed7b-2b00-40fa-ba44-47425048e1a4",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Sie sind neben Luftballons und Orgeldrehern der äußere Beweis dafür, daß laut Verkehrsverein das älteste und neben dem Hamburger Dom größte Volksfest Norddeutschlands, der Bremer Freimarkt, wieder einmal begonnen hat. Wer aus Glücksbuden, Schießständen und Lotteriespielen kein Freßpaket garantiert frische, unverfälschte Deutsche Markenbutter mit nach Hause trägt, wählt einen Teddybären. Manche Jungen halten Teddybären im Arm, wenn sie die Laufplanken zu dem im Olympiajahr zeitgemäßen Cortina-Bob (pro Fahrt fünzig Pfennige) oder zu der noch nicht ganz zeitgemäßen und dementsprechend etwas billigeren Marsrakete stürmen.“"
                                            },
                                            {
                                                "example_id": "cb0fc6a8-e213-4507-870a-f77a335b2338",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Meine glastötende Stimme ließ ich sozusagen zu Hause, drückte ein Auge zu, wenn das Gretchen befand, es sei nun genug getrommelt worden, und mir mit Gold- und Pferdezähnen lächelnd die Trommel von den Knien zog, das Blech zwischen Teddybären legte.“"
                                            },
                                            {
                                                "example_id": "ffa8c9fa-54f7-4bd2-ad51-cfb7a41605a4",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Anfangs lief ein großer Teil des Vertriebs über sogenannte ‚Mulas‘, Maultiere: arme Kolumbianer, die mit einem Rückflugticket in die Abnehmerländer geschickt werden und kleinere Mengen Kokain (selten mehr als ein kg) zu schmuggeln versuchen – verborgen in Souvenirs, Teddybären, doppelten Kofferböden, Holzbeinen, Schwangerschaftsattrappen oder im Magen.“"
                                            },
                                            {
                                                "example_id": "b8f0e383-4c03-45b3-b3c9-426ac59b9c44",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Joe gewann am Ballwurfstand einen Teddybären für Rosa.“"
                                            },
                                            {
                                                "example_id": "2bb0c7b9-8c02-4fb6-b399-76c54d466a4f",
                                                "sense_id": "2f5b0374-799b-3bae-bf96-59aa371772b7",
                                                "text": "„Teddybär Babbage sprang am Montag von seiner Plattform (bzw. wurde gestoßen), die mithilfe eines mit Wasserstoff gefüllten Wetterballons auf 39.000 Meter aufgestiegen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
