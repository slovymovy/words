                    }
                ],
                "translations": [
                    {
                        "translation_id": "11095bf9-d5fb-449b-a189-14823b2286f0",
                        "source_entry_id": "5da3fad7-6a94-35d3-aec5-692870cf208c",
                        "target_lang_word": "warm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "warm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Of a somewhat high temperature, often but not always connoting that the high temperature is pleasant rather than uncomfortable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73a80659-b84b-4460-9eac-9198be9fc1dd",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "The tea is still warm."
                                            },
                                            {
                                                "example_id": "035087a2-63aa-4338-bdf0-66735efaf22f",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "This is a very warm room."
                                            },
                                            {
                                                "example_id": "5250d98a-2fe1-4b81-a492-453ce50a9929",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "Warm and still is the summer night."
                                            },
                                            {
                                                "example_id": "a5abdd12-6c07-429a-b052-0c2696d28eb5",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "It seemed I was too excited for sleep, too warm, too young."
                                            },
                                            {
                                                "example_id": "d1bb85cd-84e3-4d3c-8d7e-edc32c1f6b90",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "While the study doesn’t directly shed light on why, it suggested that maintaining a similar degree of mobility as the climate changed to the warmer and wetter pattern we have today could have imparted additional stress as the mammoth encountered unfamiliar environments or restricted its movement."
                                            },
                                            {
                                                "example_id": "ead9a714-f370-4846-a3d1-c63c06ad3efc",
                                                "sense_id": "d3c5e4fe-6387-3268-860a-469eb66ffef1",
                                                "text": "Kids jump into Lake Michigan during unseasonably warm conditions in Chicago on February 26, 2024. […] This winter was the warmest on record for the Lower 48, NOAA’s National Centers for Environmental Information said Friday. Records date to the late 1800s."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b14d469-fc6b-34ad-a582-0dc5daf6b45e",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Friendly and with affection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4c63138f-2a72-4590-a45c-f74b7f6748d4",
                                                "sense_id": "0b14d469-fc6b-34ad-a582-0dc5daf6b45e",
                                                "text": "We have a warm friendship."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8d5257a8-a104-3b3b-a7b4-35e7aa652eae",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Having a color in the part of the visible electromagnetic spectrum between red and yellow-green."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f4eb3de-4cab-301e-8bd8-d17da1dec9a1",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Close to a goal or correct answer."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d9e1c36-c774-4ede-91bd-5496ec1af41a",
                                                "sense_id": "8f4eb3de-4cab-301e-8bd8-d17da1dec9a1",
                                                "text": "Earlier you were way off, but now you're getting warmer."
                                            },
                                            {
                                                "example_id": "e015b41c-a45c-4569-878c-0c0d1a3be1b8",
                                                "sense_id": "8f4eb3de-4cab-301e-8bd8-d17da1dec9a1",
                                                "text": "That was a further clue; and here, indeed, young Mr. Dowse was getting \"warm,\" as children say at blind-man's-buff, although, as a matter-of-fact, she had now been talking of George Miller at all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6214759e-0249-32a5-9a29-6e5dce980dfa",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Fresh, of a scent; still able to be traced."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfabbfa1-e889-3a03-81e1-77ebecb4b8e4",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Communicating a sense of comfort, ease, or pleasantness."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95e1572e-b1a0-4adc-b3cd-64ad817ad5c4",
                                                "sense_id": "dfabbfa1-e889-3a03-81e1-77ebecb4b8e4",
                                                "text": "a warm piano sound"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Ardent, zealous."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb5b194-c9c7-4ebc-8073-adbba8c30620",
                                                "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                                "text": "a warm debate, with strong words exchanged"
                                            },
                                            {
                                                "example_id": "37044084-b162-4155-9c84-4f37d68833f6",
                                                "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                                "text": "Mirth, and youth, and warm desire!"
                                            },
                                            {
                                                "example_id": "d8f7fac0-77df-471d-bb33-de33dc2b3e63",
                                                "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                                "text": "They say he's a warm man and does not care to be made mouths at."
                                            },
                                            {
                                                "example_id": "61fecb18-ca1f-48e6-b00c-90ba6f2e0eab",
                                                "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                                "text": "To the strength and fierceness of barbarians they added a contempt for life, which was derived from a warm persuasion of the immortality and transmigration of the soul."
                                            },
                                            {
                                                "example_id": "946441df-0a3f-468d-b62d-b8e6e3792769",
                                                "sense_id": "6a4f36b6-18df-3ce4-b490-654d881ca1a2",
                                                "text": "I had been none of the warmest of partisans."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "40acefb6-9ff6-33bc-bb4f-576354ea7180",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Well off as to property, or in good circumstances; prosperous."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71bb6703-0fc9-426d-80c1-6be311ea6cb5",
                                                "sense_id": "40acefb6-9ff6-33bc-bb4f-576354ea7180",
                                                "text": "You shall have a draught upon him, payable at sight: and let me tell you he is as warm a man as any within five miles round him."
                                            },
                                            {
                                                "example_id": "7aebcbc7-d3ca-4409-b4a8-bb2ce162d7ad",
                                                "sense_id": "40acefb6-9ff6-33bc-bb4f-576354ea7180",
                                                "text": "Mrs. and the Miss Cathcarts began to be considered as people of some consequence in the circle in which they moved, while he gradually obtained in the city the name of a warm man."
                                            },
                                            {
                                                "example_id": "d700d258-19c3-4649-bbd2-514c5edd3a9b",
                                                "sense_id": "40acefb6-9ff6-33bc-bb4f-576354ea7180",
                                                "text": "I know the Stuyvesant family —puff— every one of them —puff— not a more respectable family in the province —puff— old standards —puff— warm householders —puff— none of your upstarts"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0b9dea93-4126-37a6-8ff3-aad8080f955f",
                                        "entry_id": "177d0ef5-3bf4-38f1-808e-bde0af8288d8",
                                        "glosses": [
                                            "Requiring arduous effort."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "017a8e79-bde0-469e-be46-c2c9165a79ef",
                                                "sense_id": "0b9dea93-4126-37a6-8ff3-aad8080f955f",
                                                "text": "The circular iron platform over there is used in the task of tyring the wheels, a warm job, too, by the way."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "warm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bdbebbb-2f91-3ffb-b3e5-f95d17324a02",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To make or keep warm."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1edf7704-a513-4745-a91b-a486831e45a8",
                                                "sense_id": "8bdbebbb-2f91-3ffb-b3e5-f95d17324a02",
                                                "text": "Then shall it [an ash tree] be for a man to burn; for he will take thereof and warm himself."
                                            },
                                            {
                                                "example_id": "9983b54f-8e61-4df6-87a4-8e80f9264755",
                                                "sense_id": "8bdbebbb-2f91-3ffb-b3e5-f95d17324a02",
                                                "text": "enough to warm, but not enough to burn"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "630ee346-670f-3dcc-b2ca-47421497d5ff",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To become warm, to heat up."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "28dea4f9-dd31-44f7-8951-b5713f70811d",
                                                "sense_id": "630ee346-670f-3dcc-b2ca-47421497d5ff",
                                                "text": "My socks are warming by the fire."
                                            },
                                            {
                                                "example_id": "fb60fef2-2889-4a44-93d3-7d8f929f0b05",
                                                "sense_id": "630ee346-670f-3dcc-b2ca-47421497d5ff",
                                                "text": "The earth soon warms on a clear summer day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d8128cf-26bb-39b1-becb-68803e787e6e",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "(sometimes in the form warm up) To favour increasingly."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d3638f97-b5f8-40e5-b7e8-3f4e1a7abdc9",
                                                "sense_id": "4d8128cf-26bb-39b1-becb-68803e787e6e",
                                                "text": "Mr. Campion appeared suitably impressed and she warmed to him. He was very easy to talk to with those long clown lines in his pale face, a natural goon, born rather too early she suspected."
                                            },
                                            {
                                                "example_id": "d004a885-fb2d-4a6d-9abe-df07b6facf27",
                                                "sense_id": "4d8128cf-26bb-39b1-becb-68803e787e6e",
                                                "text": "He is warming to the idea."
                                            },
                                            {
                                                "example_id": "604ca6f7-13d2-4ea4-8fe2-5e8ec7ce64dc",
                                                "sense_id": "4d8128cf-26bb-39b1-becb-68803e787e6e",
                                                "text": "Her classmates are gradually warming to her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "664999e2-4367-3ae3-88e6-10cd9d2f1717",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To cause (someone) to favour (something) increasingly."
                                        ],
                                        "tags": [
                                            "ditransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1d5eabd6-930f-41ab-a870-0754dea6466c",
                                                "sense_id": "664999e2-4367-3ae3-88e6-10cd9d2f1717",
                                                "text": "It is with no small degree of irony that I confess that immersing myself in an interdisciplinary project has warmed me to the seductions of disciplinary perspectives."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b0fa3e55-3426-32c8-86d5-883da27a5038",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To become ardent or animated."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45f29dc8-b359-4b3d-9a4b-ef21751d5830",
                                                "sense_id": "b0fa3e55-3426-32c8-86d5-883da27a5038",
                                                "text": "The speaker warms as he proceeds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3f912a90-51bb-3950-b51e-80b3797ce6cc",
                                        "entry_id": "a7704fe4-17e6-3ff8-85bd-35ef0cc08be5",
                                        "glosses": [
                                            "To make engaged or earnest; to interest; to engage; to excite ardor or zeal in; to enliven."
