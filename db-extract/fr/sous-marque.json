                        "glosses": [
                            "Marque sous laquelle sont distribués des produits réalisés par un industriel qui utilise par ailleurs une marque plus prestigieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd407eed-dadd-4baa-b187-bc2b4528db29",
                                "sense_id": "f74e8515-bea7-30c0-9c54-26c497cbb3a5",
                                "text": "Je leur donne une dose de croquettes d’une sous-marque et des repas faits maison le midi, et le soir ils ont nos restes de la journée ou de la veille."
                            },
                            {
                                "example_id": "40cc544f-ce7b-4f14-8769-c00bb94eeeb1",
                                "sense_id": "f74e8515-bea7-30c0-9c54-26c497cbb3a5",
                                "text": "Depuis l’incident des M&M’s avec Lil’Ray, j’ai distribué douze boîtes de petits gâteaux de sous-marques dans ma salle de classe."
                            },
                            {
                                "example_id": "d09349a8-6e10-4bcd-8bf7-cb1bee066230",
                                "sense_id": "f74e8515-bea7-30c0-9c54-26c497cbb3a5",
                                "text": "Sous-marque du géant chinois Huawei, Honor se distingue par des smartphones accessibles, élégants et performants."
                            }
                        ]
                    }
