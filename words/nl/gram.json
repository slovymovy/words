                },
                {
                    "sense_id": "f206630c-bf05-3af3-bd5b-4da29472bbe5",
                    "sense_definition": "Het gevoel van genoegdoening of wraak na onrecht.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "emotie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Eindelijk kon de atleet zijn <w>gram</w> halen door de wedstrijd te winnen.",
                            "target_lang_translations": {
                                "en": "The athlete was finally able to get his <w>vindication</w> by winning the race.",
                                "ru": "Наконец атлет смог <w>отыграться</w>, выиграв соревнование."
                            }
                        },
                        {
                            "text": "Na jaren van kritiek gaf deze overwinning hem de nodige <w>gram</w>.",
                            "target_lang_translations": {
                                "en": "After years of criticism, this victory gave him the necessary <w>satisfaction</w>.",
                                "ru": "После многих лет критики эта победа принесла ему долгожданное <w>удовлетворение</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "zijn gram halen"
                    ],
                    "target_lang_definitions": {
                        "en": "A sense of satisfaction or vindication after being wronged.",
                        "ru": "Чувство удовлетворения или отмщения после несправедливости."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "vindication",
                                "target_lang_sense_clarification": "clearing of blame or suspicion"
                            },
                            {
                                "target_lang_word": "satisfaction",
                                "target_lang_sense_clarification": "getting even or proving oneself"
                            }
