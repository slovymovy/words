                "senses": [
                    {
                        "sense_id": "54cffc5e-a85e-3531-bc5e-69fc07a26b3e",
                        "entry_id": "77d40d2a-9234-30c8-8c5a-13daa489619f",
                        "glosses": [
                            "Faire porter le hidjab à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f2e9973-0f15-4d8d-a850-85848e8b1584",
                                "sense_id": "54cffc5e-a85e-3531-bc5e-69fc07a26b3e",
                                "text": "La ténacité de l'intégrisme dans son entreprise de hidjabiser la femme, d'en faire une alliée dans l'œuvre de destruction culturelle renforce sa combativité."
                            },
                            {
                                "example_id": "e4a3660e-bd39-47d2-8edc-18bf3c75cd06",
                                "sense_id": "54cffc5e-a85e-3531-bc5e-69fc07a26b3e",
                                "text": "Pourquoi tu veux absolument changer la France, l'islamiser, l'hallaliser, la hidjabiser, la minariser, partout, tout le temps, où que tu sois?"
                            },
                            {
                                "example_id": "cdaddc30-ce07-4fcf-9a21-357c2b45f0c7",
                                "sense_id": "54cffc5e-a85e-3531-bc5e-69fc07a26b3e",
                                "text": "Alors pourquoi, toi, Ghannouchi, intégriste de chez intégriste, islamiste qui rêve de hidjabiser tout un pays vient-tu donner des leçons aux Algériens et faire des pronostics sur les législatives du 10 mai prochain ?"
                            }
                        ]
                    }
                ],
