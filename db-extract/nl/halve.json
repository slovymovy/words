            {
                "entry_id": "733b48d8-8af3-3735-bbb1-1c4539ef1568",
                "word": "halve",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "ea2abe70-a5d5-3672-967a-46eac6032d0d",
                        "entry_id": "733b48d8-8af3-3735-bbb1-1c4539ef1568",
                        "glosses": [
                            "verbogen vorm van de stellende trap van half"
                        ],
                        "tags": [
                            "form-of"
                        ],
                        "examples": [
                            {
                                "example_id": "bbfc95c1-50f6-4af5-a2b6-167365b9d461",
                                "sense_id": "ea2abe70-a5d5-3672-967a-46eac6032d0d",
                                "text": "Ik had de keuze om 10 kilometer terug te lopen naar een plek waarvan ik zeker wist dat er water was of 8 kilometer door te lopen naar het eerstvolgende beekje, dat echter ook opgedroogd zou kunnen zijn. Ik ging er even voor zitten, ik was moe en had nog maar een halve fles water over, dit was geen moment om een foute beslissing te nemen."
                            },
                            {
                                "example_id": "9f15141e-f2aa-4a4d-975f-6ed8aaa61147",
                                "sense_id": "ea2abe70-a5d5-3672-967a-46eac6032d0d",
                                "text": "Bibi trekt met de punt van haar rechter gymp halve cirkeltjes in het zand."
                            },
                            {
                                "example_id": "5ad6d4d7-498a-4f6e-bff4-e6f521df7889",
                                "sense_id": "ea2abe70-a5d5-3672-967a-46eac6032d0d",
                                "text": "Ik klauter over de rotsblokken, tot ik op het hoogste punt kom, waar de halve maan zijn blauwe schijnsel over het volgende dal legt."
                            },
                            {
                                "example_id": "c89aad1f-98a2-4825-ae12-ea5afa1f4c1a",
                                "sense_id": "ea2abe70-a5d5-3672-967a-46eac6032d0d",
                                "text": "Dat ze haar halve rugzak heeft gevuld met pillen en poeders."
                            }
                        ]
                    }
                ],
