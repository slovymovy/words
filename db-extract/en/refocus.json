                "senses": [
                    {
                        "sense_id": "5473999a-dee4-397e-bbd7-24d9dbc0686a",
                        "entry_id": "ca67608c-f796-3845-a885-cef6bae3bd6c",
                        "glosses": [
                            "to focus on something else"
                        ],
                        "tags": [
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "f8fed7cd-5a5a-486f-ab3c-7b8d6476fe70",
                                "sense_id": "5473999a-dee4-397e-bbd7-24d9dbc0686a",
                                "text": "Labour frontbencher Louise Haigh (Shadow Transport Secretary for heaven's sake!) initially lambasted TOCs before the handful of specialist rail commentators fell on her tweets and she changed her tune, refocusing her fire on Government."
                            }
                        ]
                    },
                    {
                        "sense_id": "84e2379b-3e1d-385f-a1dc-d95af5cfe82a",
                        "entry_id": "ca67608c-f796-3845-a885-cef6bae3bd6c",
                        "glosses": [
                            "to change the focus of"
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "15a720d0-a354-4337-9772-a9db5dc143a1",
                                "sense_id": "84e2379b-3e1d-385f-a1dc-d95af5cfe82a",
                                "text": "These two sets of questions are interrelated in such a way that they often actually work to prevent productive discussion of the movie's politics. Just a few observations might make this point clear, and help to refocus the debate that has surrounded the film since its opening earlier this summer."
                            },
                            {
                                "example_id": "5f33469a-3965-4b7e-b90c-90413b1b47c5",
                                "sense_id": "84e2379b-3e1d-385f-a1dc-d95af5cfe82a",
                                "text": "to refocus a microscope"
                            }
                        ]
                    },
                    {
                        "sense_id": "516d2f2a-3606-304c-b58c-4136caed6244",
                        "entry_id": "ca67608c-f796-3845-a885-cef6bae3bd6c",
                        "glosses": [
                            "to change one's priorities"
                        ],
