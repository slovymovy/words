        "fr-extract.jsonl": [
            {
                "entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                "word": "anuiter",
                "pos": "verb",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e320730e-c3e4-4395-9821-88a3ef8a8086",
                        "entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                        "tags": [
                            "pronominal"
                        ],
                        "form": "s’anuiter"
                    },
                    {
                        "form_id": "e498ec08-ffd6-4f52-b04b-b74f54bf89e5",
                        "entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                        "tags": [],
                        "form": "annuiter"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a085cd78-4078-3903-a219-35d8a67ab8a6",
                        "entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                        "glosses": [
                            "S’assombrir à mesure que la nuit tombe."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "dca49305-dd27-427f-a9d1-36b9be39a478",
                                "sense_id": "a085cd78-4078-3903-a219-35d8a67ab8a6",
                                "text": "Çà et là, avec la fraîcheur du soir, des bouchons de brume blanche commençaient à courir et à se bousculer au ras du sol, comme un troupeau pris de panique – l’île s’anuitait déjà –, on eût dit qu’avant l’heure les fantômes du soir se hâtaient de reprendre possession de la lande."
                            },
                            {
                                "example_id": "2f91ad86-04dc-4f33-b173-cc9462e3cefa",
                                "sense_id": "a085cd78-4078-3903-a219-35d8a67ab8a6",
                                "text": "Le bois s’anuitait petit à petit, les oiseaux avaient cessé de chanter - il commençait à faire très sombre dans le sous-bois opaque."
                            }
                        ]
                    },
                    {
                        "sense_id": "eb6171ce-cc47-319f-ad84-2961d2bbd31e",
                        "entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                        "glosses": [
                            "S’exposer à être surpris en chemin par la nuit."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0b83a9d-55cd-4f32-95ce-6a505840b700",
                                "sense_id": "eb6171ce-cc47-319f-ad84-2961d2bbd31e",
                                "text": "Mais le petit avait plus peur des loups que les loups des allumettes & forçait sur les pédales de crainte de s’anuiter loin du village."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "04c7db76-68ce-4bb7-a88d-6c0314ee3c6a",
                        "source_entry_id": "a880dd8e-e5d7-331a-a8f1-63ecc71a268d",
                        "target_lang_word": "benight",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "benight",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8ca88c3b-d39e-3124-957e-bb8a47e04e38",
                                        "entry_id": "c9803bfb-59a0-362e-8d09-aee9db099c93",
                                        "glosses": [
                                            "To overtake (a traveller etc) with the darkness of night, especially before shelter is reached."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6cc12510-6a30-45fd-865e-65ac169bd610",
                                                "sense_id": "8ca88c3b-d39e-3124-957e-bb8a47e04e38",
                                                "text": "How far might I have been on my way by this time! I am made to tread thoſe ſteps thrice over, which I needed not to have trod but once: Yea now alſo I am like to be benighted, for the day is almost ſpent."
                                            },
                                            {
                                                "example_id": "37368bb0-78d4-41c0-a99b-ba214a5dad6c",
                                                "sense_id": "8ca88c3b-d39e-3124-957e-bb8a47e04e38",
                                                "text": "[H]e struck off the common road, to take the benefit of a nearer cut; and finding himself benighted near a village, took up his lodging at the first inn to which his horse directed him."
                                            },
                                            {
                                                "example_id": "e15f4d49-0a26-412e-b31b-302b0b53ffd2",
                                                "sense_id": "8ca88c3b-d39e-3124-957e-bb8a47e04e38",
                                                "text": "The public road, however, was tolerably well-made and safe, so that the prospect of being benighted brought with it no real danger."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b12c9b38-53cc-3a68-92f5-90f43a0fca61",
                                        "entry_id": "c9803bfb-59a0-362e-8d09-aee9db099c93",
                                        "glosses": [
                                            "To darken; to shroud or obscure."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "daa5f165-c582-4354-9f03-95fe8ad06f20",
                                                "sense_id": "b12c9b38-53cc-3a68-92f5-90f43a0fca61",
                                                "text": "The King with half the East at heel is marched from lands of morning; / Their fighters drink the rivers up, their shafts benight the air."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fcc45fe-5953-3dba-9c8e-c65754b76bcf",
                                        "entry_id": "c9803bfb-59a0-362e-8d09-aee9db099c93",
                                        "glosses": [
                                            "To plunge or be overwhelmed in moral or intellectual darkness."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f91ac7a1-7015-4ab6-a4c0-0846c605f2dd",
                                                "sense_id": "6fcc45fe-5953-3dba-9c8e-c65754b76bcf",
                                                "text": "Can we whose souls are lighted\nWith Wisdom from on high,\nCan we to men benighted\nThe lamp of life deny?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
        ],
