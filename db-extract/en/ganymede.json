                                            "największy księżyc Jowisza; największy księżyc w Układzie Słonecznym; jeden z księżyców galileuszowych"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f078391b-c8ca-4440-b0b0-f81f2d792434",
                                                "sense_id": "ad4f6051-894c-3849-ae93-57537e710ece",
                                                "text": "Atmosfera Ganimedesa składa się niemal wyłącznie z tlenu."
                                            }
                                        ],
