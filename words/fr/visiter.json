    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9300f2a3-e260-3418-942a-ea05c7ebaff8",
                    "sense_definition": "Parcourir un lieu remarquable, un monument ou une ville pour les découvrir par curiosité ou intérêt culturel.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "decouverte_touristique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pendant les vacances, nous voulons <w>visiter</w> plusieurs musées célèbres de la capitale."
                        },
                        {
                            "text": "Tu dois absolument <w>visiter</w> Paris lors de ton prochain voyage en France."
                        }
                    ],
                    "common_phrases": [
                        "faire visiter",
                        "visiter la ville",
                        "visiter un musée"
                    ]
                },
                {
                    "sense_id": "24dbb66c-3a3a-3f3a-ae98-862ee0182459",
                    "sense_definition": "Inspecter ou examiner un logement ou un local en vue d'un achat ou d'une location.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "immobilier",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous allons <w>visiter</w> un appartement lumineux dans le centre historique cet après-midi."
                        },
                        {
                            "text": "L'agent immobilier a proposé de nous faire <w>visiter</w> cette belle maison demain."
                        }
                    ],
                    "common_phrases": [
                        "visiter un appartement",
                        "visiter une maison"
                    ]
                },
                {
                    "sense_id": "2d939c21-3702-38f4-a0be-ff6896d2d811",
                    "sense_definition": "Aller voir quelqu'un à son domicile ou sur son lieu de séjour pour prendre de ses nouvelles.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "relations_sociales",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a promis de <w>visiter</w> ses patients âgés dès le début de la matinée."
                        },
                        {
                            "text": "Cet après-midi, elle souhaite <w>visiter</w> un ami hospitalisé depuis quelques jours."
                        }
                    ],
                    "synonyms": [
                        "rendre visite"
                    ],
                    "common_phrases": [
                        "visiter des amis",
                        "visiter un malade"
                    ]
                },
                {
                    "sense_id": "b64cc57d-ae10-365f-bf14-86ae0ce0ebcb",
                    "sense_definition": "Examiner avec soin et inspecter des objets, des bagages ou un véhicule pour vérifier leur conformité.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "controle_inspection",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les douaniers ont décidé de <w>visiter</w> les bagages de tous les passagers suspects."
                        },
                        {
                            "text": "Le garde forestier a pris le temps de <w>visiter</w> attentivement chaque véhicule à l'entrée."
                        }
                    ],
                    "common_phrases": [
                        "visiter les bagages"
                    ]
                },
                {
                    "sense_id": "1062d5f3-91c3-3619-82b8-b5e7951c3b29",
                    "sense_definition": "Pénétrer par effraction dans un lieu pour y dérober des biens.",
                    "learner_level": "B2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "delinquance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Des cambrioleurs expérimentés ont réussi à <w>visiter</w> le magasin pendant la nuit."
                        },
                        {
                            "text": "La maison des voisins a été <w>visitée</w> pendant qu'ils étaient partis en vacances."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "argot"
                        }
                    ]
                }
            ]
        }
