{
    "word_family": [
        "Juneteenth"
    ],
    "entries": [
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "f6d70552-92d0-35bf-8542-2bb3a2bd2466",
                    "sense_definition": "The sixth month of the Gregorian calendar, following May and preceding July.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "months",
                    "name_type": "other",
                    "examples": [
                        {
                            "text": "The school year usually ends in <w>June</w> for many students.",
                            "target_lang_translations": {
                                "ru": "Учебный год у многих студентов обычно заканчивается в <w>июне</w>."
                            }
                        },
                        {
                            "text": "We are planning to go on a <w>June</w> holiday to the beach this year.",
                            "target_lang_translations": {
                                "ru": "В этом году мы планируем поехать в <w>июньский</w> отпуск на пляж."
                            }
                        }
                    ],
                    "common_phrases": [
                        "early June",
                        "late June",
                        "June holiday",
                        "month of June"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шестой месяц григорианского календаря, следующий за маем и предшествующий июлю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "июнь",
                                "target_lang_sense_clarification": "название месяца"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e46e9872-4f64-3010-975d-8f60cd9b42f2",
                    "sense_definition": "A female given name, originally referring to the month.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "My grandmother's name was <w>June</w>, and she was born in the summer.",
                            "target_lang_translations": {
                                "ru": "Мою бабушку звали <w>Джун</w>, и она родилась летом."
                            }
                        },
                        {
                            "text": "The character <w>June</w> in the story is a very kind person.",
                            "target_lang_translations": {
                                "ru": "Персонаж по имени <w>Джун</w> в этой истории — очень добрый человек."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Женское имя, первоначально происходящее от названия месяца."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джун",
                                "target_lang_sense_clarification": "женское имя"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b1444e2d-35e7-3ed6-9f36-907862f0df86",
                    "sense_definition": "A male nickname often used for a boy who is a junior to his father.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "names",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Everyone in the family calls the little boy <w>June</w> because he is named after his dad.",
                            "target_lang_translations": {
                                "ru": "Все в семье зовут маленького мальчика <w>Джун</w>, потому что его назвали в честь отца."
                            }
                        },
                        {
                            "text": "His legal name is Robert, but his nickname has always been <w>June</w>.",
                            "target_lang_translations": {
                                "ru": "Его официальное имя — Роберт, но его прозвищем всегда было <w>Джун</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "Junior"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used as a nickname for 'Junior'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Мужское прозвище, часто используемое для мальчика, названного в честь отца (младшего)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Джун",
                                "target_lang_sense_clarification": "прозвище для младшего"
                            },
                            {
                                "target_lang_word": "младший",
                                "target_lang_sense_clarification": "значение прозвища"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d042271f-f095-3e57-be56-706b51baddcc",
                    "sense_definition": "To move with great speed or to rush.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "movement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The water began to <w>june</w> through the narrow gap in the rocks.",
                            "target_lang_translations": {
                                "ru": "Вода начала <w>проноситься</w> сквозь узкую щель в скалах."
                            }
                        },
                        {
                            "text": "He watched the cyclists <w>june</w> past the finish line at high speed.",
                            "target_lang_translations": {
                                "ru": "Он наблюдал, как велосипедисты на большой скорости <w>проносятся</w> мимо финишной черты."
                            }
                        }
                    ],
                    "synonyms": [
                        "rush",
                        "dash",
                        "speed"
                    ],
                    "antonyms": [
                        "crawl",
                        "dawdle"
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "rare or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Двигаться с большой скоростью или стремительно нестись."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нестись",
                                "target_lang_sense_clarification": "быстро двигаться"
                            },
                            {
                                "target_lang_word": "мчаться",
                                "target_lang_sense_clarification": "стремительно перемещаться"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}