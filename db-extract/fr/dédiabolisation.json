                "word": "dédiabolisation",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4cab8ce4-43f2-403a-8e19-be45861d1b03",
                        "entry_id": "a3026fb9-37d5-38b6-89c2-2cc431f7c07e",
                        "tags": [
