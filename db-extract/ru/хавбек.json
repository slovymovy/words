                                        "glosses": [
                                            "Any of various positions on the field of play between the forwards and the fullbacks."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb749441-23c9-33b9-89b0-34e4463f1e49",
