                        ],
                        "examples": [
                            {
                                "example_id": "86146318-a6dd-4ad1-828c-94b2fe75e839",
                                "sense_id": "3c9584b0-c358-3cf4-a157-a05bf6823740",
                                "text": "On examine aussi la rentabilité par rapport aux ventes en déterminant la marge bénéficiaire."
                            },
                            {
                                "example_id": "6e481334-45b8-43c5-bc4c-470e4cc7196e",
                                "sense_id": "3c9584b0-c358-3cf4-a157-a05bf6823740",
                                "text": "Je vous l’ai dit : cela fait trente ans qu’au nom de l’idéologie, de la rentabilité et des priorités budgétaires, on sinistre la psychiatrie dans ce pays."
                            },
                            {
                                "example_id": "33b25b08-8927-4130-80a9-5e04388d4416",
                                "sense_id": "3c9584b0-c358-3cf4-a157-a05bf6823740",
                                "text": "Désormais, dans les groupes qui se constituèrent, la rentabilité allait devenir le maître mot. On vit apparaître une catégorie de cadres jusque-là inconnue : les contrôleurs de gestion."
                            }
                        ]
                    }
