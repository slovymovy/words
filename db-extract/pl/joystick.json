                "senses": [
                    {
                        "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                        "entry_id": "874dbd4e-4def-3003-8fbc-2eaa314c9208",
                        "glosses": [
                            "joystick (a mechanical control device consisting of a handgrip mounted on a base or pedestal and typically having one or more buttons, used to control an aircraft, computer, or other equipment)"
                        ],
                        "tags": [
                            "inanimate",
                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "93607abc-aa39-49e3-9d98-e3f5614ffb6a",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "komputerowy joystick",
                                "translation": "computer joystick",
                                "english": "computer joystick"
                            },
                            {
                                "example_id": "c339b0f5-52be-47c5-98b4-f30d82b0ca3b",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "joystick i klawiatura",
                                "translation": "joystick and keyboard",
                                "english": "joystick and keyboard"
                            },
                            {
                                "example_id": "7c5aeb51-4619-48f0-b46e-bd5a3a738573",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "sterować joystickiem",
                                "translation": "to control with a joystick",
                                "english": "to control with a joystick"
                            },
                            {
                                "example_id": "22929c53-417c-4581-b5c2-009825658137",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "obsługiwać za pomocą joysticka",
                                "translation": "to operate with a joystick",
                                "english": "to operate with a joystick"
                            },
                            {
                                "example_id": "c936c7b0-d96b-4bc8-88b5-6ff01e109e30",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "Dobrze jest także wyposażyć komputer w joystick lub konsolę do gry. Zaoszczędzi to częstych awarii klawiatury.",
                                "translation": "It is also a good idea to equip your computer with a joystick or a gaming console. This will save you from frequent keyboard failures.",
                                "english": "It is also a good idea to equip your computer with a joystick or a gaming console. This will save you from frequent keyboard failures."
                            },
                            {
                                "example_id": "f59e204b-553c-4d26-9874-cd5e52233ae9",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "Kierowca może zmieniać biegi[,] używając oryginalnego joysticka na środkowym tunelu bądź też, nie odrywając rąk od kierownicy, dwoma umieszczonymi pod nią przyciskami.",
                                "translation": "The driver can change gears[,] using the original joystick on the central tunnel or, without taking his hands off the steering wheel, using the two buttons located below it.",
                                "english": "The driver can change gears[,] using the original joystick on the central tunnel or, without taking his hands off the steering wheel, using the two buttons located below it."
                            },
                            {
                                "example_id": "605a57b8-7217-4e89-afbd-06d3f3186e45",
                                "sense_id": "09419b96-a6af-368f-9385-c6ce047ffd64",
                                "text": "Zestaw chirurgiczny składa się z konsoli z monitorem i elementami kontrolnymi oraz samego robota. Ramiona robota z wymiennymi narzędziami są kierowane za pomocą joysticków, zaś kamera przekazująca obraz operowanego miejsca — głosem.",
                                "translation": "The surgical set consists of a console with a monitor and control elements and the robot itself. The robot arms with interchangeable tools are controlled by joysticks, while the camera transmitting the image of the operated site — by voice.",
                                "english": "The surgical set consists of a console with a monitor and control elements and the robot itself. The robot arms with interchangeable tools are controlled by joysticks, while the camera transmitting the image of the operated site — by voice."
                            }
                        ]
                    }
