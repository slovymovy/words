                "senses": [
                    {
                        "sense_id": "94ab47da-d8b1-3afc-8b56-4850d535c181",
                        "entry_id": "9decde49-bb48-3284-b540-3437bf16920a",
                        "glosses": [
                            "en (ook) niet"
                        ],
                        "tags": [
                            "formal"
                        ],
                        "examples": [
                            {
                                "example_id": "cd19c8b5-1a4a-44da-ad28-2b861a73522d",
                                "sense_id": "94ab47da-d8b1-3afc-8b56-4850d535c181",
                                "text": "Natuurlijk hebben noch ik noch de heren in lange jurken enig idee wat waar is en wat niet, maar je moet tenslotte toch ergens in geloven."
                            },
                            {
                                "example_id": "799074fe-b60b-4a82-9acc-94a7e79b4d54",
                                "sense_id": "94ab47da-d8b1-3afc-8b56-4850d535c181",
                                "text": "De feiten rondom de ontvoering van Mehdi ben Barka, die ook wel de handelsreiziger van de revolutie werd genoemd, zijn tot op heden onopgehelderd gebleven. Volgens het onderzoek dat door De Gaulle was opgezet had noch de Franse politie noch de geheime dienst enige rol hierin gespeeld."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f0257cfc-63c2-456f-8683-3a3b13098097",
                        "source_entry_id": "9decde49-bb48-3284-b540-3437bf16920a",
                        "source_sense_id": "94ab47da-d8b1-3afc-8b56-4850d535c181",
                        "target_lang_word": "neither",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                        "entry_id": "b1b46df7-7688-31a6-bcc2-1f9cf05a0363",
                                        "glosses": [
                                            "Not one of two; not either; not one or the other."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1810723-97b1-46fb-b373-bb1042fb8588",
                                                "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                                "text": "Neither definition seems correct."
                                            },
                                            {
                                                "example_id": "97e6628f-1ac0-4a66-bd5c-4538ee6b49ac",
                                                "sense_id": "3a529d01-13c9-3fe6-bad0-c0a4e3f29806",
                                                "text": "She was neither learned nor intelligent, but she contrived to dress both herself and her daughter out of a meagre jointure, supplying with her clever fingers what her purse could not buy;[…]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                        "entry_id": "9d28c3e7-a47b-3b2e-8668-90ad5c2e8c54",
                                        "glosses": [
                                            "Not either (used with nor)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60e4732d-9a3e-4bcd-a51a-6f88e356e0ae",
                                                "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                                "text": "Neither you nor I likes it."
                                            },
                                            {
                                                "example_id": "297de0be-a834-4c00-a852-7d840d513d56",
                                                "sense_id": "7c8f5ea3-dbd2-3368-bbfc-ba482e78b690",
                                                "text": "For most people, this sacrifice is made easily and instinctively. Not so for otroverts, who are neither willing nor able to passively adopt the social scripts that others do. To the otrovert, who is constantly engaged with the choices and consequences of their individual life, social norms follow a circular logic: […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                        "entry_id": "32ee1389-d02b-3962-818c-b377acfa561d",
                                        "glosses": [
                                            "Not either one of two."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3126ed0-871a-4f5d-8a1b-0702cab94ed8",
                                                "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                                "text": "I’ve tried on both shirts, but neither fits properly."
                                            },
                                            {
                                                "example_id": "469d4996-3ad8-4f89-8784-c374778aad05",
                                                "sense_id": "70472506-787f-3a80-991c-8e68d43d2b95",
                                                "text": "Her words of advice will help neither of us."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                        "entry_id": "e485c291-f42c-32ed-882a-abd0f479a722",
                                        "glosses": [
                                            "Similarly not."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94ecdce9-12cd-4e35-a491-e99f5cd2013f",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Just as you would not correct it, neither would I."
                                            },
                                            {
                                                "example_id": "72781cdd-8db3-4e92-957c-ab785c380f7f",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Neither can she stop him, nor can he stop her."
                                            },
                                            {
                                                "example_id": "6061bcf8-3352-4c11-b9b3-c93813b533da",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "Neither now, nor ever will he forsake his mother."
                                            },
                                            {
                                                "example_id": "d9d21f09-7f0d-44c5-b4c1-92b076b4ba55",
                                                "sense_id": "c9ae4ab8-906a-35c9-9840-91fc27afb7bc",
                                                "text": "The ability to shift profits to low-tax countries by locating intellectual property in them[…]is often assumed to be the preserve of high-tech companies. […] current tax rules make it easy for all sorts of firms to generate […] “stateless income”: profit subject to tax in a jurisdiction that is neither the location of the factors of production that generate the income nor where the parent firm is domiciled."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "neither",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "646a8ec3-e2d5-309d-89bf-2ffd234c5983",
                                        "entry_id": "ac08ad05-f0e3-3b64-98d2-70eaae3e0f73",
                                        "glosses": [
                                            "Nor."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ce3b3b50-17d6-4e6f-8a62-e45f3d7b6143",
                                                "sense_id": "646a8ec3-e2d5-309d-89bf-2ffd234c5983",
                                                "text": "But here thou canst not handle aught, neither make the folk ware of thee, not though thou shout thy throat hoarse."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ce9ce392-5e84-4b1e-9662-63a77f98ef16",
                        "source_entry_id": "9decde49-bb48-3284-b540-3437bf16920a",
                        "source_sense_id": "94ab47da-d8b1-3afc-8b56-4850d535c181",
                        "target_lang_word": "ni",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ni",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                        "entry_id": "5e997d10-1df5-39cd-be31-43b8d962a423",
                                        "glosses": [
                                            "Conjonction de coordination négative qui correspond à et affirmatif."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f282d461-d9f4-4f79-b322-fd8729cdafe2",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "La véritable affaire n'était pas encore commencée. On n'entendait ni les cris antidynastiques qui étaient attendus ni le grondement orageux de La Marseillaise."
                                            },
                                            {
                                                "example_id": "555fc97e-c986-4aa3-b409-ca16baf15dcb",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "Donc, plus de fausse pudeur ni de sensiblerie de mauvais aloi."
                                            },
                                            {
                                                "example_id": "f3d89f40-8ae9-4264-ab21-6b48be6b8425",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "Pendant de longues heures nous marchons en silence, ne regardant ni à droite ni à gauche, la tête baissée sous nos capuchons pour nous garantir de l’ondée cinglante."
                                            },
                                            {
                                                "example_id": "f117068e-e752-44d4-9478-17ebc0c0a79c",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "Ces sortes d’affaires s’instruisent sans huissiers ni défenseurs. Le ministère de ceux-ci est déclaré n’être pas obligatoire, et le surcroît de frais qu’il eût occasionné être irrépétible."
                                            },
                                            {
                                                "example_id": "7aee6843-1def-42b0-8601-8f3c2c9bca2a",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "— C’est un katoï, chuchota la mère abbesse, ce qui peut se traduire par ladyboy. Un être émasculé, qui n’est ni homme ni femme."
                                            },
                                            {
                                                "example_id": "792e9b6a-1bf1-4140-9f6c-2489d5c1f63f",
                                                "sense_id": "dd3891c1-2abd-3c07-9291-3f58c37ad5d0",
                                                "text": "On s'est retrouvés sur une île sans rien à manger ni à faire à part traîner ensemble. Et c'était le paradis. Mais les bonnes choses ne durent jamais."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97794d25-6fce-3d52-a567-7255988ee04a",
                                        "entry_id": "5e997d10-1df5-39cd-be31-43b8d962a423",
                                        "glosses": [
                                            "Entre deux propositions :"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fde17ab3-63a7-4266-846a-a1875d9daaf6",
                                                "sense_id": "97794d25-6fce-3d52-a567-7255988ee04a",
                                                "text": "L'année dernière un de ses anciens camarades de Polytechnique, administrateur-délégué des Assurances Nationales, qu'il a rencontré au bal des Antiques, lui a proposé la direction d'un bureau d’actuaires ; il n'a répondu ni oui ni non, sait-on jamais ?"
                                            },
                                            {
                                                "example_id": "e76e53fb-f713-4dd1-bf18-217669ce4efe",
                                                "sense_id": "97794d25-6fce-3d52-a567-7255988ee04a",
                                                "text": "Il ne boit ni ne mange.— Je ne crois pas qu’il vienne, ni même qu’il pense à venir."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
