                        "glosses": [
                            "Qui va dans le sens de la théorie d’une évolution biologique par sauts évolutifs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cefc4487-d306-4673-bd1b-da5a6ab17a71",
                                "sense_id": "67292e7c-c8fc-3577-832d-3ce72ef635c3",
                                "text": "Selon cette vue transitionniste, exposée en 1997, la variation n’est intrinsèquement ni gradualiste, ni saltationniste, elle passe d’une modalité à l'autre selon la complexification des génomes et des processus."
                            },
                            {
                                "example_id": "b954456b-d0f0-4236-92f1-762fe23cb05e",
                                "sense_id": "67292e7c-c8fc-3577-832d-3ce72ef635c3",
                                "text": "Ces deux exemples nous ramènent à notre propos du début : l’évolution est-elle saltationniste ou gradualiste ?"
                            },
                            {
                                "example_id": "e4ce815a-3634-4880-adda-9e4bc52457bf",
                                "sense_id": "67292e7c-c8fc-3577-832d-3ce72ef635c3",
                                "text": "Dans l’ensemble, les conceptions saltationnistes ou catastrophistes de l’évolution biologique se sont accompagnées d’une vision typologique des groupes taxinomiques."
                            }
                        ]
                    }
