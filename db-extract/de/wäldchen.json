                                            {
                                                "example_id": "62363e8f-b341-4e4c-9e26-a64ab2bf9d50",
                                                "sense_id": "d4baabf0-3e02-3d19-86bf-fc3a2fbea57b",
                                                "text": "Haar vingers speelden met de stelen van het bosje bloemen dat in een glazen vaasje stond."
                                            }
