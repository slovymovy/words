                            {
                                "example_id": "2143f4a7-cd71-4d26-a83d-2ae7a9f9d498",
                                "sense_id": "e48cf3ae-2607-3699-bce3-3032af6cc085",
                                "text": "„Die Kunststoffdübel sind für unterschiedliche Baustoffe geeignet, in einem Hohlraum verankern sie sich durch Verknoten.“"
                            },
                            {
                                "example_id": "faf285c8-b620-4d6d-b335-30b1879cd7c0",
                                "sense_id": "e48cf3ae-2607-3699-bce3-3032af6cc085",
                                "text": "„Wer langfristig sichergehen möchte, dass die Dübel nicht ausbrechen, setzt bei Kunststoffdübel auf die hochwertige Variante aus Nylon.“"
                            }
                        ],
