                "senses": [
                    {
                        "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                        "entry_id": "03083a57-1ae8-36dd-ae69-36d3801ff1ea",
                        "glosses": [
                            "ein Prozess des ortsbezogenen Niederlassens von Lebewesen mit anschließender Vermehrung sowie das Ergebnis dieses Prozesses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "871bbc31-c5c0-4fa3-ad16-1e66320ea2f8",
                                "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                                "text": "Die Besiedelung Nordamerikas erfolgte in mehreren Einwanderungswellen."
                            },
                            {
                                "example_id": "24d11ae4-161e-43f5-bdb7-741a08845721",
                                "sense_id": "4ad70302-e46c-3c30-adee-96a96247e06d",
                                "text": "„Die Besiedelung der Sierra Morena beschäftigte mich sehr; vor allem schrieb ich über die Verwaltung, die eine Grundvoraussetzung zum Gedeihen der Kolonie war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
