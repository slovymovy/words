                                "example_id": "16914514-fc8e-46c2-9b85-1352a7116683",
                                "sense_id": "d55aea22-c92c-351f-ab13-d1955732ddea",
                                "text": "Als \"Bauchhöhle\" wird in der anatomischen Fachsprache der Bereich des Rumpfes zwischen Brustkorb und Becken bezeichnet."
                            },
                            {
                                "example_id": "1c58ca7b-5345-420d-a8b6-e30844795062",
                                "sense_id": "d55aea22-c92c-351f-ab13-d1955732ddea",
                                "text": "„Schon war die Bauchhöhle weit geöffnet und der Aufbruch, also Innereien, Magen, Gedärme, herausgerissen worden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
