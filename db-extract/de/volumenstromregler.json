                "senses": [
                    {
                        "sense_id": "ab4118c9-9b63-3df5-b3cb-e131c13402b1",
                        "entry_id": "d826f630-f337-3474-8114-62cc84ec5f17",
                        "glosses": [
                            "ein technisches Bauelement zum Anpassen des Volumenstroms innerhalb eines Regelkreises; Sollwertgeber"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aeb1894a-5317-45e7-aaeb-96ff35396f00",
                                "sense_id": "ab4118c9-9b63-3df5-b3cb-e131c13402b1",
                                "text": "„Zuber Volumenstromregler sind in folgenden Ausführungen in thermoplastischen Kunststoffen möglich: PP, PPs, PPs-EL, PE, PVDF. Durch die Ausführung aus Kunststoff ist es möglich unsere Volumenstromregler bei chemisch belasteter Abluft einzusetzen.“"
                            },
                            {
                                "example_id": "cea471eb-c496-4bd7-bcbf-55e8fb7d0493",
                                "sense_id": "ab4118c9-9b63-3df5-b3cb-e131c13402b1",
                                "text": "„Ein Volumenstromregler wird zur druckunabhängigen Regelung von Volumenströmen in Lüftungs- und Klimaanlagen eingesetzt.“"
                            },
                            {
                                "example_id": "8483aac6-58be-44c0-9bba-89ba95e68327",
                                "sense_id": "ab4118c9-9b63-3df5-b3cb-e131c13402b1",
                                "text": "„Für konstante und variable Volumenströme. Runder Volumenstromregler mit integriertem elektronischen Regelsystem zum Einsatz in Zuluft- und Abluftkanälen von RLT-Anlagen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
