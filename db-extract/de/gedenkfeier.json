                "senses": [
                    {
                        "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                        "entry_id": "5a8f4324-c188-3cfd-bc19-9361e36557a5",
                        "glosses": [
                            "Feier, die zum Gedenken an eine verstorbene Persönlichkeit oder ein historisches Ereignis begangen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d3a9f91-d792-46f3-a713-536687bb6c6c",
                                "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                                "text": "Der Präsident hielt eine Ansprache bei der Gedenkfeier."
                            },
                            {
                                "example_id": "ef938a0e-479c-432e-bc12-eb63ad75a3bc",
                                "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                                "text": "„Einen Monat nach dem Tod des Vaters findet in Manchester eine Gedenkfeier statt.“"
                            },
                            {
                                "example_id": "d598cda6-23fe-457f-b442-afb240883292",
                                "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                                "text": "„Die beiden hatten sich bei Updikes Gedenkfeier am 19. März 2009 kennengelernt – Roths sechsundsiebzigsten Geburtstag.“"
                            },
                            {
                                "example_id": "4164dc4b-fb03-4196-8352-3320d0b8a1c7",
                                "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                                "text": "„Die Gedenkfeier fand in der Kirche von Akranes statt.“"
                            },
                            {
                                "example_id": "e6ade42e-dc06-4838-9b4e-359e6e5e4f60",
                                "sense_id": "98a50de0-2084-363e-b4f5-9eebbf12d561",
                                "text": "„Wir hatten die Gedenkfeier für Mama in diesem Hotel abgehalten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
