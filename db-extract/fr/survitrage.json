                        "glosses": [
                            "Technique d’ajout d’une deuxième vitre à une fenêtre ancienne initialement dotée d’un simple vitrage ; vitre ajoutée à un simple vitrage."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff9628f7-83c3-4b01-bf26-98bb35ccc5e1",
                                "sense_id": "e5d3330e-04ca-3bc1-b751-1a11313eea28",
                                "text": "Poser un survitrage sur une fenêtre est une technique destinée à améliorer les performances d’isolation thermique et d’isolation acoustique des fenêtres."
                            },
                            {
                                "example_id": "11128149-5b11-497b-a2f1-8083a57e5b44",
                                "sense_id": "e5d3330e-04ca-3bc1-b751-1a11313eea28",
                                "text": "Il est aussi possible de réaliser un survitrage, c'est-à-dire un ajout d'une vitre côté intérieur, la vitre existante étant conservée."
                            }
                        ]
                    }
