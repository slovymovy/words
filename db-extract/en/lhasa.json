                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lhasa",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7c51f849-a405-3534-ad89-c2fa6a4140c5",
                                        "entry_id": "20ce342d-b30a-388d-80df-01289635212b",
                                        "glosses": [
                                            "Hauptstadt von Tibet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1dd933eb-d30f-4422-999a-37058ac42a1f",
                                                "sense_id": "7c51f849-a405-3534-ad89-c2fa6a4140c5",
                                                "text": "„Lasst sie die falschen Lehren von Konfuzius und Buddha vergessen und auch die Götter Tibets und Lhasas, die es zuließen, dass ihr Volk unter der Knechtschaft der weißen Teufel endete.“"
                                            },
                                            {
                                                "example_id": "602c8df2-07bc-489c-9def-0f41cca9245a",
                                                "sense_id": "7c51f849-a405-3534-ad89-c2fa6a4140c5",
                                                "text": "„Falls es wirklich Ruinen sind, Werke intelligenter Wesen, dann müssen diese zyklopischen Steinterrassen und Festungsanlagen, die sich um jene scharfkantigen, erschreckend zerklüfteten Gipfel drängen, die ältesten Artefakte sein, die der Wissenschaft bekannt sind ... viele, viele Zeitalter vor dem dunklen Lhasa oder den labyrinthischen Ruinenstädten von Ponape erbaut ...“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
