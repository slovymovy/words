                                "target_senses": [
                                    {
                                        "sense_id": "c0f1bad9-68d6-3687-b9b8-d242c6c857d4",
                                        "entry_id": "84f95bad-c3ee-3b9c-ad16-35c1ea0d7c95",
                                        "glosses": [
                                            "In a horizontal direction or position."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3606e209-54ba-4465-8c1d-d75df4cbd4dd",
                                                "sense_id": "c0f1bad9-68d6-3687-b9b8-d242c6c857d4",
                                                "text": "Japanese can be written horizontally as well as vertically."
                                            },
                                            {
                                                "example_id": "cb504087-ba0c-448d-ab66-6203ac033d12",
                                                "sense_id": "c0f1bad9-68d6-3687-b9b8-d242c6c857d4",
                                                "text": "Moreover, recent research showed that the amount of genetic material that can be moved horizontally may include small gene fragments, entire operons, superoperons that encode complex biochemical pathways, and whole chromosomes [ 54 ]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f23c2fd1-6b88-3595-8639-f5b1d3a9a3ac",
                                        "entry_id": "84f95bad-c3ee-3b9c-ad16-35c1ea0d7c95",
                                        "glosses": [
                                            "In a horizontal manner (any sense)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b537f2bd-82af-4aca-8a09-86c631958477",
                                                "sense_id": "f23c2fd1-6b88-3595-8639-f5b1d3a9a3ac",
                                                "text": "an organism transmitted horizontally"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25aca6b1-03b9-4b6e-95cb-174b5d2b71c9",
                        "source_entry_id": "b2e3d4be-dc63-33fb-b12a-3d6f1ebc8f26",
                        "source_sense_id": "b4800c71-4343-39f3-8639-ca16cae3f299",
                        "target_lang_word": "across",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "across",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4721d93-cfd0-3c1a-af6c-f2cf57f33a9f",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "To, toward, or from the far side of (something that lies between two points of interest)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc6c1b98-f0d4-448e-ba97-cfe3477d33d4",
                                                "sense_id": "a4721d93-cfd0-3c1a-af6c-f2cf57f33a9f",
                                                "text": "He came across the street to meet me."
                                            },
                                            {
                                                "example_id": "c61cc78d-f78d-44fd-8c72-5fc7721cde07",
                                                "sense_id": "a4721d93-cfd0-3c1a-af6c-f2cf57f33a9f",
                                                "text": "We rowed across the river."
                                            },
                                            {
                                                "example_id": "0c66f074-2228-4f5b-aff7-d8d2b2cc0f54",
                                                "sense_id": "a4721d93-cfd0-3c1a-af6c-f2cf57f33a9f",
                                                "text": "Fortunately, there was a bridge across the river."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "581bab5c-59d0-3707-acac-4d620a093f3b",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "On the opposite side of (something that lies between two points of interest)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "904c19e7-d836-484a-b23b-96ccc0132205",
                                                "sense_id": "581bab5c-59d0-3707-acac-4d620a093f3b",
                                                "text": "That store is across the street."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9fc65976-20d4-3d6d-8c1f-ed4b23755973",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "across from: on the opposite side, relative to something that lies between, from (a point of interest)."
                                        ],
                                        "tags": [
                                            "Southern-US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8904f52a-cba9-4e0f-a930-f1822930a848",
                                                "sense_id": "9fc65976-20d4-3d6d-8c1f-ed4b23755973",
                                                "text": "And make sure you're parked across the mall in the outside lot. […] Last time I was there, I parked in a parking structure and paid an arm and a leg for it."
                                            },
                                            {
                                                "example_id": "24f3e569-f5a2-4dd6-ace9-fd88d3f676b9",
                                                "sense_id": "9fc65976-20d4-3d6d-8c1f-ed4b23755973",
                                                "text": "On another occasion, Clinton asked Patterson to drive him to Chelsea's school, Booker Elementary, where Clinton met the department store clerk and climbed into her car.\n\"I parked across the entrance and stood outside the car looking around, about 120 feet from where they were parked in a lot that was pretty well lit,\" Patterson recalled. \"[…]They stayed in the car for thirty to forty minutes.\""
                                            },
                                            {
                                                "example_id": "813c371f-6f96-4118-aa10-10ab4efa9c02",
                                                "sense_id": "9fc65976-20d4-3d6d-8c1f-ed4b23755973",
                                                "text": "A boy that sat across me politely introduced himself as Jackson Klausner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "603196f7-3301-323a-8ec7-0bf4e874c385",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "From one side to the other within (a space being traversed)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98caeb5a-ec96-4c76-8fae-7264bc06c4d8",
                                                "sense_id": "603196f7-3301-323a-8ec7-0bf4e874c385",
                                                "text": "The meteor streaked across the sky."
                                            },
                                            {
                                                "example_id": "b676d1db-11de-4a9a-8760-f25f2c588368",
                                                "sense_id": "603196f7-3301-323a-8ec7-0bf4e874c385",
                                                "text": "He walked across the room."
                                            },
                                            {
                                                "example_id": "ae77a763-7f1e-44f1-8877-7e0ee440c954",
                                                "sense_id": "603196f7-3301-323a-8ec7-0bf4e874c385",
                                                "text": "Could you slide that across the table to me, please?"
                                            },
                                            {
                                                "example_id": "593dd560-2bdb-4d5d-9b53-7f360045af1d",
                                                "sense_id": "603196f7-3301-323a-8ec7-0bf4e874c385",
                                                "text": "I corralled the judge, and we started off across the fields, in no very mild state of fear of that gentleman's wife, whose vigilance was seldom relaxed. And thus we came by a circuitous route to Mohair, the judge occupied by his own guilty thoughts, and I by others not less disturbing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "64acd4c5-0f36-3f87-99cd-bc273ceeaead",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "At or near the far end of (a space)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f1aae4f9-85b8-40df-9bdb-07121116f875",
                                                "sense_id": "64acd4c5-0f36-3f87-99cd-bc273ceeaead",
                                                "text": "\"Mam's baking and Cathleen's asleep. I've got a pile of washing bubbling in the copper, so I'd best be off.\" With that she was across the room and out the door."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3bd4fefe-6c47-3f77-86cb-385978c074b9",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "Spanning."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89f821b1-c5fe-46e5-a358-e3fb645ccdd9",
                                                "sense_id": "3bd4fefe-6c47-3f77-86cb-385978c074b9",
                                                "text": "This poetry speaks across the centuries."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e4869191-c175-36fe-9af3-e5acf5770658",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "Throughout."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2cbbd47-466d-4777-8429-0bd0473eeef3",
                                                "sense_id": "e4869191-c175-36fe-9af3-e5acf5770658",
                                                "text": "All across the country, voters were communicating their representatives."
                                            },
                                            {
                                                "example_id": "b670c351-5aa1-46e2-8101-85bd6c2267a3",
                                                "sense_id": "e4869191-c175-36fe-9af3-e5acf5770658",
                                                "text": "Last spring, the periodical cicadas emerged across eastern North America. Their vast numbers and short above-ground life spans inspired awe and irritation in humans—and made for good meals for birds and small mammals."
                                            },
                                            {
                                                "example_id": "fca36767-8df4-406d-accf-b510dd9c3c71",
                                                "sense_id": "e4869191-c175-36fe-9af3-e5acf5770658",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e37403-bdb8-310e-9f6d-9c84312fe594",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "So as to intersect or pass through or over at an angle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47aea339-ec64-4358-a732-fc68ef16fc7f",
                                                "sense_id": "b5e37403-bdb8-310e-9f6d-9c84312fe594",
                                                "text": "Lay the top stick across the bottom one."
                                            },
                                            {
                                                "example_id": "40f871e0-e7e0-4e46-a10b-ff37ab0c393c",
                                                "sense_id": "b5e37403-bdb8-310e-9f6d-9c84312fe594",
                                                "text": "She had straps fastened across the conduit every six feet."
                                            },
                                            {
                                                "example_id": "b740d9e2-7e1c-4bcd-aae2-4c8c9c87def5",
                                                "sense_id": "b5e37403-bdb8-310e-9f6d-9c84312fe594",
                                                "text": "He parked across the end of the driveway, blocking her in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "358840cc-b6dd-326d-bcec-961b9f8b621b",
                                        "entry_id": "da89d8f5-a541-34c2-ba64-e89f329bc3a0",
                                        "glosses": [
                                            "In possession of full, up-to-date information about; abreast of."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bcbc50e6-7925-4234-a2ad-c9b7df4fb5f5",
                                                "sense_id": "358840cc-b6dd-326d-bcec-961b9f8b621b",
                                                "text": "Keep across all the latest news here at Channel 10."
                                            },
                                            {
                                                "example_id": "d06295b9-515c-41d2-a712-0825698a7646",
                                                "sense_id": "358840cc-b6dd-326d-bcec-961b9f8b621b",
                                                "text": "As a regular news reader I thought I was across the eccentricities of the US president."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "across",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a969189-e977-3f76-8d01-b6f97fd88fa1",
                                        "entry_id": "7d739888-9490-3b26-a8dd-d6b39e946ce4",
                                        "glosses": [
                                            "From one side to the other."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "20ea5fb9-b81a-407d-bd85-66b8fb89fdaa",
                                                "sense_id": "7a969189-e977-3f76-8d01-b6f97fd88fa1",
                                                "text": "she helped the blind man across; the river is half a mile across"
                                            },
                                            {
                                                "example_id": "4a0055bf-7829-4618-b3b4-be3be1811b60",
                                                "sense_id": "7a969189-e977-3f76-8d01-b6f97fd88fa1",
                                                "text": "[The researchers] noticed many of their pieces of [plastic marine] debris sported surface pits around two microns across. Such pits are about the size of a bacterial cell. Closer examination showed that some of these pits did, indeed, contain bacteria, […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "83a3d8d8-951b-303d-9ea0-11d850f25d13",
                                        "entry_id": "7d739888-9490-3b26-a8dd-d6b39e946ce4",
                                        "glosses": [
                                            "On the other side."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2593f3d0-8302-475f-89f5-703e42e403dc",
                                                "sense_id": "83a3d8d8-951b-303d-9ea0-11d850f25d13",
                                                "text": "If we sail off at noon, when will we be across?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1f24aae8-eeed-38c6-b4fc-81a436c8e54e",
                                        "entry_id": "7d739888-9490-3b26-a8dd-d6b39e946ce4",
                                        "glosses": [
                                            "In a particular direction."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ee5d151d-1ab3-453e-9950-78a2460edb16",
                                                "sense_id": "1f24aae8-eeed-38c6-b4fc-81a436c8e54e",
                                                "text": "He leaned across for a book."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d6d4251-bc18-3563-ae82-bb23ddbe149c",
                                        "entry_id": "7d739888-9490-3b26-a8dd-d6b39e946ce4",
                                        "glosses": [
                                            "Horizontally."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2c62eed3-c786-4932-8462-e1e1f73fdeab",
                                                "sense_id": "1d6d4251-bc18-3563-ae82-bb23ddbe149c",
                                                "text": "I got stuck on 4 across."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "across",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cb15062a-731d-3ecb-8bba-0fe5b7def55f",
                                        "entry_id": "e42ae924-332c-3699-885c-998eebf8a14a",
                                        "glosses": [
                                            "A word that runs horizontally in the completed puzzle grid or its associated clue."
                                        ],
                                        "tags": [
                                            "in-compounds",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "389163a7-1eae-473b-ab96-d52f1a96b7fd",
                                                "sense_id": "cb15062a-731d-3ecb-8bba-0fe5b7def55f",
                                                "text": "I solved all of the acrosses, but then got stuck on 3 down."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b13f3931-9fb0-4b2c-b909-f1104a839996",
                        "source_entry_id": "b2e3d4be-dc63-33fb-b12a-3d6f1ebc8f26",
                        "source_sense_id": "b4800c71-4343-39f3-8639-ca16cae3f299",
                        "target_lang_word": "horizontalement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "horizontalement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "40db8bb1-767d-37a6-a77d-bc975fbb262e",
                                        "entry_id": "b88ec802-cb5e-3528-8ad2-20e09a034faa",
                                        "glosses": [
                                            "Parallèlement à l’horizon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "718bc0d1-a9c0-45a5-9755-fef27eecac66",
                                                "sense_id": "40db8bb1-767d-37a6-a77d-bc975fbb262e",
                                                "text": "Il est démontré qu’un boulet de canon tiré horizontalement décrit, dans l’hypothèse de la pesanteur constante, une parabole terminée à un certain point par la rencontre de la terre."
                                            },
                                            {
                                                "example_id": "42ad9391-9545-4561-a8a2-c47fcb016c6b",
                                                "sense_id": "40db8bb1-767d-37a6-a77d-bc975fbb262e",
                                                "text": "Cet angle a été adopté, parce qu'on a remarqué que le vent ne souffle pas horizontalement, mais que sa direction plonge ordinairement un peu sur la surface de la terre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ff481d88-453d-429b-abff-b67ba0f8b036",
                        "source_entry_id": "b2e3d4be-dc63-33fb-b12a-3d6f1ebc8f26",
                        "source_sense_id": "b4800c71-4343-39f3-8639-ca16cae3f299",
                        "target_lang_word": "horizontal",
