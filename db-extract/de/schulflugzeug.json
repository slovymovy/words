                        "sense_id": "f30aba13-c926-3fc4-a51a-b99e63eedcb4",
                        "entry_id": "fb0a16f7-c285-36b6-b82c-e335eb6b8987",
                        "glosses": [
                            "(meist kleines) Flugzeug, das zur Ausbildung von Piloten dient, in dem praktischer Flugunterricht stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "202f2966-05fd-4320-85b6-11ccefdce2da",
                                "sense_id": "f30aba13-c926-3fc4-a51a-b99e63eedcb4",
                                "text": "„Weil der General möglichst wenig Aufsehen erregen wollte, hatte er ein kleines, einmotoriges Schulflugzeug angefordert, das viel weniger auffiel als der große MI-17-Transporthubschrauber, den ihm der Flugplatzkommandant empfohlen hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
