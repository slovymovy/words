                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4bee28a1-1fef-384f-b988-9ad2894ed3fe",
                        "entry_id": "3f7cef06-8fd9-34d7-8985-325142a1b1c9",
                        "glosses": [
                            "een tekst of tekening door wrijven met een vlakgom verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7717202-21ca-49fc-a8f9-7ef5fdb07fe2",
                                "sense_id": "4bee28a1-1fef-384f-b988-9ad2894ed3fe",
                                "text": "Dat komt volgens Tijs omdat hij de eenhoorn getekend heeft. Wat getekend is, bestaat in zijn wereld. Was dat rothuis maar een tekening, dan kon hij het uitgummen."
                            },
                            {
                                "example_id": "b71f3768-c963-4f80-8250-e0e4a4d6f8c4",
                                "sense_id": "4bee28a1-1fef-384f-b988-9ad2894ed3fe",
                                "text": ",,We laten een positief Europa zien, waarin we elkaar opzoeken. Markus Lewe, Oberbrgermeister van Münster over het samen met Enschede uitgummen van de landsgrens."
                            }
                        ]
                    }
                ],
