                "senses": [
                    {
                        "sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                        "entry_id": "dcad35e0-f30d-3894-bab2-0f37ef7fac50",
                        "glosses": [
                            "wesoły nastrój, dobra atmosfera; radość, beztroska"
                        ],
                        "tags": [
                            "literary"
                        ],
                        "examples": [
                            {
                                "example_id": "c60ac964-f660-43de-9fbf-45da3bd9acd5",
                                "sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                                "text": "Anegdota opowiedziana przez Darka wywołała wybuch wesołości."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "314c3dae-2769-4fd9-a6ec-563d5f010c6d",
                        "source_entry_id": "dcad35e0-f30d-3894-bab2-0f37ef7fac50",
                        "source_sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                        "target_lang_word": "cheerfulness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cheerfulness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                        "entry_id": "22992355-ca5c-36ce-8567-edbb80c94af2",
                                        "glosses": [
                                            "The state of being cheerful; joy."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50aa49d1-e64f-4ddc-8391-7d8377c3d509",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "Or he that exhorteth, on exhortation: he that giueth, let him doe it with simplicitie: hee that ruleth, with diligence: hee that sheweth mercy, with cheerefulnesse."
                                            },
                                            {
                                                "example_id": "1d546bda-b067-418d-8b73-1f63d0495500",
                                                "sense_id": "86438433-9995-312b-a425-48f481e9554e",
                                                "text": "The banded ones were all dressed in white gowns - a gay survival from Old Style days, when cheerfulness and May-time were synonyms - days before the habit of taking long views had reduced emotions to a monotonous average."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e19eca45-1b09-4a7d-a995-5092b8401000",
                        "source_entry_id": "dcad35e0-f30d-3894-bab2-0f37ef7fac50",
                        "source_sense_id": "6b0e6d87-2bf1-37e1-be8f-e421a54d3aed",
                        "target_lang_word": "jollity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jollity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5d1cfb61-0d2c-3ef1-84c6-f677d378b33d",
                                        "entry_id": "b4bebb60-7382-3fb1-8dc6-99e85d0948cd",
                                        "glosses": [
                                            "The state of being jolly; jolliness, cheerfulness."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba02c345-f93a-4cc4-8a82-542f4a6bd10b",
                                                "sense_id": "5d1cfb61-0d2c-3ef1-84c6-f677d378b33d",
                                                "text": "But I pitty the flatteries, and ſelfe-applauſes of a careleſſe and impenitent heart: This jollity hath in it much danger, and vvithout ſome change, death."
                                            },
                                            {
                                                "example_id": "a142fd30-96a8-42ab-b307-7f0f1f19af56",
                                                "sense_id": "5d1cfb61-0d2c-3ef1-84c6-f677d378b33d",
                                                "text": "The Jolly Sandboys was a small road-side inn of pretty ancient date, with a sign, representing three Sandboys increasing their jollity with as many jugs of ale and bags of gold."
                                            },
                                            {
                                                "example_id": "4a05e9d5-1b40-4584-b81b-38ed598646bc",
                                                "sense_id": "5d1cfb61-0d2c-3ef1-84c6-f677d378b33d",
                                                "text": "The youngsters, not immediately within sight, seemed rather bright and desirable appurtenances than otherwise; the incidents of daily life were not without humorousness and jollity in their aspect there."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7c43564-00c3-300b-9a49-8f2c51b78af8",
                                        "entry_id": "b4bebb60-7382-3fb1-8dc6-99e85d0948cd",
                                        "glosses": [
                                            "Revelry or festivity; a merry or festive gathering."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b26501b-03cd-471c-ac6e-7b0b2b9d9ee6",
                                                "sense_id": "f7c43564-00c3-300b-9a49-8f2c51b78af8",
                                                "text": "Across the US, candidates traditionally attend rallies, barbecues and similar jollities in their states and districts."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d26ccc9-8f97-3993-85a2-83cc24862fe5",
                                        "entry_id": "b4bebb60-7382-3fb1-8dc6-99e85d0948cd",
                                        "glosses": [
                                            "Things, remarks, or characteristics which are enjoyable."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60398a19-9cd0-46b1-b21a-0d3f75e9fa4f",
                                                "sense_id": "7d26ccc9-8f97-3993-85a2-83cc24862fe5",
                                                "text": "Add to this picture a jolly, crackling, rollicking fire, going rejoicingly up a great wide chimney,—the outer door and every window being set wide open, and the calico window-curtain flopping and snapping in a good stiff breeze of damp raw air,—and you have an idea of the jollities of a Kentucky tavern."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
