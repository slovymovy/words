                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d1ee24ba-0c54-3966-8b76-0d5c15d38d25",
                                        "entry_id": "9ac1289f-bf9f-3771-89b8-39ceee085d00",
                                        "glosses": [
                                            "Région frontalière entre la Finlande et la Russie.",
                                            "Province de la partie orientale de la Finlande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "06faaa0c-ed42-47f2-9a13-fdc1ca37edfb",
                                                "sense_id": "d1ee24ba-0c54-3966-8b76-0d5c15d38d25",
                                                "text": "Les terribles événements qui font le sujet de ce roman se sont produits à cette date, en Finlande, à Kollaa. Mais aussi sur son isthme, en Carélie. Dans ses glaces, à Petsamo."
