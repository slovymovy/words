                ],
                "senses": [
                    {
                        "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                        "entry_id": "208c3c79-2d3c-3d45-aade-4894ca775e56",
                        "glosses": [
                            "gut unterhalten; belustigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3d30323-0931-4c42-8b70-5805a769715d",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "Sein amüsiertes Lächeln über ihren Look fand sie hinreißend."
                            },
                            {
                                "example_id": "266909cd-baf2-4e9c-9af9-32b4b86d3f65",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Ein leises, amüsiertes Lächeln huschte über Pippins Lippen, als er den stechenden Blick des CEOs ohne Probleme stand hielt.“"
                            },
                            {
                                "example_id": "ed2f7f67-1c0e-4743-b0b2-9b144378d093",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Natürlich war das Blödsinn. Und am amüsierten Gesicht meines Begleiters sah ich, dass er das auch wusste.“"
                            },
                            {
                                "example_id": "ee24e27d-2f4a-4b8b-a30a-57f0ea47ea98",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Torben und Tina diskutieren, wie sie ihre Wohnung einrichten wollen. Ben wird amüsierter Zeuge, als die beiden sich liebevoll über ein Möbelstück kabbeln.“"
                            },
                            {
                                "example_id": "246cc403-f251-428a-947e-241f983892fa",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Christopher Ogbogbo beobachtet das Treiben mit amüsierter Gelassenheit.“"
                            },
                            {
                                "example_id": "b0d4223d-65d1-4066-9663-44a8641931d6",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Delgado bediente sich eines Deutsch, das er zwar erst als Jugendlicher erlernt hatte, dem er aber einen amüsierten Unterton beimischte. Nun ist Gabriel Delgado gestorben - er wurde nur 61 Jahre alt.“"
                            },
                            {
                                "example_id": "e038fa51-e7d4-461b-9e84-2505a134c37f",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Grönland-Kauf: Donald Trump meint's ernst – […] In den USA reichen die Reaktionen von amüsierter Fassungslosigkeit bis zu ernstem Interesse.“"
                            },
                            {
                                "example_id": "4c04e857-ddd2-457a-8ddb-e1d9c7a67ae8",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„\"Ich träume gern Verlierer\", lässt der Schriftsteller bei einer Lesung zur Verleihung des Rheingauer Literaturpreises die amüsierten Zuhörer wissen.“"
                            },
                            {
                                "example_id": "90bc5815-be63-4b2d-95db-0854414d4f8f",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Heinz Erhardts Stimme wurde aus früheren Rundfunkaufnahmen hinzugemischt; in kurzen, eingeblendeten Szenen war Erhardt selbst als amüsierter Dichter in einem Park auf einer Bank sitzend zu sehen.“"
                            },
                            {
                                "example_id": "87acce22-fbf4-4848-9bf4-eab7e13d5c94",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„[…] er griff mit so unübersehbarem Appetit zu, dass ihm die Ritter neben ihm immer amüsiertere Blicke zuwarfen.“"
                            },
                            {
                                "example_id": "1f456d6f-803e-43e3-ba82-a890ae33d72a",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Mar betrachtete Kathrin Arnolds Gesicht, das eindeutig einen immer amüsierteren Ausdruck annahm. Sie lächelte.“"
                            },
                            {
                                "example_id": "8e20857b-754d-47b3-b3cf-6ace741fc617",
                                "sense_id": "71d90083-1aa0-3cac-86e4-571b38fca7c0",
                                "text": "„Robert hat die Liste kürzlich zur Hand genommen und voller Ehrfurcht gelesen. Ein aus nur einem Wort bestehender Punkt erregte seine größte, amüsierteste, verblüffteste Aufmerksamkeit. Das Wort, durch das ein Strich gezogen war, war sein Name.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
