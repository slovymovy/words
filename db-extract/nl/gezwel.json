                        "examples": [
                            {
                                "example_id": "71b06458-dc45-4847-906c-4ad608b7b41e",
                                "sense_id": "58d70ac2-1129-381f-9adf-d27e5f18faa0",
                                "text": "Gelukkig is dit gezwel niet kwaadaardig."
                            }
