                        "examples": [
                            {
                                "example_id": "39b9a7b2-4532-4ef2-9d7e-fbad8d09ff7f",
                                "sense_id": "69e4fac0-7091-3249-a4e7-a68db61bee38",
                                "text": "While in the judgement of wise Men, by laying the foundation of his defence on the avouchment of that which is so manifestly untrue, he hath giv’n a worse soile to his own cause, then when his whole Forces were at any time overthrown."
                            }
                        ]
                    },
