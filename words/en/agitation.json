{
    "word_family": [
        "agitate",
        "agitator",
        "agitprop"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6df8b746-a391-3ad4-8c62-ed9fbd8e4055",
                    "sense_definition": "A state of anxiety or nervous excitement that disturbs one's peace of mind.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She tried to hide her <w>agitation</w> during the difficult interview.",
                            "target_lang_translations": {
                                "zh": "在艰难的面试中，她试图掩饰自己的<w>焦虑</w>。"
                            }
                        },
                        {
                            "text": "His visible <w>agitation</w> was a clear sign of his deep concern.",
                            "target_lang_translations": {
                                "zh": "他显而易见的<w>不安</w>清楚地表明了他深切的担忧。"
                            }
                        }
                    ],
                    "synonyms": [
                        "emotion",
                        "perturbation"
                    ],
                    "common_phrases": [
                        "visible agitation",
                        "extreme agitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种不安或紧张兴奋的状态，扰乱了内心的平静。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "焦虑",
                                "target_lang_sense_clarification": "指因担忧而产生的不安情绪。"
                            },
                            {
                                "target_lang_word": "不安",
                                "target_lang_sense_clarification": "指内心不平静、焦躁的状态。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45f11b13-324b-33cf-b9f0-6c519f40fc75",
                    "sense_definition": "A state of violent or irregular motion, often referring to physical elements like water or air.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>agitation</w> of the waves made it impossible for the small boat to dock.",
                            "target_lang_translations": {
                                "zh": "海浪的<w>翻腾</w>使得小船无法靠岸。"
                            }
                        },
                        {
                            "text": "During the storm the sea was in constant <w>agitation</w>.",
                            "target_lang_translations": {
                                "zh": "暴风雨期间，大海一直处于<w>动荡</w>之中。"
                            }
                        }
                    ],
                    "synonyms": [
                        "commotion"
                    ],
                    "common_phrases": [
                        "constant agitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "指剧烈或不规则的运动状态，常用于水或空气等物理现象。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "翻腾",
                                "target_lang_sense_clarification": "指水体等剧烈起伏的状态。"
                            },
                            {
                                "target_lang_word": "动荡",
                                "target_lang_sense_clarification": "指环境或物理状态的不稳定和剧烈波动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "199181de-0627-3067-ad8d-ef9dd3482c53",
                    "sense_definition": "The act of stirring up public opinion or organizing campaigns to achieve social or political change.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "political_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Years of political <w>agitation</w> finally led to the new law.",
                            "target_lang_translations": {
                                "zh": "多年的政治<w>鼓动</w>最终促成了这项新法律。"
                            }
                        },
                        {
                            "text": "The group focused on labor <w>agitation</w> to improve working conditions.",
                            "target_lang_translations": {
                                "zh": "该团体专注于劳工<w>鼓动</w>以改善工作条件。"
                            }
                        }
                    ],
                    "synonyms": [
                        "excitement"
                    ],
                    "common_phrases": [
                        "political agitation",
                        "labor agitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "为实现社会或政治变革而煽动舆论或组织运动的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "鼓动",
                                "target_lang_sense_clarification": "指为了某种目的而煽动群众。"
                            },
                            {
                                "target_lang_word": "煽动",
                                "target_lang_sense_clarification": "指通过言论促使他人采取行动，常含贬义。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1a41a3f9-a85a-3cc3-b27c-42dbb7ca4bfa",
                    "sense_definition": "The process of shaking or stirring a substance to mix it thoroughly.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_motion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Constant <w>agitation</w> of the mixture is required to prevent the ingredients from separating.",
                            "target_lang_translations": {
                                "zh": "需要对混合物进行持续的<w>搅拌</w>，以防止成分分离。"
                            }
                        },
                        {
                            "text": "The chemical reaction was accelerated by the <w>agitation</w> of the solution.",
                            "target_lang_translations": {
                                "zh": "溶液的<w>搅拌</w>加速了化学反应。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "constant agitation"
                    ],
                    "target_lang_definitions": {
                        "zh": "通过摇晃或搅拌使物质充分混合的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "搅拌",
                                "target_lang_sense_clarification": "指为了混合而进行的物理动作。"
                            },
                            {
                                "target_lang_word": "摇匀",
                                "target_lang_sense_clarification": "指通过摇晃使液体或混合物均匀。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f0df31f9-7bba-31bb-a256-0f7c32999e82",
                    "sense_definition": "The act of debating or considering a controversial subject or proposal.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "discussion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The proposal is currently in <w>agitation</w> among the committee members.",
                            "target_lang_translations": {
                                "zh": "该提案目前正在委员会成员中进行<w>讨论</w>。"
                            }
                        },
                        {
                            "text": "A thorough <w>agitation</w> of the matter revealed several hidden problems.",
                            "target_lang_translations": {
                                "zh": "对该事项的彻底<w>审议</w>揭示了几个隐藏的问题。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "对有争议的主题或提议进行辩论或审议的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "讨论",
                                "target_lang_sense_clarification": "指对问题进行深入的探讨。"
                            },
                            {
                                "target_lang_word": "审议",
                                "target_lang_sense_clarification": "指对提案进行正式的讨论和评估。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}