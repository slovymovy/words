                ],
                "senses": [
                    {
                        "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                        "entry_id": "dc038a04-93ff-38c4-acef-aa1fca2073db",
                        "glosses": [
                            "fortlaufendes Siebband in Form einer waagerechten Tischplatte, mit Schutzhaube; Absonderung von Wasser"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6486b89-3282-41f8-ab71-78fe9e3a945c",
                                "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                                "text": "„Um die Flockenbildung zu verbessern, wird der Schlamm anschließend im statischen Mischer, der dem Seihtisch vorgeschaltet ist, vermischt.“"
                            },
                            {
                                "example_id": "c8c04c9d-a804-44fa-88c9-61a12e3e9a74",
                                "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                                "text": "„Über Dosierpumpen gelangt der Schlamm weiter auf den Seihtisch, wo er vorentwässert wird.“"
                            },
                            {
                                "example_id": "316fc5d1-c830-455d-83da-4b82f49ef0cc",
                                "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                                "text": "„Im Seihtisch gelange der Schlamm auf ein Siebband, dadurch kann eine Teil des Abwassers abfliessen durch Umschichtung wird dieser Effekt noch erhöht.“"
                            },
                            {
                                "example_id": "79c1fce4-1442-46da-905e-d9c6719bf14e",
                                "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                                "text": "„Der Überschussschlamm wird in Villach mittels zweier Seihtische maschinell eingedickt; der Primärschlamm wird separat in die Faulung gepumpt.“"
                            },
                            {
                                "example_id": "ed411ec5-0917-4e8f-aa4b-300df1ff9d29",
                                "sense_id": "71bdd123-8066-37c7-be4a-42f0db0de4fe",
                                "text": "„Unter Zugabe von Flockungsmitteln könne in kurzer Zeit auf dem Seihtisch sehr viel Wasser von den Schlammflocken abgetrennt werden: \"Dabei wird der Schlamm problemlos auf sieben Prozent Feststoffgehalt eingedickt. Das heisst, dass durch die Eindickung von dreieinhalb auf sieben Prozent das heutige Schlammvolumen um die Hälfte reduziert werden kann!\"“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
