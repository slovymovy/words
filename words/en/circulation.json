{
    "word_family": [
        "circulate",
        "circulatory",
        "circular",
        "circle"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5a4d4322-560a-3325-8289-dc2318ef7f8b",
                    "sense_definition": "The continuous movement of blood through the body caused by the pumping action of the heart.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "physiology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Regular exercise is known to improve your <w>circulation</w> significantly.",
                            "target_lang_translations": {
                                "ru": "Известно, что регулярные физические упражнения значительно улучшают <w>кровообращение</w>.",
                                "zh": "众所周知，经常锻炼能显著改善你的<w>血液循环</w>。"
                            }
                        },
                        {
                            "text": "He suffers from poor <w>circulation</w>, which makes his hands and feet feel cold.",
                            "target_lang_translations": {
                                "ru": "Он страдает от плохого <w>кровообращения</w>, из-за чего у него мерзнут руки и ноги.",
                                "zh": "他患有<w>血液循环</w>不良，这导致他的手脚总是冰凉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "blood flow"
                    ],
                    "common_phrases": [
                        "poor circulation",
                        "improve circulation",
                        "blood circulation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Непрерывное движение крови по организму, обеспечиваемое насосной функцией сердца.",
                        "zh": "血液在心脏泵血作用下在体内持续流动的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "кровообраще́ние",
                                "target_lang_sense_clarification": "физиологический процесс"
                            },
                            {
                                "target_lang_word": "циркуля́ция",
                                "target_lang_sense_clarification": "движение жидкости в организме"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "血液循环",
                                "target_lang_sense_clarification": "生理学上的血液流动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a14cb3cd-9044-3ebc-b3b7-f7b74dfb9fcd",
                    "sense_definition": "The act of passing something, such as money, information, or goods, from person to person or place to place.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_flow",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The government decided to withdraw the old coins from <w>circulation</w>.",
                            "target_lang_translations": {
                                "ru": "Правительство решило изъять старые монеты из <w>обращения</w>.",
                                "zh": "政府决定将旧硬币从<w>流通</w>中收回。"
                            }
                        },
                        {
                            "text": "Several rumors are currently in <w>circulation</w> regarding the company's future.",
                            "target_lang_translations": {
                                "ru": "Относительно будущего компании сейчас <w>ходят</w> различные слухи.",
                                "zh": "目前关于公司未来的传言正在<w>传播</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distribution",
                        "dissemination",
                        "transmission",
                        "spread"
                    ],
                    "common_phrases": [
                        "in circulation",
                        "out of circulation",
                        "put into circulation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс передачи чего-либо (денег, информации, товаров) от одного лица к другому или распространение в обществе.",
                        "zh": "指货币、信息或商品在人与人或地与地之间传递或流通的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обраще́ние",
                                "target_lang_sense_clarification": "денег, валюты"
                            },
                            {
                                "target_lang_word": "оборо́т",
                                "target_lang_sense_clarification": "товаров, капитала"
                            },
                            {
                                "target_lang_word": "циркуля́ция",
                                "target_lang_sense_clarification": "слухов, информации"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "流通",
                                "target_lang_sense_clarification": "商品或货币的流转"
                            },
                            {
                                "target_lang_word": "传播",
                                "target_lang_sense_clarification": "信息或谣言的扩散"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "802dfb18-f9b6-305a-824d-b66225a8a0f6",
                    "sense_definition": "The number of copies of a newspaper or magazine sold or distributed over a specific period.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "publishing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The magazine has a daily <w>circulation</w> of over one million copies.",
                            "target_lang_translations": {
                                "ru": "Ежедневный <w>тираж</w> журнала составляет более миллиона экземпляров.",
                                "zh": "该杂志的日<w>发行量</w>超过一百万份。"
                            }
                        },
                        {
                            "text": "Despite the rise of digital media, the paper maintained a steady <w>circulation</w>.",
                            "target_lang_translations": {
                                "ru": "Несмотря на рост цифровых СМИ, газета сохранила стабильный <w>тираж</w>.",
                                "zh": "尽管数字媒体兴起，该报纸仍保持了稳定的<w>发行量</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "readership",
                        "sales"
                    ],
                    "common_phrases": [
                        "daily circulation",
                        "wide circulation",
                        "mass circulation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Количество экземпляров печатного издания (газеты или журнала), проданных или распространенных за определенный период.",
                        "zh": "报纸或杂志在特定时期内售出或发行的份数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тира́ж",
                                "target_lang_sense_clarification": "печатного издания"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "发行量",
                                "target_lang_sense_clarification": "出版物的销售或分发数量"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fdb245fe-ba2c-33c4-8d5e-fae68c7ef42c",
                    "sense_definition": "The movement of air, water, or other fluids within a closed area or system.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mechanics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fan was installed to improve air <w>circulation</w> in the stuffy room.",
                            "target_lang_translations": {
                                "ru": "Вентилятор установили, чтобы улучшить <w>циркуляцию</w> воздуха в душной комнате.",
                                "zh": "安装风扇是为了改善闷热房间内的空气<w>流通</w>。"
                            }
                        },
                        {
                            "text": "Proper water <w>circulation</w> is essential for keeping the aquarium clean.",
                            "target_lang_translations": {
                                "ru": "Правильная <w>циркуляция</w> воды необходима для поддержания чистоты в аквариуме.",
                                "zh": "良好的水<w>循环</w>对于保持鱼缸清洁至关重要。"
                            }
                        }
                    ],
                    "synonyms": [
                        "flow",
                        "current",
                        "motion"
                    ],
                    "antonyms": [
                        "stagnation"
                    ],
                    "common_phrases": [
                        "air circulation",
                        "water circulation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Движение воздуха, воды или других жидкостей внутри замкнутого пространства или системы.",
                        "zh": "空气、水或其他流体在封闭区域或系统内的运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "циркуля́ция",
                                "target_lang_sense_clarification": "воздуха, воды"
                            },
                            {
                                "target_lang_word": "круговоро́т",
                                "target_lang_sense_clarification": "природный цикл"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "循环",
                                "target_lang_sense_clarification": "流体在系统内的运动"
                            },
                            {
                                "target_lang_word": "流通",
                                "target_lang_sense_clarification": "空气的流动"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}