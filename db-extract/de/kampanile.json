                "senses": [
                    {
                        "sense_id": "55d1266a-3152-382c-ac6c-29d82a687dd5",
                        "entry_id": "d8dfa7fe-bfa3-33c6-b2c9-8c804bf954e4",
                        "glosses": [
                            "frei stehender Glockenturm"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5af75745-4f71-419b-bcac-7a3f50984aa9",
                                "sense_id": "55d1266a-3152-382c-ac6c-29d82a687dd5",
                                "text": "Der Kampanile ist typisch für die mittelalterliche Baukunst Italiens."
                            },
                            {
                                "example_id": "b8ba4a23-9030-44bb-b688-f5f9b59f4b22",
                                "sense_id": "55d1266a-3152-382c-ac6c-29d82a687dd5",
                                "text": "„Ich ließ mich von dem Mann auf dem Kampanile nicht zweimal einladen und begab mich sofort zum Gottesdienst in die Moschee.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8e0b8d0e-2aa1-4ec6-ae47-6ef447d2174d",
                        "source_entry_id": "d8dfa7fe-bfa3-33c6-b2c9-8c804bf954e4",
                        "source_sense_id": "55d1266a-3152-382c-ac6c-29d82a687dd5",
                        "source_sense_description": "Architektur: frei stehender Glockenturm",
                        "target_lang_word": "campanile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campanile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1de1c9bd-ec1a-35aa-9c43-614baac0fa46",
                                        "entry_id": "0e87a160-abc9-3e06-b7ba-0f6df3119394",
                                        "glosses": [
                                            "A bell tower (especially one that is freestanding), often associated with a church or other public building, especially in Italy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e3ef63-ff86-442b-bf6b-037623905699",
                                                "sense_id": "1de1c9bd-ec1a-35aa-9c43-614baac0fa46",
                                                "text": "The Leaning Tower of Pisa is a campanile."
                                            },
                                            {
                                                "example_id": "21d26de7-8055-4178-ac2c-a97e23774e48",
                                                "sense_id": "1de1c9bd-ec1a-35aa-9c43-614baac0fa46",
                                                "text": "There was no doubt as to the direction, with the campanile of the duomo as a beacon. For a quarter of a mile the road is straight and narrow; then it broadens into an open space and Castel Franco appears."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "60d7fce7-ed47-4ff4-88b5-1baad588ed0a",
                        "source_entry_id": "d8dfa7fe-bfa3-33c6-b2c9-8c804bf954e4",
                        "source_sense_id": "55d1266a-3152-382c-ac6c-29d82a687dd5",
                        "source_sense_description": "Architektur: frei stehender Glockenturm",
                        "target_lang_word": "campanile",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "campanile",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                                        "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                                        "glosses": [
                                            "Clocher à jour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0388bec7-9468-4ce6-8aff-0b911991cf1a",
                                                "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                                                "text": "Il découvrirait un campanile de tuiles rongées par la mousse, douze maisonnettes éparses, entourées de leurs vergers et de leurs chenevières."
                                            },
                                            {
                                                "example_id": "b55d5fa0-182c-41f4-8ab6-cfe26bf18cbf",
                                                "sense_id": "dc3ff776-3bbe-3ae0-b8a4-649c6162eb4f",
                                                "text": "Les campaniles de sa vieille cathédrale s’élancent dans les airs, où ils se confondaient alors avec les créations fantastiques de quelques nuages blanchâtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                                        "entry_id": "51dadafd-1d84-30f0-8f0a-796f056b3a62",
                                        "glosses": [
                                            "Tour ouverte, haute et généralement isolée, dans laquelle sont suspendues des cloches."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6ffdda44-6eb3-4f6d-84e7-05f0b0de6700",
                                                "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                                                "text": "Le campanile de la cathédrale Notre-Dame de l’Assomption de Pise, plus connu sous le nom de Tour penchée de Pise, a cessé de s’affaisser doucement, et s’est même redressé d’un soupçon."
                                            },
                                            {
                                                "example_id": "96a03097-3608-4082-a99f-15ef6d5356e0",
                                                "sense_id": "81d4263c-36d7-34da-8882-12646da74bcd",
                                                "text": "Le coup d’envoi est donné par le « vol de l’ange », quand une jeune fille accrochée à un filin s’élance du campanile de la place Saint-Marc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
