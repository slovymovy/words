                "senses": [
                    {
                        "sense_id": "a9efcd52-3dfc-3b07-9d92-cef6307c8895",
                        "entry_id": "2bf503d2-e151-336c-93c5-223256d7a6d6",
                        "glosses": [
                            "Buch über Anatomie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "64a0f869-8b56-4afb-bde7-1c4f3c04f77a",
                                "sense_id": "a9efcd52-3dfc-3b07-9d92-cef6307c8895",
                                "text": "„Ich hatte über meinen Anatomiebüchern gebrütet, mit besonderem Augenmerk auf meine Aufzeichnungen zum Thema Sezieren.“"
                            },
                            {
                                "example_id": "8101070b-8216-48b6-b825-8ea06821e383",
                                "sense_id": "a9efcd52-3dfc-3b07-9d92-cef6307c8895",
                                "text": "„Alle reden über die Moral der Bilder. Die feinen Damen tun es beim Anblick der allerneuesten Hintern in der Zeitschrift und klagen über solche Offenherzigkeit; diejenigen tun es, die mit dem Foto eines Fouls beweisen wollen, dass der Elfmeter berechtigt war; Kinder tun es, wenn sie ein Anatomiebuch aufschlagen, um Missbildungen anzuschauen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
