                                    {
                                        "sense_id": "6581cc21-02a3-3018-9b4a-1d7c2b94ce6f",
                                        "entry_id": "b3ccc3a4-4556-3623-a627-4688eb05bc2e",
                                        "glosses": [
                                            "A circle defined as the intersection of the surface of a sphere and a plane which passes through the centre of the sphere."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d3390ff1-7529-3180-b234-101f2d911c93",
                                        "entry_id": "b3ccc3a4-4556-3623-a627-4688eb05bc2e",
                                        "glosses": [
                                            "A segment of such circle representing the shortest distance between two points on the surface of a sphere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d7eb45e-0a8b-46c5-80d1-ef8e494ad857",
                                                "sense_id": "d3390ff1-7529-3180-b234-101f2d911c93",
                                                "text": "Wherever a navigator may be, it certainly would be to his advantage to be able to find the great circle, or shortest course, and the distance, to his port of destination, [....]"
                                            },
                                            {
                                                "example_id": "be0b623a-790f-4fc6-928e-de93673f47bf",
                                                "sense_id": "d3390ff1-7529-3180-b234-101f2d911c93",
                                                "text": "The shortest distance between two points on an ocean Mercator chart is not a straight line - it is a curve known as a 'great circle'."
                                            },
                                            {
                                                "example_id": "8aa466eb-150a-4441-8403-5375ca3a6540",
                                                "sense_id": "d3390ff1-7529-3180-b234-101f2d911c93",
                                                "text": "Because the Earth's surface is curved, the shortest distance is actually a curve over the surface called a great circle."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
