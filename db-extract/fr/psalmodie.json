        "fr-extract.jsonl": [
            {
                "entry_id": "ee563003-ad6f-33fe-8dc0-555e01fd4081",
                "word": "psalmodie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "f6d50160-9a16-48e6-8a7a-6c8de099590f",
                        "entry_id": "ee563003-ad6f-33fe-8dc0-555e01fd4081",
                        "tags": [
                            "plural"
                        ],
                        "form": "psalmodies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c5c42b4-032c-3346-8895-4c4d1721cc73",
                        "entry_id": "ee563003-ad6f-33fe-8dc0-555e01fd4081",
                        "glosses": [
                            "Manière de chanter ou de réciter, à l’église, les psaumes et le reste de l’office, toujours sur la même note."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59b7f954-1ce5-47b7-9fb8-b4165b629111",
                                "sense_id": "5c5c42b4-032c-3346-8895-4c4d1721cc73",
                                "text": "Les moines du couvent de Hango entouraient le corps en chantant des psalmodies du rite grec, quelquefois harmonieuses, plus souvent monotones."
                            },
                            {
                                "example_id": "8d13c68c-2166-4aeb-a197-e1006cef325f",
                                "sense_id": "5c5c42b4-032c-3346-8895-4c4d1721cc73",
                                "text": "Cette psalmodie parvint aux oreilles d’un petit campement de métis convertis, qui abattaient du bois. […] ils sortirent tout joyeux, s’attendant à un second Avent."
                            }
                        ]
                    },
                    {
                        "sense_id": "1fccedab-f623-3451-8964-f1be86938fa7",
                        "entry_id": "ee563003-ad6f-33fe-8dc0-555e01fd4081",
                        "glosses": [
                            "Manière monotone de déclamer, de débiter des vers ou de la prose."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "a5a0436c-08e8-42c7-9cc4-445e66a3eb87",
                                "sense_id": "1fccedab-f623-3451-8964-f1be86938fa7",
                                "text": "Cela nous valut toute la nuit un concert fantastique de clarinettes, de hautbois, d’orgues, d’accordéons, où l’on voyait, très bien défiler tous les ponts de Paris avec leurs psalmodies différentes…"
                            },
                            {
                                "example_id": "8604b539-6105-4380-b769-f3bb37f66eb9",
                                "sense_id": "1fccedab-f623-3451-8964-f1be86938fa7",
                                "text": "Leur procession par les rues se déroule avec la lenteur habituelle, sa psalmodie sourde, son rite invariable de grimaces, d’oremus et de signes de croix."
                            },
                            {
                                "example_id": "8cf1214e-81e0-4142-851e-a50852f04e1e",
                                "sense_id": "1fccedab-f623-3451-8964-f1be86938fa7",
                                "text": "Les bêtes regagnent en meuglant les étables […] plus loin, la psalmodie d’une chanson traîne dans l’air, comme accrochée au dernier rayon de soleil."
                            },
                            {
                                "example_id": "f315d22c-4517-4b86-89ba-6688bb4f449e",
                                "sense_id": "1fccedab-f623-3451-8964-f1be86938fa7",
                                "text": "Quand elle vint, Heathcliff vint avec elle, et elle insista pour que je le prenne dans la cuisine : l’autre domestique, Joseph, étant allé à Gimmerton pour ne pas entendre le bruit de notre infernale psalmodie, comme il se plaisait à l’appeler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b03d59e6-eace-4b77-93c8-818139ff7b0a",
                        "source_entry_id": "ee563003-ad6f-33fe-8dc0-555e01fd4081",
                        "target_lang_word": "psalmody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "psalmody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                        "entry_id": "444419d3-6717-358a-a353-3a90410016fc",
                                        "glosses": [
                                            "The singing or the writing of psalms."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e7848d28-0659-4e5f-b119-192c7d177481",
                                                "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                                "text": "They deserved the enmity of the Pagans; and some of them might deserve the reproaches of avarice and intemperance; of avarice, which they gratified with holy plunder, and of intemperance, which they indulged at the expense of the people, who foolishly admired their tattered garments, loud psalmody, and artificial paleness."
                                            },
                                            {
                                                "example_id": "a9b0db52-d569-4b5a-8711-b10886cbc46d",
                                                "sense_id": "58016044-9b38-373f-9ede-3d81824bb9bf",
                                                "text": "All these strange antics were accompanied by still stranger guttural noises from the devotee, who seemed to be praying in a sing-song or else singing some pagan psalmody or other, during which his face twitched about in the most unnatural manner."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "eb37c1dc-e2cb-33b5-a0f2-3e70ffd29201",
                                        "entry_id": "444419d3-6717-358a-a353-3a90410016fc",
                                        "glosses": [
                                            "A collection of psalms."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "psalmody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c9dd46d9-72b9-3f53-b348-e3e6ccf84be1",
                                        "entry_id": "4307959e-f274-3bf3-a7e1-7f5dcb757a93",
                                        "glosses": [
                                            "To celebrate in psalms."
