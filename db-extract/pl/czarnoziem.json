                "senses": [
                    {
                        "sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                        "entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                        "glosses": [
                            "bardzo żyzna gleba wykształcona na lessach"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "17c83b14-880d-4840-bb8d-0fb916beff21",
                                "sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
                                "text": "Czarnoziemy są silnie próchnicznymi glebami, wytworzonymi na lessach przy udziale roślinności stepowej."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a0da312-f82f-4b83-8e28-8c5f0a6838f2",
                        "source_entry_id": "de4fe2d7-fefb-3115-8b6a-2d019e7ac4fd",
                        "source_sense_id": "216a389c-ff96-3c71-bb9a-0b2c0f15cb43",
