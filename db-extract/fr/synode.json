                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3f26169e-9dcc-4b00-aa5d-f17f269cc458",
                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "tags": [
                            "plural"
                        ],
                        "form": "synodes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "145db9ef-3ad3-388d-9c94-183d1ebb6b52",
                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "glosses": [
                            "Assemblée ecclésiastique."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "glosses": [
                            "Assemblée ecclésiastique.",
                            "Assemblée d'ecclésiastiques catholiques, qui se fait dans chaque diocèse par le mandement de l’évêque ou d’un autre supérieur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d457ec1c-6656-4e3d-a2da-ed7ba36f277a",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "Tenir un synode."
                            },
                            {
                                "example_id": "3251f4ee-bf87-4b05-93d7-c841043315c5",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "On a même organisé des synodes d’évêques, vers le VIIIᵉ siècle pour délibérer de cette question."
                            },
                            {
                                "example_id": "76f5ad83-4eed-4144-b2ed-69a5541d11a5",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "L'étymologie du terme est d'ailleurs suggestive : « synode » vient du grec sun-odos, qui signifie « marcher ensemble », « faire route ensemble ». L'idée est immédiatement présente que l'Église existe grâce à la convergence et à la participation de tous."
                            },
                            {
                                "example_id": "7324143a-118a-4866-aeef-4ba9b041b00f",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "C’est en tout cas ce qu’ont demandé les évêques catholiques réunis à Rome, au dernier jour d’un synode (une assemblée convoquée par le pape) sur l’Amazonie, samedi 26 octobre."
                            },
                            {
                                "example_id": "209d4847-1c55-49b5-a4a2-b19aa3927485",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "Synode diocésain."
                            },
                            {
                                "example_id": "1ed025fa-1ed9-4e6d-b311-10f8f4afb684",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "Aller au synode."
                            },
                            {
                                "example_id": "7b4d8375-ae0f-4bb5-bab8-41e396efd20c",
                                "sense_id": "ebb9b8a6-6e22-3b4b-9795-fd3d593a9ebf",
                                "text": "Convoquer le synode."
                            }
                        ]
                    },
                    {
                        "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "glosses": [
                            "Assemblée ecclésiastique.",
                            "Assemblée représentative de laïcs et ministres du culte protestants."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "503fdc12-dcf3-4e19-97ad-d2abd3d73db9",
                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                "text": "Synode national, général."
                            },
                            {
                                "example_id": "c69ddd96-b2ac-4611-991e-1c0910168039",
                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                "text": "Synode provincial."
                            },
                            {
                                "example_id": "19439489-3c12-4c9f-badc-a84165d08f4b",
                                "sense_id": "3738487f-5d7b-35a4-bfce-d63158b067e4",
                                "text": "Le synode de Dordrecht."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc9dafe8-f2b6-35ba-af79-f7ca65a45085",
                        "entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "glosses": [
                            "Assemblée ecclésiastique.",
                            "Assemblée de croyants juifs, aussi dite grande Synagogue."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "0cc0e516-50e6-4c73-8209-72991e2bac61",
                                "sense_id": "cc9dafe8-f2b6-35ba-af79-f7ca65a45085",
                                "text": "Le Grand Synode (…) qui rappelait le Conseil des Anciens de Moïse (…) se composait de 120 membres (…). Ceux qui en faisaient partie n'étaient pas des prêtres, mais des savants et des sages."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7bd3a875-bea5-403b-95ee-c08262d846dd",
                        "source_entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "source_sense_description": "réunion de membres du clergé",
                        "target_lang_word": "Synode",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Synode",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "250acd30-328c-3bb2-874e-566617247ec5",
                                        "entry_id": "f62122f8-3542-3283-9fa3-936cd6335727",
                                        "glosses": [
                                            "gesetzgebende Versammlung, bei der theologische und rechtliche Fragen geklärt werden sollen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a22a27a8-6d19-434e-b3e5-985003aec115",
                                                "sense_id": "250acd30-328c-3bb2-874e-566617247ec5",
                                                "text": "Die Synode von Sis besiegelte 1307 die Vereinigung der armenischen mit der römisch-katholischen Kirche."
                                            },
                                            {
                                                "example_id": "1151496a-c60f-4596-8ce9-432a7ba02672",
                                                "sense_id": "250acd30-328c-3bb2-874e-566617247ec5",
                                                "text": "„Der Assessor sagte, daß er gewißlich wohl vertraut sei mit Pastor Sigurdurs Vorschlag, der oftmals bei Synoden wie auf dem Allthing bekanntgegeben, begründet mit tiefgelehrten Auslegungen von der Heiligen Schrift und zweideutigen Gesetzparagraphen, demzufolge Ketzer gefoltert und Hexer verbrannt werden sollten, meinte gleichwohl, daß man aus dem Grunde Pastor Sigurdur nicht minder Höflichkeit schuldig sei.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4717a157-21f5-4805-a094-12b3ada29ae8",
                        "source_entry_id": "c27b442b-86ef-3cf0-ade6-f5d2e6ec9f5c",
                        "source_sense_description": "réunion de membres du clergé",
                        "target_lang_word": "synod",
