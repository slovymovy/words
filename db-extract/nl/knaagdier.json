                        "entry_id": "566fc43f-e00a-3bea-87ba-513d5b1418d5",
                        "glosses": [
                            "benaming voor dieren uit de orde Rodentia, vrij kleine zoogdieren met twee paar op beitels lijkende en steeds aangroeiende snijtanden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f4e81806-f3ed-4a17-be12-d79e1f731563",
                                "sense_id": "6557d216-fde6-3db9-b264-0a1ac25d438d",
                                "text": "Om de Rotterdammers een handje te helpen, is een projector naast de vuilnisbakken geplaatst. Die projecteert beelden van een levensgrote rat bij de container. De projectie van het knaagdier wordt afgewisseld met de tekst: \"Voorkom ratten.\""
                            }
                        ]
                    }
