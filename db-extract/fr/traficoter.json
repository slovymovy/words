                ],
                "senses": [
                    {
                        "sense_id": "fc053d2a-f292-3fc4-ae47-d3fbf76cc58c",
                        "entry_id": "71eaadb9-0fa3-3f43-85e6-40e3762cdef1",
                        "glosses": [
                            "Bricoler, bidouiller, trafiquer."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "f0569a58-ccc8-48b9-9122-28c9afe69fc8",
                                "sense_id": "fc053d2a-f292-3fc4-ae47-d3fbf76cc58c",
                                "text": "Ça vous prend un fauteuil tout neuf qui vaut bien trente-cinq francs, crac ! ... ça le traficote, ça le casse, ça flanque du plomb de chasse dedans et ça en fait un fauteuil tout vieux qui vaut bien cent cinquante francs."
                            },
                            {
                                "example_id": "8e749626-42b6-4490-aaa8-342e78d041a1",
                                "sense_id": "fc053d2a-f292-3fc4-ae47-d3fbf76cc58c",
                                "text": "27 juin 43 – Un pâtissier en chambre, M. Thomassot, vient à domicile nous traficoter de ravissants petits gâteaux qui attendent d’être pomponnés et pommadés au dernier moment."
                            },
                            {
                                "example_id": "3e848a4b-1c02-4ca1-adc3-c1745e920b8a",
                                "sense_id": "fc053d2a-f292-3fc4-ae47-d3fbf76cc58c",
                                "text": "Je les vis préparer un piège que j'ai du mal à décrire ici. C'était, si je m'en souviens bien, un récipient en aluminium qu'ils avaient traficoté."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "37b7cb9b-d006-49e4-9290-92cd9671173f",
                        "source_entry_id": "71eaadb9-0fa3-3f43-85e6-40e3762cdef1",
                        "source_sense_id": "fc053d2a-f292-3fc4-ae47-d3fbf76cc58c",
                        "target_lang_word": "knoeien",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "knoeien",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2f3f3242-2bb1-3f2b-bd61-88f20c8f4fc5",
                                        "entry_id": "e883214b-18fe-327c-996d-ed9b7d44e7d4",
                                        "glosses": [
                                            "slecht of slordig werk leveren"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "95faa2cd-f9c1-4c18-9d28-b83be61f7ab9",
                                                "sense_id": "2f3f3242-2bb1-3f2b-bd61-88f20c8f4fc5",
                                                "text": "De kinderen knoeiden lekker in de modder en hun moeder was blij dat ze oude kleren aanhadden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df8b6e66-6506-37fd-a96d-a3fcaba1df9c",
                                        "entry_id": "e883214b-18fe-327c-996d-ed9b7d44e7d4",
                                        "glosses": [
                                            "aan/in elkaar ~ iets slordig vervaardigen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c0e94793-e404-425e-bb2b-4e8cb16684c7",
                                                "sense_id": "df8b6e66-6506-37fd-a96d-a3fcaba1df9c",
                                                "text": "Ze hadden de verwarmingsbuis echt aan elkaar geknoeid."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "668c28ca-592c-3f59-abe3-c446b94bd820",
                                        "entry_id": "e883214b-18fe-327c-996d-ed9b7d44e7d4",
                                        "glosses": [
                                            "onjuist of onwettig omgaan met gelden of de boekhouding ervan"
                                        ],
                                        "tags": [
                                            "unergative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4c20c233-cdf6-4eb7-9d52-8226aa37e28c",
                                                "sense_id": "668c28ca-592c-3f59-abe3-c446b94bd820",
                                                "text": "Er was geknoeid met de begroting van de gemeente en iemand was er met veel geld vandoor."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
