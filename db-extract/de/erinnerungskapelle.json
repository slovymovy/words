                "senses": [
                    {
                        "sense_id": "2122eb28-74e3-3f17-84aa-b3f66e5e4858",
                        "entry_id": "501d4563-5eae-320e-bf1a-a6617e519417",
                        "glosses": [
                            "im kirchlichen Stil gestaltete, kleine Kapelle, die für Andachten gegen das Vergessen von etwas erbaut wurde und auch für Gottesdienste genutzt werden kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c3ad2b0a-8c10-492b-9036-28e8ce5dedf0",
                                "sense_id": "2122eb28-74e3-3f17-84aa-b3f66e5e4858",
                                "text": "„Eine weitere Sehenswürdigkeit ist die Bauernkapelle, eine Erinnerungskapelle an die im Bauernkrieg 1525 erschlagenen Bauern aus der Region.“"
                            },
                            {
                                "example_id": "c67c4969-e4f2-4d9c-81a0-7625f7ab3afc",
                                "sense_id": "2122eb28-74e3-3f17-84aa-b3f66e5e4858",
                                "text": "„Geplant als Erinnerungskapelle an Weggefährten von Dr. Heinrich Klier, direkt an der Gratscheide im Bereich des Schaufeljochs gelegen, markiert ein auf die Grundelemente einer klassischen Kapelle reduzierter Baukörper aus rauem Beton und Stahl einen Ort der Ruhe, Kontemplation und Erinnerung inmitten des lebhaften Skizirkus.“"
                            },
                            {
                                "example_id": "df98e55d-4bea-43a1-a822-f32b7ce0c45e",
                                "sense_id": "2122eb28-74e3-3f17-84aa-b3f66e5e4858",
                                "text": "„Die Erinnerungskapelle für die Opfer des Fluges Air-France 447 sollte nicht als „touristische Attraktion“ und attraktive Einnahmequelle für interessierte Gemeinden missbraucht werden.“"
                            },
                            {
                                "example_id": "821ef7af-ac4d-4966-8e04-2d6ad66bc528",
                                "sense_id": "2122eb28-74e3-3f17-84aa-b3f66e5e4858",
                                "text": "„Im 350. Erinnerungsjahr nach der Teilung der Freigrafschaft Düdinghausen im Jahre 1663 nimmt der Veranstaltungsreigen nach der feierlichen Eröffnung der Wanderausstellung „Alte Grenzen, die uns verbinden“ in Titmaringhausen, dem Düdinghäuser Schnadegang, den geschichtlichen Angeboten auf dem Dorffest in Referinghausen und der Einweihung der Erinnerungskapelle an die Simultankirche in Eppe nun weiter Fahrt auf.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
