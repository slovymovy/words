{
    "word_family": [
        "gloweringly"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8edf7207-d8f3-3122-a1e7-ec6c0bd4d45f",
                    "sense_definition": "To look or stare with anger or annoyance.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angry_stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The angry customer continued to <w>glower</w> at the manager while waiting for a refund.",
                            "target_lang_translations": {
                                "cs": "Rozzlobený zákazník při čekání na vrácení peněz dál na manažera <w>zlostně zíral</w>."
                            }
                        },
                        {
                            "text": "He <w>glowered</w> at his brother after their heated argument about the broken vase.",
                            "target_lang_translations": {
                                "cs": "Po ostré hádce o rozbitou vázu na svého bratra <w>zlostně hleděl</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "glare",
                        "scowl",
                        "lour"
                    ],
                    "common_phrases": [
                        "glower at"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dívat se nebo zírat s hněvem či rozhořčením."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zlostně zírat",
                                "target_lang_sense_clarification": "vyjádření hněvu pohledem"
                            },
                            {
                                "target_lang_word": "mračit se",
                                "target_lang_sense_clarification": "vyjádření nevole nebo hněvu"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d60ce0a8-1fc1-39a3-8029-9969fb7f0551",
                    "sense_definition": "An angry or sullen look.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "angry_stare",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She gave him a dark <w>glower</w> before turning away in silence.",
                            "target_lang_translations": {
                                "cs": "Věnovala mu temný <w>zlostný pohled</w>, než se mlčky odvrátila."
                            }
                        },
                        {
                            "text": "The teacher noticed the <w>glowers</w> exchanged between the two students during the test.",
                            "target_lang_translations": {
                                "cs": "Učitel si všiml <w>zlostných pohledů</w>, které si během testu vyměnili dva studenti."
                            }
                        }
                    ],
                    "synonyms": [
                        "glare",
                        "scowl"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zlostný nebo zamračený pohled."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "zlostný pohled",
                                "target_lang_sense_clarification": "výraz tváře vyjadřující hněv"
                            },
                            {
                                "target_lang_word": "zamračení",
                                "target_lang_sense_clarification": "výraz nevole"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ef6c44e2-ca02-3ec0-ae41-a48c3c1363b0",
                    "sense_definition": "A device that emits light when heated.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory equipment utilized a Nernst <w>glower</w> as a stable infrared light source.",
                            "target_lang_translations": {
                                "cs": "Laboratorní vybavení využívalo Nernstovo <w>žhavicí tělísko</w> jako stabilní zdroj infračerveného světla."
                            }
                        },
                        {
                            "text": "Engineers tested the efficiency of the <w>glower</w> under extreme temperature conditions.",
                            "target_lang_translations": {
                                "cs": "Inženýři testovali účinnost <w>žhavicího tělíska</w> v podmínkách extrémních teplot."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Zařízení, které vyzařuje světlo při zahřátí."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "žhavicí tělísko",
                                "target_lang_sense_clarification": "technický prvek vyzařující světlo"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}