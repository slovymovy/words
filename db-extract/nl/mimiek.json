                                            {
                                                "example_id": "4ef56220-21ca-4805-bfa6-b55835363eef",
                                                "sense_id": "328cbe23-efed-3508-bc6f-3302d26f7f74",
                                                "text": "Il attendait, près du portant de gauche, le moment de se diriger du pas d’un homme qui rêve dans la direction de Jimmy, son partenaire, dont la mimique exprimait aussitôt une singulière jubilation."
                                            },
                                            {
                                                "example_id": "556b2e46-0e18-4f1c-bdc5-0983131b8e6f",
                                                "sense_id": "328cbe23-efed-3508-bc6f-3302d26f7f74",
                                                "text": "La surexcitation de Bert s’aggravait. Il se leva, faisant avec ses doigts une mimique simiesque."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7f47a7bf-3bb1-33aa-bdb3-4bc2c2de494e",
                                        "entry_id": "2ae78d78-5361-3c7b-9129-c667b9d0a63f",
                                        "glosses": [
                                            "Gestes expressifs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2ca297f-2acf-4b95-83f8-5bb238c0953a",
                                                "sense_id": "7f47a7bf-3bb1-33aa-bdb3-4bc2c2de494e",
                                                "text": "La baronne, pour ne pas répondre, affecta de n’avoir pas entendu, pendant que Dutheil, qui paraissait très renseigné, continuait à s’égayer sur la princesse et sur la matinée qu’elle donnait, où elle devait produire des danseuses espagnoles, d’une mimique si lascive, que tout Paris, averti, allait s’écraser chez elle."
                                            },
                                            {
                                                "example_id": "9a162640-24f8-40f9-a3dc-ea117abfdf24",
                                                "sense_id": "7f47a7bf-3bb1-33aa-bdb3-4bc2c2de494e",
                                                "text": "Il ne montrait à aucun degré les facultés transcendantes que son père déployait dans la mimique et la déclamation."
                                            },
                                            {
                                                "example_id": "70f1a2bd-3666-4632-970f-245c86885bf1",
                                                "sense_id": "7f47a7bf-3bb1-33aa-bdb3-4bc2c2de494e",
                                                "text": "Et il se mit à singer le papotage d’une Parisienne, et jusqu’à la mimique, avec tant de gaieté que Zaheira ne put s’empêcher de rire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
