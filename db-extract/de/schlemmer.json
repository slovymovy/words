                            {
                                "example_id": "58b9df01-1600-41d5-bd15-79b75ca41281",
                                "sense_id": "2d44b123-fe0f-30a2-a592-146d7523c0c0",
                                "text": "„Er war ein schöner Mann, ein Feinschmecker und Schlemmer und sehr geistreich.“"
                            }
                        ],
