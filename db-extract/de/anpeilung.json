                ],
                "senses": [
                    {
                        "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                        "entry_id": "06901c6b-a6f9-371f-a8f0-9faf2bc11bc1",
                        "glosses": [
                            "Vorgang, mittels Funk, Kompass oder Ähnliches Lage und Entfernung von etwas zu ermitteln"
                        ],
                        "tags": [
                            "Schifffahrt",
                            "Flugwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "f1e366f0-85b1-4aa6-837d-cb03af5c7cfb",
                                "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                                "text": "„Aber sobald dieser seinen Sender noch einmal in Betrieb nahm, konnte eine exaktere Anpeilung erfolgen.“"
                            },
                            {
                                "example_id": "d5f4ccf1-3f47-421d-9a1c-265bca7722ef",
                                "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                                "text": "„Ebenfalls an Bord dieser Ju 88 befand sich das den Alliierten bisher unbekannte FuG 227 Flensburg zur Anpeilung von Emissionen des in britischen Bombern installierten Monica-Radars.“"
                            },
                            {
                                "example_id": "10668d75-a47a-4dd0-8de3-0ee1108f422f",
                                "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                                "text": "„Räumliche Entfernungen spielen nur für die Anpeilung, den Pedokontakt, eine Rolle.“"
                            },
                            {
                                "example_id": "19df60de-8171-4984-af6e-3ebd3bab1d2e",
                                "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                                "text": "„Der Ort ließ sich zwar nicht auf den Meter genau anzeigen, aber auch die ungefähre Anpeilung ließ keinen Zweifel daran, dass er sich nur wenige hundert Meter von seiner Wohnung entfernt aufhielt.“"
                            },
                            {
                                "example_id": "501ce224-df38-470a-8445-c15b5a0723e2",
                                "sense_id": "f1741adb-e6a1-3f30-8383-01235e117d7e",
                                "text": "„Eine exakte Anpeilung des Zielortes war vielversprechender und würde genauer sein, wenn sie senkrecht darüber standen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
