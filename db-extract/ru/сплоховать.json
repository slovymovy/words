                "senses": [
                    {
                        "sense_id": "01ea90e1-a72d-3928-a5ae-0f5cfe59deff",
                        "entry_id": "5d0352f0-6bbd-373b-a996-4117fe332fe8",
                        "glosses": [
                            "разг. допустить ошибку, промах; потерпеть неудачу в чём-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90e112d2-6456-4141-a429-144a0c53ea5d",
                                "sense_id": "01ea90e1-a72d-3928-a5ae-0f5cfe59deff",
                                "text": "Но у самого финиша мы сплоховали: не рассчитали немножко, зашли под бережок, попали в полосу безветрия, заштилели."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "48558b5f-662c-4072-97c2-06aaf709fae2",
                        "source_entry_id": "5d0352f0-6bbd-373b-a996-4117fe332fe8",
                        "source_sense_id": "01ea90e1-a72d-3928-a5ae-0f5cfe59deff",
