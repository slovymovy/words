                    },
                    {
                        "translation_id": "be89aea4-9a86-44d9-9793-15c18125a73a",
                        "source_entry_id": "0f32536a-39a5-347a-9bb9-297fd1061fd4",
                        "target_lang_word": "Mischling",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mischling",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "653d0828-d0e3-3015-8fa9-e4da2cf583d3",
                                        "entry_id": "eee00619-7607-33bb-b09c-43d8bdb572f6",
                                        "glosses": [
                                            "das Ergebnis einer Kreuzung verschiedener Zuchtlinien, Rassen oder Arten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8201a22a-b499-4963-bd3d-ca8da2d8af77",
                                                "sense_id": "653d0828-d0e3-3015-8fa9-e4da2cf583d3",
                                                "text": "Das ist ein Mischling aus Schäferhund und Rottweiler."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0d8ea9a-b60d-3c08-b950-7c9b10f7fc2c",
                                        "entry_id": "eee00619-7607-33bb-b09c-43d8bdb572f6",
                                        "glosses": [
                                            "ein Mensch, dessen Eltern oder Vorfahren zu verschiedenen Bevölkerungsgruppen gehören"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47e063fa-f7d3-44b4-86c2-2fa82e2c908c",
                                                "sense_id": "a0d8ea9a-b60d-3c08-b950-7c9b10f7fc2c",
                                                "text": "„Barack Obama ist schwarz. Nicht extrem dunkel, aber schwarz. Eigentlich aber ist er ein Mischling: die Mutter weiß (wie Schnee, wie er sagt) und aus Kansas, der Vater schwarz (Obama: pechschwarz), ein Kenianer.“"
                                            },
                                            {
                                                "example_id": "e54dba23-9654-4832-b15f-e24381fd38b2",
                                                "sense_id": "a0d8ea9a-b60d-3c08-b950-7c9b10f7fc2c",
                                                "text": "„Die beiden anderen waren der Reedereivertreter John Hartung und sein Begleiter, der Mischling Septimus Goring aus New Orleans.“"
                                            },
                                            {
                                                "example_id": "290e9ca0-ccbf-416a-ae2f-3c87b7f12547",
                                                "sense_id": "a0d8ea9a-b60d-3c08-b950-7c9b10f7fc2c",
                                                "text": "„In der Wissenschaft kennt man die einfache Rassenmischung zwischen Weiß und Schwarz, siehe die Mulatten und Mischlinge der Antillen.“"
                                            },
                                            {
                                                "example_id": "778cc6aa-75f6-48ec-a4c3-39bf2fb4be39",
                                                "sense_id": "a0d8ea9a-b60d-3c08-b950-7c9b10f7fc2c",
                                                "text": "„Nach den neuen Rassegesetzen von Nürnberg galt David Hanf, da Vater und Mutter jüdisch waren, als Volljude, indes die Söhne der Volljüdin Lea Bertini und des Ariers Alf, Kinder einer sogenannten Mischehe, als jüdische Mischlinge Ersten Grades bezeichnet wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7b5ad45-0a07-4d5a-9496-659e4e5bd5a8",
                        "source_entry_id": "0f32536a-39a5-347a-9bb9-297fd1061fd4",
                        "target_lang_word": "Kreuzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kreuzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                        "entry_id": "97cdb915-f65e-30b4-870c-463dc9f4740a",
                                        "glosses": [
                                            "Stelle, wo sich zwei oder mehrere Straßen treffen"
                                        ],
                                        "tags": [
                                            "Verkehrsinfrastruktur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2f105bc-12f8-4f9b-998f-5aefdf9bfe1a",
                                                "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                                "text": "„Siavasch schaute zu mir rüber und übersah dabei die vierköpfige Familie, die auf einem Motorrad auf die Kreuzung zusteuerte.“"
                                            },
                                            {
                                                "example_id": "be189a8d-7802-45df-9245-91ad178a067f",
                                                "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                                "text": "Der Straßenbelag der Kreuzung wurde erneuert."
                                            },
                                            {
                                                "example_id": "ddff91ff-3eb7-4fdf-a44a-182087767270",
                                                "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                                "text": "„Auf einer Farm erzählt man mir, dass Berlin ganz in der Nähe an einer Kreuzung lag.“"
                                            },
                                            {
                                                "example_id": "1f4450a4-b571-4d6b-8ed5-e524e125dd81",
                                                "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                                "text": "„An der nächsten Kreuzung hätte ich ihn fast verloren, aber ich quetschte mich noch durch, als die Ampel schon auf Rot sprang.“"
                                            },
                                            {
                                                "example_id": "4f71b4c7-f962-4c2f-8508-58a97e5cf989",
                                                "sense_id": "e83b0c73-36db-3c70-823e-cd6b1e8d6d19",
                                                "text": "„In der Küstenstadt stand Sabina an einer Kreuzung und wartete darauf, daß die Lichter grün wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "9fae9b0f-c08b-3c43-ba7f-9fdd3c1475da",
                                        "entry_id": "97cdb915-f65e-30b4-870c-463dc9f4740a",
                                        "glosses": [
                                            "das Kreuzen, Paaren bei Pflanzen oder Tieren"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84feaec5-8960-499a-8ede-a49011b0df1a",
                                                "sense_id": "9fae9b0f-c08b-3c43-ba7f-9fdd3c1475da",
                                                "text": "Die Kreuzung zwischen einem Elefanten und einem Zebra ist nicht möglich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "8bbabb55-5216-34cd-8801-f35393de044c",
                                        "entry_id": "97cdb915-f65e-30b4-870c-463dc9f4740a",
                                        "glosses": [
                                            "züchterisches Ergebnis des Kreuzens"
                                        ],
                                        "tags": [
                                            "Genetik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "83555813-fa6c-4c63-bc0b-7659a804f48b",
                                                "sense_id": "8bbabb55-5216-34cd-8801-f35393de044c",
                                                "text": "Ein Maultier ist eine Kreuzung zwischen Esel und Pferd."
                                            },
                                            {
                                                "example_id": "d33f512f-ee84-490e-b2ba-9ea8afabe3ce",
                                                "sense_id": "8bbabb55-5216-34cd-8801-f35393de044c",
                                                "text": "„Der Winzer war braungebrannt und jung und sah aus wie eine widernatürliche Kreuzung zwischen Adonis uns Apoll.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
