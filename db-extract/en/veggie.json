    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
                "word": "veggie",
                "pos": "adj",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "85eddb3d-ca5d-43f4-8c4c-33a2e45912ba",
                        "entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more veggie"
                    },
                    {
                        "form_id": "9e325fbd-75aa-4eec-b0f1-cc57ca048a25",
                        "entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most veggie"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "faa11d01-600c-3ea8-b3f3-d7c6af27bd23",
                        "entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
                        "glosses": [
                            "Vegetarian; suitable for vegetarians; without meat."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "d0d74ada-9288-4aae-b1bb-7f3bbff19fe4",
                                "sense_id": "faa11d01-600c-3ea8-b3f3-d7c6af27bd23",
                                "text": "One place was too crowded last time, another too expensive, a third she liked but he thought too \"veggie.\""
                            },
                            {
                                "example_id": "9c087a93-d2eb-43b8-810d-0784601d7f27",
                                "sense_id": "faa11d01-600c-3ea8-b3f3-d7c6af27bd23",
                                "text": "Diet for a Small Planet was also popular at the time, but it was a little too 'veggie,' a little too new for some people."
                            },
                            {
                                "example_id": "5a9cd716-2531-4ec5-aee3-72c48a5a67ae",
                                "sense_id": "faa11d01-600c-3ea8-b3f3-d7c6af27bd23",
                                "text": "The main courses are heavy on beans and may be too veggie for the typical meat eater to swallow but side dishes are less exotic and just as healthy ..."
                            },
                            {
                                "example_id": "f786b65c-456a-432c-b84b-d2651309ddbd",
                                "sense_id": "faa11d01-600c-3ea8-b3f3-d7c6af27bd23",
                                "text": "Steven Beeson of Milwaukee won a blue ribbon with this very veggie entree"
                            }
                        ]
                    },
                    {
                        "sense_id": "d4f1da71-b9b5-3a12-be2b-6af030dab47e",
                        "entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
                        "glosses": [
                            "Vegetable-like, vegetal"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8ddcc40a-e7f6-4ba7-8a54-5f28624124d3",
                                "sense_id": "d4f1da71-b9b5-3a12-be2b-6af030dab47e",
                                "text": "So we actually proved that the old folklore about a dense canopy leading to very veggie wines was true, Noble said."
                            },
                            {
                                "example_id": "a0701e80-6a79-4738-8fc2-ccf8fa54ff4b",
                                "sense_id": "d4f1da71-b9b5-3a12-be2b-6af030dab47e",
                                "text": "They're neither too sweet nor too veggie, but like the other bars, have more calories than a bucket of broccoli."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a3eefa2-cc1d-4d05-b9ad-0d2587d2bceb",
                        "source_entry_id": "c854c4b4-9a41-31ac-9ddc-360a446a0fd0",
