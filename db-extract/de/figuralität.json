                ],
                "senses": [
                    {
                        "sense_id": "f492fade-789c-3727-9f57-59f65f1c1f15",
                        "entry_id": "d8c59f85-8f15-3cea-93dd-d61b5955e594",
                        "glosses": [
                            "Eigenschaft, die Form, das Figürliche betreffend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d90be18-35a1-4617-b367-01dd201c8363",
                                "sense_id": "f492fade-789c-3727-9f57-59f65f1c1f15",
                                "text": "„Entscheidend bleibt jedoch, daß die Figur des Heiligen durch das parallelisierte Mauerstück hinter ihr nicht gesteigert, sondern in ihrer Figuralität geradezu beeinträchtigt wird.“"
                            },
                            {
                                "example_id": "4148e192-97e6-47be-977c-d8562d1b6e9b",
                                "sense_id": "f492fade-789c-3727-9f57-59f65f1c1f15",
                                "text": "„Es kann sehr gut sein, daß die Unterscheidung zwischen einer Figuralität der ‚poetischen‘ und einer Figuralität der ‚rhetorischen‘ Figuren unbegründet ist (daß sie wenig mehr besagt, als daß die einen in poetischen und literarischen Texten und Kontexten stehen, und die anderen nicht), schon deshalb, weil es keine ‚poetische‘ Figur gibt, die keine ‚rhetorische‘ Figur ist.“"
                            },
                            {
                                "example_id": "fd366bc6-c18a-40cb-a824-ab03e10a3281",
                                "sense_id": "f492fade-789c-3727-9f57-59f65f1c1f15",
                                "text": "„Der Grund des ›Neuen‹ liegt dabei zumeist in Prozessen der Imagination oder Figuralität – im weitesten Sinne in der Produktivkraft von Bildern, Assoziationen oder Metaphern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
