                        "glosses": [
                            "Caractère de ce qui est agréable, de ce vers quoi on a tendance à revenir ou dont on a tendance à reprendre."
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "8d40f564-990c-4a17-9d67-93684322cd71",
                                "sense_id": "fd468477-d6f1-3cb5-b02b-3dc4645ae09a",
                                "text": "Un air de reviens-y, un goût de reviens-y."
                            },
                            {
                                "example_id": "1100974f-f443-4979-86ec-a8da1f1da12c",
                                "sense_id": "fd468477-d6f1-3cb5-b02b-3dc4645ae09a",
                                "text": "Le bonheur, quoi ! Un machin qui a un arrière-goût de liberté si tu me comprends, personne sur ton dos et une récompense. Un arrière-goût de reviens-y."
                            }
                        ]
                    }
