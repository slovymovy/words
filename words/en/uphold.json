{
    "word_family": [
        "upholder",
        "upholding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81b54cfe-77d7-3b79-a7c7-27e8b11084c0",
                    "sense_definition": "To support, maintain, or defend a law, principle, or decision that has been questioned or challenged.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "support_and_maintain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The supreme court decided to <w>uphold</w> the original ruling after reviewing all the new evidence provided.",
                            "target_lang_translations": {
                                "ru": "Верховный суд решил <w>оставить в силе</w> первоначальное решение после изучения всех представленных новых доказательств."
                            }
                        },
                        {
                            "text": "It is the duty of every police officer to <w>uphold</w> the law and protect the citizens of this city.",
                            "target_lang_translations": {
                                "ru": "Обязанность каждого полицейского — <w>соблюдать</w> закон и защищать жителей этого города."
                            }
                        }
                    ],
                    "synonyms": [
                        "vindicate"
                    ],
                    "antonyms": [
                        "overturn",
                        "repeal",
                        "violate"
                    ],
                    "common_phrases": [
                        "uphold the law",
                        "uphold a decision",
                        "uphold a tradition",
                        "uphold the constitution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Поддерживать, сохранять или защищать закон, принцип или решение, которые были поставлены под сомнение или оспорены."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "закон, решение или принцип"
                            },
                            {
                                "target_lang_word": "соблюдать",
                                "target_lang_sense_clarification": "закон или правила"
                            },
                            {
                                "target_lang_word": "отстаивать",
                                "target_lang_sense_clarification": "права или интересы"
                            },
                            {
                                "target_lang_word": "оставлять в силе",
                                "target_lang_sense_clarification": "судебное решение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f65a35f5-3ec8-3f83-849d-cf6a21935bf1",
                    "sense_definition": "To keep something in an upright position or prevent it from falling; to provide physical or moral support.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "support_and_maintain",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The strong pillars <w>uphold</w> the weight of the massive cathedral ceiling.",
                            "target_lang_translations": {
                                "ru": "Прочные колонны <w>поддерживают</w> вес массивного потолка собора."
                            }
                        },
                        {
                            "text": "Even in times of great personal tragedy, his deep faith helped <w>uphold</w> him through the darkest days.",
                            "target_lang_translations": {
                                "ru": "Даже во времена великой личной трагедии глубокая вера помогала <w>поддерживать</w> его в самые темные дни."
                            }
                        }
                    ],
                    "antonyms": [
                        "abandon",
                        "drop"
                    ],
                    "common_phrases": [
                        "uphold the weight"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать что-либо в вертикальном положении или предотвращать падение; оказывать физическую или моральную поддержку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поддерживать",
                                "target_lang_sense_clarification": "физически или морально"
                            },
                            {
                                "target_lang_word": "подпирать",
                                "target_lang_sense_clarification": "физически снизу"
                            },
                            {
                                "target_lang_word": "оказывать поддержку",
                                "target_lang_sense_clarification": "в трудную минуту"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7690f31-783a-38a8-9f1f-bb7e0d0bd3ce",
                    "sense_definition": "To lift something up high or to elevate it physically.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "physical_elevation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest began to <w>uphold</w> the sacred relic so that everyone in the back of the crowd could see it.",
                            "target_lang_translations": {
                                "ru": "Священник начал <w>поднимать</w> священную реликвию, чтобы все в задних рядах толпы могли ее видеть."
                            }
                        },
                        {
                            "text": "With hands <w>upheld</w> toward the sky, the villagers prayed for the rain to finally come.",
                            "target_lang_translations": {
                                "ru": "С <w>воздетыми</w> к небу руками жители деревни молились о том, чтобы наконец пошел дождь."
                            }
                        }
                    ],
                    "antonyms": [
                        "lower"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This physical sense of lifting is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Высоко поднимать или возносить что-либо физически (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "поднимать",
                                "target_lang_sense_clarification": "высоко вверх"
                            },
                            {
                                "target_lang_word": "возносить",
                                "target_lang_sense_clarification": "к небу или вверх"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "0ed3651e-ad42-3855-8513-9619107a4dd3",
                    "sense_definition": "A <w>surname</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local archives contain several records of the <w>Uphold</w> family living in this county during the nineteenth century.",
                            "target_lang_translations": {
                                "ru": "В местных архивах сохранилось несколько записей о семье <w>Апхолд</w>, жившей в этом округе в девятнадцатом веке."
                            }
                        },
                        {
                            "text": "Mr. <w>Uphold</w> was appointed as the new head of the historical society last Tuesday.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Апхолд</w> был назначен новым главой исторического общества в прошлый вторник."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "This is a rare English family name."
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Апхолд",
                                "target_lang_sense_clarification": "транслитерация фамилии"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}