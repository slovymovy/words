                    },
                    {
                        "translation_id": "9d7521ea-1c2e-4d78-ab53-2961d5bd0028",
                        "source_entry_id": "b690988e-8375-3205-9202-a429fd60e58a",
                        "source_sense_id": "7cac73aa-e18f-351c-8295-b52717d293af",
                        "target_lang_word": "Performanz",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Performanz",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "eb059f5e-39a8-3a7f-8743-f9a75cfdfc31",
                                        "entry_id": "4b44e8e3-c746-3e89-88a7-33a68d2c26b6",
                                        "glosses": [
                                            "Ausführung, Durchführung (einer Idee), Aufführung (eines Kunstwerks)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f725bf08-66c0-4441-a14b-791b232487d6",
                                                "sense_id": "eb059f5e-39a8-3a7f-8743-f9a75cfdfc31",
                                                "text": "Die Performanz des jungen Künstlers zeugte von mangelnder Erfahrung."
                                            },
                                            {
                                                "example_id": "50214598-7056-47df-bc1d-160478ddd51a",
                                                "sense_id": "eb059f5e-39a8-3a7f-8743-f9a75cfdfc31",
                                                "text": "Die Regeln eines Spiels sind eine Sache, die Performanz (also tatsächliche Durchführung) eine andere."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b13dc76-abf1-3c70-8c4e-ab0cb41acb96",
                                        "entry_id": "4b44e8e3-c746-3e89-88a7-33a68d2c26b6",
                                        "glosses": [
                                            "Leistungsverhalten"
                                        ],
                                        "tags": [
                                            "Ökonomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "014765b7-95b2-481d-9fa5-a35c9adc103a",
                                                "sense_id": "3b13dc76-abf1-3c70-8c4e-ab0cb41acb96",
                                                "text": "Die Performanz des DAX ließ im vierten Quartal zu wünschen übrig."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "84b25d2c-6e24-320f-aa55-5bb1fbc3a824",
                                        "entry_id": "4b44e8e3-c746-3e89-88a7-33a68d2c26b6",
                                        "glosses": [
                                            "konkretes Verhalten eines Individuums"
                                        ],
                                        "tags": [
                                            "Soziologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af4dd191-e77f-47ad-a75b-feb94e025b3f",
                                                "sense_id": "84b25d2c-6e24-320f-aa55-5bb1fbc3a824",
                                                "text": "Ihre Performanz in diesem nicht-verbalen Intelligenztest war durchschnittlich."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "3497c0b7-2d11-3b8e-9296-4985e41146e2",
                                        "entry_id": "4b44e8e3-c746-3e89-88a7-33a68d2c26b6",
                                        "glosses": [
                                            "das Sprechen und Sprachverhalten"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "317236d5-86b9-4112-b639-406414fcb458",
                                                "sense_id": "3497c0b7-2d11-3b8e-9296-4985e41146e2",
                                                "text": "„Für Chomsky kann die Erforschung der Performanz nur in dem Maße Erfolg haben, wie es Einsichten in die zugrunde liegende Kompetenz erlauben.“"
                                            },
                                            {
                                                "example_id": "eb3e2f99-29f6-4508-8450-c316904ff79b",
                                                "sense_id": "3497c0b7-2d11-3b8e-9296-4985e41146e2",
                                                "text": "„Dieser Gedanke setzt sich in jüngeren Theorien fort, etwa im Begriff der »Kompetenz«, des Sprachvermögens, das aufgrund eines vorgegebenen Regelsystems beliebig viele Sätze in einer Sprache zu erzeugen vermag, während demgegenüber die »Performanz« die tatsächliche Äußerung einer begrenzten Zahl bestimmter Sätze ist.“"
                                            },
                                            {
                                                "example_id": "149f0a0a-03dc-49bd-9a0b-9f0be2736f8c",
                                                "sense_id": "3497c0b7-2d11-3b8e-9296-4985e41146e2",
                                                "text": "„Solche Gebrauchsregeln (Kompetenzregeln) können in der Performanz ein Korrelat von Assoziationen haben, deren Untersuchung in den Aufgabenbereich der Psycholinguistik fällt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    }
