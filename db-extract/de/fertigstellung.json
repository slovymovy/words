                                        "sense_id": "d73224f4-7392-30da-acc5-b26b4ec01c7b",
                                        "entry_id": "e5a29e0a-7585-3269-85d9-28a395ec5540",
                                        "glosses": [
                                            "Perfectionnement dont un ouvrage est susceptible."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86f1e0d5-6f5b-4e85-8b09-d457256294ec",
                                                "sense_id": "d73224f4-7392-30da-acc5-b26b4ec01c7b",
                                                "text": "Cet ouvrage n’est pas arrivé à son dernier degré d’achèvement."
                                            }
                                        ]
