                            {
                                "example_id": "4b61d998-27c8-4f0f-9465-0996ad4d2cec",
                                "sense_id": "45cc8211-4ae4-322d-a917-24eaca6daf10",
                                "text": "Die Duktilität von Gold ist größer als die von Glas."
                            },
                            {
                                "example_id": "be6f4dd7-2f79-4100-94d5-19e227425d99",
                                "sense_id": "45cc8211-4ae4-322d-a917-24eaca6daf10",
