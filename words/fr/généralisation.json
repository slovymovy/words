                    ],
                    "synonyms": [
                        "uniformisation",
                        "universalisation"
                    ],
                    "antonyms": [
                        "différenciation"
                    ],
                    "common_phrases": [
                        "généralisation des normes"
                    ]
                }
            ]
        }
    ]
