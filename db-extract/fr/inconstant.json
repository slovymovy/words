                            {
                                "example_id": "6968653c-6769-44af-a9c5-9d4c1f7b60d6",
                                "sense_id": "a04e683e-cfdb-3f74-b5f5-a9ba3835e290",
                                "text": "C’était sans connaître le venin qui habitait Guillaume : un inconstant en quête de jupons."
                            },
