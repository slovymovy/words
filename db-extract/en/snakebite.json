                                        "examples": [
                                            {
                                                "example_id": "428af15a-0abd-4085-9d75-fbbede13c411",
                                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                                "text": "Er wurde wegen eines Schlangenbisses in ein Krankenhaus eingeliefert."
                                            },
                                            {
                                                "example_id": "85cf7119-5feb-4ebc-9da3-e2c979aa6da1",
                                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                                "text": "„Besonders in dörflichen Gesellschaften suchen viele Menschen nach einem Schlangenbiss traditionelle Heiler auf.“"
                                            },
                                            {
                                                "example_id": "012f63cd-3451-408d-9f07-4d1fcca72341",
                                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                                "text": "„Dem norwegischen Ethnografen Carl Sofus Lumholtz zufolge benutzten die Ureinwohner Nordamerikas Peyote, um körperliche Leiden wie Schlangenbisse, Skorpionstiche, Zahnschmerzen, Verbrennungen, Pfeilwunden oder Rheuma zu lindern.“"
                                            },
                                            {
                                                "example_id": "354c2135-a557-4f13-8307-eeea22cedb5c",
                                                "sense_id": "077b72d1-9a4b-3fab-b4bd-f28464c896ef",
                                                "text": "„Es sah aus wie nach einem Schlangenbiss.“"
                                            }
                                        ],
