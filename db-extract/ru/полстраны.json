                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2e3b3c74-7efd-421b-bae7-94163132acea",
                                "sense_id": "dbc26d2c-84db-39e7-81ae-af7c38c89c29",
                                "text": "― Я объездил полстраны и нигде не видал ни бедных, ни нищих, ни обиженных."
                            },
                            {
                                "example_id": "d0084191-77f6-4543-b2a3-b81166b62ad1",
                                "sense_id": "dbc26d2c-84db-39e7-81ae-af7c38c89c29",
                                "text": "И нам всё же казалось, что за Якубовича полстраны отдаст свои голоса."
                            }
                        ]
                    }
