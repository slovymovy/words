                        "glosses": [
                            "Nom donné à certaines parties du littoral des îles Normandes de la Manche et de la baie du Mont-Saint-Michel."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b7f00de-17f6-459b-8a4e-a8af18f991fc",
                                "sense_id": "4962b347-85b3-3546-bd9f-53c0489d9b96",
                                "text": "En ce temps il y eut quelque grand navire d'Espagne, chargé de vins doux, qui se perdit auprès de la corbière."
                            },
                            {
                                "example_id": "30f9ed37-1d44-41e4-b2eb-384367808537",
                                "sense_id": "4962b347-85b3-3546-bd9f-53c0489d9b96",
                                "text": "Si nos corbières, ainsi qu'on l'a pensé, n'étaient que les juchoirs favoris du cormoran, rien ne serait plus naturel que de dériver corbière de corp, d'où la forme corb, corbeau de mer."
                            }
                        ]
                    }
