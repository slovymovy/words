                                        "entry_id": "bf860fb8-89ae-374b-9013-09c21fa21a16",
                                        "glosses": [
                                            "A sex organ that produces gametes; specifically, a testicle or ovary."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ca938c5f-0fdb-408b-9eec-33325ad62d1b",
                                                "sense_id": "0304378c-fff5-3c8e-b2d1-d19191171256",
                                                "text": "The shape of his gonads must set the ambit of his emotions? No. […] What Bart feels like is mother."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f8b1df83-5c57-340b-8387-196b0ada1309",
                                        "entry_id": "bf860fb8-89ae-374b-9013-09c21fa21a16",
