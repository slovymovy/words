                                        "sense_id": "88dc30aa-c339-3a87-b705-dc02b34529d2",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Objet portatif creux servant à contenir et transporter des provisions, des marchandises ou des animaux (à l’origine, en vannerie)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa4bf8a8-f22a-4d85-ab34-36b19a73ad4a",
                                                "sense_id": "88dc30aa-c339-3a87-b705-dc02b34529d2",
                                                "text": "L’épicerie emploie un certain nombre de paniers, généralement en osier, soit pour le déplacement en magasin de ses articles, soit pour la livraison."
                                            },
                                            {
                                                "example_id": "4db1935c-d72d-4ee2-ad66-df8e4ff5c548",
                                                "sense_id": "88dc30aa-c339-3a87-b705-dc02b34529d2",
                                                "text": "L’autobus était bourré de paysans chargés de lourds paniers, de sacs de victuailles et accompagnés d’une marmaille d’enfant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "488730a7-4ed8-3b5f-969b-36d2815e13de",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Objet rappelant un panier (au sens précédent)."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e15510cf-6e75-4424-be36-f9c6987c1d52",
                                                "sense_id": "488730a7-4ed8-3b5f-969b-36d2815e13de",
                                                "text": "Un panier à salade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e597afcf-4607-3333-bf17-a1c749bf735c",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Cerceau métallique sous lequel est attaché un filet ouvert en bas et dans lequel il faut faire pénétrer le ballon."
                                        ],
                                        "tags": [
                                            "Au basket"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e0160a24-c724-3313-aeee-f629f8285843",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "L’action de mettre le ballon dans le panier."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aa4d4d33-f49d-481a-bba3-085ff66548cf",
                                                "sense_id": "e0160a24-c724-3313-aeee-f629f8285843",
                                                "text": "L’équipe première de basket-ball de la Société d’Éducation Physique l’« Avant-Garde », rencontrait, dimanche dernier, sur son terrain de l’Esplanade, l’équipe première de Thélonne (Ardennes). Nos locaux surent, par leur adresse au panier et leur jeu très vite, s’imposer et gagnèrent la partie avec une série de 87 points contre 18 à Thélonne."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "96d5eb77-fb96-360e-ad00-44b264331fea",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Objet décoratif constitué d’une corbeille remplie de fleurs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6f89e0d-ec34-4246-af39-48bbd9ce9314",
                                                "sense_id": "96d5eb77-fb96-360e-ad00-44b264331fea",
                                                "text": "La table était ornée de paniers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e1b0e290-6169-31fa-a5ce-102857df3a9b",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Contenu d’un panier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7135c00d-6dcf-4516-b14d-f1e26174759f",
                                                "sense_id": "e1b0e290-6169-31fa-a5ce-102857df3a9b",
                                                "text": "Aidée par l’inflation, la crise du Covid-19 a aussi provoqué une baisse du panier moyen du consommateur, mais aussi une réorganisation, selon Julien Tuillier : les Franciliens « rationalisent » leurs choix de consommation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a8d5cbfd-a2d8-303b-a6b8-5f4d5d7c8e32",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Armature en osier qu’on plaçait sous les jupes ou les robes longues pour les faire bouffer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a0d5488a-8350-463f-9877-a6e9bb4129aa",
                                                "sense_id": "a8d5cbfd-a2d8-303b-a6b8-5f4d5d7c8e32",
                                                "text": "En voyant cette mine ennuyée de Philippe IV, si souvent reproduite, les gros yeux niais des infantes, leur lèvre autrichienne, leurs paniers monstrueux, tous ces personnages si préoccupés d'étiquette, si « hauts sur fraise », il est impossible de ne pas plaindre le pauvre Pintor de Camara."
                                            },
                                            {
                                                "example_id": "b2423ec2-87a9-43db-a6be-ce5cce331cd6",
                                                "sense_id": "a8d5cbfd-a2d8-303b-a6b8-5f4d5d7c8e32",
                                                "text": "[…] on porte maintenant des corsages beaucoup plus longs, le devant en pointe, le busc dépassant toute limite, la jupe froncée comme au temps des paniers, avec, par-derrière, des coussinets ouatés pour donner plus de tournure."
                                            },
                                            {
                                                "example_id": "0e0b2cca-f12b-49c1-8b0e-ab427f82c496",
                                                "sense_id": "a8d5cbfd-a2d8-303b-a6b8-5f4d5d7c8e32",
                                                "text": "Leurs robes, gonflées par d’énormes paniers, s’étalaient devant elles en éventail […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1563e4bf-46fa-358c-96ac-6749c1495862",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Le derrière des dames."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e32149b0-227d-4cfa-a002-a6a4cb3a6e64",
                                                "sense_id": "1563e4bf-46fa-358c-96ac-6749c1495862",
                                                "text": "Ce qui lui a encore moins plu, c’est qu’il lui mette la main au panier. Pif, paf, elle te lui a balancé un aller-retour en première et dans le sens de la marche, il a pas été déçu du voyage !"
                                            },
                                            {
                                                "example_id": "7a1197d8-eab9-46b6-b34f-1bba38a7a7bc",
                                                "sense_id": "1563e4bf-46fa-358c-96ac-6749c1495862",
                                                "text": "C'était rue d'Ménilmontant,\nQu'elle étalait son p'tit panier.\nPour attirer les clients,\nEll' remuait un peu son panier, […]. — (Bourvil, Les crayons,)"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a78a6cd-07da-3de5-9e2a-1f671370b9b0",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Liste des articles sélectionnés sur un site marchand, qu’il faut valider pour accéder au tunnel de commande."
                                        ],
                                        "tags": [
                                            "Internet"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d764965c-1a95-36ca-bffd-99b46aed60e2",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Casier de pêche."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8343ccda-f07f-48de-82d4-a24aa1035e69",
                                                "sense_id": "d764965c-1a95-36ca-bffd-99b46aed60e2",
                                                "text": "Une nuit, M. Desmond est parti en mer pour aller poser des paniers à langoustes…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a7cefa8e-4518-3af5-b9fd-e97f2825d90b",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Dispositif destiné à accueillir les diapositives lors d’une projection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "04311538-90d6-3c09-b285-1870e6228bc9",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Élément, placé à l’extrémité du bras d’une nacelle, pouvant accueillir une ou plusieurs personnes, un poste de commande et disposant un point d’accroche en fond de panier."
                                        ],
                                        "tags": [
                                            "Industrie"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65441793-b2c4-3050-9b57-a2a23321f872",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Petite voiture basse en osier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a40ce974-d2cf-4aac-9b1f-ded24a329221",
                                                "sense_id": "65441793-b2c4-3050-9b57-a2a23321f872",
                                                "text": "Enfin, vers dix heures et demie, une voiture qui roulait rapidement prit ce chemin : c’était un panier, traîné par un seul cheval et conduit par un cocher en chapeau de paille."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c5a27f2-a1b1-36b8-861d-8919ebcdec1d",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Structure métallique permettant la manutention de matières radioactives et satisfaisant à des exigences spécifiques de sûreté nucléaire."
                                        ],
                                        "tags": [
                                            "Cycle du combustible nucléaire"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9531f343-03d3-3604-b101-95aa29385419",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Partie d’un porteur contenant les bois transportés."
                                        ],
                                        "tags": [
                                            "Exploitation forestière"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "989b695d-01bc-4384-bda9-5891c2be065b",
                                                "sense_id": "9531f343-03d3-3604-b101-95aa29385419",
                                                "text": "Grâce à un panier rallongé spécial bois énergie, les bois ne touchent pas le sol lors du débardage, ce qui permet d’éviter toute présence de sable, terre ou cailloux dans le bois."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1485a48a-527e-3cb3-b80d-85c9268ccfd4",
                                        "entry_id": "f26b9840-d296-3277-bbc8-73335aa76527",
                                        "glosses": [
                                            "Groupe de crabes."
                                        ],
