                                "target_senses": [
                                    {
                                        "sense_id": "5fb4730c-4cf1-3c6d-8d20-3adfc57a8468",
                                        "entry_id": "c5da4635-254c-3f4e-b547-9cc79d50e093",
                                        "glosses": [
                                            "The dialect of working-class Quebecers."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7f1a9d3c-1fc0-44af-84ce-a12fd422bf2e",
                                                "sense_id": "5fb4730c-4cf1-3c6d-8d20-3adfc57a8468",
                                                "text": "As inflammatory as what the joual ‘is’—a mixed, oral sociolect—is its function as a kind of self-image for Québécois. In Jean-Claude Germain's terms, joual ‘bears in its flesh the scars of life and history.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
