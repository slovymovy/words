                "senses": [
                    {
                        "sense_id": "f2f2c72b-ef20-38aa-b999-79252f99b77b",
                        "entry_id": "0fb637af-460e-34ac-872b-590a661a663e",
                        "glosses": [
                            "een lijn die vanuit de masttop de giek draagt bij weggenomen zeil"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d5cca01-3fdc-4380-8874-27805f5b7ba3",
                                "sense_id": "f2f2c72b-ef20-38aa-b999-79252f99b77b",
                                "text": "Tijdens het zeilen dient het zeil de giek te dragen, de kraanlijn moet dan slap hangen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4a235b9d-3ac5-439f-8ed1-6bc0d7a80740",
                        "source_entry_id": "0fb637af-460e-34ac-872b-590a661a663e",
                        "source_sense_id": "f2f2c72b-ef20-38aa-b999-79252f99b77b",
                        "source_sense_description": "kraanlijn",
                        "target_lang_word": "Dirk",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Dirk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                        "entry_id": "cd3d80c8-0ff9-346b-9eb3-a6c25412ae19",
                                        "glosses": [
                                            "(meist dünnes) Seil, das von der Großbaumnock zum Masttop läuft und den Großbaum hochhält"
                                        ],
                                        "tags": [
                                            "Seemannssprache"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9ee1c6fb-8bed-43e7-b761-8773af638605",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "„Zieh doch mal die Dirk an, ich habe mir gerade den Kopf am Baum gestoßen.“"
                                            },
                                            {
                                                "example_id": "87ce8ce7-d017-4ed6-b58a-677edb3826a1",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "Dirken gehören zum laufenden Gut eines Segelschiffes."
                                            },
                                            {
                                                "example_id": "a7680777-1127-47ea-a9ca-ed9320eb5a38",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "Dirken laufen vom Ende des Baumes nach oben zum Mast und von dort zurück an Deck. […] Kleinere Jollen haben normalerweise keine Dirk."
                                            },
                                            {
                                                "example_id": "cc585dc7-0312-4dce-aa6a-e1c884cebb8b",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "Bei kleineren Booten hat man im allgemeinen eine Dirk an der Nock des Großbaums."
                                            },
                                            {
                                                "example_id": "ed2a2ce5-3aa9-433b-a7bd-b8f9609518bd",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "Schließlich behalfen wir uns mit der Dirk, was ein Drahtseilakt war. Denn damit wurde der zentnerschwere Baum seines Haltes beraubt. Damals nahm ich mir fest vor, ein \"Reservefall\" zu installieren. Was nicht so einfach ist, denn bei innenliegenden Fallen sind die beiden Rollen im Topp von der Dirk und vom Großfall ja schon belegt."
                                            },
                                            {
                                                "example_id": "a9af3dea-5c16-41cb-bca3-5c7cd16879d2",
                                                "sense_id": "44e71e97-876e-3427-9d23-3e8503d2d188",
                                                "text": "Gewöhnlich fahren aber die Baumdirken, die bei größeren Schiffen doppelt sind, so daß das Segel zwischen den beiden Dirken liegt, direkt nach der Saling […]. Bei kleineren Schiffen und einfacher Dirk fährt diese oft über dem obersten Piekfallblock am Topp des Masten […]. Bei Schonern fährt die Dirk des Schonersegels nach der Saling des Großmastes hinauf."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Dirk",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4750cecc-a89d-3cac-ae54-b31f895f0aad",
                                        "entry_id": "d6af6691-5566-39e4-8481-e6a966cf9870",
                                        "glosses": [
                                            "männlicher Vorname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "38ef5ebd-38ad-4aa7-a75a-d331b76ce155",
                                                "sense_id": "4750cecc-a89d-3cac-ae54-b31f895f0aad",
                                                "text": "Dirk muss gleich hier sein, er hat eben angerufen."
                                            },
                                            {
                                                "example_id": "b7e5369e-8c90-4656-8759-e1a44e0537f0",
                                                "sense_id": "4750cecc-a89d-3cac-ae54-b31f895f0aad",
                                                "text": "Hast du Dirk schon zum Geburtstag gratuliert?"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
