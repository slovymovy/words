                                "target_lang_sense_clarification": "the action of spending funds"
                            },
                            {
                                "target_lang_word": "expense",
                                "target_lang_sense_clarification": "a cost incurred"
                            },
                            {
                                "target_lang_word": "outlay",
                                "target_lang_sense_clarification": "an amount of money spent on a specific purpose"
                            }
                        ],
                        "ru": [
                            {
                                "target_lang_word": "расход",
                                "target_lang_sense_clarification": "затрата в процессе деятельности"
