                        "entry_id": "bdf0406c-a3db-3c7f-ba32-547313c49c28",
                        "glosses": [
                            "Celui qui rend."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43427830-fe4b-491c-a511-cd06527ca82d",
                                "sense_id": "2e3636c1-fa8a-3023-b229-e08fb7b8edf8",
                                "text": "Pour faire plaisir on reçoit souvent déplaisir, et pour prêter à un mauvais rendeur, d'un ami on en fait un ennemi."
                            },
                            {
                                "example_id": "5397ce42-cede-4e8e-95fb-b55b326ec1ff",
                                "sense_id": "2e3636c1-fa8a-3023-b229-e08fb7b8edf8",
                                "text": "Le rendeur d'oracles se retira dans sa case."
                            },
                            {
                                "example_id": "1e439b34-db0c-440a-a4b9-ab32e4a0a0bc",
                                "sense_id": "2e3636c1-fa8a-3023-b229-e08fb7b8edf8",
                                "text": "C'est lui le rendeur de visites, le donneur de rendez-vous."
                            },
                            {
                                "example_id": "e44557b3-b9b6-44e5-8304-73ef218b2b2e",
                                "sense_id": "2e3636c1-fa8a-3023-b229-e08fb7b8edf8",
                                "text": "Rendeur de petits soins : celui qui fait l’empressé auprès d'une femme en lui rendant toutes sortes de menus services."
                            }
                        ]
                    }
