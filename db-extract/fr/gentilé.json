            {
                "entry_id": "47e4a74e-a04a-3c2e-8122-2bf0b0f6a742",
                "word": "gentilé",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ebd2193c-6789-44c0-957c-58be9f385768",
                        "entry_id": "47e4a74e-a04a-3c2e-8122-2bf0b0f6a742",
                        "tags": [
                            "plural"
                        ],
                        "form": "gentilés"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e6de28b7-8dd6-315d-92cc-0acb9d9937d6",
                        "entry_id": "47e4a74e-a04a-3c2e-8122-2bf0b0f6a742",
                        "glosses": [
                            "Nom donné aux habitants d’un lieu, d’un pays, d’un continent, d’une région, d’une province, etc."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "087534db-e25d-4c93-9415-0e923e4ac89a",
                                "sense_id": "e6de28b7-8dd6-315d-92cc-0acb9d9937d6",
                                "text": "Le gentilé d’un seul homme peut être de trois manieres & de trois sortes de dénominations : le gentilé, par exemple, du peintre Jean Rothénamer est allemand, bavarois & munichien ; allemand signifie qu’il est d’Allemagne ; bavarois, qu’il est du cercle de Baviere ; & munichien, qu’il est de Munich."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "41819bc6-f2c8-42cd-9d2c-6d097df9c34b",
                        "source_entry_id": "47e4a74e-a04a-3c2e-8122-2bf0b0f6a742",
                        "source_sense_id": "e6de28b7-8dd6-315d-92cc-0acb9d9937d6",
                        "source_sense_description": "(Linguistique) Nom donné aux habitants d’un lieu",
                        "target_lang_word": "Demonym",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Demonym",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                                        "entry_id": "be67c231-f34e-3dbe-ab21-4250eaf195e3",
                                        "glosses": [
                                            "Bezeichnung eines Volkes, von Einheimischen oder Einwohnern eines bestimmten Landes"
                                        ],
                                        "tags": [
                                            "Onomastik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a623c35f-d0b4-4e38-bfac-2b584dcdc480",
                                                "sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                                                "text": "Die gebräuchlichste Methode zum Erstellen von Demonymen besteht darin, den Namen der Standorte Suffixe hinzuzufügen."
                                            },
                                            {
                                                "example_id": "b8fa2583-b417-4416-af8a-df4f4220ca9c",
                                                "sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                                                "text": "Außerdem sind Demonyme normalerweise Substantive und Adjektive."
                                            },
                                            {
                                                "example_id": "1d15044d-a075-4113-a8e6-71c1ab3b5b45",
                                                "sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                                                "text": "Das Demonym für die Mehrheitsbevölkerung Kosovos stellt ebenfalls einen interessanten Untersuchungsgegenstand dar. Die Albaner nennen sich selbst shqiptarë (pl.), das ist die Grundlage für die auch im Deutschen bekannte Form: Skipetaren."
                                            },
                                            {
                                                "example_id": "71aa0ac8-70dc-4560-a4b6-c8688441dc04",
                                                "sense_id": "ff4d355d-15a4-3774-80b0-cde138dadb24",
                                                "text": "So hat ein Bewohner von New York das Demonym New Yorker. Aber nicht alle Demonyme sind auf den ersten Blick so offenkundig."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
