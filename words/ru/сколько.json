{
    "word_family": [
        "столько",
        "нисколько",
        "поскольку",
        "сколько-нибудь",
        "сколько-то",
        "несколько",
        "сколечко"
    ],
    "entries": [
        {
            "pos": "pronoun",
            "senses": [
                {
                    "sense_id": "f2356559-7faa-305e-9115-c6ddf0d7e6ed",
                    "sense_definition": "Вопросительное или относительное слово, обозначающее количество, число или меру чего-либо.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "quantity_interrogative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Скажите, пожалуйста, <w>сколько</w> стоит этот билет на поезд до Москвы?",
                            "target_lang_translations": {
                                "en": "Could you please tell me <w>how much</w> this train ticket to Moscow costs?",
                                "zh": "请问这张去莫斯科的火车票<w>多少</w>钱？"
                            }
                        },
                        {
                            "text": "Я даже не представляю, <w>сколько</w> времени нам потребуется на эту работу.",
                            "target_lang_translations": {
                                "en": "I can't even imagine <w>how much</w> time we will need for this work.",
                                "zh": "我甚至无法想象完成这项工作需要<w>多少</w>时间。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как много",
                        "какое количество"
                    ],
                    "common_phrases": [
                        "сколько стоит",
                        "сколько времени",
                        "сколько лет",
                        "сколько угодно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to ask about or refer to a quantity, number, or amount.",
                        "zh": "用于询问或指代数量、数字或程度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how much",
                                "target_lang_sense_clarification": "uncountable nouns or price"
                            },
                            {
                                "target_lang_word": "how many",
                                "target_lang_sense_clarification": "countable nouns"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多少",
                                "target_lang_sense_clarification": "询问数量或程度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc7d41d8-f525-3bb0-9fc9-9c857cf8b774",
                    "sense_definition": "Употребляется в восклицательных предложениях для выражения удивления по поводу большого количества кого-либо или чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantity_exclamatory",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Боже мой, <w>сколько</w> цветов ты принёс на наш праздник!",
                            "target_lang_translations": {
                                "en": "My God, <w>how many</w> flowers you brought to our celebration!",
                                "zh": "天哪，你为我们的节日带来了<w>多少</w>花啊！"
                            }
                        },
                        {
                            "text": "Я уже забыл, <w>сколько</w> раз мы обсуждали эту сложную тему.",
                            "target_lang_translations": {
                                "en": "I've already forgotten <w>how many</w> times we discussed this complex topic.",
                                "zh": "我已经忘了我们讨论过<w>多少</w>次这个复杂的话题了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "много"
                    ],
                    "common_phrases": [
                        "сколько лет сколько зим",
                        "сколько можно"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in exclamations to express surprise at a large quantity or amount.",
                        "zh": "用于感叹句，表示对数量之多感到惊讶。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "so many",
                                "target_lang_sense_clarification": "large number"
                            },
                            {
                                "target_lang_word": "so much",
                                "target_lang_sense_clarification": "large amount"
                            },
                            {
                                "target_lang_word": "how many",
                                "target_lang_sense_clarification": "exclamatory"
                            },
                            {
                                "target_lang_word": "how much",
                                "target_lang_sense_clarification": "exclamatory"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多少",
                                "target_lang_sense_clarification": "感叹数量多"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "1073254e-5380-35de-a571-8a3491e6c065",
                    "sense_definition": "Обозначает длительность или продолжительность действия во времени.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "time_duration",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты не знаешь, <w>сколько</w> нам ещё ждать начала концерта?",
                            "target_lang_translations": {
                                "en": "Do you know <w>how long</w> we still have to wait for the concert to start?",
                                "zh": "你知不知道我们还要等<w>多久</w>音乐会才开始？"
                            }
                        },
                        {
                            "text": "Врач не сказал, <w>сколько</w> дней мне нужно принимать это лекарство.",
                            "target_lang_translations": {
                                "en": "The doctor didn't say <w>how many</w> days I need to take this medicine.",
                                "zh": "医生没说我需要吃<w>多少</w>天这种药。"
                            }
                        }
                    ],
                    "synonyms": [
                        "как долго",
                        "как много времени"
                    ],
                    "common_phrases": [
                        "сколько ждать",
                        "сколько идти",
                        "сколько ехать"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate the duration or length of time of an action.",
                        "zh": "用于表示动作持续的时间长度。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "how long",
                                "target_lang_sense_clarification": "duration"
                            },
                            {
                                "target_lang_word": "how much",
                                "target_lang_sense_clarification": "time"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多久",
                                "target_lang_sense_clarification": "询问时间长度"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "70d3714a-9790-3107-b0c1-dcabadc45639",
                    "sense_definition": "Используется для обозначения степени проявления признака или меры действия, часто в сопоставлении (обычно в паре со словом «столько»).",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "degree_measure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я не столько устал после работы, <w>сколько</w> просто хочу побыть в тишине.",
                            "target_lang_translations": {
                                "en": "I am not so much tired after work <w>as</w> I simply want to be in silence.",
                                "zh": "与其说我工作后很累，不如说我只是想安静一会儿。"
                            }
                        },
                        {
                            "text": "Он помог нам ровно столько, <w>сколько</w> позволяли его скромные возможности.",
                            "target_lang_translations": {
                                "en": "He helped us exactly as much <w>as</w> his modest means allowed.",
                                "zh": "他尽其所能，在能力范围内帮了我们。"
                            }
                        }
                    ],
                    "synonyms": [
                        "насколько"
                    ],
                    "common_phrases": [
                        "не столько сколько",
                        "столько же сколько"
                    ],
                    "target_lang_definitions": {
                        "en": "Used to indicate degree or measure, typically in comparisons.",
                        "zh": "用于表示程度或度量，通常用于比较。"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "as",
                                "target_lang_sense_clarification": "in comparisons"
                            },
                            {
                                "target_lang_word": "as much",
                                "target_lang_sense_clarification": "degree"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "多少",
                                "target_lang_sense_clarification": "用于比较程度"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}