                    {
                        "sense_id": "9d775de1-7258-3e14-84e5-a544cf81f8c3",
                        "entry_id": "bf2f97c3-9372-3758-8d22-c1a90b47cea9",
                        "glosses": [
                            "Worte, mit denen eine gegensätzliche Haltung deutlich gemacht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d9bb4ce6-c38e-48c0-9cea-6cb1aad580bc",
                                "sense_id": "9d775de1-7258-3e14-84e5-a544cf81f8c3",
                                "text": "„Wer hier nicht gelernt hat, dass man sich in einer solchen Situation ohne Widerrede den Anordnungen eines Kommandanten unterordnen muss, der ist hier fehl am Platz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6b0f7872-eb95-38dc-8b4a-c8887f199d2e",
                        "entry_id": "bf2f97c3-9372-3758-8d22-c1a90b47cea9",
                        "glosses": [
                            "Vortrag (Gegenrede) als Antwort auf eine zuerst gehaltene Rede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32fbb242-b212-4985-9ad9-816715b11f88",
                                "sense_id": "6b0f7872-eb95-38dc-8b4a-c8887f199d2e",
                                "text": "„Der Weg, mit ihm handelseinig zu werden, war mit ebenso vielen Für- und Widerreden gepflastert wie der Dienstweg durch die zahllosen Behörden mit Bakschisch, um eine Genehmigung für unser Vorhaben zu erhalten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fcdd42f-765d-4392-8380-22aee7133607",
                        "source_entry_id": "bf2f97c3-9372-3758-8d22-c1a90b47cea9",
                        "source_sense_id": "9d775de1-7258-3e14-84e5-a544cf81f8c3",
                        "source_sense_description": "Worte, mit denen eine gegensätzliche Haltung deutlich gemacht wird",
                        "target_lang_word": "backtalk",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "backtalk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2b4cd71f-4095-3ecb-ac7f-cd4656009b86",
                                        "entry_id": "1baceca6-202f-3be6-bc0c-06b9854de23e",
                                        "glosses": [
                                            "Verbal impudence or argumentative discourse, given in response."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "74d8d6b6-ccf7-41e7-ba53-373c28b717c1",
                                                "sense_id": "2b4cd71f-4095-3ecb-ac7f-cd4656009b86",
                                                "text": "Don't give me any backtalk; just go clean your room."
                                            },
                                            {
                                                "example_id": "88e4cf18-d7a7-4378-8fb7-7cb304a7cb4e",
                                                "sense_id": "2b4cd71f-4095-3ecb-ac7f-cd4656009b86",
                                                "text": "He scratched his head. \"Well, damn me,\" said he. \"I never thought I would take orders from a Chink, but he says 'hist!' and by crums you've got to hist and no back talk either.\""
                                            },
                                            {
                                                "example_id": "acb223d8-a631-421b-ac2b-42c55880af43",
                                                "sense_id": "2b4cd71f-4095-3ecb-ac7f-cd4656009b86",
                                                "text": "\"Squalled at me that she owned the business and that she wouldn't take any back talk from me and that the piece wasn't for sale. What could I do?\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "backtalk",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4d6f789-4710-3c61-ad60-a10f5ba62df1",
                                        "entry_id": "54a588a4-a459-3f1f-887c-90778381da1d",
                                        "glosses": [
                                            "To respond to in an aggressively disputatious, often sarcastic or insolent manner."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c038d2fa-b972-477c-bb0c-d8f711df7903",
                                                "sense_id": "b4d6f789-4710-3c61-ad60-a10f5ba62df1",
                                                "text": "Peter was sent to detention for backtalking the teacher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
