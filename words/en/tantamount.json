{
    "word_family": [],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ed07761a-3fe6-3bc5-ba05-951ee89543dc",
                    "sense_definition": "Equivalent in value, meaning, or effect to something else.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "For many people, silence is <w>tantamount</w> to agreement.",
                            "target_lang_translations": {
                                "cs": "Pro mnoho lidí se mlčení <w>rovná</w> souhlasu."
                            }
                        },
                        {
                            "text": "Ignoring the problem is <w>tantamount</w> to admitting defeat in this situation.",
                            "target_lang_translations": {
                                "cs": "Ignorování problému se v této situaci <w>rovná</w> přiznání porážky."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivalent",
                        "synonymous"
                    ],
                    "common_phrases": [
                        "tantamount to"
                    ],
                    "target_lang_definitions": {
                        "cs": "Mající stejnou hodnotu, význam nebo účinek jako něco jiného."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rovnocenný",
                                "target_lang_sense_clarification": "vyjadřuje shodu v hodnotě nebo významu"
                            },
                            {
                                "target_lang_word": "rovnající se",
                                "target_lang_sense_clarification": "často používané ve spojení s předložkou 'k' (rovnající se něčemu)"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0e18cb5b-8b84-389d-b16d-6295d52536a0",
                    "sense_definition": "Something that has the same value or significance as another thing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The offer was a <w>tantamount</w> to the original price agreed upon.",
                            "target_lang_translations": {
                                "cs": "Nabídka byla <w>ekvivalentem</w> původní dohodnuté ceny."
                            }
                        },
                        {
                            "text": "He considered the apology a <w>tantamount</w> to a full confession.",
                            "target_lang_translations": {
                                "cs": "Považoval omluvu za <w>ekvivalent</w> úplného přiznání."
                            }
                        }
                    ],
                    "synonyms": [
                        "equivalent"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "This noun usage is largely archaic or non-standard in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Něco, co má stejnou hodnotu nebo význam jako jiná věc (zastaralé užití)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "ekvivalent",
                                "target_lang_sense_clarification": "odpovídající náhrada nebo hodnota"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "f72ba4d1-a06e-32cc-8ec5-d009db4ce655",
                    "sense_definition": "To be equal in value or effect.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "equivalence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The total costs <w>tantamount</w> to a significant portion of the budget.",
                            "target_lang_translations": {
                                "cs": "Celkové náklady se <w>rovnají</w> významné části rozpočtu."
                            }
                        },
                        {
                            "text": "These small errors <w>tantamount</w> to a complete failure of the project.",
                            "target_lang_translations": {
                                "cs": "Tyto malé chyby se <w>rovnají</w> úplnému selhání projektu."
                            }
                        }
                    ],
                    "synonyms": [
                        "equal",
                        "amount"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This verb usage is no longer common in contemporary English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Být si roven v hodnotě nebo účinku (zastaralé užití)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "rovnat se",
                                "target_lang_sense_clarification": "dosahovat stejné úrovně nebo hodnoty"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}