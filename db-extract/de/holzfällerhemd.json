                "senses": [
                    {
                        "sense_id": "276a516c-93ca-3d02-87c2-b7da857dd7cc",
                        "entry_id": "7e34d609-d8a8-372f-81e2-961a7632afcc",
                        "glosses": [
                            "grobes, kariertes Hemd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5ab4e8f-98f4-4c97-96da-142d06f3b0f7",
                                "sense_id": "276a516c-93ca-3d02-87c2-b7da857dd7cc",
                                "text": "„Vor mir steht ein Mann, kaum größer als ich, den Schädel kahlrasiert, die Haut gräulich braun, das Holzfällerhemd nachlässig in eine beigefarbene Bundfaltenhose gesteckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
