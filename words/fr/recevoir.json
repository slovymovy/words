    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "242cf899-84cb-3eb4-8d60-318a13b25afd",
                    "sense_definition": "Prendre livraison ou entrer en possession de ce qui est envoyé, transmis ou remis par quelqu'un.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hier matin, j'ai <w>reçu</w> une lettre importante de ma banque."
                        },
                        {
                            "text": "Elle <w>reçoit</w> toujours beaucoup de cadeaux le jour de son anniversaire."
                        }
                    ],
                    "common_phrases": [
                        "recevoir une lettre",
                        "recevoir un message",
                        "recevoir un cadeau",
                        "recevoir un colis"
                    ]
                },
                {
                    "sense_id": "0a514c51-9c2e-373e-9030-f0b55bb0b266",
                    "sense_definition": "Accueillir chez soi ou dans un lieu des visiteurs, des invités ou des clients.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "accueil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mes voisins adorent <w>recevoir</w> des amis à dîner le samedi soir."
                        },
                        {
                            "text": "Le médecin ne peut pas vous <w>recevoir</w> sans rendez-vous préalable."
                        }
                    ],
                    "common_phrases": [
                        "recevoir des amis",
                        "recevoir du monde",
                        "savoir recevoir"
                    ]
                },
                {
                    "sense_id": "8a312848-4edd-3799-91d5-37d207de2dfe",
                    "sense_definition": "Se faire procurer ou délivrer des vivres, du matériel ou des approvisionnements.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transmission",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les habitants du village sinistré viennent enfin de <w>recevoir</w> des vivres d'urgence."
                        },
                        {
                            "text": "Le nouvel hôpital va bientôt <w>recevoir</w> tout le matériel médical nécessaire."
                        }
                    ],
                    "synonyms": [
                        "obtenir"
                    ],
                    "common_phrases": [
                        "recevoir des vivres",
                        "recevoir des secours",
                        "recevoir des renforts"
                    ]
                },
                {
                    "sense_id": "3fe177ef-a257-3b6a-9753-c3a34f57af72",
                    "sense_definition": "Subir ou éprouver un choc physique, un dommage ou un traitement désagréable.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "subir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le défenseur a <w>reçu</w> un coup violent lors de la compétition."
                        },
                        {
                            "text": "Cet employé a <w>reçu</w> un avertissement formel de la part de sa hiérarchie."
                        }
                    ],
                    "common_phrases": [
                        "recevoir un coup",
                        "recevoir une blessure",
                        "recevoir un avertissement"
                    ]
                },
                {
                    "sense_id": "e6c5396d-fbb9-3dee-8695-40d1ca0c44f6",
                    "sense_definition": "Être admis ou accepté avec succès à un examen, un concours ou dans une corporation.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "admettre",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après des mois de préparation intensive, elle a été <w>reçue</w> à son concours."
                        },
                        {
                            "text": "Ce jeune juriste espère être <w>reçu</w> au barreau dès l'automne prochain."
                        }
                    ],
                    "common_phrases": [
                        "être reçu à un examen",
                        "être reçu au concours"
                    ]
                },
                {
                    "sense_id": "9d9f90af-f980-3eaa-8506-6ce45cf44f10",
                    "sense_definition": "Recueillir ou contenir en son sein des éléments naturels, des eaux ou des flux.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "contenir",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette cuve spéciale permet de <w>recevoir</w> les eaux usées de toute l'usine."
                        },
                        {
                            "text": "Le grand fleuve <w>reçoit</w> les eaux abondantes de plusieurs affluents de montagne."
                        }
                    ],
                    "common_phrases": [
                        "recevoir les eaux"
                    ]
                }
            ]
        }
    ]
