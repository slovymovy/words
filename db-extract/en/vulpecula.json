                                                "sense_id": "95c1ad43-14db-3d55-8163-a5487ac91611",
                                                "text": "Schau sie an die Füchse, die fahren noch dreistellig (sinngemäß für: die haben noch mindestens 100 Tage zu dienen)."
                                            }
                                        ],
                                        "sense_index_json": "\"15\""
                                    },
                                    {
                                        "sense_id": "7fb994ba-79e3-3cd6-90eb-d42f3bd6ae7c",
                                        "entry_id": "7d9aa0b8-ea97-31b2-a003-688bc9be868b",
                                        "glosses": [
