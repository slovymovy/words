        "fr-extract.jsonl": [
            {
                "entry_id": "0310a272-f99f-3909-8f14-b267ab5fb749",
                "word": "pertinemment",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                        "entry_id": "0310a272-f99f-3909-8f14-b267ab5fb749",
                        "glosses": [
                            "D’une manière pertinente, en touchant précisément le point en question."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08dba2af-9223-45d8-a957-173878168fe3",
                                "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                                "text": "Il en parle pertinemment, très pertinemment et en connaisseur."
                            },
                            {
                                "example_id": "40e9ae94-feed-4c8c-a51c-839aa66f701d",
                                "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                                "text": "Il en a discouru pertinemment."
                            },
                            {
                                "example_id": "60a8de95-13cb-469a-b2be-ab017c0fb046",
                                "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                                "text": "Il parle, ce me semble, assez pertinemment,"
                            },
                            {
                                "example_id": "2570100c-dd61-451d-a31c-93e27765b879",
                                "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                                "text": "J’ajoute, pour être complet, que je dus répondre publiquement et pertinemment – ces deux adverbes joints… – à quelques questions saugrenues des sénateurs Bepmale et Debierre sur l’origine de mes dossiers. Ces messieurs, collés sous bande, n’insistèrent pas."
                            },
                            {
                                "example_id": "d5f05555-a2f5-463e-84fa-991c204f0f7a",
                                "sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                                "text": "Les leçons et les devoirs rampaient sur la soirée. Quand papa revenait à temps, il nous aidait pertinemment mais avec impatience. Il ne nous tolérait ni légèreté ni lenteur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "99852336-2626-4b55-8ea5-95b208f251f2",
                        "source_entry_id": "0310a272-f99f-3909-8f14-b267ab5fb749",
                        "source_sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                        "target_lang_word": "absolutely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "47da8542-fd0e-34ac-b563-c913654db3dd",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "In an absolute or unconditional manner; utterly, positively, wholly."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "Independently; viewed without relation to other things or factors."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c81a4da-f091-4ce0-a15a-9077506450cf",
                                                "sense_id": "2f717f83-1c78-3e4f-983d-60d67b8bc133",
                                                "text": "Another characteristic of numbers, which does not concern their mutual relations so much as themselves absolutely, is their ability, according to the ideas of Nicomachus, to conform to geometrical arrangements."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                        "entry_id": "e5f3eb3e-a412-3c2a-a354-78880f3d6140",
                                        "glosses": [
                                            "As an intensive: extremely, very, indeed."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ebdec5-29be-4c20-868f-3073a912b06b",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "But when it came to posing for publicity pictures they proved absolutely brilliant doing just what came naturally."
                                            },
                                            {
                                                "example_id": "c38bfa8f-c587-4bcb-acca-4ede84befecf",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The strength of the mouse is absolutely spectacular for various kinds of issues, until you find out that the mouse has absolutely no extracellular matrix to speak of in his optic nerve head."
                                            },
                                            {
                                                "example_id": "a29e99e0-44ab-4143-98bb-d8995ba39d0f",
                                                "sense_id": "58ee26a4-b92d-3260-b696-6b1b425c9b62",
                                                "text": "The most absolutely terrifying creature lifted her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "absolutely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                        "entry_id": "dafa4a83-cdd1-3e27-bd0c-eb0b7ac7b9bc",
                                        "glosses": [
                                            "Yes, certainly; expression indicating strong agreement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2ac9752-fa44-4cd8-b952-dca657402b56",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Is Bob a good teacher?\nAbsolutely!"
                                            },
                                            {
                                                "example_id": "cd181f96-9d79-4997-b6f4-98a9933b0ae2",
                                                "sense_id": "e93f6ed4-40ad-305c-aeb4-19b7909244d5",
                                                "text": "Do you want a free cookie with that coffee?\nAbsolutely!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b36e86a-52e9-4824-9e24-4fa89a918948",
                        "source_entry_id": "0310a272-f99f-3909-8f14-b267ab5fb749",
                        "source_sense_id": "431aba53-1a82-3628-bc1e-93b1c4615984",
                        "target_lang_word": "definitely",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "definitely",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "Without question and beyond doubt."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17663ba8-eeae-4fe3-9e67-4374926ada7f",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "Joe definitely doesn't know how to drive a tractor."
                                            },
                                            {
                                                "example_id": "35bac096-e678-43d3-8b69-e38e3bbec1d9",
                                                "sense_id": "335c0432-ecda-3b42-83e3-253cbb297a38",
                                                "text": "She said she wasn't coming, definitely."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                        "entry_id": "3a09d650-9e94-3015-b0e8-e1845b55f8ca",
                                        "glosses": [
                                            "In a definite manner; decisively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8183e1b2-41c5-49da-ad93-89cff4ff9f2a",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "It was really impossible on board that ship to get away definitely from Almayer"
                                            },
                                            {
                                                "example_id": "64f95043-a2cb-43a6-811e-598be8b23344",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And the Nose definitely turned away."
                                            },
                                            {
                                                "example_id": "b77493ff-1187-43e1-8a19-bdf51e9f198f",
                                                "sense_id": "dbc49c65-7966-3a49-bd7b-c0811295f06d",
                                                "text": "And these Elders were men of good standing in that community, and they swore definitely before the counsel that this lady committed this impropriety, and there was nobody to gainsay that, except the lady herself, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
