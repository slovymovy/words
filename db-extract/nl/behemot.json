                "translations": [
                    {
                        "translation_id": "4fa90495-4ced-4f04-a31f-89388926f3be",
                        "source_entry_id": "a39d0b16-87e3-30bd-a33f-ca96687a9fbf",
                        "source_sense_id": "bcbe7499-4ffe-33af-95bf-633ec6265977",
                        "target_lang_word": "behemoth",
