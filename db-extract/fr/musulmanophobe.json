                                "example_id": "301dd193-547a-4b5f-a232-8ec46b045c7d",
                                "sense_id": "87502412-7277-3090-9d1a-102102148df3",
                                "text": "Selon cet assistant-chercheur de l’ULB, les travaux de Caroline Fourest sur l’islam et l’intégrisme font d’elle une « musulmanophobe de gauche »."
                            },
                            {
                                "example_id": "6c9099a2-b83c-4a36-a093-00943a13df8d",
                                "sense_id": "87502412-7277-3090-9d1a-102102148df3",
                                "text": "Voilà ce que me reproche Souhail Chichah et ce qui justifie –à ses yeux– de me traiter de « musulmanophobe »."
                            }
                        ]
                    }
