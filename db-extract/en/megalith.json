                                "target_senses": [
                                    {
                                        "sense_id": "b6a42d45-ea9c-3809-8c43-74d313b72c94",
                                        "entry_id": "de0b2642-894c-3c10-a8de-fae231a338f2",
                                        "glosses": [
                                            "Construcción de grandes bloques de piedra escasamente desbastados propia del Neolítico o de la Edad del Bronce temprana."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74cccc60-209c-48bd-bbf9-98b05281d205",
                                                "sense_id": "b6a42d45-ea9c-3809-8c43-74d313b72c94",
                                                "text": "Existe en Portugal un dolmen, el llamado a casa da moira, en la falda occidental de la sierra de Ossa (Alemtejo), que presenta una particularidad extraña, notada ya en otros megalitos de Crimea, de Palestina, de Siria y en algunos, aunque pocos, del mundo occidental: el de presenter una abertura artificial en uno de sus lados."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
