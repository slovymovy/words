                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She ignored his clumsy <pickup> at the bar.",
                            "target_lang_translations": {
