{
    "word_family": [
        "need",
        "needy",
        "needlessly",
        "needlessness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "dea518ea-8b31-3213-96e6-cd04c85db921",
                    "sense_definition": "Not needed; unnecessary.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new project of yours will only be a <w>needless</w> expense.",
                            "target_lang_translations": {
                                "ru": "Этот твой новый проект станет лишь <w>ненужной</w> тратой.",
                                "pl": "Ten twój nowy projekt będzie tylko <w>niepotrzebnym</w> wydatkiem."
                            }
                        },
                        {
                            "text": "<w>Needless</w> to say, we were all very relieved when the difficult work was finished.",
                            "target_lang_translations": {
                                "ru": "<w>Излишне</w> говорить, что мы все почувствовали огромное облегчение, когда эта трудная работа была закончена.",
                                "pl": "<w>Nie trzeba dodawać</w>, że wszyscy poczuliśmy ogromną ulgę, gdy ta ciężka praca dobiegła końca."
                            }
                        }
                    ],
                    "synonyms": [
                        "unnecessary",
                        "unneeded",
                        "gratuitous",
                        "avoidable"
                    ],
                    "antonyms": [
                        "needful"
                    ],
                    "common_phrases": [
                        "needless to say",
                        "needless expense",
                        "needless waste",
                        "needless suffering"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не являющийся необходимым; такой, в котором нет нужды.",
                        "pl": "Taki, który nie jest potrzebny; zbyteczny lub nieuzasadniony."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ненужный",
                                "target_lang_sense_clarification": "общий смысл"
                            },
                            {
                                "target_lang_word": "излишний",
                                "target_lang_sense_clarification": "чрезмерный, лишний"
                            },
                            {
                                "target_lang_word": "напрасный",
                                "target_lang_sense_clarification": "бесполезный, не имеющий смысла"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepotrzebny",
                                "target_lang_sense_clarification": "taki, który nie jest wymagany ani przydatny"
                            },
                            {
                                "target_lang_word": "zbyteczny",
                                "target_lang_sense_clarification": "stanowiący nadmiar, niekonieczny"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "11d315e1-4047-3f15-b6bb-5b385bae61b3",
                    "sense_definition": "Needlessly, without cause.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He worried <w>needless</w> about the outcome of the game, which they won easily.",
                            "target_lang_translations": {
                                "ru": "Он <w>напрасно</w> беспокоился об исходе игры, которую они легко выиграли.",
                                "pl": "Martwił się <w>niepotrzebnie</w> o wynik meczu, który bez trudu wygrali."
                            }
                        },
                        {
                            "text": "They argued <w>needless</w> over small details that did not matter in the end.",
                            "target_lang_translations": {
                                "ru": "Они <w>без нужды</w> спорили о мелочах, которые в итоге не имели значения.",
                                "pl": "Kłócili się <w>niepotrzebnie</w> o drobne szczegóły, które ostatecznie nie miały znaczenia."
                            }
                        }
                    ],
                    "synonyms": [
                        "needlessly",
                        "unnecessarily"
                    ],
                    "target_lang_definitions": {
                        "ru": "Без необходимости; напрасно (устаревшее или редкое использование в качестве наречия).",
                        "pl": "Bez potrzeby; niepotrzebnie, zbytecznie."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "напрасно",
                                "target_lang_sense_clarification": "зря, без пользы"
                            },
                            {
                                "target_lang_word": "без нужды",
                                "target_lang_sense_clarification": "без необходимости"
                            }
                        ],
                        "pl": [
                            {
                                "target_lang_word": "niepotrzebnie",
                                "target_lang_sense_clarification": "bez potrzeby, na próżno"
                            },
                            {
                                "target_lang_word": "zbytecznie",
                                "target_lang_sense_clarification": "nadmiernie, bez racjonalnego powodu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}