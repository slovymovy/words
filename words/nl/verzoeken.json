                                "target_lang_sense_clarification": "побуждать к действию"
                            }
                        ],
                        "it": [
                            {
                                "target_lang_word": "pregare",
                                "target_lang_sense_clarification": "formale e cortese"
                            },
                            {
                                "target_lang_word": "richiedere",
                                "target_lang_sense_clarification": "formale"
                            },
                            {
                                "target_lang_word": "invitare",
                                "target_lang_sense_clarification": "esortare formalmente"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a8664bdf-717e-3607-941e-7d8bdac7dc96",
                    "sense_definition": "Iemand in verleiding brengen of op de proef stellen",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "tempt",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In het oude verhaal werd de held <w>verzocht</w> door rijkdom en macht.",
                            "target_lang_translations": {
                                "en": "In the old story, the hero was <w>tempted</w> by wealth and power.",
                                "ru": "В старой истории героя <w>искушали</w> богатством и властью.",
                                "it": "Nell'antica storia, l'eroe fu <w>tentato</w> dalla ricchezza e dal potere."
                            }
                        },
                        {
                            "text": "Hij liet zich niet <w>verzoeken</w> om zijn principes opzij te zetten.",
                            "target_lang_translations": {
                                "en": "He did not let himself be <w>tempted</w> to set aside his principles.",
                                "ru": "Он не позволил себя <w>искусить</w> и отступить от своих принципов.",
                                "it": "Non si lasciò <w>tentare</w> di mettere da parte i suoi principi."
                            }
                        }
                    ],
                    "synonyms": [
                        "verleiden",
                        "beproeven"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly religious or literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To tempt someone or put them to the test",
                        "ru": "Вводить кого-либо в искушение или подвергать испытанию",
                        "it": "Tentare qualcuno o metterlo alla prova"
                    },
                    "translations": {
