                        "target_lang_word": "typomètre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "typomètre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                        "entry_id": "54f0e1c7-5aab-35f5-abb4-50981684d262",
                                        "glosses": [
                                            "Règle divisée en cicéros, demi cicéros et quarts de cicéros, avec laquelle on évalue les compositions typographiques."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b342e6b4-4201-41db-a67a-97c87f2bac6f",
                                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                                "text": "On apprécie ensuite les distances, que l’on figurera avec les garnitures en les évaluant à l’aide du typomètre."
                                            },
                                            {
                                                "example_id": "3a099d39-5f7d-4c2e-91fe-0dce45f669ae",
                                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                                "text": "Une minute plus tard, abandonnant qui le massicot, qui le typomètre et qui les brucelles du correcteur, nous organisions, dans notre domaine, une battue méticuleuse."
                                            },
                                            {
                                                "example_id": "39463ca4-0e3d-4927-b4a4-1d1f7126c627",
                                                "sense_id": "391c0bee-8c45-30b3-954c-fd3df4538a68",
                                                "text": "Il raclait toutes les piges qui se présentaient, avait accepté de devenir technicien du typomètre dans un magazine local où le futur maire faisait ses premiers pas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
