                "senses": [
                    {
                        "sense_id": "852971d8-7d4d-3ba9-8bae-e5b9f56b712c",
                        "entry_id": "57b682d9-f3df-399c-9c13-db93311bb1e3",
                        "glosses": [
                            "Arbeiterin, die ihren beruflichen Aufgaben in einem Lager nachgeht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e74d43c0-6049-4353-8edb-228d35327823",
                                "sense_id": "852971d8-7d4d-3ba9-8bae-e5b9f56b712c",
                                "text": "„Sechs Stellenangebote aus der Datenbank des Arbeitsamtes bekommt Hibler-Hofer dann doch mit nach Hause. Darunter Jobs als Lagerarbeiterin, als Aushilfe bei einer Tankstelle und als Einräumhilfe.“"
                            },
                            {
                                "example_id": "22ea71dd-2c21-4760-a30f-477f02cb4a70",
                                "sense_id": "852971d8-7d4d-3ba9-8bae-e5b9f56b712c",
                                "text": "„Der 23-jährigen Mutter, einer Lagerarbeiterin, und ihrem zwei Jahre älteren Mann, einem arbeitslosen Bankangestellten, droht nun eine Haftstrafe von bis zu zwölf Jahren.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
