                "senses": [
                    {
                        "sense_id": "d5f9b822-c8ba-3ef4-859e-810984c4da3f",
                        "entry_id": "4cc6276e-0feb-3821-a812-8287f980e5f5",
                        "glosses": [
                            "weiblicher und männlicher Vorname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e248e040-cb06-48d5-9c3f-80c573164dc4",
                                "sense_id": "d5f9b822-c8ba-3ef4-859e-810984c4da3f",
                                "text": "Im März erscheint ein neues Album von Dido."
                            },
                            {
                                "example_id": "5204766a-ef01-45b2-b3d0-b9f4307ed770",
                                "sense_id": "d5f9b822-c8ba-3ef4-859e-810984c4da3f",
                                "text": "„Er war gut angekommen, arbeitete schon wieder, das Zimmer im Hotel für Dido war bereit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "2283f2fd-c1cd-3cf0-9cee-a04f60ebbb3b",
                        "entry_id": "4cc6276e-0feb-3821-a812-8287f980e5f5",
                        "glosses": [
                            "phönizische Prinzessin, nach der Gründungslegende Karthagos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "25942d37-15ca-4754-b85b-84affaab4351",
                                "sense_id": "2283f2fd-c1cd-3cf0-9cee-a04f60ebbb3b",
                                "text": "„Dido stammte eigentlich aus Phönizien; sie wurde in der Stadt Tyros im heutigen Libanon geboren. Nach der Ermordung ihres Ehemanns musste sie aus dem Land fliehen.“"
                            },
                            {
                                "example_id": "8112b69e-c09d-41c1-aa69-99d80396c403",
                                "sense_id": "2283f2fd-c1cd-3cf0-9cee-a04f60ebbb3b",
                                "text": "„Nachdem Aeneas beteuert hat, er werde Dido nie vergessen, streitet er Didos Anschuldigungen ab […].“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
