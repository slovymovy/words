                "senses": [
                    {
                        "sense_id": "2307ea8f-e7f7-3dfb-a7f3-1288f8e43767",
                        "entry_id": "2ca642b5-ef79-3752-b52b-43d32ef7e489",
                        "glosses": [
                            "Stadtteil, in dem überwiegend Neubauten stehen oder errichtet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d2a8049-5680-4600-92ac-1bbc38ddc1a4",
                                "sense_id": "2307ea8f-e7f7-3dfb-a7f3-1288f8e43767",
                                "text": "„Sie führte immerzu um einen leeren, vollkommen nichtssagenden Platz in einem ebenso nichtssagenden Neubauviertel herum.“"
                            },
                            {
                                "example_id": "c1c49f7a-586a-472c-aca7-2131c8363e83",
                                "sense_id": "2307ea8f-e7f7-3dfb-a7f3-1288f8e43767",
                                "text": "„Die Einrichtung der Schnellbahn auf Strecken der Nordbahn und der Verbindungsbahn, der U-Bahn-Bau (Linien U1 und U2) und Neubauviertel wie das ehemalige Nordbahnhofgelände und das ‚Viertel zwei‘ zwischen Messe Wien und Stadion sind hier ebenso zu nennen wie die quer über den Prater gebaute Stadtautobahn Südosttangente mit der Praterbrücke über die Donau und das Donaukraftwerk Freudenau.“"
                            },
                            {
                                "example_id": "33da5907-b52a-46f2-8680-fd477cabe946",
                                "sense_id": "2307ea8f-e7f7-3dfb-a7f3-1288f8e43767",
                                "text": "„Im Berliner Stadtteil Charlottenburg erhielt nach dem Ersten Weltkrieg ein ganzes Neubauviertel (zwischen Olympiastadion und Teufelsberg) Alleen, deren Namen an Ostpreußen erinnern: Neidburg, Sarkau, Heilsberg, Sensburg, Insterburg.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
