                "senses": [
                    {
                        "sense_id": "3f1c26fd-f489-3bab-8070-52f90c63df24",
                        "entry_id": "b8dba058-4d0e-3c6b-bbe6-18e7a0cf65c9",
                        "glosses": [
                            "прост., груб. еда, пища"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "440051d2-776f-48b9-b715-1e203e841da0",
                                "sense_id": "3f1c26fd-f489-3bab-8070-52f90c63df24",
                                "text": "Он же, подлец, голодом нас морил, а сам с работы полные сумки жратвы таскал…"
                            },
                            {
                                "example_id": "bb0fd110-bcc7-4380-a2cc-c57d4e8738ed",
                                "sense_id": "3f1c26fd-f489-3bab-8070-52f90c63df24",
                                "text": "Сходили в магазин и набрали жратвы: хлеба и консервов."
                            }
                        ]
                    },
                    {
                        "sense_id": "6a7c5c65-8d58-3f49-a8e3-aed3c2345aa5",
                        "entry_id": "b8dba058-4d0e-3c6b-bbe6-18e7a0cf65c9",
                        "glosses": [
                            "прост. питание, еда (процесс принятия пищи)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66a06d09-c0a0-45ed-9cc9-ab577779549c",
                                "sense_id": "6a7c5c65-8d58-3f49-a8e3-aed3c2345aa5",
                                "text": "Это не литература, это отчёт о большой жратве, празднике каннибалов."
                            }
                        ]
                    }
                ],
