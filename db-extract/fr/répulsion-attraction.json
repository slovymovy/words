                                            {
                                                "example_id": "13e7a283-4b6b-4a37-bce3-a505acb6535b",
                                                "sense_id": "f776bad4-a978-3245-86b7-56a9a5a83ac3",
                                                "text": "The coaches require modifications, including work to ensure they can work in push-pull mode with Class 67 locos."
                                            },
                                            {
                                                "example_id": "4fa6b60d-5bde-452f-87aa-640533503103",
                                                "sense_id": "f776bad4-a978-3245-86b7-56a9a5a83ac3",
                                                "text": "That train is Inspection Saloon 975025, better known as Caroline. It's a former Hastings line Class 201 diesel-electric multiple unit (DEMU) buffet car converted to run in push-pull operation, with large windows at both ends to give a great view of the line ahead."
                                            }
