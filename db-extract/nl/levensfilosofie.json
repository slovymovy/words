                    {
                        "sense_id": "72733ca2-a607-35ee-80bc-97e280bd3b84",
                        "entry_id": "7f8f547a-24b1-3596-a91a-9f1f0216f2f3",
                        "glosses": [
                            "geheel van opvattingen waarmee je richting geeft aan je bestaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b0fa8e7-3a20-491c-ad25-82906d0ada6a",
                                "sense_id": "72733ca2-a607-35ee-80bc-97e280bd3b84",
                                "text": "Haar levensfilosofie was: „Eis het uiterste van jezelf – wacht niet op anderen.”"
                            },
                            {
                                "example_id": "5833cba3-626b-4b07-b00b-128c62f84d0d",
                                "sense_id": "72733ca2-a607-35ee-80bc-97e280bd3b84",
                                "text": "Wie aan spoken denkt, denkt aan geesten, aan de zielen van de doden die geen rust vinden; of, in andere levensfilosofieën misschien wel altijd aanwezig blijven."
                            },
                            {
                                "example_id": "25807bfc-191c-4a41-a037-0d2706da3372",
                                "sense_id": "72733ca2-a607-35ee-80bc-97e280bd3b84",
                                "text": "Het doet denken aan recente televisieprogramma's die onder de naam Robinson een soort Big Brother op zonnige eilandlocatie vertonen. Navolgers zoals al die schoolmeesters en ideologen als Wysz en Campe die het procédé van Defoe overnamen om hun persoonlijke levensfilosofietjes te ventileren."
                            }
                        ]
                    },
                    {
                        "sense_id": "05d6f4b5-88a9-3190-930a-15fa7eb40843",
                        "entry_id": "7f8f547a-24b1-3596-a91a-9f1f0216f2f3",
                        "glosses": [
                            "in de tweede helft van de 19e eeuw ontstane stroming waarin aan de creativiteit en dynamiek van het bestaan meer waarde wordt toegekend dan zich in rationele tradities laat vatten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1586f989-2ffd-42d6-a104-2cdc6c8c852c",
                                "sense_id": "05d6f4b5-88a9-3190-930a-15fa7eb40843",
                                "text": "Dat is te merken aan de antirationalistische levensfilosofie die aan Spenglers wereldbeeld ten grondslag ligt. Tegenover het bewuste ‘wakker-zijn’ staat bij hem het levende ‘bestaan’, tegenover de wereld als dode ‘natuur’ de wereld als ‘geschiedenis’, tegenover de mechanische ‘causaliteit’ de noodzakelijkheid van het ‘lot’."
                            }
                        ]
                    }
