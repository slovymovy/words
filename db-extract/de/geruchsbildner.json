                ],
                "senses": [
                    {
                        "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                        "entry_id": "22b538c6-3c7e-33e5-aae1-eefeff32d7aa",
                        "glosses": [
                            "Stoff, der Geruch bildet/abgibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c25c4354-2c3b-44af-b7e5-15032351dc6f",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "Im Vergleich zur herkömmlichen oxidativen Gaswäsche ist das Verfahren geeignet auch leichtflüchtige und schwer wasserlösliche Stoffe sowie Geruchsbildner aus der Abluft zu entfernen."
                            },
                            {
                                "example_id": "0bba5e2e-b90a-40c1-91ba-bc4cfcf51a65",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Das läßt die Vermutung zu, daß NII, durch andere Geruchsbildner verstärkt wird und diese bei der Geruchsbekämpfung von gleich wichtiger Bedeutung sind.“"
                            },
                            {
                                "example_id": "0dfba84d-4f12-4fea-801f-775e018b4025",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Die extraorale Halitosis wird in blood born und non-blood born unterschieden, je nachdem, ob die Geruchsbildner mit dem Blutstrom zur Lunge gelangen und dann abgeatmet werden oder direkt aus den Atemwegen stammen.“"
                            },
                            {
                                "example_id": "dfd8affd-337e-4ebe-a19e-cb327d6096c7",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Normale Zahnpasta enthält Tenside, die dafür sorgen, dass sie so schön schäumt, Konservierungsmittel, Geschmeidigmacher, Farben, Emulgatoren, Stabilisatoren, Geruchsbildner und auch Alkohole.“"
                            },
                            {
                                "example_id": "8c6b1f81-61e4-434b-ac2e-96ae04da63ce",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Aktinomyceten sind ausgesprochene Geruchsbildner und nicht selten für das verantwortlich, was gemeinhin als Schimmelgeruch bezeichnet wird.“"
                            },
                            {
                                "example_id": "f218f471-b0aa-400a-b546-cc2ad18eed89",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Die Literatur nennt die Steroide 5α-Androstenol und 5α-Androstenon als charakteristische Geruchsbildner.“"
                            },
                            {
                                "example_id": "dd609759-f1e4-4cbd-92bf-03b20264ec52",
                                "sense_id": "37fcec70-2cf7-3b1e-82fc-e43b332db29b",
                                "text": "„Dabei verbinden sich individuelle Geruchsbildner des Körpers mit den Parfümölen zu einem Gesamteindruck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
