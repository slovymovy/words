                        ],
                        "form": "sie sind jaulig"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8f5817e8-a904-3360-a4ad-5c35c8d7d05b",
                        "entry_id": "a2466512-2d6a-396b-ae6e-f79dfffc37df",
                        "glosses": [
                            "wie ein langer, klagender Ruf klingend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d549c97-1f9c-4db0-8647-11b719dee5b3",
                                "sense_id": "8f5817e8-a904-3360-a4ad-5c35c8d7d05b",
                                "text": "„Die androgyne Stimme des Sängers macht den Klang der Band einerseits interessant, andererseits ist es auf Dauer zu jaulig für den Alltagsgebrauch.“"
                            },
                            {
                                "example_id": "772a7b79-956c-4ed8-9da7-05f7063f4f8e",
                                "sense_id": "8f5817e8-a904-3360-a4ad-5c35c8d7d05b",
                                "text": "„Mit müde beschwipster Heiterkeit und einer nasal lauen, jaulig hohen Sprechnölstimme setzt Friebe seine Pop-Lyrics auf die Themen der Zeit an […].“"
                            },
                            {
                                "example_id": "f80cd4d2-3b36-4b42-b394-aa9664d3dd38",
                                "sense_id": "8f5817e8-a904-3360-a4ad-5c35c8d7d05b",
                                "text": "„Was wir hören, sind unaufregende Lieder und eine Stimme, die zuweilen so überkippend jaulig klingt, dass es schmerzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a1ee23b0-ed87-4718-8001-d3ccc12d1c55",
