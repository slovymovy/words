                "senses": [
                    {
                        "sense_id": "084141e3-c2e4-346b-8454-7519b349d808",
                        "entry_id": "1b459ab3-5c16-3eb1-bbbc-56d8253c992d",
                        "glosses": [
                            "нижняя часть крестца у человека или животного"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "250e284f-96c4-3733-8d01-ed4b7f591cad",
                        "entry_id": "1b459ab3-5c16-3eb1-bbbc-56d8253c992d",
                        "glosses": [
                            "перен. ягодицы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee1088a4-ac5a-4263-a1fa-33b8e071f852",
                                "sense_id": "250e284f-96c4-3733-8d01-ed4b7f591cad",
                                "text": "Под сборчатой черной юбкой, особенно женственно выделявшей перехват ее гибкой талии, кострецы выступали твердыми бугорками плавных очертаний."
                            }
                        ]
                    },
                    {
                        "sense_id": "0095a98c-688f-3534-91bb-3eb3e264ca47",
                        "entry_id": "1b459ab3-5c16-3eb1-bbbc-56d8253c992d",
                        "glosses": [
                            "верхняя часть бедра задней ноги животного"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "6178711f-cbeb-3f2a-b823-fc5ba30e31ae",
                        "entry_id": "1b459ab3-5c16-3eb1-bbbc-56d8253c992d",
                        "glosses": [
                            "травянистое растение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7367653f-9e16-4740-b882-b31e124fb882",
                                "sense_id": "6178711f-cbeb-3f2a-b823-fc5ba30e31ae",
                                "text": "У костреца Биберштейна и костреца Пампэлла в кусте преобладают корневищные побеги, у костреца берегового — ортотропные, а у костреца ангренского и костреца мелкочешуйного корневищные побеги совсем отсутствуют."
                            }
                        ]
                    }
                ],
