                    }
                ],
                "translations": [
                    {
                        "translation_id": "6ef5ff42-39ed-4457-a445-99813296e842",
                        "source_entry_id": "3163d05b-fc1a-3344-8c95-5cfb2f4f7f6c",
                        "source_sense_description": "a parish constable",
                        "target_lang_word": "dráb",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dráb",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "a2581fb7-f7a2-3933-acaa-8929af0f5b71",
                                        "entry_id": "45b75d83-7d98-3efa-a50e-7341004715ad",
                                        "glosses": [
                                            "uniformovaný sluha vykonávající úřední nařízení"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5715299c-547a-4367-84a5-de6cf5f93377",
                                                "sense_id": "a2581fb7-f7a2-3933-acaa-8929af0f5b71",
                                                "text": "Správce panství silůvského s celou desítkou osmahlých, v panských i vojenských službách zhrublých drábů stojí na poli a od slunce východu do slunce západu lomozí se před ním lid."
                                            },
                                            {
                                                "example_id": "36654fea-8290-4794-8beb-cd342f3daf2e",
                                                "sense_id": "a2581fb7-f7a2-3933-acaa-8929af0f5b71",
                                                "text": "Vyjede, zatočí kolem božích muk, vidí pod skalkou lípu, pod lípou drába s poklasným, po poli se jen hemží lidí, dráb už zdaleka hrozí holí a křičí. Josef nedbal křiku, zvolna dojel, a když se dráb na něho hnal, vytáhne z kapsy hodinky, podívá se na ně a praví: „Je zákon, že se panská práce koná od sedmi do sedmi, a ještě není sedm hodin.“"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68baf299-5532-330d-8d65-6733fe1fabf8",
                                        "entry_id": "45b75d83-7d98-3efa-a50e-7341004715ad",
                                        "glosses": [
                                            "pěší voják"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b421da43-f2c5-4691-8f60-e5d9343b1c31",
                                                "sense_id": "68baf299-5532-330d-8d65-6733fe1fabf8",
                                                "text": "Císař vtrhnuv s lidem do lesa, kterýž hradí všecku zemi, nalezl cesty dřívím zasekané — neboť tak byl Břetislav učiniti nařídil; protož rozkázal drábům svým, aby cestu vojsku sekerami proklestili a vypravili."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2f473314-1434-43c0-8ab1-cd98e01382ea",
                        "source_entry_id": "3163d05b-fc1a-3344-8c95-5cfb2f4f7f6c",
