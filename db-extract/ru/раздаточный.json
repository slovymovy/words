                "senses": [
                    {
                        "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                        "entry_id": "2c07938b-c890-3cb0-afde-44ce24e5def0",
                        "glosses": [
                            "относящийся к раздаче, связанный с раздачей чего-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32c16163-1d3c-4125-bad7-4683597e2177",
                                "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                                "text": "Раздаточный материал к экзамену по физике."
                            },
                            {
                                "example_id": "e476f1ed-44fd-4fef-87de-0eccb27857a0",
                                "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                                "text": "Раздаточный пункт."
                            },
                            {
                                "example_id": "2d32bb54-80e9-4a22-933a-5b225ee67437",
                                "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                                "text": "У остеклённой двери на кухню, рядом с раздаточным окошком, стоит Абдушидзе в поварском колпаке…"
                            },
                            {
                                "example_id": "325c8aa9-c38e-4ce9-9cb2-b0b6138c7153",
                                "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                                "text": "Раздаточная коробка."
                            },
                            {
                                "example_id": "2fb64efd-60c2-4dca-815a-23aad8474268",
                                "sense_id": "1a39dfb6-3a4e-3575-aee6-fa472b365633",
                                "text": "Раздаточный вал коробки передач."
                            }
                        ]
