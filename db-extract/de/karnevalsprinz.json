                "senses": [
                    {
                        "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                        "entry_id": "504f82a2-6818-37d9-8d2b-cbc0d8c019ca",
                        "glosses": [
                            "elegant kostümiertes männliches Oberhaupt der Narren und Repräsentant eines Karnevalsvereins, einer Kommune oder einer Region während der Karnevalszeit"
                        ],
                        "tags": [
                            "Karneval"
                        ],
                        "examples": [
                            {
                                "example_id": "3d5ea91b-8f19-481c-b47f-bb336c2bfdd5",
                                "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                                "text": "„Duisburger Narren haben einen Karnevalsprinzen für die Session 2026 gewählt.“"
                            },
                            {
                                "example_id": "90038953-ecb7-46e2-bc16-0693e7794772",
                                "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                                "text": "„Dort wird der künftige Karnevalsprinz samt Garde ab 19 Uhr bei freiem Eintritt der breiten Öffentlichkeit präsentiert.“"
                            },
                            {
                                "example_id": "e9ded10e-7ad9-42d2-9b7e-44870b012359",
                                "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                                "text": "„Der 25-Jährige wird der nächste Stolberger Karnevalsprinz.“"
                            },
                            {
                                "example_id": "c02028d5-448d-4319-a675-45da4b9133a9",
                                "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                                "text": "„Wer wird neuer Karnevalsprinz in Hoetmar?“"
                            },
                            {
                                "example_id": "8421955f-f310-4afd-8eb0-7e2c1a864804",
                                "sense_id": "4bb21306-eba3-3b76-80b7-c8a8a5ecd1b3",
                                "text": "„In der närrischen Zeit setzt Karnevalsprinz Alex I. ein besonderes Zeichen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
