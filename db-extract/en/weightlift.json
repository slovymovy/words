                        "source_sense_description": "to practise weightlifting as a form of physical recreation",
                        "target_lang_word": "жать",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "жать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "26e4f86a-bb4a-36b2-bf75-2b5c06fea349",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "давить, стискивать, сжимать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4938b24-878b-424a-8336-1c459cadabe1",
                                                "sense_id": "26e4f86a-bb4a-36b2-bf75-2b5c06fea349",
                                                "text": "Жать руку."
                                            },
                                            {
                                                "example_id": "ddd66a4a-f603-4e83-ab55-1b62bbe755b6",
                                                "sense_id": "26e4f86a-bb4a-36b2-bf75-2b5c06fea349",
                                                "text": "Жми на газ, Петька!"
                                            },
                                            {
                                                "example_id": "3324763b-95e9-4aa0-b8e5-5c203b5ac99b",
                                                "sense_id": "26e4f86a-bb4a-36b2-bf75-2b5c06fea349",
                                                "text": "Жать друг друга в толпе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91ba10bd-7fbf-3761-9944-0ebb24d51795",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "быть тесным, узким (об обуви, платье)"
                                        ],
                                        "tags": [
                                            "3-е л."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1451a639-fb77-477a-b449-12813f1af14d",
                                                "sense_id": "91ba10bd-7fbf-3761-9944-0ebb24d51795",
                                                "text": "Если новые туфли жмут, перед тем как надеть их на ноги, смочите это место одеколоном."
                                            },
                                            {
                                                "example_id": "be3867ce-35c7-47b1-9b43-6c3dbc06d285",
                                                "sense_id": "91ba10bd-7fbf-3761-9944-0ebb24d51795",
                                                "text": "Сапог ногу жмёт."
                                            },
                                            {
                                                "example_id": "eef9e1b3-e584-44e5-b49d-020011376307",
                                                "sense_id": "91ba10bd-7fbf-3761-9944-0ebb24d51795",
                                                "text": "Пиджак жмёт в плечах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4310fd18-7e4b-3a71-940c-a220768cdd3c",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "безл. о неудобстве, причиняемом тесной одеждой, обувью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f54066c7-8465-4676-8d68-18392ecee760",
                                                "sense_id": "4310fd18-7e4b-3a71-940c-a220768cdd3c",
                                                "text": "В плечах жмёт."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f66016c7-953b-3cc3-b0de-daea3053ddec",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "с.-х. давить с целью получения сока"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9545ba32-f734-4bc5-adaf-58ab760949e4",
                                                "sense_id": "f66016c7-953b-3cc3-b0de-daea3053ddec",
                                                "text": "Жать сок из винограда."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c519c60b-7232-319c-af48-8d2dd99c9f52",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "перен., разг. притеснять, угнетать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3584e7c6-6305-4cf2-8e97-de723da2d89b",
                                                "sense_id": "c519c60b-7232-319c-af48-8d2dd99c9f52",
                                                "text": "Английские власти в Индии нещадно жмут крестьян."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73268590-2b93-3937-9b98-c6c6f387e1de",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "перен., разг. вызывать необходимость в спешке, поджимать"
                                        ],
                                        "tags": [
                                            "3-е л."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ba1a0e34-3d40-46f2-a9f2-eb452068e97d",
                                                "sense_id": "73268590-2b93-3937-9b98-c6c6f387e1de",
                                                "text": "Подскажите, пожалуйста, побыстрей и поподробней, сроки жмут!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3e1ebb47-f08d-336a-87b5-f03253131cb3",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "разг. спешить, действовать быстро и энергично"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89fcc3b0-40a2-4f8f-9ca3-aedef43b659b",
                                                "sense_id": "3e1ebb47-f08d-336a-87b5-f03253131cb3",
                                                "text": "Говорю шоферу: «Жми по дороге, а я скажу, когда нужно будет свернуть.»"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b2bade7-f287-34a8-b5bd-d3126bc0e30b",
                                        "entry_id": "f9dddef3-5de9-3f3e-8a82-48a4eaf369ca",
                                        "glosses": [
                                            "спорт., разг. в тяжёлой атлетике — выполнять жим"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "жать",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                        "entry_id": "9fea120e-115f-3ab9-838e-a8bd7e505c9d",
                                        "glosses": [
                                            "с.-х. среза́ть под корень (стебли хлебных растений), убирать урожай зерновых"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cbb6adfc-77a3-4ef6-a2c7-bc1ff80fee28",
                                                "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                                "text": "Сегодня в районе уже жнут пшеницу."
                                            },
                                            {
                                                "example_id": "3869cf97-fc9a-41c6-aa99-0b6d6d480cf3",
                                                "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                                "text": "Еще не кончили жать, а на току уже появилась молотилка."
                                            },
                                            {
                                                "example_id": "9088348e-99ca-4b08-99fa-a5f4b03510e6",
                                                "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                                "text": "Ребенок скоро успокоился, заснул, мать положила его в люльку, взяла серп и принялась жать с особенным усилием, чтобы догнать своих подруг, чтоб не отстать от других."
                                            },
                                            {
                                                "example_id": "966567bd-e3b6-4c48-80bf-5acd990c6114",
                                                "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                                "text": "Если престанем проливать пот на земле; то по необходимости будем жать терние."
                                            },
                                            {
                                                "example_id": "c912681e-45eb-48ab-9139-21d2869a4f5e",
                                                "sense_id": "9ed4a81c-9dee-3699-886a-61b174f362c6",
                                                "text": "Ненилка-та — красавица и молода, а сама себя хранит как стеклянну посуду. А работница! Бают, жать подёт, дак двенадцать суслонов на упряг."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
