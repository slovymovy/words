                            {
                                "example_id": "25a54880-f2ec-48d3-8fac-0faf8cbddf9e",
                                "sense_id": "f04b642e-7916-3a7e-af59-382b66f069f8",
                                "text": "Fleming meent dat de beslissing op korte termijn een normale functionering in Genk tot gevolg zal hebben. „Tevens is het de basis om te komen tot een sociaal plan voor diegenen die de onderneming zullen moeten verlaten. Op langere termijn komt het erop neer dat we ons allemaal achter de doelstelling moeten scharen om van Genk het beste te maken wat er in zijn activiteitsgebied te vinden is.”"
                            }
                        ]
                    },
                    {
                        "sense_id": "e3321433-274f-3c47-9aeb-19ba2eca8010",
