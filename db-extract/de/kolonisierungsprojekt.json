                "senses": [
                    {
                        "sense_id": "07b6210e-5622-3c9d-a22b-3da9688a54f4",
                        "entry_id": "2f423b28-3a97-3b0c-afd1-9885865300f0",
                        "glosses": [
                            "Vorhaben, ein Gebiet zu kolonisieren, Kolonien zu errichten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eec2f19d-8b2f-4837-9095-2db57eb345d0",
                                "sense_id": "07b6210e-5622-3c9d-a22b-3da9688a54f4",
                                "text": "„Die Tatsache, dass die Vertreiber im Zuge eines Kolonisierungsprojektes neu ins Land kamen, stellt den Fall Palästina in einen Zusammenhang mit der Kolonialgeschichte ethnischer Säuberungen in Nord- und Südamerika, Afrika und Australien, wo weiße Siedler regelmäßig solche Verbrechen begingen.“"
                            },
                            {
                                "example_id": "03f13481-80cd-4e7e-924a-11d4ba4fd62a",
                                "sense_id": "07b6210e-5622-3c9d-a22b-3da9688a54f4",
                                "text": "„Bevor die zionistische Bewegung die Unterstützung Großbritanniens erhielt, war sie ein Kolonisierungsprojekt auf der Suche nach einer Großmacht als Schirmherrin.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
