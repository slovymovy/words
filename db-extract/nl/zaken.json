                                    },
                                    {
                                        "sense_id": "4d0d95ba-b9dc-32e5-9094-fcf99bd41245",
                                        "entry_id": "5ebb0490-a461-3a9d-b44f-2cf715d3c4ce",
                                        "glosses": [
                                            "Disruptive shenanigans."
                                        ],
                                        "tags": [
