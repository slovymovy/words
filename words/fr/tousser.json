            "pos": "verb",
            "senses": [
                {
                    "sense_id": "54f3b232-dfa2-3277-816f-701d8cdaad62",
                    "sense_definition": "Avoir un accès de toux, expulser bruyamment l'air des poumons par suite d'une irritation ou d'une maladie.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "physiologie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'enfant est malade et <w>tousse</w> depuis hier soir."
                        },
                        {
                            "text": "La fumée du feu de bois me fait <w>tousser</w>."
                        }
                    ],
                    "common_phrases": [
                        "faire tousser"
                    ]
                },
                {
                    "sense_id": "25b75eb6-e68b-3511-8176-1b6b346fe0d5",
                    "sense_definition": "Faire volontairement un bruit de toux pour avertir quelqu'un ou attirer son attention.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "communication",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a <w>toussé</w> discrètement pour prévenir son collègue du danger."
                        },
                        {
                            "text": "Elle <w>tousse</w> pour rappeler sa présence dans la pièce."
                        }
                    ],
                    "synonyms": [
                        "toussoter"
                    ],
                    "common_phrases": [
                        "tousser discrètement"
                    ]
                },
                {
                    "sense_id": "11d78434-0e4e-3c8c-a04b-541452b54377",
                    "sense_definition": "Émettre un bruit irrégulier et saccadé analogue à une toux, en parlant d'un moteur ou d'une machine.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bruit_moteur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieux moteur de la voiture a <w>toussé</w> avant de s'arrêter."
                        },
                        {
                            "text": "La tondeuse <w>tousse</w> un moment puis démarre enfin."
                        }
                    ],
                    "synonyms": [
                        "ratatouiller"
                    ],
                    "common_phrases": [
                        "moteur qui tousse"
                    ]
                },
                {
                    "sense_id": "54d1b829-43f6-3780-bfc5-a86312482b89",
                    "sense_definition": "Manifester de la gêne, de la réserve ou de l'indignation face à des propos ou une situation inattendue.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "reaction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette augmentation brutale des tarifs a fait <w>tousser</w> les clients."
                        },
                        {
                            "text": "Plusieurs députés <w>toussent</w> devant les nouvelles mesures annoncées."
                        }
                    ],
                    "synonyms": [
                        "tiquer",
                        "protester"
                    ],
                    "common_phrases": [
                        "faire tousser"
                    ]
                },
                {
                    "sense_id": "ccc6e596-5c6b-36b4-9681-50c80028d3a0",
