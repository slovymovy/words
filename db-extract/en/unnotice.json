                        "glosses": [
                            "To cease to notice."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "0af23dbb-0f08-4193-aac7-0167334d7ad3",
                                "sense_id": "31452bcf-672a-32e9-b65a-7d7f676506b0",
                                "text": "He put a “then” at the end of most sentences. Long ago William T. had noticed this vocal peculiarity and now he could not unnotice it."
                            },
                            {
                                "example_id": "f220c423-2d59-457f-b7ec-ef4998cfce75",
                                "sense_id": "31452bcf-672a-32e9-b65a-7d7f676506b0",
                                "text": "“Don't we know it!” Mrs. Henderson exclaimed. She exclaimed almost every short thing she said, and now that it'd been noticed, Mercy couldn't unnotice it."
                            }
                        ]
                    }
