                        ],
                        "examples": [
                            {
                                "example_id": "46228b2a-3156-4633-9f0b-677458d296f1",
                                "sense_id": "cc32c2bc-f222-30b0-9735-5bafeaa952b7",
                                "text": "Les maisons blanches, couvertes d’échandole, se montrent de ci de là, étagées aux flancs des côteaux entourés de vergers."
                            },
                            {
                                "example_id": "8518e6e0-3f15-4c11-8577-202a6f5e5ff6",
                                "sense_id": "cc32c2bc-f222-30b0-9735-5bafeaa952b7",
                                "text": "Il monte à l’échelette, entre au grenier à tâtons, tâte au long de l’échandole, et fait choir le pot à plumes, qui se brise en cent morceaux."
                            },
                            {
                                "example_id": "6c07826f-761c-4e62-ab31-5d15e8592a67",
                                "sense_id": "cc32c2bc-f222-30b0-9735-5bafeaa952b7",
                                "text": "L’échandole est, chez nous, l’équivalent de l'ardoise. Ces minces bardeaux étaient taillés par le père et les fils, qui en coupaient jusqu’à mille par jour."
                            }
                        ]
                    }
