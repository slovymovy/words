                ],
                "senses": [
                    {
                        "sense_id": "585fe106-c5e4-308b-ad3b-e7a58ca02fa0",
                        "entry_id": "d2f7c2f1-a00f-3afa-8a33-8d5a46cfdcfd",
                        "glosses": [
                            "разг. микроволновая печь"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "716595f9-b977-41ed-b594-0e1486a0e643",
                                "sense_id": "585fe106-c5e4-308b-ad3b-e7a58ca02fa0",
                                "text": "Теперь каждый грешник может предаваться обжорству круглыми сутками, просто вытащив еду из холодильника и засунув её в микроволновку."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "16671047-b57f-42b3-b386-0640c8399ee3",
                        "source_entry_id": "d2f7c2f1-a00f-3afa-8a33-8d5a46cfdcfd",
                        "source_sense_id": "585fe106-c5e4-308b-ad3b-e7a58ca02fa0",
                        "target_lang_word": "microwave",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "microwave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                        "entry_id": "4a92e3cd-0992-3bf2-aba4-4c72ac0e35ba",
                                        "glosses": [
                                            "An electromagnetic wave with wavelength between that of infrared light and radio waves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "efcb1fd4-9d4b-4366-bba8-10dadf0fa63d",
                                                "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                                "text": "Many radar systems use a combination of radio waves and microwaves."
                                            },
                                            {
                                                "example_id": "987f0202-bc57-4a98-9c78-19a9322fa3b9",
                                                "sense_id": "12753416-62ee-3e3e-adf8-e02c33f4c877",
                                                "text": "Microwaves do not follow the curvature of the earth, but travel in a straight line. They must therefore have unobstructed \"line of sight\" and the dish aerials have to be sited on towers or high buildings, on high ground, or a combination of all three."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88f5e0bc-d68d-312f-8300-7090555fe876",
                                        "entry_id": "4a92e3cd-0992-3bf2-aba4-4c72ac0e35ba",
                                        "glosses": [
                                            "Ellipsis of microwave oven."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1db7154e-b2a9-4f7c-80e0-a3945d986653",
                                                "sense_id": "88f5e0bc-d68d-312f-8300-7090555fe876",
                                                "text": "Just put it in the microwave for 30 seconds and it's ready to eat."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "microwave",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "363d8b5f-8c02-3ea3-924c-1a804c3b717a",
                                        "entry_id": "b0c085f3-34d0-3b56-b9f9-9850bb2720e8",
                                        "glosses": [
                                            "To cook (something) in a microwave oven."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "de866134-f8a2-4108-a4db-162c98d6da9a",
                                                "sense_id": "363d8b5f-8c02-3ea3-924c-1a804c3b717a",
                                                "text": "A vengeful mother-of-three has been jailed for 168 days after being convicted of killing a neighbour's kitten by microwaving the 10-week-old pet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0b132ad-c5a6-3edd-b862-78af44185eae",
                                        "entry_id": "b0c085f3-34d0-3b56-b9f9-9850bb2720e8",
                                        "glosses": [
                                            "To provide minimal preparation for implementation, deeming full or extensive preparation as unnecessary."
                                        ],
                                        "tags": [
                                            "slang",
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ca883f4b-a7d4-4eea-b198-6e4f437e085d",
                        "source_entry_id": "d2f7c2f1-a00f-3afa-8a33-8d5a46cfdcfd",
