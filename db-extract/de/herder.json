                ],
                "senses": [
                    {
                        "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                        "entry_id": "b0f394c2-295a-3a1a-a8a7-4e6b5c092eda",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "df58de3d-44f8-4e78-9419-5c5583c7de7b",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Frau Herder ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "a0fec70e-6995-4bc0-b3fe-b9663b9001a0",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Herr Herder wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "42367c41-fb67-490c-9f74-e406d8a9a9bc",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Die Herders fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "d4e614ce-394a-4c25-aaaf-a753f3f5ced2",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Der Herder trägt nie die Schals, die die Herder ihm strickt."
                            },
                            {
                                "example_id": "9953435b-8bc4-4d76-9260-f8f9aee390fe",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Herder kommt, geht der Herr Herder.“"
                            },
                            {
                                "example_id": "1672833a-4878-4bff-a961-fddb9b1e2d37",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Herder kommt und geht."
                            },
                            {
                                "example_id": "90ceef6e-04aa-42a7-9e99-d10b44b70f2a",
                                "sense_id": "9609c859-1d01-3e32-b9fc-32bfac385946",
                                "text": "Herders kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
