                "senses": [
                    {
                        "sense_id": "a2bae426-58cf-3b40-a35c-c9850d5d18d2",
                        "entry_id": "afcc8fa0-31a6-32c2-bcab-4e2f45eea0c3",
                        "glosses": [
                            "Pêcher le poisson de mer dans une écluse à poissons, à la marée basse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4c440736-5132-434a-a7b9-9c9c44030b1a",
                                "sense_id": "a2bae426-58cf-3b40-a35c-c9850d5d18d2",
                                "text": "Les Oléronais allaient à la pêche à pied, posaient des filets, et mareyaient leurs écluses."
                            },
                            {
                                "example_id": "c6ce1a35-d2df-4a95-a689-9a72c9bc622c",
                                "sense_id": "a2bae426-58cf-3b40-a35c-c9850d5d18d2",
                                "text": "Celle des pêcheurs d’écluses, rythmée par les deux marées quotidiennes quand la pêcherie égoutte et leur permet de mareyer le poisson."
                            }
                        ]
                    },
                    {
                        "sense_id": "b51e6803-2166-36af-81b8-21c875c307e7",
                        "entry_id": "afcc8fa0-31a6-32c2-bcab-4e2f45eea0c3",
                        "glosses": [
                            "Vendre (du poisson de mer)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be42ce25-c9df-4055-87be-55e6bf55fd54",
                                "sense_id": "b51e6803-2166-36af-81b8-21c875c307e7",
                                "text": "Ils ne passent pas à la coopérative car ils possèdent leur organisation propre « Méditerranée-Marée » et mareyent eux-mêmes leur poisson."
                            },
                            {
                                "example_id": "d0fea5f9-06a5-472b-9deb-4ccda4ff8cd1",
                                "sense_id": "b51e6803-2166-36af-81b8-21c875c307e7",
                                "text": "Un appel à ne pas sortir les bateaux, à ne pas vendre de poisson, ou encore à ne pas mareyer pour dénoncer des \"réglementations européennes inadaptées\" et les prix toujours élevés du gazole."
                            },
                            {
                                "example_id": "7b0a7a05-f6b7-4fdf-8626-2106bc852d2c",
                                "sense_id": "b51e6803-2166-36af-81b8-21c875c307e7",
                                "text": "Ainsi, plus de 50% des volumes de crevettes débarquées en Casamance sont « mareyés » dans les usines pour le marché d’exportation."
                            }
                        ]
                    }
                ],
