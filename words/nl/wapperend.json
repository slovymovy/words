                            "trait_type": "form",
                            "comment": "present participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Present participle of to flap, flutter, or wave.",
                        "fr": "Participe présent du verbe wapperen (flotter, agiter)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "flapping",
                                "target_lang_sense_clarification": "moving back and forth"
                            },
                            {
                                "target_lang_word": "waving",
                                "target_lang_sense_clarification": "swinging or moving in the air"
                            },
                            {
                                "target_lang_word": "fluttering",
                                "target_lang_sense_clarification": "moving lightly back and forth"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "en flottant",
                                "target_lang_sense_clarification": "au vent"
                            },
                            {
                                "target_lang_word": "en agitant",
