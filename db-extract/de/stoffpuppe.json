                "senses": [
                    {
                        "sense_id": "d3285366-9dda-3c6f-b9bc-4c01c7e08d6d",
                        "entry_id": "f347bd0d-63f4-39f7-a894-9b21aa320e89",
                        "glosses": [
                            "aus Textilien gefertigte Puppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "901a64a4-31c0-4f13-9527-8241846d622e",
                                "sense_id": "d3285366-9dda-3c6f-b9bc-4c01c7e08d6d",
                                "text": "„Er benimmt sich so normal, wie das jemandem möglich ist, dessen Körper aufgeschlitzt und wie eine Stoffpuppe wieder zusammengeflickt wurde.“"
                            },
                            {
                                "example_id": "09b539a2-62f5-46f2-9c25-229a1a3c2b1e",
                                "sense_id": "d3285366-9dda-3c6f-b9bc-4c01c7e08d6d",
                                "text": "„Sie versuchte, das Mädchen hochzuheben, doch es war schlaff wie eine Stoffpuppe.“"
                            },
                            {
                                "example_id": "e1eb9374-92da-4b55-a2b2-55d47a05ae8b",
                                "sense_id": "d3285366-9dda-3c6f-b9bc-4c01c7e08d6d",
                                "text": "„Die Explosion schleuderte mich wie eine Stoffpuppe durch die Luft, wobei mein linker Fuß hin und her schlackerte und weißglühende Blitze durch mein Bein zuckten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31dfec84-97a5-4c99-8369-bd63d9f49669",
