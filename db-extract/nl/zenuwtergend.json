                "senses": [
                    {
                        "sense_id": "f4859d09-b7c0-34b4-b1de-272cc8b253ef",
                        "entry_id": "0d6c1813-576a-3b19-8a09-a090ccb35909",
                        "glosses": [
                            "van iets dat het van heel slechte kwaliteit is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62b06fa8-1082-4c33-8df5-88e1d843855c",
                                "sense_id": "f4859d09-b7c0-34b4-b1de-272cc8b253ef",
                                "text": "Roberts kon voor Erin Brockovich bovendien rekenen op het bedreven vakmanschap van Steven Soderbergh. Het wanhopige smoelenwerk van Barrymore kent daarentegen geen maat en wordt door het zenuwtergende geklooi van de regisseur, Penny Marshall, zo mogelijk nog meer in de verf gezet. Marshall, die in het verleden met komische vodden als Big en A league of their own hooguit kon charmeren, tekent deze keer voor een stomvervelend en waardeloos melodrama."
                            },
                            {
                                "example_id": "07640246-4c58-42b6-94a5-8ec9ef8553b4",
                                "sense_id": "f4859d09-b7c0-34b4-b1de-272cc8b253ef",
                                "text": "De oorspronkelijke sciencefictiontrilogie van George Lucas steekt nog altijd ver uit boven de zenuwtergende actievehikels, waarmee de Amerikaanse producent en zelfverklaarde regisseur een vervolg meende te moeten breien aan zijn technologisch baanbrekende en legendarische merchandisingmachine."
                            }
                        ]
                    }
