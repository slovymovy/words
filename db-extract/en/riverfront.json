                        "translation_id": "4d85eeac-491d-4dc7-9a38-3657fbbd9075",
                        "source_entry_id": "5219b860-e992-3bdc-affd-1e36f2c3ab79",
                        "source_sense_id": "ea175f5c-d6df-3bc2-94de-a27e4986c1aa",
                        "source_sense_description": "Flussufer",
                        "target_lang_word": "Flussufer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Flussufer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                        "entry_id": "d9c6f5d8-7e54-3fc9-9ccd-c51074a0f1cf",
                                        "glosses": [
                                            "das Ufer eines Flusses"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe038b73-f9be-4ea2-96ac-426cd3324be8",
                                                "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                                "text": "Sie saßen am Flussufer und schauten aufs Wasser."
                                            },
                                            {
                                                "example_id": "6f6feefa-b7f9-4e54-bee2-2874197b9962",
                                                "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                                "text": "„Über den Bäumen am jenseitigen Flussufer sah Macomber Geier kreisen und steil herabstoßen.“"
                                            },
                                            {
                                                "example_id": "76f06a0f-10a2-4dd1-a5fd-9db93af60ec4",
                                                "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                                "text": "„Wir gingen zurück nach Wapping und aßer in einem Pub am Flussufer namens Prospect of Whitby zu Mittag."
                                            },
                                            {
                                                "example_id": "3b4ea8ca-2d40-4abe-a5f6-a727328797a5",
                                                "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                                "text": "„Er ging vor Morgengrauen fort, und wir fanden Unterschlupf in einem leeren Blockhaus am Flussufer, wo wir den Tag verbrachten.“"
                                            },
                                            {
                                                "example_id": "ead48b54-f616-406f-bcf5-ddbf551c0e30",
                                                "sense_id": "e2f3f50b-5172-3f84-9bc8-73c7c55fe10b",
                                                "text": "„Ein Vortrupp berichtete, sie hätten Kosaken auf den Hängen am Flussufer gesehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
