                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "6c15cb71-d3c0-3d51-9836-4fb3b5c441b6",
                                        "entry_id": "bcad6b52-da6b-3855-944b-ef08f1100d2c",
                                        "glosses": [
                                            "dumme, einfältige (bisweilen auch sonderliche) Person"
                                        ],
                                        "tags": [
                                            "übertragen, umgangssprachlich, zu [1]",
                                            "Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "053eef78-7899-4ba7-8ee5-ff68da182dc1",
                                                "sense_id": "6c15cb71-d3c0-3d51-9836-4fb3b5c441b6",
                                                "text": "„Erst mal ’ne Oma haben, du Eimer!“"
                                            },
                                            {
                                                "example_id": "feb680cf-3fd6-4750-a988-4831eca7eb32",
                                                "sense_id": "6c15cb71-d3c0-3d51-9836-4fb3b5c441b6",
                                                "text": "„Nee, du Eimer, ich mein’ das Salz in der Werra.“"
                                            },
                                            {
                                                "example_id": "b0a4a6ba-bc11-4b2a-9929-ec12cb1911d5",
                                                "sense_id": "6c15cb71-d3c0-3d51-9836-4fb3b5c441b6",
                                                "text": "„Bis eben jene Evi ihn fragte: ‚Sachma, du Eimer, willze mich verarschen oder meinze dat jetz ernst?‘.“"
                                            }
                                        ],
