        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "56fe1521-af1e-3177-bf5b-8d768f2c82c2",
                    "sense_definition": "A cut of beef taken from the shoulder area of the animal.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "meat",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ground <w>chuck</w> is often used to make juicy hamburgers.",
