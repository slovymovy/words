                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cdc8e9a2-2686-3de1-b817-2ff5abee79b7",
                                        "entry_id": "7410995d-0c2d-3744-ad2a-f0bed22b38cb",
                                        "glosses": [
                                            "A ban on trade with another country."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d8db269-d167-46ae-93be-f10ea136fa93",
                                                "sense_id": "cdc8e9a2-2686-3de1-b817-2ff5abee79b7",
                                                "text": "Instead he [Jefferson] proposed an embargo, an end to all trade between America and England."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f7741957-ed1e-328b-83cd-dd4045c18bfb",
                                        "entry_id": "7410995d-0c2d-3744-ad2a-f0bed22b38cb",
                                        "glosses": [
                                            "A temporary ban on making certain information public."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3391f4-1cac-4cc4-a1b3-03e002ba7b61",
                                                "sense_id": "f7741957-ed1e-328b-83cd-dd4045c18bfb",
                                                "text": "This copy of the federal budget is under embargo until 2 p.m."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e82b0e0-f072-3692-826f-445a781b3868",
                                        "entry_id": "7410995d-0c2d-3744-ad2a-f0bed22b38cb",
                                        "glosses": [
                                            "A heavy burden or severe constraint on action or expenditure."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9d346b3-b6ec-415b-b04d-cf5b42f3c3b5",
                                                "sense_id": "8e82b0e0-f072-3692-826f-445a781b3868",
                                                "text": "They were delighted with the idea of their mamma having forgiven Louisa, but sorry, she thought, such a public proof of her pardon necessary as that of giving a party; for the sisters well knew how great an embargo it would lay on the purses of Helen and Georgiana;..."
                                            }
                                        ]
                                    }
                                ]
                            },
