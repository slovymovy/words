                                        "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                        "entry_id": "f29fec08-128e-3571-af7d-7a0397dd68da",
                                        "glosses": [
                                            "statt weich und biegsam zu bleiben, mit der Zeit holzartiger/holzig werden, als Pflanze einen Stamm entwickeln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8deba389-d76c-4e88-bea4-4c2fd438a3c3",
                                                "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                                "text": "„Manche Kräuter verholzen mit den Jahren. Das heißt, ihre Triebe entstehen nicht jedes Jahr aus dem Wurzelstock neu wie bei den Stauden, sondern sie entwickeln einen festen Stamm, aus dem sie im Frühling frisch austreiben.“"
                                            },
                                            {
                                                "example_id": "28c658f3-e520-496b-85a6-67b5a034fd4d",
                                                "sense_id": "2ee4d26f-e723-3612-8f22-b41d1b2851a7",
                                                "text": "„Ein Verstummter läßt nicht mit sich reden. Ich verlor die Freundlichkeit. Ich verholzte. Und ein Stück Holz bin ich geblieben, das Verstummen habe ich gründlich gelernt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
