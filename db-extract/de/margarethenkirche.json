                        "glosses": [
                            "verschiedenen Heiligen namens Margarete/Margareta geweihtes Gotteshaus, das für Gottesdienste genutzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2177d56b-9000-42dd-9c20-b4310ffe04d7",
                                "sense_id": "d216613f-d5e8-3b65-b039-73f4dae8f6d0",
                                "text": "„Die Magarethenkirche in Gotha ist eine Einrichtung der evangelisch lutherischen Gemeinde in Gotha.“"
                            },
                            {
                                "example_id": "660f0eb2-7e0f-431f-9c85-41c077565a21",
                                "sense_id": "d216613f-d5e8-3b65-b039-73f4dae8f6d0",
                                "text": "„Anschliessend Fahrt über Fagaras und Agnita nach Medias um die Margarethenkirchen zu sehen.“"
                            }
                        ],
