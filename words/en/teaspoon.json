{
    "word_family": [
        "teaspoonful"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "013815ad-ca55-3585-a9aa-353894f32cc3",
                    "sense_definition": "A small spoon used to stir the contents of a cup or glass.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cutlery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a <w>teaspoon</w> to stir the sugar into her hot tea.",
                            "target_lang_translations": {
                                "ru": "Она использовала <w>чайную ложку</w>, чтобы размешать сахар в горячем чае."
                            }
                        },
                        {
                            "text": "Please put a clean <w>teaspoon</w> on the saucer next to the coffee cup.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, положи чистую <w>чайную ложку</w> на блюдце рядом с кофейной чашкой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "silver teaspoon",
                        "stir with teaspoon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленькая ложка, используемая для перемешивания содержимого чашки или стакана."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайная ложка",
                                "target_lang_sense_clarification": "столовый прибор"
                            },
                            {
                                "target_lang_word": "ложечка",
                                "target_lang_sense_clarification": "уменьшительная форма"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b9b2294c-f1f9-3586-a7cc-736c2a179986",
                    "sense_definition": "A unit of measure, equivalent to one-third of a tablespoon or roughly five milliliters.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "measurement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The recipe calls for one <w>teaspoon</w> of salt and two cups of flour.",
                            "target_lang_translations": {
                                "ru": "По рецепту требуется одна <w>чайная ложка</w> соли и два стакана муки."
                            }
                        },
                        {
                            "text": "Add a <w>teaspoon</w> of vanilla extract to the cake batter for better flavor.",
                            "target_lang_translations": {
                                "ru": "Добавьте <w>чайную ложку</w> ванильного экстракта в тесто для торта для лучшего вкуса."
                            }
                        }
                    ],
                    "synonyms": [
                        "teaspoonful",
                        "tsp"
                    ],
                    "common_phrases": [
                        "teaspoon of salt",
                        "level teaspoon"
                    ],
                    "target_lang_definitions": {
                        "ru": "Единица измерения объема, равная одной трети столовой ложки или примерно пяти миллилитрам."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "чайная ложка",
                                "target_lang_sense_clarification": "мера объема"
                            },
                            {
                                "target_lang_word": "ложечка",
                                "target_lang_sense_clarification": "содержимое одной маленькой ложки"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "055033cb-957a-38a0-8978-dfdf3b241bdd",
                    "sense_definition": "To serve or move something using a teaspoon.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "serving",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I <w>teaspooned</w> some sugar into my cup very carefully.",
                            "target_lang_translations": {
                                "ru": "Я очень осторожно <w>насыпал чайной ложкой</w> немного сахара в свою чашку."
                            }
                        },
                        {
                            "text": "She <w>teaspooned</w> the medicine into the child's mouth.",
                            "target_lang_translations": {
                                "ru": "Она <w>влила чайной ложкой</w> лекарство в рот ребенку."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавать или перемещать что-либо с помощью чайной ложки."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "накладывать чайной ложкой",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "черпать чайной ложкой",
                                "target_lang_sense_clarification": "действие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}