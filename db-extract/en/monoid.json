                    {
                        "sense_id": "4b303188-f47f-3246-a904-4bc9161d01c5",
                        "entry_id": "82779043-7f8f-33ef-91b8-2e22f57ecba6",
                        "glosses": [
                            "A set which is closed under an associative binary operation, and which contains an element which is an identity for the operation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4df69e59-e960-4117-9c89-2bde94119b3d",
                                "sense_id": "4b303188-f47f-3246-a904-4bc9161d01c5",
                                "text": "Just like any abstraction, a monoid is useful to the extent we can write useful generic code assuming only the capabilities provided by the abstraction."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4c6ce311-d308-40e4-a104-9c48d1d8b3e2",
