                {
                    "sense_id": "7e19ecf6-6414-3e52-830d-573c4d9ce44f",
                    "sense_definition": "Dire des choses fausses, exagérées ou sans fondement sérieux.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "paroles",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne l'écoute pas, il adore <w>raconter</w> des bêtises pour attirer l'attention des autres.",
                            "target_lang_translations": {
                                "en": "Don't listen to him, he loves to <w>talk nonsense</w> to get other people's attention.",
                                "ru": "Не слушай его, он любит <w>нести чушь</w>, чтобы привлечь к себе внимание.",
                                "nl": "Luister niet naar hem, hij houdt ervan <w>onzin uit te kramen</w> om de aandacht van anderen te trekken.",
                                "de": "Hör nicht auf ihn, er <w>erzählt</w> gern Unsinn, nur um die Aufmerksamkeit der anderen auf sich zu lenken.",
                                "pl": "Nie słuchaj go, uwielbia <w>opowiadać bzdury</w>, żeby zwrócić na siebie uwagę innych.",
                                "it": "Non ascoltarlo, gli piace <w>raccontare balle</w> per attirare l'attenzione degli altri.",
                                "cs": "Neposlouchej ho, rád <w>plácá nesmysly</w>, jen aby na sebe přitáhl pozornost ostatních.",
                                "tr": "Ona kulak asma, başkalarının dikkatini çekmek için <w>saçmalamayı</w> çok sever.",
                                "es": "No le hagas caso, le encanta <w>decir tonterías</w> para llamar la atención de los demás.",
                                "zh": "别听他的，他就爱<w>胡说</w>，好引起别人的注意。"
                            }
                        },
                        {
                            "text": "Arrête de <w>raconter</w> n'importe quoi, je n'ai jamais dit une chose pareille !",
                            "target_lang_translations": {
                                "en": "Stop <w>talking nonsense</w>, I never said anything like that!",
                                "ru": "Перестань <w>нести чушь</w>, я никогда не говорил ничего подобного!",
                                "nl": "Hou op met <w>onzin uit te kramen</w>, ik heb nooit zoiets gezegd!",
                                "de": "Hör auf, so einen Quatsch zu <w>erzählen</w>, ich habe nie so etwas gesagt!",
                                "pl": "Przestań <w>opowiadać bzdury</w>, z moich ust nigdy nie padło nic podobnego!",
                                "it": "Smettila di <w>dire sciocchezze</w>, non ho mai detto una cosa del genere!",
                                "cs": "Přestaň <w>plácat nesmysly</w>, nikdy jsem něco takového neřekl!",
                                "tr": "<w>Saçmalamayı</w> bırak, ben böyle bir şey hiç söylemedim!",
                                "es": "¡Deja de <w>decir tonterías</w>, yo nunca he dicho nada parecido!",
                                "zh": "别再<w>胡说</w>了，我从来没说过这种话！"
                            }
                        }
                    ],
                    "common_phrases": [
                        "raconter des bêtises",
                        "raconter des salades",
                        "raconter des histoires"
                    ],
                    "target_lang_definitions": {
                        "en": "To say things that are false, exaggerated, or lacking any serious basis.",
                        "ru": "Говорить неправду, преувеличивать или нести вздор без серьёзных оснований.",
                        "nl": "Informeel: onwaarheden, overdrijvingen of onzin vertellen, zonder dat het serieus bedoeld is.",
                        "de": "Unwahres, Übertriebenes oder Unsinniges sagen, meist ohne ernste Absicht.",
                        "pl": "Potocznie: mówić nieprawdę, przesadzać lub wygadywać bzdury, zwykle bez poważnego zamiaru.",
                        "it": "Familiare: dire cose false, esagerate o prive di fondamento serio.",
                        "cs": "Hovorově: říkat nepravdy, přehánět nebo mluvit nesmysly, obvykle bez vážného úmyslu.",
                        "tr": "Gerçek dışı, abartılı ya da ciddi bir dayanağı olmayan şeyler söylemek. Günlük dilde kullanılır.",
                        "es": "Decir cosas falsas, exageradas o sin fundamento serio, generalmente de forma informal.",
                        "zh": "说假话、夸大其词或胡扯，语气多为口语化、不太严肃。"
                    },
