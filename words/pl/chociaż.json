                            }
                        },
                        {
                            "text": "Kupił cukier w sklepie, <w>chociaż</w> miał jeszcze całą torbę w domu.",
                            "target_lang_translations": {
                                "ru": "Он купил сахар в магазине, <w>хотя</w> дома у него был ещё целый пакет."
                            }
                        }
                    ],
