                "senses": [
                    {
                        "sense_id": "981844e0-caa9-3039-8f63-098392a1fa84",
                        "entry_id": "4d8e951d-981c-3817-ab51-deaf95f5cbec",
                        "glosses": [
                            "przyrząd, który odmierza upływ czasu"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c3dcd72-7239-405d-a083-5d5a9393628e",
                                "sense_id": "981844e0-caa9-3039-8f63-098392a1fa84",
                                "text": "Na wystawie zaprezentowano nowożytne czasomierze z Japonii i Chin."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "df5a8ec3-99f4-43c2-84bc-3c703e9bcbdd",
                        "source_entry_id": "4d8e951d-981c-3817-ab51-deaf95f5cbec",
                        "source_sense_id": "981844e0-caa9-3039-8f63-098392a1fa84",
                        "target_lang_word": "timekeeping",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "timekeeping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1c647d1d-f1d8-362b-bc3a-f854b276dfbc",
                                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                                        "glosses": [
                                            "The measurement of time, or determining what the local time is: the act or process of keeping the time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8a1e5e72-9535-312b-8c22-484b29912749",
                                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                                        "glosses": [
                                            "The measurement of time, or determining what the local time is: the act or process of keeping the time.",
                                            "Measuring and recording the time spent by employees on the clock, including the timepoints at which they clocked in and clocked out."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                        "entry_id": "f21092ac-f8cd-3e3a-979f-bddc671cc1ed",
                                        "glosses": [
                                            "The quality of being punctual, keeping to a set time."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45985aed-68e6-4917-8cb9-dedeaa2779f0",
                                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                                "text": "Timekeeping is better than on many Irish main lines; indeed, such delays as do occur are often attributable to late running of the Dublin-Sligo trains."
                                            },
                                            {
                                                "example_id": "f80902b8-bcdc-4322-b1a1-bc4f7de6f3e3",
                                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                                "text": "As already indicated, timekeeping is very poor. Point-to-point times are not kept, even with a clear road, and whilst fast running has never been a feature of the route because of the large number of junctions and speed restrictions, this Sunday night lethargy is hard to explain."
                                            },
                                            {
                                                "example_id": "083fc333-0acd-41fc-9e25-be177e7939c1",
                                                "sense_id": "cbf8c5af-9b20-32a0-ac4a-02112065d54c",
                                                "text": "Our correspondent found that timekeeping had suffered following the substitution of Class 5 4-6-0s on these workings."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "timekeeping",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "de2489c5-bf58-3764-b87d-f12c84b552d3",
                                        "entry_id": "c22a4dd8-3305-33e1-9661-6e5884828693",
                                        "glosses": [
                                            "present participle and gerund of timekeep"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "gerund",
                                            "participle",
                                            "present"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa44cba5-9d90-4747-a89a-a166b63989f1",
                        "source_entry_id": "4d8e951d-981c-3817-ab51-deaf95f5cbec",
                        "source_sense_id": "981844e0-caa9-3039-8f63-098392a1fa84",
                        "target_lang_word": "device",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "device",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a6441436-2664-3a55-a2fa-5e3b6410bf80",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "Any piece of equipment made for a particular purpose, especially a mechanical or electrical one."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c65c4dbf-b89b-456d-b653-6fac557b01ac",
                                                "sense_id": "a6441436-2664-3a55-a2fa-5e3b6410bf80",
                                                "text": "1949. Geneva Convention on Road Traffic Chapter VI. Provisions Applicable to Cycles in International Traffic\nEvery cycle shall be equipped with: … (b) an audible warning device consisting of a bell …"
                                            },
                                            {
                                                "example_id": "4bda7288-0f29-4602-8ffb-d1a0f0a1bf27",
                                                "sense_id": "a6441436-2664-3a55-a2fa-5e3b6410bf80",
                                                "text": "An artificial kidney these days still means a refrigerator-sized dialysis machine. Such devices mimic the way real kidneys cleanse blood and eject impurities and surplus water as urine."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72cd27fb-72fd-3497-8130-5e5dede4b21c",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "A peripheral device; an item of hardware."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "A project or scheme, often designed to deceive; a stratagem; an artifice. 1602, Shakespeare, The Merry Wives of Windsor. \\\"This is our device,/ That Falstaff at that oak shall meet with us.\\"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d7930b3-73cd-4ab2-aa39-65104de2312e",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "His device is against Babylon, to destroy it."
                                            },
                                            {
                                                "example_id": "333cb444-1a15-4fb8-87c4-53ffbbccaab6",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "He disappointeth the devices of the crafty, so that their hands cannot perform their enterprise."
                                            },
                                            {
                                                "example_id": "2e7de7b1-b398-431a-9f6d-ecc3df5d9bd8",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "Their recent device of demanding benevolences."
                                            },
                                            {
                                                "example_id": "c1236e82-fd1f-42fc-9138-d53e5ccba21a",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "So next day the hunting began. I did not know how to shoot, but I proceeded to learn. And when I had expended some thirty shells for three seals, I decided that the ammunition would be exhausted before I acquired the necessary knowledge. I had used eight shells for lighting fires before I hit upon the device of banking the embers with wet moss, and there remained not over a hundred shells in the box."
                                            },
                                            {
                                                "example_id": "86a8fc26-d486-44d3-af02-21feb40a1a5e",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "FOR a month Tarzan was a regular and very welcome devotee at the shrine of the beautiful Countess de Coude. […] More often Olga found devices that would give her an hour of Tarzan alone."
                                            },
                                            {
                                                "example_id": "619629a4-f6ab-4459-8d6f-2d53d8463637",
                                                "sense_id": "b4a836a8-bc65-3edb-ba89-5f0804ca0954",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e147fd67-bbf2-3c25-b076-dccafc2100a3",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "An improvised explosive device, home-made bomb"
                                        ],
                                        "tags": [
                                            "Ireland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebf354d5-90b2-47ba-9be3-b653ff668522",
                                                "sense_id": "e147fd67-bbf2-3c25-b076-dccafc2100a3",
                                                "text": "THE ARMY BOMB Disposal Team rendered safe a viable device in Cavan this afternoon."
                                            },
                                            {
                                                "example_id": "dd05da30-df0d-4ee2-bcd4-b020056e398a",
                                                "sense_id": "e147fd67-bbf2-3c25-b076-dccafc2100a3",
                                                "text": "Inflammable material is planted in my head / It's a suspect device that's left 2000 dead"
                                            },
                                            {
                                                "example_id": "d6274e81-de5b-4ae0-86d7-4f3f9d78fefd",
                                                "sense_id": "e147fd67-bbf2-3c25-b076-dccafc2100a3",
                                                "text": "The army bomb squad carried out two controlled explosions on the device. It was later found that the suspect device was a hoax and not a viable explosive."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9633200-9de9-359d-bd48-01ba140f60b3",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "A technique that an author or speaker uses to evoke an emotional response in the audience; a rhetorical device."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5d7ad8b-e081-443e-a87b-44cde4994c09",
                                                "sense_id": "c9633200-9de9-359d-bd48-01ba140f60b3",
                                                "text": "1736. O'Callaghan, Edmund Bailey. The Documentary History of the State of New York Chapter I, Article III: Enumeration of the Indian Tribes.\nThe devices of these savages are the serpent, the Deer, and the Small Acorn."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0850f9b0-52e9-33a3-bd57-20b29d6c5e56",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "A technique that an author or speaker uses to evoke an emotional response in the audience; a rhetorical device.\\n(heraldry) A motto, emblem, or other mark used to distinguish the bearer from others. A device differs from a badge or cognizance primarily as it is a personal distinction, and not a badge borne by members of the same house successively.",
                                            "A motto, emblem, or other mark used to distinguish the bearer from others. A device differs from a badge or cognizance primarily as it is a personal distinction, and not a badge borne by members of the same house successively."
                                        ],
                                        "tags": [
                                            "rhetoric"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7348eed3-67c9-38a5-b5f7-370d2f6ad67b",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "Power of devising; invention; contrivance."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "240d89de-011a-4316-9f2b-7625e4e16840",
                                                "sense_id": "7348eed3-67c9-38a5-b5f7-370d2f6ad67b",
                                                "text": "Moreover I must have instruments of mine own device, weighty, and exceeding costly"
                                            },
                                            {
                                                "example_id": "e5d25cb5-efb4-4123-a12f-20051ae036b4",
                                                "sense_id": "7348eed3-67c9-38a5-b5f7-370d2f6ad67b",
                                                "text": "And she said,\n\"We are all prisoners here,\nOf our own device\""
                                            },
                                            {
                                                "example_id": "25552c6f-b3e8-4459-b94d-ca20e2fd7805",
                                                "sense_id": "7348eed3-67c9-38a5-b5f7-370d2f6ad67b",
                                                "text": "I want to (I must) tell a story of a revelation in my life. His name is Vernon. We have known each other for 17 years, yet we are presently separated through no device of our own making."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f388b66-85dd-3b8c-80fb-d8eaa71fd21f",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "An image used in whole or in part as a trademark or service mark."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4dba9fcd-544d-3248-9e7b-8509e8ab2cf1",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "An image or logo denoting official or proprietary authority or provenience."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f29f127-d309-47f5-bab3-f15b1920b19f",
                                                "sense_id": "4dba9fcd-544d-3248-9e7b-8509e8ab2cf1",
                                                "text": "Prior to the issuance of the first stamps, letters accepted by postmasters for dispatch were marked \"Paid\" by means of pen and ink or hand stamps of various designs. … To facilitate the handling of mail matter, some postmasters provided special stamps or devices for use on letters as evidence of the prepayment of postage."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68fac3fd-6cb4-35bc-ad83-1374b7c4d81c",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "Any specific class of wordplay element in a cryptic crossword."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "31c55e1a-1dc0-45a2-bb43-e1a0b3d356d3",
                                                "sense_id": "68fac3fd-6cb4-35bc-ad83-1374b7c4d81c",
                                                "text": "These eight devices, and combinations thereof, account for nearly every kind of wordplay you will encounter in cryptic crosswords."
                                            },
                                            {
                                                "example_id": "852f7262-3c6e-48f4-abee-b7d1a1e68976",
                                                "sense_id": "68fac3fd-6cb4-35bc-ad83-1374b7c4d81c",
                                                "text": "Discovering these variants is much of the fun. All the devices can be combined and twisted to produce surface readings in each clue which point you in the wrong direction."
                                            },
                                            {
                                                "example_id": "fb7f1eca-9394-40da-8748-f1d6960ee59f",
                                                "sense_id": "68fac3fd-6cb4-35bc-ad83-1374b7c4d81c",
                                                "text": "As with all varieties of cryptic clues, the container device can be used in conjunction with other devices, especially in more complex cryptic crosswords."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e8302f72-b403-3045-9bcf-d2af9f2b0eb9",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "A spectacle or show."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eb5be278-b14a-4eb7-b53b-2b6885b0aac9",
                                                "sense_id": "e8302f72-b403-3045-9bcf-d2af9f2b0eb9",
                                                "text": "It will be out of faſhion to weare ſwords, / Maſques, and devices welcome, I ſalute you […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "444673d5-ef94-3d9c-8199-4792e6786886",
                                        "entry_id": "236d8dc0-f94a-345c-87f0-9b056e9a612c",
                                        "glosses": [
                                            "Opinion; decision."
                                        ],
