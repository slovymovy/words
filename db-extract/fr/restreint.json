                        "sense_id": "209de719-50dd-3c27-b204-9bfc186e9a2d",
                        "entry_id": "73c88556-c188-3da2-90fa-dba8159dd02d",
                        "glosses": [
                            "Troisième personne du singulier du présent de restreindre."
