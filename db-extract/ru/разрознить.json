                    }
                ],
                "senses": [
                    {
                        "sense_id": "ef8701cd-604d-34cd-b95f-f20de2d8a01a",
                        "entry_id": "76e0916e-bf88-32ae-b090-b519f7240490",
                        "glosses": [
                            "нарушить целостность, единство"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "636f7685-92bd-343f-b782-6734154ec524",
                        "entry_id": "76e0916e-bf88-32ae-b090-b519f7240490",
                        "glosses": [
                            "разъединить, разобщить, внести рознь"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "36b3ab26-a952-4819-8f8b-ab323df81eb7",
                        "source_entry_id": "76e0916e-bf88-32ae-b090-b519f7240490",
                        "target_lang_word": "diviser",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "diviser",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "21d118ae-e4b9-353c-89fd-be91634f631a",
                                        "entry_id": "7d670308-2604-3514-9a83-f40b74868c6d",
                                        "glosses": [
                                            "Séparer en parties ; morceler ; fractionner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4067fb7a-cb94-415f-94ad-793f7b8a4cdc",
                                                "sense_id": "21d118ae-e4b9-353c-89fd-be91634f631a",
                                                "text": "Des trois bandes ou régions qui divisaient devant nous la plaine d’Athènes, nous traversâmes les deux premières, la région inculte et la région cultivée."
                                            },
                                            {
                                                "example_id": "63dc6ede-5efb-436a-88c2-cd34b97b46ed",
                                                "sense_id": "21d118ae-e4b9-353c-89fd-be91634f631a",
                                                "text": "Chaque contingent du guîch forme une r’ha sous les ordres d’un caïd et est divisée, comme les tabor de l’âsker, en groupes de cent hommes."
                                            },
                                            {
                                                "example_id": "e2a4d09b-967d-4e90-96ce-c0280962fd6e",
                                                "sense_id": "21d118ae-e4b9-353c-89fd-be91634f631a",
                                                "text": "Il est classique de diviser les molécules limitant l’œdème en deux familles, les imperméants et les colloïdes."
                                            },
                                            {
                                                "example_id": "88b52231-ad2b-428e-aedc-79e14325dc2b",
                                                "sense_id": "21d118ae-e4b9-353c-89fd-be91634f631a",
                                                "text": "Derrière la maison sied un terrain de cinquante ares qui borde un chemin sur une longueur de soixante mètres. Il est tout à fait possible de le diviser en parts égales et de proposer ainsi à la vente trois terrains à bâtir."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2af69b1d-b41b-363e-9076-a6e6e69f5e08",
                                        "entry_id": "7d670308-2604-3514-9a83-f40b74868c6d",
                                        "glosses": [
                                            "Séparer en parts égales. Appliquer l’opération mathématique permettant d’arriver à ce résultat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "810db106-09a9-4d82-85b0-ac7795712b83",
                                                "sense_id": "2af69b1d-b41b-363e-9076-a6e6e69f5e08",
                                                "text": "Diviser 99 par 9 donne 11."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7442de5d-55ea-3b0e-b569-187c0823b659",
                                        "entry_id": "7d670308-2604-3514-9a83-f40b74868c6d",
                                        "glosses": [
                                            "Mettre en discorde ; désunir."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22b862d2-1782-443d-94a1-a6ac128f9fc2",
                                                "sense_id": "7442de5d-55ea-3b0e-b569-187c0823b659",
                                                "text": "La zizanie semée entre des ennemis coalisés et supérieurs en forces, est de bonne guerre. Le maréchal de Maillebois n'avait rien négligé en 1745 pour diviser ainsi les Autrichiens et les Piémontais."
                                            },
                                            {
                                                "example_id": "01271567-6355-4c58-a689-abc5bad63228",
                                                "sense_id": "7442de5d-55ea-3b0e-b569-187c0823b659",
                                                "text": "Les clans berbères sont divisés en çofs ou partis hostiles qui se disputent la prépondérance, souvent par une guerre au couteau; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b39fee5-9dcf-3732-8c63-5d499ad43745",
                                        "entry_id": "7d670308-2604-3514-9a83-f40b74868c6d",
                                        "glosses": [
                                            "Couper un mot à la fin d’une ligne, en se conformant aux règles établies."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "248716b8-dce3-4e09-a628-99adddd62de3",
                                                "sense_id": "2b39fee5-9dcf-3732-8c63-5d499ad43745",
                                                "text": "Diviser, c’est couper d’une ligne à la suivante, entre deux syllabes par la figure nommée division ; figure que malgré son identité il faut se garder de confondre avec le trait d’union, dont le rôle est de marquer l’union de plusieurs mots."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
