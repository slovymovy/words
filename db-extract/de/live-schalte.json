                                    {
                                        "sense_id": "35c01d9a-c26a-3a17-8b9d-5eeafb77e5e6",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Qui est droit, qui ne fait aucun détour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4ed75d30-2398-4495-93d8-4ba07abed19b",
                                                "sense_id": "35c01d9a-c26a-3a17-8b9d-5eeafb77e5e6",
                                                "text": "Édouard Voss tente de protester :\n— Si nous étions passés par l’Escarène, cela aurait été plus direct. J'ai vu la carte.\n— Monsieur le baron voudrait-il me faire croire que la voie est moins sinueuse ?"
                                            },
                                            {
                                                "example_id": "d1b91b2a-b13b-41fb-8914-dd42145b0470",
                                                "sense_id": "35c01d9a-c26a-3a17-8b9d-5eeafb77e5e6",
                                                "text": "Mouvement direct. — En ligne directe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c0a0268-5f9f-30bb-a980-41ec905ed541",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Sans détour."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "559f62be-5f2f-4c7b-80bc-ae090694f3b5",
                                                "sense_id": "4c0a0268-5f9f-30bb-a980-41ec905ed541",
                                                "text": "Un regard direct."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a98b4c7f-fb79-3054-8a74-07e867e86f45",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Qui se fait sans intermédiaire ou sans étapes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cafa1d45-ce0a-402d-bd93-0f8befe65869",
                                                "sense_id": "a98b4c7f-fb79-3054-8a74-07e867e86f45",
                                                "text": "Train direct, train de chemin de fer qui va d’un endroit à un autre sans s’arrêter aux stations intermédiaires, ou en ne s’arrêtant qu’à certaines d’entre elles."
                                            },
                                            {
                                                "example_id": "5b767188-9d8f-4f49-8884-c181b16616f6",
                                                "sense_id": "a98b4c7f-fb79-3054-8a74-07e867e86f45",
                                                "text": "Une vente directe."
                                            },
                                            {
                                                "example_id": "354cb64c-7d65-46a4-8bad-9aacd4445a14",
                                                "sense_id": "a98b4c7f-fb79-3054-8a74-07e867e86f45",
                                                "text": "Un vol direct vers Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e29de95a-490e-35a3-a52c-a3606f6eff7a",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "En termes de sports,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f67d51b-04e5-4e96-9711-1bc28d7427f2",
                                                "sense_id": "e29de95a-490e-35a3-a52c-a3606f6eff7a",
                                                "text": "Un coup direct, ou, par abréviation, un direct, un coup de poing empruntant la ligne droite."
                                            },
                                            {
                                                "example_id": "9e2d24f4-512c-4093-8be2-5559c00de527",
                                                "sense_id": "e29de95a-490e-35a3-a52c-a3606f6eff7a",
                                                "text": "Deux directs, droite gauche, firent tomber le géant."
                                            },
                                            {
                                                "example_id": "88cd8348-720e-4669-9086-db729e21e4fc",
                                                "sense_id": "e29de95a-490e-35a3-a52c-a3606f6eff7a",
                                                "text": "Jean voulut intervenir, mais il fut interrompu par la vision de Lucien recevant un direct, on vit voler les postillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9977862-4d57-3fe1-b295-d07d544b068c",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Immédiat, sans intermédiaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "19d260c3-8435-432b-b168-338a489421d3",
                                                "sense_id": "f9977862-4d57-3fe1-b295-d07d544b068c",
                                                "text": "Rapport direct."
                                            },
                                            {
                                                "example_id": "6bb093c0-08c2-49f5-b3ae-c3cdd2024baa",
                                                "sense_id": "f9977862-4d57-3fe1-b295-d07d544b068c",
                                                "text": "Correspondance directe."
                                            },
                                            {
                                                "example_id": "c11145ae-b3fe-4153-961f-582dafd7d66d",
                                                "sense_id": "f9977862-4d57-3fe1-b295-d07d544b068c",
                                                "text": "Il me désigna ma place, qui était juste en face de celle de ma supérieure directe, mademoiselle Mori."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "16468f3f-7c5a-3b70-b765-88823705f41c",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "En termes d’Astronomie,"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2b976fa-fbd6-4427-bff9-9b4ae6a6062d",
                                                "sense_id": "16468f3f-7c5a-3b70-b765-88823705f41c",
                                                "text": "Mouvements directs, ceux qui sont dirigés de l’occident vers l’orient, comme le sont les mouvements de toutes les planètes et de leurs satellites dans le système solaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "df015a93-273d-3660-8e36-92f297a53baf",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Relatif aux ascendants et des descendants, par opposition à collatéral."
                                        ],
                                        "tags": [
                                            "Généalogie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dba0dee4-379c-4c7f-8122-554f80dcf669",
                                                "sense_id": "df015a93-273d-3660-8e36-92f297a53baf",
                                                "text": "Il descend d’un tel en ligne directe."
                                            },
                                            {
                                                "example_id": "7e95421a-cb89-44cb-b567-11b22061f743",
                                                "sense_id": "df015a93-273d-3660-8e36-92f297a53baf",
                                                "text": "Succession en ligne directe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98432f2-f173-3a1c-b41d-b89dc7303bd6",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Ordonné, qui place le sujet, le verbe, l’attribut ou le complément dans l’ordre de la relation grammaticale."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ab24c1e-0e8c-410e-8001-a4dc9b12732c",
                                                "sense_id": "e98432f2-f173-3a1c-b41d-b89dc7303bd6",
                                                "text": "Complément d’objet direct."
                                            },
                                            {
                                                "example_id": "6b27e069-44ce-494e-b83c-6eb32b332417",
                                                "sense_id": "e98432f2-f173-3a1c-b41d-b89dc7303bd6",
                                                "text": "Discours direct, dans une histoire, dans un poème, se dit de Ce qu’on suppose être prononcé par le personnage lui-même."
                                            },
                                            {
                                                "example_id": "bda368ba-118e-45cf-b107-7969bf02e81c",
                                                "sense_id": "e98432f2-f173-3a1c-b41d-b89dc7303bd6",
                                                "text": "L’écriture sainte est remplie de discours directs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9a39eb91-fbe8-3f6e-aa48-153b2b688ccd",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Relatif au ratio de la première à la seconde grandeur, dans l’ordre où on les énonce; par opposition à inverse, qui intervertit l’ordre suivi dans l’énoncé."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2675bdb1-3d72-4326-b3cd-6981d35708b8",
                                                "sense_id": "9a39eb91-fbe8-3f6e-aa48-153b2b688ccd",
                                                "text": "La raison directe de six à trois est deux, et la raison inverse de ces mêmes nombres est un demi."
                                            },
                                            {
                                                "example_id": "e4af6940-e28b-43eb-80af-7dc302254d76",
                                                "sense_id": "9a39eb91-fbe8-3f6e-aa48-153b2b688ccd",
                                                "text": "Les attractions mutuelles des corps matériels varient en raison directe du produit de leurs masses et en raison inverse du carré de leur distance."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a90dd3e3-0e01-3421-8090-1c9f2bea1c61",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "Montant à partir de la basse. Il se dit par opposition à renversé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aa47ec6-675e-4121-992a-7ef426852926",
                                                "sense_id": "a90dd3e3-0e01-3421-8090-1c9f2bea1c61",
                                                "text": "La quinte, la tierce majeure et l’octave sont les seuls intervalles directs proprement dits."
                                            },
                                            {
                                                "example_id": "9d9768d1-f030-4ba6-9dcc-7c493d4a15d4",
                                                "sense_id": "a90dd3e3-0e01-3421-8090-1c9f2bea1c61",
                                                "text": "Accord direct, celui qui procède du grave à l’aigu."
                                            },
                                            {
                                                "example_id": "3f74284c-a132-4da3-814f-706f0b5e3c2a",
                                                "sense_id": "a90dd3e3-0e01-3421-8090-1c9f2bea1c61",
                                                "text": "L’accord direct parfait est tierce, quinte et octave."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ddf006ee-df7d-39dd-bb42-4595733df812",
                                        "entry_id": "10ed7349-7bb3-3135-8000-4b40f37b8a00",
                                        "glosses": [
                                            "En trigonométrie : désigne le sens inverse des aiguilles d'une montre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "direct",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "30d270d1-5f84-3af5-b9e3-31eabebe527e",
                                        "entry_id": "82a062c8-1424-3659-b467-55c89b3ed072",
                                        "glosses": [
                                            "Directement ; d’emblée."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3c6cde99-985f-4d98-bcd8-46141126f55f",
                                                "sense_id": "30d270d1-5f84-3af5-b9e3-31eabebe527e",
                                                "text": "Il a démarré et on s'est tamponné une auto tamponneuse direct."
                                            },
                                            {
                                                "example_id": "75da7893-a607-402c-a1ea-82fd010c4542",
                                                "sense_id": "30d270d1-5f84-3af5-b9e3-31eabebe527e",
                                                "text": "Ah bon, on peut appeler direct le répondeur ?"
                                            },
                                            {
                                                "example_id": "da0deaa5-9709-4dd3-ab19-62088d8c8c96",
                                                "sense_id": "30d270d1-5f84-3af5-b9e3-31eabebe527e",
                                                "text": "T’as raison, nada… surtout pas sa boîte d’allouffes qui était là trois secondes avant… alors le mec, il comprend que c’est toi qui viens de la chouriner, y t’allonge direct un coup de boule…"
                                            },
                                            {
                                                "example_id": "6ce0b44b-8938-4678-a8fd-a2dcad4ba790",
                                                "sense_id": "30d270d1-5f84-3af5-b9e3-31eabebe527e",
                                                "text": "J’sais que l’passé, c’est l’passé\nMais y a qu’à toi qu’j’peux me confier\nTu sais, j’deviens parano des fois\nQuand j’reste seul, direct, je pense à toi\nEt ça fait, \"clic, clic-clic, pan-pan-pan\"\nJ’braque ton petit cœur, ma chérie, t’es trop séduisante (trop séduisante)"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "direct",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4f30bde7-9175-3516-96ad-3e933254d5c6",
                                        "entry_id": "f2675b4d-eac6-3c18-896b-7dd3df3c2701",
                                        "glosses": [
                                            "Coup droit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "98335081-9caf-4d67-8453-ef88ccb5af04",
                                                "sense_id": "4f30bde7-9175-3516-96ad-3e933254d5c6",
                                                "text": "L’autre, sans se presser, lui plaçait crochets et directs comme s’il était à l’entraînement, devant un sparring-partner, et quand le rouquin l’atteignait d’une détente farouche, il encaissait le coup, massivement."
                                            },
                                            {
                                                "example_id": "167bffc4-6197-47ac-9642-a21cf659acfa",
                                                "sense_id": "4f30bde7-9175-3516-96ad-3e933254d5c6",
                                                "text": "Valcourt encaissa la leçon comme un boxeur encaisse un direct dévastateur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "edeb6b50-5cfb-3395-a68b-619b30a0f3a6",
                                        "entry_id": "f2675b4d-eac6-3c18-896b-7dd3df3c2701",
                                        "glosses": [
                                            "Émission télévisée retransmise en temps réel, sans enregistrement préalable."
                                        ],
                                        "tags": [
                                            "Audiovisuel"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b8c48e0c-944d-455d-8576-320dc4880c0c",
                                                "sense_id": "edeb6b50-5cfb-3395-a68b-619b30a0f3a6",
                                                "text": "On regarde un direct depuis Rome."
                                            },
                                            {
                                                "example_id": "ded9a8ab-dcfb-4ede-801e-9f1b2d586b71",
                                                "sense_id": "edeb6b50-5cfb-3395-a68b-619b30a0f3a6",
                                                "text": "Cette émission est en direct de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0af820e5-cc4f-3271-adbd-cb019fcb9484",
                                        "entry_id": "f2675b4d-eac6-3c18-896b-7dd3df3c2701",
                                        "glosses": [
                                            "Transport qui mène à un endroit sans étapes, en un seul trajet (Se dit principalement des trains ou des avions)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2357c93f-b686-4ece-8598-daa4b2a253f0",
                                                "sense_id": "0af820e5-cc4f-3271-adbd-cb019fcb9484",
                                                "text": "Je vais à l’aéroport et je prends un direct pour l’Espagne."
                                            },
                                            {
                                                "example_id": "64e30503-e295-4543-8500-b1c2c7f77c56",
                                                "sense_id": "0af820e5-cc4f-3271-adbd-cb019fcb9484",
                                                "text": "Pour aller à Bruxelles, vous pouvez prendre un direct ou vous arrêter à la gare de Lille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
