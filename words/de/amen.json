            "senses": [
                {
                    "sense_id": "35632a8f-18e2-3f5e-a38d-e1775d32c2db",
                    "sense_definition": "Ausruf am Ende eines Gebets oder zur nachdrücklichen Bekräftigung einer Aussage im Sinne von „so sei es“",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bekraeftigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Am Ende des gemeinsamen Gebets sprachen alle Gläubigen laut <w>Amen</w>."
                        },
                        {
                            "text": "Nachdem der Pfarrer das Gebet gesprochen hatte, rief die Gemeinde <w>Amen</w>."
                        }
                    ],
                    "common_phrases": [
                        "amen sagen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "061818d6-7dd7-3550-8528-26443679a34c",
                    "sense_definition": "bekräftigende Schlussformel eines Gebets oder einer Rede, oft auch im übertragenen Sinne als Bestätigung verwendet",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bekraeftigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Diese Entscheidung ist so sicher wie das <w>Amen</w> in der Kirche."
                        },
                        {
                            "text": "Er will nicht zu jedem Vorschlag seines Chefs einfach Ja und <w>Amen</w> sagen."
                        }
                    ],
                    "common_phrases": [
                        "das Amen in der Kirche",
                        "Ja und Amen sagen"
                    ]
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "31f835e8-daa2-35ba-97c6-f93f6e72a119",
                    "sense_definition": "zur Bekräftigung einer Aussage vorangestellt, im Sinne von „wahrlich“ oder „gewiss“",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bekraeftigung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Amen</w>, ich sage euch, die Wahrheit wird am Ende immer ans Licht kommen."
                        },
                        {
                            "text": "Der Prediger begann seine Mahnung mit den Worten: „<w>Amen</w>, ich sage euch: Kehrt um!“"
                        }
                    ],
                    "synonyms": [
                        "wahrlich",
                        "gewiss"
                    ],
                    "common_phrases": [
                        "amen ich sage euch"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "vor allem in biblischen Texten und religiöser Sprache gebräuchlich"
                        }
                    ]
                }
            ]
        }
    ]
