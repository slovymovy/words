                    },
                    {
                        "translation_id": "489d3051-8b0b-4684-b620-fe2412223ab1",
                        "source_entry_id": "2dba0404-aa19-3d67-b797-d489ada07b8b",
                        "source_sense_id": "c3b2fc5d-fb28-3d9a-b890-ff144df77da2",
                        "target_lang_word": "sparadrap",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sparadrap",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                                        "glosses": [
                                            "Tissu recouvert d’une sorte d’emplâtre agglutinatif."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "76ce6afb-59c9-41c8-8c6c-3ab9f3a5bbd4",
                                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                                "text": "Le taffetas d’Angleterre est un sparadrap."
                                            },
                                            {
                                                "example_id": "2596869f-66b2-430b-8a72-354c6966a773",
                                                "sense_id": "31ec6e53-6c33-3e16-95ac-1c0dd28bf43b",
                                                "text": "Le sparadrap, collé sur sa joue, en tirait obliquement la peau tendue."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                                        "glosses": [
                                            "Bandage plus ou moins poreux, élastique, adhésif, qui s'applique sur la peau par simple pression et sert à maintenir un pansement ou sert de pansement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5b794597-63fd-4090-83f8-60d1a779d6ba",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Les pansements étaient compliqués et difficiles, la fixation des appareils et des linges par le sparadrap n’ayant pas encore été imaginée à cette époque."
                                            },
                                            {
                                                "example_id": "4a1e8ff9-9018-4474-b4c2-6c7589cccb83",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "[Corte] est en train de téléphoner. Il n'a plus de bandages, mais seulement un pansement de sparadrap."
                                            },
                                            {
                                                "example_id": "9b1b5768-3531-4958-9af2-5e7ea3f7b6f0",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Papa n'avait plus son bandeau sur la tête, mais, pour ne pas exhiber son sparadrap et son crâne passé à la tondeuse, il avait mis sa grande viscope d'ouvrier sellier."
                                            },
                                            {
                                                "example_id": "9895847a-e13a-407c-8735-cf1469a25c8b",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Henri enleva son pansement, le remplaça par un carré de sparadrap."
                                            },
                                            {
                                                "example_id": "93494abf-d847-47be-ab37-99a2eb49cdfa",
                                                "sense_id": "732f21b8-9944-3bfa-b92f-25adf3872d25",
                                                "text": "Un sparadrap maintenait ouverte la paupière de son œil droit et lui donnait un air de boxeur égaré."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9363f25b-1503-3e28-9f04-c160bcb091db",
                                        "entry_id": "b8426c31-50ff-3799-8382-a5d3529f0769",
                                        "glosses": [
                                            "Moyen de réparer quelque-chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f01ab15b-41c4-4cd6-b9bb-4350235d3c5a",
                                                "sense_id": "9363f25b-1503-3e28-9f04-c160bcb091db",
                                                "text": "Une politique sparadrap."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
