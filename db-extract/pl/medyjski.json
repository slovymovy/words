                "translations": [
                    {
                        "translation_id": "139ce362-cc47-4ab8-a7aa-b3228ef122c4",
                        "source_entry_id": "69937529-f4e5-3b46-893b-fe77a525df11",
                        "source_sense_id": "4081ca35-2408-3eed-b0e9-896eced65d80",
                        "target_lang_word": "Median",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Median",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ddbf5b5-7449-3e4b-a762-43480612595b",
                                        "entry_id": "a1fa8345-6e93-3e98-89d0-2fa156b4d1e1",
                                        "glosses": [
                                            "Relating to Media or Medes."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "75366d69-a314-40eb-a87c-8677a3baec99",
                                                "sense_id": "1ddbf5b5-7449-3e4b-a762-43480612595b",
                                                "text": "Lucullus seeing certaine Median men at armes, which were in the front of Tigranes Army, heavily and unweildily armed, as in an iron prison, apprehended thereby an opinion, that he might easily defeat them[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                        "entry_id": "a1fa8345-6e93-3e98-89d0-2fa156b4d1e1",
                                        "glosses": [
                                            "Of laws, rules etc.: unchanging, invariable."
                                        ],
                                        "tags": [
                                            "not-comparable",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0ab8db9e-77cc-45a0-89b7-5cd668ce6b53",
                                                "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                                "text": "‘This proceeding,’ interposed the president, ‘is by no means in accordance with the terms of the mulct or sentence, which is in its nature Median, and not to be altered or recalled.’"
                                            },
                                            {
                                                "example_id": "18c0d09c-8856-4d80-96bf-42fb878314ff",
                                                "sense_id": "6625356b-ff1f-3bfe-a2e0-a803486a560c",
                                                "text": "And if you venture to object to these Median laws, – as I am now doing, – you elicit a chorus of disapproval, and acquire some evil name."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Median",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "fa15943c-95ee-340a-958d-285808ef9308",
                                        "entry_id": "8dc145f5-f117-3d2e-a9ff-0ae3e7919a54",
                                        "glosses": [
                                            "A Mede."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Median",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7e731a5f-d9cb-3e0f-9dea-b6d3923cd334",
                                        "entry_id": "12facabf-7775-3c6d-891e-14dd23794c15",
                                        "glosses": [
                                            "The northwestern Old Iranian language of the Medes, attested only by numerous loanwords in Old Persian, few borrowings in Old Armenian and some glosses in Ancient Greek; nothing is known of its grammar."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7a952925-100e-40c5-ab60-761bf9a98ccc",
                        "source_entry_id": "69937529-f4e5-3b46-893b-fe77a525df11",
