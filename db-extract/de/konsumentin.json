                ],
                "senses": [
                    {
                        "sense_id": "63057ace-95c3-3a72-b2d1-98ca6059a66b",
                        "entry_id": "9a995d1f-e2a2-38bb-ba84-0508b0cf3325",
                        "glosses": [
                            "weibliche Person, die etwas verbraucht, konsumiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c68396f7-9584-4347-81b9-0e54f946e13a",
                                "sense_id": "63057ace-95c3-3a72-b2d1-98ca6059a66b",
                                "text": "„Ein achtjähriges Mädchen, das täglich rund 400 Epilepsie-Anfälle durchlebt, wird Mexikos erste legale Konsumentin von medizinischem Marihuana: Trotz striktem Marihuana-Verbot genehmigte das Gesundheitsministerium die Einfuhr eines Mittels auf der Basis von Cannabidiol (CBD), das die Anfälle des Mädchens verringern soll.“"
                            },
                            {
                                "example_id": "367cd1f7-46f3-4294-a81f-b50a0cf9363a",
                                "sense_id": "63057ace-95c3-3a72-b2d1-98ca6059a66b",
                                "text": "„Am Donnerstag wurde nach Polizeiangaben eine 27 Jahre alte Konsumentin chemischer Suchtmittel leblos in ihrer Wohnung in Haidhausen entdeckt, die junge Frau starb kurz darauf im Krankenhaus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dffa10fc-4233-469d-a845-72b9b2e91870",
