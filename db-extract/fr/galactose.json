                        "tags": [],
                        "examples": [
                            {
                                "example_id": "16c6d34c-6aea-48f1-b551-c02b61c65756",
                                "sense_id": "9c9df6f3-ab71-3a50-a771-6f770b3034a0",
                                "text": "L’hydrolyse du lactose par la β-galactosidase (une lactase) donne du glucose et du galactose."
                            },
                            {
                                "example_id": "1fd2897e-b1f7-4f15-abe6-2ed99ea950bb",
                                "sense_id": "9c9df6f3-ab71-3a50-a771-6f770b3034a0",
                                "text": "Le galactose libéré par l’hydrolyse intestinale du lactose est métabolisé presque exclusivement par le foie."
                            }
                        ]
                    }
                ],
