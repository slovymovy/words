                "translations": [
                    {
                        "translation_id": "87a68ae5-37cf-4d66-aa1c-40d134ba97bd",
                        "source_entry_id": "4c2c9919-c7d1-3315-9a54-8203eb3fdf8c",
                        "target_lang_word": "ablegen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ablegen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3bc4b460-76a7-396f-9b40-b1bed1b35ed8",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "fortlegen, niederlegen, irgendwohin legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "624506c0-21e1-42d6-8bd8-e581d61c4bbb",
                                                "sense_id": "3bc4b460-76a7-396f-9b40-b1bed1b35ed8",
                                                "text": "Ich werde den Telefonhörer jetzt ablegen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f2ac8758-91bb-3a2a-bac9-f28d73c901f5",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "etwas was bearbeitet ist, nicht mehr benötigt wird, zur Aufbewahrung weglegen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ef06eb6-bc78-49ef-bf7f-5d045007286b",
                                                "sense_id": "f2ac8758-91bb-3a2a-bac9-f28d73c901f5",
                                                "text": "Dieser Fall wird jetzt abgelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7b31c768-9a02-3e28-affa-b85486cd77c3",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "ein Kleidungsstück ausziehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db75671-3f6d-43d6-85b3-d6e5548524cc",
                                                "sense_id": "7b31c768-9a02-3e28-affa-b85486cd77c3",
                                                "text": "Er legte sein Sakko ab und setzte sich nieder."
                                            },
                                            {
                                                "example_id": "8e5edf16-6ad5-4741-961e-be87b863641a",
                                                "sense_id": "7b31c768-9a02-3e28-affa-b85486cd77c3",
                                                "text": "„Trotz der mörderischen Hitze konnten die Ritter ihre schweren Rüstungen nicht ablegen, denn immer wieder wurden die Kreuzfahrer von Reiterhorden angegriffen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "6d08d38f-4321-3324-ae94-0bd8592eceed",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "nicht mehr tragen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "258bb053-67de-4b84-aa88-b3ac06232ebc",
                                                "sense_id": "6d08d38f-4321-3324-ae94-0bd8592eceed",
                                                "text": "Sie legt den Rock endgültig ab, da er ihr zu altmodisch erscheint."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c6ccfe01-b78b-382d-8abe-157757d4a6dd",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "sich von etwas frei machen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ecc373c-1c64-488c-8823-de76f16029dc",
                                                "sense_id": "c6ccfe01-b78b-382d-8abe-157757d4a6dd",
                                                "text": "Du hast deine schlechte Angewohnheit noch immer nicht abgelegt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bfac6d9c-c6a9-303c-9db9-3638eaa1f881",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "auf schriftliche oder mündliche Weise etwas leisten, was von dem Betreffenden als Beweis für etwas gefordert wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95310174-41b3-44d4-ab9d-7f54abbe70fa",
                                                "sense_id": "bfac6d9c-c6a9-303c-9db9-3638eaa1f881",
                                                "text": "Morgen lege ich die Prüfung in Schwedisch ab."
                                            },
                                            {
                                                "example_id": "1a129d5f-1d1e-4cdf-a4ba-b6a6b002efc8",
                                                "sense_id": "bfac6d9c-c6a9-303c-9db9-3638eaa1f881",
                                                "text": "1923 legt der damals 17-Jährige das Abitur ab."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "7c0838ca-71e1-38c5-8afc-02a7d1ffd70e",
                                        "entry_id": "ac1bd80d-a1d5-3707-a505-1d60c0852e59",
                                        "glosses": [
                                            "von der Anlegestelle wieder wegfahren"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "079a8cc6-304d-4026-9dba-ad23ce7cf574",
                                                "sense_id": "7c0838ca-71e1-38c5-8afc-02a7d1ffd70e",
                                                "text": "„Während die Flüchtlingsschiffe „Excelsior“ und „Catania“ ihre Fahrt ins apulische Taranto antraten, sollten noch am Donnerstag weitere 2000 Nordafrikaner in Lampedusa abgelegt haben.“"
                                            },
                                            {
                                                "example_id": "793dbb14-526b-489d-a4eb-304ab80dabae",
                                                "sense_id": "7c0838ca-71e1-38c5-8afc-02a7d1ffd70e",
                                                "text": "„Wer es sich leisten konnte, war an Bord des ausgebuchten Ozeanriesen, als dieser am 16. Juli 1929 unter Kapitän Leopold Ziegenbein in Bremerhaven ablegte.“"
                                            },
                                            {
