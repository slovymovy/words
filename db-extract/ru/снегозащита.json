                        "glosses": [
                            "мероприятия по защите дорог, населенных пунктов и промышленных объектов от снежных заносов, включают разнообразные средства и способы борьбы с заносами, выдуванием и уборки снега"
                        ],
                        "tags": [],
                        "examples": []
                    },
