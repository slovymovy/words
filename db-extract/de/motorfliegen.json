                "senses": [
                    {
                        "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                        "entry_id": "42f0bffc-2bb2-39d9-af4a-8e28f6c9782e",
                        "glosses": [
                            "Sportart, die mit einem propellergetriebenen Sportflugzeug (Cessna, Piper) ausgeübt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c33706cb-928c-4b22-ac43-67441cb29a61",
                                "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                                "text": "„Das Motorfliegen erfordert ein beträchtliches navigatorisches Wissen und Können bzw. […] vestibuläre Belastbarkeit, Raumorientierungsvermögen und ein feinmotorisches Gespür für den Umgang mit der Maschine.“"
                            },
                            {
                                "example_id": "8401a589-d3f8-4c43-b2b1-caad551e5f8c",
                                "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                                "text": "„Beim Motorfliegen kommt es im Gegensatz zum Segelfliegen mehr darauf an, fliegerische, navigatorische und technische Aufgaben zu meistern.“"
                            },
                            {
                                "example_id": "138aed05-9a6f-406f-b8ed-dc2f8fa2f56e",
                                "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                                "text": "„Wer sich den Traum vom Motorfliegen erfüllen will, dem bietet sich in Brandenburg die Möglichkeit, den Privatpilotenschein, kurz PPL genannt, zu erwerben.“"
                            },
                            {
                                "example_id": "15239063-c23f-496e-880b-1fbb3ba29b9c",
                                "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                                "text": "„Der Leser findet Anregungen für Wandern, Bergsteigen, Radtouren, Malen, Reiten, Golf, Motorfliegen, Segeln, Wasserski, Paddeln, Angeln, Sprachkurse, Kochen und Photographieren.“"
                            },
                            {
                                "example_id": "b2e4655c-2871-435b-9ac2-c80a1e8fedf9",
                                "sense_id": "c0af24c2-ef70-38bd-b329-6f67049d7bbd",
                                "text": "„Und Honecker war es auch, der 1952 die Einführung des Schießunterrichts, des Fallschirmspringens und des Motorfliegens bei der FDJ verkündete; der Popularisierung der Wiederbewaffnung bei der Jugend widmete er danach seine ganze Energie.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
