                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e01d3b08-f96b-4e4a-ad02-a1107949a703",
                                "sense_id": "c9f84820-1135-3292-80df-1948404a8879",
                                "text": "Op zijn verjaardag vieren we in het gezin feest. Het weekend daaropvolgend vieren we het in de familie."
                            },
                            {
                                "example_id": "0ffca65b-b6a2-425a-953c-c0ca1a2ef955",
                                "sense_id": "c9f84820-1135-3292-80df-1948404a8879",
                                "text": "10 jaar geleden nam hij een jaar rust, maar de daaropvolgende jaren was hij extra druk."
                            },
                            {
                                "example_id": "7d9eae05-c24a-4497-8508-68f79d798401",
                                "sense_id": "c9f84820-1135-3292-80df-1948404a8879",
                                "text": "Het daaropvolgende uur werd gekenmerkt door gezellige borrelpraat en een drinktempo van Joop en Coby waarmee Jeroen en Chantal zich niet konden en wilden meten."
                            },
                            {
                                "example_id": "afbe0afa-4823-465f-8076-75e5a9de5f97",
                                "sense_id": "c9f84820-1135-3292-80df-1948404a8879",
                                "text": "De speech van Hermans en het daaropvolgende applaus van haar partijgenoten werden bekritiseerd in verschillende media, zoals bij Vandaag Inside, door columnist en podcaster Marcel van Roosmalen en door programmamaker Tim Hofman."
                            }
                        ]
                    }
