                                    {
                                        "sense_id": "52f1ad5e-be7b-3108-8b4a-7ea936363874",
                                        "entry_id": "449a2ab1-fbe4-3eb0-bee5-e7b57536dc5e",
                                        "glosses": [
                                            "Nom de famille, connu notamment pour Ferdinand Foch."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9c882a-43fc-4dc3-abc9-2145ab010332",
                                                "sense_id": "52f1ad5e-be7b-3108-8b4a-7ea936363874",
                                                "text": "Les Saxons ont avancé jusqu’à Gourgançon sur une petite rivière, la Maurienne, mais ils ne peuvent se maintenir. Leur pression diminue et les Français reprennent Fère-Champenoise. Au soir du 8 septembre, Foch peut annoncer : « Nous sommes incontestablement dans le mouvement avant général. Je pense que nous passerons la Marne demain. »"
                                            },
                                            {
                                                "example_id": "21da4d5f-163c-4a8e-a7ca-cc1e6add9db4",
                                                "sense_id": "52f1ad5e-be7b-3108-8b4a-7ea936363874",
                                                "text": "Il y avait même plus que de l’amitié entre eux, Foch considérait Weygand comme « son propre fils »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Foch",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "94559cbb-4f4c-3b07-8a6a-0ba41b200ada",
                                        "entry_id": "30ab7daa-a6b5-3610-9d93-1065fc56b039",
                                        "glosses": [
                                            "Quartier de la ville de Lyon situé dans le sixième arrondissement, autour de l’avenue éponyme."
                                        ],
                                        "tags": [
                                            "toponymic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1b91d99-eebf-42d4-bb89-9d65576018e3",
                                                "sense_id": "94559cbb-4f4c-3b07-8a6a-0ba41b200ada",
                                                "text": "Chic. Forcément, on est dans le 6e. Et pas n’importe quel 6e, le quartier Foch, le beau linge. Suprême."
                                            },
                                            {
                                                "example_id": "7dd0b016-ebcd-4682-98a1-1a7c24c7bfe1",
                                                "sense_id": "94559cbb-4f4c-3b07-8a6a-0ba41b200ada",
                                                "text": "Oui tout à fait, vous avez bien lu : à Foch. Ce quartier pépère du 6ème se voit enfin doté d’un lieu de sortie digne de ce nom."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
