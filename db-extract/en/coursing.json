                        "entry_id": "d44b45e6-f3f8-373a-9f53-0317ed784f95",
                        "glosses": [
                            "The sport of chasing wild animals, especially hares, with dogs by sight rather than by scent."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "f7f1ffd8-479b-428e-8038-8f84b6539e99",
                                "sense_id": "7475d827-7b70-35ee-8ad4-032ddd7a6277",
                                "text": "Narracoorte was the great coursing centre of the district, and, I believe, of the colony."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "58dac07c-d3d6-4309-b84e-4eb7ca28ba85",
                        "source_entry_id": "d44b45e6-f3f8-373a-9f53-0317ed784f95",
                        "source_sense_id": "7475d827-7b70-35ee-8ad4-032ddd7a6277",
                        "source_sense_description": "sport",
                        "target_lang_word": "Hetzjagd",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Hetzjagd",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a2410867-434f-3b2b-9c79-7e7fcb4a0ca5",
                                        "entry_id": "a12a7d5a-63c8-3b6d-9e8b-94f7f79e21b8",
                                        "glosses": [
                                            "Art der Jagd, bei der das Wild mit Hunden gehetzt wird"
                                        ],
                                        "tags": [
                                            "Jagdwesen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "45578c87-67c3-4471-85e4-2a75352390b0",
                                                "sense_id": "a2410867-434f-3b2b-9c79-7e7fcb4a0ca5",
                                                "text": "„Die im Mittelalter vorherrschende Jagdform war die Pirschjagd, besonders bei geistlichen Jagdrechtsinhabern, denen die persönliche Teilnahme an Treib- oder Hetzjagden vom Kirchenrecht verboten war.“"
                                            },
                                            {
                                                "example_id": "544f6356-5665-47c4-ae13-7c0851420308",
                                                "sense_id": "a2410867-434f-3b2b-9c79-7e7fcb4a0ca5",
                                                "text": "„Von da an befasste er sich mit leidenschaftlicher Hingabe mit der Hetzjagd, die beim alten Grafen in grossem Masstabe getrieben wurde und für Nikolai etwas Neues bedeutete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "688276eb-e9fa-3e5b-88e2-c6b9addaeb2a",
                                        "entry_id": "a12a7d5a-63c8-3b6d-9e8b-94f7f79e21b8",
                                        "glosses": [
                                            "Bekämpfung mit allen zur Verfügung stehenden Mitteln"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2787ba0-1163-49f3-b6b9-fc6a198d359e",
                                                "sense_id": "688276eb-e9fa-3e5b-88e2-c6b9addaeb2a",
                                                "text": "„Er spricht von Hetzjagd und Komplott, greift Richter und Medien an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "0738cf92-c6e1-37bb-b02c-b162f02eb623",
                                        "entry_id": "a12a7d5a-63c8-3b6d-9e8b-94f7f79e21b8",
                                        "glosses": [
                                            "Handeln unter großem Zeitdruck"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43d191f0-fc0c-41f4-951d-f796f4c78df1",
                                                "sense_id": "0738cf92-c6e1-37bb-b02c-b162f02eb623",
                                                "text": "Die Koalitionsbildung wurde zur Hetzjagd, da eine stabile Regierung dringend benötigt wird."
                                            },
                                            {
                                                "example_id": "fc1a024b-fab3-4135-8d71-02a9df98631c",
                                                "sense_id": "0738cf92-c6e1-37bb-b02c-b162f02eb623",
                                                "text": "„Den morgigen Tag […] wolle er ruhiger zubringen. Keine Hetzjagd mehr durch Museen, Kinos, Restaurants und Undergroundlokale.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
