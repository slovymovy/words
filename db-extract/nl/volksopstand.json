                        "source_sense_id": "8cedbf17-a246-3a37-a440-c473104611c1",
                        "source_sense_description": "een oproer tegen het gevestigde gezag door grote groepen uit de bevolking",
                        "target_lang_word": "riot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "riot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a3692329-30b7-378c-9e4a-8dc43ec8cc38",
                                        "entry_id": "92115427-6e1c-3d91-9e7d-4082ab151e8f",
                                        "glosses": [
                                            "A tumultuous disturbance of the public peace by a large group of people, often involving violence or damage to property."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e0cfa0f-f0af-4da2-bdc1-47c2cc6feb3e",
                                                "sense_id": "a3692329-30b7-378c-9e4a-8dc43ec8cc38",
                                                "text": "The protests began peacefully but turned into riots after several days."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5264295c-f158-3e66-80b4-883762d12046",
                                        "entry_id": "92115427-6e1c-3d91-9e7d-4082ab151e8f",
                                        "glosses": [
                                            "A wide and unconstrained variety."
                                        ],
                                        "tags": [
                                            "countable",
                                            "figuratively",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6af944f4-475f-419b-bf34-f0ed3a3265fb",
                                                "sense_id": "5264295c-f158-3e66-80b4-883762d12046",
                                                "text": "In summer this flower garden is a riot of colour."
                                            },
                                            {
                                                "example_id": "86bca895-304a-4b1f-8d21-f86c4de7db1b",
                                                "sense_id": "5264295c-f158-3e66-80b4-883762d12046",
                                                "text": "The human world is contracting not only prospectively but to the backward-probing eye of culture-history. Nevertheless we are as yet far from able to reduce the riot of spoken languages to a small number of “stocks.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7207a177-0afb-3100-8060-270c1e91b6fc",
                                        "entry_id": "92115427-6e1c-3d91-9e7d-4082ab151e8f",
                                        "glosses": [
                                            "A humorous or entertaining event or person."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36f40deb-95c0-470e-b340-c474212d13a2",
                                                "sense_id": "7207a177-0afb-3100-8060-270c1e91b6fc",
                                                "text": "Check this out! We have to get this! I can't believe all this stuff! This is a total riot!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c7ae4959-8db4-3068-b214-3e494fa78d0c",
                                        "entry_id": "92115427-6e1c-3d91-9e7d-4082ab151e8f",
                                        "glosses": [
                                            "Wanton or unrestrained behavior or emotion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f258f11-d87f-46b8-abdb-4f688b403e6b",
                                                "sense_id": "c7ae4959-8db4-3068-b214-3e494fa78d0c",
                                                "text": "For when his head-ſtrong Riot hath no Curbe,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf9a613a-2a7c-32cd-a44c-5124c48670dd",
                                        "entry_id": "92115427-6e1c-3d91-9e7d-4082ab151e8f",
                                        "glosses": [
                                            "Excessive and expensive feasting; wild and loose festivity; revelry."
                                        ],
                                        "tags": [
                                            "countable",
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef55a2b3-22eb-4ea3-a981-92a357a074e9",
                                                "sense_id": "bf9a613a-2a7c-32cd-a44c-5124c48670dd",
                                                "text": "the lamb thy riot dooms to bleed to-day"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "riot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "37b686ce-aa92-34f0-b7ae-8bbb22e3fbca",
                                        "entry_id": "e373b69e-d14d-3ad1-80f0-ad3546c9f9bf",
                                        "glosses": [
                                            "To create or take part in a riot; to raise an uproar or sedition."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a0d60a3-89c9-4f1e-bd30-de4e6fb75286",
                                                "sense_id": "37b686ce-aa92-34f0-b7ae-8bbb22e3fbca",
                                                "text": "The nuclear protesters rioted outside the military base."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c139adb0-d01b-34ea-b7b7-28ecc5136e5f",
                                        "entry_id": "e373b69e-d14d-3ad1-80f0-ad3546c9f9bf",
                                        "glosses": [
                                            "To act in an unrestrained or wanton manner; to indulge in excess of feasting, luxury, etc."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6b719c4b-9a6d-4127-9bc6-f205114da365",
                                                "sense_id": "c139adb0-d01b-34ea-b7b7-28ecc5136e5f",
                                                "text": "Now he exact of all, wastes in delight, / Riots in pleasure, and neglects the law."
                                            },
                                            {
                                                "example_id": "0b156a41-a8cb-47a9-a742-646717f9d02e",
                                                "sense_id": "c139adb0-d01b-34ea-b7b7-28ecc5136e5f",
                                                "text": "Think of the insults, wrongs, and contumelies, / Ye bear from your proud lords—that your hard toil / Manures their fertile fields—you plow the earth, / You sow the corn, you reap the ripen'd harvest,— / They riot on the produce!— […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "21028726-e782-3743-9a0c-c2f27278cc0e",
                                        "entry_id": "e373b69e-d14d-3ad1-80f0-ad3546c9f9bf",
                                        "glosses": [
                                            "To cause to riot; to throw into a tumult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "74e894b0-61dc-3071-9500-9c1e4e83a67c",
                                        "entry_id": "e373b69e-d14d-3ad1-80f0-ad3546c9f9bf",
                                        "glosses": [
                                            "To annoy."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
