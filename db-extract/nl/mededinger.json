                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cad4508-2796-473c-af52-3f61e5f7fd4a",
                                                "sense_id": "5b1f74b1-2fd1-3071-96cf-5721d70ea05c",
                                                "text": "Ioine with me now in this my meane eſtate, […]\nAnd when my name and honor ſhall be ſpread,\nAs far as Boreas claps his braſen wings,\nOr faire Botëes ſends his cheerefull light.\nThen ſhalt thou be Competitor with me,\nAnd ſit with Tamburlaine in all his maieſtie."
                                            }
