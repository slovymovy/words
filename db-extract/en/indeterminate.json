            {
                "entry_id": "a9d1a959-7939-34be-9545-4d4628fe02cf",
                "word": "indeterminate",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d56d487b-7a23-41bb-868f-f0645b9320f9",
                        "entry_id": "a9d1a959-7939-34be-9545-4d4628fe02cf",
                        "tags": [
                            "plural"
                        ],
                        "form": "indeterminates"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1b66b3e8-d242-3f78-90a9-fbe0a147f6e8",
                        "entry_id": "a9d1a959-7939-34be-9545-4d4628fe02cf",
                        "glosses": [
                            "A symbol that resembles a variable or parameter but is used purely formally and neither signifies nor is ever assigned a particular value;"
                        ],
                        "tags": [
                            "strict-sense"
                        ],
                        "examples": [
                            {
                                "example_id": "e6154e4c-43d3-4a23-bd26-1a9121eef6e4",
                                "sense_id": "1b66b3e8-d242-3f78-90a9-fbe0a147f6e8",
                                "text": "1862, H. J. Stephen Smith, Report on the Theory of Numbers—Part III, Report of the 31st Meeting of the British Association for the Advancement of Science, British Association for the Advancement of Science, page 292,\nThe form is linear, quadratic, cubic, biquadratic or quartic, quintic, &c., according to its order in respect of the indeterminates it contains; and binary, ternary, quaternary, &c., according to the number of its indeterminates. Thus x²+y² is a binary quadratic form, x³+y³+z³-3xyz is a ternary cubic form."
                            },
                            {
                                "example_id": "869f2d80-50de-4a88-a399-6a3dbf12c1f6",
                                "sense_id": "1b66b3e8-d242-3f78-90a9-fbe0a147f6e8",
                                "text": "1892, Henry B. Fine, Kronecker and His Arithmetical Theory of the Algebraic Equation, Thomas S. Fiske, Harold Jacoby (editors), Bulletin of the New York Mathematical Society, Volume 1, New York Mathematical Society, page 179,\nSuch a factor is therefore an integral function of x and the indeterminates u_1,u_2,…u_n with coefficients belonging to the domain of rationality (R',R,..) and may be represented by g(x,u_1,u_2,..u_n)."
                            },
                            {
                                "example_id": "9a94ec63-afbb-4a80-811c-cfc024eec325",
                                "sense_id": "1b66b3e8-d242-3f78-90a9-fbe0a147f6e8",
                                "text": "2006, Alexander B. Levin, Difference Algebra, M. Hazewinkel, Handbook of Algebra, page 251,\nLet T=T_σ and let S be the polynomial R-algebra in the set of indeterminates y_i,τ_(i∈I,τ∈T) with indices from the set I×T."
                            }
                        ]
                    },
                    {
                        "sense_id": "16c24fdd-d640-3d6c-be8d-a7a3490ccfdd",
                        "entry_id": "a9d1a959-7939-34be-9545-4d4628fe02cf",
                        "glosses": [
                            "A symbol that resembles a variable or parameter but is used purely formally and neither signifies nor is ever assigned a particular value;\\n(loose sense) a variable.",
                            "a variable."
                        ],
                        "tags": [
                            "strict-sense"
                        ],
                        "examples": []
                    }
