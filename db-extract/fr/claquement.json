                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f01952d-df67-3b74-973a-38ad9da6699d",
                        "entry_id": "5741aa75-1531-364f-8bf2-f171d9a69843",
                        "glosses": [
                            "Action de claquer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f9c4ffa8-c6d2-4607-a8c8-4995a9168d93",
                                "sense_id": "5f01952d-df67-3b74-973a-38ad9da6699d",
                                "text": "La friction du vent sous l’enveloppe produisait une série intermittente de rides et de petits claquements : on eût cru, en moins fort, le bruit du sillage à l’avant d’un bateau."
                            },
                            {
                                "example_id": "d701314d-536d-4cbc-bfc2-3f32d53e36f1",
                                "sense_id": "5f01952d-df67-3b74-973a-38ad9da6699d",
                                "text": "Puis, avant qu’il n’ait eu le temps de comprendre ce qui se passait, il vit sa femme ouvrir grand la porte de la chambre pour se propulser dans le salon à la vitesse d’un claquement d’élastique."
                            }
                        ]
                    },
                    {
                        "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                        "entry_id": "5741aa75-1531-364f-8bf2-f171d9a69843",
                        "glosses": [
                            "Bruit produit par cette action."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "52e7c31d-61ba-4ac1-bc27-55278c4831c2",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "Et, pareil aux arbres échevelés, Pascal tenait bon, avec ses vêtements qui avaient des claquements de drapeaux, avec sa barbe et ses cheveux emportés, fouettés de tempête."
                            },
                            {
                                "example_id": "2b3d7df0-711f-429d-86b9-0920171aae87",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "L’écho de la forêt voisine répétait nos cris, le mugissement des troupeaux, le tintement des clochettes et le claquement du fouet […]"
                            },
                            {
                                "example_id": "375a9fff-5724-4c2b-a61d-3256e5d889bc",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "Peu à peu, des claquements de sabots s’entendirent, puis des pas étouffés de religieuses […]"
                            },
                            {
                                "example_id": "3e7bf0c9-9bd7-41ed-b3a7-974975ab9006",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "Ses rues, dans le silence d’un lieu désert, attendent le claquement des volets, l’ouverture des portes, le hennissement des chevaux, l’essor d’une marmaille."
                            },
                            {
                                "example_id": "f3e6300c-3547-4410-90b6-a5279dac10f4",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "Il est bien clair qu’à ce balcon, avec un pare-balles à droite, et sans m’occuper beaucoup des sifflements et claque­ments, je ne pensais qu’à bien faire mon métier de guetteur."
                            },
                            {
                                "example_id": "7429cb3b-42d4-4591-b611-f0e9aa3617d4",
                                "sense_id": "d290a749-cffd-3a8c-8a34-626ff831674a",
                                "text": "On entend beaucoup mieux le vélo des autres en revanche, et surtout ce petit claquement qui vous prévient que quelqu’un vient de changer de braquet et qu’il va falloir changer d’allure."
                            }
                        ]
                    },
