                                            {
                                                "example_id": "4dc85cd0-0acd-4d09-a787-8f90d5e71502",
                                                "sense_id": "f32eb08b-462c-3975-8a4d-10567dfe70ee",
                                                "text": "Ein Kreis ist sowohl drehsymmetrisch als auch achsensymmetrisch."
                                            },
                                            {
                                                "example_id": "85f17b5e-068c-4c0f-8896-5433b26173a6",
                                                "sense_id": "f32eb08b-462c-3975-8a4d-10567dfe70ee",
                                                "text": "„Aus undurchsichtigen Käfigen ließ Thornhill verschiedene Männchen ihren Duftstoff versprühen. Und in 44 von 50 Fällen strebten die begattungswilligen Skorpionsfliegenweibchen zielstrebig auf den Käfig zu, in dem das am symmetrischsten gebaute Männchen saß.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59ae7869-4342-35c6-8399-2a27e22a64a3",
