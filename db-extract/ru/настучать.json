                    }
                ],
                "translations": [
                    {
                        "translation_id": "c9eeb17a-b6cc-4679-b52d-d61f38eed9c0",
                        "source_entry_id": "2f0101ef-253e-3b5c-b7cf-d002fe91de6f",
                        "target_lang_word": "dénoncer",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dénoncer",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a10e9ae3-8746-32cd-9dc8-9d150a7accd5",
                                        "entry_id": "34d5b3f3-bd5f-3401-9ce7-7b7ee6f77903",
                                        "glosses": [
                                            "Notifier par voie officielle ou judiciaire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61d92311-27f3-4bde-840e-a4b95f6f5bf0",
                                                "sense_id": "a10e9ae3-8746-32cd-9dc8-9d150a7accd5",
                                                "text": "Dénoncer la guerre."
                                            },
                                            {
                                                "example_id": "55cb135b-e63d-4360-8769-53dfe794d5cf",
                                                "sense_id": "a10e9ae3-8746-32cd-9dc8-9d150a7accd5",
                                                "text": "Nous, Guillaume Norry, héraut de la couronne d'Angleterre, te dénonçons la guerre sur terre et sur mer, et, comme signe de défi, te jetons ici le gant de bataille."
                                            },
                                            {
                                                "example_id": "a98736d0-c247-451a-8b22-c0664930a19b",
                                                "sense_id": "a10e9ae3-8746-32cd-9dc8-9d150a7accd5",
                                                "text": "Dénoncer une opposition, une saisie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22a962ff-49c7-3dbf-bfac-0fc288c89ff3",
                                        "entry_id": "34d5b3f3-bd5f-3401-9ce7-7b7ee6f77903",
                                        "glosses": [
                                            "Annoncer la fin d’un accord, d’un contrat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "985da606-6426-4812-9616-91caeb1cdd82",
                                                "sense_id": "22a962ff-49c7-3dbf-bfac-0fc288c89ff3",
                                                "text": "Dénoncer la fin de l’armistice, ou, (Par ellipse) dénoncer l’armistice."
                                            },
                                            {
                                                "example_id": "4f8fd758-0db1-4369-a94c-6be893155320",
                                                "sense_id": "22a962ff-49c7-3dbf-bfac-0fc288c89ff3",
                                                "text": "Dénoncer un traité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59596be4-cb92-3f92-a81c-417edfdc7952",
                                        "entry_id": "34d5b3f3-bd5f-3401-9ce7-7b7ee6f77903",
                                        "glosses": [
                                            "Signaler comme coupable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f3ed992-0d73-4b22-a137-c70b494473e5",
                                                "sense_id": "59596be4-cb92-3f92-a81c-417edfdc7952",
                                                "text": "Les coopératives ont été longtemps dénoncées comme n’ayant aucune utilité pour les ouvriers ; depuis qu’elles prospèrent, plus d’un politicien fait les yeux doux à leur caisse […]"
                                            },
                                            {
                                                "example_id": "50fd27b8-4cd7-4677-b548-c149d92cc6df",
                                                "sense_id": "59596be4-cb92-3f92-a81c-417edfdc7952",
                                                "text": "D'autre part, Péchenard écrit que le pasteur de Gespunsart, « à cause de son attachement aux erreurs jansénistes » fut dénoncé par ses paroissiens à l'autorité diocésaine. Il fut donc interdit par l'archevêque de Mailly."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                        "entry_id": "34d5b3f3-bd5f-3401-9ce7-7b7ee6f77903",
                                        "glosses": [
                                            "Signaler, publiquement ou non, les pratiques malhonnêtes, immorales ou illégitimes d’une personne physique ou morale."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "acf5e044-d83b-419f-a559-9db839c516f9",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Pour mon compte, je n'ai pas manqué une occasion de dénoncer au bon sens public ces escroqueurs de renommée."
                                            },
                                            {
                                                "example_id": "1cdeaadf-53a9-48a9-9a73-00d66b080ff8",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Déjà, nous dénoncions publiquement les tendances pro-germaniques et pro-hitlériennes de Monsieur De Man."
                                            },
                                            {
                                                "example_id": "a07750eb-77fc-4bf6-a42f-523fd4d3f077",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Harland, qui a fort bien connu Vavilov, condamne sans réserves les théories mitchouriniennes, taxe Lyssenko de charlatan et dénonce les odieuses manœuvres qui ont abouti à la révocation des principales figures de la génétique soviétique."
                                            },
                                            {
                                                "example_id": "91dcae65-7c7a-48a1-b06c-e3ba02ac948b",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Le groupe se doit d’être vigilant et de dénoncer sans réserve la supercherie, le charlatanisme et la malhonnêteté dont font preuves ceux dont le but est d’attirer des sympathisants."
                                            },
                                            {
                                                "example_id": "231b6142-0e09-47b9-9a81-20b2184d111d",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Après avoir dénoncé cette affaire sur un blog, ils ont toutefois été contactés par l’agence, qui se dit prête à annuler le contrat et à rembourser le premier versement de 2 300 €."
                                            },
                                            {
                                                "example_id": "84bbc6ea-1eaa-4b05-8218-8a6438a6d9b9",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Jésus dénonce l'agressivité."
                                            },
                                            {
                                                "example_id": "f9a0d8df-484d-4e97-ab09-b3f89421aa4d",
                                                "sense_id": "18dbb3d9-4c50-364c-a750-a8a3ed90d7e8",
                                                "text": "Mais elle touche à des points sensibles de notre expérience, comme lorsque Byung-Chul Han dénonce le nouvel idéal néolibéral de la performance qui fait que chacun est mis en demeure de s’auto-exploiter lui-même, au risque de la dépression et du burn-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14273d40-afa5-3b19-b754-bb412f244245",
                                        "entry_id": "34d5b3f3-bd5f-3401-9ce7-7b7ee6f77903",
                                        "glosses": [
                                            "Indiquer par des indices."
