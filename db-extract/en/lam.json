                    {
                        "sense_id": "4721a975-6811-39dc-9222-8f4446c9c069",
                        "entry_id": "4bf2dd66-dcbd-3209-a644-e0dd92873c26",
                        "glosses": [
                            "To beat or thrash."
                        ],
                        "tags": [
                            "informal",
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "bdec03ba-d3ac-4ace-9afd-c717cc5a296c",
                                "sense_id": "4721a975-6811-39dc-9222-8f4446c9c069",
                                "text": "1930, Langston Hughes and Zora Neale Hurston, Mule Bone, Act II, Scene 2, in The Collected Works of Langston Hughes, Volume 5: The Plays to 1942: Mulatto to The Sun Do Move, edited by Leslie Catherine Sanders, Columbia: University of Missouri Press, 2002, p. 102,\nAn' fo' I knowed it, he done picked up that bone an' lammed me ovah de head wid it."
                            },
                            {
                                "example_id": "59457448-13fd-4df2-8be5-d20c1256bbc6",
                                "sense_id": "4721a975-6811-39dc-9222-8f4446c9c069",
                                "text": "They lammed each other on the head with great, clumsy stone hammers; but their skulls were so hard that the hammers bounced off again […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "7218bb68-5ef9-33c8-8a10-2ae2b870a842",
                        "entry_id": "4bf2dd66-dcbd-3209-a644-e0dd92873c26",
                        "glosses": [
                            "To flee or run away."
                        ],
                        "tags": [
                            "dated",
                            "intransitive",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "578813f8-4a97-45a1-b239-4bc3191acc19",
                                "sense_id": "7218bb68-5ef9-33c8-8a10-2ae2b870a842",
                                "text": "[Gangster running away:] Batman and Robin! Let's lam!"
                            },
                            {
                                "example_id": "731bbecb-30f7-4348-b6d5-22198dffdcf0",
                                "sense_id": "7218bb68-5ef9-33c8-8a10-2ae2b870a842",
                                "text": "[…]and she was so mad and so down deep vindictive that she reported to the police some false trumped-up hysterical crazy charge, and Dean had to lam from Hoboken."
                            }
                        ]
                    }
