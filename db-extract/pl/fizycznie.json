                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d1e5430-f9f9-41c6-b049-339f8221d4bf",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "e8c7b19a-d2e2-37e2-a9eb-aeae3e340c5b",
                        "target_lang_word": "matériellement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "matériellement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6b2fd985-bec8-3b47-97bd-265990cc004d",
                                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                                        "glosses": [
                                            "Dans l’ancienne philosophie scolastique, par rapport à la matière, il est opposé à formellement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a7a35cb-1e8e-41e1-b441-a16c02590bd6",
                                                "sense_id": "6b2fd985-bec8-3b47-97bd-265990cc004d",
                                                "text": "L’homme est mortel matériellement et immortel formellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                                        "glosses": [
                                            "D’une manière matérielle, grossière."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "456676b4-3c75-478c-aad3-5f24a398943f",
                                                "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                                                "text": "[…] ils ne supportent pas le sous-développement du pays lors de leur séjour estival, mais de l'autre côté ils contribuent matériellement à l'essor du trabendo qui affaiblit toutes les initiatives d'émancipation nationale."
                                            },
                                            {
                                                "example_id": "43bd6c1e-7821-45b1-adcb-5e40255eae62",
                                                "sense_id": "6a78b44b-a13a-3958-a353-0990683bd984",
                                                "text": "Cette table est faite bien matériellement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                                        "entry_id": "a31508da-6012-3ee8-99da-aa36a26912d7",
                                        "glosses": [
                                            "Effectivement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a9b35895-dcc5-47c6-a2a1-91ab6f61f72e",
                                                "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                                                "text": "Celui qui se dirige d'après les lois de l’agronomie, c'est l’agriculteur ; celui qui exécute matériellement les principes de l’agriculture, c'est le cultivateur."
                                            },
                                            {
                                                "example_id": "78c49459-a4b3-45ea-8f34-067c71381440",
                                                "sense_id": "3eff7511-6e00-3489-b8f6-d71e7759fb64",
                                                "text": "Sire, il était matériellement impossible de deviner des projets que cet homme cachait à tout le monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "702d82a1-3a52-48c2-8075-e7037ff7cd61",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "e8c7b19a-d2e2-37e2-a9eb-aeae3e340c5b",
                        "target_lang_word": "sensiblement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sensiblement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                        "entry_id": "160d7d67-26ac-380a-9664-3b87b5742543",
                                        "glosses": [
                                            "D’une manière sensible, perceptible ou appréciable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "43be3793-ce7f-4111-8aa8-d8ba7ae7aacf",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "Les températures « vont baisser sensiblement par le Nord-Ouest d’ici à la fin de la semaine, sauf sur les régions les plus au Sud où elles pourront rester élevées », proches de 35°C, a souligné Olivier Caumont, de Météo-France."
                                            },
                                            {
                                                "example_id": "0c2eb24d-1dcc-47f8-93ee-05faa98e0a08",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "Les marnes bleues qui constituent le substratum des alluvions avec des faciès sensiblement identiques, d’Épineau-Ies-Voves à Appoigny, méritent de retenir l’attention au point de vue stratigraphique."
                                            },
                                            {
                                                "example_id": "a95dea63-c3a6-49a9-8c6f-ea36ef998ee3",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "L'installation de bord était sensiblement la même, avec cette différence, toutefois, que le poste émetteur et récepteur de T.S.F. […], avait été changé […]."
                                            },
                                            {
                                                "example_id": "af42eb4d-066d-4fc4-bc18-1d626670dacc",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "Songe avant-coureur d’aventure tragique ! Combien sensiblement cet accident s’explique !"
                                            },
                                            {
                                                "example_id": "4e5dbbd1-fd14-4e84-bc65-aca8b2dd6ee9",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "Si les grandes [maladies] l’altèrent sensiblement [le sens], je ne doute point que les petites n'y fassent impression à leur proportion,"
                                            },
                                            {
                                                "example_id": "44539dfc-3f84-443e-b765-b49d40d41a5d",
                                                "sense_id": "97284775-db5b-376b-a56e-cd6ad39a09ff",
                                                "text": "On voit fort sensiblement de dedans la lune notre terre tourner sur son centre,"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "903393fc-1042-3c9a-9109-98226ce7ab1f",
                                        "entry_id": "160d7d67-26ac-380a-9664-3b87b5742543",
                                        "glosses": [
                                            "D’une manière qui affecte le cœur, touchante, émouvante."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "051378b3-4a9f-4670-9399-548cc5ff0d97",
                                                "sense_id": "903393fc-1042-3c9a-9109-98226ce7ab1f",
                                                "text": "Ô Dieu ! que ce discours sensiblement me blesse !"
                                            },
                                            {
                                                "example_id": "f5b064e0-d3eb-4a0a-a722-bead651b8569",
                                                "sense_id": "903393fc-1042-3c9a-9109-98226ce7ab1f",
                                                "text": "Il saura, je le jure, Combien sensiblement me touche cette injure,"
                                            },
                                            {
                                                "example_id": "db173d1a-c5de-4f9f-99d7-b028ada48d23",
                                                "sense_id": "903393fc-1042-3c9a-9109-98226ce7ab1f",
                                                "text": "M. de Lamoignon ne fut pas si sensiblement touché des grâces qu’on fit à sa maison, que des secours qu’il obtint pour les hôpitaux,"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb8598a4-bbb9-4ab0-8507-3cce545e7211",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "71b50b51-9fd8-33db-a0d4-26568d90b399",
                        "target_lang_word": "physically",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physically",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                                        "glosses": [
                                            "In a physical manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8fd566d-348f-4b2c-b7c9-620339711621",
                                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                                "text": "“And whatʼs more,” the voice went on triumphantly, “the patient is both physically and neurally whole.”"
                                            },
                                            {
                                                "example_id": "70a945e1-37ea-4ed1-81d6-035402150832",
                                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                                "text": "Oh, yeah? Well, that's not physically possible for me to do! So there!"
                                            },
                                            {
                                                "example_id": "20d8b52c-456b-484e-9c94-8805328dbb45",
                                                "sense_id": "01d59149-7883-3afa-8c43-0aa0527d502c",
                                                "text": "In good times and bad, in sickness and health, the benefits of friendships between women are physically and psychologically undeniable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9d96b41c-94eb-368d-a77c-8980465e597b",
                                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                                        "glosses": [
                                            "According to the laws of physics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ba5aae98-359e-3461-9983-3d5ee5a498d2",
                                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                                        "glosses": [
                                            "Using physical force."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "eafa62c4-9ead-3404-8526-f7364f15d16a",
                                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                                        "glosses": [
                                            "Directly, rather than automatically or similar."
                                        ],
                                        "tags": [
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b13e187-0502-4846-a2f2-9aa12731b653",
                                                "sense_id": "eafa62c4-9ead-3404-8526-f7364f15d16a",
                                                "text": "After the software updated, I had to go in and physically change all the settings back to the way I wanted them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "000c0039-6f41-30f4-bd65-d10f914238c6",
                                        "entry_id": "11aee1f9-0645-3140-9a9e-32c74d00ebbe",
                                        "glosses": [
                                            "According to the rules of medicine."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "13f80d37-1b6d-49bb-af7e-a292e32708c2",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "71b50b51-9fd8-33db-a0d4-26568d90b399",
                        "target_lang_word": "physiquement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "physiquement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                        "entry_id": "bf15661f-a1e9-3cf0-adb1-f0ea97b94452",
                                        "glosses": [
                                            "D’une manière réelle et physique."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "177bcf1f-1832-409c-977d-4cef82ae6289",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "Il n'est pas physiquement impossible que…"
                                            },
                                            {
                                                "example_id": "eb2e29aa-0cce-478c-bec6-8d75634e39d4",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "C’est un homme qui est très bien physiquement."
                                            },
                                            {
                                                "example_id": "e2d39892-de84-45a7-a96f-2afccbe29bea",
                                                "sense_id": "f93cc015-1ded-3e1e-8a33-5a256afef744",
                                                "text": "Quelques heures plus tard, vers 17 heures, les deux hommes se retrouvent, physiquement cette fois, dans la salle de la commission des Lois de l’Assemblée, peu avant le début de la réunion sur la Nouvelle-Calédonie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c67efa4c-61bd-40aa-92cb-5c0929345610",
                        "source_entry_id": "854263ca-5036-39f8-b9be-3b42d096488d",
                        "source_sense_id": "eb25ae4a-7430-3776-ab5c-37f40c8078e1",
                        "target_lang_word": "constitutionally",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "constitutionally",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "45bc6aae-9476-3671-8867-b7f0f64614cb",
                                        "entry_id": "7f755f79-cb71-3620-ab6d-0bdeda8d138c",
                                        "glosses": [
                                            "Pertaining to one's bodily constitution; physically, physiologically."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc7b6191-9527-4e9d-b5b7-cc2881299c76",
                                                "sense_id": "45bc6aae-9476-3671-8867-b7f0f64614cb",
                                                "text": "These children are constitutionally sad. Other children, like Luke, develop depressive feelings out of the blue or in response to some mild stressor."
                                            },
                                            {
                                                "example_id": "03e7c3b4-f6e3-47fe-b7f6-98ee2ea1a4bf",
                                                "sense_id": "45bc6aae-9476-3671-8867-b7f0f64614cb",
                                                "text": "The astonishing progress of science had made God quite irrelevant; it had caused human beings to focus so intently on the physical world that they would soon be constitutionally unable to take God seriously."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87752c36-5ef2-3164-a32f-d4ceabbced7f",
                                        "entry_id": "7f755f79-cb71-3620-ab6d-0bdeda8d138c",
                                        "glosses": [
                                            "Pertaining to one's fundamental values or mental inclinations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b64072a-957b-4942-bbe1-505c5aaca3dc",
                                                "sense_id": "87752c36-5ef2-3164-a32f-d4ceabbced7f",
                                                "text": "The effect of this filtering of ideas through the convictions of a class which is constitutionally disposed to certain views is by no means confined to the masses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98a52172-d3e2-3293-b0f8-0733ed11c3ec",
                                        "entry_id": "7f755f79-cb71-3620-ab6d-0bdeda8d138c",
                                        "glosses": [
                                            "In accordance with a political constitution."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1453669f-2975-47ba-8643-7d9a09f77cf7",
                                                "sense_id": "98a52172-d3e2-3293-b0f8-0733ed11c3ec",
                                                "text": "“In our view, on the basis of the public record, former President Donald J. Trump is constitutionally disqualified from again being President (or holding any other covered office) because of his role in the attempted overthrow of the 2020 election and the events leading to the January 6 attack,” law professors William Baude and Michael Stokes Paulsen wrote for the University of Pennsylvania Law Review."
                                            }
