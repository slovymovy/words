                "senses": [
                    {
                        "sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "glosses": [
                            "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d75e8c29-4530-4f65-ad13-57a181d0c748",
                                "sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                                "text": "Sedna is een planetoïde in ons zonnestelsel."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad390d9e-0e38-411e-9e35-d49cd685f7f4",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "Asteroid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asteroid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a334b24d-88c8-393c-8715-3185dde01abc",
                                        "entry_id": "92f1a95c-dd42-3503-8e02-f475d18974c6",
                                        "glosses": [
                                            "kleines, planetenähnliches Objekt, welches sich auf einer Keplerschen Umlaufbahn um die Sonne bewegt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d211b613-39e5-42f0-bb42-743b5a13cd73",
                                                "sense_id": "a334b24d-88c8-393c-8715-3185dde01abc",
                                                "text": "Asteroiden sind mit bloßem Auge nicht zu beobachten."
                                            },
                                            {
                                                "example_id": "2dbbd1f9-4875-416c-b26f-31a1278530f9",
                                                "sense_id": "a334b24d-88c8-393c-8715-3185dde01abc",
                                                "text": "„Bald kam der Tag, an dem die Siedler schon zwei Jahre auf der Insel Lincoln wohnten, fast so einsam wie auf einem Asteroiden irgendwo im Milchstraßensystem.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bdc746c6-ec78-443a-8b62-eb92ee818cc3",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "Planetoid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Planetoid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1694f674-ed7d-3239-82ef-b49b7139dc37",
                                        "entry_id": "3a1d726c-8e59-3ae6-9e08-a2fb06d4ce32",
                                        "glosses": [
                                            "sich um die Sonne bewegender, planetenähnlicher Himmelskörper"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "69b337ce-61a6-4fdb-9ad9-e48460ffae8b",
                                                "sense_id": "1694f674-ed7d-3239-82ef-b49b7139dc37",
                                                "text": "„Ceres, sagte er betont langsam, habe man den Planetoiden getauft, den Piazzi zuerst gesichtet und dessen Umlaufbahn er, Gauß, bestimmt habe.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3da14ccc-83ea-49da-a5e4-0f8e58c08d60",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "Kleinplanet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kleinplanet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                        "entry_id": "f5854720-ba8e-3a86-af28-9417a250ba94",
                                        "glosses": [
                                            "Himmelskörper, die sich in einer direkten Umlaufbahn um die Sonne bewegen, jedoch die Kriterien zur Einstufung als Planet nicht erfüllen und auch nicht als Komet eingeordnet werden können."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7a86a07-c810-456d-ae17-c0de1f2b2ab5",
                                                "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                                "text": "„In Berlin wurde etwa über einen \"Steineisenmeteoriten\" berichtet, in dem Trümmer aus verschiedenen Silikatgesteinen in Nickeleisen eingebettet sind. Dieser differenzierte Meteorit könnte so entstanden sein: Ein Kleinplanet von 200 bis 500 Kilometer Durchmesser wurde von einem 50 bis 150 Kilometer dicken Brocken getroffen. Aus dem damals - vor 4,4 Milliarden Jahren - noch flüssigen Kern spritzte das Metall in ein Gemisch aus festen Trümmern, die auf diese Weise miteinander verklebt wurden.“"
                                            },
                                            {
                                                "example_id": "eb33802f-ffaa-4ad6-bd35-46d9f61bc938",
                                                "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                                "text": "„Doch nach Meinung der Astronomen ist Sedna gar kein richtiger Planet, sondern ein Planetoid oder Kleinplanet.“"
                                            },
                                            {
                                                "example_id": "15355c96-65b0-40bc-99f8-9e6f3217fa37",
                                                "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                                "text": "„Ein Asteroid ist ein Kleinplanet oder Planetoid, der sich in einer elliptischen Bahn um die Sonne bewegt und aus Mineralien besteht.“"
                                            },
                                            {
                                                "example_id": "18d38cde-0ba1-4ff6-a7c4-245ec70d5629",
                                                "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                                "text": "„Kaum jemand freut sich mehr darauf als Peter Stättmayer (65), Leiter der Volkssternwarte München. Er ist ein erfahrener Sternegucker, nach ihm wurde sogar ein Kleinplanet benannt.“"
                                            },
                                            {
                                                "example_id": "fd2e8417-6657-4d98-9cae-25be4424f2dd",
                                                "sense_id": "134c81c7-b00a-3a43-a41a-b4546ebc2aad",
                                                "text": "„Historisch gesehen sind die Begriffe Asteroid, Kleinplanet und Planetoid mehr oder weniger synonym. Das Problem ist aber komplizierter geworden, indem zahlreiche Kleinplaneten außerhalb der Jupiterbahn, insbesondere aber der Neptunbahn, entdeckt wurden, für welche der Begriff Asteroiden nicht gebräuchlich ist. Zudem gibt es Kleinplaneten, die „ausgasen“ und zugleich auch als Komet klassifiziert werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "012fcd07-d85a-4e2f-b1ac-7966c1ec4f1f",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "asteroid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "asteroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe6e2cf-0eee-3338-ad7b-ed33e2a45a1c",
                                        "entry_id": "8ec9b6f0-1f7d-30e8-985a-ae547e1c8d33",
                                        "glosses": [
                                            "A naturally occurring solid object, which is smaller than a planet and a dwarf planet, larger than a meteoroid and not a comet, that orbits a star and often has an irregular shape."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b147963a-f464-3ac0-9b33-75ce939cf9a6",
                                        "entry_id": "8ec9b6f0-1f7d-30e8-985a-ae547e1c8d33",
                                        "glosses": [
                                            "In the Solar system, such a body that orbits within the orbit of Jupiter"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f11b663-d372-457b-bbce-0c3f277b873c",
                                                "sense_id": "b147963a-f464-3ac0-9b33-75ce939cf9a6",
                                                "text": "The orbital planes of asteroids, minor bodies that circle the Sun mainly between the orbits of Mars and Jupiter, are often more tilted ..."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "asteroid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "764cf04e-1d44-3443-bc8d-526e02b2ec92",
                                        "entry_id": "45365527-2427-32bd-8f6a-4d7253edfdf3",
                                        "glosses": [
                                            "Any member of the taxonomic class Asteroidea; a starfish."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5af6f73d-6dc6-4e7b-9fab-871002b62878",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "planetoid",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "planetoid",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "An asteroid of any size"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffbeb2a9-aef8-4081-98e6-d0ed3c9843cf",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "The group of small bodies that circle round the Sun, outside the orbit of Mars, are known under the designation of the planetoids."
                                            },
                                            {
                                                "example_id": "06b36edf-5008-4162-a3cf-81f857d50c7e",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "Numbering of the Planetoids or Asteroidal Planets.—In numbering the planetoids a difficulty has arisen [...]"
                                            },
                                            {
                                                "example_id": "f34cf409-2073-45a6-8b3a-d82d2acbbfcd",
                                                "sense_id": "a9adb6b1-fcd0-3721-9801-d0174e415a75",
                                                "text": "if one can argue for the early existence of a few largely molten planetoids with dimension of kilometers or tens of kilometers, one can quite as easily argue for very large numbers of such planetoids."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "95858837-ab67-3e83-bed2-75e84e0a8e66",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "An asteroid-like body in an orbit beyond the asteroid belt, such as a centaur or Kuiper belt object"
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "A larger, planetary, body in orbit around the Sun, such as Vesta or (candidate) dwarf planets such Eris or Sedna"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cd1d5b6-4f7c-41b7-832e-b5c741cf1d6a",
                                                "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                                "text": "After discovering \"planetoids\", bodies orbiting the Sun, even larger than Pluto's moon Charon ... the question of how Sedna and other planetoids came to be."
                                            },
                                            {
                                                "example_id": "e95ad7b4-6719-43a2-9f36-9bdd1aa67d37",
                                                "sense_id": "fb4d82d7-cbb3-3694-b247-79374fee1971",
                                                "text": "Eris [...] was the upstart planetoid that knocked Pluto off the planetary lists"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c398d720-f51a-368a-8859-e838243a0452",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "Any planetary body, including classical planets and moons: a planetary-mass object"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "347d7ac8-0ac4-49c9-b914-cb568f9c0c17",
                                                "sense_id": "c398d720-f51a-368a-8859-e838243a0452",
                                                "text": "Plate tectonics is a style of convection for an active planetoid where lid fragment (plate) motions reflect sinking of dense lithosphere in subduction zones […] In 2015 humanity completed a 50+ year effort to survey the 30 largest planets, asteroids, satellites, and inner Kuiper Belt objects, which we informally call “planetoids”."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                        "entry_id": "a8b282b6-e0ca-38e0-9e4b-46f8e8978d4c",
                                        "glosses": [
                                            "A dwarf planet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "826c9af5-2840-49af-bdd8-36cf88c3b141",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "We prefer the word \"planetoid\" as a new word to describe round objects orbiting the sun."
                                            },
                                            {
                                                "example_id": "f3629c6b-f343-44af-b5bc-7f7cc43a7df6",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "A dwarf planet or a planetoid is a celestial body that [...]"
                                            },
                                            {
                                                "example_id": "13ce1a8f-8514-4b7a-a18b-8d8de6a4f3db",
                                                "sense_id": "76fbe27c-80d7-31c7-823d-001dda4152b1",
                                                "text": "'Dwarf planet' is a dumb phrase. For years we've called things like Pluto and Xena 'planetoids'—planetlike."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f7a3c834-f7ce-48fe-9130-326e09f5c18b",
                        "source_entry_id": "e891343b-f901-3b76-b95a-b1322cc59974",
                        "source_sense_id": "094fdd98-6395-3659-8028-aeb5fafa834b",
                        "source_sense_description": "een brok vaste materie die net als een planeet in een baan rond de zon draait, maar kleiner is dan een planeet",
                        "target_lang_word": "astéroïde",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Objet céleste dont la taille varie de quelques mètres à plusieurs centaines de kilomètres de diamètre, qui tourne autour du Soleil ou fait partie d’un autre système stellaire."
                                        ],
                                        "tags": [
                                            "Planétologie",
                                            "Astronomie observationnelle"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "105921ed-555d-4317-b0d0-db6057ebad4b",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "Au siècle suivant, les astronomes ont observé une nouvelle classe d’objets célestes qu’ils ont qualifiés d’« astéroïdes », et non de « planétoïdes », en dépit du fait qu’ils orbitaient autour du Soleil comme les planètes. Les premiers astéroïdes ont reçu le nom de Ceres, Pallas, Juno et Vesta. Comme des milliers d’autres, ils circulent entre les orbites de Mars et de Jupiter dans ce que l’on a conséquemment appelé la Ceinture d’astéroïdes."
                                            },
                                            {
                                                "example_id": "53ee3f54-7b36-45d8-b9c9-acd6524e4b64",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "Le premier objet interstellaire à avoir été observé passant près de notre système solaire est Oumuamua. Classé à l'origine comme une comète, Oumuamua a ensuite été reclassé comme un astéroïde, parce qu'il n'avait pas de coma."
                                            },
                                            {
                                                "example_id": "ee25de5c-0e13-430e-8202-5484c8c889e6",
                                                "sense_id": "cce1cfb2-daae-3d29-9d01-bc1ce22078b7",
                                                "text": "La ceinture de Kuiper est une région peuplée de milliers d’astéroïdes et de comètes de plus de 100 kilomètres de large."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Météorite."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c9f74c12-40bd-4162-8554-526905c396b7",
                                                "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                                "text": "Les mouvements apparents des étoiles filantes sont quelquefois directs, quelquefois rétrogrades, c’est-à-dire qu’au lieu de paraître provenir du Lion, les étoiles filantes semblent quelquefois être dirigées vers cette constellation. M. Valz a appelé avec raison l’attention sur cette particularité du phénomène qu’on ne peut expliquer qu’en admettant que le mouvement direct absolu des anneaux d’astéroïdes qui entourent au loin le Soleil est tantôt un peu plus lent, tantôt un peu plus rapide que celui de la Terre."
                                            },
                                            {
                                                "example_id": "f69349ac-4afe-4bb2-83a9-24c4ad825f00",
                                                "sense_id": "6d537ea7-7732-3fc5-ab98-2c8933ffd867",
                                                "text": "Barbicane avait saisi la main de ses deux compagnons, et tous trois regardaient à travers leurs paupières à demi fermées cet astéroïde chauffé à blanc. Si la pensée n’était pas détruite en eux, si leur cerveau fonctionnait encore au milieu de son épouvante, ils devaient se croire perdus !"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4af0bf61-45f3-3756-8df5-6b148e29dc33",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Petit corps céleste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c1e1949-68e5-4414-a800-35b15c89c180",
                                                "sense_id": "4af0bf61-45f3-3756-8df5-6b148e29dc33",
                                                "text": "Le Juste restait droit sur ses hanches solides :\nUn rayon lui dorait l’épaule ; des sueurs\nMe prirent : « Tu veux voir rutiler les bolides ?\nEt, debout, écouter bourdonner les flueurs\nD’astres lactés, et les essaims d’astéroïdes ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "56898bae-ab57-3aaa-b938-09690a16cbb9",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Petite tache blanche et opaque, en forme d’étoile, dans le corps vitré de l’œil."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4bddffe3-c190-36bc-b0dc-c0c0053b0b15",
                                        "entry_id": "05ce43da-9ef0-3dfe-b166-29326c612ff3",
                                        "glosses": [
                                            "Objet en forme d’étoile."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e549f8cf-9031-4b86-a004-8a5c0c414008",
                                                "sense_id": "4bddffe3-c190-36bc-b0dc-c0c0053b0b15",
                                                "text": "Les anges n’empruntent à la forme humaine que la tête ; le corps est remplacé par des ailes en plus ou moins grand nombre. On dirait des flammes nageant dans l’azur du ciel, et c’est au milieu de ces astéroïdes qu’apparaît, sur fond d’or, l’image du Christ, immense et dominant toute l’église."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                        "entry_id": "bbe52abf-3c31-3a75-ba8e-a7351af23faa",
                                        "glosses": [
                                            "Variante de astéride."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5412fe28-887a-4aad-8775-35a5c8f19d42",
                                                "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                                "text": "L’assertion de Sars, que l’animal qu’il avait autrefois appelé Bipinnaria asterigera, n’est probablement qu’une Astéroïde en voie de développement et pourvue d’un grand appareil de natation, mérite d’être prise en considération."
                                            },
                                            {
                                                "example_id": "fb06c6ef-d844-40da-9e35-e731afcc5f7b",
                                                "sense_id": "ee0e9154-7c59-305e-b057-31252d03bcb2",
                                                "text": "Mlle Dubois : un des volumes d’un savant ouvrage richement illustré L’univers et l’Humanité et une Astéroïde de la famille des Astérniées : Palmipes membranaerus, cette étoile de mer provient des environs de St-Vaast-la-Hougue."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3a38faf4-f698-3228-8df2-65de52852f06",
                                        "entry_id": "5d2d6eed-789a-3af6-9c0f-0babec842868",
                                        "glosses": [
                                            "Genre d'astéracées à capitules jaunes appartenant au genre Buphthalmum; synonyme de buphthalme. → voir buphthalme"
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5e91a4-41a2-4f3c-8c95-42c137bae013",
                                                "sense_id": "3a38faf4-f698-3228-8df2-65de52852f06",
                                                "text": "L’astéroïde à feuille de Saule. Buphthalmum salicifolium. La tige herbacée, velue, ronde, droite, haute d’un pied ; les feuilles alternes, lancéolées comme dentelées, velues. Les calices nus ; les fleurs d’un jaune foncé. On trouve cette plante, qui est vivace, dans plusieurs de nos provinces."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aad492d3-fe07-330e-a0b3-0353fd60a05e",
                                        "entry_id": "a95a1f97-5821-3b85-8699-6e946c968d21",
                                        "glosses": [
                                            "Courbe ressemblant au carreau des cartes à jouer et obtenue par le déplacement d’un point fixe situé sur un cercle de rayon 1 qui « roule » le long de l’intérieur d’un cercle de rayon 4."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ec7c158-8e42-48b3-be12-5d4da6db645a",
                                                "sense_id": "aad492d3-fe07-330e-a0b3-0353fd60a05e",
                                                "text": "Les courbes parallèles aux astéroïdes sont-elles toujours des astéroïdes ? Une astéroïde est la courbe enveloppée par une droite mobile r sur laquelle deux droites fixes a, b, formant un angle 2a, déterminent un segment à longueur donnée l ; si 2a = ½π, on dit que l’astéroïde est régulière."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "astéroïde",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "2b80b5f9-f91d-3e0a-9f6f-e33acb569deb",
                                        "entry_id": "256a983c-2b0d-3919-8773-8aaca27fe29d",
                                        "glosses": [
                                            "Qualifie un organisme en forme d’étoile."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "68045047-c86e-43a7-86bc-674a4fed65f1",
                                                "sense_id": "2b80b5f9-f91d-3e0a-9f6f-e33acb569deb",
                                                "text": "L’in­térêt de ces observations n’est pas d’ordre clinique, mais consiste en ce que le champignon pathogène s’est présenté, dans le pus gom­meux, sous la forme astéroïde si curieuse, signalée par Splendore, au Brésil, en 1908, à propos d’un cas de sporotrichose humaine seul connu jusqu’ici."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22e19e88-d695-3eff-b947-6bfd2d3af392",
                                        "entry_id": "256a983c-2b0d-3919-8773-8aaca27fe29d",
                                        "glosses": [
                                            "Qui ressemble à une astérie."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
