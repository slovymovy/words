                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abchazja",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "602ce51e-9136-3c5f-b22c-940b2c1ebc96",
                                        "entry_id": "4052078c-8c57-3fa9-898f-eeea16d1750c",
                                        "glosses": [
                                            "formalnie republika autonomiczna wchodząca w skład Gruzji"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
