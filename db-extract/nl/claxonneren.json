                        "glosses": [
                            "toeteren met de claxon van de auto"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e1d6aac-7257-4345-904f-58c8e4ca9b6a",
                                "sense_id": "3cf56354-e3de-3d41-9851-c88aba4c536f",
                                "text": "Voor De Rycke zijn het niet meer dan opstapjes voor observaties en verhalen die lopen van de dubbele betekenis van claxonneren tot zijn weerzin tegen vegetarisch eten. Het zijn modale thema’s, die leiden tot veel grappen die geforceerd aandoen."
                            },
                            {
                                "example_id": "723814f7-82d9-4d3e-b4de-8d79d5b2f4e1",
                                "sense_id": "3cf56354-e3de-3d41-9851-c88aba4c536f",
                                "text": "In zijn maandelijkse rapportage schrijft Google dat de auto’s nu onderscheid kunnen maken tussen mogelijk gevaarlijke situaties en false positives: overbodig claxonneren dat andere weggebruikers irriteert."
                            }
                        ]
                    }
