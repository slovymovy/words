                "senses": [
                    {
                        "sense_id": "31f7d23f-9bcc-3c0b-8d9e-dc786d89faa6",
                        "entry_id": "8bbace1d-d98b-3b77-b18a-408c5a570d81",
                        "glosses": [
                            "mit der Vollmacht zur Vertretung eines Klägers oder Verklagten beauftragte weibliche Person in einem Zivilprozess"
                        ],
                        "tags": [
                            "Rechtswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "a70cfb6c-658e-4315-96e6-28347e020d73",
                                "sense_id": "31f7d23f-9bcc-3c0b-8d9e-dc786d89faa6",
                                "text": "„Das Gericht habe bestätigt, dass der TÜV seine Aufgaben verantwortungsvoll und im Einklang mit allen geltenden Gesetzen und Normen wahrgenommen habe, sagte die Prozessbevollmächtigte Ina Brock.“"
                            },
                            {
                                "example_id": "f3414f24-d103-4960-a3a1-2d2cb6591eb6",
                                "sense_id": "31f7d23f-9bcc-3c0b-8d9e-dc786d89faa6",
                                "text": "„Aufgrund dieser Entscheidung hat die Prozessbevollmächtigte des Oberbergamtes bei der Gemeinde Heusweiler angefragt, ob sie das Rechtsstreitverfahren gegen das Oberbergamt weiter betreiben will.“"
                            },
                            {
                                "example_id": "e81f6605-9b0c-4f45-8133-9c24e8e8da39",
                                "sense_id": "31f7d23f-9bcc-3c0b-8d9e-dc786d89faa6",
                                "text": "„Allerdings: Kurz vor der mündlichen Verhandlung am Verwaltungsgericht Koblenz machte ihre Prozessbevollmächtigte einen Rückzieher und zog die Klage zurück.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
