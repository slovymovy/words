                                "tr": "Dersin <w>eğitici</w> olması amaçlanmıştı ama öğrenciler dersi oldukça sıkıcı buldu.",
                                "nl": "De lezing was bedoeld als <w>vormend</w>, maar de studenten vonden het nogal saai.",
                                "de": "Der Vortrag sollte eigentlich <w>erbaulich</w> sein, aber die Studenten fanden ihn ziemlich langweilig.",
                                "fr": "La conférence se voulait <w>édifiante</w>, mais les étudiants l'ont trouvée plutôt ennuyeuse.",
                                "it": "La conferenza doveva essere <w>edificante</w>, ma gli studenti l'hanno trovata piuttosto noiosa.",
                                "cs": "Přednáška měla být <w>výchovná</w>, ale studentům připadala poněkud nudná.",
                                "es": "La conferencia pretendía ser <w>formativa</w>, pero los estudiantes la encontraron bastante aburrida.",
                                "zh": "这场讲座本意是<w>有教益的</w>，但学生们觉得相当乏味。"
                            }
                        }
