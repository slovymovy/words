                        "examples": [
                            {
                                "example_id": "e39d1146-8556-47b7-80ac-8b8d3b4cef42",
                                "sense_id": "ff06166d-7391-3f9e-8cb6-5eb04a251011",
                                "text": "En ik zal niet toestaan dat jij je dochters toekomst vergooit zoals mijn ouders de mijne verspeelden."
                            },
                            {
                                "example_id": "0c1d7258-6eb1-4ce4-91c3-3b4d264e73f9",
                                "sense_id": "ff06166d-7391-3f9e-8cb6-5eb04a251011",
                                "text": "Otto ziet eruit alsof een deel van zijn ziel is verdampt door zijn dochters verdwijning."
                            }
                        ]
                    }
