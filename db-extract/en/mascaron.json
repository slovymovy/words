                        ]
                    },
                    {
                        "translation_id": "dcebf720-9bd1-4aed-a020-d8c6bcce6041",
                        "source_entry_id": "bd6bf656-7cce-3f33-9945-4ae86f86acaf",
                        "source_sense_id": "e9837dac-28ca-309a-b541-af58a06c86a9",
                        "source_sense_description": "carved, ornamental face",
                        "target_lang_word": "mascaron",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mascaron",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                        "entry_id": "4e0cd46c-ee7f-3f6d-ab20-c187ef1f1bee",
                                        "glosses": [
                                            "Tête ou masque de fantaisie, d’hommes et d’animaux, en ronde-bosse ou en bas-relief, qu’on met pour ornement à la clef des arcades, aux fontaines, à la décoration des objets tels que les vases, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "689276b6-bf58-4089-b2b0-ea55f8dfc4c0",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "(...) de même que tous les ornements de sculptures de cette porte, où l’on distingue encore les mascarons & d’autres choses qui sont d’une grande propreté & parfaitement bien placées."
                                            },
                                            {
                                                "example_id": "8804f49a-adc2-4c90-a490-c259bf7db691",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Deux fort belles tables de marqueterie (...). Elles sont ornées de bandes, termes, agrafes & mascarons de Bronze parfaitement reparés & dorés d’or moulu."
                                            },
                                            {
                                                "example_id": "240b186b-ab0b-405f-a05e-051bf6c92053",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Elle avait dans sa belle pierre de taille, avariée par le temps, un certain air de grandeur Louis-quatorzienne (permettez ce barbarisme) ; les chaînes de la façade figurent des assises, les tableaux en briques rouges rappellent les côtés des écuries à Versailles, les fenêtres cintrées ont des mascarons pour ornements à la clef du cintre et sous l’appui."
                                            },
                                            {
                                                "example_id": "6a922f67-1383-4779-aca5-7b49a6ef8aff",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Il l’aperçut enfin, et sortant de sa méditation creuse, il prit la pièce d’un geste brusque et fou et la plongea dans sa pochette en grommelant quelques vagues injures, puis, le démon des vers s’emparant de nouveau de lui, il se mit à brocher des babines, à rouler des yeux, à faire des grimaces aussi curieuses au moins que celles des mascarons sculptés par Germain Pilon sous la corniche du Pont-Neuf, accompagnant le tout de mouvements de doigts pour scander les pieds du vers qu’il murmurait entre ses dents, qui le rendaient semblable à un joueur de mourre, et réjouissaient les polissons réunis en cercle autour de lui."
                                            },
                                            {
                                                "example_id": "c84ec582-a7ea-492f-a5b2-c30dfb37e734",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Ce qu’on appelait jadis le vent de Fronde courait dans le Marais. Sur le fronton des grands hôtels, la grimace joyeuse des mascarons de pierre avait l’air de dire : « Je connais ça. »"
                                            },
                                            {
                                                "example_id": "0b5a6808-2280-447e-9ed2-95c85d435f02",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Au-dessus du mascaron cornu, que la blanche Aline prenait pour le diable, deux nymphes de marbre s'enlaçaient, debout et penchées sur le bassin obscur."
                                            },
                                            {
                                                "example_id": "00656ae3-7711-4fba-b319-d9bb2cc4bdda",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Combien de balcons en ferronnerie, de mascarons, de pilastres nous restituent l'image de ce que fut cette cité au XVIᵉ, au XVIIᵉ, au XVIIIᵉ siècle."
                                            },
                                            {
                                                "example_id": "30357f91-485e-41d5-b7b2-b32ccff91038",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Les seuls qui répondaient, un peu, à ce qu’on attendait d’eux étaient les conducteurs de certains fourgons plats : ils avaient la tête entourée d’une sorte d’écran transparent, en forme de calice, évasé, ouvert vers le haut, qui leur donnait une curieuse allure de mascarons, de figures grotesques de foire."
                                            },
                                            {
                                                "example_id": "d2db5df0-064e-4939-96bd-6487bcde1b0c",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Un éclair illumina violemment les façades de pierre blanche, dévoilant les mascarons, grimaçants et torturés (...)"
                                            },
                                            {
                                                "example_id": "c289ac1f-d579-432c-84b1-721e3c3b31e3",
                                                "sense_id": "c9f85b26-b634-38e7-9f9c-c366811494d0",
                                                "text": "Le 15 février 1989, une violente explosion détruit un bâtiment de cinq étages dans le vieux Toulon. Le bilan est de 13 morts et 32 blessés. L’immeuble était baptisé « Maison des têtes » en raison de mascarons posés sur le fronton des fenêtres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ca4f710-1109-3419-82a2-c1b778ea8b6c",
                                        "entry_id": "4e0cd46c-ee7f-3f6d-ab20-c187ef1f1bee",
                                        "glosses": [
                                            "Obturateur destiné à boucher un trou prévu pour la pose d'un robinet sur un lavabo, baignoire, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cbc4a2b-f9d3-483a-ab5b-b3cd72046c96",
                                                "sense_id": "1ca4f710-1109-3419-82a2-c1b778ea8b6c",
                                                "text": "Un mascaron cache l'emplacement originel d'un robinet qui permettait l'écoulement de l'eau pour nettoyer l'intérieur de l'aquarium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
