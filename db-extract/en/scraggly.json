                                                "example_id": "0ec8d7d9-bb4d-41c8-b761-ea56b327f26d",
                                                "sense_id": "a4bc0561-2179-3768-8609-5cc3c48c9238",
                                                "text": "In seinem Zimmer herrscht ein wildes Durcheinander."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "9e9f46db-2a20-3200-b3ca-5723810a8b54",
