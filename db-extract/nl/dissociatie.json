                                    {
                                        "sense_id": "bf86960c-9ecf-3305-a500-a2996efbfc39",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "The act of dissociating or disuniting; a state of separation; disunion."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e832faab-69e9-4a63-b5b4-9ab0a2ead964",
                                                "sense_id": "bf86960c-9ecf-3305-a500-a2996efbfc39",
                                                "text": "A general observation in memory studies of individuals with ASD is that they tend to experience greater difficulties on tests of free recall than tests of recognition or cued recall (Boucher, Mayes, & Bigham, 2012). In its own right, this pattern suggests greater difficulties with retrieval through recollection than through familiarity, but there is also more direct evidence for this dissociation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "The process by which a compound body breaks up into simpler constituents; said particularly of the action of heat on gaseous or volatile substances."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2bf61b6-0c73-478b-b1e9-9b8e2a4461bd",
                                                "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                                "text": "the dissociation of the sulphur molecules"
                                            },
                                            {
                                                "example_id": "d6134a79-83ba-4421-b63b-2efb694817a2",
                                                "sense_id": "091c5375-e842-37bf-9f54-c7d5f1da0b6b",
                                                "text": "the dissociation of ammonium chloride into hydrochloric acid and ammonia"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa2ab25a-6f71-3dd1-b25c-7dcde90a99c4",
                                        "entry_id": "4bed5008-66f9-3130-8783-73850d424330",
                                        "glosses": [
                                            "A defence mechanism where certain thoughts or mental processes are compartmentalised in order to avoid emotional stress to the conscious mind."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf2cad7d-d2b0-4d64-b5bc-96f3ac05ff3d",
                                                "sense_id": "aa2ab25a-6f71-3dd1-b25c-7dcde90a99c4",
                                                "text": "Project MONARCH could be best described as a form of structured dissociation and occultic integration, carried out in order to compartmentalize the mind into multiple personalities within a systematic framework."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "998b968a-31ed-4259-ba2e-97d5cc54930d",
                        "source_entry_id": "7f5a58b8-d905-30fc-b866-5d9bd1662d08",
                        "source_sense_id": "b357ed0d-00ba-3430-9aea-986c76e7b077",
