                                "example_id": "44bd86ab-e4c1-4884-8f68-5a58e036748a",
                                "sense_id": "32e31c82-b726-3014-bd89-ccb91a6f12da",
                                "text": "„Zwei Kinder im Alter von acht und zehn Jahren sowie ihr Großvater sind in der Nacht auf Freitag bei einem Wohnhausbrand in der Oststeiermark gestorben.“"
                            },
                            {
                                "example_id": "0eba03a1-ee97-4548-a878-050d854d277c",
                                "sense_id": "32e31c82-b726-3014-bd89-ccb91a6f12da",
                                "text": "„Bei einem Wohnhausbrand in Inning am Ammersee sind sieben Erwachsene und drei Kinder leicht verletzt worden.“"
                            }
