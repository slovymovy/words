{
    "word_family": [
        "sparkle",
        "sparkler",
        "sparky",
        "sparkless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "b6359187-0074-378c-80af-987b4570636a",
                    "sense_definition": "A small particle of glowing matter, either molten or on fire, resulting from a fire or friction.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "fire_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "A single <w>spark</w> from the campfire landed on the dry leaves.",
                            "target_lang_translations": {
                                "ru": "Одна единственная <w>искра</w> от костра упала на сухие листья.",
                                "de": "Ein einzelner <w>Funke</w> vom Lagerfeuer landete auf den trockenen Blättern."
                            }
                        },
                        {
                            "text": "The grinding metal sent a bright <w>spark</w> flying across the room.",
                            "target_lang_translations": {
                                "ru": "От скрежета металла яркая <w>искра</w> полетела через всю комнату.",
                                "de": "Das schleifende Metall ließ einen hellen <w>Funken</w> durch den Raum fliegen."
                            }
                        }
                    ],
                    "synonyms": [
                        "ember",
                        "cinder"
                    ],
                    "common_phrases": [
                        "bright spark",
                        "fly sparks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Мельчайшая частица горящего или раскаленного вещества, возникающая от огня или трения.",
                        "de": "Ein kleines, glühendes Teilchen, das bei Feuer oder Reibung entsteht."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искра",
                                "target_lang_sense_clarification": "частица огня"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Funke",
                                "target_lang_sense_clarification": "glühendes Teilchen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1bbdc321-92a2-3f4e-9780-44ce6d6bb207",
                    "sense_definition": "A short or small burst of electrical discharge.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There was a blue <w>spark</w> when I plugged in the old toaster.",
                            "target_lang_translations": {
                                "ru": "Когда я включил старый тостер, проскочила голубая <w>искра</w>.",
                                "de": "Es gab einen blauen <w>Funken</w>, als ich den alten Toaster einsteckte."
                            }
                        },
                        {
                            "text": "Static electricity caused a small <w>spark</w> when he touched the doorknob.",
                            "target_lang_translations": {
                                "ru": "Статическое электричество вызвало небольшую <w>искру</w>, когда он коснулся дверной ручки.",
                                "de": "Statische Elektrizität verursachte einen kleinen <w>Funken</w>, als er die Türklinke berührte."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "arc"
                    ],
                    "target_lang_definitions": {
                        "ru": "Короткий или небольшой электрический разряд.",
                        "de": "Ein kurzer elektrischer Entladungsvorgang."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искра",
                                "target_lang_sense_clarification": "электрическая"
                            },
                            {
                                "target_lang_word": "разряд",
                                "target_lang_sense_clarification": "электрический"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Funke",
                                "target_lang_sense_clarification": "elektrische Entladung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83c65942-283b-3593-9548-19e0baf66076",
                    "sense_definition": "A small amount of something, such as an idea, feeling, or quality, that has the potential to grow.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt a sudden <w>spark</w> of inspiration for her new novel.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала внезапную <w>искру</w> вдохновения для своего нового романа.",
                                "de": "Sie spürte einen plötzlichen <w>Funken</w> der Inspiration für ihren neuen Roman."
                            }
                        },
                        {
                            "text": "There was not a <w>spark</w> of truth in his explanation.",
                            "target_lang_translations": {
                                "ru": "В его объяснении не было ни <w>искры</w> правды.",
                                "de": "In seiner Erklärung steckte nicht ein <w>Funke</w> Wahrheit."
                            }
                        }
                    ],
                    "synonyms": [
                        "glimmer",
                        "trace",
                        "hint",
                        "germ",
                        "atom",
                        "grain",
                        "iota",
                        "modicum",
                        "scintilla"
                    ],
                    "common_phrases": [
                        "spark of hope",
                        "spark of life",
                        "spark of genius",
                        "bright spark"
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшое количество чего-либо (идеи, чувства), имеющее потенциал к росту; проблеск.",
                        "de": "Ein kleiner Ansatz oder ein Anzeichen für etwas, das sich entwickeln kann (z. B. Idee, Gefühl)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искра",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "проблеск",
                                "target_lang_sense_clarification": "надежды, истины"
                            },
                            {
                                "target_lang_word": "вспышка",
                                "target_lang_sense_clarification": "вдохновения"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Funke",
                                "target_lang_sense_clarification": "übertragen: Ansatz, Spur"
                            },
                            {
                                "target_lang_word": "Anflug",
                                "target_lang_sense_clarification": "geringe Spur von etwas"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0a83a72b-abf5-3e7a-8e8a-e7b5af8fea6c",
                    "sense_definition": "An electrician.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to call a <w>spark</w> to fix the wiring in the kitchen.",
                            "target_lang_translations": {
                                "ru": "Нам нужно вызвать <w>электрика</w>, чтобы починить проводку на кухне.",
                                "de": "Wir müssen einen <w>Elektriker</w> rufen, um die Verkabelung in der Küche zu reparieren."
                            }
                        },
                        {
                            "text": "The <w>spark</w> arrived with his tools to check the fuse box.",
                            "target_lang_translations": {
                                "ru": "<w>Электрик</w> приехал со своими инструментами, чтобы проверить блок предохранителей.",
                                "de": "Der <w>Elektriker</w> kam mit seinem Werkzeug, um den Sicherungskasten zu überprüfen."
                            }
                        }
                    ],
                    "synonyms": [
                        "sparky",
                        "electrician"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "British"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Электрик (разговорное).",
                        "de": "Eine Person, die elektrische Anlagen installiert oder repariert."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "электрик",
                                "target_lang_sense_clarification": "профессия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Elektriker",
                                "target_lang_sense_clarification": "Berufsbezeichnung"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "749cb309-1f9d-3d50-807f-63312b2caaf0",
                    "sense_definition": "A fashionable, gallant, or foppish young man.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The young <w>spark</w> tried to impress the ladies with his fine clothes.",
                            "target_lang_translations": {
                                "ru": "Молодой <w>щеголь</w> пытался впечатлить дам своей изысканной одеждой.",
                                "de": "Der junge <w>Geck</w> versuchte, die Damen mit seiner feinen Kleidung zu beeindrucken."
                            }
                        },
                        {
                            "text": "He was known as a wild <w>spark</w> in his youth.",
                            "target_lang_translations": {
                                "ru": "В молодости он слыл отчаянным <w>гулякой</w>.",
                                "de": "In seiner Jugend war er als wilder <w>Stutzer</w> bekannt."
                            }
                        }
                    ],
                    "synonyms": [
                        "dandy",
                        "fop",
                        "gallant",
                        "beau",
                        "blade"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Модный, галантный или щеголеватый молодой человек (устаревшее).",
                        "de": "Ein modischer, oft etwas eitler junger Mann (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "щеголь",
                                "target_lang_sense_clarification": "модник"
                            },
                            {
                                "target_lang_word": "франт",
                                "target_lang_sense_clarification": "устаревшее"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Geck",
                                "target_lang_sense_clarification": "modischer, eitler Mann"
                            },
                            {
                                "target_lang_word": "Stutzer",
                                "target_lang_sense_clarification": "veraltet für einen modischen Mann"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cac7750e-2b97-3a78-af26-42834f788d3d",
                    "sense_definition": "To trigger or cause something to start, such as an argument, event, or reaction.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "metaphorical_start",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The controversial article <w>sparked</w> a fierce debate online.",
                            "target_lang_translations": {
                                "ru": "Спорная статья <w>спровоцировала</w> ожесточенные дебаты в интернете.",
                                "de": "Der kontroverse Artikel <w>löste</w> eine heftige Online-Debatte aus."
                            }
                        },
                        {
                            "text": "His speech <w>sparked</w> hope in the hearts of the people.",
                            "target_lang_translations": {
                                "ru": "Его речь <w>зажгла</w> надежду в сердцах людей.",
                                "de": "Seine Rede <w>entfachte</w> Hoffnung in den Herzen der Menschen."
                            }
                        }
                    ],
                    "synonyms": [
                        "trigger",
                        "ignite",
                        "provoke",
                        "stimulate",
                        "kindle"
                    ],
                    "antonyms": [
                        "dampen",
                        "extinguish",
                        "suppress"
                    ],
                    "common_phrases": [
                        "spark a debate",
                        "spark interest",
                        "spark joy",
                        "spark a conversation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Спровоцировать или послужить причиной начала чего-либо (спора, события).",
                        "de": "Etwas auslösen oder den Beginn von etwas verursachen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вызвать",
                                "target_lang_sense_clarification": "стать причиной"
                            },
                            {
                                "target_lang_word": "спровоцировать",
                                "target_lang_sense_clarification": "конфликт, спор"
                            },
                            {
                                "target_lang_word": "разжечь",
                                "target_lang_sense_clarification": "переносное: чувства, дебаты"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "auslösen",
                                "target_lang_sense_clarification": "einen Prozess starten"
                            },
                            {
                                "target_lang_word": "entfachen",
                                "target_lang_sense_clarification": "übertragen: Gefühle oder Debatten"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cf8a14d-0f18-3c7b-96ca-f6cf020bfbfe",
                    "sense_definition": "To give off sparks of fire or electricity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fire_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The broken cable began to <w>spark</w> and smoke dangerously.",
                            "target_lang_translations": {
                                "ru": "Порванный кабель начал <w>искрить</w> и опасно дымиться.",
                                "de": "Das defekte Kabel begann gefährlich zu <w>funken</w> und zu rauchen."
                            }
                        },
                        {
                            "text": "The wheels of the train <w>sparked</w> against the metal tracks.",
                            "target_lang_translations": {
                                "ru": "Колеса поезда <w>искрили</w> при трении о металлические рельсы.",
                                "de": "Die Räder des Zuges <w>funkten</w> auf den Metallschienen."
                            }
                        }
                    ],
                    "synonyms": [
                        "flash",
                        "flare",
                        "flicker"
                    ],
                    "target_lang_definitions": {
                        "ru": "Искрить, выбрасывать искры.",
                        "de": "Funken aussenden oder sprühen."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "искрить",
                                "target_lang_sense_clarification": "выделять искры"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "funken",
                                "target_lang_sense_clarification": "Funken abgeben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f26e9616-8291-34a6-aa89-4d31636decef",
                    "sense_definition": "To light or kindle a fire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "fire_light",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He used a flint to <w>spark</w> the dry grass into a flame.",
                            "target_lang_translations": {
                                "ru": "Он использовал кремень, чтобы <w>поджечь</w> сухую траву.",
                                "de": "Er benutzte einen Feuerstein, um das trockene Gras zu <w>entzünden</w>."
                            }
                        },
                        {
                            "text": "She <w>sparked</w> her lighter to see in the dark.",
                            "target_lang_translations": {
                                "ru": "Она <w>чиркнула</w> зажигалкой, чтобы осмотреться в темноте.",
                                "de": "Sie <w>zündete</w> ihr Feuerzeug an, um im Dunkeln sehen zu können."
                            }
                        }
                    ],
                    "synonyms": [
                        "ignite",
                        "light",
                        "kindle"
                    ],
                    "antonyms": [
                        "extinguish"
                    ],
                    "target_lang_definitions": {
                        "ru": "Зажечь или раздуть огонь.",
                        "de": "Ein Feuer entzünden."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зажечь",
                                "target_lang_sense_clarification": "огонь"
                            },
                            {
                                "target_lang_word": "воспламенить",
                                "target_lang_sense_clarification": "поджечь"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "entzünden",
                                "target_lang_sense_clarification": "Feuer anmachen"
                            },
                            {
                                "target_lang_word": "anfachen",
                                "target_lang_sense_clarification": "ein Feuer zum Brennen bringen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8661b161-71d4-39d2-90e3-0cc4f22e4ea7",
                    "sense_definition": "To woo or court someone romantically.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "romance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, a young man would <w>spark</w> his sweetheart on the front porch.",
                            "target_lang_translations": {
                                "ru": "В былые времена молодой человек <w>ухаживал</w> за своей возлюбленной на крыльце.",
                                "de": "Früher pflegte ein junger Mann auf der Veranda um seine Liebste zu <w>werben</w>."
                            }
                        },
                        {
                            "text": "He went out to <w>spark</w> the neighbor's daughter.",
                            "target_lang_translations": {
                                "ru": "Он пошел <w>ухаживать</w> за дочерью соседа.",
                                "de": "Er ging aus, um um die Tochter des Nachbarn zu <w>werben</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "court",
                        "woo",
                        "romance"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "or dialectal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ухаживать за кем-то с романтическими намерениями (устаревшее).",
                        "de": "Jemanden umwerben (veraltet)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ухаживать",
                                "target_lang_sense_clarification": "романтически"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "umwerben",
                                "target_lang_sense_clarification": "romantisch den Hof machen"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5fac7907-b815-309a-b582-0da611f88662",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Spark</w> signed the document at the bottom of the page.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Спарк</w> подписал документ внизу страницы.",
                                "de": "Herr <w>Spark</w> unterschrieb das Dokument am unteren Ende der Seite."
                            }
                        },
                        {
                            "text": "I met a woman named Sarah <w>Spark</w> at the conference.",
                            "target_lang_translations": {
                                "ru": "На конференции я встретил женщину по имени Сара <w>Спарк</w>.",
                                "de": "Ich habe auf der Konferenz eine Frau namens Sarah <w>Spark</w> getroffen."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "de": "Ein Familienname."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Спарк",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "de": [
                            {
                                "target_lang_word": "Spark",
                                "target_lang_sense_clarification": "Eigenname"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}