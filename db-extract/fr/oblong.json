                            {
                                "target_word": "oblong",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e2f5f649-bdc5-3bb1-9ab2-3275c9ba6602",
                                        "entry_id": "f0fb80ba-d389-3974-957e-5895cbf8df05",
                                        "glosses": [
                                            "To extend so as to form an oblong shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c55353e-f4d3-47f5-9715-b1ddc2fcda4a",
                                                "sense_id": "e2f5f649-bdc5-3bb1-9ab2-3275c9ba6602",
                                                "text": "[…]; by John Denmans hom lot on the north sid the front by a salt crek the reare to the comon which hom lot with all the upland oblonging to it conteining to about fourtie acers more or lese with about one acer & half of salt medo liing before the said house[…]"
                                            },
                                            {
                                                "example_id": "860c0cc1-257e-4d08-94c9-eea773cf03af",
                                                "sense_id": "e2f5f649-bdc5-3bb1-9ab2-3275c9ba6602",
                                                "text": "That the Gilbert tract, according to his opinion and the law, ought to have been oblonged up the creek. That by oblonging it across the creek, it afforded Elijah Robertson, who superintended the surveying, an opportunity of laying a warrant not located there, for himself, and thereby takes 5,000 acres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a218eb3-e220-382a-ae0d-914a909d8716",
                                        "entry_id": "f0fb80ba-d389-3974-957e-5895cbf8df05",
                                        "glosses": [
                                            "To give an oblong shape to."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa57e7a3-5a41-4c95-95e3-6fc5553c26ff",
                                                "sense_id": "7a218eb3-e220-382a-ae0d-914a909d8716",
                                                "text": "A. Why, by dropping them off of cars or dropping them off of trucks or some way it would oblong them ."
                                            },
                                            {
                                                "example_id": "90174411-c380-4c13-a5ca-604ccbe6bd25",
                                                "sense_id": "7a218eb3-e220-382a-ae0d-914a909d8716",
                                                "text": "His silhouette: broad shoulders, big legs, a square face oblonged by a crest of thick hair and almost lantern jaw."
                                            },
                                            {
                                                "example_id": "36946558-d982-45e9-9005-4369a43af1e9",
                                                "sense_id": "7a218eb3-e220-382a-ae0d-914a909d8716",
                                                "text": "And there were suddenly berries where there had been none before, bright red and bright blue, all with a careless water drop oblonging their form."
                                            },
                                            {
                                                "example_id": "a2723a9e-7be7-444b-808a-ca5aa253b1f8",
                                                "sense_id": "7a218eb3-e220-382a-ae0d-914a909d8716",
                                                "text": "[…] the venue (a private country club nestled in the woods outside Cincinnati, with a dance hall whose ceilings went straight to the moon), to the ice cubes (truly cubed, not oblonged or crushed, and king-sized cubes for the bourbon rocks),"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
