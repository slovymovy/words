                                    {
                                        "sense_id": "cb4884f5-e0eb-3276-9c61-07e17c1ccda0",
                                        "entry_id": "8433bd50-ad40-3fa2-ae0e-d2baf0c0afef",
                                        "glosses": [
                                            "A callous growth, especially on the foot; a corn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "db01a681-22b3-4aa9-b15f-80309819b597",
                                                "sense_id": "cb4884f5-e0eb-3276-9c61-07e17c1ccda0",
                                                "text": "In a review of over 1000 interdigital clavuses, 65% were found in the fourth interspace, while the first and third web space clavuses were found in 17% and 16% of the patients respectively[…]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
