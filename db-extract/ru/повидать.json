                "senses": [
                    {
                        "sense_id": "bd3d80e7-8b1a-3350-9d27-bc650307d5f5",
                        "entry_id": "884df9b1-1d99-3de7-a045-86ecea6a8a79",
                        "glosses": [
                            "to see, to get to see"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "2f32e340-1215-4c96-b1c2-599c1e42cc95",
                                "sense_id": "bd3d80e7-8b1a-3350-9d27-bc650307d5f5",
                                "text": "Он мно́гое повида́л на своём веку́.",
                                "translation": "He got to see a lot in his life.",
                                "english": "He got to see a lot in his life."
                            }
                        ]
                    },
                    {
                        "sense_id": "79593666-d17e-339a-aaf6-261504f1b45c",
                        "entry_id": "884df9b1-1d99-3de7-a045-86ecea6a8a79",
                        "glosses": [
                            "to visit"
                        ],
                        "tags": [
                            "colloquial",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "1591cf70-a049-41a4-8900-5b62169bdcf2",
                                "sense_id": "79593666-d17e-339a-aaf6-261504f1b45c",
                                "text": "Мы о́чень уста́ли, но зато́ повида́ли друзе́й.",
                                "translation": "We got very tired but (for all that) we visited (our) friends.",
                                "english": "We got very tired but (for all that) we visited (our) friends."
                            }
                        ]
                    }
