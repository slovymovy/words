                "senses": [
                    {
                        "sense_id": "76d67405-db54-3440-87a0-32459b9c65d7",
                        "entry_id": "6a0c86e6-66fe-3159-8ea1-da08cbc1fb96",
                        "glosses": [
                            "naśladownictwo jakichś wzorców, na ogół bezkrytyczne"
                        ],
