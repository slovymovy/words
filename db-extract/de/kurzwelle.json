                                        "sense_id": "220ecaed-2f63-3969-8358-98cb5e10ee9e",
                                        "entry_id": "365caa38-1259-3182-b8b6-bbc997bf5e9d",
                                        "glosses": [
                                            "Having a wavelength of approximately 10 to 100 meters."
                                        ],
