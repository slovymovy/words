                                    },
                                    {
                                        "sense_id": "dcbfabf4-f339-34ac-a668-cbc14110e56b",
                                        "entry_id": "51b6a526-24de-3f0c-87ff-b5dd59d45855",
                                        "glosses": [
                                            "An interchange, a road that connects a freeway to a surface street or another freeway."
