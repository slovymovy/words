                    {
                        "sense_id": "8d5eadba-0806-35d1-b6d1-a1fc1a8ff666",
                        "entry_id": "406c2612-6d88-324a-b3fc-3771e634ed6a",
                        "glosses": [
                            "element przełączający umieszczany na wirniku komutatorowych maszyn elektrycznych"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "982441b3-83b0-40da-970d-d95c42016d1a",
                                "sense_id": "8d5eadba-0806-35d1-b6d1-a1fc1a8ff666",
                                "text": "Komutator pozwala na takie przełączanie uzwojeń wirnika, by kierunek siły elektrodynamicznej powstającej w wirniku był stały."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "b5d997cb-5987-3f31-8d42-269db5e486a9",
                        "entry_id": "406c2612-6d88-324a-b3fc-3771e634ed6a",
                        "glosses": [
                            "urządzenie łączące segmenty sieci komputerowej"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f267664-b3d6-4564-a07b-cf63581c5efc",
                                "sense_id": "b5d997cb-5987-3f31-8d42-269db5e486a9",
                                "text": "Zadaniem komutatora jest przekazywanie ramki między segmentami sieci z doborem portu przełącznika, na który jest przekazywana."
                            }
                        ],
                        "sense_index_json": "\"1.2\""
                    },
