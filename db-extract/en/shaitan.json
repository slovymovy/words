            {
                "entry_id": "654fad9d-d9ad-3b3f-a9b8-53c904d37b26",
                "word": "shaitan",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "99052ca8-fc70-351f-8fb7-0d595daae2d8",
                        "entry_id": "654fad9d-d9ad-3b3f-a9b8-53c904d37b26",
                        "glosses": [
                            "der Satan, der Teufel"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "22054342-1706-4bf0-9d33-2048819c0f56",
                        "source_entry_id": "654fad9d-d9ad-3b3f-a9b8-53c904d37b26",
                        "source_sense_id": "99052ca8-fc70-351f-8fb7-0d595daae2d8",
                        "source_sense_description": "der Satan, der Teufel",
                        "target_lang_word": "Satan",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Satan",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c135a6ae-70af-37d9-8e0e-5fff46ff5ed6",
                                        "entry_id": "b8891329-67df-35d5-b786-1118aa56c9f8",
                                        "glosses": [
                                            "der Gegenspieler Gottes, der Teufel, der Versucher"
                                        ],
                                        "tags": [
                                            "ohne Plural; theologisch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4073f1ad-bc74-45ff-8b88-4d4d13fb7e0f",
                                                "sense_id": "c135a6ae-70af-37d9-8e0e-5fff46ff5ed6",
                                                "text": "„Der Böse aber wird in der Macht des Satans auftreten mit großer Kraft und lügenhaften Zeichen und Wundern“"
                                            },
                                            {
                                                "example_id": "5fbd0d00-2fa3-468b-8839-21438a3e7560",
                                                "sense_id": "c135a6ae-70af-37d9-8e0e-5fff46ff5ed6",
                                                "text": "„Der Unterschied aber ist der, dass 1) der Satan der Urheber (πατής) der Sünde wurde, die Menschen aber der in die gute Schöpfung Gottes bereits eingedrungenen Macht der Sünde erlagen; dass 2) der Satan sich aus sich selber gegen Gott entschied, die Menschen aber durch Berückung von aussen der Liebe Gottes entrückt wurden, und 3) dass bei der Unmittelbarkeit, in welcher der Satan als reiner Geist Gotte gegenüberstand, seine Sünde direkte vollbewusste Empörung war, wogegen die Sünde der Menschen als geistleiblicher Wesen sich dadurch vollendete, dass sie, irre gemacht an Gottes Liebe, ohne diese vollbewusst zu verneinen, durch sinnliche Anziehungskraft des verbotenen Gegenstandes den entscheidenden Stoss erhielten.“"
                                            },
                                            {
                                                "example_id": "42c05fa3-133b-43c0-9a12-6886e0fd6fa1",
                                                "sense_id": "c135a6ae-70af-37d9-8e0e-5fff46ff5ed6",
                                                "text": "„Ohne Affinität kein Ganzes, keine Welt, nicht einmal denkbar; unser Erdball ein wüstes, ewig totes Chaos.« »Satan trennt«, schreibt er anderswo, »er ist Mörder von Anfang. Christus trennt, um zu vereinen«; und ein Wahn ist es ihm, »daß man das Christentum aufgeben müsse, um die intellektuelle und soziale Freiheit zu gewinnen, oder letztere aufgeben, um das Christentum aufrecht zu erhalten«.“"
                                            },
                                            {
                                                "example_id": "dc9a9d81-1e97-46ff-9d44-fc45bf605c52",
                                                "sense_id": "c135a6ae-70af-37d9-8e0e-5fff46ff5ed6",
                                                "text": "„Er wird Gog und Magog um sich scharen, zwei Völker von den Enden der Erde; der Messias wird erneut erscheinen, und nach einem fürchterlichen Endkampf, dem Armageddon, werden Satan und alle, die im gefolgt sind, vom ewigen Höllenfeuer verschlungen werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "117ddae3-b2a3-367c-8a41-92a336471ed6",
                                        "entry_id": "b8891329-67df-35d5-b786-1118aa56c9f8",
                                        "glosses": [
                                            "boshafte Person"
                                        ],
                                        "tags": [
                                            "umgangssprachlich abwertend; oft als Schimpfwort"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7fd16e65-7269-4392-9671-442111b795f6",
                                                "sense_id": "117ddae3-b2a3-367c-8a41-92a336471ed6",
                                                "text": "„Ohne dich zu verstehen, glaubt sie gewiß so wie alle in gleichem Fall, schonungslos von dir bespöttelt zu sein,. und so bewährst du deinen Ruf als eingefleischten ironischen Satan und ziehst mich neuen Ankömmling ins Unglück, denn schon sprechen alle mit zweideutigem Seitenblick und bittersüßem Lächeln: […]“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "befc76df-1a62-4289-8753-3709e8a577a1",
                        "source_entry_id": "654fad9d-d9ad-3b3f-a9b8-53c904d37b26",
                        "source_sense_id": "99052ca8-fc70-351f-8fb7-0d595daae2d8",
                        "source_sense_description": "der Satan, der Teufel",
                        "target_lang_word": "Teufel",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Teufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4b69fcfd-8292-3ba3-a58b-20412995f128",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "böses Geisterwesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "607fd772-de08-401d-a9a5-d9de1a8a13bd",
                                                "sense_id": "4b69fcfd-8292-3ba3-a58b-20412995f128",
                                                "text": "Er ist von einem Teufel besessen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "Gegenspieler Gottes"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "afd08f97-282e-4568-9214-d710dd618a5a",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Der Teufel kann eine Seele nicht mit Gewalt an sich reißen, er muss sie verführen, sagte Mustafa.“"
                                            },
                                            {
                                                "example_id": "7ddd9587-d090-421f-ac16-6247b7bcb1fb",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "Der Teufel soll dich holen!"
                                            },
                                            {
                                                "example_id": "8a98b0dc-8ca6-4ed6-a1d8-87789bdc9a62",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Ich stieg in die Turmkammer empor, in der Jesus vierzig Tage lang der Versuchung des Teufels widerstanden haben soll, und trat auf den schmalen Streifen eines Balkons hinaus, von dem ich auf Jericho hinabblicken konnte.“"
                                            },
                                            {
                                                "example_id": "bd64b4a1-92a5-475e-99d8-0324f61a783b",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Schaut man sich um, dann sind die Teufel die Sieger, nicht etwa Gott, daran ist nicht zu rütteln.“"
                                            },
                                            {
                                                "example_id": "a087d83d-243e-4846-8213-a40423393f19",
                                                "sense_id": "80bc35c1-436f-32da-88b0-71835d26d249",
                                                "text": "„Selbst der Teufel kann nicht so schnell schreiben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                        "entry_id": "ee551030-3836-32af-8913-c59a94668173",
                                        "glosses": [
                                            "böser Mensch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c14a4f0e-999e-4335-993b-70f80c98c322",
                                                "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                                "text": "Er war für seine Grausamkeiten bekannt, ein verabscheuungswürdiger Teufel, eben ein Teufel in Menschengestalt."
                                            },
                                            {
                                                "example_id": "d311168f-2cd1-4eb1-805e-6007874539ac",
                                                "sense_id": "19f95180-70f1-33e6-bb2c-0d6b32a98df8",
                                                "text": "„Die beiden beschimpften sich wechselseitig als Teufel und waren doch untereinander so einig über das Teufelszeug der aufkommenden Geldwirtschaft wie mit vielen anderen Zeitgenossen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Teufel",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                        "entry_id": "79e13279-b6f7-3e7e-b2a7-e22e03d60d7d",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a152b11d-0df0-45b4-8908-4c82fafd97f7",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Frau Teufel ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "27b4e604-3bdf-4c3d-a6e5-87968e1ca746",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Herr Teufel wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "d19c414e-4078-4136-b166-0c9df0d0333e",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Die Teufels fahren heute nach Erfurt."
                                            },
                                            {
                                                "example_id": "bb5cb55b-44e0-4289-80d5-d47dc4d66034",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Der Teufel trägt nie die Pullover, die die Teufel ihm strickt."
                                            },
                                            {
                                                "example_id": "9994d703-cb40-4056-9458-10fd2611a5c9",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Teufel kommt, geht der Herr Teufel.“"
                                            },
                                            {
                                                "example_id": "d94a1d96-4ba5-4199-93ee-24282f6eb273",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Teufel kommt und geht."
                                            },
                                            {
                                                "example_id": "279b3526-636f-418a-bf13-f4a1a68dddde",
                                                "sense_id": "74995cc0-445f-3de2-8271-c322b5a9e9ea",
                                                "text": "Teufels kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
