                "senses": [
                    {
                        "sense_id": "6e351142-6701-368d-8b50-47c5cb1b3859",
                        "entry_id": "5b938130-af1d-333a-8690-c82c3ec6a532",
                        "glosses": [
                            "lokale Einrichtung eines Radiosenders"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1ac9dae3-d0cf-4b4f-91f8-f1daa8e8860d",
                                "sense_id": "6e351142-6701-368d-8b50-47c5cb1b3859",
                                "text": "„Die Zeitungsleute und die Radiostation, die die Pressekonferenz übertragen werde, sagten sie, warteten schon über eine Stunde, und das Wochenschau-Team, das sie aufnehmen wollte, ebenfalls.“"
                            },
                            {
                                "example_id": "7ef8cfd3-1b9b-4b32-89df-492cfcddead2",
                                "sense_id": "6e351142-6701-368d-8b50-47c5cb1b3859",
                                "text": "„Eine Weile stehe ich so und betrachte im Lärm der amerikanischen Radiostation und vieler Grammaphone, die an verschiedenen Stellen des Hauses kreischen, im Gejaule einiger Saxophone und einer Trommel diese vornehme Stille des Schachspiels; dann gehe ich zu mir hinauf, ziehe mich aus und lege mich ins Bett, um zu schlafen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
