                        "source_entry_id": "74916b8c-c57e-3f0d-9100-66df02be0250",
                        "source_sense_id": "12bf357e-8b7d-33a9-841d-3309fa963611",
                        "target_lang_word": "zeitgleich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "zeitgleich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                        "entry_id": "79838252-221e-3f74-abd9-b655383fcc2a",
                                        "glosses": [
                                            "zur gleichen Zeit seiend; gleichzeitig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "600fecdc-4dda-4cee-a096-761b2b793bfb",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "Zeitgleich zur Neujahrsrede des Bürgermeisters findet auch ein Fußballturnier der F-Jugend und die Kindergeburtstagsfeier unserer Nachbarn statt."
                                            },
                                            {
                                                "example_id": "c2002cf8-c2eb-4d2e-8350-470d5e74e37b",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "„Ungeschickterweise verhedderte sich Hamilton fast zeitgleich in eine außereheliche Affäre.“"
                                            },
                                            {
                                                "example_id": "4843519f-269f-4359-83cf-28ba45bc8bde",
                                                "sense_id": "b5bedece-6007-3c0e-b960-0d037e2ce65d",
                                                "text": "[Tschetschenienkrieg 1994:] „Am 11.12.1994 marschierten nach gescheiterten Verhandlungen 40.000 russische Soldaten in Tschetschenien ein, zeitgleich wurde die Hauptstadt Grosny aus der Luft angegriffen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "946e2b43-5a02-357c-a90c-83246ed377b8",
                                        "entry_id": "79838252-221e-3f74-abd9-b655383fcc2a",
                                        "glosses": [
                                            "die gleich lange Zeitspanne in Anspruch nehmend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "397039e4-7409-4771-b7db-e923b380b9fb",
                                                "sense_id": "946e2b43-5a02-357c-a90c-83246ed377b8",
                                                "text": "Die Sieger der beiden nacheinander um 8:00 Uhr und um 8:15 Uhr gestarteten 100m-Vorläufe kamen zeitgleich mit jeweils 10,20 s ins Ziel"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
