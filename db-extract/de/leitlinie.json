                    {
                        "form_id": "338fdae2-2e40-473c-95d7-976c99cc1bd0",
                        "entry_id": "861ad656-382e-3b2f-b78a-34ba280a1b0c",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Leitlinie"
                    },
                    {
                        "form_id": "4629154f-fb46-4447-b9f3-bdc57b6ce6ef",
                        "entry_id": "861ad656-382e-3b2f-b78a-34ba280a1b0c",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Leitlinien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f4121527-372a-3a31-80d1-93578f3a1d48",
                        "entry_id": "861ad656-382e-3b2f-b78a-34ba280a1b0c",
                        "glosses": [
                            "grundsätzliche Zielvorgabe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43ae714a-497e-44db-9179-b171e09b24ec",
                                "sense_id": "f4121527-372a-3a31-80d1-93578f3a1d48",
                                "text": "„Es kann zwischen Empfehlungen, Leitlinien und Richtlinien unterschieden werden.“"
                            },
                            {
                                "example_id": "b5443519-4034-4d52-9ee6-74a184c309de",
                                "sense_id": "f4121527-372a-3a31-80d1-93578f3a1d48",
                                "text": "„Das Internet wird derzeit als beste Quelle für die Information über Leitlinien angesehen.“"
                            },
                            {
                                "example_id": "3d59e1e4-46a5-4d72-a9ed-c42435b21239",
                                "sense_id": "f4121527-372a-3a31-80d1-93578f3a1d48",
                                "text": "„In allen Lebensbereichen brauchen wir derartige Orientierungspunkte, die wir »Normen« nennen, als die konventionellen Leitlinien menschlichen Handlens und Verhaltens.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                        "entry_id": "861ad656-382e-3b2f-b78a-34ba280a1b0c",
                        "glosses": [
                            "Bewegungsvorgabe, zum Beispiel die unterbrochene Fahrbahnmarkierung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "46de6b7c-744c-4300-8487-a81babce2854",
                                "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                                "text": "„Leitlinien sind unterbrochene Längsmarkierungen in weißer Farbe.“"
                            },
                            {
                                "example_id": "e00a10f0-7c31-434e-ae63-f6e2725cf9a2",
                                "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                                "text": "„In diesen Fällen soll zuvor eine Leitlinie von ausreichender Länge angeordnet werden, deren Striche länger sein müssen als ihre Lücken (Warnlinie).“"
                            },
                            {
                                "example_id": "3110e2a2-4226-48fb-b0af-aa5a71223134",
                                "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                                "text": "„Die äußere Leitlinie ist die ertastbare Gehwegbegrenzung zur Fahrbahn hin.“"
                            },
                            {
                                "example_id": "82624f1a-a94e-4fc8-ad2b-bce5e0176c0f",
                                "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                                "text": "„Während sich konventionelle FTS an aktiven oder passiven Leitlinien orientieren, bewegt sich ein frei verfahrbares Fahrzeug entlang einer virtuellen Leitlinie.“"
                            },
                            {
                                "example_id": "94bb5430-9fa0-4140-9536-a4c9c38a1bdb",
                                "sense_id": "81ee9b11-70c7-39fe-84b6-a4d3dfed7bb7",
                                "text": "„Derartige Singularitäten treten bei der Regelung entlang einer virtuellen (oder auch realen) Leitlinie nicht auf.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "7ea1b5c7-59cf-31ac-81f8-8af1faf0fd42",
                        "entry_id": "861ad656-382e-3b2f-b78a-34ba280a1b0c",
                        "glosses": [
                            "bestimmende Kurve einer geometrischen Form, zum Beispiel die Symmetrieachse eines Kegelschnitts"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b7e7220-ba48-4163-8324-8f73f64c52e2",
                                "sense_id": "7ea1b5c7-59cf-31ac-81f8-8af1faf0fd42",
                                "text": "„Die Parabel ist als geometrischer Ort aller Punkte P einer Ebene definiert, die von einem festen Punkt, dem Brennpunkt F, und einer festen Geraden, Leitlinie genannt, gleich weit entfernt sind […]“"
                            },
                            {
                                "example_id": "ecdc0833-0c23-4495-8a4b-3472efb584e2",
                                "sense_id": "7ea1b5c7-59cf-31ac-81f8-8af1faf0fd42",
                                "text": "„Erzeugende gleitet entlang der Leitlinie, oder Leitlinie gleitet entlang der Erzeugenden.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
