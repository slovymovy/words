        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "32813d15-2a28-3c13-8cd0-e5a3ca60334c",
                "word": "euhemerism",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "d1a29820-0368-45c7-8e51-39ccbe37dce8",
                        "entry_id": "32813d15-2a28-3c13-8cd0-e5a3ca60334c",
                        "tags": [
                            "plural"
                        ],
                        "form": "euhemerisms"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d8a31307-7714-37c7-b758-f0230e260e5e",
                        "entry_id": "32813d15-2a28-3c13-8cd0-e5a3ca60334c",
                        "glosses": [
                            "The belief that legends and mythology arise from exaggerated descriptions of historical people and events."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "042303cf-d4e3-4a05-8dd5-35be738cfe81",
                                "sense_id": "d8a31307-7714-37c7-b758-f0230e260e5e",
                                "text": "In regard to the Thracian god Zalmosis, the Hellespontic Greeks interpreted his character and attributes according to the scheme of Euemerism."
                            },
                            {
                                "example_id": "742fd812-3ff8-4ec0-94e4-1a6543bdbd1c",
                                "sense_id": "d8a31307-7714-37c7-b758-f0230e260e5e",
                                "text": "Then again there was a period of what is sometimes called Euhemerism - the theory that the gods and goddesses had actually once been men and women, historical characters round whom a halo of romance and remoteness had gathered."
                            },
                            {
                                "example_id": "46e5bbae-7227-405a-b96c-1bca87b33c71",
                                "sense_id": "d8a31307-7714-37c7-b758-f0230e260e5e",
                                "text": "Already before euhemerism saved them by embalming them, [...] they had become in their very being the enlarged shadows of great men and warriors upon the walls of the world."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "24b03c34-9dc4-4d3f-96f3-5deb88a9d047",
                        "source_entry_id": "32813d15-2a28-3c13-8cd0-e5a3ca60334c",
                        "source_sense_id": "d8a31307-7714-37c7-b758-f0230e260e5e",
                        "source_sense_description": "attribution of a historical origin to myths and legends",
                        "target_lang_word": "évhémérisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "évhémérisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "aed91055-f4df-3b2e-a833-794d47eeb10a",
                                        "entry_id": "25c12b0a-f030-38dc-a7c6-5cc4c2fc978f",
                                        "glosses": [
                                            "Système suivant lequel les dieux du paganisme étaient des hommes divinisés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a3b3b4f5-e21d-4f70-933c-c8496d20cf96",
                                                "sense_id": "aed91055-f4df-3b2e-a833-794d47eeb10a",
                                                "text": "L’évhémérisme est une des manières d’interpréter la mythologie."
                                            },
                                            {
                                                "example_id": "2a97d89e-0c86-4b77-8a36-b8eb56b08af4",
                                                "sense_id": "aed91055-f4df-3b2e-a833-794d47eeb10a",
                                                "text": "La théorie des anciens astronautes s’appuie sur des idées issues de l’évhémérisme."
                                            },
                                            {
                                                "example_id": "b1a3749d-ba95-46d4-a1a6-435b863fe699",
                                                "sense_id": "aed91055-f4df-3b2e-a833-794d47eeb10a",
                                                "text": "Le premier courant d’interprétation est représenté par l’évhémérisme, vulgarisé par Ennius."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
