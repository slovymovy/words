                "senses": [
                    {
                        "sense_id": "392b5879-0aa7-308a-ac9b-84164d2ac235",
                        "entry_id": "e7f67cae-e6b8-3a3d-9545-f41502ad772c",
                        "glosses": [
                            "das Springen aus großer Höhe mit einem in der Regel an den Knöcheln befestigtem Gurt, Seil (Gummi-, Sprungseil) oder Ähnlichem, um eine Berührung mit dem Boden zu verhindern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c12c5248-1314-4979-9112-dda967349d4f",
                                "sense_id": "392b5879-0aa7-308a-ac9b-84164d2ac235",
                                "text": "Bungeespringen ist nichts für mich, das ist viel zu aufregend."
                            },
                            {
                                "example_id": "b6897db4-4df7-410c-a6c9-0de56799f82d",
                                "sense_id": "392b5879-0aa7-308a-ac9b-84164d2ac235",
                                "text": "„So entziehen sich ausgereifte Sports wie das Bungeespringen, Reiten, Tauchen oder Drachenfliegen dieser Subsumierung als Risikosport, sobald objektivierende Beweisforderungen und wissenschaftliche Maßstäbe an die Zuordnung gelegt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
