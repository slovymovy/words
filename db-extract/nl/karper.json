                "translations": [
                    {
                        "translation_id": "2d253076-cb2e-41f6-a0a7-b3f62cf1f5c4",
                        "source_entry_id": "3849dc47-b81e-35f6-ac92-c30ad927eb3c",
                        "source_sense_id": "53b9fbc9-4aaa-3f46-8efd-a4579a9342f1",
                        "source_sense_description": "bepaald soort grote zoetwatervis met een hoge rug, die van oorsprong uit Azië komt, Cyprinus carpio",
                        "target_lang_word": "Karpfen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Karpfen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5afc560b-01dd-38c0-88b1-b8bcb3e19e29",
                                        "entry_id": "fb2bc315-ee07-39e1-b670-5e44591ca384",
                                        "glosses": [
                                            "Fisch der Gattung Cyprinus, speziell der Art Cyprinus carpio; ein großer Fisch, der in Teichen lebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a4df5e51-fade-43bb-8f6a-416269483dfc",
                                                "sense_id": "5afc560b-01dd-38c0-88b1-b8bcb3e19e29",
                                                "text": "Der Karpfen nimmt im Winter keine Nahrung auf."
                                            },
                                            {
                                                "example_id": "9442de5d-2288-4cf8-9add-e307b87276e2",
                                                "sense_id": "5afc560b-01dd-38c0-88b1-b8bcb3e19e29",
                                                "text": "„Die Strömung war vorteilhaft, und unter den Algenbänken wimmelte es von Weißfischen, Barschen und Karpfen.“"
                                            },
                                            {
                                                "example_id": "6a5daa23-1e4e-45cf-af57-dd4dd2747e57",
                                                "sense_id": "5afc560b-01dd-38c0-88b1-b8bcb3e19e29",
                                                "text": "„Von diesem Steg aus fütterte ich gelegentlich mit Freunden schmatzende Karpfen mit Brot; einige von ihnen fraßen mir sogar aus der Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "ce492145-b049-34c8-9273-d9a26f30e2c8",
                                        "entry_id": "fb2bc315-ee07-39e1-b670-5e44591ca384",
                                        "glosses": [
                                            "[1] als Speise"
                                        ],
                                        "tags": [
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7b35769-ddb9-476b-b968-f90c989c9423",
                                                "sense_id": "ce492145-b049-34c8-9273-d9a26f30e2c8",
                                                "text": "In vielen Familien gibt es zu Heiligabend Karpfen."
                                            },
                                            {
                                                "example_id": "3c49ec06-8e82-4346-9246-a7b9d9f0a773",
                                                "sense_id": "ce492145-b049-34c8-9273-d9a26f30e2c8",
                                                "text": "Müssen es heute Babysteinbutt in Mangold, Seezungenröllchen oder Lachsmousse sein, so genügten den Buddenbrooks noch kapitale Karpfen."
                                            },
                                            {
                                                "example_id": "b331b963-5f70-44d5-9f8a-3480d1227e57",
                                                "sense_id": "ce492145-b049-34c8-9273-d9a26f30e2c8",
                                                "text": "„Lampe fragt nichts, als die Köchin, der der Schreck wie eine Narbe im Gesicht sitzt, den fetten Karpfen auftischt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9665b67a-e0d9-469c-9ff7-51804f7502f9",
