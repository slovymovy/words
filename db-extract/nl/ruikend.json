        "nl-extract.jsonl": [
            {
                "entry_id": "bfe81b51-497a-3ff5-8ff8-51599d50c150",
                "word": "ruikend",
                "pos": "adj",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "73c21e87-ed25-3171-a9a5-c1d765a40f69",
                        "entry_id": "bfe81b51-497a-3ff5-8ff8-51599d50c150",
                        "glosses": [
                            "sterk geurend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8628bb5f-55f3-48cb-9895-810a916fa6e0",
                                "sense_id": "73c21e87-ed25-3171-a9a5-c1d765a40f69",
                                "text": "De politie in Almelo zoekt naar ‘fris ruikende, gladgeschoren’ dieven. Het gaat om twee ‘heren’."
                            },
                            {
                                "example_id": "cd1d4eb8-c763-4ac4-956b-23e461247295",
                                "sense_id": "73c21e87-ed25-3171-a9a5-c1d765a40f69",
                                "text": "Omdat de hond nogal naar stinkdieren stonk, gelooft Ballejos dat hij kon overleven door op stinkdieren te jagen. Hij joeg wel vaker op de sterk ruikende zwart-witte dieren."
                            }
                        ]
                    },
                    {
                        "sense_id": "1b590f87-145c-317d-bf35-9e036375847d",
                        "entry_id": "bfe81b51-497a-3ff5-8ff8-51599d50c150",
                        "glosses": [
                            "waardoor iets wordt gekarakteriseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88c63546-8133-4afa-b9c6-8045eb8d77f1",
                                "sense_id": "1b590f87-145c-317d-bf35-9e036375847d",
                                "text": "In het naar roomwitte karnemelk, doorgekookte bloemkool en polderracisme ruikende wereldje van Blok is een multi-etnische samenleving bij voorbaat al gedoemd te mislukken. Voor het gemak laat hij landen als Canada, Nieuw-Zeeland, Duitsland en -jazeker – ons eigen land even buiten beschouwing en gaat hij er vanuit dat we elkaar bij het minste of geringste naar de keel vliegen. Daar kunnen we ook niets aan doen, dat is genetisch bepaald. HP de Tijd 19/07"
                            }
                        ]
                    }
