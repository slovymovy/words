{
    "word_family": [
        "penchant"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "2b734988-2dc9-30ec-a749-03b5792cf407",
                    "sense_definition": "Incliner un objet ou une partie de son corps vers le bas ou sur le côté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclinaison_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il doit <w>pencher</w> la tête pour passer sous cette porte trop basse."
                        },
                        {
                            "text": "Fais attention à ne pas trop <w>pencher</w> la bouteille quand tu verses."
                        }
                    ],
                    "synonyms": [
                        "incliner",
                        "baisser"
                    ],
                    "antonyms": [
                        "relever"
                    ],
                    "common_phrases": [
                        "pencher la tête",
                        "pencher le buste"
                    ]
                },
                {
                    "sense_id": "20db4be9-5293-3fe0-934c-b960cb043f2a",
                    "sense_definition": "Être incliné, n'être plus vertical ou d'aplomb.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclinaison_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille tour <w>penche</w> dangereusement depuis de nombreuses années."
                        },
                        {
                            "text": "Le tableau ne semble pas droit, il <w>penche</w> un peu vers la droite."
                        }
                    ],
                    "synonyms": [
                        "s'incliner"
                    ],
                    "common_phrases": [
                        "arbre qui penche"
                    ]
                },
                {
                    "sense_id": "516fd6c0-6abc-333f-86f8-5b0075b41e7b",
                    "sense_definition": "Courber son corps en avant ou sur le côté.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inclinaison_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle se <w>penche</w> à la fenêtre pour saluer ses amis dans la rue."
                        },
                        {
                            "text": "Il s'est <w>penché</w> pour ramasser ses clés tombées par terre."
                        }
                    ],
                    "synonyms": [
                        "se baisser",
                        "s'incliner"
                    ],
                    "common_phrases": [
                        "se pencher en avant"
                    ]
                },
                {
                    "sense_id": "d8c2e7db-936d-3162-ba63-03def5867863",
                    "sense_definition": "Avoir une préférence, être favorable ou enclin à une option ou un choix.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "inclination_morale",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Entre ces deux propositions, je <w>penche</w> plutôt pour la seconde."
                        },
                        {
                            "text": "Après une longue hésitation, elle <w>penche</w> finalement pour le voyage en Italie."
                        }
                    ],
                    "synonyms": [
                        "préférer",
                        "opter"
                    ],
                    "common_phrases": [
                        "pencher pour",
                        "faire pencher la balance"
                    ]
                },
                {
                    "sense_id": "65b86308-11fa-3043-835b-3645bdaefbe1",
                    "sense_definition": "Examiner avec attention un sujet, s'intéresser ou se consacrer à un problème.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "analyse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le comité a promis de se <w>pencher</w> sur cette affaire dès demain."
                        },
                        {
                            "text": "Les scientifiques doivent encore se <w>pencher</w> sur les causes de ce phénomène."
                        }
                    ],
                    "synonyms": [
                        "examiner",
                        "étudier"
                    ],
                    "common_phrases": [
                        "se pencher sur le problème",
                        "se pencher sur la question"
                    ]
                }
            ]
        }
    ]
}