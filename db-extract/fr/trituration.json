                "senses": [
                    {
                        "sense_id": "c642c931-3edc-3179-b2da-aa76d3f7cddf",
                        "entry_id": "de58a3ad-8174-3016-a12f-9873f66d1294",
                        "glosses": [
                            "Action de triturer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63dfeeba-b1bc-4e4a-bd3d-57d2f071d682",
                                "sense_id": "c642c931-3edc-3179-b2da-aa76d3f7cddf",
                                "text": "La mastication et la salivation permettent la trituration des aliments dans la bouche."
                            }
                        ]
                    },
                    {
                        "sense_id": "8c3318b4-cdfe-3e4c-8a1f-c01b1962dcc1",
                        "entry_id": "de58a3ad-8174-3016-a12f-9873f66d1294",
                        "glosses": [
                            "Broiement ; réduction d’un corps solide en parties très menues ou en poudre."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": [
                            {
                                "example_id": "df42259a-dd11-448f-aa74-d49028b9263c",
                                "sense_id": "8c3318b4-cdfe-3e4c-8a1f-c01b1962dcc1",
                                "text": "Si l'on écrase entre deux pierres des grains de blé, l'enveloppe corticale de chaque grain est brisée, et les débris, qui portent le nom de son, se mêlent à la farine provenant de la trituration de la partie intérieure ; […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "101aa8d2-5998-3c8e-99b5-b6d99fce1614",
                        "entry_id": "de58a3ad-8174-3016-a12f-9873f66d1294",
                        "glosses": [
                            "Action de triturer puis presser des graines oléagineuses pour fabriquer de l'huile."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "32bbbdf5-4e46-4f46-979c-a86ba6dc804f",
                                "sense_id": "101aa8d2-5998-3c8e-99b5-b6d99fce1614",
                                "text": "C'est véritablement en colza que le marché exprime le plus grand changement […]. La hausse du pétrole et du dollar, l'augmentation de la trituration en Europe […] laissent entrevoir un bilan sain, voire tendu à la fin de la campagne."
                            }
                        ]
                    }
