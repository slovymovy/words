                                        "glosses": [
                                            "The last part of a period of time, event, or situation; the concluding or final part."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f2e2c85-e5c9-4d0c-a543-5d3ed5d30617",
                                                "sense_id": "46609e47-4771-3390-a538-d757d5ab1978",
                                                "text": "At the tail end of summer."
                                            },
                                            {
                                                "example_id": "4670c287-30a3-4a95-ab89-86b95fa4e178",
                                                "sense_id": "46609e47-4771-3390-a538-d757d5ab1978",
                                                "text": "The tail end of a lecture."
                                            },
                                            {
                                                "example_id": "855ffa6d-15bd-4098-bfab-dbf6522a1a7b",
                                                "sense_id": "46609e47-4771-3390-a538-d757d5ab1978",
                                                "text": "The tail end of a conversation."
                                            },
                                            {
                                                "example_id": "64d87c9b-169f-47c4-a32a-da0ec5657350",
                                                "sense_id": "46609e47-4771-3390-a538-d757d5ab1978",
                                                "text": "An equipment malfunction has woken him up 90 years early, and he’s now doomed to live out the rest of his life surrounded by sushi bars and infinity pools, but not a single human companion.(The other 5,000 passengers on board will wake up at the tail end of the ship’s 120-year voyage to Earth colony Homestead-II.)"
                                            },
                                            {
                                                "example_id": "164bfb5c-758f-4861-8d46-83894d992b49",
                                                "sense_id": "46609e47-4771-3390-a538-d757d5ab1978",
                                                "text": "We meet at the tail-end of the Edinburgh TV Festival, normally a hum of desperate pitching and angry gossiping among media executives."
                                            }
                                        ]
