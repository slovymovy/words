                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8292eee-82f7-3115-9fe9-3f8926d6390c",
                                        "entry_id": "22610df9-2aef-35b2-89a2-eebe9cfb8271",
                                        "glosses": [
                                            "A sport played in a walled court with a soft rubber ball and bats like tennis racquets."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d413c229-1a5f-4ca5-bf31-e08f0774fce2",
                                                "sense_id": "e8292eee-82f7-3115-9fe9-3f8926d6390c",
                                                "text": "She plays squash every Saturday."
                                            },
                                            {
                                                "example_id": "33f6dc6e-e162-4c37-ac13-ab79507dd602",
                                                "sense_id": "e8292eee-82f7-3115-9fe9-3f8926d6390c",
                                                "text": "Ivor had acquired more than a mile of fishing rights with the house; he was not at all a good fisherman, but one must do something; one generally, however, banged a ball with a squash-racket against a wall."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "31b5586f-28c5-3354-928a-5b6cc68bd752",
                                        "entry_id": "22610df9-2aef-35b2-89a2-eebe9cfb8271",
                                        "glosses": [
                                            "A non-alcoholic drink made from a fruit-based concentrate diluted with water or milk."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8f6f2a61-9efa-4456-93df-489f83753830",
                                                "sense_id": "31b5586f-28c5-3354-928a-5b6cc68bd752",
                                                "text": "Sure. I pour hot squash all over myself and we all have a good chuckle. Everyone except Muggins here."
                                            },
                                            {
                                                "example_id": "625f732c-e333-454c-8676-7e6500702b61",
                                                "sense_id": "31b5586f-28c5-3354-928a-5b6cc68bd752",
                                                "text": "When I'm thirsty I drink squash; it tastes much nicer than plain water."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "28d1c6ca-fdf6-360d-90e0-1dfa76d64b51",
                                        "entry_id": "22610df9-2aef-35b2-89a2-eebe9cfb8271",
                                        "glosses": [
                                            "A place or a situation where people have limited space to move."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30991a42-d3c8-463f-8873-91d89f275f07",
                                                "sense_id": "28d1c6ca-fdf6-360d-90e0-1dfa76d64b51",
                                                "text": "It's a bit of a squash in this small room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9480a56a-d4f9-3085-8b25-7c0d93b6ed81",
