                ],
                "senses": [
                    {
                        "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                        "entry_id": "37666e38-a7b7-3faa-afb1-69bd14c3cc0b",
                        "glosses": [
                            "water dat in de vorm van regen uit de hemel komt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0736cbe-00ba-4c45-abe8-df7632bf2fa5",
                                "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                                "text": "Regenwater opvangen voor hergebruik kan heel gemakkelijk door het installeren van een regenton."
                            },
                            {
                                "example_id": "56095deb-05f9-46bf-a3bd-3d2aacc3dfd3",
                                "sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                                "text": "Het reservoir is van een fabriek nabij een inmiddels gesloten fosfaatmijn in de buurt van de stad Tampa. Het water is een mix van zout water, gemengd met afval- en regenwater. Volgens het milieudepartement van Florida bevat het verhoogde niveaus van fosfor en stikstof en is het water relatief zuur, maar is het hoogstwaarschijnlijk niet giftig."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4b5c1a78-8666-40bb-9073-d2d774d91b36",
                        "source_entry_id": "37666e38-a7b7-3faa-afb1-69bd14c3cc0b",
                        "source_sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                        "target_lang_word": "Regenwasser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Regenwasser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                        "entry_id": "e0a51be7-9448-383d-b80c-a0d35078daa8",
                                        "glosses": [
                                            "Wasser aus natürlichem Niederschlag, das nicht durch Gebrauch verunreinigt wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f83b70cb-5530-4335-a978-5a2235d3afc2",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "Regenwasser kann in meist unterirdischen Zisternen aufgefangen und als Brauch- oder Nutzwasser verwendet werden."
                                            },
                                            {
                                                "example_id": "cd58b644-1c7d-4ae3-a666-df15fed57ce7",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Er setzte sich auf einen Stein, das Regenwasser rann ihm über den Kopf und die Schultern.“"
                                            },
                                            {
                                                "example_id": "16f636dc-0840-490f-be02-75760da4ae0f",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Schmutz und Regenwasser spritzten über ihn und seine Kameraden hin.“"
                                            },
                                            {
                                                "example_id": "3b5e05bc-b908-423c-823a-56f389b5bc9b",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Es hat dann aber furchtbar zu regnen begonnen, und das Regenwasser hat so laut auf das Dach des Campinghauses geprasselt, dass ich wieder Angst bekam.“"
                                            },
                                            {
                                                "example_id": "d1439d9e-279b-43d1-b042-9629a0ce508a",
                                                "sense_id": "9297be55-5687-317b-a00a-9e5bdda57ab2",
                                                "text": "„Götzens ›Schloss‹ verfügte nicht über einen Brunnen, allenfalls über eine Zisterne, in die über Dachrinnen und Rohrleitungen das Regenwasser lief.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f18b74d-88c8-4d56-89cb-a8bcc9cd1a3c",
                        "source_entry_id": "37666e38-a7b7-3faa-afb1-69bd14c3cc0b",
                        "source_sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                        "target_lang_word": "rainwater",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rainwater",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                                        "glosses": [
                                            "Rainfall."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52fda84d-264b-4577-9427-efd276951cbd",
                                                "sense_id": "2bd022ed-0aae-3c94-a585-13bf84b26330",
                                                "text": "In early December, as rainwaters had started the monthlong process of flooding mines and washing out rail lines, workers lined up before 1 p.m. at an easy-to-miss storefront depot in Mackay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                                        "entry_id": "f7d03c63-d8c1-376f-ab86-28f9574bbbaa",
                                        "glosses": [
                                            "Water (for a house, etc.) sourced from rain which has not joined a spring, stream or river, pond, lake or sea."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5d8d3cde-59b6-4024-8470-b2dea0acac04",
                                                "sense_id": "b85ff13d-8031-32e9-98a9-dd04ab4bb80e",
                                                "text": "Constructed of hard flint stone, which came as ballast from England and is now painted coral white, the house has a fishpond, or catchment, roof, dating from 1788, to collect rainwater."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "34bec9b7-6ad4-4772-a0f2-b1151414ac50",
                        "source_entry_id": "37666e38-a7b7-3faa-afb1-69bd14c3cc0b",
                        "source_sense_id": "79bca3de-5355-3295-888a-8f353a8d42db",
                        "target_lang_word": "eau de pluie",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eau de pluie",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                        "entry_id": "93df090d-82fc-366b-86c7-13082ff068fe",
                                        "glosses": [
                                            "Eau telle qu’elle tombe d’un nuage en se condensant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf4f7452-2121-493c-8f96-a5d0a32023d1",
                                                "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                                "text": "L’eau de pluie contient en dissolution toutes les substances qui existent dans l’air, telles que l’oxygène, l’azote, l’acide carbonique, de petites quantités d’acide azotique, de carbonate d’ammoniaque, ou d’azotate d’ammoniaque."
                                            },
                                            {
                                                "example_id": "03476889-bace-4da7-87c2-6ed177f788d0",
                                                "sense_id": "04f45f52-0043-3f26-bfb5-3882afe59d37",
                                                "text": "À Nancy, nous avons créé des jardins d’eau alimentés grâce à la récupération d’eau de pluie et de trop pleins de la Meurthe."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
