                ],
                "senses": [
                    {
                        "sense_id": "39e523ff-e89d-34b0-a25d-57ff0f69d57a",
                        "entry_id": "03984d52-4b43-3a71-ac80-c88cce34db97",
                        "glosses": [
                            "Faire perdre son caractère basque à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee599eae-1ffe-4474-a631-72a7def36202",
                                "sense_id": "39e523ff-e89d-34b0-a25d-57ff0f69d57a",
                                "text": "C'est se débasquiser soi-même et se borner à réclamer une société socialiste pour l’homme universel et abstrait, produit du capitalisme centralisateur."
                            },
                            {
                                "example_id": "4d549faf-5a79-4cc3-92ec-188d698d5270",
                                "sense_id": "39e523ff-e89d-34b0-a25d-57ff0f69d57a",
                                "text": "Retenons la fonction symbolique qu’il assume dans le texte, et qui institue un rapport d’arrière-plan entre Marca Britannica, Marca Hispanica et cette autre marche de l’Empire qu’est le royaume débasquisé de Navarre."
                            },
                            {
                                "example_id": "9304e247-4859-44fd-8c07-cc00d643afd7",
                                "sense_id": "39e523ff-e89d-34b0-a25d-57ff0f69d57a",
                                "text": "L’administration, la presse, la littérature s’espagnolisent rapidement. Des régions entières perdent l’euskara en Alava et en Navarre : dans cette dernière, 300 villages se débasquisent en quelques décennies."
                            }
                        ]
                    }
                ],
