                                "target_senses": [
                                    {
                                        "sense_id": "3a481ac6-22f5-3506-ba31-bef30dee4d3f",
                                        "entry_id": "3a145d87-b933-3641-89ef-78e33bee18bf",
                                        "glosses": [
                                            "A card game resembling chemin de fer with many forms - usually entailing the player(s) betting against two or three hands dealt - also bearing some similarities to blackjack."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fd23f9b8-ce00-47a4-8def-92abadde3ddc",
                        "source_entry_id": "63863eae-c14b-3f86-9726-35f599d8c3c2",
                        "source_sense_id": "6c5c810e-b389-3687-a4ab-60807bf523e1",
                        "source_sense_description": "Kartenglücksspiel",
                        "target_lang_word": "baccara",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "baccara",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "282009eb-166e-35aa-9ad8-4cd5d0923fac",
                                        "entry_id": "3674993c-aa58-3b7b-b83c-0fe62cad671f",
                                        "glosses": [
                                            "Jeu de cartes où ce terme est usité pour accuser les valeurs zéro (10, 20, 30)."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3226e13-9ddc-48f8-927f-8c2b2bfe9826",
                                                "sense_id": "282009eb-166e-35aa-9ad8-4cd5d0923fac",
                                                "text": "Quand on a cinq mille dollars, on peut gagner un million au baccara, mettre une couturière dans ses meubles ou acheter des cornues pour la Faculté des sciences."
                                            },
                                            {
                                                "example_id": "81a5c974-654a-44e3-9688-e3fd59d0f3be",
                                                "sense_id": "282009eb-166e-35aa-9ad8-4cd5d0923fac",
                                                "text": "Ils viendront solliciter en pleurnichant des dégrèvements d'impôts, me dit un fonctionnaire […], et ils risquent au baccara, au chemin de fer, des fortunes tous les soirs."
                                            },
                                            {
                                                "example_id": "c508a2f9-d86e-4098-895d-a939df8e589f",
                                                "sense_id": "282009eb-166e-35aa-9ad8-4cd5d0923fac",
                                                "text": "Jeannin était joueur et même tricheur, entraîné à cela par un autre ; et insensiblement ils se mirent à tenir tripot, entendez qu'ils attiraient des inconnus à la table de nuit ; on passait du tarot au baccara pendant que nous dormions, et les étrangers étaient plumés."
                                            },
                                            {
                                                "example_id": "9f41fd32-a48c-4369-a6ea-1a37675b9a93",
                                                "sense_id": "282009eb-166e-35aa-9ad8-4cd5d0923fac",
                                                "text": "La principale différence entre le Baccara en banque et le Chemin de fer réside en ce que chaque joueur, dans ce dernier jeu, devient banquier à tour de rôle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc2c4ffa-a351-31d4-80e6-d6a16f8a7aef",
                                        "entry_id": "3674993c-aa58-3b7b-b83c-0fe62cad671f",
                                        "glosses": [
                                            "Point zéro au baccara."
                                        ],
                                        "tags": [
                                            "Cartes à jouer"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1e0c6628-3e0e-3e30-9f97-f1d53f9b2e19",
                                        "entry_id": "3674993c-aa58-3b7b-b83c-0fe62cad671f",
                                        "glosses": [
                                            "Faillite, échec."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbe63b67-0f4a-4f78-8fb0-ec0f21cf3a40",
                                                "sense_id": "1e0c6628-3e0e-3e30-9f97-f1d53f9b2e19",
                                                "text": "Être en plein baccara, être dans une misère noire."
                                            },
                                            {
                                                "example_id": "193862cb-2b1a-4639-bde2-6e75cebc446d",
                                                "sense_id": "1e0c6628-3e0e-3e30-9f97-f1d53f9b2e19",
                                                "text": "J'suis en plein baccara. Tiens, j'ai juste trois thunes."
                                            },
                                            {
                                                "example_id": "76eb7d50-6549-4e44-986f-3bf4f2bf818c",
                                                "sense_id": "1e0c6628-3e0e-3e30-9f97-f1d53f9b2e19",
                                                "text": "Une gonzesse qui me fait la malle, les condés qui me rallègent aux miches, je suis en plein baccara !"
                                            },
                                            {
                                                "example_id": "f840d454-96db-45a5-aec8-5e2efd896a23",
                                                "sense_id": "1e0c6628-3e0e-3e30-9f97-f1d53f9b2e19",
                                                "text": "Après le baccara qu’il vient d’encaisser chez Peter, Hans a éprouvé le besoin de réfléchir et de faire le point."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
