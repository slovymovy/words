                                        "entry_id": "34eb0df2-cab3-3534-bd55-57593cad4eb9",
                                        "glosses": [
                                            "The wood of the Pará rubber tree."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
