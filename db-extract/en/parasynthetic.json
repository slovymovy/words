                                        "glosses": [
                                            "Qualifie un mot composé par l'addition combinée d'un préfixe et d'un suffixe à une base."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e79563-10f7-4366-a050-3c32cf61339d",
                                                "sense_id": "7a1c9e33-4c99-36e0-97da-2d54ca5d42b7",
                                                "text": "La dérivation est dite simple quand elle se fait soit par préfixation, soit par suffixation soit par les deux à la fois. Dans ce dernier cas elle est appelée dérivation parasynthétique."
                                            }
                                        ]
                                    }
