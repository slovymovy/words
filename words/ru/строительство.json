                {
                    "sense_id": "de2f3e56-1654-366f-9fff-82c6044a3c77",
                    "sense_definition": "Процесс возведения зданий, сооружений или иных объектов.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "процесс созидания",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Весной началось <w>строительство</w> нового дома в нашем районе.",
                            "target_lang_translations": {
                                "en": "In the spring, the <w>construction</w> of a new house began in our neighborhood."
                            }
                        },
                        {
                            "text": "План включает <w>строительство</w> дорог и ремонт старых больниц.",
                            "target_lang_translations": {
                                "en": "The plan includes the <w>building</w> of roads and the renovation of old hospitals."
                            }
                        }
                    ],
                    "synonyms": [
                        "возведение",
                        "постро́йка"
                    ],
                    "antonyms": [
                        "разрушение"
                    ],
                    "common_phrases": [
                        "строительство дорог",
                        "начать строительство",
                        "план строительства"
                    ],
                    "target_lang_definitions": {
                        "en": "The process of erecting buildings, structures, or other objects."
                    },
                    "translations": {
