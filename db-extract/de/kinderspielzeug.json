                "senses": [
                    {
                        "sense_id": "791a1aeb-f726-30ed-9287-659f5d7c8eea",
                        "entry_id": "b87500af-2f99-360c-9fb1-0ee06aada082",
                        "glosses": [
                            "speziell auf die Bedürfnisse von Kindern abgestimmtes Spielzeug"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22d34fee-0921-48fd-8dd1-bdba87127014",
                                "sense_id": "791a1aeb-f726-30ed-9287-659f5d7c8eea",
                                "text": "„Lego gilt als Inbegriff des pädagogisch wertvollen Kinderspielzeugs.“"
                            },
                            {
                                "example_id": "5e5169cd-f69b-44aa-9b1a-5c1be1f1e834",
                                "sense_id": "791a1aeb-f726-30ed-9287-659f5d7c8eea",
                                "text": "Ich muss noch das Kinderspielzeug wegräumen."
                            },
                            {
                                "example_id": "7b26716c-13a5-4f2a-925d-67dfec625c74",
                                "sense_id": "791a1aeb-f726-30ed-9287-659f5d7c8eea",
                                "text": "Auf dem Weihnachtsmarkt gibt es Weihnachtsdekoration, Bücher, Kinderspielzeug, Grußkarten, Delikatessen, Gebäck, Marmelade, Liköre und nicht zuletzt Christstollen."
                            },
                            {
                                "example_id": "696a15b7-74eb-4661-9778-c71f9f1fada3",
                                "sense_id": "791a1aeb-f726-30ed-9287-659f5d7c8eea",
                                "text": "Gefährliche Kinderspielzeuge sollen vom Markt verschwinden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
