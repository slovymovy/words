                            {
                                "example_id": "eea21fa9-8160-437a-80b5-d809e0c71e39",
                                "sense_id": "f2a64ab0-fb29-3ee5-90e0-b1c17b6e9090",
                                "text": "De kaartjes waren wel veertig franc per stuk geweest, vertelde hij met glanzende ogen en hij maande met zijn vinger, je bent elf nu, pas op, nu ga je het beleven."
                            }
                        ]
                    },
