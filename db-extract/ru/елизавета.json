                                "target_senses": [
                                    {
                                        "sense_id": "a73ea0cb-10c3-3127-83c2-394e183ead7e",
                                        "entry_id": "99a537bd-df26-31fa-9ed4-f0feffbc2b4e",
                                        "glosses": [
                                            "imię żeńskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd3d7439-82a0-4245-91de-914e685e5763",
                                                "sense_id": "a73ea0cb-10c3-3127-83c2-394e183ead7e",
                                                "text": "Wczoraj poszedłem z moją Elżbietą do kina."
                                            },
                                            {
                                                "example_id": "30d897a2-2e4c-42c4-add7-6b2961cc61b3",
                                                "sense_id": "a73ea0cb-10c3-3127-83c2-394e183ead7e",
                                                "text": "Podczas rządów Władysława Jagiełły został w 1410 powołany na sekretarza kancelarii królewskiej, lecz pozbawiony tej funkcji w 1419 roku za napisanie paszkwilu na królową Elżbietę."
                                            },
                                            {
                                                "example_id": "ef42a094-4ed2-4189-ae00-aac4dda440d8",
                                                "sense_id": "a73ea0cb-10c3-3127-83c2-394e183ead7e",
                                                "text": "Elżbieta kończyła doprawiać specjalnym sosem surówkę z różnorakich warzyw i owoców, a Alicja już zaczęła nakrywać stół kolorowym obrusem."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "ddaf8c83-05ba-3846-bc5c-5de87cc7fe5b",
                                        "entry_id": "99a537bd-df26-31fa-9ed4-f0feffbc2b4e",
                                        "glosses": [
                                            "wieś w Polsce, w województwie lubelskim, w gminie Opole Lubelskie"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7fdc48a4-c490-40a9-b4d0-90ed966850a3",
                        "source_entry_id": "4b4767bf-29bb-307a-b5a1-c3cc3597d535",
                        "source_sense_id": "5475e290-6a2e-354a-831f-b3be682836e6",
                        "source_sense_description": "Иноязычные аналоги",
                        "target_lang_word": "Élisabeth",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Élisabeth",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5587b122-f3ff-33d5-9390-220e11c4995c",
                                        "entry_id": "8e718963-70b1-36cf-a433-db1cb71ede1c",
                                        "glosses": [
                                            "Prénom féminin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "febac71c-b982-4ec2-a184-880b1e537dd6",
                                                "sense_id": "5587b122-f3ff-33d5-9390-220e11c4995c",
                                                "text": "Élisabeth était forcée de se parler à elle-même au lieu de communiquer ses idées, car elle se sentait sans pairs qui la comprissent."
                                            },
                                            {
                                                "example_id": "6cde5eb7-528a-4185-9bd1-0866cbfc25db",
                                                "sense_id": "5587b122-f3ff-33d5-9390-220e11c4995c",
                                                "text": "Elle s’appelait Élisabeth Mabille, elle avait mon âge."
                                            },
                                            {
                                                "example_id": "99c2b22a-260e-40e2-bac4-e069f6c9aedf",
                                                "sense_id": "5587b122-f3ff-33d5-9390-220e11c4995c",
                                                "text": "J’étais, je ne sais pourquoi, déguisée en sainte Élisabeth de Hongrie, peut-être parce qu’un plâtre de cette sainte décorait l’église."
                                            }
                                        ]
                                    }
                                ]
