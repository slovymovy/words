                "senses": [
                    {
                        "sense_id": "8cca6299-0209-3889-9455-acc4c1b5588d",
                        "entry_id": "217c1676-02d5-3e6a-b080-1932d8079713",
                        "glosses": [
                            "pigmentierte Zelle von Gewebetieren, die meistens oberflächennah im Körper liegt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1569d40f-3c9f-423d-8c1f-b93999191b04",
                                "sense_id": "8cca6299-0209-3889-9455-acc4c1b5588d",
                                "text": "„Ein Haar ist schwarz oder blond, weil eine Pigmentzelle in der Haarwurzel es färbt.“"
                            },
                            {
                                "example_id": "93a23cec-0f9e-481a-9394-eeab56e344e4",
                                "sense_id": "8cca6299-0209-3889-9455-acc4c1b5588d",
                                "text": "„Der Schwerpunkt seiner Beweisführung liegt in der Aufstellung einer Entwicklungsreihe der Pigmentzelle.“"
                            },
                            {
                                "example_id": "cbda25b0-c92c-46c1-b4dd-b794830ce2cd",
                                "sense_id": "8cca6299-0209-3889-9455-acc4c1b5588d",
                                "text": "„Die meisten primitiven Zellen dieser sternförmigen Pigmentzellen zeichnen sich von gewöhnlichen Pigmentzellen nur dadurch aus, dass sie gewöhnlich kleiner und dichter mit Pigment gefüllt sind.“"
                            }
                        ],
