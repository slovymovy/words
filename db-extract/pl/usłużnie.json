                    {
                        "translation_id": "f7888cf5-3bb2-43c5-be8a-10a981c4c97b",
                        "source_entry_id": "b8ab0955-8e65-3e52-96a4-b0e4a05bc705",
                        "source_sense_id": "cc18c8c0-29b5-3d65-a16b-78139ad44237",
                        "target_lang_word": "hilfsbereit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hilfsbereit",
