                    "sense_id": "19263148-4250-3cbe-87ee-a4d833256ca8",
                    "sense_definition": "samen met iemand anders ergens naartoe gaan",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "begeleiden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wil je vanavond gezellig met ons <w>meekomen</w> naar de bioscoop?",
                            "target_lang_translations": {
                                "en": "Do you want to <w>come along</w> with us to the cinema tonight?"
                            }
                        },
                        {
                            "text": "De verdachte weigerde te luisteren en <w>kwam</w> niet vrijwillig <w>mee</w>.",
                            "target_lang_translations": {
                                "en": "The suspect refused to listen and did not <w>come along</w> voluntarily."
                            }
                        }
                    ],
                    "synonyms": [
                        "meegaan"
                    ],
                    "antonyms": [
                        "achterblijven"
                    ],
                    "common_phrases": [
                        "gezellig meekomen",
                        "met de politie meekomen"
                    ],
                    "target_lang_definitions": {
                        "en": "to accompany someone; to go or come along with others to a destination"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to come along",
                                "target_lang_sense_clarification": "to accompany someone to a place or event"
                            },
                            {
                                "target_lang_word": "to come with",
                                "target_lang_sense_clarification": "to join someone on their way somewhere"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "18f3e76e-40b4-315c-afba-9fe541aff530",
                    "sense_definition": "het tempo of niveau van anderen kunnen evenaren of bijhouden",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "bijhouden",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De nieuwe leerling kan op school nog niet goed <w>meekomen</w> met de rest.",
                            "target_lang_translations": {
                                "en": "The new pupil cannot quite <w>keep up</w> with the rest at school yet."
                            }
                        },
                        {
                            "text": "Tijdens de snelle dansles <w>kwam</w> hij nauwelijks <w>mee</w> met het ritme van de muziek.",
                            "target_lang_translations": {
                                "en": "During the fast dance lesson, he could barely <w>keep up</w> with the rhythm of the music."
                            }
                        }
                    ],
                    "synonyms": [
                        "bijblijven",
                        "volgen"
                    ],
                    "antonyms": [
                        "achteropraken"
                    ],
                    "common_phrases": [
