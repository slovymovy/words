                                "sense_id": "e0296c83-d0e8-365d-ad60-5901b013cadf",
                                "text": "Am 31. Oktober ist Reformationstag."
                            },
                            {
                                "example_id": "63173b4f-d635-4479-aff5-ab3ce29236c8",
                                "sense_id": "e0296c83-d0e8-365d-ad60-5901b013cadf",
                                "text": "„Zu ihrer Weihe am Reformationstag 1898 zog Wilhelm II. in Jerusalem ein.“"
                            }
