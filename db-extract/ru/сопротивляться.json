                        "entry_id": "521ff0ac-f31d-35d9-8170-36703040c1b4",
                        "glosses": [
                            "не давать овладеть собой чему-либо нежелательному, противостоять воздействию чего-либо нежелательного"
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
