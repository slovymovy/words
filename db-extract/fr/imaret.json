                "forms": [
                    {
                        "form_id": "b3857012-c3ad-4a39-81e4-63ddfc7581f4",
                        "entry_id": "e47f650a-a7da-32ef-a4c5-4f612c74778f",
                        "tags": [
                            "plural"
                        ],
                        "form": "imarets"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9a485c50-162c-3bfb-86b4-315657347431",
                        "entry_id": "e47f650a-a7da-32ef-a4c5-4f612c74778f",
                        "glosses": [
                            "Établissement turc, où l'on assure la distribution de vivres pour les nécessiteux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07b1b808-6b85-4f2b-90a4-5cead8dca909",
                                "sense_id": "9a485c50-162c-3bfb-86b4-315657347431",
                                "text": "A côté de celle-ci il avait fait construire une école et un imaret pour les pauvres, auxquels il légua des biens assez importants."
                            },
                            {
                                "example_id": "36befcc3-089a-41a2-8423-d9b4968c4193",
                                "sense_id": "9a485c50-162c-3bfb-86b4-315657347431",
                                "text": "Il y avait une mosquée, un asile de cinquante chambres, un dispensaire, et les deux installations dont Kamal et Nisrine avaient le plus besoin : un imaret - une cuisine publique - et un petit han, un gîte destiné aux voyageurs."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0eb0bb7b-bb24-4ca3-a2b9-0b2a62fc6a2c",
                        "source_entry_id": "e47f650a-a7da-32ef-a4c5-4f612c74778f",
                        "source_sense_id": "9a485c50-162c-3bfb-86b4-315657347431",
                        "target_lang_word": "imaret",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imaret",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7e7893a-ffdb-327e-b127-f9982df7551e",
                                        "entry_id": "2bf5ea7c-8933-3806-8e05-f78a1e185c00",
                                        "glosses": [
                                            "An Ottoman soup kitchen built between the fourteenth and nineteenth centuries, often part of a larger complex or waqf."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea045bf3-be33-46b5-acaa-608fee08e4e7",
                                                "sense_id": "f7e7893a-ffdb-327e-b127-f9982df7551e",
                                                "text": "Yıldırım Bayezid had located his imaret in the opposite direction, some two kilometers to the east of the city. Mehmed I chose a site closer to the center, between the imarets of Orhan Gazi and Yıldırım Bayezid."
                                            },
                                            {
                                                "example_id": "c2687fa2-301a-4319-abee-202494922847",
                                                "sense_id": "f7e7893a-ffdb-327e-b127-f9982df7551e",
                                                "text": "It was originally built as a zaviye, or hostel, for members of the Ahi Brotherhood of Virtue; later it became an imaret, serving free food to the poor of Iznik."
                                            },
                                            {
                                                "example_id": "cd3635c2-17e1-49b4-b436-36e29fa76ba4",
                                                "sense_id": "f7e7893a-ffdb-327e-b127-f9982df7551e",
                                                "text": "He lived in an elegant stone house, a part of the Imaret of Haseki Sultan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
