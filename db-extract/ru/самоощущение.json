                                    {
                                        "sense_id": "2aca80c8-d0fa-365c-ad3c-24ac45c60e3e",
                                        "entry_id": "41a850f3-e88f-32fb-897d-44fe53f5e8b7",
                                        "glosses": [
                                            "The state or property of being self-aware; state of being aware of oneself as an individual."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "065e812a-ab85-39bb-b5d0-5d65a865aabb",
                                        "entry_id": "41a850f3-e88f-32fb-897d-44fe53f5e8b7",
                                        "glosses": [
                                            "A personal trait regarding someone's ability to persistently and accurately perceive their presence amongst other people, and their own knowledge and abilities."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dddc8ce9-87a4-48d4-acd6-4495eb9fc9d0",
                                                "sense_id": "065e812a-ab85-39bb-b5d0-5d65a865aabb",
                                                "text": "As with any good relationship, readers who have experience with ENM say self-awareness and communication are key to keeping things harmonious."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "136b1ef1-25b5-4a44-b46c-c2b8275a4fd0",
                        "source_entry_id": "986dd1ca-94c6-3a88-bbb4-4dfcfb765b92",
