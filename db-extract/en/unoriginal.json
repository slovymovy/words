                "forms": [
                    {
                        "form_id": "e0ab1d96-4ab9-43ba-b2fc-f1f662be4ee3",
                        "entry_id": "6fcd8738-34f0-302e-8d81-ad028d6df837",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more unoriginal"
                    },
                    {
                        "form_id": "99869756-ca99-4b94-9121-b53998b372fd",
                        "entry_id": "6fcd8738-34f0-302e-8d81-ad028d6df837",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most unoriginal"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                        "entry_id": "6fcd8738-34f0-302e-8d81-ad028d6df837",
                        "glosses": [
                            "Lacking originality."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5b8efe67-efa1-4a83-a354-2a6a1fdd34ec",
                                "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                                "text": "1758, William Hawkins, Tracts in Divinity, Oxford, Volume 2, Letter 12 [on Pope’ translations of Homer], pp. 418-419,\nRedundancies are as unoriginal as Insipidities, and the Spirit of an Author may be as much overwhelmed in Exuberance on the one Hand, as it evaporates in Frigidity on the other."
                            },
                            {
                                "example_id": "ef9b2e23-7e5d-4397-a23b-c2ceb1cbf8fb",
                                "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                                "text": "Originality is the one thing which unoriginal minds cannot feel the use of. They cannot see what it is to do for them: how should they?"
                            },
                            {
                                "example_id": "91b412e8-f8fb-4330-b636-84dff555d1ba",
                                "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                                "text": "“[…] Everything in its proper time and season,” he added, with the unoriginal man’s fondness for proverbial philosophy."
                            },
                            {
                                "example_id": "29919b02-c930-4aa2-afe6-3fe9f2f25d51",
                                "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                                "text": "2008, André Brink, Other Lives, Naperville, Illinois: Sourcebooks, “Mirror,” Chapter 8, p. 185,\n“Stories come from other stories.”\n“Then there is no originality anywhere.”\n“Does it matter? Perhaps our very idea of originality is overrated. And unoriginal.”"
                            },
                            {
                                "example_id": "5206f2db-2ea3-4337-9f69-c2c92f2f919a",
                                "sense_id": "9cfa7613-35b8-3804-882b-544bafa6e454",
                                "text": "If you’re a writer, you will write a lot of unoriginal work before you write something original."
                            }
                        ]
                    },
                    {
                        "sense_id": "aadd32c8-045d-33a2-8262-d59451cbe2c6",
                        "entry_id": "6fcd8738-34f0-302e-8d81-ad028d6df837",
                        "glosses": [
                            "Not being the first or earliest version of something, not original."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "992223bf-484a-49fd-bfd9-91e36e2c0ab9",
                                "sense_id": "aadd32c8-045d-33a2-8262-d59451cbe2c6",
                                "text": "1894, Joseph Jacobs (editor), More Celtic Fairy Tales, London: David Nutt, Notes and References, “The Leeching of Kayn’s Leg,” p. 232,\n[This tale] occurs in an MS. of the fifteenth century in an obviously unoriginal form which shows that the story-teller did not appreciate the significance of many features in the folk-tale he was retelling […]"
                            }
                        ]
                    },
                    {
                        "sense_id": "9d4366c4-ef7c-3c9c-baac-0c8c5fa3f7de",
                        "entry_id": "6fcd8738-34f0-302e-8d81-ad028d6df837",
                        "glosses": [
                            "Without an origin or source."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "1683db6c-122b-4738-9ce2-30b8fb51d3c8",
                                "sense_id": "9d4366c4-ef7c-3c9c-baac-0c8c5fa3f7de",
                                "text": "[I] plung’d in the womb\nOf unoriginal Night and Chaos wilde,"
                            }
                        ]
                    }
                ],
