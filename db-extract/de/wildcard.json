                "senses": [
                    {
                        "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                        "entry_id": "095bb470-036d-32fa-ace5-7daf41c964a6",
                        "glosses": [
                            "Berechtigung für die Teilnahme an einem Wettbewerb oder Turnier, die von dem Veranstalter an einen Teilnehmer vergeben wird, der nicht über die formellen Qualifikationen verfügt"
                        ],
                        "tags": [
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "a3808ca1-9bd2-4606-be18-0f97405dac9e",
                                "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                                "text": "„Es ist das bedeutendste Mannschaftsturnier im Golfsport – und Martin Kaymer ist erneut dabei: Der Deutsche erhielt eine Wildcard für das europäische Team.“"
                            },
                            {
                                "example_id": "41922870-e9f8-4dfa-b5c8-e72a5f556ae9",
                                "sense_id": "a5141c68-adfd-32a5-a7e4-fcb41dfccd9c",
                                "text": "„Mit einer Wildcard nimmt er in den kommenden drei Tagen am Turnier in Jeddah teil.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "85c7299e-74de-30c4-a9d4-fcb92daffd39",
                        "entry_id": "095bb470-036d-32fa-ace5-7daf41c964a6",
                        "glosses": [
                            "Zeichen oder Zeichenfolge, die stellvertretend für beliebige andere Zeichen steht"
                        ],
                        "tags": [
                            "EDV"
                        ],
                        "examples": [
                            {
                                "example_id": "43f824ea-b79e-4860-ab20-cc49f93da8cd",
                                "sense_id": "85c7299e-74de-30c4-a9d4-fcb92daffd39",
                                "text": "Das * in der Abfrage *.com ist eine Wildcard und steht für jede beliebige Zeichenfolge vor der Dateiendung.com."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
