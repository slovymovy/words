                                                "sense_id": "9f65c6cd-9747-3677-8899-871302b6d27d",
                                                "text": "I am going to brick up the window instead of replacing the glass."
                                            },
                                            {
                                                "example_id": "be39f55d-99ee-4a25-8376-eac68cc3e2c6",
                                                "sense_id": "9f65c6cd-9747-3677-8899-871302b6d27d",
                                                "text": "The tunnel's mouth was bricked up because it was unsafe."
                                            },
                                            {
