                    },
                    {
                        "translation_id": "b0aeff16-9108-4d27-967a-287658831152",
                        "source_entry_id": "375c37f7-b5c7-3d47-873d-5eb12001a750",
                        "source_sense_id": "d7e3c2d9-5aad-33fe-99a3-7f8e92327886",
                        "target_lang_word": "Gardist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gardist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                        "entry_id": "5c849a84-68bd-3182-a787-31f310ae92e0",
                                        "glosses": [
                                            "Angehöriger der Garde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c44b3d03-628d-4477-a7e3-f4eb5baef3a9",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Aber nicht das Gebäude ist die Attraktion, sondern die davor Wache haltenden Soldaten: Ein Gardist zu Fuß und zwei zu Pferd vom Corps der Household Cavalry stehen, unbeeindruckt von den um sie herum wuselnden Touristen, auf ihrem Posten.“"
                                            },
                                            {
                                                "example_id": "7d52f4df-365e-446a-a112-cfb8a0b44ccb",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Die beiden Gardisten erzählten Rostow von ihrem Marsch und von allen Empfängen und Feiern, die man der Garde zu Ehren in Russland, in Polen und im Auslande veranstaltet hatte.“"
                                            },
                                            {
                                                "example_id": "d9691df1-ca3d-4850-9e79-0901d25170e2",
                                                "sense_id": "1328741c-f344-3f11-92c1-53e7cf9fc623",
                                                "text": "„Von 189 Gardisten kamen 147 ums Leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "eb8a889a-cb9b-4444-9971-3d71b3169d26",
                        "source_entry_id": "375c37f7-b5c7-3d47-873d-5eb12001a750",
                        "source_sense_id": "d7e3c2d9-5aad-33fe-99a3-7f8e92327886",
                        "target_lang_word": "Gardesoldat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gardesoldat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5b4a943f-63e7-37e1-9c02-32717376bec8",
                                        "entry_id": "311f2256-8a5d-31ca-8fe8-22ef3853653c",
                                        "glosses": [
                                            "Soldat, der Mitglied der Garde ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5ad6cc95-bd9b-44af-8650-1610f70563a2",
                                                "sense_id": "5b4a943f-63e7-37e1-9c02-32717376bec8",
                                                "text": "„Ein Gardesoldat war im August 2017 nach einem Marsch bei Hitze verstorben.“"
                                            },
                                            {
                                                "example_id": "66f8c92c-9159-4066-b438-bf6dc5db856e",
                                                "sense_id": "5b4a943f-63e7-37e1-9c02-32717376bec8",
                                                "text": "„Nur einer der Männer, der Gardesoldat I.G. Moros, starb am 25. April 1945.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e523f32-f645-4d39-876f-4c21e77fc87a",
                        "source_entry_id": "375c37f7-b5c7-3d47-873d-5eb12001a750",
                        "source_sense_id": "d7e3c2d9-5aad-33fe-99a3-7f8e92327886",
                        "target_lang_word": "гвардеец",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гвардеец",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "4a1c5515-a5a7-34f3-84f6-cab57f7d18e7",
                                        "entry_id": "6858d6d3-04f4-3227-a500-f028fbe36f9b",
                                        "glosses": [
                                            "военный, проходящий службу в гвардии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9157aeac-2dbf-4c1c-8e82-894b67422034",
                                                "sense_id": "4a1c5515-a5a7-34f3-84f6-cab57f7d18e7",
                                                "text": "Первым женихом Мимочки был молодой и блестящий гвардеец, у которого были чудесные лакированные сапоги, чёрные усики, волнистые каштановые волосы и pincenez в золотой оправе."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6725042d-8c73-3da9-8750-598fd986cf32",
                                        "entry_id": "6858d6d3-04f4-3227-a500-f028fbe36f9b",
                                        "glosses": [
                                            "перен., разг. о человеке имеющем высокий рост, крепкое сложение, молодцеватый вид"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d67cfa94-0d3d-4da9-b47f-aabab915ce14",
                                                "sense_id": "6725042d-8c73-3da9-8750-598fd986cf32",
                                                "text": "― Что вы, Полин. Александр Сергеевич, увы, совсем не гвардеец. Два аршина пять вершков с половиной."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
