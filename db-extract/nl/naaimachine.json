                                "target_senses": [
                                    {
                                        "sense_id": "bdd6891a-17eb-33f2-8143-2b143b9d7490",
                                        "entry_id": "8f6300e4-dd7d-35e5-9253-e378bad1af95",
                                        "glosses": [
                                            "Any mechanical or electromechanical device used to stitch cloth or other material; normally uses two threads to form lock stitches."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d575ea32-dbf8-4d31-b8e1-f67ff0b910c5",
                        "source_entry_id": "f4b2aac5-759e-30a5-aa5e-6237da2a20d7",
                        "source_sense_id": "f4ea9eb8-6850-3f58-b346-5609f6fb5d5a",
                        "target_lang_word": "machine à coudre",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "machine à coudre",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6132bca4-5368-36b5-8250-62135d2aac9c",
                                        "entry_id": "7750ef49-6c58-3052-8265-58427a56c067",
                                        "glosses": [
                                            "Machine, d’usage domestique ou industriel, qui exécute mécaniquement les points de couture, généralement en utilisant deux fils, le fil supérieur enfilé dans l’aiguille, et le fil inférieur venant de la canette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9c51c82-8e26-475d-a87e-6dd24e1300dd",
                                                "sense_id": "6132bca4-5368-36b5-8250-62135d2aac9c",
                                                "text": "Ah, il se moquait bien maintenant aussi de sa machine à coudre, à laquelle il devait tant de petites joies chaque fois qu’il poussait la pédale avec son pied ! Mais pourquoi y pensait-il ? Il était vraiment ridicule d’aller de l’image de cet enfant à celle de la Singer."
                                            },
                                            {
                                                "example_id": "225ebb40-8ef0-4301-9b02-43b51d3a2d64",
                                                "sense_id": "6132bca4-5368-36b5-8250-62135d2aac9c",
                                                "text": "La psychanalyse en fut pour ses frais qui vit dans l’accouplement inconfortable de la machine à coudre et du parapluie, sur une table de dissection, un coupable fantasme fornicatoire."
                                            },
                                            {
                                                "example_id": "b1446179-7877-43ca-a837-87a75ece3db1",
                                                "sense_id": "6132bca4-5368-36b5-8250-62135d2aac9c",
                                                "text": "Vous pouvez trouver différentes marques de fil multiusages dans votre boutique de tissu ou chez votre revendeur de machines à coudre."
                                            },
                                            {
                                                "example_id": "25cff5b1-e7ed-42ad-ac9a-f632ca395060",
                                                "sense_id": "6132bca4-5368-36b5-8250-62135d2aac9c",
                                                "text": "Les seuls bruits qu’on entendait désormais étaient ceux des machines à coudre ou à embosser le cuir et des métiers à tisser..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fb51423-6b2d-3f11-a503-3aaad050dd62",
                                        "entry_id": "7750ef49-6c58-3052-8265-58427a56c067",
                                        "glosses": [
                                            "Machine servant à coudre les cahiers d’un livre au fil textile."
                                        ],
                                        "tags": [
                                            "Imprimerie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
