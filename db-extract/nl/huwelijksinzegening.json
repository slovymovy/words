                        "glosses": [
                            "gods zegen vragen voor het huwelijk; man en vrouw met elkaar laten verbinden door god"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68bd4843-3c76-423f-a082-3fb0aa25a840",
                                "sense_id": "2ef4dee4-c42e-3439-a35d-96837248b692",
                                "text": "Volgens Britse media woonden zo’n 120 gasten de kerkelijke huwelijksinzegening bij, op het feest in de achtertuin van de familie Middleton in Bucklebury worden nog eens 200 extra gasten verwacht."
                            },
                            {
                                "example_id": "d18c1e70-f6d6-48a1-ab3f-00648eee737d",
                                "sense_id": "2ef4dee4-c42e-3439-a35d-96837248b692",
                                "text": "De huwelijksinzegening in de paleiskerk van het Koninklijk Paleis in Stockholm zaterdagmiddag was een mooie mix van traditie en moderne elementen, niet in de laatste plaats het 'Joyful, Joyful'waarmee de dienst werd besloten."
                            }
