                        "examples": [
                            {
                                "example_id": "b6af323b-452b-427c-a501-f62c14bd1534",
                                "sense_id": "20cabbf7-d73e-33b2-9b1b-fe1ff7ef816e",
                                "text": "Hij is allang vertrokken."
                            },
                            {
                                "example_id": "5302373a-8ee7-45c4-8fe8-ac3052c0aa63",
                                "sense_id": "20cabbf7-d73e-33b2-9b1b-fe1ff7ef816e",
                                "text": "De wijn uit het Rhônedal heeft de afgelopen decennia aan prestige gewonnen door productverbetering en slimme marketing. De Côtes du Rhône is allang geen onaanzienlijk slobberwijntje meer, maar een succesvol exportproduct."
                            },
                            {
                                "example_id": "24fbaa39-6ef4-42e9-a011-e9974db234b9",
                                "sense_id": "20cabbf7-d73e-33b2-9b1b-fe1ff7ef816e",
                                "text": "Waren ze gaan twijfelen? Nee, helemaal niet. Echt niet, verzekerde Karl hem opgelaten. Als hij en Louise het alleen konden beslissen, zouden ze allang getrouwd zijn. Maar dat was helaas niet zo."
                            }
                        ]
                    },
                    {
                        "sense_id": "40d58784-bcbb-3c75-883f-f93f5c32fbbc",
                        "entry_id": "0167232c-29e1-3de4-b449-07181301566d",
                        "glosses": [
                            "niet meer eisend of willend"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36418d34-d884-410d-8079-ecdda649393d",
                                "sense_id": "40d58784-bcbb-3c75-883f-f93f5c32fbbc",
                                "text": "Een onbekende stem vertelde een eindeloos lange mop met een zeer matige clou, maar ik was allang blij afgeleid te worden."
                            }
                        ]
                    }
