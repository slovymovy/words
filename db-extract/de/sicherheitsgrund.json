                ],
                "senses": [
                    {
                        "sense_id": "944f9f85-f703-3b63-9dd9-cdb9d518016f",
                        "entry_id": "788470c5-3b20-3534-bd35-980307e081a1",
                        "glosses": [
                            "Argument (Grund) für die Unversehrtheit, Stabilität (Sicherheit) des dargestellten Sachverhalts/Objekts; Aspekt, der vor Gefahren schützt"
                        ],
                        "tags": [
                            "plural",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "3c21cbaf-ac06-4a0a-b99b-8ccd098b3de5",
                                "sense_id": "944f9f85-f703-3b63-9dd9-cdb9d518016f",
                                "text": "Man sollte dies aus Sicherheitsgründen nicht tun."
                            },
                            {
                                "example_id": "a56b21e0-26d7-4505-8d67-460c6b9ec5bc",
                                "sense_id": "944f9f85-f703-3b63-9dd9-cdb9d518016f",
                                "text": "„Neue Herrschaftshäuser und Siedlungen wurden nun aus Sicherheitsgründen vor weiteren möglichen Flutkatastrophen oder von der See her kommenden Piraten auf küstenferneren Hügeln errichtet und von Mauern umgeben.“"
                            },
                            {
                                "example_id": "46485e2a-d807-46a7-bdbc-e99a3c2467e8",
                                "sense_id": "944f9f85-f703-3b63-9dd9-cdb9d518016f",
                                "text": "„Ein anderer wichtigerer Grund ist der Sicherheitsgrund, falls Messungen bestimmter Leistungsgrößen an dem realen System, beispielsweise einem Kraftwerk, aus Sicherheitsvorschriften nicht zuzulassen sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
