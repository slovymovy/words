                                        ]
                                    },
                                    {
                                        "sense_id": "de2731c8-db41-3be6-a840-f706096a7ff7",
                                        "entry_id": "bd39261d-7b26-354b-8c14-56d13ebcf3e9",
                                        "glosses": [
