                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The famous researcher <w>Balk</w> published his findings last year.",
                            "target_lang_translations": {
                                "es": "El famoso investigador <w>Balk</w> publicó sus hallazgos el año pasado."
                            }
                        },
                        {
                            "text": "I met a man named Mr. <w>Balk</w> at the conference.",
                            "target_lang_translations": {
                                "es": "Conocí a un hombre llamado Sr. <w>Balk</w> en la conferencia."
                            }
                        }
                    ],
                    "traits": [
