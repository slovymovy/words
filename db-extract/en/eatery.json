                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Esslokal",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d1c18491-21b9-3e8a-8f4d-90a827c49efe",
                                        "entry_id": "b4409299-e8dd-37d5-b68e-40629c0870ee",
                                        "glosses": [
                                            "gastronomischer Betrieb, der Essen serviert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c857daaf-48ec-4e29-86e4-3388a0e9e75c",
                                                "sense_id": "d1c18491-21b9-3e8a-8f4d-90a827c49efe",
                                                "text": "„Sein neues Hauptquartier war das Palace Chop House, ein Esslokal gleich beim Hotel.“"
                                            },
                                            {
                                                "example_id": "236f2238-e327-49ff-a93d-7a09b56bd0eb",
                                                "sense_id": "d1c18491-21b9-3e8a-8f4d-90a827c49efe",
                                                "text": "„In der rue de l'Odéon gab es keine Esslokale, erst an dem Platz, wo drei Restaurants waren."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
