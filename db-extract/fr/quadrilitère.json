                        "glosses": [
                            "Qui comporte quatre consonnes servant de support aux éléments vocaliques, en parlant d’un mot."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2824d02e-c1af-46ce-adf4-a2048bf25816",
                                "sense_id": "144dce40-5a94-36af-94af-a335201b78bd",
                                "text": "Le verbe quadrilitère est celui dont la racine ou 3ᵉ personne du singulier masculin du prétérit est composée de quatre lettres."
                            },
                            {
                                "example_id": "d719b9fd-84c5-490e-abfc-b317b7758d59",
                                "sense_id": "144dce40-5a94-36af-94af-a335201b78bd",
                                "text": "Même cette épouvante qui s’appelle verbes sourds, concaves, assimilés, défectueux, hamzés, trilitères, quadrilitères, et les dix formes de leurs dérivés ne parvient pas à me rebuter."
                            }
                        ]
                    }
