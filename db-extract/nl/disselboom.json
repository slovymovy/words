                "senses": [
                    {
                        "sense_id": "a7215645-5fc5-3370-a149-b3c47d3f489e",
                        "entry_id": "c0b01df4-03dc-30cd-abbd-06024bcbda48",
                        "glosses": [
                            "mechanisme om meerdere paarden of andere dieren samen een gespan te laten vormen; door de hefboomwerking kon een jonger dier opgeleerd worden (en kreeg het een langere lastarm)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66ed6644-7802-4fdb-91e7-97fce37c2436",
                                "sense_id": "a7215645-5fc5-3370-a149-b3c47d3f489e",
                                "text": "Door het combineren van meerdere disselbomen kon een drie- of vierspan gevormd worden (ieder dier kon trekken al naargelang zijn kracht)"
                            },
                            {
                                "example_id": "e7244c6b-f6a3-4582-a904-d61fc4493714",
                                "sense_id": "a7215645-5fc5-3370-a149-b3c47d3f489e",
                                "text": "Arme boeren konden een ossenspan vormen; wanneer er niet genoeg ossen meer waren kon ook een koe bijgelegd worden"
                            },
                            {
                                "example_id": "f1965be1-898e-48d1-ad3c-ef4a17554735",
                                "sense_id": "a7215645-5fc5-3370-a149-b3c47d3f489e",
                                "text": "Enkel het oudste dier werd gemend; de andere dieren volgden"
                            },
                            {
                                "example_id": "07abaca0-5690-46bb-8c2b-f4f71060456e",
                                "sense_id": "a7215645-5fc5-3370-a149-b3c47d3f489e",
                                "text": "We reden langzaam de stad in vanaf de haven omdat de straten vol waren met mensen en een klein soort rijtuigen die bestonden uit een wagen met een fiets in plaats van een paard, of zelfs een wagen met twee disselbomen en een blootsvoetse neger als paard."
                            }
                        ]
                    }
