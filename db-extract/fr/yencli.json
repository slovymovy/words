                            {
                                "example_id": "857a97e0-1356-4da2-ab13-5f219be7ffb4",
                                "sense_id": "2c97fe15-abcb-3e6f-8da3-99d6406dd7fa",
                                "text": "Il tfallait combien ? Yencli. - Kekra (rappeur) s'adressant à Joke (rappeur)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "803974f4-3113-4c5c-b146-e3f1f866dfb1",
                        "source_entry_id": "aeed9674-ee33-37fe-868e-20cace912cc1",
                        "source_sense_id": "2c97fe15-abcb-3e6f-8da3-99d6406dd7fa",
                        "target_lang_word": "wigger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "wigger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07523c29-7fa3-3654-a6fd-e2944b5f83e8",
                                        "entry_id": "54c7441e-dcae-388b-b84b-57d9d7e53e04",
                                        "glosses": [
                                            "A maker of wigs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9822e67e-70cc-417e-8958-75e43dcfadaf",
                                                "sense_id": "07523c29-7fa3-3654-a6fd-e2944b5f83e8",
                                                "text": "I flounder about for my diplomacy and give up; it is simply one man against four wiggers, that much is clear, and they are going to fight me down to the wire. \"This girl does not need a wig at all,\" I am forced to say yet once more."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "wigger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b546a13c-9cbd-3ce5-a718-952112eb7002",
                                        "entry_id": "6334cb30-3bb0-3547-a4a7-44bf714308df",
                                        "glosses": [
                                            "A white person, typically young and male, considered to be overly infatuated with African-American or (UK) Afro-Caribbean culture, a cultural appropriator."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b802d656-cf4c-4f36-a3de-9e7ed15791da",
                                                "sense_id": "b546a13c-9cbd-3ce5-a718-952112eb7002",
                                                "text": "I have often heard the word \"wigger\" used to describe a white person who supposedly acts and talks \"black,\" while the same type of taunting is put upon a black person who supposedly acts \"white.\""
                                            },
                                            {
                                                "example_id": "ddd9c5fc-cef9-4ad4-814d-3df7586af753",
                                                "sense_id": "b546a13c-9cbd-3ce5-a718-952112eb7002",
                                                "text": "To some extent wiggers are simply the most visible examples of a very American brand of teenage rebellion."
                                            },
                                            {
                                                "example_id": "b7e4e4c4-275e-45eb-8d20-e9ccd54db217",
                                                "sense_id": "b546a13c-9cbd-3ce5-a718-952112eb7002",
                                                "text": "And I just do not got the patience\nTo deal with these cocky Caucasians\nWho think I'm some wigger who just tries to be black..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "46fc7e9e-e1ee-3c9e-b7e8-f2611f10ba42",
                                        "entry_id": "6334cb30-3bb0-3547-a4a7-44bf714308df",
                                        "glosses": [
                                            "A nonblack person of any race considered to be inauthentically appropriating black culture and behavior."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "78ac0858-a06d-37f8-ba04-19e90726b96e",
                                        "entry_id": "6334cb30-3bb0-3547-a4a7-44bf714308df",
                                        "glosses": [
                                            "A white person considered to be sincerely appreciative of black culture, as opposed to poseurs and wannabes."
                                        ],
                                        "tags": [
                                            "dated",
                                            "uncommon"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cab7a2-b4c6-4bca-b1d1-da06047f079d",
                                                "sense_id": "78ac0858-a06d-37f8-ba04-19e90726b96e",
                                                "text": "The Oprah people were on the phone with my mom. Someone had given them my name as an expert on wiggers. You know, Wiggers. White kids who identify themselves with hip-hop. I was an expert on that."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3470f7b1-accd-4470-a80c-6d0bc859c2d5",
                        "source_entry_id": "aeed9674-ee33-37fe-868e-20cace912cc1",
                        "source_sense_id": "2c97fe15-abcb-3e6f-8da3-99d6406dd7fa",
                        "target_lang_word": "whigger",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
