                        "cross_references": [
                            {
                                "target_word": "Clermont-Ferrand",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "95cb3972-10c5-30f9-87d4-a939afaeb5f1",
                                        "entry_id": "b4d88f49-e321-33ff-8e3f-15503eb9dff4",
                                        "glosses": [
                                            "französische Stadt, Hauptstadt der Auvergne"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c2ce612-11ab-499c-a29b-8033e66f390f",
                                                "sense_id": "95cb3972-10c5-30f9-87d4-a939afaeb5f1",
                                                "text": "Die Kathedrale Mariä Himmelfahrt, die aus dunklem, porösen Lavagestein erbaut ist, ist eine Sehenswürdigkeit Clermont-Ferrands."
                                            },
                                            {
                                                "example_id": "c8e30dc1-0980-446b-a3d7-972b310379f7",
                                                "sense_id": "95cb3972-10c5-30f9-87d4-a939afaeb5f1",
                                                "text": "Clermont-Ferrand wird überragt vom Puy de Dôme, einem hohen, erloschenen Vulkan des Zentralmassiv."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
