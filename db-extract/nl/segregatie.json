                    {
                        "translation_id": "2ce60472-29a1-468c-81e6-1215a0e1c023",
                        "source_entry_id": "cb1b6c9f-753f-3bba-afbb-e8099ee38b61",
                        "source_sense_id": "ced4e7c5-501e-302b-a1f8-85d1fc88a10e",
                        "target_lang_word": "ségrégation",
