                    {
                        "sense_id": "ed6c325b-21ee-3820-8fec-53163366fa6f",
                        "entry_id": "fd9e5243-e747-36b4-905b-fd5bff66be60",
                        "glosses": [
                            "Alternative form of sie (gender-neutral pronoun)."
                        ],
                        "tags": [
                            "alt-of",
                            "alternative",
                            "rare",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "0b59e5fb-d1a2-4343-aa47-9effe764fc4c",
                                "sense_id": "ed6c325b-21ee-3820-8fec-53163366fa6f",
                                "text": "The mother was Chakat Goldfur and the sire was Garrek Redfox (foxtaur) so she has the same red fur but cougar-like markings. Of course shi’s still only a cub yet, but if shi grows up to look anything like the your Jaguar-Vixen, shi’s going to be a heartbreaker!"
                            },
                            {
                                "example_id": "06b8daea-e072-430f-bef3-9c46aa841b7d",
                                "sense_id": "ed6c325b-21ee-3820-8fec-53163366fa6f",
                                "text": "> Unlike most Furry Hermaphrodites I've seen, Clash is fairly\n> androgynous. Shi is remarkable in hir modesty.\n>\n> But shi IS rather naughty, as you can see."
                            },
                            {
                                "example_id": "fb5a5826-821f-45e9-ac5e-5ecd7816dfaf",
                                "sense_id": "ed6c325b-21ee-3820-8fec-53163366fa6f",
                                "text": "Dropping hir forebody down just a little, shi bent over double at the waist. Andrew's eyes blinked open as whiskers met his cheeks just before feline lips. He purred to hir and reached up to caress hir back as shi kissed him ..."
                            }
                        ]
                    }
