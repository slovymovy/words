                                "target_senses": [
                                    {
                                        "sense_id": "883d2e92-229f-306c-986f-6b7b12ccc563",
                                        "entry_id": "13eb2f48-ffe8-3081-9eb9-ed50413bdbb7",
                                        "glosses": [
                                            "действие по значению гл. обезболивать"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "249dd683-4d02-40b5-a227-defad86ca9fb",
                                                "sense_id": "883d2e92-229f-306c-986f-6b7b12ccc563",
                                                "text": "Ампутация и частичная экстирпация витальной пульпы осуществляются под обезболиванием, а затем применяется девитальный метод с медикаментозным воздействием на остатки корневой пульпы."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fba45d6-d5d4-43b6-a648-ea58fa82f477",
                        "source_entry_id": "02d9ad97-a4bd-3242-b02a-baaceb6cba46",
                        "source_sense_id": "6e078161-a6c4-3eb6-a4d9-5e7df975dc8c",
                        "source_sense_description": "an administration of anesthesia",
                        "target_lang_word": "нарко́з",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "нарко́з",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8ef010ce-b699-3a99-b419-d3e2b16708e9",
                                        "entry_id": "292ab836-e698-363f-98b9-772f5c327731",
                                        "glosses": [
                                            "мед. искусственно вызванная потеря сознания с полной нечувствительностью"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d96934e-2884-4af5-bd5a-536768113529",
                                                "sense_id": "8ef010ce-b699-3a99-b419-d3e2b16708e9",
                                                "text": "Уже открыт был желудочный и панкреатический сок, гликогенная функция печени, эфирный и хлороформный наркоз с их стадиями начального возбуждения ― словом, целый ряд фактов выдвинул новые точки зрения на процессы в различных органах, во всём организме в его целом (процессы обмена) и в нервной системе в частности."
                                            },
                                            {
                                                "example_id": "651ff26e-74e4-4891-8761-d83e07ec9b24",
                                                "sense_id": "8ef010ce-b699-3a99-b419-d3e2b16708e9",
                                                "text": "Наркоз бывает ингаляционным, когда наркотическое вещество вдыхается, и неингаляционным, когда средство для наркоза вводят внутривенно, внутримышечно, ректально и т. д."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6002cfbe-7d6e-33b6-86fe-a7b3b21d7b98",
                                        "entry_id": "292ab836-e698-363f-98b9-772f5c327731",
                                        "glosses": [
                                            "разг. анестезия"
                                        ],
                                        "tags": [
                                            "ошиб."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "594752d2-77f1-42b1-9ad6-225b24c6091d",
                                                "sense_id": "6002cfbe-7d6e-33b6-86fe-a7b3b21d7b98",
                                                "text": "Операция длилась четыре с половиной часа, наркоз был только местный, последние два часа он уже не действовал."
                                            },
                                            {
                                                "example_id": "9d6c03d3-c575-44d1-97ce-d666cd9c73f0",
                                                "sense_id": "6002cfbe-7d6e-33b6-86fe-a7b3b21d7b98",
                                                "text": "Он руки протёр одеколоном, местный наркоз сделал."
                                            },
                                            {
                                                "example_id": "5863c566-b8d3-4321-afc0-f79b6bd64f60",
                                                "sense_id": "6002cfbe-7d6e-33b6-86fe-a7b3b21d7b98",
                                                "text": "Анестезия самая примитивная: местный наркоз, новокаин, двадцать пять минут работы, пузырь льда на замороженный живот ― и следующая…"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
