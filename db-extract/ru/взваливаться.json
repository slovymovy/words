                        "glosses": [
                            "разг. грузно ложиться, садиться на что-либо, взбираться куда-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e765e500-53f3-45ed-9230-740f67278aab",
                                "sense_id": "da2b05cc-463b-38ce-be70-5c38d837b66c",
                                "text": "Будто на мертвеца, наступив на его спину, я взваливаюсь грудью на танк."
                            }
                        ]
                    },
                    {
                        "sense_id": "25a0601e-7fcd-3d69-8e12-bc4dfd7a5562",
                        "entry_id": "553fdf63-fdac-37ec-a9ab-670b2ffeea84",
                        "glosses": [
                            "страд. к взваливать"
                        ],
                        "tags": [
                            "passive"
                        ],
                        "examples": [
                            {
                                "example_id": "c08d1185-bc5a-4e36-856b-d463952bab71",
                                "sense_id": "25a0601e-7fcd-3d69-8e12-bc4dfd7a5562",
                                "text": "Сыгней часто бросал работу на дворе и убегал к чеботарю. Работа тогда взваливалась на Тита и отца."
                            }
                        ]
                    }
