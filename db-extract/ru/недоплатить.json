                    }
                ],
                "senses": [
                    {
                        "sense_id": "2725db60-0bdd-33c3-9ca3-c31815afca06",
                        "entry_id": "149683ce-18cb-3f7f-a04d-14206434e5f1",
                        "glosses": [
                            "неперех. заплатить за что-либо не полностью или меньше, чем следует"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8c8e54ed-4508-4dde-af18-a0b6dd4a93a0",
                                "sense_id": "2725db60-0bdd-33c3-9ca3-c31815afca06",
                                "text": "Этот портной тоже был при Кальмане и квартира его кальмановских времен, и газеты на палках, и старомодная вежливость, вмиг улетучившаяся, когда ему почудилось, будто я недоплатил."
                            }
                        ]
                    },
                    {
                        "sense_id": "79459e43-015e-3d28-823d-26f8eaa4600c",
                        "entry_id": "149683ce-18cb-3f7f-a04d-14206434e5f1",
                        "glosses": [
                            "неперех. платя, недодать, удержать, задолжать определённую сумму"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bb4c1274-42ae-4fce-b7c9-561b4fac64c8",
                                "sense_id": "79459e43-015e-3d28-823d-26f8eaa4600c",
                                "text": "Так что чарующая картина богатства возникла перед глазами Шломо именно тогда, когда ему недоплатили ровно восемьсот шекелей."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c4987d8b-15d6-4a2f-bcb4-fdd65b2af214",
                        "source_entry_id": "149683ce-18cb-3f7f-a04d-14206434e5f1",
                        "target_lang_word": "underpay",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "underpay",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56d20f87-8ac9-3f0d-bd81-1360830b02f8",
                                        "entry_id": "d579f407-3427-3958-9e8e-9e71817bec98",
                                        "glosses": [
                                            "To pay (someone) less than the value of their work; to pay (someone) insufficiently."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79ff3bb4-c95e-4d93-b650-52186252b10b",
                                                "sense_id": "56d20f87-8ac9-3f0d-bd81-1360830b02f8",
                                                "text": "The company-city subgenre always seemed to star a hero who outsmarted, overthrew, or escaped \"the company.\" I've never seen one where the hero fought like hell to get taken in and underpaid by the company."
                                            },
                                            {
                                                "example_id": "6e9d6c26-77ec-447b-a188-4335aa732831",
                                                "sense_id": "56d20f87-8ac9-3f0d-bd81-1360830b02f8",
                                                "text": "In their Position Paper, respondents averred that they were underpaid their daily wage, overtime work pay and 13th month pay."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "91904e87-5871-3aee-b59e-f80d1aabb485",
                                        "entry_id": "d579f407-3427-3958-9e8e-9e71817bec98",
                                        "glosses": [
                                            "To pay less than is due for (something)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7202b3cd-bdfc-4969-94dc-281c7296e52a",
                                                "sense_id": "91904e87-5871-3aee-b59e-f80d1aabb485",
                                                "text": "The underpaid letter was returned to the sender."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
