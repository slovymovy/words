                "senses": [
                    {
                        "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                        "entry_id": "9d670b9e-f065-31c5-8dcb-5831bfbc8b8b",
                        "glosses": [
                            "hohle, hergerichtete Figur, in der ein Bienenvolk lebt und Honig produziert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73f600c2-fd0f-4cb2-9cd5-6cde66c9689d",
                                "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                                "text": "„Die ältesten Figurenbeuten stammen vermutlich aus dem frühen 17. Jahrhundert.“"
                            },
                            {
                                "example_id": "4fd9c062-56e4-47a3-b0e2-c39e76b05a8f",
                                "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                                "text": "„Eine Figurenbeute ist ein ausgehöhlter Baumstamm, der zur Skulptur bearbeitet mit einem Bienenvolk bevölkert wird.“"
                            },
                            {
                                "example_id": "4b9ca0fd-9c97-43a2-b97a-fe06b98de6b8",
                                "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                                "text": "„Im 18. Jahrhundert wurden diese Bäume in einigen Regionen beschnitzt, die Figurenbeute war geboren.“"
                            },
                            {
                                "example_id": "7ef6247a-6877-4435-af21-8a4d459f37e7",
                                "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                                "text": "„Figurenbeuten haben eine lange Tradition und sind in der imkerlichen Volkskunst verankert.“"
                            },
                            {
                                "example_id": "a8030531-90fb-4d82-8a82-f57d912ff2c3",
                                "sense_id": "b6fd6cc3-7e80-3001-aea6-24d583b50624",
                                "text": "„Geschnitzte Figurenbeuten zählen zu den weniger bekannten, dafür aber um so markanteren Werken der bäuerlichen Volkskunst des 18. und 19.Jahrhunderts.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
