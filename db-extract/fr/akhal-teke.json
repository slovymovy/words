                        "entry_id": "7fe5c83d-610f-35aa-83b0-480f707cb7e6",
                        "glosses": [
                            "Race de cheval de sport très ancienne et très pure, originaire d’Asie centrale et traditionnellement élevée par la tribu des Tekes au Turkménistan, adaptée aux courses d’endurance dans les steppes du désert : endurance, concours complet d’équitation, dressage."
                        ],
                        "tags": [
                            "Hippologie"
                        ],
                        "examples": [
                            {
                                "example_id": "491080a1-714f-4c18-8500-deb06f702cbc",
                                "sense_id": "fb30069c-34b0-34b0-b0ff-549801378773",
                                "text": "La taille au garrot de l’akhal-teke est de 1,44 à 1,70 m (1,52 à 1,60 m en moyenne)."
                            },
                            {
                                "example_id": "3ce038ef-3f8a-4fbb-a8ee-4754e014bc3a",
                                "sense_id": "fb30069c-34b0-34b0-b0ff-549801378773",
                                "text": "Le cheval pur-sang arabe dériverait de l’akhal-teke."
                            }
                        ]
                    }
