                "senses": [
                    {
                        "sense_id": "e6e71dbe-9cb9-3c9c-934b-c89889fd6b2d",
                        "entry_id": "6c9faa60-5124-319f-b9a2-9ad41a33c76c",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus, das für regelmäßige Gottesdienste einer Gemeinde bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c4aa688b-b5d3-3685-acfd-c895c956719d",
                        "entry_id": "6c9faa60-5124-319f-b9a2-9ad41a33c76c",
                        "glosses": [
                            "die in einer Stadt, zur musikalischen Unterhaltung spielende Musikkapelle"
                        ],
                        "tags": [
                            "Musik"
                        ],
                        "examples": [
                            {
                                "example_id": "bf1d00f3-3ed3-4a68-a97d-824b2b9d23fd",
                                "sense_id": "c4aa688b-b5d3-3685-acfd-c895c956719d",
                                "text": "„Die Stadtkapelle Köln steht in der Tradition der professionell orientierten Musikkapellen, welche es in Köln und im Rheinland seit fast 100 Jahren gibt.“"
                            },
                            {
                                "example_id": "f0d6bd7d-47ef-45fb-b1bf-02b0c04e088d",
                                "sense_id": "c4aa688b-b5d3-3685-acfd-c895c956719d",
                                "text": "„Stadtkapelle Tettnang wurde 1809 gegründet und hat 59 aktive Mitglieder.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b1f2514-238c-4312-b852-60fb96e646a9",
                        "source_entry_id": "6c9faa60-5124-319f-b9a2-9ad41a33c76c",
                        "source_sense_id": "e6e71dbe-9cb9-3c9c-934b-c89889fd6b2d",
                        "target_lang_word": "chapelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "chapelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "cc269a30-fe2b-3e8e-9445-28e983becd89",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Petit édifice religieux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f7481dde-919a-4af7-b0ab-66702d747519",
                                                "sense_id": "cc269a30-fe2b-3e8e-9445-28e983becd89",
                                                "text": "Une chapelle qui est au milieu des champs. Les chapelles sépulcrales d’un cimetière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b594b24-61a5-35ff-9b20-97fd15c522e6",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Chacune des enceintes ménagées dans une église pour y enfermer un autel sous l’invocation particulière d’un saint."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "81147b5e-fba4-4be1-a5d0-3584ac99b595",
                                                "sense_id": "9b594b24-61a5-35ff-9b20-97fd15c522e6",
                                                "text": "Cette église se compose d’une nef […], et d’un transept avec abside et chapelles, datant du commencement du XIVᵉ siècle."
                                            },
                                            {
                                                "example_id": "570e9cbb-5297-4cba-bc13-8f463c817d49",
                                                "sense_id": "9b594b24-61a5-35ff-9b20-97fd15c522e6",
                                                "text": "La chapelle des fonts ou baptistère, […], est une des parties les plus remarquables de la basilique ; ce fut là, pendant des siècles, le vrai sanctuaire lorrain."
                                            },
                                            {
                                                "example_id": "c695e54c-4a86-439b-aac1-362bac487840",
                                                "sense_id": "9b594b24-61a5-35ff-9b20-97fd15c522e6",
                                                "text": "Les colonnes qui supportent les voûtes de la chapelle de la Vierge sont d'une légèreté telle que pour un peu on crierait au miracle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c4463462-4523-3d77-88df-192b8b3ac93a",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Église dépendant d’une paroisse."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "44b16fe3-35df-3b83-9b56-a85ca08348e2",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Lieu où l’on célèbre l’office religieux, dans un domaine privé, dans un hospice, dans un collège, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "864d5890-bda3-495d-b117-8f1e0121b988",
                                                "sense_id": "44b16fe3-35df-3b83-9b56-a85ca08348e2",
                                                "text": "La chapelle du roi, lieu où le roi entendait ordinairement la messe."
                                            },
                                            {
                                                "example_id": "3ba747bc-8a31-48d2-a222-20240e2d0f3f",
                                                "sense_id": "44b16fe3-35df-3b83-9b56-a85ca08348e2",
                                                "text": "Plusieurs services traditionnels ont été construits comme la chapelle et le bar, même si malheureusement, en 2021, on ne pourra pas se marier ici ni commander un verre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f6681630-5469-3448-b7b5-c3ad57b68e03",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Corps des ecclésiastiques attachés à la chapelle du roi."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b559b61a-3a82-3397-88c8-9748cccddb82",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Ensemble des musiciens d’une église."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd09dcc5-ec48-4792-92b6-110bdc45972e",
                                                "sense_id": "b559b61a-3a82-3397-88c8-9748cccddb82",
                                                "text": "La chapelle pontificale. Il faisait partie de la chapelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5347b357-a44b-39bf-81b8-2caa704abd01",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Toute l’argenterie dont on se sert, trésor d’une église privée, royale ou princière."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "612f63d0-c831-47a7-8b63-99a61bf4b063",
                                                "sense_id": "5347b357-a44b-39bf-81b8-2caa704abd01",
                                                "text": "Ce prélat a une belle et riche chapelle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "88e8b5a8-8bf0-3509-8772-8003c0172ecb",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Coterie littéraire ou autre groupe d’intérêt."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7707ee50-7080-439b-9171-d04ffe722f2e",
                                                "sense_id": "88e8b5a8-8bf0-3509-8772-8003c0172ecb",
                                                "text": "Elle a été conduite ainsi à rompre avec les anciennes chapelles officielles, utopistes et politiciennes, qui ont horreur de la grève générale, et à entrer, au contraire, dans le mouvement propre du prolétariat révolutionnaire."
                                            },
                                            {
                                                "example_id": "3e35e1d1-826f-4869-96f7-c2788dd4c5ba",
                                                "sense_id": "88e8b5a8-8bf0-3509-8772-8003c0172ecb",
                                                "text": "Le rejet du radical permet à Bourdieu de poser la question du photographiable et du non-photographiable au sein de valeurs établies, de normes en vigueur, de chapelles artistiques."
                                            },
                                            {
                                                "example_id": "960dbc36-d411-44e8-adf9-603d7700d334",
                                                "sense_id": "88e8b5a8-8bf0-3509-8772-8003c0172ecb",
                                                "text": "À rebrousse-poil des sentiers battus, Onfray s’attire naturellement la haine des béni-oui-oui de toutes les chapelles."
                                            },
                                            {
                                                "example_id": "6922fb56-b9a4-4a07-aa1b-771b2bcdd219",
                                                "sense_id": "88e8b5a8-8bf0-3509-8772-8003c0172ecb",
                                                "text": "Les médias, comme les politiques, souffrent d’une crise de légitimité, on le sait, mais aussi d’une crise du statut de la vérité. Les intellectuels ont explosé en chapelles concurrentes, incapables de rassembler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7263e74-3b7f-31ac-8cad-77e1eef7a5bb",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Serre rattachée par un groupe de serre."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c6433df3-93b1-3d4b-a2a5-93874c7dc14f",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Cavité ménagée dans une pièce à boulonner perpendiculairement à une autre, pour pouvoir placer le boulon ou visser son écrou."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "4f6d0dae-05f3-3c2b-a46e-20a95b3312d6",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Meuble représentant l’édifice du même nom dans les armoiries. Elle se distingue de l’église par ses dimensions plus modestes. Quand l’orientation (front, profil…) n’est pas définie, on la représente de front. À rapprocher de église et temple."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9c90b983-4aba-44da-850d-0c593507d123",
                                                "sense_id": "4f6d0dae-05f3-3c2b-a46e-20a95b3312d6",
                                                "text": "De gueules à une chapelle d’argent ouverte et ajourée de sable, posée sur une terrasse ployée d’or, chargée d’un sentier de sable ; accompagnée en chef de deux écussons : à dextre d’argent à la croix de gueules, à senestre de sable à une bordure d’or, qui est de la commune de La Chapelle-Iger de Seine-et-Marne → voir illustration « armoiries avec une chapelle »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8bb96638-2386-36c2-8b3c-1072908c8c3c",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Coffret électrique de chantier."
                                        ],
                                        "tags": [
                                            "Belgique"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d27cea13-cb23-3ba2-b028-10a6212d73d1",
                                        "entry_id": "82e015cf-a8b3-322b-9d32-2e004bbc4c37",
                                        "glosses": [
                                            "Hotte aspirante de laboratoire chimique, sorbonne."
                                        ],
                                        "tags": [
                                            "Suisse"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "853e37d8-8d78-4c45-8897-29d9488cc1d9",
                                                "sense_id": "d27cea13-cb23-3ba2-b028-10a6212d73d1",
                                                "text": "Les chapelles sont à disposition pour votre sécurité et votre santé, ainsi que celles de vos collègues. Pour une meilleure aspiration : abaissez la vitre, fermez les chapelles qui ne sont pas utilisées."
                                            }
                                        ]
                                    }
                                ]
                            },
