                "senses": [
                    {
                        "sense_id": "4def009e-4135-396a-bfd7-15023a12075e",
                        "entry_id": "a707b96b-4875-3d6a-b24e-392c777ee199",
                        "glosses": [
                            "Qui a rapport à l’hippophagie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "82fa18cf-93a8-4f31-b3d0-70540bb277d1",
                                "sense_id": "4def009e-4135-396a-bfd7-15023a12075e",
                                "text": "Marthe revint à la charge pour qu’on accepte l’enseigne « boucherie chevaline » plutôt qu’« hippophagique », terme savant utilisé pour masquer la réalité aux âmes sensibles."
                            },
                            {
                                "example_id": "4d049f53-141c-4234-b764-23f169114bd2",
                                "sense_id": "4def009e-4135-396a-bfd7-15023a12075e",
                                "text": "L’autre foyer de contradiction, et non le moindre, tient à l’aventure hippophagique. Elle est l’affaire de ces mêmes savants humanistes, au premier rang desquels le naturaliste I. Geoffroy Saint-Hilaire, qui s’en fait l’apôtre, depuis sa tribune de cours populaires au muséum."
                            }
                        ]
                    }
