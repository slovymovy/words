                "senses": [
                    {
                        "sense_id": "cd895f05-d1f9-3c74-9f25-f7e09fdff237",
                        "entry_id": "77b37c47-ff25-3048-88ff-3d1434744de2",
                        "glosses": [
                            "diejenige Menge/Auswahl von Dingen, die am Anfang zur Verfügung steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d12c8622-be3f-4e62-a052-0ab8068d6166",
                                "sense_id": "cd895f05-d1f9-3c74-9f25-f7e09fdff237",
                                "text": "„Die vielen historisch wertvollen Gegenstände aus dem Alltagsleben der Dorfbewohner und Fischer, die man beim Abriss eines alten Hauses fand, bildeten den Grundstock des 1963 eröffneten Heimatmuseums.“"
                            },
                            {
                                "example_id": "d709b99f-c155-4aea-b00e-6dbcad0f1ca9",
                                "sense_id": "cd895f05-d1f9-3c74-9f25-f7e09fdff237",
                                "text": "„Aber für eine auf Friedensstärke von rund 500 000 Mann reduzierte Armee lieferten die im Krieg rekrutierten indischen Offiziere einen guten Grundstock.“"
                            },
                            {
                                "example_id": "ede0e448-a653-43f9-a2fb-d6f07bb6c341",
                                "sense_id": "cd895f05-d1f9-3c74-9f25-f7e09fdff237",
                                "text": "„Seine Balladen sind seit Anfang des Jahrhunderts Grundstock bürgerlicher Bibliotheken, seine Liedertexte erklingen an Lagerfeuern der Wandervögel und Pfadfinder, kein lebender Dichter, brüstet er sich (nicht einmal zu Unrecht), sei häufiger vertont worden als er.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
