                        "source_sense_id": "a290007a-8a8c-30b2-917a-f5d8beee11c2",
                        "target_lang_word": "Wi-Fi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "87d3aca4-7c28-3678-bacd-955f81a1e7e3",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "Any of several standards for short-range wireless data transmission (IEEE 802.11)."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "Wireless networking using one of these standards."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e838584-707c-45f3-a120-eb803f6320bd",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "Mimi gave Fifi access to her Wi-Fi."
                                            },
                                            {
                                                "example_id": "6e157132-62dc-45fd-a5f7-1d14f99fe341",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "He couldn't connect to the Wi-Fi in this area."
                                            },
                                            {
                                                "example_id": "f48f2c2d-fd03-4a29-bc2d-a028139498ee",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "This coffee shop has Wi-Fi for its customers."
                                            },
                                            {
                                                "example_id": "18b0837d-a0c1-45bd-8f7b-75b5633ac1ff",
                                                "sense_id": "6f1b6b37-b352-3a77-ae5e-7a12daf40047",
                                                "text": "He asked me if I knew the Wi-Fi password."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6fdf7698-a097-3920-9b7b-3ca5520e3d65",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "The capability to connect to a Wi-Fi network."
                                        ],
                                        "tags": [
                                            "informal",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0679164f-4486-4a2a-b5e8-cd5440876a3d",
                                                "sense_id": "6fdf7698-a097-3920-9b7b-3ca5520e3d65",
                                                "text": "The refrigerator cost 1000 more dollars just because it had Wi-Fi, and I'm thinking \"this is ridiculous\"!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97bd8a43-b8c5-3010-bb03-7f8cdbe7a331",
                                        "entry_id": "9d3eef6f-2380-305f-bc0a-5487f65570db",
                                        "glosses": [
                                            "A Wi-Fi network."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "Wi-Fi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                        "entry_id": "1c6439e9-55e2-319f-a0b8-9fc7791d470a",
                                        "glosses": [
                                            "To equip with Wi-Fi; to Wi-Fi enable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2ccd02bc-ea90-4c49-a247-c3a0fb765f88",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "What type of electronics will be immune from being Wi-Fied?"
                                            },
                                            {
                                                "example_id": "b220397b-4614-4fc1-90ae-10d2098697ce",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "The biggest market may be Wi-Fi-ing people's homes."
                                            },
                                            {
                                                "example_id": "f87197ab-6d7b-4b3f-b91b-fa0d29fe5fd0",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "To Wi-Fi or Not to Wi-Fi?"
                                            },
                                            {
                                                "example_id": "b6b88d1a-6d38-4dba-a28f-694724013134",
                                                "sense_id": "1979dd4d-0e13-3794-a123-61a214f22d05",
                                                "text": "There was no point in being off the grid if the vehicle you drove was Wi-Fied to it with every turn of the wheels."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                        "entry_id": "1c6439e9-55e2-319f-a0b8-9fc7791d470a",
                                        "glosses": [
                                            "To connect to the internet using Wi-Fi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2065b6fd-12f9-4e1f-aedd-05b91e7c78b4",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "The hotel manager even claims he's seen Red Sox problem child Manny Ramirez Wi-Fi-ing in the lobby on his Palm."
                                            },
                                            {
                                                "example_id": "1587aa11-3c24-45a3-a02c-5deb0d54ec84",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "Perhaps someone sees you typing in confidential information while you are \"Wi-Fi-ing\" in a hotel lobby or a crowded airport waiting area."
                                            },
                                            {
                                                "example_id": "4e61c59e-d810-4488-8930-9ca766050175",
                                                "sense_id": "597cfe1a-05dd-3c3e-b94f-d15b31d82c18",
                                                "text": "If Addison and Steele were alive and holding court at Starbucks, they'd be Wi-Fi-ing into a joint blog."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "df26bc89-102a-4358-9c5a-6b930cc48274",
                        "source_entry_id": "cce9aaa6-078b-3621-aa3b-73636d343ba5",
