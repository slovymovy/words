                            {
                                "example_id": "d2dceb85-9017-4b73-82fd-c60f62355c91",
                                "sense_id": "cc947274-5e26-369c-8f83-9e8c3dd48c3d",
                                "text": "Il embrasse l’une, baise l'autre, cajole une câlineuse, regarde le sourire d’une troisième, court derrière une quatrième."
                            },
                            {
                                "example_id": "1d7b8b2f-657d-4780-b818-3915fdbec9b0",
                                "sense_id": "cc947274-5e26-369c-8f83-9e8c3dd48c3d",
                                "text": "Je ne suis pas une câlineuse, une championne de bisous, etc. Ce n'est pas mon rayon. Moi c’est le genre Milady, petit doigt levé et hautaine !"
                            }
                        ]
