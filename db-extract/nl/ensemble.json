                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f7da6df-20ec-4b3b-a4f6-87cef547f7e5",
                                                "sense_id": "958bbec5-295f-3f54-841f-a258fc3089fc",
                                                "text": "„Das futuristische Ensemble aus schöner Frau und kraftvollem Wagen erinnert stark an den Stil der angesagten Manga-Comics.“"
