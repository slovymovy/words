                    {
                        "sense_id": "fd99a393-05bd-3f02-949e-1d7474c356b6",
                        "entry_id": "9e77b125-51e6-3957-af05-f3a64d21f565",
                        "glosses": [
                            "A decrease in industrial activity or capacity."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "a79704d2-3b58-4691-90f8-e4a89f1af199",
                                "sense_id": "fd99a393-05bd-3f02-949e-1d7474c356b6",
                                "text": "The U.K. is now an object lesson for other countries dealing with a dark triad of deindustrialization, degrowth, and denigration of foreigners."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd627811-5c22-4583-8f74-28b925659cf8",
                        "source_entry_id": "9e77b125-51e6-3957-af05-f3a64d21f565",
                        "source_sense_id": "fd99a393-05bd-3f02-949e-1d7474c356b6",
                        "source_sense_description": "Translations",
                        "target_lang_word": "désindustrialisation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désindustrialisation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0666694e-a04c-3ba8-bdaf-49a325c0a0cc",
                                        "entry_id": "6e5ca783-7618-3aef-8fac-9629ed9ce471",
                                        "glosses": [
                                            "Processus de disparition progressive des activités industrielles dans un pays, une région ou une ville, souvent lié à la tertiarisation, aux délocalisations ou à la perte de compétitivité du secteur manufacturier."
                                        ],
                                        "tags": [
                                            "Économie",
                                            "Histoire économique",
                                            "Sociologie économique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eaf5f535-a452-45ca-b4f6-50aaa80c6ce5",
                                                "sense_id": "0666694e-a04c-3ba8-bdaf-49a325c0a0cc",
                                                "text": "Par désindustrialisation, on entend généralement un ensemble de facteurs affectant la place du secteur manufacturier dans l’économie et la compétitivité de ce secteur sur les marchés nationaux et internationaux."
                                            },
                                            {
                                                "example_id": "09eea9a9-cad8-4be4-8cb4-2e229ba78e89",
                                                "sense_id": "0666694e-a04c-3ba8-bdaf-49a325c0a0cc",
                                                "text": "Il est aberrant que le Canada ait laissé son industrie de fabrication pharmaceutique dépendre à ce point de l’étranger. Trudeau n’est pas le seul responsable de ces politiques de désindustrialisation."
                                            },
                                            {
                                                "example_id": "0780fbce-d64e-4cdc-9ef9-c6fff8484487",
                                                "sense_id": "0666694e-a04c-3ba8-bdaf-49a325c0a0cc",
                                                "text": "Certes, en trente ans, le nombre d’accidents mortels au travail a été réduit de moitié. Mais c’est moins en raison d’entreprises plus vertueuses que d’une désindustrialisation et d’une externalisation des tâches les plus mortifères."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f297c27a-4001-41a5-a804-643ff363f334",
