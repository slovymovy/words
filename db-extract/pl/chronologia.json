                                    {
                                        "sense_id": "2993a5a4-d784-3086-96ef-89eb6ef0291e",
                                        "entry_id": "9da85bdd-a36f-3483-8a62-9b41fa51a070",
                                        "glosses": [
                                            "The science of determining the order in which events occurred."
                                        ],
                                        "tags": [
