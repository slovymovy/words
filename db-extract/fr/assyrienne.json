                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e2ef047-72e3-4918-ac1a-c8e7d42e3e9e",
                                                "sense_id": "24dd7aa0-f042-3de2-ba86-86b3130a841d",
                                                "text": "There is a languor in the air which encourages your own, and the poetry of memory is in every drooping flower and falling leaf. The very magnificence of its Assyrian array is touched with the light of imagination: even while you watch it, it passes away as your brightest hopes have done before."
                                            }
