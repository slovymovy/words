                                "target_senses": [
                                    {
                                        "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                        "entry_id": "afa066ac-c6ab-35c6-bed6-3d4bbc415fa2",
                                        "glosses": [
                                            "der im Kopf gelegene Teil des Zentralnervensystems der Wirbeltiere"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1ae4420e-4163-4e43-8660-2108b24b396a",
                                                "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                                "text": "Das Gehirn selbst ist schmerzunempfindlich."
                                            },
                                            {
                                                "example_id": "344a6037-10d3-4fcf-a23d-2beb90d67778",
                                                "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                                "text": "Übermäßiger Drogenkonsum zerstört die Zellen im Gehirn."
                                            },
                                            {
                                                "example_id": "4eeedefd-cafb-4d46-86f7-0391dded74fd",
                                                "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                                "text": "„Daß es ihm schon vor zwanzig Jahren gelungen war, aus animalischen Zellen unter dem Einfluß des magnetischen Feldes und durch mechanische Rotation vollständig ausgebildete Gehirne auf Glasplatten wachsen zu lassen, -- Gehirne, die, nach allem zu schließen, sogar selbständig zu denken vermochten, -- hatte zwar hie und da in Zeitungen gestanden, -- wissenschaftliches, tieferes Interesse aber hatte es nicht geweckt.“"
                                            },
                                            {
                                                "example_id": "e6a89d49-85f6-4535-925d-6c08d3df103b",
                                                "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                                "text": "„Das Gehirn allerdings arbeitete noch gut, noch relativ gut.“"
                                            },
                                            {
                                                "example_id": "2c895978-14c1-4f84-8502-0f5fefd74152",
                                                "sense_id": "1fbefcc9-5da2-3a23-bf76-6db74c330997",
                                                "text": "Mancherorts steht das Gehirn des Kalbes auf der Speisekarte, in Butter geschwenkt und mit einem leichten Blattsalat als Beilage."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "dd7842f1-4360-37a9-a9a4-563b7564523b",
                                        "entry_id": "afa066ac-c6ab-35c6-bed6-3d4bbc415fa2",
                                        "glosses": [
                                            "der Ansatz zur Bildung von Nervenzentren"
                                        ],
                                        "tags": [
                                            "vergleichende Anatomie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6f118bef-579c-40e7-ae16-874b26db883f",
                                                "sense_id": "dd7842f1-4360-37a9-a9a4-563b7564523b",
                                                "text": "Sobald die Nervenzentren komplexer werden, wie bei den höherentwickelten Insekten, sprechen wir von Gehirnen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c8b6e01d-af50-3429-808d-9041e9375702",
                                        "entry_id": "afa066ac-c6ab-35c6-bed6-3d4bbc415fa2",
                                        "glosses": [
                                            "Verstand, Denkvermögen"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19303c18-5703-4cde-9b44-40c5e23826d2",
                                                "sense_id": "c8b6e01d-af50-3429-808d-9041e9375702",
                                                "text": "Sie zermarterte sich das Gehirn, konnte aber partout nicht auf Rolfs Nachnamen kommen."
                                            },
                                            {
                                                "example_id": "4e3c0307-a92c-4448-9f6e-06d124baf3cf",
                                                "sense_id": "c8b6e01d-af50-3429-808d-9041e9375702",
                                                "text": "Haben sie dir das Gehirn amputiert? Du kannst doch keine Plastiktüten in den offenen Kamin schmeißen!"
                                            },
                                            {
                                                "example_id": "8acccfc1-281c-4235-8fa4-1575a9b88ae6",
                                                "sense_id": "c8b6e01d-af50-3429-808d-9041e9375702",
                                                "text": "„Ehe Krist aber die Giebeltür noch erreicht und von außen her zugeschlossen haben konnte, legte sichs schon schwer und bleiern auf seines Herrn überreiztes Gehirn.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
