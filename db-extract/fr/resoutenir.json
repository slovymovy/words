                "senses": [
                    {
                        "sense_id": "a0768d3f-74bc-3203-89dc-881713c05dca",
                        "entry_id": "d2f88150-c0c2-3b6e-bf63-245c02d258dd",
                        "glosses": [
                            "Soutenir à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63242b92-3d65-4c2b-840d-8c3d88d9d0e6",
                                "sense_id": "a0768d3f-74bc-3203-89dc-881713c05dca",
                                "text": "En général et à quelques exceptions près, il s'agit de resoutenir un doctorat de 3e cycle."
                            },
                            {
                                "example_id": "3f2e1611-eb3c-4711-9261-93089cb6e01a",
                                "sense_id": "a0768d3f-74bc-3203-89dc-881713c05dca",
                                "text": "Demain, y'a encore de la natation, alors je vais resoutenir mon Thorpe qui affrontera Popov et Peter Van den Hoogenband."
                            },
                            {
                                "example_id": "38bd164d-a182-4a97-98d9-8a511234fa9f",
                                "sense_id": "a0768d3f-74bc-3203-89dc-881713c05dca",
                                "text": "Rien que pour le plaisir de te consoler d'abord, puis de te soutenir, puis de te reconsoler, puis de te resoutenir....."
                            }
                        ]
                    }
