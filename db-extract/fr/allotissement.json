        "fr-extract.jsonl": [
            {
                "entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                "word": "allotissement",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec917e2f-8d11-47d3-9604-44ad7843f8f7",
                        "entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "tags": [
                            "plural"
                        ],
                        "form": "allotissements"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "42a1ab32-f275-377e-9e12-9a88fbf4af52",
                        "entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "glosses": [
                            "Opération qui consiste à entreposer des marchandises, par exemple à leur arrivée sur un aéroport, dans un ordre qui facilite leur reconnaissance par leur propriétaire et leur enlèvement une fois faites les formalités douanières."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "31a151ba-da4f-3970-8226-98dbb7eaf23c",
                        "entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "glosses": [
                            "Fait de diviser un marché en plusieurs lots."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fceccd69-9f26-43f8-914e-a9fd932d0360",
                                "sense_id": "31a151ba-da4f-3970-8226-98dbb7eaf23c",
                                "text": "Selon les syndicats, le Sytral étudierait de répartir les modes de transports selon plusieurs lots (par exemple un lot \"métro\", un lot \"bus\" etc..) ce qui pourrait amener l'arrivée de plusieurs opérateurs. Une grève est prévue le mercredi 9 février contre ce projet d’allotissement."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "05e55909-8bba-464b-86d3-b5395b750bed",
                        "source_entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "target_lang_word": "Zuteilung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Zuteilung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "38a10a32-3862-31a8-93be-d161d45fc20e",
                                        "entry_id": "0e75d89e-8c19-3402-b236-48097fd33744",
                                        "glosses": [
                                            "Vorgang des Zuteilens, Aufteilens, Verteilens, Anweisens"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b75754c3-b4e2-44e1-8e9d-57607ec4fec4",
                                                "sense_id": "38a10a32-3862-31a8-93be-d161d45fc20e",
                                                "text": "Bei der Zuteilung der Lebensmittel wurde betrogen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                        "entry_id": "0e75d89e-8c19-3402-b236-48097fd33744",
                                        "glosses": [
                                            "das Zugeteilte, die Ration"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "011f13a5-a5c4-4e64-82a8-8ed3f3de2567",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "Die Zuteilung umfasste 100 Gramm Brot."
                                            },
                                            {
                                                "example_id": "26e890ff-5b65-4b10-ac80-54958a5aa033",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "„Da die Lebensmittelkarten von den Kommunen den jeweiligen Lieferungen entsprechend ausgegeben wurden, unterschieden sich die offiziellen Zuteilungen von Ort zu Ort.“"
                                            },
                                            {
                                                "example_id": "08f3550a-8662-477c-be05-d9eabd667115",
                                                "sense_id": "40f65210-4cf1-3935-a787-0e9b912627d5",
                                                "text": "„Die Reichsmark, die den Arbeitern und Angestellten ausbezahlt wurde, spielte demgegenüber keine Rolle, mit ihr konnte man nur noch die amtlichen Zuteilungen auf Lebensmittelkarte und Kleiderkarte bezahlen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b4aa4ad4-d97e-4933-b696-c966763bc80d",
                        "source_entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "target_lang_word": "allotment",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allotment",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e8b16bac-b8f9-3c64-a3cd-4575ebbdeb50",
                                        "entry_id": "f2274eff-695a-39de-9ae8-8832446d3913",
                                        "glosses": [
                                            "The act of allotting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8288cb49-42eb-410a-8b6e-21a93f78d8a3",
                                                "sense_id": "e8b16bac-b8f9-3c64-a3cd-4575ebbdeb50",
                                                "text": "You will achieve more in designated sessions of quiet uninterrupted periods than in a longer allotment of time broken up by various activities."
                                            },
                                            {
                                                "example_id": "28f6f4b1-d0d1-4bbf-8d3a-997746c67388",
                                                "sense_id": "e8b16bac-b8f9-3c64-a3cd-4575ebbdeb50",
                                                "text": "The allotment of particular names to special ideas which gradually disengage themselves from a general idea is apparently determined by accident."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b6baab4c-53f1-3f51-b224-9b1478f1ef14",
                                        "entry_id": "f2274eff-695a-39de-9ae8-8832446d3913",
                                        "glosses": [
                                            "Something allotted; a share, part, or portion granted or distributed"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da430c0c-7927-4c0d-a83e-1bec591c81d6",
                                                "sense_id": "b6baab4c-53f1-3f51-b224-9b1478f1ef14",
                                                "text": "The history attached to it could not but recur to Emily as she passed, and her heart sank within her—not with fear, but at the thought, how much of misery there was in the world; and why should she be spared amid such general allotment?"
                                            },
                                            {
                                                "example_id": "f5c14dc1-ce0d-4e8b-949e-483cf0fac52d",
                                                "sense_id": "b6baab4c-53f1-3f51-b224-9b1478f1ef14",
                                                "text": "Similar customs prevailed in a part of Friesland, the most notable of which was the ‘Jus Theelacticum,’ or custom of the Theel lands, doles, or allottable lands in East Friesland, not far from the mouth of the Ems. There an inherited allotment was indivisible; on the death of the father it passed intact to the youngest son, and on his death without issue it fell into the possession of the whole community"
                                            },
                                            {
                                                "example_id": "efb3425e-7140-4b44-9da7-d4f547c74499",
                                                "sense_id": "b6baab4c-53f1-3f51-b224-9b1478f1ef14",
                                                "text": "Though most interviews are aired in ten-minute segments, very often they are longer than that specific time allotment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "992db9bf-e9fa-3e8b-be33-a245683ac27b",
                                        "entry_id": "f2274eff-695a-39de-9ae8-8832446d3913",
                                        "glosses": [
                                            "The allowance of a specific amount of money or other credit of a particular thing to a particular person."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05f940fe-66a4-4ca0-b383-fe01fe9120b7",
                                                "sense_id": "992db9bf-e9fa-3e8b-be33-a245683ac27b",
                                                "text": "Maynard used to help before he got sick, but there was no income except what I brought in my allotment."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00a169a5-28b1-3be8-a4a3-650a4f4c4488",
                                        "entry_id": "f2274eff-695a-39de-9ae8-8832446d3913",
                                        "glosses": [
                                            "A plot of land rented from the council for growing fruit and vegetables."
                                        ],
                                        "tags": [
                                            "British",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99cfc910-09c6-49d7-9e14-65fed0cf6328",
                                                "sense_id": "00a169a5-28b1-3be8-a4a3-650a4f4c4488",
                                                "text": "The fallout of this unexpected turn of events was that it was Saturday morning, the first day of the Easter holidays, before the thought of my allotment even entered my head. Goodness only knew how big my carrots were going to be by the time I got round there!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3da12e74-91e3-4dd8-804e-38237f22aaa6",
                        "source_entry_id": "1cee6f34-4db5-3b29-8d73-404502b7aa8a",
                        "target_lang_word": "opdeling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "opdeling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d2ff1d96-ad16-3ab2-ab3e-866fb54882fd",
                                        "entry_id": "473efb6f-6db7-3901-a195-d3722d0d1725",
                                        "glosses": [
                                            "verdeling van een geheel in afzonderlijke stukken"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59081322-de80-401a-a907-5976e0927227",
                                                "sense_id": "d2ff1d96-ad16-3ab2-ab3e-866fb54882fd",
                                                "text": "Zo'n splitsing is er nooit van gekomen, maar dat wil niet zeggen dat de gedachte van een opdeling volstrekt idioot is, zegt bestuurskundige Jan Schrijver."
                                            },
                                            {
                                                "example_id": "b660dbc4-4a7b-477f-8a4d-e16cb4480482",
                                                "sense_id": "d2ff1d96-ad16-3ab2-ab3e-866fb54882fd",
                                                "text": "De belangrijkste aanpassing is de opdeling van de supermarkt in twee schillen: de binnenste schil is een 'to go', een supermarkt zoals je die ook wel op stations vindt, de buitenste schil wordt een normale supermarkt met min of meer hetzelfde assortiment als de supermarkt hier al had. Het is het tweede filiaal waar dit gebeurt; op Schiphol bestaat het concept al."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "38dcd7e3-2150-4e25-9d2f-dbeb752f7dc5",
