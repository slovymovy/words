                "senses": [
                    {
                        "sense_id": "01219355-bf7e-38c3-bf73-a8ff4a0ab6f2",
                        "entry_id": "1cccc91b-f5c9-3294-a62d-d3abbe9c3007",
                        "glosses": [
                            "to depart, especially to depart quickly"
                        ],
                        "tags": [
                            "Canada",
                            "US",
                            "informal",
                            "intransitive"
                        ],
                        "examples": [
                            {
                                "example_id": "8475fc52-6c44-4d0d-b484-f7ff98f355f2",
                                "sense_id": "01219355-bf7e-38c3-bf73-a8ff4a0ab6f2",
                                "text": "There goes the supper gong! Annie, you and Mary had better skidoo out of this room or you'll get so many demerits you won't be out of bounds to go home in June."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e6f0e5e-505d-3126-9a28-db0994fec477",
                        "entry_id": "1cccc91b-f5c9-3294-a62d-d3abbe9c3007",
                        "glosses": [
                            "a nonsense word, often an expression of disrespect"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e9399ca3-4a9e-49a6-bbbb-ed11e8a3ad94",
                                "sense_id": "1e6f0e5e-505d-3126-9a28-db0994fec477",
                                "text": "Then skidoo, little girl, skidoo. / 23 is the number for you."
                            },
                            {
                                "example_id": "2ef31d84-fca4-46b9-8e0c-cd4c4038e461",
                                "sense_id": "1e6f0e5e-505d-3126-9a28-db0994fec477",
                                "text": "“Twenty-three skidoo!” was an all-embracing, meaningless, smart-alecky comment of the day, something in essence like one of its grandchildren, “So's your old man!”"
                            }
                        ]
                    }
                ],
