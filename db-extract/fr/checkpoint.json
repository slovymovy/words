        "fr-extract.jsonl": [
            {
                "entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                "word": "checkpoint",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "763a8bf2-8b35-4556-aa48-04bb983b8f43",
                        "entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "tags": [
                            "plural"
                        ],
                        "form": "checkpoints"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "367281a9-068a-3e8a-b442-824f7a8f6b06",
                        "entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "glosses": [
                            "Barrage routier tenu par des milices ou des militaires dans des zones de conflits armés. Le dispositif est souvent constitué de chevaux de frise ou d'obstacles lourds disposés en quinconce pour faire ralentir les véhicules s'y présentant et interdire tout passage en force."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "339288a0-f55a-49b3-b4fe-5c4ad830832a",
                                "sense_id": "367281a9-068a-3e8a-b442-824f7a8f6b06",
                                "text": "Cahin-caha, après avoir déposé tous ses passagers palestiniens et franchi encore quelques passages difficiles sur une route semée de chicanes, de ralentisseurs et de nids-de-poule, le taxi atteint notre troisième checkpoint, Zatara."
                            },
                            {
                                "example_id": "18c291c7-49b3-4718-b09b-7b07c1d35126",
                                "sense_id": "367281a9-068a-3e8a-b442-824f7a8f6b06",
                                "text": "« Ils arrêtent des gens dans leurs maisons et ils contrôlent tous les checkpoints », a-t-il dit, via internet et sous le couvert de l'anonymat."
                            }
                        ]
                    },
                    {
                        "sense_id": "d190f849-09c7-33dc-81ab-6bfae6705f4a",
                        "entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "glosses": [
                            "Point d'un programme informatique où le compilateur effectue un arrêt de vérification, en vue d'une reprise ultérieure du traitement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b33ce075-16eb-4b7b-98d0-44c85ebf0aa6",
                        "source_entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "source_sense_id": "367281a9-068a-3e8a-b442-824f7a8f6b06",
                        "source_sense_description": "(Anglicisme) (Militaire) Barrage routier tenu par des milices ou des militaires dans des zones de conflits armés.",
                        "target_lang_word": "Checkpoint",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Checkpoint",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                        "entry_id": "f1b3d3cc-597e-3a73-84bc-9de139645f91",
                                        "glosses": [
                                            "Stelle (besonders an Absperrungen, Grenzübergängen), an der Personen und Fahrzeuge einer Kontrolle, Überprüfung unterzogen werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "55917126-f565-4df4-b2d7-fd3f0223b3eb",
                                                "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                                "text": "Am Checkpoint hat ein Polizist gerade einen Lkw-Fahrer kontrolliert."
                                            },
                                            {
                                                "example_id": "29ff25fd-3904-4463-bfeb-e91fe43cb9a4",
                                                "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                                "text": "„Checkpoints, Wachtürme auf Sichtweite, ein dreifacher Zaun und bewaffnete Patrouillen rund um Tokios neuen Airport Narita erinnerten den Freidemokraten nachhaltig ‚an die DDR-Grenze‘.“"
                                            },
                                            {
                                                "example_id": "4bdcd381-6f68-4a0d-9ef7-a7c08fe29cf6",
                                                "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                                "text": "„Am Checkpoint ‚Ledra-Palace‘ in Nikosia, dem einzigen Übergang über die Bruchstelle zwischen Zypern und Zypern, sammeln sich einige hundert Aktivisten der linkssozialistischen EDEK-Partei.“"
                                            },
                                            {
                                                "example_id": "eea3be83-fed4-44e5-8a97-bd08065195d3",
                                                "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                                "text": "„Polizisten der KKTC prüfen am Checkpoint die Ausweise der Reisenden, tippen fleißig ihre Personalien in einen Computer und händigen dann kleine Zettel mit einem Stempel aus: das ‚Visum‘, das zur Einreise berechtigt.“"
                                            },
                                            {
                                                "example_id": "447adfb9-6604-4be8-bf57-3d3eb9e4e91e",
                                                "sense_id": "e5a0d525-e8e4-3de1-83c0-d85d9d3650e6",
                                                "text": "„Wir verließen Illizi am nächsten Morgen erst, nachdem Hamid fünfzehn Kopien aller unserer Pässe gemacht hatte für die vielen Checkpoints, die vor uns lagen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "169444da-0bf8-3ce5-8289-fcb3222723b6",
                                        "entry_id": "f1b3d3cc-597e-3a73-84bc-9de139645f91",
                                        "glosses": [
                                            "geografisches Merkmal, das Piloten während des Fluges der Orientierung dient"
                                        ],
                                        "tags": [
                                            "Luftfahrt"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "36b40ff9-4138-4cb5-ba49-fe3ab403433e",
                                                "sense_id": "169444da-0bf8-3ce5-8289-fcb3222723b6",
                                                "text": "„Die Flugkontrolle richtet sich nach dem Flugplan, der in diesem Fall nach Edinburgh führte. Dann wird nur noch überwacht, dass der Pilot auch die richtigen Checkpoints (Wegpunkte) an der Strecke mithilfe seines Autopiloten anfliegt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "51aafb72-0e96-3df9-84aa-ccdb27850f58",
                                        "entry_id": "f1b3d3cc-597e-3a73-84bc-9de139645f91",
                                        "glosses": [
                                            "Fixpunkt innerhalb eines Programms, auf den nach einem Fehler oder einer Unterbrechung (zum Beispiel durch Ausfall der EDV-Anlage, Stromausfall) zurückgegriffen werden kann, sodass die Fortsetzung des Programms gewährleistet bleibt"
                                        ],
                                        "tags": [
                                            "EDV"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9a5c33a3-6b7f-4776-9259-9b8d9d8962a9",
                        "source_entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "source_sense_id": "367281a9-068a-3e8a-b442-824f7a8f6b06",
                        "source_sense_description": "(Anglicisme) (Militaire) Barrage routier tenu par des milices ou des militaires dans des zones de conflits armés.",
                        "target_lang_word": "checkpoint",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "checkpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A point or place where a check is performed, especially a point along a road or on a frontier where travellers are stopped for inspection."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f82d61f-8221-4630-b737-94becc4b6a1d",
                                                "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                                "text": "The travellers were stopped at the checkpoint."
                                            },
                                            {
                                                "example_id": "042cfcb1-5d3f-4a23-972d-e4fa25097ebc",
                                                "sense_id": "ef8bc43e-bfe8-3e9c-a581-a9fb658b22cb",
                                                "text": "2014, Paul Salopek, Blessed. Cursed. Claimed., National Geographic (December 2014)https://web.archive.org/web/20150212214621/http://ngm.nationalgeographic.com/2014/12/pilgrim-roads/salopek-text\nA few days later I ford the Jordan River on a bus: Foot travel across Allenby Bridge checkpoint is strictly prohibited."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "023dad88-ea92-30e3-83e5-ed84266512cc",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A situation, often represented by a point in time, at which the state of a database system is known to be valid, and to which it can be returned in the event of a crisis by using a combination of backups and logs; the data stored at this event."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9eff31-e279-46cc-a950-6e764b86a15f",
                                                "sense_id": "023dad88-ea92-30e3-83e5-ed84266512cc",
                                                "text": "After the crash, we rolled back the database to the last checkpoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A predetermined point in a map, level or scenario that the player may resume from if they die or restart."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8413909a-a1c2-4dae-b13f-1ab54667d9d1",
                                                "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                                "text": "You can't finish the race if you haven't passed all of the checkpoints on the track."
                                            },
                                            {
                                                "example_id": "3e5ff7bb-9967-4180-b45b-5b674249206a",
                                                "sense_id": "0c306a7f-64e4-3c8c-891d-d12aa8decdbf",
                                                "text": "This is not a videogame, this is real life! People get hurt! There is no restart from last checkpoint."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "35d847e5-da80-3351-adcd-9f3df767070d",
                                        "entry_id": "8f16d5eb-0468-341c-a153-007a5520797d",
                                        "glosses": [
                                            "A biological control mechanism ensuring correct progression through the cell cycle."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "checkpoint",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23c9deaa-ab2a-32a6-99a9-ab44463ff83d",
                                        "entry_id": "846986c1-b2d3-3089-872c-bdc17d2b7bc0",
                                        "glosses": [
                                            "To set a checkpoint."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f9622a72-731b-4ece-8b0d-738e74929be6",
                        "source_entry_id": "4d4338d9-f134-3cac-b6c9-72afac756f34",
                        "source_sense_id": "d190f849-09c7-33dc-81ab-6bfae6705f4a",
                        "source_sense_description": "(Programmation) Point d'un programme informatique où le compilateur effectue un arrêt de vérification",
                        "target_lang_word": "Schnappschuss",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schnappschuss",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                        "entry_id": "b517bb8d-eb2f-3ebd-a2fa-12cb699d3654",
                                        "glosses": [
                                            "spontanes Foto, das durch unvorbereitetes Abdrücken des Auslösers einer Kamera (auch automatisch) erzeugt wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ae193078-1c86-46e9-90e1-12d8d5977eb7",
                                                "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                                "text": "Dieser Schnappschuss ist ein Volltreffer! Man sieht das Autokennzeichen sehr deutlich."
                                            },
                                            {
                                                "example_id": "3ff370d6-ecdd-4b70-af07-24e2acefd3c5",
                                                "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                                "text": "„Der ‹ungewöhnlich schöne Schnappschuss› erfülle die Werkvoraussetzungen nicht, weil keine ‹Planung der besonderen Art›, keine geistige Schöpfung vorliege.“"
                                            },
                                            {
                                                "example_id": "7016af3e-7735-41cd-a367-a80d0aea6201",
                                                "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                                "text": "„Dieses Foto ist mehr als ein gelungener Schnappschuss.“"
                                            },
                                            {
                                                "example_id": "91c3388b-ac3d-4084-81eb-4f4ddc816f1d",
                                                "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                                "text": "„Das Bild ist einer dieser gewöhnlichen kleinen Schnappschüsse, die das Leben fast aller Menschen illustrieren.“"
                                            },
                                            {
                                                "example_id": "9131cdea-4463-4b7e-ab85-e05ff60eb57d",
                                                "sense_id": "1daff7fa-d560-34f4-af68-707d0b1e46c9",
                                                "text": "„Meine Tochter hat mir dann irgendwann diesen Schnappschuss gezeigt, eigentlich zufällig.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
