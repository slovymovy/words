                                        "sense_id": "a11fcec5-bde4-3160-86be-4f4c3690f040",
                                        "entry_id": "81548a3b-64d2-39d6-b413-e51a73346374",
                                        "glosses": [
                                            "animal da família dos erinacídeos dotado de espinhos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1bca46c-0c89-4b77-9040-4d34a53b82f7",
                                                "sense_id": "a11fcec5-bde4-3160-86be-4f4c3690f040",
                                                "text": "O filho de Canicrã jamais será escravo; nasceu tapuia e tapuia morrerá, como o grande chefe que o gerou. Enquanto o ouriço viver nas florestas, ele roubará seus espinhos para furar os olhos dos tucanos."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5582306c-5092-365b-b403-d7846b3e4f57",
                                        "entry_id": "81548a3b-64d2-39d6-b413-e51a73346374",
                                        "glosses": [
                                            "invólucro com espinhos de alguns frutos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d3093b-dded-4b63-8ae8-878d13bf0448",
                                                "sense_id": "5582306c-5092-365b-b403-d7846b3e4f57",
                                                "text": "Elas fazem arte com o ouriço da castanha-do-pará, sementes e cipós coletados nas matas."
                                            }
                                        ]
                                    }
                                ]
                            }
