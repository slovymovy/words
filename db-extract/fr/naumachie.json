            {
                "entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                "word": "naumachie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "dcb57b93-4246-4cd8-ad10-0e1c8bb96a79",
                        "entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                        "tags": [
                            "plural"
                        ],
                        "form": "naumachies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "75fc5507-6e7d-3edf-adea-e3586440e538",
                        "entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                        "glosses": [
                            "Spectacle d’un combat naval qu’on donnait au peuple de l’ancienne Rome."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": [
                            {
                                "example_id": "d8ca987b-8636-4fc0-946d-86914fb8ac72",
                                "sense_id": "75fc5507-6e7d-3edf-adea-e3586440e538",
                                "text": "Dans un grand espace aquatique délimité ou bien spécialement construit par les organisateurs, la naumachie met en scène des milliers de condamnés à mort, embarqués sur de redoutables galères de combat."
                            },
                            {
                                "example_id": "5c258c96-9c6a-411f-8401-28278a00851e",
                                "sense_id": "75fc5507-6e7d-3edf-adea-e3586440e538",
                                "text": "Les Romains faisaient d’énormes dépenses pour leurs naumachies."
                            }
                        ]
                    },
                    {
                        "sense_id": "2e085ff7-27b4-34a9-a41c-02496c47ecf6",
                        "entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                        "glosses": [
                            "Lieu même où se donnait ce spectacle."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "b660dfa6-caec-4efc-a2a5-faa8cc18e4e4",
                                "sense_id": "2e085ff7-27b4-34a9-a41c-02496c47ecf6",
                                "text": "On voit encore les ruines d’une naumachie à la maison de campagne d’Adrien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c3ca22d8-3d7e-4fdc-820c-46e8e06ef67b",
                        "source_entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                        "target_lang_word": "Naumachie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Naumachie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66538a8f-12bb-3b6d-adad-451ba9f529dc",
                                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                                        "glosses": [
                                            "nachgestellte Seeschlacht zur Unterhaltung der Bevölkerung"
                                        ],
                                        "tags": [
                                            "historisch, Antike"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2374fed6-c18a-3fe3-a963-033929268df7",
                                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                                        "glosses": [
                                            "Anlage, in der nachgestellte Seeschlachten zur Unterhaltung der Bevölkerung stattfanden"
                                        ],
                                        "tags": [
                                            "historisch, Antike"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47461c2e-beba-449f-8735-045a06228310",
                                                "sense_id": "2374fed6-c18a-3fe3-a963-033929268df7",
                                                "text": "„Zur Volksbelustigung veranlasst Augustus schließlich noch, jenseits des Tibers eine Naumachie auszuheben, ein von einer eigenen Wasserleitung gespeistes riesiges Becken, in dem Seeschlachten nachgestellt werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d06712a4-d00c-3f2b-9503-dddceff430f7",
                                        "entry_id": "1f97dfeb-424a-31b5-9889-b292ef6240f7",
                                        "glosses": [
                                            "Seeschlacht"
                                        ],
                                        "tags": [
                                            "historisch, Antike",
                                            "Griechenland"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "869fce1a-f367-4590-8309-18fa2bf34d9f",
                                                "sense_id": "d06712a4-d00c-3f2b-9503-dddceff430f7",
                                                "text": "„Plötzlich weiß ich das Wort für eine nächtliche Seeschlacht, nach dem ich so lange schon suche: Naumarchie.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "23d831b2-2155-4dbf-b96d-b3c2b271a586",
                        "source_entry_id": "2f8a75b9-fea6-3045-802b-094b76b16244",
                        "target_lang_word": "naumachia",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "naumachia",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "480a9041-f6d7-338f-a01e-e311d0e44d60",
                                        "entry_id": "d5f8c83e-4367-34e4-bb07-bb63bde9c710",
                                        "glosses": [
                                            "The recreation of a sea battle staged for entertainment."
                                        ],
                                        "tags": [
                                            "Ancient-Rome"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f34c1cdc-3a80-454f-932f-264268e5ed57",
                                                "sense_id": "480a9041-f6d7-338f-a01e-e311d0e44d60",
                                                "text": "BEFORE he went to feed with owls and bats\nNebuchadnezzar had an ugly dream,\nWorse than an Hus'if's when she thinks her cream\nMade a Naumachia for mice and rats."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6154f299-8bd7-3d77-b6f9-5229ae5dc607",
                                        "entry_id": "d5f8c83e-4367-34e4-bb07-bb63bde9c710",
                                        "glosses": [
                                            "The location where such recreated sea battles took place; a building featuring an artificial body of water."
                                        ],
                                        "tags": [
                                            "Ancient-Rome",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9174a1f0-bcc0-4ce1-8354-435812573221",
                                                "sense_id": "6154f299-8bd7-3d77-b6f9-5229ae5dc607",
                                                "text": "Our clerical guide did not fail us, but took us to see some ancient architectural remains, water tanks, a naumachia and other ruins of a similar sort."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
