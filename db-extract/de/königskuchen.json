                        "entry_id": "d0b6c0d4-603e-32df-a207-e36fc53af809",
                        "glosses": [
                            "Korinthen, Zitronat, Mandeln und ähnliche Zutaten beinhaltender kastenförmiger, feiner Rührkuchen"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                        "entry_id": "d0b6c0d4-603e-32df-a207-e36fc53af809",
                        "glosses": [
                            "Kurzform von Dreikönigskuchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9bcf39dd-8ac4-46a8-b285-a7d7784ff9ad",
                                "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                                "text": "„2005 spenden zum Beispiel die Bäcker des Kantons Zürich für jeden gekauften Königskuchen einen Franken für die Opfer des Seebebens.“"
                            },
                            {
                                "example_id": "b2e02fff-ace1-4f05-bd4c-a92c0ae9e540",
                                "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                                "text": "„Wie jedes Jahr werden hunderttausende Königskuchen verkauft.“"
                            },
                            {
                                "example_id": "4fbc562f-1029-487a-a44e-d96018d35870",
                                "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                                "text": "„Hier wird seit Generationen der Königskuchen nach Schweizer Art gebacken – ein Gebäck in der Form einer Blüte, von der die einzelnen Portionen abgezupft werden.“"
                            },
                            {
                                "example_id": "06b1e683-db30-4c76-b866-8c36dc21a2d3",
                                "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                                "text": "„In jedem Königskuchen wird eine Bohne oder eine kleine Figur versteckt, dazu gibt es eine goldene Pappkrone.“"
                            },
                            {
                                "example_id": "0ce445f8-017f-4425-a409-f4463cfa94e5",
                                "sense_id": "6ea40af7-0a57-377e-ad7c-d8aafb09f1c4",
                                "text": "„Gross ist seine Begeisterung auch, was die Zusammenarbeit mit der Bäckerei Steiner Solothurn betrifft, die die leckeren Königskuchen bereitstellte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
