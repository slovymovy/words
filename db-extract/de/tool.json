                "senses": [
                    {
                        "sense_id": "96776d79-c9f9-3767-b4a6-8635b661d543",
                        "entry_id": "0a68eb04-b5b4-3631-a660-05312461fea3",
                        "glosses": [
                            "ein Programm, das spezielle Aufgaben innerhalb eines größeren Softwarepaketes übernimmt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "319b5bf3-8282-46a2-b645-fe26e05c7a0b",
                                "sense_id": "96776d79-c9f9-3767-b4a6-8635b661d543",
                                "text": "„Neben den Standardwerkzeugen existieren unter Linux gleich mehrere Tools, die das stetige Betrachten einer Logdatei erlauben.“"
                            },
                            {
                                "example_id": "9d19563b-7524-4df0-b27c-0a22fab253aa",
                                "sense_id": "96776d79-c9f9-3767-b4a6-8635b661d543",
                                "text": "„Um einen Einstieg ins Thema maschinelles Lernen zu bekommen, bietet Google mit der Teachable Machine ein Tool, mit dem Nutzer ein eigenes neuronales Netz trainieren können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "79c07c46-e135-3b42-a180-715ef917d2aa",
                        "entry_id": "0a68eb04-b5b4-3631-a660-05312461fea3",
                        "glosses": [
                            "ein Verfahren, das als Werkzeug geeignet ist, um ein bestimmtes Ziel zu erreichen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "295411d8-f05a-4ae3-8b85-1131bd9d1abf",
                                "sense_id": "79c07c46-e135-3b42-a180-715ef917d2aa",
                                "text": "„Teamanalysen führen wir mit Unterstützung eines Tools durch, das bezogen auf den jeweiligen Analyseschwerpunkt beispielsweise typische Verhaltensweisen und Handlungsmuster im Team aufdeckt, die Teamkultur beschreibt oder verschiedene Rollen im Team untersucht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb848779-2e76-43db-baa3-f3c04ccd5d22",
                        "source_entry_id": "0a68eb04-b5b4-3631-a660-05312461fea3",
                        "source_sense_id": "96776d79-c9f9-3767-b4a6-8635b661d543",
                        "source_sense_description": "Informatik: ein Programm, das spezielle Aufgaben innerhalb eines größeren Softwarepaketes übernimmt",
                        "target_lang_word": "tool",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tool",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5c74e640-1863-38f0-a610-c41b502a9443",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "Any physical device meant to ease or do a task."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e536856-3d9b-4112-b73e-be155c0678c3",
                                                "sense_id": "5c74e640-1863-38f0-a610-c41b502a9443",
                                                "text": "Several prehistoric tools, including a stone ax, were found during the dig."
                                            },
                                            {
                                                "example_id": "94a1647e-c26f-40fe-b620-f6850b8b9f49",
                                                "sense_id": "5c74e640-1863-38f0-a610-c41b502a9443",
                                                "text": "A screwdriver is a tool that no household should be without."
                                            },
                                            {
                                                "example_id": "a03d5a71-b1b8-4d0d-9986-9a6833ed2e18",
                                                "sense_id": "5c74e640-1863-38f0-a610-c41b502a9443",
                                                "text": "A stapler is a tool for attaching papers to others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "Any physical device meant to ease or do a task.",
                                            "Any piece of equipment used in a profession, such as a craftsman's."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9a3a99aa-6bde-4043-8a43-a95aa4fdc6f5",
                                                "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                                "text": "the tools of the trade"
                                            },
                                            {
                                                "example_id": "f518671d-bfe2-4b37-ab53-1eac0eed0fe9",
                                                "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                                "text": "Rakes, shovels, hoes, and spades are some of the tools of the gardener's trade."
                                            },
                                            {
                                                "example_id": "b76897dd-6395-4c00-ab4a-62b8cacbc3f5",
                                                "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                                "text": "I don't have the right tools to start fiddling around with the engine."
                                            },
                                            {
                                                "example_id": "0981f49f-8de3-43ca-b07c-13349d313e85",
                                                "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                                "text": "A timing light is a tool that only an automotive mechanic, professional or amateur, would have."
                                            },
                                            {
                                                "example_id": "1998d193-32de-4b68-9cea-8730a3d193c4",
                                                "sense_id": "552a1b05-a38d-3bd9-8740-2a2c25b17242",
                                                "text": "Drawings and pictures are more than mere ornaments in scientific discourse. Blackboard sketches, geological maps, diagrams of molecular structure, astronomical photographs, MRI images, the many varieties of statistical charts and graphs: These pictorial devices are indispensable tools for presenting evidence, for explaining a theory, for telling a story."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "74a86372-3095-3bde-87e0-ac1844381fe4",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "Anything that aids someone to perform an operation; an instrument; a means."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592e2198-ec93-4105-90fc-5448758baff2",
                                                "sense_id": "74a86372-3095-3bde-87e0-ac1844381fe4",
                                                "text": "Idleness is a tool of the devil."
                                            },
                                            {
                                                "example_id": "cf95bed7-f4b4-496a-9286-109a731c0390",
                                                "sense_id": "74a86372-3095-3bde-87e0-ac1844381fe4",
                                                "text": "A spreadsheet app and a bookkeeping app are some of the principal tools of a bookkeeper."
                                            },
                                            {
                                                "example_id": "9f9fe93a-03f0-444d-a46e-b8141fed73b5",
                                                "sense_id": "74a86372-3095-3bde-87e0-ac1844381fe4",
                                                "text": "What was the need of a man to do that? \"One stick at a time;\" if Ned could not do that, he was a poor tool. Ah, a poor tool he proved to be."
                                            },
                                            {
                                                "example_id": "69cbe47f-2f64-4dcd-891f-ee2cd8abc46b",
                                                "sense_id": "74a86372-3095-3bde-87e0-ac1844381fe4",
                                                "text": "Not long ago, it was difficult to produce photographs of tiny creatures with every part in focus.[…]A photo processing technique called focus stacking has changed that. Developed as a tool to electronically combine the sharpest bits of multiple digital images, focus stacking is a boon to biologists seeking full focus on a micron scale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1626e2fd-7d5d-3b8a-8f60-9898ed949cc9",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "A piece of software used to develop software or hardware, or to perform low-level operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e16524a-b418-448b-a062-43a51d5d3887",
                                                "sense_id": "1626e2fd-7d5d-3b8a-8f60-9898ed949cc9",
                                                "text": "The software engineer had been developing lots of EDA tools."
                                            },
                                            {
                                                "example_id": "448b4420-b724-46d8-bac9-a89056d6a724",
                                                "sense_id": "1626e2fd-7d5d-3b8a-8f60-9898ed949cc9",
                                                "text": "a tool for recovering deleted files from a disk"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1859f6a4-46cc-3867-bc80-40cc85f45d61",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "A person or group which is used or controlled, usually unwittingly, by another person or group, a pawn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6c492ad3-2b25-43cf-a61c-d4a51cfea10d",
                                                "sense_id": "1859f6a4-46cc-3867-bc80-40cc85f45d61",
                                                "text": "She was a tool of the pharmaceutical lobby."
                                            },
                                            {
                                                "example_id": "1f5a9bf6-9978-4a07-94f0-5baf72669c4e",
                                                "sense_id": "1859f6a4-46cc-3867-bc80-40cc85f45d61",
                                                "text": "He was a tool of a foreign influence operation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2ba9c63-8bc4-35bd-b93e-cbef8be97b96",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "A particular skill pertaining to baseball (such as hitting, running, etc.)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3515d6b-eac1-4ad3-9b0f-be7135826247",
                                                "sense_id": "c2ba9c63-8bc4-35bd-b93e-cbef8be97b96",
                                                "text": "a five-tool player"
                                            },
                                            {
                                                "example_id": "1bbd2f5d-a59b-45a7-ac11-5a13aedef337",
                                                "sense_id": "c2ba9c63-8bc4-35bd-b93e-cbef8be97b96",
                                                "text": "When asked what he liked about Youk [Kevin Youkilis], former Boston scout Matt Haas says, \"At first glance, not a lot.\" (Mind you, this is one of the few scouts who actually wanted the kid.) \"He was unorthodox,\" says Haas, who now scouts for the Arizona Diamondbacks. \"He had an extreme crouch—his thighs were almost parallel to the ground. And he was heavier than he is now. But the more I watched him, the more I just thought, Throw the tools out the window. This guy can play baseball.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea7a6e30-3577-3171-91d6-32e4466bef69",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "A penis, notably with a sexual or erotic connotation."
                                        ],
                                        "tags": [
                                            "informal",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da918328-39f2-4f2d-9a88-b5ab9e2ec83f",
                                                "sense_id": "ea7a6e30-3577-3171-91d6-32e4466bef69",
                                                "text": "Or haue wee some strange Indian with the great Toole, come to Court, the women so besiege vs?"
                                            },
                                            {
                                                "example_id": "d071d618-ce8d-45bc-ad1d-e60c21277b4b",
                                                "sense_id": "ea7a6e30-3577-3171-91d6-32e4466bef69",
                                                "text": "She wanna hang with the goons\nShe wanna party midnight till noon\nShe wanna play with my tool"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d44b79bf-dbb4-3b32-8adf-fd16b5b29bf9",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "An obnoxious or uptight person."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "derogatory",
                                            "slang",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f990314d-f48b-4b5c-9812-610ec9eab92d",
                                                "sense_id": "d44b79bf-dbb4-3b32-8adf-fd16b5b29bf9",
                                                "text": "He won't sell us tickets because it's 3:01, and they went off sale at 3. That guy's such a tool."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cb35b9b4-b569-3daa-a7f4-112035fa548e",
                                        "entry_id": "bda3ce47-f327-3ba8-b150-6dd28b4e75ff",
                                        "glosses": [
                                            "A handgun."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Multicultural-London-English",
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c3608144-2fb8-4d8f-8935-9329b60a8814",
                                                "sense_id": "cb35b9b4-b569-3daa-a7f4-112035fa548e",
                                                "text": "In my city keep a tool\nLil nigga you know the rules"
                                            },
                                            {
                                                "example_id": "20e176e9-d69e-45b1-9926-8dd751f26099",
                                                "sense_id": "cb35b9b4-b569-3daa-a7f4-112035fa548e",
                                                "text": "Three waps up and a couple of shanks (Just in case)\nBut I got faith that these tools won't jam"
                                            }
