                "senses": [
                    {
                        "sense_id": "ec94639b-c025-3e1a-841b-72c86a7e811c",
                        "entry_id": "d7052144-8dfb-3bd7-a5d5-240ee2ad505e",
                        "glosses": [
                            "Faire perdre son caractère vaudou à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e8ac0dd-f294-46a8-aa52-2401cf3a9cef",
                                "sense_id": "ec94639b-c025-3e1a-841b-72c86a7e811c",
                                "text": "Pour les religions africaines, il s’agit de dévaudouiser Dieu, de le décharlataniser et de le déséloigner."
                            },
                            {
                                "example_id": "a645283c-9b2d-407b-8433-9da6998d6c9c",
                                "sense_id": "ec94639b-c025-3e1a-841b-72c86a7e811c",
                                "text": "Dans ce travail d’assainissement moral qui ne souhaitait que dévaudouiser le vaudouisant de son vodoun (loa), pourrait-on dire, les prêtres catholiques visèrent juste, car les Haïtiens, en général, avaient et ont encore une grande peur du serment!"
                            }
                        ]
                    }
                ],
