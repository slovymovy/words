                "senses": [
                    {
                        "sense_id": "22d76ffd-73ef-3c6f-8322-64a7a3857b52",
                        "entry_id": "e8964baa-f08a-353a-96b0-4daacb5f69d2",
                        "glosses": [
                            "Quelqu’une des espèces végétales qui s’implantent dans un lieu et y font évoluer la végétation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcbc4937-9bf8-4980-b7db-8fea58d3d012",
                                "sense_id": "22d76ffd-73ef-3c6f-8322-64a7a3857b52",
                                "text": "Ces pelouses constituent des peuplements les plus riches en espèces spéciales […]. On les considère souvent comme stabilisés par l'action indirecte de l'homme et en particulier par le pacage des ovins. Il est possible que dans certains cas, l’arrêt des actions anthropozoogènes permette à des pionnières forestières de s'implanter […]."
                            }
                        ]
                    },
                    {
                        "sense_id": "c912a8f7-fc9e-3ea6-8114-bf2d9a32a0d6",
                        "entry_id": "e8964baa-f08a-353a-96b0-4daacb5f69d2",
                        "glosses": [
                            "Femme qui s’attache à une entreprise nouvelle, qui fait gagner un terrain nouveau à une influence."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2e962709-c658-4dc5-b8a3-b099c3a00455",
                                "sense_id": "c912a8f7-fc9e-3ea6-8114-bf2d9a32a0d6",
                                "text": "Ils étaient dans la lignée de beaucoup de rappeurs et rappeuses qui véhiculaient des textes engagés. Parmi eux, il y avait la pionnière du rap féminin, Queen Latifah, qui créa une véritable révolution dans le monde machiste du hip-hop."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7a459a66-503c-41f7-a8b6-04ef79ca1b67",
                        "source_entry_id": "e8964baa-f08a-353a-96b0-4daacb5f69d2",
                        "source_sense_description": "Femme",
                        "target_lang_word": "Pionierin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Pionierin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                                        "glosses": [
                                            "Wegbereiterin, Bahnbrecherin"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3f1216f2-a2f8-4d50-b39f-cdbc08f2bdd9",
                                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                                "text": "Sie war ein Pionierin der Genderwissenschaft."
                                            },
                                            {
                                                "example_id": "b505c2ef-9c7e-4b33-9761-6d2a4d3bff7a",
                                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                                "text": "„Und so brach sie als Pionierin, die sie war, auf in ein neues Abenteuer.“"
                                            },
                                            {
                                                "example_id": "5eef4c50-984b-4cb4-8a65-5dfb5cd424b1",
                                                "sense_id": "9dce53fe-3b67-3649-9dac-d5c8eac9ea28",
                                                "text": "„London war in der frühen Neuzeit nicht nur eine der am schnellsten wachsenden Städte der Welt, sondern wohl auch die dreckigste. Sie wurde zur Vorreiterin in Sachen Vermüllung – aber auch zu einer Pionierin moderner Abfallbeseitigung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "2aa45632-f135-3725-828d-0776b28fab0c",
                                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                                        "glosses": [
                                            "Angehörige einer Pioniertruppe"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28128e08-87f3-4961-a10f-e31e05df4e03",
                                                "sense_id": "2aa45632-f135-3725-828d-0776b28fab0c",
                                                "text": "Die Pionierinnen sprengten eine Brücke."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c48fc43f-95a0-3aa0-83fe-fa49cd86dd7d",
                                        "entry_id": "c735bf71-f1b8-37e2-8b2f-74e0218d2a72",
                                        "glosses": [
                                            "Angehörige einer Kinderorganisation der führenden Partei"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c5a31bc-a4a1-4c71-9d2f-d4c2f227b961",
                                                "sense_id": "c48fc43f-95a0-3aa0-83fe-fa49cd86dd7d",
                                                "text": "Die Pionierinnen übten im Wald."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2d215083-832d-4ebe-95c7-33c993e9121d",
                        "source_entry_id": "e8964baa-f08a-353a-96b0-4daacb5f69d2",
