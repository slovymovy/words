                        "target_lang_word": "recitative",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "recitative",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4b5ac900-d919-392b-af38-a57d65cecc35",
                                        "entry_id": "3b13561a-3ac4-37d1-8df6-d7bb7e582495",
                                        "glosses": [
                                            "dialogue, in an opera etc, that, rather than being sung as an aria, is reproduced with the rhythms of normal speech, often with simple musical accompaniment or harpsichord continuo, serving to expound the plot."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ee43ea05-18e7-4b9a-a473-0271c81c67c9",
                                                "sense_id": "4b5ac900-d919-392b-af38-a57d65cecc35",
                                                "text": "In Gilbert and Sullivan's Patience, Bunthorne performs the recitative \"Am I Alone and Unobserved?\" before going on to his solo aria \"If You're Anxious For To Shine\"."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "recitative",
                                "target_lang_code": "en",
