                "senses": [
                    {
                        "sense_id": "dc292054-8db9-3c8e-bb4b-79ae2229dd8e",
                        "entry_id": "0a02c5a7-8e1c-3620-b2ac-be267dc07e24",
                        "glosses": [
                            "Celui qui embrasse, qui aime à embrasser."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b2dc4b9-c341-401b-adf5-aa1713a155dc",
                                "sense_id": "dc292054-8db9-3c8e-bb4b-79ae2229dd8e",
                                "text": "Il était plus vif que le roi, plus en dehors, affectueux, grand embrasseur."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9f1516ff-2a78-4b03-b4ba-2c37d709c948",
                        "source_entry_id": "0a02c5a7-8e1c-3620-b2ac-be267dc07e24",
                        "source_sense_id": "dc292054-8db9-3c8e-bb4b-79ae2229dd8e",
                        "target_lang_word": "kisser",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kisser",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8f9bb8a5-5540-394a-8832-1f28438a90c9",
                                        "entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                                        "glosses": [
                                            "One who kisses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4479af95-3bfb-4e01-8fa9-ac91f347e781",
                                                "sense_id": "8f9bb8a5-5540-394a-8832-1f28438a90c9",
                                                "text": "She's a great kisser!"
                                            },
                                            {
                                                "example_id": "e0fdfa0f-afb8-440c-b680-f3a87a3d573e",
                                                "sense_id": "8f9bb8a5-5540-394a-8832-1f28438a90c9",
                                                "text": "I went to bed that night totally and completely in love with my Mary. What a kisser. She dropped me the next day."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5b42ac2d-7f2d-3979-ae5d-12af51f78c44",
                                        "entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                                        "glosses": [
                                            "The mouth."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d6af60f-8e88-453e-9582-30c569328afe",
                                                "sense_id": "5b42ac2d-7f2d-3979-ae5d-12af51f78c44",
                                                "text": "Get yore handkerchief ready, an' run out an' cram it into his kisser an' choke th' —— if he starts in to holler."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "416eb0a2-a354-3624-a305-6b8e49a98ced",
                                        "entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                                        "glosses": [
                                            "The face."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "47762dc2-7202-498e-8e8a-6da54bc5a1e7",
                                                "sense_id": "416eb0a2-a354-3624-a305-6b8e49a98ced",
                                                "text": "Not a pretty kisser,\nbut so mobile those\ndrawn-on brows, bulging\npeepers green as dill,\ncock-eyed grin,\nthe It Girls lost it\nbeside her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5dd4ae1c-00c6-357e-8491-6b5e2c54c759",
                                        "entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                                        "glosses": [
                                            "The kissing gourami."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "58b44200-8f18-364d-89a1-749b3952c58d",
                                        "entry_id": "9a2003d0-0370-33d5-aa8b-1f8c3c870aac",
                                        "glosses": [
                                            "A button on a bowstring that indicates consistent height when drawing a bow, for example by being placed against the archer's mouth ."
                                        ],
