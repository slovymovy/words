{
    "word_family": [
        "coaxer",
        "coaxing"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87740613-e29f-362f-a79c-7692459776de",
                    "sense_definition": "To persuade someone or something gradually or by using flattery to do something.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "persuasion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She <w>coaxed</w> her friend into joining the dance class.",
                            "target_lang_translations": {
                                "cs": "Kamarádku <w>přemluvila</w>, aby se přihlásila do tanečního kurzu.",
                                "zh": "她<w>哄劝</w>朋友去参加舞蹈课。"
                            }
                        },
                        {
                            "text": "The trainer <w>coaxed</w> the nervous dog to come out of its kennel.",
                            "target_lang_translations": {
                                "cs": "Cvičitel <w>přemluvil</w> nervózního psa, aby vylezl z boudy.",
                                "zh": "训犬员<w>哄着</w>那只紧张的狗从狗窝里出来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cajole",
                        "persuade",
                        "wheedle"
                    ],
                    "common_phrases": [
                        "coax into"
                    ],
                    "target_lang_definitions": {
                        "cs": "Někoho postupně přesvědčovat nebo přemlouvat k určité činnosti, často pomocí lichotek nebo laskavého naléhání.",
                        "zh": "慢慢地劝说、哄劝某人或某物做某事，常带有奉承、安抚或温和催促的意味。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "přemluvit",
                                "target_lang_sense_clarification": "dokonavé, úspěšné přesvědčení někoho k něčemu"
                            },
                            {
                                "target_lang_word": "přemlouvat",
                                "target_lang_sense_clarification": "nedokonavé, proces přesvědčování někoho"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "哄劝",
                                "target_lang_sense_clarification": "用好话、耐心劝说，让别人慢慢答应去做某事"
                            },
                            {
                                "target_lang_word": "劝诱",
                                "target_lang_sense_clarification": "带有诱导、劝动意味地让对方做某事"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f46648fb-d37b-385b-80ea-5e776aacd021",
                    "sense_definition": "To carefully manipulate something into a particular desired state or position.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "manipulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He <w>coaxed</w> the wire through the narrow opening in the wall.",
                            "target_lang_translations": {
                                "cs": "Opatrně <w>navedl</w> drát úzkým otvorem ve zdi.",
                                "zh": "他小心地把电线<w>穿过</w>墙上的狭窄开口。"
                            }
                        },
                        {
                            "text": "The mechanic <w>coaxed</w> the engine back to life after several attempts.",
                            "target_lang_translations": {
                                "cs": "Mechanik po několika pokusech <w>zprovoznil</w> motor.",
                                "zh": "机械师试了几次后，终于<w>让</w>发动机重新运转起来。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ease"
                    ],
                    "target_lang_definitions": {
                        "cs": "Opatrně s něčím manipulovat nebo to dostat do požadovaného stavu či polohy.",
                        "zh": "小心地摆弄、引导某物，使其进入所希望的状态或位置。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "navést",
                                "target_lang_sense_clarification": "opatrné vedení něčeho do úzkého prostoru"
                            },
                            {
                                "target_lang_word": "zprovoznit",
                                "target_lang_sense_clarification": "opatrné uvedení stroje nebo zařízení zpět do chodu"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "慢慢弄到",
                                "target_lang_sense_clarification": "小心地把某物弄到某个位置或状态"
                            },
                            {
                                "target_lang_word": "让……重新运转起来",
                                "target_lang_sense_clarification": "设法让机器、系统等恢复工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caac0335-bdf7-3b31-8622-fa26c5f363b9",
                    "sense_definition": "To touch or handle someone or something in a gentle, affectionate, or playful way.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "touch",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mother <w>coaxed</w> the baby's hair while singing a lullaby.",
                            "target_lang_translations": {
                                "cs": "Matka <w>hladila</w> miminko po vláskách, zatímco mu zpívala ukolébavku.",
                                "zh": "母亲一边唱摇篮曲，一边轻轻<w>抚摸</w>着宝宝的头发。"
                            }
                        },
                        {
                            "text": "They sat on the bench <w>coaxing</w> the stray cat that had wandered into the garden.",
                            "target_lang_translations": {
                                "cs": "Seděli na lavičce a <w>mazlili se</w> s toulavou kočkou, která zabloudila na zahradu.",
                                "zh": "他们坐在长椅上，轻轻<w>逗弄</w>那只误闯进花园的流浪猫。"
                            }
                        }
                    ],
                    "synonyms": [
                        "caress",
                        "fondle"
                    ],
                    "target_lang_definitions": {
                        "cs": "Dotýkat se někoho nebo něčeho jemným, láskyplným nebo hravým způsobem.",
                        "zh": "以轻柔、亲昵或带玩闹意味的方式触碰或摆弄某人或某物。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "hladit",
                                "target_lang_sense_clarification": "jemné dotýkání se rukou"
                            },
                            {
                                "target_lang_word": "mazlit se",
                                "target_lang_sense_clarification": "projevování náklonnosti doteky"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "抚摸",
                                "target_lang_sense_clarification": "轻柔地用手触碰、抚弄"
                            },
                            {
                                "target_lang_word": "逗弄",
                                "target_lang_sense_clarification": "带着亲昵或玩耍意味地逗弄"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "228728da-487b-3af7-9263-f689a17d9b40",
                    "sense_definition": "A type of cable used for transmitting high-frequency signals, often used for television or internet.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The technician connected the <w>coax</w> to the back of the television.",
                            "target_lang_translations": {
                                "cs": "Technik připojil <w>koaxiální kabel</w> k zadní straně televize.",
                                "zh": "技术员把<w>同轴电缆</w>接到了电视机背面。"
                            }
                        },
                        {
                            "text": "We need a longer <w>coax</w> to reach the router in the other room.",
                            "target_lang_translations": {
                                "cs": "Potřebujeme delší <w>koax</w>, abychom dosáhli k routeru v druhé místnosti.",
                                "zh": "我们需要一根更长的<w>同轴线</w>，才能接到另一个房间里的路由器。"
                            }
                        }
                    ],
                    "synonyms": [
                        "coax cable"
                    ],
                    "target_lang_definitions": {
                        "cs": "Typ kabelu používaný pro přenos vysokofrekvenčních signálů, často pro televizi nebo internet.",
                        "zh": "一种用于传输高频信号的电缆，常用于电视或网络连接。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koaxiální kabel",
                                "target_lang_sense_clarification": "technický název pro tento typ kabelu"
                            },
                            {
                                "target_lang_word": "koax",
                                "target_lang_sense_clarification": "hovorové označení pro koaxiální kabel"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同轴电缆",
                                "target_lang_sense_clarification": "用于传输高频信号的标准技术名称"
                            },
                            {
                                "target_lang_word": "同轴线",
                                "target_lang_sense_clarification": "口语中对同轴电缆的简称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4ffe314-deaa-3ea0-9aec-811bae5acd8b",
                    "sense_definition": "A foolish or easily deceived person.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old play described the main character as a complete <w>coax</w> who lost all his money.",
                            "target_lang_translations": {
                                "cs": "Stará hra popisovala hlavní postavu jako úplného <w>naivku</w>, který přišel o všechny peníze.",
                                "zh": "那部老戏把主角描写成一个十足的<w>傻瓜</w>，把钱全都赔光了。"
                            }
                        },
                        {
                            "text": "Do not be such a <w>coax</w> and listen to the advice of your friends.",
                            "target_lang_translations": {
                                "cs": "Nebuď takový <w>hlupák</w> a poslechni rad svých přátel.",
                                "zh": "别这么<w>轻信的人</w>了，听听朋友们的劝告吧。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "This sense is rarely used in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Pošetilý nebo snadno oklamatelný člověk.",
                        "zh": "一个愚蠢或容易受骗的人。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "naivka",
                                "target_lang_sense_clarification": "člověk, který je snadno oklamán"
                            },
                            {
                                "target_lang_word": "hlupák",
                                "target_lang_sense_clarification": "pošetilý člověk"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "轻信的人",
                                "target_lang_sense_clarification": "容易上当、轻信别人的人"
                            },
                            {
                                "target_lang_word": "傻瓜",
                                "target_lang_sense_clarification": "较口语、较笼统的说法，指愚蠢的人"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "cc0711c4-288b-3e87-b67e-f09ef6d9127d",
                    "sense_definition": "Relating to or using a <w>coaxial</w> cable.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>coax</w> connection provides a stable internet signal.",
                            "target_lang_translations": {
                                "cs": "<w>Koaxiální</w> připojení poskytuje stabilní internetový signál.",
                                "zh": "<w>同轴</w>连接能提供稳定的网络信号。"
                            }
                        },
                        {
                            "text": "He bought a <w>coax</w> adapter for his home theater system.",
                            "target_lang_translations": {
                                "cs": "Koupil si <w>koaxiální</w> adaptér pro svůj systém domácího kina.",
                                "zh": "他给自己的家庭影院系统买了一个<w>同轴</w>适配器。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used as a shorthand for coaxial."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Vztahující se ke koaxiálnímu kabelu nebo jej využívající.",
                        "zh": "与同轴电缆有关的，或使用同轴电缆的。"
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "koaxiální",
                                "target_lang_sense_clarification": "odborný přídavný název"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "同轴",
                                "target_lang_sense_clarification": "与同轴电缆有关的；使用同轴电缆的"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}