                "senses": [
                    {
                        "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                        "entry_id": "abc4087b-c0b4-3c25-a3ca-058d55cb1768",
                        "glosses": [
                            "längliche Vertiefung zwischen dem Gesäß und dem Oberschenkel"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "6515bdfc-aa44-407b-b37e-1b6fe4b72a7b",
                                "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                                "text": "„Wenn Ernährung und Bewegung nicht stimmen, kann die teuerste Creme keine perfekte Bananenfalte zaubern.“"
                            },
                            {
                                "example_id": "a4faaba8-6911-41c6-b2ae-7fb31218c810",
                                "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                                "text": "„Es geht im Prinzip darum, die Bananenfalte so wenig wie möglich sichtbar zu machen.“"
                            },
                            {
                                "example_id": "450acc81-2145-42b4-a8f7-27401d34e7ae",
                                "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                                "text": "„Es scheint für nahezu alles eine Schönheitsoperation zu geben und so natürlich auch für die Bananenfalte.“"
                            },
                            {
                                "example_id": "5ce2bc8f-3676-425d-b6e0-c1f22bcb2017",
                                "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                                "text": "„Rein medizinisch ist der Eingriff nicht allzu dramatisch, bei der Bananenfalte handelt es sich um Haut- und Fettüberschuss, der sich am Übergang vom Hintern zum Schenkel befindet.“"
                            },
                            {
                                "example_id": "8aab0bae-7ab0-4f67-85b7-b2b268a82003",
                                "sense_id": "5f16a6e4-8bb0-322a-81ef-9d89051593f7",
                                "text": "„Auch wer viel sitzt, sitzt im wahrsten Sinne des Wortes auch seinen Hintern platt – und begünstigt so das Entstehen der Bananenfalte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
