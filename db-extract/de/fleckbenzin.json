                "senses": [
                    {
                        "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                        "entry_id": "fb452803-23fd-3ffa-8192-5adc8cfa2d84",
                        "glosses": [
                            "zum Reinigen verwendetes raffiniertes Benzin oder Ersatzflüssigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b6e4ec4a-7bc8-493e-99ef-481134942a77",
                                "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                                "text": "„Fleckbenzin, Waschmittel und Gips kaufte ich in der Farbenhandlung Elvira Fürtauer.“"
                            },
                            {
                                "example_id": "2660936b-3dc2-439a-99e1-222a7346ce6b",
                                "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                                "text": "„Durch die sauren Soda-Schwaden und scharfen Gerüche nach Fleckbenzin und anderen Chemikalien hört er die Stimme der Wäschereinfrau: […]“"
                            },
                            {
                                "example_id": "c846e1a1-a5eb-4c21-822f-86f332f55895",
                                "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                                "text": "„‚Den kannst wegschmeißen. Der ist hin‘, stellte sie fachkundig fest. ‚Da hilft nicht einmal mehr Fleckbenzin.‘“"
                            },
                            {
                                "example_id": "3e12f57e-5df1-466f-98b2-f8f9a608c0fe",
                                "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                                "text": "„1853 brannten dort denn auch die ersten Petroleumlampen, und das sich bei der Destillation ergebende Benzin wurde aus Mangel and Einsatzmöglichkeiten überwiegend zur Verdunstung gebracht. Nur zu einem geringen Teil gelangte es als Wund- und Fleckbenzin in Apotheken und Drogerien.“"
                            },
                            {
                                "example_id": "7c257b16-6ad9-48ad-9d2b-bc4bbaa63246",
                                "sense_id": "08a3251e-99cb-3d39-9cd7-2a38d1475a7d",
                                "text": "„Dieses Leichtbenzin ist auch bekannt unter dem Namen Waschbenzin und Fleckbenzin und wurde in Apotheken vertrieben. Die erste Tankstelle der Welt war tatsächlich eine Apotheke.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
