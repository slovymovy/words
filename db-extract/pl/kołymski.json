                            {
                                "target_word": "колымский",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "98939d2f-2722-315a-aa96-0c43f4e21bb0",
                                        "entry_id": "1ce94677-d20e-3247-b6d1-f63440fedb99",
                                        "glosses": [
                                            "расположенный на Колыме, обитающий на Колыме, либо имеющий к этому региону иное непосредственное отношение"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dfc52c8a-7397-4628-b1c3-614c675b9b03",
                                                "sense_id": "98939d2f-2722-315a-aa96-0c43f4e21bb0",
                                                "text": "Так что, когда на колымском прииске убили его брата, он поклялся, что лично покарает убийцу."
                                            },
                                            {
                                                "example_id": "ce81482e-12a6-4b20-aaa6-b4409455968a",
                                                "sense_id": "98939d2f-2722-315a-aa96-0c43f4e21bb0",
                                                "text": "Полжизни провел за колючей проволокой колымских лагерей и лишь чудом избежал смерти."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
