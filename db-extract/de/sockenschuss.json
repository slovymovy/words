                "senses": [
                    {
                        "sense_id": "30293c40-a2c0-335e-8a66-bad21125435c",
                        "entry_id": "33fb2ecf-7375-335d-b3b8-061a20b929fa",
                        "glosses": [
                            "Zusammenheften von Socken oder Strümpfen mit einer Nadel beziehungsweise einem Faden im Textil-/Wäschereiwesen"
                        ],
                        "tags": [
                            "Fachausdruck"
                        ],
                        "examples": [
                            {
                                "example_id": "396d4614-d56c-4fd8-9ec8-8673a1c14acd",
                                "sense_id": "30293c40-a2c0-335e-8a66-bad21125435c",
                                "text": "„Auch Hersteller oder Händler fügen oft das Strumpfpaar mit einem Sockenschuss samt Stofffaden für den Verkauf und zur Sicherheit zusammen, da Strümpfe immer als Paar angeboten werden und als solches vom Kunden auch vorgefunden werden sollte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "011b9b49-864c-3fcd-9304-2866321b549a",
                        "entry_id": "33fb2ecf-7375-335d-b3b8-061a20b929fa",
                        "glosses": [
                            "Ausdruck in Redewendungen in Verbindung mit haben für „spinnen“, leichte Verrücktheit"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "1177e2d1-e436-4428-9f27-a83b63871c68",
                                "sense_id": "011b9b49-864c-3fcd-9304-2866321b549a",
                                "text": "Gewisse Landpomeranzen haben einen Sockenschuss, indem sie in fremde Wohnungen einsteigen und fremde Smartphones hacken lassen."
                            },
                            {
                                "example_id": "830f7f4e-c75b-4ab8-b4e3-1bc644fd0c2b",
                                "sense_id": "011b9b49-864c-3fcd-9304-2866321b549a",
                                "text": "„Katrina hat einen massiven Sockenschuss nach einer Überdosis romantischer Komödien in ihrer Jugend.“"
                            },
                            {
                                "example_id": "9c17d2a0-5889-4070-9841-c1510d4b0c48",
                                "sense_id": "011b9b49-864c-3fcd-9304-2866321b549a",
                                "text": "„Die Frau hatte einen Sockenschuss, einen Knall, der auf keine Kuhhaut ging.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
