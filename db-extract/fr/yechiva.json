                        "entry_id": "4edad4de-b04c-36eb-b689-e4afe17fa85d",
                        "glosses": [
                            "Chez les juifs, établissement d’enseignement supérieur dans lequel l’étude du Talmud et de la Torah est continuelle et intensive."
                        ],
                        "tags": [
                            "Judaism"
                        ],
                        "examples": [
                            {
                                "example_id": "5c8290ba-46aa-4915-9591-591ecf2cbaa5",
                                "sense_id": "7fbb8497-7ba8-32c0-8b7d-9543a7dd17db",
                                "text": "Petit, j'ai fait l'école yechiva. Je ne comprenais rien. C'était du pur par cœur. Mais maintenant, je comprends."
                            }
                        ]
                    }
                ],
