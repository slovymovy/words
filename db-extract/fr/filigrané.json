                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66b312c3-31a6-4de3-9410-b308db6b60e5",
                                "sense_id": "41175b15-5016-3968-9416-38f4e69d0662",
                                "text": "Le papier filigrané destiné à former le devant des cartes désignées ci-dessus, sera fabriqué et fourni par la régie ; les fabricans ne pourront point en employer d’autre."
                            },
                            {
                                "example_id": "610e82ec-2df3-4b1f-9954-180193d58fad",
                                "sense_id": "41175b15-5016-3968-9416-38f4e69d0662",
                                "text": "J’ai retrouvé le contrat qu’elle signa à cette occasion. Deux pages d’un papier bleu ciel, très épais et filigrané, à l’en-tête d’Openfeld-Films."
                            }
                        ]
                    }
