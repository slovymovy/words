                "senses": [
                    {
                        "sense_id": "a249ad35-ca3d-31ad-8e73-b0a8043d5ce1",
                        "entry_id": "1c7c4f81-7531-39c3-a650-605713413f52",
                        "glosses": [
                            "Bien brossé, bien coiffé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "70d39287-e672-4de1-92c4-0b5a09808077",
                                "sense_id": "a249ad35-ca3d-31ad-8e73-b0a8043d5ce1",
                                "text": "Eva Longoria : trop brushée, trop maquillée, son premier fashion faux pas ?!"
                            },
                            {
                                "example_id": "13a2f983-95ff-4af5-86ef-ab5bcba531ea",
                                "sense_id": "a249ad35-ca3d-31ad-8e73-b0a8043d5ce1",
                                "text": "Dans le film de Patrick Rotman sur Jaques Chirac, on le voit en 1980, c’est-à-dire à vingt-cinq ans, en paraissant quatorze, cravate, coupe brushée d’étudiant de droit."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ff6bbc60-ce76-4328-acbd-a1328c4f77df",
                        "source_entry_id": "1c7c4f81-7531-39c3-a650-605713413f52",
                        "source_sense_id": "a249ad35-ca3d-31ad-8e73-b0a8043d5ce1",
                        "target_lang_word": "gebürstet",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gebürstet",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                        "entry_id": "7a85bd65-d25b-3c12-86e3-4e85e157ec92",
                                        "glosses": [
                                            "mit einer Bürste behandelt, wodurch eine matte, strukturierte oder gleichmäßige Oberfläche entsteht"
                                        ],
                                        "tags": [
                                            "Materialien",
                                            "Stoffe"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b90ad44b-17a8-4bbe-b135-bfd46d194489",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Das Gehäuse besteht aus schwarzem gebürstetem Aluminium.“"
                                            },
                                            {
                                                "example_id": "bf29d9cb-0b50-4a36-a761-9e786a3fd63a",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Am linken und rechten Rand sind ins schwarze Glas zwei Elektroden aus gebürstetem Edelstahl eingelassen, über die der Strom geleitet wird, um den Anteil an Körperfett zu messen.“"
                                            },
                                            {
                                                "example_id": "a2c18477-5a89-4c09-876b-935fa9b6cbae",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Die gebürstete Innenseite fühlt sich besonders weich und schön auf der Haut an.“"
                                            },
                                            {
                                                "example_id": "74fd5d75-00ae-4007-b326-68a7a94c51b0",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Durch das gebürstete und lackierte Salzkammergut-Eichefurnier strahlt das ca. 32 x 50 x 55 cm (BxHxT) große TV-Unterteil 1113L aus der Interliving Wohnzimmer Serie 2023 moderne Eleganz und gemütlichen Naturcharme aus.“"
                                            },
                                            {
                                                "example_id": "7399bdd9-4abb-45c6-bec1-6aa2613b9e42",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Seine schlanke und wertige Optik bekommt er durch das gebürstete Gestell mit fünf einzelnen Rollenarmen.“"
                                            },
                                            {
                                                "example_id": "76c46436-a25f-4852-9b02-9aabd1fde4b7",
                                                "sense_id": "c9b72f0a-4ad6-3f38-a9a8-74ca808879a4",
                                                "text": "„Die gebürstete Oberfläche verleiht dieser Garderobe einen ganz eigenen, Used-Look, der einerseits rustikal, andererseits aber auch spielerisch leicht wirkt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                        "entry_id": "7a85bd65-d25b-3c12-86e3-4e85e157ec92",
                                        "glosses": [
                                            "mit einer Bürste behandelt (gepflegt, gestylt)"
                                        ],
                                        "tags": [
                                            "Haar, Fell"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3086a43b-9492-4313-af04-663856f93f79",
                                                "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                                "text": "„Geben Sie das Öl großzügig in das trockene, gut gebürstete Haar.“"
                                            },
                                            {
                                                "example_id": "e4a3ce48-8cfe-486d-9e30-e686c42204c6",
                                                "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                                "text": "„Die einzigartigen flaschenförmigen Borsten dieser Haarbürste sorgen dafür, das jede Frisur, egal ob Hochsteckfrisur, entspannte gebürstete Wellen oder eine voluminöse Frisur glatt und glänzend wird.“"
                                            },
                                            {
                                                "example_id": "1dd1768b-c55c-4085-a02c-75c7cbb1e147",
                                                "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                                "text": "„Zur Schulzeiten habe ich am liebsten riesige Dutts, mit Hilfe eines Kissens getragen, im Studium dann locker gesteckte Frisuren und mittlerweile gerne gebürstete und streng gesteckte Dutts, weil sie trotz ihres minimalen Aufwands schick und nach Boss-Babe aussehen.“"
                                            },
                                            {
                                                "example_id": "74956ada-23cb-43cc-8253-c7c0335615d2",
                                                "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                                "text": "„Er hatte dunkelblaue Augen, eine helle Haut und feine, braune – stets gut gebürstete – Haare … Er bot einen derart sauberen und ordentlichen Anblick, dass fast jeder neben ihm ungepflegt wirkte …“"
                                            },
                                            {
                                                "example_id": "3355c41d-e88c-4170-b155-385d3ef34bfd",
                                                "sense_id": "1210cdec-5d90-3740-a6b6-2b0e86f6bbde",
                                                "text": "„Klassisch gestyltes Haar sieht immer edel und elegant aus und passt zu jedem Outfit, etwa als glatt gebürstete Langhaarfrisur, Pony Tail oder Updo.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
