                "senses": [
                    {
                        "sense_id": "275c07ef-6c61-33fc-a973-dc5e80ba4b48",
                        "entry_id": "817c6ca0-d53a-362c-8499-0cd97660ee13",
                        "glosses": [
                            "een baan waar men voor weinig werk veel loon ontvangt"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "898cd6b0-42da-4bc0-86e7-971e7eff8d2e",
                                "sense_id": "275c07ef-6c61-33fc-a973-dc5e80ba4b48",
                                "text": "Platini heeft zich suf gelobbyd voor de toekenning van het WK aan Qatar. Inmiddels bekleedt zijn niet al te snuggere zoon een luizenbaan in Qatar."
                            },
                            {
                                "example_id": "2e6a754e-bddc-45d3-825b-9c125e41ea86",
                                "sense_id": "275c07ef-6c61-33fc-a973-dc5e80ba4b48",
                                "text": "Huisartsen krijgen de gevolgen over zich heen van een maatschappij waarin 'welzijn' een vies woord is geworden in de politiek, de 24-uurs economie dagelijks meer slachtoffers maakt en marktwerking het Gouden Kalf is. Tegelijkertijd worden ze neergezet als 'graaiers' met een luizenbaan. Minister Schippers, die politicologie heeft gestudeerd en alleen de Haagse kringen van binnen en buiten kent, heeft geen flauw besef van de fysieke en psychische belasting van het huisartsenberoep."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "664fe936-cce5-4627-b08a-ed0caeffabcc",
                        "source_entry_id": "817c6ca0-d53a-362c-8499-0cd97660ee13",
                        "source_sense_id": "275c07ef-6c61-33fc-a973-dc5e80ba4b48",
                        "source_sense_description": "(pejoratief) een baan waar men voor weinig werk veel loon ontvangt",
                        "target_lang_word": "sinecure",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sinecure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                        "entry_id": "5f03727e-c911-33ca-9e75-1fbc2979df72",
                                        "glosses": [
                                            "A position that requires little to no work, or easy work, but still gives an ample payment; a cushy job."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01cffd1e-cc11-4b16-a577-70a0cc5ba074",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "Miss Briggs was not formally dismissed, but her place as companion was a sinecure and a derision […]"
                                            },
                                            {
                                                "example_id": "9c91317b-34c5-413a-b712-29daf57834e9",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "A lucrative sinecure in the Excise was bestowed on Ferguson."
                                            },
                                            {
                                                "example_id": "b5a0cb07-5c30-4529-9d53-2df895a323a1",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "His prospects consisted of a hope that if he kept up appearances somebody would do something for him. The something appeared vaguely to his imagination as a private secretaryship or a sinecure of some sort."
                                            },
                                            {
                                                "example_id": "d49d2454-8153-4d0c-8f87-5f5609c250aa",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "With extra traffic, numerous boat trains to and from Southampton Docks, and working of empty stock, his job, like that of most signalmen, is no sinecure."
                                            },
                                            {
                                                "example_id": "e879be6f-8500-4b90-8b9a-6c3ffb20bcd8",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "In the ADF, while the numbers vary between the individual services and the reserves, employment is no comfortable sinecure for any personnel and thus does not appeal to many people, male or female, especially under current pay scales."
                                            },
                                            {
                                                "example_id": "f1a85cd9-2713-4ad1-be6e-e2233d346c7d",
                                                "sense_id": "199f905d-1a3d-382e-974e-758fb84a8ed6",
                                                "text": "However, by the time of World War II (if not before), politics, at least in the federal sphere, was no longer regarded as sinecure for well-intentioned part-timers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff60e789-baad-39ca-ad02-00ba0bff349a",
                                        "entry_id": "5f03727e-c911-33ca-9e75-1fbc2979df72",
                                        "glosses": [
                                            "An ecclesiastical benefice without the care of souls."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sinecure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e7f16168-4185-33df-b099-8339facf9e46",
                                        "entry_id": "a55a31c0-9fe8-306e-ad3a-393e8f4329a2",
                                        "glosses": [
                                            "Requiring no work for an ample reward."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9618f7d9-0999-4945-ae3d-71f425a9a986",
                                                "sense_id": "e7f16168-4185-33df-b099-8339facf9e46",
                                                "text": "By the act of union (1800), the offices of Irish secretary, a sinecure post, and lord lieutenant's secretary were combined."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd8265ae-75dc-3c59-ad03-b31a47fd6a8f",
                                        "entry_id": "a55a31c0-9fe8-306e-ad3a-393e8f4329a2",
                                        "glosses": [
                                            "Having the appearance of functionality without being of any actual use or purpose."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04d5c355-616a-4365-a7ec-6f599325d791",
                                                "sense_id": "dd8265ae-75dc-3c59-ad03-b31a47fd6a8f",
                                                "text": "The old man hastily pulled down his spectacles from their sinecure office on his forehead, and looked at her with an expression of most angry amazement."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sinecure",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "256623d2-f511-3884-8c7e-77bee4b58e5d",
                                        "entry_id": "d9c2ca1f-b875-3247-9940-974b88af265f",
                                        "glosses": [
                                            "To put or place in a sinecure."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
