                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                        "entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
                        "glosses": [
                            "Protection or patronage."
                        ],
                        "tags": [
                            "plural",
                            "plural-only"
                        ],
                        "examples": [
                            {
                                "example_id": "3eacc17c-847f-47e7-aba7-2653a751cdde",
                                "sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                                "text": "The project took place under the auspices of the local church."
                            },
                            {
                                "example_id": "fcb8ce46-8f94-4746-970f-a86234ea8a08",
                                "sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                                "text": "\"You are of the old school, Sir Robert, I know; but, still, even you must allow that a fancy fair does good—many a sinking charity has been revived under its auspices, many a principle of care for our humble classes been implanted in the young heart, and—\""
                            },
                            {
                                "example_id": "d6f6ef43-6b8f-4855-8c12-44efa72d4db9",
                                "sense_id": "a92a5e33-2dd9-33b3-a3ba-f69f039666d3",
                                "text": "Lynch added: \"Our findings from our FOI requests on ticket office closures shows the whole process to be a stitch-up between the train operators, under the auspices of the Rail Delivery Group[,] and ministers."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "123b9f72-d085-4639-b8a4-9ac9efcdcf62",
                        "source_entry_id": "7d4eb097-834f-3d24-8370-d3c7fbbcc3ed",
