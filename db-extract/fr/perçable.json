                        "examples": [
                            {
                                "example_id": "b6b8edbe-9241-46c4-b4c3-21231321b8ed",
                                "sense_id": "a8dfbb34-8fbf-38e0-a3aa-19ebfd16d610",
                                "text": "De Toul à Thionville, sa ligne, trop longue, trop mince, eut été partout perçable, et pour tenir quelque temps en respect le flot germanique, il lui eut fallu des qualités et une fortune telles qu’aucun général avisé n’en doit faire la base habituelle de ses combinaisons."
                            },
                            {
                                "example_id": "e95854fb-0c13-4fed-90f6-aaa307d73c8e",
                                "sense_id": "a8dfbb34-8fbf-38e0-a3aa-19ebfd16d610",
                                "text": "Il existe des modèles perfectionnés avec membrane perçable avec une aiguille à la demande, de façon à réguler l'issue des gaz, ce qui permet une vie de société sans émission de bruit incontrôlable."
                            }
                        ]
