                    {
                        "translation_id": "786f5cf2-e701-4a4e-992f-2cae32e3df91",
                        "source_entry_id": "dab6580f-a474-364d-a85b-de0da1c81c14",
                        "source_sense_id": "ce08aa25-7bb2-3bdf-b9a9-251062a1090c",
