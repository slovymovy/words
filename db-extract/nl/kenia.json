                                "target_senses": [
                                    {
                                        "sense_id": "2b5e4bf9-eccd-3663-825c-e004d7fa5dce",
                                        "entry_id": "bbcf2c8a-6212-3907-978c-fe4cf77b8dd0",
                                        "glosses": [
                                            "A country in East Africa. Official name: Republic of Kenya."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dacbd13d-5933-4711-b5c0-e39f0d5ac8df",
                                                "sense_id": "2b5e4bf9-eccd-3663-825c-e004d7fa5dce",
                                                "text": "The object of the builders was to push on to Uganda as quickly as possible; one result was that Kenya was \"discovered\" on the way."
                                            },
                                            {
                                                "example_id": "31826f4d-5d45-4ee8-b635-3d738bd6819e",
                                                "sense_id": "2b5e4bf9-eccd-3663-825c-e004d7fa5dce",
                                                "text": "Thomas was born in 1986, at a US military hospital in Frankfurt, Germany, to a mother born in Kenya and a US citizen father who eventually spent more than a decade in the military, where he repaired Army helicopters."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2eca7ac6-ae49-4762-8d67-a4171b300c54",
                        "source_entry_id": "538c569f-a9ec-391a-9779-33d586dafc5f",
                        "source_sense_id": "80b2b09a-65d8-31ea-b35e-a8767aa071a9",
                        "source_sense_description": "een land in Oost-Afrika, de Republiek Kenia, grenzend aan Somalië, Ethiopië, Oeganda, Tanzania en de Indische Oceaan",
                        "target_lang_word": "Kenya",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kenya",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                        "entry_id": "c0b51acb-d48c-3ea2-9738-cfd084a6bd78",
                                        "glosses": [
                                            "Pays d’Afrique de l’Est, entouré par le Soudan du Sud et l’Éthiopie au nord, la Somalie et l’océan Indien à l’est, l’Ouganda à l’ouest et la Tanzanie au sud. Sa capitale est Nairobi."
                                        ],
                                        "tags": [
                                            "Pays"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e3fccd2b-f43a-44af-8433-a74890fbea26",
                                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                                "text": "Et, avant de regagner l’Europe, j’avais résolu de passer par un des Parcs royaux du Kenya, ces réserves où des lois d’une rigueur extrême protègent les bêtes sauvages dans toutes les formes de leur vie."
                                            },
                                            {
                                                "example_id": "0e0373ab-766e-48fc-aa53-d402af99d957",
                                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                                "text": "Le bongo se rencontre en zone forestière de l’Ouest africain jusqu’au Kenya et en Ouganda ; il n’en est pas moins la plus rare des grandes antilopes et sa protection est une nécessité impérieuse."
                                            },
                                            {
                                                "example_id": "5f2beafa-5ef9-4d2d-8568-e5360f08488a",
                                                "sense_id": "ff181366-37d1-3122-9a48-42f07cce59eb",
                                                "text": "Je voulais aller au Kenya, photographier les Masai et les neiges du Kilimandjaro."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
