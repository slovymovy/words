                ],
                "senses": [
                    {
                        "sense_id": "fc8b3bd0-409b-3968-a6f0-3d67a3ca022b",
                        "entry_id": "1c4198d4-d35d-39a2-a9d1-4dc6aef6c742",
                        "glosses": [
                            "(о комнатных животных) вывести на прогулку"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca33e8f7-d437-49d4-802a-2639ee851efc",
                                "sense_id": "fc8b3bd0-409b-3968-a6f0-3d67a3ca022b",
                                "text": "Выгулять щенка."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6632b284-6eb5-4483-97bd-1def0d0a5f99",
                        "source_entry_id": "1c4198d4-d35d-39a2-a9d1-4dc6aef6c742",
                        "source_sense_id": "fc8b3bd0-409b-3968-a6f0-3d67a3ca022b",
                        "target_lang_word": "promener",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "promener",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                                        "entry_id": "7e93f269-dd8b-3d02-956a-66b48e243a1d",
                                        "glosses": [
                                            "Mener, conduire, faire aller quelqu’un de côté ou d’autre, soit pour l’amuser, soit pour qu’il prenne de l’exercice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f141f59b-7451-4ef1-8b83-92dab254f624",
                                                "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                                                "text": "À quelques mètres, Roseline promène Murphy, son chien."
                                            },
                                            {
                                                "example_id": "5e82ae4c-cedd-486a-9311-30e0b169f7b5",
                                                "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                                                "text": "Promener des étrangers par la ville, dans la ville, La leur faire parcourir, la leur faire voir."
                                            },
                                            {
                                                "example_id": "6ce0fc7a-82d5-4bea-b810-360d02822a8f",
                                                "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                                                "text": "Promener un cheval, le faire marcher doucement, soit en le tenant par la bride, soit en le montant."
                                            },
                                            {
                                                "example_id": "34fdc9ea-d711-431d-bb2d-46e442025629",
                                                "sense_id": "bdd9c93c-db09-3dbb-a6f1-053744e097e1",
                                                "text": "Promener un enfant, un vieillard, un malade."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bf55a06-0143-3326-88e3-bfff518b0006",
                                        "entry_id": "7e93f269-dd8b-3d02-956a-66b48e243a1d",
                                        "glosses": [
                                            "Faire une promenade."
                                        ],
                                        "tags": [
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "26455674-dcb0-3ee1-8b42-ba3cfb667bca",
                                        "entry_id": "7e93f269-dd8b-3d02-956a-66b48e243a1d",
                                        "glosses": [
                                            "Se promener, faire une promenade."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "92d386ec-c0b3-4fde-9195-b09f141b859f",
                                                "sense_id": "26455674-dcb0-3ee1-8b42-ba3cfb667bca",
                                                "text": "Général, nous allons promener…"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                        "entry_id": "7e93f269-dd8b-3d02-956a-66b48e243a1d",
                                        "glosses": [
                                            "Faire aller ; porter de côté et d’autre."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f7103a2b-21fc-476a-ad02-aebe3f5cb356",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Celui qui, au sommet de l’Etna promène à loisir ses yeux autour de lui, est principalement affecté par l’étendue et par la diversité du tableau."
                                            },
                                            {
                                                "example_id": "f65d20fc-96c0-4ee5-b108-a086c4dc0572",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Je commande un pastis, et je promène mon œil dans la salle. Rien que de très ordinaire : au bout du comptoir, un client quelconque joue au 421 avec une brune au décolleté vertigineux."
                                            },
                                            {
                                                "example_id": "82f58b9c-c0a1-43b8-9db5-f4689a0364b9",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Une dizaine de mioches assis sur une natte en raphia ânonnaient en chœur l'alphabet hébraïque dessiné sur une planche en bois d’arar (thuya) sur laquelle le rabbin promenait son doigt."
                                            },
                                            {
                                                "example_id": "bbe53b75-ce42-4993-9d04-cfcb7219c302",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Promener son esprit, son imagination, ses pensées sur divers objets."
                                            },
                                            {
                                                "example_id": "a6b342db-e78f-49fa-9f83-22ed099b5184",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Ce romancier promène ses lecteurs dans toutes les parties du monde."
                                            },
                                            {
                                                "example_id": "2e7c6fbb-9c43-4616-9b7b-dd18182a3bd4",
                                                "sense_id": "4ae13526-db1d-3f1a-a741-faa96069a3b6",
                                                "text": "Il promène en tous lieux son inquiétude, son chagrin, son ennui, son oisiveté."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b05aa2c5-9835-360a-8bde-5d4305e75d7f",
                                        "entry_id": "7e93f269-dd8b-3d02-956a-66b48e243a1d",
                                        "glosses": [
                                            "Abuser, lasser par des délais, par des promesses vaines, mener en bateau."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1676c0eb-60f3-42e6-b803-d21acab01d4d",
                                                "sense_id": "b05aa2c5-9835-360a-8bde-5d4305e75d7f",
                                                "text": "Promener quelqu’un."
                                            },
                                            {
