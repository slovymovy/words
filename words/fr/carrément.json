                    "frequency": "High",
                    "semantic_group_id": "intensite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce film est <w>carrément</w> génial, je te conseille vivement d'aller le voir au cinéma."
                        },
                        {
                            "text": "Il refuse de nous accompagner parce qu'il trouve cette proposition <w>carrément</w> absurde."
                        }
                    ],
                    "common_phrases": [
                        "carrément faux",
                        "carrément impossible"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
