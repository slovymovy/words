                "senses": [
                    {
                        "sense_id": "6e5f7965-aad8-3a6e-a257-c07022d0bc47",
                        "entry_id": "0be9d163-f785-367c-8a80-174cd2404e36",
                        "glosses": [
                            "разг. будучи виновником торжества, поставлять в компанию угощения для совместного празднования"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d541e9a9-5aaf-4ca0-b8c0-a563bf5f9e66",
                                "sense_id": "6e5f7965-aad8-3a6e-a257-c07022d0bc47",
                                "text": "Я отвлёкся! Деньги давай ― проставляться! Митя вынул стотысячную купюру."
                            },
                            {
                                "example_id": "d552e6e3-d6d3-4a85-a4de-8b33740a1c3d",
                                "sense_id": "6e5f7965-aad8-3a6e-a257-c07022d0bc47",
                                "text": "Очередная история: ***** вручили благодарность Путина. Он проставлялся. Представляешь, заказал пиццу."
                            }
                        ]
                    },
                    {
                        "sense_id": "9f57ebe2-9bad-371e-95b6-39684b9337c0",
                        "entry_id": "0be9d163-f785-367c-8a80-174cd2404e36",
                        "glosses": [
                            "вноситься, записываться"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4753a166-2474-4b82-a063-b6743dd155e8",
                                "sense_id": "9f57ebe2-9bad-371e-95b6-39684b9337c0",
                                "text": "На протоколе проставляется дата заседания, а не окончательного оформления или подписания протокола."
                            }
                        ]
                    }
