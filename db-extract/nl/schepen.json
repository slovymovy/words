                        "target_lang_word": "alderman",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alderman",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "2e570775-0306-30a2-85c7-e41f5968b0b7",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A member of a municipal legislative body in a city or town."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A half-crown coin; its value, 30 pence."
                                        ],
                                        "tags": [
                                            "UK",
                                            "historical",
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44bafc12-4d8d-42a3-ad0e-ec9cd96db708",
                                                "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                                "text": "The price of a case (five shillings piece bad) from the smasher is about one shilling; an alderman (two and sixpence) about sixpence; a peg (shilling) about threepence; a downer or sprat (sixpence) about twopence."
                                            },
                                            {
                                                "example_id": "06dbd465-4913-47b8-948d-9ce855bc6c93",
                                                "sense_id": "80dafe67-b92e-3779-80b3-a3fb1665f8c1",
                                                "text": "Half-a-crown is known as an alderman, half a bull, half a tusheroon, and a madza caroon; whilst a crown piece, or five shillings, may be called either a bull, or a caroon, or a cartwheel, or a coachwheel, or a thick-un, or a tusheroon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ca52fe85-1644-33e6-b8e8-c1e747a07e93",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A long pipe for smoking."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "564640d9-239d-4001-be73-0c0c2e928236",
                                                "sense_id": "ca52fe85-1644-33e6-b8e8-c1e747a07e93",
                                                "text": "In one part of Cockaigne an amalgamation of these two last has lately taken place; and the pleasure experienced by the parishioners of Walbrook is unbounded when smoking an alderman and churchwarden."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b782fcac-4f5c-3187-8e62-7c84a1a17e21",
                                        "entry_id": "095e07e1-c7fe-3866-9fdc-0449d5f60fc6",
                                        "glosses": [
                                            "A large, protruding, or swollen abdomen; a paunch, a potbelly."
                                        ],
                                        "tags": [
                                            "US",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32fc0957-953b-4cc6-851d-f65a884a9141",
                                                "sense_id": "b782fcac-4f5c-3187-8e62-7c84a1a17e21",
                                                "text": "He'd exercise, get the fat off, because if he let it go, he'd have too much on and maybe make his heart worse, and you looked like hell with an alderman. […] And she wouldn't want a guy who stuck out in front like a balloon."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f65bd3eb-8f00-4c66-8edb-3d163087366c",
                        "source_entry_id": "f73697ec-0dba-3257-a4f8-e3cae8cf41c3",
                        "source_sense_id": "38c63334-ecc1-37d5-b54f-6ef859e2fc33",
                        "source_sense_description": "ambt",
                        "target_lang_word": "échevin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "échevin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3d580ac0-38e8-3742-8eb9-ef49c375872e",
                                        "entry_id": "d61d9e9e-d7dc-30d3-955a-5199a672df39",
                                        "glosses": [
                                            "Dans l’empire carolingien (à partir du IXᵉ siècle), juge adjoint du tribunal comtal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3de0f8db-cec2-4cd0-96a3-d4b3f74e4d49",
                                                "sense_id": "3d580ac0-38e8-3742-8eb9-ef49c375872e",
                                                "text": "Il était en effet un peu dur ... d'être obligé de faire fête en bon accueil, lui Charles de Bourbon, à je ne sais quels bourgeois; lui cardinal, à des échevins"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1224c752-db7a-3940-bdcf-7db3815f0041",
                                        "entry_id": "d61d9e9e-d7dc-30d3-955a-5199a672df39",
                                        "glosses": [
                                            "Dans les villes du Nord de la France (puis dans la plupart des villes du royaume de France), magistrat municipal (fonction aujourd’hui dévolue au seul maire qui préside la municipalité au nom du peuple souverain, mais avec des pouvoirs plus limités) dont la charge était de représenter les pouvoirs fondamentaux du souverain sur ses terres, et donc d’y faire appliquer le droit des individus et sociétés, d’y organiser la police et la perception pour lui des taxes et de l’échet."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7377f35f-38cc-4a0c-b7db-fc6473bab4e4",
                                                "sense_id": "1224c752-db7a-3940-bdcf-7db3815f0041",
                                                "text": "Premier, second échevin."
                                            },
                                            {
                                                "example_id": "a1d3018a-cc08-4258-ba78-5da1782ae300",
                                                "sense_id": "1224c752-db7a-3940-bdcf-7db3815f0041",
                                                "text": "Le prévôt des marchands et les échevins de Paris."
                                            },
                                            {
                                                "example_id": "5d9e93eb-2398-4d36-9223-8b2ad1e1da83",
                                                "sense_id": "1224c752-db7a-3940-bdcf-7db3815f0041",
                                                "text": "Les échevins de Toulouse étaient appelés capitouls."
                                            },
                                            {
                                                "example_id": "33991a73-9848-49ce-a615-3abade68de0b",
                                                "sense_id": "1224c752-db7a-3940-bdcf-7db3815f0041",
                                                "text": "On y avait naguère retenu un échevin accusé de malversations et, plus anciennement, un seigneur gagné à prix d’or au parti français ; rien n’était plus convenable qu’un tel lieu de détention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5580cee9-4a5e-3649-a929-8c88a93ecfc5",
                                        "entry_id": "d61d9e9e-d7dc-30d3-955a-5199a672df39",
                                        "glosses": [
                                            "Membre du collège communal à fonction exécutoire présidé par le bourgmestre, chargé d’un domaine de l’administration communale. Il est élu par le conseil communal en son sein, une entité distincte à fonction décisionnelle."
                                        ],
                                        "tags": [
                                            "Belgique",
                                            "Luxembourg"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a97a22b-e7f5-49b2-afad-f42e51586529",
                                                "sense_id": "5580cee9-4a5e-3649-a929-8c88a93ecfc5",
                                                "text": "Le bourgmestre et ses échevins de l’état civil, et des travaux publics."
                                            },
                                            {
                                                "example_id": "87c67bbd-dbeb-422e-bf60-928dcbb884ca",
                                                "sense_id": "5580cee9-4a5e-3649-a929-8c88a93ecfc5",
                                                "text": "Il a été nommé échevin de la culture."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5ee34743-65ac-3010-ab22-f88bb5e05474",
                                        "entry_id": "d61d9e9e-d7dc-30d3-955a-5199a672df39",
                                        "glosses": [
                                            "Adjoint au maire, conseiller municipal représentant d’un quartier donné."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b34f7bd-2dd7-4cd0-9650-30f62fd91dce",
                                                "sense_id": "5ee34743-65ac-3010-ab22-f88bb5e05474",
                                                "text": "Il a été échevin pour le quartier Saint-Roch."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
