                        "glosses": [
                            "приготовленный из ветчины или с ветчиной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55d69f57-96ec-4a54-8413-e08313f54062",
                                "sense_id": "6ddd7205-4bb9-369d-a2f4-4f6137745f48",
                                "text": "Ел Володя без суеты и опрятно, загодя обдирая колбасную кожуру и обрезая лишнюю ветчину по краю бутерброда. Из обрезков он потом устроил себе отдельный бутерброд, крытый ветчинной мозаикой."
                            }
                        ]
