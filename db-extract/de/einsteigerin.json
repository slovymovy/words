                    {
                        "sense_id": "19ef202f-d74d-3d5e-8922-9f94ef447576",
                        "entry_id": "f646807c-73e1-354a-9f13-8833730a9340",
                        "glosses": [
                            "weibliche Person, die einsteigt, etwas Neues anfängt, beginnt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1547808-70e1-4a75-85cf-9d49e745c00f",
                                "sense_id": "19ef202f-d74d-3d5e-8922-9f94ef447576",
                                "text": "Eine Einsteigerin muss natürlich wesentlich mehr Zeit für Routineaufgaben aufwenden, als das später der Fall ist, wenn man seine Geschäftsabläufe gelernt und feingetunt hat."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "900580cf-d022-4ef9-9b75-e0e23260aa99",
                        "source_entry_id": "f646807c-73e1-354a-9f13-8833730a9340",
