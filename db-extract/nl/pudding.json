                                "target_senses": [
                                    {
                                        "sense_id": "9627f915-06b8-3ec0-9a3f-0f52264c438f",
                                        "entry_id": "1755ef0d-c4b6-324a-b5b2-a05bb94bb67a",
                                        "glosses": [
                                            "meist kalt servierte Süßspeise, die meist durch Aufkochen von Milch mit Stärke, Grieß oder Eiern zubereitet wird"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61055545-ea95-442e-9b28-b830f57ef5da",
                                                "sense_id": "9627f915-06b8-3ec0-9a3f-0f52264c438f",
                                                "text": "Viele Menschen essen gerne Pudding."
                                            },
                                            {
                                                "example_id": "6579ef41-2507-49dd-b6ce-b24b3ca25565",
                                                "sense_id": "9627f915-06b8-3ec0-9a3f-0f52264c438f",
                                                "text": "Pudding wird oft als Nachspeise gereicht."
                                            },
                                            {
                                                "example_id": "8cf91c29-1a2c-4417-bc36-3f80017bc70c",
                                                "sense_id": "9627f915-06b8-3ec0-9a3f-0f52264c438f",
                                                "text": "„Die Mahlzeit wurde mit einem Pudding beschlossen; in beträchtlichen Mengen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cf8e7f8a-3801-4c7e-bcb5-d0a183eb06b5",
                        "source_entry_id": "ae01b04d-9ee7-36d0-9353-10402fb3df12",
                        "source_sense_id": "ae070956-369a-37ce-9a99-727a30a9746b",
