                                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                                "text": "Placing the hoops in this position makes skirts hip hop with a swirl."
                                            },
                                            {
                                                "example_id": "edc6efe1-6060-45d4-b0ed-d9c8e29f59d1",
                                                "sense_id": "6265ab20-c4ca-3341-a14b-c5afccd81080",
                                                "text": "I have a bunny and he goes hip hop, I often wonder if he cannot stop."
                                            },
