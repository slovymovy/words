                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The children are <w>jumping</w> on the bed despite the rules.",
                            "target_lang_translations": {
                                "ru": "Дети <w>прыгают</w> на кровати, несмотря на правила.",
                                "zh": "尽管有规定，孩子们还是在床上<w>跳</w>。",
                                "nl": "De kinderen zijn op het bed aan het <w>springen</w>, ondanks de regels.",
                                "pl": "Dzieci <w>skaczą</w> na łóżku, mimo zakazów.",
                                "de": "Die Kinder <w>springen</w> trotz der Regeln auf dem Bett.",
                                "fr": "Les enfants <w>sautent</w> sur le lit malgré les règles.",
                                "it": "I bambini stanno <w>saltando</w> sul letto nonostante le regole.",
                                "cs": "Děti <w>skáčou</w> na posteli navzdory pravidlům.",
                                "tr": "Çocuklar kurallara rağmen yatakta <w>zıplıyorlar</w>.",
                                "es": "Los niños están <w>saltando</w> en la cama a pesar de las reglas."
                            }
                        },
                        {
                            "text": "He was <w>jumping</w> up and down with excitement when he heard the news.",
                            "target_lang_translations": {
                                "ru": "Он <w>прыгал</w> от радости, когда услышал новости.",
                                "zh": "他听到这个消息时，兴奋得又<w>跳</w>又叫。",
                                "nl": "Hij stond op en neer te <w>springen</w> van opwinding toen hij het nieuws hoorde.",
                                "pl": "Podskakiwał z radości, gdy usłyszał te wieści.",
                                "de": "Er <w>sprang</w> vor Aufregung auf und ab, als er die Nachrichten hörte.",
                                "fr": "Il <w>sautait</w> de joie en apprenant la nouvelle.",
                                "it": "Stava <w>saltando</w> su e giù per l'eccitazione quando ha sentito la notizia.",
                                "cs": "Když uslyšel tu zprávu, vzrušením <w>skáky</w> radostí.",
                                "tr": "Haberi duyduğunda heyecandan yerinde <w>zıplıyordu</w>.",
                                "es": "Él estaba <w>saltando</w> de emoción cuando escuchó las noticias."
                            }
                        }
                    ],
