                ],
                "senses": [
                    {
                        "sense_id": "46c195da-56e7-3b2a-9e49-6955a1df112f",
                        "entry_id": "1d3aeb00-40a7-3372-b4fa-a34640454e18",
                        "glosses": [
                            "свойство по значению прилагательного враждебный"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b023821-895f-4906-852e-177f528d5c9d",
                                "sense_id": "46c195da-56e7-3b2a-9e49-6955a1df112f",
                                "text": "Когда она думала о Вронском, ей представлялось, что он не любит ее, что он уже начинает тяготиться ею, что она не может предложить ему себя, и чувствовала враждебность к нему за это."
                            },
                            {
                                "example_id": "27466030-730f-44d3-a0b1-b10275feb329",
                                "sense_id": "46c195da-56e7-3b2a-9e49-6955a1df112f",
                                "text": "Как только он увидал высунувшегося из двери французского офицера, это чувство войны, враждебности, которое он всегда испытывал при виде неприятеля, вдруг обхватило его."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5e7adcbb-c30a-4616-8dd3-b24cc3bca609",
                        "source_entry_id": "1d3aeb00-40a7-3372-b4fa-a34640454e18",
                        "source_sense_id": "46c195da-56e7-3b2a-9e49-6955a1df112f",
                        "target_lang_word": "hostility",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hostility",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "The state of being hostile."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2d59f2fc-f757-4a0f-85cf-c745b6ed3b97",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "My resentment and anger towards you caused hostility and a division between us."
                                            },
                                            {
                                                "example_id": "ea990558-94ef-4c52-a74f-572894267c08",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "There is no hostilitie so excellent, as that which is absolutely Christian."
                                            },
                                            {
                                                "example_id": "bced59d3-8aa0-4a69-9d9c-dd8efade346a",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "But with Goodison Park openly directing its full hostility towards Atkinson, Liverpool went ahead when Carroll turned in his first Premier League goal of the season after 70 minutes."
                                            },
                                            {
                                                "example_id": "c080f4fe-3a47-4e2e-a9af-933eec9ccc11",
                                                "sense_id": "29661ecd-04c5-3c0c-8fe5-cd5d80031cc7",
                                                "text": "The polarization of wealth and the polarization of attitudes to diversity are not unrelated. A key reason for popular hostility to immigrants is that to many people, particularly within working-class communities, immigration has become a symbol of unacceptable change."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                        "entry_id": "537e2829-e992-34e3-a7f9-dcdab7f0f044",
                                        "glosses": [
                                            "A hostile action, especially a military action. See hostilities for specific plural definition."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5eb4c81c-aec6-4f2b-a0b6-e46a68b42b43",
                                                "sense_id": "5de9e25f-7825-3008-a6f2-f917c727d100",
                                                "text": "As the revivals died down in the 1740s, the revivalist camp made concessions to their opponents, admonished prorevivalists who continued with the hostilities, and generally sought to heal divisions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4bcbb111-7f02-40b7-af2b-f78c97260325",
                        "source_entry_id": "1d3aeb00-40a7-3372-b4fa-a34640454e18",
                        "source_sense_id": "46c195da-56e7-3b2a-9e49-6955a1df112f",
                        "target_lang_word": "animosity",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "animosity",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                        "entry_id": "e47a4cb0-fb51-343a-85c1-47216a892c44",
                                        "glosses": [
                                            "Violent hatred leading to active opposition; active enmity; energetic dislike."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eeb79906-8d9b-402b-89d2-5b9912373791",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "There was open animosity between the two rival teams."
                                            },
                                            {
                                                "example_id": "0db2148f-7c2b-4474-ba57-18c1ba35439c",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Despite years of conflict, she felt no animosity toward him."
                                            },
                                            {
                                                "example_id": "5c4a7c69-fd24-4ca7-a439-a97ceff0d877",
                                                "sense_id": "4aa5601c-6868-3295-a9cb-e08f0be1be0f",
                                                "text": "Political debates often stir up animosity."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f443e88f-753f-49c2-ac47-0d831192c1d5",
