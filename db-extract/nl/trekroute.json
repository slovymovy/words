                        "glosses": [
                            "de route die dieren nemen als ze van het ene leefgebied naar het andere gaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e310f465-5276-4399-b1af-0e6107f22d92",
                                "sense_id": "ddabe4d4-a2f1-3522-a134-448a7da346af",
                                "text": "Bij de windturbines vallen jaarlijks enkele duizenden vogelslachtoffers. Daarvan is circa 45 procent een trekvogel. Juist het Eemshavengebied is een belangrijke trekroute voor veel vogelsoorten."
                            },
                            {
                                "example_id": "cda29b1b-a1b2-4f8a-949c-f51c3bbea789",
                                "sense_id": "ddabe4d4-a2f1-3522-a134-448a7da346af",
                                "text": "Ze zijn bont, en uniek getekend. Wellicht is deze walvis ook elders gefotografeerd en vinden we zijn foto en dus zijn trekroute nog terug.”"
                            }
                        ]
                    }
