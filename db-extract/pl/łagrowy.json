                        "sense_id": "a994ae0b-c606-35ce-b741-1e8be102e51a",
                        "entry_id": "ca1c145f-aa74-3aaf-b7c3-090cf5127497",
                        "glosses": [
                            "odnoszący się do łagru, związany z łagrem"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "69c5fa81-ce10-4a66-8342-0cc4e6f68bb0",
                                "sense_id": "a994ae0b-c606-35ce-b741-1e8be102e51a",
                                "text": "Polska dla Polaków - jak to pogodzić z postawą obcoplemieńca, który po opuszczeniu getta działał w konspiracji, pisał antyhitlerowskie satyry, przeszedł przez obozy i łagrową poniewierkę, by wreszcie po andersowskim epizodzie znaleźć się w Londynie"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4068d663-4949-4b3a-b442-32a2ebd06920",
                        "source_entry_id": "ca1c145f-aa74-3aaf-b7c3-090cf5127497",
                        "source_sense_id": "a994ae0b-c606-35ce-b741-1e8be102e51a",
                        "target_lang_word": "лагерный",
