                "senses": [
                    {
                        "sense_id": "ad86f04c-1de4-3b4e-bb27-9084289157ca",
                        "entry_id": "d1ecbb40-2e14-368d-aaba-c1d88d263f73",
                        "glosses": [
                            "Espèce d'oiseau de la famille des ardéidés (hérons, aigrettes, butors et apparentés), de taille moyenne, blanc, vivant près des eaux douces, insectivore et piscivore, originaire d’Afrique et se trouvant souvent en compagnie du bétail sur tous les continents."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f58d6e2a-3bba-45ba-85e5-465e0dd2d3cb",
                                "sense_id": "ad86f04c-1de4-3b4e-bb27-9084289157ca",
                                "text": "Savary, […] , s'est servi , de même que Shaw , du mot rouge pour exprimer la couleur des pieds du garde-bœuf ; mais elle est tout au plus d'un orangé-olivâtre dans quelques individus."
                            },
                            {
                                "example_id": "a6d2eab3-900a-44ea-a417-f3c5be1c2d2a",
                                "sense_id": "ad86f04c-1de4-3b4e-bb27-9084289157ca",
                                "text": "Des oiseaux qui parent encore agréablement les rives du Nil sont les hérons. Dans le nombre, on en distingue des espèces blanches, parmi lesquelles sont le garde-bœuf et l’aigrette."
                            },
                            {
                                "example_id": "76d4379f-4d6d-4b28-b9ef-58d1bfcf36f7",
                                "sense_id": "ad86f04c-1de4-3b4e-bb27-9084289157ca",
                                "text": "En saison sèche, les Garde-bœuf suivent les feux de forêt et de savane, pour manger les animaux mis à nu par la disparition de la couverture herbacée."
                            },
                            {
                                "example_id": "965aa81f-1b0e-4872-aaa6-9e0405fefccb",
                                "sense_id": "ad86f04c-1de4-3b4e-bb27-9084289157ca",
                                "text": "Alors que les aigrettes se nourrissent essentiellement dans les milieux aquatiques, le garde-bœufs est une espèce grégaire terrestre qui vit en association étroite avec le bétail et les ongulés sauvages qu'il suit."
                            }
                        ]
                    }
