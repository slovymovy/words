                    "sense_definition": "der Vater der Ehepartnerin oder des Ehepartners",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mit meinem <w>Schwiegervater</w> verstehe ich mich seit Jahren sehr gut.",
                            "target_lang_translations": {
                                "en": "I have gotten along very well with my <w>father-in-law</w> for years.",
                                "ru": "Со своим <w>тестем</w> я уже много лет отлично лажу.",
                                "nl": "Met mijn <w>schoonvader</w> kan ik het al jaren heel goed vinden.",
                                "pl": "Z moim <w>teściem</w> od lat dogaduję się bardzo dobrze.",
                                "fr": "Je m'entends très bien avec mon <w>beau-père</w> depuis des années.",
                                "it": "Vado molto d'accordo con mio <w>suocero</w> da anni.",
                                "cs": "Se svým <w>tchánem</w> vycházím už léta velmi dobře.",
                                "tr": "Yıllardır <w>kayınpederimle</w> çok iyi anlaşıyorum.",
                                "es": "Desde hace años me llevo muy bien con mi <w>suegro</w>.",
                                "zh": "多年来，我和我的<w>岳父</w>一直相处得非常融洽。"
                            }
                        },
                        {
                            "text": "Zum Geburtstag schenken wir meinem <w>Schwiegervater</w> ein schönes Buch.",
                            "target_lang_translations": {
                                "en": "For his birthday, we are giving my <w>father-in-law</w> a nice book.",
                                "ru": "На день рождения мы дарим моему <w>свёкру</w> хорошую книгу.",
                                "nl": "Voor zijn verjaardag geven we mijn <w>schoonvader</w> een mooi boek.",
                                "pl": "Na urodziny podarujemy mojemu <w>teściowi</w> piękną książkę.",
                                "fr": "Pour son anniversaire, nous offrons un beau livre à mon <w>beau-père</w>.",
                                "it": "Per il compleanno regaliamo a mio <w>suocero</w> un bel libro.",
                                "cs": "K narozeninám dáme mému <w>tchánovi</w> pěknou knihu.",
                                "tr": "Doğum günü için <w>kayınpederime</w> güzel bir kitap hediye ediyoruz.",
                                "es": "Por su cumpleaños le regalamos un libro bonito a mi <w>suegro</w>.",
                                "zh": "过生日时，我们送给我<w>公公</w>一本好书。"
                            }
                        }
