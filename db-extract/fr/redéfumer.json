                "senses": [
                    {
                        "sense_id": "b5dada4d-4c87-318d-962f-eea3c1b26ecb",
                        "entry_id": "e620bad6-f9ba-3d53-a83c-485f8308658a",
                        "glosses": [
                            "Défumer (arrêter de fumer) de nouveau."
                        ],
                        "tags": [
                            "neologism",
                            "very-familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "4d350b2c-1bc5-402d-8c80-30ca068d1eab",
                                "sense_id": "b5dada4d-4c87-318d-962f-eea3c1b26ecb",
                                "text": "Alors je me suis dit : plus forte que tout et tout le monde, je vais redéfumer sans lui, celui qui m'a fait croire, celui qui m'a trompé en laissant passer les envies la première fois."
                            },
                            {
                                "example_id": "02f0a6bb-448b-4515-8eb8-796f2769dce2",
                                "sense_id": "b5dada4d-4c87-318d-962f-eea3c1b26ecb",
                                "text": "Redéfumer le 1ᵉʳ janvier pas question."
                            },
                            {
                                "example_id": "45f9fb2e-3758-4ff5-9d19-64ca29bc8f75",
                                "sense_id": "b5dada4d-4c87-318d-962f-eea3c1b26ecb",
                                "text": "Moi.. malgré ma réussite... je n'ai plus la force ni de refumer.. ni de redéfumer."
                            }
                        ]
                    }
