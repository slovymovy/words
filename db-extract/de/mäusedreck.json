                        "examples": [
                            {
                                "example_id": "9850d7b0-fadf-4fad-ab9c-f6659a67e718",
                                "sense_id": "88a917af-50cf-3621-a469-fe6f49b4e57c",
                                "text": "„Ein Vorhang fiel, entrollte sich in einem Wirbel von Staub und Käferhüllen und getrocknetem Mäusedreck.“"
                            },
                            {
                                "example_id": "f5322c22-4198-4a7d-b49c-fb294618c4fa",
                                "sense_id": "88a917af-50cf-3621-a469-fe6f49b4e57c",
                                "text": "„Die Zweige, verdreht und dunkelbraun angelaufen. Auf jedem balanciert ein schwarzer Reispfad aus getrocknetem Mäusedreck.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
