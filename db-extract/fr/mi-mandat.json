                ],
                "senses": [
                    {
                        "sense_id": "6142df85-1e4c-31a4-a268-d4211ecdcd9c",
                        "entry_id": "fa4e0d7d-ed3f-34d7-8886-09c28e5efb4a",
                        "glosses": [
                            "Milieu d’un mandat."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dc410e4-0799-4fa8-a7b1-e3dedd689650",
                                "sense_id": "6142df85-1e4c-31a4-a268-d4211ecdcd9c",
                                "text": "Après avoir été secouée lors de la présidentielle de 2020, puis à l’occasion de l’assaut du Capitole, en janvier 2021, la démocratie américaine va de nouveau être mise à l’épreuve, mardi, jour de midterms, les élections de mi-mandat."
                            }
                        ]
                    },
                    {
                        "sense_id": "83c2a9c6-7d62-3e9c-9eaa-f3bfeb1c070d",
                        "entry_id": "fa4e0d7d-ed3f-34d7-8886-09c28e5efb4a",
                        "glosses": [
                            "Milieu d’un mandat.",
                            "Aux-États-Unis, moment où sont organisées des élections pour les deux chambres du Congrès des États-Unis, au milieu du mandat quadriennal du président américain. L'ensemble des 435 sièges de la Chambre des représentants est renouvelé pour deux ans. Un tiers des 100 sièges du Sénat, renouvelé par tiers tous les deux ans."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "bfc40c1a-2c9d-442a-a0b6-3f471da17407",
                                "sense_id": "83c2a9c6-7d62-3e9c-9eaa-f3bfeb1c070d",
                                "text": "Les démocrates espèrent que le mécontentement provoqué par les retombées de la loi budgétaire les aidera à conquérir la majorité à la Chambre des représentants aux élections de mi-mandat, en 2026."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cd63b76c-a462-490a-94bb-0866f387126c",
                        "source_entry_id": "fa4e0d7d-ed3f-34d7-8886-09c28e5efb4a",
                        "target_lang_word": "midterm",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "midterm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bf59033d-af07-39d4-a8eb-9341c7f05605",
                                        "entry_id": "6fa17add-1820-39b1-9002-9878584a7cab",
                                        "glosses": [
                                            "Halfway through a term, or roughly so."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ed7418fe-ada2-4046-8c5a-a3e3664d5713",
                                                "sense_id": "bf59033d-af07-39d4-a8eb-9341c7f05605",
                                                "text": "The administration is suffering from the usual midterm drop in approval ratings."
                                            },
                                            {
                                                "example_id": "2903fc44-3594-42cf-bdd2-ba97d77cc2f9",
                                                "sense_id": "bf59033d-af07-39d4-a8eb-9341c7f05605",
                                                "text": "Most of the rational world . . . foresaw a smooth ride to victory for Democrats. They had, after all, the wind at their backs from the 2006 midterm elections."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "midterm",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a4d8860c-27d8-31bc-8c22-3f4395468e9b",
                                        "entry_id": "71c3b788-8fa2-3f68-bc48-8bebecccc51a",
                                        "glosses": [
                                            "A midterm school exam (i.e., halfway through the term)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0c5743d5-fdb2-4c99-b0c6-6434dd5d93de",
                                                "sense_id": "a4d8860c-27d8-31bc-8c22-3f4395468e9b",
                                                "text": "I only got a C on the midterm, so I really have to study for the final."
                                            },
                                            {
                                                "example_id": "d094bb88-a061-4075-b512-b3c865a47bc2",
                                                "sense_id": "a4d8860c-27d8-31bc-8c22-3f4395468e9b",
                                                "text": "It was tough cramming for those midterms and finals, staying up 72 hours straight hepped up on caffeine and pizza."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a900c6cf-3f49-3741-9bfc-ca21dec4da0a",
                                        "entry_id": "71c3b788-8fa2-3f68-bc48-8bebecccc51a",
                                        "glosses": [
                                            "A midterm election."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3ecb3f5f-15ab-4827-a69b-6ebe8368ca45",
                                                "sense_id": "a900c6cf-3f49-3741-9bfc-ca21dec4da0a",
                                                "text": "The AAPI electorate has become more politically engaged in recent election cycles, and although it is not a voting bloc that has historically shown strong support for Trump, growing skepticism toward him could influence key battlegrounds in the 2026 midterms and beyond."
                                            }
                                        ]
                                    }
