                ],
                "senses": [
                    {
                        "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                        "entry_id": "835e1bb2-dd03-3f0e-91c3-b0831cc78365",
                        "glosses": [
                            "denken dat je beter bent dan andere mensen en op die anderen neerkijken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7c018778-ac28-4bfd-bf94-6a121054a7cd",
                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                "text": "Het hooghartige wicht had dan wel een rijke vader, maar had zelf nog helemaal niets bereikt."
                            },
                            {
                                "example_id": "a4ad4564-e73e-4c73-8a47-8f5a03e06e33",
                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                "text": "Uma Thurman is de mooiste venus van allemaal. Vanuit de hoogte kijkt ze vanaf een filmscherm op ons neer, in de eerste zaal van de tentoonstelling Botticelli Reimagined in het Londense V&A Museum. Ze oogt sereen, een tikkeltje hooghartig maar vooral wonderschoon, met haar rossige krullen en haar framboosrode lippen. (Sandra Smallenburg NRC 14 maart 2016)"
                            },
                            {
                                "example_id": "142fbfb8-dc57-4282-be66-3189a8b06eed",
                                "sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                                "text": "De Fransen, die onverdraaglijk hooghartige kwasten, hadden gekregen wat ze verdienden."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "46f4ab5f-8ab7-43eb-8477-15a3e49dd402",
                        "source_entry_id": "835e1bb2-dd03-3f0e-91c3-b0831cc78365",
                        "source_sense_id": "330000ee-6782-374e-84db-a68e7f233344",
                        "target_lang_word": "altivo",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "altivo",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "13293b02-ce37-36fd-b1d2-b3fbdefd2510",
                                        "entry_id": "8d62a80a-7740-3811-a5f4-e77cc60cfdf2",
                                        "glosses": [
                                            "Orgulloso, soberbio."
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3b844cc0-3e9b-3e1e-aba3-b34d9f828ff4",
                                        "entry_id": "8d62a80a-7740-3811-a5f4-e77cc60cfdf2",
                                        "glosses": [
                                            "Elevado, erguido."
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "65ced466-7619-4f2d-b406-660a4a0f3494",
                                                "sense_id": "3b844cc0-3e9b-3e1e-aba3-b34d9f828ff4",
                                                "text": "Allí está canosa, pero todavía enjuta y sin edad discernible, como si la gota de sangre araucana que corriera por sus venas hubiera tenido el don de petrificar su altivo perfil."
                                            },
                                            {
                                                "example_id": "77e8b2e4-e1eb-450b-b1d3-6ed3275fc1a5",
                                                "sense_id": "3b844cc0-3e9b-3e1e-aba3-b34d9f828ff4",
                                                "text": "Por primera vez se siente entrar con majestad en la gran calle de árboles. Ya no la exaspera el altivo continente del álamo; por primera vez nota que su follaje tiene ondulación y reflejos de agua agitada."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
