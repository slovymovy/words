                                                "sense_id": "62150727-e354-31ce-a9f3-f73ec2563297",
                                                "text": "Die Quadersteine der Fundamente wurden mit Eisenklammern verankert."
                                            },
                                            {
                                                "example_id": "da034013-e7ae-4940-a0fd-c35c7f8c281e",
                                                "sense_id": "62150727-e354-31ce-a9f3-f73ec2563297",
                                                "text": "„Die aus grauen länglichen Quadersteinen dicht gefügte Stirnwand wies vielfach eine ins Tintige gehende Maserung auf.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
