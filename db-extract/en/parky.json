                "senses": [
                    {
                        "sense_id": "b5799a46-160a-3db7-b929-764e07651eaf",
                        "entry_id": "7000863a-903a-353e-ac0f-5fe771ede68c",
                        "glosses": [
                            "kalt, kühl (bezogen auf das Wetter/ die Luft etc.)"
                        ],
                        "tags": [
                            "British",
                            "colloquial"
                        ],
