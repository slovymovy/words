                        "examples": [
                            {
                                "example_id": "2dede58b-cbb2-4a32-8672-2279a668dfb5",
                                "sense_id": "ea37aff1-4802-3910-842e-8e1319617795",
                                "text": "« Le nom Zembla est une corruption non du russe zemlya [terre], mais de Semblerland, un pays de reflets, de « ressembleurs » », insiste le commentateur — Feu pâle, p. 294.."
                            },
                            {
                                "example_id": "8f627d02-6a01-44e2-80f0-ebacada9c2d3",
                                "sense_id": "ea37aff1-4802-3910-842e-8e1319617795",
                                "text": "Il est le Grand Ressembleur, il demande la Lune, le doigt tendu aveuglément vers elle."
                            },
                            {
                                "example_id": "db798a3b-b218-44c5-bd16-b31083510615",
                                "sense_id": "ea37aff1-4802-3910-842e-8e1319617795",
                                "text": "(...) une fois qu'il était plutôt \"ressembleur\" que \"rassembleur\", étiquette qu'il affectionne par-dessus tout."
                            }
                        ]
                    }
