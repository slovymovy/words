            "pos": "verb",
            "senses": [
                {
                    "sense_id": "76a4bcda-acad-348d-bdc8-40b052c28b9a",
                    "sense_definition": "zich ergens zorgen over maken",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "zorgen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bekommerde</w> me over de slechte economische vooruitzichten van ons land.",
                            "target_lang_translations": {
                                "en": "I <w>worried</w> about the poor economic prospects of our country."
                            }
                        },
                        {
                            "text": "Je moet je niet zo <w>bekommeren</w> over wat andere mensen van je denken.",
                            "target_lang_translations": {
                                "en": "You shouldn't <w>be so concerned</w> about what other people think of you."
                            }
                        }
                    ],
                    "synonyms": [
                        "verontrusten",
                        "piekeren"
                    ],
                    "common_phrases": [
                        "zich bekommeren over"
                    ],
                    "target_lang_definitions": {
                        "en": "to worry or be concerned about something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "worry",
                                "target_lang_sense_clarification": "to feel anxious or uneasy"
                            },
                            {
                                "target_lang_word": "be concerned",
                                "target_lang_sense_clarification": "to feel interest or worry about a situation"
                            },
                            {
                                "target_lang_word": "fret",
                                "target_lang_sense_clarification": "to be constantly or visibly anxious"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "013fd3bf-37c8-37b6-b272-d08e7c4c3e58",
                    "sense_definition": "aandacht besteden aan of zorg dragen voor iemand of iets",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zorg dragen",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>bekommerde</w> me om mijn zieke moeder en ging er iedere dag even langs.",
                            "target_lang_translations": {
                                "en": "I <w>cared for</w> my sick mother and stopped by every day."
                            }
                        },
                        {
                            "text": "De overheid moet zich meer <w>bekommeren</w> om het lot van daklozen.",
                            "target_lang_translations": {
                                "en": "The government should <w>look after</w> the fate of homeless people more."
                            }
                        }
                    ],
                    "synonyms": [
                        "verzorgen",
                        "omzien"
                    ],
                    "antonyms": [
                        "verwaarlozen"
                    ],
                    "common_phrases": [
                        "zich bekommeren om"
                    ],
                    "target_lang_definitions": {
                        "en": "to pay attention to or take care of someone or something"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "care for",
                                "target_lang_sense_clarification": "to look after someone or something"
                            },
                            {
                                "target_lang_word": "look after",
                                "target_lang_sense_clarification": "to take care of or be responsible for"
                            },
                            {
                                "target_lang_word": "trouble oneself",
                                "target_lang_sense_clarification": "to make an effort to help or pay attention"
                            }
                        ]
                    }
                }
            ]
        }
    ]
