                ],
                "senses": [
                    {
                        "sense_id": "bc71e4fc-c91a-3b8d-bb17-a69cf0643234",
                        "entry_id": "91625650-37e0-3503-b1b7-76d0c4543178",
                        "glosses": [
                            "Arbeitsstätte eines niedergelassen Zahnarztes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "327bd031-b497-4722-b5a8-2faaef5f3055",
                                "sense_id": "bc71e4fc-c91a-3b8d-bb17-a69cf0643234",
                                "text": "Die Zahnarztpraxis ist am Mittwoch geschlossen."
                            },
                            {
                                "example_id": "0cccb702-0ff2-4ad7-aa26-debb546b9c06",
                                "sense_id": "bc71e4fc-c91a-3b8d-bb17-a69cf0643234",
                                "text": "„Als ich die Zahnarztpraxis verließ, stand unten auf der Straße ein Mann mit einem Backenbart, der mir mit den Augen zuzwinkerte; er machte eine merkwürdige Geste, indem er die Wand des nächsten Hauses hinauf zeigte.“"
                            },
                            {
                                "example_id": "0fbcdc14-c1bf-4b5c-95c7-921080668288",
                                "sense_id": "bc71e4fc-c91a-3b8d-bb17-a69cf0643234",
                                "text": "„In Hallstadt in Oberfranken ist eine Frau in einer Zahnarztpraxis derart wütend geworden, dass die Polizei kommen musste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
