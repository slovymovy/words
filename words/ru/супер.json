{
    "word_family": [
        "суперский"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "b2130ac2-0379-3f02-a68c-76b4b07bec54",
                    "sense_definition": "Оценочная характеристика чего-либо как очень хорошего, превосходного; отлично, великолепно.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "У тебя всё получится! Оля, ты просто <w>супер</w>!",
                            "target_lang_translations": {
                                "en": "You'll succeed! Olya, you are just <w>great</w>!",
                                "fr": "Tu vas y arriver ! Olga, tu es tout simplement <w>géniale</w> !"
                            }
                        },
                        {
                            "text": "Это же просто <w>супер</w>, подумала я, когда увидела подарок.",
                            "target_lang_translations": {
                                "en": "That is just <w>awesome</w>, I thought when I saw the gift.",
                                "fr": "C'est tout simplement <w>super</w>, me suis-je dit en voyant le cadeau."
                            }
                        }
                    ],
                    "common_phrases": [
                        "просто супер",
                        "всё супер",
                        "выглядишь супер"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Informal description of something as excellent or outstanding.",
                        "fr": "Caractérisation familière de quelque chose d'excellent, de formidable ou de très bien."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "Very good; excellent"
                            },
                            {
                                "target_lang_word": "awesome",
                                "target_lang_sense_clarification": "Excellent, exciting"
                            },
                            {
                                "target_lang_word": "super",
                                "target_lang_sense_clarification": "Better than average; wonderful"
                            },
                            {
                                "target_lang_word": "cool",
                                "target_lang_sense_clarification": "Very interesting or exciting"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "super",
                                "target_lang_sense_clarification": "familier, très bien, formidable"
                            },
                            {
                                "target_lang_word": "génial",
                                "target_lang_sense_clarification": "excellent, enthousiasmant"
                            },
                            {
                                "target_lang_word": "formidable",
                                "target_lang_sense_clarification": "remarquable, excellent"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "509dda71-d0d1-309e-be4f-ba64397be0e8",
                    "sense_definition": "Возглас, выражающий высшую степень одобрения, восхищения или радости.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "evaluation_positive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Супер</w>! Спасибо за такой классный подарок!",
                            "target_lang_translations": {
                                "en": "<w>Awesome</w>! Thanks for such a cool present!",
                                "fr": "<w>Super</w> ! Merci pour ce cadeau si chouette !"
                            }
                        },
                        {
                            "text": "Мы едем на море в эти выходные? <w>Супер</w>!",
                            "target_lang_translations": {
                                "en": "Are we going to the sea this weekend? <w>Awesome</w>!",
                                "fr": "On part à la mer ce week-end ? <w>Génial</w> !"
                            }
                        }
                    ],
                    "common_phrases": [
                        "ну супер",
                        "вообще супер"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "An exclamation used to express strong approval or happiness.",
                        "fr": "Exclamation exprimant une vive approbation, l'admiration ou la joie."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "great",
                                "target_lang_sense_clarification": "Expression of gladness"
                            },
                            {
                                "target_lang_word": "awesome",
                                "target_lang_sense_clarification": "Colloquial exclamation"
                            },
                            {
                                "target_lang_word": "super",
                                "target_lang_sense_clarification": "Expression of approval"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "super",
                                "target_lang_sense_clarification": "exclamation d'enthousiasme ou d'approbation"
                            },
                            {
                                "target_lang_word": "génial",
                                "target_lang_sense_clarification": "exclamation familière marquant la satisfaction"
                            },
                            {
                                "target_lang_word": "trop bien",
                                "target_lang_sense_clarification": "très familier, expression de joie"
                            }
