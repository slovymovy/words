                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e360f15a-f32c-492f-a1f8-fb966dd1e84a",
                                                "sense_id": "194e9fe2-1637-3f4a-9ce1-a8c75134aa2d",
                                                "text": "The walls and ceiling of this drawing-room in Montague Square are painted ivory."
                                            }
