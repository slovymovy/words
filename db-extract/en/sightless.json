                        ],
                        "form": "sightless"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "deb023c3-d6bf-345e-b767-53704c9d1996",
                        "entry_id": "743c1370-ae94-3fde-95e6-3df4c8ea8f68",
                        "glosses": [
                            "blind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d664a09-3050-4914-bf16-8b83348f5bda",
                                "sense_id": "deb023c3-d6bf-345e-b767-53704c9d1996",
                                "text": "„Just as a light is flashed in vain on closed or sightless eyes, so ‚an unspiritual person cannot accept anything of the Spirit of God.‘“ (Bernard of Clairvaux)",
                                "translation": "So wie ein Licht für geschlossene oder blinde Augen umsonst angezündet wird, so kann eine unspirituelle Person nichts vom Geist Gottes annehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27a5cc81-2b46-48ac-9e25-3159470481c2",
                        "source_entry_id": "743c1370-ae94-3fde-95e6-3df4c8ea8f68",
                        "source_sense_id": "deb023c3-d6bf-345e-b767-53704c9d1996",
                        "source_sense_description": "blind",
                        "target_lang_word": "blind",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "blind",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fc84ec8-8b09-327b-9693-a8048ed4cf15",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "des Sehens nicht fähig"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2c54af72-b5ec-4798-9eaf-5a5f8eb8ed43",
                                                "sense_id": "4fc84ec8-8b09-327b-9693-a8048ed4cf15",
                                                "text": "Er ist seit dem Unfall blind."
                                            },
                                            {
                                                "example_id": "c5d0b980-4db6-421a-8216-368f3e6af56c",
                                                "sense_id": "4fc84ec8-8b09-327b-9693-a8048ed4cf15",
                                                "text": "Eine gelbliche Wolke schwebt aus den deutschen Schützengräben auf die gegnerische Linie zu. Dort beginnt das Grauen. Rot angelaufen, blind und hustend taumeln die vom Gas eingehüllten Soldaten umher. 3000 von ihnen ersticken, weitere 7000 überleben schwer verätzt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "3c74a462-cc4a-32c4-a3ea-22753ba571de",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "besinnungslos; außer sich seiend"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "52a86e22-8423-4133-9da3-567a3624c490",
                                                "sense_id": "3c74a462-cc4a-32c4-a3ea-22753ba571de",
                                                "text": "Blind vor Wut stürzte er sich auf sie."
                                            },
                                            {
                                                "example_id": "9eca92f1-2c95-46da-82c4-3d8df562e054",
                                                "sense_id": "3c74a462-cc4a-32c4-a3ea-22753ba571de",
                                                "text": "„Der Extremkletterer setzt sich nicht ‚todesmutig’ oder gar ‚blind’ einer ‚mörderischen Wand’ aus, sondern sichert sich mit Seil und Haken, vertraut seinen Eisen, seinem Können, seiner Sorgfalt, seiner Konzentrationsfähigkeit, seinem Selbsteinschätzungsvermögen, seinem Krisenmanagement, seiner Erfahrung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4892c924-6cf3-386f-9220-e9769e8b63bb",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "nicht Sehen wollend; unkritisch, ignorant"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "886c75f8-f90c-4121-becf-45ac171013b7",
                                                "sense_id": "4892c924-6cf3-386f-9220-e9769e8b63bb",
                                                "text": "„Der Extremkletterer setzt sich nicht ‚todesmutig’ oder gar ‚blind’ einer ‚mörderischen Wand’ aus, sondern sichert sich mit Seil und Haken, vertraut seinen Eisen, seinem Können, seiner Sorgfalt, seiner Konzentrationsfähigkeit, seinem Selbsteinschätzungsvermögen, seinem Krisenmanagement, seiner Erfahrung.“"
                                            },
                                            {
                                                "example_id": "aa7b62a3-e1bd-42fb-88f9-7b27b7ca2e65",
                                                "sense_id": "4892c924-6cf3-386f-9220-e9769e8b63bb",
                                                "text": "Er ist ein blinder Anhänger des Katholizismus."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "d0f0c758-5cca-3771-85bb-53a2848f65af",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "matt, nicht durchsichtig und klar (Fenster)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "574d854e-2402-423d-af9f-308567d50913",
                                                "sense_id": "d0f0c758-5cca-3771-85bb-53a2848f65af",
                                                "text": "Die Fenster sind schon beinahe blind."
                                            },
                                            {
                                                "example_id": "aa493515-927e-4f36-9476-1dcb5113eb94",
                                                "sense_id": "d0f0c758-5cca-3771-85bb-53a2848f65af",
                                                "text": "Dann betraten sie miteinander die Mehlkammer, einen niedrigen Raum mit zwei winzigen Fensterchen, blind von Mehlstaub."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "3728f4a3-470e-3c01-b77d-f3f3f18ed316",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "zu seiner zugedachten Funktion nicht fähig; leer, inhaltslos"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "576ca043-bc6b-4b2e-851c-33965f931d79",
                                                "sense_id": "3728f4a3-470e-3c01-b77d-f3f3f18ed316",
                                                "text": "Der Blindgänger richtete wenig Schaden an, da er beim Aufschlag nicht detonierte."
                                            },
                                            {
                                                "example_id": "8696ef93-735d-4c78-b225-fc09aeeb72fd",
                                                "sense_id": "3728f4a3-470e-3c01-b77d-f3f3f18ed316",
                                                "text": "Das Ei ist blind. Es wurde offenbar nicht befruchtet."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "bdaaea72-dc9e-3b41-8fc1-287ad42d9ac0",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "ohne Öffnung; ohne Fortsetzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c11794c3-4255-4850-99d1-3de10475cec4",
                                                "sense_id": "bdaaea72-dc9e-3b41-8fc1-287ad42d9ac0",
                                                "text": "Der Weg in dieses Tal endet blind."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "d32f283e-249e-3412-a84e-1bfa9313ea7a",
                                        "entry_id": "24cdbf29-f28c-326b-8a58-f5b4a50c65cc",
                                        "glosses": [
                                            "ungesehen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a3ba8c4-aeae-46ae-9302-81ac427c8eeb",
                                                "sense_id": "d32f283e-249e-3412-a84e-1bfa9313ea7a",
                                                "text": "Der blinde Passagier versteckte sich gut und wurde von der Schiffsbesatzung nicht entdeckt."
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    }
                                ]
                            }
                        ]
                    }
