                "senses": [
                    {
                        "sense_id": "a66df0a6-bf6c-3073-b49f-4abc77d28d56",
                        "entry_id": "17d449d9-884e-3a6e-9cc5-7ea3b1b80feb",
                        "glosses": [
                            "säulenförmige Flamme"
