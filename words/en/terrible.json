                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Чрезвычайно или очень; используется для усиления значения в разговорной речи.",
                        "zh": "极其或非常；用于非正式场合强调形容词。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ужа́сно",
                                "target_lang_sense_clarification": "в значении \"очень\""
