                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b86b44d-c3c1-47fb-bfeb-2e0ae9e4e4fa",
                                "sense_id": "f5f31ee5-81a1-3151-a6b7-bba2a8414e9e",
                                "text": "The mail carrier was phobic of dogs."
                            },
                            {
                                "example_id": "722a3aa8-d189-49b2-8152-4eb2d6eee456",
                                "sense_id": "f5f31ee5-81a1-3151-a6b7-bba2a8414e9e",
                                "text": "Even so, in many cases the homophobe truly is phobic of gays and lesbians, […]"
                            },
                            {
                                "example_id": "81163877-25fb-494e-baff-a93d34c937c7",
                                "sense_id": "f5f31ee5-81a1-3151-a6b7-bba2a8414e9e",
                                "text": "Yes, our society is backwards, full of violent phobic unexamined idiot fear people constantly throw at innocent others."
                            }
                        ]
                    }
