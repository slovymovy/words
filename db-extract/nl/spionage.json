                                        "sense_id": "5357e1c6-535b-3c66-bb3c-4f0cdfd76e66",
                                        "entry_id": "1b73204c-1cbd-3868-886f-c0e937bdeab4",
                                        "glosses": [
                                            "The act or process of learning secret information through clandestine means."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e802ede1-4fda-4e5d-9dd8-84586d39e3a0",
                                                "sense_id": "5357e1c6-535b-3c66-bb3c-4f0cdfd76e66",
                                                "text": "So intolerable did Heavy Benson's espionage become, that Raynham would have grown depopulated of its womankind had not Adrian interfered, who pointed out to the Baronet what a fearful arm his butler was wielding."
                                            },
                                            {
                                                "example_id": "12f38cc4-90ed-4e70-adda-ec1c96822bb8",
                                                "sense_id": "5357e1c6-535b-3c66-bb3c-4f0cdfd76e66",
                                                "text": "What a freak show! I mean, how often do you meet a wrestling librarian?\nYeah, about as often as you meet a high schoolgirl involved in international espionage… Okay, bad example."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5f6f0ea-1034-489d-9357-4453cddc8d56",
                        "source_entry_id": "242eb63c-58f8-3463-953e-089d7ef2f561",
                        "source_sense_id": "bff30096-407b-3d0e-b71a-35adb5f4d0c8",
                        "source_sense_description": "de handeling van het spioneren",
                        "target_lang_word": "espionnage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "espionnage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                        "entry_id": "d04cfd9f-4852-3faa-a9bc-7da7e2000c95",
                                        "glosses": [
                                            "Action d’espionner, d'utiliser un ou des espions ; métier d’espion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "52c0a6d4-53a7-4ac6-97b0-9219b14fafdd",
                                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                                "text": "Il déroulait les curiosités, dépistait les espionnages, se servant de ses amis, sans qu'ils se doutassent du rôle qu'il leur faisait jouer."
                                            },
                                            {
                                                "example_id": "f7a90c4b-e25a-44ca-8c94-5c98cfc7c7fb",
                                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                                "text": "Je venais de me dire, en effet, que ma poursuite était tout à fait incorrecte et que la façon d’espionnage à laquelle je me livrais était indigne de moi."
                                            },
                                            {
                                                "example_id": "ada5c23f-c92a-471d-8d1a-de5957d416a3",
                                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                                "text": "Deux jours après, je passai devant le conseil de guerre, qui, après plaidoirie d'un avoué allemand, me condamna à mort pour espionnage […]."
                                            },
                                            {
                                                "example_id": "c69c3750-6551-43e9-9263-630779377856",
                                                "sense_id": "790dfe24-e968-3478-8a96-ce947d5e5b4c",
                                                "text": "Mais cette scolastique de l’espionnage, et la méthode si raisonnable des recoupements, enivrent ceux qui y participent, et encore plus ceux qui les ont inventées."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
