                ],
                "senses": [
                    {
                        "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                        "entry_id": "2dbf5791-c810-3dc6-82d5-c780018fc9f6",
                        "glosses": [
                            "Zwiebel, die zum Wachsen in die Erde gepflanzt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8f378698-a2e9-4ddf-a0ff-3ec62e6bba67",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Im März werden Steckzwiebel und Schalotten gepflanzt, im Oktober ist die Goldparmäne reif.“"
                            },
                            {
                                "example_id": "c168df2c-985d-46af-bd32-7b37dc4160e1",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Denn bei ihnen wird die Steckzwiebel nicht nur einfach größer, sondern bildet unter der Erde ein Nest mit mehreren neuen Schalotten.“"
                            },
                            {
                                "example_id": "e4357c03-df8d-4895-a756-f4e343f2ca67",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„In eine mit dem Pflanzholz gezogene Rille werden Steckzwiebeln gerade so tief gesteckt, dass die Spitzen nicht mehr aus dem Boden hervorschauen.“"
                            },
                            {
                                "example_id": "21606326-2386-47c8-8188-4aa378756ad4",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Möhren und Steckzwiebeln sind auch eine seit Generationen bekannte Kombination, dieses Duo hält unschlagbar die Zwiebelfliegen ab.“"
                            },
                            {
                                "example_id": "35cbad51-2400-4cf9-83f2-1d3de4f74d50",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Neben den Knoblauch gesellt sich die Steckzwiebel, die du nun ins Beet setzen kannst.“"
                            },
                            {
                                "example_id": "1e31838b-e405-4e4f-b07e-6d9e27291a2e",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Dabei sollte die Wurzelseite der Steckzwiebeln nach unten und der Trieb nach oben schauen.“"
                            },
                            {
                                "example_id": "8e70c10f-a7e1-4146-9e45-df98f37c99db",
                                "sense_id": "c045257f-79df-345e-b3f1-d66ac11ec435",
                                "text": "„Für Anfänger empfehle ich die gängigen Steckzwiebeln, diese stecke ich von Mitte Februar bis Anfang März direkt ins Freiland, unkompliziert und gut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
