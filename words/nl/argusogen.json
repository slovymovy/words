{
    "word_family": [
        "argusoog"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2675d7a3-affd-336a-8b9e-f6f522130aac",
                    "sense_definition": "Meervoud van <w>argusoog</w>.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "plural",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>argusogen</w> van de bewaker misten geen enkele beweging in de hal.",
                            "target_lang_translations": {
                                "en": "The <w>watchful eyes</w> of the guard missed not a single movement in the hall."
                            }
                        },
                        {
                            "text": "Met zijn <w>argusogen</w> controleerde de leraar of er niemand spiekte tijdens het examen.",
                            "target_lang_translations": {
                                "en": "With his <w>hawk-like eyes</w>, the teacher checked if anyone was cheating during the exam."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "meervoudsvorm"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "Plural form of 'argusoog' (Argus eye), referring to a watchful or suspicious gaze."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "watchful eyes",
                                "target_lang_sense_clarification": "referring to being very observant or vigilant"
                            },
                            {
                                "target_lang_word": "suspicious eyes",
                                "target_lang_sense_clarification": "referring to a distrustful or critical gaze"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a084613-611c-3641-bda1-e24a7890f8ea",
                    "sense_definition": "Heel oplettend of zeer wantrouwend kijken.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attentiveness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij bekeek de offerte van het bedrijf met <w>argusogen</w>.",
                            "target_lang_translations": {
                                "en": "He examined the company's offer <w>with a suspicious eye</w>."
                            }
                        },
                        {
                            "text": "Ze houdt zijn bewegingen met <w>argusogen</w> in de gaten terwijl ze zich vastklampt aan de stoel.",
                            "target_lang_translations": {
                                "en": "She keeps a <w>watchful eye</w> on his movements while clutching the chair."
                            }
                        }
                    ],
                    "synonyms": [
                        "waakzaam",
                        "achterdochtig"
                    ],
                    "common_phrases": [
                        "met argusogen bekijken",
                        "met argusogen volgen"
                    ],
                    "target_lang_definitions": {
                        "en": "To look at something with extreme attentiveness or deep suspicion."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "with a hawk's eye",
                                "target_lang_sense_clarification": "idiomatic expression for watching very closely"
                            },
                            {
                                "target_lang_word": "with a suspicious eye",
                                "target_lang_sense_clarification": "looking at something with distrust"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}