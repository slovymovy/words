                        ],
                        "examples": [
                            {
                                "example_id": "b3a46442-754d-4c2c-90b3-e1b574d8fc28",
                                "sense_id": "6c2107ab-f2a3-3bea-8af7-d20f9c6075c7",
                                "text": "Season of the Witch débute par une scène esthétiquement absolument infecte. Sur un décor de carton, un filtre jaune pissouille nous bousille les yeux. Le film démarre donc fort."
                            },
                            {
                                "example_id": "76a0b469-aac1-483f-95e8-6654b02918d4",
                                "sense_id": "6c2107ab-f2a3-3bea-8af7-d20f9c6075c7",
                                "text": "Le délégué à ce morceau d’Éden en godet est aisément identifiable à son gilet en mailles polaires vert de gris pissouille et à sa gueule de six pieds de long."
                            },
                            {
                                "example_id": "43e4fe90-7601-452a-9443-bed2d2ae8c7d",
                                "sense_id": "6c2107ab-f2a3-3bea-8af7-d20f9c6075c7",
                                "text": "Je pense que l’on connait toutes la fameuse frustration du « je viens pour mes pointes » où l’on ressort avec 15cm en moins, ou je viens pour un beau blond d’été qui termine en jaune pissouille etc etc…"
                            },
                            {
                                "example_id": "ee0bef34-f179-4138-92ab-dde288455100",
                                "sense_id": "6c2107ab-f2a3-3bea-8af7-d20f9c6075c7",
                                "text": "Je traçai mon chemin dans le couloir aux murs peints d'un rose pissouille que les décorateurs des taules à macchabées surutilisent."
                            }
                        ]
                    }
