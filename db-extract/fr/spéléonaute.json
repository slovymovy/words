                "senses": [
                    {
                        "sense_id": "3d4fc5f4-4c51-3acd-8b72-b607aa5f975c",
                        "entry_id": "f2dc112c-39f7-3728-ac9e-33d9622e917d",
                        "glosses": [
                            "Spécialiste de la spéléologie, capable d’affronter des conditions extrêmes (exploration en profondeur, long séjour, prise de risques…), dans le but de réaliser des expériences scientifiques."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "f14fbea7-eff1-46a9-937f-b9fcab107b4c",
                                "sense_id": "3d4fc5f4-4c51-3acd-8b72-b607aa5f975c",
                                "text": "Le spéléologue plongeur devenu spéléonaute peut, grâce aux perfectionnements techniques, demeurer plusieurs heures voire dizaines d’heures en plongée."
                            },
                            {
                                "example_id": "162999a9-2a59-4078-bafb-f6b148117da2",
                                "sense_id": "3d4fc5f4-4c51-3acd-8b72-b607aa5f975c",
                                "text": "Le premier spéléonaute en 1962, Michel Siffre, ne connaissait pas cet effet inattendu sur la perception du temps. Il l’évoque assez longuement dans son livre au titre significatif : Hors du temps."
                            }
                        ]
                    }
