                        ]
                    },
                    {
                        "translation_id": "3db39cb3-fd64-485a-bebe-936d56b08b1e",
                        "source_entry_id": "c9dd79ea-3c35-37ad-8eff-fbcac27eb66e",
                        "source_sense_id": "282776dc-cfe4-3caf-931f-a6ad93710a00",
