                ],
                "senses": [
                    {
                        "sense_id": "d5ae30c7-a49a-34b9-9153-444c20853f27",
                        "entry_id": "348051e5-aa74-3a28-8bf9-041ae26d262d",
                        "glosses": [
                            "Enlever son caractère massif, ou son caractère de masse, à quelque chose."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7673944e-259a-4b9a-bb9e-c32044c104d5",
                                "sense_id": "d5ae30c7-a49a-34b9-9153-444c20853f27",
                                "text": "Nous voulons au contraire démassifier le plus possible, autrement dit aérer, ventiler la société."
                            },
                            {
                                "example_id": "0b1f44c3-26a2-4170-ac16-62bb06e0fe66",
                                "sense_id": "d5ae30c7-a49a-34b9-9153-444c20853f27",
                                "text": "Ensauvager la vie c'est la démassifier, aérer l'espace et permettre d'y respirer."
                            },
                            {
                                "example_id": "477de251-1adf-46aa-a425-76ec814fb127",
                                "sense_id": "d5ae30c7-a49a-34b9-9153-444c20853f27",
                                "text": "Et quand je dis que la refonte devra être massive, je veux dire qu'elle devra être radicale pour démassifier cet ensemble trop compact."
                            }
                        ]
                    }
                ],
