                        "entry_id": "b7e2eaa3-9b93-33b1-9856-a69418418f78",
                        "glosses": [
                            "w sposób mądry; na sposób świadczący o inteligencji lub wiedzy"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "af42ecd1-ad48-409b-82c9-d88c5a40b931",
                                "sense_id": "652d8ba6-f208-3ce3-a409-e2089eaea72d",
                                "text": "Górski replikował, bronił swej słuszności sprawnie i mądrze, ale zarazem atakował, obrażał i poniżał osobę przeciwnika"
                            }
