                                            {
                                                "example_id": "5b72b3df-7da8-455e-a184-9b9602df4d74",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "Die Beerdigung ist für 11 Uhr angesetzt."
                                            },
                                            {
                                                "example_id": "fb60952f-b735-49d5-8e4a-d9b858d654bc",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Die Beerdigung findet in extravaganter Atmosphäre in New York statt.“"
                                            },
                                            {
                                                "example_id": "514815eb-9c3f-4aaf-8138-0e865255e81a",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Der Beerdigung schloss sich ein Leichenschmaus im Dorfgasthof an.“"
                                            },
                                            {
                                                "example_id": "dd8c291f-7266-49e0-9f98-60adfb55612d",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Dann ging ich zurück und besprach die Beerdigung meines Vaters.“"
                                            },
                                            {
                                                "example_id": "c4ed9ffe-421d-4bad-9b82-e1bc599225ac",
                                                "sense_id": "3d14a000-7db1-35a8-a1a1-e2dc0b8b3aa3",
                                                "text": "„Ich erinnere mich, dass wir bei der Beerdigung meines Großvaters viel gelacht haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a6515b0c-c4bd-47f8-96b7-e6427fc08362",
                        "source_entry_id": "61d3b9ac-5084-34d3-9988-810d833ca564",
                        "source_sense_id": "1eaa5648-f0f1-3192-8a18-76e20d25d4b5",
                        "target_lang_word": "Begräbnis",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Begräbnis",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a0775a81-b7c9-30ba-a4de-1d04f944ead2",
                                        "entry_id": "e1c33951-6b63-3666-8e67-3d520b63b170",
                                        "glosses": [
                                            "Vorgang, einen Verstorbenen in ein Grab zu legen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a02b5f92-7207-4cb3-aa27-5a9a06bddd35",
                                                "sense_id": "a0775a81-b7c9-30ba-a4de-1d04f944ead2",
                                                "text": "Das Begräbnis meiner Großmutter war sehr feierlich."
                                            },
                                            {
                                                "example_id": "9bcc16c6-bdb7-4a04-b29e-73b9e368c634",
                                                "sense_id": "a0775a81-b7c9-30ba-a4de-1d04f944ead2",
                                                "text": "„In den frühen Morgenstunden packte er kalt entschlossen statt der Schulsachen ein paar Kleider in seinen Ranzen, dazu alles Geld, das er sich insgeheim mühsam zusammengespart hatte, und verließ sein Elternhaus, um fast drei Jahrzehnte lang nicht wiederzukehren, auch nicht zum Begräbnis seiner Mutter.“"
                                            },
                                            {
                                                "example_id": "e65bc602-909c-4e5c-bb71-1e9d420bdaaf",
                                                "sense_id": "a0775a81-b7c9-30ba-a4de-1d04f944ead2",
                                                "text": "„Als er ging, stand fest, daß wir am Begräbnis von Ditte teilnehmen würden.“"
                                            },
                                            {
                                                "example_id": "b0e4638f-6146-4d46-91d3-4d827272b5a6",
                                                "sense_id": "a0775a81-b7c9-30ba-a4de-1d04f944ead2",
                                                "text": "„Er ahnte nicht, daß zwei Wochen später genausowenig jemand Zeit haben würde, ihn mit einem angemessenen Begräbnis zu ehren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0af35619-db6c-3c7a-ac52-276f00509f06",
                                        "entry_id": "e1c33951-6b63-3666-8e67-3d520b63b170",
                                        "glosses": [
                                            "für eine Leiche bestimmter Platz"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a7826bc1-affe-47fc-97a0-5ea7c164c8d1",
                                                "sense_id": "0af35619-db6c-3c7a-ac52-276f00509f06",
                                                "text": "„Ihr Körper schläft in Capulets Begräbnis, / Und ihr unsterblich Teil lebt bei den Engeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
