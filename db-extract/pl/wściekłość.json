                        "sense_id": "7fd7081c-01ea-3e4e-82c7-02da2cfd4591",
                        "entry_id": "594c414a-011b-3f76-9937-bfc526e71d10",
                        "glosses": [
                            "bardzo silna negatywna emocja, intensywna złość"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a3d720ca-bc81-4466-9984-73842df89d0c",
                                "sense_id": "7fd7081c-01ea-3e4e-82c7-02da2cfd4591",
                                "text": "Jej niegrzeczne zachowanie doprowadziło mnie do wściekłości."
                            }
