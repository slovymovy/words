                ],
                "senses": [
                    {
                        "sense_id": "c5146c4f-1625-3745-90c7-c958e5b59ea0",
                        "entry_id": "8a944009-6628-39b5-ac1d-e9b820844355",
                        "glosses": [
                            "vom Arbeitgeber gewährter freier Tag"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c95b40-e347-4576-83d9-0075e07b59f0",
                                "sense_id": "c5146c4f-1625-3745-90c7-c958e5b59ea0",
                                "text": "„Angehörige der US-Streitkräfte erhalten hingegen 30 Urlaubstage pro Jahr zuzüglich der gesetzlichen Feiertage.“"
                            },
                            {
                                "example_id": "f6d4fa63-95a6-4051-9ac3-80baf28e9e1d",
                                "sense_id": "c5146c4f-1625-3745-90c7-c958e5b59ea0",
                                "text": "„Deswegen sparten die Sachalinbewohner ihre Urlaubstage an und sammelten Urlaubszeit, wie man anderswo Briefmarken sammelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "41f0ab3a-c891-3143-ae51-3648d69bcb83",
                        "entry_id": "8a944009-6628-39b5-ac1d-e9b820844355",
                        "glosses": [
                            "Tag, an dem sich jemand im Urlaub befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7a3821b9-2ee1-4fa2-97ae-20a0e4ad1fd3",
                                "sense_id": "41f0ab3a-c891-3143-ae51-3648d69bcb83",
                                "text": "Am ersten Urlaubstag auf Rügen hat es leider stark geregnet."
                            },
                            {
                                "example_id": "351a8fec-f709-4564-8240-eec12d0c6214",
                                "sense_id": "41f0ab3a-c891-3143-ae51-3648d69bcb83",
                                "text": "„Das ganze Theater kostet Vielgut zwei Urlaubstage, aber es ist für ihn und alle Schaulustigen ein großer Spaß.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "096a737b-f37b-48d9-be59-a440f646345e",
                        "source_entry_id": "8a944009-6628-39b5-ac1d-e9b820844355",
                        "source_sense_id": "c5146c4f-1625-3745-90c7-c958e5b59ea0",
