                "senses": [
                    {
                        "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                        "entry_id": "a005ee64-2413-37f5-92f9-ad243e87ea4d",
                        "glosses": [
                            "Staatsbürgerin von Belarus"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "689c2758-70ab-462f-82a4-fdc0ceae835c",
                                "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                                "text": "„Noch nie hat Belarus in Deutschland so viel Aufmerksamkeit bekommen wie im vergangenen Jahr. Und doch muss man als Belarusin immer wieder neu erklären, was dort passiert.“ Katja Artsiomenka, 2021"
                            },
                            {
                                "example_id": "f01df610-1bca-45f9-ab59-8d6e229ffe55",
                                "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                                "text": "„Die Belarusin lebt schon seit über 15 Jahren in Litauen.“ Sofie Donges und Christian Blenker, 2021"
                            },
                            {
                                "example_id": "94181384-ea51-4c21-bb4b-c93c94024056",
                                "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                                "text": "„Eigentlich wollte die Belarusin in Litauens Hauptstadt Vilnius Jura studieren.“"
                            },
                            {
                                "example_id": "68cb7293-984a-41db-bddb-1d472cab3c98",
                                "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                                "text": "„Die Belarusin Maria Kolesnikowa ist gerade in aller Munde.“"
                            },
                            {
                                "example_id": "0a5c21e4-d78a-4b3a-9cd2-e6a781eeaf4d",
                                "sense_id": "cfbeef4b-fc3b-367c-b449-d19c9107d1aa",
                                "text": "„In der Endrunde konkurrierten zwei Belarusinnen um den Titel.“ Melanie Arndt, 2020"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
