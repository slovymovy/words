                                            {
                                                "example_id": "796844c5-bcba-4677-916c-2a01aedbfa1b",
                                                "sense_id": "8a425556-002e-32a7-bcb5-3d1cf6be90c2",
                                                "text": "Показался тарантас, запряженный тройкой ямских лошадей; в тарантасе мелькнул околыш студентской фуражки, знакомый очерк дорогого лица…"
                                            },
                                            {
                                                "example_id": "10fe1411-d7b1-4e81-bc23-2bce60480930",
                                                "sense_id": "8a425556-002e-32a7-bcb5-3d1cf6be90c2",
                                                "text": "На дворе стоял тарантас, выпрягали лошадей, ходили с фонарем, суетились."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1c97177-0a85-3e93-b655-143a22c0cb6f",
                                        "entry_id": "74686f63-18b2-32ba-8d50-b1bd5881e18d",
                                        "glosses": [
                                            "разг. старый, испорченный автомобиль"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bc2dc072-02cb-4e82-ba02-f8cd5963f3a5",
                                                "sense_id": "a1c97177-0a85-3e93-b655-143a22c0cb6f",
                                                "text": "Тарантас паралитично трясся, выстреливая из глушителя снопы искр."
                                            }
                                        ]
