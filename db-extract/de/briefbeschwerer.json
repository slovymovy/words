                                "target_senses": [
                                    {
                                        "sense_id": "6e0af7bf-7e70-3ba8-a6b0-86c7cbaa9c5c",
                                        "entry_id": "19954f00-3476-3604-81fd-305c6590c055",
                                        "glosses": [
                                            "A small, decorative, somewhat weighty object placed on one or more pieces of paper to keep them from fluttering away."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c78c85cc-610c-464d-949f-660cf0ab5a1c",
                                                "sense_id": "6e0af7bf-7e70-3ba8-a6b0-86c7cbaa9c5c",
                                                "text": "The ability of a segment of a glass sphere to magnify whatever is placed before it was known around the year 1000, when the spherical segment was called a reading stone, essentially what today we might term a frameless magnifying glass or plain glass paperweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bb25914f-bdb3-3ea0-8f38-8c4fbe1f5908",
                                        "entry_id": "19954f00-3476-3604-81fd-305c6590c055",
                                        "glosses": [
                                            "Any object used for this purpose."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e8e1dcea-6599-4548-8655-16a0b56f2bf5",
                                                "sense_id": "bb25914f-bdb3-3ea0-8f38-8c4fbe1f5908",
                                                "text": "John used his coffee mug as a paperweight."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b1cbc260-619d-3a48-884c-016032ed94f9",
                                        "entry_id": "19954f00-3476-3604-81fd-305c6590c055",
                                        "glosses": [
                                            "A useless piece of equipment."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "78051f23-ede7-4804-948a-9ed50d34ebf5",
                        "source_entry_id": "62a5cebb-cbe6-324e-abd9-14ea15053b88",
                        "source_sense_id": "05f40c4e-840f-36d5-afa3-38838717422a",
                        "source_sense_description": "Gegenstand, der verhindert, dass Papier verweht wird",
                        "target_lang_word": "presse-papier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presse-papier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d9c16605-8092-3641-9b6f-7532fa6f71f9",
                                        "entry_id": "63133dbc-160c-31b3-a450-470cd969c092",
                                        "glosses": [
                                            "Objet lourd qu'on pose sur des papiers pour empêcher qu'ils se dispersent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3c3874c2-af91-42a0-a6b2-5946fb274bdb",
                                                "sense_id": "d9c16605-8092-3641-9b6f-7532fa6f71f9",
                                                "text": "Il nous a semblé que le meilleur parti à tirer de ces débris était d’en faire des presse-papiers auxquels nous conserverions, toutes les fois que cela serait possible, la forme inégale donnée au morceau de marbre par la cassure. Ceci décidé, nous avons voulu garnir ces morceaux de marbre, préalablement nettoyés et polis, d’un bouton permettant de les utiliser commodément comme presse-papier."
                                            },
                                            {
                                                "example_id": "b46d44e9-96f7-4129-af8f-7ba8974b47c7",
                                                "sense_id": "d9c16605-8092-3641-9b6f-7532fa6f71f9",
                                                "text": "Puis il passa dans le bureau décoré de calendriers, où Deniseau lui-même se tenait devant une table couverte de registres crasseux et de vieux fers à cheval qui servaient de presse-papier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c682b5e1-3061-3246-a110-61a097a1713a",
                                        "entry_id": "63133dbc-160c-31b3-a450-470cd969c092",
                                        "glosses": [
                                            "Élément du système d’exploitation qui stocke temporairement les données dans les opérations de copié-collé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf9674b8-a89b-412d-9c0b-bd7784d0bf21",
                                                "sense_id": "c682b5e1-3061-3246-a110-61a097a1713a",
                                                "text": "Comment accéder au presse-papier sur Windows 10 ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "02ef0353-1d18-4e4f-8a6a-4944ad698d83",
                        "source_entry_id": "62a5cebb-cbe6-324e-abd9-14ea15053b88",
                        "source_sense_id": "05f40c4e-840f-36d5-afa3-38838717422a",
                        "source_sense_description": "Gegenstand, der verhindert, dass Papier verweht wird",
                        "target_lang_word": "presse-papiers",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "presse-papiers",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a538eeb3-7a5b-37c0-be0d-d516c60629cf",
                                        "entry_id": "cf740da5-dfed-317a-ad17-c19c111bf41e",
                                        "glosses": [
                                            "Objet de marbre, de métal, de bois, etc., qu’on pose sur les papiers d’un bureau pour empêcher qu’ils ne se dispersent."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "671862f2-86d3-491d-a441-58fa52da10a8",
                                                "sense_id": "a538eeb3-7a5b-37c0-be0d-d516c60629cf",
                                                "text": "Sur sa table, un presse-papiers de marbre noir en forme de livre, au dos duquel on lit : Histoire de l’autre monde, fait songer à l’homme malicieux, au lombard caustique, en même temps qu’un dictionnaire italien-sarde, décèle le patriote passionné pour l'unité de langue."
                                            },
                                            {
                                                "example_id": "9b30d906-7ddb-498a-a2d5-17cb39cbd41c",
                                                "sense_id": "a538eeb3-7a5b-37c0-be0d-d516c60629cf",
                                                "text": "Et il y avait, à cet instant-là, un rayon de soleil sur le globe de cristal qui servait de presse-papiers au chef."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "239f0044-aeae-3b6d-a61c-266aba137f88",
                                        "entry_id": "cf740da5-dfed-317a-ad17-c19c111bf41e",
                                        "glosses": [
                                            "Élément du système d’exploitation qui stocke temporairement les données dans les opérations de copié-collé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f97f98b2-a412-427e-9f32-0b413f8b7fa7",
                                                "sense_id": "239f0044-aeae-3b6d-a61c-266aba137f88",
                                                "text": "Fonction d’un logiciel de traitement de texte qui supprime la portion sélectionnée d’un document pour la stocker provisoirement dans le presse-papiers et l’insérer ensuite dans un autre document ou à une autre place."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
