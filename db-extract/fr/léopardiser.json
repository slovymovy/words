                "senses": [
                    {
                        "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                        "entry_id": "9329c36a-1eba-3d44-80e7-a40ce5506ace",
                        "glosses": [
                            "Donner un caractère rappelant les taches d’un léopard à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dbae74c-fb0c-47b4-8b32-91965f36f1df",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "Verser l'appareil sur le fond de tarte précuit et enfourner à 180 ° pendant 35 minutes: la flaune doit commencer à se \"léopardiser\"."
                            },
                            {
                                "example_id": "3debbdb2-a4c8-4aca-a0af-dda62f9cec77",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "Je vais léopardiser ton petit Noël et je me le mettrai dans la crèche!!"
                            },
                            {
                                "example_id": "5a014bb2-7b9a-4680-a901-71ebf29771c7",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "Pour ma part, bien que j'adore me léopardiser les ongles, j'ai choisi le chat."
                            },
                            {
                                "example_id": "4db46edd-0092-497d-a85d-fb496b111a02",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "J'ai eu envie de « léopardiser » mes ongles, mais pas seulement, j'ai invité Mr zèbre à se joindre à nous !"
                            },
                            {
                                "example_id": "391bf4e6-a740-45c1-ad7a-e5a300872138",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "Je voulais dire léopardiser le territoire c'est-à-dire se ghettoïser pour prendre le contrôle des lieux."
                            },
                            {
                                "example_id": "17ac7c7d-6de6-4ae9-8a86-1f298e7e44b6",
                                "sense_id": "0954ecfe-f752-32df-bdc9-38ed95f350bc",
                                "text": "Libre à nous de léopardiser la partie de nous-même que nous souhaitons la plus sauvage."
                            }
                        ]
                    }
                ],
