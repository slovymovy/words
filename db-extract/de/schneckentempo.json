                    {
                        "form_id": "09c178ca-5682-4de3-b1d8-c6b6ea327047",
                        "entry_id": "41f19374-85fa-3ce9-aa68-f4c1e3e7b035",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "das Schneckentempo"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                        "entry_id": "41f19374-85fa-3ce9-aa68-f4c1e3e7b035",
                        "glosses": [
                            "ganz geringe Geschwindigkeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e4ae5ccd-b22c-416d-b3ed-ad1686894d4d",
                                "sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                                "text": "„Endlich fand ich eine Toilette, musste jedoch feststellen, dass die Warteschlange sich im Schneckentempo vorwärtsbewegte.“"
                            },
                            {
                                "example_id": "22703c92-e9b8-4423-b815-a0e31f7f4493",
                                "sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                                "text": "„Getrieben von den Studenten, wagt sich die Lehre eher im Schneckentempo in die Ist-Zeit.“"
                            },
                            {
                                "example_id": "19210ac2-5df9-41f2-ac21-720712dcfdae",
                                "sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                                "text": "„Von nun an ging der Weg in Serpentinen steil nach oben, und wir kamen mit dem schweren Wagen nur noch im Schneckentempo vorwärts.“"
                            },
                            {
                                "example_id": "707a07ad-a707-480f-b33a-2bffe27bc449",
                                "sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                                "text": "„Über der Straße hängt der Gestank von schlecht verbranntem Diesel, den teilweise kriminell überladene Lastwagen ausstoßen, die sich im Schneckentempo die Steigung hochquälen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b7a16ec2-e45b-4451-b69c-641bd43fd5c2",
                        "source_entry_id": "41f19374-85fa-3ce9-aa68-f4c1e3e7b035",
                        "source_sense_id": "5f80214e-b4d1-3940-8562-00a37ed24ee6",
                        "source_sense_description": "ganz geringe Geschwindigkeit",
                        "target_lang_word": "snail's pace",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "snail's pace",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                        "entry_id": "add3f410-15e3-3f6c-95f6-7f159f682a88",
                                        "glosses": [
                                            "A frustratingly slow rate of speed."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "30820d83-df0f-403c-a2b0-d0ad47b3f25d",
                                                "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                                "text": "My grandmother drives her car at a snail's pace."
                                            },
                                            {
                                                "example_id": "e417aec6-148f-46a5-acdc-9bcea802707a",
                                                "sense_id": "b42c453f-c4d8-306e-ae2c-9cdb997ffbf0",
                                                "text": "He describes the operation thus: \"The heavy ram employed to impart the finishing strokes, hoisted up with double purchase and snail's pace to the summit of the Piling Engine, and then falling down like a thunderbolt on the head of the devoted timber, driving it perhaps a single half inch in to the stratum below, is well calculated to put to the test the virtue of patience, while it illustrates the old adage of—slow and sure.\""
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "74857396-9613-4a9a-8b4f-c65421af804c",
                        "source_entry_id": "41f19374-85fa-3ce9-aa68-f4c1e3e7b035",
