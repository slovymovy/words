                        "sense_id": "73c989ac-15ee-3f40-b217-03736e86dca8",
                        "entry_id": "2f0d3fa1-3468-3fe2-a328-dd52800052b5",
                        "glosses": [
                            "A hike; an off-road walk in the countryside, possibly wearing a backpack, undertaken as a leisure activity."
                        ],
                        "tags": [
                            "Australia",
                            "New-Zealand"
                        ],
                        "examples": [
                            {
                                "example_id": "f3cb0061-f975-4cfc-a7ea-288e2d2f4899",
                                "sense_id": "73c989ac-15ee-3f40-b217-03736e86dca8",
                                "text": "There are also bushwalks in Sassafras Gully."
                            },
                            {
                                "example_id": "6ac3b28b-6dbc-4397-9e21-7f157dfe210d",
                                "sense_id": "73c989ac-15ee-3f40-b217-03736e86dca8",
                                "text": "The 24-sq-km Porongurup National Park is 12km long and has 1100-million-year-old granite outcrops, panoramic views, beautiful scenery, large karri trees and excellent bushwalks."
                            },
                            {
                                "example_id": "9748501b-c0e5-4b7c-bc36-14b8bf933fee",
                                "sense_id": "73c989ac-15ee-3f40-b217-03736e86dca8",
                                "text": "Some offer a guided coach tour during which you just stretch your legs, while others let you get your circulation going with a couple of longish bushwalks."
                            }
                        ]
                    }
                ],
