                "senses": [
                    {
                        "sense_id": "7b0a215d-7967-3a32-b2c5-c33db21be082",
                        "entry_id": "6b9bc44f-95ed-3c06-b410-bf39ebc96ea7",
                        "glosses": [
                            "ein ausschließlich im deutschen Weinbaugebiet Württemberg hergestellter Rotling"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0bef1426-3dc9-47d6-875e-9771f65e98fc",
                                "sense_id": "7b0a215d-7967-3a32-b2c5-c33db21be082",
                                "text": "Dieser Schillerwein erhielt seinen Namen durch seine typisch rötlich schillernde Farbe."
                            },
                            {
                                "example_id": "03976574-5320-4716-bc5c-d8554da4211a",
                                "sense_id": "7b0a215d-7967-3a32-b2c5-c33db21be082",
                                "text": "\"Ein Rotling muss mindestens die Qualitätsstufe QbA (Qualitätswein bestimmter Anbaugebiete) besitzen, um als Schillerwein vermarktet werden zu dürfen.\""
                            },
                            {
                                "example_id": "592306af-cd51-4612-8f19-dc0857a8a900",
                                "sense_id": "7b0a215d-7967-3a32-b2c5-c33db21be082",
                                "text": "\"Der Schillerwein ist ein Rotling aus dem Verschnitt von Rotwein- und Weißwein-Trauben, die zur gleichen Zeit geerntet und gekeltert werden.\""
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
