                        "glosses": [
                            "Type de palais à Java."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d59f18e-a5ed-461a-8c55-a5f488d86890",
                                "sense_id": "031529b9-f51f-3e37-adb2-ea2cb0d04217",
                                "text": "D’après l'article, le mouvement comptait une centaine de membres, en majorité des priyayi du kraton d’Hamengku Buwana VIII et de la région de Kedu."
                            },
                            {
                                "example_id": "e4be4830-ead6-4d36-bd47-dd4a769fc6e2",
                                "sense_id": "031529b9-f51f-3e37-adb2-ea2cb0d04217",
                                "text": "Dans ses plus belles expressions, l’architecture profane respecte, elle aussi, ces normes traditionnelles qui donnent aux kratons javanais, par leur décoration, et à leurs jardins, quelque air de parenté avec les palais marocains et leurs riads."
                            },
                            {
                                "example_id": "a515f0ab-67f0-4bcc-b684-048649b6b124",
                                "sense_id": "031529b9-f51f-3e37-adb2-ea2cb0d04217",
                                "text": "On connaît bien les kratons de Solo et celui de Djogjakarta. Le gamelan y accompagne le plus souvent les danseurs qui représentent des épisodes de la version javanaise du Ramayana indien."
                            }
                        ]
                    }
