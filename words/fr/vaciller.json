                    "frequency": "Middle",
                    "semantic_group_id": "mouvement_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après un long moment debout sous la chaleur, il a commencé à <w>vaciller</w> dangereusement."
                        },
                        {
                            "text": "L'arbre fragile semble <w>vaciller</w> sous les violentes rafales du vent d'automne."
                        }
                    ],
                    "synonyms": [
