                                "target_senses": [
                                    {
                                        "sense_id": "e03d4b69-b9b7-3dbc-b9b9-e897a5c1bb28",
                                        "entry_id": "f0b0a878-d68e-330f-a85c-3dfd2b1478e5",
                                        "glosses": [
                                            "von einer Neonröhre emittiertes, künstliches Licht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3e25ec65-d0c4-4067-b592-a5adef130db9",
                                                "sense_id": "e03d4b69-b9b7-3dbc-b9b9-e897a5c1bb28",
                                                "text": "Diese Neonröhre emittiert Neonlicht."
                                            },
                                            {
                                                "example_id": "00928874-73e3-4e1e-9d9c-2ec2d04262c3",
                                                "sense_id": "e03d4b69-b9b7-3dbc-b9b9-e897a5c1bb28",
                                                "text": "„Wir sahen uns zwinkernd an, als das Neonlicht kalt auf uns herunterplatschte, als hätten wir unanständige Geheimnisse gehabt.“"
                                            },
                                            {
                                                "example_id": "767c6fae-c990-42f7-a402-63f1fc311e9d",
                                                "sense_id": "e03d4b69-b9b7-3dbc-b9b9-e897a5c1bb28",
                                                "text": "„Aber im Moment sah man nur den matten Widerschein von Neonlicht auf der fahlen Haut.“"
                                            },
                                            {
                                                "example_id": "3e59df25-8ad1-4ca3-bd5f-aea831f2530a",
                                                "sense_id": "e03d4b69-b9b7-3dbc-b9b9-e897a5c1bb28",
                                                "text": "„Die Neonlichter des Fernfahrerlokals draußen schimmern trüb und verwaschen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
