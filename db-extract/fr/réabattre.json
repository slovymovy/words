                ],
                "senses": [
                    {
                        "sense_id": "9e8b3137-7c13-318c-a701-e382d75fc5fa",
                        "entry_id": "ca9ebc9c-d614-3306-8455-f77e6d432ce7",
                        "glosses": [
                            "Abattre de nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f161e4fa-d0fe-484a-b8c3-8a3d25154638",
                                "sense_id": "9e8b3137-7c13-318c-a701-e382d75fc5fa",
                                "text": "Va pas falloir qu’on retourne tout de suite se coucher, hein ? — Non ! Je dis non ! Non, on se laissera pas réabattre comme ça ! Ils ne prévaudront pas ! On va tenir tête !"
                            },
                            {
                                "example_id": "972864c2-3b18-4da7-8836-7d46e082c5b3",
                                "sense_id": "9e8b3137-7c13-318c-a701-e382d75fc5fa",
                                "text": "Pour faire cette opération différemment, il faut abattre à grands frais le bâtiment, d'une manière qui le fatigue beaucoup ; il faut presque tous les soirs le relever pour la nuit seulement, de manière à éviter les dangers et la variabilité du temps, pendant la nuit, pour le réabattre le lendemain."
                            }
                        ]
                    }
                ],
