                                                "sense_id": "4a4064e5-75d6-3249-8e77-1d3df4739786",
                                                "text": "„Der Hall der langsam gesetzten Worte erfüllte den Raum.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "35a5a0cf-b750-3e38-a7b8-66d12879f5b5",
