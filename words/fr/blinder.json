                    ],
                    "synonyms": [
                        "s'endurcir",
                        "s'insensibiliser",
                        "s'aguerrir"
                    ],
                    "antonyms": [
                        "s'attendrir",
                        "s'affaiblir"
                    ],
                    "common_phrases": [
                        "se blinder contre les critiques"
                    ],
                    "traits": [
