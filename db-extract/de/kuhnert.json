                ],
                "senses": [
                    {
                        "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                        "entry_id": "257e832d-a7c0-3cf0-a98b-51b1e6817cd0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d44ee66-8136-4838-85e5-af5dced8f400",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Frau Kuhnert ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "791d3260-7e26-4966-ab7c-e16448e2dd23",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Herr Kuhnert wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c378bab6-2a08-47bd-8e07-e45961b2c2a6",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Die Kuhnerts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "c192fb3c-8c47-40bf-a8b8-3fd3e9e9bc88",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Der Kuhnert trägt nie die Schals, die die Kuhnert ihm strickt."
                            },
                            {
                                "example_id": "7da19ac6-8928-4b82-b4ab-790e3630b906",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kuhnert kommt, geht der Herr Kuhnert.“"
                            },
                            {
                                "example_id": "fff2ce62-b49e-4bc4-9855-ddf1d0e37b01",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Kuhnert kommt und geht."
                            },
                            {
                                "example_id": "6343f7f7-45c9-4423-96b6-e44be6eb68b2",
                                "sense_id": "d24b49e3-0c47-3ab1-88f3-dd5224b387dc",
                                "text": "Kuhnerts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
