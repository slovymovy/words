                    {
                        "sense_id": "c59023f8-6df0-37e8-92ba-2b3286e085e8",
                        "entry_id": "a2ff101d-9344-3842-b551-34bcf95b2f61",
                        "glosses": [
                            "mannelijke sopraan- of altzanger, die als gevolg van een jeugdige castratie, de jongensstem heeft behouden."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6baa1d55-c1c1-4c12-9714-48a8000f65d4",
                                "sense_id": "c59023f8-6df0-37e8-92ba-2b3286e085e8",
                                "text": "In de zeventiende eeuw zongen castraten in de Sixtijnse kapel de sopraanstemmen."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ba4c7280-9ce9-47d4-8821-e49efb5cd65c",
                        "source_entry_id": "a2ff101d-9344-3842-b551-34bcf95b2f61",
                        "target_lang_word": "Kastrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kastrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "bbcaafa8-a944-325c-bbaf-f548d0047d60",
                                        "entry_id": "addae9fe-2074-392d-90b8-5ab2ba4910a9",
                                        "glosses": [
                                            "entmannte/kastrierte männliche Person"
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e5f8780-9fd3-464e-af02-67b53fc15c3f",
                                                "sense_id": "bbcaafa8-a944-325c-bbaf-f548d0047d60",
                                                "text": "„Denn der Mann hatte das hohe, pfeifende Lachen eines Kastraten, und während ihm Tränen der Heiterkeit aus den Augen strömten, pochte er mit seinem Stock auf den Boden.“"
                                            },
                                            {
                                                "example_id": "082b89d6-7f01-4bf1-802d-cd21894d1ad9",
                                                "sense_id": "bbcaafa8-a944-325c-bbaf-f548d0047d60",
                                                "text": "„Hätte es Kastraten gegeben, sie wären ihr gerade recht gewesen.“"
                                            },
                                            {
                                                "example_id": "318de96d-1e34-4f15-ba2d-fa6af27c2d4f",
                                                "sense_id": "bbcaafa8-a944-325c-bbaf-f548d0047d60",
                                                "text": "„Seine Hüften und Schenkel ließen mich glauben, er sei ein verkleidetes Mädchen; das sagte ich zu Abate Gama, und er erwiderte, das sei Beppino della Mammana, ein berühmter Kastrat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "817a9e40-1f66-4b71-9bbb-0ceb2cb3ee2b",
                        "source_entry_id": "a2ff101d-9344-3842-b551-34bcf95b2f61",
                        "target_lang_word": "castrat",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "castrat",
