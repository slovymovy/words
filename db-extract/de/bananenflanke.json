                ],
                "senses": [
                    {
                        "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                        "entry_id": "f6446c5d-e704-35a5-b98d-e57f88495ccc",
                        "glosses": [
                            "Flanke, die in bananenförmiger Flugbahn vor das gegnerische Tor gebracht wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "76491d0d-2deb-4998-8bf2-823d1a927291",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "Die gekrümmte Flugbahn, die der Ball bei der Bananenflanke beschreibt, entsteht durch die Rotation des Balls."
                            },
                            {
                                "example_id": "e4fe055f-9f49-4d98-826d-e377ea54803a",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "Horst Hrubesch hat aus zahlreichen Bananenflanken ein Tor gemacht."
                            },
                            {
                                "example_id": "4a1eac5f-9ca9-4389-889f-5f0b7d5879a3",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "Die Bananenflanken von Manni Kaltz waren hoch gefürchtet."
                            },
                            {
                                "example_id": "a77295e9-cd82-41cf-b1d1-2e088b58726a",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "Manni Kaltz ist der ungekrönte König der Bananenflanke."
                            },
                            {
                                "example_id": "fa3b4a6d-49f4-4058-aebf-c1b9aad6724b",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "„Nationalverteidiger Manfred Kaltz, der unter Happel langsam zum offensiven Mittelfeldspieler wird, schlägt seine Bananenflanken immer zielgenauer auf Hrubeschs Schädel.“"
                            },
                            {
                                "example_id": "f1ef2b4f-e0f5-40b9-8173-960724c5d299",
                                "sense_id": "dad8dd31-d74b-3f47-b95a-deb3dab173ba",
                                "text": "„Dem eigentlichen Erfinder der ‚Bananenflanke‘, als den nicht wenige Dörfel – und nicht Manfred Kaltz – bezeichnen, steht eine glänzende Laufbahn bevor.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
