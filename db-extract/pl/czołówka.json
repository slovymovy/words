                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1c996135-ea97-4df4-b417-4298026a6f88",
                        "source_entry_id": "fde7e123-e7ce-3c94-93fb-e9a1279794d8",
                        "source_sense_id": "901d3b76-19f8-3f68-aa8f-27a31170af5c",
                        "target_lang_word": "фонарь",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "фонарь",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "7dfde195-5dd6-3f3f-8345-b51589378eae",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "искусственный источник света, устанавливаемый для освещения улиц, дорог и т. п. в тёмное время суток"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c34047a0-12a1-4265-9cd0-2473f91f47b2",
                                                "sense_id": "7dfde195-5dd6-3f3f-8345-b51589378eae",
                                                "text": "Фонарь у подъезда скрипел и раскачивался, и вместе с ним раскачивались светлые полосы на потолке и стенах."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1b1efe8-10f1-33e0-9122-c2306e2b7f21",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "то же, что карманный фонарь; портативный осветительный прибор с направленным лучом света"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8aecb61f-b2bd-4127-8757-6e9edc3ab4e4",
                                                "sense_id": "d1b1efe8-10f1-33e0-9122-c2306e2b7f21",
                                                "text": "Помню, он стоял посреди кухни и, стоя, пил чай из чашки, а Соня чистила щёткой баул, необыкновенно пыльный, и вдруг погас свет, стали искать свечку или фонарь, в это время объявили тревогу."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "199650e0-f7e4-3ccb-8bf5-4101f51093cd",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "разг. ирон. синяк от удара, как правило, вокруг глаза"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bfdde0f9-1e59-4305-9a30-becb4c86801f",
                                                "sense_id": "199650e0-f7e4-3ccb-8bf5-4101f51093cd",
                                                "text": "Под глазом полыхал фонарь — последствие драки с охранниками клуба «Тринадцать попугайчиков», попытавшимися завернуть Халявия на фэйс-контроле."
                                            },
                                            {
                                                "example_id": "596309d0-5a5b-433b-bacd-7d6e7928531c",
                                                "sense_id": "199650e0-f7e4-3ccb-8bf5-4101f51093cd",
                                                "text": "— Я вот сейчас поставлю тебе фонарь под другим глазом, — ласково сказал Крячко."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f9466d25-4bb5-38e1-8e9a-67d751835d91",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "то же, что огонь; осветительный прибор на транспортном средстве, как правило, предназначенный для сигнализации"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9e806236-bc75-412a-a5e7-a42178f71644",
                                                "sense_id": "f9466d25-4bb5-38e1-8e9a-67d751835d91",
                                                "text": "Фонарь хвостового вагона прощально мигнул петербургскому периоду русской истории, а фонарь локомотива бросил прямой сноп туда, где воспрянет период московитский."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd12c85b-ae6e-3b53-af1d-d314234dc3dd",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "архит. источник света в виде застеклённого отверстия в потолке комнаты, лестничного проёма или зала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1f95bd88-731d-4437-8805-8be32f769c1f",
                                                "sense_id": "dd12c85b-ae6e-3b53-af1d-d314234dc3dd",
                                                "text": "Там вместо потолка и крыши — высокий стеклянный фонарь; вечерами, налитый светом, он светил, как маяк."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fc243b5f-44d3-3338-a61a-b45b96559941",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "авиац. прозрачный колпак, закрывающий кабину лётчика"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "62026b62-ec73-42db-9c74-9168d5095643",
                                                "sense_id": "fc243b5f-44d3-3338-a61a-b45b96559941",
                                                "text": "Защёлкиваешь фонарь над головой, убеждаешься, закрыты ли задняя форточка, интерцепторы и замок для крепления троса."
                                            },
                                            {
                                                "example_id": "2e35a18d-cf76-49f6-bf11-1ccd7a422875",
                                                "sense_id": "fc243b5f-44d3-3338-a61a-b45b96559941",
                                                "text": "Однако фонарь кабины не отстрелился, а крышку штурманского люка заело."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b5e05a33-e722-37a0-a876-21b9a4d6534b",
                                        "entry_id": "97c8c9fe-3e5c-39d7-a427-8aa571e21637",
                                        "glosses": [
                                            "стеклянное окно в трубопроводе"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e434bd67-e7ef-43c5-9fc7-954d8efb505d",
                                                "sense_id": "b5e05a33-e722-37a0-a876-21b9a4d6534b",
                                                "text": "Ещё одним особенным видом продукции, которую изготавливает ООО «Профиль-Арма», являются смотровые фонари для трубопроводов."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
