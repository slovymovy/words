                                        "examples": [
                                            {
                                                "example_id": "ce29dafd-b112-4ec7-a571-eaa6287bef07",
                                                "sense_id": "c74c256e-361b-36c3-8986-09ded153d763",
                                                "text": "Der Spitzenkandidat kassierte bei der Landtagswahl einen derben Rückschlag."
                                            },
                                            {
                                                "example_id": "bc944a8a-c380-430a-adfd-d0f8a6e8f812",
                                                "sense_id": "c74c256e-361b-36c3-8986-09ded153d763",
                                                "text": "„Jüttner unterlag als Spitzenkandidat der Niedersachsen-SPD 2008 gegen Wulff.“"
                                            },
                                            {
                                                "example_id": "c3f953f1-1c3a-486d-8dd1-f2642175a68b",
                                                "sense_id": "c74c256e-361b-36c3-8986-09ded153d763",
                                                "text": "„Bei seiner Wahl zum Spitzenkandidaten hatte Pretzell vorigen September gegen einen wenig bekannten Gegenkandidaten auch nur 54 Prozent der Delegierten überzeugt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb47abf6-15ce-49ea-96d1-f6fe21a06df8",
                        "source_entry_id": "0d5d9366-332b-3e91-8175-b092d90a5187",
