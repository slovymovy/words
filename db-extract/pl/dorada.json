                    {
                        "translation_id": "ca1b4e05-e970-4b66-8577-eacfc8df23b4",
                        "source_entry_id": "42012d66-da6c-3bb5-af77-e9a1f41acf7d",
                        "source_sense_id": "b67a6e95-19d0-315d-8635-deea13f44a66",
                        "target_lang_word": "daurade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "daurade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5376122e-8890-3d36-abf1-5e49d9274a53",
                                        "entry_id": "4d6c7a77-686f-3d05-9972-9d81d6c2bb60",
                                        "glosses": [
                                            "Poisson de la famille des Sparidés, très commun dans la mer Méditerranée, et dont il existe plusieurs espèces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cca1500f-384a-4c37-9382-9cf244eea3ae",
                                                "sense_id": "5376122e-8890-3d36-abf1-5e49d9274a53",
                                                "text": "Ainsi, une daurade de mer met douze ans pour atteindre 43 cm, taille qu’elle aurait acquise dans le lac en trois ans seulement."
                                            },
                                            {
                                                "example_id": "2ccde5d2-c985-47d4-8f61-061163c7bc6e",
                                                "sense_id": "5376122e-8890-3d36-abf1-5e49d9274a53",
                                                "text": "Ils se baigneront longuement à Carthage, au milieu des ruines, à La Marsa ; ils iront jusqu’à Utique, à Kelibia, à Nabeul, où ils achèteront des poteries, à la Goulette où, tard dans la nuit, ils mangeront d’extraordinaires daurades."
                                            },
                                            {
                                                "example_id": "2cfba931-52ca-4175-9466-fc8aaa46d4be",
                                                "sense_id": "5376122e-8890-3d36-abf1-5e49d9274a53",
                                                "text": "Une glissade, et j’aurais été par-dessus bord, tandis que mon navire, sans maître désormais, s’en serait allé au loin, me laissant pour nourriture aux requins et aux daurades."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7eb365ea-8143-3231-a454-8c35269844ac",
                                        "entry_id": "4d6c7a77-686f-3d05-9972-9d81d6c2bb60",
                                        "glosses": [
                                            "Variante de daurade royale (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6132e931-c5e1-3ca8-bd25-e6a041f2adf6",
                                        "entry_id": "4d6c7a77-686f-3d05-9972-9d81d6c2bb60",
                                        "glosses": [
                                            "Synonyme de coryphène (poisson)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f30fcbe-e95e-4521-a67a-1472ec943eae",
                        "source_entry_id": "42012d66-da6c-3bb5-af77-e9a1f41acf7d",
                        "source_sense_id": "b67a6e95-19d0-315d-8635-deea13f44a66",
                        "target_lang_word": "dorade",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dorade",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                                        "glosses": [
                                            "Poisson osseux marin, sparidé aux écailles dorées."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e78c45ff-054b-43dc-a181-79930e665c07",
                                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                                "text": "J’aurais voulu montrer aux enfants ces dorades\nDu flot bleu, ces poissons d’or, ces poissons chantants."
                                            },
                                            {
                                                "example_id": "b609ac3c-9658-4e53-adc2-9ecb18714b52",
                                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                                "text": "Quelles boules ! dit Bixiou à du Bruel, quelle belle caricature si on les dessinait sous forme de raies, de dorades, et de claquarts (nom vulgaire d’un coquillage) dansant une sarabande !"
                                            },
                                            {
                                                "example_id": "6607eb63-345a-4ddd-ba06-c621983f8313",
                                                "sense_id": "f2e8f794-2d6f-3673-8efe-6e33e38511ae",
                                                "text": "Le souvenir inoubliable de cette petite lecture furtive a été cause que, pendant mes quarts à la mer, chaque fois qu’un timonier m’a signalé un passage de dorades, j’ai toujours tourné les yeux pour les regarder ; et toujours j’ai trouvé une espèce de charme à noter ensuite l’incident sur le journal du bord, — si peu différent de celui que ces marins de juin 1813 avaient tenu avant moi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dd43a40c-18ad-3058-876f-1c9251ca865e",
                                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                                        "glosses": [
                                            "Synonyme de daurade royale."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc7a0392-9a6b-3a3d-98da-4ed0c8d88047",
                                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                                        "glosses": [
                                            "Nom parfois donné au coryphène, poisson osseux marin, poisson de la famille des coryphaenidés."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf23f1df-5564-4ab7-9127-181548257a77",
                                                "sense_id": "cc7a0392-9a6b-3a3d-98da-4ed0c8d88047",
                                                "text": "Les dorades, qui aiment le gros temps, sautent autour du Firecrest qui fait route plein Sud."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4010dc78-6f9a-340d-b4eb-f97557ec6bc0",
                                        "entry_id": "b143dd3d-7254-3e42-bbfa-64fb5ea9a8c8",
                                        "glosses": [
                                            "Synonyme de cétérach officinal."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
