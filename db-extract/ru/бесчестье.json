                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94e57d53-6f00-4d66-a654-3020904e0e9d",
                                                "sense_id": "2aa4e8d7-adf1-3763-b766-b4007ae6c7fe",
                                                "text": "You have brought dishonour upon the family."
                                            },
                                            {
                                                "example_id": "0bfc359c-badc-4528-8c21-7692ee2e9ae6",
                                                "sense_id": "2aa4e8d7-adf1-3763-b766-b4007ae6c7fe",
                                                "text": "That which were a dishonour to God the Son, were a dishonour to God the holy Ghost."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fa0628bd-b629-3952-be07-e5870e074c7d",
                                        "entry_id": "1d90fa30-d223-3ccf-8bed-5267e16b4c3f",
                                        "glosses": [
                                            "Lack of honour or integrity."
                                        ],
