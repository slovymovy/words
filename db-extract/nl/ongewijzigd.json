                "senses": [
                    {
                        "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                        "entry_id": "72e72e5b-de2b-3d82-9b86-1e5534fed367",
                        "glosses": [
                            "zonder verandering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "afeba1c7-16d7-4940-a615-62fe0423a417",
                                "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                                "text": "Die ongewijzigde rentestand verbaasde vriend en vijand."
                            },
                            {
                                "example_id": "1559f386-dbb2-4ed2-b29c-32f2a42ffb25",
                                "sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                                "text": "Voor het huidige personeel bleven de afspraken ongewijzigd, maar voor nieuwe medewerkers zijn de arbeidsvoorwaarden versoberd."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9261222b-41b0-4edd-96ea-1a783fac68e1",
                        "source_entry_id": "72e72e5b-de2b-3d82-9b86-1e5534fed367",
                        "source_sense_id": "513e2ff7-d4e4-3479-9c25-d18a38a7e0cd",
                        "source_sense_description": "zonder verandering",
                        "target_lang_word": "unaltered",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unaltered",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                        "entry_id": "4e8e02a1-8bad-3e54-b077-4bd09e732789",
                                        "glosses": [
                                            "Remaining in its initial state; not changed."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfc91a93-1677-4976-be26-1080f4b67914",
                                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                                "text": "\"A first love is not easily extinguished, Mr. Allanson,\" said she. \"You may guess from my appearance, that I have been fortunate in life; but, for all that, my first love for you has continued the same, unaltered and unchanged, and you must forgive the little freedoms I used to-day to try your affections, and the effects my appearance would have on you.\""
                                            },
                                            {
                                                "example_id": "bb4e817e-9838-4bed-ae9a-f461fc9aa740",
                                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                                "text": "Pat found subject and scene of his wooing unaltered, but all his specious blandishments could not induce the matured matron of 'Gi' Away Nothin' 'All' to join fortunes, though his perseverance would have delighted Bruce's spider."
                                            },
                                            {
                                                "example_id": "6869a395-6759-4b7a-8f43-f67a93d18e83",
                                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                                "text": "But beyond these cut-offs, to avoid the wholesale alteration of all mileposting and mileages—of bridges and culverts, for example—the original mileposts have remained unaltered."
                                            },
                                            {
                                                "example_id": "aae0c8bb-1a4e-4be7-bb62-3171c0915c3d",
                                                "sense_id": "9280ce29-9cc0-3460-b0b2-4721f3103361",
                                                "text": "The new yearbooks at Wall Township High School in Wall, New Jersey – with the original, unaltered photos – will be available for students to pick up in about two weeks, Cheryl Dyer, the superintendent of Wall Township schools, said in a letter to students and parents."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
