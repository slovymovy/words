                                    {
                                        "sense_id": "b1b1fbcb-8474-3af4-94a0-61bbf2519ffb",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "unabhängig, nicht gefangen, nicht versklavt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8eae2e2-7301-48f5-bc0f-ac808a7721a1",
                                                "sense_id": "b1b1fbcb-8474-3af4-94a0-61bbf2519ffb",
                                                "text": "Ich bin ein freier Mann und mache, was ich machen kann."
                                            },
                                            {
                                                "example_id": "6b8335f7-b87b-4b26-a1a5-830db3e62168",
                                                "sense_id": "b1b1fbcb-8474-3af4-94a0-61bbf2519ffb",
                                                "text": "Die freie Lüftung eines Raumes kann durch das öffnen eines Fensters erfolgen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6f46b8f6-b5b0-3d41-a728-8d82848beda9",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "ungehindert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bed937c-6a66-4a89-b397-044c05fdda53",
                                                "sense_id": "6f46b8f6-b5b0-3d41-a728-8d82848beda9",
                                                "text": "Der Weg ist frei."
                                            },
                                            {
                                                "example_id": "a3dcdb98-aebc-4ee9-b7e7-4b3192269728",
                                                "sense_id": "6f46b8f6-b5b0-3d41-a728-8d82848beda9",
                                                "text": "„Deltafliegen ist eine wunderbare, freie Art von Fliegen, die dem Vogelflug bestimmt am nächsten kommt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3cd6dae6-2087-3379-87e9-48dfda09e25d",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "ohne"
                                        ],
                                        "tags": [
                                            "frei von"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0badbc33-93fa-4604-9c50-5a5b05d18a64",
                                                "sense_id": "3cd6dae6-2087-3379-87e9-48dfda09e25d",
                                                "text": "Wir kaufen nur Waren frei von Konservierungsstoffen ein."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "25c3b5b1-3426-3c93-ae61-5d73843cac8e",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "uneingeschränkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "02496ea4-8c11-4227-833c-aeb44adc7f8c",
                                                "sense_id": "25c3b5b1-3426-3c93-ae61-5d73843cac8e",
                                                "text": "Sie können hier frei schalten und walten."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "fb3159de-2d0f-35ef-a6eb-814026d361fc",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "kostenlos"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03803124-de1d-41ff-ae98-deae2145195f",
                                                "sense_id": "fb3159de-2d0f-35ef-a6eb-814026d361fc",
                                                "text": "Kinder haben freien Eintritt."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "7c5af2e7-d77a-3d5c-9747-b9edb8275183",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "nicht besetzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a867693e-4dc1-4667-8f37-25577678add6",
                                                "sense_id": "7c5af2e7-d77a-3d5c-9747-b9edb8275183",
                                                "text": "Entschuldigen Sie, ist hier noch frei?"
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    },
                                    {
                                        "sense_id": "6bec1d3b-fcaf-3212-b18e-105d50fd6a06",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "nicht eingegrenzt, unbegrenzt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73ff3294-26e8-48ce-845e-9efc9eee4d5e",
                                                "sense_id": "6bec1d3b-fcaf-3212-b18e-105d50fd6a06",
                                                "text": "\"Ich fühle mich in Gottes freier Natur wohler als in der Kirche\", meinte er."
                                            },
                                            {
                                                "example_id": "b6f37939-6b16-4cf6-92b7-6cf711d7be3a",
                                                "sense_id": "6bec1d3b-fcaf-3212-b18e-105d50fd6a06",
                                                "text": "„Dieses den jungen Goethe ergreifende Verlangen, sich in den unendlichen Luftraum zu stürzen und über den schauerlichen Abgründen zu schweben, frei zu werden wie der Adler im Äther, beflügelt und bewegt auch die heutigen Delta- und Gleitschirmpiloten, die dank des opferbereiten Wagemuts Lilienthals und anderer Flugpioniere diesen Traum heute zu realisieren vermögen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"7\""
                                    },
                                    {
                                        "sense_id": "73bff258-88c9-3d1e-83ea-328558a6bbb8",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "verfügbar, ohne Arbeit oder Verpflichtung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "285d5510-b760-43a9-9e30-4f11524eed79",
                                                "sense_id": "73bff258-88c9-3d1e-83ea-328558a6bbb8",
                                                "text": "Ich habe heute frei."
                                            },
                                            {
                                                "example_id": "1dd89c53-1114-4218-a6a4-dd4093b743d1",
                                                "sense_id": "73bff258-88c9-3d1e-83ea-328558a6bbb8",
                                                "text": "Heute ist mein freier Tag."
                                            }
                                        ],
                                        "sense_index_json": "\"8\""
                                    },
                                    {
                                        "sense_id": "b7276584-bbf7-317b-b4cf-5222be781aec",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "freiberuflich, freischaffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7117b4ba-1e27-4570-b615-47bc0fc860fa",
                                                "sense_id": "b7276584-bbf7-317b-b4cf-5222be781aec",
                                                "text": "Sie ist freie Architektin und Schriftstellerin."
                                            }
                                        ],
                                        "sense_index_json": "\"9\""
                                    },
                                    {
                                        "sense_id": "022059af-8bdd-364f-b64a-8549f6601580",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "unbedeckt"
                                        ],
                                        "tags": [
                                            "von einem Körperteil"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "811f3475-db9d-4332-9220-6bb419909d81",
                                                "sense_id": "022059af-8bdd-364f-b64a-8549f6601580",
                                                "text": "Die Soldaten trainierten an den Geräten auf dem Hof mit freiem Oberkörper."
                                            },
                                            {
                                                "example_id": "531122e6-725a-4bf2-83dd-0223fb6aa56a",
                                                "sense_id": "022059af-8bdd-364f-b64a-8549f6601580",
                                                "text": "\"Bitte machen Sie sich frei\", sagte der Arzt."
                                            }
                                        ],
                                        "sense_index_json": "\"10\""
                                    },
                                    {
                                        "sense_id": "d3d512e1-443d-338c-911b-51050154d1b7",
                                        "entry_id": "30c32b37-48ec-38b0-b2c3-9632ea14cdc0",
                                        "glosses": [
                                            "unverheiratet"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "51c2de1c-08e5-4b56-9651-6e4e6b541e62",
                                                "sense_id": "d3d512e1-443d-338c-911b-51050154d1b7",
                                                "text": "Sie haben Glück, ich bin noch frei!"
                                            }
                                        ],
                                        "sense_index_json": "\"11\""
                                    }
