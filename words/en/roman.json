                            "comment": "literary context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Роман (литературный жанр).",
                        "zh": "长篇小说。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "роман",
                                "target_lang_sense_clarification": "литературный жанр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "小说",
                                "target_lang_sense_clarification": "文学体裁"
                            }
                        ]
                    }
                }
            ]
        },
