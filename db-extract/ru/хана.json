                    {
                        "sense_id": "e5bd6817-d56a-3f8b-942a-b8c29021e5e9",
                        "entry_id": "2824d72a-b60b-39b3-a79f-a57275f9c499",
                        "glosses": [
                            "it is doomed, it is hopeless, it's the end"
                        ],
                        "tags": [
                            "impersonal",
                            "predicative",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "426d0dc0-3b7f-4703-996b-d6cfbbb2c25a",
                                "sense_id": "e5bd6817-d56a-3f8b-942a-b8c29021e5e9",
                                "text": "тебе́ хана́",
                                "translation": "you are in deep trouble, you are in the dead end, you are in the hopeless situation",
                                "english": "you are in deep trouble, you are in the dead end, you are in the hopeless situation"
                            },
                            {
                                "example_id": "a46bf770-aeea-4809-b318-45428d053a66",
                                "sense_id": "e5bd6817-d56a-3f8b-942a-b8c29021e5e9",
                                "text": "э́то хана́",
                                "translation": "it's doomed, it's the end",
                                "english": "it's doomed, it's the end"
                            },
                            {
                                "example_id": "f9e7fed6-66f3-4484-b970-90076d81d6fc",
                                "sense_id": "e5bd6817-d56a-3f8b-942a-b8c29021e5e9",
                                "text": "— Сочине́ние написа́ла уже́?\nХло́я кивну́ла.\n— Списа́ла. А ты?\n— Нет, — сказа́л Грым. — Я не начина́л да́же.\n— Тогда хана́ тебе́, — констати́ровала Хло́я.",
                                "translation": "‘Have you written your essay already?’\nChloe nodded.\n‘I cribbed it. How about you?’\n‘No,’ said Grim. ‘I haven’t even started.’\n‘Then you’re screwed.’",
                                "english": "‘Have you written your essay already?’\nChloe nodded.\n‘I cribbed it. How about you?’\n‘No,’ said Grim. ‘I haven’t even started.’\n‘Then you’re screwed.’"
                            }
                        ]
                    }
