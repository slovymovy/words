{
    "word_family": [
        "law",
        "lawful",
        "lawyer",
        "lawless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "05da8178-104f-3beb-b75c-f806ddfb8375",
                    "sense_definition": "A local custom or law of a settlement or district.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "local_regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The village council decided to enforce an old <w>bylaw</w> regarding noise levels.",
                            "target_lang_translations": {
                                "zh": "村委会决定执行一项关于噪音水平的旧<w>地方法规</w>。"
                            }
                        },
                        {
                            "text": "Residents gathered to discuss the new <w>bylaw</w> affecting local property rights.",
                            "target_lang_translations": {
                                "zh": "居民们聚集在一起讨论影响当地财产权的新<w>地方法规</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ordinance"
                    ],
                    "common_phrases": [
                        "local bylaw"
                    ],
                    "target_lang_definitions": {
                        "zh": "地方政府或社区制定的法规或条例。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "地方法规",
                                "target_lang_sense_clarification": "指特定地区或社区适用的法规。"
                            },
                            {
                                "target_lang_word": "地方条例",
                                "target_lang_sense_clarification": "指地方政府制定的具体管理规定。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "16ad77d8-a462-308e-9e7f-847e74ba254d",
                    "sense_definition": "A rule made by a local authority to regulate its own affairs.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "local_regulation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The city council passed a <w>bylaw</w> to restrict parking on narrow streets.",
                            "target_lang_translations": {
                                "zh": "市议会通过了一项限制在狭窄街道停车的<w>市政条例</w>。"
                            }
                        },
                        {
                            "text": "Every citizen must follow the <w>bylaw</w> established by the municipal government.",
                            "target_lang_translations": {
                                "zh": "每位公民都必须遵守市政当局制定的<w>市政条例</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ordinance"
                    ],
                    "common_phrases": [
                        "municipal bylaw"
                    ],
                    "target_lang_definitions": {
                        "zh": "地方行政机构为管理自身事务而制定的规则。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "市政条例",
                                "target_lang_sense_clarification": "指城市或市政当局制定的管理规则。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2d935d52-3ee3-384f-8571-8485b5ba7bbc",
                    "sense_definition": "A law or rule governing the internal affairs of an organization.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "corporate_governance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company updated its <w>bylaw</w> to change how board members are elected.",
                            "target_lang_translations": {
                                "zh": "公司更新了其<w>章程</w>，以改变董事会成员的选举方式。"
                            }
                        },
                        {
                            "text": "We reviewed the corporate <w>bylaw</w> to ensure our meeting procedures were compliant.",
                            "target_lang_translations": {
                                "zh": "我们审查了公司<w>章程</w>，以确保我们的会议程序合规。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "corporate bylaw"
                    ],
                    "target_lang_definitions": {
                        "zh": "组织或公司内部用于规范其运作的章程或规则。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "章程",
                                "target_lang_sense_clarification": "指组织或公司内部的规章制度。"
                            },
                            {
                                "target_lang_word": "内部细则",
                                "target_lang_sense_clarification": "指组织内部具体的运作规则。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}