                                    }
                                ]
                            },
                            {
                                "target_word": "lugger",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b4a850a2-fa19-37c1-bb3d-88bfe6128b89",
                                        "entry_id": "a118b208-18dc-3ed5-9c89-7eb841865a3b",
                                        "glosses": [
                                            "An Indian falcon (Falco jugger), similar to the European lanner and the American prairie falcon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40e35806-0f85-492a-a19e-ea3c76d06f3e",
                                                "sense_id": "b4a850a2-fa19-37c1-bb3d-88bfe6128b89",
                                                "text": "Falconry is a difficult art to master, some species more so than others. Sakers and Luggers are known to be problematic, and easy to lose, or to lose patience with."
                                            }
                                        ]
