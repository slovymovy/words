                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94cf38df-d3ad-41e9-9783-c54d4b0afb46",
                                                "sense_id": "9a258fe1-9e66-3f01-8231-8654926612f1",
                                                "text": "“So your friend was into drugs, is that what you’re saying. He’s a Candy Man. That’s some friend to have, I don’t think.” She looked puzzled. “Candy Man,” she repeated. “I don’t understand.” A Candy Man is a slang term for a drug dealer,” I explained."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6ea73c60-8884-3754-a34d-0df5c36dcd0e",
                                        "entry_id": "fa3624ea-6c81-3ab5-a33f-fd8ca4bb5434",
                                        "glosses": [
                                            "A person who sells sweets, especially a sidewalk or street vendor."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc79bd9-cb2a-4dc3-98d9-a122087f268a",
                                                "sense_id": "6ea73c60-8884-3754-a34d-0df5c36dcd0e",
                                                "text": "\"There comes the candy-man!\" exclaimed a little fellow, pressing up to the side of the lady. \"Quick, ma! Here, candy-man!\" calling after an old man with a tin cylinder under his arm."
                                            }
                                        ]
                                    }
