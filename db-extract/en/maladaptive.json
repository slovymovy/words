                    },
                    {
                        "translation_id": "dde715c6-95f8-42d6-8ed4-4ebdaa4524d9",
                        "source_entry_id": "5647f428-9ce6-3260-92db-982f8ead253f",
                        "source_sense_description": "Translations",
                        "target_lang_word": "unangepasst",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unangepasst",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b0d70146-821d-3f10-bad1-156b31e46ca3",
                                        "entry_id": "14ee745c-9187-3ee2-86a5-003979037588",
                                        "glosses": [
                                            "für die Situation nicht angemessen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7ef00ae5-a458-4103-987c-9aa47453debf",
                                                "sense_id": "b0d70146-821d-3f10-bad1-156b31e46ca3",
                                                "text": "In den meisten Fällen ist menschliches Versagen schuld: unangepasste Geschwindigkeit, Überschätzung der Lage, Alkohol am Steuer."
                                            },
                                            {
                                                "example_id": "fccc3abf-ed18-4c50-bcaa-c9226e76e301",
                                                "sense_id": "b0d70146-821d-3f10-bad1-156b31e46ca3",
                                                "text": "Für meinen Geschmack sind schon viel zu viel PS-Boliden auf unseren Straßen unterwegs, deren Fahrer leider zu häufig mit ihrer waghalsigen, dem Verkehr völlig unangepassten Fahrweise auffallen müssen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "7ad277dd-c5a8-3dc0-942f-bff04f0ea3ff",
                                        "entry_id": "14ee745c-9187-3ee2-86a5-003979037588",
                                        "glosses": [
                                            "nicht an die Gesellschaft angepasst"
                                        ],
                                        "tags": [
                                            "von Personen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ba44f2f-0e94-4b3d-b4dc-e0e99586666a",
                                                "sense_id": "7ad277dd-c5a8-3dc0-942f-bff04f0ea3ff",
                                                "text": "Stevie Nicks ist einer der unangepasstesten und unberechenbarsten US-Superstars - doch eine Hexe, wie oft behauptet, ist sie nicht."
                                            },
                                            {
                                                "example_id": "787b3824-1a73-4500-9c8f-888866823091",
                                                "sense_id": "7ad277dd-c5a8-3dc0-942f-bff04f0ea3ff",
                                                "text": "Sind die Menschen demnach unangepasst, überfordert durch neue Techniken, den Fortschritt oder die Umwelt?"
                                            },
                                            {
                                                "example_id": "5157235a-f530-4829-9973-710e0b77524b",
                                                "sense_id": "7ad277dd-c5a8-3dc0-942f-bff04f0ea3ff",
                                                "text": "„Als Pastorensohn 1853 geboren, war Vincent ein schwieriger Mensch, leidenschaftlich, rechthaberisch, egozentrisch und unangepasst.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
