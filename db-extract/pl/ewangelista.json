                "translations": [
                    {
                        "translation_id": "1ba13848-42d9-4f97-b291-de554d553a20",
                        "source_entry_id": "0b7188c4-aed1-3237-b9d1-16d760f7420a",
                        "source_sense_id": "5efbfc88-bb87-34a8-b09b-bee6f5c905fd",
                        "target_lang_word": "evangelist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "evangelist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e749259c-c685-3b71-9f99-7c309d288ebb",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "An itinerant or special preacher, especially a revivalist, who conducts services in different cities or locations, now often televised."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a9b91046-6db1-3a47-b7e1-2186662fa33c",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "A writer of a gospel, especially the four New Testament Gospels (Matthew, Mark, Luke, and John), usually capitalized (Evangelist)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b84ab25c-9588-3f3d-acab-38aeaa88d256",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "A person who first brought the gospel to a city or region."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abd0baa6-d662-3d1c-ae92-d45aea0770b6",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "A patriarch."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bdf17cdd-5345-366e-9e24-d26be5a9bff3",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "A person marked by extreme enthusiasm for or support of any cause, particularly with regard to religion."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c6803c86-4e1b-4152-8a2d-e724c14e9986",
                                                "sense_id": "bdf17cdd-5345-366e-9e24-d26be5a9bff3",
                                                "text": "Booth, William (1829-1912) English evangelist; founder and first general of the Salvation Army ... his subordinates being expected to give him unquestioning obedience."
                                            },
                                            {
                                                "example_id": "65a8ba74-4ab6-4bda-ba46-ae62289b1259",
                                                "sense_id": "bdf17cdd-5345-366e-9e24-d26be5a9bff3",
                                                "text": "Yet in the spreading consumer market of the mid-1700s, his renditions competed with others offering a far different account of the evangelist and his message. The famous artist William Hogarth mocked Whitefield in two engravings presenting the revivalist as a religious fanatic who held sway over the superstitious lower orders."
                                            },
                                            {
                                                "example_id": "45eacb29-d9aa-416f-92d6-1ad9232d4bc9",
                                                "sense_id": "bdf17cdd-5345-366e-9e24-d26be5a9bff3",
                                                "text": "The film implies that the evangelist, as a type, is a fanatic, a sanctimonious prig, and ultimately a hypocrite."
                                            },
                                            {
                                                "example_id": "0ee3a252-7b97-4a67-9842-6ec21918035f",
                                                "sense_id": "bdf17cdd-5345-366e-9e24-d26be5a9bff3",
                                                "text": "Hendy has come out as something of an evangelist for discontinuous electrification. For Waterloo-Exeter, this could make real sense on a route where the high capital cost of wiring or third rail all the way to Devon would be prohibitive. But what about his vocal support for it on East West Rail, which is effectively a brand new line?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2c4a15b7-441c-3831-83d5-8759d30976f3",
                                        "entry_id": "ddc23371-2d54-354c-92ab-05316ff4f4fc",
                                        "glosses": [
                                            "A person hired to promote a particular technology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bed61c69-dcfd-4705-ab80-3a678df2036e",
                                                "sense_id": "2c4a15b7-441c-3831-83d5-8759d30976f3",
                                                "text": "developer evangelist"
                                            },
                                            {
                                                "example_id": "4774496f-27f0-4951-97c0-86451b0b834e",
                                                "sense_id": "2c4a15b7-441c-3831-83d5-8759d30976f3",
                                                "text": "[…] and has worked in multiple roles, including as the C# Product Manager and as a Developer Evangelist in the Mid-Atlantic district."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fb6c6527-d518-4000-a014-decf2465392e",
                        "source_entry_id": "0b7188c4-aed1-3237-b9d1-16d760f7420a",
                        "source_sense_id": "5efbfc88-bb87-34a8-b09b-bee6f5c905fd",
                        "target_lang_word": "Evangelist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Evangelist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "735cca1b-b123-30e5-ac01-c3f9489decd3",
                                        "entry_id": "0d4e788f-0567-34a1-939d-5e519bd4c813",
                                        "glosses": [
                                            "einer der vier Verfasser der neutestamentlichen Evangelien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a467eff-99eb-4a1f-8e4b-c3bef2c47e98",
                                                "sense_id": "735cca1b-b123-30e5-ac01-c3f9489decd3",
                                                "text": "„Die vier Evangelisten berichten, wie Christus unter anderem Gelähmte und Blinde durch seine Anwesenheit oder durch Berührung von ihren Leiden befreit hat.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "afc46903-95d9-3aa3-aae8-473b2b0f9818",
                                        "entry_id": "0d4e788f-0567-34a1-939d-5e519bd4c813",
                                        "glosses": [
                                            "Person, die nicht- und andersgläubige Menschen den christlichen Glauben vermittelt und sie zur Bekehrung einlädt"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "6d5c8212-2271-3d76-8ae5-33b971cf716c",
                                        "entry_id": "0d4e788f-0567-34a1-939d-5e519bd4c813",
                                        "glosses": [
                                            "Diakon, der eines der vier Evangelien verliest"
                                        ],
                                        "tags": [
                                            "Ostkirche"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "698b0acd-ea8a-4862-a6b5-edfb7a3e35e3",
                        "source_entry_id": "0b7188c4-aed1-3237-b9d1-16d760f7420a",
                        "source_sense_id": "5efbfc88-bb87-34a8-b09b-bee6f5c905fd",
                        "target_lang_word": "евангелист",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "евангелист",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "8b8998b2-0867-317c-adc9-b9d508e2d65a",
                                        "entry_id": "6d3d0740-660b-35c7-bfa9-70fc3936d206",
                                        "glosses": [
                                            "религ. один из четырёх авторов канонических Евангелий в Новом Завете"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1b746715-a0d5-49f0-8b95-d84f6a8497ca",
                                                "sense_id": "8b8998b2-0867-317c-adc9-b9d508e2d65a",
                                                "text": "И Он поставил одних Апостолами, других пророками, иных Евангелистами, иных пастырями и учителями…"
                                            },
                                            {
                                                "example_id": "ebeb44cb-8d62-47f5-95d7-f94bf9af486c",
                                                "sense_id": "8b8998b2-0867-317c-adc9-b9d508e2d65a",
                                                "text": "Кузнец был богобоязливый человек и писал часто образа святых, и теперь ещё можно найти в Т… церкве его евангелиста Луку."
                                            },
                                            {
                                                "example_id": "de8adcc5-b5f2-4de9-8eab-c41968355a03",
                                                "sense_id": "8b8998b2-0867-317c-adc9-b9d508e2d65a",
                                                "text": "На обложке она увидела надпись: «Евангелие Льва Толстого». Старушка очень огорчилась и обиделась. «Я знаю четырех евангелистов и никогда не слыхала о евангелисте Толстом»."
                                            },
                                            {
                                                "example_id": "418d7514-8dbf-4858-aa4e-e079f09409f1",
                                                "sense_id": "8b8998b2-0867-317c-adc9-b9d508e2d65a",
                                                "text": "Повествования евангелистов подтверждаются и дополняются античными и иудейскими авторами, а также открытиями современных археологов."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fee66800-0873-3fcc-9055-c5ee09ec0bef",
                                        "entry_id": "6d3d0740-660b-35c7-bfa9-70fc3936d206",
                                        "glosses": [
                                            "религ. член родственной баптизму общины евангельских христиан — одной из христианских общин, вероучение которых основывается на новозаветных евангельских текстах, и считающих, что спасение уготовано всем, кто верит в искупительную жертву Христа"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5b1e4bd-b7b0-4319-ab9b-276d21d774aa",
                                                "sense_id": "fee66800-0873-3fcc-9055-c5ee09ec0bef",
                                                "text": "Появились многочисленные секты, уклоняющиеся от церковных канонов (евангелисты, баптисты и пр.)."
                                            },
                                            {
                                                "example_id": "47b01016-a54f-4f75-aed9-f29e8b73b656",
                                                "sense_id": "fee66800-0873-3fcc-9055-c5ee09ec0bef",
                                                "text": "В стране действуют более 16 тысяч религиозных объединений, представляющих различные вероисповеднические направления. Из них, по данным на 1 января 1998 г. 8061 принадлежало Русской Православной Церкви, 2734 исламу, 145 буддизму, 87 иудаизму. Около 4 тысяч религиозных объединений принадлежат представителям других конфессий, среди которых крупнейшими представителями являются Евангелисты Христиане ― Баптисты (667), Адвентисты Седьмого Дня (306), Христиане Веры Евангелической ― пятидесятники (445), Евангелические Христиане (354), Старообрядцы (195) и т. д."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e756651-495f-369c-8090-6f7eca3071d6",
                                        "entry_id": "6d3d0740-660b-35c7-bfa9-70fc3936d206",
                                        "glosses": [
                                            "перен. писатель-проповедник какой-либо идеи"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b806cf87-6e13-41fa-94fe-a148a40dff56",
                                                "sense_id": "6e756651-495f-369c-8090-6f7eca3071d6",
                                                "text": "Без сомнения, преступная идея важна. Она всегда выживала и выживет. У неё есть свои апостолы, мученики и евангелисты."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "17b129c8-dea6-314c-8b8c-f392c255ff2a",
                                        "entry_id": "6d3d0740-660b-35c7-bfa9-70fc3936d206",
                                        "glosses": [
                                            "перен. торг. должность в компании, заключающаяся в создании идеологии компании, популяризации главных её технологий, коммуникации и внешних связях"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0e995b1c-929d-47df-974c-c1b6a5a410f7",
                                                "sense_id": "17b129c8-dea6-314c-8b8c-f392c255ff2a",
                                                "text": "Сейчас Винт Серф работает в корпорации Google, и является, как это принято говорить, евангелистом «поисковика»."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
