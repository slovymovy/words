                        "glosses": [
                            "Qui contient ou concerne des graptolites."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3361be4d-74af-48aa-b403-52deefe88071",
                                "sense_id": "6ef6b84f-24d5-3015-a41c-06b85ffa5867",
                                "text": "La formation d’Utica, qui se compose en grande partie de pyroschistes (schistes bitumineux) graptolitiques, est suivie par les grès et schistes, souvent plus ou moins calcaires, qui constituent la formation de Hudson-River ou de Loraine."
                            },
                            {
                                "example_id": "48e06fb4-3f3f-47e5-8644-484a53e28927",
                                "sense_id": "6ef6b84f-24d5-3015-a41c-06b85ffa5867",
                                "text": "Les Schistes de Kerloc’h se retrouvent au Sud de Rennes à Sion, à Erbray à Bourg-des-Comptes, à Saint-Senoux, etc. avec une faune graptolitique où M. Barrois a reconnu les espèces suivantes : …."
                            },
                            {
                                "example_id": "315acb43-264c-40ac-bb79-f3e75740663c",
                                "sense_id": "6ef6b84f-24d5-3015-a41c-06b85ffa5867",
                                "text": "Les colonies graptolitiques étaient planctoniques pour la plupart et la réunion de leurs rhabdosomes sur des plaques fossilifères est uniquement due aux hasards d’une sédimentation souvent capricieuse qui a rassemblé leurs cadavres au fond de la mer."
                            }
                        ]
                    }
