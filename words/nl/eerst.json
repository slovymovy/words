                                "de": "Wir setzen uns <w>zuerst</w> einmal ganz ruhig hin.",
                                "fr": "Nous allons <w>tout d'abord</w> nous asseoir tranquillement.",
                                "it": "Andiamo <w>innanzitutto</w> a sederci un attimo con calma.",
                                "cs": "<w>Především</w> se v klidu posadíme.",
                                "tr": "<w>Her şeyden önce</w> şöyle bir sakinleşip oturalım.",
                                "es": "<w>Antes que nada</w>, vamos a sentarnos tranquilamente."
                            }
