        "ru-extract.jsonl": [
            {
                "entry_id": "aec33f03-214a-3ca1-800b-ab009d52ac08",
                "word": "где-либо",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "9cfae45e-cfa5-3cbf-a346-873425223f84",
                        "entry_id": "aec33f03-214a-3ca1-800b-ab009d52ac08",
                        "glosses": [
                            "в каком-либо месте; в некоей неуказанной точке пространства"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef34e397-4ac0-4c2d-ad8d-e755fb19ea7a",
                                "sense_id": "9cfae45e-cfa5-3cbf-a346-873425223f84",
                                "text": "Тут же был и поток немцев — немцев Поволжья, колонистов с Украины и Северного Кавказа, и всех вообще немцев, где-либо в Советском Союзе живших."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd011825-6c71-4aaa-8ba3-e1690e63ad0d",
                        "source_entry_id": "aec33f03-214a-3ca1-800b-ab009d52ac08",
                        "source_sense_id": "9cfae45e-cfa5-3cbf-a346-873425223f84",
                        "target_lang_word": "somewhere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "In an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c09c7815-a34f-4211-b258-707700464130",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I must have left my glasses somewhere."
                                            },
                                            {
                                                "example_id": "4f5493c3-bf64-4497-b89f-7bbf2a8f37ee",
                                                "sense_id": "b95e87a1-f78d-3e66-8c37-50d9e5330bb2",
                                                "text": "I've hidden candy somewhere in this room."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "To an uncertain or unspecified location."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "88cf080b-c0c0-401c-93d3-4df937ba2e0d",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "He plans to go somewhere warm for his vacation."
                                            },
                                            {
                                                "example_id": "31f42e79-251c-428c-ab3b-eb0693a71cc6",
                                                "sense_id": "0f7c7978-a05a-314f-b7d6-eed41f6a431f",
                                                "text": "I have to go somewhere at lunch. Can I meet you at 2?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                        "entry_id": "86e5b850-9929-3dbd-9155-66a2df04b22c",
                                        "glosses": [
                                            "At some unspecified point."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "593452c6-5a6e-4786-a00f-83b7861a20c7",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "I don't remember the exact number, but it was somewhere between 200 and 300."
                                            },
                                            {
                                                "example_id": "7c8f23ac-1c44-4d6a-97db-1a62754046ba",
                                                "sense_id": "23f969d1-68af-324b-87ce-f237d38dbcf3",
                                                "text": "When a train has to ascend the incline, it first runs down, engine first, from the station about 60 or 70 yards. Then comes behind it the aforesaid truck, or one similar, which, being attached to an endless wire rope, a communication is made by means of the electric telegraph to the engineman at the top of the incline, when the fixed engine begins to work, and the train, partly pulled by the locomotive before, and partly pushed by the truck behind, rapidly ascends, taking somewhere about three minutes to get up."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "somewhere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "Unspecified or unknown (unlocated) place or location."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e82ba24-e5ba-4e1a-b2cc-78f77929a771",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "We have come from somewhere and we are going somewhere, but because life is an unending circle, we are again going to come from a somewhere, and we are again going to go to a somewhere, and this will go on, and on, and on."
                                            },
                                            {
                                                "example_id": "3437451b-da52-4422-b228-e788278abca0",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "A courting owl hoots in the somewheres of the night and another answers its call further off."
                                            },
                                            {
                                                "example_id": "3ad56f2d-0c4b-4d9a-a750-72a2ff4f611c",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "[…] and it transports the person to a somewhere, a somewhere that the music dictates."
                                            },
                                            {
                                                "example_id": "f48f350b-69e1-4ffa-b958-6f10fc80c7a2",
                                                "sense_id": "894a65a8-5b8d-3597-9cb4-c1e8a34a1ef6",
                                                "text": "This is essentialised place: a somewhere that is nowhere and yet everywhere."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c0f6ada2-758d-3b40-9f56-55cdd009b0a0",
                                        "entry_id": "b218b425-90eb-3f21-be78-81d033f5e6f5",
                                        "glosses": [
                                            "A person with strong cultural or social ties to a specific place."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "53e0a69e-08de-48fb-aefa-569d3f75cbb8",
                        "source_entry_id": "aec33f03-214a-3ca1-800b-ab009d52ac08",
                        "source_sense_id": "9cfae45e-cfa5-3cbf-a346-873425223f84",
                        "target_lang_word": "irgendwo",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "irgendwo",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "600f9d38-b5fc-36e9-8bca-0097d57aa80c",
                                        "entry_id": "4acf8cc8-d4c3-30b1-9a33-1d302780d03b",
                                        "glosses": [
                                            "an einem unbestimmten oder und unbestimmbaren Ort"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d70ba5a8-b764-4eec-97d9-9f1d2d7a718b",
                                                "sense_id": "600f9d38-b5fc-36e9-8bca-0097d57aa80c",
                                                "text": "Irgendwo werden wir uns treffen."
                                            },
                                            {
                                                "example_id": "a35a8705-446d-40a5-a8ce-f9c8cf22b415",
                                                "sense_id": "600f9d38-b5fc-36e9-8bca-0097d57aa80c",
                                                "text": "Ich habe doch hier irgendwo meinen Schlüssel hingelegt."
                                            },
                                            {
                                                "example_id": "2f31357a-5a0f-429e-9d24-e4a0cfe05c4c",
                                                "sense_id": "600f9d38-b5fc-36e9-8bca-0097d57aa80c",
                                                "text": "„Irgendwo wurde Grammophon gespielt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bf58cf45-30bd-424c-ae87-513b17f1eb49",
                        "source_entry_id": "aec33f03-214a-3ca1-800b-ab009d52ac08",
                        "source_sense_id": "9cfae45e-cfa5-3cbf-a346-873425223f84",
                        "target_lang_word": "ergens",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ergens",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3e3b831f-38d7-3342-8a6a-8b2179aa185b",
                                        "entry_id": "cc575b57-d276-3453-a874-ec6d688dbd8c",
                                        "glosses": [
                                            "in/op een (onbepaalde) plaats"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "057d84c5-6221-46f4-865d-6deda1e2e855",
                                                "sense_id": "3e3b831f-38d7-3342-8a6a-8b2179aa185b",
                                                "text": "Hij woont ergens in Hilversum."
                                            },
                                            {
                                                "example_id": "fc9421bc-e432-4237-b620-180c537200d5",
                                                "sense_id": "3e3b831f-38d7-3342-8a6a-8b2179aa185b",
                                                "text": "Met mijn 43 jaar was ik duidelijk de oudste van het stel, de rest leek ergens tussen de twintig en vijfentwintig."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acfed0bb-0eb5-377a-a308-d4c74d6c69a2",
                                        "entry_id": "cc575b57-d276-3453-a874-ec6d688dbd8c",
                                        "glosses": [
                                            "op een bepaalde manier"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "68f9c264-47a4-43f6-8d5f-0071572a311a",
                                                "sense_id": "acfed0bb-0eb5-377a-a308-d4c74d6c69a2",
                                                "text": "Ergens vind ik hem ook wel grappig."
                                            },
                                            {
                                                "example_id": "11d0f441-a7d8-4224-aac3-7b5b94a1a0b2",
                                                "sense_id": "acfed0bb-0eb5-377a-a308-d4c74d6c69a2",
                                                "text": "Maar er moest ergens iets fout zijn gegaan, aangezien de hele gietvorm van de brugoverspanning in de slotfase was ingestort. Dat was het enige wat met zekerheid kon worden gezegd."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3a41988-a88b-371e-8e11-7b16e9b30a4d",
                                        "entry_id": "cc575b57-d276-3453-a874-ec6d688dbd8c",
                                        "glosses": [
                                            "als locatief deel van een samengesteld voornaamwoordelijk bijwoord vervangt het een onbepaald voornaamwoord iets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9fb7d590-4846-4019-8dc2-772591364f06",
                                                "sense_id": "f3a41988-a88b-371e-8e11-7b16e9b30a4d",
                                                "text": "Hij schreef met iets => hij schreef ergens mee."
                                            },
                                            {
                                                "example_id": "2e8d5d5c-737e-4f9f-9363-91b48135b990",
                                                "sense_id": "f3a41988-a88b-371e-8e11-7b16e9b30a4d",
                                                "text": "kan ik u met iets helpen => Kan ik u ergens mee helpen."
                                            },
                                            {
                                                "example_id": "cce906c4-055d-4f62-946f-f82cf658cdfb",
                                                "sense_id": "f3a41988-a88b-371e-8e11-7b16e9b30a4d",
                                                "text": "In het verleden was de Amerikaanse STAR-detector altijd sneller in het vinden van recordbrekende antimateriedeeltjes. ‘Elke keer als ze [het LHC-team] ergens naar op zoek gingen, waren de onderzoekers van STAR ze voor’, zegt natuurkundige Horst Stöcker van het Frankfurt Institute for Advanced Studies in Duitsland. ‘Dit is de eerste keer dat het STAR-team iets nog niet heeft gezien, maar LHC-onderzoekers wel.’"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
