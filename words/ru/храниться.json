            "pos": "verb",
            "senses": [
                {
                    "sense_id": "81a8c60c-d883-3263-bc2d-ab021b9729a6",
                    "sense_definition": "находиться на хранении, сберегаться в определённых условиях или месте",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "нахождение_на_хранении",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Молочные продукты должны <w>храниться</w> в холодильнике при низкой температуре.",
                            "target_lang_translations": {
                                "en": "Dairy products must <w>be kept</w> in the refrigerator at a low temperature."
                            }
                        },
                        {
                            "text": "Все важные бумаги <w>хранятся</w> в металлическом сейфе в кабинете директора.",
                            "target_lang_translations": {
                                "en": "All important papers <w>are kept</w> in a metal safe in the director's office."
                            }
                        }
                    ],
                    "synonyms": [
                        "содержаться",
                        "сберегаться"
                    ],
                    "antonyms": [
                        "портиться"
                    ],
                    "common_phrases": [
                        "храниться в холодильнике",
                        "храниться в сухом месте"
                    ],
                    "target_lang_definitions": {
                        "en": "to be kept in storage, preserved, or maintained in particular conditions"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be stored",
                                "target_lang_sense_clarification": "goods, provisions, or data"
                            },
                            {
                                "target_lang_word": "be kept",
                                "target_lang_sense_clarification": "in specific conditions or place"
                            },
                            {
                                "target_lang_word": "keep",
                                "target_lang_sense_clarification": "stay fresh or unspoiled"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "542531a2-8c87-3ced-aa36-34fe3746ac06",
                    "sense_definition": "иметь своё постоянное место, лежать или находиться где-либо",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "нахождение_на_хранении",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Старые детские игрушки и книги <w>хранятся</w> в коробках на чердаке.",
                            "target_lang_translations": {
                                "en": "Old childhood toys and books <w>are stored</w> in boxes in the attic."
                            }
                        },
                        {
                            "text": "Семейные фотоальбомы всегда <w>хранились</w> на нижней полке книжного шкафа.",
                            "target_lang_translations": {
                                "en": "Family photo albums <w>were</w> always <w>kept</w> on the bottom shelf of the bookcase."
                            }
                        }
                    ],
                    "synonyms": [
                        "находиться",
                        "лежать"
                    ],
                    "common_phrases": [
                        "храниться в шкафу",
                        "храниться дома"
                    ],
                    "target_lang_definitions": {
                        "en": "to have a permanent home or place; to sit, lie, or be put away somewhere"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be kept",
                                "target_lang_sense_clarification": "belonging in a certain place"
                            },
                            {
                                "target_lang_word": "be stored",
                                "target_lang_sense_clarification": "put away in a closet, box, or attic"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a2a765c0-14cf-3a4b-9f7c-b6678ade6338",
                    "sense_definition": "переносно: оставаться в памяти, сберегаться в сознании или сердце",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Тёплые воспоминания о поездке к морю долго <w>хранились</w> в её памяти.",
                            "target_lang_translations": {
                                "en": "Warm memories of the trip to the sea <w>were preserved</w> in her memory for a long time."
                            }
                        },
                        {
                            "text": "Образ родного дома навсегда <w>хранится</w> в сердцах уехавших людей.",
                            "target_lang_translations": {
                                "en": "The image of home <w>is</w> forever <w>kept</w> in the hearts of those who left."
                            }
                        }
                    ],
                    "synonyms": [
                        "помниться",
                        "оставаться"
                    ],
                    "antonyms": [
                        "забываться"
                    ],
                    "common_phrases": [
                        "храниться в памяти",
                        "храниться в сердце"
                    ],
                    "target_lang_definitions": {
                        "en": "figuratively: to be preserved or linger in memory, mind, or heart"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be preserved",
                                "target_lang_sense_clarification": "in one's memory"
                            },
                            {
                                "target_lang_word": "be kept",
                                "target_lang_sense_clarification": "cherished in mind or heart"
                            },
                            {
                                "target_lang_word": "linger",
                                "target_lang_sense_clarification": "remain in memory"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07d4abd1-4dfb-3712-b867-34ca90998564",
                    "sense_definition": "страдательный залог к <w>хранить</w>",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Редкие рукописи бережно <w>хранятся</w> сотрудниками библиотеки в особых залах.",
                            "target_lang_translations": {
                                "en": "Rare manuscripts <w>are</w> carefully <w>preserved</w> by library staff in special rooms."
                            }
                        },
                        {
                            "text": "Эта тайна строго <w>хранилась</w> членами семьи на протяжении многих десятилетий.",
                            "target_lang_translations": {
                                "en": "This secret <w>was</w> strictly <w>kept</w> by family members for many decades."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "passive voice of 'to keep' or 'to preserve'"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "be kept",
                                "target_lang_sense_clarification": "by someone (secrets, items)"
                            },
                            {
                                "target_lang_word": "be preserved",
                                "target_lang_sense_clarification": "carefully safeguarded by curators or caretakers"
                            }
                        ]
                    }
                }
            ]
