                    {
                        "sense_id": "a159b87c-bac0-3c97-9dcd-f816c64f0bfd",
                        "entry_id": "63e645aa-b6aa-3144-a835-6123dbb747b8",
                        "glosses": [
                            "een drank die vervaardigd is van echte of kunstmatige vruchtensappen, suiker en water"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f6df0c6-b8a2-4612-b5c9-3fdabc87c22a",
                                "sense_id": "a159b87c-bac0-3c97-9dcd-f816c64f0bfd",
                                "text": "Ik vind limonade met frambozensmaak erg lekker."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fe5285f1-2b5e-4665-ba05-cd0c1657e969",
                        "source_entry_id": "63e645aa-b6aa-3144-a835-6123dbb747b8",
                        "source_sense_id": "3d9ce390-e14f-3992-9490-fc8a0fbfa46c",
                        "source_sense_description": "een drank die vervaardigd is van citroensap, suiker en water",
                        "target_lang_word": "Limonade",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Limonade",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                        "entry_id": "9e402208-e9c8-375f-bb8d-542f05b57c1a",
                                        "glosses": [
                                            "frucht- und zuckerhaltiges Erfrischungsgetränk, oft mit Kohlensäure, nie mit Alkohol"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aead030a-df80-4a66-b911-6ba7ac93996c",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "Möchtest du Saft oder Limonade?"
                                            },
                                            {
                                                "example_id": "d6924c16-4ea2-4df8-ac6c-c86fb277f878",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "Auf der Grillparty gab es nur Alkoholfreies, darunter Limonade und Mineralwasser."
                                            },
                                            {
                                                "example_id": "5c13baf4-ca86-4ba3-b05a-581713066d5b",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "Limonade sollte man in Maßen genießen, da sie viel Zucker enthalten kann."
                                            },
                                            {
                                                "example_id": "163c5e21-80c0-4fd2-865a-99098af28ffa",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "„Ein paar Mädels saßen da bei Limonade oder Bier oder was auch immer, junge Männner gingen durch, an den Tischen vorbei und wieder hinaus oder setzten sich dazu.“"
                                            },
                                            {
                                                "example_id": "17a027ad-c54b-4705-9561-72fa46924ab7",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "„Die Gruppe der Schulkinder geht schnell weiter und setzt sich auf die Wiese, packt die Brotzeit aus und Limonade.“"
                                            },
                                            {
                                                "example_id": "1896f29b-db05-4558-9da4-a628b8cd61f7",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "„Er liess sich den Brief aus der Tasche geben und das Tischchen mit der Limonade und der seilförmig gedrehten Wachskerze ans Bett rücken, setzte die Brille auf und begann zu lesen.“"
                                            },
                                            {
                                                "example_id": "748a9900-25ef-4a34-b0df-7eb8711380c4",
                                                "sense_id": "4fdf8601-52b6-37c3-ac2e-94a49eb13ded",
                                                "text": "„Ich erklärte, ich würde gern ein Glas Limonade trinken, und er führte mich zum Gartenhäuschen, wo ich die alte Sklavin entdeckte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "12f0721d-a85e-4c82-9ff3-2c292937e941",
                        "source_entry_id": "63e645aa-b6aa-3144-a835-6123dbb747b8",
                        "source_sense_id": "3d9ce390-e14f-3992-9490-fc8a0fbfa46c",
                        "source_sense_description": "een drank die vervaardigd is van citroensap, suiker en water",
                        "target_lang_word": "lemonade",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lemonade",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "A flavoured beverage consisting of water, lemon, and sweetener, sometimes ice, served mainly as a refreshment."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "India",
                                            "Philippines",
                                            "US",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "545cba71-1fa6-48be-8013-a63cdaeef6a0",
                                                "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                                "text": "Mrs. Murphy, who had […] stopped for a few minutes, at Mrs. Loring's invitation, to rest and enjoy the cool glass of lemonade that was very refreshing after her long walk."
                                            },
                                            {
                                                "example_id": "9cd54c40-c7ad-40bf-b1c4-3808d00e1727",
                                                "sense_id": "29817c9e-9448-3113-b47d-dbb2759f2396",
                                                "text": "The tiny flowers on the long skirt and sleeveless halter-top made her look like she belonged in some Southern porch handing out lemonade and sweet tea."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3ba90c75-3763-3e45-98cf-ab82ce80e581",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "A clear, usually carbonated, beverage made from lemon or artificial lemon flavouring, water, and sugar."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "New-Zealand",
                                            "UK",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                        "entry_id": "dfc382a5-cd91-30c1-b94e-0684cd6cdcef",
                                        "glosses": [
                                            "Recreational drugs of poor or weak quality, especially heroin."
                                        ],
                                        "tags": [
                                            "countable",
                                            "derogatory",
                                            "slang",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "97ccae8b-111e-4fff-92a5-52ee5fd80965",
                                                "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                                "text": "In fact, a recent report from Denver shows it [street heroin] was about 1 to 2 percent and the addicts that are receiving this in many cases refer to it as lemonade, because it is so weak."
                                            },
                                            {
                                                "example_id": "f04893d3-5cd3-477d-8af9-d1db97c7119e",
                                                "sense_id": "07c5f226-c785-35f1-93a5-c9eada609298",
                                                "text": "Lemonade — heroin; poor quality drugs"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
