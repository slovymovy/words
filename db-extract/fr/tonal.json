                "senses": [
                    {
                        "sense_id": "0a8cb080-259c-3e9c-a543-7a4f5cf7b454",
                        "entry_id": "b4fc9ce4-e592-34f8-a0a7-24941422baef",
                        "glosses": [
                            "Qui se rapporte au ton, à la hauteur du son. Qui possède des tons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "145bf56f-21e4-4536-a032-7dd117861afa",
                                "sense_id": "0a8cb080-259c-3e9c-a543-7a4f5cf7b454",
                                "text": "Le chinois est une langue tonale."
                            },
                            {
                                "example_id": "63f8ac50-44f4-4592-925c-2acef5d35afb",
                                "sense_id": "0a8cb080-259c-3e9c-a543-7a4f5cf7b454",
                                "text": "Le sandhi tonal du minnan est plus complexe que celui du mandarin."
                            },
                            {
                                "example_id": "33830644-f7de-4f9d-9a40-d9903aabe9ad",
                                "sense_id": "0a8cb080-259c-3e9c-a543-7a4f5cf7b454",
                                "text": "Les langues bantoues de la zone B peuvent avoir des cas tonals."
                            }
                        ]
                    },
                    {
                        "sense_id": "51a15bf2-f288-3723-8c47-2eaabf161950",
                        "entry_id": "b4fc9ce4-e592-34f8-a0a7-24941422baef",
                        "glosses": [
                            "Qui se rapporte à la tonalité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "33fad6ab-af40-47df-bd18-889bd2200ff0",
                                "sense_id": "51a15bf2-f288-3723-8c47-2eaabf161950",
                                "text": "Structure tonale."
                            },
                            {
                                "example_id": "f64ed410-2c36-4466-b7ad-f22051a9fc86",
                                "sense_id": "51a15bf2-f288-3723-8c47-2eaabf161950",
                                "text": "Notes tonales. (la tonique, la sous-dominante et la dominante)"
                            }
                        ]
                    },
                    {
                        "sense_id": "92c8acaa-6235-39b7-97d3-67c837ac68c2",
                        "entry_id": "b4fc9ce4-e592-34f8-a0a7-24941422baef",
                        "glosses": [
                            "Qui fonctionne selon un système de ton."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bfd378d5-7afd-473f-9f91-3c7fd7945aac",
                                "sense_id": "92c8acaa-6235-39b7-97d3-67c837ac68c2",
                                "text": "Personnellement, je préconise un usage modéré et limité de la suppression et du transfert d'octave en musique tonale et atonale. Il semble que la fusion, par contre, soit beaucoup plus nécessaire en musique atonale qu'en musique tonale, car, […], celle-ci ne possède pas les contraintes harmoniques et linéaires de la musique tonale."
                            }
                        ]
                    }
