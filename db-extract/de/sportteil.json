                "senses": [
                    {
                        "sense_id": "32633c34-6d7f-3e56-8152-0ae83919e2a4",
                        "entry_id": "d18fafe0-d2ee-36e2-8ce7-491a78e4a5ca",
                        "glosses": [
                            "Zeitungsabschnitt, der sich mit Sport beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f51c198-9f2b-4fcb-aebb-987503e36a9e",
                                "sense_id": "32633c34-6d7f-3e56-8152-0ae83919e2a4",
                                "text": "„Ich weiß nicht, warum jede Zeitung einen Sportteil haben muss.“"
                            },
                            {
                                "example_id": "9a786318-ebf5-4104-acae-2e039b4ccf53",
                                "sense_id": "32633c34-6d7f-3e56-8152-0ae83919e2a4",
                                "text": "„Täglich las er akribisch alle drei großen Tageszeitungen und zog sich zusätzlich jede Menge Wochenzeitschriften rein, die in New York daherkamen wie gehaltvolle Nachspeisen. Heute interessierte ihn vor allem der Sportteil, da er fest an einen Sieg der Yankees glaubte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
