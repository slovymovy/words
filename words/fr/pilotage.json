                    "frequency": "Middle",
                    "semantic_group_id": "gestion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La directrice a réuni le comité de <w>pilotage</w> pour valider les étapes du projet."
                        },
                        {
                            "text": "Un bon outil de <w>pilotage</w> permet d'ajuster les ressources selon les résultats obtenus."
                        }
                    ],
                    "synonyms": [
                        "coordination",
                        "direction",
                        "gestion",
                        "management"
                    ],
                    "common_phrases": [
