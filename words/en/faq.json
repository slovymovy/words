    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d86b1cb-053d-36b2-a793-181202d1e974",
                    "sense_definition": "A document or webpage containing a list of frequently asked questions and their corresponding answers.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "information_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Before you contact customer service, please check the <w>FAQ</w> section on our website.",
                            "target_lang_translations": {
                                "zh": "在联系客服之前，请查看我们网站上的<w>常见问题</w>专区。"
                            }
                        },
                        {
                            "text": "This site's <w>FAQ</w> says you should log in to access your personal dashboard.",
                            "target_lang_translations": {
                                "zh": "该网站的<w>常见问题解答</w>显示，您需要登录才能访问个人控制面板。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "FAQ section",
                        "FAQ page"
                    ],
                    "target_lang_definitions": {
                        "zh": "常见问题解答；包含常见问题及其对应答案的文档或网页。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "常见问题",
                                "target_lang_sense_clarification": "网站或文档中的问答板块"
                            },
                            {
                                "target_lang_word": "常见问题解答",
                                "target_lang_sense_clarification": "问答列表全称"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d03f2608-5b56-3d4c-80e9-ea20803310b5",
                    "sense_definition": "A comprehensive guide or walkthrough detailing strategies and instructions for completing a video game.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "information_guide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I was stuck on the final boss until I read an online <w>FAQ</w>.",
                            "target_lang_translations": {
                                "zh": "我一直卡在最终首领那里，直到我读了一篇网上<w>攻略</w>。"
                            }
                        },
                        {
                            "text": "He wrote a detailed <w>FAQ</w> explaining all the secret collectibles in the game.",
                            "target_lang_translations": {
                                "zh": "他写了一份详细的<w>游戏攻略</w>，解释了游戏中所有的隐藏收集品。"
                            }
                        }
                    ],
                    "synonyms": [
                        "walkthrough"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "gaming"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "（电子游戏的）攻略或玩法指南。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "游戏攻略",
                                "target_lang_sense_clarification": "指导通关或解谜的文档"
                            },
                            {
                                "target_lang_word": "攻略",
                                "target_lang_sense_clarification": "游戏通关指导"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "862b54ad-22cf-30a0-9094-0d7c345064cf",
                    "sense_definition": "An offensive exclamation used to express intense anger or contempt; shorthand for fuck you.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He got angry during the online argument and typed <w>faq</w> before logging off.",
                            "target_lang_translations": {
                                "zh": "在网络争吵中他十分生气，下线前打了一句“<w>去你的</w>”。"
                            }
                        },
                        {
                            "text": "The rude player shouted <w>faq</w> when he lost the match.",
                            "target_lang_translations": {
                                "zh": "那个粗鲁的玩家输掉比赛时大喊了一句“<w>操</w>”。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "vulgar"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "粗俗感叹词，用于表达极度愤怒或蔑视；fuck you 的网络谐音缩写。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "去你的",
                                "target_lang_sense_clarification": "粗俗的咒骂语"
                            },
                            {
                                "target_lang_word": "操",
                                "target_lang_sense_clarification": "粗鲁的感叹词"
                            }
                        ]
                    }
                }
            ]
        }
    ]
