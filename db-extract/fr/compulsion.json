                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9fb4bdd7-6448-4149-b1f7-3007878fad1f",
                        "source_entry_id": "130d784b-aa7f-3919-9a3a-f08a7364584f",
                        "target_lang_word": "compulsion",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "compulsion",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                                        "glosses": [
                                            "An irrational need or irresistible urge to perform some action, often despite negative consequences."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "437a93a3-f38e-4c59-868f-88055ebb8688",
                                                "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                                                "text": "During the basketball game, I had a sudden compulsion to have a smoke."
                                            },
                                            {
                                                "example_id": "06e8db7b-83ca-4e0e-aa28-12738001d522",
                                                "sense_id": "b6d4d5fa-e7b2-3e50-bd10-4757b6e85c8b",
                                                "text": "It is tempting to speculate about the incentives or compulsions that might explain why anyone would take to the skies in [the] basket [of a balloon]: perhaps out of a desire to escape the gravity of this world or to get a preview of the next; […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                                        "glosses": [
                                            "The use of authority, influence, or other power to force (compel) a person or persons to act."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab37bcfc-165e-4395-aff2-36368b5a55e3",
                                                "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                                                "text": "From the opening of the City & South London Railway independent electric locomotives were used under compulsion of the Board of Trade."
                                            },
                                            {
                                                "example_id": "d07de75a-1abf-4b62-a8a4-207a24e85167",
                                                "sense_id": "7fe95c50-018c-346a-a96f-42e25a5b1681",
                                                "text": "But Treaty translator and Ottawa leader Andrew Blackbird described the Treaty as made “not with the free will of the Indians, but by compulsion.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f70b60cc-d825-3d9f-abf8-fd885aadaf89",
                                        "entry_id": "84f7647a-2bfb-30f8-aecd-5225846a1ab6",
                                        "glosses": [
                                            "The lawful use of violence (i.e. by the administration)."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
