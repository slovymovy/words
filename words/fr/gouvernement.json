                },
                {
                    "sense_id": "1b53f406-8b2c-3fe3-b558-2b481bdb43cc",
                    "sense_definition": "Action, charge ou manière d'administrer, de régir ou de diriger une entité, des biens ou des personnes.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "direction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le <w>gouvernement</w> des affaires publiques exige une rigueur constante et un sens élevé du devoir civique."
                        },
                        {
                            "text": "Elle assurait avec fermeté et sagesse le <w>gouvernement</w> de la maison et de ses finances."
