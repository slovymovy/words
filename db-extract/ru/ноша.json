                                        "glosses": [
                                            "To encumber with a literal or figurative burden."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6432de9a-b5cd-444a-b172-469ce22df7bc",
                                                "sense_id": "afe44992-9362-3e95-ab74-d64d448c5e24",
                                                "text": "to burden a nation with taxes"
                                            },
                                            {
                                                "example_id": "fadcfc10-ee49-4d11-abef-4d195817cc65",
                                                "sense_id": "afe44992-9362-3e95-ab74-d64d448c5e24",
                                                "text": "My burdened heart would break."
                                            },
                                            {
                                                "example_id": "8f4564c0-08b4-453f-862a-01033535a4e0",
                                                "sense_id": "afe44992-9362-3e95-ab74-d64d448c5e24",
                                                "text": "This ſtraunge vnwelcome and vnhappie newes, […]\nBurdens my heart, and interrupts my ſleepe, […]"
                                            },
                                            {
                                                "example_id": "0e0417eb-3415-4b23-b32c-44e9925f80b0",
                                                "sense_id": "afe44992-9362-3e95-ab74-d64d448c5e24",
                                                "text": "For I meane not that other men bee eaſed, and you burthened: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94af298-1421-330e-b5b1-b6ab339ce776",
                                        "entry_id": "5db64e9b-24b8-38df-b661-3aaf7ef91f5c",
                                        "glosses": [
                                            "To impose, as a load or burden; to lay or place as a burden (something heavy or objectionable)."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "burden",
