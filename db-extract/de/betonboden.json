                "senses": [
                    {
                        "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                        "entry_id": "f313252b-21e4-3225-b3cb-66e79cc21e64",
                        "glosses": [
                            "Boden, der aus Beton (einem Werkstoff aus Zement, Wasser und feinem Kies) gegossen wurde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f791b066-b196-49cb-8336-db03d3052457",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Der Ehemann der Getöteten, Harald Meier, beauftragte einen Maurer, den Betonboden aufzustemmen.“"
                            },
                            {
                                "example_id": "312486d1-473b-486e-8d50-1af005e527a2",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Nachdem das Internet seit Mittwoch wieder verfügbar ist, kann nun jeder in Belarus online die Bilder von Folter und Gewalt sehen. Menschen liegen dicht an dicht auf dem Betonboden im Hof eines Gefängnisses in Minsk.“"
                            },
                            {
                                "example_id": "a3db9eb1-56da-429b-bc72-7bbeb0ee2085",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„»Seitdem ich im Straflager war, komme ich manchmal nicht vom Bett hoch. Das liegt daran, dass ich dort so lange auf kaltem Betonboden schlafen musste. Meine Glieder und Gelenke schmerzen vom Rheuma.«“"
                            },
                            {
                                "example_id": "3e239acb-35ad-4626-b67e-ef088c502013",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Auf Polizeifotos ist zu sehen, dass sich um den Kopf des Jugendlichen eine große Blutlache auf dem Betonboden der Zelle gebildet hatte.“"
                            },
                            {
                                "example_id": "4e84a7b1-83d8-4963-b154-6d33058b2140",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Das erste, was ich dann sehe, wenn ich das Pressezentrum betrete, ist der putzige Roboter, der den grau lackierten Betonboden dieses riesigen Gebäudes putzt.“"
                            },
                            {
                                "example_id": "7b67a94a-2e8b-4697-8c63-ce81845c63a3",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Auf dem Betonboden stehen ein Ledersofa und Kisten voll mit „Mauerresten“,“ […]."
                            },
                            {
                                "example_id": "888dcd5c-c164-4a50-8feb-dfcb3668ef17",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„A und O sind Rivalen. Beide geraten in Streit. Schließlich versetzt der A dem O ohne Tötungsvorsatz einen kräftigen Faustschlag. O fällt auf den Betonboden, wodurch er eine tödliche Gehirnblutung erleidet.“"
                            },
                            {
                                "example_id": "f6d81888-2fe1-4a13-b219-241865721a78",
                                "sense_id": "5c1ca34e-b9bf-3a8b-bf05-3e416b35510b",
                                "text": "„Im Schneidersitz saß Warlam Babinitsch in einer Ecke des überfüllten Schlafsaals auf dem dreckigen Betonboden und verbarg mit seinem Körper die Gegenstände, die er vor sch ausgebreitet hatte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
