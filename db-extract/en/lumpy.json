                        "source_entry_id": "2dda57af-a2dc-3a35-9d9f-4191b5d54879",
                        "source_sense_description": "full of lumps",
                        "target_lang_word": "grumeleux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grumeleux",
