                                "sense_id": "1ed4461b-322a-337b-828a-c43d017f537b",
                                "text": "Remoisten and reblot two or three times until what you're blotting up is colorless or the faint color of Red or Blue juice, but definitely not the color of wine."
                            },
                            {
                                "example_id": "9ef5b7e7-30c8-4e93-a5cf-664c8fdb2338",
                                "sense_id": "1ed4461b-322a-337b-828a-c43d017f537b",
                                "text": "Stipple several times on your surface until the swab is too dry, then reload and reblot."
                            },
                            {
                                "example_id": "2ce2f176-2d97-48ce-95fb-18311572ce93",
                                "sense_id": "1ed4461b-322a-337b-828a-c43d017f537b",
                                "text": "Reblot the gel and remove the template."
