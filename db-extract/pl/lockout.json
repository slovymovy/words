                                        "examples": []
                                    },
                                    {
                                        "sense_id": "aa94ec26-975a-3a97-8fb6-1c4c08a13686",
                                        "entry_id": "b7495d73-8709-3199-90f9-cd9b62c965e9",
                                        "glosses": [
                                            "The exclusion of certain people from a place, event, situation, etc."
