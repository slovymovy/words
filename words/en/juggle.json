{
    "word_family": [
        "juggler",
        "juggling"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4dac682d-10ab-301a-b6fe-e17973b9d576",
                    "sense_definition": "To handle or manage many different tasks, responsibilities, or activities at the same time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "multitasking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It is often difficult to <w>juggle</w> work and family life during the busy holiday season.",
                            "target_lang_translations": {
                                "ru": "В разгар праздничного сезона часто бывает трудно <w>совмещать</w> работу и семейную жизнь.",
                                "zh": "在繁忙的假期里，想要<w>兼顾</w>工作和家庭生活往往很困难。"
                            }
                        },
                        {
                            "text": "He <w>juggled</w> home school and work for two years while finishing his degree.",
                            "target_lang_translations": {
                                "ru": "Он два года <w>балансировал</w> между домашним обучением и работой, пока получал диплом.",
                                "zh": "他在攻读学位期间，花了两年时间在家庭教育和工作之间进行<w>平衡</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "multitask",
                        "balance"
                    ],
                    "common_phrases": [
                        "juggle work and family",
                        "juggle multiple tasks"
                    ],
                    "target_lang_definitions": {
                        "ru": "Одновременно справляться с несколькими задачами, обязанностями или видами деятельности.",
                        "zh": "同时处理或管理多项不同的任务、责任或活动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жонглировать",
                                "target_lang_sense_clarification": "переносно о делах и обязанностях"
                            },
                            {
                                "target_lang_word": "совмещать",
                                "target_lang_sense_clarification": "несколько видов деятельности"
                            },
                            {
                                "target_lang_word": "балансировать",
                                "target_lang_sense_clarification": "между разными задачами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兼顾",
                                "target_lang_sense_clarification": "同时处理多项任务或责任"
                            },
                            {
                                "target_lang_word": "平衡",
                                "target_lang_sense_clarification": "在不同需求之间保持平衡"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33de8440-925f-3834-96fe-39a9eae849df",
                    "sense_definition": "To keep several objects, such as balls or clubs, in motion in the air at the same time by repeatedly throwing and catching them.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_juggling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The street performer began to <w>juggle</w> three bright orange balls to entertain the crowd.",
                            "target_lang_translations": {
                                "ru": "Уличный артист начал <w>жонглировать</w> тремя ярко-оранжевыми шарами, чтобы развлечь толпу.",
                                "zh": "街头艺人开始<w>杂耍</w>三个亮橙色的球来娱乐人群。"
                            }
                        },
                        {
                            "text": "She can <w>juggle</w> flaming torches with incredible precision and speed.",
                            "target_lang_translations": {
                                "ru": "Она может <w>жонглировать</w> горящими факелами с невероятной точностью и скоростью.",
                                "zh": "她能以惊人的精准度和速度<w>杂耍</w>燃烧的火把。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "juggle three balls",
                        "learn to juggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Удерживать несколько предметов в воздухе, поочередно подбрасывая и ловя их.",
                        "zh": "通过反复抛接，使多个物体（如球或棒）同时在空中运动。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жонглировать",
                                "target_lang_sense_clarification": "предметами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂耍",
                                "target_lang_sense_clarification": "指抛接物体的表演"
                            },
                            {
                                "target_lang_word": "玩杂技",
                                "target_lang_sense_clarification": "指进行杂技表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7a488191-18dc-3d23-9bc8-5c6335560063",
                    "sense_definition": "To manipulate information or figures dishonestly in order to deceive someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The accountant was caught trying to <w>juggle</w> the books to hide the company's losses.",
                            "target_lang_translations": {
                                "ru": "Бухгалтер был пойман на попытке <w>подтасовать</w> отчетность, чтобы скрыть убытки компании.",
                                "zh": "会计因试图<w>篡改</w>账目以掩盖公司亏损而被抓。"
                            }
                        },
                        {
                            "text": "I think they are <w>juggling</w> the company's books to avoid paying their fair share of taxes.",
                            "target_lang_translations": {
                                "ru": "Я думаю, они <w>махинируют</w> с бухгалтерией компании, чтобы избежать уплаты налогов в полном объеме.",
                                "zh": "我认为他们在<w>做手脚</w>以逃避应缴税款。"
                            }
                        }
                    ],
                    "synonyms": [
                        "manipulate",
                        "fudge"
                    ],
                    "common_phrases": [
                        "juggle the books"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечестно манипулировать информацией или цифрами с целью обмана.",
                        "zh": "为了欺骗他人而以不诚实的方式操纵信息或数字。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жонглировать",
                                "target_lang_sense_clarification": "фактами или цифрами для обмана"
                            },
                            {
                                "target_lang_word": "подтасовывать",
                                "target_lang_sense_clarification": "факты или отчетность"
                            },
                            {
                                "target_lang_word": "махинировать",
                                "target_lang_sense_clarification": "с данными"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "篡改",
                                "target_lang_sense_clarification": "指非法修改数据或账目"
                            },
                            {
                                "target_lang_word": "做手脚",
                                "target_lang_sense_clarification": "指暗中进行不正当操作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a332566d-e1f9-36b4-b6b5-62a7954db460",
                    "sense_definition": "To perform magic tricks or sleight of hand.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In the old days, traveling entertainers would <w>juggle</w> and perform small wonders for the villagers.",
                            "target_lang_translations": {
                                "ru": "В прежние времена бродячие артисты <w>показывали фокусы</w> и совершали маленькие чудеса для жителей деревень.",
                                "zh": "过去，流浪艺人会为村民们<w>变戏法</w>并表演一些小奇迹。"
                            }
                        },
                        {
                            "text": "The wizard seemed to <w>juggle</w> with the very laws of nature to produce his illusions.",
                            "target_lang_translations": {
                                "ru": "Казалось, волшебник <w>играет</w> с самими законами природы, создавая свои иллюзии.",
                                "zh": "巫师似乎在<w>戏弄</w>自然法则来制造幻象。"
                            }
                        }
                    ],
                    "synonyms": [
                        "conjure"
                    ],
                    "target_lang_definitions": {
                        "ru": "Показывать фокусы или демонстрировать ловкость рук.",
                        "zh": "表演魔术或戏法。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "показывать фокусы",
                                "target_lang_sense_clarification": "заниматься иллюзионизмом"
                            },
                            {
                                "target_lang_word": "фокусничать",
                                "target_lang_sense_clarification": "демонстрировать ловкость рук"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "变戏法",
                                "target_lang_sense_clarification": "指表演魔术"
                            },
                            {
                                "target_lang_word": "耍花招",
                                "target_lang_sense_clarification": "指通过技巧进行表演"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7cfa64c6-831d-3b0a-b4a0-fdf6e7ece18e",
                    "sense_definition": "To joke, jest, or play around in a lighthearted manner.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "jesting",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They spent the evening <w>juggling</w> with words and sharing funny stories by the fire.",
                            "target_lang_translations": {
                                "ru": "Они провели вечер, <w>играя</w> словами и делясь забавными историями у костра.",
                                "zh": "他们围坐在火堆旁，整晚都在<w>戏谑</w>言辞并分享有趣的故事。"
                            }
                        },
                        {
                            "text": "Do not <w>juggle</w> with such serious matters when the stakes are so high.",
                            "target_lang_translations": {
                                "ru": "Не стоит <w>паясничать</w> в таких серьезных вопросах, когда ставки так высоки.",
                                "zh": "当利害关系如此重大时，不要在这些严肃的事情上<w>开玩笑</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "jest",
                        "joke"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "this sense is rarely used in modern English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шутить, паясничать или вести себя легкомысленно.",
                        "zh": "以轻松的方式开玩笑、戏谑或玩闹。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "паясничать",
                                "target_lang_sense_clarification": "шутить, вести себя несерьезно"
                            },
                            {
                                "target_lang_word": "шутить",
                                "target_lang_sense_clarification": "играть словами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "戏谑",
                                "target_lang_sense_clarification": "用言语开玩笑"
                            },
                            {
                                "target_lang_word": "打趣",
                                "target_lang_sense_clarification": "轻松地开玩笑"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6d7e939f-19dd-3564-a539-9ebf153c5524",
                    "sense_definition": "The act of managing several activities or obligations simultaneously.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "multitasking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The daily <w>juggle</w> of childcare and a full-time job can be extremely exhausting.",
                            "target_lang_translations": {
                                "ru": "Ежедневное <w>совмещение</w> ухода за детьми и полноценной работы может быть крайне изнурительным.",
                                "zh": "每天在照顾孩子和全职工作之间<w>兼顾</w>会让人精疲力竭。"
                            }
                        },
                        {
                            "text": "Quit the <w>juggle</w> and monotask if you want to improve your focus.",
                            "target_lang_translations": {
                                "ru": "Прекратите эту <w>многозадачность</w> и сосредоточьтесь на одном деле, если хотите улучшить концентрацию.",
                                "zh": "如果你想提高专注力，就停止这种<w>多任务处理</w>，一次只做一件事。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "daily juggle"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс одновременного выполнения нескольких дел или обязательств.",
                        "zh": "同时管理多项活动或义务的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жонглирование",
                                "target_lang_sense_clarification": "переносно о делах"
                            },
                            {
                                "target_lang_word": "совмещение",
                                "target_lang_sense_clarification": "обязанностей"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "兼顾",
                                "target_lang_sense_clarification": "同时处理多项事务的状态"
                            },
                            {
                                "target_lang_word": "多任务处理",
                                "target_lang_sense_clarification": "同时进行多项工作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f835a756-fc01-3455-a76a-32dd3b08a1c0",
                    "sense_definition": "A continuous act of throwing and catching props where each item is caught at least twice.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "physical_juggling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He managed a clean <w>juggle</w> with five clubs before finally dropping one.",
                            "target_lang_translations": {
                                "ru": "Ему удалось чистое <w>жонглирование</w> пятью булавами, прежде чем он в конце концов уронил одну.",
                                "zh": "他在最终掉落一个之前，成功地完成了五根棒的<w>杂耍</w>。"
                            }
                        },
                        {
                            "text": "The coach explained that a successful <w>juggle</w> requires consistent height and rhythm.",
                            "target_lang_translations": {
                                "ru": "Тренер объяснил, что успешное <w>жонглирование</w> требует постоянной высоты и ритма.",
                                "zh": "教练解释说，成功的<w>杂耍</w>需要稳定的高度和节奏。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт подбрасывания и ловли предметов в цирковом или спортивном искусстве.",
                        "zh": "一种连续抛接道具的动作，其中每个物体至少被接住两次。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "жонглирование",
                                "target_lang_sense_clarification": "физический акт"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "杂耍",
                                "target_lang_sense_clarification": "指杂技表演中的抛接动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2b34c719-d542-3334-82b4-8541f3766316",
                    "sense_definition": "An act of trickery, deceit, or an imposture.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "deception",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He suspected the entire spiritualist session was nothing more than a clever <w>juggle</w>.",
                            "target_lang_translations": {
                                "ru": "Он подозревал, что весь спиритический сеанс был не более чем ловкой <w>махинацией</w>.",
                                "zh": "他怀疑整个降神会不过是一场巧妙的<w>骗局</w>。"
                            }
                        },
                        {
                            "text": "Is this a <w>juggle</w> intended to lead us away from the truth of the matter?",
                            "target_lang_translations": {
                                "ru": "Не является ли это <w>уловкой</w>, призванной увести нас от истины?",
                                "zh": "这是否是一个旨在将我们引离事实真相的<w>诡计</w>？"
                            }
                        }
                    ],
                    "synonyms": [
                        "deception",
                        "trick"
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт обмана, хитрости или мошенничества.",
                        "zh": "欺骗、诡计或冒充的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "махинация",
                                "target_lang_sense_clarification": "обманное действие"
                            },
                            {
                                "target_lang_word": "уловка",
                                "target_lang_sense_clarification": "хитрость"
                            },
                            {
                                "target_lang_word": "подтасовка",
                                "target_lang_sense_clarification": "обман"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "诡计",
                                "target_lang_sense_clarification": "欺骗性的手段"
                            },
                            {
                                "target_lang_word": "骗局",
                                "target_lang_sense_clarification": "欺诈行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "61daa33a-bf03-3ff6-afa2-cfdedd4ec64f",
                    "sense_definition": "The performance of a magic trick or an illusion.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "magic",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience gasped at the intricate <w>juggle</w> performed by the court magician.",
                            "target_lang_translations": {
                                "ru": "Зрители ахнули от сложного <w>фокуса</w>, исполненного придворным магом.",
                                "zh": "观众对宫廷魔术师表演的复杂<w>魔术</w>感到惊叹。"
                            }
                        },
                        {
                            "text": "Every <w>juggle</w> he presented left the children wondering how the coins disappeared.",
                            "target_lang_translations": {
                                "ru": "Каждый представленный им <w>трюк</w> заставлял детей гадать, куда исчезают монеты.",
                                "zh": "他表演的每一个<w>戏法</w>都让孩子们好奇硬币是如何消失的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "trick",
                        "illusion"
                    ],
                    "target_lang_definitions": {
                        "ru": "Исполнение магического трюка или иллюзии.",
                        "zh": "魔术表演或幻术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фокус",
                                "target_lang_sense_clarification": "магический трюк"
                            },
                            {
                                "target_lang_word": "иллюзия",
                                "target_lang_sense_clarification": "представление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "魔术",
                                "target_lang_sense_clarification": "指表演的戏法"
                            },
                            {
                                "target_lang_word": "戏法",
                                "target_lang_sense_clarification": "指小型的魔术表演"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}