                ],
                "senses": [
                    {
                        "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                        "entry_id": "ecf71e54-3549-3080-b391-df61ef3ee44d",
                        "glosses": [
                            "jemand, der unter bestimmten Bedingungen Geld zur Verfügung stellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "905855ee-c2c0-4c1a-a4e9-cf963e2e13c5",
                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                "text": "„Die Geldgeber sind unzufrieden.“"
                            },
                            {
                                "example_id": "8b869875-6ea1-47bc-b73c-269db0f6d991",
                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                "text": "„Anatol besass einen Pass, einen Postfahrschein, zehntausend Rubel von seiner Schwester und weitere zehntausend Rubel, die ihm Dolochow von irgendeinem Geldgeber verschafft hatte.“"
                            },
                            {
                                "example_id": "95493269-a7dc-4959-b1c9-773eba17d708",
                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                "text": "„Zu den Geldgebern gehörte auch der Jugendstil-Zeichner Marcus Behmer.“"
                            },
                            {
                                "example_id": "f36505b1-dd3b-462f-b6c3-cc9ed233744b",
                                "sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                                "text": "„Einer der Geldgeber der Stolbergs war Hans Luder, der Vater des Reformators.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b0b1d841-a449-409e-ba5a-c0e9c70f700f",
                        "source_entry_id": "ecf71e54-3549-3080-b391-df61ef3ee44d",
                        "source_sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                        "source_sense_description": "jemand, der unter bestimmten Bedingungen Geld zur Verfügung stellt",
                        "target_lang_word": "investor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "investor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                        "entry_id": "30b3f798-5f3c-30f1-8b99-8f5f07783ecf",
                                        "glosses": [
                                            "A person who invests money in order to make a profit."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49f98171-9da7-4430-9775-7ea0b7d6a443",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "[…] (it was the town's humour to be always gassing of phantom investors who were likely to come any moment and pay a thousand prices for everything) — “[…] Them rich fellers, they don't make no bad breaks with their money. […]”"
                                            },
                                            {
                                                "example_id": "002cc0b8-22e2-4e5b-ad33-4c14c1130acf",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "Across Japan, technology companies and private investors are racing to install devices that until recently they had little interest in: solar panels. Massive solar parks are popping up as part of a rapid build-up that one developer likened to an \"explosion.\""
                                            },
                                            {
                                                "example_id": "2312f782-7b12-4ee0-9355-629d2e613dd4",
                                                "sense_id": "b9d141d0-df34-33ea-bb61-4cbe98e8d8b7",
                                                "text": "So investors buy stablecoins not to make a profit but instead as a place to store money within the cryptocurrency infrastructure and to use when buying and selling other crypto assets. […] For example, the Commodity Futures Trading Commission asserted that for nearly four years Tether did not fully back its stablecoin with US dollars, meaning it did not have enough US dollars on hand to pay back every investor who potentially might cash out their Tether stablecoins."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef9ff5e9-a0ed-45a4-a788-4ee7837e9e2b",
                        "source_entry_id": "ecf71e54-3549-3080-b391-df61ef3ee44d",
                        "source_sense_id": "c29ba5c1-66d7-3abb-9113-ab7b32769eec",
                        "source_sense_description": "jemand, der unter bestimmten Bedingungen Geld zur Verfügung stellt",
                        "target_lang_word": "sponsor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sponsor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c815eb36-dd01-45f0-91a3-4aa3c09afc39",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "He was my sponsor when I applied to join the club."
                                            },
                                            {
                                                "example_id": "476a6f1e-692c-451b-91d8-db7a8111553a",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "They were my sponsors for immigration."
                                            },
                                            {
                                                "example_id": "c2d5736e-2f55-480d-9f6a-1f0c780e5005",
                                                "sense_id": "0b342ca1-f9db-3de3-bf43-1ef09e4c2884",
                                                "text": "The colonel and his sponsor made a queer contrast: Greystone [the sponsor] long and stringy, with a face that seemed as if a cold wind was eternally playing on it. […] But there was not a more lascivious reprobate and gourmand in all London than this same Greystone."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization with some sort of responsibility for another person or organization, especially where the responsibility has a religious, legal, or financial aspect.",
                                            "A senior member of a twelve step or similar program chosen to guide an initiate and form a partnership with them."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435b75e4-2d8a-4b93-bd86-3d8729b10948",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "My narcotics anonymous sponsor became my best friend when I finally was able to do something about my meth problem."
                                            },
                                            {
                                                "example_id": "03db4f57-ee93-47e6-bb1e-b34b759c2a00",
                                                "sense_id": "7a7443aa-d12c-3230-8b90-e7acfce8fc14",
                                                "text": "Members also choose a sponsor, with whom they are supposed to remain in regular, even daily, contact—and that, too, is a powerful boost for monitoring."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                        "entry_id": "6f0dcac0-f237-39d7-b75b-d812582543ca",
                                        "glosses": [
                                            "A person or organization that pays all or part of the cost of an event, publication, media program, etc., usually in exchange for advertising."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92efaac5-e314-41e4-b145-0f040a6a99a5",
                                                "sense_id": "b8ed18dd-e79f-3b61-97d1-e45102712bcd",
                                                "text": "And now a word from our sponsor."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sponsor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d29ec35-f290-3d4e-a4ce-432f72eabd83",
                                        "entry_id": "219c3327-013f-3803-8856-a8784f8d80bf",
                                        "glosses": [
                                            "To be a sponsor for."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e62cce4b-196e-4e28-b4cb-f733c1461cdb",
                                                "sense_id": "8d29ec35-f290-3d4e-a4ce-432f72eabd83",
                                                "text": "Like most human activities, ballooning has sponsored heroes and hucksters and a good deal in between. For every dedicated scientist patiently recording atmospheric pressure and wind speed while shivering at high altitudes, there is a carnival barker with a bevy of pretty girls willing to dangle from a basket or parachute down to earth."
                                            }
                                        ]
                                    }
                                ]
                            }
