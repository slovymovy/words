        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "bebbb2e5-1d5e-3f84-95e7-82a76d95e33d",
                    "sense_definition": "auf eine Art und Weise, die Unmut oder Verärgerung erkennen lässt",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "empfindend",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er blickte <w>ärgerlich</w> auf seine Uhr und verließ hastig den Besprechungsraum.",
                            "target_lang_translations": {
                                "en": "He glanced <w>angrily</w> at his watch and hurriedly left the meeting room.",
                                "ru": "Он <w>сердито</w> взглянул на часы и поспешно покинул переговорную.",
                                "nl": "Hij keek <w>geïrriteerd</w> op zijn horloge en verliet haastig de vergaderruimte.",
                                "pl": "Spojrzał <w>ze złością</w> na zegarek i pośpiesznie opuścił salę konferencyjną.",
                                "fr": "Il jeta un coup d'œil à sa montre <w>avec agacement</w> et quitta précipitamment la salle de réunion.",
                                "it": "Guardò l'orologio <w>con irritazione</w> e lasciò in fretta la sala riunioni.",
                                "cs": "<w>Podrážděně</w> se podíval na hodinky a spěšně opustil zasedací místnost.",
                                "tr": "<w>Öfkeyle</w> saatine baktı ve aceleyle toplantı odasından ayrıldı.",
                                "es": "Miró el reloj <w>con irritación</w> y abandonó a toda prisa la sala de reuniones.",
                                "zh": "他<w>生气地</w>看了一眼手表，匆匆离开了会议室。"
                            }
                        },
                        {
                            "text": "Sie schüttelte nur <w>ärgerlich</w> den Kopf und ging wortlos an ihm vorbei.",
                            "target_lang_translations": {
