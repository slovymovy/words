                "senses": [
                    {
                        "sense_id": "e921640f-e7da-3334-a2c7-5a1ee5f58a0e",
                        "entry_id": "1c101464-c927-3cf0-b307-2691c004e977",
                        "glosses": [
                            "Se blanchir soi-même."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "73edd0b3-4680-4cef-a507-13e2e2956b9c",
                                "sense_id": "e921640f-e7da-3334-a2c7-5a1ee5f58a0e",
                                "text": "Parmi d’autres écoles, malheureusement parfois plus mis en avant par des diviseurs ((i.e. sujet parfois d’un camouflage, ou double-action, pour s’auto-blanchir de la part de néo-hitlériens de toutes obédiences)"
                            },
                            {
                                "example_id": "f7ab5519-8a1b-4c04-9488-4e46dc0fb6cc",
                                "sense_id": "e921640f-e7da-3334-a2c7-5a1ee5f58a0e",
                                "text": "Dans le jargon publicitaire, on appelle ça le «greenwashing», l’art de s’auto-blanchir."
                            },
                            {
                                "example_id": "e759ac6a-eec3-4746-a39b-e143b73dfc76",
                                "sense_id": "e921640f-e7da-3334-a2c7-5a1ee5f58a0e",
                                "text": "Pour s’auto-blanchir dans ce dossier, le premier est venu sur une radio de la place le dimanche dernier."
                            }
                        ]
                    }
