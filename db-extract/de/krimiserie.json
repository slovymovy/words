                "senses": [
                    {
                        "sense_id": "4409ec20-05e5-31cd-9026-e55bcee4d657",
                        "entry_id": "2c8443f1-d6d9-39e4-b7a4-7eca0d29b2c1",
                        "glosses": [
                            "Fernsehserie, in deren Handlung die Aufklärung von Verbrechen im Mittelpunkt steht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "133a62f9-eb5f-4526-8ad5-f040beb61777",
                                "sense_id": "4409ec20-05e5-31cd-9026-e55bcee4d657",
                                "text": "„Schauplatz dieser Szene ist der Eingangsbereich der Eiswelt auf der Waldau, wo derzeit die Episode „Rollergirlz“ der Stuttgarter Krimiserie gedreht wird.“"
                            },
                            {
                                "example_id": "0b5ddca1-6e8e-4b2c-a9e9-ae3fe0544e2f",
                                "sense_id": "4409ec20-05e5-31cd-9026-e55bcee4d657",
                                "text": "„Es ist das erste Mal in 21 \"Pfarrer Braun\"-Fällen, dass das Schwergewicht Gottes, der \"Tabernakel-Columbo\" (in Anlehnung an die berühmte US-Krimiserie mit Peter Falk als Inspektor Columbo), den Vatikan besucht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
