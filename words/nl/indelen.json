                    "sense_id": "5960492f-33f6-3805-945d-6cd604120c33",
                    "sense_definition": "personen of zaken in groepen of categorieën plaatsen op basis van bepaalde kenmerken",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "classificatie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De leraar gaat de nieuwe leerlingen in verschillende groepen <w>indelen</w>.",
                            "target_lang_translations": {
                                "en": "The teacher is going to <w>assign</w> the new students to different groups.",
                                "pl": "Nauczyciel zamierza <w>przydzielić</w> nowych uczniów do różnych grup."
                            }
                        },
                        {
                            "text": "Kun je deze boeken op alfabetische volgorde <w>indelen</w> in de kast?",
                            "target_lang_translations": {
                                "en": "Can you <w>sort</w> these books in alphabetical order in the cabinet?",
                                "pl": "Czy możesz <w>poukładać</w> te książki w szafie w porządku alfabetycznym?"
                            }
                        }
