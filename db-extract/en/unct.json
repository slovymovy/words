                "senses": [
                    {
                        "sense_id": "bfb555df-c132-38a6-8160-541a2a05590a",
                        "entry_id": "bdb89451-4a47-3b86-a820-e8bc84c378a6",
                        "glosses": [
                            "To anoint, especially a monarch or other patriarchal leader."
                        ],
                        "tags": [
                            "archaic"
                        ],
                        "examples": [
                            {
                                "example_id": "9d2acf37-4577-4466-9bb0-85d525d16b3a",
                                "sense_id": "bfb555df-c132-38a6-8160-541a2a05590a",
                                "text": "The King was uncted in the nick of time"
                            },
                            {
                                "example_id": "5059ec55-1dea-4c69-8e15-2b3c20975bd3",
                                "sense_id": "bfb555df-c132-38a6-8160-541a2a05590a",
                                "text": "[…] and lat thame pray ouir him and unct him with oyle in the name of our Lord, […]"
                            },
                            {
                                "example_id": "4d3be3d4-4bd7-4004-9b49-0f0a7c9848a2",
                                "sense_id": "bfb555df-c132-38a6-8160-541a2a05590a",
                                "text": "Tyll tyred with battles, for to ceese the fraie, / Theie uncted Brutus kynge, and gave the Trojanns swaie."
                            },
                            {
                                "example_id": "29a23be8-9e5e-40f3-9611-6aed083f43cf",
                                "sense_id": "bfb555df-c132-38a6-8160-541a2a05590a",
                                "text": "2001, Sheila Fischman tr., The Little Girl who was Too Fond of Matches: A Novel (original by Gaétan Soucy), →ISBN, page 11,\nI suppose the prospect of the sly devils in the village forcing my brother and me to kick the bucket without even uncting us extremely skewered me in every direction on the barbecue grill of those ancient queries concerning hell and its kind."
                            }
                        ]
                    },
                    {
                        "sense_id": "699ec603-e526-37fc-b92f-1d6db6139fd7",
                        "entry_id": "bdb89451-4a47-3b86-a820-e8bc84c378a6",
                        "glosses": [
                            "To lubricate."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc9deea-f868-4798-976c-4e1e04294cba",
                                "sense_id": "699ec603-e526-37fc-b92f-1d6db6139fd7",
                                "text": "This is also an uncting procedure in which oil is dropped into the nose and expelled through the mouth."
                            }
                        ]
                    }
