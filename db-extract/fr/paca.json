                "senses": [
                    {
                        "sense_id": "39641c70-78b3-3ee7-9162-f6e3cacea762",
                        "entry_id": "1c7cf15a-83b4-3711-8516-67659c34afdb",
                        "glosses": [
                            "Provence-Alpes-Côte d’Azur, (région administrative française)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6913dae2-1da8-4c0f-ad4a-f5d5acfeae42",
                                "sense_id": "39641c70-78b3-3ee7-9162-f6e3cacea762",
                                "text": "Les régions Pays-de-la-Loire et Provence-Alpes-Côte-d’Azur (PACA) détiennent les plus grandes surfaces, avec respectivement plus de 18 000 et 14 300 ha de roselières […]"
                            },
                            {
                                "example_id": "638f8e50-e1b9-4ad6-92bc-55f8d935e30f",
                                "sense_id": "39641c70-78b3-3ee7-9162-f6e3cacea762",
                                "text": "D’abord, la France méditerranéenne sera présentée en décrivant l’administration et la géographie. Ensuite, l’image mythique et touristique de la PACA va être présentée en détail."
                            },
                            {
                                "example_id": "1c05366f-dd33-4d0a-ab11-cd59181ed93f",
                                "sense_id": "39641c70-78b3-3ee7-9162-f6e3cacea762",
                                "text": "En Île-de-France aussi, les maîtres d’ouvrage commencent à préparer des listes de chantiers prioritaires et en PACA, une réunion autour du préfet de région doit se tenir le 17 avril pour définir justement les priorités et remettre l’ensemble de la chaîne de la construction à l’ouvrage."
                            }
                        ]
                    }
                ],
