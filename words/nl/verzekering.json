    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "513b036b-34cc-3bfb-832f-8081f647d626",
                    "sense_definition": "Een overeenkomst waarbij men tegen betaling van een premie recht heeft op vergoeding van schade of verlies.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verzekering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik heb als ondernemer een nieuwe <w>verzekering</w> afgesloten voor mijn bedrijfspand.",
                            "target_lang_translations": {
                                "en": "As an entrepreneur, I have taken out a new <w>insurance</w> policy for my business premises."
                            }
                        },
                        {
                            "text": "Zonder een goede <w>verzekering</w> moet je alle medische kosten zelf betalen.",
                            "target_lang_translations": {
                                "en": "Without good <w>insurance</w>, you have to pay all medical costs yourself."
                            }
                        }
                    ],
                    "synonyms": [
                        "assurantie"
                    ],
                    "common_phrases": [
                        "verzekering afsluiten",
                        "medische verzekering",
                        "verzekering opzeggen"
                    ],
                    "target_lang_definitions": {
                        "en": "An agreement where, in exchange for a premium payment, one is entitled to compensation for damage or loss."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "insurance",
                                "target_lang_sense_clarification": "financial protection against loss"
                            },
                            {
                                "target_lang_word": "insurance policy",
                                "target_lang_sense_clarification": "the specific contract or agreement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "da326cd1-d015-33b1-8848-e91c85ec2a05",
                    "sense_definition": "De stellige mededeling of belofte dat iets waar is of zal gebeuren.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belofte",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Hij gaf me de <w>verzekering</w> dat alles klopte en dat ik me geen zorgen hoefde te maken.",
                            "target_lang_translations": {
                                "en": "He gave me the <w>assurance</w> that everything was correct and that I didn't need to worry."
                            }
                        },
                        {
                            "text": "Ondanks zijn plechtige <w>verzekering</w> bleek het verhaal achteraf toch niet helemaal waar te zijn.",
                            "target_lang_translations": {
                                "en": "Despite his solemn <w>assurance</w>, the story turned out not to be entirely true afterwards."
                            }
                        }
                    ],
                    "synonyms": [
                        "garantie"
                    ],
                    "common_phrases": [
                        "plechtige verzekering",
                        "de verzekering geven"
                    ],
                    "target_lang_definitions": {
                        "en": "A firm statement or promise that something is true or will happen."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "assurance",
                                "target_lang_sense_clarification": "a declaration intended to inspire confidence"
                            },
                            {
                                "target_lang_word": "guarantee",
                                "target_lang_sense_clarification": "a formal promise or certainty"
                            },
                            {
                                "target_lang_word": "affirmation",
                                "target_lang_sense_clarification": "a declaration that something is true"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}