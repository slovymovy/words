                        "entry_id": "1866e7a9-5e51-3d38-8b69-0a3e55a1ade5",
                        "glosses": [
                            "Relatif à saint Jacques, et en particulier au pèlerinage à Saint-Jacques-de-Compostelle."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "efc5d9d6-b8be-4d18-97ce-094a932532e6",
                                "sense_id": "10007808-a5b7-345e-9bd0-ff4264e9a15e",
                                "text": "Les fonds récoltés par la vente de ce foulard baptisé Ultréïa serviront à restaurer les refuges jacquaires et contribueront au pèlerinage de jeunes défavorisés."
                            },
                            {
                                "example_id": "ca0d22df-ede3-4d72-83a8-6a9484645e09",
                                "sense_id": "10007808-a5b7-345e-9bd0-ff4264e9a15e",
                                "text": "Les pèlerins de Saint-Jacques-de-Compostelle faisant halte à Saint-Sever, trouveront une nouvelle halte jacquaire, rénovée et flambant neuve dans le cloître des Jacobins."
                            }
                        ]
                    },
                    {
                        "sense_id": "dc33c679-cb93-3303-a221-5ebd318a224d",
                        "entry_id": "1866e7a9-5e51-3d38-8b69-0a3e55a1ade5",
                        "glosses": [
                            "Qualifie les années où la Saint-Jacques tombe un dimanche ^([1])."
                        ],
