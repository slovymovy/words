    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                "word": "blatantly",
                "pos": "adv",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "b37666f3-d33a-4156-bc72-2b630a19da9d",
                        "entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "tags": [
                            "comparative"
                        ],
                        "form": "more blatantly"
                    },
                    {
                        "form_id": "d6149535-e2b5-4fbd-bec1-0ed9e45368cb",
                        "entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "tags": [
                            "superlative"
                        ],
                        "form": "most blatantly"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                        "entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "glosses": [
                            "In a blatant manner; so as to be highly visible or obvious."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d3ff686-c29b-4a1c-9e8f-bc343636f83a",
                                "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                                "text": "Although he was blatantly on drugs, the crowd still cheered him."
                            },
                            {
                                "example_id": "ec6a0eec-5837-48c1-a18e-eaec9a46a835",
                                "sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                                "text": "Further on, blatantly advertising its meritorious solidity, a boarding-house exhibits behind uncurtained windows its testimony to the soundness of London."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4def7568-0660-4b9f-809f-b6fa26142811",
                        "source_entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "source_sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                        "source_sense_description": "in a blatant manner",
                        "target_lang_word": "manifestement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "manifestement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                        "entry_id": "c5c200b5-0da8-3081-ac49-d2450c5a6774",
                                        "glosses": [
                                            "D’une manière manifeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e57bfa3-9a31-477c-b260-912ff04bb101",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "La vertu de Dieu s’étant fait connaître manifestement."
                                            },
                                            {
                                                "example_id": "2dd82efc-bd4c-40dd-a631-7bbf5b73d425",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Cette présence immuable de l’éternité, toujours fixe, toujours permanente, enfermant en l’infinité de son étendue toutes les différences des temps, il s’ensuit manifestement que le temps peut être en quelque sorte dans l’éternité."
                                            },
                                            {
                                                "example_id": "c7a2c994-381b-458b-8b77-b437bc51dd28",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Qui ne sait que la loi si quis canis, Digeste De vi paragrapho, messieurs, caponibus, Est manifestement contraire à cet abus ?"
                                            },
                                            {
                                                "example_id": "fe62e8d4-478c-45e9-872b-f2b350e3eabe",
                                                "sense_id": "28125064-3428-36bf-98b8-11c5950beb8c",
                                                "text": "Une option manifestement irréaliste."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ffe71278-8171-4c8b-b270-35d2c08d521b",
                        "source_entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "source_sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                        "source_sense_description": "in a blatant manner",
                        "target_lang_word": "ouvertement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ouvertement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                        "entry_id": "6fe16a36-369c-36cd-a747-08e5a5229200",
                                        "glosses": [
                                            "D’une manière ouverte, manifeste."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3c6ff21-3f0e-4a41-a294-4f659eb856e3",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Il est bien pénible de voir renverser toute la morale chrétienne par des égarements si étranges, sans oser y contredire ouvertement,"
                                            },
                                            {
                                                "example_id": "895d6189-3a8c-405d-b81b-b24c674beb4e",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "C'est l’ordinaire des orgueilleux d’exercer ouvertement leurs inimitiés,"
                                            },
                                            {
                                                "example_id": "3f15c46b-538b-41cd-88d1-280662eb1c71",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Marc-Aurèle ordonna qu’on ne poursuivît point les chrétiens pour cause de religion ; Caracalla, Héliogabale, Alexandre, Philippe, Gallien les protégèrent ouvertement,"
                                            },
                                            {
                                                "example_id": "2307c552-615e-41cd-8324-aebb8c21161e",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Il est certaines situations dont bénéficient seuls les gens tarés. Ils fondent leur fortune là où des hommes mieux posés et plus influents n’auraient point osé risquer la leur. Certes, Roudier, Granoux et les autres, par leur position d’hommes riches et respectés, semblaient devoir être mille fois préférés à Pierre comme chefs actifs du parti conservateur. Mais aucun d’eux n’aurait consenti à faire de son salon un centre politique ; leurs convictions n’allaient pas jusqu’à se compromettre ouvertement ; en somme, ce n’étaient que des braillards, des commères de province, qui voulaient bien cancaner chez un voisin contre la République, du moment où le voisin endossait la responsabilité de leurs cancans."
                                            },
                                            {
                                                "example_id": "534cd9ec-6737-4b92-a242-ea6156f71ff5",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Non contents de traquer les fourrageurs et d'enlever les hommes isolés, les Indiens commençaient à menacer ouvertement la place."
                                            },
                                            {
                                                "example_id": "b988a0a5-6cb9-44f7-b724-229df7df782a",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Brest, exceptionnelle enclave, est, en somme, la seule commune où un esprit anticlérical, se manifeste ouvertement."
                                            },
                                            {
                                                "example_id": "19d3431a-eeca-4991-b4ee-3d646d4dbb5b",
                                                "sense_id": "f6f0f60a-b7f8-3eb2-a679-43da2331ba7f",
                                                "text": "Entre temps, les rationalistes zélés avaient dû prendra garde aux poursuites d'un cléricalisme obscurantin. Ils furent obligés de ne pas manifester trop ouvertement leurs vues, en raison de la « crainte du sabre »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b9a9a4b8-670a-4db1-abc5-2b0a38b003e4",
                        "source_entry_id": "c1192092-4e87-356a-b3ea-ef8c30934f30",
                        "source_sense_id": "4d7343e3-e2b1-3352-ab1d-65d3e192c6c2",
                        "source_sense_description": "in a blatant manner",
                        "target_lang_word": "clairement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "clairement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "D’une manière claire et nette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2a07e334-3376-4e75-b122-fa360b162691",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Les principaux problèmes auxquels il faudra faire face dans vingt ans sont clairement posés : la Corée du Nord et l’Iran auront-ils à cette date une arme nucléaire qui puisse être vectorisée ?"
                                            },
                                            {
                                                "example_id": "cb1d0246-8a3b-40d5-bae2-d1bcb1d17394",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Si vous vous expliquiez un peu plus clairement."
                                            },
                                            {
                                                "example_id": "5b5c360e-5448-4564-93d3-ef4dda66808b",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "[Elle] […] fait voir clairement les merveilleux effets Qu’en un cœur irrité produisent les bienfaits."
                                            },
                                            {
                                                "example_id": "2d18c738-88df-4e7b-b6bf-79138f37f2a2",
                                                "sense_id": "4380189b-1c9f-3dc7-87f9-a1a0f5596133",
                                                "text": "Ce que l’on conçoit bien s’énonce clairement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                        "entry_id": "7f529d56-3e31-3be5-9129-9cb46608c8a8",
                                        "glosses": [
                                            "Indéniablement, sans aucun doute."
                                        ],
                                        "tags": [
                                            "neologism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "403dffde-55df-4e1f-8dc5-947e3ba31359",
                                                "sense_id": "577a5fee-5d38-36c0-9f3d-8cb1c1d72510",
                                                "text": "C’est clairement moins cher dans ce magasin."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
