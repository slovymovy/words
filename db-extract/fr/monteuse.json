                                    },
                                    {
                                        "sense_id": "8a865fd1-ff51-33f7-80f2-48853d7438b1",
                                        "entry_id": "b432bfb4-e50d-3bd3-8811-1494f552003c",
                                        "glosses": [
                                            "A person who edited a specific document."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787e8dfc-8b3c-44a1-ba6d-752137ac1909",
                                                "sense_id": "8a865fd1-ff51-33f7-80f2-48853d7438b1",
                                                "text": "John Johnson wrote this term paper and the editor was Joan Johnson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9ed172b4-eb18-337a-ad6b-00e38c8f72be",
                                        "entry_id": "b432bfb4-e50d-3bd3-8811-1494f552003c",
                                        "glosses": [
                                            "A person at a newspaper, publisher or similar institution who edits stories and/or decides which ones to publish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07a4a7ff-86e9-4f68-a277-e9669c07c031",
                                                "sense_id": "9ed172b4-eb18-337a-ad6b-00e38c8f72be",
                                                "text": "John is the city editor at the Daily Times."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a2fc9a7-d526-382b-8a65-4e129d23bbea",
                                        "entry_id": "b432bfb4-e50d-3bd3-8811-1494f552003c",
                                        "glosses": [
                                            "A machine used for editing (cutting and splicing) movie film"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8524038b-4a1e-3594-9b89-7b0d3c091ac3",
                                        "entry_id": "b432bfb4-e50d-3bd3-8811-1494f552003c",
                                        "glosses": [
                                            "A program for creating and making changes to files, especially text files."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f8b287b-94dd-4af5-b5a1-1bf43fae0d58",
                                                "sense_id": "8524038b-4a1e-3594-9b89-7b0d3c091ac3",
                                                "text": "The TPU EVE editor is an excellent, extensible, programmable editor."
                                            }
                                        ]
