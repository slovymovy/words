                "senses": [
                    {
                        "sense_id": "53291c35-50c5-3674-8a1e-1751d8f5f321",
                        "entry_id": "348ade82-84e2-3504-ae87-014ef6cedee8",
                        "glosses": [
                            "Mettre une jupe à (un kayak)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b21c45fe-64c9-48ee-9748-bd4eb149a89b",
                                "sense_id": "53291c35-50c5-3674-8a1e-1751d8f5f321",
                                "text": "Modèles à juper (jupe fournie) ou autovideurs (débutants)."
                            },
                            {
                                "example_id": "150ec750-fe90-4801-be2c-99d462bc495f",
                                "sense_id": "53291c35-50c5-3674-8a1e-1751d8f5f321",
                                "text": "Je fais bien attention en embarquant, depuis en ponton, pieds secs, et en jupant, je suis sur de ne pas embarquer d'eau."
                            }
                        ]
                    },
                    {
                        "sense_id": "78ea4bb4-03c1-3359-8f59-551395561ecd",
                        "entry_id": "348ade82-84e2-3504-ae87-014ef6cedee8",
                        "glosses": [
                            "Mettre une jupe."
                        ],
                        "tags": [
                            "pronominal",
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "be1a97fe-743b-4e5b-8772-c3d0cfa7f824",
                                "sense_id": "78ea4bb4-03c1-3359-8f59-551395561ecd",
                                "text": "je peux au moins me juper sans collant compact..."
                            },
                            {
                                "example_id": "bb0e80a9-86d1-4c6d-9653-cc112bea86e7",
                                "sense_id": "78ea4bb4-03c1-3359-8f59-551395561ecd",
                                "text": "Ekatérinbourg : pour visiter la cathédrale les dames ont du se \"juper\"."
                            },
                            {
                                "example_id": "029d77f7-4a36-4dbc-b50a-f56c398f9161",
                                "sense_id": "78ea4bb4-03c1-3359-8f59-551395561ecd",
                                "text": "Dont ce sublime keffieh (modèles uniques & vraiment distingués) & de quoi se juper sans"
                            },
                            {
                                "example_id": "47a7995f-132a-49c3-9135-734bd3dc2c46",
                                "sense_id": "78ea4bb4-03c1-3359-8f59-551395561ecd",
                                "text": "se demander où sont les clés de toutes ces minuscules serrures et qui a choisi les couleurs, penser aussi que le mot cadenas sonne pauvret et rigide, n'a rien à voir avec la ribambelle de verrous qui, parce qu'elle les fait couler en cascade, les purge de la notion fermée de fermeture, c'est pourtant simple, ça s'ouvre en grappe, ça se jupe en danseuse espagnole, le mot cadenas rien à faire là, qu'on lui tranche la tête"
                            }
                        ]
                    }
