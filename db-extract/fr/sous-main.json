        "fr-extract.jsonl": [
            {
                "entry_id": "d681320e-16d6-3e20-b40a-c3e08f4c8c89",
                "word": "sous-main",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "abbd6b6c-9d2a-4ae9-ba8d-8db187dfd34d",
                        "entry_id": "d681320e-16d6-3e20-b40a-c3e08f4c8c89",
                        "tags": [
                            "plural"
                        ],
                        "form": "sous-mains"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                        "entry_id": "d681320e-16d6-3e20-b40a-c3e08f4c8c89",
                        "glosses": [
                            "Accessoire de bureau sur lequel on pose son papier pour écrire."
                        ],
                        "tags": [
                            "Travail"
                        ],
                        "examples": [
                            {
                                "example_id": "0ba5dba1-e9b7-40a5-8e0f-ae990a343658",
                                "sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                                "text": "Au centre, le sous-main à coins de cuir, flanqué du tampon buvard, de crayons rouges et bleus, d’une règle en métal chromé."
                            },
                            {
                                "example_id": "bd153c43-cb19-4127-b1ba-47892c086226",
                                "sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                                "text": "Installés sur des chaises de cuir dont les dossiers dépassaient largement la tête, les ouvriers avaient devant eux les sous-main des membres du conseil d’administration avec des feuilles de papier, un tampon buvard et, devant, un encrier en bronze tarabiscoté au milieu d’un quadrige triomphant, le porte-plume planté, à l’envers, parmi les fruits d’une corne d’abondance."
                            },
                            {
                                "example_id": "3c2d6b63-4dc5-40ec-a8a6-e7426c0ebe71",
                                "sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                                "text": "Les sous-mains peuvent entraîner des allergies de contact comme dans les trois observations rapportées [30, 31]."
                            },
                            {
                                "example_id": "fefacda5-e80d-424a-9975-9ce145a7d858",
                                "sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                                "text": "Pia se pencha sur le bureau et étudia les griffonnages du sous-main…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b52cccab-a5b3-47f0-9301-b439c1163f1d",
                        "source_entry_id": "d681320e-16d6-3e20-b40a-c3e08f4c8c89",
                        "source_sense_id": "c10cdf6a-6b5e-3154-8a6a-ecb56bdb1f72",
                        "source_sense_description": "Accessoire pour placer le papier",
                        "target_lang_word": "Unterlage",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterlage",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f26a42f5-eaec-370d-82fb-d5bc16956353",
                                        "entry_id": "ae1b722c-59a0-3146-bdc3-62dbda35a002",
                                        "glosses": [
                                            "unter etwas liegender Gegenstand oder Schicht (Schichte) als Schutz, Stärkung oder Höhenausgleich"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1151f1e3-2507-499d-bab8-4f6535b73607",
                                                "sense_id": "f26a42f5-eaec-370d-82fb-d5bc16956353",
                                                "text": "Ein dicker Karton diente als Unterlage zum Schreiben."
                                            },
                                            {
                                                "example_id": "74755448-1136-4ae0-9d9b-0b4433e12712",
                                                "sense_id": "f26a42f5-eaec-370d-82fb-d5bc16956353",
                                                "text": "Als Unterlage tranken wir noch ein Gläschen Öl, um für das Saufgelage gerüstet zu sein."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                        "entry_id": "ae1b722c-59a0-3146-bdc3-62dbda35a002",
                                        "glosses": [
                                            "Dokumente und sonstige Beweisstücke, die für einen rechtlichen, verwaltungstechnischen oder ähnlichen Vorgang benötigt werden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "350e355b-cdba-456d-87e8-21781a8107bf",
                                                "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                                "text": "„Außerdem ließ er sich die Unterlagen über Gasthörerschaft vom Institut für Asien- und Afrikawissenschaften schicken.“"
                                            },
                                            {
                                                "example_id": "e497c66f-f8dc-4614-8206-5eb751632863",
                                                "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                                "text": "Der Beamte weigerte sich, meinen Akt ohne ausreichende Unterlagen zu bearbeiten."
                                            },
                                            {
                                                "example_id": "9d60fa7f-e0a7-4289-a7a4-b4adafde13c0",
                                                "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                                "text": "„Darauf ging ich nach Hause, um gegebenenfalls ein wenig die Unterlagen der Glasreiniger zu durchforschen.“"
                                            },
                                            {
                                                "example_id": "2926e360-d600-44e1-8038-046292771ac9",
                                                "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                                "text": "„Dwayne machte Anstalten zu gehen und sammelte seine Unterlagen vom Tisch ein.“"
                                            },
                                            {
                                                "example_id": "754b69e5-7f02-4ab6-b3b5-34e57933015b",
                                                "sense_id": "23da989d-56d5-357a-8ae9-e2c9a67ce2ee",
                                                "text": "„Im Flur schiebt er seine Unterlagen in die Aktentasche, zieht seinen Parka an und reicht ihr die Hand.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7be1c2bd-2a09-3b98-a695-4c3326a2e718",
                                        "entry_id": "ae1b722c-59a0-3146-bdc3-62dbda35a002",
                                        "glosses": [
                                            "Grundlage, auf der Edelreiser aufgebracht werden"
                                        ],
                                        "tags": [
                                            "Obstbau"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0e8a032c-6905-4d28-955d-d43e668cb5e5",
                                                "sense_id": "7be1c2bd-2a09-3b98-a695-4c3326a2e718",
                                                "text": "Für viele Obstbäume dient die Quitte als Unterlage."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "a4ed706d-c684-3976-85f3-f63a204a478f",
                                        "entry_id": "ae1b722c-59a0-3146-bdc3-62dbda35a002",
                                        "glosses": [
                                            "Beim Wettkampf Position unter dem Gegner"
                                        ],
                                        "tags": [
                                            "Ringen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c2ba5313-2209-4d8c-98e4-a9075c38d3cf",
                                                "sense_id": "a4ed706d-c684-3976-85f3-f63a204a478f",
                                                "text": "Er konnte sich aus der Unterlage befreien."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    }
                                ]
                            }
                        ]
                    },
