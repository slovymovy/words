                        "examples": [
                            {
                                "example_id": "272a524c-3f66-4747-bc24-11c78389233e",
                                "sense_id": "8235258b-6bf3-34d5-9ec5-2403f2eb04a9",
                                "text": "Берг встал и, обня́в свою́ жену́ осторо́жно, что́бы не измя́ть кружевну́ю пелери́нку, за кото́рую он до́рого заплати́л, поцелова́л её в середи́ну губ.",
                                "translation": "Berg rose and embraced his wife carefully, so as not to crush her lace fichu for which he had paid a good price, kissing her straight on the lips.",
                                "english": "Berg rose and embraced his wife carefully, so as not to crush her lace fichu for which he had paid a good price, kissing her straight on the lips."
                            }
                        ]
                    }
