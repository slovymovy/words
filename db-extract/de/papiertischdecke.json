                "senses": [
                    {
                        "sense_id": "618ab97a-9b88-31b6-a96c-f208c56e35e6",
                        "entry_id": "623a5dfb-89ce-357d-b77c-57f84655b086",
                        "glosses": [
                            "Papier (von der Rolle), das als Abdeckung über eine Tischplatte gelegt wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec20fa30-aa74-4b31-bdae-25809f053e01",
                                "sense_id": "618ab97a-9b88-31b6-a96c-f208c56e35e6",
                                "text": "„Sie entdeckt ihn ganz hinten an der Fensterfront, die Blick auf die Asphaltpiste gewährt. Das Kinn auf die rechte Hand gestützt, huscht die linke über die Papiertischdecke und zeichnet ein Gesicht darauf.“"
                            },
                            {
                                "example_id": "e6d13c7d-d874-4151-8664-0fce66f8f190",
                                "sense_id": "618ab97a-9b88-31b6-a96c-f208c56e35e6",
                                "text": "„Jeder Tisch hatte eine weiße Papiertischdecke, und auf jedem standen zwei Flaschen Wein ohne Etikett, ein Roter und ein Rosé, von der Kooperative von Bonnieux zweihundert Meter weiter auf der anderen Straßenseite.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
