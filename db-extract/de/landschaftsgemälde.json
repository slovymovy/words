                "senses": [
                    {
                        "sense_id": "738a78b9-2ec9-38c7-8c20-0a8f6feda805",
                        "entry_id": "6697e7f8-8012-3310-acd4-ca38a78189f1",
                        "glosses": [
                            "Gemälde, das eine Landschaft darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b5763590-1a75-4b33-b477-9ce0b5d5e17c",
                                "sense_id": "738a78b9-2ec9-38c7-8c20-0a8f6feda805",
                                "text": "„Sie blieben eine Stunde hier, betrachteten eine Sammlung von Landschaftsgemälden, die während der Kulturrevolution als ›verloren‹ gegolten hatten und erst kürzlich ›wiedergefunden‹ und ausgestellt worden waren.“"
                            },
                            {
                                "example_id": "546f325a-3a83-4671-887a-9216d5ade89d",
                                "sense_id": "738a78b9-2ec9-38c7-8c20-0a8f6feda805",
                                "text": "„Das Bild, ein Landschaftsgemälde, zeigte ein Haus, rundum von einer Veranda umgeben, im Schatten von Bäumen.“"
                            },
                            {
                                "example_id": "9bd9d81b-0f09-4d82-a4e3-a9d26f536896",
                                "sense_id": "738a78b9-2ec9-38c7-8c20-0a8f6feda805",
                                "text": "„Außerdem finden sich hier Topfpflanzen und ein Landschaftsgemälde, aber nichts, was darauf hindeutet, wodurch der Besitzer jemanden so sehr verärgert haben könnte, dass dieser immer wieder auf ihn einstach.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
