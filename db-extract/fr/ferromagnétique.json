                "senses": [
                    {
                        "sense_id": "52ac41ba-37da-37a1-9d54-3d7c4c836fb6",
                        "entry_id": "6011fba4-f521-3939-b43a-71906e2f86c2",
                        "glosses": [
                            "Relatif au ferromagnétisme."
                        ],
                        "tags": [
                            "physical"
                        ],
                        "examples": [
                            {
                                "example_id": "8bd2c1de-52b6-441b-a43f-9c2084a6f28b",
                                "sense_id": "52ac41ba-37da-37a1-9d54-3d7c4c836fb6",
                                "text": "Là, une bobine calée sur chaque aimant devient elle-même un capteur pour le champ magnétique variable ré-induit par les roues, elles-mêmes fabriquées dans un matériau ferromagnétique."
                            },
                            {
                                "example_id": "e8982522-6a8b-4f21-acac-95d9a591fc36",
                                "sense_id": "52ac41ba-37da-37a1-9d54-3d7c4c836fb6",
                                "text": "L’effet galvanomagnétique, appelé aussi effet Goldhammer-Thomson, se traduit par un accroissement de la résistance électrique de la substance ferromagnétique placée dans un champ magnétique longitudinal et par une diminution de cette résistance électrique lorsque le champ magnétique est transversal."
                            }
                        ]
                    },
                    {
                        "sense_id": "f50b3324-4434-38cd-a3f9-5fc96a9231f3",
                        "entry_id": "6011fba4-f521-3939-b43a-71906e2f86c2",
                        "glosses": [
                            "Relatif aux ferromagnétaux."
                        ],
                        "tags": [
                            "Science-fiction"
                        ],
                        "examples": [
                            {
                                "example_id": "8e1a1ce0-0598-461d-b444-cf52f6091488",
                                "sense_id": "f50b3324-4434-38cd-a3f9-5fc96a9231f3",
                                "text": "C'est vraisemblablement là qu'il faut voir la manifestation dominante de la vie ferromagnétique."
                            }
                        ]
                    }
