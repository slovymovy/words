                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d74cb3b-4c36-4501-939d-b8df485aa06c",
                                "sense_id": "79823658-c0c7-392f-b547-cb582a754864",
                                "text": "De dag nadat ik de ramen had gewassen stonden de handafdrukken van mijn geliefde dochter al weer op de ruiten."
                            },
                            {
                                "example_id": "6048b417-289d-478c-9d7d-4569bc1680dd",
                                "sense_id": "79823658-c0c7-392f-b547-cb582a754864",
                                "text": "Annemiek opent de zwarte tent. Met het roetkwastje begint ze over gladde oppervlakten te strijken, reliëf verstoort het lijnenbeeld. Eerst het tentzeil, dan de lichtkap. Vingerafdrukken doemen op. Ze kan de lijnen dromen. „Als ik in De Bijenkorf ben en ik zie zo’n dikke handafdruk op de draaideur, denk ik soms: hé, dat is een mooie om een spoor af te trekken.”"
                            }
                        ]
                    }
