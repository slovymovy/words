                "senses": [
                    {
                        "sense_id": "f9ce1afc-3a71-3c73-8fbb-ccf3efee62fd",
                        "entry_id": "b3b55aa3-89d8-3c5a-9d5d-6120e1841817",
                        "glosses": [
                            "Celui qui contemple."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d065abb4-958a-4203-8336-ca53471d7cbe",
                                "sense_id": "f9ce1afc-3a71-3c73-8fbb-ccf3efee62fd",
                                "text": "Contemplateur des merveilles de la nature."
                            },
                            {
                                "example_id": "606035b5-d562-4a02-8ca0-85f89815eaff",
                                "sense_id": "f9ce1afc-3a71-3c73-8fbb-ccf3efee62fd",
                                "text": "Ce que n’ont pu abattre ni le temps, ni les hommes, ni le bon goût, ni l’industrie, voilà que l’achève sans le savoir le contemplateur naïf, dans l’exercice même de sa curiosité admirative."
                            },
                            {
                                "example_id": "865ce84f-fabc-4c2d-a881-53f450a0490d",
                                "sense_id": "f9ce1afc-3a71-3c73-8fbb-ccf3efee62fd",
                                "text": "Les couleurs découragent le plus intrépide des contemplateurs : bruns grumeleux, marrons, beiges maladifs, ocres diarrhéiques, gris intestinaux."
                            }
                        ]
                    },
                    {
                        "sense_id": "fd12c1fc-ca76-35a4-83b5-6f5b4dfdcdac",
                        "entry_id": "b3b55aa3-89d8-3c5a-9d5d-6120e1841817",
                        "glosses": [
                            "Se dit surtout de celui qui se livre à la méditation intérieure."
                        ],
