                "senses": [
                    {
                        "sense_id": "30729ea2-e574-3563-8a79-a7e052da39a6",
                        "entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
                        "glosses": [
                            "Gefäß zum Schmelzen von Metallen oder anderen Stoffen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d23d6b34-cd7f-41a5-9847-906fd1d8e8bc",
                                "sense_id": "30729ea2-e574-3563-8a79-a7e052da39a6",
                                "text": "In einem Schmelztiegel werden Kupfer und Zinn zu Bronze verschmolzen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52eb40da-a83f-350c-9a59-839cf0d01fbf",
                        "entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
                        "glosses": [
                            "Ort der Assimilation von Menschen verschiedener kultureller Herkunft"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "e1c7fb2a-f34c-49ba-9437-43f347b725c1",
                                "sense_id": "52eb40da-a83f-350c-9a59-839cf0d01fbf",
                                "text": "Die USA sind ein Schmelztiegel der Kulturen."
                            },
                            {
                                "example_id": "9d5ceebf-a9dd-43ad-9d01-dcd5e55018ba",
                                "sense_id": "52eb40da-a83f-350c-9a59-839cf0d01fbf",
                                "text": "„Das alte Wien war ein Schmelztiegel gewesen, ein europäisches Kulturzentrum, ein Knotenpunkt der Kommunikation.“"
                            },
                            {
                                "example_id": "f0ce69e4-4d46-42ad-b2df-3b7330d1efb7",
                                "sense_id": "52eb40da-a83f-350c-9a59-839cf0d01fbf",
                                "text": "„Der gesellschaftskritische Sinn, der Blick für die sozialen Gegensätze schärfte sich in einem Land, das jeden Mann und jede Frau in den Schmelztiegel Paris schleuderte.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e68b1575-e461-4e93-8717-a7a3572fa53d",
                        "source_entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
                        "source_sense_id": "30729ea2-e574-3563-8a79-a7e052da39a6",
                        "source_sense_description": "Gefäß zum Schmelzen von Metallen oder anderen Stoffen",
                        "target_lang_word": "crucible",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crucible",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e90b917-0203-3213-adf4-af516a27fdc4",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A cup-shaped piece of laboratory equipment used to contain chemical compounds when heating them to very high temperatures."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8757e926-7681-4f1b-9707-beadca41dacc",
                                                "sense_id": "0e90b917-0203-3213-adf4-af516a27fdc4",
                                                "text": "In one corner of the closet was a very small furnace, with a glowing fire in it, and on the fire a kind of duplicate crucible—two crucibles connected by a tube. One of these crucibles was nearly full of lead in a state of fusion, but not reaching up to the aperture of the tube, which was close to the brim."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf594bb4-d8bf-30ac-b837-3be1b891b40d",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A heat-resistant container in which metals are melted, usually at temperatures above 500°C, commonly made of graphite with clay as a binder."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7b6ce7f4-f54a-3a60-91bf-7423d7a11a59",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "The bottom and hottest part of a blast furnace; the hearth."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                        "entry_id": "e7e531fb-ef87-3618-8302-fe99e24a646c",
                                        "glosses": [
                                            "A very difficult and trying experience, that acts as a refining or hardening process."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcad3650-2f18-417d-bbc2-28701300ed84",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "But, in considering an author and his works as one, a sufficient distinction is not drawn between the ideal and the real: the last is only given by being past through the crucible of the first."
                                            },
                                            {
                                                "example_id": "b03b516b-5092-4c00-915c-2be5974869be",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "We should give our support to the liberation of the captive nations of the world and deliver our compatriots from their crucible of suffering. In other words, we should take up the difficult task of reshaping the world’s destiny by destroying the tyrannical Communist rule now afflicting the earth and by delivering humankind from the Red holocaust."
                                            },
                                            {
                                                "example_id": "2123f297-8899-4037-8d22-c3aa839b63b8",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "Some of our ancestors faced trials that we will never know—the snows of Valley Forge; the crucible of a bitter, bloody civil war; and the incredible hardships endured in taming a savage wilderness."
                                            },
                                            {
                                                "example_id": "e2cbaa00-6186-4296-ab77-cc40db453bc3",
                                                "sense_id": "cc603ec0-ce99-3290-a2d7-ca8567566b48",
                                                "text": "Beowulf's mood as he gets ready to fight the dragon - who could be read as a projection of Beowulf's own chthonic wisdom refined in the crucible of experience - recalls the mood of other tragic heroes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "fe5ab739-a77c-4614-9092-dda7aec96bb4",
                        "source_entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
                        "source_sense_id": "30729ea2-e574-3563-8a79-a7e052da39a6",
                        "source_sense_description": "Gefäß zum Schmelzen von Metallen oder anderen Stoffen",
                        "target_lang_word": "melting pot",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "melting pot",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f137f5af-6219-387a-8eb2-aea10d5c73cc",
                                        "entry_id": "7f5b6584-faee-37d2-addc-7e60809c0219",
                                        "glosses": [
                                            "A crucible, or similar pot, used to fuse mixtures of metals etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                        "entry_id": "7f5b6584-faee-37d2-addc-7e60809c0219",
                                        "glosses": [
                                            "A place where many divergent things (often races or cultures, but also talents) come together and are homogenized."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bc403d59-c9f7-4ee3-a856-8b6c8fc0f672",
                                                "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                                "text": "The festival is a true racial melting pot; people from dozens of countries take part speaking many languages."
                                            },
                                            {
                                                "example_id": "bcf365a4-c46b-4fbe-a26d-df6d844509c8",
                                                "sense_id": "8c2c750a-1d2e-3e07-a0ce-e0d8c9f49bbd",
                                                "text": "Three-quarters of a century ago this edifice, garishly handsome in the city’s brashest manner, had been dedicated, on the cornerstone, “to Pythianism”, without any embarrassment at the clash of Greek and Mesopotamian metaphors. Such plundering and jumbling of the storehouse of yesterday’s empires, this melting pot or métissage of past power, was the true indicator of present might."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e70eecab-6db8-432b-8022-e7e13f8c2530",
                        "source_entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
                        "source_sense_id": "30729ea2-e574-3563-8a79-a7e052da39a6",
                        "source_sense_description": "Gefäß zum Schmelzen von Metallen oder anderen Stoffen",
                        "target_lang_word": "creuset",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "creuset",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                        "entry_id": "22617536-d0e5-303d-8320-80716dab6d2c",
                                        "glosses": [
                                            "Récipient de terre réfractaire ou de métal, qui sert à faire fondre certaines substances, et principalement les métaux."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "12efefad-07b2-489e-b293-4271082cc32a",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "Il était chauffé dans un creuset en porcelaine émaillée, au milieu d’une masse de fer porphyrisé qui le préservait de l’oxydation."
                                            },
                                            {
                                                "example_id": "27b3b4a2-8d97-4f1a-b460-fc31c7087ca6",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "Ces minerais ont encore un inconvénient grave : à cause de leur finesse, […], ils traversent les charges du haut-fourneau et arrivent jusqu'au creuset sans être réduits."
                                            },
                                            {
                                                "example_id": "cbf1f1f3-4350-481f-b040-76d9d0dbcf8f",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "On ne doit pas négliger de couvrir le creuset, sans cette précaution il s'y introduiroit du charbon qui gêneroit pour la coulée qui se fait dans une lingotière de fer forgé."
                                            },
                                            {
                                                "example_id": "8939d236-0250-463a-8a7c-609fd937f1b3",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "Le confinement de sa propre pensée à l’égard de l’en­viron­ne­ment sus-jacent, de sa bulle ambiante, permet de mieux ré­fléchir, de commu­niquer sub­li­mi­­na­lement avec l’extérieur, de ratiociner la my­ria­­de d’observations organolep­tiques acquises, de les distiller dans les cornues du laboratoire mental de la créativité et, enfin, de les faire fondre dans les creusets intellectuels mi­niaturés des haïkus."
                                            },
                                            {
                                                "example_id": "95bd3c35-a23e-4fad-8528-8b82bd78076e",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "Il y réussit en chauffant le métal avec du charbon en poudre dans un creuset fait en terre réfractaire."
                                            },
                                            {
                                                "example_id": "a20c5d2e-4d0a-476a-8ff3-19872a953ea4",
                                                "sense_id": "0118214c-651e-303d-b57a-f49903dfeb33",
                                                "text": "Il prit l’âme et la matière, les jeta dans un creuset, n’y trouva rien, et dès lors il devint Don Juan!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ce2d675e-8ba2-3cf0-82f1-f51abf2ff620",
                                        "entry_id": "22617536-d0e5-303d-8320-80716dab6d2c",
                                        "glosses": [
                                            "Source ; origine."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9990ac89-c65d-4381-a5ed-cd5179251927",
                                                "sense_id": "ce2d675e-8ba2-3cf0-82f1-f51abf2ff620",
                                                "text": "Le creuset de sa prise de conscience serait dans la détestation des élites : la caste, la supranationalité, Bruxelles, Berlin, la mondialisation, le parti médiatique, les bons sentiments, voire la « gôche », ce terme qui vient tout droit de l’extrême droite des années 1930."
                                            },
                                            {
                                                "example_id": "0037c8b6-d625-4d48-aaf8-09fd01631ce9",
                                                "sense_id": "ce2d675e-8ba2-3cf0-82f1-f51abf2ff620",
                                                "text": "Le français comme un creuset. Est-ce encore possible ? Le Canada peut-il l’accepter ? Le projet de loi 96 me semble en tout cas une expression forte du fameux plébiscite dont parlait Renan."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a929f959-8c81-467e-ac56-71046d3d487b",
                        "source_entry_id": "0b867984-eca9-34e4-a88b-bf7701e0b1b7",
