                                "example_id": "c6186a68-f4ff-4c2a-88ce-30194c007fd3",
                                "sense_id": "c6ec1c2c-2f75-3283-9d21-93c31b7c6449",
                                "text": "Le massage au Gua Sha est une technique de Tribo-effleurage"
                            },
                            {
