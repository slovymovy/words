                                "target_senses": [
                                    {
                                        "sense_id": "a135bd47-877a-3dc1-b87c-076580e242f9",
                                        "entry_id": "90921850-d6fa-3894-8b4d-cee65ad02525",
                                        "glosses": [
                                            "действие по значению гл. тренировать, тренироваться"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af632094-246d-4ad6-b4ca-6aa2a7dee322",
                                                "sense_id": "a135bd47-877a-3dc1-b87c-076580e242f9",
                                                "text": "В Англии находится много призовых скакунов, принадлежащих немцам и присланных сюда для тренировки."
                                            },
                                            {
                                                "example_id": "a4faa747-26e0-483c-b464-9d22ffb6cd1a",
                                                "sense_id": "a135bd47-877a-3dc1-b87c-076580e242f9",
                                                "text": "Конечно, при рациональной тренировке боли не должны быть, а если и будут, то значительную помощь в их устранении может оказать массаж."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "11fccb7f-cd2b-3315-aa71-0cad53439f31",
                                        "entry_id": "90921850-d6fa-3894-8b4d-cee65ad02525",
                                        "glosses": [
                                            "учебное занятие, упражнение в каком-либо навыке, умении"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "09890671-ffc5-4b5e-ad57-12ff1c484f65",
                                                "sense_id": "11fccb7f-cd2b-3315-aa71-0cad53439f31",
                                                "text": "Однажды я стоял в группе зевак, смотревших на тренировку команды школы, готовившейся к соревнованиям."
                                            }
                                        ]
                                    }
