                        "entry_id": "efe1ad6d-af22-3a18-8b24-00fe6b5ebbaa",
                        "glosses": [
                            "Any of various conditions affecting the brain."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
