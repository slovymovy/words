                    {
                        "sense_id": "eb105bc9-67e9-3db9-b189-faab91137dd4",
                        "entry_id": "fcce9c69-dff5-3482-92a7-cd4f8112ac40",
                        "glosses": [
                            "RFA, République fédérale d’Allemagne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37503cef-7f00-4abd-836a-6a4e4c38d5a2",
                                "sense_id": "eb105bc9-67e9-3db9-b189-faab91137dd4",
                                "text": "Ich wohne in der BRD. — J’habite en RFA."
                            },
                            {
                                "example_id": "2e94a417-c1fd-49e1-9453-7387d90f06dd",
                                "sense_id": "eb105bc9-67e9-3db9-b189-faab91137dd4",
                                "text": "Heidelore Rutz wurde in der DDR inhaftiert, weil sie für ihre Ausreise demonstrierte. Die BRD kaufte sie frei.",
                                "translation": "Heidelore Rutz a été emprisonnée en RDA parce qu'elle manifestait pour quitter le pays. La RFA l'a libérée."
                            }
                        ]
                    }
                ],
