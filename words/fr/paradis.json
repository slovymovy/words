            "senses": [
                {
                    "sense_id": "69059eda-ff22-3938-a9d6-cecdd97636ac",
                    "sense_definition": "Séjour des bienheureux et lieu de bonheur éternel après la mort selon diverses religions.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Beaucoup de croyants espèrent aller au <w>paradis</w> après leur mort."
                        },
                        {
                            "text": "Le prêtre rappelait souvent que le chemin du <w>paradis</w> demande de la vertu."
                        }
                    ],
                    "synonyms": [
                        "ciel"
                    ],
                    "antonyms": [
                        "enfer"
                    ],
                    "common_phrases": [
                        "aller au paradis",
                        "gagner son paradis"
                    ]
                },
                {
                    "sense_id": "f0b5e612-42b4-35bf-a5ac-32cad218bda1",
                    "sense_definition": "Lieu enchanteur, agréable et particulièrement propice au bien-être.",
