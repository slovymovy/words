                    "sense_definition": "Attente vigilante et attentive en vue d'observer ou de saisir une occasion.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les investisseurs restent constamment à l'<w>affût</w> de nouvelles opportunités sur le marché."
                        },
                        {
                            "text": "Le journaliste était à l'<w>affût</w> de la moindre information concernant ce scandale politique."
                        }
                    ],
                    "synonyms": [
