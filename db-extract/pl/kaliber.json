                    {
                        "sense_id": "fecf58a7-8af9-3546-bc43-2911691ba3ae",
                        "entry_id": "ad426da6-655b-35cc-af35-b9b2d48588e5",
                        "glosses": [
                            "znaczenie, waga, istotność"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a122233-a18b-4739-8eaf-132f6e035130",
                                "sense_id": "fecf58a7-8af9-3546-bc43-2911691ba3ae",
                                "text": "To jest sprawa wielkiego kalibru!"
                            }
                        ],
                        "sense_index_json": "\"1.3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "244a484f-d738-46fa-af0e-8ae035a62ede",
                        "source_entry_id": "ad426da6-655b-35cc-af35-b9b2d48588e5",
                        "source_sense_id": "e6f420c5-025b-31e3-b8bf-6d435b418eaa",
                        "target_lang_word": "Kaliber",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kaliber",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "03f9d820-072e-3972-aa8d-31b9b35f3db1",
                                        "entry_id": "3115afac-e9cc-34d3-b89b-56f3244e4601",
                                        "glosses": [
                                            "Innendurchmesser des Laufes einer Feuerwaffe beziehungsweise Durchmesser eines Projektils"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ead5bb1f-914f-4003-87cb-285ee44e3571",
                                                "sense_id": "03f9d820-072e-3972-aa8d-31b9b35f3db1",
                                                "text": "Die Tatwaffe hatte Kaliber 9."
                                            },
                                            {
                                                "example_id": "5ff1602c-75a5-43a1-8174-6607ef44db2f",
                                                "sense_id": "03f9d820-072e-3972-aa8d-31b9b35f3db1",
                                                "text": "„Das Geschütz wurde im Jahr 1411 in Braunschweig gegossen, wog gut 8000 Kilo und soll durch ein knapp drei Meter langes Rohr mit einem Kaliber von 76 Zentimetern schwere Steinkugeln verschossen haben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "001c34b7-30a2-3ec5-b3cb-8198755676c1",
                                        "entry_id": "3115afac-e9cc-34d3-b89b-56f3244e4601",
                                        "glosses": [
                                            "Wesensart, Format"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f8215709-0809-4ff4-9d5d-d2ed50f3690d",
                                                "sense_id": "001c34b7-30a2-3ec5-b3cb-8198755676c1",
                                                "text": "Ihr neuer Freund war von einem ganz anderen Kaliber als sein Vorgänger."
                                            },
                                            {
                                                "example_id": "484b5c87-d3f8-4aa6-9787-94a399030ae8",
                                                "sense_id": "001c34b7-30a2-3ec5-b3cb-8198755676c1",
                                                "text": "„Ein goldenes Armband am linken Handgelenk ließ Lucien das finanzielle Kaliber seines Gesprächspartners ahnen.“"
                                            },
                                            {
                                                "example_id": "6dfdbe2c-0567-45ae-bfa4-e3738ccca4bf",
                                                "sense_id": "001c34b7-30a2-3ec5-b3cb-8198755676c1",
                                                "text": "„Zugegeben, es ist ein bisschen eng, wenn wir beide drin sind, Ruby ist ein ganz schönes Kaliber, aber ich hab da schon viel Spaß beim Planschen gehabt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "bc27d847-567e-3420-9f52-78e4eed9bf2d",
                                        "entry_id": "3115afac-e9cc-34d3-b89b-56f3244e4601",
                                        "glosses": [
                                            "Baureihe eines mechanischen Uhrwerkes mit dazugehörigem Herstellercode"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2e424632-864b-4efb-892f-a3620b6acca7",
                                                "sense_id": "bc27d847-567e-3420-9f52-78e4eed9bf2d",
                                                "text": "„Darüber hinaus ist die ursprüngliche Fliegeruhr mit einem Uhrwerk Kaliber 83 und einer Drehlünette mit Merkpfeil ausgestattet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46e06dcf-e799-488e-b7a8-1bf203e356c6",
                        "source_entry_id": "ad426da6-655b-35cc-af35-b9b2d48588e5",
                        "source_sense_id": "e6f420c5-025b-31e3-b8bf-6d435b418eaa",
                        "target_lang_word": "калибр",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "калибр",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "d1467648-1257-3ea4-a896-1f86bc26f67f",
                                        "entry_id": "2807836c-5633-3887-8b6c-f8cd8a692eac",
                                        "glosses": [
                                            "воен. диаметр канала ствола огнестрельного оружия; размер боеприпаса к нему (снаряда, пули)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8825f31-4d5d-49da-aada-6d62586498f5",
                                                "sense_id": "d1467648-1257-3ea4-a896-1f86bc26f67f",
                                                "text": "Артиллерия состояла из 60 пушек разного калибра .."
                                            },
                                            {
                                                "example_id": "2d9375dc-d3c4-409e-aae1-817f67ac93a3",
                                                "sense_id": "d1467648-1257-3ea4-a896-1f86bc26f67f",
                                                "text": ".. только теми пулями можно бить верно, которые совершенно приходятся по калибру ружья."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "71f67657-e4d4-3c7f-8d22-422826bb4b46",
                                        "entry_id": "2807836c-5633-3887-8b6c-f8cd8a692eac",
                                        "glosses": [
                                            "техн. бесшкальный мерительный инструмент, предназначенный для контроля размеров, формы и взаимного расположения поверхностей детали"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ce79b9db-91f6-367a-a233-439601273381",
                                        "entry_id": "2807836c-5633-3887-8b6c-f8cd8a692eac",
                                        "glosses": [
                                            "перен., разг. то же, что величина, масштаб"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39f0805a-ef91-458a-b585-1639ba9ad49e",
                                                "sense_id": "ce79b9db-91f6-367a-a233-439601273381",
                                                "text": "Художник, тем более твоего калибра, вообще живёт в виртуальном измерении, так мне кажется."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
