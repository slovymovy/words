                    "frequency": "VeryLow",
                    "semantic_group_id": "geography",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "He grew up in the small village of <w>Forth</w> before moving to the city for work.",
                            "target_lang_translations": {
                                "ru": "Он вырос в небольшой деревне <w>Форт</w>, прежде чем переехать в город на работу."
                            }
