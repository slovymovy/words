                    }
                ],
                "translations": [
                    {
                        "translation_id": "3abb247a-29cd-46a2-b882-71ffaa92544c",
                        "source_entry_id": "89d6a43d-deca-319a-bdb1-721f1f7b2f1d",
                        "source_sense_id": "d08a6556-c0fe-3be0-b5c0-d2dfaf0bdddd",
                        "target_lang_word": "unbeliever",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unbeliever",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a7d2a3b0-dfd2-3589-8fc7-9239fb4db8e2",
                                        "entry_id": "378821ae-5d5a-39e7-ad20-fc932c4079d1",
                                        "glosses": [
                                            "One who does not believe, particularly in a deity (used by believers to describe people who do not believe in the same deity or deities as themselves)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "37027056-a87d-4b07-8407-7a731dd2009a",
                                                "sense_id": "a7d2a3b0-dfd2-3589-8fc7-9239fb4db8e2",
                                                "text": "`Well, I suppose that we must try it,' I said; and the others assented in their various ways - Leo, as though it were the best joke in the world; Job, in respectful disgust; and Mahomed, with an invocation to the Prophet, and a comprehensive curse upon all unbelievers and their ways of thought and travel."
                                            },
                                            {
                                                "example_id": "5c8f604c-b154-4e85-87a8-3ed0cf2b6563",
                                                "sense_id": "a7d2a3b0-dfd2-3589-8fc7-9239fb4db8e2",
                                                "text": "I tried to persuade some of the men to come and save you, but they would not do it, saying: ‘Let the unbelievers kill one another if they wish. It is none of our affair, and if we go and interfere with Ali-ben-Ahmed’s plans we shall only stir up a fight with our own people.’"
                                            },
                                            {
                                                "example_id": "ea010b12-982b-4426-97b3-e05f97609c52",
                                                "sense_id": "a7d2a3b0-dfd2-3589-8fc7-9239fb4db8e2",
                                                "text": "One of the emcees, going for a cheap laugh had said \"classical musicians, we all know what they're like,\" and I heard several voices from the audience reply, \"Oh yeah, what are they like?\" But the classical concert certainly convinced the unbelievers."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b8cc87a8-7490-4878-bc13-d813be57cb4d",
                        "source_entry_id": "89d6a43d-deca-319a-bdb1-721f1f7b2f1d",
                        "source_sense_id": "d08a6556-c0fe-3be0-b5c0-d2dfaf0bdddd",
