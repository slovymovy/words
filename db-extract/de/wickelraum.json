                ],
                "senses": [
                    {
                        "sense_id": "eb097b0c-1058-3b99-bdd1-74efceba21c2",
                        "entry_id": "de9c01cc-5d0f-35ee-ab03-c4cb39608831",
                        "glosses": [
                            "babies’ changing room, baby change (a room in public buildings and in some means of public transport such as passenger trains in which parents can change their infant’s diaper/nappy)"
                        ],
                        "tags": [
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "080834b1-e04e-4d55-9181-4bce1e46aaef",
                                "sense_id": "eb097b0c-1058-3b99-bdd1-74efceba21c2",
                                "text": "Am anstrengendsten sind Flugreisen für Eltern mit Kleinkindern. Auf zahlreichen Flughäfen suchen sie vergeblich nach einem Wickelraum.",
                                "translation": "Air travel is the most demanding for parents with small children. They search in vain for a babies’ changing room at numerous airports.",
                                "english": "Air travel is the most demanding for parents with small children. They search in vain for a babies’ changing room at numerous airports."
                            },
                            {
                                "example_id": "eb8e3fb3-af9a-4f42-9ec2-e7c93e6c794d",
                                "sense_id": "eb097b0c-1058-3b99-bdd1-74efceba21c2",
                                "text": "Die meisten Autobahnraststätten verfügen darüber hinaus über Kinderspielplätze und Wickelräume.",
                                "translation": "Most rest and service areas also have children’s playgrounds and babies’ changing rooms.",
                                "english": "Most rest and service areas also have children’s playgrounds and babies’ changing rooms."
                            },
                            {
                                "example_id": "7ae87a2a-32f0-420d-82c4-53f0094cdcd5",
                                "sense_id": "eb097b0c-1058-3b99-bdd1-74efceba21c2",
                                "text": "Ende 2015 eröffnete der neue Ruhr Park. Nun gibt es dort beispielsweise […] kostenloses WLAN, Ladestationen für Smartphones, für die Besucher mit Kindern gibt es Baby-Lounges mit Still- und Wickelräumen, Eltern-Kind-Toiletten, einen Kinderspielplatz, Ruhezonen sowie ausgewiesene XXL-Parkplätze für die Kunden mit SUVs.",
                                "translation": "The new Ruhr Park opened at the end of 2015. Now there are, for example, […] free WiFi, charging stations for smartphones, for visitors with children there are baby lounges with nursing and changing rooms, parent-child toilets, a children’s playground, relaxation areas and designated XXL parking spaces for customers with SUVs.",
                                "english": "The new Ruhr Park opened at the end of 2015. Now there are, for example, […] free WiFi, charging stations for smartphones, for visitors with children there are baby lounges with nursing and changing rooms, parent-child toilets, a children’s playground, relaxation areas and designated XXL parking spaces for customers with SUVs."
                            }
                        ]
                    }
