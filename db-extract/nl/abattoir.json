                                "target_senses": [
                                    {
                                        "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Bâtiment où l’on tue les bestiaux pour les boucheries."
                                        ],
                                        "tags": [
                                            "Élevage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3b3d4fd-2630-491d-9562-049cfdd06ace",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Après l’abattage d’urgence, le cadavre dépouillé, éviscéré en en quartiers pourra être transporté à l’abattoir pour y être inspecté à condition qu’il soit accompagné de la totalité des viscères."
                                            },
                                            {
                                                "example_id": "333416b9-0495-4987-bfc1-6f56345835fc",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Dans son autobiographie, Henry Ford révèle que sa chaîne d’assemblage a été pensée et créée sur le modèle des abattoirs de Chicago dont l’efficacité lui faisait forte impression."
                                            },
                                            {
                                                "example_id": "fc7b1a91-23aa-4dc3-8b4d-f61e5724061f",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Chaque semaine, l’Ontario produit 125 000 porcs de boucherie, dont près de 25 000, ou 20 % sont envoyés dans les abattoirs du Québec, selon des chiffres du ministère de l’Agriculture de l’Ontario obtenus par Le Journal."
                                            },
                                            {
                                                "example_id": "beeeafdb-0585-4886-8b20-2da90624ccb8",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Cet abattoir est vaste, bien aéré."
                                            },
                                            {
                                                "example_id": "ab7c7afb-6e34-41ef-8b5d-dbfd27a6870a",
                                                "sense_id": "dbcf2191-ca6d-3e6f-b89b-357c0ac4ec89",
                                                "text": "Les abattoirs de Paris."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9f5d32ae-b665-3598-9d7f-bde6cec13f9f",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
                                            "Guillotine."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "81e32388-e3b5-3f65-bd38-ae99ce4bdd8b",
                                        "entry_id": "aff281fa-fe5d-3066-9c65-27b71141a4c1",
                                        "glosses": [
