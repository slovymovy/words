                "senses": [
                    {
                        "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                        "entry_id": "52df202c-1959-307c-b1a7-cd13f065f007",
                        "glosses": [
                            "The Pleistocene epoch."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e91b8b68-8d55-48cf-a2f5-88293c60ce77",
                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                "text": "A prehistoric site of late Pleistocene age, which was especially prepared for our visit, was seen at Ting-ts'un, above the Fen River (Shansi)."
                            },
                            {
                                "example_id": "3cf5beac-bbeb-41b1-9920-caae0799d442",
                                "sense_id": "b4398536-6ffc-3431-a1c6-830cbe3bf487",
                                "text": "Throughout the Pleistocene, climatic changes exerted another type of selective pressure on human biological evolution, contributing to the rapid emergence of various Homo species over time."
                            }
                        ]
                    }
                ],
