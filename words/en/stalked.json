    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "32b762f7-184e-3622-ba84-845a5f2efc53",
                    "sense_definition": "Simple past tense and past participle of <w>stalk</w>.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The lion silently <w>stalked</w> its prey through the tall grass of the savanna.",
                            "target_lang_translations": {
                                "ru": "Лев бесшумно <w>выслеживал</w> свою добычу в высокой траве саванны."
                            }
                        },
                        {
                            "text": "She felt extremely unsafe after she realized that a stranger had <w>stalked</w> her online for weeks.",
                            "target_lang_translations": {
                                "ru": "Она почувствовала себя в крайней опасности, когда поняла, что незнакомец неделями <w>преследовал</w> её в интернете."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола stalk (выслеживать, преследовать)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выслеживал",
                                "target_lang_sense_clarification": "охотился, тихо подкрадывался"
                            },
                            {
                                "target_lang_word": "преследовал",
                                "target_lang_sense_clarification": "навязчиво следил, в том числе в интернете"
                            }
                        ]
                    }
                }
            ]
        },
        {
