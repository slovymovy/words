{
    "word_family": [
        "masker",
        "masking",
        "unmask",
        "masquerade",
        "bitmask",
        "eyemask",
        "facemask"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e25f63a7-c45c-31d6-955d-afca983d6ace",
                    "sense_definition": "A cover, or partial cover, for the face, used for disguise or protection.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "face_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor wore a protective <w>mask</w> over her nose and mouth during the surgery.",
                            "target_lang_translations": {
                                "ru": "Во время операции врач носила защитную <w>маску</w> на носу и рту."
                            }
                        },
                        {
                            "text": "He decided to wear a scary <w>mask</w> for the Halloween party to hide his identity.",
                            "target_lang_translations": {
                                "ru": "Он решил надеть страшную <w>маску</w> на вечеринку в честь Хэллоуина, чтобы скрыть свою личность."
                            }
                        }
                    ],
                    "synonyms": [
                        "vizard"
                    ],
                    "common_phrases": [
                        "wear a mask",
                        "protective mask",
                        "surgical mask",
                        "face mask"
                    ],
                    "target_lang_definitions": {
                        "ru": "Накладка на лицо или его часть, используемая для маскировки или защиты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "защитная или карнавальная"
                            },
                            {
                                "target_lang_word": "личина",
                                "target_lang_sense_clarification": "устаревшее или обрядовое"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a94b0fef-e533-35dc-8961-988c4350ec18",
                    "sense_definition": "Something that disguises or hides one's true feelings, character, or intentions; a pretext.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disguise",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His constant joking was just a <w>mask</w> for his deep sadness after the loss.",
                            "target_lang_translations": {
                                "ru": "Его постоянные шутки были лишь <w>маской</w>, скрывающей глубокую печаль после утраты."
                            }
                        },
                        {
                            "text": "She maintained a <w>mask</w> of indifference even though she was very angry inside.",
                            "target_lang_translations": {
                                "ru": "Она сохраняла <w>маску</w> безразличия, хотя внутри была очень зла."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mask of indifference",
                        "mask of sanity",
                        "drop the mask"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что скрывает истинные чувства, характер или намерения человека; предлог."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "притворный вид"
                            },
                            {
                                "target_lang_word": "личина",
                                "target_lang_sense_clarification": "скрывающая истинную сущность"
                            },
                            {
                                "target_lang_word": "прикрытие",
                                "target_lang_sense_clarification": "предлог"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a84cb6db-7542-35b0-a850-f1057ce9eda0",
                    "sense_definition": "A flat covering used to block off an unwanted portion of a scene or image in photography or editing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The photographer used a <w>mask</w> to protect the background while adjusting the subject's lighting.",
                            "target_lang_translations": {
                                "ru": "Фотограф использовал <w>маску</w>, чтобы защитить фон во время настройки освещения объекта."
                            }
                        },
                        {
                            "text": "Apply a layer <w>mask</w> to hide the parts of the image you do not want to see.",
                            "target_lang_translations": {
                                "ru": "Примените <w>слой-маску</w>, чтобы скрыть те части изображения, которые вы не хотите видеть."
                            }
                        }
                    ],
                    "common_phrases": [
                        "layer mask",
                        "digital mask"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Плоское покрытие, используемое для блокировки нежелательной части сцены или изображения в фотографии или редактировании."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "в графических редакторах"
                            },
                            {
                                "target_lang_word": "слой-маска",
                                "target_lang_sense_clarification": "в фотошопе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6558c023-494e-334a-87af-531b94c95113",
                    "sense_definition": "A pattern of bits used in bitwise operations to select or modify specific bits in a value.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The software applies a bitwise <w>mask</w> to extract the network portion of the IP address.",
                            "target_lang_translations": {
                                "ru": "Программное обеспечение применяет побитовую <w>маску</w> для извлечения сетевой части IP-адреса."
                            }
                        },
                        {
                            "text": "You can use a subnet <w>mask</w> to divide a large network into smaller segments.",
                            "target_lang_translations": {
                                "ru": "Вы можете использовать <w>маску</w> подсети, чтобы разделить большую сеть на более мелкие сегменты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "subnet mask",
                        "bit mask",
                        "network mask"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Шаблон битов, используемый в побитовых операциях для выбора или изменения определенных битов в значении."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "битовая маска",
                                "target_lang_sense_clarification": "для побитовых операций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a663d782-0537-375c-a7a8-7a459965c43a",
                    "sense_definition": "A decorative grotesque head or face used in architecture, often to adorn fountains or keystones.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "architecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient fountain was decorated with a stone <w>mask</w> that spouted water into the basin.",
                            "target_lang_translations": {
                                "ru": "Древний фонтан был украшен каменным <w>маскароном</w>, из которого вода изливалась в чашу."
                            }
                        },
                        {
                            "text": "Each keystone in the archway featured a unique <w>mask</w> carved by a master mason.",
                            "target_lang_translations": {
                                "ru": "На каждом замковом камне арки была уникальная <w>маска</w>, вырезанная мастером-каменщиком."
                            }
                        }
                    ],
                    "synonyms": [
                        "mascaron"
                    ],
                    "common_phrases": [
                        "decorative mask",
                        "stone mask"
                    ],
                    "target_lang_definitions": {
                        "ru": "Декоративное изображение головы или лица в архитектуре, часто украшающее фонтаны или замковые камни."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскарон",
                                "target_lang_sense_clarification": "архитектурное украшение"
                            },
                            {
                                "target_lang_word": "маска",
                                "target_lang_sense_clarification": "декоративная"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1655255a-fd81-3b10-9937-c397c0cd36ee",
                    "sense_definition": "To conceal from view or knowledge; to cover or hide something so it cannot be noticed.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "concealment",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The tall trees were planted to <w>mask</w> the ugly factory from the main road.",
                            "target_lang_translations": {
                                "ru": "Высокие деревья были посажены, чтобы <w>скрыть</w> уродливый завод от главной дороги."
                            }
                        },
                        {
                            "text": "He used strong perfume to <w>mask</w> the smell of smoke on his clothes.",
                            "target_lang_translations": {
                                "ru": "Он использовал сильный парфюм, чтобы <w>заглушить</w> запах дыма на своей одежде."
                            }
                        }
                    ],
                    "antonyms": [
                        "reveal",
                        "uncover"
                    ],
                    "common_phrases": [
                        "mask the smell",
                        "mask the sound",
                        "mask the truth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Скрывать от глаз или знаний; покрывать или прятать что-либо, чтобы оно не было замечено."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "скрывать внешний вид"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "делать незаметным"
                            },
                            {
                                "target_lang_word": "заглушать",
                                "target_lang_sense_clarification": "о запахе или звуке"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b39dd39e-d7a7-3910-a343-09a1184f2c3e",
                    "sense_definition": "To cover the face with a mask for protection or to hide one's identity.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_covering",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers were ordered to <w>mask</w> themselves before entering the smoke-filled building.",
                            "target_lang_translations": {
                                "ru": "Солдатам приказали <w>надеть маски</w> перед входом в задымленное здание."
                            }
                        },
                        {
                            "text": "All guests must <w>mask</w> their faces before entering the grand ballroom for the masquerade.",
                            "target_lang_translations": {
                                "ru": "Все гости должны <w>скрыть</w> свои лица под масками перед входом в большой бальный зал на маскарад."
                            }
                        }
                    ],
                    "antonyms": [
                        "unmask"
                    ],
                    "common_phrases": [
                        "mask up"
                    ],
                    "target_lang_definitions": {
                        "ru": "Закрывать лицо маской для защиты или чтобы скрыть свою личность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "надевать маску",
                                "target_lang_sense_clarification": "на лицо"
                            },
                            {
                                "target_lang_word": "маскироваться",
                                "target_lang_sense_clarification": "скрывать лицо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f29eaade-363d-33b1-ae03-e25f1afb2634",
                    "sense_definition": "To suppress or hide autistic traits or other neurodivergent behaviors to appear neurotypical in social situations.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "psychology",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many individuals <w>mask</w> their symptoms for years, which can lead to extreme mental exhaustion.",
                            "target_lang_translations": {
                                "ru": "Многие люди годами <w>маскируют</w> свои симптомы, что может привести к крайнему ментальному истощению."
                            }
                        },
                        {
                            "text": "She felt she had to <w>mask</w> her true self at work to fit in with her colleagues.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что на работе ей приходится <w>скрывать</w> свое истинное «я», чтобы вписаться в коллектив."
                            }
                        }
                    ],
                    "common_phrases": [
                        "social masking",
                        "masking symptoms"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "psychological"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подавлять или скрывать аутичные черты или другие особенности поведения, чтобы казаться нейротипичным в обществе."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "симптомы или черты"
                            },
                            {
                                "target_lang_word": "скрывать",
                                "target_lang_sense_clarification": "особенности поведения"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8b76e9df-da4c-3ad3-bad2-fe86cb01bf8a",
                    "sense_definition": "To disable or ignore a signal, such as a hardware interrupt, by setting a specific bit in a register.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "computing_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer decided to <w>mask</w> the interrupt to prevent the process from being disturbed.",
                            "target_lang_translations": {
                                "ru": "Программист решил <w>замаскировать</w> прерывание, чтобы предотвратить нарушение процесса."
                            }
                        },
                        {
                            "text": "You must <w>mask</w> certain bits to ensure the correct data is processed by the CPU.",
                            "target_lang_translations": {
                                "ru": "Вы должны <w>наложить маску</w> на определенные биты, чтобы обеспечить правильную обработку данных процессором."
                            }
                        }
                    ],
                    "common_phrases": [
                        "mask an interrupt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Отключать или игнорировать сигнал, например аппаратное прерывание, путем установки определенного бита в регистре."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маскировать",
                                "target_lang_sense_clarification": "прерывание в технике"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}