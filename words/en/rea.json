                    "frequency": "VeryLow",
                    "semantic_group_id": "currency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The document mentioned a payment of several <w>reas</w> from the old Portuguese system.",
                            "target_lang_translations": {
                                "ru": "В документе упоминалась выплата нескольких <w>реев</w> по старой португальской системе."
                            }
                        },
                        {
                            "text": "Historical accounts often spell the currency as <w>rea</w> instead of rei.",
                            "target_lang_translations": {
                                "ru": "В исторических отчетах валюта часто пишется как <w>rea</w> вместо rei."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical currency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вариант написания португальской монеты «рей»."
