                                        "glosses": [
                                            "Nom donné à certaines mangoustes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "mangue",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "32b2f211-fb9b-32d8-b53c-0e54755cea25",
                                        "entry_id": "de6e1120-8dc2-317e-82a9-80c562d576c5",
                                        "glosses": [
                                            "Langue éteinte qui était parlée par des peuples indigènes du Honduras, du Costa Rica et du Nicaragua."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46eaa593-d847-4c4a-8ff1-838d9f1acebf",
                                                "sense_id": "32b2f211-fb9b-32d8-b53c-0e54755cea25",
                                                "text": "Le subtiaba et le mangue, deux langues de cette famille, autrefois parlées au Nicaragua et au Costa Rica, sont éteintes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2e49213e-78e3-4685-b0d6-f23dd52ac98a",
                        "source_entry_id": "bc17774e-4fcd-34b4-8ae6-6cd3ab92f54d",
                        "source_sense_id": "04955d00-7277-3cdb-99ad-15c719eb410b",
