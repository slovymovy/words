                "senses": [
                    {
                        "sense_id": "bf60853e-5e37-3ea8-bbbd-36ca1d3d4021",
                        "entry_id": "6db5b3d4-b7ad-3e8e-bc89-12dc4da7bcdb",
                        "glosses": [
                            "durch einen aufgehängten Buschen aus Zweigen und manchmal einem bunten Licht z.B. über der Eingangstüre gekennzeichnete Wirtschaft, die selbst produzierten (heurigen) Wein ausschenkt und meistens kalte Imbisse anbietet"
                        ],
                        "tags": [
                            "österreichisch - meist in der Steiermark und dem Burgenland"
                        ],
                        "examples": [
                            {
                                "example_id": "e3e3e823-0a8a-46fb-b2e0-9304255b2492",
                                "sense_id": "bf60853e-5e37-3ea8-bbbd-36ca1d3d4021",
                                "text": "Die Feier fand in der Buschenschenke statt."
                            },
                            {
                                "example_id": "6cbc792b-541e-4a90-a042-c73ccc4f3461",
                                "sense_id": "bf60853e-5e37-3ea8-bbbd-36ca1d3d4021",
                                "text": "In einer Buschenschenke wird der Ausschank durch die Anbringung eines „Buschen“, eines Kiefern- oder Fichtenzweiges, angezeigt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
