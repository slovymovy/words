{
    "word_family": [
        "extincteur",
        "extinction",
        "éteignoir"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "8a2b97da-f1c3-3c9c-9ec5-906c0c302623",
                    "sense_definition": "Interrompre le fonctionnement d'un appareil électrique ou couper une source de lumière.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "dispositif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pense à <w>éteindre</w> la lumière avant de quitter la chambre."
                        },
                        {
                            "text": "Il <w>éteint</w> toujours son téléphone portable pendant les réunions importantes."
                        }
                    ],
                    "antonyms": [
                        "allumer"
                    ],
                    "common_phrases": [
                        "éteindre la lumière",
                        "éteindre la télévision",
                        "éteindre son téléphone"
                    ]
                },
                {
                    "sense_id": "401a24c2-ca72-3c0f-b3ac-130245de1e24",
                    "sense_definition": "Faire cesser la combustion d'un feu ou d'une flamme.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "feu",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les pompiers sont intervenus sans attendre pour <w>éteindre</w> l'incendie de forêt."
                        },
                        {
                            "text": "L'enfant souffle sur le gâteau pour <w>éteindre</w> les bougies d'anniversaire."
                        }
                    ],
                    "antonyms": [
                        "allumer"
                    ],
                    "common_phrases": [
                        "éteindre un incendie",
                        "éteindre le feu",
                        "éteindre une bougie"
                    ]
                },
                {
                    "sense_id": "7f15ad92-7c57-31c6-89b5-56567a2a829a",
                    "sense_definition": "Calmer, modérer ou faire cesser une émotion vive, un conflit ou une tension.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "apaiser",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ses paroles rassurantes ont permis d'<w>éteindre</w> la colère des riverains mécontents."
                        },
                        {
                            "text": "Une médiation rapide a suffi à <w>éteindre</w> la querelle entre les deux associés."
                        }
                    ],
                    "common_phrases": [
                        "éteindre une querelle",
                        "éteindre la colère",
                        "éteindre les passions"
                    ]
                },
                {
                    "sense_id": "e9ccde66-fa58-33e9-b6f6-99a0221c064c",
                    "sense_definition": "S'affaiblir progressivement jusqu'à disparaître complètement ou mourir en paix.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "fin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le vieil homme s'est <w>éteint</w> paisiblement chez lui au milieu des siens."
                        },
                        {
                            "text": "Au fil des semaines, l'enthousiasme général a fini par s'<w>éteindre</w> peu à peu."
                        }
                    ],
                    "common_phrases": [
                        "s'éteindre paisiblement",
                        "s'éteindre à petit feu"
                    ]
                },
                {
                    "sense_id": "18d030bf-c191-3af7-a60d-7061a5e30de1",
                    "sense_definition": "Faire cesser ou solder de manière définitive une dette, un droit ou une obligation légale.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce remboursement anticipé permet enfin d'<w>éteindre</w> la dette contractée l'an passé."
                        },
                        {
                            "text": "La prescription a <w>éteint</w> le droit du créancier d'agir en justice."
                        }
                    ],
                    "common_phrases": [
                        "éteindre une dette",
                        "éteindre une obligation"
                    ]
                },
                {
                    "sense_id": "f606fcfe-043b-3f52-ba29-7495f3ce58d5",
                    "sense_definition": "Atténuer la vivacité, l'éclat ou l'intensité de quelque chose, comme une couleur ou un son.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "attenuer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'artiste peintre a cherché à <w>éteindre</w> les couleurs vives de l'arrière-plan."
                        },
                        {
                            "text": "La fatigue et les épreuves prolongées semblaient avoir <w>éteint</w> l'éclat de son regard."
                        }
                    ],
                    "common_phrases": [
                        "éteindre les couleurs",
                        "éteindre l'éclat"
                    ]
                },
                {
                    "sense_id": "850f60fc-92d9-3240-ad90-243f2361df79",
                    "sense_definition": "Arriver à son terme définitif par manque d'héritiers ou de successeurs directs.",
                    "learner_level": "C1",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fin",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette ancienne lignée de marchands s'est <w>éteinte</w> à la fin du siècle dernier."
                        },
                        {
                            "text": "Le titre de duc s'est <w>éteint</w> lors du décès sans postérité de son dernier porteur."
                        }
                    ],
                    "common_phrases": [
                        "s'éteindre sans postérité"
                    ]
                }
            ]
        }
    ]
}