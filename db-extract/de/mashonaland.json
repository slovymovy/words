                "senses": [
                    {
                        "sense_id": "a760c50c-b038-38a9-81b1-1a829fe7e85f",
                        "entry_id": "c84304ca-a761-35c4-90f8-5714b3f76f37",
                        "glosses": [
                            "geographische Region in Simbabwe, welche das Hauptsiedlungsgebiet der Shona darstellt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b992486-aa15-4564-b5f1-7034d915af29",
                                "sense_id": "a760c50c-b038-38a9-81b1-1a829fe7e85f",
                                "text": "„Bei seiner Ankunft in Salisbury wurde er als Volksheld gefeiert und begann unverzüglich seinen Wahlkampf, in dessen Verlauf es immer wieder zur Behinderung anderer Parteien und zu Einschüchterungen in den ländlichen Regionen von Mashonaland kam.“"
                            },
                            {
                                "example_id": "be65e871-c02c-42e8-b828-fb5e9d5231d9",
                                "sense_id": "a760c50c-b038-38a9-81b1-1a829fe7e85f",
                                "text": "„Die Bergwerke König Salomos sollten irgendwo in dieser Region zu finden sein, angeblich im nordöstlichen Teil, der als Mashonaland bekannt war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
