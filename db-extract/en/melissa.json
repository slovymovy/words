                    {
                        "sense_id": "daec08bd-92af-319c-bac2-8b9f8f179bb1",
                        "entry_id": "a7f35600-549e-38b6-9584-9f098ba23cfa",
                        "glosses": [
                            "A female given name from Ancient Greek, popular in the latter half of the 20th century."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "89ea7538-bd7e-4ad6-834a-d72d15c8c0fa",
                                "sense_id": "daec08bd-92af-319c-bac2-8b9f8f179bb1",
                                "text": "And her owne handmayd, that Melissa hight / Appointed to attend her dewly day and night"
                            },
                            {
                                "example_id": "052cd452-0ad7-4e18-bb76-e99b93e64237",
                                "sense_id": "daec08bd-92af-319c-bac2-8b9f8f179bb1",
                                "text": "Miss Melissa Wackles was the eldest daughter, Miss Sophy the next, and Miss Jane the youngest."
                            },
                            {
                                "example_id": "30b2e37d-2781-4329-b31b-8d2e487777b7",
                                "sense_id": "daec08bd-92af-319c-bac2-8b9f8f179bb1",
                                "text": "- - - by Mrs. Melissa Blaydon and Miss Ianthe Ambrose.\n\"Well, they may be sisters,\" said Nigel. \"Those elegant, classical Christian names suggest one father."
                            },
                            {
                                "example_id": "6e545a6c-2745-42d2-8660-7378b2722492",
                                "sense_id": "daec08bd-92af-319c-bac2-8b9f8f179bb1",
                                "text": "The first line of dialogue is from an off-screen Field Commander Melissa Lewis (Jessica Chastain), asking the team to stay in sight and “make NASA proud”."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
