                "senses": [
                    {
                        "sense_id": "e9f336df-c475-354d-b533-a855d9d6c306",
                        "entry_id": "c5ff63e9-967a-3b27-b10c-ec29864a125f",
                        "glosses": [
                            "Luft, die sich in der unmittelbaren Nachbarschaft befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4dc4dd42-60c7-46a9-bd33-66ffdee8b6f2",
                                "sense_id": "e9f336df-c475-354d-b533-a855d9d6c306",
                                "text": "„Die Umgebungsluft ist nicht keimfrei.“"
                            },
                            {
                                "example_id": "a03fd27f-4c7c-43f5-b885-511ac29695d8",
                                "sense_id": "e9f336df-c475-354d-b533-a855d9d6c306",
                                "text": "„Die Umgebungsluft ist Grundlage der menschlichen Atmung.“"
                            },
                            {
                                "example_id": "0b5b9f33-5f42-4ba2-b28b-a511722037a1",
                                "sense_id": "e9f336df-c475-354d-b533-a855d9d6c306",
                                "text": "„Auch die Qualität unserer Umgebungsluft zeigt mein Handy seit einigen Tagen an.“"
                            },
                            {
                                "example_id": "21f29253-906f-4db0-bd7f-9018ed50bd24",
                                "sense_id": "e9f336df-c475-354d-b533-a855d9d6c306",
                                "text": "„Bei der Luft-Luft-Wärmepumpe wird auch der Umgebungsluft Wärme entzogen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
