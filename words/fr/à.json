                {
                    "sense_id": "c57e36c7-c57b-3dbb-88dd-4d7a5aa0cf93",
                    "sense_definition": "Indique un ingrédient principal, un arôme ou un assaisonnement dans un plat.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "cuisine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Pour le dessert, les enfants préfèrent une glace <w>à</w> la vanille."
                        },
                        {
                            "text": "Ma grand-mère prépare une délicieuse tarte <w>à</w> la crème."
