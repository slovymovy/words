        "nl-extract.jsonl": [
            {
                "entry_id": "c52afe23-d250-3107-9c36-e3fa44e61439",
                "word": "aanfruiten",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "23aeb696-5af2-3bf5-8785-ee4e7fae4f86",
                        "entry_id": "c52afe23-d250-3107-9c36-e3fa44e61439",
                        "glosses": [
                            "korte tijd bakken zodat het voedsel (met name ui) net wat glazig wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb0fa098-7173-47fa-9f21-0f1188715beb",
                                "sense_id": "23aeb696-5af2-3bf5-8785-ee4e7fae4f86",
                                "text": "Dit is naar een recept van chef-kok Alex Zeelenberg. Fruit in kokosolie knoflook, sjalotten, 100 gram pinda’s, citroengras en laos. Rooster op laag vuur kurkumawortel, komijnpoeder, trassi, korianderzaad en kerriepoeder. Voeg alles samen en vijzel dit met de rode pepers tot een currypasta. Pasta aanfruiten in een koekenpan en afblussen met kokosmelk tot-ie indikt."
                            },
                            {
                                "example_id": "729cfc17-7375-40f1-9b1d-22baaee29e00",
                                "sense_id": "23aeb696-5af2-3bf5-8785-ee4e7fae4f86",
                                "text": "Daarom heeft hij alle recepten nauwkeurig nagelezen en gezorgd voor verduidelijking. ,,Aanfruiten van uien bijvoorbeeld. Het kan geen kwaad om uit te leggen dat dat niet om bakken gaat. Dan krijg je namelijk een heel andere smaak.\" Met de extra uitleg kan iedereen ze met gemak maken, verzekert de 46-jarige Paskal. ,,Maar Edwin zei wel: er moeten ook een paar van die gerechten in staan waar je wel je tanden in moet zetten. Daarvan staan er ook een stuk of vier in.”"
                            }
                        ]
                    }
                ],
