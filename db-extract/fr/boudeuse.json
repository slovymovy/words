                        "glosses": [
                            "Celle qui boude habituellement, fréquemment."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45d6e1f4-b435-4af6-bd98-4eda7bf97029",
                                "sense_id": "e8d98b82-c801-3629-9942-e7e46a54bb8c",
                                "text": "Et moi, comme une boudeuse, ou plutôt comme une peureuse, je ne peux pas me décider à aller lui dire : « Me voilà ! »"
                            }
                        ]
                    },
                    {
                        "sense_id": "a5639952-9ce8-3808-9cb8-4338d872599b",
                        "entry_id": "d922b922-5b2c-3745-b884-448f64750cc2",
                        "glosses": [
                            "Siège à deux places adossées et séparées par un dossier, par opposition avec la causeuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42f828cf-3b96-475c-828f-6041a8fef339",
                                "sense_id": "a5639952-9ce8-3808-9cb8-4338d872599b",
                                "text": "La boudeuse est constituée de deux fauteuils dos-à-dos séparés par un seul et même dossier. Deux personnes assises sur la boudeuse ne sauraient se parler se tournant le dos, d’où ce nom très imagé."
                            }
                        ]
                    }
