                                                "sense_id": "77178c3e-97fe-3f3e-bc10-d95a338c0642",
                                                "text": "Budgeting is even harder in times of recession"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "138ac45e-c0fe-333c-962a-411f70db7860",
