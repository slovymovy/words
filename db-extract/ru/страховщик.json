                        "source_sense_id": "51bc2564-4655-3cc8-a01a-8fe28d887b4d",
                        "target_lang_word": "insurer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "insurer",
