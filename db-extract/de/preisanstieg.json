                "senses": [
                    {
                        "sense_id": "e4703e3a-3694-360e-807d-a83b289456aa",
                        "entry_id": "030805b6-376f-3e66-a5ef-dfa5e0834652",
                        "glosses": [
                            "Anstieg eines Preises"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "94067a93-4007-4ea4-8141-7f8a09941686",
                                "sense_id": "e4703e3a-3694-360e-807d-a83b289456aa",
                                "text": "„Dieser scharfe Preisanstieg steigerte die Verunsicherung vieler Frauen, zu deren Aufgaben seinerzeit der Einkauf gehörte.“"
                            },
                            {
                                "example_id": "f7c5f24e-6422-4b27-8aa0-0cb026c533ad",
                                "sense_id": "e4703e3a-3694-360e-807d-a83b289456aa",
                                "text": "„Für Nutzer von Einzel- oder Streifenkarten würde der Preisanstieg beim Überfahren einer Tarifgrenze dadurch geringer, für Besitzer von Zeitkarten etwas teurer ausfallen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
