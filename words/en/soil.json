{
    "word_family": [
        "topsoil",
        "subsoil",
        "night soil"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a71e3956-2052-3fbf-b63d-62b20125e16a",
                    "sense_definition": "A mixture of mineral particles and organic material on the earth's surface, used to support plant growth.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "noun_earth_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gardeners often add compost to improve the quality of the <w>soil</w>.",
                            "target_lang_translations": {
                                "ru": "Садоводы часто добавляют компост, чтобы улучшить качество <w>почвы</w>.",
                                "zh": "园丁经常添加堆肥来改善<w>土壤</w>质量。"
                            }
                        },
                        {
                            "text": "The <w>soil</w> in this region is rich and perfect for growing vegetables.",
                            "target_lang_translations": {
                                "ru": "<w>Почва</w> в этом регионе плодородная и идеально подходит для выращивания овощей.",
                                "zh": "这个地区的<w>土壤</w>肥沃，非常适合种植蔬菜。"
                            }
                        }
                    ],
                    "synonyms": [
                        "earth",
                        "dirt",
                        "ground"
                    ],
                    "common_phrases": [
                        "fertile soil",
                        "potting soil",
                        "sandy soil",
                        "rich soil"
                    ],
                    "target_lang_definitions": {
                        "ru": "Верхний слой земной коры, смесь минеральных и органических веществ, пригодная для роста растений.",
                        "zh": "地球表面由矿物质颗粒和有机物质组成的混合物，用于支持植物生长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "почва",
                                "target_lang_sense_clarification": "наиболее точный сельскохозяйственный и научный термин"
                            },
                            {
                                "target_lang_word": "земля",
                                "target_lang_sense_clarification": "общеупотребительное слово"
                            },
                            {
                                "target_lang_word": "грунт",
                                "target_lang_sense_clarification": "в строительстве или садоводстве (субстрат)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "土壤",
                                "target_lang_sense_clarification": "最准确的农业和科学术语"
                            },
                            {
                                "target_lang_word": "土地",
                                "target_lang_sense_clarification": "通俗用语，指地表"
                            },
                            {
                                "target_lang_word": "泥土",
                                "target_lang_sense_clarification": "指地表的泥沙或尘土"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2ff0caf6-4cd4-3784-979c-77dd3b5bed44",
                    "sense_definition": "The territory or land belonging to a specific country or region.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "noun_territory_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of living abroad, she was relieved to finally stand on her native <w>soil</w>.",
                            "target_lang_translations": {
                                "ru": "После долгих лет жизни за границей она с облегчением наконец ступила на родную <w>землю</w>.",
                                "zh": "在国外生活多年后，她终于能站在故乡的<w>土地</w>上，感到如释重负。"
                            }
                        },
                        {
                            "text": "The soldiers were forbidden from entering foreign <w>soil</w> without official permission.",
                            "target_lang_translations": {
                                "ru": "Солдатам было запрещено вступать на чужую <w>землю</w> без официального разрешения.",
                                "zh": "士兵们被禁止在没有官方许可的情况下踏入外国<w>领土</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "native soil",
                        "foreign soil",
                        "on American soil"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "often used in literary or rhetorical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, принадлежащая определенной стране или региону.",
                        "zh": "属于特定国家或地区的领土或土地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земля",
                                "target_lang_sense_clarification": "поэтическое или риторическое обозначение территории (родная земля)"
                            },
                            {
                                "target_lang_word": "территория",
                                "target_lang_sense_clarification": "административный или географический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "土地",
                                "target_lang_sense_clarification": "常用于文学或修辞语境，如“故土”"
                            },
                            {
                                "target_lang_word": "领土",
                                "target_lang_sense_clarification": "行政或地理术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e62fe2a3-af56-3765-9f10-577a775672cf",
                    "sense_definition": "To make something dirty or stained, especially on the surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verb_dirty_1",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Try not to <w>soil</w> the clean carpet with your muddy shoes.",
                            "target_lang_translations": {
                                "ru": "Постарайся не <w>испачкать</w> чистый ковер грязной обувью.",
                                "zh": "尽量别用你那沾满泥的鞋子把干净的地毯<w>弄脏</w>。"
                            }
                        },
                        {
                            "text": "White shirts <w>soil</w> easily, so you must be careful when you eat.",
                            "target_lang_translations": {
                                "ru": "Белые рубашки легко <w>пачкаются</w>, поэтому нужно быть осторожным во время еды.",
                                "zh": "白衬衫很容易<w>弄脏</w>，所以吃饭时一定要小心。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dirty",
                        "smirch"
                    ],
                    "common_phrases": [
                        "soil one's hands",
                        "soil clothes"
                    ],
                    "target_lang_definitions": {
                        "ru": "Делать что-либо грязным, оставлять пятна на поверхности.",
                        "zh": "使某物变脏或留下污渍，尤指表面。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пачкать",
                                "target_lang_sense_clarification": "несовершенный вид, общее значение"
                            },
                            {
                                "target_lang_word": "испачкать",
                                "target_lang_sense_clarification": "совершенный вид, результат действия"
                            },
                            {
                                "target_lang_word": "замарать",
                                "target_lang_sense_clarification": "разговорный синоним"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "通用动词，表示使变脏"
                            },
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "指弄脏表面"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "43d2727b-5f69-31b1-a5c9-64693bfbe4b5",
                    "sense_definition": "To dirty one's clothing or bedding by accidentally defecating.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verb_dirty_2",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The nurse quickly changed the sheets after the patient <w>soiled</w> the bed.",
                            "target_lang_translations": {
                                "ru": "Медсестра быстро сменила простыни после того, как пациент <w>испачкал</w> кровать.",
                                "zh": "病人把床<w>弄脏</w>后，护士迅速更换了床单。"
                            }
                        },
                        {
                            "text": "The toddler <w>soiled</w> his pants because he could not reach the bathroom in time.",
                            "target_lang_translations": {
                                "ru": "Малыш <w>испачкал</w> штанишки, потому что не успел вовремя добраться до туалета.",
                                "zh": "那个幼儿因为没能及时赶到洗手间，把裤子<w>弄脏</w>了。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "soil oneself",
                        "soil a diaper"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "euphemistic"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пачкать одежду или постель испражнениями (эвфемизм).",
                        "zh": "因意外排泄而弄脏衣物或床铺（委婉语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "испачкать",
                                "target_lang_sense_clarification": "эвфемизм, часто с дополнением (штаны, постель)"
                            },
                            {
                                "target_lang_word": "обделаться",
                                "target_lang_sense_clarification": "разговорное, о человеке"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "弄脏",
                                "target_lang_sense_clarification": "委婉表达，常搭配衣物或床单"
                            },
                            {
                                "target_lang_word": "拉在",
                                "target_lang_sense_clarification": "口语，指排泄在某处"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4445e611-d4f9-3cfc-bf63-8dde7559a5ed",
                    "sense_definition": "To damage or disgrace a reputation, honor, or good name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "verb_dirty_3",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to let the scandal <w>soil</w> his family's good name.",
                            "target_lang_translations": {
                                "ru": "Он отказался позволить скандалу <w>запятнать</w> доброе имя своей семьи.",
                                "zh": "他拒绝让这桩丑闻<w>玷污</w>他家族的好名声。"
                            }
                        },
                        {
                            "text": "Dishonest behavior will eventually <w>soil</w> your professional reputation.",
                            "target_lang_translations": {
                                "ru": "Нечестное поведение в конечном итоге <w>запятнает</w> вашу профессиональную репутацию.",
                                "zh": "不诚实的行为最终会<w>玷污</w>你的职业声誉。"
                            }
                        }
                    ],
                    "synonyms": [
                        "smirch",
                        "besmirch"
                    ],
                    "common_phrases": [
                        "soil a reputation",
                        "soil one's honor"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "figurative"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наносить ущерб репутации, чести или доброму имени.",
                        "zh": "损害名誉、荣誉或好名声。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запятнать",
                                "target_lang_sense_clarification": "наиболее частотное сочетание с репутацией или честью"
                            },
                            {
                                "target_lang_word": "замарать",
                                "target_lang_sense_clarification": "разговорное, переносное значение"
                            },
                            {
                                "target_lang_word": "очернить",
                                "target_lang_sense_clarification": "синоним, означающий клевету или позор"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "玷污",
                                "target_lang_sense_clarification": "常与名誉或荣誉搭配"
                            },
                            {
                                "target_lang_word": "抹黑",
                                "target_lang_sense_clarification": "指损害名声"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}