                ],
                "senses": [
                    {
                        "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                        "entry_id": "47ffa416-5430-31f8-8ade-721e4af0e051",
                        "glosses": [
                            "Mütze, die speziell für das Laufen (insbesondere bei kühlerem Wetter) bestimmt ist"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "b780e714-632a-4f97-b20e-26cffa15d3e7",
                                "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                                "text": "„Als Belohnung erhält jeder Läufer und Walker eine hochwertige Laufmütze (Größe S, M und L) und eine Urkunde.“"
                            },
                            {
                                "example_id": "7dbf9d9f-4b24-448d-ae8a-843a53de95f4",
                                "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                                "text": "„Der Sprühregen war zwar nervig, aber dank Laufmütze war es zu verschmerzen.“"
                            },
                            {
                                "example_id": "09b6ede6-a4d1-4085-9149-ea6791fab614",
                                "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                                "text": "„An kühleren Tagen bietet sich ein Stirnband oder eine Laufmütze an, um Kopfschmerzen oder Ohrenentzündungen zu vermeiden.“"
                            },
                            {
                                "example_id": "52a49b9f-eb8a-400e-817a-772bbc5ea3d2",
                                "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                                "text": "„Deine neue Laufmütze kannst Du ruhigen Gewissens tragen, denn sie wurde unter fairen & sicheren Arbeitsbedingungen in Europa gefertigt und reinigt zeitgleich die Weltmeere.“"
                            },
                            {
                                "example_id": "cca378e3-e3e2-488c-9a72-ee1071d586fc",
                                "sense_id": "3d5ed157-9434-3d5d-ade5-d439bd62db1e",
                                "text": "„Zum Glück gibt es Laufmützen, welche vor Sonne etwas schützen, aber auch die Lüftung berücksichtigen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
