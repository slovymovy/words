                        "target_lang_word": "клубень",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "клубень",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "5c32620d-6a68-35f7-9af1-769237e83fa7",
                                        "entry_id": "fe9ea637-b4f1-384a-8179-3b0a2f5fcef5",
                                        "glosses": [
                                            "ботан. развивающийся, как правило, на концах подземных столонов видоизменённый укороченный побег, имеющий более или менее шаровидную форму в результате разрастания одного или нескольких междоузлий и с редуцированными листьями"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2cf8effc-7994-45b7-8df1-19ba5d672913",
                                                "sense_id": "5c32620d-6a68-35f7-9af1-769237e83fa7",
                                                "text": "Картофельные клубни ― это вздутия подземных стеблей картофельного курта."
                                            },
                                            {
                                                "example_id": "28ec1708-826f-4526-ba65-f7f3c5741d67",
                                                "sense_id": "5c32620d-6a68-35f7-9af1-769237e83fa7",
                                                "text": "Растения образуют клубни, корни, корневища ― естественные склады запасных питательных веществ."
                                            },
                                            {
                                                "example_id": "333b7457-5aa6-453b-acd4-9d956fdcc6e7",
                                                "sense_id": "5c32620d-6a68-35f7-9af1-769237e83fa7",
                                                "text": "Жители Западной Сибири издавна употребляли клубневидные корни пиона для приготовления вкусного и питательного блюда ― вареного мяса с клубнями."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
