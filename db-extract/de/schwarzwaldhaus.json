                "senses": [
                    {
                        "sense_id": "0c6f103a-a7d5-39fb-b4ae-68ef08886ccb",
                        "entry_id": "f6f564d7-a8d6-3bf9-bcf2-919f87b724d2",
                        "glosses": [
                            "Bauernhaus, das in der für den Schwarzwald charakteristischen Weise gebaut ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2761d193-c21d-4f87-970e-4fb30c8ff1eb",
                                "sense_id": "0c6f103a-a7d5-39fb-b4ae-68ef08886ccb",
                                "text": "„Von der Terrasse des Schwarzwaldhauses blickt man in das Schonacher Hochtal.“"
                            },
                            {
                                "example_id": "ab777862-4cfb-4977-aa42-876b4b5d2fc3",
                                "sense_id": "0c6f103a-a7d5-39fb-b4ae-68ef08886ccb",
                                "text": "„Sie lebt mit ihren Tieren in einem alten Schwarzwaldhaus, das sich auf 850 Metern Höhe an einen steilen Berghang schmiegt.“"
                            },
                            {
                                "example_id": "153c2cc6-9915-40df-b337-bbfb3210d5d0",
                                "sense_id": "0c6f103a-a7d5-39fb-b4ae-68ef08886ccb",
                                "text": "„Auch wenn die Klassen eins bis vier jahrgangsübergreifend unterrichtet werden, herrscht kein Gedränge in dem Schwarzwaldhaus in Münstertal (Kreis Breisgau-Hochschwarzwald).“"
                            },
                            {
                                "example_id": "1b33be0e-5d25-4adc-81f2-34b84459b7f9",
                                "sense_id": "0c6f103a-a7d5-39fb-b4ae-68ef08886ccb",
                                "text": "„Er schwärmte ja für das Verwurzelte, für Schwarzwaldhäuser, für die Wahrheit zerbeulter Tiegel und Töpfe.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
