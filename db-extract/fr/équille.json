                    {
                        "sense_id": "f779fafa-efa2-3499-929c-760e9b535d99",
                        "entry_id": "98a3f30f-a379-3cf7-80f2-11f94ce4a4ca",
                        "glosses": [
                            "Lançon, petit poisson de mer qui, à la marée basse, s’enfonce dans le sable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "acae9f52-fea1-4a83-8e25-45597c0aab87",
                                "sense_id": "f779fafa-efa2-3499-929c-760e9b535d99",
                                "text": "les équilles minces, raidies, ressemblaient à des rognures d’étain."
                            },
                            {
                                "example_id": "8fa6429d-f244-4c5d-b9e8-f92f82ed1ed8",
                                "sense_id": "f779fafa-efa2-3499-929c-760e9b535d99",
                                "text": "Des rochers bas, couverts de mousses et de varechs, émergent à marée basse. On pêche la crevette et l’équille."
                            },
                            {
                                "example_id": "2c2333fe-7cd1-41e4-a12f-db98df695b8f",
                                "sense_id": "f779fafa-efa2-3499-929c-760e9b535d99",
                                "text": "Je me racontai ce jour-là que je t’avais vu [Jean Marais] dans ton rôle de La Maison du pêcheur, et que sur tes pas traînait le filet, cheminait l’odeur de l’algue, étincelait l’écaille minuscule et nacrée des équilles…"
                            }
                        ]
