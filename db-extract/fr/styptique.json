        "fr-extract.jsonl": [
            {
                "entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                "word": "styptique",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4f3c6b05-5c9f-41fe-9ea0-c48efd1e74a3",
                        "entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "styptiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "14351dfa-91c0-3346-93f8-df0568394df4",
                        "entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                        "glosses": [
                            "Qui empêche l'écoulement du sang."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e3991e2-d07a-4921-a536-b2c11aeba563",
                                "sense_id": "14351dfa-91c0-3346-93f8-df0568394df4",
                                "text": "Dans tous les cas où j'ai appliqué la gaze au stryphnon, l'action styptique de ce produit a été constante et durable pour autant bien entendu qu'il s'agissait d'hémorragies parenchymateuses ou en nappe."
                            }
                        ]
                    },
                    {
                        "sense_id": "4dd53237-dc0a-3985-861c-aba86e2b9344",
                        "entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                        "glosses": [
                            "Qui a pour effet de resserrer les muqueuses buccales et les papilles, astringent."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e2732d17-e6a6-4f3a-9806-5f453f8c8293",
                                "sense_id": "4dd53237-dc0a-3985-861c-aba86e2b9344",
                                "text": "L’élatérine est un principe immédiat retiré, par M. Morrus, du momordica elaterium. Il est blanc, cristallin , très amer, un peu styptique, insoluble dans l'eau et dans les alcalis, […]."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "34e1ff50-da7a-4da0-9de4-9625391338f1",
                        "source_entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                        "target_lang_word": "blutstillend",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "185b8b34-773a-43e1-8f53-2c06ebb6182b",
                        "source_entry_id": "d12912d8-61c1-36f9-bcd3-b645a8ea210e",
                        "target_lang_word": "styptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "styptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d8b520a0-f6d4-3060-8a2b-e8279ff50b4c",
                                        "entry_id": "80f15627-b544-3cb9-bc21-09bb0b50d136",
                                        "glosses": [
                                            "Bringing about contraction of tissues; harsh, raw, austere."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1927ad37-f099-4c23-8302-d5f1d8489938",
                                                "sense_id": "d8b520a0-f6d4-3060-8a2b-e8279ff50b4c",
                                                "text": "Boyles turns to look over his shoulder, squinting into the styptic sun, and then flags a hand over his head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "49bfd6ec-99cb-3164-ab50-1783db814538",
                                        "entry_id": "80f15627-b544-3cb9-bc21-09bb0b50d136",
                                        "glosses": [
                                            "That stops bleeding; especially, in a minor way, topically."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d1259f2f-0435-48ce-b189-f586acd78912",
                                                "sense_id": "49bfd6ec-99cb-3164-ab50-1783db814538",
                                                "text": "The growth on top was a scrubby plant, unknown anywhere else on Malta, which was believed to have styptic qualities – it could staunch bleeding when packed on top of a wound […]."
                                            },
                                            {
                                                "example_id": "697d4461-5bf5-4df0-9262-8bef07dc6f3d",
                                                "sense_id": "49bfd6ec-99cb-3164-ab50-1783db814538",
                                                "text": "But I waited while he dabbed at the cut with styptic powder."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "styptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "56e76282-b22f-305d-b6ab-138b95187bcf",
                                        "entry_id": "bac0e973-d376-3675-8ca0-688c4439054a",
                                        "glosses": [
                                            "A substance used for styptic results."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41bf8650-008c-4470-b451-f82a4889c26f",
                                                "sense_id": "56e76282-b22f-305d-b6ab-138b95187bcf",
                                                "text": "The powdered gum with resin is used as a styptic; and the mucilage has been recommended as an application to burns."
                                            },
                                            {
                                                "example_id": "445b7621-e279-4e0a-a48a-b259fc3490bd",
                                                "sense_id": "56e76282-b22f-305d-b6ab-138b95187bcf",
                                                "text": "Externally, it is applied as a styptic, and in solution, of various strengths, as an astringent."
                                            },
                                            {
                                                "example_id": "8ee82292-2ae2-436d-9933-1728d891ce16",
                                                "sense_id": "56e76282-b22f-305d-b6ab-138b95187bcf",
                                                "text": "Knowledge of puffball's use as a styptic and for hemorrhoids reached Bass through the popular tradition."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
