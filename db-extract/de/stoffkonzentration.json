                ],
                "senses": [
                    {
                        "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                        "entry_id": "b401c6f0-102d-3f6d-a087-d27bad5040e9",
                        "glosses": [
                            "Anzahl der Teilchen (Atome oder Moleküle) pro Volumen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "512cb82c-144b-48e0-a69e-0c87cf050251",
                                "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                                "text": "„Im Frühjahr kommt es zu einer Durchmischung aller Stoffkonzentrationen im See.“"
                            },
                            {
                                "example_id": "6bcde589-51f2-499a-8e38-88a4b79c87c4",
                                "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                                "text": "„Wenn für die Komponenten des Wasserhaushalts sowohl die Wasserflüsse als auch die Stoffkonzentrationen bekannt sind, können Stofffrachten berechnet bzw. abgeschätzt werden.“"
                            },
                            {
                                "example_id": "6e1340c8-2eef-4552-8342-2c031c50004b",
                                "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                                "text": "„Luftgetragene Stoffkonzentrationen unterhalb des AEGL-1-Wertes bedeuten Expositionshöhen, die leichte Geruchs-, Geschmacks- bzw. andere sensorische Reizungen oder leichte Irritationseffekte (d.h. beispielsweise leichte Reizung an Augen und/oder Nase) hervorrufen können.“"
                            },
                            {
                                "example_id": "759966d9-5828-44ce-b479-8fb7e4fdff9a",
                                "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                                "text": "„Chemomechanische Ventile sind befähigt, automatisch und autark einen Stoffluss in Abhängigkeit vom Schwellwert einer bestimmten Stoffkonzentration zu regeln.“"
                            },
                            {
                                "example_id": "10ad00b1-ef4c-4970-bc7d-0eb5ddf9ce9e",
                                "sense_id": "feb356d0-47ad-3d5e-b0fb-e38cec42805e",
                                "text": "„Beispielsweise erhält man aus einfachen Modellen chemischer Reaktionen ein Gleichgewicht zwischen der Zu/Abnahme der betrachteten Stoffe, der Diffusion der Stoffe (durch den Laplace-Operator der Stoffkonzentration beschrieben) und nichtlinearen Termen, die von der Stoffkonzentration, von der Reaktionskinetik usw. abhängen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
