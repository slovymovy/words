                        "glosses": [
                            "de betrekkelijkheid van zaken inziend; wetend dat het allemaal niet zo heel belangrijk is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "823a7162-b7fe-44fc-b438-3f5882a4571c",
                                "sense_id": "2dd9642e-08dd-3ae3-8a0a-afb63a44a3da",
                                "text": ",,Dat is niet mis! Ik sta altijd heel relativerend tegenover mijn beroep, maar dit is echt heel bijzonder,\" zei Croiset, die zijn prijs opdroeg aan zijn moeder, die precies honderd jaar geleden was geboren."
                            },
                            {
                                "example_id": "4db249a0-a78f-4a84-b8cb-3ad4ab6ef230",
                                "sense_id": "2dd9642e-08dd-3ae3-8a0a-afb63a44a3da",
                                "text": "Een lekkere plek met voldoende oppervlakte voor 'een beetje fitness, wonen en kantoorruimte'. Daarna, minder relativerend: ,,Ik ben ongelooflijk trots dat ik dit heb kunnen kopen. En dat ik door de deal rond de feestdagen af te ronden, anderen onder wie Brad Pitt, te snel af ben geweest. Zij zaten te slapen."
                            }
                        ]
                    }
