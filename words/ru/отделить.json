{
    "word_family": [
        "отдел",
        "отделение",
        "отдельный",
        "отдельно"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "d7fd668e-5932-3c18-a301-7e7fd243ea6d",
                    "sense_definition": "Убрать одну часть от целого или отделить один предмет от другого",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Нужно <w>отделить</w> белки от желтков для приготовления этого десерта.",
                            "target_lang_translations": {
                                "de": "Man muss das Eiweiß vom Eigelb <w>trennen</w>, um dieses Dessert zuzubereiten."
                            }
                        },
                        {
                            "text": "Пожалуйста, <w>отделите</w> листы бумаги друг от друга перед печатью.",
                            "target_lang_translations": {
                                "de": "Bitte <w>trennen</w> Sie die Papierblätter vor dem Drucken voneinander."
                            }
                        }
                    ],
                    "synonyms": [
                        "разделить"
                    ],
                    "antonyms": [
                        "соединить"
                    ],
                    "common_phrases": [
                        "отделить часть"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Teil von einem Ganzen entfernen oder einen Gegenstand von einem anderen lösen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "trennen",
                                "target_lang_sense_clarification": "allgemein für das Auseinanderbringen von Dingen"
                            },
                            {
                                "target_lang_word": "absondern",
                                "target_lang_sense_clarification": "etwas gezielt von einer Gruppe oder Masse entfernen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "56b4e248-6dbe-3e0f-908a-b1cf1acf6c14",
                    "sense_definition": "Служить границей или преградой между двумя объектами",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boundary",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Высокий забор <w>отделяет</w> наш сад от соседского участка.",
                            "target_lang_translations": {
                                "de": "Ein hoher Zaun <w>trennt</w> unseren Garten vom Nachbargrundstück."
                            }
                        },
                        {
                            "text": "Ширма <w>отделила</w> рабочую зону от спального места в комнате.",
                            "target_lang_translations": {
                                "de": "Ein Paravent <w>trennte</w> den Arbeitsbereich vom Schlafplatz im Zimmer."
                            }
                        }
                    ],
                    "synonyms": [
                        "разграничить"
                    ],
                    "common_phrases": [
                        "отделить территорию"
                    ],
                    "target_lang_definitions": {
                        "de": "Als Grenze oder Barriere zwischen zwei Objekten fungieren."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "trennen",
                                "target_lang_sense_clarification": "räumliche Trennung durch ein Hindernis"
                            },
                            {
                                "target_lang_word": "abgrenzen",
                                "target_lang_sense_clarification": "eine Grenze zwischen zwei Bereichen ziehen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aac8f565-3169-3d02-8bbd-3add6db59174",
                    "sense_definition": "Считать что-либо не связанным с чем-то другим, провести четкую грань в понимании",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "conceptual_separation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Важно <w>отделить</w> личные чувства от профессиональных обязанностей на работе.",
                            "target_lang_translations": {
                                "de": "Es ist wichtig, persönliche Gefühle von beruflichen Pflichten bei der Arbeit zu <w>trennen</w>."
                            }
                        },
                        {
                            "text": "Трудно <w>отделить</w> правду от вымысла в этой запутанной истории.",
                            "target_lang_translations": {
                                "de": "Es ist schwer, in dieser verworrenen Geschichte Wahrheit von Fiktion zu <w>unterscheiden</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "разграничить"
                    ],
                    "common_phrases": [
                        "отделить главное"
                    ],
                    "target_lang_definitions": {
                        "de": "Etwas als nicht zusammengehörig betrachten oder eine klare Grenze im Verständnis ziehen."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "unterscheiden",
                                "target_lang_sense_clarification": "gedankliche Differenzierung zwischen zwei Dingen"
                            },
                            {
                                "target_lang_word": "abgrenzen",
                                "target_lang_sense_clarification": "begrifflich oder inhaltlich voneinander abheben"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9995e410-98ae-31c1-8e84-f1f9c72a48ca",
                    "sense_definition": "Выделять какое-либо вещество организмом или техническим устройством",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "secretion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Железы организма начинают <w>отделять</w> секрет при определенных условиях.",
                            "target_lang_translations": {
                                "de": "Die Drüsen des Körpers beginnen unter bestimmten Bedingungen ein Sekret <w>abzusondern</w>."
                            }
                        },
                        {
                            "text": "Этот орган способен <w>отделять</w> необходимые ферменты для пищеварения.",
                            "target_lang_translations": {
                                "de": "Dieses Organ ist in der Lage, notwendige Enzyme für die Verdauung <w>abzusondern</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "выделять"
                    ],
                    "target_lang_definitions": {
                        "de": "Einen Stoff durch einen Organismus oder ein technisches Gerät abgeben."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "absondern",
                                "target_lang_sense_clarification": "biologische Sekretion von Stoffen"
                            },
                            {
                                "target_lang_word": "ausscheiden",
                                "target_lang_sense_clarification": "Abgabe von Stoffen aus dem Körper"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}