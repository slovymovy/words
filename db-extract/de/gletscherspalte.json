                "senses": [
                    {
                        "sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                        "entry_id": "52c02da5-587b-3888-8b3a-ab1d67dea8e4",
                        "glosses": [
                            "eine spaltartige Öffnung in der Gletscheroberfläche"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3ac8dc13-0eb4-4973-b5a9-dfd2b3f17877",
                                "sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                                "text": "Ein Bergsteiger hat eine Woche in einer Gletscherspalte überlebt."
                            },
                            {
                                "example_id": "776738e9-8217-4fad-ad24-d14ae537ee98",
                                "sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                                "text": "Gletscherspalten stellen für den Bergsteiger eine große Gefahr dar."
                            },
                            {
                                "example_id": "ffb613e9-2239-42f4-a849-930799c57ff9",
                                "sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                                "text": "Zwei Gletscherspalten sind im Gletscherpark begehbar."
                            },
                            {
                                "example_id": "0a6beba6-cc67-461c-bbcd-928e0be07bf6",
                                "sense_id": "7412b490-2637-37a9-93b9-1c6d1e05af3a",
                                "text": "„Die Flucht vor der Qual der Sinnlosigkeit des täglichen Lebens führt in die menschenfeindlichsten Landschaften der Erde, in das vegetationslose Hochgebirge mit seinem ewigen Eis und Schnee, seinen unsichtbaren Gletscherspalten, seinen abweisenden Wänden und Graten, seinen gefährlichen Steinschlägen und Lawinen, seiner mörderischen Kälte und Hitze, seinen Stürmen und Wetterschlägen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
