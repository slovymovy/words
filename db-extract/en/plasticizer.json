                        "source_sense_id": "9df989ab-ce44-3008-99ff-1f6314583810",
                        "source_sense_description": "substance added for pliability in plastics",
                        "target_lang_word": "пластифика́тор",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "пластифика́тор",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2a777d79-711d-30d9-aa05-7d0c86f66538",
                                        "entry_id": "e8192dc8-f0ec-32c6-ba1f-19f7259dd4e6",
                                        "glosses": [
                                            "вещество, используемое в качестве добавки в какой-либо материал, с целью увеличения пластичности этого материала"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f5a9e65e-ee40-4c2a-8c00-a60d6f27e92e",
                                                "sense_id": "2a777d79-711d-30d9-aa05-7d0c86f66538",
                                                "text": "― Состав черепицы, производимой нами, ― это кварцевый песок, портландцемент F500, вода и пластификаторы."
                                            },
                                            {
                                                "example_id": "267f48e2-5af5-44e8-89e5-472ef76f1186",
                                                "sense_id": "2a777d79-711d-30d9-aa05-7d0c86f66538",
                                                "text": "В этой технологии, вобравшей в себя лучшее от полусухого формования и вибролитья, используется обычное отечественное сырьё (песок, цемент, пластификатор, пигменты) и стандартное оборудование (бетоносмеситель и виброплощадка)."
                                            },
                                            {
                                                "example_id": "69fa2755-7013-422d-ace6-7d69969039c9",
                                                "sense_id": "2a777d79-711d-30d9-aa05-7d0c86f66538",
                                                "text": "При перемешивании раствор неизбежно «газируется». Пластификаторы ещё больше вовлекают воздух. Объём газовой фазы в мелкозернистых (песчаных) бетонах может доходить до 10 % и более."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
