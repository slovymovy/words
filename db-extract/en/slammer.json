                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cb5b0860-cab9-3b70-85b1-3aa4c55caee9",
                        "entry_id": "e1e0f3d6-a9de-3d9c-bd6e-e0bceba26421",
                        "glosses": [
                            "In the game of Pogs, the heavier piece used to strike the stack of counters."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "505e6849-0e3d-4d31-90c2-6553d6bc4ec9",
                                "sense_id": "cb5b0860-cab9-3b70-85b1-3aa4c55caee9",
                                "text": "The basic modern 'Pog' game is played thus. Each child tosses a pog into the arena, face-up or face-down, as agreed. Each player in turn takes his slammer and pitches it hard onto the accumulated pile of pogs."
                            }
                        ]
                    },
                    {
                        "sense_id": "70a010fc-e395-3e0f-90de-2a9778d48aa5",
                        "entry_id": "e1e0f3d6-a9de-3d9c-bd6e-e0bceba26421",
                        "glosses": [
                            "A slam-door train."
                        ],
                        "tags": [
                            "UK",
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "b0cbccf0-20de-40a4-870e-a85fb20a6928",
                                "sense_id": "70a010fc-e395-3e0f-90de-2a9778d48aa5",
                                "text": "I was in Britain, wanting to take a train to Portsmouth, and I only needed a one-way ticket. I did love the English trains; we still had slammers then. A slammer is a train where you got to slam the door shut yourself."
                            }
                        ]
                    },
                    {
                        "sense_id": "3371a8f2-46db-3501-a256-cf10f74a86e9",
                        "entry_id": "e1e0f3d6-a9de-3d9c-bd6e-e0bceba26421",
                        "glosses": [
                            "A fraudster who carries out slamming (fraudulent changes to a customer's service)."
                        ],
