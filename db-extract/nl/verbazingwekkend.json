                    }
                ],
                "senses": [
                    {
                        "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                        "entry_id": "f9432b9b-9f1d-3f72-af6e-3e494fe9eba5",
                        "glosses": [
                            "wat verbazing opwekt, wat buitengewoon is"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81689d7c-23e0-4688-9ae6-cebf98646934",
                                "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                                "text": "Die circusartiesten lieten verbazingwekkende dingen zien."
                            },
                            {
                                "example_id": "42b63dcf-141f-4640-9d03-bb8a578ad96c",
                                "sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                                "text": "Prinses Elfilda dankt haar populariteit grotendeels aan haar verbazingwekkende schoonheid, hoewel er ook iets in haar karakter zit dat het grote publiek aantrekt. Ze zegt weinig, en als ze al een keertje haar mond opendoet, komen de woorden er aarzelend uit, zodat ze een bedeesde indruk maakt, een indruk die nog eens wordt versterkt door de manier waarop ze haar hoofd naar beneden houdt en door haar lange wimpers omhoogkijkt."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b8a4c178-713f-4341-81b9-9f2390238666",
                        "source_entry_id": "f9432b9b-9f1d-3f72-af6e-3e494fe9eba5",
                        "source_sense_id": "029185be-dd4d-374b-8c3d-e190632a2b66",
                        "source_sense_description": "wat verbazing opwekt, wat buitengewoon is",
                        "target_lang_word": "erstaunlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "erstaunlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                        "entry_id": "e401e565-c331-364c-9a0e-80cfa2f76aa7",
                                        "glosses": [
                                            "ungewöhnlich und dabei etwas anderes erwartend, dabei ein (leichtes) Staunen oder ein Gefühl des Befremdens auslösend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6b59de2-eb27-4408-8dc0-63ae7e554314",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "\"Er ist für sein Alter erstaunlich fit!\""
                                            },
                                            {
                                                "example_id": "5d93d84f-ced0-4dd5-b0d5-0a616f927263",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "Carl Friedrich Gauss konnte schon im jungen Alter erstaunlich gut rechnen."
                                            },
                                            {
                                                "example_id": "158a1db4-00b1-482b-9838-fbdf5e111fa0",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "Die Entwicklung von Wikipedia ist einfach erstaunlich."
                                            },
                                            {
                                                "example_id": "e1d255a3-d4a0-4a19-9174-2daa21c8f73a",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "„Wenn ein Zoo oder ein Museum die Besucher entscheiden lässt, wie viel Eintritt sie zahlen - was wird passieren? \"Pay What You Want\" klingt wie wirtschaftliches Harakiri, ist aber erstaunlich erfolgreich.“"
                                            },
                                            {
                                                "example_id": "b9febe7c-0c13-4079-910d-702f1b7bf9a1",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "„Tucholsky gehörte damit zu den Ersten, die das Scheitern der Republik und das Aufkommen der Nazis vorausahnten: \"Es ist erstaunlich, in welcher Präzision er schon damals die Szenarien vorausgesehen hat, die sich dann tatsächlich auch abgespielt haben\", sagt [der Biograph Paul] Hosfeld […].“"
                                            },
                                            {
                                                "example_id": "c893cb4e-a729-4994-8d70-91553e572286",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "„Die Wälder im Kongobecken sind noch erstaunlich intakt.“"
                                            },
                                            {
                                                "example_id": "c9990ec4-a0b9-4360-add0-bfda5cde2653",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "„Menschen mit vielen Leberflecken haben ein hohes Hautkrebsrisiko. Warum das so ist, wollte die Londoner Hautforscherin Veronique Bataille herausfinden. Und sie machte eine erstaunliche Entdeckung: Menschen mit vielen Leberflecken haben demnach eine besondere Haut, die kaum altert, unempfindlich gegenüber der Sonne ist und keine Falten bekommt.“"
                                            },
                                            {
                                                "example_id": "38a89459-e080-4f5b-a7ba-e7fb727b8be9",
                                                "sense_id": "1e48ee2c-53d8-3809-a8e6-e5d12fb8c141",
                                                "text": "„Mehr als 700 jugendliche Straftäter in neun Bundesländern haben bislang an den Seminaren [des \"Violence Prevention Network\" - VPN] teilgenommen. Die Erfolgsquote ist erstaunlich hoch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d9108a3b-a6f2-33cb-8041-d60e0bc2ebed",
                                        "entry_id": "e401e565-c331-364c-9a0e-80cfa2f76aa7",
                                        "glosses": [
                                            "sehr groß, riesig, sehr viel oder viele"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51a8a354-c78d-47a4-8602-3f44e6bcc4a8",
                                                "sense_id": "d9108a3b-a6f2-33cb-8041-d60e0bc2ebed",
                                                "text": "\"Das Burj Khalifa in Dubai ist erstaunlich hoch, dass das überhaupt stehen bleibt …\""
                                            },
                                            {
                                                "example_id": "b15d7e9e-42ae-4e36-871e-040295a5da68",
                                                "sense_id": "d9108a3b-a6f2-33cb-8041-d60e0bc2ebed",
                                                "text": "„Im Interview der Turner Fabian Hambüchen, Frage: \"Ihr erster großer Wettkampf waren 2004 die Olympischen Spiele in Athen. Zehn Jahre sind Sie jetzt in der Turn-Weltspitze dabei. Eine erstaunlich lange Zeit. Welche Gründe gibt es dafür?\"“"
                                            },
                                            {
                                                "example_id": "b195e048-9d95-4335-be6e-e4a81eb67b7f",
                                                "sense_id": "d9108a3b-a6f2-33cb-8041-d60e0bc2ebed",
                                                "text": "„Zimt ist ungesund! Einer seiner Inhaltsstoffe, Kumarin, kann in hohen Konzentrationen Leber- und Nierenschäden verursachen. Wer sich umschaut, wird erstaunlich viele Lebensmittel finden, die er besser meidet.“"
                                            },
                                            {
                                                "example_id": "11c649ce-a71e-4d57-9e6b-c492be9b567a",
                                                "sense_id": "d9108a3b-a6f2-33cb-8041-d60e0bc2ebed",
                                                "text": "„Er [der US-amerikanische Rapper und Reggae-Musiker Snoop] ist erstaunlich groß, sehr schmal, verschwindet fast in seinem schlabbrigen Trainingsanzug und hinter seiner blickdichten Sonnenbrille.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
