                                "target_senses": [
                                    {
                                        "sense_id": "1250105c-47cb-336c-bb01-d0fa62fbd76b",
                                        "entry_id": "5a88c802-e301-37ad-ac69-2e08a24da78a",
                                        "glosses": [
                                            "небольшой открытый вагон или платформа для перевозки грузов по узкоколейным и подвесным дорогам"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "867b893a-384b-4dbb-ad35-b067009f2294",
                                                "sense_id": "1250105c-47cb-336c-bb01-d0fa62fbd76b",
                                                "text": "У выхода уголь нагружается в вагонетки и по рельсам доставляется в склады."
                                            },
                                            {
                                                "example_id": "946b627f-0247-49c9-aea5-e423137ccaf6",
                                                "sense_id": "1250105c-47cb-336c-bb01-d0fa62fbd76b",
                                                "text": "Рабочие, находившиеся на самой верхушке печи, продолжали без отдыха забрасывать в неё руду и каменный уголь, которые то и дело подымались наверх в железных вагонетках."
                                            },
                                            {
                                                "example_id": "50972cf4-fe90-43fb-88a3-1b8aa8e33657",
                                                "sense_id": "1250105c-47cb-336c-bb01-d0fa62fbd76b",
                                                "text": "Сгрёб отгрёбщик уголь вон, // вбил крепильщик клетки, // а по штрекам / коногон // гонит вагонетки."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
