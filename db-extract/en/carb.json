                ],
                "translations": [
                    {
                        "translation_id": "f6285909-ee50-4999-bb11-8375c727a2cc",
                        "source_entry_id": "e11855bc-22b6-3640-8268-ea03458f7696",
                        "source_sense_id": "39852417-f278-3549-973c-da1321e559a6",
                        "source_sense_description": "Teil eines Verbrennungsmotors",
                        "target_lang_word": "Vergaser",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Vergaser",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                        "entry_id": "22976ef8-6b8b-3962-b966-88e58615fc7e",
                                        "glosses": [
                                            "Teil eines Verbrennungsmotors, der ein brennfertiges Kraftstoff-Luft-Gemisch herstellt"
                                        ],
                                        "tags": [
                                            "Kraftfahrzeugtechnik"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50c2abbd-63da-414f-ab54-e29e8f2fca4e",
                                                "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                                "text": "Er hat das Motorrad in die Werkstatt gebracht, weil die Drosselklappe am Vergaser wieder kaputt ist."
                                            },
                                            {
                                                "example_id": "7ace5b4e-652e-4228-8bb8-223d7f91aa50",
                                                "sense_id": "1b11d923-d8a2-3182-b9b0-9dc1d0d83465",
                                                "text": "„Das Gehäuse der Benzineinspritzung sieht aus wie die Vergaser aus früheren Jahrzehnten, und den Abgaskatalysator haben die Ingenieure geschickt unter dem Triebwerk versteckt, um den klassischen Schwung der Auspuffrohre nicht zu ruinieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "dc9d7704-a765-4b5a-988b-631140da8d85",
                        "source_entry_id": "e11855bc-22b6-3640-8268-ea03458f7696",
                        "source_sense_id": "62f85442-c3ac-3f07-8b9d-1bfb05b99f6a",
                        "source_sense_description": "chemische Verbindung",
                        "target_lang_word": "Kohlenhydrat",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kohlenhydrat",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                        "entry_id": "90dcb685-ec08-307f-b950-d1728a2777f0",
                                        "glosses": [
                                            "chemische Verbindung aus Kohlenstoffdioxid und Wasserstoff, allgemeine Summenformel: CₙH₂ₘOₘ"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28cd3204-2c1a-4b7b-94be-3e4c7437fafb",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "Kohlenhydrate sind ein wichtiger Bestandteil unserer Ernährung."
                                            },
                                            {
                                                "example_id": "d94a3b9d-78fc-4785-b0a5-113bff74570f",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "Kohlenhydrate sind in Kartoffeln, Zucker und anderen Nahrungsmitteln enthalten."
                                            },
                                            {
                                                "example_id": "585fcf26-ba1d-4fbc-bbe8-cee2d0fd9da5",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Unter den Nährstoffen sind Kohlenhydrate wie Zucker und Stärke die wichtigsten Energieträger.“"
                                            },
                                            {
                                                "example_id": "332cdc10-87a7-421b-98f1-dbfa6277f41c",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Auch Cellulose, der Baustoff pflanzlicher Zellwände, gehört zur Stoffgruppe der Kohlenhydrate.“"
                                            },
                                            {
                                                "example_id": "528140ac-d550-47d7-9c7c-87348c2da5ae",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Die Bezeichnung Kohlenhydrate geht auf die allgemeine Molekülformel Cₙ(H₂O)ₘ zurück, die viele Vertreter dieser Stoffgruppe kennzeichnet.“"
                                            },
                                            {
                                                "example_id": "60bc3697-b898-4f9d-8032-fafc79fbae7f",
                                                "sense_id": "4bf6f598-c6cd-3ed9-912d-30dabcd82d7e",
                                                "text": "„Kohlenhydrate, die wie Stärke oder Cellulose aus vielen Monosaccharid-Bausteinen bestehen, nennt man Polysaccharide (Abb. 1).“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
