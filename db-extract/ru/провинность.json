                    }
                ],
                "translations": [
                    {
                        "translation_id": "1e851916-cd6f-4da2-b67e-ed49d0818a28",
                        "source_entry_id": "4fded4e4-49f8-3864-b133-ce1ba553733a",
                        "source_sense_id": "647af654-7942-3fa9-a02f-cf8108a3c00b",
                        "target_lang_word": "faute",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "faute",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Manquement plus ou moins grave à un devoir, à une loi, à une règle, à un usage, à une convenance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2235255-e76f-4005-bf5f-796335ecc859",
                                                "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                                "text": "En reconstruisant, par une pensée, le tableau de ses jeunes années, don Juan s’aperçut qu’il lui serait difficile de trouver la bonté de son père en faute."
                                            },
                                            {
                                                "example_id": "cf49d54d-de37-4bc1-bdc7-fde40d04639a",
                                                "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                                "text": "Chez d'autres, le manque d'habitude de lire typographiquement produit le même résultat; des fautes évidentes leur échappent sur trois épreuves, et ils les taxent de fautes typographiques."
                                            },
                                            {
                                                "example_id": "0b27fbde-4b95-462f-8284-e1942376860c",
                                                "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                                "text": "Nous avions pour jardinier un ancien forçat que sa bonne conduite au bagne avait racheté de ses fautes."
                                            },
                                            {
                                                "example_id": "6c2e7422-bf7f-411c-9906-3e1eedcb7cdd",
                                                "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                                "text": "[…]: une grande banque catholique, l'Union Générale venait de sombrer dans la banqueroute. Cette déconfiture était due à des folles spéculations, aux fautes et même à l'improbité de ses dirigeants."
                                            },
                                            {
                                                "example_id": "e6b1e8e5-1803-44c3-bf30-3fcd094d14e6",
                                                "sense_id": "98c1bc06-efd6-3b83-bcf0-4b03737906de",
                                                "text": "La cour d’appel partagea alors les dommages, selon les principes de la faute commune, constatant que la victime s’était imprudemment aventurée sur un boulevard passager, sans prendre les précautions nécessaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32910ca4-709c-3815-b581-368c81fd4592",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Péché."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6ccaaa6-8405-4732-9784-3fc673eaa1e5",
                                                "sense_id": "32910ca4-709c-3815-b581-368c81fd4592",
                                                "text": "L'église ce dimanche, regorge de gens […] qui ne l'appellent que pour les derniers sacrements, et qu'il oindra, à l'agonie, dans l'inconscience quasi totale, absous néanmoins de toutes leurs fautes."
                                            },
                                            {
                                                "example_id": "545aee6b-301b-4586-b536-e82dca2e1004",
                                                "sense_id": "32910ca4-709c-3815-b581-368c81fd4592",
                                                "text": "Ah ! non, il ne la voyait pas sa grand’mère, cette sale petite bourgeoise qui l’avait humilié et fait souffrir durant son enfance. Il la détestait de toute sa puissance de haine, mais plus qu’elle encore, il haïssait la société présente, pleine de préjugés, qui faisait souffrir les enfants de la prétendue faute de leur mère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "73c1b0a3-78de-3e80-bce6-213bcd34f4b7",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Adultère."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9d7fa378-e28c-40cc-aad9-b194b9f1bcf4",
                                                "sense_id": "73c1b0a3-78de-3e80-bce6-213bcd34f4b7",
                                                "text": "Moi aussi, les soirs trop chauds m’ont terrassée ; moi aussi, l’odeur musquée des foins, les roulades du rossignol m’ont livré à la folie, à la faute."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d86f0d78-7586-3b8d-b1f4-e11a7490d7a4",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Manquement contre les règles de l'art ; imperfection dans un ouvrage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16ea6a22-72e4-4b64-8476-89b08d5057db",
                                                "sense_id": "d86f0d78-7586-3b8d-b1f4-e11a7490d7a4",
                                                "text": "Même fourmillement de fautes innombrables, d'erreurs ou d'inexactitudes phonétiques, dans les mots souletins que porte le dictionnaire du P. Lhande."
                                            },
                                            {
                                                "example_id": "47e32bdc-e688-4f19-aa6a-284a776643b2",
                                                "sense_id": "d86f0d78-7586-3b8d-b1f4-e11a7490d7a4",
                                                "text": "Y me resterait juste à le recopier en faisant un peu de fautes, avec des barbos."
                                            },
                                            {
                                                "example_id": "721055f2-d019-49ce-a3ea-66ceec5bf626",
                                                "sense_id": "d86f0d78-7586-3b8d-b1f4-e11a7490d7a4",
                                                "text": "Faire des fautes contre la vraisemblance dans une pièce de théâtre classique. — Une faute de jugement."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f4aec0b-3709-3ca9-9668-3d97fe168e83",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Manque ; manque de vivres, disette."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4b5b4e07-b359-4fcb-b4fa-68832afa3d25",
                                                "sense_id": "8f4aec0b-3709-3ca9-9668-3d97fe168e83",
                                                "text": "Vous n’aurez pas faute de gens qui vous le demanderont."
                                            },
                                            {
                                                "example_id": "924f1b38-730b-4eeb-bc97-7732c02d0e11",
                                                "sense_id": "8f4aec0b-3709-3ca9-9668-3d97fe168e83",
                                                "text": "On craignait d’avoir faute de soldats, de matelots."
                                            },
                                            {
                                                "example_id": "10af98de-0b8c-420c-87dc-c802b50772f9",
                                                "sense_id": "8f4aec0b-3709-3ca9-9668-3d97fe168e83",
                                                "text": "On eut faute de blé. Il y avait faute d’argent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e7bd7a7-f510-3716-a895-47092a1d9e12",
                                        "entry_id": "6c250ff3-ec14-3388-83e0-51507fa54191",
                                        "glosses": [
                                            "Violation des règles du jeu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9eb7a50-7801-4657-a878-106df1c64ff4",
                                                "sense_id": "2e7bd7a7-f510-3716-a895-47092a1d9e12",
                                                "text": "Faire des fautes au jeu."
                                            },
                                            {
                                                "example_id": "a9f32c38-a59b-46ef-8629-d0c6216321a0",
                                                "sense_id": "2e7bd7a7-f510-3716-a895-47092a1d9e12",
                                                "text": "Une balle est annoncée faute si elle reste dans le filet, ou effectue son premier rebond en dehors des limites du terrain (dans les couloirs en simple, dans son propre camp ou en dehors du carré de service lors du service). Un point est ensuite accordé à l'adversaire."
                                            }
                                        ]
                                    }
                                ]
                            },
