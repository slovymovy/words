                                        "entry_id": "856dd61f-675f-3b03-9439-a51e21601d85",
                                        "glosses": [
                                            "Foolish behaviour or speech."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "368f0859-7dcb-43b1-85c2-6fa494265ded",
                                                "sense_id": "89d25a9e-ddba-328a-998d-4d4fdbb8ec1c",
                                                "text": "\"Do not think THAT,\" I put in. \"It was not so at all. I grant you that my behaviour was bad—I fully confess that it was so, and make no secret of the fact. I would even go so far as to grant you that my behaviour might well be called stupid and indecent tomfoolery; but, MORE than that it was not."
                                            }
                                        ]
