                                    {
                                        "sense_id": "c07a882b-1574-376a-b051-6b3c3aea9545",
                                        "entry_id": "2b0c6cbe-4bb9-3e5a-a097-5ee61a2c7dfa",
                                        "glosses": [
                                            "Synonym of mpox."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c9e478c-29db-4e29-911e-8e59a7fb1c9d",
                                                "sense_id": "c07a882b-1574-376a-b051-6b3c3aea9545",
                                                "text": "In a remote southwestern pocket of the Central African Republic, doctor Patrick Karume and his small team are on the jungle frontline to quarantine a rare outbreak of monkeypox."
                                            },
                                            {
                                                "example_id": "4f61eec6-7a57-480a-8301-4bdd4c064f68",
                                                "sense_id": "c07a882b-1574-376a-b051-6b3c3aea9545",
                                                "text": "Monkeypox is a rare viral pox-like disease from the smallpox family, only milder. It can be transmitted through respiratory droplets, contact with body fluids or contact with an infected animal or animal products.\nThe first human case of monkeypox was recorded in 1970 in the Democratic Republic of Congo. The United States saw a large outbreak among humans in 2003 after the virus spread from imported African rodents to pet prairie dogs. However, this is believed to be the first monkeypox virus infection in a Texas resident, according to Dallas County health officials."
                                            },
                                            {
                                                "example_id": "6211ace9-4c25-491d-8b88-58ec0d836864",
                                                "sense_id": "c07a882b-1574-376a-b051-6b3c3aea9545",
                                                "text": "Clusters of monkeypox cases have recently been identified in Britain and Portugal, while Spain is investigating suspected cases of the virus."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
