                                "sense_id": "7511c9e0-9d79-30ba-94bc-cb6a9194dd43",
                                "text": "Der Proponent zog noch am selben Tag seinen Antrag wieder zurück."
                            }
                        ],
                        "sense_index_json": "\"3\""
