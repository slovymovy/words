                                        "sense_id": "c8e03152-f493-30d1-ace6-f2a287094970",
                                        "entry_id": "b8a9cf47-2f00-3ac4-85cc-03842f5aeee7",
                                        "glosses": [
                                            "(militärisches) Geleit zur Bewachung, zum Schutz oder zur Ehrung einer Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0651ca6-ea49-4515-bf1b-406eccbc45e0",
                                                "sense_id": "c8e03152-f493-30d1-ace6-f2a287094970",
                                                "text": "„Für den Transport nach Valladolid wird im Auftrag des portugiesischen Königs eine stattliche Eskorte zusammengestellt.“"
                                            },
                                            {
                                                "example_id": "262c9d18-2d82-4170-9239-0394e95c1063",
                                                "sense_id": "c8e03152-f493-30d1-ace6-f2a287094970",
                                                "text": "„Dann rollte der Wagen mit seiner Eskorte davon.“"
                                            },
                                            {
                                                "example_id": "1bda266d-03ea-41e4-9d35-49eb7c4475ec",
                                                "sense_id": "c8e03152-f493-30d1-ace6-f2a287094970",
                                                "text": "„Die Company bezahlte sein Gehalt weiter und versorgte ihn mit einer Eskorte von Gurkhasoldaten, alle anderen Ausgaben bestritt er aus seinem eigenen, nicht unbedeutenden Privatvermögen.“"
                                            },
                                            {
                                                "example_id": "1a95b9dd-51e7-4092-988e-5fc02114e554",
                                                "sense_id": "c8e03152-f493-30d1-ace6-f2a287094970",
                                                "text": "„Da entscheidet unser Dolmetscher, der Oberst, die Frage und sagt, daß wir keine Eskorte brauchten; wir gehörten zu denen, sagt er, die ihre Sache in Gottes Hand legten.“"
                                            }
                                        ],
