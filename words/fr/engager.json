                    ]
                },
                {
                    "sense_id": "892fbd67-a066-3b82-95fa-cb7c055d3e93",
                    "sense_definition": "Faire entrer ou introduire un objet dans un espace resserré ou un mécanisme.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mouvement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il faut doucement <w>engager</w> la tige métallique dans la fente prévue à cet effet."
                        },
                        {
                            "text": "Le conducteur a ralenti avant d'<w>engager</w> sa voiture dans l'allée très étroite."
