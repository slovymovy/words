    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "931ee425-78ef-33d5-88a0-a5906a8b1a7a",
                    "sense_definition": "Lively and quick in pace or speech.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The speaker maintained a <w>rattling</w> pace throughout the entire presentation.",
                            "target_lang_translations": {
                                "cs": "Řečník si udržoval <w>svižné</w> tempo po celou dobu prezentace."
                            }
                        },
                        {
                            "text": "They engaged in a <w>rattling</w> conversation that lasted for hours.",
                            "target_lang_translations": {
                                "cs": "Vedli <w>svižný</w> rozhovor, který trval celé hodiny."
                            }
                        }
                    ],
                    "synonyms": [
                        "brisk",
                        "fast"
                    ],
                    "common_phrases": [
                        "rattling pace"
                    ],
                    "target_lang_definitions": {
                        "cs": "Živý, rychlý a svižný v tempu nebo v řeči."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "svižný",
                                "target_lang_sense_clarification": "označující rychlé tempo"
                            },
                            {
                                "target_lang_word": "rychlý",
                                "target_lang_sense_clarification": "obecné označení pro vysokou rychlost"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fccdd61-b2b7-372f-8eae-49d42c3f5325",
                    "sense_definition": "Very good or excellent.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "lively",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We had a <w>rattling</w> good time at the party last night.",
                            "target_lang_translations": {
                                "cs": "Včera večer na večírku jsme se <w>skvěle</w> bavili."
                            }
                        },
                        {
                            "text": "The team enjoyed a <w>rattling</w> fine victory against their rivals.",
                            "target_lang_translations": {
                                "cs": "Tým si užil <w>skvělé</w> vítězství nad svými rivaly."
                            }
                        }
                    ],
                    "synonyms": [
                        "excellent",
                        "splendid"
                    ],
                    "common_phrases": [
                        "rattling good"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Often used in British English."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Velmi dobrý nebo vynikající (zastaralejší britský výraz)."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "skvělý",
                                "target_lang_sense_clarification": "vyjadřující vysokou kvalitu"
                            },
                            {
                                "target_lang_word": "výborný",
                                "target_lang_sense_clarification": "vyjadřující vynikající úroveň"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "9d818f1a-4836-30ca-8c9f-b225091a4628",
                    "sense_definition": "A sound made by loose objects shaking or vibrating against one another.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sound",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>rattling</w> of the keys in his pocket annoyed everyone.",
                            "target_lang_translations": {
                                "cs": "<w>Chrastění</w> klíčů v jeho kapse všechny obtěžovalo."
                            }
                        },
                        {
                            "text": "I heard a faint <w>rattling</w> coming from the old engine.",
                            "target_lang_translations": {
                                "cs": "Slyšel jsem slabé <w>drnčení</w> vycházející ze starého motoru."
                            }
                        }
                    ],
                    "synonyms": [
                        "clatter"
                    ],
                    "target_lang_definitions": {
                        "cs": "Zvuk způsobený volnými předměty, které o sebe narážejí nebo vibrují."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "chrastění",
                                "target_lang_sense_clarification": "zvuk drobných předmětů"
                            },
                            {
                                "target_lang_word": "drnčení",
                                "target_lang_sense_clarification": "zvuk vibrací nebo nárazů"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45abf979-9c93-324c-b204-75c6ec3fe26a",
                    "sense_definition": "Alternative form of <w>ratline</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "nautical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sailor climbed the <w>rattling</w> to reach the top of the mast.",
                            "target_lang_translations": {
                                "cs": "Námořník vylezl po <w>provazovém žebříku</w>, aby se dostal na vrchol stěžně."
                            }
                        },
                        {
                            "text": "The ship's <w>rattling</w> needed urgent repair before the long voyage.",
                            "target_lang_translations": {
                                "cs": "Loď potřebovala naléhavou opravu <w>provazového žebříku</w> před dlouhou plavbou."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "Nautical term."
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Námořnický termín pro provazový žebřík na stěžni."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "provazový žebřík",
                                "target_lang_sense_clarification": "námořnický termín"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "30daf19a-dbcd-3d73-b7c6-8f072df5539b",
