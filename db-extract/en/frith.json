                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bc8d10c-3f9e-4294-b190-900a84768b1d",
                                "sense_id": "0cdae908-386e-30cc-b097-06af5b453162",
                                "text": "As over Holt and Heath, as thorough Frith and Fell; [...]"
                            }
                        ]
                    },
                    {
                        "sense_id": "93cf5289-5106-3846-943b-b3f6aaacd8fa",
                        "entry_id": "30616976-1cf1-394a-9ff1-4bfd7171a1e3",
                        "glosses": [
                            "Land with mostly undergrowth and few trees; also, land in between forests or woods; pastureland which is not in use."
                        ],
