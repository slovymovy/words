        "fr-extract.jsonl": [
            {
                "entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                "word": "sépulcre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "c314fbb1-cead-408c-8514-b173e7011735",
                        "entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                        "tags": [
                            "plural"
                        ],
                        "form": "sépulcres"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1bfed498-249a-3be2-8a63-ff484cf5f9ba",
                        "entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                        "glosses": [
                            "Monument destiné à recevoir un mort."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "3e400856-2770-48ab-a386-3d2489e4bd16",
                                "sense_id": "1bfed498-249a-3be2-8a63-ff484cf5f9ba",
                                "text": "Vers le 20 janvier 1794, après la démolition du tombeau de François Iᵉʳ, on ouvrit le sépulcre de la comtesse de Flandre, fille de Philippe le Long."
                            },
                            {
                                "example_id": "1d7aded3-083e-4f84-af7c-e5b5fce67ca3",
                                "sense_id": "1bfed498-249a-3be2-8a63-ff484cf5f9ba",
                                "text": "[…], ils paraissaient dans les ténèbres, une foule de fantômes échappés du sépulcre, se hâtant pour accomplir une œuvre sans nom, maudite de Dieu, […]."
                            },
                            {
                                "example_id": "4dcc2dc6-6d3d-44ee-8707-0379fca153e1",
                                "sense_id": "1bfed498-249a-3be2-8a63-ff484cf5f9ba",
                                "text": "Pourquoi le sépulcre où nous t’avons vu inhumé en paix a ouvert ses lourdes mâchoires de marbre pour te rejeter dans ce monde !"
                            },
                            {
                                "example_id": "a1bce3fd-7273-4599-9ca6-08067567f8e7",
                                "sense_id": "1bfed498-249a-3be2-8a63-ff484cf5f9ba",
                                "text": "Depuis que M. Bergeret ne lui adressait plus la parole et vivait séparé d’elle, son appartement l’effrayait comme un sépulcre ; elle n’y rentrait qu’en pâlissant."
                            }
                        ]
                    },
                    {
                        "sense_id": "d1d18c84-f1a2-3325-9f79-64a707e7caa3",
                        "entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                        "glosses": [
                            "Ténèbres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed83053f-9c6a-4a65-bfc5-5a781c013e31",
                                "sense_id": "d1d18c84-f1a2-3325-9f79-64a707e7caa3",
                                "text": "Que ceux qui sont dans l'enfer, c'est-à-dire dans le sépulcre, (car c'est la signification qu'a ce mot dans l'Ancien Testament) ne loueront point le Seigneur"
                            }
                        ]
                    },
                    {
                        "sense_id": "2d65dea1-3cef-3f78-a933-d9e1ddf729ad",
                        "entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                        "glosses": [
                            "Cavité dans le roc, naturelle ou taillée artificiellement."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6818c0c3-d2c5-4ac5-99e5-1d73a710caa0",
                        "source_entry_id": "0e9c6620-5c32-309e-b646-fe2506a95283",
                        "target_lang_word": "sepulchre",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sepulchre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                        "entry_id": "5dd082a1-524c-36bb-bb11-bf7883d87024",
                                        "glosses": [
                                            "A burial chamber."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1dc1da1-0b10-4e35-987f-b19bdb5d3103",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "And so, all the night-tide, I lie down by the side\nOf my darling—my darling—my life and my bride,\nIn her sepulchre there by the sea—\nIn her tomb by the sounding sea."
                                            },
                                            {
                                                "example_id": "9022d669-a663-482f-89b7-5d6af3fb2f94",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "Near-synonym: crypt"
                                            },
                                            {
                                                "example_id": "21d35084-32be-43c3-b87a-a1bb94daae46",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "By Mahomet, my Kinſmans ſepulcher,\nAnd by the holy Alcaron I ſweare, […]"
                                            },
                                            {
                                                "example_id": "6fdb9bb1-6e70-4793-8ba0-a87de605928b",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "He is knight dubb'd with vnhatche'd Rapier, and on carpet conſideration, but he is a diuell in priuate brall, soules and bodies hath he diuorc'd three, and his incenſement at this moment is ſo implacable, that ſatisfaction can be none, but by pangs of death and ſepulcher: Hob, nob, is his word: giu't or take't."
                                            },
                                            {
                                                "example_id": "6c9d8315-d67f-4928-9335-9e8907533f33",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "Woe vnto you Scribes and Phariſees, hypocrites, for yee are like vnto whited ſepulchꝛes, which indeed appeare beautifull outward, but are within full of dead mens bones, and of all vncleanneſſe."
                                            },
                                            {
                                                "example_id": "70a9d1a3-ae62-4c37-a08a-c0c31f42fa20",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "[I]n the reign of Henry the Second, a body happening, by chance, to be dug up near Glastonbury Abbey, without any symptoms of putrefaction or decay, the Welch, the descendants of the Ancient Britons, tenacious of the dignity and reputation of that illustrious hero [King Arthur], vainly supposed it could be no other than the body of their justly-boasted Pen-Dragon; and that he had been immured in that sepulchre by the spells of some powerful and implacable inchanter."
                                            },
                                            {
                                                "example_id": "ab3116e8-dfd7-43ee-95ce-fc5591692e47",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "Nor was it the human form alone which we had placed in this eternal sepulchre, whose obsequies we now celebrated."
                                            },
                                            {
                                                "example_id": "4d50eee8-92b5-47bd-99f7-1ad6daf2a546",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "The vast tackles have now done their duty. The peeled white body of the beheaded whale flashes like a marble sepulchre; though changed in hue, it has not perceptibly lost anything in bulk."
                                            },
                                            {
                                                "example_id": "89fca26f-19f4-4b7e-ad52-ebbafbeb39e1",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "Plato, too, it is well known, considered the body as the sepulchre of the soul, and in the Cratylus concurs with the doctrine of Orpheus, that the soul is punished through its union with body."
                                            },
                                            {
                                                "example_id": "1c1ec13a-3b62-40dd-b0fc-c04a540b232d",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "The aged sisters draw us into life: we wail, batten, sport, clip, clasp, sunder, dwindle, die: over us dead they bend. First saved from waters of old Nile, among bulrushes, a bed of fasciated wattles: at last the cavity of a mountain, an occulted sepulchre amid the conclamation of the hillcat and the ossifrage."
                                            },
                                            {
                                                "example_id": "60e1cb22-9aa1-407d-af81-b07dd0db14d3",
                                                "sense_id": "3ae861f2-cf81-3f5c-ae50-96b5e5ebdb56",
                                                "text": "I parked Bertha in a convenient cab rank and raced into the smoked glass sepulchre that is Hanover airport."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dc21709b-0a7a-3eb2-b1f4-0720cde9358e",
                                        "entry_id": "5dd082a1-524c-36bb-bb11-bf7883d87024",
                                        "glosses": [
                                            "A recess in some early churches in which the reserved sacrament, etc. was kept from Good Friday till Easter."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "sepulchre",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "028711d2-3a75-3ce8-92d5-580d9aa515b8",
                                        "entry_id": "96705d40-ca77-34a7-9d20-880fba056d85",
                                        "glosses": [
                                            "To place in a sepulchre."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "25cf7729-b7ba-48b1-b467-01f0f186ef44",
                                                "sense_id": "028711d2-3a75-3ce8-92d5-580d9aa515b8",
                                                "text": "And so sepulchred in such pomp dost lie\n That kings for such a tomb would wish to die."
                                            },
                                            {
                                                "example_id": "ecac69c5-db83-4a46-9ab9-f7c0c9caaaae",
                                                "sense_id": "028711d2-3a75-3ce8-92d5-580d9aa515b8",
                                                "text": "Not one of the ordinary motives—the vanity or the selfishness which people call by the name of love—actuated her through this long trial; she had everything to fear, and nothing to expect. What creation of the poet ever exceeded this terrible reality of love sepulchred in this living tomb?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
