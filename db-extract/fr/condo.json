                "senses": [
                    {
                        "sense_id": "07b10a8b-7e35-32f0-a6b5-4f9e6d67a929",
                        "entry_id": "5964c2f1-8774-3132-ad96-6c3ab69bd7e1",
                        "glosses": [
                            "Condominium, immeuble en copropriété, logement."
                        ],
                        "tags": [
                            "Canada"
                        ],
                        "examples": [
                            {
                                "example_id": "23603d52-cde8-4442-bd16-98c52a820999",
                                "sense_id": "07b10a8b-7e35-32f0-a6b5-4f9e6d67a929",
                                "text": "Que ce soit pour la location d’une maison confortable, d’un condo douillet ou d’un studio de luxe avec vue sur le Mont-Sainte-Anne, consultez nos offres."
                            },
                            {
                                "example_id": "92bd887c-77dc-49ce-a771-2c53b663db5f",
                                "sense_id": "07b10a8b-7e35-32f0-a6b5-4f9e6d67a929",
                                "text": "C’est la grande mode, les promoteurs réhabilitent d’anciens immeubles et les partagent en condos. En général, ce n’est pas donné, surtout que c’est vert, comme coin."
                            },
                            {
                                "example_id": "34bd5b20-5e6b-4941-9248-5bec280d4420",
                                "sense_id": "07b10a8b-7e35-32f0-a6b5-4f9e6d67a929",
                                "text": "Sur la droite, pour faire le pendant à cette laideur, quelques complexes de condos de nouveaux riches s’étiraient jusqu’à la pointe de Cabana."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
