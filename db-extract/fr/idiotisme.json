        "fr-extract.jsonl": [
            {
                "entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                "word": "idiotisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "86f15539-fb7a-41aa-9261-6812cd23e030",
                        "entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "tags": [
                            "plural"
                        ],
                        "form": "idiotismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                        "entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "glosses": [
                            "Construction, locution propre à une langue et particulière à son génie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fcf4192b-e31b-4c7a-bfcd-4f9dafee5f40",
                                "sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                                "text": "Cette maison n’est plus un amas de pierres superposées architectoniquement ; non, ce mot est, dans la langue des flaneurs, un idiotisme intraduisible."
                            },
                            {
                                "example_id": "4e9e3f72-d960-464b-86c2-f27817691de2",
                                "sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                                "text": "Beaucoup de ces tournures, et particulièrement les idiotismes de figures, constituent des bizarreries dans la langue même qui les a enfantées ; […]."
                            },
                            {
                                "example_id": "257b19cb-e0f7-44cb-95c3-be153de02041",
                                "sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                                "text": "Les idiotismes réguliers n’ont besoin d’aucune autre attention, que d’être expliqués littéralement, pour être ramenés ensuite autour de la langue naturelle que l’on parle."
                            }
                        ]
                    },
                    {
                        "sense_id": "f3bab2e6-7350-3a09-bdd6-2c6a5940b6f5",
                        "entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "glosses": [
                            "Façon usuelle d'aborder un problème simple dans un langage de programmation (les langages de programmation ne donnent pas de sens spéciaux à des combinaisons d'éléments qui ont déjà chacun leur sens, donc idiotisme ne peut signifier la même chose que dans les langues naturelles)."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "de071132-64d1-457b-87a3-910295fb93d9",
                                "sense_id": "f3bab2e6-7350-3a09-bdd6-2c6a5940b6f5",
                                "text": "Le fichier à formater est précédé du fichier standard init.me qui contient tous mes idiotismes généraux et du fichier FT.me ou IDS.me où se trouvent tous les paramètres dépendants de l'imprimante cible (taille du papier notamment)."
                            }
                        ]
                    },
                    {
                        "sense_id": "6126c3e2-7fcf-3c58-a176-4724bb4389bc",
                        "entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "glosses": [
                            "Idiotie ; absence d’intelligence ; bêtise ; stupidité."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "fbdffb55-a61f-4c88-9f17-3274d658485a",
                                "sense_id": "6126c3e2-7fcf-3c58-a176-4724bb4389bc",
                                "text": "J’allai m’accouder sur la balustrade qui dominait les fossés de ceinture, et j’y restai je ne sais combien de temps dans des distractions de pur idiotisme."
                            },
                            {
                                "example_id": "23b3ffd3-d285-4932-81f3-bae7bceb4924",
                                "sense_id": "6126c3e2-7fcf-3c58-a176-4724bb4389bc",
                                "text": "Dans le monde intellectuel: l'illumination des esprits obscurs, qui, de l'impuissance, de l'ignorance et de l’idiotisme, passent subitement à la puissance de l'éloquence et de la plus haute sagesse."
                            },
                            {
                                "example_id": "fcec351f-d3bc-42a1-8176-007365738f46",
                                "sense_id": "6126c3e2-7fcf-3c58-a176-4724bb4389bc",
                                "text": "Le jeune docteur prometteur, opposé aux méthodes de son maître, se lance dans un défi irréfléchi : faire parler un patient atteint d’idiotisme, selon le diagnostic…"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0f72acf4-2994-4984-8327-43f443c90eec",
                        "source_entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "source_sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                        "source_sense_description": "Construction, locution propre à une langue.",
                        "target_lang_word": "idiom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59d87e37-8c8d-4f6d-8ecf-ad670d282f6c",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "In English, idiom requires the indefinite article in a phrase such as \"she's an engineer\", whereas in Spanish, idiom forbids it."
                                            },
                                            {
                                                "example_id": "251e739c-fe54-45ed-9e43-37d875570181",
                                                "sense_id": "6a29f182-75be-3b5b-baa1-c50b7c4fbb3c",
                                                "text": "Some of the usage prescriptions improved clarity and were kept; others that yielded discordant violations of idiom were eventually revised."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A manner of speaking, a mode of expression peculiar to a language, language family, or group of people.",
                                            "A programming construct or phraseology that is characteristic of the language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83ed047a-020a-4bdf-92d8-b8bd6707f9af",
                                                "sense_id": "1ce0d470-657d-39f6-a17f-9844b552116d",
                                                "text": "I have to use the same assignment and call to raw_input in two places. How can I avoid that? I can use the while True/break idiom: […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "A language or language variety; specifically, a restricted dialect used in a given historical period, context etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "694ce1c5-20d5-41ca-94e1-4514efdf8a2d",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "In the idiom of the day, they were sutlers, although today they'd probably be called vendors."
                                            },
                                            {
                                                "example_id": "9364d6fd-b949-416f-bd8f-3126dd3dee8c",
                                                "sense_id": "85542318-9dde-3c72-949f-c9dfffd01684",
                                                "text": "Many parents and teachers have become irritated to the point of distraction at the way the weed-style growth of \"like\" has spread through the idiom of the young."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An established phrasal expression whose meaning may not be deducible from the literal meanings of its component words."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5db5e533-89e7-4d96-996a-2da4bc4ae757",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "She often spoke in idioms, pining for salad days and complaining about pots calling the kettle black."
                                            },
                                            {
                                                "example_id": "4d267c6a-d6ab-4038-a898-cb5fa85f273c",
                                                "sense_id": "ede583ed-43b7-3680-9f82-2d38a0609ddd",
                                                "text": "You’re history, we say […]. Surely it is an American idiom. Impossible to imagine a postwar European saying, “You’re history. . . . That’s history,” meaning fuhgeddaboudit, pal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                        "entry_id": "70d298d8-3f52-378f-8357-7a234f5c5ad4",
                                        "glosses": [
                                            "An artistic style (for example, in art, architecture, or music); an instance of such a style."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "416762a8-e688-4c82-9ce0-cf636b403e6a",
                                                "sense_id": "0668da73-7b3a-3a29-9a5a-03b1d5ee14d3",
                                                "text": "the idiom of the expressionists"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f29963e2-60c3-4e89-9b6b-ae48ea38deb4",
                        "source_entry_id": "f60e1e54-5d87-3d9a-8431-3ecdcef875a8",
                        "source_sense_id": "395c888f-9cfb-3e03-a008-ee0a0fc35b42",
                        "source_sense_description": "Construction, locution propre à une langue.",
                        "target_lang_word": "idiomatic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "idiomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Pertaining or conforming to idiom, the natural mode of expression of a language."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "016a989f-dd04-4547-81a6-cd7fa52d2f92",
                                                "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                                "text": "The inclusion or omission of definite articles follows idiomatic norms in each language and depends on context and intent."
                                            },
                                            {
                                                "example_id": "e4011cd9-812c-4d5a-8bf6-22b4bd1d4d3b",
                                                "sense_id": "f7be63b8-0b17-358c-a6a3-a00a37048fc5",
                                                "text": "In English, the only idiomatic position for a pronoun as the object of a phrasal verb is before the particle, whereas a noun as object can fall either before or after the particle; thus only he picked them up but either he picked his tools up or he picked up his tools."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0f599bea-7f90-3f58-9d67-a0c7177564fe",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Resembling or characteristic of an idiom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5741e30f-b1c7-489f-9b13-b949aae50516",
                                                "sense_id": "0f599bea-7f90-3f58-9d67-a0c7177564fe",
                                                "text": "An idiomatic phrase that warns us against Pollyannaism is \"don't count your chickens before they're hatched\"."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cfe5a75-c3a9-3493-966c-1a822391a45a",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Using many idioms."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "afac8abb-e187-3b77-b2bf-fcc2df14aa8f",
                                        "entry_id": "31568879-885a-3ba4-9fa1-1c00c74cb14b",
                                        "glosses": [
                                            "Relating to parts or pieces which are written both within the natural physical limitations of the instrument and human body and, less so or less often, the styles of playing used on specific instruments."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "idiomatic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0e58aafd-9adc-39de-9652-26e5f4fc8389",
                                        "entry_id": "19a47327-a2a7-39e6-97f6-418bb2e5c5f2",
                                        "glosses": [
                                            "Synonym of idiom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e9fd32c-8528-4934-9005-31d931976e89",
                                                "sense_id": "0e58aafd-9adc-39de-9652-26e5f4fc8389",
                                                "text": "A preprocessing (or text normalization) module is necessary as a front end, since TTS [text-to-speech] systems should in principle be able to read any text, including numbers, abbreviations, acronyms, and idiomatics in any format."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
