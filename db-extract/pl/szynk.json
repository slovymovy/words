                "senses": [
                    {
                        "sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                        "entry_id": "de60829e-ab1a-3c1c-93db-822c139b99b5",
                        "glosses": [
                            "miejsce sprzedaży i degustacji napojów alkoholowych"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "5d25b70b-6bf3-44d5-be5b-51b11d72c095",
                                "sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                                "text": "Fabryka koniaku znajduje się w każdym szynku."
                            },
                            {
                                "example_id": "f69c7354-9ece-4cf3-8f84-0cefebf6e4c7",
                                "sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                                "text": "A kiedy konisko schorzałe zdechnie na środku rynku, / Na śmierć się, bracie, zapijesz w brudnym, podmiejskim szynku."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "3d4df755-b94a-3922-841d-87383069cbf1",
                        "entry_id": "de60829e-ab1a-3c1c-93db-822c139b99b5",
                        "glosses": [
                            "sprzedaż napojów alkoholowych"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1.2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f5e9ef16-0ef7-4a34-a878-674947996340",
                        "source_entry_id": "de60829e-ab1a-3c1c-93db-822c139b99b5",
                        "source_sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                        "target_lang_word": "taproom",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taproom",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d9cff47d-273f-3fe4-b3c9-eb6e374aa920",
                                        "entry_id": "1e446c09-b605-3239-8088-089af923a7e1",
                                        "glosses": [
                                            "A room where alcoholic beverages are served on tap; a bar or barroom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "508e87c0-78f3-41a5-91f5-f8ef499ed1d3",
                                                "sense_id": "d9cff47d-273f-3fe4-b3c9-eb6e374aa920",
                                                "text": "Dusty left the taproom of the tavern and wandered into the small arcade in back."
                                            },
                                            {
                                                "example_id": "3e1342d4-89e4-4093-b685-8fb971c13c55",
                                                "sense_id": "d9cff47d-273f-3fe4-b3c9-eb6e374aa920",
                                                "text": "On the other hand, to arrive after dusk, when the multitude of garish little public-houses are lit up, giving glimpses of crowded jostling bars and taprooms, is an introduction to a fine city well calculated to affect even the most nonchalant."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b96e09ab-1921-4d7b-b8da-7c2652de8f70",
                        "source_entry_id": "de60829e-ab1a-3c1c-93db-822c139b99b5",
                        "source_sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                        "target_lang_word": "taberna",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taberna",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "949503cf-213c-3338-a0e9-058784293050",
                                        "entry_id": "459421f9-9658-3843-9b57-bed00948af86",
                                        "glosses": [
                                            "Bar tradicional, que sirve también como lugar de reunión y social de las gentes de un lugar."
                                        ],
                                        "tags": [
                                            "Restaurantes"
                                        ],
                                        "examples": [],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16d7992a-4b84-4291-ae64-79cc55aee8cd",
                        "source_entry_id": "de60829e-ab1a-3c1c-93db-822c139b99b5",
                        "source_sense_id": "dfc58acc-5462-368b-b0cc-368d6e6123c7",
                        "target_lang_word": "Schenke",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schenke",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                        "entry_id": "7179cc62-5ea6-3619-83f0-ba1898ae8887",
                                        "glosses": [
                                            "kleiner Alkohol-Ausschank-Betrieb"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84b8002e-5e5d-4846-ab52-25bf7c30f6e5",
                                                "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                                "text": "Komm lass uns in die kleine Schenke am Hafen gehen."
                                            },
                                            {
                                                "example_id": "4d889531-9aa1-4665-9f4d-bb3c10231e48",
                                                "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                                "text": "„Dann würde Saint-Vith dunkel sein, die Schenke eine Höhle aus Spinnweblicht.“"
                                            },
                                            {
                                                "example_id": "d02eb648-73d2-4b37-90a9-d17df4b72fec",
                                                "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                                "text": "„Nachdem er etwa eine halbe Werst an der Queue der Kolonne geritten war, machte er bei einem alleinstehenden, verfallenen Hause, anscheinend einer ehemaligen Schenke, an einer Wegegabelung halt.“"
                                            },
                                            {
                                                "example_id": "8442d3cb-0289-439a-b55f-ae84deabd7f2",
                                                "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                                "text": "„Aus den beiden Schenken herüber klangen die schnarrenden Töne der zwei Geigen, und das Lichterschießen war erst recht in Gang gekommen.“"
                                            },
                                            {
                                                "example_id": "9707f5ec-1bfe-445d-9970-103a6a3d491c",
                                                "sense_id": "0af0676d-bc36-3fc8-8444-4973dc69b26a",
                                                "text": "„Er wäre gern in eine Schenke gegangen, um seinen Durst zu stillen, aber er besaß nur noch wenige Schillinge.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
