            "senses": [
                {
                    "sense_id": "e7e41226-0739-38b4-932b-62e2bce1b914",
                    "sense_definition": "Une personne indéterminée ou non précisée.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "personne_indeterminee",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il y a <w>quelqu'un</w> à la porte qui attend pour vous voir."
                        },
                        {
                            "text": "Je voudrais poser une question à <w>quelqu'un</w> qui parle français."
                        }
                    ],
                    "common_phrases": [
