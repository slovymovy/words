        "nl-extract.jsonl": [
            {
                "entry_id": "04a1fded-744d-3f58-8f14-a05e4cc3caa0",
                "word": "gelach",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "72b8a804-7a26-3d44-ac34-c5d19463a7fb",
                        "entry_id": "04a1fded-744d-3f58-8f14-a05e4cc3caa0",
                        "glosses": [
                            "het lachen; uiting van een vrolijke stemming"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be4eba2e-993f-4cd2-9b89-6cf6919ba024",
                                "sense_id": "72b8a804-7a26-3d44-ac34-c5d19463a7fb",
                                "text": "Hun gelach was al van ver hoorbaar."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "dc9d5af3-421a-4925-9fef-cfabd8892e5e",
                        "source_entry_id": "04a1fded-744d-3f58-8f14-a05e4cc3caa0",
                        "source_sense_id": "72b8a804-7a26-3d44-ac34-c5d19463a7fb",
                        "source_sense_description": "het lachen",
                        "target_lang_word": "Lachen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lachen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                        "entry_id": "7137ea23-6e2c-35c9-b66e-351474c207c7",
                                        "glosses": [
                                            "Ausdruck der Belustigung, der Freude"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0dac10b8-04aa-4b55-8378-b3db8f6627bc",
                                                "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                                "text": "„Viel Lachen aber verrät einen schwachen Geist; und großen Geistern ist das eigen, daß sie andere gern vor Verachtung sichern, sich selbst aber nur mit den Größten unter den Menschen vergleichen.“"
                                            },
                                            {
                                                "example_id": "20e99346-e27e-4a49-b3d1-15209f214186",
                                                "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                                "text": "„Ich konnte mir ein Lachen nicht verkneifen.“"
                                            },
                                            {
                                                "example_id": "61f6476d-3968-42ff-8d91-c48beef38ee1",
                                                "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                                "text": "„Kaum hat sich die Überraschung ins erneuerte Stimmengewirr aufgelöst, ins Kichern und Lachen hier und dort, folgt der Auftritt von Vater Jesko.“"
                                            },
                                            {
                                                "example_id": "40e78bff-895e-4f6c-bdd3-beba5adda05b",
                                                "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                                "text": "„Und dann ist da ja auch, sehr bedeutsam, ein großer biographischer Unterschied: das Lächeln bei Neugeborenen ist lange vor dem Lachen da – auch wenn oft schon etwas als Lächeln gedeutet wird, was noch kaum eines ist.“"
                                            },
                                            {
                                                "example_id": "beaa949a-3bf7-41f3-9348-3d645436dae4",
                                                "sense_id": "75aa8dea-2416-3030-a8df-6285c23c5397",
                                                "text": "„Zwischendurch äffen die Hosts und ihr Gast Bewegungen von behinderten Sportlern und Sportlerinnen nach, kriegen sich vor Lachen nicht mehr ein.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            },
