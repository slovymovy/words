                "senses": [
                    {
                        "sense_id": "cd2631a3-1854-368f-9b9f-89cbf8f3ea6f",
                        "entry_id": "f3d5236a-98f9-35f4-9866-e43910a26e41",
                        "glosses": [
                            "auf einer Parteivereinbarung, nach der der Rücktritt von einem Vertrag unter Zahlung eines Geldbetrages ermöglicht wird, beruhende Zahlung im Rücktrittsfalle"
                        ],
                        "tags": [
                            "Privatrecht"
                        ],
                        "examples": [
                            {
                                "example_id": "ba880f86-941c-403b-b98d-18a164a59323",
                                "sense_id": "cd2631a3-1854-368f-9b9f-89cbf8f3ea6f",
                                "text": "Es wird vereinbart, dass der Rücktritt vom Vertrag abgesehen von gesetzlichen Rücktrittsrechten nur unter Zahlung eines Reugeldes in bestimmter Höhe zulässig ist."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
