                ],
                "senses": [
                    {
                        "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                        "entry_id": "604332ce-d381-363c-a36a-db7719b50f62",
                        "glosses": [
                            "drahtloses Kommunikationssystem, umgangssprachlich meist auf mobile Handy-, Smartphone und Tablet-Kommunikation bezogen, aber beispielsweise auch Satellitentelefonie, Taxifunk, CB-Sprechfunk oder Telemetrie umfassend"
                        ],
                        "tags": [
                            "Telekommunikation",
                            "Nachrichtentechnik"
                        ],
                        "examples": [
                            {
                                "example_id": "47d4fa85-3383-4f5b-97f6-1e04fea3c88a",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "Die Preise für Mobilfunk wurden aufgrund der Regularien der EU etwas niedriger."
                            },
                            {
                                "example_id": "1014ab90-0cf1-4107-a70a-aeecd25241c7",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "Alle Messwerte werden sofort per Mobilfunk an das Berliner Universitätsklinikum Charité übermittelt."
                            },
                            {
                                "example_id": "d0b00792-d68a-4c52-a66f-b22f56fbf9bc",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "Beim Glasfaserausbau hinkt Deutschland hinter anderen Ländern hinterher. Für die fünfte Generation des Mobilfunks, die deutlich schnellere Netze verspricht, soll die Infrastruktur möglichst früh bereitgestellt werden."
                            },
                            {
                                "example_id": "29b172c2-347a-4206-a720-247d91655326",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "Sie sind ein Wahrzeichen Großbritanniens – die roten Telefonzellen. Doch in Zeiten des Mobilfunks werden immer mehr davon stillgelegt."
                            },
                            {
                                "example_id": "daa9d891-9a9e-4aab-b3bc-a31ea075b6ee",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "[Das Dorf] Tabo ist auch noch nicht an das Internet angeschlossen und Mobilfunk funktioniert nur über die staatliche Telefongesellschaft."
                            },
                            {
                                "example_id": "7d07cc27-a08f-420a-8950-3d58ad10c831",
                                "sense_id": "500d109d-cd0d-388d-9094-8b7254386a59",
                                "text": "Die mit Mobilfunk und GPS ausgestatteten Suchhunde können auf Grund von Funklöchern in dem bergigen Gebiet, das der Braunbär im Moment bevorzugt, von den Suchtrupps nicht oder nur schwer verfolgt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
