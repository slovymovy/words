                "senses": [
                    {
                        "sense_id": "5ec90fc3-12e1-3290-b512-b88d22e9a0ae",
                        "entry_id": "65a2fcaa-1e2a-3ba9-bcdd-ddcbebe3fb0b",
                        "glosses": [
                            "полит. направленный против коммунизма или коммунистов"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30b0dfbe-ca60-440f-b283-a5b97f29c044",
                                "sense_id": "5ec90fc3-12e1-3290-b512-b88d22e9a0ae",
                                "text": "Антикоммунистические взгляды были особенно в ходу во времена «Холодной войны»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a4e9a6ef-79e5-47cc-a90d-a06e1739876b",
                        "source_entry_id": "65a2fcaa-1e2a-3ba9-bcdd-ddcbebe3fb0b",
                        "source_sense_id": "5ec90fc3-12e1-3290-b512-b88d22e9a0ae",
                        "target_lang_word": "anticommunist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "anticommunist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ccfead02-ff73-330b-b51e-8645ab95a070",
                                        "entry_id": "62f094a2-3d37-31da-94b1-8c1a71c91870",
                                        "glosses": [
                                            "Opposed to the tenets of communism."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34754ebe-f5e3-492e-ba08-79c5557c192d",
                                                "sense_id": "ccfead02-ff73-330b-b51e-8645ab95a070",
                                                "text": "The future is anticommunist!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "anticommunist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f08dc772-34dd-38ac-ae43-1f2c47b454e5",
                                        "entry_id": "43aaec7a-4440-37f6-843a-84d50dacdc48",
                                        "glosses": [
                                            "One who is opposed to the tenets of communism."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28f7c672-260a-4c73-a09b-b07f22af429a",
                        "source_entry_id": "65a2fcaa-1e2a-3ba9-bcdd-ddcbebe3fb0b",
                        "source_sense_id": "5ec90fc3-12e1-3290-b512-b88d22e9a0ae",
                        "target_lang_word": "antikommunistisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antikommunistisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                        "entry_id": "6e2f48d1-177d-3010-883a-86f9ff13d77b",
                                        "glosses": [
                                            "gegen den Kommunismus gerichtet, gegen den Kommunismus eingestellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17fdd45e-afe3-4944-9914-988dc0720a80",
                                                "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                                "text": "„Damit versuchte er, die Rivalität zwischen ZANU und ZAPU auf eine zwischenstaatliche Ebene zu heben, indem er die ZAPU dem Lager des konservativeren und antikommunistischen Kaunda zurechnete.“"
                                            },
                                            {
                                                "example_id": "454456e6-f532-4936-8502-28f7c8e9b381",
                                                "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                                "text": "„Er war so antikommunistisch eingestellt, dass er als einer der wenigen Politiker Südkaliforniens sogar die Flüchtlinge mit offenen Armen begrüßte.“"
                                            },
                                            {
                                                "example_id": "386a7f57-1142-41ba-a1d6-7a9085e989ba",
                                                "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                                "text": "„Yehushua Globerman wurde 1905 in Weißrussland geboren und saß in den 1920er Jahren wegen antikommunistischer Aktivitäten in einem sowjetischen Gefängnis, wurde aber nach drei Jahren aus der Haft entlassen, nachdem Maxim Gorki, ein Freund seiner Eltern, sich für ihn eingesetzt hatte.“"
                                            },
                                            {
                                                "example_id": "70ff0b25-b4dd-47ca-925b-a53f4b6f0a53",
                                                "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                                "text": "„Trent wollte, dass ich einer antikommunistischen Organisation in Mittelamerika über eins unserer Konten Gelder zukommen ließ.“"
                                            },
                                            {
                                                "example_id": "3235d1ad-68bd-40bd-b5db-2ad9729b8463",
                                                "sense_id": "22f58fc2-6556-32e3-aa9a-691ecc5b581d",
                                                "text": "„Genau wie in Vietnam, wo es der CIA vorzog, den Drogenhandel antikommunistischer Guerillas, die vom CIA finanziert wurden, zu ignorieren, entschlossen sich die USA auch in Afghanistan, die geheimen Absprachen zwischen den Mudschaheddin, den pakistanischen Drogenhändlern und Militärkreisen zu ignorieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
