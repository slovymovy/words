                "senses": [
                    {
                        "sense_id": "a1499179-5680-3602-add8-8310ec631b80",
                        "entry_id": "67520048-e255-3d40-a374-311537495d1e",
                        "glosses": [
                            "am Rundfunk- oder Fernsehempfänger angebrachte Vorrichtung zur Erfassung statistischer Werte (wie zum Beispiel Einschaltzeit oder –dauer)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57ad20c4-3141-4372-ba24-ab086aaf58b1",
                                "sense_id": "a1499179-5680-3602-add8-8310ec631b80",
                                "text": "„Die Firma baut in die Rundfunk- und Fernsehempfänger repräsentativ ausgesuchter Verbraucher kleine Geräte (Audimeter) ein, die registrieren, zu welchen Zeiten die verschiedenen Stationen und Programme empfangen werden.“"
                            },
                            {
                                "example_id": "26c4c8d2-f239-42d1-9026-ec42185f2215",
                                "sense_id": "a1499179-5680-3602-add8-8310ec631b80",
                                "text": "„Wie das Audimeter ist es ein aktives Erfassungsgerät, das von den Zuschauern (nun per Fernbedienung) gehandhabt werden muß.“"
                            },
                            {
                                "example_id": "6ee87012-b451-407f-a180-579406c1425a",
                                "sense_id": "a1499179-5680-3602-add8-8310ec631b80",
                                "text": "„Mit einer Weiterentwicklung des Audimeters begann Nielsen 1950 die Erfassung der Einschaltquoten im Fernsehen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
