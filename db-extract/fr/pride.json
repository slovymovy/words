                        "sense_id": "86abf8b5-6291-35ee-9989-521b8b163193",
                        "entry_id": "7c39e817-6693-32a4-b374-3f72e570fc9f",
                        "glosses": [
                            "Manifestation de visibilité de la population LGBTI, aussi appelée LGBT pride, marche des fiertés ou marche de visibilité."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "b73787ed-3110-4ca0-bb76-e74c1acccdd0",
                                "sense_id": "86abf8b5-6291-35ee-9989-521b8b163193",
                                "text": "Biphobie à la pride de Melbourne"
                            },
                            {
                                "example_id": "a2b1f2b4-6848-48d3-b3dc-e198a902b1f8",
                                "sense_id": "86abf8b5-6291-35ee-9989-521b8b163193",
                                "text": "Par exemple, je suis quelqu’un qui participe aux prides, où beaucoup de gens viennent pour leur côté festif justement."
                            },
                            {
                                "example_id": "1103768d-28bb-4aed-a76c-abae3a6e4c8e",
                                "sense_id": "86abf8b5-6291-35ee-9989-521b8b163193",
                                "text": "Une pride doit se tenir le dimanche 18 juin à Angoulême."
                            },
                            {
                                "example_id": "f5d44869-04ac-4a85-b0e7-267d45739e3a",
                                "sense_id": "86abf8b5-6291-35ee-9989-521b8b163193",
                                "text": "Une \"pride\" revendicative défile dans les rues de Crest."
                            }
                        ]
                    }
                ],
