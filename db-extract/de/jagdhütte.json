                    {
                        "sense_id": "a90e936b-ecd3-374e-8aac-59fac2ee509c",
                        "entry_id": "4b24acf4-2ca1-308c-b6b0-cfd4e2c0ecf5",
                        "glosses": [
                            "kleines Haus im Wald, das Jägern als Unterkunft dient"
