                "senses": [
                    {
                        "sense_id": "ccc2d9b0-5f61-3751-a6eb-53e94529506f",
                        "entry_id": "0cd7a641-4ec8-3b99-abbf-fb2141ca3284",
                        "glosses": [
                            "Wissen in praktischen Bereichen des Lebens, zum Beispiel über Gesundheit, Landwirtschaft oder Sozialverhalten; besonderes Merkmal ist die regionsspezifische Überlieferung von Generation zu Generation, ohne zwingende schriftliche Aufzeichnung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "662777dd-6e30-48ba-8aee-8be781af4ca4",
                                "sense_id": "ccc2d9b0-5f61-3751-a6eb-53e94529506f",
                                "text": "Volksweisheiten sind nicht immer wissenschaftlich korrekt, enthalten oft aber einen wahren Kern."
                            },
                            {
                                "example_id": "bf837ea6-5fbc-4a95-bf3f-84ffe18b5d08",
                                "sense_id": "ccc2d9b0-5f61-3751-a6eb-53e94529506f",
                                "text": "„Der moralische Kompass für den Alltag speist sich mehr aus den regionalen, in der jeweiligen Mundart verfassten Volksweisheiten, Dichtung und Prosa als aus islamisch-orthodoxem Gedankengut.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
