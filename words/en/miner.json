{
    "word_family": [
        "mine",
        "mining",
        "mineworker",
        "mineowner"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "07ff5412-544a-3c07-a58c-bbdbd6d8306a",
                    "sense_definition": "A person who works in a mine to extract minerals, coal, or other natural resources.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "mining_profession",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>miner</w> spent many hours working deep underground to find coal.",
                            "target_lang_translations": {
                                "ru": "<w>Шахтёр</w> проводил много часов, работая глубоко под землей в поисках угля."
                            }
                        },
                        {
                            "text": "A group of <w>miners</w> were stuck underground after a shaft caved in.",
                            "target_lang_translations": {
                                "ru": "Группа <w>шахтёров</w> оказалась заблокирована под землей после обрушения ствола шахты."
                            }
                        }
                    ],
                    "synonyms": [
                        "mineworker"
                    ],
                    "common_phrases": [
                        "coal miner",
                        "gold miner",
                        "skilled miner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, работающий в шахте по добыче полезных ископаемых, угля или других природных ресурсов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шахтёр",
                                "target_lang_sense_clarification": "рабочий, работающий непосредственно в шахте"
                            },
                            {
                                "target_lang_word": "горняк",
                                "target_lang_sense_clarification": "общее название работника горной промышленности"
                            },
                            {
                                "target_lang_word": "горнорабочий",
                                "target_lang_sense_clarification": "официальное название профессии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "563fb9eb-0788-3d26-9faa-1db6faa56387",
                    "sense_definition": "A person or entity that uses computer hardware to process transactions and earn cryptocurrency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cryptocurrency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The first <w>miner</w> to solve each puzzle would be awarded fifty new bitcoins.",
                            "target_lang_translations": {
                                "ru": "Первый <w>майнер</w>, решивший каждую задачу, получал в награду пятьдесят новых биткоинов."
                            }
                        },
                        {
                            "text": "Every bitcoin <w>miner</w> needs a powerful computer to compete for rewards.",
                            "target_lang_translations": {
                                "ru": "Каждому биткоин-<w>майнеру</w> нужен мощный компьютер, чтобы бороться за вознаграждение."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bitcoin miner",
                        "crypto miner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или организация, использующие компьютерное оборудование для обработки транзакций и получения криптовалюты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "майнер",
                                "target_lang_sense_clarification": "человек, занимающийся добычей криптовалюты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1fe1bfc0-e09c-3eff-96d1-05b6bc55a15b",
                    "sense_definition": "Software or hardware specifically designed to create new units of cryptocurrency.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "cryptocurrency",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He installed a new <w>miner</w> on his server to earn digital currency.",
                            "target_lang_translations": {
                                "ru": "Он установил новый <w>майнер</w> на свой сервер, чтобы зарабатывать цифровую валюту."
                            }
                        },
                        {
                            "text": "The move would have probably prevented Kazakhstan-based <w>miners</w> from accessing the network.",
                            "target_lang_translations": {
                                "ru": "Этот шаг, вероятно, закрыл бы доступ к сети для <w>майнеров</w>, базирующихся в Казахстане."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hardware miner",
                        "software miner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Программное обеспечение или оборудование, специально разработанное для создания новых единиц криптовалюты."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "майнер",
                                "target_lang_sense_clarification": "программа или устройство для добычи криптовалюты"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "45172ccf-dbc4-33f0-9a7e-ad00bf18fc5e",
                    "sense_definition": "A soldier or specialist who operates or lays explosive mines.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "military",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The military <w>miner</w> carefully placed the explosives along the bridge.",
                            "target_lang_translations": {
                                "ru": "Военный <w>минёр</w> осторожно заложил взрывчатку вдоль моста."
                            }
                        },
                        {
                            "text": "As a combat <w>miner</w>, his job was to clear the path for the infantry.",
                            "target_lang_translations": {
                                "ru": "Как боевой <w>сапёр</w>, он должен был расчищать путь для пехоты."
                            }
                        }
                    ],
                    "common_phrases": [
                        "combat miner"
                    ],
                    "target_lang_definitions": {
                        "ru": "Солдат или специалист, который устанавливает или обслуживает взрывные мины."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "минёр",
                                "target_lang_sense_clarification": "специалист по минированию и разминированию"
                            },
                            {
                                "target_lang_word": "сапёр",
                                "target_lang_sense_clarification": "военнослужащий инженерных войск"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2110474f-496f-3c88-943d-823ea9d4ded4",
                    "sense_definition": "Any bird of several species of Australian honeyeaters in the genus Manorina.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The noisy <w>miner</w> is a common sight in many Australian gardens.",
                            "target_lang_translations": {
                                "ru": "Шумная <w>манорина</w> — обычное явление во многих австралийских садах."
                            }
                        },
                        {
                            "text": "We spotted a rare species of <w>miner</w> during our trip to the outback.",
                            "target_lang_translations": {
                                "ru": "Во время нашей поездки в глушь мы заметили редкий вид <w>манорины</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "noisy miner",
                        "bell miner"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Australia"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая птица из нескольких видов австралийских медососов рода Manorina."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "манорина",
                                "target_lang_sense_clarification": "род австралийских птиц-медососов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9368c5e1-d587-34a2-abd4-217b652a1f50",
                    "sense_definition": "Any bird of several species of South American ovenbirds in the genus Geositta.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "birds",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The common <w>miner</w> is known for building its nest in tunnels in the ground.",
                            "target_lang_translations": {
                                "ru": "Обыкновенный <w>земляной печник</w> известен тем, что строит гнезда в туннелях в земле."
                            }
                        },
                        {
                            "text": "Ornithologists traveled to the Andes to study the behavior of the local <w>miner</w>.",
                            "target_lang_translations": {
                                "ru": "Орнитологи отправились в Анды, чтобы изучить поведение местного <w>земляного печника</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "common miner"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "South America"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая птица из нескольких видов южноамериканских печников рода Geositta."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "земляной печник",
                                "target_lang_sense_clarification": "род южноамериканских птиц"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "5fa49f85-1077-3fce-b6f2-af3056d397f0",
                    "sense_definition": "A surname.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Miner</w> was appointed as the new director of the local museum.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Майнер</w> был назначен новым директором местного музея."
                            }
                        },
                        {
                            "text": "The <w>Miner</w> family has lived in this town for three generations.",
                            "target_lang_translations": {
                                "ru": "Семья <w>Майнер</w> живет в этом городе уже три поколения."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English surname"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Майнер",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f78afb35-1c65-38b6-9ea5-f447ecbf3c1d",
                    "sense_definition": "A small city located in Missouri, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The highway passes directly through the city of <w>Miner</w> in Missouri.",
                            "target_lang_translations": {
                                "ru": "Шоссе проходит прямо через город <w>Майнер</w> в штате Миссури."
                            }
                        },
                        {
                            "text": "They stopped for gas in <w>Miner</w> before continuing their road trip.",
                            "target_lang_translations": {
                                "ru": "Они остановились заправиться в <w>Майнере</w>, прежде чем продолжить свое путешествие."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "United States"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой город, расположенный в штате Миссури, США."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Майнер",
                                "target_lang_sense_clarification": "название города"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}