            },
            {
                "entry_id": "b5e551e0-85e0-3158-9779-bcba846d8e8c",
                "word": "underfoot",
                "pos": "adv",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "885c5add-89d8-39f3-a01e-ff67532bec46",
                        "entry_id": "b5e551e0-85e0-3158-9779-bcba846d8e8c",
                        "glosses": [
                            "Under one's foot or feet."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "16d049a9-45d9-44a7-91b7-cffbf445252d",
                                "sense_id": "885c5add-89d8-39f3-a01e-ff67532bec46",
                                "text": "The workers were all big, burly, hard-hearted men, tromping through the marsh in their heavy boots without sparing so much as a single thought for the masses of tiny frogs they crushed underfoot."
                            },
                            {
                                "example_id": "5dc81998-24cd-4dc4-b666-27015c7b4256",
                                "sense_id": "885c5add-89d8-39f3-a01e-ff67532bec46",
                                "text": "The green turf was velvet underfoot."
                            },
                            {
                                "example_id": "e536066b-db86-4003-9ba9-91ace60bdbab",
                                "sense_id": "885c5add-89d8-39f3-a01e-ff67532bec46",
                                "text": "With 3,600 h.p. underfoot, acceleration was reasonably brisk, but the flickering wheel-slip indicator light showed the prudence of not putting full power through the traction motors while there were traces of early-morning dampness on the rails."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1cf3175-bcc0-380f-9031-937f8361533f",
                        "entry_id": "b5e551e0-85e0-3158-9779-bcba846d8e8c",
                        "glosses": [
                            "In the way; situated so as to obstruct or hinder."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "f631104b-e3d8-4975-9bba-36eb6c039b0d",
                                "sense_id": "b1cf3175-bcc0-380f-9031-937f8361533f",
                                "text": "It would be easier to do a big project like that someday when we don't have a bunch of newcomers underfoot."
                            },
                            {
                                "example_id": "26840b39-67ef-497f-b808-62399f0d8a13",
                                "sense_id": "b1cf3175-bcc0-380f-9031-937f8361533f",
                                "text": "If you're not going to help, at least get out from underfoot."
                            }
                        ]
                    }
                ],
