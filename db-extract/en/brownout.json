                "senses": [
                    {
                        "sense_id": "2af7d367-c5fd-3b29-a546-e1e4b28dcbd5",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A period of low alternating current line voltage, causing a reduction in illumination."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "04991e15-9967-447e-a8b3-6d9fc8be8b12",
                                "sense_id": "2af7d367-c5fd-3b29-a546-e1e4b28dcbd5",
                                "text": "When demand for electricity exceeds the available supply, a brownout occurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "00dd1586-7e78-3d64-bc86-359402c929ea",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A temporary dimming of vision, usually with a brown hue and accompanied by loss of peripheral vision or tunnel vision."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a4c3340-d954-4efe-aa26-329b41965fc3",
                                "sense_id": "00dd1586-7e78-3d64-bc86-359402c929ea",
                                "text": "On rising suddenly from her chair she experienced a brownout and had to sit down again quickly."
                            }
                        ]
                    },
                    {
                        "sense_id": "5789b0a0-1b32-3951-b2db-27299d39a169",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A temporary closing of a fire station, usually due to budget restrictions."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aacc5470-e1ce-461f-b06a-f1a8691d34ab",
                                "sense_id": "5789b0a0-1b32-3951-b2db-27299d39a169",
                                "text": "Fire departments across the country have been forced to rely on rolling brownouts because of the recession."
                            }
                        ]
                    },
                    {
                        "sense_id": "d14f6fa5-0a53-34a4-8acc-cf4d841758d8",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A power outage during the day; distinguished from a blackout, which occurs at night."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "ee6e9c52-d74c-3cb0-9fe9-1c4120afb439",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A moment or period where something is weakened, diminished or less effective."
                        ],
                        "tags": [
                            "figuratively",
                            "uncommon"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "8e89be12-69b9-38d7-af6b-890c33638010",
                        "entry_id": "b4fbe1fd-034c-3844-a3f0-2131787f9f7a",
                        "glosses": [
                            "A blackout, regardless of time of day."
                        ],
                        "tags": [
                            "Australia",
                            "Hong-Kong",
                            "Philippines"
                        ],
                        "examples": [
                            {
                                "example_id": "a142f140-5728-4ed7-8852-e53a26838336",
                                "sense_id": "8e89be12-69b9-38d7-af6b-890c33638010",
                                "text": "Remember that you can't send or receive a fax if there is a brownout. ... Due to blackouts (the Philippine term is brownout), especially during the dry season, be prepared with a flashlight and don't forget to save your data in your PC."
                            }
                        ]
                    }
