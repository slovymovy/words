                    },
                    {
                        "sense_id": "fa094103-e09a-37b3-9a7c-6685b8544dba",
                        "entry_id": "64d1ab16-cd91-3cd6-a493-4f8ba11768f4",
                        "glosses": [
                            "One who endures adversity or hardship with an attitude of stoicism and persistence"
                        ],
                        "tags": [
                            "colloquial",
                            "dated",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "e7acd21b-0baa-497b-8652-c2d59c18a684",
                                "sense_id": "fa094103-e09a-37b3-9a7c-6685b8544dba",
                                "text": "[...]for Mr. Ruth, who in his mental travail has conducted himself like a real trouper."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e7e65199-ef6d-4ab4-b2db-2d6f1aa917c6",
                        "source_entry_id": "64d1ab16-cd91-3cd6-a493-4f8ba11768f4",
                        "source_sense_description": "a member of a theatrical company (a troupe)",
                        "target_lang_word": "acteur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "acteur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4c6d1cbd-2bad-377b-804d-3e1ac6f3debc",
                                        "entry_id": "04a765f9-af33-39ad-a998-13ee38e9264a",
                                        "glosses": [
                                            "Personne qui représente un personnage dans une pièce de théâtre, un film…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e819ba6-1362-4ab7-9034-13c08f77b04d",
                                                "sense_id": "4c6d1cbd-2bad-377b-804d-3e1ac6f3debc",
                                                "text": "Les acteurs sont prêts, on va commencer. - Il faut cinq acteurs pour jouer cette pièce. - On applaudit l’acteur, mais on siffla la pièce."
                                            },
                                            {
                                                "example_id": "7054e8e7-9960-422a-8d45-b0a16ae1876b",
                                                "sense_id": "4c6d1cbd-2bad-377b-804d-3e1ac6f3debc",
                                                "text": "Dans Peter Pan, George Darling et James Crochet sont incarnés par le même acteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8609e4f8-9b0a-3542-b091-2a26acb68c2c",
                                        "entry_id": "04a765f9-af33-39ad-a998-13ee38e9264a",
                                        "glosses": [
                                            "Personne qui exerce la profession de comédien."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d878eb4-8669-4c02-8d2d-1d16fcd23d95",
                                                "sense_id": "8609e4f8-9b0a-3542-b091-2a26acb68c2c",
                                                "text": "Dans leurs oupa-oupa, qui passent avec raison pour des danses très obscènes, les acteurs peignent par des pantomimes expressives toutes les passions qui les exaltent."
                                            },
                                            {
                                                "example_id": "d122c5fb-0549-4ee7-9446-e8a64b5fd281",
                                                "sense_id": "8609e4f8-9b0a-3542-b091-2a26acb68c2c",
                                                "text": "Se faire acteur, actrice. - Bon acteur. - Grand acteur. - Mauvais acteur. - Excellente actrice. - Former un acteur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "82ec5671-1d84-3609-97e9-453afc56ec68",
                                        "entry_id": "04a765f9-af33-39ad-a998-13ee38e9264a",
                                        "glosses": [
                                            "Personne qui a une part active dans la conduite, dans l’exécution d’une affaire."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "50290c14-5a24-4650-bc5e-07142bbb7426",
                                                "sense_id": "82ec5671-1d84-3609-97e9-453afc56ec68",
                                                "text": "Je revins sur mes pas, tant je comprenais que cet homme devait être l’acteur principal de quelque drame inconnu et terrible."
                                            },
                                            {
                                                "example_id": "5539f62a-2071-48ff-9800-06bb59e77720",
                                                "sense_id": "82ec5671-1d84-3609-97e9-453afc56ec68",
                                                "text": "Le crédit conso n'est plus en effet seulement l'affaire des filiales spécialisées des banques, des hypermarchés ou des constructeurs automobiles. De nouveaux acteurs sont apparus : les banques en ligne, notamment, qui désormais s'intéressent toutes à ce produit."
                                            },
                                            {
                                                "example_id": "8148645c-176b-48f9-abf9-5ff8ab13bc92",
                                                "sense_id": "82ec5671-1d84-3609-97e9-453afc56ec68",
                                                "text": "Enfin, on assiste à une internationalisation du trafic [de cocaïne], avec des acteurs qui ont pris pied en Amérique du Sud et qui sont capables d’organiser des cargaisons vers l’Europe. Ce sont des acteurs globaux, comme la Ndrangheta, la mafia calabraise, et les réseaux criminels turcs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "216149d2-a335-4e31-9c8d-a4c6605ab0f8",
                        "source_entry_id": "64d1ab16-cd91-3cd6-a493-4f8ba11768f4",
                        "source_sense_description": "a member of a theatrical company (a troupe)",
                        "target_lang_word": "actrice",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "actrice",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "71d2e46e-b1fa-3deb-9f95-e0addb153813",
                                        "entry_id": "5f642732-617c-3c2b-9ea3-fd083e16dc37",
                                        "glosses": [
                                            "Celle qui agit, qui intervient dans un processus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ccadf96-9718-4698-b337-f383fa2e89b3",
                                                "sense_id": "71d2e46e-b1fa-3deb-9f95-e0addb153813",
                                                "text": "Et si c’était la preuve que la France est bien en train de devenir, au plus profond d’elle-même, actrice du changement ?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                        "entry_id": "5f642732-617c-3c2b-9ea3-fd083e16dc37",
                                        "glosses": [
                                            "Celle qui joue un personnage, un rôle dans un spectacle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ad83c0bb-4875-4bb6-b9f9-f1bd74df19c7",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Les débutants, les bas-bleus, les actrices qui commencent et celles qui finissent leur carrière, auteurs et libraires caressent ou choyent ces plumes à tout faire."
                                            },
                                            {
                                                "example_id": "9093b921-b59c-4503-890b-83a5d4da4052",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Les actrices d’opéra-comique de ce temps-là ne se bornaient pas à roucouler un air ou une romance : on voulait encore qu'elles jouassent la comédie; et madame Favart représenta avec un rare talent Roxelane des Trois Sultanes, et tous les premiers rôles des ouvrages de son mari ou d'autres auteurs qui se disputaient ce charmant interprète."
                                            },
                                            {
                                                "example_id": "c1dc030b-1599-44a0-9d10-ad2befe9487b",
                                                "sense_id": "e98c1e12-0c75-3c2a-ae69-1f6e7901e4b3",
                                                "text": "Sensible au talent de l’actrice, Albert Camus lui confie le rôle de Martha pour la création du Malentendu en juin 1944."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
