                "senses": [
                    {
                        "sense_id": "8f4289e2-1c81-3c26-9501-0f1af6489799",
                        "entry_id": "3e6b285c-aa2b-30ff-9543-9903d2709a06",
                        "glosses": [
                            "horend bij één bepaalde sekse"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b1c476c3-2fa3-491d-9803-023ebc857fd0",
                                "sense_id": "8f4289e2-1c81-3c26-9501-0f1af6489799",
                                "text": "Misogynie is, zo lijkt het, niet specifiek geslachtsgebonden."
                            },
                            {
                                "example_id": "c420584a-a3c9-4792-9eaf-249ef6a896cc",
                                "sense_id": "8f4289e2-1c81-3c26-9501-0f1af6489799",
                                "text": ",,Er is onevenredigheid”, zegt neurobioloog Gina Rippon, auteur van het boek The Gendered Brain (Het Geslachtsgebonden Brein). ,,We moedigen meisjes aan om met jongens-dingen te spelen, maar niet andersom.” Dat is volgens haar een probleem omdat speelgoed “trainingsmogelijkheden” biedt."
                            },
                            {
                                "example_id": "3cc043c8-690e-402a-82a3-e44a08bd9911",
                                "sense_id": "8f4289e2-1c81-3c26-9501-0f1af6489799",
                                "text": "In Ierland en Nederland is gebleken dat extreem gedrag door gebrek aan seks niet geslachtsgebonden is en ook onder de nonnetjes veel voorkwam. Hun seksuele pesterijen waren vaak nog erger dan die van hun mannelijke collega’s."
                            }
                        ]
                    }
