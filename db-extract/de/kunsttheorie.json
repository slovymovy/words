                "senses": [
                    {
                        "sense_id": "4453aa9e-4447-3ae8-8552-46da79905b4c",
                        "entry_id": "62ee6c0f-3654-33b9-ac39-9b2286f91050",
                        "glosses": [
                            "Gedankenmodell zum Erklären von Kunst, sich mit Kunst beschäftigende Theorie"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4952d3f6-f545-4392-ba4a-a151144c4b19",
                                "sense_id": "4453aa9e-4447-3ae8-8552-46da79905b4c",
                                "text": "„Die Zeile muss dabei im Kontext einer Dichtungs- und Kunsttheorie gelesen werden, für die das nie da gewesene Neue kein absolutes Ideal war.“"
                            },
                            {
                                "example_id": "e7201187-5edb-4d33-abb1-7d9c22c361a3",
                                "sense_id": "4453aa9e-4447-3ae8-8552-46da79905b4c",
                                "text": "„In Kunsttheorie bringen sie einem nicht bei, dass ein zu großes Kompliment mehr wehtun kann als ein Schlag ins Gesicht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
