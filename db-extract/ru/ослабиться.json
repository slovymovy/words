                        "translation_id": "c8d1ce4e-c38a-4cce-b110-0a7402d79194",
                        "source_entry_id": "4b97a5ae-c960-3686-99e4-adfa16cb7ece",
                        "source_sense_id": "af2ce65c-b2f5-3075-be91-2a5aad90ec3b",
                        "target_lang_word": "weaken",
