                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d3533668-3624-448d-bbf7-c072c6091433",
                        "source_entry_id": "7e35411b-571f-3de4-8b03-4e59f9e3f379",
                        "source_sense_id": "196563ae-a11f-36e3-b820-f0cd994adfd0",
                        "target_lang_word": "Indien",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Indien",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                        "entry_id": "37e7b8d9-d6a4-3188-accd-0790eb079de3",
                                        "glosses": [
                                            "Staat in Südasien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7646356a-0fbf-48d3-b9a5-c191b669fb8e",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "„Indien ist ein multiethnischer Staat und mit 1,2 Milliarden Einwohnern (2009) das zweitbevölkerungsreichste Land und der bevölkerungsreichste demokratische Staat der Erde.“"
                                            },
                                            {
                                                "example_id": "179519fb-5c72-4d1c-8134-9cf7111d4c03",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "„Natürlich gehört Indien zu Asien.“"
                                            },
                                            {
                                                "example_id": "b235a927-f10c-44c4-b6da-c3eda6700445",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "Neu-Delhi ist die Hauptstadt von Indien."
                                            },
                                            {
                                                "example_id": "c8fa829d-f7d9-47c9-8496-5cfbcddfc508",
                                                "sense_id": "5edd3641-b74b-34f8-bce4-5c4569303923",
                                                "text": "Ich habe meinem Vater einen Bildband über das Indien von heute geschenkt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2f5dd55-cb19-4098-870c-a5d2cc6b74cc",
                        "source_entry_id": "7e35411b-571f-3de4-8b03-4e59f9e3f379",
                        "source_sense_id": "196563ae-a11f-36e3-b820-f0cd994adfd0",
                        "target_lang_word": "Индия",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Индия",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "2eca78c0-f1ce-3a85-8a47-5a09e0c83f2e",
                                        "entry_id": "4fa1ace2-70b3-3f9b-a2a0-a4b9fa2a08e1",
                                        "glosses": [
                                            "название государства в Южной Азии, территория которого омывается водами Аравийского моря на западе, Индийского океана на юге и Бенгальского залива на востоке, граничащая на северо-западе с Пакистаном, на севере — Китаем, Непалом и Бутаном, на востоке — с Бангладеш и Мьянма"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1e156630-7ca7-439b-805e-3ac9b9ea3f31",
                                                "sense_id": "2eca78c0-f1ce-3a85-8a47-5a09e0c83f2e",
                                                "text": "Индоарии, завоевавшие Северную Индию в XIV–XIII веках до нашей эры, пришли, возможно, из Центральной Азии ― или прошли через неё. Части исторической Индии и Центральной Азии были политически объединены в рамках Персидской империи (648–330 годы до нашей эры) и империи Александра Македонского (330–323 годы до нашей эры)."
                                            },
                                            {
                                                "example_id": "d25b292f-de7e-441e-9ca7-93f9d38c2fb4",
                                                "sense_id": "2eca78c0-f1ce-3a85-8a47-5a09e0c83f2e",
                                                "text": "В «Times» сообщают из Калькутты: «Далай-лама вместе с некоторыми тибетскими нотаблями бежал из Лхассы и перешёл через границу в Индию вследствие приближения китайских не-буддийских войск, которые грабят храмы»."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6789fff2-8b5b-3dae-bccf-862341d55c0f",
                                        "entry_id": "4fa1ace2-70b3-3f9b-a2a0-a4b9fa2a08e1",
                                        "glosses": [
                                            "устар. собирательное название территорий Ост-Индии и Вест-Индии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd7b6cdd-1ece-4fd0-a10e-7a73943bd207",
                                                "sense_id": "6789fff2-8b5b-3dae-bccf-862341d55c0f",
                                                "text": "Папа ненавидит меня за короля испанского, непримиримого врага Англии, сильного флотами и богатствами обеих Индий, но смиренного мною в глазах всей Западной Европы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "67bfb1b7-deb2-30f5-88ef-0c5cbf6fe1f2",
                                        "entry_id": "4fa1ace2-70b3-3f9b-a2a0-a4b9fa2a08e1",
                                        "glosses": [
                                            "истор. собирательное название богатых стран Южной Азии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f33f3d8-7c39-4766-b36b-040addbc58c0",
                                                "sense_id": "67bfb1b7-deb2-30f5-88ef-0c5cbf6fe1f2",
                                                "text": "В третие лето правления Кянь-фын, 668, были посольства из всех пяти Индий."
                                            },
                                            {
                                                "example_id": "a5294576-ecfc-490b-8fbe-0c8fbd702429",
                                                "sense_id": "67bfb1b7-deb2-30f5-88ef-0c5cbf6fe1f2",
