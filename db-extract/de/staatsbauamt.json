                ],
                "senses": [
                    {
                        "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                        "entry_id": "0f138870-e739-39f0-89e1-2794a7dd2df5",
                        "glosses": [
                            "Behörde, die öffentliche Bauarbeiten, die im Zuständigkeitsbereich des Staates liegen, abwickelt"
                        ],
                        "tags": [
                            "Germany",
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "867ef518-597e-417c-beef-e30930603d44",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "In den zurückliegenden Jahren wurden viele Staatsbauämter umstrukturiert und heute als das Staatliche Baumanagement weiter geführt."
                            },
                            {
                                "example_id": "fdda3324-798d-4ba8-a2bf-88a9e0343b41",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "„Die optischen „Bausünden“ werden durch ein neues Satteldach und eine Schieferverkleidung durch das Staatsbauamt Bad Arolsen behoben.“"
                            },
                            {
                                "example_id": "0a6816f5-976b-41a0-8c5e-f43cac04bfb9",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "„Das Staatsbauamt war auch im Bereich der Kirchen und Pfarrhäuser tätig.“"
                            },
                            {
                                "example_id": "99a76b5c-25a0-4ae2-8d8f-9462fb710b37",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "„Ab 1951 / 52 waren an der Querallee das Sonderbauamt Kassel beziehungsweise das Staatsbauamt angesiedelt, das 2004 in Hessisches Baumanagement (HBM) umbenannt wurde.“"
                            },
                            {
                                "example_id": "258b2470-d4fa-495a-a30b-45afff5db60b",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "„Durch das Staatsbauamt Koblenz-Nord beginnen erste Planungen für einen „Grabenschnitt“ (als Kunst am Bau) beim neuen Wirtschaftsgebäude.“"
                            },
                            {
                                "example_id": "c82d0df8-b79e-4305-bf2b-13c548d5fe89",
                                "sense_id": "b66a14be-7b78-3640-a5c5-94ed3e96bd3b",
                                "text": "„Das Staatsbauamt hatte zu diesem Zeitpunkt keine Kenntnis von den oben genannten Steuerrückständen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
