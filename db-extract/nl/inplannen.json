        "nl-extract.jsonl": [
            {
                "entry_id": "8e112f17-b6df-30b1-8e1c-a6a422caa810",
                "word": "inplannen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "b88b7f03-a468-30ea-b07d-a1eab61777b1",
                        "entry_id": "8e112f17-b6df-30b1-8e1c-a6a422caa810",
                        "glosses": [
                            "een activiteit opnemen in de planning"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91488f98-431b-4b5c-b599-f15861479ddf",
                                "sense_id": "b88b7f03-a468-30ea-b07d-a1eab61777b1",
                                "text": "Een bizarre prestatie. Het was al een medisch mirakel dat Bibian Mentel-Spee aan de start verscheen. Precies een jaar geleden won ze het testevent in Pyeongchang, waarna voor de negende keer kanker bij haar werd geconstateerd. Ze overleefde opnieuw, maar kon in de aanloop naar de Spelen geen wedstrijd meer racen, slechts enkele trainingsweken inplannen."
                            },
                            {
                                "example_id": "72258b18-1741-48a5-b6e5-89d95a57de8a",
                                "sense_id": "b88b7f03-a468-30ea-b07d-a1eab61777b1",
                                "text": "Sinds gisteren bekend werd dat Erland Galjaard na 21 jaar zendergroep RTL gaat verlaten, gonst het in Hilversum van de geruchten. De echtgenoot van WENDY VAN DIJK, vanavond te zien in de finale van TVOH, zou helemaal geen ’sabbatical’ inplannen maar aan het werk gaan voor SBS6 van JOHN DE MOL."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "970f7714-e7c5-40b1-b2d8-e6c99e62022e",
                        "source_entry_id": "8e112f17-b6df-30b1-8e1c-a6a422caa810",
                        "source_sense_id": "b88b7f03-a468-30ea-b07d-a1eab61777b1",
                        "target_lang_word": "schedule",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schedule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ae40ed0c-76f2-360e-9f5c-c163ef544194",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A procedural plan, usually but not necessarily tabular in nature, indicating a sequence of operations and the planned times at which those operations are to occur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "60980420-62f6-4816-b66c-779e3b2d432d",
                                                "sense_id": "ae40ed0c-76f2-360e-9f5c-c163ef544194",
                                                "text": "To complete on time, we must follow the schedule."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8542597c-ee57-3914-bd8c-c660d1641649",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A serial record of items, systematically arranged."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8f257937-f0d3-3a6a-9e5d-a28f4c3f5ea4",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A written or printed table of information, often forming an annex or appendix to a statute or other regulatory instrument, or to a legal contract."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af80f9cd-8119-47e0-91ab-0c2dbb1a9685",
                                                "sense_id": "8f257937-f0d3-3a6a-9e5d-a28f4c3f5ea4",
                                                "text": "schedule of tribes"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "00e66c74-d254-317f-a79c-f3c7fe3fbbdb",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A written or printed table of information, often forming an annex or appendix to a statute or other regulatory instrument, or to a legal contract.",
                                            "One of the five divisions into which controlled substances are classified, or the restrictions denoted by such classification."
                                        ],
                                        "tags": [
                                            "US",
                                            "capitalized",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "910ad95c-9bf9-42db-9741-cf7bda543ccf",
                                                "sense_id": "00e66c74-d254-317f-a79c-f3c7fe3fbbdb",
                                                "text": "Heroin is a Schedule I drug with a high potential for abuse."
                                            },
                                            {
                                                "example_id": "87d7662f-0f94-4718-b9e8-e2b53e8fef1b",
                                                "sense_id": "00e66c74-d254-317f-a79c-f3c7fe3fbbdb",
                                                "text": "Currently, cannabis/marijuana is classified as a Schedule I drug, meaning it defined as having “no currently accepted medical use and a high potential for abuse.” This is the same designation given to LSD, heroin and ecstasy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "68506f6e-8e24-34b2-a9d9-d5cd075e5efa",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A written or printed table of information, often forming an annex or appendix to a statute or other regulatory instrument, or to a legal contract.",
                                            "One of the nine schedules of the Standard for the Uniform Scheduling of Medicines and Poisons. Identical to the American usage above."
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "92aea5b8-f9c1-3ea2-ba7e-9817db616806",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "An allocation or ordering of a set of tasks on one or several resources."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "65ce5211-03ef-3984-99ef-ccb6b519a664",
                                        "entry_id": "70164499-443b-3d4b-8012-2e20de486470",
                                        "glosses": [
                                            "A slip of paper; a short note."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d6af9b03-38fe-4cd2-b0cd-71fd7bb1da8e",
                                                "sense_id": "65ce5211-03ef-3984-99ef-ccb6b519a664",
                                                "text": "He demands the blood-written schedule back from the demon, who refuses to give it up"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "schedule",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f867119b-09a8-3495-808e-bb58e45bcdcb",
