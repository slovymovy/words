                "senses": [
                    {
                        "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                        "entry_id": "606777f1-33d9-3337-b5ff-30b433c5a22e",
                        "glosses": [
                            "aus einem von einer Trillion gleich großen Teilen bestehend"
                        ],
                        "tags": [
                            "Bruchzahl",
                            "bei Maßeinheiten"
                        ],
                        "examples": [
                            {
                                "example_id": "0701b30c-e4a4-41b7-bc13-e10062b29d5d",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "Ein Attometer (am) ist ein trillionstel Meter."
                            },
                            {
                                "example_id": "c6a56581-db6d-4ba7-9bb4-014e353e1bd6",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Neben winzigsten Mengen an Bakterien, Viren, Pilzen oder Parasiten - ein trillionstel Gramm genügt schon - können unter anderem auch bösartige genetische Erkrankungen nachgewiesen werden.“"
                            },
                            {
                                "example_id": "53d3fa23-969a-4351-84d2-9f55ad53608e",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Das beste Metronom der Welt hält den Takt auf zehn trillionstel Sekunden genau und ermöglicht damit einzigartige Filme aus der Welt der Moleküle und Atome.“"
                            },
                            {
                                "example_id": "deec20b0-cf47-42fd-b5c6-d46eda6c1588",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Man könnte fast annehmen, dass er mit den Forschern mitgearbeitet hat bei der Ergründung, dass sich das Weltall in einer trillionstel Sekunde ausdehnte.“"
                            },
                            {
                                "example_id": "c84bf53b-35d6-463f-b272-eb8794fbfa78",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Viermal konnten die Forscher aus dem Wust der Daten einzelne Ereignisse herausfiltern, die aussehen, als hätten hier, weniger als eine trillionstel Sekunde lang, Higgs-Teilchen das Licht der Welt erblickt.“"
                            },
                            {
                                "example_id": "e8be1055-3bb5-466a-902c-e73dc2d63e96",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Damit sollte es möglich sein, Uhren zu schaffen, die vielleicht auf 16, 17, 18 Dezimalstellen, das heißt im Idealfall auf bis zu einer trillionstel Sekunde genau gehen.“"
                            },
                            {
                                "example_id": "0bf42162-da7c-48fb-8586-b2a5bfdd360d",
                                "sense_id": "ec7d1e58-91c6-3e63-ad61-332a46c291ae",
                                "text": "„Für eine scharfe Nase genügt ein trillionstel Gramm eines scharfen Riechstoffes! In der Differenzierung der einzelnen Stoffe war die menschliche mikrosmatische Nase um die Jahrhundertwende 100.000fach den spektralanalytischen Methoden überlegen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
