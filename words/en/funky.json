{
    "word_family": [
        "funk",
        "funkiness",
        "funkily"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "d21c22e1-584d-399c-846a-e19df0d52c9f",
                    "sense_definition": "Stylish in an unconventional way; cool, great, or excellent.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She wore a <w>funky</w> pair of glasses that everyone at the party admired.",
                            "target_lang_translations": {
                                "ru": "На ней были <w>модные</w> очки, которыми все на вечеринке восхищались."
                            }
                        },
                        {
                            "text": "What every teenage driver desires is a <w>funky</w> car and total freedom.",
                            "target_lang_translations": {
                                "ru": "Все, чего желает каждый водитель-подросток, — это <w>клевая</w> тачка и полная свобода."
                            }
                        }
                    ],
                    "synonyms": [
                        "cool",
                        "trendy",
                        "hip"
                    ],
                    "antonyms": [
                        "boring",
                        "conventional"
                    ],
                    "common_phrases": [],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used to describe fashion or style"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Стильный в необычном или нетрадиционном ключе; классный, отличный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "модный",
                                "target_lang_sense_clarification": "в необычном стиле"
                            },
                            {
                                "target_lang_word": "броский",
                                "target_lang_sense_clarification": "привлекающий внимание"
                            },
                            {
                                "target_lang_word": "клевый",
                                "target_lang_sense_clarification": "разговорное о стиле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6977c3e-8d8c-35e4-95fc-f2adfa2f9633",
                    "sense_definition": "Relating to or having the strong rhythmic character of funk music.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The band played a <w>funky</w> bass line that made everyone want to dance.",
                            "target_lang_translations": {
                                "ru": "Группа сыграла <w>фанковую</w> басовую партию, под которую всем захотелось танцевать."
                            }
                        },
                        {
                            "text": "I love the <w>funky</w> rhythm of this new track.",
                            "target_lang_translations": {
                                "ru": "Мне нравится <w>ритмичный</w> драйв этого нового трека."
                            }
                        }
                    ],
                    "synonyms": [
                        "groovy",
                        "rhythmic"
                    ],
                    "common_phrases": [
                        "funky bass line",
                        "funky rhythm",
                        "funky beat"
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к музыке в стиле фанк или имеющий сильный ритмический характер."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фанковый",
                                "target_lang_sense_clarification": "о музыке"
                            },
                            {
                                "target_lang_word": "ритмичный",
                                "target_lang_sense_clarification": "с сильным ритмом"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fc18c5e1-72ab-3293-a9dc-1f3697390780",
                    "sense_definition": "Offbeat, unconventional, or eccentric in a way that is slightly strange.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "style",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The apartment had a <w>funky</w> smell and some very strange wallpaper.",
                            "target_lang_translations": {
                                "ru": "В квартире был <w>странный</w> запах и какие-то очень необычные обои."
                            }
                        },
                        {
                            "text": "He has a <w>funky</w> style of dressing that doesn't follow any trends.",
                            "target_lang_translations": {
                                "ru": "У него <w>своеобразный</w> стиль одежды, который не следует никаким трендам."
                            }
                        }
                    ],
                    "synonyms": [
                        "eccentric",
                        "offbeat",
                        "quirky"
                    ],
                    "antonyms": [
                        "ordinary",
                        "standard"
                    ],
                    "common_phrases": [
                        "funky style"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "can imply a mix of weird and interesting"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Нетрадиционный, эксцентричный или своеобразный, иногда слегка странный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "своеобразный",
                                "target_lang_sense_clarification": "необычный"
                            },
                            {
                                "target_lang_word": "причудливый",
                                "target_lang_sense_clarification": "эксцентричный"
                            },
                            {
                                "target_lang_word": "неординарный",
                                "target_lang_sense_clarification": "выходящий за рамки привычного"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8e8cbb46-5948-3427-8e74-4d0fc95ed4d4",
                    "sense_definition": "Having a strong, foul, or unpleasant smell, often like body odor.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "smell",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You should wash those gym clothes because they are starting to smell <w>funky</w>.",
                            "target_lang_translations": {
                                "ru": "Тебе стоит постирать эту спортивную одежду, потому что она начинает <w>вонять</w>."
                            }
                        },
                        {
                            "text": "The old fridge had a <w>funky</w> smell after the power went out.",
                            "target_lang_translations": {
                                "ru": "У старого холодильника появился <w>неприятный</w> запах после того, как отключили электричество."
                            }
                        }
                    ],
                    "synonyms": [
                        "stinky",
                        "smelly",
                        "malodorous"
                    ],
                    "antonyms": [
                        "fragrant",
                        "fresh"
                    ],
                    "common_phrases": [
                        "funky smell",
                        "smell funky"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "usually refers to sweat or decay"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий сильный, неприятный или затхлый запах, часто напоминающий запах пота."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вонючий",
                                "target_lang_sense_clarification": "о неприятном запахе"
                            },
                            {
                                "target_lang_word": "затхлый",
                                "target_lang_sense_clarification": "о запахе в помещении"
                            },
                            {
                                "target_lang_word": "с душком",
                                "target_lang_sense_clarification": "о неприятном запахе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4bd6445a-c2ef-3612-822a-93f93d625dd3",
                    "sense_definition": "Not quite right, suspicious, or of questionable quality.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Something feels <w>funky</w> about this contract, so I want a lawyer to look at it.",
                            "target_lang_translations": {
                                "ru": "В этом контракте есть что-то <w>подозрительное</w>, поэтому я хочу, чтобы его посмотрел юрист."
                            }
                        },
                        {
                            "text": "The engine was making a <w>funky</w> noise before it finally broke down.",
                            "target_lang_translations": {
                                "ru": "Двигатель издавал <w>странный</w> шум перед тем, как окончательно сломаться."
                            }
                        }
                    ],
                    "synonyms": [
                        "fishy",
                        "dodgy",
                        "suspicious"
                    ],
                    "antonyms": [
                        "normal",
                        "reliable"
                    ],
                    "common_phrases": [
                        "funky attitude"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "used when something feels 'off'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Подозрительный, сомнительного качества или вызывающий недоверие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий сомнения"
                            },
                            {
                                "target_lang_word": "странный",
                                "target_lang_sense_clarification": "не такой, как должен быть"
                            },
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "разговорное о сомнительном качестве"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}