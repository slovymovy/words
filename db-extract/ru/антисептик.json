                ],
                "senses": [
                    {
                        "sense_id": "05d665c1-d493-3a55-b305-2be66e89c6f7",
                        "entry_id": "3998fd9d-eb86-3511-9d5e-1f961b26b50a",
                        "glosses": [
                            "общее название веществ, используемых для уничтожения микроорганизмов в медицине и промышленности"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91471a4a-4121-4111-b38f-5795af629f7b",
                                "sense_id": "05d665c1-d493-3a55-b305-2be66e89c6f7",
                                "text": "Антисептик препятствовал проникновению инфекции в организм больного через незажившую рану"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "eef00182-adab-443e-a8e6-bf7d3e7e77b3",
                        "source_entry_id": "3998fd9d-eb86-3511-9d5e-1f961b26b50a",
                        "source_sense_id": "05d665c1-d493-3a55-b305-2be66e89c6f7",
                        "target_lang_word": "antiseptic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiseptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3d53544-3d67-3e1f-b2ee-751e4976e405",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Of, or relating to antisepsis, or the use of antiseptics."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "bc16d8ff-9473-3324-b8d5-bd924bd7058c",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Capable of preventing microbial infection."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "fcf4dca7-046b-3b99-a9f5-0d4b554daa96",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Very clean; aseptic."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                        "entry_id": "4d0cd29c-5ef9-36db-bd62-8ade39af31a0",
                                        "glosses": [
                                            "Free of unpleasantness; prim, sanitized or bowdlerized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fea5aaef-b586-485c-9720-cb5d9cb9083d",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "This judicious representation of brutality, domestic violence and struggle empowers women trying to break the shame and fear propagated by the antiseptic whitewashing of conventional media."
                                            },
                                            {
                                                "example_id": "3a87bbfa-93da-4021-a75c-5029733debbd",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "Forget all those Christmas cards with their ideal scenarios and antiseptic smiles. Stables are filthy and they stink[…]"
                                            },
                                            {
                                                "example_id": "107713d5-c0ba-49a3-94e9-4d64830985b7",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "[Chief Justice John] Roberts got criticism for what some perceived as his relatively brief and antiseptic description of the events of Jan. 6, 2021, in his majority opinion in Fischer v. United States the other day."
                                            },
                                            {
                                                "example_id": "a0c1c47c-142d-4663-95a7-39ad371c99bd",
                                                "sense_id": "11c07e62-0b06-30b4-bd2f-59dddc00978a",
                                                "text": "The [Supreme Court's emergency ruling in Trump v. J.G.G.]—an unsigned opinion from the Court’s conservative bloc, minus Amy Coney Barrett—is strangely antiseptic."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiseptic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "f3faca9e-25e4-3faa-bf15-48d0cdb37157",
                                        "entry_id": "3cca5b4a-ee78-3312-b6a2-64384bf1e842",
                                        "glosses": [
                                            "Any substance that inhibits the growth and reproduction of microorganisms. Generally includes only those that are used on living objects (as opposed to disinfectants) and aren't transported by the lymphatic system to destroy bacteria in the body (as opposed to antibiotics)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1fac5d47-bc30-4837-9d0e-3419df445d2c",
                        "source_entry_id": "3998fd9d-eb86-3511-9d5e-1f961b26b50a",
                        "source_sense_id": "05d665c1-d493-3a55-b305-2be66e89c6f7",
                        "target_lang_word": "antiseptique",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antiseptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a8f35a64-872a-3283-874c-1f2cd9b515e3",
                                        "entry_id": "de1b951c-7a8b-3d7b-bdfc-c515eeced570",
                                        "glosses": [
                                            "Qui a rapport à l’antisepsie."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ca22d42b-b2d7-3318-a841-96dacdb34d66",
                                        "entry_id": "de1b951c-7a8b-3d7b-bdfc-c515eeced570",
                                        "glosses": [
                                            "Qui détruit les micro-organismes présents sur le corps : bactéries, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "561a3a12-4f1d-4911-8a60-4d7bd70c59ed",
                                                "sense_id": "ca22d42b-b2d7-3318-a841-96dacdb34d66",
                                                "text": "La sauge est œstrogénique, antioxydante, antalgique, anti-inflammatoire, neuro-protectrice, anti-asthénique et antiseptique localement."
                                            },
                                            {
                                                "example_id": "2d40c71f-9f9d-42d3-a7e3-61f41fee9882",
                                                "sense_id": "ca22d42b-b2d7-3318-a841-96dacdb34d66",
                                                "text": "Loreena et son équipe placent Connor sous assistance respiratoire et en coma artificiel avant de commencer les traitements locaux à base de bains antiseptiques et de crème antibactérienne."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "antiseptique",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3dda1f01-de05-33b2-a804-93c6057881ef",
                                        "entry_id": "c2ce4987-cf64-35bd-8882-c16189acc386",
                                        "glosses": [
                                            "Remède contre la gangrène."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "45852133-aaf5-3bef-8b76-ebb268238f4f",
                                        "entry_id": "c2ce4987-cf64-35bd-8882-c16189acc386",
                                        "glosses": [
                                            "Produit utilisé sur les surfaces externes du corps, qui détruit les micro-organismes : bactéries, etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f49702-ca2c-4e84-b125-18d18d1919ae",
                                                "sense_id": "45852133-aaf5-3bef-8b76-ebb268238f4f",
                                                "text": "Le docteur Paul, en blouse blanche, les mains gantées de caoutchouc, fumait cigarette sur cigarette. Il prétendait volontiers que le tabac est un des plus sûrs antiseptiques et il lui arrivait, au cours d’une autopsie, de fumer ses deux paquets de bleues."
                                            },
                                            {
                                                "example_id": "01904005-1704-4f44-8324-25fa095215be",
                                                "sense_id": "45852133-aaf5-3bef-8b76-ebb268238f4f",
                                                "text": "Le traitement des formes non compliquées est simple et comporte à chacun des changes une désinfection bactérienne par un antiseptique à base de chlorhexidine par exemple suivie d’un séchage soigneux puis de l’application d’une crème ou d’un lait antifungique associée à un traitement antifungique per os uniquement en cas de muguet ou de diarrhée."
                                            },
                                            {
                                                "example_id": "9bcab85a-c2a1-4d13-9ee5-638b17fb7fc2",
                                                "sense_id": "45852133-aaf5-3bef-8b76-ebb268238f4f",
                                                "text": "Les antiseptiques sont des substances semblables aux désinfectants, à ceci près qu’ils peuvent être utilisés directement sur la peau de l’animal dans le traitement des plaies, etc."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
