                        "glosses": [
                            "A mechanism that saves power in a circuit by removing the clock signal while the circuit is not in use."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "43f2d783-bec9-442b-87c9-efffe6b8dd71",
                                "sense_id": "4919cb16-a9d6-3ac3-a8f9-71908a0e8bf8",
                                "text": "Optimizing the selection of clock gaters based on activity is known as power-driven clock gating."
                            },
                            {
                                "example_id": "dc1436c1-fed6-447f-b822-7bdda3725bfe",
                                "sense_id": "4919cb16-a9d6-3ac3-a8f9-71908a0e8bf8",
                                "text": "With more clock buffers instead of gaters in the clock distribution, the power is significantly reduced based on Table 4-4."
                            }
                        ]
                    },
                    {
