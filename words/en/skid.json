{
    "word_family": [
        "skidding",
        "skidded"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5b6c1ac4-754b-3e70-bcd1-f8f86538383d",
                    "sense_definition": "An out-of-control sliding motion of a vehicle.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The car went into a <w>skid</w> on the icy road.",
                            "target_lang_translations": {
                                "cs": "Auto na zledovatělé silnici <w>dostalo smyk</w>."
                            }
                        },
                        {
                            "text": "The driver lost control and the car ended up in a dangerous <w>skid</w>.",
                            "target_lang_translations": {
                                "cs": "Řidič ztratil kontrolu a auto skončilo v nebezpečném <w>smyku</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "drag"
                    ],
                    "common_phrases": [
                        "go into a skid"
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekontrolovaný klouzavý pohyb vozidla."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "smyk",
                                "target_lang_sense_clarification": "klouzavý pohyb vozidla po povrchu"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94cc3349-95a4-37db-8d83-6c934949ec93",
                    "sense_definition": "A wooden platform used for storing or moving goods.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "support",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The warehouse worker moved the heavy <w>skid</w> with a forklift.",
                            "target_lang_translations": {
                                "cs": "Skladník přemístil těžkou <w>paletu</w> pomocí vysokozdvižného vozíku."
                            }
                        },
                        {
                            "text": "We received ten <w>skid</w> loads of supplies this morning.",
                            "target_lang_translations": {
                                "cs": "Dnes ráno jsme obdrželi deset <w>palet</w> zásob."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Dřevěná nebo plastová plošina používaná pro skladování nebo přepravu zboží."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "paleta",
                                "target_lang_sense_clarification": "manipulační jednotka pro přepravu zboží"
                            },
                            {
                                "target_lang_word": "ližina",
                                "target_lang_sense_clarification": "dřevěný trámec sloužící k podložení nebo posunu břemen"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c93287a9-0a25-3837-94c3-e15da5ac14de",
                    "sense_definition": "A period of continuous failure or decline.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "decline",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company is on a downward <w>skid</w> after poor sales.",
                            "target_lang_translations": {
                                "cs": "Společnost je po špatných prodejích v <w>úpadkové fázi</w>."
                            }
                        },
                        {
                            "text": "The team finally ended their losing <w>skid</w> last night.",
                            "target_lang_translations": {
                                "cs": "Tým včera večer konečně ukončil svou <w>sérii proher</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "losing skid"
                    ],
                    "target_lang_definitions": {
                        "cs": "Období trvalého neúspěchu nebo úpadku."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "úpadková fáze",
                                "target_lang_sense_clarification": "období zhoršování situace"
                            },
                            {
                                "target_lang_word": "série proher",
                                "target_lang_sense_clarification": "v kontextu sportu nebo soutěžení"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b549f5fc-416c-3286-8cc6-c2911aac4201",
                    "sense_definition": "To slide uncontrollably across a surface.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "sliding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The bicycle began to <w>skid</w> on the wet pavement.",
                            "target_lang_translations": {
                                "cs": "Kolo začalo na mokrém chodníku <w>smýkat</w>."
                            }
                        },
                        {
                            "text": "The truck <w>skidded</w> across the road when the driver braked suddenly.",
                            "target_lang_translations": {
                                "cs": "Kamion <w>dostal smyk</w> a přejel přes silnici, když řidič náhle zabrzdil."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "cs": "Nekontrolovaně klouzat po povrchu."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "dostat smyk",
                                "target_lang_sense_clarification": "ztratit kontrolu nad vozidlem při pohybu"
                            },
                            {
                                "target_lang_word": "smýkat se",
                                "target_lang_sense_clarification": "klouzat po povrchu"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}