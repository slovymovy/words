                    },
                    {
                        "form_id": "15370839-a360-4750-a49a-3e1ef994a4c6",
                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "tags": [
                            "masculine"
                        ],
                        "form": "adorateur"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "glosses": [
                            "Celle qui adore une divinité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "68d2bf21-7211-4d0a-9308-5941dacf2fbf",
                                "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                                "text": "Leclant, dans ce dernier article, étudie les liens qui unissent la divine adoratrice à la déesse Tefnout."
                            },
                            {
                                "example_id": "9b4d1ca2-6d55-4705-9dd1-263cfc72d0b1",
                                "sense_id": "a2c7749e-44e9-3b36-9280-dda09102b826",
                                "text": "Notre présence ne paraît pas contrarier les adoratrices du dieu, qui viennent en foule nous vendre leurs volailles ou plutôt les échanger contre des morceaux de cotonnade rouge."
                            }
                        ]
                    },
                    {
                        "sense_id": "1dc633a4-f1cb-336c-9d1b-1b6c351daf8a",
                        "entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "glosses": [
                            "Celle qui a une estime extraordinaire, et qui admire en tout cette personne."
                        ],
                        "tags": [
                            "hyperbole"
                        ],
                        "examples": [
                            {
                                "example_id": "65750abc-8e4e-4ad5-ba13-51f3eba089ed",
                                "sense_id": "1dc633a4-f1cb-336c-9d1b-1b6c351daf8a",
                                "text": "C’était une entreprise hasardeuse que de prétendre amadouer le docteur Johnson. Il rebutait, rabrouait souvent ses belles adoratrices, payait de rebuffades leurs adulations et leurs cajoleries."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9c826153-ac09-4f09-8fd5-394c778ea090",
                        "source_entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "target_lang_word": "Verehrerin",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verehrerin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b54a6363-0ab7-3690-b539-82b002c627ca",
                                        "entry_id": "a57248bd-93e5-3542-b021-d79ca3b11db1",
                                        "glosses": [
                                            "weibliche Person, die jemanden anderen (oft heimlich) liebt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7d4b0155-ab72-4972-b4cb-b2fd4c272e1c",
                                                "sense_id": "b54a6363-0ab7-3690-b539-82b002c627ca",
                                                "text": "Er hat eine heimliche Verehrerin."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                        "entry_id": "a57248bd-93e5-3542-b021-d79ca3b11db1",
                                        "glosses": [
                                            "weibliche Person, die jemand anderen bewundert"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5a9f3f8-c531-4573-8d5c-fc4cea39cf76",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Michalis' Erzählung ist in der Gegenwart angelangt, er drückt seine Kippe im leeren Wasserglas aus und bricht auf in Richtung Bar, wo sich zwei Verehrerinnen um ihn balgen.“"
                                            },
                                            {
                                                "example_id": "a5174400-3bdf-431a-abbf-92a2ed5bba76",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Er stellte mich seiner Verehrerin vor und sagte, er bringe mich nach Rom, wo ich das Ordensgewand des heiligen Franziskus nehmen würde.“"
                                            },
                                            {
                                                "example_id": "467e8064-712f-4d09-95a2-c9d7452580d2",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Manchmal hatten mir Verehrerinnen Blumen ins Hotel geschickt.“"
                                            },
                                            {
                                                "example_id": "296d5b7c-54e6-4be9-bc6d-a37b293fe4af",
                                                "sense_id": "a3e39497-938d-3ef0-814e-060393799c17",
                                                "text": "„Doch er schenkte seinen vielen Verehrerinnen keinen Funken Aufmerksamkeit und hatte es nie getan.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6b35302-8b3b-45b8-bb03-60a29da8472c",
                        "source_entry_id": "a8b5bd03-b6c8-3221-854f-59135418d49f",
                        "target_lang_word": "worshiper",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "worshiper",
