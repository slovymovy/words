                        "examples": [
                            {
                                "example_id": "03d62e14-e7c9-471c-83d9-507857815607",
                                "sense_id": "604ff321-9100-31e4-96be-d5c6c887620c",
                                "text": "And as I soodled on and on, / The ground was warm to look upon."
                            },
                            {
                                "example_id": "19580395-6e3a-4b1e-a8da-1acbe864841b",
                                "sense_id": "604ff321-9100-31e4-96be-d5c6c887620c",
                                "text": "[…] we would gladly soodle a sloomy way home with a burred moon over us and the fern-owls chittering in the pingles and the holts."
                            },
                            {
                                "example_id": "25893efe-03d9-4b12-a3ae-aabfcb22a0ca",
                                "sense_id": "604ff321-9100-31e4-96be-d5c6c887620c",
                                "text": "Yes, these are the dog days, Fortunatus: / The heather lies limp and dead / On the mountain, the baltering torrent / Shrunk to a soodling thread; […]"
                            }
                        ]
                    }
