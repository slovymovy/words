                "senses": [
                    {
                        "sense_id": "a4f9a15a-e31a-39db-b4ca-7ffc933fc8f9",
                        "entry_id": "4b9ad60a-9653-3d31-946e-d5c912344e78",
                        "glosses": [
                            "To cut across something."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4830b5d-c1c9-4b51-8935-8d6b42b9b594",
                                "sense_id": "a4f9a15a-e31a-39db-b4ca-7ffc933fc8f9",
                                "text": "Matter of doubt and dread suspitious, / That doth with curelesse care consume the hart, / Corrupts the stomacke with gall vitious, / Croscuts the liuer with internall smart, / And doth transfixe the soule with deathes eternall dart."
                            }
                        ]
                    },
                    {
                        "sense_id": "a1ebdf1c-7cfd-3f51-b900-6a058e549a3b",
                        "entry_id": "4b9ad60a-9653-3d31-946e-d5c912344e78",
                        "glosses": [
                            "To cut across something.",
                            "To cut (wood, lumber) across the grain."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "9a31bb21-ad0c-3078-9954-9ca83e087861",
                        "entry_id": "4b9ad60a-9653-3d31-946e-d5c912344e78",
                        "glosses": [
                            "To cut repeatedly between two concurrent scenes."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f43b0cb5-231f-3fe1-af7b-164685db467e",
                        "entry_id": "4b9ad60a-9653-3d31-946e-d5c912344e78",
                        "glosses": [
                            "To affect several modules of a program, without the possibility of being encapsulated in any one of them. See Cross-cutting concern."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d130edc-b865-4a86-b7d1-63ff540e6bdc",
                                "sense_id": "f43b0cb5-231f-3fe1-af7b-164685db467e",
                                "text": "Once we've implemented a concern in the component language, we need to perform an analysis to determine where ancillary concerns might crosscut the code."
                            }
                        ]
                    }
                ],
