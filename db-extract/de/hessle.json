                ],
                "senses": [
                    {
                        "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                        "entry_id": "79006043-7b87-35ae-8e1a-fd030fc28a35",
                        "glosses": [
                            "deutschsprachiger Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2760ac77-ae08-439d-a769-f0e6cf0d1e30",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Die Hessles fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "8e07c347-7d16-43b2-90a8-9b28d477d03c",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Frau Hessle ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e420e2bf-43f5-4a6c-bbbf-8d1ed56112f2",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Herr Hessle wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "b8a7e7a4-18dd-44ca-a0af-6c42cbc8e129",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Der Hessle trägt nie die Schals, die die Hessle ihm strickt."
                            },
                            {
                                "example_id": "18db4a91-898c-4448-b81b-96fb2d1a568b",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Hessle kommt, geht der Herr Hessles.“"
                            },
                            {
                                "example_id": "88c0737d-7001-4622-8e88-c176174d48d6",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Hessle kommt und geht."
                            },
                            {
                                "example_id": "a6d9899d-74f9-443e-9e5a-5ed50802292a",
                                "sense_id": "f7e96f23-669a-31d3-8af1-64c42bbbf900",
                                "text": "Hessles kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
