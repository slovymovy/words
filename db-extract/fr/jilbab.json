                                        "glosses": [
                                            "A long, loose-fitting coat or similar garment worn by some Muslim women to fulfil hijab."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28732607-8afe-4981-b960-eaf91433adb5",
                                                "sense_id": "717081a0-71e8-33bc-8bdb-f8595b86fb92",
                                                "text": "Most Indonesian women started wearing the jilbab in the last decade, after the fall in 1998 of President Suharto, who had kept a close grip on Islamic groups."
                                            }
