                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fdbcb4ad-53fd-46f6-8331-2d66926971e8",
                                "sense_id": "2853ead4-529a-3f41-80b0-d64f1dff0ccc",
                                "text": "Louis apporta la hrissé. Il ne savait pas très bien pour quelle raison Jef avait choisi de cuisiner pour son retour cette spécialité de blé et viande de mouton qui se servait normalement à l'Assomption."
                            },
                            {
                                "example_id": "b24a9944-7f3e-476a-be9a-ec8356b744f8",
                                "sense_id": "2853ead4-529a-3f41-80b0-d64f1dff0ccc",
                                "text": "Toute la nuit la hrissé aurait mijoté dans son chaudron, le blé et les quelques viandes ne faisant plus qu’un, mais on attendrait l’heure de midi pour se régaler, quand la défaite aurait été consommée."
                            }
                        ]
