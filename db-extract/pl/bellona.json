                                        "entry_id": "df670b28-dccc-3f34-9a6e-79b56ad87947",
                                        "glosses": [
                                            "Roman goddess of war, wife or sister of Mars. Equivalent to the Greek goddess Enyo."
                                        ],
                                        "tags": [
                                            "Roman"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f0525a6d-cfab-4da8-843d-facd0bc4fba2",
                                                "sense_id": "57787f0b-6672-38c8-8da4-e8557d2edc22",
                                                "text": "But time will teach the Russ, ev'n conquering War\nHas handmaid arts: aye, aye, the Russ will woo\nAll sciences that speed Bellona's car,\nAll murder's tactic arts, and win them too […]"
                                            }
                                        ]
