                "senses": [
                    {
                        "sense_id": "ecf97346-4d67-36fd-a6e0-d1d4eee9c179",
                        "entry_id": "8fcb63db-3cc2-3427-950f-28b0b9eff1c8",
                        "glosses": [
                            "Tumeur formée de tissu osseux ^([2]), hors du lieu où siègent normalement les os ^([1])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7e4af732-f365-4746-b6af-fc154beb8461",
                                "sense_id": "ecf97346-4d67-36fd-a6e0-d1d4eee9c179",
                                "text": "L’ostéome ostéoïde est la tumeur la plus fréquente suivie par le kyste anévrismal et le chondrome."
                            },
                            {
                                "example_id": "94405526-42a5-4eff-8385-00e82e9cad51",
                                "sense_id": "ecf97346-4d67-36fd-a6e0-d1d4eee9c179",
                                "text": "\"Seules des tumeurs bénignes ont pour le moment pu être diagnostiquées à Argos : il s'agissait d'ostéomes de la voûte crânienne (tombe 200) et d'ostéochondromes dans le cadre d'une maladie des exostoses multiples (tombe 179).\""
                            },
                            {
                                "example_id": "59f0b4c7-d396-41a1-9bf4-a6792f08f24b",
                                "sense_id": "ecf97346-4d67-36fd-a6e0-d1d4eee9c179",
                                "text": "…le jeune homme tentera de « gommer » en imagination les pastilles jaunes, représentation mentale de ses ostéomes, excroissances osseuses apparaissant fréquemment au niveau des articulations des brûlés."
                            }
                        ]
                    }
                ],
