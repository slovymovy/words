            "senses": [
                {
                    "sense_id": "eadbca7f-bbc7-35d5-97fc-ecf08653ba79",
                    "sense_definition": "Eerste persoon enkelvoud tegenwoordige tijd van <w>lijken</w>.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "verb_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>lijk</w> misschien rustig, maar ik ben heel zenuwachtig.",
                            "target_lang_translations": {
                                "en": "I might <w>seem</w> calm, but I am very nervous.",
                                "ru": "Я, может быть, и <w>кажусь</w> спокойным, но я очень нервничаю.",
                                "de": "Ich <w>wirke</w> vielleicht ruhig, aber ich bin sehr nervös."
                            }
                        },
                        {
                            "text": "Soms <w>lijk</w> ik precies op mijn moeder als ik lach.",
                            "target_lang_translations": {
