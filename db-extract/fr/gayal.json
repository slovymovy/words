                        "sense_id": "16ffa8a5-7bb1-36b7-a288-20fd358000d3",
                        "entry_id": "30512e99-de03-3b23-b1c6-5f7c448d5f3c",
                        "glosses": [
                            "Espèce de bovidé de l’Inde et du Tibet, maintenant considéré comme appartenant à la même espèce que le gaur (nom de l’espèce commune : Bos frontalis)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e531201-a46e-4e8a-9544-3e14635f604b",
                                "sense_id": "16ffa8a5-7bb1-36b7-a288-20fd358000d3",
                                "text": "Les grands quadrupèdes sauvages de la famille des taureaux de l’Inde et des contrées indo-chinoises et de Malacca ont été plus minutieusement classés ; dans le nombre, il faut citer le gayal ou gyall."
                            },
                            {
                                "example_id": "eb4ce072-268a-405f-a102-cc317789c0cc",
                                "sense_id": "16ffa8a5-7bb1-36b7-a288-20fd358000d3",
                                "text": "[…], ils chantent et dansent autour de ce monceau, tuent des gayals et des porcs avec leurs lances, en font bouillir la chair , et boivent la liqueur fermentée."
                            }
                        ]
                    }
                ],
