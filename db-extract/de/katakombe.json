                    {
                        "translation_id": "cdbfad37-25a5-40a2-835a-a2a661873164",
                        "source_entry_id": "689968e2-0220-3244-af3a-9e6147462030",
                        "source_sense_id": "a0e33ebe-2561-36d8-bd4a-d7ab5c5c1824",
                        "source_sense_description": "(meist Plural) in frühchristlicher Zeit: unterirdische Beisetzungsstätte",
