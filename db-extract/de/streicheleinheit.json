                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff5a8b56-415f-4986-ad68-1858ab36c057",
                                "sense_id": "0ebe7b77-23b1-32a2-a3bb-019bb316c7e4",
                                "text": "Das Kätzchen ist richtig verschmust, es braucht wohl ein paar Streicheleinheiten!"
                            },
                            {
                                "example_id": "991e141a-8e41-4dd1-b3f5-f72969f73d5a",
                                "sense_id": "0ebe7b77-23b1-32a2-a3bb-019bb316c7e4",
                                "text": "„Im Zusammenleben mit der Mutter waren Streicheleinheiten selten, Watschen hingegen die Regel gewesen.“"
                            },
                            {
                                "example_id": "d12855b3-7d80-4bda-9754-58f1d436f65f",
                                "sense_id": "0ebe7b77-23b1-32a2-a3bb-019bb316c7e4",
                                "text": "„Teddy bellte und wedelte mit dem Schwanz, um noch ein paar Streichleinheiten zu bekommen.“"
                            }
                        ],
