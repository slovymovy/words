                                        "sense_id": "7de4c561-b066-39f3-8229-2e6e0493deca",
                                        "entry_id": "34fd74bb-6398-30d1-aed6-58bb8ec0865f",
                                        "glosses": [
                                            "A capitalist, (usually derogatory) an exploiter of the proletariat."
                                        ],
                                        "tags": [
