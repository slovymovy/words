                        "glosses": [
                            "Habitant du Niger ^([1]) ^([2])."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9773dbf0-4afe-4e37-a582-bd5cc4dcefe7",
                                "sense_id": "76ca06e6-a2e7-3030-9e0f-a80fba7642ab",
                                "text": "[…], enfin Moussa, jeune Nigérien, bavard et sympathique. Il fera ma cuisine et me servira d’interprète dans ce pays où l'on parle le haoussa principalement et d'autres dialectes, mais non l’arabe, à part quelques chefs et quelques marabouts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "344adc8e-9a14-4748-b6f3-0ee465a211f1",
                        "source_entry_id": "cd3ffc6e-d704-35b6-8004-3e88997071a4",
                        "source_sense_id": "76ca06e6-a2e7-3030-9e0f-a80fba7642ab",
                        "target_lang_word": "Nigrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Nigrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "6e07a0c2-abd8-3b31-bcd1-54861c5a5820",
                                        "entry_id": "f1208d2d-69d8-36a3-811f-a2c6da4daa41",
                                        "glosses": [
                                            "Staatsbürger des Nigers"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "783a135c-c4ec-4c2f-98ea-52702c0d3b7c",
                                                "sense_id": "6e07a0c2-abd8-3b31-bcd1-54861c5a5820",
                                                "text": "„Die Mehrheit der Nigrer lebt in absoluter Armut, von weniger als zwei Dollar am Tag.“"
                                            },
                                            {
                                                "example_id": "c67d9e7d-bcbc-4ed8-8cdd-0aac5c408c54",
                                                "sense_id": "6e07a0c2-abd8-3b31-bcd1-54861c5a5820",
                                                "text": "„Migration aus Niger selbst spielt für die EU keine bedeutsame Rolle: Zwischen Januar und Juni 2018 wanderten gerade einmal drei Nigrer in die EU ein.“"
                                            },
                                            {
                                                "example_id": "b2323d83-2fa5-4c08-a2c4-56341bfc65d0",
                                                "sense_id": "6e07a0c2-abd8-3b31-bcd1-54861c5a5820",
                                                "text": "„Aufgrund der verheerenden Kombination aus Nahrungsmangel, Infektionskrankheiten und einer miserablen medizinischen Versorgung starben viele Nigrer in jungen Jahren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
