                "senses": [
                    {
                        "sense_id": "891ad547-8e35-32be-99e3-f63fce176847",
                        "entry_id": "78f62752-fbdd-3e5e-913c-e552567b93a5",
                        "glosses": [
                            "Wappen, das (offiziell oder inoffiziell) von einer Stadt genutzt wird und diese auch in gewisser Weise repräsentiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf41e095-9d34-42d2-950f-71e9a7b0575e",
                                "sense_id": "891ad547-8e35-32be-99e3-f63fce176847",
                                "text": "„Die Annahme eines Familienwappens steht jedem frei; die Annahme eines Stadtwappens bedarf der staatlichen Genehmigung.“"
                            },
                            {
                                "example_id": "f72eca94-4e32-4efb-ab66-fe7c9532416e",
                                "sense_id": "891ad547-8e35-32be-99e3-f63fce176847",
                                "text": "„Diese Karte vom Rathaus mit Stadtwappen wurde im Farbkunstdruckverfahren hergestellt, trägt den Postaufgabestempel Duderstadt vom 13. Juni 1903 und den Ankunftsstempel Homburg v.d.H. vom 16. Juni 1903.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4130b633-0c3a-4f09-b185-4a8a1d9b4b77",
                        "source_entry_id": "78f62752-fbdd-3e5e-913c-e552567b93a5",
                        "source_sense_id": "891ad547-8e35-32be-99e3-f63fce176847",
                        "target_lang_word": "municipal coat of arms",
