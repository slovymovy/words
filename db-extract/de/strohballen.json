                "senses": [
                    {
                        "sense_id": "f7533613-41db-378c-82fe-8afec481bd99",
                        "entry_id": "0bf48896-3fd1-3954-a4e5-c7da09123309",
                        "glosses": [
                            "in runde oder rechteckige Ballen gepresstes Stroh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb8c5817-4e91-4f69-839e-d3cca953c105",
                                "sense_id": "f7533613-41db-378c-82fe-8afec481bd99",
                                "text": "Auf unseren Feldern liegen Strohballen."
                            },
                            {
                                "example_id": "198b679b-5c9e-43df-9e7e-8002d2f5632a",
                                "sense_id": "f7533613-41db-378c-82fe-8afec481bd99",
                                "text": "Die Strohballen müssen noch in die Scheune geschafft werden."
                            },
                            {
                                "example_id": "2b99ec5a-b383-4941-92d5-2ae687604371",
                                "sense_id": "f7533613-41db-378c-82fe-8afec481bd99",
                                "text": "Die Landjugend hat auch dieses Jahr wieder lustige Puppen aus Strohballen angefertigt."
                            },
                            {
                                "example_id": "83f48d5f-0d30-4df7-b76a-1fe5689f7131",
                                "sense_id": "f7533613-41db-378c-82fe-8afec481bd99",
                                "text": "„Zwischen aufgestapelten Strohballen fanden sie Schutz vor der Kälte, und Matthias und Johanna schliefen ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
