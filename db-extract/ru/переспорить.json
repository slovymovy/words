                ],
                "senses": [
                    {
                        "sense_id": "9d43f15b-c2eb-3a49-9618-71cddd65b57b",
                        "entry_id": "d4eaaa18-9b3b-3e29-9927-478deeb4af11",
                        "glosses": [
                            "одержать верх над кем-либо в споре"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "34a1fd78-084a-434a-8a58-db30372bb4a2",
                                "sense_id": "9d43f15b-c2eb-3a49-9618-71cddd65b57b",
                                "text": "Я подумал, что если в сию решительную минуту не переспорю упрямого старика, то уж в последствии времени трудно мне будет освободиться от его опеки, и, взглянув на него гордо, сказал: «Я твой господин, а ты мой слуга. Деньги мои. Я их проиграл, потому что так мне вздумалось. А тебе советую не умничать и делать то, что тебе приказывают»."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c247f693-5aef-4dd1-b2f2-63d08a668cc9",
                        "source_entry_id": "d4eaaa18-9b3b-3e29-9927-478deeb4af11",
                        "source_sense_id": "9d43f15b-c2eb-3a49-9618-71cddd65b57b",
                        "target_lang_word": "out-argue",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "out-argue",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3b307cff-a84c-32c1-ab17-1c87442686d3",
                                        "entry_id": "f2536223-7bbf-3dfb-bd25-ab28c2caba1e",
                                        "glosses": [
                                            "Alternative form of outargue."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "84718aa3-ae8c-4097-96cf-165ffdd2a680",
                                                "sense_id": "3b307cff-a84c-32c1-ab17-1c87442686d3",
                                                "text": "You have to out-drink, out-boast, out-fight, out-argue the horde of people who float around the pub (The Royal George, Lorenzini's bistro, etc. for downtown Sydney; the Sydney University Union café for “uptown”)."
                                            },
                                            {
                                                "example_id": "ec42d30b-fe09-46b5-ad8a-54e62e593b0c",
                                                "sense_id": "3b307cff-a84c-32c1-ab17-1c87442686d3",
                                                "text": "Galileo was very good in debate: he could, his admirers believed and his opponents acknowledged, out-argue anyone."
                                            },
                                            {
                                                "example_id": "e29bd273-4d13-4787-bcd7-92823558d5a8",
                                                "sense_id": "3b307cff-a84c-32c1-ab17-1c87442686d3",
                                                "text": "They may try to out-argue and out-evidence those who would dispossess them, but they need money to do so."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
