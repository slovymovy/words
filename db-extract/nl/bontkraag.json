                            {
                                "example_id": "65a2d68a-6a54-46b8-9a14-b6298a21234e",
                                "sense_id": "b93867f2-6ccd-3f2b-ba44-3f7fa7475b3b",
                                "text": "Februari 2013. Myroslava en Irina zijn samen in Wenen. In de stralende winterzon staan ze voor het Wiener Opernhaus; Irina in een leren jas met grote bontkraag, Myroslava met strakke broek, hoge laarzen en een hippe zonnebril. Ze omhelzen elkaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "d11f3d7e-251f-303b-bd1b-727cdb852434",
                        "entry_id": "9adc70a7-5df2-38e9-a127-06a396b16734",
