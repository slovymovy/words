                    {
                        "translation_id": "eec4ea96-31e6-4142-837c-05531b13457c",
                        "source_entry_id": "499abfd5-85f3-3ca6-ab7d-1e1ee3867b3d",
                        "source_sense_id": "7c2b2513-ace0-3742-a173-c8e2af9bc94e",
