                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d34bfdf-3e6f-4468-95db-3deb3258b1b1",
                                                "sense_id": "8938260e-0eff-3071-9e19-1423f77848bb",
                                                "text": "Mancha selecto is the world's best saffron: deep-red stamens, as long as the first joint of your thumb, packed and date-stamped. Lesser types, like sierra saffron, have shorter stamens and a quantity of white and yellow flower parts."
