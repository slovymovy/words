                    {
                        "form_id": "ae0039d9-6e03-44dd-bb6c-bd04464fc2e8",
                        "entry_id": "31242a87-86f9-3c68-9e9d-4a2888afb442",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Hortensien"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                        "entry_id": "31242a87-86f9-3c68-9e9d-4a2888afb442",
                        "glosses": [
                            "strauchartige Pflanze mit doldigem Blütenstand, von der mehrere Arten als Zierpflanze genutzt werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49a274f3-6d86-48c6-9f82-4c1fb5c46370",
                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                "text": "„Die Hortensie braucht gut wasserdurchlässige, humose Erde.“"
                            },
                            {
                                "example_id": "c4a51b5a-c0bc-4866-a2e1-adf51d38e112",
                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                "text": "„Ursprünglich war die Hortensie im asiatischen Raum zu Hause.“"
                            },
                            {
                                "example_id": "b0ebe52a-8038-457f-86cc-07e16608aaea",
                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                "text": "„Der Wurzelballen der Hortensie kann nach der Blüte in den eigenen Garten gepflanzt werden.“"
                            },
                            {
                                "example_id": "d4e3cbee-8836-4277-8789-1b787e687003",
                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                "text": "„Die Hortensien sind inzwischen bis zu zwei Meter hoch und setzen mit ihren Blütenwolken in Rosatönen ein farbiges Gegengewicht zu den imposanten Bruchsteinmauern.“"
                            },
                            {
                                "example_id": "73ec73aa-b07e-4e71-b85b-0d4876d7f7b1",
                                "sense_id": "baa90dc8-20ee-31cc-939d-2348eb8f7c46",
                                "text": "„Die getrockneten Blütendolden der Hortensien sehen besonders im Winter schön aus.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
