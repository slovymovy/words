{
    "word_family": [
        "shacky"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "89c0300c-0e75-3768-b0a0-eeb859dc0aed",
                    "sense_definition": "A crude, roughly built hut or cabin.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The old fisherman lived in a small wooden <w>shack</w> right by the edge of the lake.",
                            "target_lang_translations": {
                                "ru": "Старый рыбак жил в маленькой деревянной <w>хижине</w> у самого края озера."
                            }
                        },
                        {
                            "text": "They built a temporary <w>shack</w> in the forest to shelter from the heavy rain.",
                            "target_lang_translations": {
                                "ru": "Они построили в лесу временную <w>времянку</w>, чтобы укрыться от проливного дождя."
                            }
                        }
                    ],
                    "synonyms": [
                        "hovel",
                        "shanty"
                    ],
                    "common_phrases": [
                        "wooden shack",
                        "small shack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Простая, грубо построенная хижина или лачуга."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лачу́га",
                                "target_lang_sense_clarification": "маленькое, бедное, жалкое жилище"
                            },
                            {
                                "target_lang_word": "хи́жина",
                                "target_lang_sense_clarification": "небольшой, обычно небогатый дом"
                            },
                            {
                                "target_lang_word": "хиба́ра",
                                "target_lang_sense_clarification": "небольшой убогий домик"
                            },
                            {
                                "target_lang_word": "время́нка",
                                "target_lang_sense_clarification": "временная постройка"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3444c368-97f2-3771-b712-836c086956d6",
                    "sense_definition": "Any poorly constructed or poorly furnished building.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "shelter",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The train station was nothing more than a run-down <w>shack</w> with a single bench.",
                            "target_lang_translations": {
                                "ru": "Железнодорожная станция представляла собой не более чем захудалую <w>халупу</w> с единственной скамейкой."
                            }
                        },
                        {
                            "text": "He refused to pay rent for such a dilapidated <w>shack</w> in the middle of the city.",
                            "target_lang_translations": {
                                "ru": "Он отказался платить за аренду такой полуразрушенной <w>хибары</w> в центре города."
                            }
                        }
                    ],
                    "synonyms": [
                        "hovel"
                    ],
                    "common_phrases": [
                        "run-down shack"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое плохо построенное или скудно обставленное здание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "хиба́ра",
                                "target_lang_sense_clarification": "очень скромное, ветхое жилище"
                            },
                            {
                                "target_lang_word": "халу́па",
                                "target_lang_sense_clarification": "маленькое неблагоустроенное жилище"
                            },
                            {
                                "target_lang_word": "развалю́ха",
                                "target_lang_sense_clarification": "ветхое, полуразрушенное строение"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d6e6c952-b1b7-3630-b986-0eef9a86a029",
                    "sense_definition": "The room or small building from which a ham radio operator transmits.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spent his weekends in the radio <w>shack</w>, trying to contact operators from other continents.",
                            "target_lang_translations": {
                                "ru": "Выходные он проводил в своей <w>радиорубке</w>, пытаясь связаться с операторами с других континентов."
                            }
                        },
                        {
                            "text": "The amateur radio enthusiast filled his backyard <w>shack</w> with antennas and receivers.",
                            "target_lang_translations": {
                                "ru": "Радиолюбитель заставил свою садовую <w>будку</w> антеннами и приемниками."
                            }
                        }
                    ],
                    "common_phrases": [
                        "radio shack"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used primarily among amateur radio enthusiasts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Комната или небольшое помещение, из которого вещает радиолюбитель."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "радиору́бка",
                                "target_lang_sense_clarification": "помещение для радиоаппаратуры"
                            },
                            {
                                "target_lang_word": "ше́к",
                                "target_lang_sense_clarification": "жаргон радиолюбителей"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9626f29-a2b1-3f4f-8036-a0721d321699",
                    "sense_definition": "A shiftless fellow; a low, itinerant beggar; a vagabond or tramp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The townspeople regarded the wanderer as a lazy <w>shack</w> who refused to do any honest work.",
                            "target_lang_translations": {
                                "ru": "Горожане считали странника ленивым <w>бродягой</w>, который отказывался от любой честной работы."
                            }
                        },
                        {
                            "text": "He was just an old <w>shack</w> traveling from town to town looking for scraps of food.",
                            "target_lang_translations": {
                                "ru": "Он был всего лишь старым <w>бродяжкой</w>, путешествующим из города в город в поисках остатков еды."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic slang for a vagrant"
                        },
                        {
                            "trait_type": "dated",
                            "comment": "No longer in common modern usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бездельник, бродяга или нищий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродя́га",
                                "target_lang_sense_clarification": "человек без постоянного места жительства"
                            },
                            {
                                "target_lang_word": "безде́льник",
                                "target_lang_sense_clarification": "праздный человек"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "94f77041-6dd1-3a3e-8cd9-8808b3da9ae3",
                    "sense_definition": "Grain fallen to the ground and left after harvest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The pigs were turned out into the fields to feed on the <w>shack</w> left behind by the reapers.",
                            "target_lang_translations": {
                                "ru": "Свиней выгнали на поля кормиться <w>падалицей</w>, оставленной жнецами."
                            }
                        },
                        {
                            "text": "After the harvest, there was plenty of <w>shack</w> on the ground for the birds to eat.",
                            "target_lang_translations": {
                                "ru": "После сбора урожая на земле оставалось много <w>осыпавшегося зерна</w> на корм птицам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly agricultural or regional English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Зерно, опавшее на землю и оставшееся после сбора урожая."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́далица",
                                "target_lang_sense_clarification": "осыпавшееся зерно"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5468d9a3-4e29-3882-8784-d14635ff8e6f",
                    "sense_definition": "Nuts which have fallen to the ground.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In autumn, the forest floor was covered with acorns and other <w>shack</w>.",
                            "target_lang_translations": {
                                "ru": "Осенью лесная подстилка была покрыта желудями и другой <w>падалицей</w>."
                            }
                        },
                        {
                            "text": "The animals gathered the fallen <w>shack</w> to prepare for the cold winter months.",
                            "target_lang_translations": {
                                "ru": "Животные собирали опавшие <w>орехи</w>, чтобы подготовиться к холодным зимним месяцам."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly regional English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Орехи или желуди, опавшие на землю."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "па́далица",
                                "target_lang_sense_clarification": "опавшие плоды или орехи"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "290b88e8-9635-3ed1-b52c-d0e3db441680",
                    "sense_definition": "Freedom to pasturage in order to feed upon fallen grain or nuts.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local farmers claimed their traditional right of <w>shack</w> for their sheep after the harvest.",
                            "target_lang_translations": {
                                "ru": "Местные фермеры заявили о своем традиционном <w>праве выпаса</w> овец на полях после сбора урожая."
                            }
                        },
                        {
                            "text": "The landlord disputed the tenants' customary right to <w>shack</w> on the stubble fields.",
                            "target_lang_translations": {
                                "ru": "Землевладелец оспаривал обычное право арендаторов на <w>выпас</w> скота по стерне."
                            }
                        }
                    ],
                    "common_phrases": [
                        "right of shack"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Relating to historical common land rights"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Право выпаса скота на полях после сбора урожая для поедания опавшего зерна или орехов."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пра́во выпаса",
                                "target_lang_sense_clarification": "историческое право на выпас скота по стерне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "879c3462-9dca-31cf-aaa3-988bc585faee",
                    "sense_definition": "Bait that can be picked up at sea.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The fishermen gathered small fish and other <w>shack</w> from the surface to use as bait.",
                            "target_lang_translations": {
                                "ru": "Рыбаки собирали с поверхности мелкую рыбешку и прочую <w>живность</w> для использования в качестве наживки."
                            }
                        },
                        {
                            "text": "Without proper lures, they had to rely on whatever <w>shack</w> they could find in the water.",
                            "target_lang_translations": {
                                "ru": "Без подходящих приманок им приходилось полагаться на любую <w>наживку</w>, которую они могли найти в воде."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "Mainly used in specific coastal fishing communities"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Наживка, которую можно собрать в море."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "нажи́вка",
                                "target_lang_sense_clarification": "собранный в море мелкий корм для рыбы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "482e8b39-ca00-3b8b-b10e-cf4eba67df8d",
                    "sense_definition": "A drink, especially an alcoholic one.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After a long day of hard labor, they stopped at the local tavern for a quick <w>shack</w>.",
                            "target_lang_translations": {
                                "ru": "После долгого дня тяжелого труда они заглянули в местную таверну, чтобы быстро <w>выпить</w>."
                            }
                        },
                        {
                            "text": "He poured his guest a strong <w>shack</w> to warm him up from the freezing cold.",
                            "target_lang_translations": {
                                "ru": "Он налил гостю крепкой <w>выпивки</w>, чтобы тот согрелся с мороза."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "Obsolete or highly regional slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Напиток, особенно алкогольный."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вы́пивка",
                                "target_lang_sense_clarification": "алкогольный напиток"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "311adbfb-051a-3c14-95fa-3d3cd333ca6e",
                    "sense_definition": "To live (in or with); to reside temporarily, especially to cohabit.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "They decided to <w>shack</w> up in a small apartment downtown to save money on rent.",
                            "target_lang_translations": {
                                "ru": "Они решили <w>сожительствовать</w> в небольшой квартире в центре города, чтобы сэкономить на аренде."
                            }
                        },
                        {
                            "text": "He chose to <w>shack</w> with his friends during the summer break instead of going home.",
                            "target_lang_translations": {
                                "ru": "Он предпочел <w>пожить</w> у друзей во время летних каникул вместо того, чтобы ехать домой."
                            }
                        }
                    ],
                    "common_phrases": [
                        "shack up"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Often used in the phrasal verb form 'shack up'"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Жить (где-то или с кем-то), временно проживать, особенно сожительствовать."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сожи́тельствовать",
                                "target_lang_sense_clarification": "жить вместе без регистрации брака"
                            },
                            {
                                "target_lang_word": "юти́ться",
                                "target_lang_sense_clarification": "временно проживать в скромных условиях"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "00fb611a-0c5b-3791-97c6-73376826e233",
                    "sense_definition": "To shed or fall, as corn or grain at harvest.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If the wheat is left too long in the dry wind, the ripe grain will begin to <w>shack</w>.",
                            "target_lang_translations": {
                                "ru": "Если пшеницу оставить слишком долго на сухом ветру, спелое зерно начнет <w>осыпаться</w>."
                            }
                        },
                        {
                            "text": "The farmers hurried to harvest the crop before the heavy rains caused the barley to <w>shack</w>.",
                            "target_lang_translations": {
                                "ru": "Фермеры спешили собрать урожай, пока проливные дожди не заставили ячмень <w>осыпаться</w>."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly agricultural or regional English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Осыпаться (о зерне во время жатвы)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "осыпа́ться",
                                "target_lang_sense_clarification": "о зерне"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "eda3a07e-3293-302e-a29d-69a8d6874dad",
                    "sense_definition": "To feed in stubble, or upon waste grain and nuts left in the fields.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The geese were sent out to <w>shack</w> upon the barley stubbles after the harvest was gathered.",
                            "target_lang_translations": {
                                "ru": "Гусей отправили <w>кормиться</w> на ячменную стерню после того, как урожай был собран."
                            }
                        },
                        {
                            "text": "He allowed his pigs to <w>shack</w> in the oak woods to feed on the fallen acorns.",
                            "target_lang_translations": {
                                "ru": "Он разрешил своим свиньям <w>пастись</w> в дубовом лесу, чтобы они питались опавшими желудями."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Mainly agricultural or regional English"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Кормиться на стерне или поедать опавшее зерно и орехи, оставшиеся на полях."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "корми́ться",
                                "target_lang_sense_clarification": "о скоте на убранном поле"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "253977f5-c3c1-34ce-9592-d6c169a886f5",
                    "sense_definition": "To wander about as a vagabond or tramp.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He chose to <w>shack</w> through the countryside, sleeping under the stars and doing odd jobs.",
                            "target_lang_translations": {
                                "ru": "Он предпочел <w>бродяжничать</w> по сельской местности, ночуя под звездами и подрабатывая случайными заработками."
                            }
                        },
                        {
                            "text": "Instead of finding a steady job, he preferred to <w>shack</w> around from town to town.",
                            "target_lang_translations": {
                                "ru": "Вместо того чтобы найти постоянную работу, он предпочитал <w>скитаться</w> из города в город."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dialectal",
                            "comment": "Regional or archaic slang"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Бродяжничать, скитаться."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "бродя́жничать",
                                "target_lang_sense_clarification": "вести бродячую жизнь"
                            },
                            {
                                "target_lang_word": "скита́ться",
                                "target_lang_sense_clarification": "странствовать без цели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7aadd9b3-8382-3466-9636-f88052609ef0",
                    "sense_definition": "To hibernate; to go into winter quarters.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "As the temperature dropped, the bears began to <w>shack</w> in their deep mountain caves.",
                            "target_lang_translations": {
                                "ru": "Когда температура упала, медведи начали <w>устраиваться на зимовку</w> в своих глубоких горных пещерах."
                            }
                        },
                        {
                            "text": "The small rodents will <w>shack</w> underground until the warm spring weather returns.",
                            "target_lang_translations": {
                                "ru": "Мелкие грызуны будут <w>зимовать</w> под землей, пока не вернется теплое весеннее тепло."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Rare or regional usage"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Впадать в спячку; устраиваться на зимовку."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зимова́ть",
