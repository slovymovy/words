                "translations": [
                    {
                        "translation_id": "2df81a35-c595-4f34-a0a4-36872c9c33ea",
                        "source_entry_id": "10444730-a0c2-3605-8703-97ea8ab72f8a",
                        "source_sense_id": "fe72833b-3f50-37d2-830f-96c778205147",
                        "target_lang_word": "airline",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airline",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                        "entry_id": "04eba686-609d-3239-8257-3f5909dd4d62",
                                        "glosses": [
                                            "A company that flies airplanes to transport people and goods."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6eefad38-d99e-4f75-ae56-1272f1b5f356",
                                                "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                                "text": "But already there are some commercial air­lines in the United States which use airplanes cap­able of more than 200 miles an hour."
                                            },
                                            {
                                                "example_id": "e70ea5cb-89f1-4c82-b29a-6b72478702af",
                                                "sense_id": "9d232287-544e-36d6-9496-b29d625f21ba",
                                                "text": "They and the airline itself described an internal process that requires multiple departments to manually redesign the airline’s schedule – a system that works “the vast majority of the time,” Southwest said in a statement. […] Other airlines managed to recover by early this week; at Southwest, the cancellations only increased."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c6db3500-ea1a-428f-966f-f0ebf509d670",
                        "source_entry_id": "10444730-a0c2-3605-8703-97ea8ab72f8a",
                        "source_sense_id": "fe72833b-3f50-37d2-830f-96c778205147",
                        "target_lang_word": "airway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "airway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ad8b4b9d-f407-3527-973c-5dbfd9ac82fe",
                                        "entry_id": "e96cc0df-ea8c-3b93-b5fe-78033351e4a7",
                                        "glosses": [
                                            "The trachea."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5868a3f5-45e7-4b94-90e9-8eba630c34b4",
                                                "sense_id": "ad8b4b9d-f407-3527-973c-5dbfd9ac82fe",
                                                "text": "The burners on gas stoves release pollutants including nitrogen dioxide, a key element in smog that can irritate airways and may contribute to the development of asthma, according to the U.S. Environmental Protection Agency."
                                            },
                                            {
                                                "example_id": "eb2eb5ec-471a-4a11-9d69-c212d1f4f14b",
                                                "sense_id": "ad8b4b9d-f407-3527-973c-5dbfd9ac82fe",
                                                "text": "David Williams, a scientist who evaluates antivenoms for WHO, says the biggest risk to people who are bitten by these snakes is paralysis, \"which can prevent them from being able to control their airway and breathing and they can potentially suffocate and die as a result of that.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e495c9e-15ec-35cd-a9fe-eff7c1d49e00",
                                        "entry_id": "e96cc0df-ea8c-3b93-b5fe-78033351e4a7",
                                        "glosses": [
                                            "A flight path used by aeroplanes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e474151-bd95-44be-887b-fc4e8a406918",
                                                "sense_id": "8e495c9e-15ec-35cd-a9fe-eff7c1d49e00",
                                                "text": "But British Airways Flight 112 made the trek in under five hours, setting a new record for the fastest subsonic commercial flight across the Atlantic Ocean."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "acf17a7e-274e-3f6b-bdc7-2a544e0eef3e",
                                        "entry_id": "e96cc0df-ea8c-3b93-b5fe-78033351e4a7",
                                        "glosses": [
                                            "A roadway used for ventilation."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
