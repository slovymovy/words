                        "cross_references": [
                            {
                                "target_word": "dipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1347bae8-671a-3e27-9715-7179eacd0475",
                                        "entry_id": "fe5cecb1-467e-3a63-8a70-1b4dd0de51a2",
                                        "glosses": [
                                            "A stick or rod used to measure the depth of a liquid. Often used to check the level at which a liquid in an opaque or inaccessible tank or reservoir stands; gauge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f15f93d-a19c-46af-afa1-aba962bdb6a2",
                                                "sense_id": "1347bae8-671a-3e27-9715-7179eacd0475",
                                                "text": "I haven't checked the oil level of my car's motor since I lost the dipstick three months ago."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d0add589-9557-36e7-ba38-9f1ad80615f3",
                                        "entry_id": "fe5cecb1-467e-3a63-8a70-1b4dd0de51a2",
                                        "glosses": [
                                            "An exciseman or supervisor who measures with a dipstick."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "9cf40dea-f2a0-3525-8b4f-124a2711a015",
                                        "entry_id": "fe5cecb1-467e-3a63-8a70-1b4dd0de51a2",
                                        "glosses": [
                                            "The penis."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8e786856-9d79-3bd3-81c5-ea441b966e0b",
                                        "entry_id": "fe5cecb1-467e-3a63-8a70-1b4dd0de51a2",
                                        "glosses": [
                                            "A useless person of inferior intellect; a dipshit."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d80d319c-1d2a-4e8b-a639-e7bde0f5e408",
                                                "sense_id": "8e786856-9d79-3bd3-81c5-ea441b966e0b",
                                                "text": "That referee is a right dipstick."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "dipstick",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "92d3b545-1f98-3719-bd80-f207a1eb41b6",
                                        "entry_id": "cb52548d-6a80-3466-a11e-32004f5b714f",
                                        "glosses": [
                                            "To check (a person) for their understanding of something, as of a lesson, or attitude toward something."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8e8a3023-af87-4a5f-940a-e36a636a0602",
                                                "sense_id": "92d3b545-1f98-3719-bd80-f207a1eb41b6",
                                                "text": "What most educators mean by “doing Madeline Hunter” is using her seven-step approach to planning a lesson. In Santa Barbara, as in most of her road shows, several hours are devoted to spelling out this technique, which calls for specific acts of review, introduction, explanation, “modeling” (demonstrating), “dipsticking” (checking for understanding), “monitored practice” and independent study."
                                            },
                                            {
                                                "example_id": "9529de73-15e6-4278-8660-674df17d9d08",
                                                "sense_id": "92d3b545-1f98-3719-bd80-f207a1eb41b6",
                                                "text": "In private, Secretary Powell, an amateur automotive mechanic, complains that old friends spend too much time sympathetically taking his temperature — “dip-sticking me,” as he puts it."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1870197d-fc58-3ca2-a428-012fa3b0cb54",
                                        "entry_id": "cb52548d-6a80-3466-a11e-32004f5b714f",
                                        "glosses": [
                                            "To measure the level of a fluid using a dipstick."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab10ed5e-0516-4300-b316-605341ea41e5",
                                                "sense_id": "1870197d-fc58-3ca2-a428-012fa3b0cb54",
                                                "text": "If one of the fuel gauges is inoperative (flight is not permitted if both have failed), the tanks have to be dipsticked before and after each fueling to confirm the aircraft's fuel status."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "723d2102-ab4d-465a-9629-f2b9fd51ba95",
                        "source_entry_id": "320dbbf5-9c6e-3f5f-9639-a25f95820043",
                        "source_sense_id": "1dd75aaf-eb3d-3bf3-8d82-3c552b2a79b7",
                        "target_lang_word": "jauge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "jauge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5a96ae31-e98e-3277-a5fa-d3bb826a90d8",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Instrument servant à effectuer une mesure. → voir jaugette, jauge de hauteur et jauge de profondeur"
                                        ],
                                        "tags": [
                                            "generically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "19e3f504-594c-4dd8-b548-e05d830caa50",
                                                "sense_id": "5a96ae31-e98e-3277-a5fa-d3bb826a90d8",
                                                "text": "L’épaisseur de l’écorce est mesurée à l’aide d’une jauge sur les faces des billes des arbres échantillons."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4aecc220-fe6e-320d-92cd-2afe937a865b",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Règle graduée de bois ou de fer avec laquelle on mesure la capacité d’un récipient. → voir jauge d’essence et jauge de Paris"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "740668c4-459b-45a3-9daf-652203e168f6",
                                                "sense_id": "4aecc220-fe6e-320d-92cd-2afe937a865b",
                                                "text": "Y a-t-il assez d'essence dans le réservoir ? Contrôler avec une jauge."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "39a95b36-ff1d-3513-ba61-711511b959a6",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Cadran à aiguille ou numérique indiquant une quantité résiduelle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "acbc247a-12ae-4bec-b140-36a90eb7114f",
                                                "sense_id": "39a95b36-ff1d-3513-ba61-711511b959a6",
                                                "text": "Les kilomètres défilaient et elle gardait un œil sur sa jauge. — Je vais avoir besoin d'essence, soupira-t-elle."
                                            },
                                            {
                                                "example_id": "f73dc9c7-9e1e-464b-8da9-de76948ed3d3",
                                                "sense_id": "39a95b36-ff1d-3513-ba61-711511b959a6",
                                                "text": "Son œil s'attarde pourtant sur la jauge d’essence. Impitoyable, l’aiguille marque zéro. Par quel miracle, le réservoir où Mr. Smith a versé de ses mains, au moment du départ, soixante-dix litres de supercarburant, a-t-il pu se vider subitement ?"
                                            },
                                            {
                                                "example_id": "d8fb7c4c-af46-486d-8e57-25a5992e1ecc",
                                                "sense_id": "39a95b36-ff1d-3513-ba61-711511b959a6",
                                                "text": "La jauge de carburant de la Renault 11 se rapproche de plus en plus du zéro absolu à mesure que le véhicule se rapproche de la sortie Villers-Semeuse et de son antique zone commerciale. […]. Pour accéder à la station, il faut entrer sur le parking […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5798ed0b-1e18-3b9c-9be8-d5146663e0b3",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Boîte percée de plusieurs trous calibrés qui sert au fontainier pour connaître la quantité d’eau que produit une source ou que débite un réservoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "95845491-edd2-4096-bf3f-7992f85cf77a",
                                                "sense_id": "5798ed0b-1e18-3b9c-9be8-d5146663e0b3",
                                                "text": "Le fontainier mesure la dépense des eaux (qui est leur écoulement ou leur débit dans un certain temps) par le moyen d’une jauge percée de plusieurs trous, depuis un pouce, jusqu’à deux lignes circulaires."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42433a41-e89c-34bd-9de4-4db3bdcca612",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Règle permettant d’effectuer un tracé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3af77d5-40c9-4372-a1aa-375af5e16e65",
                                                "sense_id": "42433a41-e89c-34bd-9de4-4db3bdcca612",
                                                "text": "Les empanons se coupent à la jauge, comme à la planche deuxième […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0bd42c02-8f7e-3e84-ad67-3b96545a0ba5",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Bande de parchemin graduée pour mesurer la grosseur des cordages."
                                        ],
                                        "tags": [
                                            "Corderie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d4a7b2d-f9af-4bc5-bfec-f4ec0e82421e",
                                                "sense_id": "0bd42c02-8f7e-3e84-ad67-3b96545a0ba5",
                                                "text": "Les cordiers ont une mesure pour prendre la grosseur des cordages ; ils la nomment jauge : c'est une bande de parchemin divisée par pouces et lignes, qui est roulée dans un barillet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "47604bb5-db38-36d7-a886-51f45522eaa4",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Nom de divers instruments qui servent à déterminer des contraintes mécaniques, des pressions…"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9bbcf39e-1435-4087-b943-9cf43e6e0816",
                                                "sense_id": "47604bb5-db38-36d7-a886-51f45522eaa4",
                                                "text": "On pense aux exemples cités de la jauge mécanique (pendule) et une jauge biologique (pouls), ou d'une jauge hydraulique (clepsydre), […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "18381b16-c8ed-3d5e-8227-0c981418a45e",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Dispositif ou objet qui permet de régler la profondeur du labour."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7148b035-e326-4ae2-b54d-bad30ab8c0e3",
                                                "sense_id": "18381b16-c8ed-3d5e-8227-0c981418a45e",
                                                "text": "[…] trois Membres du jury prenaient, avec une jauge faite exprès, la profondeur du sillon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1ed7423-b849-37da-96e1-17c173f8f5fe",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Capacité (juste mesure) que doit avoir un contenant."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7b1029bd-4321-4ac4-a4be-790956bde1ef",
                                                "sense_id": "d1ed7423-b849-37da-96e1-17c173f8f5fe",
                                                "text": "L’exposition dont il est question ici correspond à une de ces séries, mais le contenu est déclinable selon la jauge (la capacité d’accueil) du lieu d’exposition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "879a5afa-6da0-364e-be93-2d008fbe3507",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Nombre de spectateurs que peut contenir une salle."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ad4e65f-6e44-46fa-89c5-57d56d7144e1",
                                                "sense_id": "879a5afa-6da0-364e-be93-2d008fbe3507",
                                                "text": "Si le secteur de l’humour concentre la part la plus importante du nombre de représentations en France (près de 30 %), il ne cumule que 10 % de la billetterie car les spectacles se jouent essentiellement dans de petites jauges."
                                            },
                                            {
                                                "example_id": "52f578f2-fda1-44e7-8af0-2db659efd01b",
                                                "sense_id": "879a5afa-6da0-364e-be93-2d008fbe3507",
                                                "text": "Nous n’avons pas assez de jauge, et on n’a pas un vrai théâtre : c’est un ancien cinéma."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3ae8208-3268-363c-845e-b91e4a61059a",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Contenu d’un enseignement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0f77ce7a-a150-4da7-870f-a9b6894799d3",
                                                "sense_id": "f3ae8208-3268-363c-845e-b91e4a61059a",
                                                "text": "Ils font des exercices sur machine de quatre heures et valident seuls ces différentes étapes de leur formation par le suivi d'une jauge personnalisée."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8c15ed79-16b2-3498-bf79-59590885711a",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Quantité de gaz contenu dans un volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dd5a7426-eccb-42ab-a72a-a6b1809e3efd",
                                                "sense_id": "8c15ed79-16b2-3498-bf79-59590885711a",
                                                "text": "Analyse des gaz : actuellement, la jauge d'hydrogène conçue et réalisée par un américain de l’USGS est le seul capteur capable de mesurer de façon continue un paramètre chimique […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4e381c9-c388-3cee-9181-e9a43dc602cc",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Quantité d’informations stockées dans un fichier."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "87bde675-5c40-4551-8f04-ddc8a3142c0f",
                                                "sense_id": "d4e381c9-c388-3cee-9181-e9a43dc602cc",
                                                "text": "Une jauge sur cinq niveaux, située en haut à droite de l’écran, indique la quantité d’informations stockées sur une carte mémoire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6eb3c78f-d43a-3c89-a94e-c71a983eb1cc",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "État relatif des éléments physiques dans un système donné."
                                        ],
                                        "tags": [
                                            "Physique quantique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "640869b0-6544-4ad3-8289-30c200965ea5",
                                                "sense_id": "6eb3c78f-d43a-3c89-a94e-c71a983eb1cc",
                                                "text": "Il existe différentes classes de symétries : les symétries continues, celles de jauge, et également une autre classe de symétries appelées discontinues ou discrètes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1bd487a0-ced1-3c12-966c-2bbab5fc3503",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Mesure permettant le calcul d’un volume."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fc372782-2dd4-4275-b714-d53a392ae41a",
                                                "sense_id": "1bd487a0-ced1-3c12-966c-2bbab5fc3503",
                                                "text": "Ayant trouvé, comme ci-devant, l’aire de chaque brassiere (qui selon les lois de l'excise, doit être fixe & immuable), il ne reste plus qu’à trouver la vraie profondeur ou jauge de ce vaisseau pour pouvoir calculer la vraie quantité de bière […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1d540120-dc05-3361-8a88-9600ace821ad",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Distance laissée entre le sillon tracé par le soc de la charrue et la terre qui n’est pas encore labourée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5683276-66fe-42ec-9783-3ecdd4871546",
                                                "sense_id": "1d540120-dc05-3361-8a88-9600ace821ad",
                                                "text": "Jauge, signifie encore en terme de jardinier, la mesure de la profondeur que l’on veut donner à une tranchée ; & cette jauge est un bâton de longueur semblable à celle de cette profondeur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5cfde731-5255-329b-8120-816cd5239643",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Capacité d’un navire de commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "435fbdd7-254c-478c-bbfb-f48d5eed330d",
                                                "sense_id": "5cfde731-5255-329b-8120-816cd5239643",
                                                "text": "La présente convention entrera en vigueur douze mois après la date à laquelle auront été enregistrées les ratifications de douze Membres possédant chacun une marine marchande d’une jauge de plus de 1 million de tonneaux […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c1e75b5-fc5c-30d8-b5c0-a8ee50151554",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Contenance d’un tonneau de vin."
                                        ],
                                        "tags": [
                                            "Tonnellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5b76d1af-5b2a-40f1-8e70-d1ee8e5237a9",
                                                "sense_id": "6c1e75b5-fc5c-30d8-b5c0-a8ee50151554",
                                                "text": "On distingue à Bordeaux deux sortes de jauges, la grande & la petite. La barique de la grande jauge contient 110 pots, & la barique de la Petite jauge seulement 90."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "290bc5a9-08d9-3a32-80ba-ada3975aaab5",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Utilisation de cette mesure."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "768e3a8e-a087-4749-98e7-f027615d34df",
                                                "sense_id": "290bc5a9-08d9-3a32-80ba-ada3975aaab5",
                                                "text": "Étalonnage d’une jauge étalon de travail au moyen d’une jauge de référence."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6cc7ec1f-ed90-3fa7-a1ef-dc32ece0460d",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Tranchée ouverte pour y placer des végétaux en attente. → voir mettre en jauge et à vive jauge"
                                        ],
                                        "tags": [
                                            "Arboriculture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "927d6666-1f6a-4632-92bc-c9beb2a89a5d",
                                                "sense_id": "6cc7ec1f-ed90-3fa7-a1ef-dc32ece0460d",
                                                "text": "Sortir les plantes de leur emballage provisoire, les placer en jauge les unes contre les autres […]"
                                            },
                                            {
                                                "example_id": "f3a7d06e-68d8-479b-a13c-90303f94d8e5",
                                                "sense_id": "6cc7ec1f-ed90-3fa7-a1ef-dc32ece0460d",
                                                "text": "Si l’emplacement de la jauge est prévu dans un sol non sableux et/ou non correctement drainé, il convient de prévoir l’apport de sable."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2d4bc11b-f56b-323a-bacc-49f70cdc4a81",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Taxe qui se levait sur les vins, eaux-de-vie, etc. lorsqu’ils étaient vendus ou qu'ils changeaient de main."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "47080a80-8535-48c9-a87f-7a8f20b8082c",
                                                "sense_id": "2d4bc11b-f56b-323a-bacc-49f70cdc4a81",
                                                "text": "Personne n'est exempt des droits de jauge & courtage à la vente en détail dans les pays d'aides non sujets aux droits de gros […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e94f13d9-85cc-37c5-af5e-d32cf6fcc3c9",
                                        "entry_id": "05d27875-f389-3e22-8c2d-733347d805e5",
                                        "glosses": [
                                            "Barreau de fer emmanché qui sert à manier l’enclume ou de grosses masses de fer."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bea1d555-023a-40ae-85ef-62bda84de426",
                                                "sense_id": "e94f13d9-85cc-37c5-af5e-d32cf6fcc3c9",
                                                "text": "Grande forge ; a, chevet de cette forge ; h, billot de bois sur lequel on forge ; c, le jaugeur qui est assis sur la jauge' ; m, manche de la jauge ; n, clef qui sert à tourner l’enclume; o, fer de la jauge […]"
                                            }
                                        ]
                                    }
                                ]
