                "forms": [
                    {
                        "form_id": "fe51b291-4019-43ad-ba54-134432356a3d",
                        "entry_id": "3ed98f9f-fb3f-3360-86d6-39d7c7864720",
                        "tags": [
                            "plural"
                        ],
                        "form": "siths"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a323b778-92f1-355e-ae8a-86ad1a78ece1",
                        "entry_id": "3ed98f9f-fb3f-3360-86d6-39d7c7864720",
                        "glosses": [
                            "A journey, way."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "d02b5107-d380-44f4-a020-475465f77953",
                                "sense_id": "a323b778-92f1-355e-ae8a-86ad1a78ece1",
                                "text": "The holy gost before vs glad / ffull softly on his sithe"
                            }
                        ]
                    },
                    {
                        "sense_id": "0ef81946-1538-372d-bb70-507568696bc1",
                        "entry_id": "3ed98f9f-fb3f-3360-86d6-39d7c7864720",
                        "glosses": [
                            "One's journey of life, experience, one's lot, also by extension life, lifetime."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "bb9f4c3c-adb9-412b-868d-3386af33924b",
                                "sense_id": "0ef81946-1538-372d-bb70-507568696bc1",
                                "text": "Christ's sith of sorrow and suffering."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e4ac4d1-0a40-3770-b185-9a1289b62b63",
                        "entry_id": "3ed98f9f-fb3f-3360-86d6-39d7c7864720",
                        "glosses": [
                            "An instant in time, a point in time or an occasion."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "6cedbf5d-d649-4912-a58a-a7d87b62c6fa",
                                "sense_id": "5e4ac4d1-0a40-3770-b185-9a1289b62b63",
                                "text": "Of them the other philosophers have, by siths, taken their beginning."
                            },
                            {
                                "example_id": "8887f54c-79c1-46ff-8a0d-679bdb998654",
                                "sense_id": "5e4ac4d1-0a40-3770-b185-9a1289b62b63",
                                "text": "The foolish man thereat woxe wondrous blith, / As if the word so spoken, were halfe donne, / And humbly thanked him a thousand sith, / That had from death to life him newly wonne."
                            },
                            {
                                "example_id": "e084b249-12d3-43cf-941a-ea398ff0e088",
                                "sense_id": "5e4ac4d1-0a40-3770-b185-9a1289b62b63",
                                "text": "His land mortgag'd, he, sea-beat in the way, / Wishes for home a thousand siths a day."
                            }
                        ]
                    }
                ],
