                                "target_senses": [
                                    {
                                        "sense_id": "8f24a6f2-d817-39e8-941a-1158ee55738f",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Action de recevoir une chose qui a été adressée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "25764062-8879-4eb2-a9eb-d095dc281b8b",
                                                "sense_id": "8f24a6f2-d817-39e8-941a-1158ee55738f",
                                                "text": "Dès réception de la pièce, il faudra faire la réparation le plus vite possible."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bf838589-50bc-3af1-a0e3-4b6f5b35e2dd",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Action de recevoir des ondes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fc95023-b0ed-4da4-a217-f70770d9f6d6",
                                                "sense_id": "bf838589-50bc-3af1-a0e3-4b6f5b35e2dd",
                                                "text": "La technologie, là encore, a permis d’élargir le champ de liberté du téléspectateur grâce au magnétoscope, à la télécommande, au câble et à la réception satellitaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "716c78b7-b34c-3fec-9999-580f70a148f7",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Procédure par laquelle on accepte un résultat comme conforme à la commande passée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8f3616dd-e19e-4574-af31-aee993fdf23d",
                                                "sense_id": "716c78b7-b34c-3fec-9999-580f70a148f7",
                                                "text": "Faire la réception d’un chantier"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d529e036-24b7-3b6a-b3a0-06b0711637d8",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Accueil ; manière de recevoir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "44708b00-8f7c-41ff-b55c-2ebcdcabd8b6",
                                                "sense_id": "d529e036-24b7-3b6a-b3a0-06b0711637d8",
                                                "text": "Le lendemain, je me rendis à bord du Rochester, où une quarantaine d’officiers, réunis à leur mess autour d’une table immense, me firent une excellente réception."
                                            },
                                            {
                                                "example_id": "bf6dcbcf-206e-47bf-a28b-8b0aed7c169e",
                                                "sense_id": "d529e036-24b7-3b6a-b3a0-06b0711637d8",
                                                "text": "L’hôtesse demeura suffoquée.\n« Monseigneur, balbutia-t-elle, daignera me pardonner ma réception d’hier. Mais je ne pouvais deviner… […] »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c94c48bf-ce44-31c9-9aef-6e7691102762",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Manière dont une œuvre est perçue, lue ou interprétée dans un autre contexte culturel ou temporel."
                                        ],
                                        "tags": [
                                            "Littérature comparée"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "d67425fa-c00c-3d23-abb4-36df1e49994e",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Action de recevoir plusieurs personnes à la fois, avec une sorte de cérémonial."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "34a458ed-be70-4f44-b2aa-30296b43fc9d",
                                                "sense_id": "d67425fa-c00c-3d23-abb4-36df1e49994e",
                                                "text": "Il y avait réception chez le roi, chez la reine."
                                            },
                                            {
                                                "example_id": "c96ce591-c4e3-4de2-a5bd-6f7caecdfd26",
                                                "sense_id": "d67425fa-c00c-3d23-abb4-36df1e49994e",
                                                "text": "À l'aube de la réception de Bodo/Glimt, le défenseur revient sur la plus grave blessure de sa carrière."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dcc02358-3c08-3454-8bcd-9caef3d96bd2",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Cérémonie par laquelle quelqu’un est reçu dans une compagnie ou installé dans une charge."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e7d1a1ca-7b62-4331-8195-8565c75c9305",
                                                "sense_id": "dcc02358-3c08-3454-8bcd-9caef3d96bd2",
                                                "text": "Il y avait foule à l’Académie pour la séance de réception du nouvel académicien."
                                            },
                                            {
                                                "example_id": "85924030-076b-4869-80b9-fb64b26a4ee8",
                                                "sense_id": "dcc02358-3c08-3454-8bcd-9caef3d96bd2",
                                                "text": "Il s’était fait élire, et maintenant il ne voulait pas se faire recevoir.\nLa cérémonie de réception à l’Académie française obéissait à des rituels auxquels Robbe-Grillet refusait de se plier."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3b73c71a-1d89-38da-8357-d29df2d2a767",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Lieu dans un hôtel, une entreprise où les clients sont reçus, par extension, le service qui s’en occupe."
                                        ],
                                        "tags": [
                                            "Hôtellerie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "56ea5a51-ef18-455f-9613-b8293a061410",
                                                "sense_id": "3b73c71a-1d89-38da-8357-d29df2d2a767",
                                                "text": "On passe par la réception de l’hôtel pour s’installer au restaurant."
                                            },
                                            {
                                                "example_id": "d9dc8c51-f217-477f-97de-c5d17f1ea126",
                                                "sense_id": "3b73c71a-1d89-38da-8357-d29df2d2a767",
                                                "text": "Adressez vous à la réception pour commander votre taxi."
                                            },
                                            {
                                                "example_id": "b9ebd372-4745-4e0e-a1ce-08051947db07",
                                                "sense_id": "3b73c71a-1d89-38da-8357-d29df2d2a767",
                                                "text": "Je ne songeai même pas qu’il eût fallu me présenter à la réception."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e47b896-60dd-36ae-a551-08ad57501f79",
                                        "entry_id": "93fa118b-847d-37f5-aa76-880ef704dcff",
                                        "glosses": [
                                            "Action de retomber sur le sol."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f747a04f-94f8-4eec-b4b2-278eb05c7efb",
                                                "sense_id": "2e47b896-60dd-36ae-a551-08ad57501f79",
                                                "text": "C'était un numéro de passing notamment, à deux trapèzes et neuf massues. Loco y assurait la réception au sol, renvoyant aux deux acrobates qui se croisaient en mouvement synchronisé les massues tournoyantes."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
