                                    }
                                ]
                            },
                            {
                                "target_word": "Erwin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                        "entry_id": "467bdcb8-4837-37c6-9294-8b5878bce577",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4e9604e9-323e-4580-9cba-d27f5946f89e",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Frau Erwin ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "2f1bd496-407e-49b7-9791-b59a47b6210d",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Herr Erwin wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "98eeac2e-42b4-4074-b223-c25787668af5",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Die Erwins fliegen heute nach Kapstadt."
                                            },
                                            {
                                                "example_id": "fbed71dd-73ad-4d34-8387-dcc480cbce14",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Der Erwin trägt nie die Pullover, die die Erwin ihm strickt."
                                            },
                                            {
                                                "example_id": "660be2b3-b49b-4d73-b0c8-925d6126792b",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Erwin kommt, geht der Herr Erwin.“"
                                            },
                                            {
                                                "example_id": "3836c400-f1a1-42c4-afc1-a516be452f16",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Erwin kommt und geht."
                                            },
                                            {
                                                "example_id": "4ffd42a5-d82c-43fd-9a29-a82b84a791f5",
                                                "sense_id": "8c8bc112-9a37-3506-a352-710acabd01d0",
                                                "text": "Erwins kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
