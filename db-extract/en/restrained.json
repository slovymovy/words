                        ],
                        "examples": [
                            {
                                "example_id": "19621f4f-7477-479c-a8ec-932c6d5c3fd2",
                                "sense_id": "6f8818de-55c4-308a-8c9f-8f8bfdea71a8",
                                "text": "Ha? fie, these filthy vices. It were as good\nTo pardon him, that hath from nature stolne a man already made, as to remit\nTheir sawcie sweetnes, that do coyne heauens Image\nIn stamps that are forbid: 'tis all as easie,\nFalsely to take away a life true made,\nAs to put mettle in restrained meanes\nTo make a false one."
                            }
                        ]
                    }
