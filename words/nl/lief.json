                    "sense_id": "61ffa4a0-3851-3358-ad09-e96103bda773",
                    "sense_definition": "Aardig, vriendelijk en zachtaardig van karakter of gedrag.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "character",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De jongen is heel <w>lief</w> voor zijn hond.",
                            "target_lang_translations": {
                                "en": "The boy is very <w>sweet</w> to his dog.",
                                "ru": "Мальчик очень <w>добр</w> к своей собаке.",
                                "it": "Il ragazzo è molto <w>dolce</w> con il suo cane."
                            }
                        },
                        {
                            "text": "Ik vond het ontzettend <w>lief</w> dat je me gisteren hebt geholpen.",
                            "target_lang_translations": {
                                "en": "I thought it was incredibly <w>sweet</w> of you to help me yesterday.",
                                "ru": "Было очень <w>мило</w> с твоей стороны, что ты помог мне вчера.",
