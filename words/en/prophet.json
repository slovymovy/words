{
    "word_family": [
        "prophecy",
        "prophesy",
        "prophetic",
        "prophetical",
        "prophetess"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "5d7824f3-69ca-3bbe-8b06-b876617fcad8",
                    "sense_definition": "A person who is believed to speak for a deity or through divine inspiration",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_messenger",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient <w>prophet</w> warned the people to change their ways before it was too late.",
                            "target_lang_translations": {
                                "ru": "Древний <w>пророк</w> предупреждал народ, что нужно изменить свой образ жизни, пока не стало слишком поздно."
                            }
                        },
                        {
                            "text": "Many religions honor a <w>prophet</w> of God who delivered sacred laws to the community.",
                            "target_lang_translations": {
                                "ru": "Многие религии почитают <w>пророка</w> Божьего, который передал общине священные законы."
                            }
                        }
                    ],
                    "synonyms": [
                        "oracle",
                        "messenger"
                    ],
                    "common_phrases": [
                        "false prophet",
                        "biblical prophet",
                        "prophet of God"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, который, как считается, говорит от имени божества или под влиянием божественного вдохновения"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пророк",
                                "target_lang_sense_clarification": "религиозный проповедник воли Бога"
                            },
                            {
                                "target_lang_word": "пророчица",
                                "target_lang_sense_clarification": "женщина-пророк"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7ab2b13a-dbf5-3dea-bae4-91c1c21b258b",
                    "sense_definition": "A person who predicts what will happen in the future",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "predictor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Economists are often seen as a <w>prophet</w> of doom when they predict a market crash.",
                            "target_lang_translations": {
                                "ru": "Экономистов часто считают <w>пророками</w> гибели, когда они предсказывают крах рынка."
                            }
                        },
                        {
                            "text": "He was hailed as a <w>prophet</w> of the digital age for his early tech predictions.",
                            "target_lang_translations": {
                                "ru": "Его провозгласили <w>пророком</w> цифровой эры за его ранние технологические прогнозы."
                            }
                        }
                    ],
                    "synonyms": [
                        "soothsayer",
                        "seer",
                        "prognosticator",
                        "diviner"
                    ],
                    "common_phrases": [
                        "prophet of doom"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек, предсказывающий события будущего"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пророк",
                                "target_lang_sense_clarification": "человек, делающий точные прогнозы"
                            },
                            {
                                "target_lang_word": "предсказатель",
                                "target_lang_sense_clarification": "тот, кто предсказывает что-либо"
                            },
                            {
                                "target_lang_word": "прорицатель",
                                "target_lang_sense_clarification": "человек с даром предвидения"
                            },
                            {
                                "target_lang_word": "провидец",
                                "target_lang_sense_clarification": "человек, способный предвидеть будущее"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "47361741-03ae-3b42-b6be-0cf4a9ef282e",
                    "sense_definition": "The title used specifically to refer to Muhammad, the founder of Islam",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_figure",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Followers of Islam often say a blessing after mentioning the <w>Prophet</w>.",
                            "target_lang_translations": {
                                "ru": "Последователи ислама часто произносят благословение после упоминания <w>Пророка</w>."
                            }
                        },
                        {
                            "text": "The teachings of the <w>Prophet</w> are recorded in the Hadith.",
                            "target_lang_translations": {
                                "ru": "Учения <w>Пророка</w> записаны в Хадисах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Prophet Muhammad"
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, используемый специально для обозначения Мухаммеда, основателя ислама"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пророк",
                                "target_lang_sense_clarification": "о Мухаммеде в исламе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "12ad6e00-2a03-330a-9254-849ba4b79867",
                    "sense_definition": "Any of the specific religious figures mentioned in the Bible who delivered messages from God",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_figure",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The Old Testament contains many books written by a <w>Prophet</w> like Isaiah or Jeremiah.",
                            "target_lang_translations": {
                                "ru": "Ветхий Завет содержит много книг, написанных такими <w>пророками</w>, как Исаия или Иеремия."
                            }
                        },
                        {
                            "text": "In the cathedral, there are stained glass windows depicting each major <w>Prophet</w>.",
                            "target_lang_translations": {
                                "ru": "В соборе есть витражи с изображением каждого великого <w>пророка</w>."
                            }
                        }
                    ],
                    "common_phrases": [
                        "the Major Prophets"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой из конкретных религиозных деятелей, упомянутых в Библии, которые передавали послания от Бога"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Пророк",
                                "target_lang_sense_clarification": "библейский персонаж"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff052332-20a9-3386-ac1f-6ddb1a4330b1",
                    "sense_definition": "A title sometimes applied to Jesus in a historical or theological context",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_figure",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Some historical scholars refer to Jesus as a Galilean <w>Prophet</w>.",
                            "target_lang_translations": {
                                "ru": "Некоторые историки называют Иисуса галилейским <w>пророком</w>."
                            }
                        },
                        {
                            "text": "The crowd wondered if this man from Nazareth was indeed the <w>Prophet</w> they expected.",
                            "target_lang_translations": {
                                "ru": "Толпа гадала, был ли этот человек из Назарета тем самым <w>Пророком</w>, которого они ждали."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Титул, иногда применяемый к Иисусу в историческом или богословском контексте"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пророк",
                                "target_lang_sense_clarification": "в отношении Иисуса как исторической фигуры"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ad5b5586-30e6-3d80-9226-3de4315e999c",
                    "sense_definition": "A <w>surname</w>",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "The local library was named after David <w>Prophet</w>, a prominent local benefactor.",
                            "target_lang_translations": {
                                "ru": "Местная библиотека была названа в честь Дэвида <w>Профета</w>, видного местного благотворителя."
                            }
                        },
                        {
                            "text": "We found the name <w>Prophet</w> listed in the historical records of the parish.",
                            "target_lang_translations": {
                                "ru": "Мы нашли фамилию <w>Профет</w> в исторических записях прихода."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": "English family name"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Профет",
                                "target_lang_sense_clarification": "английская фамилия"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}