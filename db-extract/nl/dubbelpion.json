                        "glosses": [
                            "twee pionnen van dezelfde speler die achter elkaar op één lijn staan (doordat met een van die pionnen is geslagen)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0f670bfc-7097-4eb8-93df-648dea8354ac",
                                "sense_id": "62140a4d-4b62-331c-80d1-954ab7db8048",
                                "text": "We hebben nu allebei een officier verloren, die evenveel waard zijn, nl. drie pionnen. Maar nu moet je eens op je pionnen letten. Wat zie je op de c-lijn? Daar staan twee pionnen achter elkaar, één op c2 en één op c3. Dat noemen de schakers een dubbelpion. En dit moet je goed onthouden, Jan: meestal is een dubbelpion een zwakke plek in je spel. Een dubbelpion is dus meestal nadelig."
                            }
                        ]
                    }
