                                                "sense_id": "51b44ad7-2ca0-390d-be83-d51f64ee8800",
                                                "text": "His assets are much greater than his liabilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b418e66d-6835-388d-97bb-859b1aec6d59",
                                        "entry_id": "d4e36bc0-0025-30ef-a9e5-94d03f31cf2f",
                                        "glosses": [
                                            "The left side of a balance sheet."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1083a914-0ae2-40eb-a48d-58ed114940af",
                                                "sense_id": "b418e66d-6835-388d-97bb-859b1aec6d59",
                                                "text": "The assets must equal liabilities, otherwise there is an error in your balance sheet."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6e846309-01cf-3b3e-ab78-aefad1ef5464",
                                        "entry_id": "d4e36bc0-0025-30ef-a9e5-94d03f31cf2f",
                                        "glosses": [
                                            "Sufficient estate; property sufficient in the hands of an executor or heir to pay the debts or legacies of the testator or ancestor to satisfy claims against it."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-normally"
                                        ],
