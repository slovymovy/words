                "translations": [
                    {
                        "translation_id": "d9076c67-c8f3-48ad-9cea-f30e1c2b6e14",
                        "source_entry_id": "feca9b07-66d1-3c2f-888b-bcd41669a565",
                        "source_sense_id": "b6813863-fa44-37c5-a8b1-d6654f58e8ae",
                        "target_lang_word": "bayadere",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bayadere",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b3b7e5d5-ab26-3ae1-be5a-67d465d241e8",
                                        "entry_id": "b41f328d-a8bb-3414-83b7-264032ef214d",
                                        "glosses": [
                                            "A female dancer."
                                        ],
                                        "tags": [
                                            "countable",
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "05b5599b-fd3e-4248-b482-a6e29d7a8553",
                                                "sense_id": "b3b7e5d5-ab26-3ae1-be5a-67d465d241e8",
                                                "text": "Her performance being finished, the bayadere was succeeded by others, each of whom appeared to have her specialty--one imitating by her postures a serpent-charmer; another quite unequivocally representing a man-charmer; another rapidly executing what seemed an interminable pirouette."
                                            },
                                            {
                                                "example_id": "8cc1f438-e256-4da4-a7f0-d1d6aa75d374",
                                                "sense_id": "b3b7e5d5-ab26-3ae1-be5a-67d465d241e8",
                                                "text": "For the time, at any rate, the neat dexterity of counting and numbering machines, building machines, spinning engines, patent doorways, explosive motors, grain and water elevators, slaughter-house machines and harvesting appliances, was more fascinating to Graham than any bayadere."
                                            },
                                            {
                                                "example_id": "ffb76ac9-95c7-4474-a367-33937b05b10f",
                                                "sense_id": "b3b7e5d5-ab26-3ae1-be5a-67d465d241e8",
                                                "text": "The reflection of a greater thing claimed her and taught her, held her like a bayadere in a temple court."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "12e39cec-4371-387b-8288-db86d06b1240",
                                        "entry_id": "b41f328d-a8bb-3414-83b7-264032ef214d",
                                        "glosses": [
                                            "A type of fabric having strongly contrasting stripes."
                                        ],
                                        "tags": [
                                            "attributive",
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0f54b2b2-4bd6-4abe-9f0b-6b4eb1071e86",
                                                "sense_id": "12e39cec-4371-387b-8288-db86d06b1240",
                                                "text": "Bertha had chosen a blue and white silk of a bayadere stripe, with lace ruffles at the neck and wrists and a skirt of voluminous fulness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
