                ],
                "senses": [
                    {
                        "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                        "entry_id": "e42a2d6c-405f-3ad2-a12a-5170d467754a",
                        "glosses": [
                            "Ereignis, bei dem sich ein Boot auf dem Wasser auf die Seite legt"
                        ],
                        "tags": [
                            "Seemannssprache",
                            "von Wasserfahrzeugen"
                        ],
                        "examples": [
                            {
                                "example_id": "95352690-f8d0-4cc6-ad55-b975794e92ed",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "Nach einer Kenterung muss man die Jolle wieder aufrichten."
                            },
                            {
                                "example_id": "0a9ce9e0-d13a-48ea-a6cb-12244fb34e78",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "Jollen gehen nach einer Kenterung nicht unter."
                            },
                            {
                                "example_id": "5fcdd68e-d1c3-4c73-a2dd-041635882e47",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Beim sportlichen Segeln von Jollen kann eine Kenterung schon mal vorkommen.“"
                            },
                            {
                                "example_id": "dcdf6170-eeef-4149-abde-e96ea35db18b",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "[Jollen sind] „mit Schwimmkörpern ausgerüstet, so dass sie trotz Kenterung nicht sinken.“"
                            },
                            {
                                "example_id": "de7e7be9-66be-4f09-b156-fcb68bae6fab",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Bislang gingen die Kenterungen für die Sportler glimpflich aus: Die Segler blieben unverletzt,“ […]."
                            },
                            {
                                "example_id": "4ca7c4af-4d58-45e5-aa3f-c5064cc96c7d",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Bei der Kenterung der schwedischen Cup-Yacht war 2013 der britische Olympiasieger Andrew \"Bart\" Simpson ums Leben gekommen.“"
                            },
                            {
                                "example_id": "15423bd6-865f-4f8e-bbf2-07a659059f0b",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Doch leider mussten wir feststellen, dass wir“ […] „mittlerweile bestimmt 300 Meter vom Ziel weggetrieben waren, auch wenn die Kenterung uns höchstens einige Minuten gekostet hatte.“"
                            },
                            {
                                "example_id": "520b3990-ddee-4f5c-8e14-5e5bd09373f2",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Nur die „Cirrus“ hat die verzweifelten Rufe gehört. Es waren viele Unglücksfälle, die „Cumulus“ betroffen hatten: Grundberührung, Feuer an Bord, Mann über Bord, Kenterung und auch Medico-Gespräche wurden angemeldet.“"
                            },
                            {
                                "example_id": "b192e297-4126-4ac9-a8bd-d83c6825abe5",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Seekajaks sollen zur Sicherheit vor und hinter dem Paddler mit Schotts ausgestattet sein, so dass das Boot auch bei einer Kenterung nicht sinkt.“"
                            },
                            {
                                "example_id": "0c91e26b-2a6b-4031-9f58-339440645931",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Drei Ursachen sind es, auf die sich die meisten Kenterungen nach Lee im allgemeinen zurückführen lassen:“ […]."
                            },
                            {
                                "example_id": "9f97398c-6cc5-4f84-baaf-01ccf71c895f",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Zunächst überzeugt sich nach einer Kenterung jeder, ob der Mitsegler sich nicht irgendwo am Boot oder am laufenden Gut verfangen hat oder unter das Segel geraten ist.“"
                            },
                            {
                                "example_id": "b31cc142-f375-4beb-9437-d788ad318dfb",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "[…] „es gibt Umstände, unter denen ein Kentern so wahrscheinlich ist, daß ein vorsichtiger Plan mit dem Haupaugenmerk auf das Vermeiden einer Kenterung eher den Sieg bringen wird.“"
                            },
                            {
                                "example_id": "92d0ca8b-c50d-4029-896e-8182944e5b90",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "[An der chilenische Küste] „will er seine Windsteueranlage, die bei seiner Kenterung beschädigt wurde, mit Unterstützung von Land aus instand setzen.“"
                            },
                            {
                                "example_id": "915fb8ee-54f2-4b84-9e0a-90d1673820c5",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Es war eine dieser Kenterungen wie in Zeitlupe, die auch andere Teams nach Strömungsabriss an den Foils und in Folge beginnender Krängung schon erlebt haben.“"
                            },
                            {
                                "example_id": "7b4b4082-6a04-4794-9ef5-b788502eb828",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Abgesehen von der Tatsache, dass der heutige Morgen mit einer Kenterung, einer nassen Koje und Kopfschmerzen begann, hatte ich einen großartigen Tag.“"
                            },
                            {
                                "example_id": "e8e8bb0a-b59f-4d67-bda7-c54b93aadcd2",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "[Paul Elvstrøm] „entwickelte den Selbstlenzer, ein Metallventil im Rumpf, das bei Fahrt Spritzwasser aus dem Boot saugt oder nach einer Kenterung überhaupt erst das Weitersegeln ermöglicht.“"
                            },
                            {
                                "example_id": "dc9df0b5-ad8a-472d-bcb3-85f29a088bf6",
                                "sense_id": "d982b617-0ed5-3554-8c78-fcb9baa72f94",
                                "text": "„Gefährlich kann Eis für Schiffe werden, wenn überkommendes Wasser bzw. Nebel oder Nieselregen auf den Aufbauten gefriert und eine dicke Eisschicht bildet. Dadurch verschiebt sich der Schwerpunkt des Schiffes nach oben, was zur Kenterung des Schiffes führen kann.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
