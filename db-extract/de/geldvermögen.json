                ],
                "senses": [
                    {
                        "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                        "entry_id": "b54779c8-a5bb-37ad-b0b5-64ab7f79695a",
                        "glosses": [
                            "finanzielle Mittel und Ansprüche, die eine Person, ein Unternehmen oder ein Staat gegenüber anderen besitzt; das Geldvermögen setzt sich aus liquiden Mitteln (beispielsweise Bargeld, Bankguthaben) und Forderungen (z. B. Wertpapiere, Anleihen, Forderungen aus Krediten) zusammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9ea3e993-7892-4b76-8696-b19132a5c11a",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„2021 hatte das Geldvermögen weltweit noch um 10.4 Prozent auf umgerechnet 226.5 Billionen Schweizer Franken zugelegt.“"
                            },
                            {
                                "example_id": "4a3e6cc8-ef3f-4ae0-8209-024be42fee0a",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Das Geldvermögen der privaten Haushalte in Deutschland ist im dritten Quartal des Jahres 2023 um rund 197 Milliarden Euro gestiegen und hat zum Quartalsende ein neues Rekordniveau von rund 9.004 Milliarden Euro erreicht. Im Vorquartal war das Geldvermögen ebenfalls gestiegen.“"
                            },
                            {
                                "example_id": "c16d360b-4843-4212-9951-dcf29508506b",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„[…] auch 2025 könnten die Geldvermögen laut der Bank weiter zulegen und sich dann auf 9,8 Billionen Euro summieren.“"
                            },
                            {
                                "example_id": "a0265ace-5293-40d4-a092-e4c875e50edf",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Die Vermögen, besonders die Geldvermögen, sind sehr ungleich verteilt […].“"
                            },
                            {
                                "example_id": "646e3b84-f3fb-4a9d-85f4-ce8ab1fbbdae",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Die Verteilung der Geldvermögen in der DDR konterkarierte sozialistische Grundsätze: Etwa zehn Prozent der Konteninhaber besaßen 60 Prozent der Geldvermögen.“"
                            },
                            {
                                "example_id": "29ac6d97-c5d3-4e04-89a4-8e3717231f6f",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Abzüglich der Inflation erzielten die privaten Haushalte mit ihrem Geldvermögen zum Stichtag knapp drei Prozent Rendite.“"
                            },
                            {
                                "example_id": "8db2cbde-9cd2-4c66-b5bc-ec9b3863c2e2",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Der Anstieg des Geldvermögens spiegelt allerdings die geringe Konsumneigung der Verbraucher wider - was konjunkturell als problematisch gilt.“"
                            },
                            {
                                "example_id": "a193eb96-cbdc-4f32-917a-597355a1706f",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„2022 war ein schlechtes Jahr für das Geldvermögen weltweit.“"
                            },
                            {
                                "example_id": "0885403c-f362-4a02-b9f9-0fd135161f20",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„In Deutschland hatten die privaten Haushalte sowie die privaten Organisationen ohne Erwerbszweck im Jahr 2018 ein Bruttovermögen von fast 16 Billionen Euro. Mehr als die Hälfte davon entfiel auf Sachvermögen – insbesondere auf Immobilien und bebautes Land. 39 Prozent entfielen auf Geldvermögen und 7 Prozent auf Gebrauchsvermögen (z.B. Möbel, Pkw, technische Geräte und Schmuck).“"
                            },
                            {
                                "example_id": "90ea54ad-8a81-447e-b9a5-2cae3158c74d",
                                "sense_id": "6d246f76-a4f6-3e00-bf4e-6bd88037f357",
                                "text": "„Die Höhe des Geldvermögens des Bischöflichen Stuhls betrug zum 31. Dezember 2017 rund 0,5 Millionen Euro.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
