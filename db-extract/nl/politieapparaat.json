                        "examples": [
                            {
                                "example_id": "5791ebec-0271-4449-a441-cd2436da01d7",
                                "sense_id": "52512a23-5da0-3e07-a708-d8e22d1341b9",
                                "text": "Het Amsterdamse politieapparaat doet me in deze zaak denken aan een alcoholische vader die in diepe dronkenschap regelmatig zijn kinderen slaat. Als hij op een ochtend zijn zoontje met een blauw oog ziet, denkt hij: Ik sla zo vaak. Het zal gisteravond ook wel weer raak geweest zijn."
                            },
                            {
                                "example_id": "a1002e0f-daa4-4dc5-aa4b-45bd9513c39f",
                                "sense_id": "52512a23-5da0-3e07-a708-d8e22d1341b9",
                                "text": "Loekasjenko is om aan de macht te blijven afhankelijk van de loyaliteit van het politieapparaat. Bij de demonstraties, die begonnen na de verkiezingen van vorige maand, zijn duizenden betogers opgepakt. De oproerpolitie draagt daarbij vaak maskers, bivakmutsen of helmen om onherkenbaar te blijven."
                            }
                        ]
                    }
