                },
                {
                    "sense_id": "d23723db-941f-3b4b-a641-bbd66539435c",
                    "sense_definition": "With complete certainty; without any doubt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "certainty",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I can state <w>positively</w> that he was not at home last night.",
                            "target_lang_translations": {
                                "ru": "Я могу <w>с уверенностью</w> заявить, что прошлой ночью его не было дома.",
                                "zh": "我可以<w>确定</w>地说，他昨晚不在家。",
                                "es": "Puedo afirmar <w>con seguridad</w> que él no estaba en casa anoche.",
                                "tr": "Dün gece evde olmadığını <w>kesinlikle</w> söyleyebilirim.",
                                "de": "Ich kann <w>sicher</w> sagen, dass er gestern Abend nicht zu Hause war."
                            }
                        },
                        {
                            "text": "We need to identify <w>positively</w> the cause of the engine failure.",
                            "target_lang_translations": {
                                "ru": "Нам нужно <w>точно</w> установить причину отказа двигателя.",
                                "zh": "我们需要<w>明确</w>引擎故障的原因。",
                                "es": "Necesitamos identificar <w>con certeza</w> la causa del fallo del motor.",
                                "tr": "Motor arızasının nedenini <w>kesin olarak</w> belirlememiz gerekiyor.",
                                "de": "Wir müssen die Ursache des Motorausfalls <w>eindeutig</w> feststellen."
                            }
                        }
                    ],
                    "synonyms": [
                        "definitely",
                        "certainly",
                        "unquestionably",
                        "undeniably",
                        "surely"
                    ],
                    "antonyms": [
                        "doubtfully",
                        "uncertainly"
                    ],
                    "common_phrases": [
                        "know positively",
                        "state positively",
                        "identify positively"
                    ],
                    "target_lang_definitions": {
                        "ru": "С полной уверенностью; без всяких сомнений.",
                        "zh": "完全确定地；毫无疑问地。",
                        "es": "Con total certeza; sin ninguna duda.",
                        "tr": "Tam bir kesinlikle; hiçbir şüpheye yer bırakmadan.",
                        "de": "Mit völliger Gewissheit; ohne jeden Zweifel."
                    },
                    "translations": {
