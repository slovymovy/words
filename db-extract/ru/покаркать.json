                "senses": [
                    {
                        "sense_id": "8f496d52-0d4b-38cf-ab57-e940609a9208",
                        "entry_id": "3e350db9-fa7b-32ad-a7bc-b5c4eec46ef3",
                        "glosses": [
                            "провести некоторое время каркая"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2346042-dd26-4382-911d-ee75a29e8e9d",
                                "sense_id": "8f496d52-0d4b-38cf-ab57-e940609a9208",
                                "text": "…ворону, нашедшему добычу, всегда для чего-то нужно покаркать и оповестить об этом всех обитателей леса…"
                            }
                        ]
                    },
                    {
                        "sense_id": "00068bc1-594d-38ff-9b1a-e29f0b2e8fe4",
                        "entry_id": "3e350db9-fa7b-32ad-a7bc-b5c4eec46ef3",
                        "glosses": [
                            "каркнуть несколько раз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "211f694f-818e-4cb8-8fb6-e0df1a4e7163",
                                "sense_id": "00068bc1-594d-38ff-9b1a-e29f0b2e8fe4",
                                "text": "Его дом крайний, и если спрятаться в кустах да покаркать по-вороньи, Василек обязательно услышит и выбежит из дому."
                            }
                        ]
                    }
