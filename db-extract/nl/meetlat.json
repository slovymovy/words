                                            "transitive"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1b5e6174-8fd6-40bb-b63a-d5d125f69a3a",
                        "source_entry_id": "8431f04b-d87d-329f-98a8-e49d6da5df1d",
                        "source_sense_id": "4528a271-3f04-3cf8-b926-ee692b8a3ac2",
                        "source_sense_description": "een langwerpig voorwerp waarmee maten opgenomen worden",
                        "target_lang_word": "règle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "règle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "015c7dcb-f11f-35c2-9fdc-098fdd20c9d4",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Instrument de bois, de métal ou de quelque autre matière, qui sert à guider la main quand on veut tracer des lignes droites."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "252915ab-14a6-41e5-b163-d71ea141a663",
                                                "sense_id": "015c7dcb-f11f-35c2-9fdc-098fdd20c9d4",
                                                "text": "Nous écrivons sur une copie où chacune a d’abord inscrit en haut et à gauche son prénom et son nom, en haut et à droite la date, et au milieu le mot « Dictée » qu’il a fallu, comme le nom et la date, souligner en faisant habilement glisser sa plume le long d’une règle sans qu’il y ait de bavures. Le trait doit être parfaitement droit et net."
                                            },
                                            {
                                                "example_id": "40011ad2-c78f-4315-b9c4-74949f524d44",
                                                "sense_id": "015c7dcb-f11f-35c2-9fdc-098fdd20c9d4",
                                                "text": "Règle de bois, de cuivre, d’acier."
                                            },
                                            {
                                                "example_id": "042d924d-b039-4fab-908d-dc418c3b37a9",
                                                "sense_id": "015c7dcb-f11f-35c2-9fdc-098fdd20c9d4",
                                                "text": "Tirer une ligne avec la règle, à la règle."
                                            },
                                            {
                                                "example_id": "4503b9b9-b9bb-48bf-998f-dc60a5bf5465",
                                                "sense_id": "015c7dcb-f11f-35c2-9fdc-098fdd20c9d4",
                                                "text": "Autrefois, les écoliers fautifs étaient punis par administration de coups de règle sur les doigts ou sur les fesses."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a1709c85-3a9c-3012-82ad-96b3e5e89574",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Instrument parfaitement rectiligne qui sert au maçon à dresser une surface parfaitement plane."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b4c78db-82a2-427f-ac49-1e4cddf9900d",
                                                "sense_id": "a1709c85-3a9c-3012-82ad-96b3e5e89574",
                                                "text": "Le mélange est tiré à la règle ou à l’épandeuse sur le primaire recommandé, il est ensuite compacté et lissé manuellement à la taloche ou à l’hélicoptère."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Principe ; maxime ; loi ; enseignement, et généralement tout ce qui sert à conduire, à diriger l’esprit et le cœur."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "04a82173-558d-4f64-924b-14e7f5255b76",
                                                "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                                "text": "Le PLU édicte les règles d’urbanisme et d’utilisation des sols de la commune."
                                            },
                                            {
                                                "example_id": "68ab6613-9d7c-42d9-9ee6-4fef1c8957e8",
                                                "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                                "text": "Le vrai, indépendant de mes caprices, doit être la règle de mes jugements ; et je ne ferai point un crime à celui-ci de ce que j’admirerai dans celui-là comme une vertu."
                                            },
                                            {
                                                "example_id": "d9f76706-b59f-44a9-8979-7d27feef25cb",
                                                "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                                "text": "Suivre la règle. — Se conformer à la règle."
                                            },
                                            {
                                                "example_id": "6c4a8a5f-8081-4a06-a70a-bf159229838e",
                                                "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                                "text": "S’affranchir, s’écarter de la règle."
                                            },
                                            {
                                                "example_id": "feeb9ca3-c247-4f34-ada4-43dbb280778d",
                                                "sense_id": "50395edf-1520-396d-a526-a273f237aa1c",
                                                "text": "Sous la pression immobilière, les tentatives pour ordonner le territoire font long feu et toutes les occasions sont bonnes dans les municipalités pour assouplir les règles perçues comme trop contraignantes et ainsi construire toujours plus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97d322da-63d7-3bb7-8cf9-eb261858b4e2",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Préceptes qui servent à les enseigner les principes et les méthodes qui en rendent la connaissance plus facile et la pratique plus sûre ; de la manière de les pratiquer qui est considérée comme seule exacte, autorisée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5f5ef0f8-31d4-4fb8-ad57-2d767dabc0d9",
                                                "sense_id": "97d322da-63d7-3bb7-8cf9-eb261858b4e2",
                                                "text": "Elle séchait sur son devoir de grammaire. Elle disait qu'elle ne se souvenait plus de la règle des participes. Passés. Les présents ne s'accordent pas."
                                            },
                                            {
                                                "example_id": "77b95af4-32ab-498f-abf6-5362c473e2a2",
                                                "sense_id": "97d322da-63d7-3bb7-8cf9-eb261858b4e2",
                                                "text": "Les règles du sprint en athlétisme stipulent depuis 2002 que, si un athlète quitte les starting blocks en moins de 100 ms (0,1 s) après le coup de feu, il sera sanctionné d'un faux départ."
                                            },
                                            {
                                                "example_id": "00218303-bde7-4cd5-a5fa-4ccf4fd6244f",
                                                "sense_id": "97d322da-63d7-3bb7-8cf9-eb261858b4e2",
                                                "text": "Un conservatisme que ses détracteurs mettent en partie sur le compte de la surreprésentation de la Grande-Bretagne, inventrice du football et considérée pour cette raison comme opposée à de trop grands changements de règles."
                                            },
                                            {
                                                "example_id": "96c22c54-a25e-454b-b3ce-8e2a36226229",
                                                "sense_id": "97d322da-63d7-3bb7-8cf9-eb261858b4e2",
                                                "text": "Alors blanc bec t’aimes le basket\nBen on va ouèj à ma façon ;\nJ’vais juste un peu changer les règles :\nOn est les joueurs, toi t’es l’ballon."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e3646719-cc21-304b-a224-0b86caa31d00",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Opération qui se fait sur des nombres donnés, pour trouver des sommes ou des nombres inconnus."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ec89544c-1570-428c-a8f1-ef8516fbf18a",
                                                "sense_id": "e3646719-cc21-304b-a224-0b86caa31d00",
                                                "text": "La règle de trois ou de proportion."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4c3871b3-04e3-3f9f-8fc9-2f3eef53afc9",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "Statuts que les religieux d’un ordre sont obligés d’observer."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0010d4b-5526-4d78-b343-8c814b331472",
                                                "sense_id": "4c3871b3-04e3-3f9f-8fc9-2f3eef53afc9",
                                                "text": "Les règles et les statuts de l’ordre du Saint-Esprit."
                                            },
                                            {
                                                "example_id": "7f548829-f3c1-402e-8c09-41134c81ecbf",
                                                "sense_id": "4c3871b3-04e3-3f9f-8fc9-2f3eef53afc9",
                                                "text": "Il avait pour unique confident le portier de l’abbaye de La Melleraye, un petit moine au sourire très doux et à la langue si bien pendue que pour rien au monde – sinon un ordre de son supérieur – il n’aurait échangé sa place contre les règles de silence de ses frères."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7b5a74ee-bb91-3352-ab64-c178b0061696",
                                        "entry_id": "8c9ffc00-cf68-3b84-8f68-8e045c015e2f",
                                        "glosses": [
                                            "(au pluriel uniquement) Règles : menstruations."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "règle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52d02652-6655-3c49-9447-652dc6fbd31a",
