                        "entry_id": "3df705b8-d27d-38ae-b29f-dd9e9eccdebd",
                        "glosses": [
                            "Groupe de magasins de vêtements basé à San Francisco aux États-Unis."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8cfaea1e-ef83-42f6-a4ba-5df690646823",
                                "sense_id": "73207c2b-cccd-3ac9-8e85-59f463de5c29",
                                "text": "Chez Gap, je voudrais ce pantalon de flanelle à la Lauren Bacall, taille extra-small."
                            },
                            {
                                "example_id": "1327e402-76d7-455b-a6a4-c52d9d37aaa5",
                                "sense_id": "73207c2b-cccd-3ac9-8e85-59f463de5c29",
                                "text": "Il y a du Yeezy, du Balenciaga, des choses qu’on a faites avec Gap ou Adidas, a assuré le rappeur et homme d’affaires américain dans une vidéo publiée par X17 Online."
                            }
                        ]
                    }
                ],
