                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Gravität",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                                        "entry_id": "f5d8052a-e32e-3e03-a681-21d6e361a5f0",
                                        "glosses": [
                                            "feierliche Würde; Gemessenheit im Gehaben"
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "feced83f-0743-4583-b9fa-bf7be9c7ca1e",
                                                "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                                                "text": "„Der Lebensernst, die pathetische Gravität des Lebens, ist gewiß ein hoher sittlicher Wert.“"
                                            },
                                            {
                                                "example_id": "260812a6-8eec-4794-9b6e-2c7066690d76",
                                                "sense_id": "dd41cd5a-75ef-3cab-9570-df12e3ead9a9",
                                                "text": "„Der Hintergrund war, dass Uz sich über die Gravität und Langweiligkeit Bodmers (vornehmlich im »Noah«) lustig gemacht hatte, über die missglückten Versuche, durch stilitische Schaumschlägereien Milton nachzuahmen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
