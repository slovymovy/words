                        "entry_id": "b1adc833-9475-3801-a438-0631bc1da22d",
                        "glosses": [
                            "Action de défragmenter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb2b8d4d-1f21-4533-9a6e-ca9f5574dc42",
                                "sense_id": "1798b0d4-d68b-3438-8782-2ad7141feee6",
                                "text": "La défragmentation du disque dur a duré plus de deux heures."
                            },
                            {
                                "example_id": "3596dddc-3dbf-494f-b2fb-a9a6c8ff8f88",
                                "sense_id": "1798b0d4-d68b-3438-8782-2ad7141feee6",
                                "text": "Attention, lorsque la défragmentation est en cours, vous ne devez plus rien faire sur votre ordinateur jusqu’à la fin de celle-ci."
                            }
                        ]
                    },
                    {
                        "sense_id": "78e8d6fd-aaee-32eb-b303-8554aba5ba8a",
                        "entry_id": "b1adc833-9475-3801-a438-0631bc1da22d",
                        "glosses": [
                            "Résultat de l’action de défragmenter."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bd5878e6-894d-45f7-b062-9ea199698f9d",
                        "source_entry_id": "b1adc833-9475-3801-a438-0631bc1da22d",
