                "senses": [
                    {
                        "sense_id": "590309d4-46a6-33dc-b9f0-99e8e2aaad64",
                        "entry_id": "45fdee84-564f-34a9-80b6-fa07085c3db1",
                        "glosses": [
                            "Qualifie certaines choses qui vont en grossissant dans quelque partie de leur longueur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "758e2a38-f014-42ab-bfde-03ba63f2b087",
                                "sense_id": "590309d4-46a6-33dc-b9f0-99e8e2aaad64",
                                "text": "— Vers la racine, le poil se rétrécit régulièrement et les extrémités libres sont légèrement renflées ou obtuses."
                            },
                            {
                                "example_id": "c2b28bae-e059-4e84-a827-38f1b4a2d955",
                                "sense_id": "590309d4-46a6-33dc-b9f0-99e8e2aaad64",
                                "text": "— Colonne renflée."
                            },
                            {
                                "example_id": "d1972412-1131-4044-abe5-510738f641f4",
                                "sense_id": "590309d4-46a6-33dc-b9f0-99e8e2aaad64",
                                "text": "— Tige renflée à sa base."
                            },
                            {
                                "example_id": "f591434d-c92a-49db-9863-2abf0d7b9b5e",
                                "sense_id": "590309d4-46a6-33dc-b9f0-99e8e2aaad64",
                                "text": "J’entends le marteau du forgeron sur l’enclume, je vois des oiseaux dans des cages d’osier, des marmites de cuivre pendues dans les cuisines, près des oignons aux beaux reflets et des jarres vertes et rouges posées sur le sol à côté des cruches renflées."
                            }
                        ]
                    }
