            "senses": [
                {
                    "sense_id": "94ba68ef-9627-3a68-a4f1-512343b235a6",
                    "sense_definition": "Used to express relief that something fortunate occurred or that a bad situation was avoided; thankfully.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "relief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The boring speech was <w>mercifully</w> short, allowing everyone to go home early."
                        },
                        {
                            "text": "The rain stopped, and <w>mercifully</w>, the water did not reach the entrance of our house."
                        }
                    ],
                    "synonyms": [
                        "thankfully",
                        "gratefully"
                    ],
                    "common_phrases": [
                        "mercifully brief",
                        "mercifully short"
                    ]
                },
                {
                    "sense_id": "1f65340e-aa19-3cb7-bed5-05aecd924fd3",
                    "sense_definition": "In a manner showing kindness, compassion, or mercy towards someone who could be punished or harmed.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "compassion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The judge acted <w>mercifully</w> and chose not to impose a harsh prison sentence on the young offender."
                        },
                        {
                            "text": "She listened patiently and treated the defeated opponent <w>mercifully</w>."
                        }
                    ],
                    "synonyms": [
                        "compassionately",
                        "leniently",
                        "charitably"
                    ],
                    "antonyms": [
