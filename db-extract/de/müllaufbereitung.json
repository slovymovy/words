                "senses": [
                    {
                        "sense_id": "6fc9bdb5-3713-3251-b1d8-b1ca21ab53ea",
                        "entry_id": "b4428cb2-bba5-39a0-890f-f57f188cc163",
                        "glosses": [
                            "das Sortieren von Müllabfällen, um diese zur Wiederverwertung handelsfähig zu machen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "63adb831-7ad7-4432-a0df-7ceb15d67c60",
                                "sense_id": "6fc9bdb5-3713-3251-b1d8-b1ca21ab53ea",
                                "text": "„Die Müllaufbereitung braucht schließlich ebenso elektrische und maschinelle Anlagen und damit elektronische Komponenten, wie sie in anderen Bereichen der Umwelttechnik ebenfalls benötigt werden.“"
                            },
                            {
                                "example_id": "abf58577-9079-492f-acff-fafac7ec1725",
                                "sense_id": "6fc9bdb5-3713-3251-b1d8-b1ca21ab53ea",
                                "text": "„Ergebnis dieser intensiven Müllaufbereitung sind Abfallfraktionen verschiedener Feinheitsgrade (von max. 80 mm Länge bis zu kleinsten Materialteilchen), die an die nachgeschaltete Ballenpresse bzw. biologische Behandlungsstufe übergeben werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
