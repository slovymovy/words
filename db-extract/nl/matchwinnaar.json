                            {
                                "example_id": "b6ae125f-908d-459b-9c48-c5678b289b3a",
                                "sense_id": "28ff6a3a-3d63-31ed-a3c0-458115b401a0",
                                "text": "Torino-verdediger Gleison Bremer leek matchwinnaar te worden. De 24-jarige Braziliaan, die wekelijks aan verschillende Europese topclubs wordt gekoppeld, tikte in de eerste helft uit een corner van dichtbij binnen en speelde een uitstekende wedstrijd."
                            },
                            {
                                "example_id": "deea7236-e172-4b71-a0f8-d00d2b3407be",
                                "sense_id": "28ff6a3a-3d63-31ed-a3c0-458115b401a0",
                                "text": "Götze speelde voor zijn komst naar PSV voor de Duitse topclubs Borussia Dortmund en Bayern München en was in de WK-finale van 2014 de matchwinnaar door tegen Argentinië in de verlenging het enige doelpunt van het duel voor zijn rekening te nemen."
                            }
                        ]
