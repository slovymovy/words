                "senses": [
                    {
                        "sense_id": "11c6c03b-39c1-37fb-bdfe-ac306558116f",
                        "entry_id": "a55f2619-be94-32cb-b91a-cb3fdbb7cb2c",
                        "glosses": [
                            "A protein."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "451308fe-afc3-461a-954e-3788ef945b8f",
                                "sense_id": "11c6c03b-39c1-37fb-bdfe-ac306558116f",
                                "text": "When strong nitric acid is added to an aqueous solution of any of the proteids, a white precipitate forms, which turns yellow on heating the liquid."
                            },
                            {
                                "example_id": "715b43d1-510b-4cb1-a1e7-f6bbd7f68d1b",
                                "sense_id": "11c6c03b-39c1-37fb-bdfe-ac306558116f",
                                "text": "1914, Eugene Christian, Encyclopedia of Diet: A Treatise on the Food Question, Digital Edition, unnumbered page,\nThe proteid substances in the body must be formed from proteids taken in the form of food, because only proteid foods contain the element nitrogen. All proteids contain nitrogen, but all nitrogen does not contain protein. All proteids, therefore, are nitrogenous compounds."
                            },
                            {
                                "example_id": "c6d0cded-f595-42c6-9c5f-6ec330a130d6",
                                "sense_id": "11c6c03b-39c1-37fb-bdfe-ac306558116f",
                                "text": "1996, Arnold Eiloart (translator and editor), M. Bircher-Benner, Food Science for All and a New Sunlight Theory of Nutrition, page 12,\nIt was in the forties of the last century that the great chemist, Justus Liebig, brought the chemistry of food up to this point. As he believed moreover that proteids provide not only the building-material of living substance, but also muscular power, he regarded it as a nourishing principle."
                            }
                        ]
                    }
