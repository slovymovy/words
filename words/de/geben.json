                    "frequency": "High",
                    "semantic_group_id": "existenz",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In dieser kleinen Stadt <w>gibt</w> es leider keinen Bahnhof mehr."
                        },
                        {
                            "text": "<w>Gibt</w> es hier in der Nähe ein gutes italienisches Restaurant?"
                        }
                    ],
                    "synonyms": [
