                        "glosses": [
                            "Dose excessive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fbb3ba0-3806-4a34-95ec-ecf6a7de1061",
                                "sense_id": "7f95bd6b-e325-3963-b2ec-94c380515b0f",
                                "text": "En 2021, 350 Québécois sont morts sur les routes contre 450 d’une surdose."
                            }
                        ]
