{
    "word_family": [
        "ontheffen"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "0a44d4eb-5fc5-32a8-9d5b-7775acbbfe66",
                    "sense_definition": "een officiële toestemming om af te wijken van een bepaalde regel of wet",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "vrijstelling",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De gemeente verleende hem een <w>ontheffing</w> om met zijn auto in de voetgangerszone te rijden.",
                            "target_lang_translations": {
                                "en": "The municipality granted him an <w>exemption</w> to drive his car in the pedestrian zone."
                            }
                        },
                        {
                            "text": "Zonder een schriftelijke <w>ontheffing</w> mag je hier na middernacht geen lawaai maken.",
                            "target_lang_translations": {
                                "en": "Without a written <w>waiver</w>, you are not allowed to make noise here after midnight."
                            }
                        }
                    ],
                    "synonyms": [
                        "vrijstelling",
                        "dispensatie"
                    ],
                    "antonyms": [
                        "verplichting"
                    ],
                    "common_phrases": [
                        "ontheffing verlenen",
                        "schriftelijke ontheffing",
                        "ontheffing aanvragen"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "vaak gebruikt in juridische of bestuurlijke context"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "official permission to deviate from a specific rule or law"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "exemption",
                                "target_lang_sense_clarification": "being free from an obligation or rule"
                            },
                            {
                                "target_lang_word": "waiver",
                                "target_lang_sense_clarification": "official document or decision to ignore a rule"
                            },
                            {
                                "target_lang_word": "dispensation",
                                "target_lang_sense_clarification": "special permission to break a law or requirement"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ff44f966-08a0-36b3-bdb6-045173a7c863",
                    "sense_definition": "het ontslaan van iemand uit een bepaalde functie of taak",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ontslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>ontheffing</w> uit zijn functie kwam als een grote verrassing voor de directeur.",
                            "target_lang_translations": {
                                "en": "The <w>dismissal</w> from his position came as a big surprise to the director."
                            }
                        },
                        {
                            "text": "Na het schandaal volgde direct de <w>ontheffing</w> uit zijn ambt door de minister.",
                            "target_lang_translations": {
                                "en": "After the scandal, the minister immediately followed through with the <w>removal</w> from his office."
                            }
                        }
                    ],
                    "synonyms": [
                        "ontslag",
                        "afzetting"
                    ],
                    "antonyms": [
                        "benoeming",
                        "aanstelling"
                    ],
                    "common_phrases": [
                        "ontheffing uit functie",
                        "ontheffing uit ambt"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formeel taalgebruik"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "the removal of someone from a specific position, duty, or office"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "dismissal",
                                "target_lang_sense_clarification": "removal from a job or position"
                            },
                            {
                                "target_lang_word": "relieving",
                                "target_lang_sense_clarification": "removing someone from their duties"
                            },
                            {
                                "target_lang_word": "removal",
                                "target_lang_sense_clarification": "taking someone out of an official office"
                            }
                        ]
                    }
                }
            ]
        }
    ]
