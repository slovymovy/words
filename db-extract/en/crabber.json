                "senses": [
                    {
                        "sense_id": "0c11ad06-6f79-3923-a93c-01671b308505",
                        "entry_id": "b54ae39e-5e15-36da-9e5d-84c610a2e25a",
                        "glosses": [
                            "A person who catches crabs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2e712ce-df28-4ec7-b213-5bfd7ab93414",
                                "sense_id": "0c11ad06-6f79-3923-a93c-01671b308505",
                                "text": "Many shrimpers complain that the crabbers place their traps too close together and that they can't go between the traps without snagging their nets."
                            }
                        ]
                    },
                    {
                        "sense_id": "27834a6f-badd-3588-a200-d8e1bc8993ef",
                        "entry_id": "b54ae39e-5e15-36da-9e5d-84c610a2e25a",
                        "glosses": [
                            "A boat used for catching crabs."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cc0eee5b-5247-474c-84b2-97d6fc0e4b48",
                                "sense_id": "27834a6f-badd-3588-a200-d8e1bc8993ef",
                                "text": "In the bright haze of morning they came into Hort Harbor, where a hundred craft were moored or setting forth: fishermen's boats, crabbers, trawlers, trading-ships, two galleys of twenty oars […]"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11eaae08-b38f-4519-a09d-ea3635d39e03",
                        "source_entry_id": "b54ae39e-5e15-36da-9e5d-84c610a2e25a",
                        "source_sense_description": "a person who catches crabs",
                        "target_lang_word": "crabier",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "crabier",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3e895564-a654-38ef-989d-16e0232080dc",
                                        "entry_id": "eefe5ff6-8f3a-331e-a5be-a3ad0075922e",
                                        "glosses": [
                                            "Genre d'oiseaux échassiers (Ardeola spp.) de la famille des Ardéidés comprenant 6 espèces dont l'une, le crabier chevelu (ou Héron crabier (Ardeola ralloides)), niche très localement en France. Contrairement à ce que son nom suggère, l'alimentation des crabiers n'est pas spécialisée vers les crabes, et inclut poissons, divers crustacés, mollusques et insectes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "eed00ec6-1471-4d87-9119-6f0c9255401c",
                                                "sense_id": "3e895564-a654-38ef-989d-16e0232080dc",
                                                "text": "Je regardai longtemps sans rien apercevoir; enfin, en me baissant, je distinguai la tête et le long cou d'un petit crabier dont la silhouette noire se détachait sur le ciel encore rouge du couchant."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66f51134-799e-3ad7-ae41-7a0ae7402337",
                                        "entry_id": "eefe5ff6-8f3a-331e-a5be-a3ad0075922e",
                                        "glosses": [
                                            "Nom d'une espèce de raton-laveur d'Amérique du Sud (Procyon cancrivorus) appelée chien crabier ou raton crabier."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c8a88daa-8bc1-3ff2-b99d-11635a70c025",
                                        "entry_id": "eefe5ff6-8f3a-331e-a5be-a3ad0075922e",
                                        "glosses": [
                                            "L'un des noms vernaculaires (renard crabier) donnés au renard des savanes (Cerdocyon thous) d'Amérique du Sud."
                                        ],
                                        "tags": [],
