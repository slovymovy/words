                        ]
                    },
                    {
                        "translation_id": "bf963b1e-5805-479f-b168-9e49537e8b3f",
                        "source_entry_id": "303a3648-ba6c-3e21-b3dc-b1014410f48f",
                        "source_sense_id": "b2283d97-7303-3b6e-a7e1-1bf2859dff09",
                        "target_lang_word": "Mikołaj",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Mikołaj",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "a49b5d53-6925-3fbe-a13b-40324d56cf64",
                                        "entry_id": "07a2fc8b-b72f-3787-99ff-c67a49ca5dff",
                                        "glosses": [
                                            "imię męskie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be6fba1d-26de-4939-8628-a3c1c38ed392",
                                                "sense_id": "a49b5d53-6925-3fbe-a13b-40324d56cf64",
                                                "text": "Mam na imię Mikołaj i jestem kuratorem z podwarszawskiej miejscowości."
                                            },
                                            {
                                                "example_id": "b7eb5106-b362-4ad9-80db-c993827566ef",
                                                "sense_id": "a49b5d53-6925-3fbe-a13b-40324d56cf64",
                                                "text": "Mikołaj Kopernik był wybitnym astronomem, który „wstrzymał Słońce, ruszył Ziemię, (…)”."
                                            },
                                            {
                                                "example_id": "acdb65c7-732e-4b6f-96eb-aea6a6afebc8",
                                                "sense_id": "a49b5d53-6925-3fbe-a13b-40324d56cf64",
                                                "text": "W Kościele katolickim na 6 grudnia przypada wspomnienie św. Mikołaja z Myry, patrona dzieci, ubogich, kancelistów parafialnych, piekarzy, podróżnych, żeglarzy, panien pragnących wyjść za mąż, uczonych i studentów."
                                            },
                                            {
                                                "example_id": "54422db7-e63b-4d4e-b663-fe4eb39ce373",
                                                "sense_id": "a49b5d53-6925-3fbe-a13b-40324d56cf64",
                                                "text": "Mikołajowie dzień swego patrona, czyli imieniny, obchodzą 6 grudnia, a także 10 września."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "785f4a20-6bea-3faf-9ae9-41a49c9bc739",
                                        "entry_id": "07a2fc8b-b72f-3787-99ff-c67a49ca5dff",
                                        "glosses": [
                                            "Święty Mikołaj"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"1.2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9e8967d-5b1d-41a1-b687-9a846c827cbb",
                        "source_entry_id": "303a3648-ba6c-3e21-b3dc-b1014410f48f",
