                "senses": [
                    {
                        "sense_id": "f2784227-0639-335e-9953-7c9b633395fb",
                        "entry_id": "03430a0e-4d4f-35eb-8c1b-a18e357e7d7b",
                        "glosses": [
                            "met kracht en een scherp voorwerp iets verwijderen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a730b4fc-f024-4643-9852-64222357b38f",
                                "sense_id": "f2784227-0639-335e-9953-7c9b633395fb",
                                "text": "Ze wilde hun de ogen uitkrabben, schelden, schoppen, slaan, maar ze bleef zitten en liet hen gaan."
                            },
                            {
                                "example_id": "064d5461-0228-4556-95c6-eae68391d938",
                                "sense_id": "f2784227-0639-335e-9953-7c9b633395fb",
                                "text": "De tieners waren ondervoed. Hobby: \"Je had wel honger. En als er wat te eten was, mochten mijn broer, zus en ik om de beurt de pan uitkrabben voor het laatste restje. Je moest eten.\" De helpende hand kwam uit Friesland. Daar was wel voldoende eten, maar door de spoorwegstaking kon dat het westen van Nederland niet bereiken."
                            }
                        ]
                    }
                ],
