                        "sense_id": "5f63b9ea-2464-3bbc-844e-a230e5f6ccef",
                        "entry_id": "b5574018-906c-312c-b18d-add78d834128",
                        "glosses": [
                            "US-amerikanisch: öffentlicher oder privater Kasten zum Senden oder Empfangen von Post"
                        ],
                        "tags": [],
