                "senses": [
                    {
                        "sense_id": "3f1ccd70-f6ae-3c07-8215-a42e50423a1b",
                        "entry_id": "79e4de07-5966-3cef-8290-a349ac783ab1",
                        "glosses": [
                            "Dispersé."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed2b7808-0cd8-4b03-9719-c462784b05ce",
                                "sense_id": "3f1ccd70-f6ae-3c07-8215-a42e50423a1b",
                                "text": "La culture du bouillon est ensemencée sur un tube de gélose ; vingt-quatre heures après, on voit des traînées de coli, semées de colonies rondes de staphylocoques."
                            },
                            {
                                "example_id": "8bb8521f-b060-4737-b650-9f26bd5aef21",
                                "sense_id": "3f1ccd70-f6ae-3c07-8215-a42e50423a1b",
                                "text": "Un discours, un écrit semé de traits piquants, de pointes, etc. : Où il y a beaucoup de traits piquants, de pointes, etc."
                            },
                            {
                                "example_id": "6ea398ea-e700-48a7-bc58-46d1229e03e3",
                                "sense_id": "3f1ccd70-f6ae-3c07-8215-a42e50423a1b",
                                "text": "Nous partîmes en suivant les bords de la Thève, à travers les prés semés de marguerites et de boutons d’or…"
                            }
                        ]
                    },
                    {
                        "sense_id": "88ce801c-a6ad-3d1a-9f6d-18d0df2754fb",
                        "entry_id": "79e4de07-5966-3cef-8290-a349ac783ab1",
                        "glosses": [
                            "Se dit lorsque les pièces dont on parle sont en nombre indéterminé et répandues de telle sorte qu’elles se perdent dans les bords de l’écu."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "49b4ead7-8062-4286-a585-3647e75a4e51",
                                "sense_id": "88ce801c-a6ad-3d1a-9f6d-18d0df2754fb",
                                "text": "Un écu semé de fleurs de lis."
                            }
                        ]
                    }
