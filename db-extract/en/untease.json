                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3cdf70f4-7f5e-4460-9eb6-0427e66811c8",
                                "sense_id": "7e5416ff-49c0-36ef-a7b2-788a8779e575",
                                "text": "My purpose in this article is to untease that tangled web of philosophy and science which constitutes cognitive science."
                            },
                            {
                                "example_id": "4e5511b6-0c21-4c28-9e76-d976a3485e7f",
                                "sense_id": "7e5416ff-49c0-36ef-a7b2-788a8779e575",
                                "text": "This study made use of the stochasticity preserved by Monte Carlo methods to untease the different sources of synaptic variability."
                            },
                            {
                                "example_id": "ace6a27c-d127-497f-af3d-2f2e49ec836e",
                                "sense_id": "7e5416ff-49c0-36ef-a7b2-788a8779e575",
                                "text": "Her eyebrows reduced once more to smooth, perfect arcs above her deep-blue eyes, she took off the towel and started running her fingers through her wet hair to untease the knots before winding in the curlers."
                            }
                        ]
