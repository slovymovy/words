                        "glosses": [
                            "semitische Sprache, die in Äthiopien und Eritrea gesprochen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b9f90921-8e39-4acb-9fb1-9903a7dd3928",
                                "sense_id": "93b5b100-297b-3e48-9eec-22974f758c43",
                                "text": "„Tesfai, der oft entschuldigend auf seine Sprachschwierigkeiten hinweist, spricht zwar inzwischen gut Tigrinya, dennoch fehlen ihm immer wieder Wörter und Ausdrücke.“"
                            },
                            {
                                "example_id": "d04f6d26-9cbd-412f-9e0a-cd4ac4b18bc7",
                                "sense_id": "93b5b100-297b-3e48-9eec-22974f758c43",
                                "text": "„Tigrinya ist eng mit dem Ge’ez verwandt und erst seit dem Zweiten Weltkrieg Schriftsprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
