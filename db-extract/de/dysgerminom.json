                "senses": [
                    {
                        "sense_id": "b3a89d80-6608-30f0-9dd0-21844deced70",
                        "entry_id": "1837f2a1-4bb3-31c7-948d-4802ce80dccc",
                        "glosses": [
                            "niedrig maligner Keimzellentumor, der von den Urkeimzellen abstammt und meist in den Eierstöcken auftritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9fef608d-b82a-47ac-89a6-3edabc6894e4",
                                "sense_id": "b3a89d80-6608-30f0-9dd0-21844deced70",
                                "text": "„Die Tumormarker HCG und AFP steigen typischerweise beim reinen Dysgerminom nicht an. Eine Erhöhungvon HCG und/oder AFP weist auf Mischtumoren hin. Hingegen ist beim Dysgerminom typischerweise die LDH (Laktatdehydrogenase) erhöht.“"
                            },
                            {
                                "example_id": "fdd04a91-d247-4288-9e4c-904a8fa56fdf",
                                "sense_id": "b3a89d80-6608-30f0-9dd0-21844deced70",
                                "text": "„Das Dysgerminom ist der häufigste Keimzelltumor. 90 % der Patientinnen sind jünger als 30 Jahre.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
