                "senses": [
                    {
                        "sense_id": "4df68102-3e35-3dc6-b64c-3f1124108c4c",
                        "entry_id": "1af6764c-1259-3bef-bf6b-2adb0481c528",
                        "glosses": [
                            "variatie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cac8f820-868b-4e34-a9c6-0121073f3a8b",
                                "sense_id": "4df68102-3e35-3dc6-b64c-3f1124108c4c",
                                "text": "Je moet voor wat meer afwisseling in je leven zorgen."
                            },
                            {
                                "example_id": "3c223b56-538a-43a0-bfa4-8ca74a19f8a4",
                                "sense_id": "4df68102-3e35-3dc6-b64c-3f1124108c4c",
                                "text": "Tja, waarom niet? Na jaren 60 uur per week achter een computerscherm en een overvolle sociale agenda had ik behoefte aan meer afwisseling. Meer natuur en avontuur."
                            },
                            {
                                "example_id": "c39ec007-cfcc-435f-8c41-bd29385acbb4",
                                "sense_id": "4df68102-3e35-3dc6-b64c-3f1124108c4c",
                                "text": "Ik denk weleens dat ik gewoon te avontuurlijk ben voor een lange relatie. Ik heb die afwisseling en passie nodig, anders word ik gek. 'Het is alsof ik er helemaal niet ben.'"
                            }
                        ]
                    }
                ],
