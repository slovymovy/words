                "senses": [
                    {
                        "sense_id": "d1998386-c89a-3d5e-9606-aa831aef53d2",
                        "entry_id": "73fffb13-0136-3d34-8b82-6dd860c6e746",
                        "glosses": [
                            "(Kinder-)Spiel mit militärischem Inhalt, bei dem insbesondere Soldaten und ihr Handeln im Vordergrund stehen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6d8a9b97-2312-4995-a901-67ed0fe59235",
                                "sense_id": "d1998386-c89a-3d5e-9606-aa831aef53d2",
                                "text": "„Alle ihre Spiele sind Soldatenspiele mit dem einen Ziel, den großen Kriegshelden nachzueifern.“"
                            },
                            {
                                "example_id": "41371cc5-7b29-4dfd-8327-2e6a6fe944d0",
                                "sense_id": "d1998386-c89a-3d5e-9606-aa831aef53d2",
                                "text": "„Wenn aber diese Soldatenspiele begannen, zog ich mich meist recht bald nach Hause zurück, da ich kein Freund des Soldatenspiels war.“"
                            },
                            {
                                "example_id": "c98d68d7-8da6-4cd4-b85c-c0484cb5dd7c",
                                "sense_id": "d1998386-c89a-3d5e-9606-aa831aef53d2",
                                "text": "„In einer Zeit wie der Wilhelminischen Ära mit ihrer frisch-fröhlichen Kriegsmentalität wurden die Kinder ungeniert beim Soldatenspiel unterstützt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
