                            {
                                "example_id": "3e98de76-4fe8-4fe9-af2a-8df65211feb4",
                                "sense_id": "9c263e2f-4048-32a4-a915-3804a811edc1",
                                "text": "They had begun by running a knobbler in the Shabbington coverts, but in the afternoon the sport had been better, for they had found a stag of ten in the oak wood by Stanton"
                            },
                            {
                                "example_id": "e5f4195d-0ee1-44d4-99c2-29f271e002e0",
                                "sense_id": "9c263e2f-4048-32a4-a915-3804a811edc1",
                                "text": "This was explained when we got up to the beasts, for they were all dead, six of them: five hinds and calves and a small knobbler. They had been struck by lightning."
                            }
                        ]
                    }
