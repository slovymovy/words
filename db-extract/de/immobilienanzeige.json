                    {
                        "sense_id": "ce368591-2c0d-3908-a0ec-945c4e8fbcb9",
                        "entry_id": "e51c16f9-2a57-35bf-81a4-74ed8aa98626",
                        "glosses": [
                            "Anzeige, in der eine Immobilie angeboten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d33b3159-a3dd-455e-a9a6-379f91322d0b",
                                "sense_id": "ce368591-2c0d-3908-a0ec-945c4e8fbcb9",
                                "text": "„Eine gute Immobilienanzeige ist gar nicht so leicht zu schreiben.“"
                            },
                            {
                                "example_id": "fa790bfd-696b-4e95-a4b4-23e4dff33876",
                                "sense_id": "ce368591-2c0d-3908-a0ec-945c4e8fbcb9",
                                "text": "„Neben einer persönlichen Begutachtung helfen der offizielle Mietspiegel der Stadt, Informationen von Vermieterverbänden und vergleichbare Mietgesuche und Immobilienanzeigen in Zeitungen und im Internet.“"
                            },
                            {
                                "example_id": "13b81350-c54e-43ed-83a4-e11eeea0064b",
                                "sense_id": "ce368591-2c0d-3908-a0ec-945c4e8fbcb9",
                                "text": "„Hatte Elísabet die Immobilienanzeige gesehen und war von den Erinnerungen eingeholt worden?“"
                            }
                        ],
