                                "target_senses": [
                                    {
                                        "sense_id": "c9e850e6-03cc-3961-83a5-d9694e7f0884",
                                        "entry_id": "b8b33955-6052-37cd-ab9e-24ba9e161036",
                                        "glosses": [
                                            "seine feste Form/Konsistenz verlieren und in einen fließfähigen (flüssigen) Zustand übergehen"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0973a9b1-aecb-472e-8c31-2daca9ca1161",
                                                "sense_id": "c9e850e6-03cc-3961-83a5-d9694e7f0884",
                                                "text": "Die Schokolade verflüssigt sich in der Hitze des in der Sonne geparkten Wagens."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "710a2b65-4f65-30e8-ba05-f7f3185d81ef",
                                        "entry_id": "b8b33955-6052-37cd-ab9e-24ba9e161036",
                                        "glosses": [
                                            "ein Material so behandeln, dass es in einen fließfähigen Zustand übergeht"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "12caf862-c527-475d-93ac-db44d5ae4f00",
                                                "sense_id": "710a2b65-4f65-30e8-ba05-f7f3185d81ef",
                                                "text": "Wenn man Gas verflüssigt, kann man es in Tankzügen transportieren."
                                            },
                                            {
                                                "example_id": "a0b19176-6934-4ee3-9162-7ec92ff72115",
                                                "sense_id": "710a2b65-4f65-30e8-ba05-f7f3185d81ef",
                                                "text": "Waran ist ein Arzneistoff, um das Blut zu verflüssigen."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "c43d32c2-e48b-3260-b666-2e7e681de524",
                                        "entry_id": "b8b33955-6052-37cd-ab9e-24ba9e161036",
                                        "glosses": [
                                            "angelegtes Geld liquide (flüssig) machen"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4d13be6c-061e-455a-a672-3ae6f9cde567",
                                                "sense_id": "c43d32c2-e48b-3260-b666-2e7e681de524",
                                                "text": "Sie musste notgedrungen ein paar ihrer Aktien verflüssigen, um die Rechnung zahlen zu können."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
