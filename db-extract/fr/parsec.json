                        "entry_id": "dd2e4d23-f39a-392b-8a5e-5ece08d45eab",
                        "glosses": [
                            "Unité de mesure de distance, de symbole pc, équivalant exactement 60 × 60 × 180 / π unités astronomiques, soit environ 30,85 pétamètres (billions de kilomètres) ou 3,26 années-lumière."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "91c669a3-a27f-49df-9202-882890ffc5e0",
                                "sense_id": "5375015c-8d92-30d5-996b-ad4309e07a3f",
                                "text": "L’étoile la plus proche du Soleil, α Cen C ou Proxima Centauri, se trouve à 1,316 parsec (4,28 années-lumière)."
                            }
                        ]
                    }
                ],
