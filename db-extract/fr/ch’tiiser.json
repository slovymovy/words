                "senses": [
                    {
                        "sense_id": "608c468b-3d59-349e-b4a7-371ab968dfa2",
                        "entry_id": "58b0222c-bb9f-3676-a62f-ffc348b49bcc",
                        "glosses": [
                            "Donner un caractère ch’ti à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "effb901e-649c-4474-838f-76a3d6364ae9",
                                "sense_id": "608c468b-3d59-349e-b4a7-371ab968dfa2",
                                "text": "Pour ch'tiiser le tout, une petite gaufre sèche \"commelafaisaitmagrandmère\", fourrée au caramel."
                            },
                            {
                                "example_id": "e6fe8292-69a1-4a5b-b1d1-bed25881dbc0",
                                "sense_id": "608c468b-3d59-349e-b4a7-371ab968dfa2",
                                "text": "Mais attention, il ne s'agit pas de simplement ch'tiiser la télévision, ce serait réduire P'tit Quinquin à sa caricature."
                            },
                            {
                                "example_id": "58d92dba-7078-4afa-a7ea-25d558b226c3",
                                "sense_id": "608c468b-3d59-349e-b4a7-371ab968dfa2",
                                "text": "Alors que Sandrine est sur tous les fronts en ce début d'année, c'est bien volontiers qu'elle a accepté de Ch'tiiser les grilles de RTL."
                            }
                        ]
                    }
