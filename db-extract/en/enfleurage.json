                "word": "enfleurage",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "a6732bbb-2411-4b96-b63c-d88e70b14de0",
                        "entry_id": "ad0f3a4b-de75-354c-9add-61ca0b5cc92e",
                        "tags": [
                            "plural"
                        ],
                        "form": "enfleurages"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a861773f-675b-3f48-9095-fbd32ab4e33b",
                        "entry_id": "ad0f3a4b-de75-354c-9add-61ca0b5cc92e",
                        "glosses": [
                            "The process of extracting fragrance (essential oils) from flowers by using unscented wax or fat, then extracting with alcohol."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "bbfabe8c-84e7-46b3-954f-f8d16b248243",
                                "sense_id": "a861773f-675b-3f48-9095-fbd32ab4e33b",
                                "text": "The perfumes of plants like jasmine could only be extracted by enfleurage, as other methods of the time would denature the scents."
                            },
                            {
                                "example_id": "62680939-ccb9-48d3-bf3c-3b62f5afe398",
                                "sense_id": "a861773f-675b-3f48-9095-fbd32ab4e33b",
                                "text": "‘Thereʼs a man in Somerset who claims heʼs invented a method of enfleurage that requires no alcohol.’"
                            },
                            {
                                "example_id": "856d6084-0853-466a-a708-c102a15cdf6c",
                                "sense_id": "a861773f-675b-3f48-9095-fbd32ab4e33b",
                                "text": "I was set on developing a lilac enfleurage from my own shrub."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad68fc59-4173-4770-b870-3b2b67d3bbf7",
                        "source_entry_id": "ad0f3a4b-de75-354c-9add-61ca0b5cc92e",
                        "source_sense_id": "a861773f-675b-3f48-9095-fbd32ab4e33b",
                        "source_sense_description": "the process of extracting fragrance from flowers",
                        "target_lang_word": "enfleurage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "enfleurage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                                        "entry_id": "bb640ae6-a578-3c7f-86a7-0483eea33d43",
                                        "glosses": [
                                            "Action d’enfleurer."
                                        ],
                                        "tags": [
                                            "Cosmétologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d56842e4-ccd5-4e70-9378-9391a350657f",
                                                "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                                                "text": "Les extraits sont obtenus soit en mélangeant des huiles essentielles odorantes, soit en traitant par l'alcool les graisses qui se sont imprégnées d'essences pendant l'opération de l'enfleurage."
                                            },
                                            {
                                                "example_id": "7171dccc-301d-4e97-b077-24a771e8bed1",
                                                "sense_id": "650c7aa3-3fef-371b-b850-fd914605f4fc",
                                                "text": "L'essence naturelle de tubéreuse était jadis obtenue par enfleurage à froid : les fleurs étaient déposées sur des plaques enduites de graisse inodore, qui s'imprégnait de leur parfum. Un solvant tel que l'éthanol permettait d'obtenir par la suite une essence dite « absolue »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
