                                "tr": "Sizinle tanışmak benim için çok <w>hoş</w>.",
                                "es": "Es un placer <w>conocerle</w>."
                            }
                        },
                        {
                            "text": "Нам было <w>приятно</w> получить ваше письмо.",
                            "target_lang_translations": {
                                "en": "We were <w>pleased</w> to receive your letter.",
                                "zh": "收到您的来信我们感到很<w>愉快</w>。",
                                "nl": "Wij vonden het <w>fijn</w> om uw brief te ontvangen.",
                                "pl": "Było nam <w>miło</w> otrzymać państwa list.",
                                "de": "Es war uns <w>angenehm</w>, Ihren Brief zu erhalten.",
                                "fr": "Il nous a été <w>agréable</w> de recevoir votre lettre.",
                                "it": "Ci ha fatto <w>piacere</w> ricevere la vostra lettera.",
                                "cs": "Bylo nám <w>příjemné</w> obdržet váš dopis.",
                                "tr": "Mektubunuzu almak bizi çok <w>memnun</w> etti.",
                                "es": "Nos resultó <w>agradable</w> recibir su carta."
                            }
