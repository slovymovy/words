                        "examples": [
                            {
                                "example_id": "79d29a46-eeb7-42ff-9f7f-05f5c4f555ce",
                                "sense_id": "547755ca-d673-34f3-8688-109c8327fb2d",
                                "text": "Cette modalité anatomique, cette solution de continuité fonctionnelle périphérique, le cerveau peut la réaliser instantanément."
                            },
                            {
                                "example_id": "46917a71-081e-4124-a74b-30c3eb491b7f",
                                "sense_id": "547755ca-d673-34f3-8688-109c8327fb2d",
                                "text": "Notre imagination, si ardente qu'on la suppose, ne peut ni guérir instantanément une lésion organique, ni ressusciter un mort."
                            }
                        ]
                    }
                ],
