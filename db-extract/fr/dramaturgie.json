        "fr-extract.jsonl": [
            {
                "entry_id": "26e17809-d4c7-3133-9428-a7d04fc966fb",
                "word": "dramaturgie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "edeae8cf-4034-459a-97d5-36bf6df747f1",
                        "entry_id": "26e17809-d4c7-3133-9428-a7d04fc966fb",
                        "tags": [
                            "plural"
                        ],
                        "form": "dramaturgies"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "64a0443c-2170-3bcc-88ef-b872d1d9055d",
                        "entry_id": "26e17809-d4c7-3133-9428-a7d04fc966fb",
                        "glosses": [
                            "Art du dramaturge, science de la composition dramatique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a66165b1-a05d-41e0-8a3c-23cd0bbdfb77",
                                "sense_id": "64a0443c-2170-3bcc-88ef-b872d1d9055d",
                                "text": "Lessing a écrit une dramaturgie fameuse."
                            },
                            {
                                "example_id": "1a4eb93e-a033-4f90-bb8d-9983a688aba0",
                                "sense_id": "64a0443c-2170-3bcc-88ef-b872d1d9055d",
                                "text": "L’histoire relève plutôt de la justification, si on en sort victorieux, de la dramaturgie ou de l’excuse si on est vaincu."
                            },
                            {
                                "example_id": "107ca5a6-0e8f-4eee-8dd8-b5f23878857d",
                                "sense_id": "64a0443c-2170-3bcc-88ef-b872d1d9055d",
                                "text": "Sur grand écran, le train de nuit avait donné naissance à un sous-genre dont la dramaturgie prenait pour cadre l’atmosphère exiguë d’une couchette."
                            }
                        ]
                    },
                    {
                        "sense_id": "41a03b8e-b7d0-3a79-bde7-77b4cf0ffec8",
                        "entry_id": "26e17809-d4c7-3133-9428-a7d04fc966fb",
                        "glosses": [
                            "Travail du dramaturge en amont du travail de mise en scène."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac121f07-2fbb-4c20-b6d1-09c0a3c7b158",
                                "sense_id": "41a03b8e-b7d0-3a79-bde7-77b4cf0ffec8",
                                "text": "Dans une dramaturgie qui, il faut le signaler, n'était pas toujours rigoureuse dans ce genre de notations didascaliques, on observe un flottement tout de même assez révélateur, dans les noms de personnages inscrits en marge des répliques."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c87cf8dc-d3f2-452d-b45c-498d2cf62129",
                        "source_entry_id": "26e17809-d4c7-3133-9428-a7d04fc966fb",
                        "target_lang_word": "Dramaturgie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
