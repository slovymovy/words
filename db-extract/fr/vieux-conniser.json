                        "tags": [],
                        "examples": [
                            {
                                "example_id": "52eaab3b-28be-4684-86d0-d93a412defc3",
                                "sense_id": "249739e3-bb7a-3033-9ec8-49292e3bf5d5",
                                "text": "Je crois que je commence à vieux-conniser sévère…"
                            },
                            {
                                "example_id": "a18341ac-bd27-49a5-91e8-e5725660fc9d",
                                "sense_id": "249739e3-bb7a-3033-9ec8-49292e3bf5d5",
                                "text": "J'arrête là, je commence à « vieux-conniser »."
                            },
                            {
                                "example_id": "bb578493-4271-448f-a312-c4054b71a724",
                                "sense_id": "249739e3-bb7a-3033-9ec8-49292e3bf5d5",
                                "text": "Je vais vieux-conniser mais quand on voit ce qui était simulé à l'époque on croyait être au top, et quand on voit un DCS A-10 maintenant, tout évolue a une vitesse !"
                            },
                            {
                                "example_id": "807ac8a2-2f6d-4bbe-bfae-fe2e841619ec",
                                "sense_id": "249739e3-bb7a-3033-9ec8-49292e3bf5d5",
                                "text": "Et beh, les LeBron ont le même style que les Air Jordan que je portais en... 1993 :O (ouais je commence à me \"vieux-conniser\") ':)."
                            }
                        ]
                    }
