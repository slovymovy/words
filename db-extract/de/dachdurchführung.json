                "senses": [
                    {
                        "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                        "entry_id": "43223b5b-6f56-3aa4-83f0-ccb364fd3277",
                        "glosses": [
                            "bautechnisches Element, das den Durchgang der Luftführung durch das Dach sicherstellt"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "4db03a16-6307-4375-9e55-ae7171f3eb5e",
                                "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                                "text": "„Dachdurchführungen stellen den Durchgang der Luftführung durch das Dach sicher.“"
                            },
                            {
                                "example_id": "a719b58b-c6bd-4395-b37e-babd1fb9f90e",
                                "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                                "text": "„Hauff-Technik bietet hier entsprechend dem jeweiligen Dachaufbau und der kundenspezifischen Nutzung optimal abgestimmte Dachdurchführungen wie die Schwanenhalsdurchführungen SHD oder Futterrohre mit Fest-/Losflansch HRD-FUFF(A) an.“"
                            },
                            {
                                "example_id": "bb77042e-ad9c-4530-949d-98d5a4efd572",
                                "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                                "text": "„Für Anschlusshöhen größer 100 mm sind Dachdurchführung und Leitung mit selbstklebendem Universal-Dichtband (Alu-Fixband) zu umwickeln.“"
                            },
                            {
                                "example_id": "60c51afa-a9bd-4872-961f-fa3475391f93",
                                "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                                "text": "„Die Dachdurchführung besteht aus einem Standrohr, mit einer runden Grundplatte.“"
                            },
                            {
                                "example_id": "d0c0ecd5-f3cb-4221-9633-eab816b3216c",
                                "sense_id": "8b2131f4-27d9-3c5b-90a8-39871b3b10f1",
                                "text": "„Mit der Dachdurchführung wird der Edelstahlschornstein durch die Dachhaut geführt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
