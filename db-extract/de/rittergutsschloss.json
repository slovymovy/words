                "senses": [
                    {
                        "sense_id": "852e345a-d2d6-3330-8415-d8b357116c2a",
                        "entry_id": "17401633-b85d-33ad-b103-d366badebd93",
                        "glosses": [
                            "Schloss mit zugehörigem Rittergut, im Gegensatz etwa zum Jagdschloss oder Lustschloss"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed06574e-49eb-422c-a82a-e04b2b467375",
                                "sense_id": "852e345a-d2d6-3330-8415-d8b357116c2a",
                                "text": "Eine Dreikönigskapelle läßt sich 1470 im Rittergutsschloß in Ponitz erkennen."
                            },
                            {
                                "example_id": "dd62bcac-537f-41cf-b93d-37996b0cf44a",
                                "sense_id": "852e345a-d2d6-3330-8415-d8b357116c2a",
                                "text": "1712 wurde an dieser Stelle das Rittergutsschloß gebaut, in welchem ab 1951 das Landambulatorium untergebracht war."
                            },
                            {
                                "example_id": "87c334b3-d214-4bcf-9a97-3387b0ffff90",
                                "sense_id": "852e345a-d2d6-3330-8415-d8b357116c2a",
                                "text": "Natürlich kann in so einem Kompendium nicht jedes Ereignis aufgeführt werden, aber der feierliche Akt, zu dem am 18. Oktober der Gefallenen der Völkerschlacht am Rittergutsschloß gedacht wurde und dass danach auch die restaurierten Grabmale der Generäle Mantreuffel und Bogue auf dem Friedheuf feierlich übergeben wurden, fand keine Erwähnung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
