                                "target_senses": [
                                    {
                                        "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "nicht gleich, andere Eigenschaften habend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ae64a33-6330-4d1e-9048-3fa293d17620",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "Wir zwei sind sehr verschieden."
                                            },
                                            {
                                                "example_id": "e707d657-92e3-4c6e-bce9-647529ca6318",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "Die beiden Brüder sind charakterlich so verschieden, dass sie verschiedener kaum sein könnten."
                                            },
                                            {
                                                "example_id": "f043420e-395f-4a02-9e65-70f95d374fc6",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "„Man kann nicht sagen, daß eine Vergiftung stets diese und nur diese Erscheinungen aufweist, denn sie äußert sich auf die verschiedenste Weise, aber alle vorhanden gewesenen Erscheinungen lassen sich am ungezwungensten grade durch eine Vergiftung erklären.“"
                                            },
                                            {
                                                "example_id": "f0e2e2e1-8b73-4190-8f37-7e03f553ca8b",
                                                "sense_id": "4edb1bdb-e6e9-376e-b638-7c557a846f8e",
                                                "text": "„Vorrichtungen zum Abgeben von Warnzeichen mit aufeinanderfolgenden, verschieden hohen Tönen dürfen, außer in den in den Abs. 5 und 6 angeführten Fällen, nur mit Bewilligung des Landeshauptmannes angebracht werden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "68bcb9a5-17d9-3a30-a1f6-65638fc5a14f",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "nicht der-/die-/dasselbe, nicht identisch"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "770523d1-2cd7-4be3-982a-3618b6e13064",
                                                "sense_id": "68bcb9a5-17d9-3a30-a1f6-65638fc5a14f",
                                                "text": "„Tyson, der sich rühmte, in einer einzigen Nacht mit 24 verschiedenen Frauen geschlafen zu haben …“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "82606750-cdb1-3f31-adfe-42709a8f422a",
                                        "entry_id": "9ba035eb-55e2-3c1e-a062-9eddd4e99143",
                                        "glosses": [
                                            "mehrere (gleichgültig, ob gleich oder unterscheidbar)"
                                        ],
                                        "tags": [
                                            "im Plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4612062b-b2a1-4bb6-a064-a9f61e47e5e6",
                                                "sense_id": "82606750-cdb1-3f31-adfe-42709a8f422a",
                                                "text": "Ich habe verschiedene Dinge eingepackt."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            },
                            {
                                "target_word": "verschieden",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8e2c471d-873e-37e2-b772-066d043befb4",
                                        "entry_id": "2752b59a-5236-3f21-ae88-b15e1407a733",
                                        "glosses": [
                                            "nicht mehr am Leben"
                                        ],
                                        "tags": [
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "436ee860-a7c7-4a4d-bfbd-e1cc2343cfc5",
                                                "sense_id": "8e2c471d-873e-37e2-b772-066d043befb4",
                                                "text": "Seine verschiedene Großmutter war eine großartige Frau."
                                            },
                                            {
                                                "example_id": "21abdbc8-cb01-46eb-bd52-4e5930756400",
                                                "sense_id": "8e2c471d-873e-37e2-b772-066d043befb4",
                                                "text": "„Christus ist hier nämlich nicht bereits verschieden und mit ausgesenktem Körper, sondern lebend und in aufrechter Stellung dargestellt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
