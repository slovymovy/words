                                        "glosses": [
                                            "Saurier, der einen einzigen Finger seiner Vorderextremitäten deutlich verlängerte und mit diesem ein Flugsegel aufspannte"
                                        ],
                                        "tags": [
                                            "Paläontologie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fdf68d9e-20e3-4803-a3cc-95e68847ec45",
                                                "sense_id": "f3954695-6beb-3fc8-9570-e18eb8ccdaa9",
                                                "text": "Vermutlich waren die Flugsaurier Fleischfresser."
                                            },
                                            {
                                                "example_id": "6e1b745a-6d11-4412-9287-27fd512d4ea5",
                                                "sense_id": "f3954695-6beb-3fc8-9570-e18eb8ccdaa9",
                                                "text": "„Flugsaurier besiedelten nicht nur die Nordhalbkugel.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
