                "senses": [
                    {
                        "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                        "entry_id": "0830400b-6097-3dd2-b51e-a522ff334031",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "843a87e1-a907-43d2-b79b-900c5f4f24d2",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Frau Schnurr ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2fc507e7-bb93-4f20-9473-fdcae665fc78",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Herr Schnurr wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c067133e-90b8-44c5-b32a-2fa7294e4ac5",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Die Schnurrs fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "858f2227-e6a8-4fd4-b8e1-1febc94df3a8",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Der Schnurr trägt nie die Schals, die die Schnurr ihm strickt."
                            },
                            {
                                "example_id": "267fe11a-9f72-4d38-9d56-c22fbc2339e2",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Schnurr kommt, geht der Herr Schnurr.“"
                            },
                            {
                                "example_id": "f2bd479f-cd31-4e2f-98e6-cd89b5e2e778",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Schnurr kommt und geht."
                            },
                            {
                                "example_id": "9dfa4cec-8bff-4ce4-abe5-efd0a9c67bca",
                                "sense_id": "a3d173e9-f953-3945-9059-e64133fcfb90",
                                "text": "Schnurrs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
