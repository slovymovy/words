                            "target_lang_translations": {
                                "en": "My friend's name is <w>Pora</w>."
                            }
                        },
                        {
                            "text": "Я познакомился с человеком по имени <w>Пора</w> на конференции.",
                            "target_lang_translations": {
                                "en": "I met a person named <w>Pora</w> at a conference."
                            }
