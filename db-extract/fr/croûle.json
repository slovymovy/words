                                    {
                                        "sense_id": "4314d4c9-b19c-3847-b42f-98eecca9a28e",
                                        "entry_id": "ad9f489b-c118-31aa-8cd9-8caa0b71d353",
                                        "glosses": [
                                            "simple past of ride"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "past"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8d1737fc-c78f-3243-9550-b748a27c8277",
                                        "entry_id": "ad9f489b-c118-31aa-8cd9-8caa0b71d353",
                                        "glosses": [
                                            "past participle of ride"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "form-of",
                                            "nonstandard",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa60996d-d2d3-4d20-9fbe-d6e52129e08d",
                                                "sense_id": "8d1737fc-c78f-3243-9550-b748a27c8277",
                                                "text": "No doubt many a journey you have rode and gone, and many a hard daies labour you have taken, and ſharpened perhaps with care and grief[…]"
                                            },
                                            {
                                                "example_id": "c173baaa-4902-48a5-a2aa-48f9db1563c3",
                                                "sense_id": "8d1737fc-c78f-3243-9550-b748a27c8277",
                                                "text": "We dined at Martin's, and then came on to father Low's: we have rode but eight miles this day."
                                            },
                                            {
                                                "example_id": "d91778cc-74ff-4c87-a3cc-bb2bdedc62da",
                                                "sense_id": "8d1737fc-c78f-3243-9550-b748a27c8277",
                                                "text": "I have rode with the Kings, man, and I have rode with the best! I know what the truth is, and the truth is that I count and you don't."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7ec36c0d-ef4a-3019-898f-1d363561ccf1",
                                        "entry_id": "8f925a2e-13d2-3ad9-b31d-c006cb7c8e7c",
                                        "glosses": [
                                            "Of a male woodcock, to fly back and forth over the edge of a woodland while calling; to perform its, typically crepuscular, mating flight."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ff817e4-9322-4762-b5da-883259fb2a76",
                                                "sense_id": "7ec36c0d-ef4a-3019-898f-1d363561ccf1",
                                                "text": "\"When the sun rises we shall have some splendid play. Only hear the woodcock, how he is roading; he expects fine weather.\""
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rode",
