                "senses": [
                    {
                        "sense_id": "b954fbd0-3902-3ed7-b20b-ccbb7778af55",
                        "entry_id": "d8d8d54b-7424-3726-8b26-a9a33a86544f",
                        "glosses": [
                            "Wasserfahrzeug zur Brandbekämpfung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "da070606-23f0-42ab-981e-4e1733c83fe2",
                                "sense_id": "b954fbd0-3902-3ed7-b20b-ccbb7778af55",
                                "text": "„Von der Feuerwehr Essen wurde ein Löschboot gestellt, das von der Kanalseite aus einen Wasserwerfer einsetzte und Löschwasser aus dem Rhein-Herne-Kanal saugte.“"
                            },
                            {
                                "example_id": "2885bc3e-27cf-43ff-bc9c-934ee545add5",
                                "sense_id": "b954fbd0-3902-3ed7-b20b-ccbb7778af55",
                                "text": "„In Fahrzeuge und Löschboote eingebaut, werden Wasserwerfer zur Bekämpfung von Großbränden eingesetzt, in gepanzerten Spezialfahrzeugen auch als Polizeiwaffe zur Zerstreuung von Menschenansammlungen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
