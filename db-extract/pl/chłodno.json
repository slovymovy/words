                        ],
                        "examples": [
                            {
                                "example_id": "6b90410e-0b94-42ef-9248-d6acc4ffdddb",
                                "sense_id": "01dcf61c-c82b-3ede-9af9-f2ac3f57a87e",
                                "text": "Po długiej i męczącej podróży zostaliśmy przyjęci raczej chłodno."
                            }
