                "senses": [
                    {
                        "sense_id": "f6857659-d8ea-3ef5-9cd2-fbe5d5d51b5f",
                        "entry_id": "380e8afa-7562-388a-a625-fd50dc2fe415",
                        "glosses": [
                            "Person, die stehend uriniert"
                        ],
                        "tags": [
                            "derogatory",
                            "impolite"
                        ],
                        "examples": [
                            {
                                "example_id": "2e7628e9-4311-4fb1-9057-52574798e398",
                                "sense_id": "f6857659-d8ea-3ef5-9cd2-fbe5d5d51b5f",
                                "text": "„Alfredo war ein Stehpisser, wechselte alle drei Tage seine Unterhose, als ich ihm sagte, dass ich die Scheidung eingereicht habe, schlug er mich ins Gesicht.“"
                            },
                            {
                                "example_id": "38ee4926-2d06-41aa-a851-ae5cbf459144",
                                "sense_id": "f6857659-d8ea-3ef5-9cd2-fbe5d5d51b5f",
                                "text": "„Bernie nutzte keine einzige Sprechpause, um sich selbst darzustellen. Er war kein Stehpisser. Flaschen und Gläser schraubte er zu. Er schnarchte nicht. Er konnte über Gefühle sprechen.“"
                            },
                            {
                                "example_id": "3a0b2eae-8fd6-4c3c-862f-c7d1ed9535b2",
                                "sense_id": "f6857659-d8ea-3ef5-9cd2-fbe5d5d51b5f",
                                "text": "„Freiwild sind der Soundtrack für die Lügenpresse-Schreier, die unverkrampften Patrioten und völkischen Wurzeldenker, die heimatliebenden Stehpisser, die Authentizitätshuber und Geschichtsrelativierer.“"
                            },
                            {
                                "example_id": "950b86e5-e871-40ab-a79e-f02cc175698b",
                                "sense_id": "f6857659-d8ea-3ef5-9cd2-fbe5d5d51b5f",
                                "text": "„Hier könnte ich sogar ins Detail gehen und ihn als Stehpisser diskreditieren, denn ich traf Tykwer auf der Toilette, als ich vor Jahren als Küchenhilfe in einem vegetarischen Kreuzberger Restaurant jobbte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
