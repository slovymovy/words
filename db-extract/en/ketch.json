                        "entry_id": "41b8c75b-6891-3f14-8f87-286b8881f781",
                        "glosses": [
                            "Synonym of Jack Ketch (“a public executioner”)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42549fb0-f433-4b27-bf36-881e19df4a00",
                                "sense_id": "9e548095-b5a7-361a-bcd1-dce1aaa1acac",
                                "text": "Hanging was indeed the popular remedy for all criminal disorders. The legislator found patients for it, the judge prescribed it, and the Ketch administered it with the same callous and gallows indifference."
                            }
                        ]
                    }
