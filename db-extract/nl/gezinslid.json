                            {
                                "example_id": "63f9f0a5-bb8d-4f33-ab64-7d3657d0dadb",
                                "sense_id": "b51e5f29-9bae-3d69-b113-64bf92724b41",
                                "text": "Het gezin had vier gezinsleden: vader, moeder en twee kinderen."
                            },
                            {
                                "example_id": "df18e900-3faa-4d3b-b661-61926dd6aa1c",
                                "sense_id": "b51e5f29-9bae-3d69-b113-64bf92724b41",
                                "text": "Bekenden van het gezin en omwonenden gingen er het hele weekeinde al van uit dat de slachtoffers van de brand de bewoners zouden zijn. In een kapel van de Protestantse Gemeente Duiven ligt sinds zondag een gedenkboek. Op de Facebookpagina's van de gezinsleden zijn veel berichten geplaatst."
                            }
