                        ]
                    },
                    {
                        "translation_id": "55f51bc6-5e45-476b-8de4-93a51b38973f",
                        "source_entry_id": "2f5b6189-fe55-3d06-9919-49beaa879868",
                        "source_sense_id": "621652e9-5509-3f97-b1b7-c842a3b98589",
                        "target_lang_word": "Lanze",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Lanze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "698093e9-4794-3308-b4a7-7b00d871df39",
                                        "entry_id": "6b22d5ac-c1ec-3288-aa4c-9008e9156fd0",
                                        "glosses": [
                                            "Waffe für den Nahkampf (als Stoßwaffe), aber auch im Fernkampf (als Wurfwaffe) wie ein Speer einsetzbar; lange Stange (mehrere Meter) mit einer Spitze aus besonders hartem Material"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d430375-c04d-4fff-8b55-1b39ba3f0244",
                                                "sense_id": "698093e9-4794-3308-b4a7-7b00d871df39",
                                                "text": "„Aber Mohammed ergriff die Lanze eines Begleiters und stieß sie durch den Hals des Götzendieners, welcher todt vom Pferde fiel.“"
                                            },
                                            {
                                                "example_id": "9c977572-c88c-403b-86c1-aedf7f4be8c3",
                                                "sense_id": "698093e9-4794-3308-b4a7-7b00d871df39",
                                                "text": "„Agamemnon, seinem Vorsatze treu, rollte unter den Ersten daher und schleuderte furchtbar treffende Lanzen auf die Trojanerfürsten.“"
                                            },
                                            {
                                                "example_id": "9a228b74-c717-456e-9da2-1c55ae042044",
                                                "sense_id": "698093e9-4794-3308-b4a7-7b00d871df39",
                                                "text": "„Speere, Lanzen und Schilde stammten aus dem gesamten skandinavischen Raum.“"
                                            },
                                            {
                                                "example_id": "1e1dc8df-8353-42f8-ad2d-4848d9e26a4e",
                                                "sense_id": "698093e9-4794-3308-b4a7-7b00d871df39",
                                                "text": "„Von den bis zu 2,50 m langen Lanzen und mannshohen Speeren der Kelten haben sich vor allem die eisernen Spitzen und Lanzenschuhe erhalten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a0c60d89-4412-3fa2-80cf-fb8b6a919993",
                                        "entry_id": "6b22d5ac-c1ec-3288-aa4c-9008e9156fd0",
                                        "glosses": [
                                            "länglicher Hohlkörper, den man in etwas stecken kann und durch den etwas strömen kann"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
