                ],
                "senses": [
                    {
                        "sense_id": "a82300e7-c563-3948-a01c-799261f8a7b5",
                        "entry_id": "d5a5573c-1e7a-36a6-993f-ff0e0290374a",
                        "glosses": [
                            "Qualifie un objet (reliure, papier officiel, vitrail, monument funéraire…) ou une représentation (peinture, sculpture, emblème…), qui intègre des armoiries, à titre de référence, de symbolisme ou de propriété (commanditaires, fondateurs, financeur, etc.)."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8551eeaf-42da-4f1b-a4e8-695f5555faa8",
                                "sense_id": "a82300e7-c563-3948-a01c-799261f8a7b5",
                                "text": "Ils entrèrent dans une pièce chaude où deux mètres de feu crépitaient sous une hotte armoriée de signes étranges."
                            },
                            {
                                "example_id": "95bfcb27-002c-4ea8-b198-ccd1a7d9a9e2",
                                "sense_id": "a82300e7-c563-3948-a01c-799261f8a7b5",
                                "text": "Il lut la petite phrase que j’avais écrite sur le papier armorié de la marquise."
                            }
                        ]
                    },
                    {
                        "sense_id": "d2976ae6-7b19-3ea0-bca9-b33f93b43cb7",
                        "entry_id": "d5a5573c-1e7a-36a6-993f-ff0e0290374a",
                        "glosses": [
                            "Se dit d’un drapeau, étendard, etc. qui intègre des armoiries dans sa représentation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0a9f2098-eadf-4da8-99a0-9975abf5b0db",
                                "sense_id": "d2976ae6-7b19-3ea0-bca9-b33f93b43cb7",
                                "text": "Le joli morceau ! dit l’homme à la perche en regardant Tiennette. Voilà une fille de corps de garde ! Elle attirerait des recrues à nos boutiques, sous le drapeau armorié, et ferait signer des engagements !"
                            }
                        ]
                    }
                ],
