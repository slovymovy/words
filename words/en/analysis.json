{
    "word_family": [
        "analyze",
        "analyst",
        "analytic",
        "analytical"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "064b3109-0d9a-33da-a991-21e3a9560f62",
                    "sense_definition": "The process of studying or examining something in detail in order to understand it better or draw conclusions from it.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_examination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to perform a detailed <w>analysis</w> of the data before publishing the results.",
                            "target_lang_translations": {
                                "ru": "Нам нужно провести детальный <w>анализ</w> данных перед публикацией результатов.",
                                "zh": "在公布结果之前，我们需要对数据进行详细的<w>分析</w>。"
                            }
                        },
                        {
                            "text": "Her critical <w>analysis</w> of the novel impressed the professor.",
                            "target_lang_translations": {
                                "ru": "Её критический <w>анализ</w> романа впечатлил профессора.",
                                "zh": "她对这部小说的批判性<w>分析</w>给教授留下了深刻印象。"
                            }
                        }
                    ],
                    "antonyms": [
                        "synthesis"
                    ],
                    "common_phrases": [
                        "detailed analysis",
                        "critical analysis",
                        "data analysis",
                        "in the final analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс детального изучения или рассмотрения чего-либо с целью лучшего понимания или формулирования выводов.",
                        "zh": "对某事物进行详细研究或考察，以求更好地理解或得出结论的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ана́лиз",
                                "target_lang_sense_clarification": "процесс изучения"
                            },
                            {
                                "target_lang_word": "иссле́дование",
                                "target_lang_sense_clarification": "научное или глубокое изучение"
                            },
                            {
                                "target_lang_word": "разбо́р",
                                "target_lang_sense_clarification": "детальное рассмотрение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分析",
                                "target_lang_sense_clarification": "对事物进行深入研究"
                            },
                            {
                                "target_lang_word": "研究",
                                "target_lang_sense_clarification": "深入的探究"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4860dd33-9cfe-3fec-b1bd-4b201019cb45",
                    "sense_definition": "A document, report, or statement that presents the findings of a detailed examination.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "general_examination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "You can read my full <w>analysis</w> of the situation in the attached report.",
                            "target_lang_translations": {
                                "ru": "Вы можете прочитать мой полный <w>анализ</w> ситуации в приложенном отчете.",
                                "zh": "你可以在附件报告中阅读我对该情况的完整<w>分析</w>。"
                            }
                        },
                        {
                            "text": "The newspaper published an <w>analysis</w> of the election results.",
                            "target_lang_translations": {
                                "ru": "Газета опубликовала <w>анализ</w> результатов выборов.",
                                "zh": "报纸刊登了一篇关于选举结果的<w>分析</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "written analysis",
                        "present an analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Документ, отчет или заявление, представляющее результаты детального изучения.",
                        "zh": "呈现详细考察结果的文件、报告或陈述。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ана́лиз",
                                "target_lang_sense_clarification": "документ с выводами"
                            },
                            {
                                "target_lang_word": "иссле́дование",
                                "target_lang_sense_clarification": "научный труд"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分析报告",
                                "target_lang_sense_clarification": "书面的分析结果"
                            },
                            {
                                "target_lang_word": "分析",
                                "target_lang_sense_clarification": "对情况的总结性陈述"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1b052b20-938b-3a69-86c8-b2165dbf7a04",
                    "sense_definition": "The process of separating a chemical substance into its constituent parts to identify them.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory performed a chemical <w>analysis</w> of the water sample.",
                            "target_lang_translations": {
                                "ru": "Лаборатория провела химический <w>анализ</w> пробы воды.",
                                "zh": "实验室对水样进行了化学<w>分析</w>。"
                            }
                        },
                        {
                            "text": "Further <w>analysis</w> revealed traces of gold in the rock.",
                            "target_lang_translations": {
                                "ru": "Дальнейший <w>анализ</w> выявил следы золота в породе.",
                                "zh": "进一步的<w>分析</w>显示岩石中含有微量黄金。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical analysis",
                        "sample for analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Процесс разделения химического вещества на составные части для их идентификации.",
                        "zh": "将化学物质分离成其组成部分以进行识别的过程。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ана́лиз",
                                "target_lang_sense_clarification": "химический состав"
                            },
                            {
                                "target_lang_word": "разложе́ние",
                                "target_lang_sense_clarification": "распад на компоненты"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分析",
                                "target_lang_sense_clarification": "化学成分的检测"
                            },
                            {
                                "target_lang_word": "化验",
                                "target_lang_sense_clarification": "实验室的化学检测"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b98b43ad-3cc6-3435-baa2-5cdf65d2a79c",
                    "sense_definition": "A branch of mathematics dealing with limits, functions, calculus, and series.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She is taking an advanced course in complex <w>analysis</w> this semester.",
                            "target_lang_translations": {
                                "ru": "В этом семестре она проходит продвинутый курс по комплексному <w>анализу</w>.",
                                "zh": "她这学期正在修一门复<w>分析</w>的高级课程。"
                            }
                        },
                        {
                            "text": "Mathematical <w>analysis</w> is fundamental to understanding modern physics.",
                            "target_lang_translations": {
                                "ru": "Математический <w>анализ</w> является фундаментальным для понимания современной физики.",
                                "zh": "数学<w>分析</w>是理解现代物理学的基础。"
                            }
                        }
                    ],
                    "synonyms": [
                        "mathematical analysis"
                    ],
                    "common_phrases": [
                        "numerical analysis",
                        "complex analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раздел математики, занимающийся пределами, функциями, исчислением и рядами.",
                        "zh": "数学的一个分支，研究极限、函数、微积分和级数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ана́лиз",
                                "target_lang_sense_clarification": "математический"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "数学分析",
                                "target_lang_sense_clarification": "数学学科分支"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d0be75cc-0e35-3835-aab0-3ba98d6effb8",
                    "sense_definition": "A method of psychological therapy where a patient talks to a doctor to treat mental or emotional problems; psychoanalysis.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has been in <w>analysis</w> for several years to deal with his anxiety.",
                            "target_lang_translations": {
                                "ru": "Он проходит <w>психоанализ</w> уже несколько лет, чтобы справиться со своей тревожностью.",
                                "zh": "为了应对焦虑，他已经接受了几年<w>精神分析</w>治疗。"
                            }
                        },
                        {
                            "text": "The doctor suggested that <w>analysis</w> might help her understand her childhood trauma.",
                            "target_lang_translations": {
                                "ru": "Врач предположил, что <w>психоанализ</w> может помочь ей понять детскую травму.",
                                "zh": "医生建议她可以通过<w>精神分析</w>来了解自己的童年创伤。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "in analysis"
                    ],
                    "target_lang_definitions": {
                        "ru": "Метод психологической терапии, при котором пациент беседует с врачом для лечения ментальных или эмоциональных проблем; психоанализ.",
                        "zh": "一种心理治疗方法，患者通过与医生交谈来治疗心理或情绪问题；即精神分析。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "психоана́лиз",
                                "target_lang_sense_clarification": "метод терапии"
                            },
                            {
                                "target_lang_word": "ана́лиз",
                                "target_lang_sense_clarification": "краткое название"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "精神分析",
                                "target_lang_sense_clarification": "心理治疗方法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}