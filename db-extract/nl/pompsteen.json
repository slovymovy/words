                        "examples": [
                            {
                                "example_id": "b3e069f2-d094-4d95-91a4-c57ab682e0fe",
                                "sense_id": "f15dac3d-90ae-3eb8-be11-c39bcbef61e8",
                                "text": "Hier werd de zogeheten frontbeweging geboren, bij soldaten die beseften dat ze in het België dat ze met hun leven verdedigden niet gelijk werden behandeld als hun Waalse landgenoten. 'Hier ons bloed, wanneer ons recht?' kalkten ze in rode letters op een pompsteen in het verwoeste frontdorp Merkem. De steen ligt nu in de crypte op de IJzerweide, naast een vijftiende eeuws kruisbeeld en tientallen 'heldenhuldezerkjes'."
                            },
                            {
                                "example_id": "c06c3ed7-7f30-418a-a8cb-29ac043f24cf",
                                "sense_id": "f15dac3d-90ae-3eb8-be11-c39bcbef61e8",
                                "text": "‘Hij nam water uit de pompsteen boven me. Ik zag zijn schaduw. Mijn rug duwde tegen de waterleiding, en ik voelde het water stromen. Het leek wel een film. Op zo’n moment stoppen je hersenen met werken, je hart stopt met kloppen en je stopt met ademen.’"
                            }
                        ]
                    }
