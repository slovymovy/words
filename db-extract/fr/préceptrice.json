                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "5eee5e21-3e31-32c0-922a-f1f8bd226331",
                                        "entry_id": "daae0e08-d777-3121-a627-4229377513d3",
                                        "glosses": [
                                            "A teacher or tutor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13970078-fa06-40a9-aa32-cfd882fcc5d5",
                                                "sense_id": "5eee5e21-3e31-32c0-922a-f1f8bd226331",
                                                "text": "A man who had thought so much on the subjects of language and education was surely no ordinary preceptor."
                                            },
                                            {
                                                "example_id": "e1dfe7c7-458c-4e06-8dca-c90bd78f7884",
                                                "sense_id": "5eee5e21-3e31-32c0-922a-f1f8bd226331",
                                                "text": "We shall resume our studies later on; but just now I am tired of playing the preceptor; and the eager thirst of my pupils for improvement does not console me for the slowness of their progress."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "767401cc-70a8-30b1-b39f-94595f9ccf0d",
                                        "entry_id": "daae0e08-d777-3121-a627-4229377513d3",
                                        "glosses": [
                                            "The head of a preceptory of Knights Templar."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f30765da-35a1-3bb6-9558-4b02e1292f63",
                                        "entry_id": "daae0e08-d777-3121-a627-4229377513d3",
                                        "glosses": [
                                            "A doctor who gives practical training to medical students, nurses etc."
                                        ],
                                        "tags": [
                                            "US"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9de66a56-cc87-4950-ac72-5a01f01878eb",
                        "source_entry_id": "41115fe8-ca36-3ce0-9058-d7f870abcaba",
                        "source_sense_id": "05fbf361-1cda-36db-97e5-d7270f3a7d04",
                        "source_sense_description": "Celle qui est chargé de l’instruction et de l’éducation d’un enfant, d’un adolescent.",
                        "target_lang_word": "preceptress",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "preceptress",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "09e54399-61da-3ec7-b16f-7df43e1b8710",
                                        "entry_id": "44d7cb6f-7f9c-3ec7-9bea-93f7c2b6b2ac",
                                        "glosses": [
                                            "A female preceptor, or provider of moral instruction; a teacher."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e571a43b-af8b-4b19-8a44-16da7ab21d6e",
                                                "sense_id": "09e54399-61da-3ec7-b16f-7df43e1b8710",
                                                "text": "‘I daily became more amiable, and might perhaps by this time have nearly attained perfection, had not my Preceptoress been torn from my arms, e'er I had attained by seventeenth year.’"
                                            },
                                            {
                                                "example_id": "36eaaf1f-9d86-4e6e-8554-387a5c63c1a5",
                                                "sense_id": "09e54399-61da-3ec7-b16f-7df43e1b8710",
                                                "text": "Her preceptress had never found it necessary to repeat an admonition of any kind, since her arrival at years to discriminate between the right and the wrong."
                                            },
                                            {
                                                "example_id": "0fd0b0f1-bfa1-4285-9e5d-197871651e6e",
                                                "sense_id": "09e54399-61da-3ec7-b16f-7df43e1b8710",
                                                "text": "She was my sister, my preceptress and friend; but she died--her end was violent, untimely, and criminal!"
                                            },
                                            {
                                                "example_id": "4d9471f5-f0c8-4cab-a98f-73131baf9a13",
                                                "sense_id": "09e54399-61da-3ec7-b16f-7df43e1b8710",
                                                "text": "She had married late in life, having been previously a preceptress in a young ladies' school."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
