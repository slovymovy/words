                        "target_lang_word": "bottom line",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bottom line",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a28a63da-60fb-383e-8c08-7a47bf96ee77",
                                        "entry_id": "09213581-7a24-3d46-923e-ad5ed5003934",
                                        "glosses": [
                                            "The final balance; the amount of money or profit left after everything has been tallied."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
