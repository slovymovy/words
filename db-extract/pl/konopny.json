                "senses": [
                    {
                        "sense_id": "0a3243e1-ae75-3407-b2e3-b04a6f6828d6",
                        "entry_id": "b69885cf-9c41-3a03-a743-5af90ca01dbc",
                        "glosses": [
                            "otrzymywany z konopi, wykonany z włókna konopi"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75bd8925-70f5-4abe-b89a-11f71a4013c0",
                                "sense_id": "0a3243e1-ae75-3407-b2e3-b04a6f6828d6",
                                "text": "Postronkiem konopnym brzemię okręcił i westchnąwszy na plecy zarzucił: wnet ruszył przez podwórko statecznym, niespiesznym krokiem"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fcc2e32-05ef-44ed-b119-c6da9a1be4ad",
                        "source_entry_id": "b69885cf-9c41-3a03-a743-5af90ca01dbc",
                        "source_sense_id": "0a3243e1-ae75-3407-b2e3-b04a6f6828d6",
                        "target_lang_word": "hempen",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hempen",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "17eff93e-4f71-3e62-8bd9-9b8cb3b595d2",
                                        "entry_id": "3c32e09c-1429-38fb-981c-75caff377bf4",
                                        "glosses": [
                                            "Made of hemp"
                                        ],
                                        "tags": [
                                            "dated",
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8075dc0-003a-411f-b9ac-d62e930f77b8",
                                                "sense_id": "17eff93e-4f71-3e62-8bd9-9b8cb3b595d2",
                                                "text": "In fowle reproch of knighthoodes fayre degree, / About his neck an hempen rope he weares, / That with his gliſtring armes does ill agree;"
                                            },
                                            {
                                                "example_id": "e2f06514-f583-48bc-a937-d8295745a528",
                                                "sense_id": "17eff93e-4f71-3e62-8bd9-9b8cb3b595d2",
                                                "text": "A quiet land is this—a land where the slow-moving Basque, with his flat biretta-cap, his red sash and his hempen sandals, tills his scanty farm […]"
                                            },
                                            {
                                                "example_id": "b77ff6bd-eb75-43dc-a95b-5b9dd8f1fd2e",
                                                "sense_id": "17eff93e-4f71-3e62-8bd9-9b8cb3b595d2",
                                                "text": "Trains from Lime Street to Edge Hill were hauled by an endless hempen rope worked by a stationary engine on the platform at the latter station."
                                            },
                                            {
                                                "example_id": "10487fa0-98e8-4f1e-9e59-0361c855eb8f",
                                                "sense_id": "17eff93e-4f71-3e62-8bd9-9b8cb3b595d2",
                                                "text": "Apparently, Bridport is noted for \"its hempen manufactures. Its staple productions are twine, fishing nets, and canvas, and much hemp for the purpose is grown.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "34167b17-0d4f-3609-91a1-1f6aaad86bf0",
                                        "entry_id": "3c32e09c-1429-38fb-981c-75caff377bf4",
                                        "glosses": [
                                            "Related to hempen ropes, i.e., to hanging as capital punishment."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ab313178-a520-4998-a2b9-e859d223b70b",
                                                "sense_id": "34167b17-0d4f-3609-91a1-1f6aaad86bf0",
                                                "text": "[…] but rid himself also of the companionship of this ruffianly Sir Crispin, to whom no doubt a hempen justice would be meted."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2107ead-1cb9-46bd-9243-8925332cb6f2",
                        "source_entry_id": "b69885cf-9c41-3a03-a743-5af90ca01dbc",
                        "source_sense_id": "0a3243e1-ae75-3407-b2e3-b04a6f6828d6",
                        "target_lang_word": "konopný",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "konopný",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "25adc51b-8077-3bca-8fb8-2a2a6f37a08a",
                                        "entry_id": "0ac2f6f9-3f3c-30ad-b0b3-cfc00ce88b9a",
                                        "glosses": [
                                            "úzce související s konopím, např. z něj vyrobený či je obsahující"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b252efc-e6d6-4a24-847a-3d916016d6d1",
                                                "sense_id": "25adc51b-8077-3bca-8fb8-2a2a6f37a08a",
                                                "text": "V kostele měli řadu povinností: uklízeli, asistovali knězi při bohoslužbách a pohřbech, vybírali milodary a třikrát denně zvonili při modlitbách. A protože pověrčivý lid věřil, že zvuk kostelních zvonů rozhání bouřková mračna a chrání úrodu, musel promoklý anachoreta tahat za konopné lano i za deště, rachotu hromů a záře blesků. Teprve když v několika případech sjel blesk po mokrém provazu a nešťastníka zabil, bylo zvonění proti bouřím zakázáno."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
