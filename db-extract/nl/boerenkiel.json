                        "tags": [],
                        "examples": [
                            {
                                "example_id": "55652535-3151-4d03-90b5-4a5b98c71673",
                                "sense_id": "0861dab4-61eb-3ff3-8035-cc939ce45ec0",
                                "text": "Konstantin Levin keek naar binnen en zag dat er een jongeman aan het woord was; hij had een reusachtige bos haar en droeg een boerenkiel."
                            }
                        ]
                    },
                    {
                        "sense_id": "5c23bc00-9c84-38b5-9d00-f8616f17067e",
                        "entry_id": "37eda16c-0c36-3a84-856a-1aba66c57e08",
                        "glosses": [
                            "een werkjas zonder voorsluiting die over het hoofd wordt aangetrokken als favoriet kledingstuk tijdens het carnavalsfeest"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e1164dea-e2b2-4dbf-a9ab-6c039a0b8f27",
                                "sense_id": "5c23bc00-9c84-38b5-9d00-f8616f17067e",
                                "text": "Bij carnaval in Den Bosch hoort een boerenkiel. Randstedelingen, wees gewaarschuwd: zonder boerenkiel zijn jullie in sommige cafés niet welkom. Dit weekend begint carnaval en de straten van Den Bosch zijn al versierd met rood-wit-gele vlaggen."
                            }
                        ]
                    }
