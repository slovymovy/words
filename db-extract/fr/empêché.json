                    {
                        "sense_id": "47d2bc77-edac-3823-8855-4d7656f4c326",
                        "entry_id": "051d01ec-c5e5-3e3b-a477-6f67662a0f91",
                        "glosses": [
                            "Participe passé masculin singulier de empêcher."
