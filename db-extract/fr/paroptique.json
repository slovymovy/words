                        "glosses": [
                            "Qualifie une vision extra-rétinienne."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3e0e1582-4a50-4456-8521-bf706cf37fd8",
                                "sense_id": "1e6d8ee4-6238-3745-831d-672f9db7766b",
                                "text": "Le crapaud, dans une certaine mesure, voit avec sa peau. Il a, suivant l'expression de Farigoule, une vision paroptique. Même aveuglé, il se dirige vers la lumière, […]; et la sensation que sa peau en reçoit diffère d'une banale sensation de chaleur."
                            },
                            {
                                "example_id": "f009c30b-3e17-4b5b-9b59-964f0263f460",
                                "sense_id": "1e6d8ee4-6238-3745-831d-672f9db7766b",
                                "text": "Sous un éclairage normal, la vision paroptique est en effet analogue à celle de la vision normale mais elle en dépasse les limites, sauf pour le noir et blanc."
                            }
                        ]
                    },
                    {
                        "sense_id": "2c81f8aa-bbcd-3b80-8d8e-1b73fa339fc0",
                        "entry_id": "77c6aeb7-34d7-39bc-b8e9-0333d431798f",
                        "glosses": [
                            "Se dit d'une couleur obtenue par diffraction d'un rayon lumineux."
                        ],
