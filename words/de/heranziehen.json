                {
                    "sense_id": "fcdd3e10-55f6-33c3-81be-80925943dcb8",
                    "sense_definition": "Einen Gegenstand oder eine Person in die eigene Richtung, zu sich hinziehen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er <w>zog</w> einen Stuhl an den Schreibtisch <w>heran</w> und setzte sich."
                        },
                        {
                            "text": "Sie <w>zog</w> das weinende Kind tröstend zu sich <w>heran</w>."
                        }
                    ],
                    "synonyms": [
                        "herholen",
                        "näherziehen"
                    ],
                    "antonyms": [
                        "wegschieben",
                        "wegstoßen"
                    ],
                    "common_phrases": [
