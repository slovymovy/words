                                "target_senses": [
                                    {
                                        "sense_id": "d12b9b1b-9227-33c0-a32c-cd4b8ec70abb",
                                        "entry_id": "ac4979c1-5aa9-3d58-afc9-7335ab5d7d59",
                                        "glosses": [
                                            "Hébergement touristique organisé pour accueillir des enfants et adolescents en période de vacances scolaires."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b993a3-d9e3-4f4f-ac91-08c8946fe2f0",
                                                "sense_id": "d12b9b1b-9227-33c0-a32c-cd4b8ec70abb",
                                                "text": "Chèvres et moutons appartenaient à des fermes différentes qui les avaient confiés au maître berger. Et chacun allait rentrer chez soi comme les enfants au retour d’une colonie de vacances."
                                            },
                                            {
                                                "example_id": "94804fbf-6c2e-4403-838d-3de9e441bb36",
                                                "sense_id": "d12b9b1b-9227-33c0-a32c-cd4b8ec70abb",
                                                "text": "Dans les années 1990, ça chantait fort dans les colonies de vacances : « Pour faire un arbre, Dieu que c'est long! »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
