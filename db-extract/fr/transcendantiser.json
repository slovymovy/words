                "senses": [
                    {
                        "sense_id": "c308cb9c-23f5-3a39-b143-d0b165780a04",
                        "entry_id": "f52c45ca-ce99-3e3f-97b4-81f6c77b2b58",
                        "glosses": [
                            "Donner un caractère transcendant à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30de8f19-96ed-4590-a5bb-6e04f8f0f6f9",
                                "sense_id": "c308cb9c-23f5-3a39-b143-d0b165780a04",
                                "text": "Il suffit de les renvoyer à la grammaire immanente au langage, et de faire du Deus calculat, fit mundus des classiques, une représentation imaginaire qui vient transcendantiser cette immanence."
                            },
                            {
                                "example_id": "b4798423-71db-4f64-8686-a9900857019b",
                                "sense_id": "c308cb9c-23f5-3a39-b143-d0b165780a04",
                                "text": "Tandis qu’elle transcendantise le moi, elle s’y immanentise."
                            }
                        ]
                    }
