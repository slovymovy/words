                "senses": [
                    {
                        "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                        "entry_id": "79ed7050-6a60-3f4a-8858-4b787d3dd7ed",
                        "glosses": [
                            "sich durch Abstammung oder auch Testament ergebende Abfolge unter den Erben eines Nachlasses"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a396f49-c700-4836-9037-869a138a0aa9",
                                "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                                "text": "„Das deutsche Erbrecht kennt zwei Arten der Erbfolge: die gesetzliche und die gewillkürte Erbfolge.“"
                            },
                            {
                                "example_id": "16a31b74-f419-4d04-870c-8be7a960f177",
                                "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                                "text": "„Liegt kein Testament vor, tritt die gesetzliche Erbfolge in Kraft.“"
                            },
                            {
                                "example_id": "0dc51fcf-2b5a-479d-8cb0-142022f2adaf",
                                "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                                "text": "„Historisch lief die Erbfolge zu Japans Chrysanthementhron generell über männliche Nachkommen der kaiserlichen Linie.“"
                            },
                            {
                                "example_id": "19c6eb22-f6f3-4e1a-8d56-2301e3276a79",
                                "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                                "text": "„Wahlmonarchie bezeichnet eine Monarchie, deren Herrscher nicht durch Erbfolge, sondern durch eine Wahl bestimmt werden.“"
                            },
                            {
                                "example_id": "d47328a4-1af9-489b-ae0f-212f314b2bff",
                                "sense_id": "0ccca0b4-1222-34c0-a9f6-01cefdb5eb2e",
                                "text": "„Albrechts Erbfolge schien mit der Geburt seines Sohnes Wilhelm gesichert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
