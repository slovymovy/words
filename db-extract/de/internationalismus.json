                    {
                        "form_id": "c65f3e50-18eb-4250-b8c8-39f5511cc977",
                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "den Internationalismus"
                    },
                    {
                        "form_id": "3acd1018-7ef6-43ac-8592-50fa946ccf33",
                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Internationalismen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                        "glosses": [
                            "Wort, das in gleicher/ähnlicher Form und Bedeutung zugleich in mehreren Sprachen verbreitet ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "558363fb-4a50-4601-8188-f006a9dbee55",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Zudem bildet sich eine wachsende Zahl sogenannter Internationalismen heraus, die, weil sie die Kommunikation erleichtern können, eigentlich willkommen sein müßten.“"
                            },
                            {
                                "example_id": "95e3d82d-ddf1-4862-a2ef-a45b743d92b2",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Durch vergleichende Lexikonanalyse habe ich einen ersten Bestand der Internationalismen erarbeitet: demnach erreichen die gleichen Wortschätze im Deutschen, Englischen und Französischen eine Zahl von 3500 Wörtern, und zwar auf der Basis von einbändigen standardsprachlichen Wörterbüchern.“"
                            },
                            {
                                "example_id": "1cd49cb7-8de0-4c92-9ed1-7c65fc9ba962",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Wörter, die in alle wichtigen Kultursprachen entlehnt worden sind, nennen wir Internationalismen (man sagt auch Europäismen) und ähnliches)…“"
                            },
                            {
                                "example_id": "96a485a3-f046-4c88-9b3f-cd83f4b23de5",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Abschließend sollte vielleicht noch darauf hingewiesen werden, daß diese Textproben relativ viele Internationalismen enthalten.“"
                            },
                            {
                                "example_id": "c2be04e5-4677-4db3-ae0a-6a321b340d00",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Anglizismen sind zunehmend als Internationalismen anzusehen.“"
                            },
                            {
                                "example_id": "e6e552f7-58b3-4e5b-9d0c-66f6c5b990d6",
                                "sense_id": "f9134133-a3ef-36a4-9a79-6198ee33d0ec",
                                "text": "„Ein Internationalismus ist in vielen Sprachen der Erde vorhanden, hat überall gleiche oder sehr ähnliche Bedeutung und gleiche oder ähnliche Aussprache.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "3ee8be9d-6900-34a8-87f4-adde86b14e3b",
                        "entry_id": "7433e9ca-84b0-3674-9bde-df977e523155",
                        "glosses": [
                            "internationale Ausrichtung politischer Maßnahmen, politischen Denkens"
                        ],
                        "tags": [],
