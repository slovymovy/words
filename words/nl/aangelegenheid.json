                    "sense_id": "0fd7c792-cea2-33c5-9960-297e7b33f425",
                    "sense_definition": "een zaak of kwestie die aandacht of afhandeling vereist",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "zaak",
                    "name_type": "no",
