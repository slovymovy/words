                                    {
                                        "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                        "entry_id": "57347b89-b4d9-3307-a70a-6348407697d6",
                                        "glosses": [
                                            "geeft in het gedeelte na althans meer specifiek (en tegengesteld) aan wat er bedoeld wordt, in ieder geval"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ddccf25f-f02a-443c-86ed-ee4a921f0bf4",
                                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                                "text": "Dat is althans het beeld dat ontstaat bij het openslaan van een willekeurige krant."
                                            },
                                            {
                                                "example_id": "6da3a376-5b06-4018-89ea-20588f547311",
                                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                                "text": "Ik dronk niet meer, althans, niet meer zoals vroeger."
                                            },
                                            {
                                                "example_id": "1c7c5e09-b43c-47c4-8bac-7e58b2f5d6ed",
                                                "sense_id": "638ab25c-4903-3a46-9bf2-b6209e7c9b56",
                                                "text": "Hoewel ze niets van heimelijk gedrag moest hebben, voelde ze zich geen voyeur. Althans, dat maakte ze zichzelf wijs."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
