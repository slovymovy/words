{
    "word_family": [
        "rationality",
        "rationalize",
        "rationalization",
        "rationalism",
        "rationalist"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "482b6a15-16b2-36d2-89d0-cb4929917fa0",
                    "sense_definition": "Based on clear thought and reason rather than emotion; logically sound and not self-contradictory.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "logic_quality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to make a <w>rational</w> decision based on the facts, not our feelings.",
                            "target_lang_translations": {
                                "ru": "Нам нужно принять <w>рациональное</w> решение, основанное на фактах, а не на наших чувствах.",
                                "zh": "我们需要根据事实而非情感做出<w>理性</w>的决定。"
                            }
                        },
                        {
                            "text": "There must be a <w>rational</w> explanation for why the system failed yesterday.",
                            "target_lang_translations": {
                                "ru": "Должно быть <w>разумное</w> объяснение того, почему система вчера дала сбой.",
                                "zh": "系统昨天发生故障一定有其<w>合理</w>的解释。"
                            }
                        }
                    ],
                    "synonyms": [
                        "logical",
                        "reasonable",
                        "sensible",
                        "sound"
                    ],
                    "antonyms": [
                        "absurd",
                        "irrational",
                        "nonsensical"
                    ],
                    "common_phrases": [
                        "rational explanation",
                        "rational decision",
                        "rational choice",
                        "rational argument"
                    ],
                    "target_lang_definitions": {
                        "ru": "Основанный на здравом смысле и логике, а не на эмоциях; логически обоснованный.",
                        "zh": "基于清晰的思考和理性而非情感；逻辑上合理且不自相矛盾。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рациональный",
                                "target_lang_sense_clarification": "основанный на логике или расчете"
                            },
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "логичный, обоснованный"
                            },
                            {
                                "target_lang_word": "целесообразный",
                                "target_lang_sense_clarification": "соответствующий поставленной цели"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "理性的",
                                "target_lang_sense_clarification": "基于逻辑或推理的"
                            },
                            {
                                "target_lang_word": "合理的",
                                "target_lang_sense_clarification": "符合逻辑、有根据的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6d80cb0b-4ce5-3c9a-b505-b0aa23a52624",
                    "sense_definition": "Capable of thinking, reasoning, and making judgments.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "faculty_of_reason",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Humans are often described as <w>rational</w> beings because of their ability to think complexly.",
                            "target_lang_translations": {
                                "ru": "Людей часто описывают как <w>разумных</w> существ из-за их способности сложно мыслить.",
                                "zh": "人类常被称为<w>理性</w>生物，因为他们具备复杂的思维能力。"
                            }
                        },
                        {
                            "text": "The philosopher argued that a <w>rational</w> creature should always seek the truth.",
                            "target_lang_translations": {
                                "ru": "Философ утверждал, что <w>разумное</w> создание должно всегда искать истину.",
                                "zh": "那位哲学家认为，<w>理性</w>的生物应当始终追求真理。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reasoning",
                        "thinking",
                        "intelligent"
                    ],
                    "antonyms": [
                        "arational",
                        "non-rational",
                        "irrational"
                    ],
                    "common_phrases": [
                        "rational being",
                        "rational creature",
                        "rational nature"
                    ],
                    "target_lang_definitions": {
                        "ru": "Способный мыслить, рассуждать и выносить суждения.",
                        "zh": "具备思考、推理和判断能力的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разумный",
                                "target_lang_sense_clarification": "обладающий разумом"
                            },
                            {
                                "target_lang_word": "мыслящий",
                                "target_lang_sense_clarification": "способный к мышлению"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有理性的",
                                "target_lang_sense_clarification": "具备理智的"
                            },
                            {
                                "target_lang_word": "理性的",
                                "target_lang_sense_clarification": "具有思维能力的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "04865094-1000-3d77-a384-69f51a40f8c4",
                    "sense_definition": "Mentally healthy, lucid, and able to think clearly; not delirious or insane.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "mental_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Although the patient had a high fever, she remained calm and <w>rational</w>.",
                            "target_lang_translations": {
                                "ru": "Хотя у пациентки была высокая температура, она оставалась спокойной и <w>рассудительной</w>.",
                                "zh": "尽管病人发着高烧，她依然保持冷静且<w>理智</w>。"
                            }
                        },
                        {
                            "text": "It is difficult to stay <w>rational</w> when you are in a state of extreme panic.",
                            "target_lang_translations": {
                                "ru": "Трудно оставаться <w>здравомыслящим</w>, когда вы находитесь в состоянии сильной паники.",
                                "zh": "当你处于极度恐慌的状态时，很难保持<w>清醒</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "lucid",
                        "sane",
                        "composed"
                    ],
                    "antonyms": [
                        "irrational"
                    ],
                    "common_phrases": [
                        "stay rational",
                        "rational mind",
                        "rational conduct"
                    ],
                    "target_lang_definitions": {
                        "ru": "Психически здоровый, ясно мыслящий; не находящийся в бреду или безумии.",
                        "zh": "精神健康、清醒且能清晰思考的；非神志不清或疯狂的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "здравомыслящий",
                                "target_lang_sense_clarification": "обладающий здравым умом"
                            },
                            {
                                "target_lang_word": "рассудительный",
                                "target_lang_sense_clarification": "спокойный и логичный в суждениях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "清醒的",
                                "target_lang_sense_clarification": "神志正常的"
                            },
                            {
                                "target_lang_word": "理智的",
                                "target_lang_sense_clarification": "头脑冷静、判断正确的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2be147cf-a939-312d-8077-1251505aee45",
                    "sense_definition": "Of a number, capable of being expressed as a ratio of two integers (fractions).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In our math class, we learned that 0.75 is a <w>rational</w> number.",
                            "target_lang_translations": {
                                "ru": "На уроке математики мы узнали, что 0,75 — это <w>рациональное</w> число.",
                                "zh": "在数学课上，我们学到 0.75 是一个<w>有理</w>数。"
                            }
                        },
                        {
                            "text": "The square root of two is not a <w>rational</w> value because it cannot be written as a simple fraction.",
                            "target_lang_translations": {
                                "ru": "Квадратный корень из двух не является <w>рациональным</w> значением, так как его нельзя записать в виде простой дроби.",
                                "zh": "二的平方根不是<w>有理</w>值，因为它无法写成简单的分数。"
                            }
                        }
                    ],
                    "antonyms": [
                        "irrational"
                    ],
                    "common_phrases": [
                        "rational number",
                        "rational function"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Относящийся к числу, которое можно представить в виде отношения двух целых чисел (дроби).",
                        "zh": "指可以表示为两个整数之比（分数）的数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рациональный",
                                "target_lang_sense_clarification": "математический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有理的",
                                "target_lang_sense_clarification": "数学术语"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "19535dce-89c3-3579-b8e7-9a2ca8549f27",
                    "sense_definition": "A number that can be expressed as the quotient of two integers.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "mathematics_noun",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The set of <w>rationals</w> is dense, meaning there is a rational number between any two real numbers.",
                            "target_lang_translations": {
                                "ru": "Множество <w>рациональных чисел</w> плотное, что означает, что между любыми двумя вещественными числами есть рациональное число.",
                                "zh": "<w>有理数</w>集是稠密的，这意味着在任意两个实数之间都存在一个有理数。"
                            }
                        },
                        {
                            "text": "The professor asked the students to prove that the sum of two <w>rationals</w> is also rational.",
                            "target_lang_translations": {
                                "ru": "Профессор попросил студентов доказать, что сумма двух <w>рациональных чисел</w> также рациональна.",
                                "zh": "教授要求学生证明两个<w>有理数</w>之和也是有理数。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "set of rationals"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematics"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Число, которое можно представить в виде частного двух целых чисел.",
                        "zh": "可以表示为两个整数之商的数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рациональное число",
                                "target_lang_sense_clarification": "математика"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有理数",
                                "target_lang_sense_clarification": "数学名词"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "387a8b37-7bb7-334f-8fee-e85510e59b06",
                    "sense_definition": "The ceremonial breastplate worn by Israelite high priests in ancient times.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "historical_artifact",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient text describes the <w>rational</w> as a sacred garment adorned with twelve stones.",
                            "target_lang_translations": {
                                "ru": "Древний текст описывает <w>наперсник</w> как священное одеяние, украшенное двенадцатью камнями.",
                                "zh": "古籍将这种<w>胸牌</w>描述为镶嵌着十二颗宝石的圣衣。"
                            }
                        },
                        {
                            "text": "Historians studied the design of the <w>rational</w> worn by the high priest.",
                            "target_lang_translations": {
                                "ru": "Историки изучали устройство <w>наперсника</w>, который носил первосвященник.",
                                "zh": "历史学家研究了大祭司所佩戴的<w>胸牌</w>的设计。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical/religious context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ритуальный нагрудник, который носили израильские первосвященники в древности.",
                        "zh": "古代以色列大祭司佩戴的礼仪胸牌。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наперсник",
                                "target_lang_sense_clarification": "библейский термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "胸牌",
                                "target_lang_sense_clarification": "宗教礼仪服饰"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}