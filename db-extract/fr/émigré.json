                                "target_senses": [
                                    {
                                        "sense_id": "090dd481-300f-30c4-9bc5-b502bfb7429a",
                                        "entry_id": "17e6c9f3-3b3a-3314-9515-0bab35b3eda4",
                                        "glosses": [
                                            "One who has departed their native land, often as a refugee."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "49a65238-bbc3-495a-aaf9-ac384cea849c",
                                                "sense_id": "090dd481-300f-30c4-9bc5-b502bfb7429a",
                                                "text": "Between the wars, Paris was the center for all the world's emigres."
