                                "target_senses": [
                                    {
                                        "sense_id": "7bc27cc0-7915-3492-af36-09ed85d0bbd0",
                                        "entry_id": "1ef0964d-3532-3a6a-8920-2b581ce4ed06",
                                        "glosses": [
                                            "Soldat d'une milice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "110ba352-c91c-47b8-bd7b-9d3c116f97ec",
                                                "sense_id": "7bc27cc0-7915-3492-af36-09ed85d0bbd0",
                                                "text": "Le milicien céleste est un jeune homme rehaussé en couleurs, frisé d'une perruque ébouriffée, armé de la lance de rigueur et serré dans une cotte d’armes en écailles de poisson"
                                            },
                                            {
                                                "example_id": "33a6760d-9b6e-4317-bf40-41fb6902771d",
                                                "sense_id": "7bc27cc0-7915-3492-af36-09ed85d0bbd0",
                                                "text": "Véronique Nahoum-Grappe, qu’on ne peut soupçonner de complaisance envers les hommes et qui a fort bien dénoncé les violences des miliciens serbes avinés en Bosnie, lors des viols de guerre, a aussi évoqué « le violeur enivré (qui) s’endort avant de commettre son crime »."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3156d820-bd1c-3f38-8008-13bef4dc664b",
                                        "entry_id": "1ef0964d-3532-3a6a-8920-2b581ce4ed06",
                                        "glosses": [
                                            "Membre de la Milice française, créée en 1943 par le régime de Vichy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "74f6fadb-d88f-4ff8-9c6e-72547f728466",
                                                "sense_id": "3156d820-bd1c-3f38-8008-13bef4dc664b",
                                                "text": "— Mais maintenant qu’il a les miliciens dans sa manche, il va pouvoir faire du marché noir en toute tranquillité."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f71fc781-5e98-47a5-8247-e9257f973828",
                        "source_entry_id": "f74f4ef2-f103-34e8-8f68-5ba0b18b1d1a",
                        "source_sense_id": "35c3cd0d-73f6-3ae7-aebd-c357f89c870a",
                        "source_sense_description": "member of a militia",
                        "target_lang_word": "Milizionär",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Milizionär",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                        "entry_id": "510fad35-8dc8-3a8b-be53-c29b5061cde8",
                                        "glosses": [
                                            "Angehöriger einer Miliz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cab533de-e7df-4530-95f1-b33c2c7b1f9c",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Zuletzt hätten die islamistischen Milizionäre in einigen Stadtteilen sogar wieder die Kontrolle übernommen.“"
                                            },
                                            {
                                                "example_id": "0401a84a-955c-464e-b6a3-95b323f81607",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Ein Milizionär durchtrennte mit Babas Messer ihre Fesseln.“"
                                            },
                                            {
                                                "example_id": "895d8ddc-e2a9-4f12-a5be-649b7698ec6d",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Erst als sich die Situation etwas beruhigt, findet die Mutter des jungen Mannes bei einem polnischen Milizionär Gehör.“"
                                            },
                                            {
                                                "example_id": "a947ad84-9885-4d5d-af40-9cb135e8096a",
                                                "sense_id": "f8d78a58-ccce-3407-821b-558d6e6af239",
                                                "text": "„Dagegen lösten iranische Milizionäre mit Maschinengewehren behagliche Gefühle in ihr aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
