                        "glosses": [
                            "Département de France, situé en Normandie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f1fdaf80-71c9-4d76-82ac-f9e85a01a7f5",
                                "sense_id": "6410b407-d434-3a85-8920-1a7adcd37d89",
                                "text": "La Seine-Maritime profite des produits de la mer comme les lisettes de Dieppe, des gibiers comme le canard rouannais ou le lapin à la havraise mais surtout des produits laitiers comme le livarot, le camembert ou le carré de Bray !"
                            },
                            {
                                "example_id": "bffba2da-eea0-4892-b24b-92bea8f2709e",
                                "sense_id": "6410b407-d434-3a85-8920-1a7adcd37d89",
                                "text": "Après avoir été élu pendant dix-neuf ans à la tête de Varengeville-sur-Mer, un village de Seine-Maritime célèbre pour son cimetière marin, Christian Blanckaert répond à cette question en consignant mille et une anecdotes dans un livre, Journal d’un maire de campagne, qui vient de paraître."
                            }
                        ]
                    }
