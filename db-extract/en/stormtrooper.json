                                            {
                                                "example_id": "3963d994-e110-4daf-8678-68fa38b28562",
                                                "sense_id": "c7c9975a-3b64-399c-ab0b-eae09db97366",
                                                "text": "Gdy eskor­tu­jący ją wcześniej szturmowiec zda­wał raport, nadal czuła na ple­cach lufę bla­stera"
