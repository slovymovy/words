    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "67d52e4c-3267-348b-bff2-ff0108699387",
                    "sense_definition": "Effectuer ou exécuter une opération, une démarche méthodique.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Avant d'allumer l'appareil, nous devons <w>procéder</w> à une vérification complète du circuit électrique."
                        },
                        {
                            "text": "Les techniciens vont <w>procéder</w> au remplacement de la pièce défectueuse dès demain matin."
                        }
                    ],
                    "synonyms": [
                        "effectuer",
                        "exécuter",
                        "réaliser"
                    ],
                    "common_phrases": [
                        "procéder au vote",
                        "procéder à l'installation",
                        "procéder à une vérification"
                    ]
                },
                {
                    "sense_id": "cc9df1dd-5210-3b67-9804-c7864dfd0c2b",
                    "sense_definition": "Tirer son origine, émaner ou résulter de quelque chose.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "origine",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette décision courageuse <w>procède</w> d'une volonté ferme de moderniser les structures existantes."
                        },
                        {
                            "text": "Leurs craintes légitimes <w>procèdent</w> d'un manque évident de communication entre les services."
                        }
                    ],
                    "synonyms": [
                        "découler",
                        "émaner",
                        "provenir"
                    ],
                    "common_phrases": [
                        "procéder d'une même logique",
                        "procéder d'une volonté"
                    ]
                },
                {
                    "sense_id": "b42fb408-363b-366f-b778-068d9d18d5a2",
                    "sense_definition": "Agir ou se comporter d'une manière déterminée.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "comportement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa manière de <w>procéder</w> déconcerte ses collègues mais produit pourtant de remarquables résultats."
                        },
                        {
                            "text": "Vous devez m'expliquer clairement comment vous comptez <w>procéder</w> pour régler ce différend."
                        }
                    ],
                    "synonyms": [
                        "agir",
                        "se comporter"
                    ],
                    "common_phrases": [
                        "façon de procéder",
                        "manière de procéder"
                    ]
                },
                {
                    "sense_id": "07a76769-6363-30e0-b222-c7e1b002bf92",
                    "sense_definition": "Accomplir des formalités ou des actes légaux dans le cadre d'une instance judiciaire.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "droit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'avocat a conseillé à son client de <w>procéder</w> par voies juridiques formelles."
                        },
                        {
                            "text": "Le magistrat instructeur a décidé de <w>procéder</w> à l'audition de plusieurs nouveaux témoins."
                        }
                    ],
                    "synonyms": [
                        "poursuivre"
                    ],
                    "common_phrases": [
                        "procéder en justice"
                    ]
                }
            ]
        }
    ]
