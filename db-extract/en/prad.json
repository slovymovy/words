                        ],
                        "examples": [
                            {
                                "example_id": "0b8477af-a775-4a00-b8ce-66f3a49b225a",
                                "sense_id": "3adb9c87-8eba-3ed4-86d5-9bdb8ebf188d",
                                "text": "Horse Stealers, they go together always the Day before, to look over the Grounds for a good Prad or Prads […]"
                            },
                            {
                                "example_id": "9c92c585-0c51-41cb-b221-21df975c23b2",
                                "sense_id": "3adb9c87-8eba-3ed4-86d5-9bdb8ebf188d",
                                "text": "We had fixed our eye on a horse-dealer, and had some conversation with him about the purchase of a prad; but we could not agree, and parted, on account of a deeker, who was eyeing us closely, and I observed him speak to the jockey."
                            },
                            {
                                "example_id": "75b439eb-a30f-4f57-97cc-062796ca1783",
                                "sense_id": "3adb9c87-8eba-3ed4-86d5-9bdb8ebf188d",
                                "text": "'Just send somebody out to relieve my mate, will you, young man?' said the officer; 'he's in the gig, a-minding the prad. […]'"
                            },
                            {
                                "example_id": "b7d67795-6c00-4a8c-a972-f8b0bc1d0799",
                                "sense_id": "3adb9c87-8eba-3ed4-86d5-9bdb8ebf188d",
                                "text": "1893, Ernest Favenc, \"Bunthorp's Decease\" in Tales of the Austral Tropics, London: Osgood, MacIlvaine & Co., 1894, http://gutenberg.net.au/ebooks06/0600691h.html\n\"Not a bad sort of a prad that brown one,\" he remarked; \"looks a little gone in the near fore-leg.\""
                            },
                            {
                                "example_id": "942286af-65d0-4900-a9bd-07dec321edcc",
                                "sense_id": "3adb9c87-8eba-3ed4-86d5-9bdb8ebf188d",
                                "text": "So smooth of face, so fine of eye, so much a beautiful part of his beautiful chestnut prad."
                            }
                        ]
                    }
                ],
