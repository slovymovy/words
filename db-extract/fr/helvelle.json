                        "entry_id": "49b632f9-2f93-360c-8e66-ecdce5199dbb",
                        "glosses": [
                            "Genre de champignons, au chapeau lisse, en forme de selle ou chiffonné, toujours contourné, et au pied sans anneau, souvent côtelé ou lacuneux."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ee3ab6c0-da46-4ee0-84ca-8c8eac9c8647",
                                "sense_id": "5f249f8c-86d1-334c-8af5-a3b9fb44a7ab",
                                "text": "Voici… l’helvelle, dont le chapeau a l’air d’une mitre d’évêque, et non loin la tribu des hydnes."
                            }
                        ]
                    }
                ],
