                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "73c6c795-9085-43b7-9c58-540c36a7c120",
                                                "sense_id": "ef9e17e4-4b49-34e1-a8d4-da4e2e1c86e6",
                                                "text": "The real difficulty was moral, not intellectual. Was the whole edifice of Ptolemy to be destroyed?"
                                            },
                                            {
                                                "example_id": "70a2d515-a057-499d-abbe-76a86e40af71",
                                                "sense_id": "ef9e17e4-4b49-34e1-a8d4-da4e2e1c86e6",
                                                "text": "With a great thump on the table, Poirot demolished his carefully built up edifice."
                                            }
                                        ]
