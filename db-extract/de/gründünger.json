                "translations": [
                    {
                        "translation_id": "71c7c96a-a50c-4845-aaf0-d1484112f914",
                        "source_entry_id": "4add31dc-0210-3532-ad35-d631f9bd65b2",
                        "source_sense_id": "9bc047c9-02ef-312e-be78-9fb16ace1e72",
                        "source_sense_description": "aus Pflanzen gewonnener Dünger",
                        "target_lang_word": "engrais vert",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "engrais vert",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b97938ee-ccf8-35d2-929c-e0dc1bf9d691",
                                        "entry_id": "7765af1a-9a01-35c9-953a-93f8d93329d2",
                                        "glosses": [
                                            "Culture destinée à être enfouie dans le sol pour l'engraisser, soit en culture dérobée, soit en jachère cultivée."
                                        ],
                                        "tags": [
                                            "Jardinage"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e709cc80-47ed-434d-80f1-b42f6dce8cc2",
                                                "sense_id": "b97938ee-ccf8-35d2-929c-e0dc1bf9d691",
                                                "text": "En 1951, en l'absence d'une céréale mécanisable, nous avons adopté la rotation : engrais vert, arachide, arachide. Mais notre objectif était de réaliser un assolement quadriennal : engrais vert, arachide, céréale, arachide."
                                            },
                                            {
                                                "example_id": "b3411990-d11b-463b-87a6-09ec1b3d0d37",
                                                "sense_id": "b97938ee-ccf8-35d2-929c-e0dc1bf9d691",
                                                "text": "Les résultats extrêmement encourageants obtenus au Sénégal et au Togo avec ces deux légumineuses utilisées comme engrais verts en riziculture et sorghoculture, ont amené le Projet d'expérimentations agronomiques de Loudima (Congo) à les introduire au Centre de recherches agronomiques."
                                            },
                                            {
                                                "example_id": "917b270d-2e93-4800-8a02-9fa5e42fde0b",
                                                "sense_id": "b97938ee-ccf8-35d2-929c-e0dc1bf9d691",
                                                "text": "Si les engrais verts donnent de fort bons résultats dans les sols infertiles et épuisés, à plus forte raison sont-ils avantageux dans les sols fertiles et riches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
