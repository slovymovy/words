                ],
                "senses": [
                    {
                        "sense_id": "1b59b3ce-a5ad-316c-80f8-90e7c7910974",
                        "entry_id": "e3dcbbb1-38e7-35c1-b59d-640d95c03592",
                        "glosses": [
                            "niet prettig voor de gebruiker"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c7f1b1a7-6360-4d6a-8a6e-39a0e95f0640",
                                "sense_id": "1b59b3ce-a5ad-316c-80f8-90e7c7910974",
                                "text": "Opmerkelijk genoeg is Snapchat vergeleken met Twitter of Facebook buitengewoon gebruikersonvriendelijk. Nieuwe gebruikers die op zoek gaan naar een post van hun kind, verkering of een beroemdheid hebben het moeilijk: iemand vinden zonder de gebruikersnaam te weten is bijna ondoenlijk. Dat is expres, schrijft Bloomberg."
                            },
                            {
                                "example_id": "ba84c70c-e768-487c-a7a3-d3a4969c5a7a",
                                "sense_id": "1b59b3ce-a5ad-316c-80f8-90e7c7910974",
                                "text": "Hoe zijn de gevonden woorden nu in het boek en op de bijgesloten cd verwerkt? Behalve literaire bronnen hebben de auteurs diverse naslagwerken en woordenboeken doorgenomen. Per lemma sommen zij op wat zij daarin hebben gevonden. Onder het trefwoord botol, bijvoorbeeld, staan de (gebruikersonvriendelijk) verkorte titels van acht naslagwerken, met daarachter acht maal de mededeling dat botol `fles'"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8536a21f-00b5-4b87-960a-2b813327d26b",
                        "source_entry_id": "e3dcbbb1-38e7-35c1-b59d-640d95c03592",
                        "source_sense_id": "1b59b3ce-a5ad-316c-80f8-90e7c7910974",
