                                        "glosses": [
                                            "Partisan du possibilisme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbabc7bf-2d3a-4b9d-92a0-771ce2d6814d",
                                                "sense_id": "0fd34319-737a-3f19-9f78-86a4ffbf59bc",
                                                "text": "Le possibiliste est maître de son destin."
                                            },
                                            {
                                                "example_id": "42c8a4ec-4e07-4f76-821f-a2dabeb348f6",
                                                "sense_id": "0fd34319-737a-3f19-9f78-86a4ffbf59bc",
                                                "text": "Les guesdistes partis, les délégués demeurés en place, en majorité parisiens, se regroupent autour de Brousse, Allemane, Joffrin, Malon, etc. Ce sont les « possibilistes »."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "possibiliste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "41869fd2-1678-30bd-a12f-148a7c499bb9",
