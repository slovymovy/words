                    {
                        "sense_id": "f4513bc2-02ba-3c09-9dc0-94ea50e580d8",
                        "entry_id": "b5e865d9-9d17-3900-952f-0e905c7359f7",
                        "glosses": [
                            "muh ist der besondere Tierlaut der Kuh"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f5ef570e-e760-4e36-92cb-79dd7550fe0c",
                                "sense_id": "f4513bc2-02ba-3c09-9dc0-94ea50e580d8",
                                "text": "Die Kuh macht muh!, wie andere Tiere andere Laute machen."
                            },
                            {
                                "example_id": "9245ea31-2f77-41ac-8538-4a4d9cbe1347",
                                "sense_id": "f4513bc2-02ba-3c09-9dc0-94ea50e580d8",
                                "text": "Muh! Kühe fehlen auf kaum einem Bauernhof. Seit ewigen Zeiten liefern sie Fleisch und Milch."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cf6adad6-7a8f-47de-89f5-1d72da8cc770",
                        "source_entry_id": "b5e865d9-9d17-3900-952f-0e905c7359f7",
                        "source_sense_id": "f4513bc2-02ba-3c09-9dc0-94ea50e580d8",
