                    {
                        "translation_id": "2e97610b-64f9-4e20-a0a7-cff6ac728531",
                        "source_entry_id": "9252fa0a-b713-3834-b6cd-a0517c1851c9",
                        "source_sense_id": "cc1aa422-83e4-3e7f-8c2f-84b7366433a9",
                        "target_lang_word": "меломан",
