                        "entry_id": "8cca5220-0723-3b3c-982c-b53ebf2248b6",
                        "glosses": [
                            "mit Widerwillen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dbba862a-e455-456a-9cb3-5a6535e1d1ec",
                                "sense_id": "c251677f-e462-3fce-b88f-dac934789865",
                                "text": "Ich sage es ja nur ungern, aber so kann das nicht stimmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "70823aa9-2392-401b-9c3c-3dc5190c96c0",
                        "source_entry_id": "8cca5220-0723-3b3c-982c-b53ebf2248b6",
                        "source_sense_id": "c251677f-e462-3fce-b88f-dac934789865",
                        "source_sense_description": "mit Widerwillen",
                        "target_lang_word": "reluctantly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reluctantly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "973c8034-05e1-34ac-bdd4-6407e6d4ade3",
                                        "entry_id": "5074957d-046e-392c-a210-94e15553a85d",
                                        "glosses": [
                                            "In a reluctant or hesitant manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6f3e52d4-e7a3-40dd-b883-2d5a9f3eb168",
                                                "sense_id": "973c8034-05e1-34ac-bdd4-6407e6d4ade3",
                                                "text": "Then I had a good think on the subject of the hocussing of Cigarette, and I was reluctantly bound to admit that once again the man in the corner had found the only possible solution to the mystery."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "07741610-86bd-4701-b38f-c8e1ed29e9fa",
                        "source_entry_id": "8cca5220-0723-3b3c-982c-b53ebf2248b6",
                        "source_sense_id": "c251677f-e462-3fce-b88f-dac934789865",
                        "source_sense_description": "mit Widerwillen",
                        "target_lang_word": "grudgingly",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "grudgingly",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                        "entry_id": "544607ff-509c-39b0-815b-199a5d9722c3",
                                        "glosses": [
                                            "In a manner expressing resentment or lack of desire."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "64e75de4-b010-460d-92df-af28275bda88",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "\"This is just a cover story,\" Clay says to O5-8, not taking his eyes off Marion. \"It's a good one, but she's had it worked out in advance.\"\n\"Clay, lose the piece,\" says the O5.\nGrudgingly, Clay does so."
                                            },
                                            {
                                                "example_id": "ed6ba33c-1345-4ed7-a56c-fd953b5d8580",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "I was left to play my part, grudgingly, in the eternal jugalbandi of tourist life: ‘Boat, sir?’ ‘No, thank you.’ ‘Rickshaw, sir?’ ‘No, thank you.’"
                                            },
                                            {
                                                "example_id": "ef8e39bd-e06d-48cb-81b5-f0da6c47484d",
                                                "sense_id": "d16f8540-ae55-3aec-9ed8-9a4d328ee2c6",
                                                "text": "Online and over Shabbat dinners, arguments about the election have grown bitter. Those grudgingly planning to vote for Labour have been called traitors to the community and self-hating Jews. Anti-Corbyn die-hards, on the other hand, have been branded the handmaidens of a hard Brexit."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "89b0854d-e195-4c5e-b2af-49f5b2882cdc",
                        "source_entry_id": "8cca5220-0723-3b3c-982c-b53ebf2248b6",
                        "source_sense_id": "c251677f-e462-3fce-b88f-dac934789865",
                        "source_sense_description": "mit Widerwillen",
                        "target_lang_word": "à contrecœur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "à contrecœur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                        "entry_id": "e6992e4b-9553-364c-a0b1-df3549d561d5",
                                        "glosses": [
                                            "À regret ; avec répugnance ; malgré soi."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ee1be61-3bd6-4f0d-b07f-7091524d8b6c",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Si un policier seul recueille un témoignage, il sera toujours possible au suspect qui a parlé à contrecœur de nier ses aveux par la suite. Deux affirmations ont plus de poids qu’une seule devant un jury"
                                            },
                                            {
                                                "example_id": "9e8290c9-5c73-4c7c-8655-5a3c01f46f60",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Sur la steppe rouge du Planalto central, où les arbres ne poussent qu’à contrecœur, Brasilia est une ville retranchée, une capitale solitaire, loin, très loin, du Brésil utile, du pays réel. Bâtie par des disciples de Le Corbusier, elle a été soumise à la rigueur, à la raideur calvinistes du vieux maître, […]."
                                            },
                                            {
                                                "example_id": "472513cc-e919-4e1a-ba83-ab9f90061db2",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Aussi, presque à contrecœur, tire-t-il de sa musette un morceau de bruccio."
                                            },
                                            {
                                                "example_id": "21f84ba7-6fbe-476b-8192-d2df9845f0b0",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Massacrer un gentil, vraiment j’y allais à contrecœur."
                                            },
                                            {
                                                "example_id": "21ef6db0-f258-4751-89e9-cb3268222e7c",
                                                "sense_id": "25b3a067-f050-3e5d-9bee-4f7870c7085e",
                                                "text": "Derrière les prétendus paradoxes subversifs qu’elle expose, son discours ressasse une antienne séculaire de la libération sexuelle des 60-70, celle qui a avant tout libéré la sexualité masculine : les femmes doivent subir à contrecœur les assauts masculins pour ne pas être stigmatisées en tant que bourgeoises frigides (« psychologiquement pures »)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "98d801dc-566b-455c-ad89-fad28013774f",
                        "source_entry_id": "8cca5220-0723-3b3c-982c-b53ebf2248b6",
                        "source_sense_id": "c251677f-e462-3fce-b88f-dac934789865",
