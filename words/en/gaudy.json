{
    "word_family": [
        "gaud",
        "gaudily",
        "gaudiness"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c8bf584e-65a0-36e6-8a56-0a802c84de51",
                    "sense_definition": "Very showy, brightly colored, or highly ornamented, especially in a tasteless, vulgar, or excessive way.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "showy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She decided not to buy the dress because of its <w>gaudy</w> colors and cheap-looking sequins.",
                            "target_lang_translations": {
                                "ru": "Она решила не покупать платье из-за его <w>кричащих</w> цветов и дешево выглядящих пайеток."
                            }
                        },
                        {
                            "text": "The mansion was decorated with <w>gaudy</w> jewelry and oversized gold statues that offended many guests.",
                            "target_lang_translations": {
                                "ru": "Особняк был украшен <w>безвкусными</w> побрякушками и огромными золотыми статуями, которые оскорбляли вкус многих гостей."
                            }
                        }
                    ],
                    "synonyms": [
                        "flashy",
                        "garish",
                        "tacky",
                        "tasteless",
                        "ostentatious"
                    ],
                    "antonyms": [
                        "unadorned"
                    ],
                    "common_phrases": [
                        "gaudy jewelry",
                        "gaudy colors"
                    ],
                    "target_lang_definitions": {
                        "ru": "Очень броский, ярко окрашенный или чрезмерно украшенный, особенно безвкусным, вульгарным или излишним образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безвкусный",
                                "target_lang_sense_clarification": "лишенный вкуса, вульгарный"
                            },
                            {
                                "target_lang_word": "кричащий",
                                "target_lang_sense_clarification": "слишком яркий, привлекающий внимание"
                            },
                            {
                                "target_lang_word": "аляповатый",
                                "target_lang_sense_clarification": "грубо и безвкусно украшенный"
                            },
                            {
                                "target_lang_word": "цветастый",
                                "target_lang_sense_clarification": "пестрый, излишне яркий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "574199f1-a53f-3a13-ba1a-71d979c5cd98",
                    "sense_definition": "Fun, merry, or festive.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "festive",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Let us celebrate this grand occasion with one more <w>gaudy</w> night of drinking and dancing.",
                            "target_lang_translations": {
                                "ru": "Давайте отпразднуем это великое событие еще одной <w>веселой</w> ночью выпивки и танцев."
                            }
                        },
                        {
                            "text": "The old friends gathered for a <w>gaudy</w> day of laughter and reminiscing about their youth.",
                            "target_lang_translations": {
                                "ru": "Старые друзья собрались для <w>праздничного</w> дня, полного смеха и воспоминаний о юности."
                            }
                        }
                    ],
                    "synonyms": [
                        "festive",
                        "merry"
                    ],
                    "common_phrases": [
                        "gaudy night",
                        "gaudy day"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "used in the sense of festive or merry"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Веселый, праздничный или радостный (устаревшее значение)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "праздничный",
                                "target_lang_sense_clarification": "торжественный, веселый"
                            },
                            {
                                "target_lang_word": "веселый",
                                "target_lang_sense_clarification": "радостный, оживленный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "51f56994-c870-3d50-b13a-aa16188ab1ee",
                    "sense_definition": "A reunion dinner or festival held by one of the colleges of the University of Oxford for its alumni.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "oxford_reunion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He returned to his old college in Oxford to attend the annual summer <w>gaudy</w>.",
                            "target_lang_translations": {
                                "ru": "Он вернулся в свой старый колледж в Оксфорде, чтобы посетить ежегодную летнюю <w>встречу выпускников</w>."
                            }
                        },
                        {
                            "text": "Many distinguished alumni gathered at the college <w>gaudy</w> to share stories of their student days.",
                            "target_lang_translations": {
                                "ru": "Многие выдающиеся выпускники собрались на университетском <w>празднике выпускников</w>, чтобы поделиться историями о своих студенческих годах."
                            }
                        }
                    ],
                    "common_phrases": [
                        "college gaudy"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "primarily used in British English, specifically associated with Oxford University"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ежегодный торжественный обед или праздник встречи выпускников, проводимый одним из колледжей Оксфордского университета."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "встреча выпускников",
                                "target_lang_sense_clarification": "традиционный обед выпускников в Оксфорде"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4030893e-597a-369c-871e-1fd9ac31b28d",
                    "sense_definition": "One of the larger, more ornamental beads in a rosary, used to mark the recital of the Lord's Prayer.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "rosary_beads",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The medieval rosary was made of fifty small coral beads separated by larger gold <w>gaudies</w>.",
                            "target_lang_translations": {
                                "ru": "Средневековый розарий состоял из пятидесяти мелких коралловых бусин, разделенных более крупными золотыми <w>разделительными бусинами</w>."
                            }
                        },
                        {
                            "text": "She ran her fingers over the smooth beads, pausing at each <w>gaudy</w> to recite the paternoster.",
                            "target_lang_translations": {
                                "ru": "Она перебирала пальцами гладкие бусины, останавливаясь на каждой <w>крупной бусине</w>, чтобы прочитать «Отче наш»."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical term for rosary beads"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Одна из крупных, более украшенных бусин в четках (розарии), используемая для отсчета молитвы «Отче наш»."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крупная бусина",
                                "target_lang_sense_clarification": "в четках для отсчета молитвы"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}