{
    "word_family": [
        "flouter"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "1259d0c3-2a36-3a40-a695-a17594b5a32e",
                    "sense_definition": "To openly disregard or ignore a rule, law, or convention.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "disregard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The company continued to <w>flout</w> safety regulations despite repeated warnings from the authorities.",
                            "target_lang_translations": {
                                "nl": "Het bedrijf bleef de veiligheidsvoorschriften <w>aan zijn laars lappen</w> ondanks herhaalde waarschuwingen van de autoriteiten."
                            }
                        },
                        {
                            "text": "Drivers who <w>flout</w> traffic laws put everyone on the road at significant risk.",
                            "target_lang_translations": {
                                "nl": "Bestuurders die de verkeersregels <w>schenden</w>, brengen iedereen op de weg in groot gevaar."
                            }
                        }
                    ],
                    "synonyms": [
                        "defy",
                        "disregard",
                        "violate",
                        "ignore"
                    ],
                    "antonyms": [
                        "obey",
                        "observe",
                        "comply"
                    ],
                    "common_phrases": [
                        "flout the law",
                        "flout the rules"
                    ],
                    "target_lang_definitions": {
                        "nl": "Openlijk negeren of aan zijn laars lappen van een regel, wet of afspraak."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "aan zijn laars lappen",
                                "target_lang_sense_clarification": "Een informele uitdrukking voor het opzettelijk negeren van regels."
                            },
                            {
                                "target_lang_word": "schenden",
                                "target_lang_sense_clarification": "Het verbreken of niet naleven van een wet of afspraak."
                            },
                            {
                                "target_lang_word": "negeren",
                                "target_lang_sense_clarification": "Iets bewust niet opvolgen of geen aandacht aan schenken."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c60d01ac-bdc4-357a-9047-f44bde0c1cd2",
                    "sense_definition": "To treat with disdain or scorn.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disregard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He felt that his colleagues would <w>flout</w> his ideas because of his lack of experience.",
                            "target_lang_translations": {
                                "nl": "Hij had het gevoel dat zijn collega's zijn ideeën zouden <w>bespotten</w> vanwege zijn gebrek aan ervaring."
                            }
                        },
                        {
                            "text": "The arrogant artist seemed to <w>flout</w> the traditions of the classical school.",
                            "target_lang_translations": {
                                "nl": "De arrogante kunstenaar leek de tradities van de klassieke school te <w>minachten</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "scorn",
                        "mock",
                        "disdain"
                    ],
                    "antonyms": [
                        "respect",
                        "revere"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Often used in a literary or dated context."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Met minachting of spot behandelen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "bespotten",
                                "target_lang_sense_clarification": "Iemand of iets belachelijk maken."
                            },
                            {
                                "target_lang_word": "minachten",
                                "target_lang_sense_clarification": "Geen enkel respect tonen voor iemand of iets."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "de72682f-f890-327b-9810-0962b46ddda7",
                    "sense_definition": "An act of openly disregarding a law or rule.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "disregard",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blatant <w>flout</w> of the treaty led to immediate international sanctions.",
                            "target_lang_translations": {
                                "nl": "De flagrante <w>schending</w> van het verdrag leidde tot onmiddellijke internationale sancties."
                            }
                        },
                        {
                            "text": "Such a public <w>flout</w> of the court order cannot be ignored by the judge.",
                            "target_lang_translations": {
                                "nl": "Een dergelijke publieke <w>minachting</w> voor het gerechtelijk bevel kan door de rechter niet worden genegeerd."
                            }
                        }
                    ],
                    "synonyms": [
                        "violation",
                        "defiance"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Rarely used as a noun in modern English."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een daad van openlijke minachting voor een wet of regel."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "schending",
                                "target_lang_sense_clarification": "Het niet naleven van een regel of verdrag."
                            },
                            {
                                "target_lang_word": "minachting",
                                "target_lang_sense_clarification": "Het tonen van gebrek aan respect voor een autoriteit of regel."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bee288f4-6a0e-3899-9680-0b648f50c3e2",
                    "sense_definition": "A mocking remark or insult.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He endured every <w>flout</w> from his rivals with quiet dignity.",
                            "target_lang_translations": {
                                "nl": "Hij verdroeg elke <w>spotternij</w> van zijn rivalen met stille waardigheid."
                            }
                        },
                        {
                            "text": "The crowd shouted a final <w>flout</w> as the defeated leader left the stage.",
                            "target_lang_translations": {
                                "nl": "De menigte riep een laatste <w>belediging</w> toen de verslagen leider het podium verliet."
                            }
                        }
                    ],
                    "synonyms": [
                        "mockery",
                        "insult",
                        "taunt"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Used in older literary texts."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Een spottende opmerking of belediging."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "spotternij",
                                "target_lang_sense_clarification": "Het uiten van spottende opmerkingen."
                            },
                            {
                                "target_lang_word": "belediging",
                                "target_lang_sense_clarification": "Een kwetsende of spottende uitspraak."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}