                ],
                "senses": [
                    {
                        "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                        "entry_id": "a75ecebb-1a69-316f-bf0b-6d8e29c39bdf",
                        "glosses": [
                            "einfach gestaltetes Andachtsgebäude, kleines Gotteshaus am Endes eines Kreuzweges oder auch eine der 14 Stationen des Kreuzweges, die nicht für regelmäßige Gottesdienste einer Gemeinde bestimmt ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c0748d5d-4d0c-4127-bc2a-4e5a8fba769d",
                                "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                                "text": "„Im Rahmen des traditionellen Wallfahrtsfestes auf dem Rosenberg Mitte Juni hat Weihbischof Otto Georgens die neu restaurierte Kreuzwegkapelle als „geistlichen Raum der Stille“ gesegnet.“"
                            },
                            {
                                "example_id": "64e0b7d5-1164-4d91-9b4e-f0f5b851b089",
                                "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                                "text": "„Der Stationenweg zum Wallfahrtsort St. Ottilien führt vom Dreisamtal aus am Osthang des St.-Ottilien-Dobel (Musbachtal) über acht Kreuzwegkapellen steil bergan.“"
                            },
                            {
                                "example_id": "2027949f-b8e3-41ac-9b5b-a13c8046b61e",
                                "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                                "text": "„Nach Zuschüssen vom Staat haben Bertram Cremer aus Heimbach und Gabriel Marx aus Hasenfeld erst gar nicht lange gefragt, sondern sich gleich an die Renovierung der Kreuzwegkapellen unweit des Ortskerns von Mariawald in Richtung auf die Abtei gemacht.“"
                            },
                            {
                                "example_id": "648bce02-b583-4321-9579-5c43f6ee3617",
                                "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                                "text": "„Schon nach kurzer Zeit zierte die erste, zweite, dritte massiv gemauerte und mit Fresken versehene Kreuzwegkapelle den Wegesrand.“"
                            },
                            {
                                "example_id": "4d1ce236-48c7-4066-8c9b-a836b917aefd",
                                "sense_id": "ab2e8862-d4e8-3086-a6c8-88502c054c60",
                                "text": "„Im Anschluss daran fahren Sie über den Coesfelder Kreuzweg. Dieser führt Sie vorbei an zahlreichen Bildstöcken und der kleinen Kreuzwegkapelle.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
