                    }
                ],
                "senses": [
                    {
                        "sense_id": "e2a943d0-d7bd-3cb4-8157-cd500f4cf691",
                        "entry_id": "5b88ba0d-4b5d-3128-88dc-8860acbc3b46",
                        "glosses": [
                            "auf gegenüberliegender Seite des Körpers"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e39469d-0a44-40e4-932f-6d17a3f4c06d",
                                "sense_id": "e2a943d0-d7bd-3cb4-8157-cd500f4cf691",
                                "text": "„Eine kontralaterale Leistenhernie tritt nicht selten auf, sie bleibt aber oft asymptomatisch.“"
                            },
                            {
                                "example_id": "85c02394-5e77-4ad3-96c3-e7e0d4e08f80",
                                "sense_id": "e2a943d0-d7bd-3cb4-8157-cd500f4cf691",
                                "text": "„Die Symptome der langen Bahnen (je nach Höhe der Läsion Einbeziehung auch der kortikonukleären Bahnen) sind kontralateral zur Läsion ausgeprägt.“"
                            },
                            {
                                "example_id": "ce25dc95-a3f3-4668-8c71-95ddb1b7eeed",
                                "sense_id": "e2a943d0-d7bd-3cb4-8157-cd500f4cf691",
                                "text": "„Sein Ausfall hat den Verlust der wahrgenommenen feinen Sensibilität auf der kontralateralen Körperseite zur Folge, starke Berührungen und Schmerz können aber noch empfunden werden.“"
                            },
                            {
                                "example_id": "aa4397bb-88e0-4da3-9f84-d939fef8bab0",
                                "sense_id": "e2a943d0-d7bd-3cb4-8157-cd500f4cf691",
                                "text": "„Eine Hämorrhagie im Thalamus führt zu einem kontralateralen halbseitigen Sensibilitätsverlust.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
