                "senses": [
                    {
                        "sense_id": "d7becf8c-0bc4-3bfa-bc73-09763ae1085a",
                        "entry_id": "af87a05b-608c-3ee1-a7b4-c6f31f0797f7",
                        "glosses": [
                            "Gruppe von Feldtheorien, die die Prinzipien der allgemeinen Relativitätstheorie und der Supersymmetrie vereinigen"
                        ],
                        "tags": [
                            "physics"
                        ],
                        "examples": [
                            {
                                "example_id": "3f6733d8-3f1f-469e-914a-89cc67efc9b0",
                                "sense_id": "d7becf8c-0bc4-3bfa-bc73-09763ae1085a",
                                "text": "„In den 1990er Jahren stellte sich heraus, dass die bis dahin bekannten Superstringtheorien sowie die 11-dimensionale Supergravitation miteinander verbunden und Teil einer umfassenderen Theorie (M-Theorie genannt) sind, die auch höherdimensionale Objekte (sogenannte ‚Brane‘) umfasst.“"
                            },
                            {
                                "example_id": "ee909a8a-7c98-4d83-b5a6-44cfda758593",
                                "sense_id": "d7becf8c-0bc4-3bfa-bc73-09763ae1085a",
                                "text": "„Noch weist die Theorie der Supergravitation einige vielleicht entscheidende Ungereimtheiten auf, noch sind nicht alle ihre Aspekte mathematisch geprüft. Aber schon präsentieren die geistigen Väter der Supergravitation ihr Kind selbstbewußt einer breiteren Öffentlichkeit.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
