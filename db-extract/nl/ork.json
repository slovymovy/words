                "translations": [
                    {
                        "translation_id": "52943f62-9497-4148-a6a0-0686caf25c87",
                        "source_entry_id": "2b643df1-9bf6-3125-b5ef-40e293be8773",
                        "source_sense_id": "8400479c-55e4-3c2c-9d23-a96f8f001169",
                        "source_sense_description": "fictieve wezentjes die in groepsverband leven en gewoonlijk de vijand van de mensen zijn",
                        "target_lang_word": "orc",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "orc",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4730565c-28b3-3301-bbcf-e86360a5ab3a",
                                        "entry_id": "c32c76a9-1fcd-3d6d-bdcd-f6e72a0a1eae",
                                        "glosses": [
                                            "Any of several large, ferocious sea creatures, now especially the killer whale."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "orc",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c92ead05-d598-3ad5-9a0c-b8d642261713",
                                        "entry_id": "1255f14c-71a2-317d-98b6-fc4d862b4d28",
                                        "glosses": [
                                            "A mythical evil monstrous humanoid creature, usually quite aggressive and often green."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8293cb5b-df35-4386-9ef2-65e49c75bd65",
                                                "sense_id": "c92ead05-d598-3ad5-9a0c-b8d642261713",
                                                "text": "Who at one stroke didst pare away three heads from off the shoulders of an Orke, begotten by an Incubus."
                                            },
                                            {
                                                "example_id": "18cb0a65-1958-4572-88d8-ee267103c428",
                                                "sense_id": "c92ead05-d598-3ad5-9a0c-b8d642261713",
                                                "text": "The chief exploit of the hero, Beowulf the Great, is the destruction of the two monsters Grendel and his mother; both like most of the evil beings in the old times, dwellers in the fens and the waters; and both, moreover, as some Christian bard has taken care to inform us, of \"Cain's kin,\" as were also the eotens, and the elves, and the orcs (eótenas, and ylfe, and orcneas)."
                                            },
                                            {
                                                "example_id": "dd602f28-dc32-470f-84e3-d038ce67bd66",
                                                "sense_id": "c92ead05-d598-3ad5-9a0c-b8d642261713",
                                                "text": "There was a flash like flame and the helm burst asunder. The orc fell with cloven head."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "05703829-1562-3285-9aab-fb3e487a2779",
                                        "entry_id": "1255f14c-71a2-317d-98b6-fc4d862b4d28",
                                        "glosses": [
                                            "A Russian soldier or gangster."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fd6f1861-5a31-4871-9693-a54776334c4e",
                                                "sense_id": "05703829-1562-3285-9aab-fb3e487a2779",
                                                "text": "Ukrainians themselves, including those on the right, preferred to call the events the 'Revolution of Dignity', depicted not in terms of ethnicity or class, but in simple civic black and white – a revolution of the people against Yanukovych's 'Mordor' and his 'Orcs'."
                                            },
                                            {
                                                "example_id": "ed3fc3d8-bc28-49a7-9eda-a5eb28d9f4dd",
                                                "sense_id": "05703829-1562-3285-9aab-fb3e487a2779",
                                                "text": "And now we must watch the old world go up in flames, in the mad spectacle of Putin’s orcs descending upon Kyiv to execute his macabre plan."
                                            },
                                            {
                                                "example_id": "7532e431-17a5-4995-bd3c-461ff73fed9a",
                                                "sense_id": "05703829-1562-3285-9aab-fb3e487a2779",
                                                "text": "Plenty of Belarusian exiles have gone to Europe, but if you run West, then the Orcs [a Ukrainian slang term for \"Russian soldiers\"] will just follow you there. It's better to risk your life as a free person than to keep running."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd177a0b-a8b9-3eff-a1e1-fd9e64b2e60a",
                                        "entry_id": "1255f14c-71a2-317d-98b6-fc4d862b4d28",
                                        "glosses": [
                                            "A Russian person."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly",
                                            "ethnic",
                                            "slur"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
