                "senses": [
                    {
                        "sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                        "entry_id": "2fef2fff-2eb2-3eb3-9f44-238743da2c7f",
                        "glosses": [
                            "Forme de cicatrice résultant d’une excroissance du derme au niveau d’une blessure guérie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "06325e52-0d69-4db4-9fbb-0309daf60d31",
                                "sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                                "text": "Nous avons vu disparaître par ce procédé des chéloïdes prépectorales qui avaient résisté pendant des années à tous les autres traitements."
                            },
                            {
                                "example_id": "fd4f51ae-006e-4fed-b827-78e4a88c7e3f",
                                "sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                                "text": "Au modèle subtil de ce masque tribal viennent se conjuguer les cicatrices chéloïdes, ndoma, caractéristiques de l'ethnie baoulé"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "72b4f3ca-12a4-4b55-a533-9c6dd29b50b5",
                        "source_entry_id": "2fef2fff-2eb2-3eb3-9f44-238743da2c7f",
                        "source_sense_id": "7d6fef7e-566e-31d8-8bd3-642d0cbe41d2",
                        "target_lang_word": "Keloid",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Keloid",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0686f444-bcd1-3c13-af01-a9768f49ecbe",
                                        "entry_id": "9afcc784-9eec-3746-b3d6-75629bfe26f9",
                                        "glosses": [
                                            "durch überschießendes Wachstum von Fibroblasten entstehender, das Hautniveau überragender gutartiger Tumor, der nach Verletzungen, Operationen oder auch als Spontankeloid auftreten kann"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c48e6caf-2615-4c19-ac14-34dda9ea4ce9",
                                                "sense_id": "0686f444-bcd1-3c13-af01-a9768f49ecbe",
                                                "text": "„Fukuhara hat noch heute entstellende Narbenwucherungen, sogenannte Keloide, die zum Inbegriff des Schicksals der Atombombenopfer wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "769ec6a6-cd87-46cd-beed-be36972147d0",
                        "source_entry_id": "2fef2fff-2eb2-3eb3-9f44-238743da2c7f",
