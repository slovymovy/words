                    "sense_id": "017b1a50-65af-320a-8d44-3a6bbccbeb85",
                    "sense_definition": "Een bepaald gebied of een bepaalde afstand beslaan of omvatten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "omvatten",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Europa <w>bestrijkt</w> een gebied van meer dan tien miljoen vierkante kilometer.",
                            "target_lang_translations": {
                                "en": "Europe <w>covers</w> an area of more than ten million square kilometers."
                            }
                        },
                        {
                            "text": "Het onderzoek <w>bestrijkt</w> een periode van tien jaar.",
                            "target_lang_translations": {
                                "en": "The research <w>spans</w> a period of ten years."
                            }
                        }
                    ],
                    "synonyms": [
                        "omvatten",
                        "beslaan"
                    ],
                    "common_phrases": [
                        "een gebied bestrijken",
                        "een periode bestrijken"
                    ],
                    "target_lang_definitions": {
                        "en": "To cover, span, or include a certain area, distance, or period of time."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "to cover",
                                "target_lang_sense_clarification": "Used for areas, distances, or time spans."
                            },
                            {
                                "target_lang_word": "to span",
                                "target_lang_sense_clarification": "Used for time periods or physical distances."
                            },
                            {
                                "target_lang_word": "to encompass",
                                "target_lang_sense_clarification": "Used for including a wide range or area."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c9323257-e75c-3649-bd87-59c2910a194e",
                    "sense_definition": "Met een strijkende beweging een laag van iets op een oppervlak aanbrengen.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "smeren",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De kok <w>bestrijkt</w> het gebak met een dun laagje glazuur.",
                            "target_lang_translations": {
