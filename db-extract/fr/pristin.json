                                        "sense_id": "987d0941-8c31-3a3c-95ac-21203ad06754",
                                        "entry_id": "383c7242-3396-3489-ae00-63c7370616f4",
                                        "glosses": [
                                            "Primitive, pertaining to the earliest state of something."
                                        ],
