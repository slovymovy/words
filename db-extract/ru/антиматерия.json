                "translations": [
                    {
                        "translation_id": "70d3baf8-d913-4248-8af5-ef61a9a96da2",
                        "source_entry_id": "44e9d10e-33e5-3463-81d4-e8fac3521e5c",
                        "source_sense_id": "478ba527-54d1-3c64-9308-e73ea2d67d00",
                        "target_lang_word": "antimatter",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "antimatter",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "585631c0-b6ba-3260-be6f-0c1d3320fd68",
                                        "entry_id": "d8a401a0-985e-3ac4-9e23-e0aa2af7f37f",
                                        "glosses": [
                                            "Matter that is composed of the antiparticles of those that constitute normal matter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c72cbaf5-3839-4cc6-be38-ea4dbc36fa0b",
                                                "sense_id": "585631c0-b6ba-3260-be6f-0c1d3320fd68",
                                                "text": "But most theories predict that equal amounts of matter and antimatter should have been produced during the big bang, and the mystery of what happened to all the antimatter is a central question in fundamental physics."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be0d928a-8a82-3433-9745-7052435cd6bd",
                                        "entry_id": "d8a401a0-985e-3ac4-9e23-e0aa2af7f37f",
                                        "glosses": [
                                            "A form of matter that has a key property, such as charge, opposite to that of ordinary matter."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4ed13e5-944e-4eec-9170-8529a592f900",
                                                "sense_id": "be0d928a-8a82-3433-9745-7052435cd6bd",
                                                "text": "Particles of matter and antimatter are identical, except for an opposite electrical charge. An electron has a negative charge whereas its antiparticle, the positron, has a positive charge, and both have an identical mass."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
