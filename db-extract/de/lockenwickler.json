                        ],
                        "form": "die Lockenwickler"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                        "entry_id": "adae42cf-daa8-323d-92b2-7ac25b64e0d6",
                        "glosses": [
                            "kleine Rolle, um die eine Haarsträhne gewickelt wird, die dann nach dem Trocknen lockig ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b03cd220-5515-46d0-bb30-fad768cebd16",
                                "sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                                "text": "Als sie dem Postboten die Tür öffnete, trug sie noch ihren Morgenmantel und Lockenwickler auf dem Kopf."
                            },
                            {
                                "example_id": "7abaf18a-276d-4705-8437-8bafdab11ff6",
                                "sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                                "text": "„Meistens trägt sie Lockenwickler, als wollte sie uns allen zeigen, daß sie, eine alte Frau, längst noch nicht resigniert hat.“"
                            },
                            {
                                "example_id": "943d7583-f0fe-4d27-bec2-99b8c8d18b26",
                                "sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                                "text": "„Ihr Haar war mit Lockenwicklern aus Draht und Metall wie mit kleinen deutschen Handgranaten bestückt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "97e31c09-09e5-4919-b852-131fe5009a2e",
                        "source_entry_id": "adae42cf-daa8-323d-92b2-7ac25b64e0d6",
                        "source_sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                        "source_sense_description": "kleine Rolle, um die eine Haarsträhne gewickelt wird, die dann nach dem Trocknen lockig ist",
                        "target_lang_word": "curler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "curler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b09fe935-f1f3-3582-b236-ac84b99a5fd0",
                                        "entry_id": "39b95075-d55e-3112-aefa-3accd32cf0f8",
                                        "glosses": [
                                            "One of a set of small cylindrical tubes used to curl hair."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5fc0eea-a8db-4d35-966e-e11fc3aea7d7",
                                                "sense_id": "b09fe935-f1f3-3582-b236-ac84b99a5fd0",
                                                "text": "Waiting for a girl who's got curlers in her hair / Waiting for a girl, she has no money anywhere"
                                            },
                                            {
                                                "example_id": "4c70573e-6175-4d8d-a5da-7e4124c267bb",
                                                "sense_id": "b09fe935-f1f3-3582-b236-ac84b99a5fd0",
                                                "text": "There was also hairdressing: hairdressing, too, really was hairdressing in those times — no running a comb through it and that was that. It was curled, frizzed, waved, put in curlers overnight, waved with hot tongs;[…]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "806389d2-8b4c-322a-9260-a81494eb9965",
                                        "entry_id": "39b95075-d55e-3112-aefa-3accd32cf0f8",
                                        "glosses": [
                                            "A sportsman who plays curling."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "dfc82c88-a13e-326e-97ee-61873d1dff09",
                                        "entry_id": "39b95075-d55e-3112-aefa-3accd32cf0f8",
                                        "glosses": [
                                            "A pass or a shot of the ball which swerves."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "207ca68d-a2d1-4233-bed7-b6fe523ec236",
                                                "sense_id": "dfc82c88-a13e-326e-97ee-61873d1dff09",
                                                "text": "The captain sent a curler into the top corner of the net."
                                            },
                                            {
                                                "example_id": "c0223d36-8a4d-4d19-a517-b2dd2feaa0d5",
                                                "sense_id": "dfc82c88-a13e-326e-97ee-61873d1dff09",
                                                "text": "Lampard was replaced by Kalou but the substitute immediately gave the ball to Jonas, whose 25-yard curler was tipped wide by Cech."
                                            },
                                            {
                                                "example_id": "cc155799-e287-4ff5-a313-a55af0c126bc",
                                                "sense_id": "dfc82c88-a13e-326e-97ee-61873d1dff09",
                                                "text": "Liverpool were energised at the start of the second half, with ­Curtis Jones shaping a curler just past the far post."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d11b31ad-7438-3a51-973d-2de493e209c3",
                                        "entry_id": "39b95075-d55e-3112-aefa-3accd32cf0f8",
                                        "glosses": [
                                            "A wave which breaks with a barrel"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8dc10204-8a06-4486-b54b-6964702b7284",
                                                "sense_id": "d11b31ad-7438-3a51-973d-2de493e209c3",
                                                "text": "Oft considered the most even playing field on which to measure surf mastery, Slater’s innovative machine is a barrel-synthesizing environment and engineering feat. In a single round, The Wave produces a 6-foot curler capable of traveling 2,300 feet for up to one gnarly minute."
                                            },
                                            {
                                                "example_id": "e4c63c0e-7036-4e7b-9db1-1ea943e4f557",
                                                "sense_id": "d11b31ad-7438-3a51-973d-2de493e209c3",
                                                "text": "There’s the mesmeric, thrumming beat. (Sound very much “on” for this one.) Dark purples and roiling seas under heavy storms. Then Manuel, barreling perfect curler after perfect curler."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9d622d15-a9e5-4d83-a060-1df993c0c040",
                        "source_entry_id": "adae42cf-daa8-323d-92b2-7ac25b64e0d6",
                        "source_sense_id": "e0ca2d5c-e78f-3fe1-86e3-8f3aab2158a9",
                        "source_sense_description": "kleine Rolle, um die eine Haarsträhne gewickelt wird, die dann nach dem Trocknen lockig ist",
                        "target_lang_word": "bigoudi",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bigoudi",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                        "entry_id": "35ab7846-fa17-36f1-97b6-4f1547ee7337",
                                        "glosses": [
                                            "Ustensile de coiffure constitué d’un tube qu’on enroule dans les cheveux pour les faire friser."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "449e32b5-7c1f-45e1-bfaa-a9c70c501bc9",
                                                "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                                "text": "La porte intérieure était restée entrouverte. Derrière, dans l’obscurité, il vit une femme qui venait le regarder, une maigre, d’une quarantaine d’années qui avait déjà fait ses bigoudis pour la nuit."
                                            },
                                            {
                                                "example_id": "68b0ae9c-9af7-44a3-97e8-7d42341939e4",
                                                "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                                "text": "Elle l’humectait avec de l’Oréal. Elle le groupait en mèches. Elle enveloppait chaque mèche d’un papier. Elle l’enroulait autour d’un bigoudi. La 5 345 me montrait le bigoudi avec respect. Avec son élastique, il avait l’air de l’arc des indiens Jivaros, qui lance des flèches au curare."
                                            },
                                            {
                                                "example_id": "957fc8cb-9e45-40ed-b56f-de81974ef8f2",
                                                "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                                "text": "27 juin 1941 – Mais en même temps, j’ai un peu peur de la cohabitation. C’est peut-être un peu trop de se voir toute la journée, de la belle aube en bigoudis, au triste soir… en bigoudis."
                                            },
                                            {
                                                "example_id": "204c1247-5d8b-49f0-9e5f-c9b1d9b1ac55",
                                                "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                                "text": "Jimi ne possédait que sa guitare, quelques vêtements, un tube de crème pour son acné et des bigoudis en plastique rose pour ses cheveux."
                                            },
                                            {
                                                "example_id": "789957c1-9244-4018-81d2-474f3db67000",
                                                "sense_id": "8f5fa14b-b98f-305a-8f88-5163432a5df5",
                                                "text": "Elle était en pantoufles et avait des bigoudis plein les cheveux. Les bigoudis, ça ne trompait pas. C’était la première chose qu’on apprenait en entrant dans la police : les femmes assez à l’aise pour sortir avec des bigoudis plein les cheveux étaient les premières à vous déballer la vie de tout le voisinage. Des témoins précieux, les femmes aux bigoudis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92828f37-eec5-314c-9460-05d5345a5453",
                                        "entry_id": "35ab7846-fa17-36f1-97b6-4f1547ee7337",
                                        "glosses": [
                                            "Sexe masculin."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b411f51b-c9a3-487c-8fd4-dce9d95fb5a9",
                                                "sense_id": "92828f37-eec5-314c-9460-05d5345a5453",
                                                "text": "Je sentis les larmes monter, j’y tenais à mon cher zizi surtout depuis que je savais qu’il réagissait si agréablement quand Ginette me bouchonnait. Je lui posais la question d’une voix tremblante « Vous allez nous le couper m’sieur ? On n’a rien fait de mal. » Ils se remirent à rire, mais lui enchaîna « Fais le voir ton bigoudi … »"
                                            },
                                            {
                                                "example_id": "1fffbe05-5147-4dce-a046-9383be1e6ea7",
                                                "sense_id": "92828f37-eec5-314c-9460-05d5345a5453",
                                                "text": "Le garçon retira son jean et son caleçon, protégeant ses parties avec ses mains.\n– Tu crois que j’en ai quelque chose à foutre de ton bigoudi ?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
