                                        "sense_id": "1c98dd99-6a5e-3f50-abe2-90d2f66e0109",
                                        "entry_id": "d0b9342b-9c1b-32ee-9d77-a264b8d0ce65",
                                        "glosses": [
                                            "To reduce in size, force, value, amount, or degree."
