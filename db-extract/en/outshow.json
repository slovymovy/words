                        "sense_id": "773719a2-b0a2-30c2-a6a9-430355546471",
                        "entry_id": "e538354d-fa2a-33cf-b348-72c3a08613a5",
                        "glosses": [
                            "To show or present publicly; exhibit openly."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "890120a7-08e0-48ae-ba4d-0d0ee3f55c93",
                                "sense_id": "773719a2-b0a2-30c2-a6a9-430355546471",
                                "text": "He blushed to see another Sun below, / Ne durst again his fiery face outshow."
                            },
                            {
                                "example_id": "de773c24-84f7-42b8-8861-bb01cc89bbf2",
                                "sense_id": "773719a2-b0a2-30c2-a6a9-430355546471",
                                "text": "And yet the king did all their lookes outshow."
                            }
                        ]
                    },
                    {
                        "sense_id": "68b6c6c7-e0ee-3266-9a5e-cc756ff26db2",
                        "entry_id": "e538354d-fa2a-33cf-b348-72c3a08613a5",
                        "glosses": [
                            "To surpass or exceed in showing; exceed in being shown, especially in contest, competition, or rivalry."
                        ],
                        "tags": [
                            "transitive"
                        ],
                        "examples": [
                            {
                                "example_id": "a2602205-1b46-4068-b30d-4b2fcdc4329b",
                                "sense_id": "68b6c6c7-e0ee-3266-9a5e-cc756ff26db2",
                                "text": "Mazurka 13th, now owned by Mr. Streator, at ten years old Is dam of eight living calves at single births, and we don't know a cow of her age that can outshow her."
                            },
                            {
                                "example_id": "0c70953f-67f2-4757-99e9-d744ff05e951",
                                "sense_id": "68b6c6c7-e0ee-3266-9a5e-cc756ff26db2",
                                "text": "Surely it is not vainglory nor a desire simply to outshow other nations which lead to the enormous expenditures involved in every international exposition."
                            }
                        ]
                    }
