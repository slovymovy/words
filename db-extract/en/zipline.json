                    },
                    {
                        "translation_id": "869bd8fe-75da-44ec-956e-5490720030f5",
                        "source_entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                        "source_sense_description": "pulley suspended on a cable",
                        "target_lang_word": "tokkelbaan",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tokkelbaan",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "2bf23f39-c5ff-30bb-a41c-bf8718fb6623",
                                        "entry_id": "0797594b-fef9-3386-a14a-33b1c8f3611e",
                                        "glosses": [
                                            "schuin gespannen kabel waarlangs men als vermaak aan een katrol met enige vaart omlaag glijdt van een hoger punt naar een lager punt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59295c3d-bb89-4bc6-be70-3e1d3e62428f",
                                                "sense_id": "2bf23f39-c5ff-30bb-a41c-bf8718fb6623",
                                                "text": "Op die plek, een voorheen met hekken omheind stuk niets, glijden nu tieners van een gloednieuwe tokkelbaan en ligt een vrouw op een houten bed te zonnen."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d0fd4d52-4260-458b-937c-0f4fb8cadf9c",
                        "source_entry_id": "cb6f6dfb-ae02-36ce-adfc-32ca22da4978",
                        "source_sense_description": "pulley suspended on a cable",
                        "target_lang_word": "tyrolienne",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tyrolienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e02365ec-2b11-32b0-92a3-4a2cf0ccf26f",
                                        "entry_id": "2109b6d1-8e86-313b-977b-a98a5f520c5c",
                                        "glosses": [
                                            "Sorte de chanson des zones alpines. → voir yodler"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "61bd6e2b-53a8-4773-b025-c2a954a53f5b",
                                                "sense_id": "e02365ec-2b11-32b0-92a3-4a2cf0ccf26f",
                                                "text": "C'est une yodleuse savoyarde qui pousse la tyrolienne à la perfection."
                                            },
                                            {
                                                "example_id": "768a8d98-81b3-4f32-bbc5-92e990bebc18",
                                                "sense_id": "e02365ec-2b11-32b0-92a3-4a2cf0ccf26f",
                                                "text": "Le duo se terminait par une tyrolienne bouffonne, que Prullière enleva très drôlement, d’une voix de matou irrité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2eb39418-e777-3314-9ea1-b653d69d9a04",
                                        "entry_id": "2109b6d1-8e86-313b-977b-a98a5f520c5c",
                                        "glosses": [
                                            "Machine à crépir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58904f07-60fb-46aa-9868-212100b9434c",
                                                "sense_id": "2eb39418-e777-3314-9ea1-b653d69d9a04",
                                                "text": "A la fin de la journée, la tyrolienne pèse lourd!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "14d4f3dd-396b-3956-a36d-f84ec59ab62c",
                                        "entry_id": "2109b6d1-8e86-313b-977b-a98a5f520c5c",
                                        "glosses": [
                                            "Moyen de transport utilisant une poulie qui se déplace sur un câble ou une corde."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cb04d0d8-a846-455a-abe1-807c24b5537f",
                                                "sense_id": "14d4f3dd-396b-3956-a36d-f84ec59ab62c",
                                                "text": "Durant ce séjour, diverses activités leur ont été proposées : via ferrata et tyrolienne au fort de Bertheaume, escape game, chasse au trésor, veillée loup-garou, ou encore une soirée à la fête foraine locale."
                                            },
                                            {
                                                "example_id": "10f330f5-5a6e-401e-a75f-6eb1cdaefe76",
                                                "sense_id": "14d4f3dd-396b-3956-a36d-f84ec59ab62c",
                                                "text": "Il est possible de pratiquer la tyrolienne en hiver aussi."
                                            },
                                            {
                                                "example_id": "6fe0fc11-e8d5-4622-9a0e-fe485b561152",
                                                "sense_id": "14d4f3dd-396b-3956-a36d-f84ec59ab62c",
                                                "text": "D’ici, une traversée en tyrolienne permet d’enjamber une grande faille et d’atterrir au quatrième clocheton."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "tyrolienne",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "63a44634-65a8-32ee-938b-6a98402c505e",
                                        "entry_id": "4232c736-d8a0-370b-a8e0-35e839f76931",
                                        "glosses": [
                                            "Féminin singulier de tyrolien."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d083763e-8c67-4a09-b1ca-72479ffc9d15",
                                                "sense_id": "63a44634-65a8-32ee-938b-6a98402c505e",
                                                "text": "Kitzbühel est sans doute l’une des plus célèbres stations de sports d’hiver tyroliennes."
                                            },
                                            {
                                                "example_id": "a6b58d9e-46dc-4853-a6c0-28eca4cf9406",
                                                "sense_id": "63a44634-65a8-32ee-938b-6a98402c505e",
                                                "text": "Les tables de bois, tyroliennes encore par leur forme, deviennent péninsulaires quand y paraît, salué par des cris de joie, un plat fumant de spaghetti all’Amatriciana."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
