                "senses": [
                    {
                        "sense_id": "2341731f-353d-34bf-8e6e-c6b34131fa90",
                        "entry_id": "c360d3ba-5081-3ee6-a6d0-57b7ba3a9270",
                        "glosses": [
                            "(zumeist elektrisches) Küchengerät zum Vermischen oder Aufschlagen von Flüssigkeiten oder zähflüssigen Massen (wie zum Beispiel Teig), das bei der Bedienung in der Hand gehalten wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0fe1396-9220-45c4-8577-6587ca7d56c3",
                                "sense_id": "2341731f-353d-34bf-8e6e-c6b34131fa90",
                                "text": "„Besonders attraktiv sind die Etagen Eins und Vier, wo herausragende Beispiele für katalanisches Produkt- und Grafikdesign gezeigt werden. Charmant wirken der Handmixer (Gabriel Lluelles), die Stehlampe (Miguel Milá) oder die Eiswürfelzange (André Ricard) aus den 1960er-Jahren.“"
                            },
                            {
                                "example_id": "0d5883e7-3f14-43bd-8bf0-c9ec4171d8c5",
                                "sense_id": "2341731f-353d-34bf-8e6e-c6b34131fa90",
                                "text": "„Denn erfahrungsgemäss begleitet einen ein Handmixer für viele Jahre und ein guter muss, wie der Test zeigt, nicht viel kosten.“"
                            },
                            {
                                "example_id": "e151cfca-458d-4bf9-84ab-bf514b403a40",
                                "sense_id": "2341731f-353d-34bf-8e6e-c6b34131fa90",
                                "text": "„Beim Handmixer werden die Rührbesen von einem Schneckengetriebe bewegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
