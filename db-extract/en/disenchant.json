                "translations": [
                    {
                        "translation_id": "26f31322-815c-4a6a-ba47-4e9873466500",
                        "source_entry_id": "7ce146bc-b538-3f60-87cd-4a7c65cccc3d",
                        "source_sense_description": "To free from illusion, false belief or enchantment; to undeceive or disillusion",
                        "target_lang_word": "desillusioneren",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "desillusioneren",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "33c50854-f905-31ed-ae60-da2cfc6b7cfc",
                                        "entry_id": "cc434986-24c3-342c-8f86-150d3e7727b4",
                                        "glosses": [
                                            "laten kwijtraken van (al te hoog gespannen) verwachtingen, doen verliezen van hoop"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "161afcb9-ca59-4664-8c3c-6b0424dbcaca",
                                                "sense_id": "33c50854-f905-31ed-ae60-da2cfc6b7cfc",
                                                "text": "De EU kan zich volgens de EBRD niet permitteren de toetreding van de verst gevorderde economieën te lang na 2004 uit te stellen. Dat kost geloofwaardigheid en zou Oost-Europa desillusioneren. Ook moet de EU actief betrokken blijven bij de hervorming van het GOS. \"We moeten niet het IJzeren Gordijn vervangen door een gordijn van Brusselse kant\", aldus Buiter."
                                            },
                                            {
                                                "example_id": "e9d6b3f8-1948-4a94-93d3-94ed28785948",
                                                "sense_id": "33c50854-f905-31ed-ae60-da2cfc6b7cfc",
                                                "text": "Toen ik ook daar geen succes had, zocht ik weer een andere plek op maar de vissen bleven vrolijk om mijn haak heen zwemmen. Gedesillusioneerd rolde ik mijn vislijn weer op en borg het haakje weer veilig weg. ‘En?’ vroeg Jesus toen ik de groep weer opzocht. Ik schudde mijn hoofd en liet mijn lege handen zien."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "85fd6895-4efc-400a-8958-05c84e250cd6",
                        "source_entry_id": "7ce146bc-b538-3f60-87cd-4a7c65cccc3d",
                        "source_sense_description": "To free from illusion, false belief or enchantment; to undeceive or disillusion",
                        "target_lang_word": "désenchanter",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désenchanter",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "735c2fe6-e267-3195-8cf2-11522ee933fc",
                                        "entry_id": "1d54440b-68b3-3203-ab2e-4b1dcc6397d5",
                                        "glosses": [
                                            "Faire cesser d’être sous l’emprise d’un enchantement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ea9eab6a-e875-42e1-a5f6-45eea41f7cb1",
                                                "sense_id": "735c2fe6-e267-3195-8cf2-11522ee933fc",
                                                "text": "Les sorciers passaient pour avoir le pouvoir d’enchanter et de désenchanter."
                                            },
                                            {
                                                "example_id": "05552b64-a049-4821-80c7-5811bb784347",
                                                "sense_id": "735c2fe6-e267-3195-8cf2-11522ee933fc",
                                                "text": "Que veut dire désenchanter ?\nSoustraire à la puissance du chant. Arracher l’enchanté à l’obéissance maléficiante. Exorciser l’esprit mauvais, le mal qui est la souillure de la mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8227d68a-4951-322d-a777-010efec9a746",
                                        "entry_id": "1d54440b-68b3-3203-ab2e-4b1dcc6397d5",
                                        "glosses": [
                                            "Guérir d’une passion, d’un engouement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7ba3cc07-6592-4381-9c79-bf977ad3f789",
                                                "sense_id": "8227d68a-4951-322d-a777-010efec9a746",
                                                "text": "Mais la mort a de la coquetterie pour les jeunes gens ; pour eux, elle s'avance et se retire, se montre et se cache ; sa lenteur les désenchante d'elle, …"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7e471529-d1c6-3769-ac97-cb43c07f5296",
                                        "entry_id": "1d54440b-68b3-3203-ab2e-4b1dcc6397d5",
                                        "glosses": [
                                            "Faire perdre les illusions sur quelqu’un."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "pronominal"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "918f67af-3104-3857-b0fc-a080766124bc",
                                        "entry_id": "1d54440b-68b3-3203-ab2e-4b1dcc6397d5",
                                        "glosses": [
                                            "Priver quelqu’un des goûts, des sentiments, des illusions qui charmaient sa vie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01090fa8-f4ce-499e-8a20-decc66f76e59",
                                                "sense_id": "918f67af-3104-3857-b0fc-a080766124bc",
                                                "text": "Cette triste expérience l’a laissé tout désenchanté. - Dès sa jeunesse, il était déjà désenchanté de tout."
                                            },
                                            {
                                                "example_id": "a90234ed-2124-4d08-a91a-53ec7bbec655",
                                                "sense_id": "918f67af-3104-3857-b0fc-a080766124bc",
                                                "text": "Ainsi que notre correspondance naguère gâta notre revoir de l’automne, le souvenir de ta présence d’hier désenchante ma lettre d’aujourd’hui."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "73171f1b-9afa-44f3-a6fa-fa106cbba6a9",
                        "source_entry_id": "7ce146bc-b538-3f60-87cd-4a7c65cccc3d",
                        "source_sense_description": "To free from illusion, false belief or enchantment; to undeceive or disillusion",
                        "target_lang_word": "desillusionieren",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
