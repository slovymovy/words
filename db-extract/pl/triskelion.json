                                        "glosses": [
                                            "Symbol in Form von drei radialsymmetrisch angeordneten und sich in der Mitte berührenden Formen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9dbe9884-b87c-4bd6-8141-c5f87a6770e3",
                                                "sense_id": "b5a7735f-e792-3f80-8d48-0f8819ae361d",
                                                "text": "\"Triskele: Das ursprünglich keltische Symbol gibt es sowohl in geschwungener als auch in eckiger Darstellung (Abbildung). Letztere Version ist in der rechtsextremen Szene verbreitet, weil sie als dreiarmiges Hakenkreuz gelesen werden kann.\""
                                            },
                                            {
                                                "example_id": "c188d565-9986-4a32-9164-88242254939f",
                                                "sense_id": "b5a7735f-e792-3f80-8d48-0f8819ae361d",
                                                "text": "„Das Motiv ist das Wappen des Königs mit einem sich aufbäumenden Pferd und einer sogenannten Triskele aus Menschenbeinen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
