                        "form": "most cultural"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e982f640-6377-361c-a950-7ea8ccf5d9c3",
                        "entry_id": "67ea296e-3fff-3c22-8042-f293021def21",
                        "glosses": [
                            "kulturell"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "137979b5-dc77-4a12-bd48-fdb922966683",
                                "sense_id": "e982f640-6377-361c-a950-7ea8ccf5d9c3",
                                "text": "„For all of the 20th century Iraq was regarded as the cultural hub for the Arab world.“",
                                "translation": "Im gesamten 20. Jahrhundert wurde der Irak als das kulturelle Zentrum der arabischen Welt betrachtet."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "21f6b1a8-e048-413c-95ce-0869779da1e0",
                        "source_entry_id": "67ea296e-3fff-3c22-8042-f293021def21",
                        "source_sense_id": "e982f640-6377-361c-a950-7ea8ccf5d9c3",
                        "source_sense_description": "kulturell",
                        "target_lang_word": "kulturell",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulturell",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                        "entry_id": "0c0dc6ea-2832-380f-94bd-4302df003e35",
                                        "glosses": [
                                            "die Kultur betreffend, von Kultur geprägt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e325c7e0-706a-419c-b53f-376e9ae84510",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "Museen sind kulturell bedeutsame Einrichtungen."
                                            },
                                            {
                                                "example_id": "51fbda00-2bbd-48d7-b2ea-d18dff9196f9",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Noch stärker als bisher müssen Sprachwissenschaft und Sprachdidaktik dazu beitragen, die mit kultureller Diversität und intrakulturellen Sprachdifferenzen verbundenen gesellschaftlichen Herausforderungen zu gestalten.“"
                                            },
                                            {
                                                "example_id": "15861811-8cd1-416a-9766-4d6e4d4b64a3",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Die islamische Geschichtsschreibung dagegen beschreibt Mahmud als den Begründer einer kulturellen Hochphase.“"
                                            },
                                            {
                                                "example_id": "a4ee1504-89e3-4734-b633-be5893c2f455",
                                                "sense_id": "103fec0e-af40-3a88-bce1-09d385dc2b76",
                                                "text": "„Religiöse Feste oder Bräuche wie Weihnachten oder Ramadan sind kulturelle Phänomene – von Menschen für Menschen gemacht.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "141e7c2c-5b25-4807-b164-5e2d0fbe5244",
                        "source_entry_id": "67ea296e-3fff-3c22-8042-f293021def21",
                        "source_sense_id": "e982f640-6377-361c-a950-7ea8ccf5d9c3",
                        "source_sense_description": "kulturell",
                        "target_lang_word": "culturel",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culturel",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "78eda046-66dd-3bad-8e32-fbe1804b607a",
                                        "entry_id": "008e33cb-5e3b-3b63-bdc7-9de74855820c",
                                        "glosses": [
                                            "Relatif à la culture."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9ea7306b-51ca-4d33-8306-a9554d296f29",
                                                "sense_id": "78eda046-66dd-3bad-8e32-fbe1804b607a",
                                                "text": "La question soulevée par Hoffman est plutôt celle de l’effondrement des barrières entre les sphères économiques, politiques et culturelles avec la militarisation de la vie elle-même."
                                            },
                                            {
                                                "example_id": "95236684-07f3-468c-9d78-ea0a51299772",
                                                "sense_id": "78eda046-66dd-3bad-8e32-fbe1804b607a",
                                                "text": "Respect inspiré par Godard et Duras. Est culturel ce qui provoque le respect. Aucun respect pour Bourvil, Fernandel autrefois, pour Coluche naguère. La mort rend aussi culturel."
                                            },
                                            {
                                                "example_id": "79eca3a3-51be-4a8b-b699-fff7c39cfb88",
                                                "sense_id": "78eda046-66dd-3bad-8e32-fbe1804b607a",
                                                "text": "Pour des raisons culturelles, les légumes et la farine n'étaient pas vendus dans le souq. Les légumes étaient des produits considérés comme superflus."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ccf1871b-f8f3-373a-ba6e-2a6bb834d353",
                                        "entry_id": "008e33cb-5e3b-3b63-bdc7-9de74855820c",
                                        "glosses": [
                                            "Relatif à l’industrie du même nom."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e446559a-2b39-4f0b-b309-36173413f155",
                                                "sense_id": "ccf1871b-f8f3-373a-ba6e-2a6bb834d353",
                                                "text": "S'il est un domaine dans lequel la Cinquième a tenu à se distinguer, à nous distinguer du « reste du monde », c'est bien celui de l'action culturelle. La culture comme exception par la place qu'elle tient dans les préoccupations de la République, mais aussi et surtout comme arme de « résistance »."
                                            },
                                            {
                                                "example_id": "12faaa20-2608-4c5f-a028-55fae5b3989a",
                                                "sense_id": "ccf1871b-f8f3-373a-ba6e-2a6bb834d353",
                                                "text": "Mission : pré-sélectionner un roman de langue française dans le cadre d'un prestigieux concours littéraire international. Entourés de vestons-cravates, Girard et moi détonnions dans nos vestes de denim fatiguées, arborées comme par défi à la barbe de cet obscur aréopage de diplomates culturels à la solennité empesée."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
