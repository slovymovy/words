                "senses": [
                    {
                        "sense_id": "f2a3e533-e5c7-3294-bf0f-620e244f4bc7",
                        "entry_id": "c162b39b-478f-322d-a9c4-56846d425ebf",
                        "glosses": [
                            "Qui exhale une odeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2ea3a3bf-cc5e-4fc7-8e45-11d8ee0e49b0",
                                "sense_id": "f2a3e533-e5c7-3294-bf0f-620e244f4bc7",
                                "text": "Cette opération, qui se fait dans un appareil analogue à l'appareil distillatoire, est fondée sur la différence de volatilité de l'alcool et des huiles odorantes qui ne bouillent, en général, qu'à des températures bien supérieures à 100°."
                            },
                            {
                                "example_id": "613a779e-ec9d-4d3c-9cdb-be532d794e1b",
                                "sense_id": "f2a3e533-e5c7-3294-bf0f-620e244f4bc7",
                                "text": "Dans certains cas la plante fait elle-même l’hydrolyse et utilise le sucre libéré. Le produit terpénique s’accumule alors et la plante devient odorante."
                            }
                        ]
                    },
                    {
                        "sense_id": "b1abc59b-8afa-311c-9f04-6e000996fd2c",
                        "entry_id": "c162b39b-478f-322d-a9c4-56846d425ebf",
                        "glosses": [
                            "Qui répand une bonne odeur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77388ed8-d4dd-40c8-8247-7e1f72b1ad07",
                                "sense_id": "b1abc59b-8afa-311c-9f04-6e000996fd2c",
                                "text": "[Bois] de palixandre ou violet, arbre des Indes à bois odorant pour la marqueterie."
                            },
                            {
                                "example_id": "52976402-7376-45db-bb02-e5f1c7110d12",
                                "sense_id": "b1abc59b-8afa-311c-9f04-6e000996fd2c",
                                "text": "Ses temples hindous, ses frangipaniers aux fleurs odorantes, ses rizières en terrasse dont le système d’irrigation est classé au patrimoine mondial de l’Unesco… mais aussi ses embouteillages, ses plages bondées et ses millions de visiteurs aux épaules rougies par le soleil."
                            },
                            {
                                "example_id": "d241dcc5-83de-4a39-8abc-7457a853eb83",
                                "sense_id": "b1abc59b-8afa-311c-9f04-6e000996fd2c",
                                "text": "La mystique du oud tient à son origine, résine odorante secrétée en leur cœur par des arbres se défendant contre une infection."
                            }
                        ]
                    }
                ],
