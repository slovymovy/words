                "senses": [
                    {
                        "sense_id": "1fe47bf9-a4d1-34c0-8302-fbe619384622",
                        "entry_id": "af3d3c0a-31fc-3b40-8d40-30eb2b8f040d",
                        "glosses": [
                            "kleine Lutschtablette, kleines Bonbon mit dem Aroma von Veilchen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1bd8cf8-a37e-4fa5-8efd-439653645a46",
                                "sense_id": "1fe47bf9-a4d1-34c0-8302-fbe619384622",
                                "text": "„Er sah sie an. Dann griff er in seine Jackentasche und holte eine kleine Emaildose heraus. Ohne den Blick von ihr zu wenden, öffnete er sie und nahm eine Veilchenpastille, die er bedächtig in den Mund steckte.“"
                            },
                            {
                                "example_id": "baa4f95d-910f-4069-ab7c-a6826b9539a0",
                                "sense_id": "1fe47bf9-a4d1-34c0-8302-fbe619384622",
                                "text": "„Allerdings verwendet die Parfümerie-Industrie auch die Blätter des Veilchens [Duftveilchen], aus denen ein so genannter ‚grüner‘ Duft extrahiert werden kann. Heutige Parfüms enthalten wie auch Veilchenpastillen synthetische Jonone.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
