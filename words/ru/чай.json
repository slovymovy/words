            "senses": [
                {
                    "sense_id": "2ddc335c-4c34-3ebd-a726-1d1d42dbec07",
                    "sense_definition": "горячий напиток, приготовленный из заваренных листьев чайного куста",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "напиток",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Я люблю пить горячий <w>чай</w> с лимоном по утрам.",
                            "target_lang_translations": {
                                "fr": "J'aime boire du <w>thé</w> chaud avec du citron le matin."
                            }
                        },
                        {
                            "text": "Приглашаю тебя на чашку <w>чая</w> сегодня вечером.",
                            "target_lang_translations": {
                                "fr": "Je t'invite à boire une tasse de <w>thé</w> ce soir."
                            }
                        }
                    ],
                    "common_phrases": [
                        "чашка чая",
                        "крепкий чай",
                        "зеленый чай",
                        "пить чай"
                    ],
                    "target_lang_definitions": {
                        "fr": "Boisson chaude préparée par infusion de feuilles de théier."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "thé",
                                "target_lang_sense_clarification": "boisson chaude"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "efea8433-1eee-30d6-bebf-5d6ae4d1ae2d",
                    "sense_definition": "денежное вознаграждение за оказанную услугу",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "деньги",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Довольный пассажир оставил таксисту сто рублей на <w>чай</w>.",
                            "target_lang_translations": {
                                "fr": "Le passager satisfait a laissé cent roubles de <w>pourboire</w> au chauffeur de taxi."
                            }
                        },
                        {
                            "text": "В этой стране принято давать курьеру на <w>чай</w>.",
                            "target_lang_translations": {
                                "fr": "Dans ce pays, il est d'usage de donner un <w>pourboire</w> au livreur."
                            }
                        }
                    ],
                    "synonyms": [
                        "чаевые"
                    ],
                    "common_phrases": [
                        "дать на чай",
                        "оставить на чай"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "используется в разговорной речи"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Gratification pécuniaire donnée en récompense d'un service."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "pourboire",
                                "target_lang_sense_clarification": "somme d'argent donnée en extra"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "7fb9e3e2-998b-3193-a151-60121c7d9ecb",
                    "sense_definition": "вводное слово, выражающее предположение или уверенность говорящего",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "модальность",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ты, <w>чай</w>, устал после долгой дороги?",
                            "target_lang_translations": {
                                "fr": "Tu es, <w>sans doute</w>, fatigué après ce long voyage ?"
                            }
                        },
                        {
                            "text": "Он, <w>чай</w>, уже забыл о нашем обещании.",
                            "target_lang_translations": {
                                "fr": "Il a, <w>sûrement</w>, déjà oublié notre promesse."
                            }
                        }
                    ],
                    "synonyms": [
                        "вероятно",
                        "по-видимому",
                        "небось"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "народно-разговорный стиль"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Mot familier exprimant une supposition ou une quasi-certitude du locuteur."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "sans doute",
                                "target_lang_sense_clarification": "probablement"
                            },
                            {
                                "target_lang_word": "sûrement",
                                "target_lang_sense_clarification": "vraisemblablement"
                            }
                        ]
                    }
                }
            ]
        }
    ]
