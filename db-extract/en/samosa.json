                                        "examples": [
                                            {
                                                "example_id": "6f8af46e-45e4-4244-b924-368772c7a353",
                                                "sense_id": "405fd689-3331-3030-9e76-1ba78447ee46",
                                                "text": "Самса — это огромный эклер, набитый сладким мясом, сладким луком, горным луком и так далее."
                                            },
                                            {
                                                "example_id": "e8c0b3b3-45c2-4387-bd10-40dcf7cd1a08",
                                                "sense_id": "405fd689-3331-3030-9e76-1ba78447ee46",
                                                "text": "Есть всё, что требуется для маленького приятного ужина по-узбекски: помидоры с луком к плову, опять же плов, манты, самса, салат из редьки, восточные сладости, зелёный чай."
                                            }
                                        ]
                                    }
