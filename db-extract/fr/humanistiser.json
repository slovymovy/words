                        "glosses": [
                            "Donner un caractère humaniste à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ac0705eb-ea6d-494d-ae4b-e836d078c02f",
                                "sense_id": "5915dd74-d4bc-3cb8-8bc1-65d29aa128c1",
                                "text": "Alors tout ce temps-là vous L’avez non seulement humanisé — ce qui va de soi, puisqu’il s'est fait une fois homme — mais humanistisé."
                            },
                            {
                                "example_id": "6eda9f1a-1fd0-45d9-afd7-95667c2c661a",
                                "sense_id": "5915dd74-d4bc-3cb8-8bc1-65d29aa128c1",
                                "text": "Des influences des grands thèmes des Puritains de son temps, mais humanistisées et déistisées."
                            }
                        ]
                    }
