                                    {
                                        "sense_id": "1a449342-0297-3fbc-936a-6e3c3603e26f",
                                        "entry_id": "ba82c1ef-e408-395a-a28e-d27ab39dc1ba",
                                        "glosses": [
                                            "The act of making a promise."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bfeae1f-6661-4519-89bc-0c53406c6bff",
                                                "sense_id": "1a449342-0297-3fbc-936a-6e3c3603e26f",
                                                "text": "So it cannot be supposed that promisings differ from other word-givings in that a word-giver makes a promise only if he or she uses the locution \"I promise\"."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
