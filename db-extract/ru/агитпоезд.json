                "senses": [
                    {
                        "sense_id": "e7b86aa7-a1df-35c3-b23e-92d74e731556",
                        "entry_id": "752454f5-6090-33b4-93a1-6ca103415398",
                        "glosses": [
                            "истор. поезд, специально предназначенный для агитационной работы в массах в отдалённых районах страны"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35f1cfb2-f492-4560-a836-32b68246f411",
                                "sense_id": "e7b86aa7-a1df-35c3-b23e-92d74e731556",
                                "text": "На путях стоял запеленатый в яркие плакаты агитпоезд 12-й армии."
                            },
                            {
                                "example_id": "6f5db2b2-e934-4bda-aedc-d3d44a65559f",
                                "sense_id": "e7b86aa7-a1df-35c3-b23e-92d74e731556",
                                "text": "Агитпоезд круглые сутки жил кипучей жизнью: работала типография, выпускались газеты, листовки, прокламации."
                            }
                        ]
                    }
                ],
