                        "target_lang_word": "maraîcher",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "maraîcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c1c9ab72-cf7b-3d9a-96bc-eb1dc1361096",
                                        "entry_id": "1d088744-ee0c-3ec5-80dd-f23d907f91b4",
                                        "glosses": [
                                            "Personne qui pratique le maraîchage, c’est-à-dire la culture des fruits et légumes."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "35d0fa87-74f4-4030-a92b-c0a2c5b3f53c",
                                                "sense_id": "c1c9ab72-cf7b-3d9a-96bc-eb1dc1361096",
                                                "text": "A deux cents mètres environ de notre grotte, se trouvait la maisonnette d’un maraîcher."
                                            },
                                            {
                                                "example_id": "cc5eef7a-1e53-49ec-ba57-6ce03b2297c5",
                                                "sense_id": "c1c9ab72-cf7b-3d9a-96bc-eb1dc1361096",
                                                "text": "Les Fouque étaient les plus riches maraîchers du pays ; ils fournissaient de légumes tout un quartier de Plassans."
                                            },
                                            {
                                                "example_id": "4c1d6cea-ff75-4e17-a1de-6a227a97b198",
                                                "sense_id": "c1c9ab72-cf7b-3d9a-96bc-eb1dc1361096",
                                                "text": "Il n'est pas rare de voir les maraîchers rétais charger le varech providentiel sur leurs remorques pour en engraisser les parcelles de pommes de terre."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "maraîcher",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "676266fd-9dae-3048-8cef-9162a3dd0a86",
                                        "entry_id": "e3584276-809b-3561-9f6e-c9ea001898b5",
                                        "glosses": [
                                            "Relatif au maraîchage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "58aa896c-3f0e-4d9d-a2e8-0ab81167337a",
                                                "sense_id": "676266fd-9dae-3048-8cef-9162a3dd0a86",
                                                "text": "culture maraîchère."
                                            },
                                            {
                                                "example_id": "4813374e-d44e-432d-a0e0-212fad035873",
                                                "sense_id": "676266fd-9dae-3048-8cef-9162a3dd0a86",
                                                "text": "Elles suivirent un champ de maïs, puis des enclos maraîchers où croissaient des piments rouges, des pastèques et des patates."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
