                ],
                "senses": [
                    {
                        "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                        "entry_id": "6ec460f1-1c62-3a56-b8e9-6c6758fe4f8d",
                        "glosses": [
                            "ein Stück Karton (oder anderes Material) zum Aufwickeln von geringen Garnmengen, meist einer Sorte und Farbe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "59608d2a-a9f7-4d33-b24b-ad5ea8fce07e",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Diese Garnkarte in Horn-Imitat passt zum Fingerhut aus dem gleichen Material.“"
                            },
                            {
                                "example_id": "e3b2a3f7-3773-462d-92a9-a5f9e155a223",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Diese Garnkarten ähneln den hübschen kleinen Gegenständen zum Garnaufwickeln, die früher in alten luxuriösen Nähsets Platz hatten.“"
                            },
                            {
                                "example_id": "4abc38f1-4071-4da6-8481-fbb126b2fe14",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Eine alte Garnkarte diente mir dazu als Schablone.“"
                            },
                            {
                                "example_id": "13cee417-17d8-4ed3-9068-0e57ab99fed9",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„...jeder Hobbyschneiderin wird diese Form eher bekannt sein als Garnkarte, auf der Garn, Wolle oder Gummiband aufgewickelt werden.“"
                            },
                            {
                                "example_id": "48ae7046-19fb-4ff6-bf40-644b9c27c06c",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Tolle Aufbewahrungsmöglichkeit für vintage Spitzenbänder, zum Verzieren, Verschenken, Verlieben und mehr.“"
                            },
                            {
                                "example_id": "216056a1-8571-453c-9f8d-a173bf9ec748",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Sortieren Sie Ihr Stickgarn komfortabel auf original DMC Garnkarten und gleich den passenden Metallring dazu.“"
                            },
                            {
                                "example_id": "18999265-1483-4dfd-af68-21b4e3b52374",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "Methode und Sinn: „Garnkarten zur Planung von Kette und Schuss - Beim Umwickeln von Karton bekommen Sie ein Gefühl dafür, wie die verschiedenen Garnfarben nebeneinander wirken.“"
                            },
                            {
                                "example_id": "d7265956-1a29-42cb-a7a3-356116b9703f",
                                "sense_id": "05a8ee73-92b1-3c57-a3e5-926f12bbfa55",
                                "text": "„Auf Grund der Dessinkarten wird auch der Garnbedarf festgestellt und auf «Garnkarten» ausgewiesen , und schließlich wird noch der Zubehörbedarf aus den Modellkarten auf entsprechenden «Zubehörkarten» gesammelt […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                        "entry_id": "6ec460f1-1c62-3a56-b8e9-6c6758fe4f8d",
                        "glosses": [
                            "ein Karton, auf dem Garnmuster (meist unterschiedlicher Farbe) angebracht sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b4850008-0982-4405-bf29-76c71c7b31cc",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "Methode und Sinn: „Garnkarten zur Planung von Kette und Schuss - Beim Umwickeln von Karton bekommen Sie ein Gefühl dafür, wie die verschiedenen Garnfarben nebeneinander wirken.“"
                            },
                            {
                                "example_id": "a667f83b-b3f2-4ed1-953e-3c9455e20ec7",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Auf Grund der Dessinkarten wird auch der Garnbedarf festgestellt und auf «Garnkarten» ausgewiesen , und schließlich wird noch der Zubehörbedarf aus den Modellkarten auf entsprechenden «Zubehörkarten» gesammelt […].“"
                            },
                            {
                                "example_id": "bb9ffa74-5434-4435-ae82-64fbfc1bbba8",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Die ganze Reihe der Cibacetfarben (22 an der Zahl) wird teils als Selbstfarben, teils in Mischungen in einer 55 Muster enthaltenen Garnkarte vorgeführt.“"
                            },
                            {
                                "example_id": "9a5a13e4-5933-41df-a414-ee490585fc53",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Diesen Vorzug zu veranschaulìchen, das ist der Zweck der Garnkarte.“"
                            },
                            {
                                "example_id": "6e21a1b2-def9-4543-a868-fc5d0442911a",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Gleichen Sie die Farben anhand Ihrer Garnkarte oder -tabelle ab.“"
                            },
                            {
                                "example_id": "d13f9401-1636-427b-a107-57afe3a7d144",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Wenn man mit mehreren Farben arbeitet, bietet es sich an, eine Garnkarte zu benutzen.“"
                            },
                            {
                                "example_id": "8b459541-c55e-4995-85d9-c335dfff7bc7",
                                "sense_id": "9f1c271e-d766-3e7e-a7f0-12cfcfc33730",
                                "text": "„Garnkarte mit flammhemmenden, spinngefärbten, UV-stabilen Trevira Garnen in 28 Farben“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
