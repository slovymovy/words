                ],
                "senses": [
                    {
                        "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                        "entry_id": "a6ea8cfe-9fd1-3e69-9710-66365439ebc0",
                        "glosses": [
                            "Effleurer le premier une matière, goûter en premier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc9d778b-cf12-4886-9cc1-c1d40568601c",
                                "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                                "text": "Je me contente de préliber, ce qui est le droit du premier venu en toute matière."
                            },
                            {
                                "example_id": "d166e8c9-19e0-47ce-9cf6-a11fb6e01e6b",
                                "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                                "text": "Nous nous levions et nous mangions debout, notre assiette à la main ; mais les diables de bêtes se dressaient sur les pattes de derrière, nous jetaient les pattes de devant aux épaules, et se trouvaient ainsi à hauteur du morceau convoité. S’ils ne l’emportaient pas, ils lui donnaient au moins deux ou trois tours de langue, et en prélibaient ainsi la première et la plus délicate saveur."
                            },
                            {
                                "example_id": "464aea9b-3016-4f5e-b7e2-60f5dd0e67a2",
                                "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                                "text": "Je veux être le seul à préliber la saveur de cette chanson que je devine exquise."
                            },
                            {
                                "example_id": "51040b58-a34b-48fb-8a39-ee50ef73d7d9",
                                "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                                "text": "Nul doute qu'il n'ait médité sur une pareille vertu, lui dont l'adolescence avait désiré, pour préliber certaines beautés, posséder à leur sujet « une métaphore de Bergotte »."
                            },
                            {
                                "example_id": "4c906975-0468-4be1-b3e7-bc2189331b45",
                                "sense_id": "eada1b45-fb2f-3325-a8ae-9014d351e938",
                                "text": "Je ne prétends pas préliber des vérités nouvelles."
                            }
                        ]
                    }
                ],
