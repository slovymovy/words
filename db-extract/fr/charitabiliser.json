                "senses": [
                    {
                        "sense_id": "c30cd999-ea1a-3f7f-a0fe-0e2f0c6728a9",
                        "entry_id": "e6b0860f-08d7-35e4-9b78-9f33838c5067",
                        "glosses": [
                            "Donner un caractère charitable à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f159038a-ba24-429a-ba59-3337de42d12d",
                                "sense_id": "c30cd999-ea1a-3f7f-a0fe-0e2f0c6728a9",
                                "text": "pr vivre le vol de la valeur ajoutée par le propriétaire lucratif et dc cesser de vouloir charitabiliser le capitalisme."
                            },
                            {
                                "example_id": "a48900be-040f-4ce1-8d9f-65c81456ccd8",
                                "sense_id": "c30cd999-ea1a-3f7f-a0fe-0e2f0c6728a9",
                                "text": "Hé ! si la morale ne sensibilisait, ne charitabilisait, elle aurait toujours une trop incomplète action;"
                            },
                            {
                                "example_id": "4b30a864-0830-4321-a47a-4a9bf178a5f2",
                                "sense_id": "c30cd999-ea1a-3f7f-a0fe-0e2f0c6728a9",
                                "text": "Que celles qui veulent se faire payer le fassent, que celles qui veulent gestationner pour les autres jusqu'à ce que leur utérus leur tombe aux chevilles le fassent, que celles qui veulent charitabiliser charitabilisent, tout cela est très bien."
                            }
                        ]
                    }
