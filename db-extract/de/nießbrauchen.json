                        "sense_id": "8ba1bb0d-6f30-37ec-b86d-2c9be5fa8f51",
                        "entry_id": "855d17cc-bfd3-3e78-b6fd-92edfe18248f",
                        "glosses": [
                            "zum eigenen Nutzen verwenden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5409805a-04c3-4113-8e07-abb59ff17b54",
                                "sense_id": "8ba1bb0d-6f30-37ec-b86d-2c9be5fa8f51",
                                "text": "„Die Mitgift durfte der Mann nur nießbrauchen, und wenn er vor der Frau starb, nahm letztere sie mit nach Hause zurück; die Aussteuer. welche die Frau mitbrachte; blieb ihr Eigentum unter des Mannes Vormundschaft.“"
                            },
                            {
                                "example_id": "6e53902a-d93a-4ff4-9d3a-abc156dab2ba",
                                "sense_id": "8ba1bb0d-6f30-37ec-b86d-2c9be5fa8f51",
                                "text": "„Er war mit menschenleeren u. verfallenen Gebäuden umgeben, die, wie es scheint, nun von liederlichen Leuten genießbraucht wurden.“"
                            },
                            {
                                "example_id": "a1f38ca7-e602-421c-ac46-18a59b66cf5d",
                                "sense_id": "8ba1bb0d-6f30-37ec-b86d-2c9be5fa8f51",
                                "text": "„Diese neu entstandenen Frauen konnten, außer dem Brautschatze, andere Güter eigenthümlich besitzen, die zwar den Männern anvertraut, von diesen verwaltet, und genießbraucht wurden, die aber der Mann nicht veräußern konnte, und wegen welcher die Gesetze den Frauen Sicherheit zu verschaffen und Klagen zu gestatten anfingen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
