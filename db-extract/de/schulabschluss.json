                ],
                "senses": [
                    {
                        "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                        "entry_id": "3f8e252f-a0a1-30cd-a566-92e249345b1a",
                        "glosses": [
                            "erfolgreicher Abschluss an einer allgemeinbildenden Schule"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "62458d35-69c8-4b84-89ca-0344ac2f5317",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "Er strebte als Schulabschluss das Abitur an, um danach studieren zu können."
                            },
                            {
                                "example_id": "bde22a80-4bee-431f-82b4-958c565a11af",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "„Doch schon als Jugendliche war sie ihnen dafür dankbar, denn der gute Schulabschluss hat ihr ein Studium ermöglicht.“"
                            },
                            {
                                "example_id": "5fe324a2-fb0d-4346-8455-3be31ef209be",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "„Ich erkläre ihnen [meinen Söhnen] ständig, wie wichtig ein guter Schulabschluss ist für ihre Zukunft.“"
                            },
                            {
                                "example_id": "4ed351b8-a65e-4696-9d11-39367b54121c",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "„Nach dem Schulabschluss lernte sie in verschiedenen Haushalten, zunächst in Warschau, dann in Sankt Petersburg und schließlich in Unkel.“"
                            },
                            {
                                "example_id": "12e6751f-285e-452c-82d1-c75518a3c684",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "„Stefan wollte sofort nach dem Schulabschluss in gut einem Monat abhauen.“"
                            },
                            {
                                "example_id": "8825d134-a4a9-4029-abad-4d58796beefc",
                                "sense_id": "4552f151-9260-33dc-97be-78985b9288cd",
                                "text": "„Vor zwei Jahren hatte sie ihren Schulabschluss gemacht, aber es war ihr seither nicht gelungen, bei der jährlichen Zulassungsprüfung genug Punkte zu sammeln, um an einer Universität ihrer Wahl zugelassen zu werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
