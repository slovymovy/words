                                        "sense_id": "fb28d9a1-fadd-3a6c-9dc3-d303ef6cf5b4",
                                        "entry_id": "5da6b5bb-d39e-301e-8ecb-2a58a0132c38",
                                        "glosses": [
                                            "Uttered or modulated by the voice; expressed in words.",
                                            "Having or exercising the power of producing voice, speech, or sound."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f8459ef7-dc57-4494-8234-578686041c39",
                                                "sense_id": "fb28d9a1-fadd-3a6c-9dc3-d303ef6cf5b4",
                                                "text": "To hill or valley, fountain, or fresh shade,\nMade vocal by my song."
                                            },
                                            {
                                                "example_id": "8c8bc0d5-aa42-491f-a3fa-748a9fa684fd",
                                                "sense_id": "fb28d9a1-fadd-3a6c-9dc3-d303ef6cf5b4",
                                                "text": "The tide flows down, the wave again\n⁠Is vocal in its wooded walls:\n⁠My deeper anguish also falls,\nAnd I can speak a little then."
                                            }
                                        ]
                                    },
