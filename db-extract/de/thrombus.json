                "senses": [
                    {
                        "sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                        "entry_id": "cc6a0886-3fd0-3ddd-ba92-f40f9ae18926",
                        "glosses": [
                            "Blutpfropf, der ein Blutgefäß verstopft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e0bb5e66-7ec8-455e-b2fe-93946dd29481",
                                "sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                                "text": "„Der nächste Thrombus lag gewiss schon auf der Lauer, wollte sich hinter meinen zugefallenen Lidern unter der Hirnschranke durchducken, um diesmal einen der zentralen Eingänge zu verstopfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2fd2ebf0-a113-49a5-bcf4-ee9d1b6b45cd",
                        "source_entry_id": "cc6a0886-3fd0-3ddd-ba92-f40f9ae18926",
                        "source_sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                        "source_sense_description": "Blutpfropf, der ein Blutgefäß verstopft",
                        "target_lang_word": "thrombus",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrombus",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74dee56d-8006-329b-9104-37da12817de8",
                                        "entry_id": "7d2ba1d3-6020-324e-b39b-1caf6f083a69",
                                        "glosses": [
                                            "A blood clot formed from platelets and other elements that forms in a blood vessel in a living organism, and causes thrombosis or obstruction of the vessel at its point of formation or travel to other areas of the body."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c51ff5c3-0d3d-4d80-9201-7bcaf5a2632b",
                        "source_entry_id": "cc6a0886-3fd0-3ddd-ba92-f40f9ae18926",
                        "source_sense_id": "31225fd5-f9fd-3a0b-8005-2a0c3221e120",
                        "source_sense_description": "Blutpfropf, der ein Blutgefäß verstopft",
                        "target_lang_word": "thrombus",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "thrombus",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                                        "entry_id": "f541bb40-6bc7-3a36-bb1e-f6b7b744ce17",
                                        "glosses": [
                                            "Caillot sanguin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "af668e6e-4584-439d-b352-13309026aa7e",
                                                "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                                                "text": "Paradoxalement, il est recommandé d’anticoaguler à dose curative afin d’éviter la formation de thrombus intracarotidien [20, 21]."
                                            },
                                            {
                                                "example_id": "b68fa54e-f9b6-4266-9c32-5ebd5cba9b7a",
                                                "sense_id": "d80e3e1a-01ff-38f0-aa8c-d83983604979",
                                                "text": "Ainsi, il paraît logique d’anticoaguler les patients présentant une cardiopathie à haut risque de récidive embolique : prothèses valvulaires mécaniques, valvulopathies mitrales, infarctus du myocarde récent, cardiomyopathies dilatées, anévrysmes ventriculaires, fibrillation auriculaire non rhumatismale associée à un thrombus intracavitaire."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
