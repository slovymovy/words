                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjugaison_amarrer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Chaque soir en rentrant au port, j'<w>amarre</w> mon petit bateau au même ponton."
                        },
                        {
                            "text": "Il faut que le marin <w>amarre</w> soigneusement son canot avant la montée de la marée."
