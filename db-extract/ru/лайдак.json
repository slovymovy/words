                ],
                "senses": [
                    {
                        "sense_id": "99275180-9104-31de-baf2-bd43f324cc32",
                        "entry_id": "8b12c65a-5445-3568-b4dd-2e7333adc418",
                        "glosses": [
                            "разг., сниж. бездельник, лентяй, негодный человек"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e389f658-1392-421c-bfaf-f4a1786516ac",
                                "sense_id": "99275180-9104-31de-baf2-bd43f324cc32",
                                "text": "— Ну и понятно: прослышал, что у меня деньги есть, а потому и приехал венчаться! — Пани Агриппина, — закричал пан, — я рыцарь, я шляхтич, а не лайдак!"
                            }
                        ]
                    },
                    {
                        "sense_id": "e774a38e-6eb5-33fa-a1df-4daaafe97cd1",
                        "entry_id": "8b12c65a-5445-3568-b4dd-2e7333adc418",
                        "glosses": [
                            "разг., сниж., бран. употребляется как порицающее или бранное слово"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7df035f2-a8c8-4520-bd64-aac6fade59f1",
                                "sense_id": "e774a38e-6eb5-33fa-a1df-4daaafe97cd1",
                                "text": "— Пан — лайдак! — проворчал вдруг высокий пан на стуле и переложил ногу на ногу. ❬…❭ — Ну вот, и лайдак! Чего он бранится? — рассердилась вдруг Грушенька."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4f31856e-ee63-416b-a9e9-d99278df3768",
                        "source_entry_id": "8b12c65a-5445-3568-b4dd-2e7333adc418",
                        "source_sense_description": "бездельник, лентяй, негодный человек",
                        "target_lang_word": "łajdak",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
