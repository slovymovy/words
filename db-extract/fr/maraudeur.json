                    }
                ],
                "senses": [
                    {
                        "sense_id": "e34ff6bf-0307-33d1-acad-f46552588946",
                        "entry_id": "a5478c8d-ce15-319f-aa7b-984639dda96a",
                        "glosses": [
                            "Qui pratique la maraude."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28ec9a17-99b2-4152-8853-4deaf07a7238",
                                "sense_id": "e34ff6bf-0307-33d1-acad-f46552588946",
                                "text": "La région où nous allons nous engager est infestée de soldats pillards et de bédouins maraudeurs, profitant tous de l'anarchie générale pour satisfaire leurs instincts de rapine."
                            },
                            {
                                "example_id": "c432ebdc-f44d-4242-9b38-f013d6e75e0e",
                                "sense_id": "e34ff6bf-0307-33d1-acad-f46552588946",
                                "text": "À présent, les roseaux remuaient, des bêtes maraudeuses fuyaient ou plongeaient et le battement des ailes invisibles avait recommencé dans les hautes branches."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2119931b-f95f-4fdc-a75d-cf92161e01d7",
                        "source_entry_id": "a5478c8d-ce15-319f-aa7b-984639dda96a",
                        "source_sense_id": "e34ff6bf-0307-33d1-acad-f46552588946",
                        "target_lang_word": "prowler",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prowler",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "55cf792f-a2e6-392f-8035-8eafc9f569dd",
                                        "entry_id": "f0c53bb5-cc62-34c8-aa15-b91a331c20d9",
                                        "glosses": [
                                            "One who roves about for prey; one who prowls."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51160268-53b5-43bd-8e10-bc51a12b643c",
                                                "sense_id": "55cf792f-a2e6-392f-8035-8eafc9f569dd",
                                                "text": "House Prees and Bloods […] were everywhere to be seen in earnest colloquy. For the matter was, that there was some sort of night-prowler about the school grounds."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                                        "entry_id": "f0c53bb5-cc62-34c8-aa15-b91a331c20d9",
                                        "glosses": [
                                            "A person who moves stealthily around a place with intention to commit a crime, especially burglary or theft."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "66d11e5c-ae9d-4611-b453-ccc05efbf4e4",
                                                "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                                                "text": "Discourage nighttime prowlers by installing motion-sensitive lights."
                                            },
                                            {
                                                "example_id": "fab07124-067c-4c66-b2b0-221eb97440c5",
                                                "sense_id": "ec265539-f5d1-3679-909d-30525226081c",
                                                "text": "“I was under the impression that a prowler had broken in and killed my baby. Never did they say that it was a deputy-involved shooting until my brother read it on the internet,” Wilburn said."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
