        "de-extract.jsonl": [
            {
                "entry_id": "b974e5f7-8f25-3bc0-a12c-80768f52b9a7",
                "word": "blindlings",
                "pos": "adv",
                "lang_code": "de",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "bfb16306-84cf-316d-ae6d-441bff6a196a",
                        "entry_id": "b974e5f7-8f25-3bc0-a12c-80768f52b9a7",
                        "glosses": [
                            "unüberlegt, wahllos"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d1388172-9c07-4eea-bdea-76a588845c99",
                                "sense_id": "bfb16306-84cf-316d-ae6d-441bff6a196a",
                                "text": "Den Fragebogen habe ich einfach blindlings ausgefüllt."
                            },
                            {
                                "example_id": "14ff44cd-1468-4fca-a00e-755395a0765c",
                                "sense_id": "bfb16306-84cf-316d-ae6d-441bff6a196a",
                                "text": "Man kann diesen Vorschlag nicht blindlings übergehen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bfead0c3-3ca8-4441-964b-be3cd7905faf",
                        "source_entry_id": "b974e5f7-8f25-3bc0-a12c-80768f52b9a7",
                        "source_sense_id": "bfb16306-84cf-316d-ae6d-441bff6a196a",
                        "source_sense_description": "unüberlegt, wahllos",
                        "target_lang_word": "pell-mell",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pell-mell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                        "entry_id": "28f49590-b44d-3eb4-92ab-da487e700c47",
                                        "glosses": [
                                            "Hasty and uncontrolled."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "aa5ccafd-dc9c-432e-b348-f2a3208c7196",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "Nor moody Beggars, ſtaruing for a time / Of pell-mell hauocke, and confusion."
                                            },
                                            {
                                                "example_id": "bb32a09d-b861-4fd3-b1f9-0002e32c0629",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "These present the appearance of masses of water-worn gravel, mixed in the most pell mell confusion, the boulders being often of very large size; but I observed no striae, nor any of the blue tenacious clay of the Till, which it so much resembled."
                                            },
                                            {
                                                "example_id": "f6d917cd-ddbc-4631-bb91-201833595e3c",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "The whole district presents the most pell-mell throwing together imaginable."
                                            },
                                            {
                                                "example_id": "618a27b1-8e49-47d6-b9b9-320a66a411ec",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "The pell mell, hell for leather traffic of Lagos was more pell mell, hell for leather than ever."
                                            },
                                            {
                                                "example_id": "8498b44e-5248-47bd-9f6a-b372e97aebf1",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "The cattle are less disciplined, more pell-mell, heavy-footed, their hooves stamping the ground to mud in several places."
                                            },
                                            {
                                                "example_id": "adde5060-0f34-4167-b7b5-2b1b8c5a3b26",
                                                "sense_id": "4ea8988a-e9ea-395a-aaf0-cb96d8620d4f",
                                                "text": "China’s pell-mell, brisk urbanization has in some ways made the challenge harder to face."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pell-mell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                        "entry_id": "b99dff10-a720-309f-b271-fe7904951f13",
                                        "glosses": [
                                            "In haste and chaos; uncontrolledly, confusedly."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6d88c7d8-8434-441e-97f1-a09864b6f046",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "But ſeeing that there the murdring Enemie, / Peſle-meſle, purſued them like a ſtorme of hayle, / They gan retyre vvhere Iuba vvas encampt; […]"
                                            },
                                            {
                                                "example_id": "2479183a-4368-4bb9-a1f2-73cc48320c49",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "Never was there a great battle fought more pell-mell, since war began; never was valor so completely thrown away."
                                            },
                                            {
                                                "example_id": "a8781eba-1dce-4f46-b681-e5e1723d7f93",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "The table was covered with a confusion of papers, books, pamphlets, all heaped upon one another pell-mell; […]"
                                            },
                                            {
                                                "example_id": "b4d93065-1623-48c9-91ff-6068de3176a6",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "Pell-mell they rushed for Inverness and safety, leaving the strange battlefield to the stalwart five."
                                            },
                                            {
                                                "example_id": "45651071-c347-4bce-ad40-5ac01c801761",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "A group of the reapers whom we had seen running from the fields were lying all pell-mell, their bodies crossing each other, at the bottom of it."
                                            },
                                            {
                                                "example_id": "93dcdc67-d4d6-45ec-8818-4723037839e5",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "And the prompter our payments the more pell-mell the news came in and the more obligingly gruesome its detail."
                                            },
                                            {
                                                "example_id": "4bcdaa3b-dab5-44a3-8e8f-d2facf1cb925",
                                                "sense_id": "a1aef5f2-7443-3a3e-b6eb-53055009dae0",
                                                "text": "Some are already packed up well; / Others are at it, most pell mell."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "pell-mell",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7d531ad2-dcaf-3be6-beb4-c293d4e6e583",
                                        "entry_id": "aaef0c3b-3d8e-3eb7-8ee3-efa6096cf0b5",
                                        "glosses": [
                                            "Alternative form of pall mall (“ball game”)."
                                        ],
                                        "tags": [
                                            "alt-of",
                                            "alternative",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cada29fa-a7b2-4399-99cb-5a25e66f9a61",
                        "source_entry_id": "b974e5f7-8f25-3bc0-a12c-80768f52b9a7",
                        "source_sense_id": "bfb16306-84cf-316d-ae6d-441bff6a196a",
                        "source_sense_description": "unüberlegt, wahllos",
                        "target_lang_word": "aveuglément",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aveuglément",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                        "entry_id": "06748e19-7c90-310c-9cda-e91cfc90ab33",
                                        "glosses": [
                                            "En aveugle, sans réflexion ni examen."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d6685280-aa02-44a4-982a-5db00ea7e68e",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Ô juges malheureux, qui dans nos faibles mains Tenons aveuglément le glaive et la balance."
                                            },
                                            {
                                                "example_id": "f36325df-e42a-4ddd-a6fc-e2b78f28df21",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Il aime aveuglément sa patrie et son père."
                                            },
                                            {
                                                "example_id": "fc785f86-4266-4d17-9556-d647b14700a5",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Car, puisque la fortune aveuglément dispose De tout…"
                                            },
                                            {
                                                "example_id": "d355f511-21f7-43c4-87fa-9e4dac3cde52",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Puis tous s’étaient engagés à paraître ne rien savoir vis-à-vis de leur chef et à lui obéir aveuglément comme par le passé."
                                            },
                                            {
                                                "example_id": "e8d84a90-0d8d-4191-bf5b-bfef41c187cc",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Heureusement tous les cossons n’étaient pas partis. Il y a des cépages peu hâtifs qui prudemment n’ont pas « débourré » — et, chose remarquable, ce ne sont pas ceux dits « du pays » qu'on s'obstine, aveuglément, à recommander."
                                            },
                                            {
                                                "example_id": "0368a924-9ad3-40ee-a164-f34d3a7b9525",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Dans une démocratie, aucun homme sensé ne veut renoncer à son droit à exercer son jugement personnel ; sachant son chef de même nature que lui, il ne peut lui faire aveuglément confiance ; par conséquent, il veut diriger lui-même."
                                            },
                                            {
                                                "example_id": "481febde-9155-4089-aacd-72213d70a7f7",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "N’accusons pas aveuglément le naturel des habitants de l’île la plus célèbre du monde."
                                            },
                                            {
                                                "example_id": "f7f1d15b-1257-49c9-8356-afedb7f65671",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "L’âme, de son dessein jusque-là possédée, s’attache aveuglément à sa première idée."
                                            },
                                            {
                                                "example_id": "ea4c2a9f-cbbd-4a73-a6b0-d7fc5365246b",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "Suivons aveuglément ma triste destinée."
                                            },
                                            {
                                                "example_id": "363a9238-3a3f-4719-be44-5fca3939988a",
                                                "sense_id": "54dcaabb-6c7f-39eb-9fa4-2c53ecd8dc15",
                                                "text": "J’accepte aveuglément cette gloire avec joie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            }
