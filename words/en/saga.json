{
    "word_family": [],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2fe164d1-22e9-394d-be13-95255080d8eb",
                    "sense_definition": "A long, complicated series of related events or a long story, often involving hardship or drama.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>saga</w> of the missing luggage finally ended when the airline delivered it to our hotel.",
                            "target_lang_translations": {
                                "zh": "航空公司把行李送到酒店后，这起行李丢失的<w>长篇故事</w>终于画上了句号。"
                            }
                        },
                        {
                            "text": "We listened to the whole <w>saga</w> of his divorce during dinner.",
                            "target_lang_translations": {
                                "zh": "晚饭时，我们听他讲了整段离婚的<w>曲折经历</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "epic",
                        "chronicle"
                    ],
                    "common_phrases": [
                        "ongoing saga",
                        "long-running saga",
                        "family saga",
                        "epic saga"
                    ],
                    "target_lang_definitions": {
                        "zh": "指一系列漫长、复杂且往往充满波折或戏剧性的事件或故事。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "长篇故事",
                                "target_lang_sense_clarification": "指代冗长且情节复杂的故事。"
                            },
                            {
                                "target_lang_word": "一连串事件",
                                "target_lang_sense_clarification": "指代持续时间长且过程曲折的事件。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4c48ff5d-f017-34ae-8297-ed5e16abdfc6",
                    "sense_definition": "A medieval prose narrative from Iceland or Norway, typically telling the history of famous heroes and families.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "narrative",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The professor assigned a famous Icelandic <w>saga</w> for the students to analyze.",
                            "target_lang_translations": {
                                "zh": "教授布置了一部著名的冰岛<w>萨迦</w>供学生们分析。"
                            }
                        },
                        {
                            "text": "Every <w>saga</w> provides a glimpse into the lives of Viking warriors and kings.",
                            "target_lang_translations": {
                                "zh": "每一部<w>萨迦</w>都让我们得以一窥维京战士和国王的生活。"
                            }
                        }
                    ],
                    "synonyms": [
                        "legend",
                        "myth",
                        "folk tale"
                    ],
                    "common_phrases": [
                        "Norse saga",
                        "Icelandic saga"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical literature"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中世纪冰岛或挪威的散文叙事文学，通常讲述英雄和家族的历史。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "萨迦",
                                "target_lang_sense_clarification": "指北欧中世纪的英雄史诗或家族传说。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "368af4f9-b8d7-3524-b121-885496a22021",
                    "sense_definition": "Plural of <w>sagum</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The museum display showed how Roman soldiers fastened their <w>saga</w> with brooches.",
                            "target_lang_translations": {
                                "zh": "博物馆的展览展示了罗马士兵是如何用胸针固定他们的<w>斗篷</w>的。"
                            }
                        },
                        {
                            "text": "In the ancient text, the troops were described wearing heavy <w>saga</w> against the cold.",
                            "target_lang_translations": {
                                "zh": "在古籍中，士兵们被描述为穿着厚重的<w>斗篷</w>以抵御严寒。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "plural form of sagum"
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古罗马士兵所穿的斗篷（sagum）的复数形式。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "斗篷",
                                "target_lang_sense_clarification": "指代古代士兵穿着的披风。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "da905b4a-2ae8-3f32-bd8c-f40f889e8364",
                    "sense_definition": "A unisex given name.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "I met a woman named <w>Saga</w> at the conference yesterday.",
                            "target_lang_translations": {
                                "zh": "昨天在会议上，我遇到了一位名叫<w>萨加</w>的女士。"
                            }
                        },
                        {
                            "text": "<w>Saga</w> is a popular name in Sweden and is becoming known elsewhere.",
                            "target_lang_translations": {
                                "zh": "<w>萨加</w>在瑞典是一个很受欢迎的名字，并且正逐渐为其他地方的人所知。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "一个中性的人名。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "萨加",
                                "target_lang_sense_clarification": "作为人名的音译。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "853b8d90-6bb4-3341-bf5e-7a5d92c1f40e",
                    "sense_definition": "The capital city of Saga Prefecture in Kyushu, Japan.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "place_japan",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "We took a train to <w>Saga</w> to visit the annual balloon festival.",
                            "target_lang_translations": {
                                "zh": "我们乘火车去了<w>佐贺</w>参加一年一度的热气球节。"
                            }
                        },
                        {
                            "text": "The castle ruins in <w>Saga</w> are a major attraction for tourists.",
                            "target_lang_translations": {
                                "zh": "<w>佐贺</w>的城堡遗迹是吸引游客的主要景点。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "日本九州佐贺县的首府。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "佐贺",
                                "target_lang_sense_clarification": "日本地名。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1471a15e-bbb3-38ae-888c-c37b9e89d5b1",
                    "sense_definition": "A county in the Tibet Autonomous Region of China.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "The expedition team stopped in <w>Saga</w> to rest before crossing the pass.",
                            "target_lang_translations": {
                                "zh": "探险队在翻越山口前在<w>萨嘎</w>停留休息。"
                            }
                        },
                        {
                            "text": "Travelers often pass through <w>Saga</w> on their way to Mount Kailash.",
                            "target_lang_translations": {
                                "zh": "游客在前往冈仁波齐峰的途中经常会经过<w>萨嘎</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "中国西藏自治区的一个县。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "萨嘎",
                                "target_lang_sense_clarification": "中国西藏地名。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}