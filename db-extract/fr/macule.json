        "fr-extract.jsonl": [
            {
                "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                "word": "macule",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "648509a0-f2f7-4a99-a3e5-845ca38608db",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "tags": [
                            "plural"
                        ],
                        "form": "macules"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "2a9356b1-0fa3-3a9b-80af-06264480c600",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Tache ; souillure."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79f38dd5-ffec-43db-86fc-d042507b6470",
                                "sense_id": "2a9356b1-0fa3-3a9b-80af-06264480c600",
                                "text": "— Messire Philippe-Marie-François, comte d’Udressier, seigneur d’Ecleux, Cramans, Lemuy et autres lieux, consentait à affranchir « par grâce spéciale » Claude-Etienne Pasteur, garçon tanneur demeurant à Salins, son sujet mainmortable de Lemuy. L’acte stipulait que Claude-Etienne et sa postérité à naître seraient désormais affranchis de la macule de mainmorte."
                            },
                            {
                                "example_id": "16455548-a699-4dff-a6bc-9d5253edc2d4",
                                "sense_id": "2a9356b1-0fa3-3a9b-80af-06264480c600",
                                "text": "Il mentait et, quand il toussait, détournait la tête, puis s’essuyait rapidement la bouche et la barbe, afin que Jeanne n’y vît point les rouges macules. — (James Oliver Curwood, Kazan, 1914, traduit de l’anglais par P. Gruyer et L. Postif, Hachette, 1937, pages 65-66)"
                            },
                            {
                                "example_id": "b8ef9b04-f736-4276-8d33-c17b3762f6fc",
                                "sense_id": "2a9356b1-0fa3-3a9b-80af-06264480c600",
                                "text": "Ce papier est plein de macules."
                            }
                        ]
                    },
                    {
                        "sense_id": "f70bca25-542a-3ec6-b79c-a3cb9fa1a773",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Tache obscure qu’on observe sur le disque du soleil."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "042923ca-3c41-3d62-8a0d-4db76e2cf597",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Tache apparaissant pendant l’impression."
                        ],
                        "tags": [
                            "Imprimerie"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "b1672050-44d1-37a7-8e63-93041a6f83a7",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Feuille de brouillon intercalée pour éviter le maculage."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "e271735c-a1b9-3fa3-9723-1ea382f074ed",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Tache à la surface du labelle d’une orchidée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a0fc55d-91bf-436b-a3cf-72271f0417f8",
                                "sense_id": "e271735c-a1b9-3fa3-9723-1ea382f074ed",
                                "text": "Je posai devant elle un bouquet de pavots rouges bien ouverts, leur coupelle montrant, à la base des pétales, la macule d’un noir bleuté."
                            }
                        ]
                    },
                    {
                        "sense_id": "254eef10-9535-37ba-b0c0-c347526e50f6",
                        "entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "glosses": [
                            "Tache à la superficie de la peau."
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a6f22915-18a9-4825-b3e1-2c5e3a58685e",
                        "source_entry_id": "8724ef9b-7d1a-37eb-a78e-95804f38cbc4",
                        "source_sense_id": "2a9356b1-0fa3-3a9b-80af-06264480c600",
                        "source_sense_description": "tache, souillure",
                        "target_lang_word": "Fleck",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Fleck",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "Stelle, die verschmutzt (und schlecht^([1])) ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "70fc0702-504c-4c75-8397-5697959e71f0",
                                                "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                                "text": "„Er konnte die Flecken erkennen, wo der Verputz abgefallen war.“"
                                            },
                                            {
                                                "example_id": "3ac92aaf-8c4f-4f2c-94e7-55eb560eb039",
                                                "sense_id": "a880da5c-1135-35f7-99cf-3ed08e2fbe96",
                                                "text": "Mein Kleid hat einen Fleck und muss zur Reinigung/gewaschen werden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "Stelle, die andersfarbig ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2d4b99db-a5d6-4a28-bf0a-33f9429024cd",
                                                "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                                "text": "Sein neuestes Kunstwerk ist eine blau gestrichene Regentonne mit drei rosafarbenen Flecken."
                                            },
                                            {
                                                "example_id": "f9d343f3-5598-4640-aa65-9d116ea2eaac",
                                                "sense_id": "5759bc8c-77de-3f68-bc8f-1aa6f10ed29a",
                                                "text": "„Ihre Augen waren gerötet, und um die Augen herum hatte sich die Wimperntusche in schwarzen ungeordneten Flecken ausgebreitet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "794341d1-69a1-3f14-b340-5f1b04efc12c",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "bestimmter Ort oder Stelle"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a991a85c-4816-4473-a962-9ece66674cd2",
                                                "sense_id": "794341d1-69a1-3f14-b340-5f1b04efc12c",
                                                "text": "Seit Jahren treffen sie sich am selben Fleck."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "cb864e71-caef-392e-928a-ef83828be104",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "zum Verzehr gedachte Streifen aus dem Vormagen von Wiederkäuern"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4851a0d4-bcf3-4593-88af-daa7a6a45dab",
                                                "sense_id": "cb864e71-caef-392e-928a-ef83828be104",
                                                "text": "Die Flecken schmecken heute besonders gut."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1b09d69b-bd05-3c3c-a3b4-a1992464aa05",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "die Schulnote 5 (nicht genügend)"
                                        ],
                                        "tags": [
                                            "Austrian German",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "43407ac4-12fa-442b-80c8-ab15280d24dd",
                                                "sense_id": "1b09d69b-bd05-3c3c-a3b4-a1992464aa05",
                                                "text": "Er hat schon wieder einen Fleck geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "565e014d-b620-3716-a2b8-3a0b7dce7468",
                                        "entry_id": "253490ad-731c-3fad-9720-d6771233e2f3",
                                        "glosses": [
                                            "ein (rundes oder eckiges) Stück Material, oft auch für Verbesserungen/Reparaturen verwendet, oft auch auf Speisen anwendbar (siehe Wortbildungen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a8849aa6-1717-4854-8f52-96aebfea17d1",
                                                "sense_id": "565e014d-b620-3716-a2b8-3a0b7dce7468",
                                                "text": "Sie näht ihm immer noch die Flecken über die Löcher in seiner Hose."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            },
                            {
