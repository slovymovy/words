    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                "word": "Paraclete",
                "pos": "name",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                        "entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                        "glosses": [
                            "The Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9db77be9-1bae-42a6-a5f4-3dde1a806add",
                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                "text": "Apples of ashes, golden bright; / Waters of bitterness, how sweet! / O banquet of a foul delight, / Prepared by thee, dark Paraclete!"
                            },
                            {
                                "example_id": "545bc7df-d8ce-45ae-9bc7-8e19676ce6d5",
                                "sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                                "text": "The matter of a Paraclete’s coming, the comforter, the dove; the tongues of flame, the gift of tongues: Pentecost. Third Person of the Trinity."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "23c82f70-3634-4cb0-ac90-0d6d6d929051",
                        "source_entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                        "source_sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                        "source_sense_description": "the Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful",
                        "target_lang_word": "Parakleet",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Parakleet",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "47b7c97b-9be8-3539-93e4-d27f7607a8df",
                                        "entry_id": "ec1f62d5-3083-31b7-93aa-5644fd3d3549",
                                        "glosses": [
                                            "trooster, bemiddelaar, de door Christus beloofde Heilige Geest"
                                        ],
                                        "tags": [
                                            "christendom"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b860d976-cb2d-4588-87a6-4e79050023fa",
                                                "sense_id": "47b7c97b-9be8-3539-93e4-d27f7607a8df",
                                                "text": "Christus duldde dat de zijnen dwaalden, ook na ontvangst van de Parakleet, maar niet tot op een punt dat het geloof gevaar zou lopen; zoals we ook nu toegeven dat de kerk ergens kan falen, zonder gevaar evenwel voor de vroomheid en het geloof."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d66a2fd-fe98-4309-81d4-e114c2d3a109",
                        "source_entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                        "source_sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                        "source_sense_description": "the Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful",
                        "target_lang_word": "Paraclet",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Paraclet",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                                        "entry_id": "3f272225-bb1a-3814-80de-b83b250785d0",
                                        "glosses": [
                                            "Autre nom du Saint-Esprit."
                                        ],
                                        "tags": [],
                                        "note": "Toujours déterminé avec l’article défini le",
                                        "examples": [
                                            {
                                                "example_id": "cb74e5ae-3139-4c04-acd3-0927e8b20805",
                                                "sense_id": "5acf1b63-6725-39db-bcf7-9695aef35690",
                                                "text": "Inséparable du Père et du Fils, l’Esprit saint n’en est pas moins présent à la vie des disciples, alors même que le départ de Jésus les laisserait quasiment « orphelins », s’il n’y avait justement le Paraclet pour les défendre contre le monde et leur donner de vivre en communion avec le Père et le Fils."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1745cbd0-db9a-4402-b65c-e8cc9b749fec",
                        "source_entry_id": "28302e80-1aae-34e3-aeeb-1e5ea9752f79",
                        "source_sense_id": "660a9ac0-2c6d-35bb-bbf1-a17fa7966fbd",
                        "source_sense_description": "the Holy Spirit, the Holy Ghost, especially in its role as comforter of the faithful",
