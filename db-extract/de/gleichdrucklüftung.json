                "senses": [
                    {
                        "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                        "entry_id": "fbe103fe-99e6-3bd3-aa78-6b64d3d524e9",
                        "glosses": [
                            "gleichmäßiger Transport von Luft in und aus einem Raum/System bei ausgeglichenem Luftdruck im Raum"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "313c7785-4bdf-4404-8c02-47c121c11e19",
                                "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                                "text": "„Bei der Gleichdrucklüftung werden sowohl für die Frischluftzufuhr, als auch für die Abluftabfuhr Ventilatoren verwendet.“"
                            },
                            {
                                "example_id": "93802544-0ea0-4f2e-80e6-5028491a3b42",
                                "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                                "text": "„Mit Gleichdrucklüftung läßt sich im Prinzip jedes Lüftungsproblem technisch lösen.“"
                            },
                            {
                                "example_id": "67fefec8-cb83-489b-bf93-75b8bb536a4f",
                                "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                                "text": "„Bei dieser Gleichdrucklüftung sind Zu- und Abluftmengen identisch.“"
                            },
                            {
                                "example_id": "6de58066-76e6-4558-bd0d-9f8b5aeb19c8",
                                "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                                "text": "„Eine Gleichdrucklüftung verhindert, dass Fehlluft über Auslauföffnungen die Lüftung beeinträchtigt.“"
                            },
                            {
                                "example_id": "bb22ee34-b8f3-45ad-be6d-2f31380d98a0",
                                "sense_id": "482162a0-48e4-3454-91f5-a84984948956",
                                "text": "„Bei der Gleichdrucklüftung werden Ventilatoren an Zuluftöffnungen im unteren Bereich und an Abluftöffnungen im oberen Bereich des Stalls angeordnet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
