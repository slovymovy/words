        "fr-extract.jsonl": [
            {
                "entry_id": "cf15cec9-2660-3977-b585-e62d1e0e4cc3",
                "word": "fichtre",
                "pos": "adv",
                "lang_code": "fr",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                        "entry_id": "cf15cec9-2660-3977-b585-e62d1e0e4cc3",
                        "glosses": [
                            "Renforcement d’un énoncé négatif placé après le verbe."
                        ],
                        "tags": [
                            "dated",
                            "euphemism"
                        ],
                        "examples": [
                            {
                                "example_id": "5e69c2b5-b4ff-405f-a002-41b6ab41bb37",
                                "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                                "text": "Et je ne vois fichtre pas ce qui peut t’exciter en faveur des Grecs. Ils ne sont pas intéressants."
                            },
                            {
                                "example_id": "fed359cc-4e1a-4484-8f67-6206065bca9e",
                                "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                                "text": "« Si je veux qu’il ait un peu de considération pour moi, se dit-il, et fichtre, c’est exactement ce que je veux, il ne faut surtout pas dire à cet homme, coquet comme un coq, que j’ai lavé des morts. »"
                            },
                            {
                                "example_id": "f3a38b6d-3175-4f53-9ab1-7dc30e0c7d40",
                                "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                                "text": "Je ne sais fichtre pas ce qu’il aurait pu m’apprendre, et encore pour cela, aurait-il fallu qu’il ouvre la bouche."
                            },
                            {
                                "example_id": "76c8079a-39ac-4ee9-b6b2-c4fe172d6cb7",
                                "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                                "text": "Il avait pris un soir son baluchon pour aller habiter chez une copine. Où précisément ? Peut-être du côté d’Élan ou de Villers-le-Tilleul. Il n’en savait fichtre rien."
                            },
                            {
                                "example_id": "f7ea08b6-4c09-4407-9be9-cd1e320f5b79",
                                "sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                                "text": "Voilà, incontestablement, un livre générationnel ! Hommes ou femmes de moins de 55 ans, passez votre chemin, vous n’y comprendriez fichtre rien."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bf9e2ff0-deea-4994-8b9a-7c92a45209d1",
                        "source_entry_id": "cf15cec9-2660-3977-b585-e62d1e0e4cc3",
                        "source_sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                        "source_sense_description": "Renforcement",
                        "target_lang_word": "gosh",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "gosh",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96b67901-6a62-3fef-9360-51554e51a647",
                                        "entry_id": "435e2ca7-69ef-39f2-ba1c-3dd07bbc1406",
                                        "glosses": [
                                            "A mild expression of surprise or enthusiasm."
                                        ],
                                        "tags": [
                                            "euphemistic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7235e9b5-eb38-4913-ac43-b94e2373e545",
                                                "sense_id": "96b67901-6a62-3fef-9360-51554e51a647",
                                                "text": "Gosh, I didn’t realize I’d cause so much trouble!"
                                            },
                                            {
                                                "example_id": "0dd6e814-ae2a-4cc1-9ab9-266870d34ec4",
                                                "sense_id": "96b67901-6a62-3fef-9360-51554e51a647",
                                                "text": "Gosh, I’d love to go to that concert!"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ae41d862-95ef-49c3-b988-efc41960d76f",
                        "source_entry_id": "cf15cec9-2660-3977-b585-e62d1e0e4cc3",
                        "source_sense_id": "c623a67d-76fd-31f4-bc7d-7dc8f14649bd",
                        "source_sense_description": "Renforcement",
                        "target_lang_word": "damn",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "damn",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "843cbf89-1109-4edb-9c3a-8ba77e17a4d4",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "The official position is that anyone who does this will be damned for all eternity."
                                            },
                                            {
                                                "example_id": "e60118bc-323c-4447-8c09-f0d0a8a49e56",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "Only God can damn."
                                            },
                                            {
                                                "example_id": "ac03afa1-3a41-45cb-a678-cc3736aae18b",
                                                "sense_id": "07b5ee10-d020-3d97-8fe3-430c1432469d",
                                                "text": "I damn you eternally, fiend!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn; to declare guilty; to doom; to adjudge to punishment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "422fd883-f626-4ac5-8f14-53f7dffed30e",
                                                "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                                "text": "He shall not live; look, with a spot I damn him."
                                            },
                                            {
                                                "example_id": "43fe2c20-f1cc-48be-abae-8b01732ef5fd",
                                                "sense_id": "59fa85cc-e36a-3224-a6aa-0b7c8124346b",
                                                "text": "Lack of access to support services can damn children with disabilities and lesser means to lives where they never harness their full range of abilities."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cf89c886-0dff-3065-a5b7-a5135a570ec7",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To put out of favor; to ruin; to label negatively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d434b8a8-bf0a-4667-9350-425f0058c8c0",
                                                "sense_id": "cf89c886-0dff-3065-a5b7-a5135a570ec7",
                                                "text": "I’m afraid that if I speak out on this, I’ll be damned as a troublemaker."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To condemn as unfit, harmful, invalid, immoral or illegal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "51cf55f7-5437-4944-9492-1bba04ca12b6",
                                                "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                                "text": "1708 November 8, Alexander Pope, letter to Henry Cromwell\nYou are not so arrant a critic as to damn them [the works of modern poets] […] without hearing."
                                            },
                                            {
                                                "example_id": "d67b30e9-a46b-493e-bb31-0a871146c246",
                                                "sense_id": "5997a55a-b85c-3515-90c4-94731692b2ab",
                                                "text": "Homosexuality and suicide have some common characteristics. Both are damned by the Western Judeo-Christian culture as sins (although the latter has only been considered such since the sixth century)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8e53af48-71a6-3e2f-a75e-f44245caaafc",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To curse; put a curse upon."
                                        ],
                                        "tags": [
                                            "sometimes",
                                            "vulgar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "23068781-c886-4201-940c-b95bf561ce75",
                                                "sense_id": "8e53af48-71a6-3e2f-a75e-f44245caaafc",
                                                "text": "That man stole my wallet. Damn him!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e391e11f-9191-3611-aa37-1913ffc59332",
                                        "entry_id": "8a4424af-9ed8-37ce-a1e3-a706b3bafe4c",
                                        "glosses": [
                                            "To invoke damnation; to curse."
                                        ],
                                        "tags": [
                                            "archaic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "170765fd-056e-41b5-a6bb-0f7b758a37b0",
                                                "sense_id": "e391e11f-9191-3611-aa37-1913ffc59332",
                                                "text": "c. 1767-1774, Oliver Goldsmith, letter to Mrs. Bunbury\n[…] while I inwardly damn."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
