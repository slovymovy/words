        "fr-extract.jsonl": [
            {
                "entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                "word": "sushi",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ee5a9799-7b23-4c59-8722-d813950af307",
                        "entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                        "tags": [
                            "plural"
                        ],
                        "form": "sushis"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0485543c-095a-3b85-91d3-e55501546431",
                        "entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                        "glosses": [
                            "Préparation culinaire d’origine japonaise à base de riz vinaigré et de poisson cru ou de légume."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8509e89-2aaf-4538-8509-a725ce51a4bf",
                                "sense_id": "0485543c-095a-3b85-91d3-e55501546431",
                                "text": "C’était Rinri qui préparait les repas. Il cuisinait mal, mais mieux que moi, […]. Au lieu de lui signifier que c’était inavalable, je lui parlais de ma passion pour les sashimis et les sushis."
                            },
                            {
                                "example_id": "f363a4b0-c3e8-4677-9596-07459deb3933",
                                "sense_id": "0485543c-095a-3b85-91d3-e55501546431",
                                "text": "Allons manger des sushi de l’autre coté de la rue. Ma famille nous attend à la porte du restaurant."
                            },
                            {
                                "example_id": "8d7e0e62-d7df-4b1c-b535-f415b0dec88e",
                                "sense_id": "0485543c-095a-3b85-91d3-e55501546431",
                                "text": "Ses yeux s’agrandirent comme elle l’interrompait.\n — J’adore les sushis. Et la pizza. Mais surtout les sushis."
                            }
                        ]
                    },
                    {
                        "sense_id": "234da594-cba6-30d5-b2a9-b2fab90e4292",
                        "entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                        "glosses": [
                            "Type de restaurant où l’on peut manger ou acheter des sushis."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "18f35b1c-1d18-49a6-811f-72b6be4b9ec4",
                                "sense_id": "234da594-cba6-30d5-b2a9-b2fab90e4292",
                                "text": "La première fois, j’invite plutôt une fille au McDo ou au sushi, parce que le cadre est plus favorable. Question de déco, d’ambiance. Le grec, ça leur fait un peu peur. Mais une fois qu’on est ensemble, on peut y aller sans souci."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5087512-6b3c-49ac-94b4-e9dc4c1d255c",
                        "source_entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                        "target_lang_word": "Sushi",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sushi",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "93a0100c-00cb-398a-a414-3c8343a8a54b",
                                        "entry_id": "a7360f60-f4ce-36e8-b1b0-15fecf0736eb",
                                        "glosses": [
                                            "japanische Speise aus gekochtem Reis und rohem Fisch; ursprünglich jede häppchenweise Speise mit essiggetränktem Reis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "59fe2349-70d7-4036-9043-30086edeb3c3",
                                                "sense_id": "93a0100c-00cb-398a-a414-3c8343a8a54b",
                                                "text": "Heute bestellen wir mal was nach Hause. Möchtest du lieber Pizza oder Sushi?"
                                            },
                                            {
                                                "example_id": "306925ff-a5b9-4658-945c-2d629afac0e1",
                                                "sense_id": "93a0100c-00cb-398a-a414-3c8343a8a54b",
                                                "text": "„Sushi ist nicht nur das Essen der ästhetisch veranlagten Damen, es versprüht auch nach wie vor den Glanz sowohl der weiten als auch der reichen Welt.“"
                                            },
                                            {
                                                "example_id": "5f64f6bb-840d-4b62-b3a1-dc5121b0d814",
                                                "sense_id": "93a0100c-00cb-398a-a414-3c8343a8a54b",
                                                "text": "„Der Lachs war weder geräuchert, noch gebeizt und wir aßen die dünnen Scheiben wie frisches Sushi roh und ohne weitere Zutaten.“"
                                            },
                                            {
                                                "example_id": "0dfc4ba0-57c5-40bb-922b-b9977ae892e2",
                                                "sense_id": "93a0100c-00cb-398a-a414-3c8343a8a54b",
                                                "text": "„Eine japanische Mutter sprach sich für Sushi aus.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "93a014cd-8ab0-4a9e-bfbd-b4aad9d6c3c8",
                        "source_entry_id": "38e75f44-91a0-3341-aff3-f6f7c00c4c66",
                        "target_lang_word": "sushi",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sushi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                        "entry_id": "bf420f1a-b9c3-3947-8426-5742b4c85a5b",
                                        "glosses": [
                                            "A Japanese dish made of small portions of sticky white rice flavored with vinegar, usually wrapped in seaweed and filled or topped with fish, vegetables or meat."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c7aa9fd6-69aa-4455-a0bf-48fa1b0116d5",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "For the vegetarians, she served cucumber sushi."
                                            },
                                            {
                                                "example_id": "5dfd760a-767b-476b-aa4e-f44cc50b777e",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "He went to a Japanese restaurant and ordered sushi and noodles."
                                            },
                                            {
                                                "example_id": "0076a086-94ba-4a44-83af-959cc42eaf8b",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "Suzuributa.—Mashed fish, eggs, 'sushi' of shrimps, plum cake, black mushroom, plum, and finely cut orange."
                                            },
                                            {
                                                "example_id": "74dc5edd-2c53-49df-8e0a-62969908edf7",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "Not long ago a newspaper reporter came to interview me on the subject of unusual foods, and I described to him the persimmon-leaf sushi made by the people who live deep in the mountains of Yoshino—and which I shall take the opportunity to introduce to you here."
                                            },
                                            {
                                                "example_id": "24de5678-9d36-437e-9cbb-5b6d9339564f",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "I lived in New York all my life. We used to have Chinese restaurants, ltalian restaurants. Now you have these sushi restaurants. Everyone goes for sushi. Sushi—I hate the stuff. Although, I tell you, I had some the other day. I took it home, I cooked it, it wasn't bad. It tasted like fish."
                                            },
                                            {
                                                "example_id": "42601615-c656-43cf-a31d-507d201b6280",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "To appreciate sushi, you have to forget the tastes and textures that come with Western cuisine. At first glance (or should I say taste?), a sushi of flounder will not be that different from a sushi of sea bream. But, for the Japanese, these two sushi are as different as roast beef and roast pork are for a Westerner."
                                            },
                                            {
                                                "example_id": "4783212b-ead5-4fd6-b84b-de53e3695852",
                                                "sense_id": "022e963e-9e60-36d4-9522-22fec19ee940",
                                                "text": "As Trevor Corson, author of “The Story of Sushi” explains, in Japan, sushi is typically eaten at a bar, where it’s customary for the customer to chat with the chef, who can recommend what’s in season. The short window during which the fish is fresh also makes it more likely to be tastier in Japan."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "04bc9413-c83b-3cc5-bcb3-3dabe9a9070e",
                                        "entry_id": "bf420f1a-b9c3-3947-8426-5742b4c85a5b",
                                        "glosses": [
                                            "One of the portions from this dish."
                                        ],
                                        "tags": [
                                            "countable",
                                            "rare",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "29dfe97b-189c-4385-a4a8-4adc542d6eb7",
                                                "sense_id": "04bc9413-c83b-3cc5-bcb3-3dabe9a9070e",
                                                "text": "I reach out and pop a sushi into my mouth while I’m waiting for someone to answer a question."
                                            },
                                            {
                                                "example_id": "1db5f282-3b9c-4f30-b271-7d9b19ea8569",
                                                "sense_id": "04bc9413-c83b-3cc5-bcb3-3dabe9a9070e",
                                                "text": "You will recall that, contrary to the relative appearance of the words, the sashimi are the simple raw fish slices and the sushi are the rolls of rice and raw fish."
                                            },
                                            {
                                                "example_id": "28a2550d-0823-43f0-bdce-292afe206b2a",
                                                "sense_id": "04bc9413-c83b-3cc5-bcb3-3dabe9a9070e",
                                                "text": "Rusty put a sushi in her palm. / Mary Kate popped it into her mouth. It tasted salty and crunchy. “Cucumber!” she said. / “My grandmother puts a surprise in the middle of each one,” said Rusty."
                                            },
                                            {
                                                "example_id": "6cb22b14-c894-473a-b8ba-144460558197",
                                                "sense_id": "04bc9413-c83b-3cc5-bcb3-3dabe9a9070e",
                                                "text": "Startled by the venom, Erik almost dropped a sushi into his mixture of soy sauce and wasabi."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6146dedf-7af5-3c3f-96b0-eaab75caec6c",
                                        "entry_id": "bf420f1a-b9c3-3947-8426-5742b4c85a5b",
                                        "glosses": [
                                            "Raw fish, especially as a Japanese dish."
                                        ],
                                        "tags": [
                                            "proscribed",
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7a1825b2-bd79-4f51-9207-0e9649449dff",
                                                "sense_id": "6146dedf-7af5-3c3f-96b0-eaab75caec6c",
                                                "text": "'Can't eat sushi?' I said. Then Mom said, 'You can't eat uncooked fish when you're pregnant' as if I'm the one stupid enough to go and get pregnant!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sushi",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "49924298-cae3-3bb2-bdfe-01608b153657",
                                        "entry_id": "a84e829d-9c51-3ff4-8325-f0b3a4b625a2",
                                        "glosses": [
                                            "To prepare (a food) as sushi."
                                        ],
                                        "tags": [
                                            "informal",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8c4efe68-2c2b-47a8-bffb-4bdb03160327",
                                                "sense_id": "49924298-cae3-3bb2-bdfe-01608b153657",
                                                "text": "Our finned friends come in all varieties: sushi-ed, fresh, smoked and otherwise packaged for your consumption."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
