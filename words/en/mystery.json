{
    "word_family": [
        "mysterious",
        "mysteriously",
        "mystify",
        "mystification",
        "mystique"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f2c1cd0a-ed5a-33bf-bb85-8d8c2f7dca4a",
                    "sense_definition": "Something that is difficult or impossible to understand, explain, or identify.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "unknown_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The true cause of the sudden fire remains a <w>mystery</w> to the investigators.",
                            "target_lang_translations": {
                                "ru": "Истинная причина внезапного пожара остается <w>тайной</w> для следователей.",
                                "zh": "这场突发火灾的真正原因对调查人员来说仍然是一个<w>谜</w>。"
                            }
                        },
                        {
                            "text": "It is a <w>mystery</w> how the cat managed to get onto the roof of the house.",
                            "target_lang_translations": {
                                "ru": "Остается <w>загадкой</w>, как кошке удалось забраться на крышу дома.",
                                "zh": "这只猫是怎么爬上屋顶的，简直是个<w>谜</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enigma",
                        "puzzle",
                        "secret"
                    ],
                    "common_phrases": [
                        "solve a mystery",
                        "remain a mystery",
                        "shrouded in mystery",
                        "unsolved mystery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Что-то, что трудно или невозможно понять, объяснить или определить.",
                        "zh": "难以理解、解释或识别的事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайна",
                                "target_lang_sense_clarification": "нечто скрытое или неизвестное"
                            },
                            {
                                "target_lang_word": "загадка",
                                "target_lang_sense_clarification": "необъяснимое событие или явление"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谜",
                                "target_lang_sense_clarification": "难以解释的事物"
                            },
                            {
                                "target_lang_word": "奥秘",
                                "target_lang_sense_clarification": "深奥且难以理解的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9a334e0d-84ba-3cb7-a910-39d590f00106",
                    "sense_definition": "A story, book, or film that involves a crime or puzzle to be solved, often focusing on the investigation.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She loves reading a gripping murder <w>mystery</w> before going to sleep.",
                            "target_lang_translations": {
                                "ru": "Она любит читать захватывающий <w>детектив</w> об убийстве перед сном.",
                                "zh": "她喜欢在睡前读一本扣人心弦的谋杀<w>侦探小说</w>。"
                            }
                        },
                        {
                            "text": "The author is famous for writing a popular <w>mystery</w> series set in Victorian London.",
                            "target_lang_translations": {
                                "ru": "Автор известен своей популярной серией <w>детективов</w>, действие которых происходит в викторианском Лондоне.",
                                "zh": "这位作者以撰写以维多利亚时代伦敦为背景的流行<w>侦探小说</w>系列而闻名。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "murder mystery",
                        "mystery novel",
                        "mystery writer",
                        "mystery movie"
                    ],
                    "target_lang_definitions": {
                        "ru": "Произведение (книга, фильм), в котором расследуется преступление или загадочное событие.",
                        "zh": "涉及犯罪或谜题并侧重于调查过程的故事、书籍或电影。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "детектив",
                                "target_lang_sense_clarification": "жанр литературы или кино"
                            },
                            {
                                "target_lang_word": "детективный роман",
                                "target_lang_sense_clarification": "книга о расследовании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "侦探小说",
                                "target_lang_sense_clarification": "文学体裁"
                            },
                            {
                                "target_lang_word": "悬疑片",
                                "target_lang_sense_clarification": "电影体裁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "afdb1d30-3449-3333-a8c1-b9417b41ced1",
                    "sense_definition": "A person or thing that is strange, secretive, or puzzling in nature.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "unknown_nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her past is a complete <w>mystery</w> to everyone in the small town.",
                            "target_lang_translations": {
                                "ru": "Её прошлое — полная <w>загадка</w> для всех в этом маленьком городке.",
                                "zh": "对这个小镇上的每个人来说，她的过去完全是个<w>谜</w>。"
                            }
                        },
                        {
                            "text": "That man is a <w>mystery</w> to me because he never talks about himself.",
                            "target_lang_translations": {
                                "ru": "Этот человек для меня — <w>загадка</w>, потому что он никогда не говорит о себе.",
                                "zh": "那个男人对我来说是个<w>谜</w>，因为他从不谈论自己。"
                            }
                        }
                    ],
                    "synonyms": [
                        "enigma"
                    ],
                    "common_phrases": [
                        "be a mystery to someone"
                    ],
                    "target_lang_definitions": {
                        "ru": "Человек или предмет, странный или загадочный по своей природе.",
                        "zh": "性质奇怪、隐秘或令人困惑的人或事物。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "загадка",
                                "target_lang_sense_clarification": "о человеке или его поведении"
                            },
                            {
                                "target_lang_word": "тайна",
                                "target_lang_sense_clarification": "нечто непостижимое"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谜",
                                "target_lang_sense_clarification": "指代难以捉摸的人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a996965f-46c5-3b84-9df3-ecd68652a1eb",
                    "sense_definition": "A religious truth that is beyond human reason and is known only through divine revelation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "religious_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The priest explained the <w>mystery</w> of faith to the gathered congregation.",
                            "target_lang_translations": {
                                "ru": "Священник объяснил собравшимся прихожанам <w>тайну</w> веры.",
                                "zh": "牧师向聚集的会众解释了信仰的<w>奥秘</w>。"
                            }
                        },
                        {
                            "text": "Many theological concepts are considered a divine <w>mystery</w> that cannot be fully grasped by logic.",
                            "target_lang_translations": {
                                "ru": "Многие богословские концепции считаются божественной <w>тайной</w>, которую невозможно полностью постичь логикой.",
                                "zh": "许多神学概念被视为无法完全通过逻辑理解的神圣<w>奥秘</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mystery of faith",
                        "divine mystery"
                    ],
                    "target_lang_definitions": {
                        "ru": "Религиозная истина, выходящая за пределы человеческого разума и познаваемая только через откровение.",
                        "zh": "超越人类理性，仅能通过神圣启示获知的宗教真理。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тайна",
                                "target_lang_sense_clarification": "божественная истина"
                            },
                            {
                                "target_lang_word": "таинство",
                                "target_lang_sense_clarification": "религиозный догмат"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "奥秘",
                                "target_lang_sense_clarification": "宗教上的深奥真理"
                            },
                            {
                                "target_lang_word": "圣事",
                                "target_lang_sense_clarification": "宗教仪式或神圣教义"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "facc55d9-755c-3b24-8365-a25c217cac22",
                    "sense_definition": "A secret religious rite or ceremony, especially in ancient Greece or Rome, open only to initiates.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religious_concept",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Initiates were sworn to absolute secrecy regarding the rituals of the Eleusinian <w>mysteries</w>.",
                            "target_lang_translations": {
                                "ru": "Посвященные клялись хранить абсолютную тайну относительно ритуалов Элевсинских <w>мистерий</w>.",
                                "zh": "入会者被要求对厄琉息斯<w>秘仪</w>的仪式绝对保密。"
                            }
                        },
                        {
                            "text": "Historians have uncovered ruins related to the ancient <w>mysteries</w> celebrated in this temple.",
                            "target_lang_translations": {
                                "ru": "Историки обнаружили руины, связанные с древними <w>мистериями</w>, проводившимися в этом храме.",
                                "zh": "历史学家发现了与这座神庙中举行的古代<w>秘仪</w>相关的遗迹。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "refers to historical religious practices"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Тайный религиозный обряд или церемония, особенно в Древней Греции или Риме, доступные только посвященным.",
                        "zh": "秘密的宗教仪式或典礼，尤指古希腊或古罗马时期仅限入会者参加的仪式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мистерия",
                                "target_lang_sense_clarification": "античный тайный культ"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "秘仪",
                                "target_lang_sense_clarification": "古代秘密宗教仪式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9de9278f-e3c9-3a73-b106-4ee31e367499",
                    "sense_definition": "A medieval dramatic play based on biblical stories or the lives of saints.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The local guild performed a <w>mystery</w> in the town square during the festival.",
                            "target_lang_translations": {
                                "ru": "Местная гильдия разыграла <w>мистерию</w> на городской площади во время праздника.",
                                "zh": "当地行会在节日期间在城镇广场表演了一出<w>神秘剧</w>。"
                            }
                        },
                        {
                            "text": "Scholars study the text of the old <w>mystery</w> to understand medieval culture.",
                            "target_lang_translations": {
                                "ru": "Ученые изучают текст старинной <w>мистерии</w>, чтобы понять средневековую культуру.",
                                "zh": "学者们研究古老的<w>神秘剧</w>文本以了解中世纪文化。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mystery play"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "historical literary term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Средневековая драматическая пьеса, основанная на библейских сюжетах.",
                        "zh": "基于圣经故事或圣徒生平的中世纪戏剧。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мистерия",
                                "target_lang_sense_clarification": "жанр средневекового театра"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "神秘剧",
                                "target_lang_sense_clarification": "中世纪戏剧体裁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e775720b-470c-395e-add0-568a801f6425",
                    "sense_definition": "A skilled trade, craft, or profession, or a guild of such craftsmen.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was sent to the city to learn the <w>mystery</w> of goldsmithing as an apprentice.",
                            "target_lang_translations": {
                                "ru": "Его отправили в город, чтобы он обучился <w>ремеслу</w> ювелира в качестве подмастерья.",
                                "zh": "他被送到城里作为学徒去学习金匠的<w>手艺</w>。"
                            }
                        },
                        {
                            "text": "The ancient laws regulated the various <w>mysteries</w> and their members within the city walls.",
                            "target_lang_translations": {
                                "ru": "Древние законы регулировали различные <w>ремесла</w> и их представителей в стенах города.",
                                "zh": "古代法律对城墙内的各种<w>行会</w>及其成员进行了规范。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Квалифицированное ремесло, мастерство или профессия (устаревшее значение).",
                        "zh": "熟练的行业、手艺、职业或此类工匠的行会（古语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ремесло",
                                "target_lang_sense_clarification": "профессия, занятие"
                            },
                            {
                                "target_lang_word": "мастерство",
                                "target_lang_sense_clarification": "искусство в деле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "手艺",
                                "target_lang_sense_clarification": "职业或技能"
                            },
                            {
                                "target_lang_word": "行会",
                                "target_lang_sense_clarification": "工匠组织"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}