        "fr-extract.jsonl": [
            {
                "entry_id": "6e04b3a4-0f2e-3c5f-ab80-e5ed95a3fa03",
                "word": "agricole",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "3a465e93-68f5-443b-a281-bf5e160c726c",
                        "entry_id": "6e04b3a4-0f2e-3c5f-ab80-e5ed95a3fa03",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "agricoles"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "1a902296-2f26-3ab2-b812-4df57bee339f",
                        "entry_id": "6e04b3a4-0f2e-3c5f-ab80-e5ed95a3fa03",
                        "glosses": [
                            "Qui s’adonne à l’agriculture. Il est presque toujours joint à un nom collectif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "910a57b1-0b77-42c8-9059-004176866678",
                                "sense_id": "1a902296-2f26-3ab2-b812-4df57bee339f",
                                "text": "Un peuple, une nation, un pays agricole."
                            }
                        ]
                    },
                    {
                        "sense_id": "54a9029a-ef5e-33b2-a58c-a19c2eed65d3",
                        "entry_id": "6e04b3a4-0f2e-3c5f-ab80-e5ed95a3fa03",
                        "glosses": [
                            "Qui a rapport à l’agriculture."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5cb711f-3d09-47eb-8cf5-c2bd1d6ca158",
                                "sense_id": "54a9029a-ef5e-33b2-a58c-a19c2eed65d3",
                                "text": "Mais au-delà, il n’est plus possible de différer la réflexion et les décisions pour faire évoluer les modèles agricoles et sylvicoles."
                            },
                            {
                                "example_id": "d69e6798-8fbd-458b-a8b3-7d884f2786b6",
                                "sense_id": "54a9029a-ef5e-33b2-a58c-a19c2eed65d3",
                                "text": "Grâce à la nature du sol (tirs et hamri) et à l’abondance des précipitations, une grande partie de la zone côtière se prête admirablement à l’exploitation agricole."
                            },
                            {
                                "example_id": "0a466036-712e-4bf9-90c4-575ba2cb5730",
                                "sense_id": "54a9029a-ef5e-33b2-a58c-a19c2eed65d3",
                                "text": "Le ramassage des pommes de terre est une opération agricole exécutée la plupart du temps d’une façon manuelle."
                            },
                            {
                                "example_id": "d5aee362-e6d5-4d59-92f6-a7522c3b1d48",
                                "sense_id": "54a9029a-ef5e-33b2-a58c-a19c2eed65d3",
                                "text": "Cet ouvrage ne prétend donc pas aborder l’ensemble des aspects de la gestion de l’exploitation agricole."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "2ef39648-a164-47e4-99ce-913a28f21d81",
                        "source_entry_id": "6e04b3a4-0f2e-3c5f-ab80-e5ed95a3fa03",
                        "source_sense_description": "2. Qui a rapport à l’agriculture.",
                        "target_lang_word": "landwirtschaftlich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "landwirtschaftlich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                        "entry_id": "0a556187-0f8d-3bc5-80d7-867294d40ff2",
                                        "glosses": [
                                            "die Landwirtschaft betreffend, auf ihr beruhend, von ihr herrührend, zu ihr gehörend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a272cbe-01fa-49c3-b61d-549c9d78d881",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "Mein Vater hat einen landwirtschaftlichen Betrieb. Er ist Bauer."
                                            },
                                            {
                                                "example_id": "2a75a429-c319-4c32-918d-d365642ed8bd",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "Obwohl sie das Leben in der Großstadt mag, braucht sie die Natur und die Bodennähe, die ein landwirtschaftlicher Beruf mit sich bringt."
                                            },
                                            {
                                                "example_id": "00512143-8612-4f47-ae76-ea1aa55ddcce",
                                                "sense_id": "d785ca1e-ab4b-3958-9e42-616222ffe000",
                                                "text": "„Doch zu einem geringen Maße bauen sie auch Kartoffeln an und halten Kleinvieh wie Hühner und Schweine, landwirtschaftliche Techniken, die sie von ihren Nachbarn, den Aymará übernommen haben“."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1d0dd858-8077-3a84-8b2c-87150b0350dd",
                                        "entry_id": "0a556187-0f8d-3bc5-80d7-867294d40ff2",
                                        "glosses": [
                                            "der Landwirtschaft dienend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "047432d8-e139-4c92-8b97-5ca01a70c3bc",
                                                "sense_id": "1d0dd858-8077-3a84-8b2c-87150b0350dd",
                                                "text": "Diese [nachhaltige Landnutzung] sind nicht nur für die lokale Ernährungssicherung von hoher Relevanz, sondern auch für die landwirtschaftliche, medizinische und biotechnologische Forschung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1cdb8fef-f555-43b5-855e-fa5abbad1d9c",
