        "fr-extract.jsonl": [
            {
                "entry_id": "1a7a6b79-ef50-3fe5-a194-5c534936380d",
                "word": "rebec",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "eee62def-0e72-4367-8e8f-53e8009017ba",
                        "entry_id": "1a7a6b79-ef50-3fe5-a194-5c534936380d",
                        "tags": [
                            "plural"
                        ],
                        "form": "rebecs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "39baacb4-907d-390c-866e-4a95d8b530e7",
                        "entry_id": "1a7a6b79-ef50-3fe5-a194-5c534936380d",
                        "glosses": [
                            "Ancien instrument de musique à archet et monté de trois ou quatre cordes, qui était joué par les ménestrels et les jongleurs au Moyen Âge."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c1bc6b1a-612e-4e30-ad4d-1d688eeb064e",
                                "sense_id": "39baacb4-907d-390c-866e-4a95d8b530e7",
                                "text": "La feuillée verte et touffue : un clerc du gai savoir qui voyage avec sa gourde et son rebec […]"
                            },
                            {
                                "example_id": "404bac92-9a71-4b2c-b8ec-5b937e11ae65",
                                "sense_id": "39baacb4-907d-390c-866e-4a95d8b530e7",
                                "text": "Son front ridé comme une botte à la hussarde ; son nez de perroquet, ses joues de chèvre lui donnaient une apparence des plus fantastiques, et si, au lieu de castagnettes, il avait eu en main un rebec gothique, il aurait pu poser pour le coryphée de la danse des morts sur la fresque de Bâle."
                            },
                            {
                                "example_id": "72ff8f73-f52f-4ce6-be78-a601f50f75ab",
                                "sense_id": "39baacb4-907d-390c-866e-4a95d8b530e7",
                                "text": "À une époque voisine de la nôtre, le rebec donnait encore des signes d’existence. Il avait été spécialement attribué aux apprentis ménétriers, aux musiciens de guinguettes, de foire et de village, à qui des ordonnances de police, rendues dès le XVIIᵉ siècle, interdisaient l’usage des basses, dessus et autres parties de violon […]."
                            },
                            {
                                "example_id": "5e74d390-61ca-43f9-b3de-72bfcc8e01d4",
                                "sense_id": "39baacb4-907d-390c-866e-4a95d8b530e7",
                                "text": "Entre deux accords de rebec, de luth ou de târ, des chansonniers improvisent sur leur thème favori : Nizam-el-Molk."
                            }
                        ]
                    }
                ],
                "translations": [
