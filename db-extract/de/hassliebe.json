                        "sense_id": "4125c0d4-b3ce-30c7-a76a-3dd5fa7135d6",
                        "entry_id": "9cb07965-9ef2-38cc-95d6-c71774a5aa97",
                        "glosses": [
                            "love-hate relationship"
                        ],
