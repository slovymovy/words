                                        "glosses": [
                                            "A person who claims or is alleged to perform miracles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8bd9fd2-1cfd-4c06-8404-356f632e5d40",
                                                "sense_id": "d551dbbe-e44b-35d9-813b-5b34926da8ae",
                                                "text": "Eddie was the right choice to rescue their season because he knows about the Premier League, what it is like to be at the bottom end, and what it takes to survive.\nBut he is not a miracle worker, and he has taken charge of a squad that is seriously lacking."
                                            }
                                        ]
                                    },
