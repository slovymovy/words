                                "target_senses": [
                                    {
                                        "sense_id": "2a0e31ca-7511-34bd-80cb-cefa1b9cb08a",
                                        "entry_id": "5ae9434b-b775-38cd-b075-0a534b10224a",
                                        "glosses": [
                                            "Ensemble des activités industrielles visant à transformer des produits agricoles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e333d828-9c7b-4f54-ae58-ceccd9099871",
                                                "sense_id": "2a0e31ca-7511-34bd-80cb-cefa1b9cb08a",
                                                "text": "Il est temps de défaciliter tout ce que l’agro-industrie a facilité."
                                            },
                                            {
                                                "example_id": "2b5a0c86-e189-4106-8771-2ac7a2208af5",
                                                "sense_id": "2a0e31ca-7511-34bd-80cb-cefa1b9cb08a",
                                                "text": "Basée au Mas-d’Azil (Ariège), cette association écolo fondée en 1999 par Dominique Guillet se bat pour « libérer » les semences potagères du joug de l’agro-industrie type Monsanto."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
