                    {
                        "sense_id": "ca151c07-a713-3042-85b4-234d5d007237",
                        "entry_id": "fcd93ef7-2f10-3d23-beff-da13cff209fb",
                        "glosses": [
                            "Sorte de roche composée de sels et formée durant une phase d'évaporation."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "12b75c02-a7e9-4422-b76a-604b6c08842a",
                                "sense_id": "ca151c07-a713-3042-85b4-234d5d007237",
                                "text": "La couverture est formée par les évaporites d'une formation que l'on peut assimiler au Fars, la Upper Red Formation. Les évaporites y sont particulièrement abondantes à la base (sel et anhydrite) et forment une excellente couverture."
                            },
                            {
                                "example_id": "e32b3270-0ed0-4717-a64a-a1bb59886fdd",
                                "sense_id": "ca151c07-a713-3042-85b4-234d5d007237",
                                "text": "Des baguettes d'anhydrite résiduelle demeurent quelquefois en abondance dans les nodules, observation également effectuée sur les évaporites messiniennes de Méditerranée (Schreiber et al. , 1976, p. 740)."
                            }
                        ]
                    }
                ],
