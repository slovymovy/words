                        "entry_id": "6ff0e6a6-0f93-3840-8b53-482e6f746b17",
                        "glosses": [
                            "het zekere weten zonder waarneming, vaak betrekking hebbend op een opperwezen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8b73e595-5048-4b5f-8ee7-1591aa0d4738",
                                "sense_id": "9176884f-018e-34bd-ae8f-0f0c9c8f9206",
                                "text": "Voor sommige mensen met een geloofsovertuiging is die geloofsovertuiging het richtsnoer voor hun dagelijks handelen."
                            },
                            {
                                "example_id": "908e888f-e418-4749-a5a7-0e518bcc8f8e",
                                "sense_id": "9176884f-018e-34bd-ae8f-0f0c9c8f9206",
                                "text": "„Rechtsstatelijk ontstaan er risico’s wanneer bepaalde geloofsovertuigingen het zelfbeschikkingsrecht van anderen aantasten.”"
                            }
                        ]
                    }
                ],
