                    "frequency": "Middle",
                    "semantic_group_id": "drogue",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il avait les yeux rouges et semblait complètement <w>défoncé</w> après cette soirée.",
                            "target_lang_translations": {
                                "en": "He had red eyes and seemed completely <w>stoned</w> after that party.",
                                "ru": "У него были красные глаза, и после той вечеринки он выглядел совершенно <w>обдолбанным</w>.",
                                "de": "Er hatte rote Augen und wirkte nach diesem Abend völlig <w>berauscht</w>.",
                                "es": "Tenía los ojos rojos y parecía completamente <w>colocado</w> después de aquella fiesta.",
                                "zh": "那次聚会后，他眼睛红红的，看上去完全<w>嗨</w>了。"
                            }
                        },
                        {
                            "text": "Elle refusait de monter dans la voiture d'un conducteur manifestement <w>défoncé</w>.",
                            "target_lang_translations": {
                                "en": "She refused to get into the car of a driver who was obviously <w>high</w>.",
                                "ru": "Она отказывалась садиться в машину явно <w>обдолбанного</w> водителя.",
                                "de": "Sie weigerte sich, in das Auto eines offensichtlich <w>zugedröhnten</w> Fahrers einzusteigen.",
                                "es": "Se negaba a subirse al coche de un conductor que evidentemente estaba <w>colocado</w>.",
                                "zh": "她拒绝坐上一位明显<w>烂醉</w>的司机的车。"
                            }
                        }
