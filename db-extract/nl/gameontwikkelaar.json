                        "examples": [
                            {
                                "example_id": "54b41040-4d34-42ef-af85-34aadd00d58b",
                                "sense_id": "93873e25-0478-34b5-b923-6feb887a2314",
                                "text": "Steeds meer vrouwen gamen, vooral op mobiel. En dat zie je op Gamescom eigenlijk aan alles: het publiek, de ontwikkelaars en de spellen. “Gamen is mainstream”, zegt Krista Hendriks van de Dutch Game Association, waar ze vanuit de overheid jonge Nederlandse gameontwikkelaars ondersteunen."
                            }
                        ]
                    },
                    {
                        "sense_id": "6d929ea7-5ae3-3553-a7b3-b74bb26ad0c0",
                        "entry_id": "c62763e1-c677-3bac-a7c4-0e406ab41f90",
                        "glosses": [
                            "bedrijf dat computerspellen ontwikkelt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "793f42fa-da42-4d9f-b1fe-a7e8fce5894c",
                                "sense_id": "6d929ea7-5ae3-3553-a7b3-b74bb26ad0c0",
                                "text": "Nabestaanden van de Angolese rebellenleider Jonas Savimbi klagen gameontwikkelaar Activision aan. Drie kinderen van Savimbi vinden dat hun vader in schietspel Call of Duty: Black Ops II als een barbaar wordt neergezet die iedereen wil afslachten, schrijft The Guardian."
                            },
                            {
                                "example_id": "0e00b3d4-68e2-408c-aca5-14f5ed76f03e",
                                "sense_id": "6d929ea7-5ae3-3553-a7b3-b74bb26ad0c0",
                                "text": "Jesse van Dijk is hoofd concept designer van de game Destiny. Vanuit een ondergrondse bunker vertelt hij over zijn werk bij gameontwikkelaar Bungie. \"Dit is eigenlijk het project waar ik altijd al op hoopte dat ik er aan mee zou werken.\""
                            }
                        ]
                    }
