                        "entry_id": "4a5858bd-9128-3d2c-8d28-39f01001d6e5",
                        "glosses": [
                            "aggressive Äußerung oder Kampagne gegen jemanden oder etwas"
                        ],
                        "tags": [
                            "figurative"
                        ],
                        "examples": [
                            {
                                "example_id": "297608d0-308c-447e-9f25-d959ed4f9a57",
                                "sense_id": "5b339058-2695-3acb-90d2-f1c1cfb8e7fc",
                                "text": "„Den Verteidiger hat er inzwischen gewechselt, der in Tirol bekannte Albert Heiss verteidigt ihn nun mit einem Frontalangriff auf die Ermittler.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
