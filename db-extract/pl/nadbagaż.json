                "senses": [
                    {
                        "sense_id": "8f71ce5b-f4a1-3260-bebf-ded81c13e876",
                        "entry_id": "80a60658-e441-342b-8d4f-e2adfda50722",
                        "glosses": [
                            "część bagażu lotniczego przekraczająca ciężarem granicę przewidzianą taryfą i z tego tytułu wymagająca dodatkowej opłaty"
                        ],
                        "tags": [],
                        "examples": [],
