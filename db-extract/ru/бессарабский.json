                        "examples": [
                            {
                                "example_id": "43f16b33-16f8-4cf4-a671-ad0a18d04772",
                                "sense_id": "0768f3e3-6a06-39b0-a5f3-e10c8b6f0e47",
                                "text": "Он вы́нул из холщо́вого мешка́ хлеб, деся́ток кра́сных помидо́ров, кусо́к бессара́бского сы́ра «бры́нзы» и буты́лку с прова́нским ма́слом.",
                                "translation": "He turned to his canvas bag, and took out a loaf, a dozen red tomatoes, a chunk of Bessarabian cheese and a bottle of olive oil.",
                                "english": "He turned to his canvas bag, and took out a loaf, a dozen red tomatoes, a chunk of Bessarabian cheese and a bottle of olive oil."
                            }
                        ]
                    }
