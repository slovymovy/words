                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d6e7a25e-1d2a-4cc5-9f44-2d0eab885fd3",
                        "source_entry_id": "f260a15f-f1aa-3b9e-bbab-c4a543854b2e",
                        "source_sense_id": "d556040f-fded-3aea-955d-7906b4ce49c2",
                        "target_lang_word": "exigency",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "exigency",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7bc930c8-a7be-3935-8ea5-88c140e357f4",
                                        "entry_id": "459b5ec2-aae2-318a-990e-1dfe139ba91e",
                                        "glosses": [
                                            "The demands or requirements of a situation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d29886cf-5cbe-40d7-8f86-7d81b590d0db",
                                                "sense_id": "7bc930c8-a7be-3935-8ea5-88c140e357f4",
                                                "text": "My business is with you, and you only. You should not have undertaken your office, unless prepared for its various exigencies."
                                            },
                                            {
                                                "example_id": "db95e7fc-985e-4d5d-ab62-caed1dc901ec",
                                                "sense_id": "7bc930c8-a7be-3935-8ea5-88c140e357f4",
                                                "text": "No ordinary man could have escaped those frightful claws when Numa sprang from so short a distance, but Tarzan was no ordinary man. From earliest childhood his muscles had been trained by the fierce exigencies of his existence to act with the rapidity of thought."
                                            },
                                            {
                                                "example_id": "3752b298-305e-4f05-8027-fae064af6d9f",
                                                "sense_id": "7bc930c8-a7be-3935-8ea5-88c140e357f4",
                                                "text": "[...] but these details I am compelled by exigencies of space to hold over until next month."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7d4dd05f-52d8-3457-95dd-d5db29b606e4",
                                        "entry_id": "459b5ec2-aae2-318a-990e-1dfe139ba91e",
                                        "glosses": [
                                            "An urgent situation, one requiring extreme effort or attention."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
