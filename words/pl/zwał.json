                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "террикон",
                                "target_lang_sense_clarification": "искусственная насыпь из пустых пород"
                            },
                            {
                                "target_lang_word": "отвал",
                                "target_lang_sense_clarification": "место сброса отходов"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0bc556e8-11ac-3f09-887a-077516b03794",
                    "sense_definition": "nagromadzenie odłamków skalnych u podnóża góry",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "sterta",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wspinacze musieli przejść przez stromy <w>zwał</w> skalny.",
                            "target_lang_translations": {
