                                "target_senses": [
                                    {
                                        "sense_id": "64a092d9-068a-3fa3-9516-7c774dc7a3ef",
                                        "entry_id": "b0fda29b-7d9e-3ec0-9314-f28f26556fcb",
                                        "glosses": [
                                            "stowarzyszenie osób pochodzących z tego samego regionu kraju oraz ich potomków identyfikujących się z regionem pochodzenia"
                                        ],
                                        "tags": [],
