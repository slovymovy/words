                ],
                "senses": [
                    {
                        "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                        "entry_id": "9b9b0cca-1056-39b0-adfc-7b3677d6b723",
                        "glosses": [
                            "eine bestimmtes Zeitfenster, in dem gezielt Ionisation stattfindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6826ab60-3945-46ee-8777-ca22fa867eb2",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„Die zwei Hauptfaktoren, die die Ionenanzahl beeinflussen, sind die Ionisationszeit und die Amplitude der RF Spannung während der Ionisation.“"
                            },
                            {
                                "example_id": "3f96f852-e0d9-42eb-b833-1a5d5ca0eaab",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„Um die Ionisationszeit zu optimieren muss sowohl auf die emittierte Wellenlänge als auch auf die optische Leistung geachtet werden.“"
                            },
                            {
                                "example_id": "0ff00253-b472-447d-a5be-b224efe53427",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„Misst man den Winkel der Elektronenflugrichtung, so kann man den Winkel des elektrischen Feldes zur Ionisationszeit berechnen, und dieser Winkel dreht sich während eines optischen Zyklus um 360°.“"
                            },
                            {
                                "example_id": "714e010b-e9ba-411b-acc4-6dcb10d06099",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„Für niedrige Konzentrationen, wie z.B. die Basislinie oder kleine GC Peaks, wird die maximale Ionisationszeit für die eigentliche ausgewählt.“"
                            },
                            {
                                "example_id": "72f52fa6-15ca-4cbe-a4df-1195d7e0ac27",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„Vorher sichtbare Reflektionen werden durch die Ionisationszeit verzögert, und stellen den Vorgang dar, während dem der Fehler anfängt zu zünden.“"
                            },
                            {
                                "example_id": "a7d4d97b-4dff-4e4e-97a1-b3145709587d",
                                "sense_id": "841337b4-003c-336a-938c-888b2914d7b8",
                                "text": "„ Die Dauer der Ionisation (hierin als \"Ionisationszeit\" bezeichnet) ist ein wichtiger Faktor, der den Wirkungsgrad des Motors beeinflusst, und es ist normalerweise wünschenswert, dass die Ionisationszeit jeder Zündkerze im Wesentlichen gleich der Ionisationszeit jeder anderen Zündkerze des Motors, und außerdem gleich einer nominellen Ionisationszeit ist.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
