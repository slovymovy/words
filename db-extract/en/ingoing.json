                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a64dd416-0674-4039-aebd-88c5463367c3",
                                                "sense_id": "096c2acc-7277-3f5d-91b0-e342c9d37fa3",
                                                "text": "Eingehende Rechnungen, die noch per Fax kommen, scannen wir innerhalb von ein paar Tagen. Wie können sie nicht einfach so ablegen, da sie nicht dokumentenecht sind!"
                                            }
