                        ]
                    },
                    {
                        "translation_id": "4072a9e0-91f6-4953-822a-0943fe2b33a7",
                        "source_entry_id": "e6f58e40-80fa-33cf-a2d3-c9c188bbe75c",
                        "source_sense_description": "preventing, hindering, or acting as an obstacle to",
                        "target_lang_word": "präventiv",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "präventiv",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "f36577d1-cb74-39ef-9a33-17a4783dd459",
                                        "entry_id": "64d252e3-1c65-3777-a85d-384ceeb7dd2f",
                                        "glosses": [
                                            "vorbeugend, verhütend; eine unerwünschte Entwicklung verhindernd"
                                        ],
                                        "tags": [
                                            "bildungsspr."
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "846904f9-b34a-453e-b389-df3a41cb669a",
                                                "sense_id": "f36577d1-cb74-39ef-9a33-17a4783dd459",
                                                "text": "Ich schlage dies als eine präventive Maßnahme vor."
                                            },
                                            {
                                                "example_id": "b9e69f8d-1d20-4a59-8acf-ac8ea988c098",
                                                "sense_id": "f36577d1-cb74-39ef-9a33-17a4783dd459",
                                                "text": "Bei der präventiv befohlenen Bombardierung zweier Tanklaster im Jahr 2009 ließen viele afghanische Zivilisten ihr Leben."
                                            },
                                            {
                                                "example_id": "dcb8bcb4-f5de-4412-87a9-f7d1857b0087",
                                                "sense_id": "f36577d1-cb74-39ef-9a33-17a4783dd459",
                                                "text": "Der Militärische Abschirmdienst (MAD) darf Bewerber erst nach Eintritt in die Bundeswehr nachrichtendienstlich und präventiv überprüfen. Warum?"
                                            },
                                            {
                                                "example_id": "1a6f626f-6774-4579-b566-56d93f61c614",
                                                "sense_id": "f36577d1-cb74-39ef-9a33-17a4783dd459",
                                                "text": "„IDW-Chef Klaus-Peter Naumann macht sich für ein Review Panel nach britischem Vorbild stark, da es eine präventivere Wirkung habe und damit die Jahres- und Konzernabschlüsse tendenziell von vornherein ordnungsgemäß seien.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "46cdefd1-c178-400a-b8d0-19329e2fdf08",
                        "source_entry_id": "e6f58e40-80fa-33cf-a2d3-c9c188bbe75c",
                        "source_sense_description": "preventing, hindering, or acting as an obstacle to",
                        "target_lang_word": "vorsorglich",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorsorglich",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                        "entry_id": "35c88a30-6569-38c0-8ff6-ef028546c617",
                                        "glosses": [
                                            "im Voraus sorgend, meist um Probleme zu vermeiden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4d9ec399-2367-4c78-a3c2-4da0692996e3",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Ich habe vorsorglich alle Putzmittel in die oberen Schränke getan."
                                            },
                                            {
                                                "example_id": "dbc8dd93-4181-4abd-a781-c16643955017",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Karl-Heinz holte sich schon am Sonnabend vorsorglich seine Eintrittskarte."
                                            },
                                            {
                                                "example_id": "2742d9c2-87e2-496a-a5b5-42caeccb6c22",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "„Vor zwei Jahren mußte ich mein Brustimplantate vorsorglich entfernen lassen: wegen des Krebsrisikos der Silikoneinlagen.“"
                                            },
                                            {
                                                "example_id": "4654cf43-72e7-450e-b6d3-16cd4d705f01",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "„Ich werde meinen Freund heiraten. Aber nur, wenn wir vorsorglich für den Fall, dass es doch zur Scheidung kommt, einen Ehevertrag schliessen.“"
                                            },
                                            {
                                                "example_id": "6c549b94-204d-4396-b886-39b731e18506",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "Eine große Flutwelle drohte [nachdem eine Gerölllawine den Fluß Kali Gandaki aufstaute]. […] Das größte Wasserkraftwerk Nepals […] wurde vorsorglich abgeschaltet."
                                            },
                                            {
                                                "example_id": "d9eca6f4-66c1-4c7c-a8d1-8ee6c8c23a9a",
                                                "sense_id": "dcb7c680-97b1-3e8e-b2b7-1da714b6f7a6",
                                                "text": "[Nach einer Panne mit dem gefährlichen Milzbranderreger Anthrax] seien für [22 Armee-Mitglieder] \"vorsorglich medizinische Maßnahmen\" einschließlich der Verabreichung von Antibiotika getroffen worden."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
