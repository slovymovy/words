                "senses": [
                    {
                        "sense_id": "0f57f881-0fe8-3e09-9629-2b6eda1dc714",
                        "entry_id": "5d2036cf-57cc-30c7-8484-d87223344e30",
                        "glosses": [
                            "insbesondere im Alter auftretende Minderung der Knochendichte wegen des verringerten Knochenaufbaus durch Osteoblasten und erhöhten Knochenabbaus durch Osteoklasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fd8657fc-7580-44ee-9df3-f65c18a76c5e",
                                "sense_id": "0f57f881-0fe8-3e09-9629-2b6eda1dc714",
                                "text": "Die Osteopenie gilt als Vorstufe der Osteoporose und betrifft etwa die Hälfte aller älteren Frauen."
                            },
                            {
                                "example_id": "9c2149eb-2232-4093-99ab-8f78d88140f6",
                                "sense_id": "0f57f881-0fe8-3e09-9629-2b6eda1dc714",
                                "text": "Eine ausgewogene Ernährung, regelmäßige sportliche Übungen und eine gesunde Lebensweise können das Risiko einer Osteopenie reduzieren."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
