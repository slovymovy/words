        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "cd6ea7b5-7f4f-3ab6-8cfe-3f9d0e840120",
                    "sense_definition": "To strike or push bluntly, usually with the head or horns.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "action_verb",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The two rams <w>butted</w> heads aggressively during the mating season.",
                            "target_lang_translations": {
                                "ru": "Два барана агрессивно <w>бодались</w> головами во время брачного сезона.",
                                "es": "Los dos carneros se <w>topetaron</w> con fuerza durante la temporada de apareamiento."
                            }
                        },
                        {
                            "text": "He accidentally <w>butted</w> me in the face while we were playing basketball.",
                            "target_lang_translations": {
                                "ru": "Он случайно <w>ударил</w> меня головой в лицо, когда мы играли в баскетбол.",
                                "es": "Me dio un <w>cabezazo</w> accidental en la cara mientras jugábamos al baloncesto."
                            }
