                    {
                        "form_id": "de01bea4-4531-466d-a210-dbb29baa2382",
                        "entry_id": "b6450337-260f-3cc7-bf36-1ee68c307fa2",
                        "tags": [],
                        "form": "alkalin"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "840759f1-4d5d-3d92-ad7f-65a05692c929",
                        "entry_id": "b6450337-260f-3cc7-bf36-1ee68c307fa2",
                        "glosses": [
                            "Relatif aux alcalis, aux métaux alcalins."
                        ],
                        "tags": [
                            "définition à préciser ou à vérifier"
                        ],
                        "examples": [
                            {
                                "example_id": "1806136f-db61-403a-8173-0ea93634e0ad",
                                "sense_id": "840759f1-4d5d-3d92-ad7f-65a05692c929",
                                "text": "Les enzymes utilisées dans le conjugué sont principalement la HRP (horse radish peroxidase) pour une révélation chimioluminescente ou la PAL (phosphatase alcaline) pour une révélation colorimétrique."
                            },
                            {
                                "example_id": "244133f9-b70f-4662-b6b5-794fbcd8ee2b",
                                "sense_id": "840759f1-4d5d-3d92-ad7f-65a05692c929",
                                "text": "L’actinobacille préfère donc de beaucoup les milieux légèrement alcalins et redoute les milieux acides."
                            }
                        ]
                    },
                    {
                        "sense_id": "99f63758-667a-3484-a96d-54d991e06b0b",
                        "entry_id": "b6450337-260f-3cc7-bf36-1ee68c307fa2",
                        "glosses": [
                            "Qualifie un accumulateur, une pile dont l’électrolyte est alcalin."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0992a5ab-d6a9-4e1e-afbd-86f3fd0ac1e5",
                        "source_entry_id": "b6450337-260f-3cc7-bf36-1ee68c307fa2",
                        "target_lang_word": "alkalisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "alkalisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b3e8143e-d2f4-3ca8-9025-f76fd9b876dd",
                                        "entry_id": "62fe9c4b-383f-3edc-bda7-11bb9d790018",
                                        "glosses": [
                                            "einen pH-Wert größer als 7 aufweisend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d1107116-bf18-4824-bf4a-50037d335f7a",
                                                "sense_id": "b3e8143e-d2f4-3ca8-9025-f76fd9b876dd",
                                                "text": "Durch Zugabe von Natriumhydroxid wird die Lösung alkalisch gestellt."
                                            },
                                            {
                                                "example_id": "9a55b2d0-29a1-4d6b-be09-5e63f1b29f0a",
                                                "sense_id": "b3e8143e-d2f4-3ca8-9025-f76fd9b876dd",
                                                "text": "Die Reaktion läuft nur im alkalischen Milieu ab."
                                            },
                                            {
                                                "example_id": "12a9edfa-089c-440f-b70c-d36b35631b85",
                                                "sense_id": "b3e8143e-d2f4-3ca8-9025-f76fd9b876dd",
                                                "text": "Ampholyte können sowohl sauer als auch alkalisch reagieren."
                                            },
                                            {
                                                "example_id": "b5600173-d8c9-4b62-a258-459a0fb21545",
                                                "sense_id": "b3e8143e-d2f4-3ca8-9025-f76fd9b876dd",
                                                "text": "„Setzt man dem Wasser etwas Phenolphtalein als Indikator zu, erkennt man, dass der Natriumtropfen eine rote Farbspur hinterlässt. Es hat sich also eine alkalische Lösung gebildet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e658c09b-25da-4792-9e11-18f523240b23",
                        "source_entry_id": "b6450337-260f-3cc7-bf36-1ee68c307fa2",
                        "target_lang_word": "basisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "basisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "816cd1e6-f678-333a-8668-1376c13f1d41",
                                        "entry_id": "f512d0f6-0829-3182-86f7-6baef94cea22",
                                        "glosses": [
                                            "Eigenschaften einer Base besitzend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92134fe3-2fe9-4b50-93a6-147c7dc22d79",
                                                "sense_id": "816cd1e6-f678-333a-8668-1376c13f1d41",
                                                "text": "„Es gibt auch alkalische Wasserstoff-Brennstoffzellen. Sie arbeiten jedoch nur mit hochreinem Wasserstoff und Sauerstoff. In ihnen werden die Gase durch poröse, katalytisch wirksame Elektroden in eine basische Lösung eingeleitet.“"
                                            },
                                            {
                                                "example_id": "d127a791-60d9-4c93-8713-df0a9843a429",
                                                "sense_id": "816cd1e6-f678-333a-8668-1376c13f1d41",
                                                "text": "„In der Bleicherei und in der Färberei wird Salmiakgeist als billige basische Lösung verwendet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
