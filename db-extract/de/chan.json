                                    },
                                    {
                                        "sense_id": "f7d56131-9792-3410-a2d5-cb233ea30fc3",
                                        "entry_id": "bf2633f9-0a3b-3611-b30c-47503ccee3a7",
                                        "glosses": [
                                            "A noble or man of rank in various Muslim countries of Central Asia, including Afghanistan."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "khan",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                        "entry_id": "3d6b2a02-69f6-354a-88b0-ac9cfa4fe59c",
                                        "glosses": [
                                            "Synonym of caravanserai (particularly in Middle Eastern contexts)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4dc19bbc-87d1-4f80-998d-2be5bbf38d3c",
                                                "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                                "text": "‘Guess the name of that,’ she said, pointing to her delicate parts. The porter tried this name and that and ended by asking her to tell him and cease her slapping. ‘The khān of Abu-Mansur,’ she replied."
                                            },
                                            {
                                                "example_id": "633ce4e3-af84-4307-957b-0da1199b0999",
                                                "sense_id": "d17e0949-7cb3-3570-a1ec-0a3f73228a5c",
                                                "text": "At each of these stations there is a hostelry which they call a khan, where travellers alight with their beasts, and outside each khan is a public watering-place and a shop at which the traveller may buy what he requires for himself and his beast."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0fb3a61c-6179-3664-855c-5f73803a6968",
                                        "entry_id": "3d6b2a02-69f6-354a-88b0-ac9cfa4fe59c",
                                        "glosses": [
                                            "Synonym of fonduk (“inn or hotel in Middle Eastern contexts”)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e3de54e8-4aa9-429e-854b-2d929affdf1a",
