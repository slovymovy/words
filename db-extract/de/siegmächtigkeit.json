                ],
                "senses": [
                    {
                        "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                        "entry_id": "dd333bdc-7c47-312f-b5a0-1d597863c288",
                        "glosses": [
                            "Eigenschaft von Herrschern, nach der sie alleine kraft ihrer Person fähig sind, Erfolge im Krieg zu erzielen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d96bdba1-0c26-4ec3-b6e1-de923a605554",
                                "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                                "text": "„Heerkönig und Sakralkönig zugleich hatte er zu sein, Siegmächtigkeit und Fruchtbarkeitszauber in seiner Person zu vereinen.“"
                            },
                            {
                                "example_id": "e307ff8d-4fa3-41b0-bf8f-ad95fdd11f01",
                                "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                                "text": "„Bei Livius jedenfalls spielt Camillus' pietas - neben seiner Siegmächtigkeit - die zentrale Rolle, der Bericht ist überhaupt auffällig um religiöse Themen zentriert.“"
                            },
                            {
                                "example_id": "b922d7cb-3dc5-465b-926f-e2e57b9dd5a3",
                                "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                                "text": "„Sie besitzen deshalb ein besonderes Herrscherglück, das sich vor allem in ihrer Siegmächtigkeit erweist.“"
                            },
                            {
                                "example_id": "8660e0ce-274a-4014-97e5-ea3fa77b47e1",
                                "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                                "text": "„Er führte das Heer, und deshalb muß sich das Königsheil zunächst einmal als Kriegsglück, als »Siegmächtigkeit« bewahren.“"
                            },
                            {
                                "example_id": "3300b467-17f6-4a3e-ac6b-1b76b04dfd51",
                                "sense_id": "a12540c5-8a2e-3fae-be4c-e368f4d595f5",
                                "text": "„Aus der Siegmächtigkeit des Kaisers wird die Siegmächtigkeit Christi.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
