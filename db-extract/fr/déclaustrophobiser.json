                "senses": [
                    {
                        "sense_id": "7beb795d-7b9c-3199-82d8-62ce6a4e25ec",
                        "entry_id": "bafb1c5f-52af-3fc4-b4cf-f1b8409fda3b",
                        "glosses": [
                            "Faire perdre son caractère claustrophobique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b30aa2-1fed-43fa-bd63-43b6a7fd579e",
                                "sense_id": "7beb795d-7b9c-3199-82d8-62ce6a4e25ec",
                                "text": "Prendre Caché de Michael Haneke, le «déclaustrophobiser», le mettre au goût du jour, engager Juliette Binoche: le résultat pourrait ressembler à Celle que vous croyez."
                            },
                            {
                                "example_id": "a33401f2-5f42-4969-97ae-5d176ee26a5f",
                                "sense_id": "7beb795d-7b9c-3199-82d8-62ce6a4e25ec",
                                "text": "Pour l'idée du miroir, c'était pas vraiment pour agrandir, mais pour éclairer sur ce coup-là : il faut le placer en face de la fenètre de façon à refléter la lumière du jour. Ça déclaustrophobise bien un appart peu ouvert."
                            }
                        ]
                    }
