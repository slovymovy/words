{
    "word_family": [
        "afkorting",
        "kort",
        "inkorten",
        "verkorten"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "b49a69c0-a314-32b9-96ff-729350d35f48",
                    "sense_definition": "Het maken van een kortere versie van een woord of woordgroep door letters weg te laten.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "taalgebruik",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het woord \"bijvoorbeeld\" wordt in teksten vaak <w>afgekort</w> tot \"bijv.\".",
                            "target_lang_translations": {
                                "en": "The word \"bijvoorbeeld\" is often <w>abbreviated</w> to \"bijv.\" in texts."
                            }
                        },
                        {
                            "text": "Je kunt deze lange naam beter <w>afkorten</w> om ruimte te besparen op het formulier.",
                            "target_lang_translations": {
                                "en": "It is better to <w>shorten</w> this long name to save space on the form."
                            }
                        }
                    ],
                    "synonyms": [
                        "abbreviëren"
                    ],
                    "antonyms": [
                        "uitschrijven"
                    ],
                    "common_phrases": [
                        "tot een lettergreep afkorten",
                        "een naam afkorten"
                    ],
                    "target_lang_definitions": {
                        "en": "To create a shorter version of a word or phrase by omitting letters."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "abbreviate",
                                "target_lang_sense_clarification": "to shorten a word or phrase"
                            },
                            {
                                "target_lang_word": "shorten",
                                "target_lang_sense_clarification": "to make a name or word shorter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c7629d76-fec2-32c7-9da1-9b2e7fb254c2",
                    "sense_definition": "Iets fysiek korter maken door een stuk van het uiteinde te verwijderen.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "fysieke_aanpassing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De timmerman moet de houten planken eerst <w>afkorten</w> voordat hij ze kan gebruiken.",
                            "target_lang_translations": {
                                "en": "The carpenter must first <w>cut</w> the wooden planks <w>to length</w> before he can use them."
                            }
                        },
                        {
                            "text": "Kun je die te lange gordijnen een stukje voor me <w>afkorten</w>?",
                            "target_lang_translations": {
                                "en": "Could you <w>shorten</w> those curtains for me a bit?"
                            }
                        }
                    ],
                    "synonyms": [
                        "inkorten",
                        "bekorten"
                    ],
                    "antonyms": [
                        "verlengen"
                    ],
                    "common_phrases": [
                        "een plank afkorten",
                        "op maat afkorten"
                    ],
                    "target_lang_definitions": {
                        "en": "To physically make something shorter by removing a piece from the end."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shorten",
                                "target_lang_sense_clarification": "to reduce the physical length of an object"
                            },
                            {
                                "target_lang_word": "cut down",
                                "target_lang_sense_clarification": "to make something shorter by cutting"
                            },
                            {
                                "target_lang_word": "trim",
                                "target_lang_sense_clarification": "to cut off the ends of something"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "fd652f16-ffa1-3368-940a-a11f6e195462",
                    "sense_definition": "Een tekst of verhaal korter maken door bepaalde delen weg te laten.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "tekstbewerking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De redacteur besloot het artikel flink te <w>afkorten</w> omdat het niet op de pagina paste.",
                            "target_lang_translations": {
                                "en": "The editor decided to <w>shorten</w> the article significantly because it didn't fit on the page."
                            }
                        },
                        {
                            "text": "Je moet je presentatie een beetje <w>afkorten</w> om binnen de tijd te blijven.",
                            "target_lang_translations": {
                                "en": "You need to <w>cut</w> your presentation a bit to stay within the time limit."
                            }
                        }
                    ],
                    "synonyms": [
                        "bekorten",
                        "samenvatten"
                    ],
                    "antonyms": [
                        "uitbreiden"
                    ],
                    "common_phrases": [
                        "een verhaal afkorten",
                        "de tekst afkorten"
                    ],
                    "target_lang_definitions": {
                        "en": "To make a text or story shorter by leaving out certain parts."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "shorten",
                                "target_lang_sense_clarification": "to reduce the length of a text or speech"
                            },
                            {
                                "target_lang_word": "abridge",
                                "target_lang_sense_clarification": "to shorten a book or piece of writing while keeping the main idea"
                            },
                            {
                                "target_lang_word": "cut",
                                "target_lang_sense_clarification": "to remove parts of a text to make it shorter"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be23ad19-57d9-36a8-9b32-e082fe5d5782",
                    "sense_definition": "Het dwars op de vezelrichting doorzagen van hout of ander materiaal.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "techniek",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Voordat hij de balk <w>afkortte</w>, tekende hij de zaaglijn heel secuur af met een potlood.",
                            "target_lang_translations": {
                                "en": "Before he <w>crosscut</w> the beam, he marked the saw line very precisely with a pencil."
                            }
                        },
                        {
                            "text": "Met een speciale zaagmachine kun je deze profielen heel nauwkeurig <w>afkorten</w>.",
                            "target_lang_translations": {
                                "en": "With a special sawing machine, you can <w>cut</w> these profiles <w>to size</w> very accurately."
                            }
                        }
                    ],
                    "synonyms": [
                        "afzagen"
                    ],
                    "common_phrases": [
                        "dwars afkorten",
                        "balken afkorten"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technische vakterm in de houtbewerking"
                        }
                    ],
                    "target_lang_definitions": {
                        "en": "To saw wood or other material perpendicular to the grain."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "crosscut",
                                "target_lang_sense_clarification": "to saw across the grain of wood"
                            },
                            {
                                "target_lang_word": "cut to length",
                                "target_lang_sense_clarification": "to cut material to a specific size"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}