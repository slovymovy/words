                                                "sense_id": "6433c365-0d7d-3a9d-ba98-21f032110e0e",
                                                "text": "Má větší nohy jako on."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bc2f21ba-141b-39b4-be9c-6a4a29a5c315",
                                        "entry_id": "68eba5ae-68d3-3419-9c5b-01c184d7d429",
                                        "glosses": [
                                            "uvozuje příklad resp. více příkladů, tvořících přístavkové spojení"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c3a005bd-6c51-4c2f-95bc-a79de28ca905",
                                                "sense_id": "bc2f21ba-141b-39b4-be9c-6a4a29a5c315",
                                                "text": "Některé profese jako zedník, pokrývač a kominík vyžadují stálý pobyt mimo budovy."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0a502e92-61a5-37ab-9b15-8f7daa28af8c",
                                        "entry_id": "68eba5ae-68d3-3419-9c5b-01c184d7d429",
                                        "glosses": [
                                            "tedy, totiž"
                                        ],
                                        "tags": [
                                            "v obecném jazyce"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "21815586-34e0-4235-8c34-4c2d7d132194",
                                                "sense_id": "0a502e92-61a5-37ab-9b15-8f7daa28af8c",
                                                "text": "„Tož te jako chceš bét pacholkem? — Naposled haji volařem?“ obrátil se nyní Filipek na jediného svého synka Antoše."
                                            }
