                        "entry_id": "89ad6e41-c2fa-3c5b-bc36-c20607360bd6",
                        "glosses": [
                            "To make a huffing or snorting sound of disdain or dismissal; (figurative, by extension) to show one's disdain."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9cef5ac7-be2e-4e6c-9865-68f5fa4d7d29",
                                "sense_id": "e5cfb06b-2f5e-3372-8c0d-21c3b9b2c5cd",
                                "text": "Is it wrong to harumph when the scent of spitting fat drifts towards your washing line?"
                            },
                            {
                                "example_id": "c13dc1b1-33cb-4b1d-85dc-38e52aa480e8",
                                "sense_id": "e5cfb06b-2f5e-3372-8c0d-21c3b9b2c5cd",
                                "text": "\"An open invitation for beggars,\" harumphed Migrationwatch. Ever the humanitarians."
                            }
                        ]
                    }
