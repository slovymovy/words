                    {
                        "translation_id": "b242ad18-9b2c-40a8-b5e3-60fd90b26172",
                        "source_entry_id": "4312359b-82dc-318a-af97-f70a40d3ac64",
                        "source_sense_description": "Action de rétorquer",
                        "target_lang_word": "respuesta",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "respuesta",
                                "target_lang_code": "es",
                                "target_senses": [
                                    {
                                        "sense_id": "c6818bb9-bc91-3681-adab-1d7c4be83aa1",
                                        "entry_id": "a5a42e05-726d-36f3-aca9-91a13f2fcf31",
                                        "glosses": [
                                            "Acción o efecto de responder (en cualquiera de sus acepciones)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "33f8ca8d-a7d1-4a44-b766-82808c0f579a",
                                                "sense_id": "c6818bb9-bc91-3681-adab-1d7c4be83aa1",
                                                "text": "En medio de las lluvias del invierno\nNo hay tiempo ni lugar\nYo sé que entenderás\nQue amor, para quien busca una respuesta\nEs un poquito más que hacerte bien"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "280002de-8545-3694-a6ac-782d2bc685c1",
