{
    "word_family": [
        "diminish",
        "diminution"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "ecdc6f0c-448b-3c1a-9bf4-cb79a01f46d6",
                    "sense_definition": "Very small in size.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "size",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>diminutive</w> child struggled to reach the high shelf in the kitchen.",
                            "target_lang_translations": {
                                "nl": "Het <w>minuscule</w> kind had moeite om de hoge plank in de keuken te bereiken."
                            }
                        },
                        {
                            "text": "Despite her <w>diminutive</w> stature, she was a powerful and respected leader.",
                            "target_lang_translations": {
                                "nl": "Ondanks haar <w>kleine</w> gestalte was ze een krachtige en gerespecteerde leider."
                            }
                        }
                    ],
                    "synonyms": [
                        "tiny",
                        "lilliputian"
                    ],
                    "antonyms": [
                        "huge",
                        "gigantic"
                    ],
                    "common_phrases": [
                        "diminutive stature",
                        "diminutive figure"
                    ],
                    "target_lang_definitions": {
                        "nl": "Zeer klein van omvang."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "minuscuul",
                                "target_lang_sense_clarification": "Zeer klein in fysieke omvang."
                            },
                            {
                                "target_lang_word": "klein",
                                "target_lang_sense_clarification": "Algemene term voor klein van formaat."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a6ebef3b-a0f4-3b8e-924a-604131da4a89",
                    "sense_definition": "Relating to a word form that expresses smallness, youth, or affection.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In many languages, adding a <w>diminutive</w> suffix can change the meaning of a noun to indicate something small.",
                            "target_lang_translations": {
                                "nl": "In veel talen kan het toevoegen van een <w>verkleinend</w> achtervoegsel de betekenis van een zelfstandig naamwoord veranderen om iets kleins aan te duiden."
                            }
                        },
                        {
                            "text": "The author used a <w>diminutive</w> form of the name to show the character's youth.",
                            "target_lang_translations": {
                                "nl": "De auteur gebruikte een <w>diminutieve</w> vorm van de naam om de jeugd van het personage te tonen."
                            }
                        }
                    ],
                    "antonyms": [
                        "augmentative"
                    ],
                    "common_phrases": [
                        "diminutive suffix",
                        "diminutive form"
                    ],
                    "target_lang_definitions": {
                        "nl": "Betrekking hebbend op een woordvorm die kleinheid, jeugd of genegenheid uitdrukt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verkleinend",
                                "target_lang_sense_clarification": "Betrekking hebbend op de functie van een verkleinwoord."
                            },
                            {
                                "target_lang_word": "diminutief",
                                "target_lang_sense_clarification": "Taalkundige term voor een verkleinvorm."
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7f22b115-0b91-3751-8b6a-ca34c1bfc80c",
                    "sense_definition": "Serving to reduce or lower the value or importance of something.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "reduction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to make any <w>diminutive</w> comments about his colleague's hard work.",
                            "target_lang_translations": {
                                "nl": "Hij weigerde <w>kleinerende</w> opmerkingen te maken over het harde werk van zijn collega."
                            }
                        },
                        {
                            "text": "The policy had a <w>diminutive</w> effect on the overall quality of the project.",
                            "target_lang_translations": {
                                "nl": "Het beleid had een <w>verkleinend</w> effect op de algehele kwaliteit van het project."
                            }
                        }
                    ],
                    "antonyms": [
                        "augmentative"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Used in a formal or literary context."
                        }
                    ],
                    "target_lang_definitions": {
                        "nl": "Dienend om de waarde of het belang van iets te verminderen of te verlagen."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "kleinerend",
                                "target_lang_sense_clarification": "Iets minderwaardig of onbelangrijk laten lijken."
                            },
                            {
                                "target_lang_word": "verkleinend",
                                "target_lang_sense_clarification": "Iets in waarde of omvang reducerend."
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "60f4d19a-8ba2-348a-bfb5-6c79a7d34836",
                    "sense_definition": "A word form expressing smallness, youth, or endearment.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "linguistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The word booklet is a <w>diminutive</w> of the word book.",
                            "target_lang_translations": {
                                "nl": "Het woord 'boekje' is een <w>verkleinwoord</w> van het woord 'boek'."
                            }
                        },
                        {
                            "text": "She often uses a <w>diminutive</w> when speaking to her young puppy.",
                            "target_lang_translations": {
                                "nl": "Ze gebruikt vaak een <w>verkleinwoord</w> als ze tegen haar jonge puppy praat."
                            }
                        }
                    ],
                    "synonyms": [
                        "nomen deminutivum"
                    ],
                    "antonyms": [
                        "augmentative"
                    ],
                    "common_phrases": [
                        "common diminutive"
                    ],
                    "target_lang_definitions": {
                        "nl": "Een woordvorm die kleinheid, jeugd of vertedering uitdrukt."
                    },
                    "translations": {
                        "nl": [
                            {
                                "target_lang_word": "verkleinwoord",
                                "target_lang_sense_clarification": "Een woord met een verkleiningsuitgang."
                            },
                            {
                                "target_lang_word": "diminutief",
                                "target_lang_sense_clarification": "Synoniem voor verkleinwoord in taalkundige context."
                            }
                        ]
                    }
                }
            ]
        }
    ]
}