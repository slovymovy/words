                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "418e982d-c937-43ae-8848-3b56fa25ae7a",
                                "sense_id": "145e79c7-90a0-3237-9c5d-8eb18a441424",
                                "text": "„Ein Cottage, in dem eine berühmte Dichterin geboren worden war, hatte man zu einem Museum ihres Lebens umgewandelt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a3610390-9f46-39e0-b564-bb6cb39ebe78",
                        "entry_id": "5e92f571-5444-3ce8-a178-ceb308d63d90",
                        "glosses": [
                            "Villenviertel in Wien"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e6a24df-1e0e-40a6-a274-0301ab050822",
                                "sense_id": "a3610390-9f46-39e0-b564-bb6cb39ebe78",
                                "text": "„Das Cottage umfasste 1961 84,27 Hektar Nettobauland mit 6644 Bewohnern.“"
                            },
                            {
                                "example_id": "abaecc48-747f-4c43-badb-d7891630aa25",
                                "sense_id": "a3610390-9f46-39e0-b564-bb6cb39ebe78",
                                "text": "„An sich geht es in der Ottakringer Cottage am Fuß des Wilhelminenbergs ähnlich beschaulich zu wie in anderen Speckgürtellagen Wiens: Bis auf den einen oder anderen Heurigen werden hier die Trottoirs raufgeklappt, sobald die Dunkelheit hereinbricht.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
