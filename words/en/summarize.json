    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "187d6f48-c162-326c-a4e3-1f49bf267497",
                    "sense_definition": "To give a brief statement of the main points of something",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After the meeting, the manager <w>summarized</w> the major decisions made by the team.",
                            "target_lang_translations": {
                                "ru": "После собрания менеджер <w>подытожил</w> основные решения, принятые командой."
                            }
                        },
                        {
                            "text": "The teacher asked the students to <w>summarize</w> the main points of the chapter.",
                            "target_lang_translations": {
                                "ru": "Учитель попросил учеников <w>кратко изложить</w> основные положения главы."
                            }
                        }
                    ],
                    "synonyms": [
                        "précis"
                    ],
                    "common_phrases": [
                        "summarize the main points",
                        "summarize the findings",
                        "briefly summarize"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кратко изложить основные положения чего-либо"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подытожить",
                                "target_lang_sense_clarification": "сделать выводы из сказанного"
                            },
                            {
                                "target_lang_word": "подвести итог",
                                "target_lang_sense_clarification": "сформулировать результат обсуждения"
                            },
                            {
                                "target_lang_word": "обобщить",
                                "target_lang_sense_clarification": "объединить основные факты"
                            },
                            {
                                "target_lang_word": "резюмировать",
                                "target_lang_sense_clarification": "кратко повторить суть"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8df0a73c-cfc7-32cf-b498-74f62c2b868b",
                    "sense_definition": "To create a formal summary or shortened version of a document or text",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "summarize",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Jim was asked to <w>summarize</w> the document by Wednesday for the executive board.",
                            "target_lang_translations": {
                                "ru": "Джима попросили <w>составить резюме</w> документа к среде для совета директоров."
                            }
                        },
                        {
                            "text": "It is difficult to <w>summarize</w> the report without losing some of the technical details.",
                            "target_lang_translations": {
                                "ru": "Трудно <w>обобщить</w> отчет, не потеряв при этом некоторые технические детали."
                            }
                        }
                    ],
                    "synonyms": [
                        "précis"
                    ],
                    "common_phrases": [
                        "summarize the document",
                        "summarize the report",
                        "summarize the article"
                    ],
                    "target_lang_definitions": {
                        "ru": "Создать официальное краткое изложение или сокращенную версию документа или текста"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "конспектировать",
                                "target_lang_sense_clarification": "составлять краткую запись текста"
                            },
                            {
                                "target_lang_word": "составить резюме",
                                "target_lang_sense_clarification": "подготовить краткий обзор документа"
                            },
                            {
                                "target_lang_word": "изложить кратко",
                                "target_lang_sense_clarification": "сократить текст до основных мыслей"
                            }
                        ]
                    }
                }
            ]
        }
    ]
