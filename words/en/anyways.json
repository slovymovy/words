                                "target_lang_sense_clarification": "pour résumer ou passer à autre chose"
                            },
                            {
                                "target_lang_word": "enfin",
                                "target_lang_sense_clarification": "marqueur de discours familier"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0665d30e-075e-31e0-851a-bf35de3cc1fe",
                    "sense_definition": "In any manner, way, or respect; at all.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "If you are <w>anyways</w> doubtful about the plan, you should speak up now.",
                            "target_lang_translations": {
                                "ru": "Если вы <w>хоть как-то</w> сомневаетесь в плане, вам следует высказаться сейчас.",
                                "es": "Si dudas <w>de algún modo</w> sobre el plan, deberías decirlo ahora.",
                                "fr": "Si vous doutez <w>en quoi que ce soit</w> de ce plan, vous devriez le dire maintenant."
                            }
                        },
                        {
                            "text": "I do not think that his comments will <w>anyways</w> affect the final decision.",
                            "target_lang_translations": {
                                "ru": "Я не думаю, что его комментарии <w>каким-либо образом</w> повлияют на окончательное решение.",
                                "es": "No creo que sus comentarios afecten <w>en absoluto</w> la decisión final.",
                                "fr": "Je ne pense pas que ses remarques affecteront <w>d'une quelconque manière</w> la décision finale."
                            }
                        }
                    ],
                    "synonyms": [
                        "in any way",
                        "at all",
                        "whatsoever"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "mostly replaced by 'in any way' in modern English"
                        }
                    ],
