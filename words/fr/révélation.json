                        "artiste révélation"
                    ]
                },
                {
                    "sense_id": "52689ed5-5b74-3403-a471-be0ee74d7e78",
                    "sense_definition": "Prise de conscience soudaine ou découverte inattendue qui apporte un éclairage nouveau sur les choses.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "prise_de_conscience",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Son premier voyage en solitaire a été une véritable <w>révélation</w> pour elle."
                        },
                        {
                            "text": "La lecture de ce poème a agi sur lui comme une <w>révélation</w>."
