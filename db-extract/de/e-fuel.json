                                "target_senses": [
                                    {
                                        "sense_id": "02f5fd48-07b6-3dfa-90d6-26aaff13998f",
                                        "entry_id": "bf7d1b0c-8b51-3084-8ddf-3415de2a7ac9",
                                        "glosses": [
                                            "Synonym of e-fuel."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2929adb5-6096-48e1-9b06-99a1535d9b1a",
                                                "sense_id": "02f5fd48-07b6-3dfa-90d6-26aaff13998f",
                                                "text": "Majumdar then held up another vial of electrofuel, this one brewed by a team at MIT. Toone says he's been astonished by the success of the electrofuel projects, and OPX has raised $36 million in follow-up financing."
                                            },
                                            {
                                                "example_id": "eb993b6e-ff7e-449e-801f-28e907a4c3ee",
                                                "sense_id": "02f5fd48-07b6-3dfa-90d6-26aaff13998f",
                                                "text": "The cheap natural gas freed from shale by horizontal drilling and hydraulic fracturing (or fracking) has helped kill off bleeding-edge programs like Electrofuels, a bid to use microbes to turn cheap electricity into liquid fuels, […]"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6152d1b7-7481-478d-8a5c-d521ae87e78e",
                        "source_entry_id": "d4821a6f-18a8-37c5-b3dc-14f074864736",
                        "source_sense_id": "8502613c-78a9-3c2f-8b49-a02b1922aa05",
                        "source_sense_description": "synthetischer Kraftstoff",
                        "target_lang_word": "e-fuel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "e-fuel",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                        "entry_id": "0e9b8027-26d3-35c2-8365-52f2da7efb46",
                                        "glosses": [
                                            "A combustion fuel that is theoretically environmentally friendly and is carbon neutral. A range of combustibles that is produced by combining hydrogen from water with atmospheric carbon dioxide using renewable energy sources to make the fuels."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "42b6f81c-bd14-46d8-8b74-8355ba5b7a95",
                                                "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                                "text": "Fuels produced from hydrogen can be used as straight replacements for oil and gas and can be low-carbon, if renewable electricity is used to produce these “e-fuels”. However, the research found that using the electricity directly to power cars and warm houses was far more efficient."
                                            },
                                            {
                                                "example_id": "9e7f4e65-dd83-49de-8390-e4a7b1cfb592",
                                                "sense_id": "cbccf60a-5bf3-3e98-b144-8411afb066e4",
                                                "text": "E-fuels can subsequently end up in any of the sectors shown, but mainly get used as transport fuels for aviation and shipping, depending on the scenario."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4276e5e4-318c-44e5-8d94-19d48d38eb20",
                        "source_entry_id": "d4821a6f-18a8-37c5-b3dc-14f074864736",
                        "source_sense_id": "8502613c-78a9-3c2f-8b49-a02b1922aa05",
