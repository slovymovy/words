                ],
                "senses": [
                    {
                        "sense_id": "9a273ac8-1ca0-37fb-aab0-3e7a78685da4",
                        "entry_id": "b06b143f-e39f-3580-9ff7-ff65c9f640e6",
                        "glosses": [
                            "industrielle Anlage zur Herstellung von Munition"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b885171-37bb-441f-a212-e7e47587c65c",
                                "sense_id": "9a273ac8-1ca0-37fb-aab0-3e7a78685da4",
                                "text": "„So erfüllten sich die Visionen des Werkbundes von einer rationellen Serienfertigung in den Munitionsfabriken und Waffenschmieden von Hoesch und Krupp.“"
                            },
                            {
                                "example_id": "cdb62f02-261f-4c49-ba18-831368693745",
                                "sense_id": "9a273ac8-1ca0-37fb-aab0-3e7a78685da4",
                                "text": "„Während die Munitionsfabriken längst eifrig produzieren und auch ein Mangel an Nahrung vorerst nicht zu befürchten steht, schenkt man im Kriegsministerium den essenziellen ökonomischen Fragen keinerlei Beachtung.“"
                            },
                            {
                                "example_id": "a0867e0c-9ab4-4321-9523-ff7004facb67",
                                "sense_id": "9a273ac8-1ca0-37fb-aab0-3e7a78685da4",
                                "text": "„Wotans Vater arbeitete als Ingenieur in einer Munitionsfabrik, die bereits vor dem Krieg vor den Toren unserer Stadt errichtet worden war.“"
                            },
                            {
                                "example_id": "22383d2c-9226-455c-8f67-dcd1c26ec542",
                                "sense_id": "9a273ac8-1ca0-37fb-aab0-3e7a78685da4",
                                "text": "„Seit dem Umzug der Familie 1910 nach Wöllersdorf arbeitete er als Militärbeamter in der dortigen staatlichen Munitionsfabrik.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
