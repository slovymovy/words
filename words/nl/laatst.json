                                "de": "Ihr <w>neuestes</w> Buch ist ein großer Erfolg geworden.",
                                "fr": "Son <w>dernier</w> livre a rencontré un grand succès.",
                                "it": "Il suo <w>ultimo</w> libro è stato un grande successo.",
                                "cs": "Její <w>poslední</w> kniha měla obrovský úspěch.",
                                "tr": "Onun <w>son</w> kitabı büyük bir başarı yakaladı.",
                                "es": "Su <w>último</w> libro se ha convertido en un gran éxito."
                            }
                        }
