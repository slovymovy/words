                ],
                "senses": [
                    {
                        "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                        "entry_id": "4002362e-80e6-392a-b34b-27dd10031e3d",
                        "glosses": [
                            "Ruhepause, vor allem zur Mittagszeit"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0fd8bb42-643a-43de-a236-83469c75c426",
                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                "text": "„Dort war es sehr ruhig, weil die Angestellten zum Mittagsmahl nach Hause gegangen waren, während Ortega in seinem Schreibtischsessel saß und mit hochgelegten Beinen eine kleine Siesta hielt.“"
                            },
                            {
                                "example_id": "97d0a917-87ed-491e-bbd3-17e334623b97",
                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                "text": "„Auch der Ausrufung der Republik und der Loslösung von Spanien im Jahr 1640 kann nicht mehr, wie es der Tradition entspricht, mit Familienfesten und einer größeren Siesta gedacht werden.“"
                            },
                            {
                                "example_id": "bfac0b77-4c9d-4c7b-a817-80088f0c059e",
                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                "text": "„Es gab keine Spiele, Spaziergänge oder Siestas mehr.“"
                            },
                            {
                                "example_id": "2b8a8425-912e-41b3-9f0d-336696e60349",
                                "sense_id": "44026780-98ce-3e58-84e4-8313de046a7c",
                                "text": "„Während er auf das Ende der Siesta wartete, warf er hin und wieder einen gedankenverlorenen Blick auf die Auslage.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
