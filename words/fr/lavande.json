    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2cad944c-9163-37d4-ae42-c50da7dc9973",
                    "sense_definition": "Plante aromatique méditerranéenne aux fleurs mauves ou violettes très odorantes.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "plante",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "En été, les collines de Provence se couvrent de grands champs de <w>lavande</w>."
                        },
                        {
                            "text": "Elle a planté de la <w>lavande</w> le long du chemin pour attirer les papillons."
                        }
                    ],
                    "common_phrases": [
                        "champ de lavande",
                        "fleurs de lavande"
                    ]
                },
                {
                    "sense_id": "176a54e6-789f-36bb-9292-b4a3cacb35cf",
                    "sense_definition": "Parfum ou essence extraite des fleurs de cette plante aromatique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "parfum",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ce savon artisanal dégage une agréable odeur de <w>lavande</w> qui parfume toute la salle de bain."
                        },
                        {
                            "text": "Il verse quelques gouttes d'huile essentielle de <w>lavande</w> sur son mouchoir pour mieux respirer."
                        }
                    ],
                    "common_phrases": [
                        "huile essentielle de lavande",
                        "odeur de lavande"
                    ]
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "a8f4bed8-e6e5-320f-b3da-ef16b1ce230e",
                    "sense_definition": "D'une couleur bleu violacé pâle, semblable à celle des fleurs de la lavande.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "couleur",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a choisi une jolie robe <w>lavande</w> pour assister au mariage de sa sœur."
                        },
                        {
                            "text": "Les rideaux du salon affichent une teinte <w>lavande</w> très lumineuse et apaisante."
                        }
                    ],
                    "common_phrases": [
                        "robe lavande",
                        "teinte lavande"
                    ]
                }
            ]
        }
    ]
