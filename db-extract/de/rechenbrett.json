                "senses": [
                    {
                        "sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                        "entry_id": "5400d023-3874-3564-9b91-f3b4b0b01a60",
                        "glosses": [
                            "Brett mit verschiebbaren Steinen, das zum Rechnen verwendet wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5dccce8e-5a93-47ef-8541-cf91d3e35214",
                                "sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                                "text": "Im Mittelalter wurde auf einem Rechenbrett gerechnet."
                            },
                            {
                                "example_id": "476a6e5c-0f6f-41e2-81ed-2d84eaaa10e4",
                                "sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                                "text": "„Neben dem Rechnen auf dem Rechenbrett (den »linihen«) beschreibt Ries in diesem Buch das schriftliche Ziffernrechnen mit den indischen-arabischen Ziffern (mit »federn«).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1a5c10e-0830-4f5b-a415-8a7d71070a21",
                        "source_entry_id": "5400d023-3874-3564-9b91-f3b4b0b01a60",
                        "source_sense_id": "31f5400d-eedc-3006-bcbe-4228c58038a0",
                        "source_sense_description": "Mathematik: Brett mit verschiebbaren Steinen, das zum Rechnen verwendet wird",
                        "target_lang_word": "planchette à calcul",
                        "target_lang_code": "fr",
