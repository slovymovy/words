                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "centrifugal",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8feff5f8-8f57-3a7a-a844-9b74381c5c3d",
                                        "entry_id": "275ec1f6-a5a6-3566-9b2f-0d4f4bc9a494",
                                        "glosses": [
                                            "A rotating machine used to separate massecuite into sugar crystals and molasses."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "188fee27-485a-46f8-a280-c51ebe0e6a58",
                                                "sense_id": "8feff5f8-8f57-3a7a-a844-9b74381c5c3d",
                                                "text": "Where the sequencing of the centrifugals is accomplished by the triggering of a function in the process cycle, a buffer zone (nonproductive time) has to be inserted in the cycle time prior to this action."
                                            },
                                            {
                                                "example_id": "8ce1c09b-0db9-47e5-a2ec-a1234ff1caff",
                                                "sense_id": "8feff5f8-8f57-3a7a-a844-9b74381c5c3d",
                                                "text": "Modern practice favours warming the massecuite in pug mills, placed above the centrifugals."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3d06f3b8-925e-4fc9-9a63-e659981a9310",
                        "source_entry_id": "272fa959-d16b-3298-a0de-61a7cc375647",
                        "source_sense_id": "2b2ef68f-5145-384e-be54-be3f459c8366",
                        "target_lang_word": "centrifuge",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "centrifuge",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a404e20a-c2ec-315e-9249-df29fa77309a",
                                        "entry_id": "0fe3bbaf-d48d-3c0c-a7a5-b945920e808f",
                                        "glosses": [
                                            "Qui éloigne ou qui s’éloigne du centre."
                                        ],
                                        "tags": [
                                            "Didactique"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a22e9f34-8d2a-4b9f-ae09-14b86bd5affd",
                                                "sense_id": "a404e20a-c2ec-315e-9249-df29fa77309a",
                                                "text": "Parmi les travaux scientifiques de Pavlov relevant de cette époque on trouve les importantes études sur les nerfs centrifuges du cœur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93264126-e2dd-368a-82a2-8eb915bdef44",
                                        "entry_id": "0fe3bbaf-d48d-3c0c-a7a5-b945920e808f",
                                        "glosses": [
                                            "Qualifie la force qui, dans un mouvement de rotation, se forme à l'opposé du centre (ou de l'axe) de rotation."
                                        ],
                                        "tags": [
                                            "especially",
                                            "physical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4058026b-c481-45f9-bd57-70c36fb46e3e",
                                                "sense_id": "93264126-e2dd-368a-82a2-8eb915bdef44",
                                                "text": "Pour étudier l'équilibre d'un corps dans un repère en rotation par rapport à un repère galiléen, on soumet ce corps à une force centrifuge (pour compenser la rotation du repère)."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37165f06-744e-3b1d-a6f8-a5d83c2ff814",
                                        "entry_id": "0fe3bbaf-d48d-3c0c-a7a5-b945920e808f",
                                        "glosses": [
                                            "Qui utilise cette force."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c94ddc2-fc56-4c28-bb6d-c9b65f37f4bb",
                                                "sense_id": "37165f06-744e-3b1d-a6f8-a5d83c2ff814",
                                                "text": "Pour les épandeurs centrifuges à 2 disques et les épandeurs pneumatiques il est préférable, lorsque cela est possible, de vérifier le débit des 2 côtés […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5491f16a-343e-35a1-9940-6897f05d3671",
                                        "entry_id": "0fe3bbaf-d48d-3c0c-a7a5-b945920e808f",
                                        "glosses": [
                                            "Plaçant un noyau devant un modificateur."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "838d8ec4-a54c-3d10-9b8f-263b73ae596a",
                                        "entry_id": "0fe3bbaf-d48d-3c0c-a7a5-b945920e808f",
                                        "glosses": [
                                            "Qui tend vers l'éclatement."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8ce1752b-8bac-42aa-baf8-4c53e882d379",
                                                "sense_id": "838d8ec4-a54c-3d10-9b8f-263b73ae596a",
                                                "text": "Le fait même de devoir tenir compte en permanence des risques d'échec du couple introduit en son sein des forces centrifuges. On s'attend aux signes avant-coureurs, aux craquements prémonitoires. On interprète des problèmes qui, à la génération précédente, auraient été résolus ou étouffés."
                                            }
                                        ]
                                    }
                                ]
                            },
