                "translations": [
                    {
                        "translation_id": "75f10a67-b4d9-485e-bec1-8c5d425eed2c",
                        "source_entry_id": "d1e1c860-7b67-3fa7-ab0a-b464536615bb",
                        "source_sense_id": "2db4515b-dd3a-3520-8e31-b6e798aaffc6",
                        "source_sense_description": "of or pertaining to eczema",
                        "target_lang_word": "eczémateux",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "eczémateux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f4cf7974-f111-3889-bb59-896e8725306a",
                                        "entry_id": "db7bde0f-6883-3d38-888c-d50eb98de8ac",
                                        "glosses": [
                                            "Qui a rapport à l’eczéma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e184742-305e-4bf5-987e-2416a5384bba",
                                                "sense_id": "f4cf7974-f111-3889-bb59-896e8725306a",
                                                "text": "On peut sinon hériter d’une affection eczémateuse, au moins hériter de l’organisation qui favorise son développement."
                                            },
                                            {
                                                "example_id": "0b0f1623-c0d0-4772-ae93-844b6eb9b52c",
                                                "sense_id": "f4cf7974-f111-3889-bb59-896e8725306a",
                                                "text": "Toutefois, si l’herpès des lèvres ou les boutons de fièvre avaient un caractère eczémateux, il serait indispensable d’apporter à vos soins un peu plus d’attention."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "66b229c6-c90c-313a-b99e-02324a6fe399",
                                        "entry_id": "db7bde0f-6883-3d38-888c-d50eb98de8ac",
                                        "glosses": [
                                            "Touché par l’eczéma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "11ba8a8f-8c7c-4acb-b611-0e5e7f1508de",
                                                "sense_id": "66b229c6-c90c-313a-b99e-02324a6fe399",
                                                "text": "[…] un monsieur pas beau, ma foi, avec de vilains yeux, une sale bouche, et un nez surabondamment eczémateux."
                                            },
                                            {
                                                "example_id": "97330a7d-10d4-4c30-9618-935447091df3",
                                                "sense_id": "66b229c6-c90c-313a-b99e-02324a6fe399",
                                                "text": "Pourtant, Ninette Rubis, qui n’était pas une femme absolument comme les autres, détailla un moment le teint rouge et eczémateux du riche banquier, son petit ventre en pointe, ses cheveux grisonnants et rares… et elle hésita, sachant bien à quoi son acceptation l’exposait."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "eczémateux",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "c945f337-1a97-3504-b4f2-b442b08ef8c5",
                                        "entry_id": "f5e7216a-1301-36c0-8cba-c2461240f618",
                                        "glosses": [
                                            "Personne malade de l’eczéma."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c473d5ee-133a-4b90-9425-08a4db60717b",
                                                "sense_id": "c945f337-1a97-3504-b4f2-b442b08ef8c5",
                                                "text": "Faut-il donner de l’arsenic aux eczémateux ?"
                                            },
                                            {
                                                "example_id": "1d84743e-7e38-4518-a87b-cabff476370f",
                                                "sense_id": "c945f337-1a97-3504-b4f2-b442b08ef8c5",
                                                "text": "Il n’est pas rare de voir des eczémateux dégoûtés de la vie et bannis de la société, devenir la proie de la manie ou chercher à s’évader de l’existence par le suicide."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f46931e0-066d-41e6-b371-bb542ec99cb6",
                        "source_entry_id": "d1e1c860-7b67-3fa7-ab0a-b464536615bb",
                        "source_sense_id": "2db4515b-dd3a-3520-8e31-b6e798aaffc6",
