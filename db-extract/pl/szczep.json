                                    },
                                    {
                                        "sense_id": "b669e757-0f72-3c56-b8af-e899ac3910ac",
                                        "entry_id": "24530323-1379-3925-8ce5-77f52674f8b7",
                                        "glosses": [
                                            "Parte de una planta que se une a otra para que crezcan como un único organismo."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6a9710c2-76fa-4c4c-8f0f-968256811796",
                                                "sense_id": "b669e757-0f72-3c56-b8af-e899ac3910ac",
                                                "text": "-Pepe, que sabe tanto y ha de entender de árboles -afirmó doña Perfecta- te enseñará cómo se hacen los injertos. A ver qué opina él de esos peralitos que se van a trasplantar."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3c1ac891-ac23-3946-940a-3fefdd073224",
