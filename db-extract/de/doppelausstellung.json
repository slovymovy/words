                "senses": [
                    {
                        "sense_id": "240d7d9d-0041-391f-bc06-22212c8e59a9",
                        "entry_id": "bd79a0fe-1c31-314b-9a61-e2b2117c9aa8",
                        "glosses": [
                            "Ausstellung von zwei Personen oder zwei Organisationen, oder Ausstellung zu zwei verschiedenen Themen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86bda16c-df40-45e2-863b-0b370686546f",
                                "sense_id": "240d7d9d-0041-391f-bc06-22212c8e59a9",
                                "text": "„Von der Relativität des ‚Augenblicks‘ handelt die Doppelausstellung mit Walter K. Mirtl und L'Ubo Stacho.“"
                            },
                            {
                                "example_id": "ec85d368-3f90-4597-9740-87c6e12b40da",
                                "sense_id": "240d7d9d-0041-391f-bc06-22212c8e59a9",
                                "text": "„Der Zweite, fulminante Teil der Doppelausstellung bietet jetzt ein Panorama moderner und zeitgenössischer Kunst.“"
                            },
                            {
                                "example_id": "df53d248-cebe-4811-9746-05a46318add8",
                                "sense_id": "240d7d9d-0041-391f-bc06-22212c8e59a9",
                                "text": "„[…] im Palazzo dell'Arte, dem weitläufigen, Bauhaus-verpflichteten Bau Giovanni Muzios vom Anfang der dreißiger Jahre im Parco Sempione hinterm Castello, ist eine Doppelausstellung arrangiert unter der Titelkammer \"le citta immaginate\" […]“"
                            },
                            {
                                "example_id": "92d25240-da82-4374-ab8b-de63e04ac8c2",
                                "sense_id": "240d7d9d-0041-391f-bc06-22212c8e59a9",
                                "text": "„Wer die Doppelausstellung Krise und Experiment in Berlin und Frankfurt an der Oder besuchte, erfuhr, dass Kleist ein mobiler, in Netzwerken kommunizierender „Projektemacher“ (Günter Blamberger) war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
