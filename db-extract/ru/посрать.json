                "senses": [
                    {
                        "sense_id": "86d266e0-e3dd-3da1-b2d9-8ab0df9de63e",
                        "entry_id": "4bf90fc1-6d6b-375b-af33-737fd1f2c505",
                        "glosses": [
                            "to have a shit, to take a shit (referring to the whole act, usually in an organised and intentional manner)"
                        ],
                        "tags": [
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "9acacddf-9055-4aa6-85a1-66f68b37fe5d",
                                "sense_id": "86d266e0-e3dd-3da1-b2d9-8ab0df9de63e",
                                "text": "Неа, вообще́-то я собира́лся пойти́ посра́ть.",
                                "translation": "Nah, actually I'm gonna go take a shit.",
                                "english": "Nah, actually I'm gonna go take a shit."
                            }
                        ]
                    },
                    {
                        "sense_id": "4a6da996-4331-3cc1-9ab1-0c6dd4759417",
                        "entry_id": "4bf90fc1-6d6b-375b-af33-737fd1f2c505",
                        "glosses": [
                            "for (someone) to not give a shit [with dative ‘someone’ and на (na, + accusative) ‘about someone/something’] (idiomatically translated by English not give a shit with the dative object as the subject)"
                        ],
                        "tags": [
                            "figuratively",
                            "impersonal",
                            "vulgar"
                        ],
                        "examples": [
                            {
                                "example_id": "bd0f0126-bddd-4c1f-9694-49bbbde38b45",
                                "sense_id": "4a6da996-4331-3cc1-9ab1-0c6dd4759417",
                                "text": "Мне посра́ть на сосе́дей.",
                                "translation": "I don't give a shit about the neighbours.",
                                "english": "I don't give a shit about the neighbours."
                            }
                        ]
                    }
                ],
