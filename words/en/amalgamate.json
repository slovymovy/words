{
    "word_family": [
        "amalgam",
        "amalgamation",
        "amalgamator"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "484587f6-d2b5-3e33-8212-1dd9621db6b3",
                    "sense_definition": "To merge, combine, or blend different elements, organizations, or ideas into a single body.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "merge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The board of directors decided to <w>amalgamate</w> the two companies to reduce operational costs.",
                            "target_lang_translations": {
                                "ru": "Совет директоров решил <w>объединить</w> две компании, чтобы снизить операционные расходы."
                            }
                        },
                        {
                            "text": "It is often difficult to <w>amalgamate</w> different cultures into a single cohesive community.",
                            "target_lang_translations": {
                                "ru": "Часто бывает трудно <w>объединить</w> разные культуры в единое сплоченное сообщество."
                            }
                        }
                    ],
                    "synonyms": [
                        "mix"
                    ],
                    "antonyms": [
                        "separate"
                    ],
                    "common_phrases": [
                        "amalgamate two companies",
                        "amalgamate different cultures"
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять, сливать или смешивать различные элементы, организации или идеи в единое целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединять",
                                "target_lang_sense_clarification": "компании, группы, идеи"
                            },
                            {
                                "target_lang_word": "сливать",
                                "target_lang_sense_clarification": "организации, структуры"
                            },
                            {
                                "target_lang_word": "объединяться",
                                "target_lang_sense_clarification": "о компаниях, группах"
                            },
                            {
                                "target_lang_word": "сливаться",
                                "target_lang_sense_clarification": "о компаниях, культурах"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1dc4f1d3-0a6c-3128-a723-3174c420ade8",
                    "sense_definition": "To alloy or combine a metal with mercury.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "chemistry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Gold miners used to <w>amalgamate</w> the precious metal with mercury to extract it from the ore.",
                            "target_lang_translations": {
                                "ru": "Золотодобытчики раньше <w>амальгамировали</w> драгоценный металл со ртутью, чтобы извлечь его из руды."
                            }
                        },
                        {
                            "text": "The chemist explained how to safely <w>amalgamate</w> silver for dental fillings.",
                            "target_lang_translations": {
                                "ru": "Химик объяснил, как безопасно <w>сплавлять</w> серебро со ртутью для зубных пломб."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Сплавлять или соединять металл со ртутью."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амальгамировать",
                                "target_lang_sense_clarification": "металл со ртутью"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f5d8391e-dde5-38cb-8c9e-78f5efc09308",
                    "sense_definition": "To combine free groups by identifying respective isomorphic subgroups.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In algebraic topology, we often <w>amalgamate</w> groups when computing the fundamental group of a space.",
                            "target_lang_translations": {
                                "ru": "В алгебраической топологии мы часто <w>амальгамируем</w> группы при вычислении фундаментальной группы пространства."
                            }
                        },
                        {
                            "text": "The theorem describes how to <w>amalgamate</w> these specific algebraic structures.",
                            "target_lang_translations": {
                                "ru": "Теорема описывает, как <w>объединять</w> эти специфические алгебраические структуры."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "mathematical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Объединять свободные группы путем отождествления соответствующих изоморфных подгрупп."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амальгамировать",
                                "target_lang_sense_clarification": "математические группы"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "52a7f797-4688-3c0b-96a5-51d7f800762b",
                    "sense_definition": "Coalesced, united, or combined into one.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "merge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>amalgamate</w> entity became a dominant force in the global market.",
                            "target_lang_translations": {
                                "ru": "<w>Объединенная</w> организация стала доминирующей силой на мировом рынке."
                            }
                        },
                        {
                            "text": "These <w>amalgamate</w> groups represent a diverse range of political opinions.",
                            "target_lang_translations": {
                                "ru": "Эти <w>слившиеся</w> группы представляют широкий спектр политических взглядов."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Слившийся, объединенный или совмещенный в одно целое."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "объединенный",
                                "target_lang_sense_clarification": "о структуре, организации"
                            },
                            {
                                "target_lang_word": "слившийся",
                                "target_lang_sense_clarification": "о группах, сущностях"
                            },
                            {
                                "target_lang_word": "амальгамированный",
                                "target_lang_sense_clarification": "смешанный, объединенный"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ad55621f-3e14-3c42-9a4c-156cc9dda2e8",
                    "sense_definition": "A substance or mixture resulting from a process of amalgamation.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "substance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The laboratory analysis identified the compound as a complex <w>amalgamate</w> of various minerals.",
                            "target_lang_translations": {
                                "ru": "Лабораторный анализ определил соединение как сложную <w>смесь</w> различных минералов."
                            }
                        },
                        {
                            "text": "They studied the properties of the resulting <w>amalgamate</w> after the chemical reaction.",
                            "target_lang_translations": {
                                "ru": "Они изучили свойства полученного в результате химической реакции <w>сплава</w>."
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вещество или смесь, полученная в результате процесса объединения или сплавления."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "амальгама",
                                "target_lang_sense_clarification": "сплав ртути с металлом или смесь"
                            },
                            {
                                "target_lang_word": "смесь",
                                "target_lang_sense_clarification": "продукт слияния"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}