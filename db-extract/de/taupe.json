                        "cross_references": [
                            {
                                "target_word": "taupe",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                        "entry_id": "1d64edc4-ddc4-3cb3-9dbd-b6b2e26d2d4b",
                                        "glosses": [
                                            "Petit mammifère quadrupède insectivore et fouisseur, au corps allongé, au museau pointu, aux yeux très petits, au poil court et délié, et qui vit dans des galeries souterraines qu’il creuse avec ses pattes avant."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96cb3a07-3ae9-4ce6-8f96-ee1e33e1bc16",
                                                "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                                "text": "On ne prend jamais au piège les petits de la Taupe : quelquefois les Taupes, au lieu d'entrer dans le piège, remplissent si exactement de terre la taupière, qu'on a peine à la vuider ; […]."
                                            },
                                            {
                                                "example_id": "29b18e93-2982-492b-be52-669277b460e3",
                                                "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                                "text": "Le nom vernaculaire « taupe » désigne en français plusieurs espèces de mammifères du genre Talpa. Toutes ces espèces se ressemblent car leur morphologie externe est très contrainte par leur mode de vie : elles sont fouisseuses et vivent dans des galeries souterraines."
                                            },
                                            {
                                                "example_id": "5d6d748b-8393-4067-abf6-7b20245964c8",
                                                "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                                "text": "Dès les années 1990, le paysagiste, botaniste et écrivain Gilles Clément avait proclamé sa détestation des gazons, son amour des herbes folles et des taupes, du « jardin en mouvement », tout sauf lisse et figé, où le jardinier observe et guide l’évolution naturelle de la végétation, travaillant avec elle, pas contre elle."
                                            },
                                            {
                                                "example_id": "15567212-f69f-42b9-8c84-9ca16994fc28",
                                                "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                                "text": "Des taupes crevaient la terre bénite."
                                            },
                                            {
                                                "example_id": "6ac1c8d1-6fca-422f-9348-9d51cbefc01a",
                                                "sense_id": "b3334816-9966-3748-a9b1-f526e4379d30",
                                                "text": "Seul ce qui est humain peut nous être étranger.\nLe reste, c'est forêts mixtes, travail de taupe et vent."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd458d2-45f7-3a10-a6a9-b9461ea76877",
                                        "entry_id": "1d64edc4-ddc4-3cb3-9dbd-b6b2e26d2d4b",
                                        "glosses": [
                                            "Fourrure faite avec des peaux de taupes assemblées."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ffade19f-2db7-4ca4-8571-0c10f174332f",
                                                "sense_id": "2dd458d2-45f7-3a10-a6a9-b9461ea76877",
                                                "text": "Un manteau de taupe."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2fdbd5ef-84a7-372c-b93a-99f1b4cf7632",
                                        "entry_id": "1d64edc4-ddc4-3cb3-9dbd-b6b2e26d2d4b",
                                        "glosses": [
                                            "Espion infiltré, agent double."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fcc88128-fb74-4277-bae4-5dcd5c6a658f",
                                                "sense_id": "2fdbd5ef-84a7-372c-b93a-99f1b4cf7632",
                                                "text": "Le service avait une taupe en son sein."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "338119d3-c7f9-32ce-9839-b58cc7c494ba",
                                        "entry_id": "1d64edc4-ddc4-3cb3-9dbd-b6b2e26d2d4b",
                                        "glosses": [
                                            "Engin de travaux publics qui permet de creuser des tunnels, tunnelier."
                                        ],
                                        "tags": [
                                            "analogy"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5f90e41e-12e2-3529-8e97-0244aae5f015",
                                        "entry_id": "1d64edc4-ddc4-3cb3-9dbd-b6b2e26d2d4b",
                                        "glosses": [
                                            "Classe de mathématiques spéciales, dont les élèves sont appelés taupins."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e378404f-5493-48a2-aecf-ea00fa3c2db7",
                                                "sense_id": "5f90e41e-12e2-3529-8e97-0244aae5f015",
                                                "text": "Il est en taupe à Louis-le-Grand."
                                            },
                                            {
                                                "example_id": "e100f98c-e086-4a04-abac-c80a8368c607",
                                                "sense_id": "5f90e41e-12e2-3529-8e97-0244aae5f015",
                                                "text": "Je sortais d’une colle* avec A., prof de “taupe” au lycée Condorcet, sur les équations différentielles."
                                            }
