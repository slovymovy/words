                "senses": [
                    {
                        "sense_id": "502c1781-d67c-35c1-bd1b-82f6c4f58ae1",
                        "entry_id": "7e8a84fa-c42c-3f48-af59-62fa94578001",
                        "glosses": [
                            "Faire sortir (du bois…) de la forêt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5d9c15b6-7637-40f8-94db-40549f5fc53d",
                                "sense_id": "502c1781-d67c-35c1-bd1b-82f6c4f58ae1",
                                "text": "Ce bois de commerce il fallait donc le sortir de la forêt, le « débousquer », c’est-à-dire l’amener près des routes « au port », où les billes s’entassaient avant d’être transportées vers les scieries."
                            },
                            {
                                "example_id": "a1228e66-c21f-4f02-a0e7-1bc55aa89ae6",
                                "sense_id": "502c1781-d67c-35c1-bd1b-82f6c4f58ae1",
                                "text": "Au fur et à mesure de la récolte, des camalou s’occupent de ramasser et débousquer le liège jusqu’au plus proche sentier."
                            },
                            {
                                "example_id": "fe2da513-fbb4-40e8-b545-de1b78468391",
                                "sense_id": "502c1781-d67c-35c1-bd1b-82f6c4f58ae1",
                                "text": "Bases existantes de nos \"savoir-faire\" : la Forêt, métallurgie, le bois, \"débousquer\", petit élevage, l’olivier, jardins, bancaus et puits, ..."
                            }
                        ]
                    }
