                                        "glosses": [
                                            "филол., : слово или словосочетание, вносимое в речь, но не несущее никакой смысловой нагрузки (напр., вот, значит, так сказать, собственно, собственно говоря, видите ли, ну, того, это, это самое и т. п.)"
                                        ],
