                    {
                        "sense_id": "26c3f04c-3e02-3ad3-b006-58ec14869840",
                        "entry_id": "7dbb01e2-783a-3f33-b97e-1e0b0c4ad474",
                        "glosses": [
                            "stets nach der aktuellen Mode gekleidete Person"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a897def-62fa-44e1-bec0-5c7eda2a4686",
                                "sense_id": "26c3f04c-3e02-3ad3-b006-58ec14869840",
                                "text": "„Grace ist eine wundervolle Frau. So berühmt und trotzdem ganz auf dem Boden geblieben. Ein netter Mensch. Ein echtes Fashionvictim. Ich habe viel mit Modeln zu tun, aber Ausnahmetalente wie sie gibt es selten.“"
                            },
                            {
                                "example_id": "730fcca2-604c-4112-b80b-b7784036d9ac",
                                "sense_id": "26c3f04c-3e02-3ad3-b006-58ec14869840",
                                "text": "„Dazu gehörten Sisko Walden, die Japanerin Pirouette und Fashionvictim Godehard, Godi genannt, der wie Pirouette zum Ensemble des Bayerischen Staatsballetts gehörte.“"
                            },
                            {
                                "example_id": "33755864-b995-4cac-ae54-d5dd5bd92410",
                                "sense_id": "26c3f04c-3e02-3ad3-b006-58ec14869840",
                                "text": "„Mit dem neuen Maschen-Look begeistern Sie nicht nur sich selbst, sondern auch andere und werden ganz schnell zum Fashionvictim!“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
