                "senses": [
                    {
                        "sense_id": "32168921-30a9-395d-9eed-21bcc9e40900",
                        "entry_id": "d87edd77-4149-3ed5-88d9-f41447da8fde",
                        "glosses": [
                            "Donner un caractère biculturel à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a7db3e2-5d85-40e1-ae74-bf1f4520f4f5",
                                "sense_id": "32168921-30a9-395d-9eed-21bcc9e40900",
                                "text": "Bilinguiser et biculturaliser les Britanniques est peut-être bien le plus sûr moyen de les empêcher de réussir du point de vue économique ;"
                            },
                            {
                                "example_id": "ef846b9b-b442-46b8-b79e-ad44ce2fb613",
                                "sense_id": "32168921-30a9-395d-9eed-21bcc9e40900",
                                "text": "Mes corpus émanent de sujets bilingues et fortement biculturalisés, leur production langagière en porte la trace par l'alternance et le mélange des langues."
                            },
                            {
                                "example_id": "21a22f52-9ddd-4664-a3d2-065b4f86a1a7",
                                "sense_id": "32168921-30a9-395d-9eed-21bcc9e40900",
                                "text": "Dès l'âge de 19 ans ils sont tous bilinguisés et biculturalisés, tout comme les franco-canadiens."
                            }
                        ]
                    }
