{
    "word_family": [
        "bereiden",
        "berijden",
        "bereid"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "3f4bbdc2-9c4e-37e8-b7e8-88605637ce59",
                    "sense_definition": "Waar nog niet over of op gereden is (zoals een weg of ijs).",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We liepen over een vers en <w>onbereden</w> sneeuwdek in de bergen.",
                            "target_lang_translations": {
                                "en": "We walked over a fresh and <w>untrodden</w> blanket of snow in the mountains."
                            }
                        },
                        {
                            "text": "Op dat vroege uur bleef de linkerrijstrook nog volledig <w>onbereden</w>.",
                            "target_lang_translations": {
                                "en": "At that early hour, the left lane remained completely <w>untraveled</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "onbegaan"
                    ],
                    "antonyms": [
                        "bereden"
                    ],
                    "common_phrases": [
                        "onbereden sneeuw",
                        "onbereden ijs"
                    ],
                    "target_lang_definitions": {
                        "en": "Not yet driven, ridden, or traveled on (such as a road or ice)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "untraveled",
                                "target_lang_sense_clarification": "of roads, snow, or ice that has not been driven or walked on"
                            },
                            {
                                "target_lang_word": "unridden",
                                "target_lang_sense_clarification": "of a track, slope, or ice"
                            },
                            {
                                "target_lang_word": "untrodden",
                                "target_lang_sense_clarification": "of snow or path"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "51f3c19e-d69e-3804-b6a3-1e901770d896",
                    "sense_definition": "Niet te paard gezeten; te voet (met name bij politie of militairen).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Zowel bereden als <w>onbereden</w> politie hield het plein nauwlettend in de gaten.",
                            "target_lang_translations": {
                                "en": "Both mounted and <w>unmounted</w> police kept a close eye on the square."
                            }
                        },
                        {
                            "text": "De <w>onbereden</w> agenten surveillanceerden te voet door het drukke winkelcentrum.",
                            "target_lang_translations": {
                                "en": "The <w>foot</w> officers patrolled through the busy shopping center."
                            }
                        }
                    ],
                    "antonyms": [
                        "bereden"
                    ],
                    "common_phrases": [
                        "onbereden politie"
                    ],
                    "target_lang_definitions": {
                        "en": "Not mounted on horseback; on foot (especially regarding police or military)."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unmounted",
                                "target_lang_sense_clarification": "of police or military personnel on foot"
                            },
                            {
                                "target_lang_word": "foot",
                                "target_lang_sense_clarification": "as in foot police"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "071878bc-fd2b-3e15-9387-42d47d27a411",
                    "sense_definition": "Van een paard: geen ruiter dragerig of hebbend.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>onbereden</w> paarden draafden vrolijk rond in de wei.",
                            "target_lang_translations": {
                                "en": "The <w>unridden</w> horses trotted cheerfully around the meadow."
                            }
                        },
                        {
                            "text": "In de carrousel stonden een paar prachtig opgetuigde, maar <w>onbereden</w> paardjes.",
                            "target_lang_translations": {
                                "en": "In the carousel stood a few beautifully harnessed, but <w>unmounted</w> horses."
                            }
                        }
                    ],
                    "antonyms": [
                        "bereden"
                    ],
                    "common_phrases": [
                        "onbereden paard"
                    ],
                    "target_lang_definitions": {
                        "en": "Of a horse: not broken in to ride or currently without a rider."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "unmounted",
                                "target_lang_sense_clarification": "without a rider"
                            },
                            {
                                "target_lang_word": "unridden",
                                "target_lang_sense_clarification": "not ridden or without a rider"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}