                    {
                        "sense_id": "133b269d-09cd-312d-b362-3dbb5e7c0695",
                        "entry_id": "b8addca7-6d2a-3c17-bcf2-5dd6103718e3",
                        "glosses": [
                            "Qui transpire."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "c6d595ac-f06f-4f0a-82cc-a6e3bbdea54a",
                                "sense_id": "133b269d-09cd-312d-b362-3dbb5e7c0695",
                                "text": "Je courus à « la glacière » — une caisse à savon qui contenait un bloc de glace — pour boire frais. J'y trouvai, à côté de la carafe transpirante, deux compotiers pleins de crème fouettée."
                            },
                            {
                                "example_id": "1c308b64-db6a-4b28-9540-42859b176621",
                                "sense_id": "133b269d-09cd-312d-b362-3dbb5e7c0695",
                                "text": "- C’est pourquoi mon gars ? Me lance une stature transpirante qui se relève du derrière du zinc en se tapotant le front, s’épongeant l’encolure en cussant, passant un coup circulaire du même torchon couleur champignon sur une flaque filant par les flancs du comptoir."
                            }
                        ]
                    }
