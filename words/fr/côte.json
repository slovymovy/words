            "senses": [
                {
                    "sense_id": "a7be4f99-f0d4-3acd-bbd8-5010cae9b71a",
                    "sense_definition": "Partie d'un continent ou d'une île qui borde la mer ou l'océan.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons marché pendant des heures le long de la <w>côte</w> pour admirer le paysage marin."
                        },
                        {
                            "text": "De nombreuses maisons de vacances sont construites directement au bord de la <w>côte</w>."
                        }
                    ],
                    "synonyms": [
                        "rivage"
                    ],
                    "common_phrases": [
                        "le long de la côte",
                        "au bord de la côte"
                    ]
                },
                {
                    "sense_id": "a7d29d8b-08fd-320e-a9a6-6b15a4c4e83b",
                    "sense_definition": "Chacun des os courbés qui forment la cage thoracique chez l'être humain et les vertébrés.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le médecin a confirmé qu'il s'était cassé une <w>côte</w> pendant son entraînement de rugby."
                        },
                        {
                            "text": "Après sa mauvaise chute, il ressentait une vive douleur aux <w>côtes</w> à chaque mouvement."
                        }
                    ],
                    "common_phrases": [
                        "se casser une côte",
                        "douleur aux côtes"
                    ]
                },
                {
                    "sense_id": "c2d8fb41-5c9b-3195-a9b6-68a075387ab8",
                    "sense_definition": "Pente inclinée d'un terrain, d'une colline ou d'une route qu'il faut gravir.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cycliste a ralenti l'allure pour monter une <w>côte</w> particulièrement difficile dans la montagne."
                        },
                        {
                            "text": "Arrivés enfin en haut de la <w>côte</w>, les randonneurs ont découvert un magnifique panorama."
                        }
                    ],
                    "synonyms": [
                        "montée"
                    ],
                    "common_phrases": [
                        "monter une côte",
                        "en haut de la côte"
                    ]
                },
                {
                    "sense_id": "bfa4a796-b36b-3c43-aeeb-2f69fd6eca7c",
                    "sense_definition": "Grosse nervure saillante de la tige ou des feuilles de certains légumes.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le cuisinier découpe soigneusement chaque <w>côte</w> de céleri pour préparer un bouillon parfumé."
                        },
                        {
                            "text": "Elle a préparé un délicieux gratin avec des <w>côtes</w> de blettes fraîches du potager."
                        }
                    ],
                    "common_phrases": [
                        "côte de céleri",
                        "côtes de blettes"
                    ]
                },
                {
                    "sense_id": "3453df77-f956-39b1-ac33-adff252ed14f",
                    "sense_definition": "Ligne ou relief longitudinal saillant sur la surface d'un tissu ou d'un tricot.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mon grand-père portait toujours une veste en velours à <w>côtes</w> marron pendant la saison froide."
                        },
                        {
                            "text": "Ce pull épais présente des <w>côtes</w> bien régulières qui lui donnent une grande souplesse."
                        }
                    ],
                    "common_phrases": [
