                                "sense_id": "9b61f894-08ff-332b-9c88-1105407d8ef5",
                                "text": "Weinbaugebiete sind oft historisch gewachsene Regionen."
                            },
                            {
                                "example_id": "e6f5ae85-d1d8-4101-be34-c300d04eaef8",
                                "sense_id": "9b61f894-08ff-332b-9c88-1105407d8ef5",
                                "text": "Das Weinbaugebiet Württemberg weist hochinteressante Rotweine auf."
                            }
                        ],
