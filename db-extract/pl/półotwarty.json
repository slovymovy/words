                        "translation_id": "7c5f29c0-3a8e-4ab9-83fa-4d1df38b0296",
                        "source_entry_id": "cc396c72-a8f2-36ea-a5d9-1c229da4f9ed",
                        "source_sense_id": "08a8c2e0-5c51-3c18-9649-496d5c45d94a",
                        "target_lang_word": "ajar",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bfd5413a-cd4a-3ef8-b9a3-1d40e3969a9b",
                                        "entry_id": "0ce1f5a2-d265-38f9-9c3e-8209d10974fc",
                                        "glosses": [
                                            "Slightly turned or opened."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "71c786ab-6453-4337-be7a-7007b02c3ffc",
                                                "sense_id": "bfd5413a-cd4a-3ef8-b9a3-1d40e3969a9b",
                                                "text": "The door was standing ajar."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                        "entry_id": "2320d6b4-62a6-3156-bfa6-70e72ba40ce8",
                                        "glosses": [
                                            "Slightly turned or opened."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "855ccc05-39e7-4dea-aa35-39d1fe91465b",
                                                "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                                "text": "The door is ajar."
                                            },
                                            {
                                                "example_id": "d023ddc1-364c-49ac-99b4-50f993c41ca5",
                                                "sense_id": "10406c9c-664e-390b-be91-84a61fc5885c",
                                                "text": "I know—for Death, who comes for me\nFrom regions of the blest afar,\nWhere there is nothing to deceive,\nHath left his iron gate ajar, […]"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                        "entry_id": "f40fa8b8-88d9-3058-8335-3bb6f76db8ee",
                                        "glosses": [
                                            "To turn or open slightly; to become ajar or to cause to become ajar; to be or to hang ajar."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7c236d44-bf74-4c08-8b1f-45cecc2a8876",
                                                "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                                "text": "A plainclothes detective knocked on a slightly ajarred door."
                                            },
                                            {
                                                "example_id": "34d63284-1fb4-461f-9f41-b7b2be7de838",
                                                "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                                "text": "Yes, and the door also lops off stairs leading to a landing on whose landing is another door on whose hinges much of this story ajars, if it hasn't jarred too much already."
                                            },
                                            {
                                                "example_id": "cf12da62-b13c-40c0-8ced-19af04725fd0",
                                                "sense_id": "28a334ac-1428-3eb0-87c2-f84dcd447554",
                                                "text": "Just as the gates fully ajarred themselves, the Lamborghini soared through them, and out into the freedom of the poorly defined road."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "672f66e7-d34a-34e9-b4fb-f25533ec9132",
                                        "entry_id": "fcc561c7-7eed-3e72-9c60-4eaa073e1d35",
                                        "glosses": [
                                            "Out of harmony."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "not-comparable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "ff9f730a-ca69-3fa4-a2c0-88600d295f62",
                                        "entry_id": "fcc561c7-7eed-3e72-9c60-4eaa073e1d35",
                                        "glosses": [
                                            "Being at variance or in contradiction to something."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5961360-51d3-445c-9afe-7d62d372f0b2",
                                                "sense_id": "ff9f730a-ca69-3fa4-a2c0-88600d295f62",
                                                "text": "There is a sort of unexpressed concern, / A kind of shock that sets one's heart ajar […]."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "ajar",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1044cd10-ac13-3c28-8eef-c97381723c59",
                                        "entry_id": "11f36e77-5e68-302f-a941-9e2f5149eac6",
                                        "glosses": [
                                            "To show variance or contradiction with something; to be or cause to be askew."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dac1b297-44e4-40d5-b293-6dde022cfcac",
                                                "sense_id": "1044cd10-ac13-3c28-8eef-c97381723c59",
                                                "text": "It clean deafened the two of us, and set all the crockery ware ajarring ; and when the neighbours heard it they came running into the street to see who was getting hurt."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
