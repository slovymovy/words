                "senses": [
                    {
                        "sense_id": "e0e7e23c-7fd5-35a3-87d4-042a0880534d",
                        "entry_id": "073a47db-6931-352a-b694-21add9d5e121",
                        "glosses": [
                            "vorbacken (um anschließend eingefroren zu werden)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "79bbe8cb-28d3-485c-a188-728793eec89d",
                                "sense_id": "e0e7e23c-7fd5-35a3-87d4-042a0880534d",
                                "text": "„In any case, Kaplan says, the deterioration of French bread started long before parbaking, a result of the food shortages in France during the two world wars.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0da03f12-3767-49a8-945f-1d60bd3153f6",
                        "source_entry_id": "073a47db-6931-352a-b694-21add9d5e121",
                        "source_sense_id": "e0e7e23c-7fd5-35a3-87d4-042a0880534d",
                        "source_sense_description": "vorbacken (um anschließend eingefroren zu werden)",
                        "target_lang_word": "vorbacken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "vorbacken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b617acb9-33de-3a70-a5db-d433325f617d",
                                        "entry_id": "7d3ec5b7-0be2-3e5d-a7fd-d4e7242b36d4",
                                        "glosses": [
                                            "den reinen Teig ohne Füllung oder Belag, meist beschwert mit einer Auflage wie zum Beispiel trockene Erbsen, so lange backen, bis er trocken wird und Feuchtigkeit besser standhält"
                                        ],
                                        "tags": [
                                            "Kochen"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f561039b-515a-4b3b-90dc-8cefc8a855ae",
                                                "sense_id": "b617acb9-33de-3a70-a5db-d433325f617d",
                                                "text": "„‚Blindbacken‘ bezeichnet das Vorbacken von Mürbeteig ohne Füllung oder Belag. Dadurch erhält man einen knusprigen Boden, der nicht aufweicht (wichtig bei z.B. Obstkuchen).“"
                                            },
                                            {
                                                "example_id": "e630a564-c9ac-4795-80c8-13a012bcf082",
                                                "sense_id": "b617acb9-33de-3a70-a5db-d433325f617d",
                                                "text": "„Blind vorbacken: Backpapier auf den Boden legen und auf das Backpapier Hülsenfrüchte (trockenen Linsen, Erbsen oder auch Reis) verteilen – so wird der Boden beschwert und kann nicht hochgehen.“"
                                            },
                                            {
                                                "example_id": "c272022b-0213-443f-81cc-c32cfee0f597",
                                                "sense_id": "b617acb9-33de-3a70-a5db-d433325f617d",
                                                "text": "„Dann legt man ihn in einer Quicheform aus und sticht mit der Gabel ein paar Mal rein. Wenn man den Teig ganz dünn ausrollt, braucht man ihn nicht vorzubacken.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
