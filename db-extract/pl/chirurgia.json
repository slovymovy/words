                    {
                        "translation_id": "7e637bc9-7524-4839-85cc-701c5a4aed83",
                        "source_entry_id": "0c4e0a2a-8169-3dbb-abda-33d2efcd0930",
                        "source_sense_id": "680e6de2-0440-3d70-842e-1eabc3d76935",
