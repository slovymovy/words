                        "examples": [
                            {
                                "example_id": "4855795a-3bee-4c1a-86a4-565549aac319",
                                "sense_id": "6b390aba-21b3-3d14-858f-de7fd09ea4fb",
                                "text": "Samara: I will be in the shadows watching, Shepard. You will never be alone -- this I swear. But you cannot barge in with guns and allies.\nSamara: Morinth is far too cagey -- she'd simply disappear. This is a subtle, delicate act. Trust me."
                            },
                            {
                                "example_id": "91e36991-9033-40be-88cb-ffab8f925838",
                                "sense_id": "6b390aba-21b3-3d14-858f-de7fd09ea4fb",
                                "text": "But with both sides in the Premier League's bottom three before the game began, the three points at stake made for a cagey match."
                            }
                        ]
                    },
                    {
                        "sense_id": "f5651358-8f68-38bb-b770-235fc867cffb",
                        "entry_id": "bc4b51cf-74ce-3b21-a563-2af6a451c856",
                        "glosses": [
                            "Uncommunicative; unwilling or hesitant to give information."
                        ],
                        "tags": [],
                        "examples": [
