                ],
                "senses": [
                    {
                        "sense_id": "0031ae36-7dd5-3c22-8728-4bec2d974251",
                        "entry_id": "08a8103e-03de-374e-b066-ee49d5e2f9f6",
                        "glosses": [
                            "gerade eben erst oder kürzlich gewonnen(e) (Milch vom Milchvieh)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2b2ef77-99f7-4f7b-8bfe-a631584fc3c4",
                                "sense_id": "0031ae36-7dd5-3c22-8728-4bec2d974251",
                                "text": "„Interessante Gäste und Themen können auch für Pausenabwechslung sorgen: Ein Bauer, der melkfrische Milch und neue Milchprodukte abgibt, ein Bäcker aus der Umgebung, der ofenfrisches Gebäck verteilt oder ein Gemüse- und Früchtehändler, der Neues zur Saison anbietet.“"
                            },
                            {
                                "example_id": "3a6cfcf8-cf65-4849-b46c-cd67ea6a1a86",
                                "sense_id": "0031ae36-7dd5-3c22-8728-4bec2d974251",
                                "text": "„Jetzt muss man nur noch Geld einwerfen und den Startknopf drücken – und schon sprudelt melkfrische (allerdings gekühlte!) Milch in die Flasche.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
