                                    {
                                        "sense_id": "ca466c4c-c81c-309b-a399-e43d0ce9b1f8",
                                        "entry_id": "94fc463b-c966-32d9-bff3-9526ee3f7f10",
                                        "glosses": [
                                            "Discrimination or prejudice that is based on social class, especially against those of lower social class."
                                        ],
