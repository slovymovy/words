                                    {
                                        "sense_id": "ca40dee3-a97e-33cd-9458-285e5cbd0d48",
                                        "entry_id": "5503982b-fa1c-33ff-aab0-39911aa9a01c",
                                        "glosses": [
                                            "Pluriel de citoyen."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "263c0183-90e5-4517-a28e-d33351330abd",
                                                "sense_id": "ca40dee3-a97e-33cd-9458-285e5cbd0d48",
                                                "text": "En définitive, le réformisme et le légalisme des mouvements de citoyens ont donné leur marque à la « révolution pacifique » de l’automne 1989."
                                            }
                                        ]
                                    }
                                ]
