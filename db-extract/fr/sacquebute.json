                        "glosses": [
                            "Lance à bout crochu destinée à désarçonner un cavalier."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a9a83300-2717-4c67-8926-761f8d07a3a5",
                                "sense_id": "c51ed9ba-87ba-3476-b3c1-63a55198297c",
                                "text": "La pique que les Flamands et les Picards maniaient avec habileté avait donné naissance à une variante munie d'un croc pour désarçonner le cavalier: la saquebute."
                            }
                        ]
                    },
