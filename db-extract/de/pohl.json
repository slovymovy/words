                ],
                "senses": [
                    {
                        "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                        "entry_id": "1784772c-396b-308e-8cd2-2e48d98fb7b0",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "80d7539a-96e1-4c15-9287-cfcdd373946c",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Frau Pohl ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "c7639e6b-8557-42ee-9e6a-008983be665b",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Herr Pohl wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "fe310e6b-098b-4aaa-96bc-e115063dcc7d",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Die Pohls fahren heute in den Thüringer Wald."
                            },
                            {
                                "example_id": "bb1fed5e-3422-454f-b5df-ac105023c9b0",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Der Pohl trägt nie die Schals, die die Pohl ihm strickt."
                            },
                            {
                                "example_id": "29b2de31-3d21-4406-b186-af0defa075a4",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Pohl kommt, geht der Herr Pohl.“"
                            },
                            {
                                "example_id": "4abfc3d9-9e73-48e4-bed9-4fb67c041781",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Pohl kommt und geht."
                            },
                            {
                                "example_id": "2d1a8092-abe1-49b5-ae6d-f52c8c800d49",
                                "sense_id": "f13e3832-6c32-32ee-8fa9-81cad138234c",
                                "text": "Pohls kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
