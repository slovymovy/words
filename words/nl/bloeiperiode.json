            "pos": "noun",
            "senses": [
                {
                    "sense_id": "81fe4ec3-eaf2-3a8d-ae7f-cd01fd02dc2f",
                    "sense_definition": "De tijd of het seizoen waarin planten en bloemen in bloei staan.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In de lente begint de <w>bloeiperiode</w> van de tulpen in de tuin. ",
                            "target_lang_translations": {
                                "fr": "Au printemps commence la <w>période de floraison</w> des tulipes dans le jardin."
                            }
                        },
                        {
                            "text": "Tijdens de warme <w>bloeiperiode</w> komen er veel toeristen naar de bollenvelden.",
                            "target_lang_translations": {
                                "fr": "Pendant la chaude <w>saison de floraison</w>, de nombreux touristes viennent voir les champs de tulipes."
                            }
                        }
                    ],
                    "synonyms": [
                        "bloeiseizoen"
                    ],
                    "common_phrases": [
                        "de bloeiperiode van tulpen",
                        "korte bloeiperiode"
                    ],
                    "target_lang_definitions": {
                        "fr": "La période ou la saison pendant laquelle les plantes et les fleurs sont en floraison."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "période de floraison",
                                "target_lang_sense_clarification": "pour les fleurs et plantes"
                            },
                            {
                                "target_lang_word": "saison de floraison",
                                "target_lang_sense_clarification": "saison des fleurs"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "311f0609-a310-3153-b1c3-15f97a8275b8",
                    "sense_definition": "Een tijdperk waarin iets, zoals de economie, kunst of een organisatie, heel succesvol is en een grote groei doormaakt.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Het bedrijf kent momenteel een fantastische <w>bloeiperiode</w> op de internationale markt.",
                            "target_lang_translations": {
                                "fr": "L'entreprise connaît actuellement une formidable <w>période de prospérité</w> sur le marché international."
                            }
                        },
                        {
                            "text": "Na de oorlog beleefde de stad een economische <w>bloeiperiode</w>.",
                            "target_lang_translations": {
                                "fr": "Après la guerre, la ville a connu une <w>période de prospérité</w> économique."
                            }
                        }
                    ],
                    "synonyms": [
                        "hoogtij",
                        "hoogconjunctuur"
                    ],
                    "common_phrases": [
                        "economische bloeiperiode",
                        "een bloeiperiode doormaken"
                    ],
                    "target_lang_definitions": {
                        "fr": "Une époque au cours de laquelle quelque chose, comme l'économie, l'art ou une organisation, est très florissant et connaît une grande croissance."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "période de prospérité",
                                "target_lang_sense_clarification": "pour l'économie ou une organisation"
                            },
                            {
                                "target_lang_word": "âge d'or",
                                "target_lang_sense_clarification": "période apogée ou glorieuse"
                            },
                            {
                                "target_lang_word": "période d'épanouissement",
                                "target_lang_sense_clarification": "pour l'art ou la culture"
                            }
                        ]
                    }
                }
            ]
        }
    ]
