    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d4e3d4a7-f959-3a77-bf01-c0ecb7d53ec9",
                    "sense_definition": "Personne méprisable, malhonnête et dépourvue de scrupules.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moralite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cet homme d'affaires s'est conduit comme une véritable <w>canaille</w> avec ses employés."
                        },
                        {
                            "text": "Méfie-toi de lui, c'est une <w>canaille</w> qui cherche toujours à tromper les gens."
                        }
                    ],
                    "synonyms": [
                        "salaud"
                    ],
                    "common_phrases": [
                        "vieille canaille",
                        "espèce de canaille"
                    ]
                },
                {
                    "sense_id": "dcf084d3-456e-3c48-90df-1a544bdb4100",
                    "sense_definition": "Enfant turbulent ou espiègle, qualifié ainsi avec une nuance affectueuse.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "jeunesse",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ces petites <w>canailles</w> ont encore caché les clés de la voiture dans le jardin."
                        },
                        {
                            "text": "Viens ici, petite <w>canaille</w>, et finis ton assiette avant de repartir jouer !"
                        }
                    ],
                    "common_phrases": [
                        "petite canaille"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Employé familièrement et affectueusement pour parler d'un enfant."
                        }
                    ]
                },
                {
                    "sense_id": "b556c6ed-9370-3c2b-82a8-75906d09d9ca",
                    "sense_definition": "Ensemble d'individus considérés comme vils ou de basse condition sociale ; la populace.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "collectif",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'aristocrate refusait obstinément de se mêler à la <w>canaille</w> réunie sur la place publique."
                        },
                        {
                            "text": "Dans ce roman historique, les nobles méprisaient la <w>canaille</w> qui manifestait devant le château."
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Usage péjoratif ancien pour désigner le bas peuple."
                        }
                    ]
                }
            ]
        },
        {
