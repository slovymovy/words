                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b4037f6-f1f3-427a-acaa-49f45db19c9e",
                                "sense_id": "c90de0cc-5d7d-3954-b5b7-225ab153de7e",
                                "text": "Aan de vooravond van de Europese verkiezingen schuiven de organisaties dan ook een politiek eisenpakket naar voren. — C'est pourquoi à la veille des élections européennes, les organisations européennes déposent un paquet de revendications politiques."
                            }
                        ]
                    },
                    {
                        "sense_id": "9a79a65c-ae18-32c4-9d24-345b0b53d14d",
                        "entry_id": "876cc524-e236-38fc-87f6-112b4e50c393",
                        "glosses": [
