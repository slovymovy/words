                    {
                        "translation_id": "28ff0154-1fdb-4763-840b-29b9cba5b28d",
                        "source_entry_id": "306cf142-c1b4-3ce5-ab6c-0255d0f1d550",
                        "source_sense_description": "act of subjugating",
                        "target_lang_word": "assujettissement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "assujettissement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ebbe7abf-64b8-3750-8e68-8898430f0723",
                                        "entry_id": "d8b39983-0204-38ff-8a13-0ea198ca246e",
                                        "glosses": [
                                            "Action d'assujettir, de soumettre, de conquérir."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5a5bd3f-05a3-4e2d-96db-d177e15705a0",
                                                "sense_id": "ebbe7abf-64b8-3750-8e68-8898430f0723",
                                                "text": "L'assujettissement de ce pays a pris du temps."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d108a293-fbff-368b-b739-1024a09272a9",
                                        "entry_id": "d8b39983-0204-38ff-8a13-0ea198ca246e",
                                        "glosses": [
                                            "État de soumission, de dépendance."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e5c05895-9cfd-4fd0-b2fe-6ab16b275888",
                                                "sense_id": "d108a293-fbff-368b-b739-1024a09272a9",
                                                "text": "D'une manière générale, la densification des sentiments familiaux et l'assujettissement indolore de la sexualité qui caractérisent la conjugalité et l'intimité bourgeoises, en se diffusant dans l'ensemble du corps social, aboutissaient à faire de l'érotisme une spécialité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9912e652-ace8-3a6e-aeb4-f096e6701bec",
                                        "entry_id": "d8b39983-0204-38ff-8a13-0ea198ca246e",
                                        "glosses": [
                                            "Contrainte, obligation de faire une chose."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e6a98641-fa61-4003-b7b8-81dc86252abe",
                                                "sense_id": "9912e652-ace8-3a6e-aeb4-f096e6701bec",
                                                "text": "L'élévation a ses assujettissements et ses inquiétudes ; l'obscurité ses humiliations et ses mépris."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a56180f8-cba7-4bf4-aaed-b6d9c994bb0a",
                        "source_entry_id": "306cf142-c1b4-3ce5-ab6c-0255d0f1d550",
                        "source_sense_description": "act of subjugating",
                        "target_lang_word": "Unterwerfung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Unterwerfung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "die Handlung, sich jemandem zu ergeben; Akzeptanz einer (Zwangs-)Herrschaft oder Macht"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ffa36879-29ac-469c-8782-860838afbc60",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "Jetzt aufzuhören, käme einer Unterwerfung gleich."
                                            },
                                            {
                                                "example_id": "d6ea7957-2918-4601-bbb5-3d23f1e90e8f",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Er stieß weit nach Osten vor, plünderte und zerstörte seinerseits den Ring, nahm die Unterwerfung des Khagans entgegen und trieb die Scharen der Awaren, die sich nicht beugen wollten, zur Flucht über die Theiß nach Osten.“"
                                            },
                                            {
                                                "example_id": "14543a5a-c741-4bfa-95b1-2a2637fe95a7",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Mein Alter und mein Status geben ihr die vernunftmäßig nachvollziehbare Erlaubnis, sich zu unterwerfen, und im Bett ist Unterwerfung kein unangenehmes Gefühl.“"
                                            },
                                            {
                                                "example_id": "d2132f10-9288-4725-b594-732938177116",
                                                "sense_id": "d9011017-b8d9-3ce0-b6a3-2313ffea6656",
                                                "text": "„Der Despotismus erhöht die Wollust, er sucht Unterwerfung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                        "entry_id": "24347d59-94f7-3fc0-9fe5-fdd9ffb44ba2",
                                        "glosses": [
                                            "gewaltsame Aneignung eines Herrschaftsgebiets"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd73cb14-9125-4243-b852-ff03df71f020",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "Die Unterwerfung des besiegten Landes führte zu Protesten."
                                            },
                                            {
                                                "example_id": "c242b868-2d78-4dd2-be26-6b622f7f1e01",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Nach der Unterwerfung der nördlichen Grenzvölker und dem Abkommen mit dem Partherkönig im Osten 20 v. Chr. schien der Friede des Reiches tatsächlich für immer gesichert.“"
                                            },
                                            {
                                                "example_id": "d8ce7107-af91-4dea-8fb3-9386c2fb25a7",
                                                "sense_id": "99649efb-81d8-3667-9518-6387c7e81da7",
                                                "text": "„Ihm steckten Erfahrungen in den Knochen, die er wenige Jahre zuvor bei der Unterwerfung der Kumanen gemacht hatte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
