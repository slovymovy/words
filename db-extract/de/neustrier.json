                "senses": [
                    {
                        "sense_id": "d44671ee-912f-3448-81da-128b70d3dfca",
                        "entry_id": "d118be24-1620-3060-9ca8-e5ab0f3b2d13",
                        "glosses": [
                            "Bewohner des nordwestlichen Teil des Frankenreiches (Neustrien)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "b1a91da5-94c8-4504-9516-cbbde65a2683",
                                "sense_id": "d44671ee-912f-3448-81da-128b70d3dfca",
                                "text": "„Auch die Neustrier rang Karl Martell schließlich nieder, obgleich sie sich mit dem Herzog Eudo von Aquitanien verbündet hatten.“"
                            },
                            {
                                "example_id": "9ab551be-9a98-4002-907e-ff9a3817ff46",
                                "sense_id": "d44671ee-912f-3448-81da-128b70d3dfca",
                                "text": "„Karl, genannt Martell (Hammer), geb. um 689, Sohn Pippins von Heristal, seit 720 Majordomus des Fränk. Reichs, unterwarf die Neustrier, die Friesen und Sachsen sowie Burgund […].“"
                            },
                            {
                                "example_id": "6a8ed55a-22c5-4d74-acb5-da7fb6a2549c",
                                "sense_id": "d44671ee-912f-3448-81da-128b70d3dfca",
                                "text": "„Die Neustrier entschieden sich stattdessen für einen Merowingerprinzen, der eigentlich lange vergessen schien und für den seine Erhebung ein ‹Kulturschock› gewesen sein muss […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
