                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ontslag",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "De <w>opgestapte</w> president bemoeide zich verder niet meer met de politiek van zijn land.",
                            "target_lang_translations": {
                                "en": "The <w>resigned</w> president no longer interfered with the politics of his country."
                            }
                        },
                        {
                            "text": "De kranten schreven uitgebreid over de <w>opgestapte</w> minister en zijn redenen voor vertrek.",
                            "target_lang_translations": {
