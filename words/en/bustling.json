{
    "word_family": [
        "bustle"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "814103db-340f-3071-995c-e4741a435c58",
                    "sense_definition": "Full of energetic, noisy activity and people; busy.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked through the <w>bustling</w> marketplace to buy fresh vegetables.",
                            "target_lang_translations": {
                                "it": "Abbiamo attraversato il <w>vivace</w> mercato per comprare verdure fresche."
                            }
                        },
                        {
                            "text": "The city center remains <w>bustling</w> with tourists even late at night.",
                            "target_lang_translations": {
                                "it": "Il centro città rimane <w>animato</w> dai turisti anche a tarda notte."
                            }
                        }
                    ],
                    "synonyms": [
                        "lively"
                    ],
                    "common_phrases": [
                        "bustling marketplace",
                        "bustling city street",
                        "bustling crowd"
                    ],
                    "target_lang_definitions": {
                        "it": "Pieno di attività energica, rumorosa e di persone; molto frequentato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "vivace",
                                "target_lang_sense_clarification": "riferito a un luogo pieno di vita e movimento"
                            },
                            {
                                "target_lang_word": "animato",
                                "target_lang_sense_clarification": "riferito a un luogo pieno di gente e attività"
                            },
                            {
                                "target_lang_word": "frenetico",
                                "target_lang_sense_clarification": "riferito a un luogo caratterizzato da un ritmo di attività molto intenso"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f120b049-fa73-39bb-b4d6-d50da4e42aa8",
                    "sense_definition": "An instance of busy, noisy activity or movement.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The constant <w>bustling</w> in the corridor made it difficult to sleep.",
                            "target_lang_translations": {
                                "it": "Il costante <w>trambusto</w> nel corridoio rendeva difficile dormire."
                            }
                        },
                        {
                            "text": "She ignored the morning <w>bustling</w> of waiters around the busy café.",
                            "target_lang_translations": {
                                "it": "Ha ignorato il <w>trambusto</w> mattutino dei camerieri nel bar affollato."
                            }
                        }
                    ],
                    "common_phrases": [
                        "morning bustling"
                    ],
                    "target_lang_definitions": {
                        "it": "Un episodio di attività o movimento frenetico e rumoroso."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "trambusto",
                                "target_lang_sense_clarification": "confusione causata da un movimento frenetico"
                            },
                            {
                                "target_lang_word": "agitazione",
                                "target_lang_sense_clarification": "stato di movimento continuo e disordinato"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "384460d1-7d2b-34a1-966e-5d551230ae34",
                    "sense_definition": "present participle and gerund of <w>bustle</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was <w>bustling</w> around the kitchen trying to prepare dinner on time.",
                            "target_lang_translations": {
                                "it": "Si stava <w>affaccendando</w> in cucina cercando di preparare la cena in tempo."
                            }
                        },
                        {
                            "text": "After hours of <w>bustling</w> about the office, he finally took a short break.",
                            "target_lang_translations": {
                                "it": "Dopo ore ad <w>affaccendarsi</w> in ufficio, si è finalmente preso una breve pausa."
                            }
                        }
                    ],
                    "common_phrases": [
                        "bustling around",
                        "bustling about"
                    ],
                    "target_lang_definitions": {
                        "it": "Participio presente e gerundio del verbo 'bustle', che significa muoversi in modo energico e indaffarato."
                    },
                    "translations": {
                        "it": [
                            {
                                "target_lang_word": "affaccendarsi",
                                "target_lang_sense_clarification": "muoversi con fretta per svolgere diverse attività"
                            },
                            {
                                "target_lang_word": "darsi da fare",
                                "target_lang_sense_clarification": "essere molto attivi e operosi"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}