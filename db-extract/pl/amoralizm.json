                                        "glosses": [
                                            "doctrine which advocates absence of, or indifference towards any morality."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "79f1920b-777b-4f07-92d2-5b85275e5246",
                                                "sense_id": "38a12c8e-d1a7-31ae-91e2-96b8ada707bf",
                                                "text": "Acknowledging the force of that intuition is, however, quite compatible with the possibility of amoralism."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ad79c843-46c4-494c-9b8b-95632ff7e576",
