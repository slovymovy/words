                                "target_lang_sense_clarification": "debido a una equivocación o descuido"
                            },
                            {
                                "target_lang_word": "accidentalmente",
                                "target_lang_sense_clarification": "de manera accidental"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "accidentellement",
                                "target_lang_sense_clarification": "action involontaire"
                            },
                            {
                                "target_lang_word": "par accident",
                                "target_lang_sense_clarification": "sans intention"
                            },
                            {
                                "target_lang_word": "sans le vouloir",
                                "target_lang_sense_clarification": "de manière involontaire"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6bc64c91-f1b3-342e-b9fe-273f359d4d29",
                    "sense_definition": "В результате стечения обстоятельств, не по плану; неожиданно.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "coincidence",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Мы <w>случайно</w> встретились в парке после долгих лет разлуки.",
                            "target_lang_translations": {
                                "en": "We met <w>by chance</w> in the park after many years apart.",
                                "es": "Nos encontramos <w>por casualidad</w> en el parque después de muchos años sin vernos.",
                                "fr": "Nous nous sommes rencontrés <w>par hasard</w> dans le parc après de longues années de séparation."
                            }
                        },
                        {
                            "text": "Я <w>случайно</w> узнал об этом секрете из разговора коллег.",
                            "target_lang_translations": {
                                "en": "I found out about this secret <w>by accident</w> from a conversation between colleagues.",
                                "es": "Me enteré de este secreto <w>casualmente</w> por una conversación entre compañeros.",
                                "fr": "J'ai appris ce secret <w>par hasard</w> en entendant une conversation entre collègues."
                            }
                        }
                    ],
                    "synonyms": [
                        "непредвиденно",
                        "волею судеб"
                    ],
                    "antonyms": [
                        "закономерно"
                    ],
                    "common_phrases": [
                        "встретиться случайно",
                        "узнать случайно",
                        "найти случайно"
                    ],
                    "target_lang_definitions": {
                        "en": "Happening unexpectedly or as a result of coincidence rather than a plan.",
                        "es": "Como resultado de una coincidencia o sin haber sido planeado.",
                        "fr": "Qui se produit de manière inattendue ou par coïncidence."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "by chance",
                                "target_lang_sense_clarification": "due to luck or coincidence"
                            },
                            {
                                "target_lang_word": "accidentally",
                                "target_lang_sense_clarification": "unexpectedly (e.g., meeting someone)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por casualidad",
                                "target_lang_sense_clarification": "por coincidencia de circunstancias"
                            },
                            {
                                "target_lang_word": "casualmente",
                                "target_lang_sense_clarification": "de modo fortuito"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "par hasard",
                                "target_lang_sense_clarification": "de manière fortuite"
                            },
                            {
                                "target_lang_word": "fortuitement",
                                "target_lang_sense_clarification": "par coïncidence (soutenu)"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "395866ac-76f5-3c90-a7c6-4ae16c3bb701",
                    "sense_definition": "Вводное слово, используемое в вежливых вопросах для выражения предположения или неуверенности.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "question_particle",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Вы, <w>случайно</w>, не знаете, где находится ближайшая аптека?",
                            "target_lang_translations": {
                                "en": "Do you <w>by any chance</w> know where the nearest pharmacy is?",
                                "es": "¿No sabe <w>por casualidad</w> dónde está la farmacia más cercana?",
                                "fr": "Est-ce que <w>par hasard</w> vous sauriez où se trouve la pharmacie la plus proche ?"
                            }
                        },
                        {
                            "text": "Ты <w>случайно</w> не видел мои ключи от машины?",
                            "target_lang_translations": {
                                "en": "Have you <w>by any chance</w> seen my car keys?",
                                "es": "¿<w>De casualidad</w> no has visto las llaves de mi coche?",
                                "fr": "Tu n'aurais pas vu mes clés de voiture <w>par hasard</w> ?"
                            }
                        }
                    ],
                    "synonyms": [
                        "случаем",
                        "часо́м"
                    ],
                    "common_phrases": [
                        "вы случайно не",
                        "ты случайно не"
                    ],
                    "target_lang_definitions": {
                        "en": "Used in polite questions to tentatively ask for information or confirm a possibility.",
                        "es": "Palabra de enlace usada en preguntas corteses para expresar suposición o duda.",
                        "fr": "Utilisé dans les questions polies pour exprimer une supposition ou une hésitation."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "by any chance",
                                "target_lang_sense_clarification": "used in polite inquiries"
                            },
                            {
                                "target_lang_word": "happen to",
                                "target_lang_sense_clarification": "verb structure (e.g., do you happen to know)"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "por casualidad",
                                "target_lang_sense_clarification": "usado en preguntas de cortesía"
                            },
                            {
                                "target_lang_word": "de casualidad",
                                "target_lang_sense_clarification": "fórmula de consulta amable"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "par hasard",
                                "target_lang_sense_clarification": "dans les questions polies"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c796fbb6-da3d-365e-b55c-e3e17012af75",
                    "sense_definition": "Без определённого порядка, системы или закономерности; произвольно.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "randomness",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Компьютер <w>случайно</w> выбирает победителя из списка участников.",
                            "target_lang_translations": {
                                "en": "The computer <w>randomly</w> selects a winner from the list of participants.",
                                "es": "El ordenador elige <w>al azar</w> al ganador de la lista de participantes.",
                                "fr": "L'ordinateur choisit le gagnant <w>au hasard</w> dans la liste des participants."
                            }
                        },
                        {
                            "text": "Книги на полке были расставлены <w>случайно</w>, без всякой логики.",
                            "target_lang_translations": {
                                "en": "The books on the shelf were arranged <w>randomly</w>, without any logic.",
                                "es": "Los libros de la estantería estaban colocados <w>aleatoriamente</w>, sin ninguna lógica.",
                                "fr": "Les livres sur l'étagère étaient disposés <w>au hasard</w>, sans aucune logique."
                            }
                        }
                    ],
                    "synonyms": [
                        "беспорядочно",
                        "как попало"
                    ],
                    "antonyms": [
                        "упорядоченно",
                        "регулярно",
                        "закономерно"
                    ],
                    "common_phrases": [
                        "случайно выбранный",
                        "распределить случайно"
                    ],
                    "target_lang_definitions": {
                        "en": "Done without a specific pattern, method, or conscious decision; arbitrarily.",
                        "es": "Sin un orden, sistema o patrón determinado; de forma aleatoria.",
                        "fr": "Sans ordre précis, sans système ni logique ; de façon arbitraire."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "randomly",
                                "target_lang_sense_clarification": "without order or selection"
                            },
                            {
                                "target_lang_word": "at random",
                                "target_lang_sense_clarification": "phrase indicating arbitrary selection"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "al azar",
                                "target_lang_sense_clarification": "de forma aleatoria"
                            },
                            {
                                "target_lang_word": "aleatoriamente",
                                "target_lang_sense_clarification": "sin un orden o patrón específico"
                            }
                        ],
                        "fr": [
                            {
                                "target_lang_word": "au hasard",
                                "target_lang_sense_clarification": "sans ordre ni logique"
                            },
                            {
                                "target_lang_word": "aléatoirement",
                                "target_lang_sense_clarification": "de manière aléatoire"
                            }
                        ]
                    }
                }
            ]
        },
        {
