                "senses": [
                    {
                        "sense_id": "62ae5813-3873-3836-b267-185e755badd9",
                        "entry_id": "d32a370a-2035-360c-a7d6-51430883b142",
                        "glosses": [
                            "A baby that has been born prematurely."
                        ],
                        "tags": [
                            "informal"
                        ],
                        "examples": [
                            {
                                "example_id": "5d5d073d-21f8-4558-8915-4c59644cad73",
                                "sense_id": "62ae5813-3873-3836-b267-185e755badd9",
                                "text": "Prematurity is the leading cause of neonatal death, and preemies who survive are at risk for lifelong health problems."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8a667f8e-ce16-46fa-b12d-c64d5de96cf4",
