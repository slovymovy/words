                                    },
                                    {
                                        "sense_id": "9a6414ec-9134-3dc3-9f6d-6a7db1aca20f",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of erotic roleplay."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "abbreviation",
                                            "alt-of",
                                            "initialism",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d4b4254f-68b7-479d-957b-9c64a732f3e9",
                                                "sense_id": "9a6414ec-9134-3dc3-9f6d-6a7db1aca20f",
                                                "text": "The guild, called Abhorrent Taboo on WoW's Ravenholdt server, attracted gamers through its participation in Erotic Roleplay (ERP). In the case of massive multiplayer online games, this usually involves grinding avatars together to simulate sexual encounters and erotically-charged text chatting."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a80acba-c8b6-3b6b-85da-85b0859c90db",
                                        "entry_id": "a350658f-eeb0-3a6a-9a79-dc84d7d6cc74",
                                        "glosses": [
                                            "Initialism of estimated retail price."
                                        ],
                                        "tags": [
