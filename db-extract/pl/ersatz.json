                                "target_senses": [
                                    {
                                        "sense_id": "e25edf1d-2ff0-3893-b93f-85290ab9b9e4",
                                        "entry_id": "e4bee569-8697-3b1d-bf50-56ee5aceb657",
                                        "glosses": [
                                            "etwas, das an Stelle von etwas anderem tritt, weil dieses fehlt, verlorengegangen ist oder ausgetauscht werden muss"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a16d60ac-5743-434b-941f-2a537b4b6319",
                                                "sense_id": "e25edf1d-2ff0-3893-b93f-85290ab9b9e4",
                                                "text": "„Diese Muffe ist ein Ersatz für Ihre leckende Rohrverbindung“, sagte der Klempner."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1c75eecd-49f4-30ac-9fbb-dcba002a9317",
                                        "entry_id": "e4bee569-8697-3b1d-bf50-56ee5aceb657",
                                        "glosses": [
                                            "der Vorgang des Austauschens von etwas, das an Stelle von etwas anderem tritt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e0c7b054-61fd-4ac8-a8bf-d15d44c35b68",
                                                "sense_id": "1c75eecd-49f4-30ac-9fbb-dcba002a9317",
                                                "text": "Der Ersatz der Schiffsmannschaft wurde durchgeführt."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
