                        ],
                        "form": "den Kulturkampf"
                    },
                    {
                        "form_id": "ce9b3287-33a8-452f-ae6e-6d1b5ea095a7",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kulturkämpfe"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5c41a2c1-d570-3d3f-ae7e-74439f98fce6",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "glosses": [
                            "Bezeichnung für das Vorgehen gegen katholische Hierarchie und politischen Katholizismus bei der Auseinandersetzung zwischen Staat und katholischer Kirche (unter Papst Pius IX.)"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "52722163-f5c5-37c1-b4c9-2021b221ca8a",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "glosses": [
                            "Bezeichnung für das Vorgehen gegen katholische Hierarchie und politischen Katholizismus bei der Auseinandersetzung zwischen Staat und katholischer Kirche (unter Papst Pius IX.)",
                            "im Deutschen Reich, 1871–1887"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "39946f67-8219-416a-bc28-e382b4914578",
                                "sense_id": "52722163-f5c5-37c1-b4c9-2021b221ca8a",
                                "text": "„Den Namen des berühmten antiklerikalen Spötters wollte er in die Arena des Kulturkampfes zerren.“"
                            },
                            {
                                "example_id": "e7edcc4c-f1af-413d-81e5-e1b5b19c60f2",
                                "sense_id": "52722163-f5c5-37c1-b4c9-2021b221ca8a",
                                "text": "„Während des Kulturkampfes war es eine offene Frage, wer aus dem Bündnis gegen die Ultramontanen den größeren Nutzen ziehen würde: Bismarck oder seine liberalen Verbündeten.“"
                            },
                            {
                                "example_id": "de0cda55-225b-437c-9347-5158557d981b",
                                "sense_id": "52722163-f5c5-37c1-b4c9-2021b221ca8a",
                                "text": "„Im Kulturkampf entluden sich aber nicht nur konfessionelle Konflikte zwischen protestantischem Staat und katholischer Zentrumspartei, sondern auch kirchenfeindliche Einstellungen des Liberalismus und antipreußische Affekte der süddeutschen Länder.“"
                            }
                        ],
                        "sense_index_json": "\"1a\""
                    },
                    {
                        "sense_id": "8a6d6e4d-75de-3230-8d10-6632480e1f27",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "glosses": [
                            "Bezeichnung für das Vorgehen gegen katholische Hierarchie und politischen Katholizismus bei der Auseinandersetzung zwischen Staat und katholischer Kirche (unter Papst Pius IX.)",
                            "in der Schweiz, 1873–1883"
                        ],
                        "tags": [
                            "historical"
                        ],
                        "examples": [
                            {
                                "example_id": "27f03db5-9627-45e0-b811-00a1878b003f",
                                "sense_id": "8a6d6e4d-75de-3230-8d10-6632480e1f27",
                                "text": "„Der Kulturkampf wurde nirgendwo in so scharfer Form wie in der Schweiz geführt, obwohl er eigentlich nur in den gemischten Kantonen stattfand, seine Urheber bei den Katholiken selbst, nicht jedoch bei den Protestanten zu suche waren und sich tragende Kräfte der liberal-radikalen Katholiken weitgehend als Reformbewegung ohne Volk erwiesen.“"
                            },
                            {
                                "example_id": "ea0b5d22-988b-4c24-b211-14697012f725",
                                "sense_id": "8a6d6e4d-75de-3230-8d10-6632480e1f27",
                                "text": "„Auf den Widerstand der katholischen Bevölkerung des Jura reagierte die Berner Regierung 1874 mit dessen militärischer Besetzung. Erst nach jahrelangen Auseinandersetzungen und einem konservativen Machtwechsel in Bern ebbte der Kulturkampf nach 1878 ab.“"
                            }
                        ],
                        "sense_index_json": "\"1b\""
                    },
                    {
                        "sense_id": "10273f14-e37d-3d7e-8729-27fb86bb5022",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "glosses": [
                            "breit angelegte Verfolgung von Kirche und Religion durch Staat oder Gesellschaft (in Anlehnung an Bedeutung [1])"
                        ],
                        "tags": [
                            "general"
                        ],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "4f1787fd-3d91-3c98-b22c-e1c8c85c0829",
                        "entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "glosses": [
                            "heftige politisch-gesellschaftliche Auseinandersetzung über weltanschauliche Fragen im Innern einer Gesellschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed83efcf-4947-472c-aba0-2aa604a28a37",
                                "sense_id": "4f1787fd-3d91-3c98-b22c-e1c8c85c0829",
                                "text": "„Der Frontverlauf im amerikanischen Kulturkampf ist so komplex, dass er sich sogar durch die kleinste gesellschaftliche Einheit zieht: die Familie.“"
                            },
                            {
                                "example_id": "3d2c452f-33df-4532-80ce-d144582a016b",
                                "sense_id": "4f1787fd-3d91-3c98-b22c-e1c8c85c0829",
                                "text": "„Heute kämpft Volk gegen Elite, Nationalismus gegen Globalisierung, Homogenität gegen Vielfalt, Frauen gegen Männer und Stadt gegen Land. Auch Europa ist von diesen neuen Kulturkämpfen betroffen.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "65e4e7a6-0390-44ab-bbed-461986206dc5",
                        "source_entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "source_sense_id": "5c41a2c1-d570-3d3f-ae7e-74439f98fce6",
                        "source_sense_description": "Kampf zwischen Staat und Religion (Deutschland, Schweiz)",
                        "target_lang_word": "kulturkampf",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "kulturkampf",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e244c112-2226-3d1f-a64e-30c9433112b9",
                                        "entry_id": "f2ffeadf-e417-3510-9c53-08fde2179c8c",
                                        "glosses": [
                                            "A conflict between secular and religious authorities, especially the struggle between the Roman Catholic Church and the German government under Bismarck."
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af337fe6-e8d3-4141-b086-603f515faa36",
                                                "sense_id": "e244c112-2226-3d1f-a64e-30c9433112b9",
                                                "text": "As the Roman Empire became Christian in the fourth century, the scene was set for a Kulturkampf of huge proportions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "edc9f1c2-6b50-424f-b387-cad733c44a23",
                        "source_entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "source_sense_id": "5c41a2c1-d570-3d3f-ae7e-74439f98fce6",
                        "source_sense_description": "Kampf zwischen Staat und Religion (Deutschland, Schweiz)",
                        "target_lang_word": "Kulturkampf",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "ddb2a10b-933f-4263-9b6a-2f860c6cb3e5",
                        "source_entry_id": "acde3797-764a-3daf-a0b6-1c92e511f001",
                        "source_sense_id": "4f1787fd-3d91-3c98-b22c-e1c8c85c0829",
                        "source_sense_description": "heftige weltanschauliche Auseinandersetzung in einer Gesellschaft",
                        "target_lang_word": "culture war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "culture war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b989aa8f-b0e5-35fe-94bb-9c080a3f6ddd",
                                        "entry_id": "558be12d-93e8-386f-bee3-a2af3697e113",
                                        "glosses": [
                                            "A political struggle for control over cultural institutions."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                        "entry_id": "558be12d-93e8-386f-bee3-a2af3697e113",
                                        "glosses": [
                                            "Conflict between different ideological groups, especially political conflict for cultural dominance between liberals and conservatives in the United States."
                                        ],
                                        "tags": [
                                            "in-plural",
                                            "often"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eab02108-2db0-4bdd-882c-931f62ce595e",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "Little wonder, then, that stories about the “culture wars” have been burning up the pages of newspapers, magazines, and intellectual journals for the past few years: There’s so much more to fight about these days."
                                            },
                                            {
                                                "example_id": "0733d377-972f-4dfb-b880-9153853ce189",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "Bush’s other accomplishments in office include […] prolonging the life of the severely brain-damaged Terri Schiavo in a cynical bid to burnish his culture wars résumé."
                                            },
                                            {
                                                "example_id": "092b671e-255d-4a89-bb68-4c1eb8d45611",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "I am thirteen years old. The internet has arrived and I have learned with some relief that there is, at least for now, a condition called Gender Identity Disorder. I do not know that in the next decade there will be waged culture wars over what is the best thing to call me — nor that they will happen on this very internet."
                                            },
                                            {
                                                "example_id": "841dd4eb-760d-498e-ad73-c3095e45eb23",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "This false premise of video game industry collusion spiraled into an online culture war, ensnaring female gaming critics like Anita Sarkeesian and other designers like Brianna Wu who would suffer months of relentless abuse on and offline."
                                            },
                                            {
                                                "example_id": "fdd682c2-0381-42c1-924b-8775322f3913",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "Conservatives need to recognise that elections are won on economics and public services rather than culture wars, Michael Gove has said in what will be seen as a rebuke to Suella Braverman."
                                            },
                                            {
                                                "example_id": "59f095b2-2c90-4328-a803-2472fb072e54",
                                                "sense_id": "446824c2-1276-3f12-a8c0-d8fffca7ec81",
                                                "text": "Ignoring the fact that there was a big swing anyway, and that the Tory majority went down to fewer than 500 votes, the Conservatives now seem to be basing their entire election strategy for the forthcoming General Election on breaking the former consensus on net zero and turning the environment debate into one big culture war."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
