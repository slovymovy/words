                        "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                        "entry_id": "c18fe433-1ddf-3914-b8a3-6f8ad5571e93",
                        "glosses": [
                            "Messgerät zur Bestimmung des Ethanolgehaltes eines Wasser-Ethanol-Gemisches"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "615f299d-156a-48a0-a511-a1d1cfa77713",
                                "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                                "text": "„Das Instrument, welches man zur Bestimmung des Alkoholgehaltes des Spiritus benützt, ist das Alkoholometer.“"
                            },
                            {
                                "example_id": "93290832-cf40-41f0-8d63-a7a7ef9d23fc",
                                "sense_id": "17152bf9-334b-35e2-8a03-a09761f3121e",
                                "text": "„Bei allen Beobachtungen mit Hilfe des Alkoholometers bedarf es somit auch einer Feststellung der Temperatur.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
