                "senses": [
                    {
                        "sense_id": "72ffda64-cb9b-3756-958b-f1205af37a8b",
                        "entry_id": "24200b95-c755-3ffa-83f9-a89e2a527271",
                        "glosses": [
                            "Angehörige einer christlichen Konfession, die durch die Reformation entstanden ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "97d5900d-b1cc-4c26-8f70-45936081d15d",
                                "sense_id": "72ffda64-cb9b-3756-958b-f1205af37a8b",
                                "text": "In Nordirland macht es nach wie vor einen großen Unterschied, ob man Protestantin und Katholikin ist."
                            },
                            {
                                "example_id": "42abf9a5-2140-4151-ba61-1e367def2809",
                                "sense_id": "72ffda64-cb9b-3756-958b-f1205af37a8b",
                                "text": "„Da jedoch unten Gäste auf ihn warteten, die weither gekommen, hatte er diesmal keine Zeit mehr, ihnen von anderen Städten zu erzählen, und die Bischöfin, die eine eifrige Protestantin war und darob nicht sonderlich Vergnügen am Hause des Papstes fand, bat, sich ihre Stadt später beim Assessor auswählen zu können.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
