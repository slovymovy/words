                {
                    "sense_id": "bad5f851-85bd-38dd-b08b-b2278fb88c0e",
                    "sense_definition": "Qui est silencieux, sombre ou morne, en parlant d'un lieu ou d'une chose.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "environnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les voyageurs traversèrent ces villages sombres et <w>taciturnes</w> sans rencontrer la moindre âme qui vive."
                        },
                        {
                            "text": "Derrière ces hautes murailles <w>taciturnes</w>, la vieille abbaye semblait garder jalousement tous ses secrets."
                        }
                    ],
                    "synonyms": [
