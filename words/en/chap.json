                },
                {
                    "sense_id": "b5f1dceb-d12f-3bcd-9d7b-095df7807318",
                    "sense_definition": "A young child.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "person",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The little <w>chap</w> was playing happily in the park.",
                            "target_lang_translations": {
                                "ru": "Маленький <w>мальчишка</w> счастливо играл в парке."
                            }
                        },
                        {
                            "text": "He has been a clever <w>chap</w> since he was very small.",
                            "target_lang_translations": {
                                "ru": "Он был смышленым <w>пареньком</w> с самого раннего детства."
                            }
