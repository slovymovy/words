                "senses": [
                    {
                        "sense_id": "7c547b93-af81-3863-865e-8391930dfa1b",
                        "entry_id": "96a7a006-1cd0-39fb-9c28-5225ed939c4b",
                        "glosses": [
                            "wiederholbare/wiederholte Handlung, die nach eingeschliffenen oder vorgeschriebenen Regeln abläuft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ef98bd0e-cde5-40de-8fae-3adc3e799584",
                                "sense_id": "7c547b93-af81-3863-865e-8391930dfa1b",
                                "text": "„Sabina war die Tochter der Freude, aus seinem amourösen Genius geboren, und man liebkoste sie als eine weitere Manifestation eines Ritus, den sie spürte, von dem ihre Mutter ausgeschlossen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "c6833e0f-dafa-3267-aaed-9a019114726f",
                        "entry_id": "96a7a006-1cd0-39fb-9c28-5225ed939c4b",
                        "glosses": [
                            "religiöser Brauch/Handlung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1fde5295-f471-4ec6-9799-8c447858a9d3",
                                "sense_id": "c6833e0f-dafa-3267-aaed-9a019114726f",
                                "text": "„Ursprünglich bestimmten eine Reihe lokaler und regionaler Kulte das religiöse Leben der Stadt. Durch Kontakte mit der Außenwelt gerieten weitere Riten in den Gesichtskreis der Römer.“"
                            },
                            {
                                "example_id": "7df6f04b-5b50-4d22-98a7-ab7d25d6b027",
                                "sense_id": "c6833e0f-dafa-3267-aaed-9a019114726f",
                                "text": "„Der Ritus muß rein bleiben, sie sprach wie eine italienische oder französische Adelige aus alter katholischer Familie.“"
                            },
                            {
                                "example_id": "2d685873-6929-437e-a368-8dd3afdf8cbd",
                                "sense_id": "c6833e0f-dafa-3267-aaed-9a019114726f",
                                "text": "„Kunst ist in Benin stets Teil des Ritus, die Bronzegießer vollziehen in ihren Werkstätten sakrale Handlungen.“"
                            },
                            {
                                "example_id": "32e2a07a-6ec6-4e3a-9523-eeead70fb749",
                                "sense_id": "c6833e0f-dafa-3267-aaed-9a019114726f",
                                "text": "„Deshalb hatte der Pharao an diesen fünf Tagen besonders viel zu tun, denn er musste das drohende Unheil mit geeigneten Riten und Kulthandlungen abwenden.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
