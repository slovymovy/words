        "fr-extract.jsonl": [
            {
                "entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                "word": "antiquaire",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "7769985c-7cf3-4c8d-a7bc-6de26316a62c",
                        "entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "antiquaires"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e3473bfe-5ad3-350e-829c-8300735fd9f7",
                        "entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                        "glosses": [
                            "Celui, celle qui recherche pour les vendre des objets anciens."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "346110f1-4df5-4465-888e-92e6a90976a6",
                                "sense_id": "e3473bfe-5ad3-350e-829c-8300735fd9f7",
                                "text": "Le nombre des magasins d’antiquaires croît chaque jour."
                            }
                        ]
                    },
                    {
                        "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                        "entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                        "glosses": [
                            "Celui qui s’adonnait à l’étude des objets antiques ; archéologue."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "b410244d-533a-47c1-a017-887de0a35867",
                                "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                                "text": "L’archéologie a trop négligé l’étude des poteries gallo-romaines; et celles du Mans resteraient inconnues des antiquaires, sans le zèle généreux de M. De Caumont."
                            },
                            {
                                "example_id": "ea63a983-f190-4bde-9e7a-d068935b40cb",
                                "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                                "text": "A force de gratter la terre, de recueillir des médailles et des légendes, il était devenu tout à fait antiquaire."
                            },
                            {
                                "example_id": "3ca477df-ce03-42f8-add9-8fa026c13a07",
                                "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                                "text": "C’est une excursion que l’on peut faire à son aise en une après-dînée, à moins que l’on ne soit un antiquaire forcené, et que l’on ne veuille regarder une à une toutes les vieilles pierres soupçonnées d’inscriptions."
                            },
                            {
                                "example_id": "01a93e9c-66c3-4f4f-8f35-3299879ef37b",
                                "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                                "text": "Pourquoi serais-je forcé de voir ce que les autres ont vu ? Je ne voyage pas dans un but déterminé : je ne suis pas antiquaire."
                            },
                            {
                                "example_id": "d17b161b-0c46-4b1b-861a-36726b302c3b",
                                "sense_id": "5a2e111a-e41d-31b1-b9a6-3f0e5c5b156a",
                                "text": "Un perron étroit et rapide conduit à une porte basse située du côté du midi de la tour, par où l’antiquaire audacieux peut encore, ou du moins pouvait, il y a quelques années, gagner un petit escalier …."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "38c33e0e-634d-48f5-a31b-0bd7c4176ff3",
                        "source_entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                        "source_sense_description": "Personne qui recherche des objets anciens pour les vendre",
                        "target_lang_word": "Antiquitätenhändler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiquitätenhändler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "da0c3979-8df9-3081-966f-10000b27a19b",
                                        "entry_id": "70274de7-a683-360f-8f3d-74087549bad9",
                                        "glosses": [
                                            "Person, die (meist beruflich) Antiquitäten kauft und verkauft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fecd6a54-b89f-4e1e-84ba-f3e21387632a",
                                                "sense_id": "da0c3979-8df9-3081-966f-10000b27a19b",
                                                "text": "„Die MK [Militärkanzlei] meldet dem Handelsminister, dass FF [Franz Ferdinand] an der ehesten Kundmachung einer Verordnung betreffend die Einreihung der Antiquitätenhändler unter die konzessionierten Gewerbe interessiert sei.“"
                                            },
                                            {
                                                "example_id": "67fe5542-e735-426b-aac9-2f33b99ea31c",
                                                "sense_id": "da0c3979-8df9-3081-966f-10000b27a19b",
                                                "text": "„Seit Jahren schon, eigentlich seitdem 2007 die ersten Smartphones auf den Markt kamen, erfahren die Antiquitätenhändler schwere Einbußen.“"
                                            },
                                            {
                                                "example_id": "e2e40b54-5de6-4093-9e08-31e0f3d5aaac",
                                                "sense_id": "da0c3979-8df9-3081-966f-10000b27a19b",
                                                "text": "„In diesen Städten machten in der nächsten Zeit Juweliere und Antiquitätenhändler trübe und verlustreiche Erfahrungen mit beschirmten Herren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4034cb50-e54d-47c7-a8d8-7404b2afbe14",
                        "source_entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
                        "source_sense_description": "Personne qui recherche des objets anciens pour les vendre",
                        "target_lang_word": "Antiquar",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Antiquar",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "a90e454a-65fc-367b-a11b-a9144ebb81a0",
                                        "entry_id": "e6ef5f6d-ebcf-31ae-b052-a619dc28ea92",
                                        "glosses": [
                                            "Person, die mit alten Büchern und eventuell auch anderen alten Druckwerken handelt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a4d3bfb-3289-4457-9d06-c09bcf5085ba",
                                                "sense_id": "a90e454a-65fc-367b-a11b-a9144ebb81a0",
                                                "text": "„Vor ein paar Jahren rief mich ein Antiquar aus London an und fragte, ob ich ihn wohl hinsichtlich eines Pergaments beraten könne, das ihm angeboten worden sei.“"
                                            },
                                            {
                                                "example_id": "d9c53c21-1870-48ea-8a0b-98e0895a292c",
                                                "sense_id": "a90e454a-65fc-367b-a11b-a9144ebb81a0",
                                                "text": "„Der älteste Antiquar des Viertels, der schon Antiquar gewesen war, bevor die Mauer gebaut wurde, und der nicht aufgehört hatte, Antiquar zu sein, nachdem diese Mauer längst wieder abgetragen worden war, lachte sich ins Fäustchen und begann sein Schaufenster opulent zu dekorieren.“"
                                            },
                                            {
                                                "example_id": "96cadeaa-fe86-4ec8-a1df-dc52a38cb743",
                                                "sense_id": "a90e454a-65fc-367b-a11b-a9144ebb81a0",
                                                "text": "„Sie war die Tochter jenes mit Abate Grimani befreundeten Antiquars, der mich zu der Slawonierin in Pension gebracht hatte.“"
                                            },
                                            {
                                                "example_id": "b5372b49-5e89-43eb-81d8-29b7d681750e",
                                                "sense_id": "a90e454a-65fc-367b-a11b-a9144ebb81a0",
                                                "text": "„Er wechselte mit dem Antiquar ein paar Worte, nahm den Antiquariatskatalog in Empfang, zahlte mit Scheck und ging.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7d8d85bc-f4ab-4a56-a260-21c223cadcc3",
                        "source_entry_id": "79639e3b-8345-30f9-99fe-405962af75c8",
