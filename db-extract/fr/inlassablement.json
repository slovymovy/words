                                        "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                        "entry_id": "8ada01b9-8264-3515-8204-07b03b48810d",
                                        "glosses": [
                                            "zonder stoppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ac4c357d-fa2a-49fe-9980-fe2b9a5e3777",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "Haar onophoudelijke zeuren bracht iedereen tot wanhoop."
                                            },
                                            {
                                                "example_id": "5e1f8bb3-b907-4700-aecc-24815afdf165",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "Overal waar je keek zag je leven in de woestijn. Duikende vogels, mieren, hagedissen en het onophoudelijke gezang van de krekels."
                                            },
                                            {
                                                "example_id": "83b44377-52d4-4116-8000-d01b8c127433",
                                                "sense_id": "05688c7f-f131-3d4b-92bf-0883d5cf2a67",
                                                "text": "De meisjes werden gek, schreeuwden onophoudelijk en gooiden kleren op het podium. Zelfs onderbroeken, werd er beweerd."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "onophoudelijk",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "0a50dffa-3aee-339d-bdd7-653083245560",
                                        "entry_id": "7d0d6796-edfd-3497-849e-27bb4aeeb18b",
                                        "glosses": [
                                            "zonder te stoppen, als maar doorgaand"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1616438e-d592-44b0-ad0b-52238bd471cf",
                                                "sense_id": "0a50dffa-3aee-339d-bdd7-653083245560",
                                                "text": "Het bleef, naar ons gevoel, de hele zomer onophoudelijk door regenen."
                                            }
                                        ]
