                                        "glosses": [
                                            "Without making a mistake, perfectly, directly"
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0919d95a-7ee8-4399-bbfe-f0c9de4a4df1",
                                                "sense_id": "32d20183-fed0-30aa-a3e2-ed750116b59c",
                                                "text": "His sense of direction leads us unerringly every time."
                                            },
                                            {
                                                "example_id": "f8669272-e56f-4f51-b85f-ad265d48b547",
                                                "sense_id": "32d20183-fed0-30aa-a3e2-ed750116b59c",
                                                "text": "Unerringly impelling this dead, impregnable, uninjurable wall, and this most buoyant thing within; there swims behind it all a mass of tremendous life, only to be adequately estimated as piled wood is—by the cord; and all obedient to one volition, as the smallest insect."
                                            },
                                            {
                                                "example_id": "123236ad-c491-4430-9168-a0b34522ccf0",
                                                "sense_id": "32d20183-fed0-30aa-a3e2-ed750116b59c",
                                                "text": "It proved the cue for a period of implosion from Wigan, who fell two behind shortly after the hour courtesy of Boyce's costly error, Young firing in unerringly from the spot."
                                            }
                                        ]
                                    }
                                ]
