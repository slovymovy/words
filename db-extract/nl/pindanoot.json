                        "examples": [
                            {
                                "example_id": "c4d336ab-99cb-48cd-be49-b83b2457cc74",
                                "sense_id": "fe77740a-d17c-3464-ad47-821f36eef041",
                                "text": "De presentator onderging een volledig medische controle na een zware griep. Bij die controle zat ook een MRI-scan. ‘Het voelde als een sloophamer om een pindanoot te kraken’, aldus Fry, maar op die scan ontdekten de artsen een gezwel bij zijn prostaat. De presentator had twee opties: stralingstherapie of een operatie. Fry opteerde voor een operatie."
                            },
                            {
                                "example_id": "3310a485-a1f1-4e30-aff7-6a84d67e4c16",
                                "sense_id": "fe77740a-d17c-3464-ad47-821f36eef041",
                                "text": "Bacardi Ocho, een minimum acht jaar lang gerijpte rum, vormt de basis van de cocktail. Daarop bouwt Ran verder met een Amontillado-sherry (een speciale sherrystijl, met veel droge en zoute noten), wat crème de cacao, een geutje absint en een scheutje gefilterd en gepasteuriseerd zeewater, afgetopt met enkele druppels olie van pindanoten."
                            }
                        ]
                    }
