                        "tags": [
                            "geography"
                        ],
                        "examples": [
                            {
                                "example_id": "3af825a4-0086-4554-ac1c-d80a943221ee",
                                "sense_id": "438a136c-36cc-350c-bfa0-50c04787ff86",
                                "text": "„Die Einwohner von Horchheim eilten bei Luftgefahr in den dortigen Eisenbahntunnel. Tagtäglich rechnete man mit einem weiteren Vorrücken der Alliierten …“"
                            },
                            {
                                "example_id": "3cf4b35c-0e24-48b5-8533-f6fda5442ff5",
                                "sense_id": "438a136c-36cc-350c-bfa0-50c04787ff86",
                                "text": "„Ehrenbreitstein hatte von 1836 bis 1937 einen Stadtbürgermeister. Der Stadt waren angeschlossen die Gemeinden Pfaffendorf, Horchheim, Arzheim, Arenberg, Immendorf, Niederberg mit Neudorf und Urbar.“"
                            }
