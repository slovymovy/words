                                "target_senses": [
                                    {
                                        "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                        "entry_id": "bbfd3f83-0192-3494-837d-a78060cdbae7",
                                        "glosses": [
                                            "Attitude consistant à se tourner soi-même en dérision."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe4da1e2-8ead-4746-95b8-9493c4e18877",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "Autant pour moi est une locution de modestie, avec un brin d’autodérision. Elle est elliptique et signifie : « Je ne suis pas meilleur qu’un autre, j’ai autant d’erreurs que vous à mon service : autant pour moi. »"
                                            },
                                            {
                                                "example_id": "82588a9d-2c8c-4f7d-8dc4-bed92989895d",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "L’autodérision, que je sache, c’était l’essence même des monologues de Deschamps."
                                            },
                                            {
                                                "example_id": "a399ce68-ff20-4edb-a81e-f2fdf5f151ab",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "Visiblement peu encline à l’autodérision, Nicki Minaj a bloqué manu militari le compte d’un fan qui venait de publier un portrait d’elle peu flatteur sur Twitter."
                                            },
                                            {
                                                "example_id": "0d429963-b0cc-432d-affa-87cb0a2badf2",
                                                "sense_id": "d263e9ef-f1cd-37b2-b164-3b4c0239a994",
                                                "text": "L'autodérision est sœur de l'humilité et dégonfle tout ego surdimensionné.."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "029a0247-72ff-479a-a189-278344c75fec",
                        "source_entry_id": "7f288d52-8985-3178-9696-1bafa2eb64a3",
                        "source_sense_id": "cd5da4c8-e0dd-3c9c-95ad-2ae3a157b13e",
