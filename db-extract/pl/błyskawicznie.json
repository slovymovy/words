                                "target_senses": [
                                    {
                                        "sense_id": "2cdaba09-3260-32d9-95af-0c20f771016b",
                                        "entry_id": "f3b5118d-0299-3397-a066-3152287d4f2d",
                                        "glosses": [
                                            "Pour un moment ; pendant un moment."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "39899817-fd15-4489-b88c-2465d5e52905",
                                                "sense_id": "2cdaba09-3260-32d9-95af-0c20f771016b",
                                                "text": "Ce rappel à la réalité quotidienne et aux occupations usuelles change momentanément le cours de mes pensées."
                                            },
                                            {
                                                "example_id": "0f5e1ad5-233e-4b3f-82bb-49363fff8373",
                                                "sense_id": "2cdaba09-3260-32d9-95af-0c20f771016b",
                                                "text": "Le navire polaire « Gustav Holm » fut rebaptisé momentanément le « Groenland » ; […]."
                                            },
                                            {
                                                "example_id": "36f7b57c-639e-4882-8b4c-0ad72d09884f",
                                                "sense_id": "2cdaba09-3260-32d9-95af-0c20f771016b",
                                                "text": "Gvozdiline a récupéré dans l'appartement de l'officier des appareils photo Minox, […], deux dossiers momentanément soustraits à la bibliothèque confidentielle de l'état-major de l'Armée rouge."
                                            }
                                        ]
