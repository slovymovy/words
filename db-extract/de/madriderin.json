                "senses": [
                    {
                        "sense_id": "f81287e3-5d84-3646-b753-e7abb618bb05",
                        "entry_id": "d5ba88f9-2106-3d47-8b28-80ef93e9d24f",
                        "glosses": [
                            "Einwohnerin der spanischen Hauptstadt Madrid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f69f57e-da58-4a39-9e15-1fc95fa508af",
                                "sense_id": "f81287e3-5d84-3646-b753-e7abb618bb05",
                                "text": "Er fragte eine Madriderin nach dem Weg zum Plaza Mayor."
                            },
                            {
                                "example_id": "0790bbdb-9890-45a1-b771-995e8589f8ab",
                                "sense_id": "f81287e3-5d84-3646-b753-e7abb618bb05",
                                "text": "Das dunkle Haar der Madriderin wellt sich widerborstig, die Figur ist eher bodenständig als grazil und lässt Schlüsse auf ihr Hobby zu, das Bergsteigen."
                            },
                            {
                                "example_id": "27a97ce8-1b2a-4ff5-a956-0d807c849c05",
                                "sense_id": "f81287e3-5d84-3646-b753-e7abb618bb05",
                                "text": "Die Madriderin prüft derzeit, ob bei der Zahlung der 43,7 Mio. Euro an Amusátegui ein Verstoß gegen die Interessen der Bank und ihrer Aktionäre vorliegt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
