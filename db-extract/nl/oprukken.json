        "nl-extract.jsonl": [
            {
                "entry_id": "4173dbf8-bee1-3289-8c87-071fe4b14b2e",
                "word": "oprukken",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "244a18ea-a7b7-32b5-b4c3-0e605671e676",
                        "entry_id": "4173dbf8-bee1-3289-8c87-071fe4b14b2e",
                        "glosses": [
                            "je verplaatsen in de gewenste richting"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f0458fa-f38e-4764-a9d2-6cfeb998f665",
                                "sense_id": "244a18ea-a7b7-32b5-b4c3-0e605671e676",
                                "text": "Vanaf positie 7 bleef Verstappen oprukken, helemaal naar positie 2 achter wedstrijdleider en racewinnaar Lewis Hamilton, bij wie hij als enige geen moment in de buurt kon blijven. Die tweede plaats was uiteindelijk een beetje boven zijn huidige stand, wat Verstappen ook moet hebben beseft. Want natuurlijk kwam Sebastian Vettel, die even opgehouden werd door Verstappens ploegmaat Ricciardo en vroeg naar binnen moest, uiteindelijk nog langszij."
                            }
                        ]
                    },
                    {
                        "sense_id": "d00260de-d5e2-35e6-8f54-946c23b90e29",
                        "entry_id": "4173dbf8-bee1-3289-8c87-071fe4b14b2e",
                        "glosses": [
                            "van militairen: zich verplaatsen in de richting van de vijand, aanvallen, opmarcheren, optrekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9a0a550e-941b-45e2-bf02-9626232b0551",
                                "sense_id": "d00260de-d5e2-35e6-8f54-946c23b90e29",
                                "text": "Snel oprukken naar Rusland? Vergeet het maar."
                            }
                        ]
                    },
                    {
                        "sense_id": "e265ba22-470c-3478-8af6-a9345163d555",
                        "entry_id": "4173dbf8-bee1-3289-8c87-071fe4b14b2e",
                        "glosses": [
                            "van iets dat zich steeds meer uitbreidt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "df73cca7-1334-49c9-8430-7726df54ff31",
                                "sense_id": "e265ba22-470c-3478-8af6-a9345163d555",
                                "text": "De zwijnen rukken steeds verder op. Koppels worden al gesignaleerd in de dorpen Kloosterhaar, Sibculo en Westerhaar."
                            }
                        ]
                    },
                    {
                        "sense_id": "75d7b56f-5d76-303a-a1ad-639c57fa13c4",
                        "entry_id": "4173dbf8-bee1-3289-8c87-071fe4b14b2e",
                        "glosses": [
                            "weggaan, oplazeren, opstappen"
                        ],
                        "tags": [
                            "pejorative"
                        ],
                        "examples": []
                    }
