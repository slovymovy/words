                                                "sense_id": "4fbde247-1e30-375d-b6e5-489be4ca5a2a",
                                                "text": "„Ihr Vater war dort als Feldwebel der Luftwaffe stationiert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "1e869a01-b627-3d20-83c5-02f29e97df7f",
