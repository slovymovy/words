                                "target_senses": [
                                    {
                                        "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                        "entry_id": "9343c72a-1370-32d1-b1ff-92c26d8156ff",
                                        "glosses": [
                                            "die deutsche Sprache"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2298cd8c-b9f5-44b4-b182-cc57aa0565cd",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Deutsch ist meine Muttersprache."
                                            },
                                            {
                                                "example_id": "9ed7341c-2e7d-4f7e-87ee-9cf5fd0ec3cb",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Ihr Deutsch kann sie noch weiter verbessern."
                                            },
                                            {
                                                "example_id": "b7b80d2f-afa7-4a29-944b-7fed2eff5d09",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Ihr Deutsch können Sie noch weiter verbessern."
                                            },
                                            {
                                                "example_id": "3cbea458-63eb-49c0-8fa7-d3d33ce1d379",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Es bedeutet einigen Aufwand und Mühe, Deutsch gründlich zu erlernen."
                                            },
                                            {
                                                "example_id": "32e5ebbe-950f-48a5-a35b-439cdf27274d",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Im Deutschen gibt es vier grammatische Kasus."
                                            },
                                            {
                                                "example_id": "3b1ebddb-50cb-4531-a061-e01b4641b7a3",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Der Text ist auf Deutsch geschrieben."
                                            },
                                            {
                                                "example_id": "79f335d8-88a2-4470-9dc4-557ecc8b62d3",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "Der Text ist in gutem/schlechtem Deutsch geschrieben."
                                            },
                                            {
                                                "example_id": "1945f98d-b496-4888-98e7-215f6697955c",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "„Sie lobten ihr immer besser werdendes Deutsch.“"
                                            },
                                            {
                                                "example_id": "73a0357e-40b4-4df5-bc1e-8f7d304b44ac",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "[Immanuel Kant:] „»Ich bin einer der Ersten, die auf Deutsch lehren. Meine \"Kritik der reinen Vernunft\" habe ich auch auf Deutsch geschrieben. Das ist schon ungewöhnlich, aber die Studenten haben es mit Freude aufgenommen.«“"
                                            },
                                            {
                                                "example_id": "9bebbd76-de6e-4f13-ae5a-fc4eec7368e0",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "„Deutsch ist schon lange die beliebteste Zweitsprache in und über Europa hinaus.“"
                                            },
                                            {
                                                "example_id": "2b4d4be0-78f4-429b-b516-e01125addc26",
                                                "sense_id": "a10eac1a-c0e5-33a0-ae4a-c257c58f246c",
                                                "text": "„Sie sichteten alte Stadtpläne, manche lernten Deutsch an der Universität, andere eröffneten Bars mit deutschen Namen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0f8a3e5d-3098-304d-a9af-c8fe2e425f4f",
                                        "entry_id": "9343c72a-1370-32d1-b1ff-92c26d8156ff",
                                        "glosses": [
                                            "Deutschunterricht"
                                        ],
                                        "tags": [
                                            "short-form"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a5ca083f-4bca-4d5a-a186-96ced4a372d5",
                                                "sense_id": "0f8a3e5d-3098-304d-a9af-c8fe2e425f4f",
                                                "text": "In Deutsch hatte ich die Note Eins. Was? Eine Eins in Deutsch?"
                                            },
                                            {
                                                "example_id": "e32b9455-835b-4ad3-848e-213a560c8b2c",
                                                "sense_id": "0f8a3e5d-3098-304d-a9af-c8fe2e425f4f",
                                                "text": "Morgen schreiben wir erst einen Test in Mathe und dann eine Arbeit in Deutsch."
                                            },
                                            {
                                                "example_id": "0b678e95-57f8-498f-bbf0-77bf99e7ca88",
                                                "sense_id": "0f8a3e5d-3098-304d-a9af-c8fe2e425f4f",
                                                "text": "„Besonders die Benachteiligung in Deutsch wurmte den Gymnasiasten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            },
                            {
                                "target_word": "Deutsch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                        "entry_id": "34157224-e8ea-3f0f-baab-ff8bdfe0b230",
                                        "glosses": [
                                            "deutschsprachiger Familienname, Nachname"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "699988ae-1e28-42de-8163-2ef18c6ff20f",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Frau Deutsch ist ein Genie im Verkauf."
                                            },
                                            {
                                                "example_id": "6ed74635-f730-4f40-a986-7b2d7848f569",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Herr Deutsch wollte uns kein Interview geben."
                                            },
                                            {
                                                "example_id": "90e93e09-0f96-49c0-b30d-76122a078830",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Die Deutschs fahren heute nach Dresden."
                                            },
                                            {
                                                "example_id": "dcd46d6a-d3a6-4eee-b1a0-96e15cc655eb",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Der Deutsch trägt nie die Schals, die die Deutsch ihm strickt."
                                            },
                                            {
                                                "example_id": "fdd85ed9-0b3f-4c10-a19b-931d819f3257",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Deutsch kommt, geht der Herr Deutsch.“"
                                            },
                                            {
                                                "example_id": "6ed9aee9-6552-4d90-bb33-8f860dab0ab5",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Deutsch kommt und geht."
                                            },
                                            {
                                                "example_id": "9199e255-0d16-4549-82d6-c46362340936",
                                                "sense_id": "15b41d4b-6529-31b7-9abf-6faff83f9a6b",
                                                "text": "Deutschs kamen, sahen und siegten."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "258c4af2-23ac-4118-8f83-30e66f30edf3",
                        "source_entry_id": "eeae6d81-c3d9-36ed-920e-7038c7056320",
                        "source_sense_id": "24801223-e934-36bc-98bf-b0d0f2ee5bf7",
                        "source_sense_description": "(Germanismus) die deutsche Sprache",
                        "target_lang_word": "allemand",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "allemand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "33429a9b-c0f2-38f5-835d-a27b18deec80",
                                        "entry_id": "8c41e42c-3dd4-35cc-9282-ffeac0566acd",
                                        "glosses": [
                                            "Relatif à l’Allemagne ; originaire d’Allemagne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa4a8a88-e263-4f8b-b3e0-2ab66f2ce65c",
                                                "sense_id": "33429a9b-c0f2-38f5-835d-a27b18deec80",
                                                "text": "On entendait vers Noisseville des hourras et des accents lointains d’une musique allemande."
                                            },
                                            {
                                                "example_id": "70b3bd54-5486-4459-8f5e-553ea37ff7d5",
                                                "sense_id": "33429a9b-c0f2-38f5-835d-a27b18deec80",
                                                "text": "Ne sont éligibles que les personnes de nationalité allemande et qui sont majeures."
                                            },
                                            {
                                                "example_id": "91446b40-bcfc-482b-b685-6a3e17068dfc",
                                                "sense_id": "33429a9b-c0f2-38f5-835d-a27b18deec80",
                                                "text": "En septembre de la même année, Ange avait intégré l’équipe spéciale interrégionale basée à Montpellier, une unité chargée — entre autres — d’éliminer officiers allemands et collaborateurs français."
                                            },
                                            {
                                                "example_id": "901806e5-860c-4172-8eb6-0178130dd28c",
                                                "sense_id": "33429a9b-c0f2-38f5-835d-a27b18deec80",
                                                "text": "Des loups sont régulièrement tués sur les routes côté allemand."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5f8eef7f-fd80-3ed4-b358-5d635ae97abe",
                                        "entry_id": "8c41e42c-3dd4-35cc-9282-ffeac0566acd",
                                        "glosses": [
                                            "Relatif à l’allemand, la langue allemande."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e257921d-4dbe-4a17-812b-ae43bb61c877",
                                                "sense_id": "5f8eef7f-fd80-3ed4-b358-5d635ae97abe",
                                                "text": "Il n’y a pas qu’en Allemagne qu’on utilise des mots allemands."
                                            },
                                            {
                                                "example_id": "cd0bbcad-3d98-4382-a7dc-ea164f9a0240",
                                                "sense_id": "5f8eef7f-fd80-3ed4-b358-5d635ae97abe",
                                                "text": "La traduction allemande de France est Frankreich."
                                            },
                                            {
                                                "example_id": "015c2a93-f67b-4a40-8f61-084118be45d4",
                                                "sense_id": "5f8eef7f-fd80-3ed4-b358-5d635ae97abe",
                                                "text": "Par bonheur, Chalumot se passionna pour le vocabulaire allemand, et sa prononciation de phrases épineuses telles que « le bœuf der Ochs, la vache die Kuh, ferme la porte mach die Tür zu », paraissant acceptable, le professeur Moutarde oublia la tentative de mutinerie."
                                            },
                                            {
                                                "example_id": "06692998-0f16-430a-b4a2-6d4e07c410ca",
                                                "sense_id": "5f8eef7f-fd80-3ed4-b358-5d635ae97abe",
                                                "text": "On m'apprenait également le latin, l'allemand - l'anglais n'existait pas encore à l'époque ou, du moins, était considéré par ma mère comme une facilité commerciale à l'usage des gens de peu."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "allemand",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                        "entry_id": "461f6270-06c5-3319-9f0e-33679bab54b3",
                                        "glosses": [
                                            "Langue parlée en Allemagne, en Autriche, en Suisse, au Liechtenstein, au Luxembourg et en Belgique (Cantons de l’Est)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fbb0e72c-1d99-49a7-bbb6-bfcaa4f7b21d",
                                                "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                                "text": "Othon crut que sa vue le trompait, il avait sous les yeux des personnages qui semblaient par leurs habitudes avoir appartenu à une génération disparue depuis plus d’un siècle, et qui parlaient l’allemand du temps de Karl le Chauve."
                                            },
                                            {
                                                "example_id": "7d9c310e-1305-45e9-b979-93801d31e2f2",
                                                "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                                "text": "La nécessité de pousser aussi loin que possible mes études d’exégèse et de philologie sémitique m’obligea d’apprendre l’allemand. Je n’avais à cet égard aucune préparation ; à Saint-Nicolas, mon éducation avait été toute latine et française. Je ne m’en plains pas."
                                            },
                                            {
                                                "example_id": "e1a74104-7a3a-48b5-9337-49fa16a3cd1d",
                                                "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                                "text": "Je me décide à leur parler allemand : pour qu’ils comprennent mieux, j’emploie mon haut allemand le plus clair, la langue officielle des théâtres de Meiningen et de Weimar, le hanovrien saccadé des auteurs juifs qui déclament les traductions de Verlaine."
                                            },
                                            {
                                                "example_id": "97931c87-da3d-42c4-8d5b-f29f67b156bb",
                                                "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                                "text": "On apprenait – on s’apprenait – des notions hétéroclites mais passionnantes. Avant tout, les langues, cela va de soi. L’allemand, bien sûr, bien que les plus enragés prétendissent qu’il n’y aurait plus, la présente guerre terminée, ni Allemagne ni peuple allemand, et que c’était donc perdre son temps. À quoi les purs esthètes, dont j’étais, répliquaient par la beauté de la langue et la noblesse du geste gratuit."
                                            },
                                            {
                                                "example_id": "3d080019-e037-4ba6-bd85-cc15c5f79687",
                                                "sense_id": "6a981f94-8c32-37b0-9b01-613462b3c2bf",
                                                "text": "L’Allemagne, en ce temps-là, était encore l’Athènes de l’Europe ; et puis l’allemand était la langue de la science de l’Antiquité, de l’Altertumswissenschaft."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
