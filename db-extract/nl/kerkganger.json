                        "entry_id": "53a9eb95-9737-3da2-9d5c-aa6a6493279e",
                        "glosses": [
                            "een gelovige die zich naar de kerk begeeft om de kerkdienst bij te wonen (mannelijke vorm)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ae4a5876-9f08-4611-81de-e86e7d6ecae7",
                                "sense_id": "4c6d7eff-16bb-3d76-855d-d0c8345fba4a",
                                "text": "Als organist val je in een kerkdienst gemiddeld genomen wat meer op dan een gemiddelde kerkganger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c016b804-2bd8-4d8b-b6ed-9e3ed1a5ac86",
