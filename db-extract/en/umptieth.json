                        "glosses": [
                            "A generic ordinal number; a last or one of the latest in a long series; implies repetition."
                        ],
                        "tags": [
                            "informal",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "50ee3f0d-b254-4d05-aac8-d744eb9efec1",
                                "sense_id": "e32b1859-9354-312e-ae5f-e56f4e33f03c",
                                "text": "After he retied the knot for the umptieth time, he finally figured out how to make it stay tied."
                            }
                        ]
                    }
                ],
