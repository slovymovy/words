                                "example_id": "89acf38f-8a21-4cbb-8f13-58a52414598f",
                                "sense_id": "256da865-e17a-369c-8a66-fdf46649d53f",
                                "text": "On November 21, evangelist Franklin Graham (son of the late Rev. Billy Graham and a strident Trump supporter) discussed impeachment when he appeared on fellow wingnut Eric Metaxas’ radio show."
                            }
