                                            {
                                                "example_id": "c0a2e1e3-8e08-4a3c-a96b-8afcd0b0fdc3",
                                                "sense_id": "dc8ac094-b884-3a0a-9f99-dd08eecd24ea",
                                                "text": "Pokud průměrný heterosexuální muž vidí jiného dobře vypadajícího muže, s velkou pravděpodobností se bude cítit méně atraktivní."
                                            }
