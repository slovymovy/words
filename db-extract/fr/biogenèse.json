        "fr-extract.jsonl": [
            {
                "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                "word": "biogenèse",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "a936cfe0-1c75-470e-a7dc-8e3d36f27689",
                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "tags": [
                            "plural"
                        ],
                        "form": "biogenèses"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e33a99ca-2522-3619-bcac-00aa062b54ce",
                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "glosses": [
                            "Théorie selon laquelle un être vivant ne peut provenir que d’un autre être vivant."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6e3e0ce-3903-4014-8b34-80ccb32d908b",
                                "sense_id": "e33a99ca-2522-3619-bcac-00aa062b54ce",
                                "text": "On nomme aujourd'hui abiogenèse … la production d’êtres vivants sans l’intervention d’autres êtres vivants ; biogenèse, la reproduction d’un vivant par un vivant."
                            }
                        ]
                    },
                    {
                        "sense_id": "784b70b0-f9d0-360c-9e2d-a96d5b33eb1d",
                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "glosses": [
                            "Ensemble des conditions physiques et chimiques ayant permis l’apparition de la vie."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                        "entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "glosses": [
                            "Élaboration par un organisme vivant de substances diverses."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23b028a9-97e5-4b92-b3d3-6afcf9c7bca8",
                                "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                                "text": "Les bancs de coraux sont le résultat d’une biogenèse d’animaux de l’embranchement des Cnidaires."
                            },
                            {
                                "example_id": "ea15119f-197b-48d6-b9ab-8c322c9a6792",
                                "sense_id": "f7a89499-9b09-3869-891a-c8d8050f3fbf",
                                "text": "Le mode vie autotrophique des plantes repose entièrement sur l'intégrité du chloroplaste et notamment l'étape de la biogénèse"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7becef71-667f-4720-93e0-35b5366158a9",
                        "source_entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "target_lang_word": "Biogenese",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Biogenese",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "1f6ff0a7-87f3-3289-a22e-03bccc035071",
                                        "entry_id": "ec5250e0-4103-3a9d-87d4-3088d5a218ba",
                                        "glosses": [
                                            "Entwicklungsgeschichte aller Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "90038fd9-6a7c-4f91-a419-4b5562c896d1",
                                                "sense_id": "1f6ff0a7-87f3-3289-a22e-03bccc035071",
                                                "text": "Die Biogenese der Lebewesen erscheint uns manchmal wie ein Wunder."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "16fe2e69-ca79-42e8-b192-909b367d100f",
                        "source_entry_id": "9b9c5c75-87be-3479-96ab-f8aab15df9f9",
                        "target_lang_word": "biogenesis",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "biogenesis",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c979a4fd-a3c4-334e-a7ee-bf629ea7a51a",
                                        "entry_id": "32718ab2-06b3-32eb-af56-4783f17c7538",
                                        "glosses": [
                                            "The principle that living organisms are produced only from other living organisms."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6384b93f-d53c-4d9f-a8b4-31cec115148b",
                                                "sense_id": "c979a4fd-a3c4-334e-a7ee-bf629ea7a51a",
                                                "text": "And thus the hypothesis that living matter always arises by the agency of pre-existing living matter, took definite shape; […] It will be necessary for me to refer to this hypothesis so frequently, that, to save circumlocution, I shall call it the hypothesis of Biogenesis; and I shall term the contrary doctrine—that living matter may be produced by not living matter—the hypothesis of Abiogenesis."
                                            },
                                            {
                                                "example_id": "3e0f51bb-8c82-480f-ba01-0c5cf9bf5659",
                                                "sense_id": "c979a4fd-a3c4-334e-a7ee-bf629ea7a51a",
                                                "text": "It is likely that the long evolutionary trajectory of Mycoplasma went from a reductive autotroph to oxidative heterotroph to a cell-wall–defective degenerate parasite. This evolutionary trajectory assumes the simplicity to complexity route of biogenesis, a point of view that is not universally accepted."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "22cc04ab-ee74-3142-9613-be6a90d91924",
                                        "entry_id": "32718ab2-06b3-32eb-af56-4783f17c7538",
                                        "glosses": [
                                            "Biosynthesis."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
