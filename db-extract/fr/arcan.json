                        "examples": [
                            {
                                "example_id": "e415ca8a-dc36-4abb-880d-85bc99ad17a3",
                                "sense_id": "4280a409-19f3-3c6a-bef7-d3b39c8fe109",
                                "text": "Comme un seul homme, avec le Navigateur, on lève nos paluches à la hauteur de nos oreilles, tandis que l’arcan se rapproche de nous et, rapide, nous soulage de nos soufflants."
                            },
                            {
                                "example_id": "c68f9dbd-a5d4-46c5-a470-e24df90894c9",
                                "sense_id": "4280a409-19f3-3c6a-bef7-d3b39c8fe109",
                                "text": "Pour l’heure, il avait, le Paulo, la mine vicieusement réjouie de l’arcan en posture d’enfouiller, pour la première fois et sous quelques minutes, un fade de cent sacs."
                            },
                            {
                                "example_id": "50c35034-c87c-4e80-aed6-85f1c859b5d4",
                                "sense_id": "4280a409-19f3-3c6a-bef7-d3b39c8fe109",
                                "text": "- Pas d’importance, on parlera dans une autre pièce, renvoya Legendre en passant devant le vieil arcan."
                            }
                        ]
                    }
