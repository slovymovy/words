                        "examples": [
                            {
                                "example_id": "421c51f7-27f3-4eba-a616-27c405c24215",
                                "sense_id": "1a761ca2-a05f-3031-a5c4-ad66235db3eb",
                                "text": "Herolde trugen als Heroldstracht einen besonderen, mit dem Wappen ihres Dienstherren geschmückten Mantel, den Tappert."
