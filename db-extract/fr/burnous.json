                    {
                        "translation_id": "ea9efd97-afeb-4f12-a53f-6751a9e04f65",
                        "source_entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
                        "target_lang_word": "boernoes",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "boernoes",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "d534a302-2011-3c72-ab33-efc9a8eaec8f",
                                        "entry_id": "3e9fe819-0318-3aa7-9f6f-239cf2d4c95c",
                                        "glosses": [
                                            "Noord-Afrikaanse mantel met een capuchon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a5039c0-f5e1-45af-b2b6-afd47c682a7d",
                                                "sense_id": "d534a302-2011-3c72-ab33-efc9a8eaec8f",
                                                "text": "Oriëntaalse beelden van Marokko zijn er meer dan genoeg, tot vervelens toe zijn er die clichés van puntmutsen, boernoesen, slippers, grote neuzen, dikke wenkbrauwen die dikker en dikker worden naarmate de erotiek toeneemt, smalle tailles, blootliggende navels waar behendig mee wordt gespeeld, zie die slanke vingers rond de heupen bewegen, de blik van de voyeur wulps bespelend, en dan zijn er de ezeltjes en de watermannen in koddige rode kleding, de door waanzin en Allah gedreven blazers van de mystieke broederschappen, dat keer op keer benadrukken van het fanatieke."
                                            },
                                            {
                                                "example_id": "1f8dae4c-9daa-4361-b6fa-b9a8cf9cf624",
                                                "sense_id": "d534a302-2011-3c72-ab33-efc9a8eaec8f",
                                                "text": "Mannen in pakken, ouderen in boernoes, en een zeldzame snaak, aan wie nog geen halve scheerkwast werd versleten, droeg een vuurrood trainingspak van zijn geliefde elftal Morocco. De Standaard 17 APRIL 2004 OM 00:00 UUR"
                                            },
                                            {
                                                "example_id": "be2ab108-de79-4a08-8418-c48d09f2d9b4",
                                                "sense_id": "d534a302-2011-3c72-ab33-efc9a8eaec8f",
                                                "text": "Deelnemers aan congressen kregen eerst een pasje op een clip. Maar vrouwen in een jurk, of mannen in boernoes, kaftan of djellaba hebben natuurlijk geen broekriem of das om het pasje op te spelden. Een lint is altijd goed. Grote bedrijven hadden trouwens snel door dat zo'n simpel lint heel wat potentieel had als reclamedrager. Al een paar jaar delen sponsors van grote festivals of congressen dan ook linten met hun logo uit aan de ingang. Daarvoor moet je echt wel een lint gebruiken - een koordje is te smal."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1cb99596-042a-3e6b-97d4-96bc3c98c581",
                                        "entry_id": "3e9fe819-0318-3aa7-9f6f-239cf2d4c95c",
                                        "glosses": [
                                            "lang gewaad voor vrouwen uit Noord-Afrika"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5a20ebb3-53c9-4f27-9111-f5fce9932437",
                                                "sense_id": "1cb99596-042a-3e6b-97d4-96bc3c98c581",
                                                "text": "De witte boernoes van een gesluierde vrouw staat bol van de wind, ze gaat gebukt tegen de stofwolk in."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a68fd803-b33f-361f-ab32-72cf36f2cccd",
                                        "entry_id": "3e9fe819-0318-3aa7-9f6f-239cf2d4c95c",
                                        "glosses": [
                                            "officiersmantel met twee rijen knopen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "133f14d2-0689-4e11-a256-b7ffdfc00e93",
                                                "sense_id": "a68fd803-b33f-361f-ab32-72cf36f2cccd",
                                                "text": "Onze wandeling langs Koksijde leidt langs villa’s, waar door de ramen paardenhoofden naar buiten steken, rijdieren van de hulptroepen. Hier leven de vluchtelingen tussen de koloniale hulptroepen. Lange kleurrijke boernoesen vormen beweeglijke vlekken tussen kleine gelijnde tenten."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "b0518a46-b087-4612-83a5-ea5d79b5b3e1",
                        "source_entry_id": "6feaab4c-4f79-3fad-995a-e87c4db7fd33",
