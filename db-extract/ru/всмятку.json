        "ru-extract.jsonl": [
            {
                "entry_id": "e764071f-205c-3046-a483-ccb9c1b38250",
                "word": "всмятку",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "902053f9-321c-361e-9ac7-01ecadf6a568",
                        "entry_id": "e764071f-205c-3046-a483-ccb9c1b38250",
                        "glosses": [
                            "кулин. до полужидкого (внутри) состояния, когда белок сварился наполовину, а желток нет (о способе варки яиц)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6de499f-4874-4462-8f28-53cd45c32321",
                                "sense_id": "902053f9-321c-361e-9ac7-01ecadf6a568",
                                "text": "По давно заведенному обыкновению, лакей принёс ему четыре только что сваренных всмятку яйца, накрытых салфеткой, холодное мясо, полбутылки английского портера и чай."
                            }
                        ]
                    },
                    {
                        "sense_id": "f2fe1307-8a13-3382-8cbf-6b923066e648",
                        "entry_id": "e764071f-205c-3046-a483-ccb9c1b38250",
                        "glosses": [
                            "употребляется как несогласованное определение"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "692e7873-afcb-46b6-b00d-c668a01ebd35",
                                "sense_id": "f2fe1307-8a13-3382-8cbf-6b923066e648",
                                "text": "Перед полуночью Ариадна объявляла, что она хочет есть, и требовала ветчины и яиц всмятку."
                            },
                            {
                                "example_id": "0ba79ba8-229f-403e-a205-4253eeb5f432",
                                "sense_id": "f2fe1307-8a13-3382-8cbf-6b923066e648",
                                "text": "Мы уселись втроем; Варенька была спокойна, она взяла яйцо всмятку, разбила его и занималась им во время завтрака."
                            }
                        ]
                    },
                    {
                        "sense_id": "b421e439-5a3d-309c-952a-cbef7338917a",
                        "entry_id": "e764071f-205c-3046-a483-ccb9c1b38250",
                        "glosses": [
                            "разг. полностью, на мелкие куски"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a4b40428-5502-4228-a786-e8efe8ced773",
                                "sense_id": "b421e439-5a3d-309c-952a-cbef7338917a",
                                "text": "Двое всмятку, третья почти на том свете, а четвертому хоть бы хны."
                            },
                            {
                                "example_id": "8e93fd97-af42-4c75-9773-af4e9c405621",
                                "sense_id": "b421e439-5a3d-309c-952a-cbef7338917a",
                                "text": "― А у нас там жуткая авария… сразу две машины всмятку, просто не на чем завтра работать."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6fb281b9-93a3-426d-8bae-2c56b1f2a9a6",
                        "source_entry_id": "e764071f-205c-3046-a483-ccb9c1b38250",
                        "target_lang_word": "weichgekocht",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "weichgekocht",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "30c5c5ff-8144-33cc-9776-83ef0dfc5959",
                                        "entry_id": "4aa8d507-7254-3d69-926d-18202f65f02b",
                                        "glosses": [
                                            "durch Kochen weich geworden"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
