{
    "word_family": [
        "лошадиный",
        "лошажий",
        "лошадка"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "14dd8d6a-614e-3469-899d-0df695c58bed",
                    "sense_definition": "Крупное домашнее непарнокопытное животное, используемое для верховой езды и перевозки грузов.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "животное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В деревне у дедушки есть старая <w>лошадь</w>.",
                            "target_lang_translations": {
                                "fr": "Au village, mon grand-père a un vieux <w>cheval</w>."
                            }
                        },
                        {
                            "text": "Мы решили покататься на <w>лошадях</w> в парке.",
                            "target_lang_translations": {
                                "fr": "Nous avons décidé de faire du <w>cheval</w> dans le parc."
                            }
                        }
                    ],
                    "synonyms": [
                        "конь"
                    ],
                    "common_phrases": [
                        "верхом на лошади",
                        "запрячь лошадь"
                    ],
                    "target_lang_definitions": {
                        "fr": "Grand mammifère domestique herbivore de la famille des équidés, utilisé pour la monte, le trait et le transport."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cheval",
                                "target_lang_sense_clarification": "animal en général"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e74bacb0-1f86-3e8b-a49b-7997306f4bb7",
                    "sense_definition": "Самка лошади, кобыла.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "животное",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Эта <w>лошадь</w> принесла здорового жеребёнка весной.",
                            "target_lang_translations": {
                                "fr": "Cette <w>jument</w> a mis bas un poulain en bonne santé au printemps."
                            }
                        },
                        {
                            "text": "Жеребцы паслись отдельно, а <w>лошади</w> с жеребятами — на соседнем лугу.",
                            "target_lang_translations": {
                                "fr": "Les étalons paissaient à part, et les <w>juments</w> avec leurs poulains dans le pré voisin."
                            }
                        }
                    ],
                    "synonyms": [
                        "кобыла"
                    ],
                    "antonyms": [
                        "конь",
                        "жеребец"
                    ],
                    "target_lang_definitions": {
                        "fr": "Femelle adulte du cheval."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "jument",
                                "target_lang_sense_clarification": "femelle du cheval"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4abf5180-9866-34ca-9cb0-30f3dc1e48f9",
                    "sense_definition": "Единица измерения мощности, лошадиная сила.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "техника",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Двигатель этого автомобиля имеет триста <w>лошадей</w>.",
                            "target_lang_translations": {
                                "fr": "Le moteur de cette voiture développe trois cents <w>chevaux</w>."
                            }
                        },
                        {
                            "text": "Мощность мотора измеряется в <w>лошадях</w>.",
                            "target_lang_translations": {
                                "fr": "La puissance du moteur se mesure en <w>chevaux-vapeur</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "лошадиная сила"
                    ],
                    "common_phrases": [
                        "мощность в лошадях"
                    ],
                    "target_lang_definitions": {
                        "fr": "Unité de mesure de puissance des moteurs (cheval-vapeur)."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cheval",
                                "target_lang_sense_clarification": "abréviation courante de cheval-vapeur"
                            },
                            {
                                "target_lang_word": "cheval-vapeur",
                                "target_lang_sense_clarification": "unité de puissance mécanique"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "39d3ee5d-aa27-3e12-80e6-40a304f23d9a",
                    "sense_definition": "Ироничное или жаргонное название коня, часто в контексте игр или шуток.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "ирония",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "В шахматах он походил <w>лошадью</w> и выиграл партию.",
                            "target_lang_translations": {
                                "fr": "Aux échecs, il a déplacé son <w>cavalier</w> et a gagné la partie."
                            }
                        },
                        {
                            "text": "Ну ты и <w>лошадь</w> работать столько часов подряд.",
                            "target_lang_translations": {
                                "fr": "Tu es un vrai <w>bourreau de travail</w> pour enchaîner autant d'heures d'affilée."
                            }
                        }
                    ],
                    "synonyms": [
                        "коняшка"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "ироничное употребление"
                        }
                    ],
                    "target_lang_definitions": {
                        "fr": "Emploi figuré, familier ou ironique pour désigner la pièce d'échecs (le cavalier) ou une personne travaillant avec acharnement."
                    },
                    "translations": {
                        "fr": [
                            {
                                "target_lang_word": "cheval",
                                "target_lang_sense_clarification": "terme familier pour le cavalier aux échecs"
                            },
                            {
                                "target_lang_word": "bourreau de travail",
                                "target_lang_sense_clarification": "personne qui travaille énormément"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}