                                            {
                                                "example_id": "2d20b5c8-49ce-4da6-9ab0-10be0e45bef7",
                                                "sense_id": "40f6190b-693c-381a-83a9-0b5986aece86",
                                                "text": "Do not settle for shoddy knives if you are serious about cooking."
