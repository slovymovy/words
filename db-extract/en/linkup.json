                                        "examples": [
                                            {
                                                "example_id": "8614db4a-297d-400e-9d9a-8556261acda5",
                                                "sense_id": "2906e647-59c8-37f3-8822-717aaa50dbab",
                                                "text": "Zwischen den Häusern gibt es eine unterirdische Verbindung."
                                            },
                                            {
                                                "example_id": "5286126e-afc6-4a4e-bc58-6fd43da6bb5d",
                                                "sense_id": "2906e647-59c8-37f3-8822-717aaa50dbab",
                                                "text": "Die Verbindung ist schon wieder zusammengebrochen!"
                                            },
                                            {
                                                "example_id": "2dfb0894-28e7-45d7-a51f-0d8edca06bba",
                                                "sense_id": "2906e647-59c8-37f3-8822-717aaa50dbab",
                                                "text": "Was ist die schnellste Verbindung nach Itzehoe?"
                                            },
                                            {
                                                "example_id": "323b619e-cd58-48dd-9977-1625a9b1029c",
                                                "sense_id": "2906e647-59c8-37f3-8822-717aaa50dbab",
                                                "text": "„Bereits im 18. Jahrhundert verzeichnen einige Kursbücher erste internationale Verbindungen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "bfe2ae6b-fc84-3442-a039-9a49a01fcad9",
                                        "entry_id": "c0b794e6-21d2-37ef-8e1e-a9042311bf30",
                                        "glosses": [
                                            "kausale oder lokale Verbundenheit"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9963b7e6-e33d-4a0d-ad5f-461dc503b898",
                                                "sense_id": "bfe2ae6b-fc84-3442-a039-9a49a01fcad9",
                                                "text": "Ich sehe keine Verbindung zwischen den beiden Morden."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "f9727736-40d8-3f26-a5d7-61ad98b53828",
                                        "entry_id": "c0b794e6-21d2-37ef-8e1e-a9042311bf30",
                                        "glosses": [
                                            "Beziehung, Ehe, Verlöbnis"
