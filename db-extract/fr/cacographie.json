                ],
                "senses": [
                    {
                        "sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "glosses": [
                            "Faute d’orthographe, erreur de style."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "39319c8b-6571-495d-abbd-8b3c460c8ae7",
                                "sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                                "text": "Pendant que l’élève corrige cette cacographie, il lit les règles et les remarques sur l’orthographe du verbe, […]. L’élève trouve, après elles, une cacographie qui n’est fautive que sur le nom, l’adjectif et le verbe, il doit la corriger."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83d48d8d-b419-4d27-97e5-8a864824d5cf",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "Falschschreibung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Falschschreibung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "137e3de6-0c73-368b-920c-3f6a7d38bbe9",
                                        "entry_id": "9b67b075-a659-3eb9-9ec5-a08a0c13e825",
                                        "glosses": [
                                            "etwas, das falsch geschrieben ist; ein Fehler der Schreibweise"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5212f4ee-ecb1-4427-b494-78376760ae4d",
                                                "sense_id": "137e3de6-0c73-368b-920c-3f6a7d38bbe9",
                                                "text": "Eine häufige Falschschreibung von „ziemlich“ ist „ziehmlich“."
                                            },
                                            {
                                                "example_id": "029e7e25-124e-43a0-a971-af4f31fce9ff",
                                                "sense_id": "137e3de6-0c73-368b-920c-3f6a7d38bbe9",
                                                "text": "„Wahrscheinlich trug die Falschschreibung ihres Namens Schuld daran, glaubt Luise jetzt, denn damals konnte sie ihn zwar aussprechen, nicht aber buchstabieren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a5095187-328b-35cc-a20b-904ac3de49be",
                                        "entry_id": "9b67b075-a659-3eb9-9ec5-a08a0c13e825",
                                        "glosses": [
                                            "die Handlung, etwas falsch zu schreiben"
                                        ],
                                        "tags": [],
                                        "examples": [],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7cb9772f-c0d2-4900-9071-44dd77a83cf6",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "Schreibfehler",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schreibfehler",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                        "entry_id": "78d68c2d-c0b8-3bee-a69a-262b4de3c67c",
                                        "glosses": [
                                            "Fehler in einem geschriebenen Text im Hinblick auf Interpunktion oder Orthografie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "821015d3-f3ed-4a07-b8ea-2ab316f0a90c",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Die Briefe, die ich schrieb, strotzten, wie ich erfuhr, von Schreibfehlern.“"
                                            },
                                            {
                                                "example_id": "3c8e84fe-4523-47ca-92dd-bfc09fa09fa5",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Die Postbeamtin wollte ihre Papiere wegen dieses Schreibfehlers nicht annehmen.“"
                                            },
                                            {
                                                "example_id": "2d795c39-2b47-4cb8-95bf-86720fdc3fd3",
                                                "sense_id": "0fd98451-82b1-3c31-88d4-fbb5cdc2c266",
                                                "text": "„Während ich es noch einmal abschrieb, um einige Schreibfehler auszumerzen, ging er zu seinem Vater und fragte ihn, wer ich sei; darüber mußte dieser lachen, bis wir zu Tisch gingen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ef9882cb-dc38-46a3-826d-d9390746e202",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "schlechter Schreibstil",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "2a5e5cc6-9108-4b73-8ab4-aee57279b569",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "Verballhornung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verballhornung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                        "entry_id": "9a5050c4-d10c-393b-b26a-47f3b49f71d0",
                                        "glosses": [
                                            "etwas, das durch vermeintliches Verbessern verschlimmert wurde"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7fdac8fb-572e-46a5-ac09-160027079682",
                                                "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                                "text": "„Scholli“ ist eine Verballhornung von „Joly“."
                                            },
                                            {
                                                "example_id": "f512f962-d64a-4750-a8f7-bc40adfedf89",
                                                "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                                "text": "Das Wort „Rutsch“ im Neujahrsgruß „Guten Rutsch!“ ist eine Verballhornung des hebräischen „Rosch (ha-Schanah)“ und bedeutet „Anfang“."
                                            },
                                            {
                                                "example_id": "568a173f-e409-4c4c-b78b-2278d53622e9",
                                                "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                                "text": "Die Redewendung „Unter aller Kanone“ ist eine Verballhornung des lateinischen „sub omni canone“, das wörtlich „unterhalb jeder Messskala“ bedeutet."
                                            },
                                            {
                                                "example_id": "b6e230b9-ec47-49e0-ba5e-5c1e86d2e012",
                                                "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                                "text": "„Nicht nur, weil er das Gegenteil von jedem Siegfried war, eher klein, dunkel und witzig, sondern weil das Wort »Krümel« so etwas wie die Verballhornung seines Familiennamens darstellte.“"
                                            },
                                            {
                                                "example_id": "3507ba2a-0990-487e-a9cf-43022ae0d367",
                                                "sense_id": "97b51310-a662-3fd9-b7c7-df5a1c771a32",
                                                "text": "„Er will raus aus der Kitschecke, aus der Sphäre der Verniedlichung und der Verballhornung.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a5c57013-2d6b-4bd2-98bf-e7d8d4aab5f8",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "Malapropismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "afabc432-9901-461c-94c0-92ad7dd3fda9",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
                        "source_sense_id": "81379ce5-8139-3c68-a6cd-837b473ec6c6",
                        "source_sense_description": "Erreurs dans l’orthographe ou dans le style",
                        "target_lang_word": "cacography",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "cacography",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "045b7487-71b3-326c-a762-acef78229ae2",
                                        "entry_id": "3f3c3519-a641-3589-9209-bc40ab7e2b33",
                                        "glosses": [
                                            "Bad spelling or punctuation, especially unintuitive spellings considered as a feature of a whole language or dialect."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3292cef8-ad3e-4d38-9b6f-8bf3348830ef",
                                                "sense_id": "045b7487-71b3-326c-a762-acef78229ae2",
                                                "text": "A phrase exhibits proofs of cacography, when the accents are misplaced, forgotten, or used erroneously."
                                            },
                                            {
                                                "example_id": "f9f8b23a-4b64-42fa-8e12-c5ffb6fab914",
                                                "sense_id": "045b7487-71b3-326c-a762-acef78229ae2",
                                                "text": "In 1997, two American entrepreneurs, Robert Hoffer and Timothy Kay, formed a company called Typo.net to try to profit from Web surfers' cacography."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b4395c72-11e5-37d0-b5aa-4e8df2eb81a7",
                                        "entry_id": "3f3c3519-a641-3589-9209-bc40ab7e2b33",
                                        "glosses": [
                                            "Deliberate comic misspelling; malapropism."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1e68172-2b01-447a-b3a4-c2d5034cdff6",
                                                "sense_id": "b4395c72-11e5-37d0-b5aa-4e8df2eb81a7",
                                                "text": "The soul of dialect is cacography, the deliberate misspelling of words for comic effect, which is the written equivalent of the malapropism."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9b33c68e-7f5d-335f-b313-4dbda6eba887",
                                        "entry_id": "3f3c3519-a641-3589-9209-bc40ab7e2b33",
                                        "glosses": [
                                            "Poor or illegible handwriting."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f2cf5bc7-2198-4793-b9f2-b39032420e93",
                                                "sense_id": "9b33c68e-7f5d-335f-b313-4dbda6eba887",
                                                "text": "Many illegible letters is the sign of disorder, and the illegibility of Greeley's cacography has furnished numberless anecdotes."
                                            },
                                            {
                                                "example_id": "295fb024-79e5-49f2-9c0d-4310aaa52a05",
                                                "sense_id": "9b33c68e-7f5d-335f-b313-4dbda6eba887",
                                                "text": "Germans write a \"1\" so it's easy to confuse it with a \"7\": mathematics and cacography can leave Margret and I not speaking to each other for a week."
                                            },
                                            {
                                                "example_id": "69bbaf43-190a-4274-8e1a-5cbdda48764a",
                                                "sense_id": "9b33c68e-7f5d-335f-b313-4dbda6eba887",
                                                "text": "I don't even recognize the handwriting – kind of a scrawled, almost illegible cacography with the letters slanting haphazardly in all directions."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "28542436-ac16-4785-83af-a6d8d7ca32ff",
                        "source_entry_id": "38d1651a-a044-378b-9875-4de7686bbbaf",
