                "forms": [
                    {
                        "form_id": "fa432b7e-8abd-41ea-9130-6ca9103c6ad7",
                        "entry_id": "7ed9ea1e-d9f0-3966-8118-7546145cb32d",
                        "tags": [
                            "plural"
                        ],
                        "form": "alehouses"
