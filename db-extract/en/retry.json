    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "db2e155f-0429-32ae-8570-717de69d8ce6",
                "word": "retry",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "684aa5db-e955-4839-a8ce-9e6d661ffaee",
                        "entry_id": "db2e155f-0429-32ae-8570-717de69d8ce6",
                        "tags": [
                            "plural"
                        ],
                        "form": "retries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "a1a78843-0a87-3b31-abd1-f52017432e04",
                        "entry_id": "db2e155f-0429-32ae-8570-717de69d8ce6",
                        "glosses": [
                            "Another attempt."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "260a1a8d-d5ae-4963-a207-779a20c4bd46",
                                "sense_id": "a1a78843-0a87-3b31-abd1-f52017432e04",
                                "text": "“As such, the issue with login remains. If for any reason you get the ‘Failed to connect to server’ issue, it means that the maximum number of login requests for that particular minute is exceeded and/or that the servers are full and will require someone to log out before allowing new players in. As mentioned above, the increased capacity should require less retries to get in.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5359d872-cb86-4d44-94ef-1e8f7109ec33",
                        "source_entry_id": "db2e155f-0429-32ae-8570-717de69d8ce6",
                        "source_sense_id": "a1a78843-0a87-3b31-abd1-f52017432e04",
                        "source_sense_description": "another attempt",
                        "target_lang_word": "herkansing",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "herkansing",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "3f96a8b1-a8f1-3461-9dc6-b6962b972d05",
                                        "entry_id": "f4977f59-7ec1-3000-9539-e1064e117e8e",
                                        "glosses": [
                                            "een extra mogelijkheid om een succes te behalen nadat dit eerder mislukt is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "111222e0-6739-44e8-a734-0334eb040e2e",
                                                "sense_id": "3f96a8b1-a8f1-3461-9dc6-b6962b972d05",
                                                "text": "Maar de liefde is van korte duur. Hari wil een herkansing, volgend jaar, als hij hersteld is, en niet in de gevangenis zit, maar dat zegt hij er natuurlijk niet bij. „I will knock you the fuck out”, bitst hij Verhoeven toe. „Let’s do it baby”, zegt de wereldkampioen. De spanning is alweer terug van nooit weggeweest."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
