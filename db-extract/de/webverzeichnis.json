                "senses": [
                    {
                        "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                        "entry_id": "95aadb5d-eb58-32d5-a284-75ab0405a2de",
                        "glosses": [
                            "Sammlung mehrerer Internetseiten, die nach bestimmten Kriterien sortiert sind"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "057e32fa-bad4-4a4e-b12d-fc46577cf88e",
                                "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                                "text": "„Bartz wollte den als Webverzeichnis gestarteten Konzern zum Anbieter von Medieninhalten umbauen.“"
                            },
                            {
                                "example_id": "7ff5ea59-ca7a-461d-b016-7a791f6c284b",
                                "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                                "text": "„Die Paderborner oak media GmbH startet mit ‚Das Oeko-Verzeichnis‘ ein Webverzeichnis speziell für Unternehmen, Vereine, Dienstleister, Institutionen und Bildungsträger, die im Bereich der green economy tätig sind.“"
                            },
                            {
                                "example_id": "5d9ef93f-54f3-4372-934c-1f2a52416a1d",
                                "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                                "text": "„Mit dem Projekt arCHeco, einem Webverzeichnis der Wirtschaftsbestände aus der ganzen Schweiz, wird zudem zusammen mit dem Verein Schweizerischer Archivarinnen und Archivare (VSA) eine Anlaufstelle über das Internet aufgebaut.“"
                            },
                            {
                                "example_id": "6de67058-855e-4a37-a506-3b7bfaac890a",
                                "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                                "text": "„Die Idee inspirierte mindestens zwei weitere Webverzeichnisse, welche ebenfalls von privaten Unternehmen finanziert und von freiwilligen Editoren bearbeitet wurden[.]“"
                            },
                            {
                                "example_id": "f677fe4e-3f66-4c6f-9a19-fc6ccb9dcdb7",
                                "sense_id": "240fdebd-ecda-3b97-884d-6be79d805e9c",
                                "text": "„Das Unternehmen agierte zwischenzeitlich europaweit und finanzierte sich aus Werbung auf seinen Seiten, Contentlizenzierung an Dritte und teilweise Gebühren für die Aufnahme in die Webverzeichnisse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
