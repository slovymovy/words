                    }
                ],
                "senses": [
                    {
                        "sense_id": "78bcd02d-2abc-3573-926d-e9aec12793f1",
                        "entry_id": "665d8f3d-4b8e-30e5-a335-9d6c6911cafb",
                        "glosses": [
                            "The joint between two bones."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "26f9c395-06d6-43d8-ac93-56d8de757ff7",
                                "sense_id": "78bcd02d-2abc-3573-926d-e9aec12793f1",
                                "text": "...that round about the commissure of all our joints..."
                            }
                        ]
                    },
                    {
                        "sense_id": "53365403-8351-3689-97a3-17eeef9f37f2",
                        "entry_id": "665d8f3d-4b8e-30e5-a335-9d6c6911cafb",
                        "glosses": [
                            "A band of nerve tissue connecting the hemispheres of the brain, the two sides of the spinal cord, etc."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "cc1f9777-6f06-3321-a76b-2d2791eb9aad",
                        "entry_id": "665d8f3d-4b8e-30e5-a335-9d6c6911cafb",
                        "glosses": [
                            "The line where the upper and lower lips or eyelids meet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99e5b3a7-f329-42ad-abee-1e21c399328a",
                                "sense_id": "cc1f9777-6f06-3321-a76b-2d2791eb9aad",
                                "text": "There is a third inner eyelid, highly developed and of beautiful mechanism: this is the nictitating membrane, or \"winker\" (nictito, I wink), a delicate, elastic, translucent, pearly-white fold of the conjunctiva. While the other lids move vertically and have a horizontal commissure, the winker sweeps horizontally or obliquely across the ball, from the side next the beak to the opposite."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cc3b5360-ea06-4c0d-8d1f-0efbd2768b38",
                        "source_entry_id": "665d8f3d-4b8e-30e5-a335-9d6c6911cafb",
                        "source_sense_description": "point where the upper and lower lips or eyelids join",
                        "target_lang_word": "commissure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commissure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                        "entry_id": "296daaa9-9496-3a31-8068-73ccbe29e4a8",
                                        "glosses": [
                                            "Point de jonction de deux ou plusieurs parties."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0958cc04-5d13-49d8-ac8e-c18a003b2023",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "La commissure des nerfs optiques."
                                            },
                                            {
                                                "example_id": "64a72b8a-508c-4317-9eb7-f0d7be352e06",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "La commissure des lèvres, des paupières."
                                            },
                                            {
                                                "example_id": "abf88265-fd2f-4379-aef1-1ba0c4d2dbae",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "Les commissures entre les doigts de la main lors de leurs rapprochement."
                                            },
                                            {
                                                "example_id": "ed518f33-aaa4-4ec9-ae3f-bad7a76209ca",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "Sa bouche sinueuse avait l’air d’un bec. Mais, en même temps, elle se relevait aux commissures, avec le sourire de mystère qui flotte sur celle du saint Jean-Baptiste de Vinci."
                                            },
                                            {
                                                "example_id": "d9eacaf6-4526-4e0b-923e-a6c8f717b250",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "Deux psychologues canadiens ont voulu savoir à quel point la commissure droite des lèvres était mobilisée lors du babillage."
                                            },
                                            {
                                                "example_id": "e2cd55a2-fa0d-4c0f-93f4-a8203d5d4245",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "Sorda avait posé un cataplasme chaud de kaolin sur la poitrine du vieil homme pour tenter d’endiguer le flot d’écume qui suintait aux commissures de ses lèvres."
                                            },
                                            {
                                                "example_id": "10736679-27fc-4c52-9fda-fc36c7f161f1",
                                                "sense_id": "0de3ea59-17e7-386c-b8da-15ccf9244ce6",
                                                "text": "Ce matin-là, avant de monter en voiture avec Danielle pour se rendre au salon de coiffure, elle a encore esquivé ses lèvres, puis s'est reprise pour esquisser un baiser sec à leur commissure. Pas tout à fait sur la joue, mais déjà plus sur les lèvres."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6779c4ae-051a-354a-b136-07a376873211",
                                        "entry_id": "296daaa9-9496-3a31-8068-73ccbe29e4a8",
                                        "glosses": [
                                            "Joint entre les pierres."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "592d0bee-c284-4bf5-a0ab-68edd169ee16",
                                                "sense_id": "6779c4ae-051a-354a-b136-07a376873211",
                                                "text": "Les commissures d’un pilier."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
