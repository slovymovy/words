    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "8c3565c1-3224-325c-9e18-c907fc5704ec",
                "word": "homebrewed",
                "pos": "adj",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "62eede2d-9d3b-3fd1-8ee9-5249cb01097c",
                        "entry_id": "8c3565c1-3224-325c-9e18-c907fc5704ec",
                        "glosses": [
                            "Brewed at home."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "cec19dfa-6797-4463-9d00-bc413c9a23f6",
                                "sense_id": "62eede2d-9d3b-3fd1-8ee9-5249cb01097c",
                                "text": "The girl made a wry little face. \"I don't like beer, Mr. Landon,\" she said. \"It's horrid stuff, even when it's homebrewed!"
                            },
                            {
                                "example_id": "b2ca1cd3-c0ec-47c9-8079-16b30f5c4c20",
                                "sense_id": "62eede2d-9d3b-3fd1-8ee9-5249cb01097c",
                                "text": "Two common questions are, \"How long will a homebrewed beer keep?\" and \"Will it spoil?\" The answer is that homebrewed beer has a fairly long storage life."
                            },
                            {
                                "example_id": "b560a977-0e62-4902-9114-14b65fcf671e",
                                "sense_id": "62eede2d-9d3b-3fd1-8ee9-5249cb01097c",
                                "text": "She felt dizzy and befuddled, almost like the time she had swiped a drink of her mother's homebrewed mead."
                            }
                        ]
                    },
                    {
                        "sense_id": "5e78447b-9178-3a82-afdf-ecb831601b8f",
                        "entry_id": "8c3565c1-3224-325c-9e18-c907fc5704ec",
                        "glosses": [
                            "Homemade."
                        ],
                        "tags": [
                            "broadly",
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "418e5474-c61a-43c1-b04d-c0af21340897",
                                "sense_id": "5e78447b-9178-3a82-afdf-ecb831601b8f",
                                "text": "It is somewhat characteristic of this aircraft's designer that he found a homebrewed solution to the high cost of fabricating this curved boom section."
                            },
                            {
                                "example_id": "e28601a3-3d9f-47d5-9b51-032eac7cc8f3",
                                "sense_id": "5e78447b-9178-3a82-afdf-ecb831601b8f",
                                "text": "Bob concocts his own homebrewed version of the fuel by mixing old cooking oil, a small amount of gasoline, methanol from an antifreeze called Heet (found at the auto parts store), and a few gallons of Drano (which contains sodium hydroxide)."
                            },
                            {
                                "example_id": "54a70ca9-3f0e-4330-b10b-9e4076f826b3",
                                "sense_id": "5e78447b-9178-3a82-afdf-ecb831601b8f",
                                "text": "Her tribal doctor also gave her some homebrewed powdered medicine, which he mixed in water."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "4df268e9-ce25-3a88-ba40-1448f9872a7d",
                "word": "homebrewed",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "06bab03f-f3a8-3f04-b7f2-02e0c41627b8",
                        "entry_id": "4df268e9-ce25-3a88-ba40-1448f9872a7d",
                        "glosses": [
                            "Drink brewed at home."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "4506b64a-c0c5-48ef-b686-44caeb3b3d44",
                                "sense_id": "06bab03f-f3a8-3f04-b7f2-02e0c41627b8",
                                "text": "They soon made friends again over a pipe and some homebrewed."
                            },
                            {
                                "example_id": "1ed5fd29-68ae-4e4a-a4d7-2261f46d06c1",
                                "sense_id": "06bab03f-f3a8-3f04-b7f2-02e0c41627b8",
                                "text": "And they shook hands on it there and then, and Mr. Lang called for a girl to bring out some homebrewed from the cellar to make a bargain of it."
                            },
                            {
                                "example_id": "3c3b98a9-ed6d-49ae-806b-84657e9903c4",
                                "sense_id": "06bab03f-f3a8-3f04-b7f2-02e0c41627b8",
                                "text": "Because you actually came inside and sat down and are drinking homebrewed with a smile on your face. Because you brought your hound in with you and he's drinking homebrewed as well."
                            }
                        ]
                    }
                ],
