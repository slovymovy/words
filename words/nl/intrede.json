    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "806688ef-04fd-39f6-82ab-0e6d45b59200",
                    "sense_definition": "Het binnengaan of begin van iets, zoals een periode, seizoen of ontwikkeling.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "begin_of_binnenkomst",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Met de <w>intrede</w> van de winter daalden de temperaturen flink onder het vriespunt.",
                            "target_lang_translations": {
                                "en": "With the <w>onset</w> of winter, temperatures dropped well below freezing."
                            }
                        },
                        {
                            "text": "De <w>intrede</w> van smartphones heeft ons dagelijkse leven enorm veranderd.",
                            "target_lang_translations": {
                                "en": "The <w>advent</w> of smartphones has dramatically changed our daily lives."
                            }
                        }
                    ],
                    "synonyms": [
                        "intree"
                    ],
                    "common_phrases": [
                        "met de intrede van"
                    ],
                    "target_lang_definitions": {
