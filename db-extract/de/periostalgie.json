                ],
                "senses": [
                    {
                        "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                        "entry_id": "f76ae7ae-407e-334b-804e-1d4dc2b9b444",
                        "glosses": [
                            "Knochenhautschmerz"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f5503ee-550f-441d-9487-b112c9804def",
                                "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                                "text": "„Periostitis, auch als Periostalgie bekannt, ist eine Erkrankung, die durch eine Entzündung des Periosts, einer Bindegewebsschicht, die den Knochen umgibt, verursacht wird. Der Zustand ist im Allgemeinen chronisch und ist durch Empfindlichkeit und Schwellung des Knochens und Schmerzen gekennzeichnet.“"
                            },
                            {
                                "example_id": "0a517a95-c06a-4c83-b339-a23a547dc726",
                                "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                                "text": "„Wir suchen daher in jedem Fall , der sich länger hinzieht, durch energische, passive Bewegungen der Gefahr der Inaktivität vorzubeugen. Andererseits geht der Periostalgie häufig eine Myalgie des benachbarten Muskels voraus.“"
                            },
                            {
                                "example_id": "db7be514-0464-4e50-852e-7359537c3a1f",
                                "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                                "text": "„Sicher ist, daß es sich hierbei nicht um eine Periostalgie, sondern wahrscheinlich um eine Periarthritis des Humeroradialgelenkes handelt.“"
                            },
                            {
                                "example_id": "5e18ac2f-4139-4c60-9c51-3f6417d2b54b",
                                "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                                "text": "„Auch ist bei manchen Fällen von Periostalgie eine rheumatische Genese nicht ausgeschlossen.“"
                            },
                            {
                                "example_id": "6f9dceae-0a45-45b7-9e5a-c28467890320",
                                "sense_id": "0f64c465-e867-37dd-ace4-a05ef6663631",
                                "text": "„So war man insbesondere der Auffassung, dass die Schädigungen, durch die eine Periostalgie erzeugt werden können, vor allem traumatischer Art seien, entweder durch akute oder chronische Einwirkung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
