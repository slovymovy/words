                "senses": [
                    {
                        "sense_id": "cb365045-d108-3170-9cc1-f6232f5acd9b",
                        "entry_id": "f38dc78a-56de-33a0-b25e-e3eaebac9c39",
                        "glosses": [
                            "Couvrir d’excréments."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "a0f65f49-ce7e-43a4-ad9a-366812a27bf0",
                                "sense_id": "cb365045-d108-3170-9cc1-f6232f5acd9b",
                                "text": "Quel goût rare et délicieux !\nQu’auprès de lui ma fantaisie\nIncague la sainte ambroisie."
                            }
                        ]
                    },
                    {
                        "sense_id": "c82c9289-14f4-321f-bfc4-6c26ce198d5c",
                        "entry_id": "f38dc78a-56de-33a0-b25e-e3eaebac9c39",
                        "glosses": [
                            "Défier quelqu’un, le braver, en lui témoignant beaucoup de mépris."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "44d9f508-176c-4dd8-bbc3-9592b93793c2",
                                "sense_id": "c82c9289-14f4-321f-bfc4-6c26ce198d5c",
                                "text": "Je me ris de tes coups, j’incague ta fureur."
                            }
                        ]
                    }
