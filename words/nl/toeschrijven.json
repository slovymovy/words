{
    "word_family": [
        "schrijven",
        "beschrijven",
        "overschrijven",
        "inschrijven",
        "uitschrijven",
        "voorschrijven",
        "toeschrijving"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "16dd9d78-aece-30a1-891b-93b30c35beca",
                    "sense_definition": "iets beschouwen als het gevolg van een bepaalde oorzaak of eigenschap",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "causaliteit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ik <w>schrijf</w> de huidige stijging van de werkloosheid aan de onbekwaamheid van de gemeenteraad <w>toe</w>.",
                            "target_lang_translations": {
                                "en": "I <w>attribute</w> the current rise in unemployment to the incompetence of the city council."
                            }
                        },
                        {
                            "text": "Wetenschappers <w>schrijven</w> de klimaatverandering vaak <w>toe</w> aan de uitstoot van broeikasgassen.",
                            "target_lang_translations": {
                                "en": "Scientists often <w>attribute</w> climate change to the emission of greenhouse gases."
                            }
                        }
                    ],
                    "synonyms": [
                        "wijten",
                        "attribueren"
                    ],
                    "common_phrases": [
                        "toeschrijven aan"
                    ],
                    "target_lang_definitions": {
                        "en": "To consider something as the result of a specific cause or property."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attribute",
                                "target_lang_sense_clarification": "to a cause or reason"
                            },
                            {
                                "target_lang_word": "ascribe",
                                "target_lang_sense_clarification": "to a cause or quality"
                            },
                            {
                                "target_lang_word": "blame",
                                "target_lang_sense_clarification": "when the cause is negative"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5339c447-2179-31bf-ab20-a495dce4a06f",
                    "sense_definition": "het auteurschap of de eigenaar van iets associëren met iemand",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "auteurschap",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dit anonieme schilderij wordt door experts aan Rembrandt <w>toegeschreven</w>.",
                            "target_lang_translations": {
                                "en": "This anonymous painting is <w>attributed</w> to Rembrandt by experts."
                            }
                        },
                        {
                            "text": "Hem is dat citaat enige tijd <w>toegeschreven</w>, maar dat bleek later onjuist te zijn.",
                            "target_lang_translations": {
                                "en": "That quote was <w>ascribed</w> to him for some time, but that later turned out to be incorrect."
                            }
                        }
                    ],
                    "synonyms": [
                        "attribueren"
                    ],
                    "common_phrases": [
                        "wordt toegeschreven aan"
                    ],
                    "target_lang_definitions": {
                        "en": "To associate the authorship or ownership of something with someone."
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "attribute",
                                "target_lang_sense_clarification": "authorship or ownership"
                            },
                            {
                                "target_lang_word": "ascribe",
                                "target_lang_sense_clarification": "a work or quote to someone"
                            },
                            {
                                "target_lang_word": "credit",
                                "target_lang_sense_clarification": "to acknowledge someone as the creator"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}