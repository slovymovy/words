                        "entry_id": "af3474f5-9d16-3d61-b321-762afe889bf7",
                        "glosses": [
                            "Langue parlée au Canada et aux États-Unis, de la famille des langues iroquoises, parlée par environ 15 % des 15,500 Mohawks qui résident au Québec, en Ontario et dans l’État de New York."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d5478af-30f2-4f78-a4cb-d12b155c1fa9",
                                "sense_id": "0487114b-d69c-36af-bb4a-c60c34979708",
                                "text": "Même le mohawk, en voie de disparition dans les années 1960, est aujourd’hui la langue d’usage dans des classes d’immersion de tout le primaire à Kanawake."
                            }
                        ]
                    }
