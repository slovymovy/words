                "senses": [
                    {
                        "sense_id": "9a2befd7-e1fc-31cb-9e1b-e89f1fc1934f",
                        "entry_id": "1a1f8f1b-93b2-30a8-ba06-c7314c0ecc47",
                        "glosses": [
                            "пропитать водой, сделать мокрым"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "213a11ca-5f3c-4000-9d98-96175d4c5648",
                                "sense_id": "9a2befd7-e1fc-31cb-9e1b-e89f1fc1934f",
                                "text": "Намочить бельё."
                            },
                            {
                                "example_id": "127c364a-591e-431c-a370-69869ea3cea9",
                                "sense_id": "9a2befd7-e1fc-31cb-9e1b-e89f1fc1934f",
                                "text": "Чтобы кирпич не забирал влагу из раствора, перед укладкой его следует намочить, на несколько секунд полностью погрузив в воду, ― иначе кладка будет непрочной."
                            }
                        ]
                    },
                    {
                        "sense_id": "ccff3bd5-3701-3561-bdfc-3f5a8d3eb865",
                        "entry_id": "1a1f8f1b-93b2-30a8-ba06-c7314c0ecc47",
                        "glosses": [
                            "приготовить какое-нибудь количество чего-нибудь, выдерживая в воде"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7ca6734-e165-4cdd-a3c5-31c6952b5176",
                                "sense_id": "ccff3bd5-3701-3561-bdfc-3f5a8d3eb865",
                                "text": "Намочить банку яблок."
                            },
                            {
                                "example_id": "560dc111-61f7-4fbd-b0ba-b76c296197c3",
                                "sense_id": "ccff3bd5-3701-3561-bdfc-3f5a8d3eb865",
                                "text": "Намочить яблок на зиму."
                            }
                        ]
                    },
                    {
                        "sense_id": "f36f4256-6e75-3295-b96b-4421b96172c7",
                        "entry_id": "1a1f8f1b-93b2-30a8-ba06-c7314c0ecc47",
                        "glosses": [
                            "разг. налить где-нибудь, на что-нибудь, сделать лужу, наплескать"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "027ce32e-7d48-414c-b7b7-d54bb5f24f68",
                                "sense_id": "f36f4256-6e75-3295-b96b-4421b96172c7",
                                "text": "Мылся неаккуратно и кругом намочил."
                            }
                        ]
                    }
