{
    "word_family": [
        "chrysalid"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "ca0cc858-2232-34df-bbda-ac6fccb02c59",
                    "sense_definition": "The pupa of a butterfly or moth, enclosed in a firm case or shell during the stage of metamorphosis.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "biological_pupa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The caterpillar fastened itself securely to a twig before transforming into a green <w>chrysalis</w>.",
                            "target_lang_translations": {
                                "zh": "毛毛虫把自己牢牢地固定在细枝上，然后变成了一只绿色的<w>蝶蛹</w>。"
                            }
                        },
                        {
                            "text": "After two weeks inside the protective <w>chrysalis</w>, an adult monarch butterfly finally emerged.",
                            "target_lang_translations": {
                                "zh": "在起保护作用的<w>蛹</w>里待了两周后，一只成年的黑脉金斑蝶终于破茧而出。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pupa"
                    ],
                    "common_phrases": [
                        "emerge from a chrysalis"
                    ],
                    "target_lang_definitions": {
                        "zh": "（尤指蝴蝶或蛾的）蛹；蝶蛹"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蛹",
                                "target_lang_sense_clarification": "昆虫变态发育阶段的形态"
                            },
                            {
                                "target_lang_word": "蝶蛹",
                                "target_lang_sense_clarification": "蝴蝶的蛹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0b8ccad4-d137-310b-8548-bba300d86ce5",
                    "sense_definition": "A cocoon or protective outer covering produced by an insect during pupation.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "biological_pupa",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We found a silky <w>chrysalis</w> hidden safely beneath the broad garden leaf.",
                            "target_lang_translations": {
                                "zh": "我们在花园宽大的叶片下发现了一只隐蔽且泛着丝光的<w>茧</w>。"
                            }
                        },
                        {
                            "text": "Careful examination showed that the delicate <w>chrysalis</w> was spun from thin protective threads.",
                            "target_lang_translations": {
                                "zh": "仔细观察表明，这个精致的<w>蛹壳</w>是由细细的防护丝编织而成的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cocoon"
                    ],
                    "target_lang_definitions": {
                        "zh": "茧；保护性的外壳"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茧",
                                "target_lang_sense_clarification": "昆虫化蛹时所结的保护壳"
                            },
                            {
                                "target_lang_word": "蛹壳",
                                "target_lang_sense_clarification": "包裹蛹的外层硬壳"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f53b0ed5-d86a-3e89-b623-7f507d2777c5",
                    "sense_definition": "A state or environment that encloses or restricts someone before personal growth or transformation.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "figurative_state",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "After years of isolation, the shy artist gradually broke out of her <w>chrysalis</w>.",
                            "target_lang_translations": {
                                "zh": "在经历了多年的自我封闭后，这位害羞的艺术家逐渐破<w>茧</w>而出。"
                            }
                        },
                        {
                            "text": "He finally cast off the <w>chrysalis</w> of his ordinary routine to pursue his dreams.",
                            "target_lang_translations": {
                                "zh": "他终于打破了平淡日常的<w>保护壳</w>，去追逐自己的梦想。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "cast off the chrysalis"
                    ],
                    "target_lang_definitions": {
                        "zh": "（比喻）蜕变前的封闭状态或庇护所；束缚"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "茧",
                                "target_lang_sense_clarification": "比喻束缚、封闭或保护性的环境"
                            },
                            {
                                "target_lang_word": "保护壳",
                                "target_lang_sense_clarification": "比喻自我封闭的隐秘世界或障碍"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "39bc87b9-1e33-3735-929a-52034d29854e",
                    "sense_definition": "To enter the pupal stage or form a chrysalis.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metamorphosis_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In late summer, the well-fed caterpillar climbs upward and <w>chrysalises</w> upon the stem.",
                            "target_lang_translations": {
                                "zh": "夏末，吃饱的毛毛虫爬上枝茎并<w>化蛹</w>。"
                            }
                        },
                        {
                            "text": "Scientists observed that the larva <w>chrysalised</w> much faster under warmer laboratory conditions.",
                            "target_lang_translations": {
                                "zh": "科学家们观察到，在更温暖的实验室环境下，幼虫<w>化蛹</w>的速度要快得多。"
                            }
                        }
                    ],
                    "synonyms": [
                        "pupate"
                    ],
                    "target_lang_definitions": {
                        "zh": "化蛹；结茧成蛹"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "化蛹",
                                "target_lang_sense_clarification": "幼虫转变为蛹的过程"
                            },
                            {
                                "target_lang_word": "结蛹",
                                "target_lang_sense_clarification": "形成蛹"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b05b066-607a-307b-91d9-49a689fad856",
                    "sense_definition": "To undergo a major change or transformation; to metamorphose.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "metamorphosis_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Over the quiet summer months, the clumsy teenager had <w>chrysalised</w> into an elegant dancer.",
                            "target_lang_translations": {
                                "zh": "在寂静的夏日几个月里，那个笨拙的少年已经<w>蜕变</w>成了一位优雅的舞者。"
                            }
                        },
                        {
                            "text": "The local community organization slowly <w>chrysalised</w> into an influential political party.",
                            "target_lang_translations": {
                                "zh": "该地方社区组织逐渐<w>转变</w>为一个颇具影响力的政党。"
                            }
                        }
                    ],
                    "synonyms": [
                        "metamorphose",
                        "transform"
                    ],
                    "target_lang_definitions": {
                        "zh": "（比喻）蜕变；彻底转变"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "蜕变",
                                "target_lang_sense_clarification": "经历根本性、脱胎换骨式的变化"
                            },
                            {
                                "target_lang_word": "转变",
                                "target_lang_sense_clarification": "改变状态或面貌"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "531a4ee1-fc64-3739-b1c5-66e485dee97c",
                    "sense_definition": "A hypothetical former moon of Saturn, proposed as the origin of Saturn's rings and axial tilt.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "astronomical_name",
                    "examples": [
                        {
                            "text": "Astronomers suggested that the gravitational disruption of <w>Chrysalis</w> generated the spectacular planetary rings.",
                            "target_lang_translations": {
                                "zh": "天文学家提出，<w>克律萨利斯</w>受引力撕裂瓦解，从而形成了壮观的土星环。"
                            }
                        },
                        {
                            "text": "The orbital models indicate that <w>Chrysalis</w> may have collided with Saturn millions of years ago.",
                            "target_lang_translations": {
                                "zh": "轨道模型显示，数百万年前<w>克律萨利斯</w>可能与土星发生过碰撞。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "克律萨利斯（天文学家假想的土星已毁卫星）"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "克律萨利斯",
                                "target_lang_sense_clarification": "土星假想古卫星名"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}