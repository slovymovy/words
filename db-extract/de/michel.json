                ],
                "senses": [
                    {
                        "sense_id": "54ccaea7-6b1f-3acf-964c-9b093814cea8",
                        "entry_id": "0a1138ba-a572-380d-993f-1f1ae45b14e7",
                        "glosses": [
                            "Nebenform, Kurzform oder Koseform zu dem Vornamen Michael (Singular, im Plural nur mit Artikel, meist männlich, seltener auch weiblich)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66c43799-c239-4f59-beb1-5aafabba443f",
                                "sense_id": "54ccaea7-6b1f-3acf-964c-9b093814cea8",
                                "text": "Michel ist stets der Beste seiner Klasse gewesen."
                            },
                            {
                                "example_id": "34867642-31cc-4182-8703-88408c99e505",
                                "sense_id": "54ccaea7-6b1f-3acf-964c-9b093814cea8",
                                "text": "„Doch da Nora nicht an einer Kriegsneurose litt wie Michel, schien es sich bei Joyce nur um einen Fall von familiärem Zwist zu handeln, der durch Zeit und Abstand sicher beizulegen war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "87d9bbf7-bd1e-382e-aca7-e4e19ec99702",
                        "entry_id": "0a1138ba-a572-380d-993f-1f1ae45b14e7",
                        "glosses": [
                            "französische Form von Michael (Singular, im Plural nur mit Artikel möglich: siehe Tab. 1)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099acc35-838f-4f31-8ca6-28ad3a64c041",
                                "sense_id": "87d9bbf7-bd1e-382e-aca7-e4e19ec99702",
                                "text": "Ich kann mir nicht helfen, aber Robert hat eine unwahrscheinliche Ähnlichkeit mit Michel Piccoli. Findest du nicht auch?"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "1531a4cc-9121-37c8-8afa-896b253647d5",
                        "entry_id": "0a1138ba-a572-380d-993f-1f1ae45b14e7",
                        "glosses": [
                            "Kurzbezeichnung für eine Hamburger Hauptkirche"
                        ],
                        "tags": [
                            "nur im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "2a4fcc64-c966-4fe8-91dc-7d4fba122452",
                                "sense_id": "1531a4cc-9121-37c8-8afa-896b253647d5",
                                "text": "Der Michel ist eines der Wahrzeichen Hamburgs."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "edd61e8d-d4e2-3cd5-aa17-f9bf33e3346e",
                        "entry_id": "0a1138ba-a572-380d-993f-1f1ae45b14e7",
                        "glosses": [
                            "die Verkörperung deutschen Volkstums; ab circa 1840 in Karikaturen meistens dargestellt als ungelenker Bauernbursche mit Zipfelmütze und Kniehosen"
                        ],
                        "tags": [
                            "nur im Singular"
                        ],
                        "examples": [
                            {
                                "example_id": "4f1fa2e5-3ce0-4c4a-989b-b5a7da8750fe",
                                "sense_id": "edd61e8d-d4e2-3cd5-aa17-f9bf33e3346e",
                                "text": "Wer, so frage ich, will schon gern als deutscher Michel gelten?"
                            },
                            {
                                "example_id": "124ee411-cfd9-4dbc-8bf1-4cff287417b9",
                                "sense_id": "edd61e8d-d4e2-3cd5-aa17-f9bf33e3346e",
                                "text": "„Vorbei die Zeiten, in denen der deutsche Michel mit der Zipfelmütze aus seinem romantischen Fachwerkhäuschen träumte und höchstens aufpassen mußte, daß seine lange Tabakspfeife nicht den Grenzen des benachbarten Duodez-Idylls zu nahe kam.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    },
                    {
                        "sense_id": "a890aacb-0d14-3d67-992a-f883c796a902",
                        "entry_id": "0a1138ba-a572-380d-993f-1f1ae45b14e7",
                        "glosses": [
                            "die Eigenschaft „groß“ in Texten und Namen aus dem Mittelalter"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8e828b62-b60a-4f13-a82b-98d47d9f8718",
                                "sense_id": "a890aacb-0d14-3d67-992a-f883c796a902",
                                "text": "In Michelbach, Michelstetten, Micheldorf ist das Adjektiv michel noch erhalten geblieben."
                            }
                        ],
                        "sense_index_json": "\"5\""
                    }
                ],
                "translations": [],
