                ],
                "senses": [
                    {
                        "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                        "entry_id": "95383506-1833-39e9-a458-446cf7472541",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba859ca3-fe50-4387-a7c3-9a03a816ea81",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Frau Jagsch ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "ad18c425-79f2-4dc6-8aca-4c659ae649f2",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Herr Jagsch wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "f98fa275-2b5c-4592-992f-9a77317a6b47",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Die Jagschs fliegen heute nach Berlin."
                            },
                            {
                                "example_id": "3e7cdffd-ebef-4a04-8b2a-ed5d26335bc3",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Der Jagsch trägt nie die Pullover, die die Jagsch ihm strickt."
                            },
                            {
                                "example_id": "18e74333-a472-47bc-bf2e-13db1b52f64d",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Jagsch kommt, geht der Herr Jagsch.“"
                            },
                            {
                                "example_id": "aa35a7fc-2be1-42c9-bbb8-ddc70eed4b06",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Jagsch kommt und geht."
                            },
                            {
                                "example_id": "f1488a46-522c-4bfb-88f5-623689908de5",
                                "sense_id": "62750cc6-a330-3bdf-9b1c-2032f13fc2af",
                                "text": "Jagschs kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
