                "senses": [
                    {
                        "sense_id": "9b2afbf4-4a28-3ed6-a5f5-784a0f728782",
                        "entry_id": "c4cc83df-753e-398e-b06a-701b3cb0c3b3",
                        "glosses": [
                            "zittriger, alter, gebrechlicher Mann"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "55a288fe-720e-474b-9c19-755a0dbceca7",
                                "sense_id": "9b2afbf4-4a28-3ed6-a5f5-784a0f728782",
                                "text": "„Wenn ich mit meinen fünfundzwanzig Jahren alt bin, bist du mit deinen fünfunddreißig ein Tattergreis.“"
                            },
                            {
                                "example_id": "75ee2bc5-bc55-4806-84cf-74b6ca57c639",
                                "sense_id": "9b2afbf4-4a28-3ed6-a5f5-784a0f728782",
                                "text": "„Ich bin ja schließlich auch noch kein Tattergreis.“"
                            },
                            {
                                "example_id": "639e74c8-4413-4a09-810f-b0234baa22e0",
                                "sense_id": "9b2afbf4-4a28-3ed6-a5f5-784a0f728782",
                                "text": "„Weißt du, was du bist? Ein alter verkalkter Tattergreis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
