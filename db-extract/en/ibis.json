                    {
                        "translation_id": "5d145caf-3acd-4414-a953-679f7a84bab5",
                        "source_entry_id": "29c606dc-e9ff-31df-a29a-bad173eabb39",
                        "source_sense_id": "71af7512-b4c2-3702-91ab-21675b37dd00",
