                                "target_lang_sense_clarification": "secondary, typically undesirable effect"
                            },
                            {
                                "target_lang_word": "byproduct",
                                "target_lang_sense_clarification": "secondary result of an action"
                            },
                            {
                                "target_lang_word": "aftereffect",
                                "target_lang_sense_clarification": "subsequent outcome"
                            }
                        ]
                    }
                }
            ]
        }
    ]
