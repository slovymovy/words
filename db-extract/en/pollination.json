                    {
                        "translation_id": "567c1198-86e5-4f30-95e4-9e87b1e274ec",
                        "source_entry_id": "b161bb5c-3f83-3d66-9c45-c93b3be6119f",
                        "source_sense_id": "84d74d5c-68f3-330e-8f4e-afe1edf4bc21",
