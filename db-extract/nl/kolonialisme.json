        "nl-extract.jsonl": [
            {
                "entry_id": "d4e60c72-c7cb-3761-85ff-86b46e8df381",
                "word": "kolonialisme",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0a04afa5-a8ae-3bc7-90b7-470c3f04fe49",
                        "entry_id": "d4e60c72-c7cb-3761-85ff-86b46e8df381",
                        "glosses": [
                            "politiek systeem waarbij een land voor eigen voordeel een of meer andere landen bestuurt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6a680c13-1089-489f-835f-6f03a4332bcc",
                                "sense_id": "0a04afa5-a8ae-3bc7-90b7-470c3f04fe49",
                                "text": "De actievoerders betrekken het kolonialisme bij de herdenking. Ze menen dat \"oorlogsmisdadigers worden herdacht,\" omdat dus ook de Nederlandse militairen die sneuvelden tijdens de oorlog tegen onafhankelijkheidsstrijders in het toenmalige Nederlands-Indië worden herdacht."
                            },
                            {
                                "example_id": "66754b8b-f172-4a58-b87b-2974d7fb61d4",
                                "sense_id": "0a04afa5-a8ae-3bc7-90b7-470c3f04fe49",
                                "text": "Hoogleraar Te Kahautu Maxwell van de Universiteit van Waikato draagt de tatoeage ook. Voor hem is de moko een belangrijk symbool voor het overwinnen van kolonialisme en het terugnemen van de Maori-identiteit. \"Het is een traditie die bijna verloren was gegaan door kolonialisme en de handelingen van onderdrukkers. We moeten dat laatste wat ons onderscheidt blijven beschermen.\""
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "93764bc5-ad07-4f08-83b4-ca7cee1bedf1",
                        "source_entry_id": "d4e60c72-c7cb-3761-85ff-86b46e8df381",
                        "source_sense_id": "0a04afa5-a8ae-3bc7-90b7-470c3f04fe49",
                        "target_lang_word": "colonialism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "colonialism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "The policy of a country seeking to extend or retain its authority over other people or territories, generally with the aim of economic dominance."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d090db2-c770-46e8-9d2d-196f8d441353",
                                                "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                                "text": "Though most of the cases here cover European encounters with non-Europeans, it is not the intention of the book to give the impression that genocide is a function of European colonialism and imperialism alone."
                                            },
                                            {
                                                "example_id": "ca4136d3-c86a-421f-a6ae-373a9722e1b1",
                                                "sense_id": "a87b5308-de14-381b-8fa5-dba36fccd1c6",
                                                "text": "It was the racist, settler colonialism that created whiteness, that created blackness, half-caste, quarter-caste, octoroon, that saw mixed-race people as a third race."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8f1ab9fe-499f-3446-8d24-5948b72f5575",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "Any form of foreign influence seen as undesirable."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "countable",
                                            "derogatory",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1f94d0ab-29c3-3c67-b0e2-ec06a1454c6d",
                                        "entry_id": "5d17f9f1-06a0-35cc-80b7-fae1210e659b",
                                        "glosses": [
                                            "A colonial word, phrase, concept, or habit."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb21eb4-d063-45f0-905f-8d5759363c51",
                                                "sense_id": "1f94d0ab-29c3-3c67-b0e2-ec06a1454c6d",
                                                "text": "Although the settlement seems so far to have made but slow progress, there are many things which show that, to use a colonialism, \"the place was going ahead.\""
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5c687fd2-6b38-33b5-ba6a-757ec3483203",
