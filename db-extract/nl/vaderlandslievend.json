                ],
                "senses": [
                    {
                        "sense_id": "f48af111-499a-3d17-8943-b52de30f593a",
                        "entry_id": "6a0ad7d5-55aa-3556-b5a0-ffb8b4815aae",
                        "glosses": [
                            "met liefde voor het land dat je ziet als je vaderland"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "11460917-a9be-42a2-b292-32c3a9e796cb",
                                "sense_id": "f48af111-499a-3d17-8943-b52de30f593a",
                                "text": "Als in 1914 de Eerste Wereldoorlog losbreekt, vraagt Debussy - die zich in een vaderlandslievende bui ‘Claude de France’ noemt - zich af hoe zijn muziek de natie kan dienen. In de krant laat hij ontvlambare uitspraken over ‘een muzikale bevrijding’ optekenen. Hoe geraffineerd en sensueel die bevrijding klinkt, kan je horen aan de sonates die hij tijdens de oorlog componeerde."
                            },
                            {
                                "example_id": "88c85457-bb09-457e-ae01-b1dc7b296bf0",
                                "sense_id": "f48af111-499a-3d17-8943-b52de30f593a",
                                "text": "Het nieuwe curriculum verlangt ook dat religieuze scholen, die in aantal toenemen, kinderen bijbrengen dat de 'jihad'vaderlandslievend van geest is."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6076cc23-fc14-423e-887c-8fdb888080aa",
                        "source_entry_id": "6a0ad7d5-55aa-3556-b5a0-ffb8b4815aae",
                        "source_sense_id": "f48af111-499a-3d17-8943-b52de30f593a",
                        "target_lang_word": "patriotic",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "patriotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                        "entry_id": "b7cc245e-121a-3ff9-8d16-7d7266325b9a",
                                        "glosses": [
                                            "Inspired by or showing patriotism; done out of love of one's country; zealously and unselfishly devoted to the service of one's country"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fe74a66c-6b42-4040-9826-bca521821de7",
                                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                                "text": "a patriotic statesman"
                                            },
                                            {
                                                "example_id": "166ab878-cbfd-4c4e-9b24-994dc76b3862",
                                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                                "text": "a patriotic song"
                                            },
                                            {
                                                "example_id": "c8f872a0-82de-4aea-9541-e729a882f111",
                                                "sense_id": "bbae4099-ad73-355c-b493-3953c630fd58",
                                                "text": "But if patriotic sentiment is wanted,\nI've patriotic ballads cut and dried;\nFor where'er our country's banner may be planted,\nAll other local banners are defied!"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "patriotic",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8b702512-368c-3dab-8055-061029bd943d",
                                        "entry_id": "623d5aff-cdfc-3b0d-b4fd-3a6704886056",
                                        "glosses": [
                                            "A postage stamp, Civil War token, etc. bearing a patriotic design."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
