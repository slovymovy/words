                "senses": [
                    {
                        "sense_id": "b40989c4-adea-3118-8e35-e5e3d482e74c",
                        "entry_id": "6926ecbb-c335-3ead-8ebe-048c846fecce",
                        "glosses": [
                            "Capsuler à nouveau."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "08465e13-cc13-43c5-b571-791b0626ec3e",
                                "sense_id": "b40989c4-adea-3118-8e35-e5e3d482e74c",
                                "text": "Au sieur Renard (H.-E.-A.) à Liége, un brevet d’invention, à prendre date le 1ᵉʳ juin 1869 , pour des appareils à décapsuler et recapsuler les cartouches à culot métallique."
                            },
                            {
                                "example_id": "30c3002b-0d7d-473b-8c2c-07d8ea165830",
                                "sense_id": "b40989c4-adea-3118-8e35-e5e3d482e74c",
                                "text": "Il ne parvient qu'avec beaucoup de difficulté à recapsuler un flacon d'une seule main."
                            },
                            {
                                "example_id": "fde56216-238a-46f7-b8be-4b46073fb33f",
                                "sense_id": "b40989c4-adea-3118-8e35-e5e3d482e74c",
                                "text": "Le processeur a été décapsulé avec soin mais je peux le recapsuler sans soucis et proprement."
                            }
                        ]
                    }
                ],
