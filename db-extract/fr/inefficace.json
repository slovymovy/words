                                        "entry_id": "13199a8c-19e8-3cc7-ba1a-ae20f6139daa",
                                        "glosses": [
                                            "Not having the desired effect; ineffectual; otiose."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                        "entry_id": "13199a8c-19e8-3cc7-ba1a-ae20f6139daa",
                                        "glosses": [
                                            "Lacking in ability; incompetent or inadequate."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c22a5b9c-2f9d-40fd-9854-9f4924e01f60",
                                                "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                                "text": "Fire ants circumvented the problem of an ineffective sting by having an unusual and highly effective venom that when daubed or sprayed on other ants penetrates their waxy protective integumental barrier and kills or disables them."
                                            },
                                            {
                                                "example_id": "b38abff8-e1f0-4085-a3aa-5e35fed110b1",
                                                "sense_id": "34612349-f7c9-36af-8b46-f0a4f2d6b678",
                                                "text": "Their use was “impermissible not because it is unwise or ineffective, but because [federal law]^([sic]) does not allow it”, the decision explained."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
