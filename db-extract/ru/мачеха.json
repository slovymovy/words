                        ],
                        "form": "ма́чехах"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5e90c31c-ce8e-3e06-b43f-00c374fc0b69",
                        "entry_id": "5d80364f-70c0-3f0e-9325-cd723c9cb9b4",
                        "glosses": [
                            "жена (вдова) по отношению к детям своего мужа (нынешнего или покойного) от его предыдущих браков, а также к его побочным детям"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1a66741e-338f-4cea-8314-9786b03dcde6",
                                "sense_id": "5e90c31c-ce8e-3e06-b43f-00c374fc0b69",
                                "text": "Я не хотел посягать на второй брак, не хотел отдать детей в волю мачехи, и сам посвятил им свои заботы."
                            }
                        ]
                    },
                    {
                        "sense_id": "7bec00f4-2bd0-3415-b595-34871164fd27",
                        "entry_id": "5d80364f-70c0-3f0e-9325-cd723c9cb9b4",
                        "glosses": [
                            "народное название растения мать-и-мачеха"
                        ],
                        "tags": [],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5171e2c9-b525-422f-8a93-c0c3630a07f1",
                        "source_entry_id": "5d80364f-70c0-3f0e-9325-cd723c9cb9b4",
                        "source_sense_description": "жена отца",
                        "target_lang_word": "stepmother",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "stepmother",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "34e19f3a-3af8-3988-b897-ebe09143f32f",
                                        "entry_id": "cf1eba5e-41d8-369b-8e8f-97695c6721e1",
                                        "glosses": [
                                            "The wife of one's biological father, other than one's biological mother."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "5d2dedbe-4aee-3204-9f53-8b2f4d265317",
                                        "entry_id": "cf1eba5e-41d8-369b-8e8f-97695c6721e1",
                                        "glosses": [
                                            "A viola, especially Viola tricolor, heartsease."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9e8c5219-6619-4277-875b-bab57078fa0f",
                                                "sense_id": "5d2dedbe-4aee-3204-9f53-8b2f4d265317",
                                                "text": "The second came up about ten days later in the lee of the channel marker, and it was called stepmother, or love-in-idelness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e91678d5-73d3-4d27-8f17-ad78d8131479",
                        "source_entry_id": "5d80364f-70c0-3f0e-9325-cd723c9cb9b4",
                        "source_sense_description": "жена отца",
                        "target_lang_word": "Stiefmutter",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Stiefmutter",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                        "entry_id": "9ebcc088-317f-3382-bbcc-6d3f2e1753de",
                                        "glosses": [
                                            "die nach einer Wiederverheiratung des Vaters (infolge von Tod oder Scheidung) neue Ehefrau des Vaters, die mit ihrem Stiefkind (Stieftochter, Stiefsohn) nicht leiblich verwandt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "92234ffa-aee4-4255-9673-42f172e16738",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "Meine Stiefmutter ist eine liebevolle Frau."
                                            },
                                            {
                                                "example_id": "14d3323a-aef6-4bf3-8942-61ddd95fcbe3",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Er wollte seinem geliebten Sohn keine Stiefmutter vorsetzen.“"
                                            },
                                            {
                                                "example_id": "a2c9f8b3-fca2-49ae-8698-0fe7d0b6638b",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Die neue Stiefmutter kümmerte sich wohl um die körperlichen Bedürfnisse der Stiefkinder; ein wirklicher Ersatz für die leibliche Mutter wurde sie aber nie.“"
                                            },
                                            {
                                                "example_id": "b8f49e05-bd63-48fa-991e-4b35ceae8c83",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Zu meiner Stiefmutter habe ich ein gutes Verhältnis.“"
                                            },
                                            {
                                                "example_id": "a859536c-faca-42b3-8256-5685f6ef7d88",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Meine neue Stiefmutter rechtfertigte völlig die schlechte Meinung, die man von ihr hatte, und ihr erstes Auftreten bestand darin, daß sie mich zu verführen suchte.“"
                                            },
                                            {
                                                "example_id": "f54fcf9a-22c5-42bf-9c0e-efa49e2a3379",
                                                "sense_id": "dc607c20-b6bf-32f0-8e33-692f4098afd4",
                                                "text": "„Meine spätere Stiefmutter hatte ebenfalls keinen Grund, für ihre Stieftochter oder für mich besondere Zuneigung zu entwickeln.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "be60047a-b2b7-3b25-92b7-38f8f7d6ebfa",
                                        "entry_id": "9ebcc088-317f-3382-bbcc-6d3f2e1753de",
                                        "glosses": [
                                            "Stereotype für eine oder die böse Frau"
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5c7a5512-c642-49b9-953c-bad7fe7ddbc9",
                                                "sense_id": "be60047a-b2b7-3b25-92b7-38f8f7d6ebfa",
                                                "text": "Du könntest etwas netter sein und mich nicht wie eine Stiefmutter behandeln."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
