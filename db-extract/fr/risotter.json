                ],
                "senses": [
                    {
                        "sense_id": "28ee046b-f81f-3afd-b9dd-2df8df54b7b2",
                        "entry_id": "30952021-589c-3843-ae5c-1735ef8f0c43",
                        "glosses": [
                            "Cuire à la manière d’un risotto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9077d2c4-76ce-493f-95bb-7d089bea42d4",
                                "sense_id": "28ee046b-f81f-3afd-b9dd-2df8df54b7b2",
                                "text": "Laisser \"risotter\" pendant une dizaine de minutes, le temps de cuire les pâtes et que le bouillon s’évapore - Rajouter de l’eau au besoin."
                            },
                            {
                                "example_id": "28276c24-b0f2-40a1-9515-0f0cf59021db",
                                "sense_id": "28ee046b-f81f-3afd-b9dd-2df8df54b7b2",
                                "text": "Égouttez-les puis à l’aide d’une pince à pâtes, versez-les dans la poêle avec l’artichaut. Gardez l’eau à ébullition sur le feu, car elle servira à risotter les pâtes."
                            }
                        ]
                    },
                    {
                        "sense_id": "ce3d034b-dd0b-3290-b4c6-bfd9b33a7260",
                        "entry_id": "30952021-589c-3843-ae5c-1735ef8f0c43",
                        "glosses": [
                            "Inclure dans un risotto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "36005978-2982-4d75-b64e-bd4366f662b2",
                                "sense_id": "ce3d034b-dd0b-3290-b4c6-bfd9b33a7260",
                                "text": "Toute courge est bonne à « risotter » !"
                            }
                        ]
                    },
                    {
                        "sense_id": "e0249ce1-96d6-3411-9e33-4f173c2e0e20",
                        "entry_id": "30952021-589c-3843-ae5c-1735ef8f0c43",
                        "glosses": [
                            "Préparer un risotto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3c9063d3-6343-48f6-a0eb-c29971716174",
                                "sense_id": "e0249ce1-96d6-3411-9e33-4f173c2e0e20",
                                "text": "Telle une déesse lors du banquet des dieux, gambas et txakoli en guise de nectar et ambroisie, Geneviève me rejoignit pour que je trouve moins long le temps de risotter."
                            }
                        ]
                    },
                    {
                        "sense_id": "28b2122a-d827-319b-a83d-8ee0e0c1545d",
                        "entry_id": "30952021-589c-3843-ae5c-1735ef8f0c43",
                        "glosses": [
                            "Manger du risotto."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a05bc247-7e93-44f8-8f2b-ec31faef1506",
                                "sense_id": "28b2122a-d827-319b-a83d-8ee0e0c1545d",
                                "text": "Da Vinci: Un bon restaurant qui fait risotter la place du midi"
                            },
                            {
                                "example_id": "ef554cf4-8e42-45c8-8139-3df3ad23e5e8",
                                "sense_id": "28b2122a-d827-319b-a83d-8ee0e0c1545d",
                                "text": "Depuis 2000, une IGP en protège même les différentes variétés, au grand bonheur des locavores, qui peuvent ainsi « risotter » français."
                            }
                        ]
                    }
                ],
