                    }
                ],
                "senses": [
                    {
                        "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                        "entry_id": "b7162de1-b9f8-30b2-9f2b-393845959eb1",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8d1dbe36-d6d4-48ad-82b0-1b59b4f564e5",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Frau Luna ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bbbfa304-be27-4885-ac0c-296e8aa9bcd8",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Herr Luna wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "373a0b15-0513-4c6e-b902-5c53f52e158d",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Die Lunas kommen heute aus dem Knüllgebirge."
                            },
                            {
                                "example_id": "7a1ebe9a-e516-4406-9723-a95803c23ddf",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Der Luna trägt nie die Schals, die die Luna ihm strickt."
                            },
                            {
                                "example_id": "45ef65e6-8843-419a-b81c-f021f0fa6178",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Luna kommt, geht der Herr Luna.“"
                            },
                            {
                                "example_id": "70a3c6a7-5b4e-41e6-9b1a-28997b56ea64",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Luna kommt und geht."
                            },
                            {
                                "example_id": "d09afaad-5837-4a05-a19a-ab86cfc5c29f",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "Lunas kamen, sahen und siegten."
                            },
                            {
                                "example_id": "f6211681-3d24-4770-8d78-9b9eb298b545",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "An verregneten Herbsttagen ist Familie Lunas liebste Beschäftigung das Bemalen von Hühnereiern."
                            },
                            {
                                "example_id": "fcb7eb31-c5e6-4027-bdbd-b07e80a7dffc",
                                "sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                                "text": "An verschneiten Wintertagen ist die liebste Beschäftigung von Familie Luna das Schmücken von Weihnachtsbäumen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f1ce1368-1db3-4ffa-8c19-57f30db56222",
                        "source_entry_id": "b7162de1-b9f8-30b2-9f2b-393845959eb1",
                        "source_sense_id": "c58e1137-9144-30c5-876d-df8d9b9ee5c2",
                        "source_sense_description": "Familienname, Nachname",
                        "target_lang_word": "Luna",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Luna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b7114985-cec0-38ab-8401-385d80768367",
                                        "entry_id": "52046cdb-5c96-316a-9ca8-3cd673a55d57",
                                        "glosses": [
                                            "The sister of Aurora and Sol; the goddess of the moon; equivalent to the Greek Selene."
                                        ],
                                        "tags": [
                                            "Roman"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "112ece3c-5371-330a-8dd8-6dd0ddb7929c",
                                        "entry_id": "52046cdb-5c96-316a-9ca8-3cd673a55d57",
                                        "glosses": [
                                            "The name of Earth's moon; Moon."
                                        ],
                                        "tags": [
                                            "poetic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "32eb3a9a-a316-4ed8-aece-b2d067b8d0fc",
                                                "sense_id": "112ece3c-5371-330a-8dd8-6dd0ddb7929c",
                                                "text": "Luna that ne'er shines by day."
                                            },
                                            {
                                                "example_id": "a8b47d10-ab8f-4c3a-bf04-ed0cce4482e3",
                                                "sense_id": "112ece3c-5371-330a-8dd8-6dd0ddb7929c",
                                                "text": "He has but little prudence, no apprehension of consequences, and none of that melancholy which in tempraments of Luna and Venus is generally felt, and from which he is saved by the combination of Mars and Mercury."
                                            },
                                            {
                                                "example_id": "3fb4537f-d081-48aa-b650-51877b5e2835",
                                                "sense_id": "112ece3c-5371-330a-8dd8-6dd0ddb7929c",
                                                "text": "The different visible shapes of Luna are called her phases."
                                            },
                                            {
                                                "example_id": "7123e704-4921-4b1b-ad91-709100777581",
                                                "sense_id": "112ece3c-5371-330a-8dd8-6dd0ddb7929c",
                                                "text": "Lagrange point L1 is the perfect location for humanity's next major space station, the natural gateway to the moon. This one-of-a-kind point in space is located on the direct line between Earth and Luna about 200,000 miles from Earth, or conversely, a mere 39,000 miles above the geometric center of Luna's nearside."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "37baaa15-87a9-3d9b-bfe6-f8c00feb4fd4",
                                        "entry_id": "52046cdb-5c96-316a-9ca8-3cd673a55d57",
                                        "glosses": [
                                            "A female given name from Latin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b628af7d-16dc-40b6-8388-4d93115b2167",
                                                "sense_id": "37baaa15-87a9-3d9b-bfe6-f8c00feb4fd4",
                                                "text": "- - - and it so happened, that in one of old Bryan's daughters named Luna, or more familiarly Loony, he perceived, or thought he perceived, some imaginary similarity in form and air to the lovely apparition."
                                            },
                                            {
                                                "example_id": "b049c926-1168-49d9-b3d9-14358be69406",
                                                "sense_id": "37baaa15-87a9-3d9b-bfe6-f8c00feb4fd4",
                                                "text": "A few seconds later, Luna Lovegood emerged, trailing behind the rest of the class, a smudge of earth on her nose, and her hair tied in a knot on the top of her head."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "Luna",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c74e268e-e055-3aa3-8776-4384d59d447c",
                                        "entry_id": "ffaed821-279f-3703-805b-e3c74d9e00b7",
                                        "glosses": [
                                            "Argent (silver), in the postmedieval practice of blazoning the tinctures of certain sovereigns' (especially British monarchs') coats as planets."
                                        ],
                                        "tags": [
                                            "rare",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "07aeca75-4fdf-4503-8e28-1c0a6a4737ac",
                                                "sense_id": "c74e268e-e055-3aa3-8776-4384d59d447c",
                                                "text": "4. Luna, a Mantle of Estate, Mars doubled Ermine, ouched Sol, garnished with Strings fastned thereunto fretways dependent, and tasselled of the same. [...] These Arms do belong to the Town of Beckbock in Wales."
                                            },
                                            {
                                                "example_id": "ba348b91-0191-4d08-a821-ffabff161bba",
                                                "sense_id": "c74e268e-e055-3aa3-8776-4384d59d447c",
                                                "text": "George [...] Ist. Mars, three Lions passant guardant in Pale Sol, for the Arms of England, Impal'd with Scotland, i.e. Sol, a Lion rampant within a double Tressure counterflory Mars. 2d. Jupiter, three Fleurs de Lis Sol, for the Arms of France. 3d. Jupiter, an Irish Harp Sol, stringed Luna, for Ireland. 4th. Seme party per Pale, and per Chevron enarche, in the Ist Mars, two Lions passant guardant Sol, for Brunswick. In the 2d Partition Sol, semy of Hearts Mars, and a Lion rampant Jupiter, armed and langued of the First, for Luneburg. The base is Mars, a Horse currant Luna, over these last on an Inescocheon, Constantine's Crown."
                                            },
                                            {
                                                "example_id": "fc5dd313-23b4-427d-b5d8-255b5759c892",
                                                "sense_id": "c74e268e-e055-3aa3-8776-4384d59d447c",
                                                "text": "8. Tierce in Mantle, first Mars, two Lions passant-guardant in pale, Sol, for Brunswick; 2d Sol, Semi of Hearts proper, a Lion rampant Jupiter, for Lunenburgh; 3d, ente en Point, Mars, an Horse currant Luna, for Saxony."
                                            },
                                            {
                                                "example_id": "8cca7f2b-1c7d-4f56-a22b-9a0214db8f77",
                                                "sense_id": "c74e268e-e055-3aa3-8776-4384d59d447c",
                                                "text": "The third, the Ensign of Ireland, which is, Jupiter, an Harp Sol, stringed Luna."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "32e859f2-04e9-33fc-a1b5-2e75938f37e8",
                                        "entry_id": "ffaed821-279f-3703-805b-e3c74d9e00b7",
                                        "glosses": [
                                            "Silver."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
