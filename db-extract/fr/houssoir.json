                        "entry_id": "ef2fff7d-b08c-39a5-9779-49b36b09c8bb",
                        "glosses": [
                            "Balai de houx ou d’autre branchage, et le plus souvent de plumes."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "e2b61731-3c1c-4801-bf8a-b932effffa80",
                                "sense_id": "50e60419-b855-32ae-b67b-9fb87f3aea58",
                                "text": "Donnez un coup de houssoir à ce tapis."
                            },
                            {
                                "example_id": "ed8535e8-dc91-415b-af32-06f9cebff207",
                                "sense_id": "50e60419-b855-32ae-b67b-9fb87f3aea58",
                                "text": "Cette chambre n’était pas de celles que harcèlent le houssoir, la tête de loup et le balai."
                            },
                            {
                                "example_id": "762a3d73-a069-4d09-8b03-b58992fc1705",
                                "sense_id": "50e60419-b855-32ae-b67b-9fb87f3aea58",
                                "text": "Des branchages de houx énergiquement manipulés constituaient des houssoirs pour balayer, épousseter habits et tapis ou ramoner les cheminées."
                            }
                        ]
                    }
