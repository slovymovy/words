                "senses": [
                    {
                        "sense_id": "f2a5ee95-dfc2-3e79-9c15-fe510cbd2302",
                        "entry_id": "e7cc5f84-c010-3382-8e2e-0d961e8971c0",
                        "glosses": [
                            "a homemade face mask (as opposed to a medicinal, certified mask), usually from cloth"
                        ],
                        "tags": [
                            "feminine"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "a30f12a2-c91c-34f6-9d03-9d6f6f7eeeae",
                        "entry_id": "e7cc5f84-c010-3382-8e2e-0d961e8971c0",
                        "glosses": [
                            "a figurative mask behind which wearers hide their true self"
                        ],
                        "tags": [
                            "feminine",
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "2386635b-ca19-4f0e-9f3b-3dc598a934c4",
                                "sense_id": "a30f12a2-c91c-34f6-9d03-9d6f6f7eeeae",
                                "text": "Wir dürfen unsere Alltagsmaske fallen lassen und uns in unseren vielfältigen und manchmal auch ambivalenten Facetten zeigen. Vor allem aber müssen wir unsere Gefühle nicht ständig filtern oder kontrollieren wie beispielsweise in unserem beruflichen Alltag.",
                                "translation": "We are allowed to drop our everyday mask and show ourselves in our diverse and sometimes ambivalent facets. Above all, however, we do not have to constantly filter or control our feelings as we do in our everyday professional lives, for example.",
                                "english": "We are allowed to drop our everyday mask and show ourselves in our diverse and sometimes ambivalent facets. Above all, however, we do not have to constantly filter or control our feelings as we do in our everyday professional lives, for example."
                            }
                        ]
                    }
                ],
