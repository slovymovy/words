                        "examples": [
                            {
                                "example_id": "3fb61996-1fef-44e0-a5d4-021145016425",
                                "sense_id": "56d78cdf-9957-3a0a-9955-068c78c526f1",
                                "text": "ещё не изжи́тый",
                                "translation": "still persisting; persistent",
                                "english": "still persisting; persistent"
                            },
                            {
                                "example_id": "7a4ceac5-8d72-493d-b8d7-51d7777e552e",
                                "sense_id": "56d78cdf-9957-3a0a-9955-068c78c526f1",
                                "text": "изжи́ть име́ющиеся недоста́тки",
                                "translation": "to correct/overcome the existing shortcomings",
                                "english": "to correct/overcome the existing shortcomings"
                            },
                            {
                                "example_id": "9b472fb2-52c1-430d-a763-8fe68ff01126",
                                "sense_id": "56d78cdf-9957-3a0a-9955-068c78c526f1",
                                "text": "изжи́ть себя́",
                                "translation": "to be outdated; become obsolete; outlive one's usefulness",
                                "english": "to be outdated; become obsolete; outlive one's usefulness"
                            },
                            {
                                "example_id": "2108003c-ccfa-431f-b1e0-443b17600a87",
                                "sense_id": "56d78cdf-9957-3a0a-9955-068c78c526f1",
                                "text": "изжи́ть волоки́ту",
                                "translation": "to remove red tape",
                                "english": "to remove red tape"
                            }
                        ]
                    }
