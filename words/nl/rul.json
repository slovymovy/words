                        "oneffen",
                        "ruw"
                    ],
                    "antonyms": [
                        "glad",
                        "vlak"
                    ],
                    "common_phrases": [
                        "rul oppervlak"
                    ],
                    "target_lang_definitions": {
                        "en": "having an uneven, rough, or bumpy surface",
                        "ru": "с неровной, шероховатой или бугристой поверхностью"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "rough",
                                "target_lang_sense_clarification": "not smooth, uneven to the touch"
                            },
