                "senses": [
                    {
                        "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                        "entry_id": "07ed42d6-9726-3681-a8c2-383226bc01b2",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "02126fe4-af9d-4484-8ba5-07c5faf6776f",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Frau Croon ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "bd5753cc-fd8a-40ef-884a-baca1ca7f972",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Herr Croon wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "563d90bb-29e9-4ad3-8fed-4faee390f461",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Die Croons kommen heute von der Nordseeküste."
                            },
                            {
                                "example_id": "3928e0b9-ae60-4108-b9c2-2959f688d656",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Der Croon trägt nie die Schals, die die Croon ihm strickt."
                            },
                            {
                                "example_id": "5df82ef4-ca91-4503-b7e6-527f4b45d2f9",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Croon kommt, geht der Herr Croon.“"
                            },
                            {
                                "example_id": "eaea866c-949e-41bb-95b3-b8461b944c95",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Croon kommt und geht."
                            },
                            {
                                "example_id": "ded108c3-0bec-47ec-945f-51b16a24f2af",
                                "sense_id": "9e338db8-7c1d-3e34-95a9-ed169eb56fe2",
                                "text": "Croons kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
