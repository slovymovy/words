                    {
                        "translation_id": "b1b188e6-7243-49ba-b40d-e6eeaa263ada",
                        "source_entry_id": "389250de-4771-341b-9711-28eefaed726e",
                        "source_sense_id": "3cd76c7d-3b18-3c66-94dc-54bb4b1d738a",
                        "target_lang_word": "семёрка",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "семёрка",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "bcb73098-585c-3094-92bb-603da84db569",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "цифра семь"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0b190c30-c7ec-4e0c-80c6-f9030a07fda8",
                                                "sense_id": "bcb73098-585c-3094-92bb-603da84db569",
                                                "text": "Я поблагодарила приветливую тётку, прошла в конец коридора и толкнула дверь, украшенную единичкой и семёркой."
                                            },
                                            {
                                                "example_id": "422628c1-e316-47f3-84ef-fa4a7ac943c2",
                                                "sense_id": "bcb73098-585c-3094-92bb-603da84db569",
                                                "text": "Буквы они не запомнили, только цифры ― три семёрки."
                                            },
                                            {
                                                "example_id": "77533b0b-a486-441e-a5b6-d5cfacc8ad2f",
                                                "sense_id": "bcb73098-585c-3094-92bb-603da84db569",
                                                "text": "Возможно, что он семёрку написал как четвёрку."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b23744cf-db1f-343c-a763-c9f500a2611d",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "разг. группа из семи любых единиц, объектов, человек"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7b2873dd-2b6a-4028-ae41-525fb4502735",
                                                "sense_id": "b23744cf-db1f-343c-a763-c9f500a2611d",
                                                "text": "Первая семёрка самых цитируемых в сети изданий с июля не изменилась."
                                            },
                                            {
                                                "example_id": "290929e0-f948-4267-8586-982542de316f",
                                                "sense_id": "b23744cf-db1f-343c-a763-c9f500a2611d",
                                                "text": "Первую семёрку американских астронавтов связывали узы дружбы."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d47f5b3f-f8a5-38e9-a1ec-087de14a5e27",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "разг. название чего-либо, обозначенного цифрой 7"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9cde81f3-44d7-4ff6-82aa-1ae86075ba6b",
                                                "sense_id": "d47f5b3f-f8a5-38e9-a1ec-087de14a5e27",
                                                "text": "Пожалуй, главная фишка «семёрки» — двойная камера, которой, правда, наделили лишь Plus-версию смартфона."
                                            },
                                            {
                                                "example_id": "da09a06f-cf52-4bcb-b5e9-eb89ee6e417d",
                                                "sense_id": "d47f5b3f-f8a5-38e9-a1ec-087de14a5e27",
                                                "text": "Первая в мире межконтинентальная ракета с ядерным боезарядом, знаменитая «семёрка» (Р-7), стала в то же время первой в мире космической ракетой, доставившей на околоземную орбиту и первый искусственный спутник Земли, и корабль с первым космонавтом ― Юрием Гагариным."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0eabf369-1d9d-3eb2-afe4-a135fa167412",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "разг. транспортное средство (автобус, трамвай, троллейбус и т. п.), идущее по маршруту номер 7"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "639171d9-0843-4248-9feb-dfa3e66a0244",
                                                "sense_id": "0eabf369-1d9d-3eb2-afe4-a135fa167412",
                                                "text": "Вчера я проехался на «семёрке», одном из самых протяжённых городских маршрутов, чтобы лично посмотреть, каково общественному транспорту работать в такой гололёд."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9b9e49c-ec77-326b-a8d2-4c2697d21f81",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "автомоб. жарг. автомобиль ВАЗ-2107 или BMW 7-й серии"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "67dae54a-2050-4546-ad76-91e43c9d83b0",
                                                "sense_id": "c9b9e49c-ec77-326b-a8d2-4c2697d21f81",
                                                "text": "Эта же страна одной из первых испытала на своих дорогах BMW 7L ― «семёрку», вытянувшуюся на целую четверть метра."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a2b03268-c40f-318a-8fb3-a6267ae0285c",
                                        "entry_id": "b5a18cb2-3104-3c05-b7cb-cf575cf422e3",
                                        "glosses": [
                                            "карт. название игральной карты достоинством семь очков"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b609add9-32ee-4fb2-b243-adf5bbfdc40e",
                                                "sense_id": "a2b03268-c40f-318a-8fb3-a6267ae0285c",
                                                "text": "Я ударил по банку, хотя у меня была совсем паршивая карта ― семёрка бубей."
                                            },
                                            {
                                                "example_id": "84babbd5-8cc9-431e-94fc-edfbadf12930",
                                                "sense_id": "a2b03268-c40f-318a-8fb3-a6267ae0285c",
                                                "text": "Семёрка, которая была нужна ему, уже лежала вверху, первой картой в колоде."
                                            }
                                        ]
                                    }
                                ]
                            }
