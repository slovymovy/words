                            "pejorative"
                        ],
                        "examples": [
                            {
                                "example_id": "0130983b-1ca3-4869-a72e-83615f4c2021",
                                "sense_id": "bc13d6bd-ad6c-3f82-9578-d3fe1da99515",
                                "text": "Trotz alledem sah man den Parvenü der Presse ein Jahr nachher wieder Arm in Arm mit Sr. Majestät dem Kaiser Napoleon III. in vertraulicher Unterhaltung auf der Terrasse des Tuileriengarteus promeniren.",
                                "translation": "Malgré tout, un an plus tard, on vit le parvenu de la presse se promener à nouveau bras dans les bras avec Sa Majesté l’empereur Napoléon III, en conversation privée sur la terrasse du jardin des Tuileries."
                            }
                        ]
                    }
                ],
