        "fr-extract.jsonl": [
            {
                "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                "word": "dynamisme",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "0be477a1-79ce-4809-93b9-6503f205baaf",
                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                        "tags": [
                            "plural"
                        ],
                        "form": "dynamismes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                        "glosses": [
                            "Doctrine qui attribue le mouvement de la matière à des forces immanentes et non à une action extérieure et mécanique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "641b46c5-9d47-4d78-ba6f-7793a802ef8c",
                                "sense_id": "f6d200a9-524f-3f8d-8ab9-bc0f91cc0f1e",
                                "text": "Le dynamisme de Leibnitz, de Newton, opposé au mécanisme de Descartes."
                            }
                        ]
                    },
                    {
                        "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                        "entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                        "glosses": [
                            "Énergie, élan, entrain, fougue."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d2c27f35-8c35-46c0-90e3-931fe8c60c64",
                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                "text": "Il fait preuve de dynamisme."
                            },
                            {
                                "example_id": "f0ab8aed-4a31-473a-83da-d16310522ccb",
                                "sense_id": "3d7a067f-a4e8-3397-bbc0-e2214d889d9d",
                                "text": "Le dynamisme des petites entreprises n’est pas une fin en soi, mais un élément du secteur des PME qui concourt à la progression globale de la productivité."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "b6a37de4-8e16-4753-a859-e003969f3d80",
                        "source_entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
                        "target_lang_word": "dynamism",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamism",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "40739c18-348d-36a2-8343-9e93a248c761",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Great energy, drive, force, or power; vigour of body, mind or personality; oomph or pizzazz"
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Dynamic reality; active energy; continuous change, progress, or activity."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a1580c5a-ee6c-4c7d-8466-5e570fff21dc",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "The fact that the war is no longer the main issue in the election points to the dynamism of foreign affairs."
                                            },
                                            {
                                                "example_id": "a0c05c7c-65fa-4f21-9d9d-b763c9f59c67",
                                                "sense_id": "f35b4528-8113-352f-85dd-ff4c395f5f1a",
                                                "text": "But, one might ask, how can the temporal event of God in our midst be the same as God's event to himself in his eternity if so absolute a distinction is drawn between the enarrable contents of history and the \"eternal dynamism\" of God's immutability, apatheia, and perfect fullness?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "bcbc57bf-a219-3072-a714-f2c97348f528",
                                        "entry_id": "0cfb4f7f-04b8-3142-ada8-85de9caca332",
                                        "glosses": [
                                            "Any of several philosophical theories that attempt to explain the universe by an immanent force."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d01df099-4fa9-4a1e-bc32-b9aad66b9ca3",
                        "source_entry_id": "4f95bf4f-5f11-32d2-9c40-c15974ad40af",
