{
    "word_family": [
        "deterge",
        "detergence",
        "detergency"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "15dae1b9-acb8-39ce-bff1-ea670bbfdb4a",
                    "sense_definition": "A synthetic substance used for cleaning that is not soap.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "cleaning_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She used a mild <w>detergent</w> to wash the delicate clothes.",
                            "target_lang_translations": {
                                "zh": "她用一种温和的<w>洗涤剂</w>来洗涤娇贵的衣物。"
                            }
                        },
                        {
                            "text": "The store sells many types of liquid <w>detergent</w> for laundry.",
                            "target_lang_translations": {
                                "zh": "这家店出售多种用于洗衣的液体<w>洗涤剂</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "laundry detergent",
                        "liquid detergent"
                    ],
                    "target_lang_definitions": {
                        "zh": "一种用于清洁的合成物质，非肥皂。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "洗涤剂",
                                "target_lang_sense_clarification": "通用的化学清洁剂，常指洗衣液或洗洁精。"
                            },
                            {
                                "target_lang_word": "清洁剂",
                                "target_lang_sense_clarification": "泛指各种用于去除污垢的化学制剂。"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "6922ca22-e380-3a78-bd46-191985ffea43",
                    "sense_definition": "Having the quality of cleaning or removing dirt.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "cleaning_agent",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soap has a <w>detergent</w> effect on the skin.",
                            "target_lang_translations": {
                                "zh": "这种肥皂对皮肤有<w>去污</w>作用。"
                            }
                        },
                        {
                            "text": "Certain plants possess <w>detergent</w> properties used in traditional washing.",
                            "target_lang_translations": {
                                "zh": "某些植物具有可用于传统洗涤的<w>清洁</w>特性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "cleansing"
                    ],
                    "target_lang_definitions": {
                        "zh": "具有清洁或去除污垢特性的。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "有清洁作用的",
                                "target_lang_sense_clarification": "形容某种物质具备去除污垢的功能。"
                            },
                            {
                                "target_lang_word": "去污的",
                                "target_lang_sense_clarification": "指具有清除污垢能力的。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}