                                    {
                                        "sense_id": "876e86ee-ade1-3b02-8828-4358b2c11085",
                                        "entry_id": "25b4f7a2-c774-3a47-8448-f374917d8fd2",
                                        "glosses": [
                                            "Vertretung einer Person durch einen anderen; das Einnehmen der Position von jemandem durch eine andere Person"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "94a18561-9a17-4318-b62f-62ae63d6ac13",
                                                "sense_id": "876e86ee-ade1-3b02-8828-4358b2c11085",
                                                "text": "„Mit ihm arbeiten noch Kollegen mit psychischen Krankheiten oder geistigen Behinderungen, zudem die Marktleiterin, ihre Stellvertretung und eine Einzelhandelskauffrau in dem Markt.“"
                                            },
                                            {
                                                "example_id": "c478b9cd-3483-48d4-a1e7-c6e931186645",
                                                "sense_id": "876e86ee-ade1-3b02-8828-4358b2c11085",
                                                "text": "„Seit 2004 ist auch die Organisation vereinfacht: Kurator der Stiftung ist die Leitung des Berliner Hauses, die Stellvertretung obliegt dem Frankfurter Kollegen.“"
                                            },
                                            {
                                                "example_id": "67212f38-7d57-4044-9644-93fa78ea46bf",
                                                "sense_id": "876e86ee-ade1-3b02-8828-4358b2c11085",
                                                "text": "„Eine Mitarbeiterin, die sich dafür ausgesprochen hatte, auch Frauen in die Auswahlliste für die Stellvertretung einer professoralen Stelle aufzunehmen, wurde nach Angaben der Studenten übel angefeindet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
