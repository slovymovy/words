                ],
                "senses": [
                    {
                        "sense_id": "8ebb64e2-adc3-3c0c-a134-1cb073efaf0a",
                        "entry_id": "130a8005-6853-375f-8d80-afa3509aa30b",
                        "glosses": [
                            "Angehöriger des gleichnamigen, historischen Stammes, das am Unterlauf des Tiber siedelte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9d9153a3-173b-462e-a698-1f21846c215a",
                                "sense_id": "8ebb64e2-adc3-3c0c-a134-1cb073efaf0a",
                                "text": "„Die Römer, die zum Stamm der Latiner gehörten, unterhielten enge Kontakte zu den Etruskern, die in der Toskana und in Campanien siedelten.“"
                            },
                            {
                                "example_id": "367ed1fd-8310-44a8-9723-d1975d888d70",
                                "sense_id": "8ebb64e2-adc3-3c0c-a134-1cb073efaf0a",
                                "text": "„Rom war offenbar schon in dieser Zeit kulturell und politisch eine der größeren Siedlungen in Mittelitalien und speziell in latium, dem Gebiet der Latiner, zu denen auch die Römer gehörten.“"
                            },
                            {
                                "example_id": "43a0a975-3832-42a0-ad67-6e053b4c8153",
                                "sense_id": "8ebb64e2-adc3-3c0c-a134-1cb073efaf0a",
                                "text": "„In der Lombardei siedelten bis zum 5. Jahrhundert v. Chr. Völker verschiedener Abstammung: Räter, den Latinern verwandte Umbrer, ferner Etrusker und Kelten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
