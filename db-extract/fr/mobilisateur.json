                ],
                "senses": [
                    {
                        "sense_id": "4e33530c-e689-350f-9ed4-09f8c2b2a0a4",
                        "entry_id": "842f82ba-2d9b-3ae4-a63e-95332a200103",
                        "glosses": [
                            "Qui mobilise."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c1116bd-fe50-4635-aaaa-d57d8efdb2c4",
                                "sense_id": "4e33530c-e689-350f-9ed4-09f8c2b2a0a4",
                                "text": "L’idéal de liberté, en plus de permettre une contestation de l’existant et le rassemblement de divers combats, aurait aussi pour avantage de tracer une alternative mobilisatrice."
                            },
                            {
                                "example_id": "4b966bee-7a0f-458c-8be3-34f229abc437",
                                "sense_id": "4e33530c-e689-350f-9ed4-09f8c2b2a0a4",
                                "text": "L’unique point d’accord que j’ai avec vous, c’est que le désespoir n’est pas mobilisateur."
                            },
                            {
                                "example_id": "b5c7c23e-ab24-4234-afa0-f8c1c562b26b",
                                "sense_id": "4e33530c-e689-350f-9ed4-09f8c2b2a0a4",
                                "text": "Est-ce que les cibles de ce projet mobilisateur sont assez ambitieuses pour transformer le Québec ? On peut se poser la question, mais l’important à ce stade-ci, c’est la vision. Et à ce titre, c’est réussi."
                            }
                        ]
                    }
                ],
