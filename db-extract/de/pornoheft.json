                "senses": [
                    {
                        "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                        "entry_id": "23ae03cf-2bec-39c1-a482-574cc14b445b",
                        "glosses": [
                            "Heft, das pornografisches Material enthält"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3f053d31-f21c-48e1-b186-d5eadfc6b38c",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Als keine Erde mehr da ist, nehme ich verblichene Pornohefte, unzüchtige Bücher mit geplatzten Rücken, Traci Lords und John Holmes, Kayle Kleevage und Dick Rambone, Vibratoren mit ausgebrannten Batterien, abgewetzte Spielkarten, abgelaufene Kondome, porös und spröde, aber nie benutzt.“"
                            },
                            {
                                "example_id": "0668d3fd-39c5-4d55-8cfd-92598fb1e09c",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Eselsohrige Pornohefte aus der Zeit vor der Korrektur gammelten auf Drahtständern vor sich hin und präsentierten Bilder von sauberen gleischgeschlechtlichen Sexualakten.“"
                            },
                            {
                                "example_id": "87533b9e-e5e3-469f-9180-47113426928f",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Das hier ist kein Pornoheft und all das hat mit ihrem Tod nichts zu tun.“"
                            },
                            {
                                "example_id": "99fab756-0ecb-4e02-80f0-c3f583e6233f",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Nun, entweder hat Godwin ein billiges Schloss benutzt, oder Chika ist wirklich geschickt im Schlösserknacken, denn keine neunzig Sekunden später stehen wir vor dem Inhalt des Koffers. Ein paar Kleidungsstücke, Pornohefte, ein Tütchen Gras, einige DVDs, den Covern nach vom gleichen Genre wie die Magazine.“"
                            },
                            {
                                "example_id": "00d62df3-dfc8-49b0-af6e-40382eac4847",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Ich brachte Geschenke mit, um diese Schuldgefühle zu beschwichtigen: Leckereien in Dosen, die ich von Ladenbesitzern auf meiner Tour abgestaubt hatte, und beschlagnahmte Pornohefte.“"
                            },
                            {
                                "example_id": "3745f0d8-1ddc-439a-9a37-c94b465173e1",
                                "sense_id": "750dc7a2-617e-38ec-b4f3-90ae91fe45d3",
                                "text": "„Früher lasen wir Pornohefte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
