                "senses": [
                    {
                        "sense_id": "cd854baf-6e64-3bd7-bfcd-e3bb1b74a15a",
                        "entry_id": "d40f998f-e333-3965-898e-cbf56d1c00e4",
                        "glosses": [
                            "Vertreter einer Gattung fleischfressender Dinosaurier aus dem späten Jura"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "07079669-c8ad-41f0-8ac8-b514efe865c2",
                                "sense_id": "cd854baf-6e64-3bd7-bfcd-e3bb1b74a15a",
                                "text": "„Torvosaurus war ein kräftig gebauter Theropode und lebte während der späten Jura. Er lief auf zwei mächtigen Beinen, besaß starke, kurze Arme, riesige Daumenklauen und große, scharfe Zähne.“"
                            },
                            {
                                "example_id": "7682d2eb-c507-40ae-9503-556b26f53653",
                                "sense_id": "cd854baf-6e64-3bd7-bfcd-e3bb1b74a15a",
                                "text": "„Torvosaurier lebten vor 150 Mio. Jahren. Fossilien wurden bislang in Portugal und Nordamerika entdeckt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
