                ],
                "senses": [
                    {
                        "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                        "entry_id": "140d9822-7ff1-31ab-984c-28e4b2dd5b40",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "31710230-3526-4b3d-b538-3966a40ffbf5",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Baade kommt und geht."
                            },
                            {
                                "example_id": "1496d854-fd70-4f5f-9b13-60c37005603e",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Baades kamen, sahen und siegten."
                            },
                            {
                                "example_id": "cc6d054d-9d8c-4c6d-8ff2-7a4928262013",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Frau Baade ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "e2d390a9-e6b3-4468-98a5-81d612bb04e1",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Herr Baade wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "c23ba915-8c46-402e-a456-d87d4787ff64",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Die Baades fahren heute in den Spessart."
                            },
                            {
                                "example_id": "c47d4b9c-75d3-46dd-a053-dc4a8e312e1e",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Der Baade trägt nie die Schals, die die Baade ihm strickt."
                            },
                            {
                                "example_id": "2fdc177b-ad0a-43db-ac26-593225ad5c57",
                                "sense_id": "934102b3-ed4a-375e-a6b0-cbde5148983f",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Baade kommt, geht der Herr Baade.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
