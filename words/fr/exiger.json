{
    "word_family": [
        "exigence",
        "exigeant",
        "exigibilité",
        "exigible",
        "inexigible"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "87183c01-8e05-314e-b251-c68896ee60da",
                    "sense_definition": "Demander fermement en vertu d'une autorité, d'un droit ou d'une volonté impérieuse.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "demande",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le client mécontent <w>exige</w> un remboursement immédiat auprès du directeur du magasin."
                        },
                        {
                            "text": "Les manifestants réunis sur la place publique <w>exigent</w> des explications claires de la part du gouvernement."
                        }
                    ],
                    "synonyms": [
                        "réclamer",
                        "sommer",
                        "revendiquer"
                    ],
                    "antonyms": [
                        "céder",
                        "accorder"
                    ],
                    "common_phrases": [
                        "exiger des explications",
                        "exiger le respect",
                        "exiger une réponse"
                    ]
                },
                {
                    "sense_id": "97312ae1-bc73-3eb8-acac-a02397a1c4f2",
                    "sense_definition": "Nécessiter de manière impérieuse ou indispensable ; requérir.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "necessite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réparation de cet instrument ancien <w>exige</w> une attention particulière et une grande patience."
                        },
                        {
                            "text": "Cette situation financière très délicate <w>exigera</w> des décisions rapides et efficaces."
                        }
                    ],
                    "synonyms": [
                        "nécessiter",
                        "requérir"
                    ],
                    "antonyms": [
                        "dispenser"
                    ],
                    "common_phrases": [
                        "exiger du temps",
                        "exiger une attention particulière",
                        "exiger des compétences"
                    ]
                },
                {
                    "sense_id": "e6f3a7d7-d6e5-3831-8153-148796f6f3b8",
                    "sense_definition": "Astreindre à certaines obligations ou certains devoirs, en parlant de principes moraux ou sociaux.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "obligation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La morale commune <w>exige</w> que chacun respecte la parole donnée à ses proches."
                        },
                        {
                            "text": "À cette époque, les convenances <w>exigeaient</w> d'une jeune fille qu'elle ne sorte jamais seule."
                        }
                    ],
                    "synonyms": [
                        "commander",
                        "imposer",
                        "prescrire"
                    ],
                    "antonyms": [
                        "tolérer",
                        "permettre"
                    ],
                    "common_phrases": [
                        "exiger des sacrifices"
                    ]
                }
            ]
        }
    ]
}