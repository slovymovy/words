                "senses": [
                    {
                        "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                        "entry_id": "8a8c2b76-f90d-38e9-a505-7be4bc0b83d9",
                        "glosses": [
                            "eine formale Sprache zur Darstellung (Notation) von Computerprogrammen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cb5c32-8993-4ccc-9853-4baf0616fd9d",
                                "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                                "text": "Programmiersprachen werden verwendet, um Computerprogramme zu schreiben."
                            },
                            {
                                "example_id": "6fca48a0-c085-40a7-9462-8c20086e5758",
                                "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                                "text": "Dieses Programm berechnet die Kreiszahl. Es ist in der Programmiersprache Mathematica geschrieben, die speziell für mathematische Fragen gedacht ist."
                            },
                            {
                                "example_id": "93225c7c-c4c0-428b-8547-660869faec10",
                                "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                                "text": "Auf den ersten Heimcomputern stand den Anwendern oft die Programmiersprache BASIC zur Verfügung."
                            },
                            {
                                "example_id": "c869c686-bb18-4cea-a570-afa8ad0d8120",
                                "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                                "text": "„Das Detaillierungsniveau des Artikels sei an einer Einzelheit demonstriert, die heute den vielen, die sich in einer Programmiersprache auch nur rudimentär auskennen, einen kaum wahrnehmbaren Widerstand leistet, an den sogenannten Sprungbefehlen.“"
                            },
                            {
                                "example_id": "b09d4a4a-230f-4dae-aa0a-cc99bf850287",
                                "sense_id": "a030acd6-fb2d-3f5d-951d-c145d6b51132",
                                "text": "„Eine Rückkehr zum Zustand vor Babel, zur Einheit vor dem Wirrsal, ist immer wieder versucht worden - über die Wissenschaftssprache Latein, eine philosophische Sprache der Logik, die Algorithmen der Programmiersprachen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
