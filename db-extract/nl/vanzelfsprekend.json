                "senses": [
                    {
                        "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                        "entry_id": "e026b994-3c46-35c3-ac67-d77c285ab062",
                        "glosses": [
                            "overduidelijk geldend, zonder verdere uitleg duidelijk"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2954a95c-e992-41bb-ba45-346fc73bef86",
                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                "text": "Creativiteit en flexibiliteit zijn vanzelfsprekende vereisten."
                            },
                            {
                                "example_id": "4cf40967-a6d5-4a87-bf7d-23e5c6f355ec",
                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                "text": "De band tussen school en kerk was vroeger een vanzelfsprekende zaak."
                            },
                            {
                                "example_id": "6cbe1b03-1104-4144-ae2c-15ba9773108b",
                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                "text": "Mijn solidariteit met de Amerikaanse oerbevolking, de índianen', was rotsvast en het is, wat je ook mag denken, geen reconstructie achteraf die is aangepast aan het tegenwoordig vanzelfsprekende standpunt."
                            },
                            {
                                "example_id": "a378ee08-db86-4a7f-b1ee-9f88b9920bd2",
                                "sense_id": "2969c3b0-f19d-3209-a1f7-a08cfa9d658f",
                                "text": "Maar grotere en interessantere stromen werden gegenereerd door het dochterbedrijf Mercurius met zijn lopende effectenbeheer, waarbij de kasstroom werd geproduceerd door korte zaken met snelle winsten en de optiehandel, inclusief die met synthetische opties, terwijl effecten waarvan verwacht werd dat ze een grotere maar langlopendere waardevermeerdering zouden creëren vanzelfsprekend langzamer werkten."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                "word": "vanzelfsprekend",
                "pos": "adv",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "4ac116b3-1ec1-38a5-b526-9396b09f2bf4",
                        "entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                        "glosses": [
                            "iets dat geen verdere uitleg nodig heeft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9e6b1616-7e76-4516-88e1-98e2a79bf225",
                                "sense_id": "4ac116b3-1ec1-38a5-b526-9396b09f2bf4",
                                "text": "Vandaag keek hij vanzelfsprekend niet meer zo tegen de dingen aan. Hij wist dat de oorlog niets anders was dan een reusachtige loterij met levensechte kogels, waarin vier jaar overleven aan het wonderbaarlijke grensde."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebe7a7c7-41f5-3b8c-86fd-954f9e242bb2",
                        "entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                        "glosses": [
                            "automatisch zonder er verder bij na te denken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "57263304-c51a-4a65-ac54-da32597c33a3",
                                "sense_id": "ebe7a7c7-41f5-3b8c-86fd-954f9e242bb2",
                                "text": "En bijna vanzelfsprekend bleef het museum opgraven in Egypte, waar het al sinds 1957 welkom is en onder meer heeft meegeholpen aan de internationale reddingsopgravingen rond de bouw van de Aswandam, en bij Sakkara graven heeft ontdekt van twee belangrijke functionarissen van Toetanchamon, generaal Horemheb en schatbewaarder Maya (en zijn vrouw Merit)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f30a4ebb-76c1-4e7b-8573-1352c9c95ee4",
                        "source_entry_id": "fdec80ed-75f4-3ff2-ab61-59097f5421f5",
                        "source_sense_id": "4ac116b3-1ec1-38a5-b526-9396b09f2bf4",
                        "source_sense_description": "iets dat geen verdere uitleg nodig heeft",
                        "target_lang_word": "obviously",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "obviously",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "In an obvious or clearly apparent manner."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "85a2cb00-0ff5-4d12-a65f-dfcc4ec7ebec",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She was in floods of tears and obviously very upset."
                                            },
                                            {
                                                "example_id": "61370174-7462-4f05-97a9-743a3abcb477",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "She'd obviously not gone to sleep yet: her eyes were bloodshot with sleepiness."
                                            },
                                            {
                                                "example_id": "1039c7ad-6815-4a9f-b377-98f227539248",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "The plane has obviously been delayed."
                                            },
                                            {
                                                "example_id": "2dfc1c3f-39e0-4137-b412-af9e1da3a71b",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "It was a casual sneer, obviously one of a long line. There was hatred behind it, but of a quiet, chronic type, nothing new or unduly virulent, and he was taken aback by the flicker of amazed incredulity that passed over the younger man's ravaged face."
                                            },
                                            {
                                                "example_id": "27eba153-6a8e-4637-94ee-071ae04d77b6",
                                                "sense_id": "96c80741-c542-35b5-8e96-21aed645f096",
                                                "text": "“Temu is gone! What I saw today completely convinced me!” the user wrote. “Local sellers, despite obviously buying some items in advance in a bulk, don’t have all these items I was interested in.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                        "entry_id": "08cb5ae5-c6b0-3e0d-a5cc-e246bcc8c28d",
                                        "glosses": [
                                            "Used as a filler word, or to introduce information even when not obvious."
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "38742759-5d9a-4fa9-825e-818d1b5c53f0",
                                                "sense_id": "cd09882b-dad8-3cf7-9437-ea0b96bf7ba5",
                                                "text": "You weren't to know, but I've spoken to, obviously, Jim about this, and ..."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
