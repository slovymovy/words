                {
                    "sense_id": "aca044d3-8410-32c0-9798-1d755be6484a",
                    "sense_definition": "Niet stilstaan; onrustig en willekeurig bewegen",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "movement_metaphor",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Door de enorme vermoeidheid <w>dansten</w> de letters voor mijn ogen.",
                            "target_lang_translations": {
                                "ru": "Из-за сильной усталости буквы <w>плясали</w> у меня перед глазами.",
                                "en": "Due to enormous fatigue, the letters <w>danced</w> before my eyes.",
                                "pl": "Z powodu ogromnego zmęczenia litery <w>tańczyły</w> mi przed oczami.",
                                "de": "Vor lauter Müdigkeit <w>tanzten</w> die Buchstaben vor meinen Augen.",
                                "fr": "À cause de l'extrême fatigue, les lettres <w>dansaient</w> devant mes yeux.",
                                "it": "A causa dell'enorme stanchezza, le lettere mi <w>ballavano</w> davanti agli occhi.",
                                "cs": "Kvůli obrovské únavě mi písmena <w>tančila</w> před očima.",
                                "tr": "Aşırı yorgunluktan harfler gözlerimin önünde <w>uçuşuyordu</w>.",
                                "es": "Debido al cansancio extremo, las letras <w>bailaban</w> ante mis ojos."
                            }
                        },
                        {
                            "text": "De kleine boot <w>danste</w> op de hoge golven.",
                            "target_lang_translations": {
                                "ru": "Маленькая лодка <w>танцевала</w> на высоких волнах.",
                                "en": "The small boat <w>danced</w> on the high waves.",
                                "pl": "Mała łódka <w>kołysała się</w> na wysokich falach.",
                                "de": "Das kleine Boot <w>tanzte</w> auf den hohen Wellen.",
                                "fr": "Le petit bateau <w>dansait</w> sur les vagues hautes.",
                                "it": "La barchetta <w>danzava</w> sulle alte onde.",
                                "cs": "Malá loďka <w>tančila</w> na vysokých vlnách.",
                                "tr": "Küçük tekne yüksek dalgaların üzerinde <w>dans ediyordu</w>.",
                                "es": "El pequeño barco <w>danzaba</w> sobre las altas olas."
                            }
                        }
                    ],
                    "synonyms": [
                        "bewegen"
                    ],
                    "antonyms": [
                        "stilstaan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Не стоять на месте; двигаться беспокойно и хаотично",
                        "en": "To not stand still; to move restlessly and randomly",
                        "pl": "Nie stać w miejscu; poruszać się niespokojnie i chaotycznie",
                        "de": "Nicht stillstehen; sich unruhig und willkürlich bewegen",
                        "fr": "Ne pas rester immobile ; bouger de manière agitée et aléatoire",
                        "it": "Non stare fermo; muoversi in modo irrequieto e casuale",
                        "cs": "Nestát v klidu; neklidně a chaoticky se pohybovat",
                        "tr": "Hareketsiz durmamak; huzursuz ve rastgele hareket etmek",
                        "es": "No estarse quieto; moverse de forma inquieta y aleatoria"
                    },
