                    "sense_id": "b4f881f4-af12-342f-b4e7-8c13c3b8c5d2",
                    "sense_definition": "Intimement persuadé de la vérité de quelque chose.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "persuade",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle reste tout à fait <w>convaincue</w> de la sincérité de son ami.",
                            "target_lang_translations": {
                                "en": "She remains completely <w>convinced</w> of her friend's sincerity.",
                                "ru": "Она остаётся совершенно <w>убеждённой</w> в искренности своего друга.",
                                "de": "Sie bleibt von der Aufrichtigkeit ihres Freundes völlig <w>überzeugt</w>.",
                                "es": "Ella sigue totalmente <w>convencida</w> de la sinceridad de su amigo.",
                                "zh": "她依然<w>确信</w>朋友是真诚的。"
                            }
                        },
                        {
                            "text": "Je suis <w>convaincu</w> qu'une solution pacifique est encore possible aujourd'hui.",
                            "target_lang_translations": {
                                "en": "I am <w>convinced</w> that a peaceful solution is still possible today.",
                                "ru": "Я <w>убеждён</w>, что мирное решение всё ещё возможно сегодня.",
                                "de": "Ich bin <w>überzeugt</w>, dass eine friedliche Lösung heute noch möglich ist.",
                                "es": "Estoy <w>convencido</w> de que una solución pacífica todavía es posible hoy.",
                                "zh": "我<w>确信</w>，今天和平解决的方案仍然是可能的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "persuadé",
                        "sûr",
                        "certain"
                    ],
                    "antonyms": [
                        "sceptique",
                        "hésitant",
                        "incrédule"
                    ],
                    "common_phrases": [
                        "être convaincu de",
                        "pleinement convaincu",
                        "fermement convaincu"
                    ],
                    "target_lang_definitions": {
                        "en": "Fully certain that something is true.",
                        "ru": "Полностью убеждённый в истинности чего-либо.",
                        "de": "Von der Wahrheit einer Sache fest überzeugt.",
                        "es": "Completamente seguro de que algo es verdad.",
                        "zh": "对某件事的真实性深信不疑。"
