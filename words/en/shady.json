{
    "word_family": [
        "shade",
        "shadiness",
        "shadily",
        "shadeless"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "283c667b-8584-34af-985d-6b0ad27c93b2",
                    "sense_definition": "Protected from direct sunlight, often by trees or buildings, or providing such protection.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to have our picnic in a cool, <w>shady</w> spot under the oak tree.",
                            "target_lang_translations": {
                                "ru": "Мы решили устроить пикник в прохладном <w>тенистом</w> месте под дубом.",
                                "zh": "我们决定在橡树下那个凉爽、<w>有树荫的</w>地方野餐。",
                                "es": "Decidimos hacer nuestro picnic en un lugar fresco y <w>sombreado</w> bajo el roble."
                            }
                        },
                        {
                            "text": "The garden is very <w>shady</w> in the afternoon, making it a perfect place to read.",
                            "target_lang_translations": {
                                "ru": "Днем сад очень <w>тенистый</w>, что делает его идеальным местом для чтения.",
                                "zh": "下午花园里非常<w>阴凉</w>，是读书的绝佳去处。",
                                "es": "El jardín es muy <w>umbrío</w> por la tarde, lo que lo convierte en un lugar perfecto para leer."
                            }
                        }
                    ],
                    "antonyms": [
                        "sunny",
                        "bright"
                    ],
                    "common_phrases": [
                        "shady spot",
                        "shady tree",
                        "shady area",
                        "shady side"
                    ],
                    "target_lang_definitions": {
                        "ru": "Защищенный от прямых солнечных лучей, часто деревьями или зданиями, или создающий такую защиту.",
                        "zh": "指受树木或建筑物遮挡，不受阳光直射，或能提供这种遮挡的。",
                        "es": "Protegido de la luz solar directa, a menudo por árboles o edificios, o que proporciona dicha protección."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "тенистый",
                                "target_lang_sense_clarification": "обильный тенью (о месте, саде, дереве)"
                            },
                            {
                                "target_lang_word": "находящийся в тени",
                                "target_lang_sense_clarification": "расположенный там, где нет солнца"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "有树荫的",
                                "target_lang_sense_clarification": "指有树木遮挡阳光的地方"
                            },
                            {
                                "target_lang_word": "阴凉的",
                                "target_lang_sense_clarification": "指避开阳光、凉爽的地方"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sombreado",
                                "target_lang_sense_clarification": "que tiene sombra o está cubierto de ella"
                            },
                            {
                                "target_lang_word": "umbrío",
                                "target_lang_sense_clarification": "lugar donde da poca luz solar"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "3bc957a5-4bd5-3047-ba40-34ea4d60ab65",
                    "sense_definition": "Seeming dishonest, illegal, or untrustworthy.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He refused to sign the contract because it looked like a <w>shady</w> deal.",
                            "target_lang_translations": {
                                "ru": "Он отказался подписывать контракт, так как это выглядело как <w>сомнительная</w> сделка.",
                                "zh": "他拒绝签署这份合同，因为它看起来是一笔<w>不正当的</w>交易。",
                                "es": "Se negó a firmar el contrato porque parecía un trato <w>sospechoso</w>."
                            }
                        },
                        {
                            "text": "The police kept an eye on the <w>shady</w> character standing on the street corner.",
                            "target_lang_translations": {
                                "ru": "Полиция следила за <w>подозрительным</w> типом, стоящим на углу улицы.",
                                "zh": "警察一直盯着街角那个<w>可疑的</w>人。",
                                "es": "La policía vigilaba al personaje <w>turbio</w> que estaba en la esquina de la calle."
                            }
                        }
                    ],
                    "synonyms": [
                        "suspicious",
                        "dodgy",
                        "sketchy",
                        "dubious",
                        "corrupt",
                        "seedy"
                    ],
                    "antonyms": [
                        "trustworthy",
                        "honest",
                        "reputable"
                    ],
                    "common_phrases": [
                        "shady character",
                        "shady deal",
                        "shady business",
                        "shady past"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кажущийся нечестным, незаконным или ненадежным.",
                        "zh": "看起来不诚实、非法或不可靠的。",
                        "es": "Que parece deshonesto, ilegal o poco confiable."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "подозрительный",
                                "target_lang_sense_clarification": "вызывающий недоверие или опасения"
                            },
                            {
                                "target_lang_word": "сомнительный",
                                "target_lang_sense_clarification": "ненадежный, внушающий сомнения (о сделке, бизнесе)"
                            },
                            {
                                "target_lang_word": "тёмный",
                                "target_lang_sense_clarification": "разг. связанный с чем-то незаконным или непонятным"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "可疑的",
                                "target_lang_sense_clarification": "指让人怀疑其动机或合法性"
                            },
                            {
                                "target_lang_word": "不正当的",
                                "target_lang_sense_clarification": "指交易或行为不合规"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "sospechoso",
                                "target_lang_sense_clarification": "que da motivos para desconfiar"
                            },
                            {
                                "target_lang_word": "turbio",
                                "target_lang_sense_clarification": "asunto de dudosa moral o legitimidad"
                            },
                            {
                                "target_lang_word": "dudoso",
                                "target_lang_sense_clarification": "que no es confiable o es incierto"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0477df69-255c-310b-bf53-bd82b8ef6191",
                    "sense_definition": "Acting in a mean, cruel, or disrespectful way towards someone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Don't be so <w>shady</w>; just tell her the truth nicely instead of mocking her.",
                            "target_lang_translations": {
                                "ru": "Не будь таким <w>подлым</w>; просто скажи ей правду вежливо, вместо того чтобы насмехаться.",
                                "zh": "别那么<w>阴险</w>；直接礼貌地告诉她真相，别嘲笑她。",
                                "es": "No seas tan <w>deshonesto</w>; simplemente dile la verdad amablemente en lugar de burlarte de ella."
                            }
                        },
                        {
                            "text": "He was being really <w>shady</w> by ignoring her messages while posting online.",
                            "target_lang_translations": {
                                "ru": "Он вёл себя очень <w>мутно</w>, игнорируя её сообщения, но публикуя посты в сети.",
                                "zh": "他一边在网上发帖，一边无视她的消息，行为真的很<w>鬼鬼祟祟</w>。",
                                "es": "Se estaba comportando de forma muy <w>ruin</w> al ignorar sus mensajes mientras publicaba en línea."
                            }
                        }
                    ],
                    "common_phrases": [
                        "acting shady",
                        "being shady"
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "common in modern informal speech"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Ведущий себя подло, неуважительно или скрытно по отношению к кому-либо.",
                        "zh": "指对人表现得卑劣、刻薄或不尊重。",
                        "es": "Que actúa de manera mezquina, cruel o irrespetuosa hacia alguien."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мутный",
                                "target_lang_sense_clarification": "слэнг: непонятный, скрытный, ненадежный в поведении"
                            },
                            {
                                "target_lang_word": "подлый",
                                "target_lang_sense_clarification": "совершающий низкие, злые поступки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阴险的",
                                "target_lang_sense_clarification": "指行为卑劣、暗中使坏"
                            },
                            {
                                "target_lang_word": "鬼鬼祟祟的",
                                "target_lang_sense_clarification": "指行为隐秘且不怀好意"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "deshonesto",
                                "target_lang_sense_clarification": "que actúa con falta de rectitud"
                            },
                            {
                                "target_lang_word": "ruin",
                                "target_lang_sense_clarification": "que es bajo o despreciable en su comportamiento"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "e332b5cf-2f8c-3cf8-85a3-d36228ab401f",
                    "sense_definition": "A surname.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Shady</w> signed the guestbook at the hotel reception.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Шейди</w> расписался в гостевой книге на стойке регистрации отеля.",
                                "zh": "<w>谢迪</w>先生在酒店前台签了访客登记簿。",
                                "es": "El Sr. <w>Shady</w> firmó el libro de visitas en la recepción del hotel."
                            }
                        },
                        {
                            "text": "We looked up the <w>Shady</w> family in the local telephone directory.",
                            "target_lang_translations": {
                                "ru": "Мы искали семью <w>Шейди</w> в местном телефонном справочнике.",
                                "zh": "我们在当地电话簿里查找了<w>谢迪</w>一家。",
                                "es": "Buscamos a la familia <w>Shady</w> en la guía telefónica local."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия.",
                        "zh": "姓氏。",
                        "es": "Un apellido."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Шейди",
                                "target_lang_sense_clarification": "транслитерация имени собственного"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "谢迪",
                                "target_lang_sense_clarification": "姓氏的音译"
                            }
                        ],
                        "es": [
                            {
                                "target_lang_word": "Shady",
                                "target_lang_sense_clarification": "apellido (se mantiene igual al ser nombre propio)"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}