                                "target_senses": [
                                    {
                                        "sense_id": "fc2e4d9c-b1c3-38a1-9629-415a3d35283e",
                                        "entry_id": "33ead78e-def2-3b75-9f09-52c238a2cb40",
                                        "glosses": [
                                            "A grand final."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "051372ea-7b18-4534-8e51-b3187fa5cd9c",
                                                "sense_id": "fc2e4d9c-b1c3-38a1-9629-415a3d35283e",
                                                "text": "On the morning of the 'granny', the three Vizards would hop into Godfrey's Dodge and head off towards the MCG."
                                            },
                                            {
                                                "example_id": "71161b20-9852-4825-86ab-b021f0e23240",
                                                "sense_id": "fc2e4d9c-b1c3-38a1-9629-415a3d35283e",
                                                "text": "Jase was controversially suspended and prevented from playing in the granny."
                                            },
                                            {
                                                "example_id": "386dd21e-7abd-40ac-9d47-831b4f87f956",
                                                "sense_id": "fc2e4d9c-b1c3-38a1-9629-415a3d35283e",
                                                "text": "\"Dad, I got some good news and bad news. Good news is I'll be playing in the granny. Bad news is you'll have to hop on a plane.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
