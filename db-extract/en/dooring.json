                        ]
                    },
                    {
                        "sense_id": "0d589fa7-44e1-3c40-83d5-dc81bb3121e7",
                        "entry_id": "7e61bba0-77c4-341b-ab86-597c67981f47",
                        "glosses": [
                            "The event of a cyclist crashing into a newly opened car door."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ca20baf4-a1f1-4a55-b04c-520b17e1cd69",
                                "sense_id": "0d589fa7-44e1-3c40-83d5-dc81bb3121e7",
                                "text": "In the state of Victoria, Australia, cycle campaigners are trying to raise awareness among drivers, as well as stiffer penalties, about dooring after the death of a cyclist in 2010. Fines for dooring start at $122 (£81)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4817ab7e-63cb-4702-a5ba-a884fe3d6c7d",
                        "source_entry_id": "7e61bba0-77c4-341b-ab86-597c67981f47",
                        "source_sense_description": "event of crashing into opened car door",
                        "target_lang_word": "emportiérage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "emportiérage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b19b4459-10b9-3db3-bf9c-101af83a3523",
                                        "entry_id": "b78b9c7b-7c37-3993-936f-d838fbba44e4",
                                        "glosses": [
                                            "Accident de la route au cours duquel l’usager d’un véhicule ouvre sa portière sans précaution provoquant une collision avec un cycliste, ou plus rarement avec un autre usager de la route."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5decde98-41ab-49b7-8b21-a07f89668db1",
                                                "sense_id": "b19b4459-10b9-3db3-bf9c-101af83a3523",
                                                "text": "Le projet de loi contient par ailleurs des mesures visant la sécurité des cyclistes. Il modifie le Code de la sécurité routière pour hausser les amendes en cas d’emportiérage et précise la distance minimale qu’un conducteur de véhicule routier doit respecter en cas de dépassement d’une bicyclette."
                                            },
                                            {
                                                "example_id": "49052872-445b-4639-89c3-2cfbceecabef",
                                                "sense_id": "b19b4459-10b9-3db3-bf9c-101af83a3523",
                                                "text": "Jamais au grand jamais serrer une file de stationnement de trop près : l’emportiérage est une des principales causes d'accident grave à vélo."
                                            },
                                            {
                                                "example_id": "0abc06e9-2c5a-4829-9148-d4b33711a6e5",
                                                "sense_id": "b19b4459-10b9-3db3-bf9c-101af83a3523",
                                                "text": "Sur une voie cyclable dans l’emprise d’une rue, l’usager circule dans le sens de la circulation, le plus près possible de la bordure de la chaussée, en tenant compte du risque d’emportiérage et de l’état de la chaussée, puis en évitant de se tenir dans l’angle mort d’un véhicule lourd."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
