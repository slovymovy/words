                                    {
                                        "sense_id": "de7086f5-7bbe-3346-9ce0-7aa26238862b",
                                        "entry_id": "7824e60c-8b96-3648-87bd-1154c80339d7",
                                        "glosses": [
                                            "de mate waarin men al te gedienstig is"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9f30f9b7-86f1-40c0-8f7a-329f9243f248",
                                                "sense_id": "de7086f5-7bbe-3346-9ce0-7aa26238862b",
                                                "text": "Ik liet merken dat ik genoeg had van zijn gedienstige kruiperigheid."
                                            },
                                            {
                                                "example_id": "c29e9c18-ea07-4146-871c-d3b795a92739",
                                                "sense_id": "de7086f5-7bbe-3346-9ce0-7aa26238862b",
                                                "text": "Paroollezer Edith Tulp betoogt in deze lezersbrief dat we hoogopgeleide expats ook moeten verplichten Nederlands te leren. ‘Hoelang blijven we volharden in die kruiperigheid tegenover Engelstaligen?’"
                                            }
                                        ]
