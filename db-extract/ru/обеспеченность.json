                "senses": [
                    {
                        "sense_id": "f6438b03-de36-3f5c-a122-9c8de5274281",
                        "entry_id": "b122c67c-cee0-3dfb-ad54-3f0ecbb05395",
                        "glosses": [
                            "свойство или состояние по значению прилагательного обеспеченный; степень обеспечения, снабжения чем-либо"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f00dc1c5-7c8d-4dd1-97c4-c0de87ddccf5",
                                "sense_id": "f6438b03-de36-3f5c-a122-9c8de5274281",
                                "text": "Так, при слабой обеспеченности страны́ средствами и орудиями производства и её общей хозяйственной отсталости будет обязательно (в системе капиталистического хозяйства) импорт капиталов."
                            }
                        ]
                    },
                    {
                        "sense_id": "f636f4bb-7e50-387d-8ea9-257e7655fa19",
                        "entry_id": "b122c67c-cee0-3dfb-ad54-3f0ecbb05395",
                        "glosses": [
                            "материальное благосостояние; достаток"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e5b286b9-ee04-46c4-adac-97e507fa5523",
                                "sense_id": "f636f4bb-7e50-387d-8ea9-257e7655fa19",
                                "text": "Довольство, даже роскошь в настоящем, обеспеченность в будущем — всё избавляло её от мелких, горьких забот, которые сосут сердце и сушат грудь множества бедняков."
                            }
                        ]
                    }
