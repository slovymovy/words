                                    {
                                        "sense_id": "0f18b58d-6ea5-3502-b246-5ee9f8d6f14d",
                                        "entry_id": "d489c09c-5b23-33ec-a120-605006718e0e",
                                        "glosses": [
                                            "Stadtstaat des alten Griechenlands"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e883b245-c049-430b-aa93-cb95bc084717",
                                                "sense_id": "0f18b58d-6ea5-3502-b246-5ee9f8d6f14d",
                                                "text": "Athen war beispielsweise eine Polis."
                                            },
                                            {
                                                "example_id": "36db75e8-b815-4d56-91e8-e49300a13981",
                                                "sense_id": "0f18b58d-6ea5-3502-b246-5ee9f8d6f14d",
                                                "text": "„Ähnlich wie in den meisten griechischen Poleis wurde die Heeresversammlung als Volksversammlung […] nach timokratischen Kriterien (Censuswahlrecht) eingerichtet, was die vermögenden Bürger bevorteilte.“"
                                            },
                                            {
                                                "example_id": "c2e13929-bd5d-4f59-95a6-5bea24c2615d",
                                                "sense_id": "0f18b58d-6ea5-3502-b246-5ee9f8d6f14d",
                                                "text": "„Frauen und Sklaven hatten in der Polis, dem griechischen Stadtstaat, nichts zu melden.“"
                                            },
                                            {
                                                "example_id": "ec5b32f1-37f4-4352-aaf0-dc00c87fb23f",
                                                "sense_id": "0f18b58d-6ea5-3502-b246-5ee9f8d6f14d",
                                                "text": "„Schon die Polis, die für Aristoteles das Idealmaß einer wohlverfassten Gemeinschaft war, wäre zu wenig überschaubar.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
