                "senses": [
                    {
                        "sense_id": "b957f329-859f-3d4c-ae4c-e6ed9bd3201f",
                        "entry_id": "fa16bd78-de67-36d2-8a53-243afc727106",
                        "glosses": [
                            "medizinisches Teilgebiet, das sich mit der gesundheitlichen Versorgung von Mutter und Kind vor und nach Geburt spezialisiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb082893-17cb-487e-8b9b-8e63ea3f8616",
                                "sense_id": "b957f329-859f-3d4c-ae4c-e6ed9bd3201f",
                                "text": "„In den 1970er-Jahren haben dank eines enormen medizinischen und technologischen Fortschritts in der Perinatologie immer mehr frühgeborene Kinder überlebt.“"
                            },
                            {
                                "example_id": "96b85bb2-1750-4eae-b596-6fbce0974e92",
                                "sense_id": "b957f329-859f-3d4c-ae4c-e6ed9bd3201f",
                                "text": "„Teilweise überschneidet sich die Neonatologie mit der Perinatologie, in der es um medizinische Betreuung und Behandlung von Mutter und Kind im Zeitraum »um die Geburt herum« (so die wörtliche Übersetzung von »perinatal«) geht.“"
                            },
                            {
                                "example_id": "dbf63fb3-cce1-4da7-b305-e8de700ca39c",
                                "sense_id": "b957f329-859f-3d4c-ae4c-e6ed9bd3201f",
                                "text": "„Nach ihrer Ankunft in der Perinatologie verschlechtern sich die Dopplerwerte innerhalb kürzester Zeit so rapide, dass eine Sectio durchgeführt wird.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
