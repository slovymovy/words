                                "target_senses": [
                                    {
                                        "sense_id": "86615267-015a-3b9a-9259-cb4b88699b67",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "A character or glyph representing an idea, concept or object."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "07854ee3-3fc0-4a67-b9f5-217fc7115c65",
                                                "sense_id": "86615267-015a-3b9a-9259-cb4b88699b67",
                                                "text": "\"$\" is the symbol for dollars in the US and some other countries."
                                            },
                                            {
                                                "example_id": "ff3e84a6-68d8-4f5c-ab09-3c099ccd46ac",
                                                "sense_id": "86615267-015a-3b9a-9259-cb4b88699b67",
                                                "text": "Chinese people use word symbols for writing."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42c6e91f-c9fd-36c8-81a3-3d1d9fe12a22",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "A thing considered the embodiment or cardinal exemplar of a concept, theme, or other thing."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d5587134-ad7e-48c8-b1ad-d832fc09c649",
                                                "sense_id": "42c6e91f-c9fd-36c8-81a3-3d1d9fe12a22",
                                                "text": "The lion is the symbol of courage; the lamb is the symbol of meekness or patience."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "98f7916d-43eb-38b9-8441-a76ddcc50b40",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "A type of noun whereby the form refers to the same entity independently of the context; a symbol arbitrarily denotes a referent. See also icon and index."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "07b3bdc8-1e32-39ed-82b5-80cd65c583f3",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "A summary of a dogmatic statement of faith."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8e2ca02-aca6-4676-abd8-046172f58ffb",
                                                "sense_id": "07b3bdc8-1e32-39ed-82b5-80cd65c583f3",
                                                "text": "The Apostles, Nicene Creed and the confessional books of Protestantism, such as the Augsburg Confession of Lutheranism are considered symbols."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4a04de9d-32e8-3304-98bb-f7756e7ba48a",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "The numerical expression which defines a plane's position relative to the assumed axes."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9a8c32e-f4ad-3174-b482-7f4f83baaa5a",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "That which is thrown into a common fund; hence, an appointed or accustomed duty."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b2e7bade-fffd-4927-a66c-da3efcae8286",
                                                "sense_id": "f9a8c32e-f4ad-3174-b482-7f4f83baaa5a",
                                                "text": "They do their work in the days of peace […] and come to pay their symbol in a war or in a plague."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72161015-0708-3fac-a770-127b45c00a55",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "Share; allotment."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cf0be120-88a1-4a57-9a33-31fa616ec252",
                                                "sense_id": "72161015-0708-3fac-a770-127b45c00a55",
                                                "text": "The persons who are to be judged […] shall all appear to receive their symbol."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e87bb19e-b3b8-3ba4-85c5-aeb2fcaa992a",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "An internal identifier used by a debugger to relate parts of the compiled program to the corresponding names in the source code."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "214b8b35-c1bd-3cd6-9009-496660ae5672",
                                        "entry_id": "efbd590d-fd9e-34be-88a4-d0ef8504acf5",
                                        "glosses": [
                                            "A signalling event on a communications channel; a signal that cannot be further divided into meaningful information."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "symbol",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1ceb64c4-7957-3f23-810c-26c59422e03e",
                                        "entry_id": "5e1e899b-0679-3f62-bb75-43e6eb6d1b43",
                                        "glosses": [
                                            "To symbolize."
                                        ],
