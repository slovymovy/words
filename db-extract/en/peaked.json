                ],
                "senses": [
                    {
                        "sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                        "entry_id": "f16f43e6-a9c8-3d80-986b-3c4e45c703f1",
                        "glosses": [
                            "Sickly-looking, peaky."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e76e747-4a80-471a-ac09-51e387f18fbb",
                                "sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                                "text": "2001, Fred C. Feddeck, Hale Men of Fordham: Hail!, p. 17,\nWhile Nixon looked peaked throughout the debate, Kennedy looked like a poised diplomat oozing confidence."
                            },
                            {
                                "example_id": "7af6bac6-6f62-46a0-88d9-db2a8169caa3",
                                "sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                                "text": "2004, Don Ecker, Past Sins, p. 276,\nPeck looked peaked to Williams. He was pale and appeared to be breathing in shallow gasps."
                            },
                            {
                                "example_id": "a20ab570-5b2b-452e-8c6d-5356f8ff66ce",
                                "sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                                "text": "2000, Toshio Mori and Lawson Fusao Inada, Unfinished Message: Selected Works of Toshio Mori, p. 149,\nShe looked peaked and tired ever since he had volunteered for the army."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c5f7f082-5bc5-43ee-b76b-d8162233fce3",
                        "source_entry_id": "f16f43e6-a9c8-3d80-986b-3c4e45c703f1",
                        "source_sense_id": "0e8b18c0-33b8-38fd-84c0-fd00f35f7b2b",
                        "source_sense_description": "sickly-looking, peaky",
                        "target_lang_word": "измождённый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "измождённый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "fa2600b5-0c4b-3d0b-9725-3c104cfae456",
                                        "entry_id": "55e77553-a8a4-3ad9-b73e-fe5b791c6325",
                                        "glosses": [
                                            "крайне изнурённый, измученный, усталый или истощённый"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc53edc7-1345-4975-aa5f-4f7ed40f1678",
                                                "sense_id": "fa2600b5-0c4b-3d0b-9725-3c104cfae456",
                                                "text": "Он был только несколько изможден, как бывают измождены много повидавшие и обильно пожившие."
                                            },
                                            {
                                                "example_id": "269cd8c4-6ac4-4fa5-9a50-36f3de6c57c4",
                                                "sense_id": "fa2600b5-0c4b-3d0b-9725-3c104cfae456",
                                                "text": "В изможденных конфликтами странах, где существуют очень слабые возможности контроля, по мнению группы, даже организация регистрации может быть трудна."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d00b7ac0-a20d-3840-86b5-66d8b1e7e070",
                                        "entry_id": "55e77553-a8a4-3ad9-b73e-fe5b791c6325",
                                        "glosses": [
                                            "выражающий крайнюю усталость, измученность"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e90f734c-8f07-4561-926b-d8dd5107c9b0",
                                                "sense_id": "d00b7ac0-a20d-3840-86b5-66d8b1e7e070",
                                                "text": "Лица у людей были изможденные и озлобленные, глаза без блеска, кожа без румянца"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
