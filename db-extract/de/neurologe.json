                        "sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                        "entry_id": "f3823393-d803-3925-bf05-1842bc52a4e0",
                        "glosses": [
                            "ein Facharzt für Nervenheilkunde (Neurologie)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a06657d9-4ded-4e54-8bb6-fe7115f718ed",
                                "sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                                "text": "Jeder Patient mit Verdacht auf einen Schlaganfall wird von einem Neurologen untersucht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "9b563cff-faf9-48a5-9018-0ff1d4d07daf",
                        "source_entry_id": "f3823393-d803-3925-bf05-1842bc52a4e0",
                        "source_sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                        "source_sense_description": "Medizin: ein Facharzt für Nervenheilkunde (Neurologie)",
                        "target_lang_word": "neurologist",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "neurologist",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                        "entry_id": "95a26307-01b4-3538-b8b3-0e7bff6a219c",
                                        "glosses": [
                                            "A doctor or scientist who practices or specializes in neurology."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "40d41657-ae7d-489d-9348-d1c4c9ebfd8d",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "When a neurologist ruled out medical causes like Lyme disease, Ms. Abaspour recalled, her husband said, “I think we should just give her a placebo — it’s all in her head.”"
                                            },
                                            {
                                                "example_id": "5cf1fd9f-e1d5-4bcc-b3c8-f860c8014f68",
                                                "sense_id": "702938e6-9bb2-38a4-b5d7-7f454e316d1d",
                                                "text": "And most neurologists are in the habit of prescribing antispasticity drugs like tizanidine and baclofen, which are oral and inexpensive, but which cause drowsiness and weaken every muscle in the body, not just the target ones."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d1b9d6ab-b385-4c9e-808e-021a913d3a14",
                        "source_entry_id": "f3823393-d803-3925-bf05-1842bc52a4e0",
                        "source_sense_id": "fb2913f1-83ea-3b60-93c0-29571b50fbb1",
                        "source_sense_description": "Medizin: ein Facharzt für Nervenheilkunde (Neurologie)",
