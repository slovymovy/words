                "senses": [
                    {
                        "sense_id": "fbd5a297-f862-3d35-928b-d67391dcea30",
                        "entry_id": "10e1f00d-761c-39ea-9c5c-9ebda5ecd9a8",
                        "glosses": [
                            "Ort, an dem Busse (normalerweise als öffentliches Verkehrsmittel) halten, damit Passagiere ein- und aussteigen können"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "30a2744f-c986-4894-9d17-a690a7d25696",
                                "sense_id": "fbd5a297-f862-3d35-928b-d67391dcea30",
                                "text": "Ich treffe mich nachher mit den Jungs bei der Bushalte."
                            },
                            {
                                "example_id": "4d47b3c2-0deb-4d68-a900-217ec5980177",
                                "sense_id": "fbd5a297-f862-3d35-928b-d67391dcea30",
                                "text": "„Vor unserem Bauernhof parken so viele Fahrzeuge wie sonst nur zur Donnerstagabendmesse oder früher zu Mittag, als die Frommholzer Kinder noch so klein waren, dass sie vom Bus abgeholt werden mussten und ihre Mütter sich mit den Zweitwagen am Rondell vor der Bushalte trafen auf einen Schwatz.“"
                            },
                            {
                                "example_id": "cd76e25c-b7b1-43a2-8c91-0b0b84119862",
                                "sense_id": "fbd5a297-f862-3d35-928b-d67391dcea30",
                                "text": "„Ich gehe zum Italiener gegenüber von Bäcker Katz, der bei der Bushalte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
