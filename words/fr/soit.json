                    ]
                }
            ]
        },
        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "222ab142-53b1-3ca5-aa02-d2bc26637f38",
                    "sense_definition": "Exprime l'accord, la concession ou la résignation face à une proposition.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Vous préférez annuler la réunion de demain ? <w>Soit</w>, nous la reporterons à lundi."
