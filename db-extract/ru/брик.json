                    {
                        "translation_id": "ab0ebc38-fa22-4ea3-a97e-864ba17de209",
                        "source_entry_id": "a844dc94-d9c1-3841-8bbd-678ad93eb3c7",
                        "source_sense_id": "e0cb4168-be51-3776-b79f-cee5183f35ca",
