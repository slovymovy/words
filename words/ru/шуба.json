                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "nature",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Деревья стоят в белой снежной <w>шубе</w>.",
                            "target_lang_translations": {
                                "en": "The trees are standing in a white <w>blanket</w> of snow."
                            }
                        },
                        {
                            "text": "Земля укрыта толстой <w>шубой</w> из снега.",
                            "target_lang_translations": {
