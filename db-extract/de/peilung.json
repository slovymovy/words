                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "81f1280f-337c-3160-9f8d-fe404d74828f",
                        "entry_id": "f36f2783-5d41-3fa2-9d88-3c5a8f55a7f2",
                        "glosses": [
                            "Bestimmung der Lage oder Richtung von etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dbb6dfb-9a8e-4269-b82f-73f81e9c837e",
                                "sense_id": "81f1280f-337c-3160-9f8d-fe404d74828f",
                                "text": "„Nur seine Peilung veränderte sich gelegentlich: ein bißchen mehr voraus, dann wieder mehr achteraus, wie es garade so kam.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "788bf285-f943-3542-b9b2-1bc69ed5010b",
                        "entry_id": "f36f2783-5d41-3fa2-9d88-3c5a8f55a7f2",
                        "glosses": [
