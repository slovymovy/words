        {
            "pos": "interjection",
            "senses": [
                {
                    "sense_id": "d8bf0af9-fe8b-36d5-a7c2-33a2ff9d720e",
                    "sense_definition": "Восклицание, выражающее догадку, удивление, торжество или злорадство при внезапном понимании или обнаружении чего-либо.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "realization",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Ага</w>! Теперь я знаю, где ты прятал конфеты.",
                            "target_lang_translations": {
                                "en": "<w>Aha</w>! Now I know where you were hiding the candy.",
                                "nl": "<w>Aha</w>! Nu weet ik waar je de snoepjes hebt verstopt.",
                                "pl": "<w>Aha</w>! Teraz już wiem, gdzie chowałeś cukierki.",
                                "de": "<w>Aha</w>! Jetzt weiß ich, wo du die Süßigkeiten versteckt hast.",
                                "fr": "<w>Aha</w> ! Maintenant je sais où tu cachais les bonbons.",
                                "it": "<w>Ah</w>! Ora so dove nascondevi le caramelle.",
                                "cs": "<w>Aha</w>! Teď už vím, kde jsi schovával bonbóny.",
                                "tr": "<w>Aha</w>! Artık şekerleri nereye sakladığını biliyorum.",
                                "es": "<w>¡Ajá</w>! Ahora sé dónde escondías los dulces.",
                                "zh": "<w>啊哈</w>！现在我知道你把糖藏在哪里了。"
                            }
                        },
                        {
                            "text": "<w>Ага</w>, вот почему дверь была открыта!",
                            "target_lang_translations": {
                                "en": "<w>Aha</w>, so that's why the door was open!",
                                "nl": "<w>Aha</w>, dat is dus waarom de deur openstond!",
                                "pl": "<w>Aha</w>, oto dlaczego drzwi były otwarte!",
                                "de": "<w>Aha</w>, deshalb war die Tür offen!",
                                "fr": "<w>Aha</w>, voilà pourquoi la porte était ouverte !",
                                "it": "<w>Ecco</w> perché la porta era aperta!",
                                "cs": "<w>Aha</w>, proto byly dveře otevřené!",
                                "tr": "<w>Aha</w>, kapının neden açık olduğu şimdi belli oldu!",
                                "es": "<w>¡Ajá</w>, por eso la puerta estaba abierta!",
                                "zh": "<w>啊哈</w>，原来门开着是因为这个！"
                            }
                        }
                    ],
                    "synonyms": [
                        "ого",
                        "о",
                        "надо же",
                        "так-так",
                        "вот оно что"
                    ],
                    "common_phrases": [
