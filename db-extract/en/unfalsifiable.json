                        "glosses": [
                            "Not able to be proven false, but not necessarily true."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "601810b6-612d-47c5-8092-66cd131453c6",
                                "sense_id": "a68b4fa5-5372-3045-9e03-bf9d32ef6814",
                                "text": "Popper introduced the so-called ‘demarcation problem’ of identifying what distinguishes pseudoscience from science. Popper's suggestion, as I explain below, is that, unlike real science, pseudoscience is unfalsifiable."
                            },
                            {
                                "example_id": "114b88fe-01f6-45fc-9b09-9307cc559433",
                                "sense_id": "a68b4fa5-5372-3045-9e03-bf9d32ef6814",
                                "text": "Unfalsifiability: The main problem with any particular conspiracy theory is not that it's wrong, but that it's inarguable; not that it's false, but that it is unfalsifiable."
                            }
                        ]
                    }
