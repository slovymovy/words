                                        "glosses": [
                                            "разг. прибор для такой процедуры в виде баллона в форме груши с мягкими резиновыми наконечниками или стеклянной кружки с длинной резиновой трубкой и наконечником"
                                        ],
                                        "tags": [],
                                        "examples": [
