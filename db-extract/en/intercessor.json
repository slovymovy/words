                                    },
                                    {
                                        "sense_id": "24480662-c67b-3c81-b454-622d657051f9",
                                        "entry_id": "1939aadc-ea65-3df3-a6f9-723efd59612d",
                                        "glosses": [
                                            "лингв. промежуточный язык при переводе или межнациональном общении"
                                        ],
