                "senses": [
                    {
                        "sense_id": "649bc3b7-961c-31d8-8364-3d37bf126d4d",
                        "entry_id": "26c545a8-4051-3c72-8181-d30e82203957",
                        "glosses": [
                            "Autre orthographe, moins fréquente, de sous-tendre."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c404c0f-5d9c-4773-98af-a75682e9d2de",
                                "sense_id": "649bc3b7-961c-31d8-8364-3d37bf126d4d",
                                "text": "Mais il semble que le conflit qui paraît soustendre et justifier tous les autres est ce vieux conflit d'ordre religieux."
                            },
                            {
                                "example_id": "d3bd2ef3-f62e-46de-8351-38940bb7b429",
                                "sense_id": "649bc3b7-961c-31d8-8364-3d37bf126d4d",
                                "text": "Rien n'est là, en effet, pour soustendre ou pour supporter le double-mouvement de l'aperception : son fond est son sans-fond."
                            }
                        ]
                    }
