                        "entry_id": "1b777e0d-e075-3e2f-a286-77bf43b591ed",
                        "glosses": [
                            "Didelphis Linnaeus, ogoniasty ssak ze spiczastym pyskiem i krótkimi kończynami, z podrodziny dydelfów, występujący w Ameryce"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1d63ee85-09dc-42b5-88b6-09ac1f29edee",
                                "sense_id": "71779631-24db-35d6-b910-698083970006",
                                "text": "Z błyskawiczną szybkością i niesłychaną zręcznością przeskakiwały z łodygi na łodygę malutkie dydelfy, a w dole śród zwojów korzeni krzątały się drobne gatunki błotnych myszek"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
