                "senses": [
                    {
                        "sense_id": "936441d1-1261-348f-9891-0ae610ec975e",
                        "entry_id": "0cee5eb9-2d6b-36fd-8c7e-cd3f09063e96",
                        "glosses": [
                            "связанный, соотносящийся по значению с существительным электролиз"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "dab8b5ea-e4d0-4a45-b01f-fdbd3775dea4",
                                "sense_id": "936441d1-1261-348f-9891-0ae610ec975e",
                                "text": "Тантал преимущественно используется в виде порошка, из которого формуются аноды танталовых электролитических конденсаторов (ТЭК) ― важнейших компонентов интегральных схем микроэлектроники."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cce41335-50f8-46a8-8343-fe0150407ea0",
                        "source_entry_id": "0cee5eb9-2d6b-36fd-8c7e-cd3f09063e96",
                        "source_sense_id": "936441d1-1261-348f-9891-0ae610ec975e",
                        "target_lang_word": "elettrolitico",
                        "target_lang_code": "it",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "elettrolitico",
                                "target_lang_code": "it",
                                "target_senses": [
                                    {
                                        "sense_id": "8016efc1-621d-33d1-9152-0b3dcf1e25db",
                                        "entry_id": "6ba81193-7d4b-39f2-bda8-ee76fceeb8e4",
