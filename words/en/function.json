{
    "word_family": [
        "functional",
        "functionality",
        "functionary",
        "functionalism",
        "functionalist",
        "dysfunction",
        "malfunction"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "2031c507-13ac-3dff-8714-79af3747a53a",
                    "sense_definition": "The purpose that something has, or the job that someone or something does.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The main <w>function</w> of the heart is to pump blood throughout the body.",
                            "target_lang_translations": {
                                "ru": "Основная <w>функция</w> сердца — перекачивать кровь по всему телу."
                            }
                        },
                        {
                            "text": "Each button on the remote control has a specific <w>function</w> to perform.",
                            "target_lang_translations": {
                                "ru": "Каждая кнопка на пульте дистанционного управления выполняет определенную <w>функцию</w>."
                            }
                        }
                    ],
                    "synonyms": [
                        "purpose",
                        "role",
                        "use",
                        "aim"
                    ],
                    "common_phrases": [
                        "primary function",
                        "specific function",
                        "perform a function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Цель, которую имеет предмет, или работа, которую выполняет человек или вещь."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "назначение или роль"
                            },
                            {
                                "target_lang_word": "назначе́ние",
                                "target_lang_sense_clarification": "цель использования"
                            },
                            {
                                "target_lang_word": "роль",
                                "target_lang_sense_clarification": "задача в системе"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "be5c7bed-c95c-3e02-b58f-8c8909a57190",
                    "sense_definition": "A large formal party or social event.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hotel is hosting a private <w>function</w> for the local business community tonight.",
                            "target_lang_translations": {
                                "ru": "Сегодня вечером отель проводит частное <w>мероприятие</w> для местного бизнес-сообщества."
                            }
                        },
                        {
                            "text": "She had to attend a formal <w>function</w> at the embassy last weekend.",
                            "target_lang_translations": {
                                "ru": "В прошлые выходные ей пришлось присутствовать на официальном <w>приёме</w> в посольстве."
                            }
                        }
                    ],
                    "synonyms": [
                        "occasion",
                        "social function",
                        "affair"
                    ],
                    "common_phrases": [
                        "formal function",
                        "social function",
                        "attend a function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большой официальный прием или общественное мероприятие."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "мероприя́тие",
                                "target_lang_sense_clarification": "событие"
                            },
                            {
                                "target_lang_word": "приём",
                                "target_lang_sense_clarification": "официальная встреча"
                            },
                            {
                                "target_lang_word": "торжество́",
                                "target_lang_sense_clarification": "праздничное событие"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ee0dde0-6fa3-38c1-91e9-a99380fd0004",
                    "sense_definition": "A set of instructions in a computer program that performs a specific task.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "computing",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The programmer wrote a new <w>function</w> to calculate the total price of the items.",
                            "target_lang_translations": {
                                "ru": "Программист написал новую <w>функцию</w> для расчета общей стоимости товаров."
                            }
                        },
                        {
                            "text": "This software <w>function</w> allows users to export their data to a spreadsheet.",
                            "target_lang_translations": {
                                "ru": "Эта программная <w>функция</w> позволяет пользователям экспортировать данные в электронную таблицу."
                            }
                        }
                    ],
                    "synonyms": [
                        "procedure",
                        "routine",
                        "subroutine"
                    ],
                    "common_phrases": [
                        "software function",
                        "call a function",
                        "write a function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор инструкций в компьютерной программе, выполняющий определенную задачу."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "в программировании"
                            },
                            {
                                "target_lang_word": "подпрогра́мма",
                                "target_lang_sense_clarification": "часть кода"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a7d8475b-4abf-3b47-b8a6-7580e54c3322",
                    "sense_definition": "A relationship between two sets where each input value corresponds to exactly one output value.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In this equation, y is a <w>function</w> of x, meaning its value depends on x.",
                            "target_lang_translations": {
                                "ru": "В этом уравнении y является <w>функцией</w> x, что означает, что его значение зависит от x."
                            }
                        },
                        {
                            "text": "The teacher explained how to graph a linear <w>function</w> on the coordinate plane.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как построить график линейной <w>функции</w> на координатной плоскости."
                            }
                        }
                    ],
                    "synonyms": [
                        "mapping",
                        "mathematical function",
                        "transformation"
                    ],
                    "common_phrases": [
                        "mathematical function",
                        "linear function",
                        "function of x"
                    ],
                    "target_lang_definitions": {
                        "ru": "Отношение между двумя множествами, где каждому входному значению соответствует ровно одно выходное."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "математическая зависимость"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "83b696ef-c539-3c44-b948-cbb31ad27fac",
                    "sense_definition": "Something that results from or varies according to another factor.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "relation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Success in this industry is often a <w>function</w> of hard work and good timing.",
                            "target_lang_translations": {
                                "ru": "Успех в этой индустрии часто является <w>следствием</w> упорного труда и удачного момента."
                            }
                        },
                        {
                            "text": "The price of the product is a <w>function</w> of supply and demand.",
                            "target_lang_translations": {
                                "ru": "Цена продукта — это <w>функция</w> спроса и предложения."
                            }
                        }
                    ],
                    "common_phrases": [
                        "function of time",
                        "direct function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Нечто, что является результатом другого фактора или меняется в зависимости от него."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "зависимая величина"
                            },
                            {
                                "target_lang_word": "следствие",
                                "target_lang_sense_clarification": "результат чего-либо"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "6529d2b0-bf42-3017-a59b-eff4ed45f5fe",
                    "sense_definition": "A professional or official position or duty.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "purpose",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In his <w>function</w> as chairman, he has the power to veto any new proposals.",
                            "target_lang_translations": {
                                "ru": "В своей <w>должности</w> председателя он имеет право накладывать вето на любые новые предложения."
                            }
                        },
                        {
                            "text": "The committee members were confused about their exact <w>function</w> within the organization.",
                            "target_lang_translations": {
                                "ru": "Члены комитета не совсем понимали свои точные <w>обязанности</w> внутри организации."
                            }
                        }
                    ],
                    "synonyms": [
                        "office",
                        "occupation",
                        "part"
                    ],
                    "common_phrases": [
                        "official function",
                        "executive function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Профессиональная или официальная должность или обязанность."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "фу́нкция",
                                "target_lang_sense_clarification": "служебная обязанность"
                            },
                            {
                                "target_lang_word": "до́лжность",
                                "target_lang_sense_clarification": "официальный пост"
                            },
                            {
                                "target_lang_word": "обя́занность",
                                "target_lang_sense_clarification": "круг деятельности"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "06fc7f3e-c57d-37c0-8377-7727834fc516",
                    "sense_definition": "To work or operate in a proper or particular way.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The machine stopped <w>functioning</w> correctly after the power surge yesterday.",
                            "target_lang_translations": {
                                "ru": "Вчера после скачка напряжения машина перестала правильно <w>функционировать</w>."
                            }
                        },
                        {
                            "text": "Despite the old age of the computer, it still <w>functions</w> well for basic tasks.",
                            "target_lang_translations": {
                                "ru": "Несмотря на преклонный возраст компьютера, он все еще хорошо <w>работает</w> при выполнении базовых задач."
                            }
                        }
                    ],
                    "synonyms": [
                        "work",
                        "operate",
                        "run",
                        "go"
                    ],
                    "antonyms": [
                        "malfunction"
                    ],
                    "common_phrases": [
                        "function properly",
                        "function normally",
                        "cease to function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Работать или действовать надлежащим или определенным образом."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "функциони́ровать",
                                "target_lang_sense_clarification": "действовать исправно"
                            },
                            {
                                "target_lang_word": "рабо́тать",
                                "target_lang_sense_clarification": "быть в действии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "33979803-108e-3619-bf6f-98695b304603",
                    "sense_definition": "To serve a particular purpose or role.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The sofa can also <w>function</w> as a bed when we have guests staying over.",
                            "target_lang_translations": {
                                "ru": "Диван также может <w>служить</w> кроватью, когда у нас остаются гости."
                            }
                        },
                        {
                            "text": "In some cultures, certain stories <w>function</w> as a way to teach moral lessons.",
                            "target_lang_translations": {
                                "ru": "В некоторых культурах определенные истории <w>выполняют роль</w> способа преподать уроки морали."
                            }
                        }
                    ],
                    "synonyms": [
                        "serve",
                        "officiate"
                    ],
                    "common_phrases": [
                        "function as",
                        "effectively function"
                    ],
                    "target_lang_definitions": {
                        "ru": "Служить определенной цели или выполнять определенную роль."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "служить",
                                "target_lang_sense_clarification": "выступать в качестве чего-либо"
                            },
                            {
                                "target_lang_word": "выполнять роль",
                                "target_lang_sense_clarification": "использоваться как"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}