                                        "sense_id": "aafaad5d-f76f-35e8-a049-3912553cddcc",
                                        "entry_id": "e18deca8-b4b7-3cf2-a372-bc517320a740",
                                        "glosses": [
                                            "Former name of Rockwood: an unincorporated community in Imperial County, California, United States."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "3d5538f2-ad1b-3e7a-b1bb-a311e70a152a",
                                        "entry_id": "e18deca8-b4b7-3cf2-a372-bc517320a740",
                                        "glosses": [
                                            "A female given name from the Germanic languages, masculine equivalent Albert."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2178f46-86ad-45fc-9bcd-ec6f3c8039f2",
                                                "sense_id": "3d5538f2-ad1b-3e7a-b1bb-a311e70a152a",
                                                "text": "Alberta is more like a man's name than any other name that comes from a men's, more than Georgianna which is just like a magnolia blossom or Henrietta which most people change to Etta or Geraldine which nobody ever thinks of coming from a man's Irish name like Gerald. Alberta also sounds sort of Canadian, and everything from Canada is masculine the way everything from Mexico is feminine, even the men. In saying it carelessly or reading it you hardly notice the a in the end."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "33f898ef-1947-4953-a2f1-da05879a7eda",
                        "source_entry_id": "21206392-cef4-3ad9-931a-858e5ebb7308",
