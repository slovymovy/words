                                    {
                                        "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A promotion (act of promoting) of a product (such as a book, film or play) or other thing, concept, etc, for example during an interview or a commercial."
                                        ],
                                        "tags": [
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "44cc37de-bb1a-4e79-a954-2459a4609998",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "During the interview, the author put in a plug for his latest novel."
                                            },
                                            {
                                                "example_id": "cf730a4d-972c-4e6a-88af-7cf613d07fea",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "She used her televised tour of the zoo to work in another plug for conservation."
                                            },
                                            {
                                                "example_id": "d1e51af7-b6a4-4cc7-9990-64a12a1e3ab2",
                                                "sense_id": "495ad9ca-3c7b-31ad-b889-3a31fd172623",
                                                "text": "Department store decorations up before Thanksgiving, Christmas cards all over the place, TV full of plugs for fifty-dollar toys that inner-city kids watching can never expect to receive, parents spending what they can't afford and deluging their kids with the annual orgy of materialist values […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
                                            "A body of once molten rock that hardened in a volcanic vent. Usually round or oval in shape."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cfbdee06-38fe-4756-a16b-a1cb060b6ce4",
                                                "sense_id": "1034e567-f240-3a62-ac05-36fce5187869",
                                                "text": "Pressure built beneath the plug in the caldera, eventually resulting in a catastrophic explosion of pyroclastic shrapnel and ash."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5e5d4ecb-6f7c-3f81-9082-1e87ffb6be99",
                                        "entry_id": "295d0da0-97fd-3df6-b5cd-a8242b09bab8",
                                        "glosses": [
