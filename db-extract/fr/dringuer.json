                "senses": [
                    {
                        "sense_id": "99f586a5-5b3c-3516-b3ff-d65547d0f91d",
                        "entry_id": "afec4447-7357-3c99-a4cc-946f61e15198",
                        "glosses": [
                            "Sonner, faire dring."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "22388aae-f5f5-49ee-97e9-8117709b9d9b",
                                "sense_id": "99f586a5-5b3c-3516-b3ff-d65547d0f91d",
                                "text": "Mes petites affaires de cœur, le moment de les reléguer à l'arrière-plan était venu; la gravosse, ayant foncé au téléphone qui dringuait, nous faisait signe de nous tenir l’attention en éveil."
                            },
                            {
                                "example_id": "65de7224-b819-4474-8336-1d03ec1aa039",
                                "sense_id": "99f586a5-5b3c-3516-b3ff-d65547d0f91d",
                                "text": "J'avais pris soin de mettre le réveil à ”dringuer” à 22 heures au cas où je ne me réveillerais pas."
                            },
                            {
                                "example_id": "b5524666-7581-471a-b893-af09019c937c",
                                "sense_id": "99f586a5-5b3c-3516-b3ff-d65547d0f91d",
                                "text": "Je dois t'avouer que moi-même, je me retiens vraiment d'ouvrir mon sac si par hasard le téléphone se met à dringuer!"
                            }
                        ]
                    }
                ],
