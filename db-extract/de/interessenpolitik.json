                        "examples": [
                            {
                                "example_id": "cc508087-1941-4f2f-bbbc-896c5dd6ee38",
                                "sense_id": "595b7fe7-0868-3362-ad4e-0efd55b6e106",
                                "text": "Während wir gerne über Werte diskutieren, prägt zunehmend knallharte Interessenpolitik die Welt.",
                                "translation": "While we like to discuss values, tough interest politics are increasingly shaping the world.",
                                "english": "While we like to discuss values, tough interest politics are increasingly shaping the world."
                            },
                            {
                                "example_id": "215032a3-3c1f-4f5e-a3c0-97287075dace",
                                "sense_id": "595b7fe7-0868-3362-ad4e-0efd55b6e106",
                                "text": "„Bei Preiskontrollen geht es um nackte Interessenpolitik“.",
                                "translation": "\"Price controls are about naked interest politics\".",
                                "english": "\"Price controls are about naked interest politics\"."
                            },
                            {
                                "example_id": "5d7a077f-4d0c-4e58-9aac-53e9f9a334e1",
                                "sense_id": "595b7fe7-0868-3362-ad4e-0efd55b6e106",
                                "text": "Er verweist auf die Not und das Elend, in welche die Kolonien durch die Interessenpolitik der europäischen Mächte gestürzt wurden.",
                                "translation": "He refers to the hardship and misery into which the colonies were thrown by the interests of the European powers.",
                                "english": "He refers to the hardship and misery into which the colonies were thrown by the interests of the European powers."
                            }
                        ]
                    }
