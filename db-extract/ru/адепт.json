                    {
                        "translation_id": "9a08c6e5-2ee7-4c16-ac13-0310536e34ed",
                        "source_entry_id": "7f21a3d9-462b-3468-a3e2-8f079ba6372a",
                        "target_lang_word": "Adept",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Adept",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "78623b1f-fc1a-38e6-adc8-0eb0ed9c5d95",
                                        "entry_id": "1abc9a88-43d6-3b7a-9583-7695e55b8b9f",
                                        "glosses": [
                                            "jemand, der in eine geheime Wissenschaft oder Kunst (wie zum Beispiel Alchemie) eingeweiht ist"
                                        ],
                                        "tags": [
                                            "outdated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ca5f9a7f-2219-4b40-881c-fd867e47cb29",
                                                "sense_id": "78623b1f-fc1a-38e6-adc8-0eb0ed9c5d95",
                                                "text": "Der, in Gesellschaft von Adepten / Sich in die Schwarze Küche schloß"
                                            },
                                            {
                                                "example_id": "8578f834-a30b-4cd4-be8c-77319a0a9c65",
                                                "sense_id": "78623b1f-fc1a-38e6-adc8-0eb0ed9c5d95",
                                                "text": "„Sie hatte von diesem Adepten der Schwarzen Magie gehört.“"
                                            },
                                            {
                                                "example_id": "ebf8e654-8744-457a-83c0-62babc4b1282",
                                                "sense_id": "78623b1f-fc1a-38e6-adc8-0eb0ed9c5d95",
                                                "text": "„Nach diesen Vorbereitungen sollte ich an einem Ort, den ich durch Inspiration von den Genien erfuhr, eine Jungfrau, die Tochter eines Adepten, abholen und sie auf eine Weise, die nur Rosenkreuzern bekannt war, mit einem Knaben schwanger machen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "a7e9bdb5-6678-36c1-a325-74c2cc5d9562",
                                        "entry_id": "1abc9a88-43d6-3b7a-9583-7695e55b8b9f",
                                        "glosses": [
                                            "Schüler, Anhänger einer Wissenschaft"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9175f515-91e0-43f6-9144-62001e340d7f",
                                                "sense_id": "a7e9bdb5-6678-36c1-a325-74c2cc5d9562",
                                                "text": "„Inhaltlich entpuppte der Text sich als medizinische Abhandlung, deren Stil darauf hinweist, dass sie vom griechisch-römischen Arzt Galen oder einem seiner Adepten verfasst wurde.“"
                                            },
                                            {
                                                "example_id": "dac0e4f2-4603-4b2d-96db-97fe9aacb2bc",
                                                "sense_id": "a7e9bdb5-6678-36c1-a325-74c2cc5d9562",
                                                "text": "„Auffallend ist, dass seine einschlägigen Schriften zur Kinder- und Entwicklungspsychologie analytisch klar, in einer wissenschaftlichen Sprache abgefasst und auch nachvollziehbar waren für Leser, die keine Adepten der Ganzheitspsychologie waren.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "4d499cef-cecd-3e8c-9833-663380f24355",
                                        "entry_id": "1abc9a88-43d6-3b7a-9583-7695e55b8b9f",
                                        "glosses": [
                                            "fanatischer, höriger Anhänger einer Anschauung"
                                        ],
                                        "tags": [
                                            "wertend"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b31a53a-e247-42c9-acfd-72533ca34696",
                                                "sense_id": "4d499cef-cecd-3e8c-9833-663380f24355",
                                                "text": "Der harte Kern der Adepten der extremen politischen Rechten macht immer wieder auf sich aufmerksam."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
