                                    {
                                        "sense_id": "7b9d0696-d09e-3272-a00c-6a278f1fea84",
                                        "entry_id": "4d5ceb95-7c99-37be-8986-7c03103e3d9b",
                                        "glosses": [
                                            "Ville et capitale du Rwanda."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0545b390-7870-43e9-8968-4bdd27262dc5",
                                                "sense_id": "7b9d0696-d09e-3272-a00c-6a278f1fea84",
                                                "text": "Réuni à Kigali (Rwanda), le conseil de la Fifa a entériné une décision attendue depuis plusieurs mois."
                                            },
                                            {
                                                "example_id": "04d6d9d7-1e19-4019-933e-05171698b612",
                                                "sense_id": "7b9d0696-d09e-3272-a00c-6a278f1fea84",
                                                "text": "Kigali se résumait à Nyamirambo. Nyamirambo était Kigali."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d3c4e00c-e57f-3afb-b00d-1cde2321b537",
                                        "entry_id": "4d5ceb95-7c99-37be-8986-7c03103e3d9b",
                                        "glosses": [
                                            "Gouvernement rwandais."
                                        ],
                                        "tags": [
                                            "metonymically"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2e5107ff-4035-4b5f-825c-0451abb62aa0",
                                                "sense_id": "d3c4e00c-e57f-3afb-b00d-1cde2321b537",
                                                "text": "Ce sommet qui fait suite aux quadripartites antérieurs, notamment celui du 12 juillet et du 21 août 2019 a, une nouvelle fois, mis un accent particulier sur la réconciliation entre Kampala et Kigali après des mois de tension diplomatique."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
