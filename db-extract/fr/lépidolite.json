                        "entry_id": "010cda77-1dc5-34a0-9fb2-cb3d16cb75d8",
                        "glosses": [
                            "Mica lithinifère, principal minerai du lithium."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8edc2944-22a4-467f-a208-6e825c314c7c",
                                "sense_id": "3da21b01-a93d-3d64-81f5-c54a48682e27",
                                "text": "La présence de rubidium a été établie en 1861 par Robert Wilhelm Bunsen et par Gustav Kirchhoff dans les lignes spectrales de la lépidolite."
                            },
                            {
                                "example_id": "6de65204-dcd6-42bb-abae-1ae240b659fe",
                                "sense_id": "3da21b01-a93d-3d64-81f5-c54a48682e27",
                                "text": "La formule chimique du lépidolite est KLi₂Al(Al,Si)₃O₁₀(F,OH)₂."
                            },
                            {
                                "example_id": "9b6cba37-2159-4e49-a4bc-e6d9372bf811",
                                "sense_id": "3da21b01-a93d-3d64-81f5-c54a48682e27",
                                "text": "La lépidolite est une variété de micas aux propriétés remarquables."
                            }
                        ]
                    }
