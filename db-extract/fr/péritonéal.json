                    {
                        "sense_id": "2d440289-a0d2-3884-885e-b1f8b698ed81",
                        "entry_id": "b115532c-d68d-3475-b9f2-fc1d0ab5f8fe",
                        "glosses": [
                            "Relatif au péritoine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d5fa3ce0-964b-446a-ab4d-d780b7ef7a42",
                                "sense_id": "2d440289-a0d2-3884-885e-b1f8b698ed81",
                                "text": "L'abdomen est très ample, d'aspect batracien. Il n'y a pas d’hernie ombilicale. La cavité péritonéale ne contient aucun épanchement."
                            },
                            {
                                "example_id": "ef0217b7-3c3b-4f21-9d19-e3a3b5da99e7",
                                "sense_id": "2d440289-a0d2-3884-885e-b1f8b698ed81",
                                "text": "En présence d'un envahissement du Douglas plus ou moins étendu à la face antérieure du rectum, une pelvectomie postérieure extra-péritonéale répond aux exigences oncologiques […]."
                            }
                        ]
                    }
