        "fr-extract.jsonl": [
            {
                "entry_id": "3fe02120-7948-30f6-a440-47417b1b07b7",
                "word": "trotte",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "cd5e0d02-bb83-447d-8366-a32d75a2a02f",
                        "entry_id": "3fe02120-7948-30f6-a440-47417b1b07b7",
                        "tags": [
                            "plural"
                        ],
                        "form": "trottes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "0df506e3-09fa-371a-9964-39934f6da13e",
                        "entry_id": "3fe02120-7948-30f6-a440-47417b1b07b7",
                        "glosses": [
                            "Espace de chemin à parcourir."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "0a8111f8-3cc1-42fe-88cd-1202f2d9d40e",
                                "sense_id": "0df506e3-09fa-371a-9964-39934f6da13e",
                                "text": "Le P. Jousse — car on ne lui dit pas mon lieutenant mais “mon Père” — me céda son propre cheval, un grand alezan dans le style de Page, tandis que lui montait un cheval de prise allemand et l’on partit s’apéritiver d’une trotte de 8 kilomètres dans des forêts splendides au crépuscule."
                            },
                            {
                                "example_id": "7d634c3e-5416-4661-8799-15f5067ca53e",
                                "sense_id": "0df506e3-09fa-371a-9964-39934f6da13e",
                                "text": "À la campagne, chez nous, il n’est pas exceptionnel que le facteur, pour s’économiser une trotte, confie le courrier à un gosse."
                            },
                            {
                                "example_id": "62df137c-af63-435c-a23f-5bdaab3b36ad",
                                "sense_id": "0df506e3-09fa-371a-9964-39934f6da13e",
                                "text": "Mais je dois rester, chéri. Hein, dans ce bled? mais t’es folle! tu voulais Vegas pas Triffouilly-les-Oies! Ce contrat tu m’as dit toi-même que c’était juste pour rendre service à ton agent ou à je ne sais plus qui, et que ça te faisait drôlement braire de te farcir cette trotte."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "cb7bea9c-4d7a-4330-804b-892fc09563a8",
                        "source_entry_id": "3fe02120-7948-30f6-a440-47417b1b07b7",
                        "source_sense_id": "0df506e3-09fa-371a-9964-39934f6da13e",
                        "target_lang_word": "country mile",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "country mile",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                        "entry_id": "709a2148-58a8-3c49-bd3c-19012d8f4bca",
                                        "glosses": [
                                            "A long way, a great distance."
                                        ],
                                        "tags": [
                                            "idiomatic",
                                            "informal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "258672ac-c20f-4199-a4d8-a496f0019055",
                                                "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                                "text": "by a country mile"
                                            },
                                            {
                                                "example_id": "c35e0c33-f9f5-481b-9e97-2bdcda1a0e18",
                                                "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                                "text": "’Twas long indeed, a country mile;"
                                            },
                                            {
                                                "example_id": "b695ac8d-4df5-4fc3-a7db-5ae9f24edaf9",
                                                "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                                "text": "I liked to imagine that my father had been a pretty fair country ballplayer who didn't pay attention to his batting average but could hit the ball a country mile and run like the wind."
                                            },
                                            {
                                                "example_id": "7e2091bf-e621-47e1-bdba-5d91afc9efbc",
                                                "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                                "text": "Once I got in gear and took off, I was the only car left! I won by a country mile, Bro!"
                                            },
                                            {
                                                "example_id": "5bd59cf9-70f1-423e-8b1e-43a274aa3997",
                                                "sense_id": "082ffc97-e85e-3c43-b4dd-b5a74a52ad6f",
                                                "text": "But the passengers we spoke to seemed very happy with the trains - and yes, they are an improvement on the Class 170 by a country mile."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
            },
