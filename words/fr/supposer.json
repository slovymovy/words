{
    "word_family": [
        "supposition",
        "supposable",
        "présupposer",
        "présupposition"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "0bed2dc9-46d8-37b9-9f0b-1acd4b1ea390",
                    "sense_definition": "Former une conjecture, présumer ou estimer qu'une chose est vraie ou probable sans en avoir la certitude.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je <w>suppose</w> qu'elle arrivera un peu en retard à cause des embouteillages."
                        },
                        {
                            "text": "Tout le monde <w>supposait</w> que le projet avait été abandonné par la direction."
                        }
                    ],
                    "synonyms": [
                        "présumer",
                        "conjecturer",
                        "penser"
                    ],
                    "common_phrases": [
                        "je suppose que"
                    ]
                },
                {
                    "sense_id": "0154814c-98b7-3a3c-a92c-10ba189c8a5a",
                    "sense_definition": "Admettre une proposition par hypothèse pour en tirer ensuite des déductions ou des conséquences.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "conjecture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "<w>Supposons</w> un instant que nous disposions d'un budget illimité pour cette recherche."
                        },
                        {
                            "text": "Pour résoudre ce problème complexe, il faut d'abord <w>supposer</w> le cas idéal."
                        }
                    ],
                    "synonyms": [
                        "postuler"
                    ],
                    "common_phrases": [
                        "supposons que",
                        "à supposer que"
                    ]
                },
                {
                    "sense_id": "8aff713f-bb7d-3096-b355-bfdd4e969491",
                    "sense_definition": "Avoir pour condition préalable nécessaire ; impliquer ou exiger obligatoirement.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "condition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "La réussite d'un tel projet <w>suppose</w> une entente parfaite entre les membres de l'équipe."
                        },
                        {
                            "text": "Vouloir voyager dans ces contrées isolées <w>suppose</w> une excellente préparation physique."
                        }
                    ],
                    "synonyms": [
                        "impliquer",
                        "nécessiter",
                        "exiger"
                    ]
                },
                {
                    "sense_id": "e8a256c8-2d9e-3cd6-a2d7-5ba5260743b9",
                    "sense_definition": "Substituer frauduleusement ou attribuer de façon fausse pour faire passer le faux pour vrai.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "fraude",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé avait tenté de <w>supposer</w> un testament authentique afin de dépouiller les héritiers légitimes."
                        },
                        {
                            "text": "Dans cette ancienne chronique, on raconte comment ils réussirent à <w>supposer</w> un enfant pour usurper le titre."
                        }
                    ],
                    "synonyms": [
                        "falsifier"
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "terme juridique ancien"
                        }
                    ]
                }
            ]
        }
    ]
}