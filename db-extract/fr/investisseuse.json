                    },
                    {
                        "translation_id": "55efa0e9-6415-4508-9629-92cad6a63482",
                        "source_entry_id": "bb43d4d9-2d2d-3351-8bca-ec92daa88a75",
                        "source_sense_id": "585da884-2201-301b-9914-852f6d20eb3d",
