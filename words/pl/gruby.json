                    "frequency": "Low",
                    "semantic_group_id": "potoczne",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ten deweloper to naprawdę <w>gruba</w> ryba na lokalnym rynku nieruchomości.",
