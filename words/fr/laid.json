            "senses": [
                {
                    "sense_id": "c7a3cbcb-71c3-3fcc-9b53-7e98816d2198",
                    "sense_definition": "Qui manque de beauté physique, dont les traits ou le corps sont disgracieux, en parlant d'un être vivant.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "apparence_physique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le petit garçon pensait qu'il était <w>laid</w> à cause de ses grandes oreilles."
                        },
                        {
                            "text": "Cette bête n'est pas méchante, même si elle semble un peu <w>laide</w> au premier abord."
                        }
                    ],
                    "synonyms": [
                        "moche",
                        "vilain"
                    ],
                    "antonyms": [
                        "beau"
                    ]
                },
                {
                    "sense_id": "afdad7fd-3639-3c40-9a1a-277e7c825fa6",
                    "sense_definition": "Qui est inesthétique, déplaisant à la vue, en parlant d'un objet, d'un lieu ou du temps.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "inesthetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Nous avons visité une ville avec un centre historique charmant mais une banlieue très <w>laide</w>."
                        },
                        {
                            "text": "Ce vieux meuble marron est particulièrement <w>laid</w> dans ce salon moderne."
                        }
                    ],
                    "synonyms": [
                        "moche",
                        "vilain"
                    ],
                    "antonyms": [
                        "beau"
                    ]
                },
                {
                    "sense_id": "26a33a54-152b-3540-897d-72c2365229af",
                    "sense_definition": "Qui est moralement répréhensible, vilain, indigne ou contraire à l'honnêteté.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "moral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Mentir à ses propres amis pour de l'argent est une action vraiment <w>laide</w>."
                        },
                        {
                            "text": "Il a eu un geste <w>laid</w> envers son collègue lors de la réunion."
                        }
                    ],
                    "synonyms": [
                        "vilain"
                    ],
                    "antonyms": [
                        "beau"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "e58c7c6e-0086-3089-afa6-a226ec5d3f59",
                    "sense_definition": "Personne dont l'apparence physique manque de beauté ou de grâce.",
                    "learner_level": "B1",
                    "frequency": "Low",
                    "semantic_group_id": "personne_laide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans ce conte célèbre, la jeune fille finit par aimer le prétendu <w>laid</w> pour sa bonté."
                        },
                        {
                            "text": "Les gens superficiels rejettent souvent les <w>laids</w> sans chercher à connaître leur personnalité."
                        }
                    ],
                    "synonyms": [
                        "moche"
                    ],
                    "antonyms": [
                        "beau"
                    ]
                },
                {
                    "sense_id": "996d89f1-79b4-344e-bcd8-b53320bf8566",
                    "sense_definition": "Ce qui déplaît à la vue ou à l'esprit, considéré comme catégorie esthétique opposée à la beauté.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "concept_esthetique",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe consacre tout un chapitre à la distinction fondamentale entre le beau et le <w>laid</w>."
                        },
                        {
                            "text": "Certains artistes modernes cherchent délibérément à explorer l'esthétique du <w>laid</w>."
                        }
                    ],
                    "antonyms": [
                        "beau"
                    ],
                    "common_phrases": [
                        "le beau et le laid"
                    ]
                }
            ]
        }
    ]
