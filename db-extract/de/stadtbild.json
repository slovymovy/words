                "senses": [
                    {
                        "sense_id": "75227ecb-28e8-39cb-89b2-afc098fadc04",
                        "entry_id": "737d92f9-60d0-3e1b-97f4-aa7c26aaf989",
                        "glosses": [
                            "the appearance of a town or city; townscape, cityscape, but referring more to its appearance as one walks through it, rather than the skyline"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "2a863a18-0a86-418a-b9a9-5ddbabc88666",
                                "sense_id": "75227ecb-28e8-39cb-89b2-afc098fadc04",
                                "text": "Fachwerkhäuser prägen bis heute das Stadtbild.",
                                "translation": "Half-timbered houses dominate the town’s appearance to this day.",
                                "english": "Half-timbered houses dominate the town’s appearance to this day."
                            },
                            {
                                "example_id": "60e219fd-65a9-45a2-b943-a9838faa2bba",
                                "sense_id": "75227ecb-28e8-39cb-89b2-afc098fadc04",
                                "text": "[Friedrich] Merz hatte auf einer Pressekonferenz in Potsdam, wo er vergangene Woche auf Antrittsbesuch bei SPD-Ministerpräsident Dietmar Woidke war, von einem „Problem“ im „Stadtbild“ gesprochen, was Migration betreffe."
                            }
                        ]
                    },
                    {
                        "sense_id": "39222304-0bb4-3dca-a05e-c6917af1d305",
                        "entry_id": "737d92f9-60d0-3e1b-97f4-aa7c26aaf989",
                        "glosses": [
                            "the streets and public areas of a town or city, especially the centre and other areas of interest"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "1d83d4de-d72e-4ae1-bca5-0dff69b50048",
                                "sense_id": "39222304-0bb4-3dca-a05e-c6917af1d305",
                                "text": "Überall im Stadtbild finden sich Hinweise auf die historische Bedeutung des Bergbaus.",
                                "translation": "References to the historical importance of mining are found throughout the city.",
                                "english": "References to the historical importance of mining are found throughout the city."
                            }
                        ]
                    }
                ],
