            {
                "entry_id": "df51cfcf-ce16-3a65-b44e-89a015b6c387",
                "word": "logogriphe",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "627f23df-7daa-4447-a601-893cb082200e",
                        "entry_id": "df51cfcf-ce16-3a65-b44e-89a015b6c387",
                        "tags": [
