{
    "word_family": [
        "infiltrate",
        "infiltrator"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1d7f770a-2f89-3725-bbca-27a2d4b55679",
                    "sense_definition": "The act of secretly entering a physical location or organization to gain information or influence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "security",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The agency discovered a systematic <w>infiltration</w> of the government by foreign agents.",
                            "target_lang_translations": {
                                "zh": "该机构发现外国特工对政府进行了系统的<w>渗透</w>。"
                            }
                        },
                        {
                            "text": "The <w>infiltration</w> of the organization was planned months in advance.",
                            "target_lang_translations": {
                                "zh": "对该组织的<w>渗透</w>行动是提前数月策划的。"
                            }
                        }
                    ],
                    "synonyms": [
                        "penetration",
                        "intrusion"
                    ],
                    "common_phrases": [
                        "systematic infiltration",
                        "prevent infiltration"
                    ],
                    "target_lang_definitions": {
                        "zh": "秘密进入某个物理场所或组织以获取信息或施加影响的行为。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "渗透",
                                "target_lang_sense_clarification": "指秘密进入或潜入组织、机构或区域。"
                            },
                            {
                                "target_lang_word": "潜入",
                                "target_lang_sense_clarification": "指悄悄进入某处，通常带有隐蔽性。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5ff6d465-4a87-3624-a703-5fc475362671",
                    "sense_definition": "The process by which water on the ground surface enters the soil.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "High rates of <w>infiltration</w> help prevent flooding during heavy rain.",
                            "target_lang_translations": {
                                "zh": "高<w>入渗</w>率有助于防止暴雨期间发生洪水。"
                            }
                        },
                        {
                            "text": "The soil type significantly affects the rate of water <w>infiltration</w>.",
                            "target_lang_translations": {
                                "zh": "土壤类型会显著影响水分的<w>入渗</w>速度。"
                            }
                        }
                    ],
                    "synonyms": [
                        "percolation",
                        "seepage"
                    ],
                    "common_phrases": [
                        "water infiltration",
                        "soil infiltration"
                    ],
                    "target_lang_definitions": {
                        "zh": "地表水进入土壤的过程。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "入渗",
                                "target_lang_sense_clarification": "水文学术语，指水分从地表进入土壤内部。"
                            },
                            {
                                "target_lang_word": "渗透",
                                "target_lang_sense_clarification": "指液体通过多孔介质的移动。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a806138c-44d0-330c-b3dd-00fedfdc5e55",
                    "sense_definition": "A substance that has entered the pores or cavities of a body.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "science",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The rock sample contained mineral <w>infiltration</w> within its cracks.",
                            "target_lang_translations": {
                                "zh": "岩石样本的裂缝中含有矿物质<w>浸染</w>。"
                            }
                        },
                        {
                            "text": "Geologists studied the calcareous <w>infiltration</w> filling the cavities.",
                            "target_lang_translations": {
                                "zh": "地质学家研究了填充在空腔中的钙质<w>渗入物</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "deposit",
                        "precipitate"
                    ],
                    "target_lang_definitions": {
                        "zh": "进入物体孔隙或空腔中的物质。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "渗入物",
                                "target_lang_sense_clarification": "指已经渗入并填充在空隙中的物质。"
                            },
                            {
                                "target_lang_word": "浸染",
                                "target_lang_sense_clarification": "指物质渗入并分布在岩石或矿物中。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}