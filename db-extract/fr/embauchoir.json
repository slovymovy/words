                    }
                ],
                "senses": [
                    {
                        "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                        "entry_id": "40baf353-a79c-3dcc-91e1-247800abbff7",
                        "glosses": [
                            "Instrument de bois ou de plastique en forme de pied dont on se sert pour élargir les chaussures ou pour empêcher qu’elles ne se déforment."
                        ],
                        "tags": [
                            "Cordonnerie"
                        ],
                        "examples": [
                            {
                                "example_id": "fb9861b3-5a12-4352-94de-cfd482f2e06b",
                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                "text": "Ah ! Le bel embauchoir !"
                            },
                            {
                                "example_id": "8a73bba3-823a-42d3-91b7-e7e8c145310e",
                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                "text": "Pour conserver à vos chaussures leur aspect neuf, mettez des embauchoirs à l’intérieur quand vous ne les portez pas."
                            },
                            {
                                "example_id": "bd865715-ce2f-4ac2-9161-83d700f2003e",
                                "sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                                "text": "... au sol une exposition de chaussures avec des embauchoirs et des brosses immaculées..."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "76d59f55-7763-46c7-8e2a-f571a64f6305",
                        "source_entry_id": "40baf353-a79c-3dcc-91e1-247800abbff7",
                        "source_sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                        "target_lang_word": "Schuhstrecker",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhstrecker",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "631c239f-fc3a-3d4a-afe0-a47c38dfcf47",
                                        "entry_id": "579185dd-e9da-3e09-94b2-60e0d0a0b453",
                                        "glosses": [
                                            "Gerät, das nach dem Tragen in den Schuh geklemmt wird, damit dieser seine Form behält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e70ddf9-e0b9-496d-851c-8167464310e4",
                                                "sense_id": "631c239f-fc3a-3d4a-afe0-a47c38dfcf47",
                                                "text": "Es gibt maßgefertigte Schuhstrecker, die das Ebenbild des Fußes des Maßschuhträgers sind."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2062074-d8e6-4c22-9403-454f82113fe2",
                        "source_entry_id": "40baf353-a79c-3dcc-91e1-247800abbff7",
                        "source_sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                        "target_lang_word": "Schuhspanner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Schuhspanner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                                        "entry_id": "8857d34a-993b-38cc-9eae-da631f9573f8",
                                        "glosses": [
                                            "Gerät, das nach dem Tragen in den Schuh geklemmt wird, damit dieser seine Form behält"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f10f3519-cf74-4c3a-9d88-9b8d9e1bc933",
                                                "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                                                "text": "„Wenn die Schuhe naß werden, sollte man ihnen sogar 48 Stunden Ruhe gönnen - mit einem hölzernen Schuhspanner ausgeleistet, versteht sich.“"
                                            },
                                            {
                                                "example_id": "4982a87a-a4ff-405f-9e2e-31df039e8a5e",
                                                "sense_id": "c29ab50d-7ffe-30df-9a50-e3d818b11a1a",
                                                "text": "„Ich riß die Tür des Kleiderschranks schnell auf, um dem Spiegel zu entgehen: Nichts mehr von Marie im Schrank, nichts mehr, nicht einmal mehr ein Schuhspanner oder ein Gürtel, wie ihn Frauen manchmal hängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4f1d63b4-9f78-4bce-a912-f9f72c1cd141",
                        "source_entry_id": "40baf353-a79c-3dcc-91e1-247800abbff7",
                        "source_sense_id": "23dd3605-c79b-3299-8248-8918ccf738e9",
                        "target_lang_word": "Spanner",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Spanner",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "28752ebb-4896-33c8-a273-6df206c16129",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "jemand, der heimlich andere Personen beobachtet"
                                        ],
                                        "tags": [
                                            "colloquial"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "354cd30b-1840-4099-9059-083413a3459b",
                                                "sense_id": "28752ebb-4896-33c8-a273-6df206c16129",
                                                "text": "„Am Zaun grienen gottverdammte Spanner, delektieren sich am alstergekühlten Schrumpfgemächt.“"
                                            },
                                            {
                                                "example_id": "011e157b-7ec6-42e6-9de7-f05748928b72",
                                                "sense_id": "28752ebb-4896-33c8-a273-6df206c16129",
                                                "text": "„Die Species der Spanner ist glücklicherweise auch ausgestorben.“"
                                            },
                                            {
                                                "example_id": "1a7b2756-8bdb-4b37-9ce6-b6be3bd4de90",
                                                "sense_id": "28752ebb-4896-33c8-a273-6df206c16129",
                                                "text": "„Ich habe mich schon öfter gefragt, was der Spanner wohl in seinem Koffer trägt.“"
                                            },
                                            {
                                                "example_id": "bb1baa3f-646e-4e8e-a473-23e2b4949621",
                                                "sense_id": "28752ebb-4896-33c8-a273-6df206c16129",
                                                "text": "„Irgendein Spanner vor dem Fenster hätte es wohl nur für eine Pornoszene halten können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "72acea95-dcbf-3f1a-8e21-db7adee76bf9",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "Werkzeug, das dazu dient, Schuhe in ihrer ursprünglichen Form zu halten"
                                        ],
                                        "tags": [
                                            "Mode",
                                            "Haushalt",
                                            "Schuhmacherhandwerk"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b4bb66f6-dca8-42ff-88f1-36adc6ce5dec",
                                                "sense_id": "72acea95-dcbf-3f1a-8e21-db7adee76bf9",
                                                "text": "Mein Vater hielt sehr viel von Spannern für die Schuhe."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "d2d6b083-4c19-38ec-a052-9bf9dc61b7ab",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "Werkzeug, das zum Spannen der Saiten eines Schlägers für Rückschlagsportarten dient (zum Beispiel eines Tennisschlägers)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8bded00e-33fb-4c7e-bd49-47467a3eb8f2",
                                                "sense_id": "d2d6b083-4c19-38ec-a052-9bf9dc61b7ab",
                                                "text": "Neben dem Tennisschläger liegen Spanner, Dosen mit Bällen und Schweißbänder."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "5aff3e8f-0052-319a-be1c-5a8d39168505",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "ein federbelastetes Laufrad, das zur Gangschaltung von Rennrädern im Radsport gehört und für eine konstante Spannung der Kette sorgt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f98bf2af-2b71-4f34-b4bf-cafac4540b90",
                                                "sense_id": "5aff3e8f-0052-319a-be1c-5a8d39168505",
                                                "text": "Man spannt die Feder mit einem einfachen Handgriff am Spanner."
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "c72e0e51-fca2-3fd3-aebc-f00ae7e04a1c",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "Mitglied der Spanner, einer der größten Familien der Schmetterlinge mit circa 26.000 Arten"
                                        ],
                                        "tags": [
                                            "Insektenkunde"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c5c67ca-0363-4f7c-8807-ccb64fdfdd1d",
                                                "sense_id": "c72e0e51-fca2-3fd3-aebc-f00ae7e04a1c",
                                                "text": "Hier ein schwarzgrauer Spanner mit Wellenstreifen über den Flügeln."
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    },
                                    {
                                        "sense_id": "f92c1f27-bfb4-3a22-980e-12dfba7b7895",
                                        "entry_id": "ee1455de-5c43-302d-ae6c-4ba2c120ddcc",
                                        "glosses": [
                                            "Bauteil für Spannaufgaben"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b91d808-9da5-4e88-8997-006ebaf1761c",
                                                "sense_id": "f92c1f27-bfb4-3a22-980e-12dfba7b7895",
                                                "text": "Mit dem Spanner wird das Werkstück fixiert."
                                            }
                                        ],
                                        "sense_index_json": "\"6\""
                                    }
                                ]
                            }
                        ]
