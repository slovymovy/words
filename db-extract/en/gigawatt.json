    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "9982ad6a-5a1c-3100-a04c-fb8c5f294bdb",
                "word": "gigawatt",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "80e304c5-ff18-49d4-895d-99884d4734f9",
                        "entry_id": "9982ad6a-5a1c-3100-a04c-fb8c5f294bdb",
                        "tags": [
                            "plural"
                        ],
                        "form": "gigawatts"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                        "entry_id": "9982ad6a-5a1c-3100-a04c-fb8c5f294bdb",
                        "glosses": [
                            "One thousand million (10⁹) watts, an amount of power large enough to power such things as a midsize town or several small ones. (Consuming 1 gigawatt during a duration of 1 hour consumes 1 gigawatt-hour of energy.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ce2d03a5-262a-42a4-92ff-9560f4c94919",
                                "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                                "text": "Holonyms: TW, terawatt < PW, petawatt"
                            },
                            {
                                "example_id": "eabca9ca-4857-436a-b24d-b5e6506128fb",
                                "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                                "text": "Meronyms: mW, milliwatt < W, watt < kW, kilowatt < MW, megawatt"
                            },
                            {
                                "example_id": "90d151fa-2473-45d7-891f-0fa542e9ff42",
                                "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                                "text": "In the 2020s, the race for AI data centers has Big Tech searching for ways to add multiple gigawatts of additional grid capacity to a regional power grid."
                            },
                            {
                                "example_id": "764eddb2-a29e-4ef5-b6f9-acdec73b0885",
                                "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                                "text": "In a famous movie about time travel, the mad scientist tells the teenage hero that the time machine requires 1.21 gigawatts of power to operate."
                            },
                            {
                                "example_id": "e353cbd2-7ec4-4b74-926a-ba86edf398e6",
                                "sense_id": "7fe141d3-c083-309f-8e91-11a53d6d3fe4",
                                "text": "The European Union's string of record-setting solar power deployment is on track to come to an end this year as demand wanes for rooftop solar panels due to lower wholesale electricity prices. Solar power additions are set to contract 1.4% in the EU, the first annual dip since 2016, according to a report from industry group Solar Power Europe. While new additions are still at historically high levels, it shows the impact on growth of saturated solar power markets where prices regularly dip below zero during the sunniest parts of the year. Overall, the EU is on track to add 64.2 gigawatts of new capacity, according to the industry group. That view contrasts with analysis from BloombergNEF that sees slight growth this year in the bloc."
                            }
                        ]
                    },
                    {
                        "sense_id": "bdc1c1ef-2a74-3e22-9e6b-13f422fe6547",
                        "entry_id": "9982ad6a-5a1c-3100-a04c-fb8c5f294bdb",
                        "glosses": [
                            "The amount of data center capacity or amount of compute that this amount of power can provide under the current technological state of the art (PUE, clock speed, etc)."
                        ],
                        "tags": [
                            "metonymically"
                        ],
                        "examples": [
                            {
                                "example_id": "590e7f30-de35-4d1f-931b-09b7ba420aa3",
                                "sense_id": "bdc1c1ef-2a74-3e22-9e6b-13f422fe6547",
                                "text": "a gigawatt of compute"
                            },
                            {
                                "example_id": "5e7748a2-19db-4d33-a3ce-4217ad584476",
                                "sense_id": "bdc1c1ef-2a74-3e22-9e6b-13f422fe6547",
                                "text": "“We’re gonna need stadiums full of electricians, heavy equipment operators, ironworkers, HVAC technicians,” Dwarkesh Patel and Romeo Dean, AI-industry analysts, wrote recently. Large-scale data-center build-outs may already be reshaping America’s energy systems. OpenAI has announced that it intends to build at least 30 gigawatts’ worth of data centers—more power than all of New England requires on even the hottest day—and CEO Sam Altman has said he’d eventually like to build a gigawatt of AI infrastructure every week. Other major tech firms have similar ambitions."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "414445d9-e325-4d2f-ba5c-3edfb5b08ea4",
                        "source_entry_id": "9982ad6a-5a1c-3100-a04c-fb8c5f294bdb",
                        "source_sense_description": "109 watts",
                        "target_lang_word": "gigawatt",
