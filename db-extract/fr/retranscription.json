                                        "entry_id": "a7c80307-4b5b-3bc1-a74f-822fa6659c49",
                                        "glosses": [
                                            "Something which has been transcribed; a writing or composition consisting of the same words as the original; a written copy."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "0837cd95-769d-3c90-8cd2-d20dc5c84462",
                                        "entry_id": "a7c80307-4b5b-3bc1-a74f-822fa6659c49",
                                        "glosses": [
                                            "A copy of any kind; an imitation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b9be0425-0af9-4037-b79a-0fef88f2bc00",
                                                "sense_id": "0837cd95-769d-3c90-8cd2-d20dc5c84462",
                                                "text": "The Grecian learning was but a transcript of the Chaldean and Egyptian."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "028540ea-7bcc-3931-b931-fb1d6e127136",
                                        "entry_id": "a7c80307-4b5b-3bc1-a74f-822fa6659c49",
                                        "glosses": [
                                            "A written version of what was said orally"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcacf9e-15d6-429e-bf12-7909437a5262",
                                                "sense_id": "028540ea-7bcc-3931-b931-fb1d6e127136",
                                                "text": "the transcript of a trial"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d170577a-7037-308a-b6f2-4d9bc2f68c41",
                                        "entry_id": "a7c80307-4b5b-3bc1-a74f-822fa6659c49",
                                        "glosses": [
                                            "A molecule of RNA produced by transcription."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2f560fda-1210-41d2-9cba-73aeab940971",
                                                "sense_id": "d170577a-7037-308a-b6f2-4d9bc2f68c41",
                                                "text": "Some transcripts were exclusively expressed in specific organs, such as female protarsus, whereas others were universally expressed, this varied expression profile may provide insights into the specific functions mediated by chemoreception proteins in insects."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "92e678ed-31fa-3ef5-b0c9-84a632602765",
                                        "entry_id": "a7c80307-4b5b-3bc1-a74f-822fa6659c49",
                                        "glosses": [
                                            "An official certified record of a student's academic performance throughtout their course of study, including all courses taken and grades received."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "045153da-c41b-4869-a1e3-15dbc07462cd",
                                                "sense_id": "92e678ed-31fa-3ef5-b0c9-84a632602765",
                                                "text": "The grading policy now specifies that all students enrolled before the spring 1982 semester in classes of less than 40 students will receive written evaluations, with either a nonletter grade (honors, pass or no credit) or a letter grade on their transcripts. Under the old system, the no-credit notation did not appear on the transcript."
                                            }
                                        ]
                                    }
                                ]
