                                        "entry_id": "d6c345b1-36fe-3536-bba6-e4e832988db3",
                                        "glosses": [
                                            "A pocket inside of a garment, hence not visible to others."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "41dde4e0-3776-4177-9971-191db28b15c4",
                                                "sense_id": "d95c0b84-9156-356c-87b8-7e58efbea4f6",
                                                "text": "Many men keep their wallet in an inside pocket."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c3124fb6-c5c5-47a5-990d-94ed589164b3",
