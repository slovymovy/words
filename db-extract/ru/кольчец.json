                            {
                                "example_id": "b5e5dcd3-13ec-4896-b2a5-bce729637a5b",
                                "sense_id": "d1e79e5d-475c-3238-9268-022b38e9c7e2",
                                "text": "Некоторые кольчецы микроскопические, но в Австралии обитают гиганты длиной более 2 м."
                            }
                        ]
                    }
