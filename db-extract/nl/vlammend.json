                                                "sense_id": "aaaaa2aa-ce84-3864-af66-3bc79f1e9527",
                                                "text": "burning skin"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "7a607e63-f59a-38f1-9cbd-bd9ecf6df056",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Feeling great passion."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8692ec1d-dad7-4bbb-8960-eecdba4e11ab",
                                                "sense_id": "7a607e63-f59a-38f1-9cbd-bd9ecf6df056",
                                                "text": "her burning heart"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e84b910e-6131-3c0c-9c7c-fce995be9550",
                                        "entry_id": "dca85d66-2b0b-37ad-bdb4-873f518ee6d4",
                                        "glosses": [
                                            "Consuming; intense; inflaming; exciting; vehement; powerful."
                                        ],
                                        "tags": [],
