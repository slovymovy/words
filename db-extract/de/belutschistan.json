                                            {
                                                "example_id": "93187f24-1001-4916-b27b-4df31a6814e8",
                                                "sense_id": "58406aed-2c5b-3b45-bdac-be7f81d30845",
                                                "text": "Les Pachtounes se répartissent entre la province de Khyber Pakhtunkhwa (ancienne Province de la Frontière du Nord-Est), les « Zones tribales », le Baloutchistan et Karachi."
                                            },
                                            {
                                                "example_id": "353e10a2-e2e4-400c-8519-f3eb8154fa7b",
                                                "sense_id": "58406aed-2c5b-3b45-bdac-be7f81d30845",
                                                "text": "Le Baloutchistan est la province la moins peuplée du Pakistan, mais elle est riche en ressources minérales."
                                            }
