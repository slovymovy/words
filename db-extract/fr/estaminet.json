                                    {
                                        "sense_id": "4c76bc42-0817-3215-a750-08b20cbf09fb",
                                        "entry_id": "a8dab4e6-d8c8-3e22-aa44-bc782d89f16d",
                                        "glosses": [
                                            "A public server."
