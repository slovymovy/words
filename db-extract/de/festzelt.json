                        "glosses": [
                            "Grande tente destinée à accueillir les fêtes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "75772ab8-f2f8-4701-a5c7-f297a54bdf0f",
                                "sense_id": "54dff83f-faec-3c1f-8ca6-c499181ebf1e",
                                "text": "Emma und Detlef sind glücklich, wenn sie im Festzelt zu volkstümlicher Musik schunkeln können.",
                                "translation": "Emma et Detlef sont heureux lorsqu'ils peuvent se balancer sous le chapiteau au son de la musique populaire."
                            },
                            {
                                "example_id": "ed2b2bcb-e47f-4fe0-a2a7-fa8ee4030845",
                                "sense_id": "54dff83f-faec-3c1f-8ca6-c499181ebf1e",
                                "text": "Es sollte ein lustiger Sonntag auf der Wiesn werden, die Studentin Luisa T. (Name geändert) und ihr Freund hatten sich mit zwei Bekannten im Augustiner-Festzelt verabredet.",
                                "translation": "Ce devait être un dimanche amusant à l'Oktoberfest, l’étudiante Luisa T. (nom modifié) et son petit ami avaient rendez-vous avec deux connaissances dans le chapiteau Augustiner."
                            }
                        ]
                    }
