                    {
                        "translation_id": "d7c1ffae-b53c-45cf-bce4-ba99910c2b54",
                        "source_entry_id": "618d91e3-0d54-32af-8077-6e93ead7d6e1",
                        "source_sense_id": "5d4a3e6e-e70a-326a-930c-78766686ffb1",
