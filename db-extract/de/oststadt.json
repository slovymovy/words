                        "examples": [
                            {
                                "example_id": "119d6bb2-49a6-4a2e-9d64-c118dfd7d2d4",
                                "sense_id": "36e3afee-fb4d-3c95-a63f-6e1b0591df99",
                                "text": "Das Amt befindet sich in der Oststadt."
                            },
                            {
                                "example_id": "3095d376-f720-43f0-a289-aef453c3adc9",
                                "sense_id": "36e3afee-fb4d-3c95-a63f-6e1b0591df99",
                                "text": "Wenn sie durch die Oststadt kommen, grüßen sie Frau Meyer von mir."
                            },
                            {
                                "example_id": "d2e44bc0-865c-445c-9b3f-91ccc9f1989b",
                                "sense_id": "36e3afee-fb4d-3c95-a63f-6e1b0591df99",
                                "text": "Ihre Kindheit und Jugend verbrachten die Kinder in der Oststadt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
