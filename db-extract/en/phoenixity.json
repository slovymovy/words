                        "glosses": [
                            "The quality of being like a phoenix, especially that of recovering from destruction, or possession of an otherworldly beauty."
                        ],
                        "tags": [
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "1ff2e5de-4381-4716-b742-c53f4823e41e",
                                "sense_id": "993188e7-7781-3ce8-a580-f5da98970411",
                                "text": "The driver is a Chinese woman. Remarkable phoenixity."
                            },
                            {
                                "example_id": "d8a521c7-968d-475e-bbc5-75ce78d8568b",
                                "sense_id": "993188e7-7781-3ce8-a580-f5da98970411",
                                "text": "No church in the Philippines can match the phoenixity of Ermita."
                            },
                            {
                                "example_id": "64d94f2f-0cb0-49cb-a785-a346d07cae99",
                                "sense_id": "993188e7-7781-3ce8-a580-f5da98970411",
                                "text": "But, as the district court observed in piercing the corporate veil, the corporation's \"phoenixity provides Mottolo no haven from liability.\""
                            },
                            {
                                "example_id": "1a7c44f4-9ba4-49c2-bfd6-80b45da0c0cc",
                                "sense_id": "993188e7-7781-3ce8-a580-f5da98970411",
                                "text": "Her best course would be to marry another phoenix; but as she—poor girl!—cannot appreciate even her own phoenixity, much less that of another, she must perforce be content with a mere mortal."
                            }
                        ]
                    }
