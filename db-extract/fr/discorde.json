            {
                "entry_id": "5ed90391-5a36-3aee-a3fe-bf2a5e4b6a23",
                "word": "discorde",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "e91c6f8c-17a7-42fe-91ad-0de717743cc2",
                        "entry_id": "5ed90391-5a36-3aee-a3fe-bf2a5e4b6a23",
                        "tags": [
                            "plural"
                        ],
                        "form": "discordes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                        "entry_id": "5ed90391-5a36-3aee-a3fe-bf2a5e4b6a23",
                        "glosses": [
                            "Dissentiment violent et durable entre deux ou plusieurs personnes qui les porte à l’inimitié, à la haine."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "88fbec37-7e51-415a-ad72-d9745f6da7b8",
                                "sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                                "text": "Or cette fameuse bagarre ne se produisit pas. Une sorte de crapuleux délire empêchait toute discorde."
                            },
                            {
                                "example_id": "fa96aae2-c4d5-40a6-9811-108677280cf2",
                                "sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                                "text": "Les rois norvégiens cessèrent de s'intéresser à la lointaine colonie ; la discorde survint ; des luttes naquirent, soit intestines, soit entre colons et esquimaux."
                            },
                            {
                                "example_id": "2a1326a4-9528-49f7-94b2-7c7abc40baa3",
                                "sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                                "text": "Il s’en irait semer la discorde et la zizanie ailleurs, où il voudrait, pourvu que le pays fût débarrassé de sa personne."
                            },
                            {
                                "example_id": "617bda0a-dd20-4521-9ded-2133b7fe4fa8",
                                "sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                                "text": "En discorde (discordia) avec eux à cause de terres et d'autres biens qu'ils leur avaient injustement enlevés, ils se sont rendus au plaid (placitum) à Laizé en présence du cellérier et du doyen de ce lieu. Là, ils ont abandonné leur injustice (calumpnia)."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "347ebd47-5e5f-47b4-9ffd-b4827cd225ed",
                        "source_entry_id": "5ed90391-5a36-3aee-a3fe-bf2a5e4b6a23",
                        "source_sense_id": "c96cea8f-7fa3-3432-95ef-e0f705c4abd7",
                        "target_lang_word": "Uneinigkeit",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Uneinigkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                        "entry_id": "049d43de-819c-3c32-bc43-f196cfefe573",
                                        "glosses": [
                                            "keine Übereinstimmung in einer bestimmten Frage"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1337a04a-8aa4-49f7-9602-5d8854a8520a",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "Zwischen den Sunniten und den Schiiten herrschten Uneinigkeiten."
                                            },
                                            {
                                                "example_id": "e8e2a783-7e1f-46b2-92a3-3c5b55acd055",
                                                "sense_id": "59d33377-7532-3dca-9a29-bf40ba220191",
                                                "text": "„Der Speiseplan der Neandertaler sorgt schon seit längerem für Uneinigkeit und kontroverse Diskussionen unter Anthropologen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
