                ],
                "senses": [
                    {
                        "sense_id": "a74eaa87-fc15-30b3-93c9-786a7808d351",
                        "entry_id": "5e8746f8-bf26-3406-9952-42d72e575fc0",
                        "glosses": [
                            "Umstand, dass kriegswichtige Informationen aufgrund verschiedener Umstände immer eine gewisse Unsicherheit und Unvollständigkeit aufweisen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0b80cb2f-ca17-4ebb-93a7-1f2a30538b70",
                                "sense_id": "a74eaa87-fc15-30b3-93c9-786a7808d351",
                                "text": "Aufgrund des Kriegsnebels können wir nicht wissen, ob dort Minen versteckt sind."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "493d62ca-7283-31b7-9235-03a7934aa4cb",
                        "entry_id": "5e8746f8-bf26-3406-9952-42d72e575fc0",
                        "glosses": [
                            "unbetretener, unbekannter Bereich in einem Computerspiel"
                        ],
                        "tags": [
                            "Computerspieler-Jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "584b2b46-5c88-4adc-adfa-7651e6cf6229",
                                "sense_id": "493d62ca-7283-31b7-9235-03a7934aa4cb",
                                "text": "Der Kriegsnebel (englisch: Fog of War) verhindert die Einsicht in Orbits und Planeteninformationen (Rohstoffwerte, Einwohner, Besitzer) in Systemen ohne alliierte Schiffe oder Planeten."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "f04994ca-3a24-46e9-8c09-af956bc771d3",
                        "source_entry_id": "5e8746f8-bf26-3406-9952-42d72e575fc0",
                        "source_sense_id": "a74eaa87-fc15-30b3-93c9-786a7808d351",
                        "target_lang_word": "fog of war",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fog of war",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "868452f3-a1b8-3f82-9460-c50c63c5808c",
                                        "entry_id": "396588b7-fcff-319c-8548-68b71934566a",
                                        "glosses": [
                                            "The uncertainty in situational awareness experienced by participants in military operations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a505c66f-518e-4a4e-8704-ea18a8136575",
                                                "sense_id": "868452f3-a1b8-3f82-9460-c50c63c5808c",
                                                "text": "Future reports from any source should be treated with caution. What we can see is not the “fog of war,” in the old-fashioned sense; instead it is a kind of swirling tornado, a maelstrom of claims and counterclaims, memes and countermemes, real battles taking place away from television screens and fake ones happening on camera."
                                            },
                                            {
                                                "example_id": "8029d80b-d7eb-4a6f-88a9-91569196e271",
                                                "sense_id": "868452f3-a1b8-3f82-9460-c50c63c5808c",
                                                "text": "Only now, amid the fog of war, is it possible to ascertain what happened."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "645ff69c-9540-3b95-b99c-f751e9abb553",
                                        "entry_id": "396588b7-fcff-319c-8548-68b71934566a",
                                        "glosses": [
                                            "The shrouded concealment of enemy activity outside of areas observable by a player's forces."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "3a1da48f-1946-4537-b491-bb48731c88d6",
                                                "sense_id": "645ff69c-9540-3b95-b99c-f751e9abb553",
                                                "text": "The game starts with an overhead view of a map with the “fog of war” covering all areas not within sight of the player's units."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
