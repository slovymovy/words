                "senses": [
                    {
                        "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                        "entry_id": "515738d3-f208-3ce0-a7e9-b83c9e58403a",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f6b95bd0-852e-4ebc-90d2-88dcdb2aac35",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Frau Wickramasinghe ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "6f72104c-bad3-483a-b6b8-b5dcff7008ac",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Herr Wickramasinghe wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2f5dfc5f-b1b0-4962-9d3b-c0014ea68204",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Die Wickramasinghes kommen heute aus Rom."
                            },
                            {
                                "example_id": "8053a674-0eb6-4acf-9e5c-869c4710798a",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Der Wickramasinghe trägt nie die Schals, die die Wickramasinghe ihm strickt."
                            },
                            {
                                "example_id": "a34f4388-fbcb-4fe0-a67b-53898de177f7",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Wickramasinghe kommt, geht der Herr Wickramasinghe.“"
                            },
                            {
                                "example_id": "7cc3b20f-7495-4482-887f-8af782a61798",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Wickramasinghe kommt und geht."
                            },
                            {
                                "example_id": "8c19dc09-0eeb-4c9e-bbb8-a932988b9d0e",
                                "sense_id": "0c781f07-12da-39c2-bc79-a9a2cd2faec1",
                                "text": "Wickramasinghes kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
