                                "example_id": "e4e6aced-48dd-4dcf-84af-153db002ef66",
                                "sense_id": "78572a8e-1328-3773-a326-e14975455a83",
                                "text": "„Wir sehen Pflegefälle in Bauernkaten, in denen es nicht einmal fließendes Wasser gibt.“"
                            },
