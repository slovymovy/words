{
    "word_family": [
        "divide",
        "divider",
        "divisive",
        "divisibility",
        "divisible",
        "indivisible",
        "divisional"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "20efb3ad-bc09-3d8a-b093-d226a34625c1",
                    "sense_definition": "The mathematical process of finding how many times one number is contained in another.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "mathematics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The teacher explained how to do long <w>division</w> on the blackboard.",
                            "target_lang_translations": {
                                "ru": "Учитель объяснил, как выполнять <w>деление</w> в столбик на доске.",
                                "zh": "老师在黑板上讲解了如何进行长<w>除法</w>。"
                            }
                        },
                        {
                            "text": "You can solve this problem using simple <w>division</w>.",
                            "target_lang_translations": {
                                "ru": "Ты можешь решить эту задачу, используя простое <w>деление</w>.",
                                "zh": "你可以用简单的<w>除法</w>来解决这个问题。"
                            }
                        }
                    ],
                    "antonyms": [
                        "multiplication"
                    ],
                    "common_phrases": [
                        "long division",
                        "short division",
                        "division sign"
                    ],
                    "target_lang_definitions": {
                        "ru": "Математическое действие, позволяющее узнать, сколько раз одно число содержится в другом.",
                        "zh": "数学运算，用于计算一个数包含多少个另一个数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "деле́ние",
                                "target_lang_sense_clarification": "математическое действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "除法",
                                "target_lang_sense_clarification": "数学运算"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "854cf7f5-b2b7-37f4-b841-e07acd535ad9",
                    "sense_definition": "A large and important unit or section of an organization, company, or government.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "organization_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She was promoted to become the head of the sales <w>division</w>.",
                            "target_lang_translations": {
                                "ru": "Её повысили до начальника <w>отдела</w> продаж.",
                                "zh": "她被提拔为销售<w>部门</w>的负责人。"
                            }
                        },
                        {
                            "text": "The company has opened a new <w>division</w> to handle international accounts.",
                            "target_lang_translations": {
                                "ru": "Компания открыла новое <w>подразделение</w> для работы с международными счетами.",
                                "zh": "公司开设了一个新的<w>分部</w>来处理国际业务。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "sales division",
                        "marketing division",
                        "head of the division"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное структурное подразделение организации, компании или правительства.",
                        "zh": "组织、公司或政府中大型且重要的部门或单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отде́л",
                                "target_lang_sense_clarification": "структурная единица организации"
                            },
                            {
                                "target_lang_word": "подразделе́ние",
                                "target_lang_sense_clarification": "часть организации"
                            },
                            {
                                "target_lang_word": "дивизио́н",
                                "target_lang_sense_clarification": "в крупных корпорациях"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "部门",
                                "target_lang_sense_clarification": "组织机构的组成部分"
                            },
                            {
                                "target_lang_word": "分部",
                                "target_lang_sense_clarification": "大型机构的下属单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8c4ddd1c-7f85-39ce-a120-003c00f8ebe6",
                    "sense_definition": "The act of separating something into parts, groups, or shares.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "act_of_separating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>division</w> of the property among the heirs took several months.",
                            "target_lang_translations": {
                                "ru": "<w>Раздел</w> имущества между наследниками занял несколько месяцев.",
                                "zh": "在继承人之间<w>分割</w>财产花费了几个月的时间。"
                            }
                        },
                        {
                            "text": "We agreed on an equal <w>division</w> of the chores to keep the house clean.",
                            "target_lang_translations": {
                                "ru": "Мы договорились о равном <w>разделении</w> обязанностей, чтобы поддерживать чистоту в доме.",
                                "zh": "我们商定平均<w>分配</w>家务，以保持屋子整洁。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split"
                    ],
                    "antonyms": [
                        "combination",
                        "fusion",
                        "merger",
                        "unification"
                    ],
                    "common_phrases": [
                        "division of labor",
                        "division of power",
                        "fair division"
                    ],
                    "target_lang_definitions": {
                        "ru": "Действие по разделению чего-либо на части, группы или доли.",
                        "zh": "将某物分成若干部分、组或份额的行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделе́ние",
                                "target_lang_sense_clarification": "процесс разъединения"
                            },
                            {
                                "target_lang_word": "разде́л",
                                "target_lang_sense_clarification": "имущества, территории"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分割",
                                "target_lang_sense_clarification": "将整体拆分"
                            },
                            {
                                "target_lang_word": "分配",
                                "target_lang_sense_clarification": "分发份额"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c24641e2-c6b3-31fe-83a6-69651e9779a1",
                    "sense_definition": "A disagreement or difference in opinion that separates people into opposing groups.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "disagreement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The new policy created a deep <w>division</w> between the management and the staff.",
                            "target_lang_translations": {
                                "ru": "Новая политика привела к глубокому <w>расколу</w> между руководством и сотрудниками.",
                                "zh": "新政策在管理层和员工之间造成了严重的<w>分歧</w>。"
                            }
                        },
                        {
                            "text": "Political <w>division</w> in the country has made it difficult to pass new laws.",
                            "target_lang_translations": {
                                "ru": "Политический <w>раскол</w> в стране затруднил принятие новых законов.",
                                "zh": "国内的政治<w>分裂</w>使得通过新法律变得困难。"
                            }
                        }
                    ],
                    "synonyms": [
                        "split"
                    ],
                    "common_phrases": [
                        "deep division",
                        "cause division",
                        "social division"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разногласие или различие во мнениях, разделяющее людей на противоборствующие группы.",
                        "zh": "导致人们分裂成对立阵营的意见分歧或不和。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "раско́л",
                                "target_lang_sense_clarification": "серьезное разногласие"
                            },
                            {
                                "target_lang_word": "разногла́сие",
                                "target_lang_sense_clarification": "отсутствие согласия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分歧",
                                "target_lang_sense_clarification": "意见不一致"
                            },
                            {
                                "target_lang_word": "分裂",
                                "target_lang_sense_clarification": "群体间的严重对立"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d4b383be-05d4-3533-ac52-785306ee8174",
                    "sense_definition": "A large military unit that usually consists of several brigades or regiments.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "organization_unit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The general commanded an armored <w>division</w> during the conflict.",
                            "target_lang_translations": {
                                "ru": "Генерал командовал танковой <w>дивизией</w> во время конфликта.",
                                "zh": "冲突期间，将军指挥着一个装甲<w>师</w>。"
                            }
                        },
                        {
                            "text": "Troops from the first infantry <w>division</w> were deployed to the region.",
                            "target_lang_translations": {
                                "ru": "Войска из первой пехотной <w>дивизии</w> были переброшены в регион.",
                                "zh": "第一步兵<w>师</w>的部队被部署到了该地区。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "armored division",
                        "infantry division",
                        "airborne division"
                    ],
                    "target_lang_definitions": {
                        "ru": "Крупное воинское формирование, обычно состоящее из нескольких бригад или полков.",
                        "zh": "通常由若干旅或团组成的大型军事单位。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "диви́зия",
                                "target_lang_sense_clarification": "воинское соединение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "师",
                                "target_lang_sense_clarification": "军事编制单位"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fadf94a-2f67-390e-b961-116953a6b10d",
                    "sense_definition": "A major category in the classification of living things (especially plants and fungi), ranking below a kingdom and above a class.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "biology_taxonomy",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Magnolias belong to a specific <w>division</w> of flowering plants.",
                            "target_lang_translations": {
                                "ru": "Магнолии принадлежат к особому <w>отделу</w> цветковых растений.",
                                "zh": "木兰花属于开花植物中的一个特定<w>门</w>。"
                            }
                        },
                        {
                            "text": "In zoology, this rank is usually called a phylum rather than a <w>division</w>.",
                            "target_lang_translations": {
                                "ru": "В зоологии этот ранг обычно называется типом, а не <w>отделом</w>.",
                                "zh": "在动物学中，这个等级通常被称为“门”而不是<w>门</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "phylum"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "technical biology context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Основная категория в классификации живых организмов (особенно растений), рангом ниже царства и выше класса.",
                        "zh": "生物分类学中的一个主要类别（特别是植物和真菌），位于界之下、纲之上。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "отде́л",
                                "target_lang_sense_clarification": "в биологии"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "门",
                                "target_lang_sense_clarification": "生物分类等级"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aecb3e2b-460c-3a47-b4ec-ec85fc72eaed",
                    "sense_definition": "A formal method of voting in a legislature where members separate into groups to be counted.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "parliamentary_procedure",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The Speaker ordered a <w>division</w> because the voice vote was unclear.",
                            "target_lang_translations": {
                                "ru": "Спикер назначил <w>разделение</w> голосов, так как результаты устного голосования были неясны.",
                                "zh": "由于口头表决结果不明确，议长下令进行<w>分票</w>。"
                            }
                        },
                        {
                            "text": "Members of Parliament rushed to the lobby when the <w>division</w> bell rang.",
                            "target_lang_translations": {
                                "ru": "Члены парламента поспешили в вестибюль, когда раздался звонок к <w>разделению</w>.",
                                "zh": "当<w>分票</w>铃声响起时，议员们纷纷冲向大厅。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "call for a division"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "parliamentary procedure"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формальный метод голосования в законодательном органе, при котором члены разделяются на группы для подсчета.",
                        "zh": "立法机构中一种正式的投票方法，成员通过分组站立来接受清点。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разделе́ние голосов",
                                "target_lang_sense_clarification": "парламентская процедура"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "分票",
                                "target_lang_sense_clarification": "议会投票程序"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}