            "pos": "noun",
            "senses": [
                {
                    "sense_id": "7c32107f-7ead-3bab-bea4-c77a0a33a870",
                    "sense_definition": "Partie d'un objet conçue pour être saisie avec la main afin de l'ouvrir, de le soulever ou de le manier.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "objet",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a tourné la <w>poignée</w> de la porte d'entrée pour accueillir ses invités."
                        },
                        {
                            "text": "La <w>poignée</w> de sa lourde valise s'est cassée pendant le long trajet en train."
                        }
                    ],
                    "synonyms": [
                        "anse"
                    ],
                    "common_phrases": [
                        "poignée de porte",
                        "tourner la poignée"
                    ]
                },
                {
                    "sense_id": "25d76d92-1de7-37b3-b889-27cfef131fe0",
                    "sense_definition": "Quantité que la main fermée peut contenir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a jeté une <w>poignée</w> de graines aux oiseaux dans le jardin ce matin."
                        },
                        {
                            "text": "Ajoutez une petite <w>poignée</w> de gros sel dans la casserole d'eau bouillante."
                        }
                    ],
                    "common_phrases": [
                        "poignée de sel",
                        "poignée de riz"
                    ]
                },
                {
                    "sense_id": "ec888904-8ba2-30eb-90dc-c95ecfa98749",
                    "sense_definition": "Petit nombre de personnes ou d'éléments.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "quantite",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Seule une <w>poignée</w> d'élèves est restée dans la salle pour poser des questions."
                        },
                        {
                            "text": "Le match s'est décidé en une <w>poignée</w> de secondes avant le coup de sifflet."
                        }
                    ],
                    "common_phrases": [
                        "poignée de personnes",
                        "poignée de secondes"
                    ]
                },
                {
                    "sense_id": "0c42303e-5661-39d2-8e08-f5a45ab045e7",
