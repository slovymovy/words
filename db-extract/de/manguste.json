                "senses": [
                    {
                        "sense_id": "298f1504-ae61-3d35-be59-fa15cff812a2",
                        "entry_id": "3359ccde-468a-3349-9de5-a6022bb6a382",
                        "glosses": [
                            "schlankes, kleines Raubtier mit grau oder braun gefärbtem Fell, das vor allem in Afrika und Südeurasien heimisch ist"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d54986ba-938c-4b25-9619-0b488eedfd64",
                                "sense_id": "298f1504-ae61-3d35-be59-fa15cff812a2",
                                "text": "„Mangusten, die in Gruppen leben, gebären ihre Jungtiere alle am selben Tag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e3d8ef11-736c-40f5-a18a-25c3d906c855",
                        "source_entry_id": "3359ccde-468a-3349-9de5-a6022bb6a382",
                        "source_sense_id": "298f1504-ae61-3d35-be59-fa15cff812a2",
                        "source_sense_description": "schlankes, kleines Raubtier mit grau oder braun gefärbtem Fell",
                        "target_lang_word": "mongoose",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mongoose",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ace584a2-c942-333e-b8c3-bd2ea0a33992",
                                        "entry_id": "4137516b-fd91-3089-9eec-13079e42b92d",
                                        "glosses": [
                                            "Any of several species of generalist predatory carnivores in the family Herpestidae; the various species range in size from rats to large cats. Indian mongooses are predators of venomous snakes, though other mongoose species have similar habits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bd86d742-f98f-4685-b277-1cd007f193db",
                                                "sense_id": "ace584a2-c942-333e-b8c3-bd2ea0a33992",
                                                "text": "After the mongoose had satisfied its appetite, we proceeded to examine with a pocket lens the wounds he had received from the cobra; and on cleansing one of these places, the lens disclosed the broken fang of the cobra deeply imbedded in the head of the mongoose... We have had the mongoose confined ever since (now four days' time), and it is as healthy and lively as ever."
                                            },
                                            {
                                                "example_id": "2fec6d67-e444-4326-a7ce-fb40d4affde2",
                                                "sense_id": "ace584a2-c942-333e-b8c3-bd2ea0a33992",
                                                "text": "He was a mongoose, rather like a little cat in his fur and his tail, but quite like a weasel in his head and his habits."
                                            },
                                            {
                                                "example_id": "bc63b83d-1342-4888-82ed-cd65e1280906",
                                                "sense_id": "ace584a2-c942-333e-b8c3-bd2ea0a33992",
                                                "text": "Hannibal Lecter: I think Uncle Jack sees you as a fragile little tea-cup, the finest china used for only special guests.\nWill Graham: How do you see me?\nHannibal Lecter: The mongoose I want under the house when the snakes slither by."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a111b64a-be4a-36f1-b070-3f5e371ecbab",
                                        "entry_id": "4137516b-fd91-3089-9eec-13079e42b92d",
                                        "glosses": [
                                            "Any members of family Eupleridae of Malagasy mongooses, only distantly related to the Herpestidae, but resembling them in appearance and habits, with larger ears and ringed tails."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d607d1bc-eaab-411f-aa98-13ced825a4c7",
                        "source_entry_id": "3359ccde-468a-3349-9de5-a6022bb6a382",
                        "source_sense_id": "298f1504-ae61-3d35-be59-fa15cff812a2",
                        "source_sense_description": "schlankes, kleines Raubtier mit grau oder braun gefärbtem Fell",
                        "target_lang_word": "mangouste",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "mangouste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                                        "entry_id": "7f08a1b1-c166-3195-893d-642f4e64d14e",
                                        "glosses": [
                                            "Fruit du mangoustan, de la grosseur d’une petite orange et d’une saveur sucrée, légèrement acide avec un parfum de framboise."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ff46850-b6e0-4a6d-af6c-6d809e5cb0f7",
                                                "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                                                "text": "Le brave garçon avait acheté quelques douzaines de mangoustes, grosses comme des pommes moyennes, d’un brun foncé au-dehors, d’un rouge éclatant au-dedans,[…]."
                                            },
                                            {
                                                "example_id": "37fb7e74-e371-453c-8195-4fa245e2b02b",
                                                "sense_id": "20231d5d-fc08-3f7a-9704-34c76d5ea095",
                                                "text": "La mangouste est le fruit préféré de maman, la jambose celui de Kim."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "mangouste",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d19c81ba-51f8-3ae4-b7e6-f944cfd9b0ee",
                                        "entry_id": "9074401b-0725-3248-aed2-7fe6636a8a0f",
                                        "glosses": [
                                            "Une des espèces de petits mammifères quadrupèdes digitigrades carnivores de l’Ancien Monde de la taille d’un chat et de la forme d’une martre, à longue queue, qui s’apprivoisent facilement et détruisent des animaux nuisibles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fb02f3ca-fd60-43c5-a79f-f7f4e6db4425",
                                                "sense_id": "d19c81ba-51f8-3ae4-b7e6-f944cfd9b0ee",
                                                "text": "Tu as peut-être entendu parler des meloncillos ou mangoustes, sortes de petits mammifères. Par ici, il n’y en a pas, mais à La Equidad on étudie leur façon de se coordonner. Quand ils sont attaqués par des créatures beaucoup plus grandes qu’eux, ils se rassemblent et forment un tas tranquille, à l’air de rocher inaccessible. Quand ils se déplacent, parfois avec leurs enfants, ils forment une sorte de grand animal unique sans l’être, un long serpent qui marche et peut menacer et poursuivre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
