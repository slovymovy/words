                            {
                                "example_id": "bf68389e-c7b7-4ca3-a27e-2dccc49f97d3",
                                "sense_id": "85d384a7-7976-3405-bb51-1f7f279126a7",
                                "text": "In 1983 publiceerde hij het eerste deel van zijn herinneringen, Van Zwolle tot Brest-Litowsk, waarin hij nauwgezet zijn leven tot 1962 reconstrueerde. Hij maakte daarbij gebruik van het reusachtige knipselarchief dat hij had aangelegd."
                            },
                            {
                                "example_id": "a9bf64ce-23cd-4510-9270-a6f03a3f0ea5",
                                "sense_id": "85d384a7-7976-3405-bb51-1f7f279126a7",
                                "text": "De collectie van het instituut bestaat uit ongeveer 37 duizend filmtitels, 60 duizend affiches, een half miljoen foto's en 100 duizend scenario's. Ook heeft het museum een grote hoeveelheid filmboeken, tijdschriften, een groot knipselarchief en multimedia met informatie over film en filmgeschiedenis."
                            }
                        ]
