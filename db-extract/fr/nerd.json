                    {
                        "sense_id": "fa50672d-ac68-39e2-8556-72af20b09669",
                        "entry_id": "ccda6ad2-d12c-3d68-abc8-3ce3e6a00575",
                        "glosses": [
                            "Socialement handicapé et passionné par des sujets liés à la science et aux techniques."
                        ],
                        "tags": [
                            "Anglicism"
                        ],
                        "examples": [
                            {
                                "example_id": "498a5dce-a32b-4ab9-bcd4-c4e46be5f07b",
                                "sense_id": "fa50672d-ac68-39e2-8556-72af20b09669",
                                "text": "Un peu nerd, elle peine à trouver sa place au lycée."
                            },
                            {
                                "example_id": "5dbcc80f-f482-44d8-a087-786e7186fa94",
                                "sense_id": "fa50672d-ac68-39e2-8556-72af20b09669",
                                "text": "Bizarrement, les fans se passionnent pour cette gamine nerd, assez godiche et exaspérante, laissent quantité de commentaires et lui donnent des conseils dans des « vidéos réponses » qu’ils mettent en ligne."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "8276b093-5371-46df-af2d-71818567a324",
                        "source_entry_id": "ccda6ad2-d12c-3d68-abc8-3ce3e6a00575",
                        "source_sense_id": "fa50672d-ac68-39e2-8556-72af20b09669",
                        "source_sense_description": "Relatif à un nerd",
                        "target_lang_word": "nerdig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "nerdig",
