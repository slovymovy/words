                "senses": [
                    {
                        "sense_id": "3e72570a-3649-3ed0-accb-b26fa2caeb4e",
                        "entry_id": "e46b460a-c68d-3f8e-ae0f-91b27eef8f5e",
                        "glosses": [
                            "Teil einer Bodenbearbeitungsmaschine, der zum Aufnehmen, Transportieren und Abschütten von Erdreich oder sonstigem Schüttmaterial dient"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58fbf884-db11-472a-bc4e-917aa5162401",
                                "sense_id": "3e72570a-3649-3ed0-accb-b26fa2caeb4e",
                                "text": "„Ein Mann ist bei der Feier eines Kegelclubs im Münsterland von einer mit 2000 Liter Wasser gefüllten Baggerschaufel erschlagen worden.“"
                            },
                            {
                                "example_id": "d4e258bb-f29d-4ca0-b201-1e354300e725",
                                "sense_id": "3e72570a-3649-3ed0-accb-b26fa2caeb4e",
                                "text": "„Unbekannte entwendeten an der Kreisstraße 4943 zwischen Heitersheim und Staufen eine breite Baggerschaufel eines Kleinbaggers.“"
                            },
                            {
                                "example_id": "648d609c-0ee1-4b27-b22e-550ba149e7b1",
                                "sense_id": "3e72570a-3649-3ed0-accb-b26fa2caeb4e",
                                "text": "„Ein Gleisbauarbeiter wurde im Rahmen seiner Arbeit von einer Baggerschaufel am Kopf getroffen.“"
                            },
                            {
                                "example_id": "6c2910a7-edd3-47e0-900e-39e33dbf894e",
                                "sense_id": "3e72570a-3649-3ed0-accb-b26fa2caeb4e",
                                "text": "„In der Nacht von Dienstag auf Mittwoch wurde bei Schwetzingen eine 600 Kilo schwere Baggerschaufel gestohlen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
