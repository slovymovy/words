                "senses": [
                    {
                        "sense_id": "4cb17c15-9536-3759-b25e-223459e75299",
                        "entry_id": "dad52fa8-ba6c-363e-8431-8c4fb3ff5293",
                        "glosses": [
                            "Sortir de l’androcentrisme, se détacher d’un regard exclusivement masculin."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35393eec-f15c-4ba9-9536-d5a5392fd585",
                                "sense_id": "4cb17c15-9536-3759-b25e-223459e75299",
                                "text": "Désandrocentrer le travail, c’est ainsi se donner les moyens de repenser l’exploitation et de renouveler les luttes pour l’émancipation du travail."
                            },
                            {
                                "example_id": "2c5dc388-bee4-41c8-aef1-1f343bdde982",
                                "sense_id": "4cb17c15-9536-3759-b25e-223459e75299",
                                "text": "La perspective visant à désandrocentrer les contestations populaires articulée à l’ambition de « déstabiliser le présent » procède de cette histoire féministe renouvelée."
                            },
                            {
                                "example_id": "a4f10c2e-14d1-4997-8a94-2c584246f59a",
                                "sense_id": "4cb17c15-9536-3759-b25e-223459e75299",
                                "text": "Nous avons survolé la notion de \"travail reproductif\" et de \"travail déqualifié\" pour aboutir à l’idée qu’il est urgent de \"désandrocentrer\" le syndicalisme et les luttes sociales en général."
                            }
                        ]
                    }
                ],
