        "fr-extract.jsonl": [
            {
                "entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
                "word": "chambard",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4fff9b9b-323f-448a-93c8-485ae633572a",
                        "entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
                        "tags": [
                            "plural"
                        ],
                        "form": "chambards"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "202ec0c3-7b30-35ec-8f98-50b112980bcf",
                        "entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
                        "glosses": [
                            "Brimade à l’égard des nouveaux."
                        ],
                        "tags": [
                            "dated",
                            "slang"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "da5b494c-4a41-3b30-9365-05eb11fc68e1",
                        "entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
                        "glosses": [
                            "Désordre."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "9b5a88a1-25c4-41c2-ae10-646b67bad3dc",
                                "sense_id": "da5b494c-4a41-3b30-9365-05eb11fc68e1",
                                "text": "Le grand chambard tirait sur sa fin, ce n’était pas le moment d’être séparé de Maria."
                            },
                            {
                                "example_id": "ab9ae202-a292-4e2c-a51b-8821d84fa76a",
                                "sense_id": "da5b494c-4a41-3b30-9365-05eb11fc68e1",
                                "text": "C'est un vrai chambard ici."
                            },
                            {
                                "example_id": "3953ba5e-422c-45c7-bfc3-59f3945c1c6a",
                                "sense_id": "da5b494c-4a41-3b30-9365-05eb11fc68e1",
                                "text": "Il faut que je vous dise que j’ai une vieille marotte : c’est de croire que lorsqu’on essaie de découvrir quelque chose, le bon truc c’est de faire le plus de chambard possible, car lorsqu’il y a du pétard, les gens commencent à faire des tas de choses qu’ils ne feraient pas normalement […]."
                            },
                            {
                                "example_id": "73906679-b7de-4c84-9da4-c643305e9da2",
                                "sense_id": "da5b494c-4a41-3b30-9365-05eb11fc68e1",
                                "text": "Tous, jusqu’aux plus petits, sont pris par le besoin subit et irrésistible d’exécuter le chambard aux simulacres du délire bestial et alcoolique."
                            }
                        ]
                    },
                    {
                        "sense_id": "23b72980-e59e-3898-aaa4-a079c5ac1767",
                        "entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
                        "glosses": [
                            "Bruit intense."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "ed00d27e-8044-42b8-9543-18f6dbda8ddc",
                                "sense_id": "23b72980-e59e-3898-aaa4-a079c5ac1767",
                                "text": "Quel chambard!… Qu’on expulse ces bagarreurs!!"
                            },
                            {
                                "example_id": "89b5199e-53fe-4cad-a92a-05ec55291e83",
                                "sense_id": "23b72980-e59e-3898-aaa4-a079c5ac1767",
                                "text": "Shed a rampé vers le raffut tonitruant. Qu’est-ce qu’il fabriquait au juste, pour faire un chambard pareil ?"
                            },
                            {
                                "example_id": "dc82c0d3-47ed-4c4d-bfd8-ca1cc8a40147",
                                "sense_id": "23b72980-e59e-3898-aaa4-a079c5ac1767",
                                "text": "N’ai-je pas somnolé bercé par la rumeur du port, les fanfares, les chambards ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "61773097-04de-4051-921d-4eb3b5d5c9e6",
                        "source_entry_id": "ecfce4bc-56ff-3186-ac30-3347370d79b8",
