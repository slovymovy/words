                "senses": [
                    {
                        "sense_id": "09abd3f3-29b6-36fc-9da1-a674b845a259",
                        "entry_id": "4e9ae6c9-a526-3695-927d-cc519edc40d4",
                        "glosses": [
                            "Arbeitnehmer, der von einem Vermittlungsunternehmen gegen einen Bonus, den der Arbeitnehmer durch Lohnverzicht leistet, verliehen wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "084446cc-0367-4a5c-97cf-cab04f0edd0c",
                                "sense_id": "09abd3f3-29b6-36fc-9da1-a674b845a259",
                                "text": "„Für die rund 900 000 Leiharbeiter in Deutschland gilt erstmals ein verbindlicher Mindestlohn.“"
                            },
                            {
                                "example_id": "212ed7cb-62ac-4601-a592-1fcd3c9e3724",
                                "sense_id": "09abd3f3-29b6-36fc-9da1-a674b845a259",
                                "text": "Vor der Reform [durch die Hartz-Gesetze] hatten wir ungefähr 300.000 Leiharbeiter in Deutschland, und jetzt haben wir eine Million. Das ist gewiss auf die Reform zurückzuführen."
                            }
                        ],
