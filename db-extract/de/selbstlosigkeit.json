                "senses": [
                    {
                        "sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                        "entry_id": "f7320b94-8c00-36d1-9421-3c85495c8c9f",
                        "glosses": [
                            "Einstellung, das Wohlergehen anderer über das eigene zu stellen; großherzige Haltung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e4d4dbf-3928-40d4-9008-374c26da679e",
                                "sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                                "text": "„Nette Menschen üben eine Tugend, die viel gepriesen, aber wenig belohnt wird: Selbstlosigkeit.“"
                            },
                            {
                                "example_id": "578ef51a-4447-445c-a682-83ba7f48596f",
                                "sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                                "text": "„Bei der Befreiung der Tiere, fehlen diese egoistischen Komponenten, hier sind wir ausschließlich auf menschliche Selbstlosigkeit angewiesen.“"
                            },
                            {
                                "example_id": "47abfc15-710e-4074-bcde-85f921f0dc4a",
                                "sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                                "text": "„Es ist schwer, Selbstlosigkeit zu üben, wenn wir gerade selbst zu kämpfen haben.“"
                            },
                            {
                                "example_id": "adaeafdc-ce49-4891-9c48-a1269542d247",
                                "sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                                "text": "„2012 wurde Edhi für den Friedensnobelpreis vorgeschlagen, denn kein Pakistaner verkörpert Ehrlichkeit und Selbstlosigkeit in so hohem Maße wie er; finanziert er doch alle seine Stiftungsaktivitäten ausschließlich über Spenden und lebt selbst äußerst bescheiden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1568a41c-aa5e-4598-ab27-bcfde66892ba",
                        "source_entry_id": "f7320b94-8c00-36d1-9421-3c85495c8c9f",
                        "source_sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                        "source_sense_description": "Einstellung, das Wohlergehen anderer über das eigene zu stellen; großherzige Haltung",
                        "target_lang_word": "selflessness",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "selflessness",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "aae4b3c3-0ab2-369d-a85c-2d34a641fab6",
                                        "entry_id": "b3d6b690-a006-30a6-a0df-af8e60f905a9",
                                        "glosses": [
                                            "The quality or state of being selfless."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cbdb0358-3225-4d02-8725-e31800a3cf8f",
                                                "sense_id": "aae4b3c3-0ab2-369d-a85c-2d34a641fab6",
                                                "text": "But the truth is that I came to cherish Japan’s civility and selflessness."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "cd658bd3-6599-427d-95c6-45c32c01768c",
                        "source_entry_id": "f7320b94-8c00-36d1-9421-3c85495c8c9f",
                        "source_sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                        "source_sense_description": "Einstellung, das Wohlergehen anderer über das eigene zu stellen; großherzige Haltung",
                        "target_lang_word": "désintéressement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "désintéressement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                        "entry_id": "eab12538-b281-37c7-8679-ac7434a31d91",
                                        "glosses": [
                                            "Qualité de celui qui est désintéressé."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4f051bb0-513f-4817-9a75-9bfe70266c5b",
                                                "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                                "text": "Dès que les jeunes gens furent mariés, Mouret comprit qu’il devait quitter Plassans, s’il ne voulait pas entendre chaque jour des paroles désobligeantes sur sa femme et sur sa belle-mère. Il partit, il emmena Ursule à Marseille où il travailla de son état. D’ailleurs, il n’avait pas demandé un sou de dot. Comme Pierre, surpris de ce désintéressement, s’était mis à balbutier, cherchant à lui donner des explications, il lui avait fermé la bouche en disant qu’il préférait gagner le pain de sa femme."
                                            },
                                            {
                                                "example_id": "58036c5c-d6fd-4d4a-a2cb-559f0641d034",
                                                "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                                "text": "Qu'est-ce que la vertu ? Au sens où l'entend son restaurateur, c'est sans doute la probité et le désintéressement, c'est ce genre d’intégrité qui rend un fonctionnaire ou un mandataire inaccessible à toutes les tentations, à toutes les corruptions […]."
                                            },
                                            {
                                                "example_id": "e07df3f4-b7c7-4d90-8868-9d829dbafdaa",
                                                "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                                "text": "Dans vingt ans, […], une héritière d’un million, ce sera rare comme le désintéressement chez un usurier."
                                            },
                                            {
                                                "example_id": "dbcf6922-d891-4ad8-8de7-85a8a1acdfef",
                                                "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                                "text": "Son désintéressement ne venait pas de fortune, il venait de son caractère ; car il n'est pas rare qu'un homme riche veuille s'enrichir."
                                            },
                                            {
                                                "example_id": "ab422ab6-c35c-4ccf-a5cb-5593e0086aa2",
                                                "sense_id": "6cc9836c-5518-3c1d-8eab-edea0519a77b",
                                                "text": "Sans doute elle était obligée d’avouer que Swann ne tenait pas à l’argent, mais elle ajoutait d’un air boudeur : « Mais lui, ça n’est pas la même chose » ; et en effet, ce qui parlait à son imagination, ce n’était pas la pratique du désintéressement, c’en était le vocabulaire."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                        "entry_id": "eab12538-b281-37c7-8679-ac7434a31d91",
                                        "glosses": [
                                            "Détachement de tout intérêt propre."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b63c6db3-c739-4840-9734-ef7737ad4f7e",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "L'on y voit de si grands exemples de constance, de vertu, de tendresse et de désintéressement, de si beaux et de si parfaits caractères […]"
                                            },
                                            {
                                                "example_id": "629660ba-e1dd-4fe0-a49d-5e344b5cb19c",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "L'esprit républicain qui est un esprit de désintéressement."
                                            },
                                            {
                                                "example_id": "bb27ee5a-1288-4abe-a1d3-20c08ac78a57",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "Mais les révolutions sont toujours des sacrifices que le temps fait à l'avenir, et qui nécessitent de la part des peuples par qui elles s'accomplissent un grand désintéressement momentané."
                                            },
                                            {
                                                "example_id": "f99c78ce-3644-436f-b86f-a99bb39e0dd7",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "Le désintéressement, la démission pratique mêmes sont des décisions de partisans. La volonté d’être un clerc et seulement un clerc est moins un choix de l’homme éternel que l’élection du partisan."
                                            },
                                            {
                                                "example_id": "03fc474e-117c-4663-9a22-9e0bfb1b59b3",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "Il suivit M. Paul Cambon qui parvint à édifier le célèbre accord entre la France et la Grande-Bretagne, impliquant notamment le troc de nos droits sur l'Égypte contre le désintéressement anglais au Maroc."
                                            },
                                            {
                                                "example_id": "8ecab871-be1c-47d9-af7d-19209e650918",
                                                "sense_id": "2f57ba2d-915b-3136-a987-ec8f5460597e",
                                                "text": "Je pense que ce qui a beaucoup contribué à l’aura dont jouissait de Gaulle, c’est son désintéressement pour les biens matériels."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6fb54506-8cfe-48c9-97b4-e671e836fe05",
                        "source_entry_id": "f7320b94-8c00-36d1-9421-3c85495c8c9f",
                        "source_sense_id": "6d28ebff-e448-3799-9a4d-63ee59558870",
                        "source_sense_description": "Einstellung, das Wohlergehen anderer über das eigene zu stellen; großherzige Haltung",
                        "target_lang_word": "abnégation",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abnégation",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                        "entry_id": "e1a78297-c1f6-370d-8d3a-5e9b3eebdb5f",
                                        "glosses": [
                                            "Renoncement, sacrifice."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dcb22e24-7b88-40d7-b416-0260f784969c",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Cette responsabilité d’honneur, cette abnégation magnifique donnèrent insensiblement à la jeune marquise une dignité de femme, une conscience de vertu […]."
                                            },
                                            {
                                                "example_id": "a1d81725-b95d-44f2-b93d-10f5a442a3f0",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "L’Abnégation du Guerrier est une croix plus lourde que celle du Martyr. Il faut l’avoir portée longtemps pour en savoir la grandeur et le poids."
                                            },
                                            {
                                                "example_id": "1c0f3a6f-c328-4072-9466-71c258697fb0",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Si donc l’histoire récom­pense l’abnégation résignée des hommes qui luttent sans se plaindre et accomplissent sans profit une grande œuvre de l'histoire, comme l'affirme Renan, nous avons une raison nouvelle de croire à l'avènement du socialisme, […]."
                                            },
                                            {
                                                "example_id": "302b5ba6-05fe-4d91-9bfb-920b50eaa380",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Je n’ai pas de leçons à donner, mais s’il y avait eu des smartphones quand j’avais 18 ou 20 ans, je ne sais pas si j’aurais eu le même parcours. Car il m’a demandé beaucoup de travail et un peu d’abnégation."
                                            },
                                            {
                                                "example_id": "28ff7154-569a-46fd-9c40-de05d6ec6721",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "L’abnégation ne figure pas au rang de mes qualités distinctives."
                                            },
                                            {
                                                "example_id": "78b2274b-4ee9-4572-b967-ed7e3cc4682b",
                                                "sense_id": "d8586b5c-60e1-3003-858f-21d6095cf2aa",
                                                "text": "Ce dévouement, qui s'élève parfois jusqu'à l'abnégation, s'affirmera encore davantage après sa visite au bagne de Sakhaline."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "aa83ae96-ba2d-37bd-a542-05774ad52f36",
                                        "entry_id": "e1a78297-c1f6-370d-8d3a-5e9b3eebdb5f",
                                        "glosses": [
                                            "Détachement de tout ce qui n’a pas rapport à Dieu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "787eec68-8b63-44fa-9d25-bc9461fe214f",
                                                "sense_id": "aa83ae96-ba2d-37bd-a542-05774ad52f36",
                                                "text": "Pour s’attacher uniquement à Dieu, il fait abnégation de ce que l’homme a de plus cher."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": []
