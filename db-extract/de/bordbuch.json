                "senses": [
                    {
                        "sense_id": "f0894a02-7f31-3995-8f00-f0a4bd0d6ad7",
                        "entry_id": "42f61ae7-d3e3-30f6-b5a8-e3fa45de0e4e",
                        "glosses": [
                            "Nautik: Tagebuch, in dem die Ereignisse während einer Fahrt aufgezeichnet werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5173a718-3b78-42d5-8745-2892bcf41b07",
                                "sense_id": "f0894a02-7f31-3995-8f00-f0a4bd0d6ad7",
                                "text": "„Glücklicherweise lieferten Forschungen, die ich mehrere Jahre lang betrieben hatte, reichlich Belege für die Authentizität von Durands Bordbuch.“"
                            },
                            {
                                "example_id": "6ffc8e75-7fb1-49ac-9f88-7be2503eef40",
                                "sense_id": "f0894a02-7f31-3995-8f00-f0a4bd0d6ad7",
                                "text": "„Ich hatte keinen Zugang zum Bordbuch gehabt und verstand den Hintergrund dieser Frage daher nicht.“"
                            },
                            {
                                "example_id": "eedaee87-2c0b-4479-9830-83592596b234",
                                "sense_id": "f0894a02-7f31-3995-8f00-f0a4bd0d6ad7",
                                "text": "„Was es für einen Seemann bedeutete, das Festland weit hinter sich zu lassen und ins Unbekannte zu segeln, zeigen die Notizen, die Christoph Kolumbus in sein Bordbuch geschrieben hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
