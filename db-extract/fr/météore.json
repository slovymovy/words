        "fr-extract.jsonl": [
            {
                "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                "word": "météore",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4ad693c2-1482-4037-9081-29bfc83c8a1a",
                        "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "tags": [
                            "plural"
                        ],
                        "form": "météores"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                        "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "glosses": [
                            "Phénomène atmosphérique."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "edc409e8-61c0-4df4-8094-bdae0083c96e",
                                "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                                "text": "Le tonnerre, les éclairs, la pluie, la neige, la grêle sont des météores."
                            },
                            {
                                "example_id": "ef17701d-fa72-4709-9fd3-15e2805c08b5",
                                "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                                "text": "L’arc-en-ciel est un météore."
                            },
                            {
                                "example_id": "3e683a23-aa85-4a19-ac2b-e5fb9963f27e",
                                "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                                "text": "Météore aérien, aqueux, lumineux, igné, enflammé."
                            },
                            {
                                "example_id": "283334b1-d190-46d6-9209-dfe1524c1636",
                                "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                                "text": "Ce n’était qu’un orage qui avait passé avec cette rapidité spéciale aux météores électriques. — (Jules Verne, Le Pays des fourrures, J. Hetzel et Cⁱᵉ, Paris, 1873)"
                            },
                            {
                                "example_id": "b80903f9-552c-414e-acff-5f8fedd07b07",
                                "sense_id": "b55979da-8207-34e5-9f82-4248b9533c00",
                                "text": "Vous avez beaucoup couru aujourd'hui ; vous avez eu des émotions ; vous avez vu des météores [il s'agit de feux follets] …"
                            }
                        ]
                    },
                    {
                        "sense_id": "e6f41dff-8b3c-3a35-a778-392dcfe5ddec",
                        "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "glosses": [
                            "Corps solide qui se consume en traversant l'atmosphère."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9eab6311-2cc2-42bf-8d06-2f29fbe81961",
                                "sense_id": "e6f41dff-8b3c-3a35-a778-392dcfe5ddec",
                                "text": "[Mayer] explique l’incandescence des météores par une perte d’énergie cinétique dans l’atmosphère."
                            },
                            {
                                "example_id": "b15823f9-f417-42f6-9ad6-c0bbaf951529",
                                "sense_id": "e6f41dff-8b3c-3a35-a778-392dcfe5ddec",
                                "text": "Enfin le soleil se leva, un large soleil si pâle, si pâle, qu’on eût dit un signe du ciel annonçant aux hommes la consommation des temps, un sinistre météore précurseur du chaos final, un grand soleil mort."
                            }
                        ]
                    },
                    {
                        "sense_id": "a37cd417-40f9-3d34-b2d2-eacad377016c",
                        "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "glosses": [
                            "Traînée lumineuse produite par l’entrée dans l’atmosphère d’un météoroïde."
                        ],
                        "tags": [
                            "especially"
                        ],
                        "examples": [
                            {
                                "example_id": "89031a85-00a7-4ed0-b7d4-c5c7fbd60582",
                                "sense_id": "a37cd417-40f9-3d34-b2d2-eacad377016c",
                                "text": "Aussi son règne fut-il comme le cours d’un météore rapide et étincelant qui parcourt le ciel, répandant autour de lui une lumière éblouissante, mais inutile, que remplace aussitôt une obscurité profonde."
                            }
                        ]
                    },
                    {
                        "sense_id": "814c6b82-afc5-3b81-a381-37ead6d53e83",
                        "entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "glosses": [
                            "Personne qui a une renommée éclatante, mais passagère ; chose qui fait une impression vive, mais peu durable."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "400aeb2f-46c8-45a8-bebb-e3881273c0de",
                                "sense_id": "814c6b82-afc5-3b81-a381-37ead6d53e83",
                                "text": "Il est dans le caractère français de s’enthousiasmer, de se colérer, de se passionner pour le météore du moment, pour les bâtons flottants de l’actualité."
                            },
                            {
                                "example_id": "28605e36-7613-45a1-a265-395933403ab6",
                                "sense_id": "814c6b82-afc5-3b81-a381-37ead6d53e83",
                                "text": "Thom ne fut-il qu’un météore polaire, qui déchira la toile du ciel canadien pour vomir son fiel contre les Canadiens français et les Métis, puis repartir, le mal fait, vers son Écosse natale ?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "be14285c-7ac8-4720-b848-2d48036cb682",
                        "source_entry_id": "27abf076-9a4b-387f-b49f-c5a51bd82ec6",
                        "target_lang_word": "Meteor",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
