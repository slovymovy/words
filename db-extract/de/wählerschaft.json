                                                "sense_id": "6e67cef3-b521-3a2f-b073-084d220d5b7f",
                                                "text": "Dans tout l’électorat de Trèves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30cdba36-8169-398b-b091-ea452ed2fa32",
                                        "entry_id": "2aac6294-c92e-3131-8821-c1b0faf7c5e4",
                                        "glosses": [
                                            "Qualité d’électeur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e86f762-99bc-4ed3-aec7-79a494f2a529",
                                                "sense_id": "30cdba36-8169-398b-b091-ea452ed2fa32",
                                                "text": "On a conféré aux femmes l’électorat pour les élections aux Tribunaux de commerce."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "509bfbcf-0180-3d5c-8c9f-a8d879135326",
                                        "entry_id": "2aac6294-c92e-3131-8821-c1b0faf7c5e4",
                                        "glosses": [
                                            "Ensemble des électeurs qui votent pour un parti ou un candidat spécifiques."
                                        ],
                                        "tags": [
                                            "collective"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "5bbb8f8b-cbae-4129-b5a2-8969dc04b22d",
                                                "sense_id": "509bfbcf-0180-3d5c-8c9f-a8d879135326",
                                                "text": "En revanche, la plus importante numériquement des familles politiques, celle des « sans-opinion », le « marais » viendra gonfler au gré des événements, l’électorat de tel ou tel parti."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a38a291b-2b6e-406d-9d5b-6c04ed92f948",
