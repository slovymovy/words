{
    "word_family": [
        "presume",
        "presumptive",
        "presumptuous"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "64539266-7ad0-30ef-8d0d-b0f9f1f7e398",
                    "sense_definition": "The belief that something is true based on reasonable evidence.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>presumption</w> is that the meeting will start on time."
                        },
                        {
                            "text": "There is a strong <w>presumption</w> of innocence until proven guilty."
                        }
                    ],
                    "common_phrases": [
                        "legal presumption",
                        "strong presumption"
                    ]
                },
                {
                    "sense_id": "cba33727-6066-331e-a307-a385b78eec75",
                    "sense_definition": "Behavior that is rude or shows a lack of proper respect.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "behavior",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was pure <w>presumption</w> for him to interrupt the professor during the lecture."
                        },
                        {
                            "text": "She apologized for her <w>presumption</w> in offering advice to her boss."
                        }
                    ]
                },
                {
                    "sense_id": "618c953b-16e7-3963-a309-384594cd286e",
                    "sense_definition": "The act of assuming something to be true without absolute proof.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His entire argument was based on a false <w>presumption</w> about the data."
                        },
                        {
                            "text": "We must avoid making a <w>presumption</w> about their future intentions."
                        }
                    ]
                },
                {
                    "sense_id": "6cad5f43-d97a-32af-8a3b-2f862d8a1312",
                    "sense_definition": "A legal rule that a fact is accepted as true unless proven otherwise.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "legal",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The law creates a <w>presumption</w> that the driver is responsible for the accident."
                        },
                        {
                            "text": "The defense successfully challenged the <w>presumption</w> of negligence in the case."
                        }
                    ],
                    "common_phrases": [
                        "rebuttable presumption"
                    ]
                },
                {
                    "sense_id": "367604cb-34f5-3452-895a-818fa84d1035",
                    "sense_definition": "The underlying condition or premise upon which a conclusion is built.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "belief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The entire theory rests on the <w>presumption</w> that resources are infinite."
                        },
                        {
                            "text": "They questioned the <w>presumption</w> that economic growth is always beneficial."
                        }
                    ]
                }
            ]
        }
    ]
