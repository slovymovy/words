                    },
                    {
                        "sense_id": "0fda8d49-6c18-3084-8520-b46e518f8b18",
                        "entry_id": "6b442a40-106e-3c74-87c7-14a687ffe331",
                        "glosses": [
                            "Dispositif destiné à être introduit dans un fût par la bonde et à supporter une mèche soufrée enflammée."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bec16a7f-cf39-4c3d-a9dd-49b9a94584ca",
                                "sense_id": "0fda8d49-6c18-3084-8520-b46e518f8b18",
                                "text": "On fixe une mèche au crochet, on l'allume, puis on l'introduit dans le tonneau par le trou de la bonde, et on l'enfonce jusqu'à ce que le bouchon ferme bien ce trou . On ne retire le méchoir que lorsque la mèche est entièrement brûlée."
                            }
                        ]
                    }
                ],
