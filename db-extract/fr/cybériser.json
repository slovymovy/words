                "senses": [
                    {
                        "sense_id": "e2a358d0-0d9e-3c5a-bc21-73d11d17adf7",
                        "entry_id": "f95dd032-da84-3a58-8f15-ea4f773ac7ef",
                        "glosses": [
                            "Donner un caractère cybernétique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "40821412-4cbb-4578-97c8-f394c05005cb",
                                "sense_id": "e2a358d0-0d9e-3c5a-bc21-73d11d17adf7",
                                "text": "Avec Bernard Kouchner, quelques semaines candidat en 2007, nous reprendrons le principe mais en le cybérisant."
                            },
                            {
                                "example_id": "3e6dcefd-aa40-4b19-8217-c709a9b15298",
                                "sense_id": "e2a358d0-0d9e-3c5a-bc21-73d11d17adf7",
                                "text": "Il serait alors plus juste de parler d’une « allégorie autobiographique » des textes : fonctionnement qui déguise et « cybérise » le Moi, en le faisant osciller entre « je suis » et « comme si j’étais »."
                            },
                            {
                                "example_id": "f4d4349e-a589-49a3-8fbf-dd5f09c6e167",
                                "sense_id": "e2a358d0-0d9e-3c5a-bc21-73d11d17adf7",
                                "text": "Je te souhaite de te cybériser la vie de temps à autre…"
                            }
                        ]
                    }
