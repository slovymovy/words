                            }
                        },
                        {
                            "text": "She learned how to <w>joint</w> a rabbit properly for the stew.",
                            "target_lang_translations": {
                                "ru": "Она научилась правильно <w>разделывать</w> кролика для рагу.",
                                "zh": "她学会了如何正确地<w>分割</w>兔子肉来炖汤。"
                            }
                        }
                    ],
                    "synonyms": [
                        "disjoint"
                    ],
                    "common_phrases": [
                        "joint a chicken"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разрезать мясо на куски по суставам.",
                        "zh": "顺着关节将肉切成小块。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разде́лывать",
                                "target_lang_sense_clarification": "резать тушу на части"
