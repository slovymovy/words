                        "entry_id": "fbd1993c-b3c2-341b-96ab-e7d5a8bd3e96",
                        "glosses": [
                            "Personne n’ayant pas le statut de citoyen ou la citoyenneté."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d3765fb0-70f9-4d17-9a21-f197e8aaf6dc",
                                "sense_id": "92d608c4-6199-316b-af1c-da671f7bc861",
                                "text": "Un non-citoyen reconnu est une personne qui n’est citoyenne ni du pays déclarant ni d’un autre pays, mais a établi avec le premier des liens engendrant une partie seulement des droits et devoirs d’une citoyenneté complète."
                            }
                        ]
                    }
                ],
