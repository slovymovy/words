                    {
                        "translation_id": "118ff390-0f68-4d0c-a4b8-0c121b8ba75a",
                        "source_entry_id": "4f815e53-cb0e-3c0b-a781-3c285b872965",
                        "source_sense_id": "98c7a92d-98b4-3595-879e-6a5a7c074d3c",
                        "target_lang_word": "Infanterie",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Infanterie",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                        "entry_id": "a62484e7-29e9-365c-9669-c96f857a58d5",
                                        "glosses": [
                                            "zu Fuß kämpfende, mit Handwaffen ausgerüstete Truppen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "be21631b-bb69-4f75-99ff-00f84483da88",
                                                "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                                "text": "Die Infanterie bildet seit der Einführung der Schnellfeuerwaffen wieder das Rückgrat der meisten Armeen."
                                            },
                                            {
                                                "example_id": "75443375-f062-489e-b0a1-004a9c632191",
                                                "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                                "text": "„Die Kasernen sind mit Freiwilligen überfüllt, bei der Infanterie und Kavallerie werde ich abgewiesen, ich soll warten, Freiwillige werden nicht mehr eingestellt.“"
                                            },
                                            {
                                                "example_id": "7a26285b-6c65-42dc-96ab-821e4085b648",
                                                "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                                "text": "„Ich dürfe nicht zur SS, ich müsse zum Heer, sagte ich, mein Vater sei dort Offizier, und sein Herzenswunsch sei es, daß ich Offizier bei der Infanterie des Heeres würde.“"
                                            },
                                            {
                                                "example_id": "533ea4e7-3f29-4cff-99c2-23298c9bf834",
                                                "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                                "text": "„Neulich waren es Fallschirmjäger gewesen, diesmal war es Infanterie.“"
                                            },
                                            {
                                                "example_id": "1a74fa23-f815-4793-a3e4-c2be7e70f026",
                                                "sense_id": "82ebf0e4-2f40-3f2c-8c75-4912a899a616",
                                                "text": "„Hier stand unsere Intanterie und hart am Abhang des Hügels am weitesten rechts, Dragoner.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "50bef594-62d2-48c8-85c5-a9046036d39e",
                        "source_entry_id": "4f815e53-cb0e-3c0b-a781-3c285b872965",
