    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "36183894-c452-3950-a111-2c20ef955ffe",
                    "sense_definition": "Émettre une lueur ou de la lumière, de façon continue ou intermittente.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rayonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dans l'obscurité totale de la forêt, quelques lucioles <w>luisent</w> au milieu des fougères."
                        },
                        {
                            "text": "La lune <w>luisait</w> calmement au-dessus des collines endormies."
                        }
                    ],
                    "synonyms": [
                        "briller",
                        "rayonner",
                        "étinceler"
                    ],
                    "antonyms": [
                        "s'éteindre",
                        "s'obscurcir"
                    ],
                    "common_phrases": [
                        "luire dans l'obscurité",
                        "luire dans la nuit"
                    ]
                },
                {
                    "sense_id": "672c9912-3e8c-3f89-ae44-e1b91c9ea4d9",
                    "sense_definition": "Renvoyer ou réfléchir la lumière, en parlant d'un métal ou d'une surface polie.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "rayonnement",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Les rails métalliques du chemin de fer <w>luisaient</w> sous la pluie battante."
                        },
                        {
                            "text": "Une fine chaîne en or poli <w>luit</w> au soleil sur le tissu noir."
                        }
                    ],
                    "synonyms": [
                        "briller",
                        "miroiter",
                        "scintiller"
                    ],
                    "antonyms": [
                        "ternir"
                    ],
                    "common_phrases": [
                        "luire au soleil",
                        "tout ce qui luit"
                    ]
                },
                {
                    "sense_id": "1e66b0d3-2604-3726-a292-364451696190",
                    "sense_definition": "Apparaître faiblement ou commencer à poindre dans l'esprit, en parlant d'un sentiment favorable ou d'une perspective.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après plusieurs mois de crise diplomatique, un mince espoir de paix semblait enfin <w>luire</w>."
                        },
                        {
                            "text": "Un bref sentiment de soulagement l'envahit dès qu'une solution commença à <w>luire</w> à l'horizon."
                        }
                    ],
                    "synonyms": [
                        "poindre",
                        "apparaître"
                    ],
                    "antonyms": [
                        "disparaître",
                        "s'évanouir"
                    ],
                    "common_phrases": [
                        "faire luire un espoir",
                        "voir luire l'espoir"
                    ]
                }
            ]
        }
    ]
}