                        "sense_id": "0d512bc8-2ae0-3045-9499-a69906268b7c",
                        "entry_id": "78ff8afb-05d6-3043-a7a4-8e3169fdc867",
                        "glosses": [
                            "an einer Hochschule oder Fachschule ausgebildete Fachkraft auf dem Gebiet der Technik"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7f73e509-2222-402d-9060-677b3b52397c",
                                "sense_id": "0d512bc8-2ae0-3045-9499-a69906268b7c",
                                "text": "Wir stellen ab sofort einen Techniker oder eine Technikerin für den Außendienst an."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "705dd488-cc73-347d-8610-5842c19663b2",
                        "entry_id": "78ff8afb-05d6-3043-a7a4-8e3169fdc867",
                        "glosses": [
                            "qualifizierte, weibliche Person, die in ihrem Fachgebiet als kompetent gilt und die mechanische Vorgehensweise sehr gut beherrscht"
                        ],
                        "tags": [
                            "oft über Sportlerinnen und Musikerinnen"
                        ],
                        "examples": [
                            {
                                "example_id": "be8153eb-7f3b-446e-9953-3cc992ae24e3",
                                "sense_id": "705dd488-cc73-347d-8610-5842c19663b2",
                                "text": "Anne hat schon viele Abfahrtsrennen gewonnen, weil sie eine brillante Technikerin ist."
                            },
                            {
                                "example_id": "9847d28e-a984-45a2-a53a-077e7739ae17",
                                "sense_id": "705dd488-cc73-347d-8610-5842c19663b2",
                                "text": "Die junge Chinesin begeistert bei ihrem Klavierspiel als hervorragende Technikerin."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
