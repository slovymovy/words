                    },
                    {
                        "form_id": "d6f0ccef-cbac-43b1-a79f-82a166022dd5",
                        "entry_id": "ddc86fc9-a29e-3a60-acf9-737cc9bd5bd6",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Gönnerinnen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c8ad9b1b-160c-3206-9cb2-fb1ecfdd7d77",
                        "entry_id": "ddc86fc9-a29e-3a60-acf9-737cc9bd5bd6",
                        "glosses": [
                            "wohlhabende, weibliche Person, die jemand anderen (Künstler oder Einrichtung) in seinen Bestrebungen mit Geld unterstützt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "be6f7400-50d9-4c80-8ff4-4821d7f8b3d2",
                                "sense_id": "c8ad9b1b-160c-3206-9cb2-fb1ecfdd7d77",
                                "text": "Der junge Künstler hat in der Fürstin eine Gönnerin gefunden, die ihm ein gutes Auskommen ermöglicht."
                            },
                            {
                                "example_id": "94076b2d-7cc8-488d-bdbb-fb04d9c765ce",
                                "sense_id": "c8ad9b1b-160c-3206-9cb2-fb1ecfdd7d77",
                                "text": "„Diese hatte sich nämlich zu ihrer Gönnerin erklärt, als bekannt wurde, daß Signor D. R. mit ihr in einem kleinen Haus außerhalb der Stadt gefrühstückt hatte, das einem Signor Cazzaetti gehörte.“"
                            },
                            {
                                "example_id": "041f1df1-2934-4ef4-ba92-3e292e136252",
                                "sense_id": "c8ad9b1b-160c-3206-9cb2-fb1ecfdd7d77",
                                "text": "„Der so Geehrte mußte jedoch seine Gönnerin in dieser Hinsicht enttäuschen, denn er war zeitlebens entweder zu schüchtern oder zu bescheiden, große und prächtige Gemälde zu verfertigen.“"
                            },
                            {
                                "example_id": "db91e15d-ac4c-4d87-a5cb-e9198a9ca313",
                                "sense_id": "c8ad9b1b-160c-3206-9cb2-fb1ecfdd7d77",
                                "text": "„An den Tagen, wenn er solche mahnenden Briefe von seiner Gönnerin erhielt, kam er misslaunig zu Shakespeare and Company und lud dann jeden, der abends um acht noch da war, zu einem guten Essen ins Les Deux Magots ein.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
