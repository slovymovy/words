                ],
                "senses": [
                    {
                        "sense_id": "49b34057-8e4e-3bd6-99bf-5a2d65f23ea3",
                        "entry_id": "4b9e281a-569a-3c6a-acfa-2e2bc51fd9a6",
                        "glosses": [
                            "Intervalle d’une solive à l’autre dans un plancher, d’un poteau à l’autre dans une cloison."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0aa65234-b5bf-46c2-a2f1-2f8fcb4bcf02",
                                "sense_id": "49b34057-8e4e-3bd6-99bf-5a2d65f23ea3",
                                "text": "Dans un travail qui a fait école, R. Emmerich … a démontré la quantité prodigieuse de matière organique qui s’accumule dans les entrevous ( espaces situés sous les planchers)."
                            }
                        ]
                    },
                    {
                        "sense_id": "768b6ed5-0d40-3fed-b146-6231d4023d50",
                        "entry_id": "4b9e281a-569a-3c6a-acfa-2e2bc51fd9a6",
                        "glosses": [
                            "Matériaux que l’on met dans cet espace, comme par exemple des hourdis."
                        ],
                        "tags": [
                            "broadly"
                        ],
                        "examples": [
                            {
                                "example_id": "43767fdf-8dea-47da-9506-ec36ef1639ce",
                                "sense_id": "768b6ed5-0d40-3fed-b146-6231d4023d50",
                                "text": "L’entrevous peut être en béton, mais aussi en terre cuite, en polystyrène expansé, en fibragglo, en fibres de bois,…."
                            },
                            {
                                "example_id": "3ea6c8e0-f804-49f9-9706-14c88acb37a0",
                                "sense_id": "768b6ed5-0d40-3fed-b146-6231d4023d50",
                                "text": "L’entrevous est également particulièrement sensible aux événements sismiques et c’est pourquoi il est vendu avec plan de conception et étude d'implantation, afin de vérifier sa résistance et la manière dont il est soutenu."
                            }
                        ]
                    }
                ],
