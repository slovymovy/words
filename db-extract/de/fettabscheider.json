                ],
                "senses": [
                    {
                        "sense_id": "58a1fecf-c75a-39b9-a64c-f5cdae56f251",
                        "entry_id": "d0ce90ed-29b3-3992-a4c7-43b3e94aa7b7",
                        "glosses": [
                            "technische Vorrichtung oder Kammersystem, zum Abschöpfen von Fettbestandteilen aus Abwässern"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d4e21d36-300c-49f6-8a72-ed5f5d7bb88b",
                                "sense_id": "58a1fecf-c75a-39b9-a64c-f5cdae56f251",
                                "text": "„In Einzelfällen können die Berliner Wasserbetriebe über die Notwendigkeit zum Einbau eines Fettabscheiders entscheiden.“"
                            },
                            {
                                "example_id": "b9f533cc-6fa0-4920-89a2-0fe105d08fe4",
                                "sense_id": "58a1fecf-c75a-39b9-a64c-f5cdae56f251",
                                "text": "„Fettabscheideranlagen bestehen aus Schlammfang, Fettabscheider und Probenahmeschacht, wobei einzelne Funktionsräume auch miteinander kombiniert ausgeführt werden können.“"
                            },
                            {
                                "example_id": "fb3df26f-ec6f-40c5-a530-d38febc61c91",
                                "sense_id": "58a1fecf-c75a-39b9-a64c-f5cdae56f251",
                                "text": "„Die Flammendurchschlagsicherheit des Fettabscheiders sei durch ein TÜV-Prüfsiegel oder das strenge amerikanische UL-Zertifikat dokumentiert, so von Aswege.“"
                            },
                            {
                                "example_id": "6a8bbf24-89b0-462e-860d-0fb801631fcf",
                                "sense_id": "58a1fecf-c75a-39b9-a64c-f5cdae56f251",
                                "text": "„Alle zehn Tage musste er zwanzig Stunden Küchendienst leisten: Er schälte Kartoffeln, gab Suppe aus, reinigte die Fettabscheider und so weiter.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
