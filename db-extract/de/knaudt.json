                "senses": [
                    {
                        "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                        "entry_id": "89e12770-eb5e-3f1b-a830-bf13602cfd27",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7040c212-679b-4858-8e5c-86a1e0804305",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Frau Knaudt ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "23bd4f61-cae1-40e7-b545-a0024c4b7b25",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Herr Knaudt wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "1fa9ed2a-8e12-49e6-a872-7855ae721bf5",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Die Knaudts fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "acf2981a-6799-423a-a93d-b8bb500fd244",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Der Knaudt trägt nie die Schals, die die Knaudt ihm strickt."
                            },
                            {
                                "example_id": "3e97cf37-860d-4f7a-8363-1325cf723261",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Knaudt kommt, geht der Herr Knaudt.“"
                            },
                            {
                                "example_id": "57c20fd6-3e9f-47e7-be56-429f8409c8ba",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Knaudt kommt und geht."
                            },
                            {
                                "example_id": "712871d5-cdb1-48ea-abda-15cadd0cb943",
                                "sense_id": "ccc6c259-0f8b-3091-8406-462a32a210aa",
                                "text": "Knaudts kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
