                "senses": [
                    {
                        "sense_id": "cadf393b-4829-3fa4-84e3-c6fe84a13bca",
                        "entry_id": "ffcd7861-c1c3-3e43-9409-9a4bbe9d1b23",
                        "glosses": [
                            "heel erg vriendelijk tegen iemand doen omdat je een liefdesrelatie met die persoon wilt aangaan"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1f6033b8-6b5f-4f46-8cbe-f13ce878d1e7",
                                "sense_id": "cadf393b-4829-3fa4-84e3-c6fe84a13bca",
                                "text": "Niet alle mannen zijn even romantisch, maar sommige excelleren in hofmakerij: dat bevestigt dit filmpje maar eens."
                            },
                            {
                                "example_id": "05f5387f-ed93-4982-b42d-cfa99b186deb",
                                "sense_id": "cadf393b-4829-3fa4-84e3-c6fe84a13bca",
                                "text": "Hoofdonderzoeker Nick Neave en collega's gaan ervan uit dat dansen te maken heeft met het lokken van een partner. Zoals ze in formele wetenschapstaal noteren: 'Dans komt veelvuldig tot uitdrukking in een context van hofmakerij'."
                            }
                        ]
                    },
                    {
                        "sense_id": "108a6f30-e809-3a93-a0b9-8c3a78024d69",
                        "entry_id": "ffcd7861-c1c3-3e43-9409-9a4bbe9d1b23",
                        "glosses": [
                            "vriendelijk tegen elkaar doen om tot een samenwerking te komen"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "fa3e4204-990e-4aaa-9525-e0530474eab8",
                                "sense_id": "108a6f30-e809-3a93-a0b9-8c3a78024d69",
                                "text": "Door de mislukte voorzomerse hofmakerij staan SP en PvdA verder van elkaar af dan ooit. Wel waagt nu vakbond FNV een poging de scherven te lijmen en alsnog een links ’zorgblok’ te vormen. Ook GroenLinks wordt daarbij betrokken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "632f1b8c-c1ee-40b6-be8d-cbc1d6151c44",
                        "source_entry_id": "ffcd7861-c1c3-3e43-9409-9a4bbe9d1b23",
                        "source_sense_id": "cadf393b-4829-3fa4-84e3-c6fe84a13bca",
                        "target_lang_word": "courtship behaviour",
