                ],
                "senses": [
                    {
                        "sense_id": "633460a9-c64e-3a7b-be39-240f0c88c0ed",
                        "entry_id": "158a1faf-0e97-3aaf-8619-81efd2e42cec",
                        "glosses": [
                            "Vorgang des Auftragens einer Schicht aus oder auf Kunststoff"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6308faab-1e0a-48ce-aefe-0c10a917d8e0",
                                "sense_id": "633460a9-c64e-3a7b-be39-240f0c88c0ed",
                                "text": "„Anders als bei einigen Holz- oder Metalluntergründen ist bei vielen Kunststoffoberflächen eine Beschichtung aus Gründen des Sachwertschutzes nicht zwangsläufig nötig. Dennoch muss sich der Maler und Lackierer immer wieder mit der Kunststoffbeschichtung auseinandersetzen.“"
                            },
                            {
                                "example_id": "8526864b-d669-4017-9596-e7aad5a9c337",
                                "sense_id": "633460a9-c64e-3a7b-be39-240f0c88c0ed",
                                "text": "„Die Kunststoffbeschichtung stellt aufgrund der Materialrelevanz besondere Anforderungen an den Beschichter.“"
                            },
                            {
                                "example_id": "1b53ea85-4758-4b69-ac2f-cad0d13decdd",
                                "sense_id": "633460a9-c64e-3a7b-be39-240f0c88c0ed",
                                "text": "„Als Spezialist für Kunststoffbeschichtungen tragen wir unsere Kunststoff-Beschichtung in einem speziellen Hochdruckverfahren auf Ihre Objekte / Produkte auf, um diese vor Witterungseinflüssen und physischen Beanspruchungen zu schützen.“"
                            },
                            {
                                "example_id": "7830d596-afc3-479a-946d-32f472f83c2f",
                                "sense_id": "633460a9-c64e-3a7b-be39-240f0c88c0ed",
                                "text": "„Egal, ob Schwimmbäder, Dächer, Fußböden, Deiche, Kläranlagen, Kanäle, Abwassertanks oder Tankstellen – die Kunststoffbeschichtung kann in diversen Bereichen eingesetzt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                        "entry_id": "158a1faf-0e97-3aaf-8619-81efd2e42cec",
                        "glosses": [
                            "eine aufgetragene oder aufzutragende Kunststoffschicht"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c8333f05-8e24-42b7-b8d3-02f4ee662c7c",
                                "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                                "text": "„Die Kunststoffbeschichtung bildet eine perfekte Oberflächenveredelung für Metallteile aller Art.“"
                            },
                            {
                                "example_id": "aabada04-7fc5-4a49-81df-454116e29967",
                                "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                                "text": "„Folienbeschichtungen sind eine weitere Möglichkeit der festen Kunststoffbeschichtungen von Badmöbeln.“"
                            },
                            {
                                "example_id": "b5508bdb-836d-4a30-a424-da183f859c0e",
                                "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                                "text": "„Durch die vielfältigen Merkmale von der Kunststoffbeschichtung (PTFE, FEP, PFA, ECTFE), PEEK© und SOL-GEL bieten sich zahlreiche Einsatzmöglichkeiten an, um die Standzeit Ihrer Anlagen in allen Branchen in nahezu allen Prozessen zu verlängern.“"
                            },
                            {
                                "example_id": "b19d2769-9eaf-42e1-b94f-430849bf197a",
                                "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                                "text": "„Die Kunststoffbeschichtung, auch Pulverbeschichtung oder Pulverlackierung genannt, schafft sehr strapazierfähige, extrem stoß- und kratzfeste Oberflächen und sichert so in allen Anwendungsbereichen hochwertige Oberflächenqualität und wirksamen Schutz gegen Korrosion.“"
                            },
                            {
                                "example_id": "d55e002a-f688-47a6-874a-ac13ef2d361e",
                                "sense_id": "db4530d0-7b25-3674-92ed-76befd6230b4",
                                "text": "„Edelstahlkabelbinder mit Kunststoffbeschichtung bieten einen hohen Installationskomfort, insbesondere im Außeneinsatz bei niedrigen Temperaturen.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
