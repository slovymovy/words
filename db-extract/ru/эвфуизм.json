                        "cross_references": []
                    },
                    {
                        "translation_id": "c2310a51-d186-4fcb-b263-4698000bd0ea",
                        "source_entry_id": "c5ad1ecd-7e5c-355e-8e49-d03d8b6ff592",
                        "source_sense_id": "4eec90eb-fc03-33c1-a316-c32cc18e2958",
                        "target_lang_word": "Euphuismus",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euphuismus",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "d88fda16-0863-3336-903e-a2ccbc9f6768",
                                        "entry_id": "c12a6659-ee38-3045-adb0-d1c2eacf17f8",
                                        "glosses": [
                                            "schwülstige Ausdrucksweise in der Literatur"
                                        ],
                                        "tags": [
                                            "Literaturwissenschaft"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2181d6a-c9b1-4ef8-9b6e-ba70674e53f1",
                                                "sense_id": "d88fda16-0863-3336-903e-a2ccbc9f6768",
                                                "text": "Der Euphuismus zeichnet sich durch sehr lange Sätze, eigenartige Vergleiche und ein besonderes Pathos aus."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "24c8e49d-7516-4e80-b6a7-35a9b5fbca04",
                        "source_entry_id": "c5ad1ecd-7e5c-355e-8e49-d03d8b6ff592",
                        "source_sense_id": "4eec90eb-fc03-33c1-a316-c32cc18e2958",
                        "target_lang_word": "eufuizm",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "1af8383c-f6fb-4163-be58-66d0f467850c",
                        "source_entry_id": "c5ad1ecd-7e5c-355e-8e49-d03d8b6ff592",
                        "source_sense_id": "4eec90eb-fc03-33c1-a316-c32cc18e2958",
                        "target_lang_word": "euphuisme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphuisme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1258ef8b-6170-3aaa-8144-b8fcd33ab914",
                                        "entry_id": "e44f4189-a85a-344a-a530-196803334b8b",
                                        "glosses": [
                                            "Style précieux qui était à la mode en Angleterre à la cour d’Élisabeth Iʳᵉ."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5cb927c0-b296-416e-9951-6aa460eb7770",
                                                "sense_id": "1258ef8b-6170-3aaa-8144-b8fcd33ab914",
                                                "text": "Le faux esprit régnait alors presque partout, – en Angleterre en Italie, en Espagne, en France, – sous différents noms. En Italie, c’étaient les concetti, ou le Marinisme ; en Espagne, les conceptos, ou agudezas (les pointes), ou le Gongorisme, ou le cultisme ; en Angleterre, l’euphuïsme ; en France, l’esprit précieux."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5bf73512-167a-374e-b8b2-3817300eecd3",
                                        "entry_id": "e44f4189-a85a-344a-a530-196803334b8b",
                                        "glosses": [
                                            "Style affecté."
                                        ],
                                        "tags": [
                                            "broadly",
                                            "literary"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e584da5d-af28-4349-861a-0499fee8527c",
                                                "sense_id": "5bf73512-167a-374e-b8b2-3817300eecd3",
                                                "text": "Plût à Dieu ! madame, nous ne serions pas obligés, quelques beaux esprits de mes amis et moi, de réveiller dans cette pauvre France, engourdie aux bas-fonds de la vulgarité roturière, la politesse des siècles monarchiques et chrétiens, la prudhomie du goût, les grâces de l’euphuisme et les allures fringantes du style gentilhomme."
                                            },
                                            {
                                                "example_id": "1c61f5ec-20ae-48d3-9dbd-82bfecfaf7a9",
                                                "sense_id": "5bf73512-167a-374e-b8b2-3817300eecd3",
                                                "text": "Ces mots s’appellent les uns les autres, éveillés par la consonance, et, sur ces sonorités, ils rebondissent en se multipliant. Ce sont les arabesques de style, les préciosités, les mignardises, l’euphuisme des époques entêtées de recherches."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "48a65c70-5b63-4a64-b0df-3a693c376a82",
                        "source_entry_id": "c5ad1ecd-7e5c-355e-8e49-d03d8b6ff592",
                        "source_sense_id": "4eec90eb-fc03-33c1-a316-c32cc18e2958",
                        "target_lang_word": "euphuïsme",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "euphuïsme",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7817eae8-f9fb-37d4-a935-cd46ad6ed3de",
                                        "entry_id": "73b7d85a-8c94-3967-8468-aea64a083052",
                                        "glosses": [
                                            "Variante de euphuisme."
                                        ],
                                        "tags": [
                                            "alt-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "649f4407-52b0-41b2-8faf-175022f4a651",
                                                "sense_id": "7817eae8-f9fb-37d4-a935-cd46ad6ed3de",
                                                "text": "Apparut soudain un être brusque, négligé, professant autant de mépris pour l’euphuïsme que pour l'étiquette."
                                            },
                                            {
                                                "example_id": "f9ed5529-ccf7-4f5b-af5b-deaff7192712",
                                                "sense_id": "7817eae8-f9fb-37d4-a935-cd46ad6ed3de",
                                                "text": "Les manuels de littérature disent et répètent que la préciosité n’est que l’aspect français d’un mouvement européen qu’on appelle en Angleterre euphuïsme, en Italie marinisme, en Espagne gongorisme."
                                            },
                                            {
                                                "example_id": "3ee31bee-01bb-4d78-9a9b-bada3bf832ba",
                                                "sense_id": "7817eae8-f9fb-37d4-a935-cd46ad6ed3de",
                                                "text": "Mais à d'autres moments de l'histoire, l'artiste se flatte de n'être compris que d'une élite (euphuïsme élisabéthain, \"art pour l'art\" de 1890)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
