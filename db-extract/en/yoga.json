                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "yoga",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e0ac1808-3d2b-3dc6-a324-c3942e3efdef",
                                        "entry_id": "5b386926-e79c-3c3e-b7ea-c4ee8849664a",
                                        "glosses": [
                                            "Discipline visant, par la méditation, la gymnastique et l’ascèse à réaliser l’unification de l’être dans ses aspects psychique, physique et spirituel."
                                        ],
                                        "tags": [
                                            "Hinduism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ef19b1b3-d781-4073-8e95-f395646f2119",
                                                "sense_id": "e0ac1808-3d2b-3dc6-a324-c3942e3efdef",
                                                "text": "Pour beaucoup cette perception est goût « exotique », art d’agrément ; on s’intéresse au Moyen Âge comme l’on ferait de la peinture sur soie ou du yoga."
                                            },
                                            {
                                                "example_id": "389b1403-c4eb-4c70-af89-b4db4bcbef71",
                                                "sense_id": "e0ac1808-3d2b-3dc6-a324-c3942e3efdef",
                                                "text": "Depuis des millénaires, la voie a été désignée comme « l'union des contraires » (c'est le sens étymologique du mot yoga) ou « la réconciliation des opposés »."
                                            },
                                            {
                                                "example_id": "beaa7796-1cfe-40b9-80e7-01b9f0d5b238",
                                                "sense_id": "e0ac1808-3d2b-3dc6-a324-c3942e3efdef",
                                                "text": "Le yoga est la base de toutes les pratiques corporelles, rappellent le Dʳ Bernadette de Gasquet et Jean-Paul Bouteloup dans leur guide Yoga sans dégâts."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2073baf-aa35-4b96-b611-667555801df4",
                        "source_entry_id": "bd255194-2a1c-3b46-852d-da8018fd4c7f",
                        "source_sense_id": "1e476caf-80b5-3bc0-8fe3-0eaca078b992",
