                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "924016ac-bacb-41c9-ae3c-e2795246abd3",
                                                "sense_id": "2340e94f-b7e1-301f-a4db-d978fc31ff71",
                                                "text": "Der Accent circonflexe gibt in den meisten Fällen den Ausfall eines altfranzösischen s an."
                                            },
                                            {
                                                "example_id": "d2984bd8-9aeb-41ad-9626-7d34939dca46",
                                                "sense_id": "2340e94f-b7e1-301f-a4db-d978fc31ff71",
                                                "text": "Der Accent circonflexe ist der einzige Akzent, der im Französischen auf fünf Vokalen stehen kann: â, ê, î, ô und û."
                                            },
                                            {
                                                "example_id": "1bd405e6-8857-4322-8975-1f2826920854",
                                                "sense_id": "2340e94f-b7e1-301f-a4db-d978fc31ff71",
                                                "text": "Das Wort » pêle-mêle « wird mit zwei Accents circonflexes geschrieben."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
