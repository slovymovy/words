    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "dfa3b60a-de6b-3edf-956a-0bc936a4963e",
                    "sense_definition": "simple past and past participle of <w>ordain</w>",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The church elders <w>ordained</w> two new pastors during the Sunday morning service.",
                            "target_lang_translations": {
                                "ru": "Старейшины церкви <w>рукоположили</w> двух новых пасторов во время воскресного утреннего богослужения."
                            }
                        },
                        {
                            "text": "Many believe that fate had <w>ordained</w> their unexpected meeting in the ancient city.",
                            "target_lang_translations": {
                                "ru": "Многие верят, что судьба <w>предопределила</w> их неожиданную встречу в древнем городе."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "past tense and past participle"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Прошедшее время и причастие прошедшего времени от глагола ordain (посвящать в духовный сан; предназначать, предопределять)."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукоположил",
                                "target_lang_sense_clarification": "в церковный сан"
                            },
                            {
                                "target_lang_word": "посвятил",
                                "target_lang_sense_clarification": "в духовный сан"
                            },
                            {
                                "target_lang_word": "предопределил",
                                "target_lang_sense_clarification": "о судьбе или высшей воле"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "27f8cd01-edb4-3d32-91de-0e771da84e29",
                    "sense_definition": "Officially admitted or invested with priestly or ministerial authority in a religious body.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "religious_ministry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She has served as an <w>ordained</w> minister in her local community for over twenty years.",
                            "target_lang_translations": {
                                "ru": "Она служит <w>рукоположенным</w> священнослужителем в своей местной общине уже более двадцати лет."
                            }
                        },
                        {
                            "text": "Only an <w>ordained</w> priest is permitted to perform this sacred wedding ceremony.",
                            "target_lang_translations": {
                                "ru": "Только <w>посвященному в сан</w> священнику разрешено совершать это священное венчание."
                            }
                        }
                    ],
                    "antonyms": [
                        "unordained"
                    ],
                    "common_phrases": [
                        "ordained minister",
                        "ordained priest"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально посвященный в духовный сан или наделенный пастырскими полномочиями в религиозной общине."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рукоположенный",
                                "target_lang_sense_clarification": "принявший сан через рукоположение"
                            },
                            {
                                "target_lang_word": "посвященный в сан",
                                "target_lang_sense_clarification": "имеющий священнический сан"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "32c1a820-63bc-3a29-9d4f-b8f63701eb30",
                    "sense_definition": "Fixed, appointed, or settled authoritatively or by destiny.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "established_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The citizens were expected to strictly follow the divinely <w>ordained</w> laws of the kingdom.",
                            "target_lang_translations": {
                                "ru": "От граждан требовалось строго следовать божественно <w>установленным</w> законам королевства."
                            }
                        },
                        {
                            "text": "He felt that his eventual rise to power was a preordained and naturally <w>ordained</w> event.",
                            "target_lang_translations": {
                                "ru": "Он чувствовал, что его приход к власти был заранее предначертанным и естественно <w>предопределенным</w> событием."
                            }
                        }
                    ],
                    "synonyms": [
                        "appointed",
                        "decreed"
                    ],
                    "common_phrases": [
                        "divinely ordained"
                    ],
                    "target_lang_definitions": {
                        "ru": "Установленный свыше, властно предписанный или предопределенный судьбой."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предопределенный",
                                "target_lang_sense_clarification": "судьбой или свыше"
                            },
                            {
                                "target_lang_word": "установленный",
                                "target_lang_sense_clarification": "высшим законом или властью"
                            },
                            {
                                "target_lang_word": "предписанный",
                                "target_lang_sense_clarification": "о законах или правилах"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}