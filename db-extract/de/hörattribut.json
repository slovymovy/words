                "senses": [
                    {
                        "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                        "entry_id": "68797970-c527-3488-89fb-1a078b5e12a0",
                        "glosses": [
                            "qualitative Bezeichnung von reinen Höreigenschaften bzw. Hörempfindungen im eigentlichen Sinn"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1c61ddda-40fb-4087-982c-1b19eb4f7e46",
                                "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                                "text": "„Schließlich gehören dazu die Hörattribute Volumen, Schärfe und Klanghaftigkeit.“"
                            },
                            {
                                "example_id": "ba445fb7-c3ba-483d-a17e-b5bc0b74b83d",
                                "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                                "text": "„Hat man auf diesem Weg eine Ordnung für die in der Wahrnehmung relevanten Hörattribute gefunden, kann für die künftige Beurteilung ähnlicher Schalle ein verkürztes SD konstruiert werden, das nur noch aus jenen Adjektivskalen besteht, welche die Faktorenstruktur am besten repräsentieren.“"
                            },
                            {
                                "example_id": "32e84c2b-27da-413b-a751-eb2292b4ba4e",
                                "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                                "text": "„Die einzelnen Hörattribute werden zu einem Gesamteindruck zusammengefasst.“"
                            },
                            {
                                "example_id": "53b6ed88-4741-41aa-9bee-40117ec660f4",
                                "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                                "text": "„Diese lautet: Tonhöhe ist dasjenige Hörattribut eines Schalles, welches man hinsichtlich eines Aspekts, den man […]“"
                            },
                            {
                                "example_id": "2b56ee93-ae1b-452d-98b5-a0b32329dd17",
                                "sense_id": "021e222c-251e-3df5-bcf4-3bf64850c1f0",
                                "text": "„Die Definition der Klangfarbe wurde zum Teil schon in Abschnitt 10.3.3 vorweggenommen, weil dies zur Erklärung des prothetischen Hörattributs Klanghaftigkeit erforderlich war.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
