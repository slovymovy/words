                                        "sense_id": "52d08756-23b6-3404-b00d-3615b7a54023",
                                        "entry_id": "6d28906a-4eab-3ed7-bc4b-835f090f67fd",
                                        "glosses": [
                                            "Someone or something, especially, a television station, that is associated with a larger, related organization, such as a television network; a member of a group of associated things."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "24586d07-8a28-4324-8cc9-5b6f17479134",
                                                "sense_id": "52d08756-23b6-3404-b00d-3615b7a54023",
                                                "text": "Our local TV channel is an affiliate of NBC."
                                            },
                                            {
                                                "example_id": "94b4dca5-2e1c-416d-963c-ee9534057ee5",
                                                "sense_id": "52d08756-23b6-3404-b00d-3615b7a54023",
                                                "text": "They used to been^([sic]) more of a Detroit channel, as they had showed a lot of American programs, aside from being the CBC affiliate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "affiliate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "74e344c2-6d1f-3445-b30b-edd57fae308a",
                                        "entry_id": "6f1c2534-5841-36a4-870b-3f44b9b51afb",
