                "senses": [
                    {
                        "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                        "entry_id": "e67ecbd9-43c8-3e8d-9f44-e15cb57f7f85",
                        "glosses": [
                            "Charakter, Art eines Spiels, auch in metaphorischer Verwendung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "de6b4959-2265-481c-ab30-2910e82a0638",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Spielformen, die einen recht engen, sensiblen Körperkontakt abfordern wie Fühlgang, Kettenzug oder Vertrauenskreis, sollten in der Regel erst dann angeboten werden, wenn sich die Gruppenmitglieder schon näher kennengelernt haben.“"
                            },
                            {
                                "example_id": "744dd0fc-771e-4bb5-a330-58b7c90c1880",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Nicht nur das Spiel selbst unterliegt kulturellem Wandel, auch die Wertschätzung verschiedener Spielformen ist kulturbedingt.“"
                            },
                            {
                                "example_id": "e3df15f5-4e1d-46c1-9a46-abec389c0945",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Die Sportwissenschaft unterteilt diese Spielformen in die beiden Hauptgruppen ‚Kleine Bewegungsspiele‘ und ‚Große Sportspiele‘.“"
                            },
                            {
                                "example_id": "d62f44a3-d1e5-4caa-ae2b-71e869de3349",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Das Rollenspiel ist eine sehr flexible Spielform.“"
                            },
                            {
                                "example_id": "27009c62-44b5-4f2a-a3f4-40c17733a818",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Die hier verwendeten Spielformen fassen mehrere, oft unterschiedliche Merkmale in einer Art Oberbegriff zusammen.“"
                            },
                            {
                                "example_id": "fa86a317-143f-4f28-93f4-ea67cb067f68",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Eine liebenswürdige Spielform der Mathematik ist die Ornamentik, das Ausfüllen von Flächen mit geometrischen Mustern.“"
                            },
                            {
                                "example_id": "62560550-7807-4567-b9f1-e846db936401",
                                "sense_id": "016e6216-be5d-39fb-95fc-08ecf56a478b",
                                "text": "„Auch der sozialistische Mensch ist nur ein Gleichnis – eine Spielform des universalen Scheiterns, das allein Kunst uns erträglich macht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                        "entry_id": "e67ecbd9-43c8-3e8d-9f44-e15cb57f7f85",
                        "glosses": [
                            "Art und Weise, Variante des Spielens"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d89f5065-dd2d-4e00-ac55-217a1cfce1c4",
                                "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                                "text": "„Er ist sehr kreativ, was die Entwicklung neuer Spielformen angeht, und überrascht immer wieder damit, dass er mit großem Erfolg wie bei Raphael Guerreiro neue und bislang ungeahnte Positionen für seine Spieler findet, sagte Rauball.“"
                            },
                            {
                                "example_id": "dc99e919-4ec8-4897-af20-a0fea12ad71c",
                                "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                                "text": "„Um Spielformen üben zu können, holte der 47 Jahre alte Bundesliga-Coach für die beiden Einheiten am Dienstag sechs Nachwuchsakteure in sein Aufgebot.“"
                            },
                            {
                                "example_id": "6555524d-069b-4ef1-abc0-19f775b20855",
                                "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                                "text": "„Als Spielformen geübt wurden, gab er lautstark Anweisungen an die Profis weiter.“"
                            },
                            {
                                "example_id": "dee32d74-9eec-4adf-a0dd-92bf35f9593b",
                                "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                                "text": "„Coach Ewald Lienen ließ seine Profis am Montag Passübungen und Spielformen auf dem Kleinfeld absolvieren, teilte der Kiezclub dazu via Twitter mit.“"
                            },
                            {
                                "example_id": "fd4b93e1-4658-40c4-b778-cbfd333a9380",
                                "sense_id": "cfdc1f53-1f45-314b-be36-c3621045da90",
                                "text": "„In den Spielformen ging es aggressiv zur Sache.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
