                                        "entry_id": "b68117a7-5515-3eeb-8512-b79023781166",
                                        "glosses": [
                                            "Producing a voltage when exposed to light."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "99ab0104-04bf-4a0e-9244-09da8e80196a",
                                                "sense_id": "bf1a9f8b-b6bf-394c-9913-f74ec0692bb2",
                                                "text": "But the truly impressive part of this entry is the photovoltaic film that has been applied to the platform and entrance roofs (all 272 square metres of it). It is a UK first for the railway, and is expected to generate 36kW of electricity to meet the needs of the station itself and to feed the surplus back to the grid."
                                            }
                                        ]
