                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "burgomestre",
                                "target_lang_code": "pt",
                                "target_senses": [
                                    {
                                        "sense_id": "fad6d6fc-d39d-3ef1-bb1c-7ad18c9d6064",
                                        "entry_id": "53cdc92b-c31a-332f-93c5-ecc56dd16072",
                                        "glosses": [
                                            "principal autoridade municipal em países como a Alemanha, Bélgica, Holanda e outros"
                                        ],
                                        "tags": [
                                            "Política"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a2451bc-5ade-4844-b1d0-a476c9bc7b9f",
                                                "sense_id": "fad6d6fc-d39d-3ef1-bb1c-7ad18c9d6064",
                                                "text": "O dia da partida chegara, a fragata austríaca Novara e a fragata francesa Thémis fundearam no porto de Trieste, todo um enxame de arquiduques e arquiduquesas concorrera ao bota-fora, o burgomestre, em nome dos habitantes da cidade, significara ao novo imperador a viva saudade que ele deixava, e Maximiliano, abraçando o burgomestre, sentira os olhos inundados de lágrimas, e o coração atormentado por um vago pressentimento de desgraça."
                                            },
                                            {
                                                "example_id": "07ad6505-cd1b-4da1-be8e-33515e911963",
                                                "sense_id": "fad6d6fc-d39d-3ef1-bb1c-7ad18c9d6064",
                                                "text": "Em Montevideo, o Burgomestre Olaf Scholz será recebido pelo Presidente José Mujica para conversações."
                                            },
                                            {
                                                "example_id": "558e3d6e-de67-4774-b2ba-8c9f1b3e050c",
                                                "sense_id": "fad6d6fc-d39d-3ef1-bb1c-7ad18c9d6064",
                                                "text": "Natalie Silva é a nova burgomestre de Larochette, conhecida como a localidade mais portuguesa do Luxemburgo."
                                            },
                                            {
                                                "example_id": "47df2c96-c1a0-451f-914c-c97aec4df043",
                                                "sense_id": "fad6d6fc-d39d-3ef1-bb1c-7ad18c9d6064",
                                                "text": "Durante esse triênio como \"burgomestra\" (cargo semelhante ao de prefeita) de Molenbeek, Françoise viu vários moradores da área se envolverem em atentados jihadistas."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c2dedb3e-a18b-4e50-b96e-df817b2ac252",
