                        "cross_references": [
                            {
                                "target_word": "Armbrustschütze",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c8f3ee0b-1f84-37a7-a273-8dee9adcf417",
                                        "entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                                        "glosses": [
                                            "Sportler, der mit einer Armbrust schießt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bf5b116d-e5ab-448f-a788-c2187fd3ba0a",
                                                "sense_id": "c8f3ee0b-1f84-37a7-a273-8dee9adcf417",
                                                "text": "„Eidgenössischer Armbrustschützenverband (kurz: EASV) (französisch: Association Fédérale de tir à l'arbalète) ist der Dachverband der Armbrustschützen für Breitensport und Leistungssport in der Schweiz, er wurde am 17. Juli 1898 gegründet.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                                        "entry_id": "959ad3bd-a0be-3cc2-9a3d-bf7949780338",
                                        "glosses": [
                                            "Soldat, der mit einer Armbrust bewaffnet ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0520f9c-6124-4b7e-8625-be6a36a2cded",
                                                "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                                                "text": "„Eine neue Waffe schwamm jetzt im trüben Wasser des Sees: 13 kleine Kriegsschiffe, Brigantinen, bemannt mit Armbrustschützen und Musketieren.“"
                                            },
                                            {
                                                "example_id": "1393e83d-394c-442a-b132-cf675139b1cf",
                                                "sense_id": "b0be5986-e86d-3aaf-b213-4db97b2c0f1b",
                                                "text": "„Das Laden erfolgt von vorn und dauert einige Minuten, in denen Armbrustschützen weiter ihre Pfeile verschießen können.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f2898e57-496b-4650-8566-dedfc46016ef",
                        "source_entry_id": "7f714abb-1eca-3847-9a42-4c4c1c740bb5",
