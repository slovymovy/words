                        "entry_id": "3973333d-6b89-380e-9d68-d6e9a9948f7e",
                        "glosses": [
                            "Person, die beruflich feinmechanische elektrische, elektronische oder optische Geräte oder Bauteile herstellt und repariert"
                        ],
                        "tags": [
                            "Beruf"
                        ],
                        "examples": [
                            {
                                "example_id": "4e526db3-1f60-4d58-bf86-adee094d4d3d",
                                "sense_id": "18285c29-eba2-3d1b-9820-5f07da4b9aea",
                                "text": "Der Feinmechaniker ist ein anerkannter Ausbildungsberuf nach der Handwerksordnung."
                            },
                            {
                                "example_id": "a584bd46-d77b-4114-8824-849c23da4e26",
                                "sense_id": "18285c29-eba2-3d1b-9820-5f07da4b9aea",
                                "text": "Am Ende der Ausbildungszeit wird die Abschlussprüfung zum Feinmechaniker gemacht."
                            },
                            {
                                "example_id": "e7c2cc97-1447-4127-a37a-c7707c7749e7",
                                "sense_id": "18285c29-eba2-3d1b-9820-5f07da4b9aea",
                                "text": "Feinmechaniker arbeiten in Produktionsstätten und Werkstätten für Maschinen mit Präzisionsmechanik."
                            }
                        ],
