                                        "examples": [
                                            {
                                                "example_id": "4ff5b5a0-1869-4723-be40-63357fbd5e84",
                                                "sense_id": "2071c60c-0773-3503-9048-f16947e1bd78",
                                                "text": "Druk hierna op de meest linkse knop."
                                            },
                                            {
                                                "example_id": "c95a18af-c1a1-4236-a1e0-436016b0bb76",
                                                "sense_id": "2071c60c-0773-3503-9048-f16947e1bd78",
                                                "text": "De bewaker links verplaatste zijn voeten iets, verstandige schoenen die dreiging uitbeeldden."
                                            },
                                            {
                                                "example_id": "58d67aaa-e6f7-4129-a653-27a9002bd7d0",
                                                "sense_id": "2071c60c-0773-3503-9048-f16947e1bd78",
                                                "text": "Onderweg naar de uitgang van het kleine vliegveld word ik links en rechts ingehaald."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d07416a-04b7-33eb-8cbb-116a6f024d0a",
                                        "entry_id": "ff98517e-3183-3122-abf2-72cf1660a296",
                                        "glosses": [
                                            "betrekking hebbend op een politieke richting of denkwijze aan de linkerzijde van het politieke spectrum"
                                        ],
