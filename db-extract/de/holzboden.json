                "senses": [
                    {
                        "sense_id": "159f379a-4137-36c3-aab9-d4c8294ead63",
                        "entry_id": "b872c7e8-fe2c-35b2-b1ef-50c334c4306c",
                        "glosses": [
                            "Bodenbelag, der aus einer bestimmten Holzart besteht"
                        ],
                        "tags": [
                            "Innenarchitektur"
                        ],
                        "examples": [
                            {
                                "example_id": "18b54828-b8ee-41bd-962f-5bc891777beb",
                                "sense_id": "159f379a-4137-36c3-aab9-d4c8294ead63",
                                "text": "„Wenn in einem Gebäude aus dem 19. bzw. frühen 20. Jahrhunderts Sanierungsarbeiten an Dielen- oder Holzböden anstehen, sind in vielen Fällen die Auflagen des Denkmalschutzes zu befolgen.“"
                            },
                            {
                                "example_id": "1b1a4334-8101-414d-bd14-d2435f8c17b8",
                                "sense_id": "159f379a-4137-36c3-aab9-d4c8294ead63",
                                "text": "„Detes Schritte auf dem Holzboden hatten Mia geweckt, und im Moment des Wachwerdens war ihr ein seltsamer Gedanke in den Kopf gestiegen, der vor dem Einschlafen darin keinen Platz gefunden hatte, der sie jetzt aber im Nu hellwach machte und ins Rechnen brachte.“"
                            },
                            {
                                "example_id": "7db9e3b7-a17b-4dee-8d08-ae8ef625a9bd",
                                "sense_id": "159f379a-4137-36c3-aab9-d4c8294ead63",
                                "text": "„Sie ist die einzige Lichtquelle in dem Zimmer, der Holzboden reflektiert sie schwach.“"
                            },
                            {
                                "example_id": "c5f40ce2-6919-4ee3-a7f8-dece7c9f0813",
                                "sense_id": "159f379a-4137-36c3-aab9-d4c8294ead63",
                                "text": "„In der Weinstube saßen immer Einheimische in Nagelstiefeln und Gebirgstracht, und die Luft war voller Rauch und der Holzboden von den Nägeln zerkratzt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e660a970-0653-386e-ab7a-8ebc27c5ac48",
