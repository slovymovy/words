                ],
                "senses": [
                    {
                        "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                        "entry_id": "1da34d3b-7b51-3e12-8cdf-30a196db3699",
                        "glosses": [
                            "Kenntnisse, Erlebnisse und Kompetenzen (also Erfahrungen), die jemand durch aktives Laufen erworben hat"
                        ],
                        "tags": [
                            "Laufsport"
                        ],
                        "examples": [
                            {
                                "example_id": "9670315d-0b27-4af4-8741-9e01cc64f97a",
                                "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                                "text": "„Die Jungendlichen können sich auf der ca. 2 km Strecke austoben und die Kleinsten beim Bambinilauf (400m) erste Lauferfahrungen sammeln.“"
                            },
                            {
                                "example_id": "19a14801-8e6b-4bba-b59a-511fb4134aae",
                                "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                                "text": "„Unter unserer kompetenten Anleitung helfen wir ihnen, alte frustrierende Lauferfahrungen abzubauen und ihnen neue Freude an der Bewegung zu geben.“"
                            },
                            {
                                "example_id": "75e7aa1c-e26f-402d-8cda-5351dc87fd12",
                                "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                                "text": "„Die Auswertung der PatientInnen-Daten [sic] ergab ein Durchschnittsalter von 33 Jahren, eine Lauferfahrung von rund sieben Jahren und ein wöchentliches Laufpensum von rund 3 Stunden pro Woche.“"
                            },
                            {
                                "example_id": "94fe7110-65c8-4a94-a408-e7fb69e51d7a",
                                "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                                "text": "„Du würdest gerne mit dem Laufen anfangen, oder an einem Lauf wie zum Beispiel dem Firmenlauf teilnehmen, bist aber unsicher, weil du keinerlei Lauferfahrung hast?“"
                            },
                            {
                                "example_id": "5b967ef1-ccbd-4645-8e30-feb1ed765940",
                                "sense_id": "7e5a26b9-de7d-3f99-9560-fe88b8dd7222",
                                "text": "„Das Wetter hat dazu eingeladen, im Zielbereich einfach noch ein wenig zu Plaudern und Lauferfahrungen auszutauschen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
