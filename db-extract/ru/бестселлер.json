                        ]
                    },
                    {
                        "translation_id": "b11e1979-6c7b-4a81-bc9d-44067b112005",
                        "source_entry_id": "fc9995d7-336d-3cbc-b728-3c3279c78c95",
                        "source_sense_id": "757649ae-77aa-3ff7-9f9f-b775bd05a5b5",
                        "target_lang_word": "Bestseller",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bestseller",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                        "entry_id": "759467b7-bfee-3d06-955a-af2e70f7f3e6",
                                        "glosses": [
                                            "Produkt, das sehr viel verkauft wird und (bei Büchern) in Bestsellerlisten erscheint"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "461c443d-e08b-4df2-8f5b-ba7e630dc347",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "In einer großen Buchhandlung finde ich viele Bestseller."
                                            },
                                            {
                                                "example_id": "e71dfcdf-2a45-4a99-82c1-273f2fcaab41",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Etablierte Bestseller wie Q5 (2016) und Q7 (bereits 2014) erhalten Nachfolger, Lücken im Q-Programm werden mit neuen Modellen aufgefüllt.“"
                                            },
                                            {
                                                "example_id": "cd4e49d7-9ddc-4e11-b5ea-e5cf3f97e839",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Frankreichbücher sind in Deutschland immer wieder Bestseller geworden.“"
                                            },
                                            {
                                                "example_id": "81282dc2-2c65-49c9-8501-30cf773a0985",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Und anders als die Berichte von Afrikareisenden wie Mungo Park wird sein Werk kein Bestseller.“"
                                            },
                                            {
                                                "example_id": "bf226afb-fc41-49da-acec-25a0c2f300ae",
                                                "sense_id": "999783db-a3d6-34e3-8fe3-378394b91c0c",
                                                "text": "„Der Titel selbst kam nie auch nur in die Nähe eines Bestsellers.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6a07fc07-04ed-42f0-8258-05beda827638",
                        "source_entry_id": "fc9995d7-336d-3cbc-b728-3c3279c78c95",
                        "source_sense_id": "757649ae-77aa-3ff7-9f9f-b775bd05a5b5",
                        "target_lang_word": "best-seller",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "best-seller",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "70a8f31f-5500-3061-b28f-7911c562d5e0",
                                        "entry_id": "82ab05de-aeab-3a75-9ffd-b8da86dc71a8",
                                        "glosses": [
                                            "Meilleure vente en parlant de marchandise, de produits."
                                        ],
                                        "tags": [
                                            "Anglicism"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6e55bed5-23b5-4a4c-8cd6-fc17f624ca51",
                                                "sense_id": "70a8f31f-5500-3061-b28f-7911c562d5e0",
                                                "text": "La version « homme » de notre dernier parfum est un best-seller."
                                            },
                                            {
                                                "example_id": "e6f7dd93-e195-4ae2-8f44-bf8588ef38bf",
                                                "sense_id": "70a8f31f-5500-3061-b28f-7911c562d5e0",
                                                "text": "On ne change pas une formule gagnante, puisque le constructeur se targue d'avoir écoulé neuf millions exemplaires de son \"best-seller\" depuis 2004, dont 200 000 en France."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ba52a0b4-ff39-3afb-ab4e-914d149c50e4",
                                        "entry_id": "82ab05de-aeab-3a75-9ffd-b8da86dc71a8",
                                        "glosses": [
                                            "Succès en parlant de vente de livres."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f5b3ed95-3a28-4184-9d28-d5f5a314c839",
                                                "sense_id": "ba52a0b4-ff39-3afb-ab4e-914d149c50e4",
                                                "text": "En 1788, Bernardin de Saint-Pierre publia Paul et Virginie, un des premiers best-sellers des temps modernes. Cette idylle tropicale fit pleurer Margot des décennies durant. Les demoiselles s'identifiaient à la jeune héroïne, comme elles le font aujourd'hui d'une chanteuse à la mode."
                                            },
                                            {
                                                "example_id": "c52b89b2-1652-48db-becd-5995e0c0f74e",
                                                "sense_id": "ba52a0b4-ff39-3afb-ab4e-914d149c50e4",
                                                "text": "Totalement crédible en Marylin Monroe, elle pourrait même décrocher un Oscar pour sa performance dans cette adaptation du best-seller de Joyce Caroll Oates."
                                            },
                                            {
                                                "example_id": "205d50aa-534a-401d-a617-cb8a0c228c5a",
                                                "sense_id": "ba52a0b4-ff39-3afb-ab4e-914d149c50e4",
                                                "text": "Selon le psychothérapeute Thomas d’Ansembourg, qui la décrit dans son best-seller Cessez d’être gentil, soyez vrai (Éditions de l’Homme), « Le non-respect de soi mène tôt ou tard au non-respect de l’autre »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
