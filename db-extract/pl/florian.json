                    },
                    {
                        "translation_id": "e9379d52-ca49-4850-a006-07f419f0d95c",
                        "source_entry_id": "f6af02f8-69d3-3e1a-a6cd-772bd02b0dcc",
                        "source_sense_id": "494c820d-e70b-3ed2-b757-d0f00d4f8e81",
                        "target_lang_word": "Florian",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Florian",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "52db9271-dfb4-3c9b-8aca-4efb62057138",
                                        "entry_id": "007e4a27-9f9c-3e6f-b032-8f198780f843",
                                        "glosses": [
                                            "Prénom masculin."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fa65ef41-5be9-457e-a66d-64467ed17191",
                                                "sense_id": "52db9271-dfb4-3c9b-8aca-4efb62057138",
                                                "text": "Depuis dix ans, Florian Bartsch, créateur du concept de NEW, assure la direction artistique de ce spectacle inédit à chaque représentation."
                                            },
                                            {
                                                "example_id": "45fe321a-0955-4732-bacc-39948b8cb592",
                                                "sense_id": "52db9271-dfb4-3c9b-8aca-4efb62057138",
                                                "text": "J’aurais aimé aller plus haut, bien sûr…, admet le Morbihannais Florian Martin, désormais à Valenciennes (183 rencontres de L2)."
                                            },
                                            {
                                                "example_id": "ea59fa9f-54ae-47f2-9f82-3d7f0199b427",
                                                "sense_id": "52db9271-dfb4-3c9b-8aca-4efb62057138",
                                                "text": "L’avocat de Chokri Chafroud, Florian François-Jacquemin, a estimé que « cette décision [était] une erreur »."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
