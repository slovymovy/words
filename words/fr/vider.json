            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9c80f17c-5062-39f2-b665-15a31a5b9e66",
                    "sense_definition": "Retirer ce qui est contenu dans un récipient, un espace ou un meuble pour le rendre vide.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "rendre_vide",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "N'oublie pas de <w>vider</w> la poubelle de la cuisine avant de partir au travail ce matin."
                        },
                        {
                            "text": "Avant de déménager ses affaires, il a complètement <w>vidé</w> les armoires de sa chambre."
                        }
                    ],
                    "synonyms": [
                        "évacuer"
                    ],
                    "antonyms": [
                        "remplir",
                        "combler"
                    ],
                    "common_phrases": [
                        "vider la poubelle",
                        "vider les poches"
                    ]
                },
                {
                    "sense_id": "1b2895cd-77cf-393c-9972-187cf67d9492",
                    "sense_definition": "Boire jusqu'à la dernière goutte le contenu d'un verre ou d'une bouteille.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "boire",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après cette longue course sous le soleil, il a <w>vidé</w> sa bouteille d'eau d'un trait."
                        },
                        {
                            "text": "Les invités ont rapidement <w>vidé</w> leur verre avant de porter un nouveau toast."
                        }
                    ],
                    "synonyms": [
                        "boire",
                        "épuiser"
                    ],
                    "antonyms": [
                        "remplir"
                    ],
                    "common_phrases": [
