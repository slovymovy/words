                "senses": [
                    {
                        "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                        "entry_id": "9aabd3de-1ab2-362d-b353-ed60dead8c12",
                        "glosses": [
                            "Begleitung von Musik durch ein Musikinstrument"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4377206c-d50e-4722-8bab-8ed1e5c8770f",
                                "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                                "text": "„Es entwickelte sich der mehrstimmige und Sologesang mit selbständiger Instrumentalbegleitung, sowie die freie Instrumentalmusik.“"
                            },
                            {
                                "example_id": "13f76777-795e-4ef6-85f7-d45ec6f79833",
                                "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                                "text": "„Die Instrumentalbegleitung wird stehend, bescheidene Versuche sie selbständiger zu gestalten werden bemerkbar, an passenden Stellen treten kurze Sinfonien ein.“"
                            },
                            {
                                "example_id": "250d8cfb-e730-4f78-a20c-b980e7e01468",
                                "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                                "text": "„Hier ist nicht nur die Musik für Gesang allein gemeint, sondern auch solche, die mit Instrumentalbegleitung versehen ist, wobei aber der Gesang die Hauptsache bildet.“"
                            },
                            {
                                "example_id": "cd12c217-4122-48d8-bdbf-e5e9fc28ec11",
                                "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                                "text": "„Das Programım für die musikalischen Aufführungen war, um vielseitigen Anforderungen zu entsprechen, sehr reichhaltig; es wechselten polyphone Gesangsstücke mit Piecen mit Instrumentalbegleitung von älteren und neueren Meistern.“"
                            },
                            {
                                "example_id": "865623ab-19d0-4e7d-ae78-0332a70a5cb6",
                                "sense_id": "64b0f9b8-2f09-3e47-bad2-430e9cab1e63",
                                "text": "„Schütz schrieb seine Passionen nach den vier Evangelisten 1585 bis 1672; Sebastiani bereicherte das Passionsoratorium mit dem Recitativ und mit dürftiger Instrumentalbegleitung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
