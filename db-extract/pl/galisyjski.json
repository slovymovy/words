                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8fe8c38c-22ac-3162-96e7-9dc57a9d7a61",
                                        "entry_id": "ec28bcf4-da62-3595-814a-849f85620539",
                                        "glosses": [
                                            "die spanische Region Galicien oder ihre Bewohner betreffend, zu ihr gehörend, aus ihr stammend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9277293c-40c0-4196-9416-518a4a51f9b2",
                                                "sense_id": "8fe8c38c-22ac-3162-96e7-9dc57a9d7a61",
                                                "text": "„Der galicische Schriftsteller Manuel Rivas bezeichnete in einer Ansprache den Umgang der Zentralregierung in Madrid mit der Katastrophe als ‚Schande‘ und warf dem Ministerpräsidenten vor, ‚wie ein römischer Feldherr‘ in Galicien einzuziehen.“"
                                            },
                                            {
                                                "example_id": "692a2faf-2602-4101-a837-235266e21f82",
                                                "sense_id": "8fe8c38c-22ac-3162-96e7-9dc57a9d7a61",
                                                "text": "„Zudem strebt die galicische Privatkundenbank Sabadell die Übernahme des baskischen Konkurrenten Guipuzcoana an.“"
                                            },
                                            {
                                                "example_id": "9976a65a-87e6-4af8-90ba-4263fff3a4e0",
                                                "sense_id": "8fe8c38c-22ac-3162-96e7-9dc57a9d7a61",
                                                "text": "„Bei frisch geöffneten Austern und einem Glas gekühltem Albarino kann man dort dem kulinarischen Kult der galicischen Küste anhängen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "6ddffd58-755b-34c2-8fb2-fc7029a5484c",
                                        "entry_id": "ec28bcf4-da62-3595-814a-849f85620539",
                                        "glosses": [
                                            "die Sprache der Galicier (Galicisch) betreffend, in ihr verfasst"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e2b941c5-aa5f-46b5-bb28-89e6a1b99110",
                                                "sense_id": "6ddffd58-755b-34c2-8fb2-fc7029a5484c",
                                                "text": "„Das galicische Wort für ‚Töpfer‘ ist alfareiro, das uns spanisch vorkommt.“"
                                            },
                                            {
                                                "example_id": "0e42a405-c1cf-451d-9280-e313c41f6ef7",
                                                "sense_id": "6ddffd58-755b-34c2-8fb2-fc7029a5484c",
                                                "text": "„Neben einer Reihe von Verwendungsbeispielen, in denen die Sprecher das Verb entsprechend der spanischen Norm mit Pronomen und Präposition de bilden […] existiert auch eine beträchtliche Anzahl von Fällen, die nicht der spanischen Standardnorm entsprechen und auf Gebrauchsregeln für das analoge galicische Verb acordar zurückgehen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
