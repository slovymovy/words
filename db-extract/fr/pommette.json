                ],
                "translations": [
                    {
                        "translation_id": "bbe516c3-f5f6-493e-a182-9f98bdf02ffb",
                        "source_entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                        "source_sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                        "source_sense_description": "Os de la joue",
                        "target_lang_word": "Jochbein",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Jochbein",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                        "entry_id": "84032bdf-6f32-3510-9795-c92e116cfe8a",
                                        "glosses": [
                                            "Knochen des Gesichtsschädels, der den Oberkiefer mit dem Schläfenbein verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "528fbca2-5c8c-4de5-b079-71e2361fca80",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Miroslav Klose hat anstatt des zunächst befürchteten erneuten Bruchs nur eine Prellung am Jochbein erlitten.“"
                                            },
                                            {
                                                "example_id": "b22d54c4-006a-4290-b4e9-bc8a97c145de",
                                                "sense_id": "64c4c4de-b6a3-3b54-9ee9-d9b508db4d64",
                                                "text": "„Da kam bei Brokdorf ein Polizist vom Bremer Sondereinsatzkommando noch glimpflich davon. Einen ‚plötzlichen heftigen Druck am Kopf‘ spürte der Uniformierte: Eine Stahlkugel hatte – knapp am Auge vorbei – sein Jochbein zertrümmert.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6d9241c5-0d88-4160-8383-9fc61ddecdfe",
                        "source_entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
                        "source_sense_id": "91e25d23-3a89-3ab3-86eb-005c869596ce",
                        "source_sense_description": "Os de la joue",
                        "target_lang_word": "Wangenknochen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wangenknochen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                        "entry_id": "9dff491b-be88-3022-885f-750e7628b07c",
                                        "glosses": [
                                            "Knochenvorsprung unter den Augenhöhlen, der den Oberkiefer mit dem Schläfenbein verbindet"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4754d133-8a33-4b8f-ad75-6293e1bc95ae",
                                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                                "text": "„Er hatte die gleichen herabhängenden Schultern und kräftigen Wangenknochen.“"
                                            },
                                            {
                                                "example_id": "df0a267c-039e-4f82-a17b-0edbf333db0f",
                                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                                "text": "„Ihre hohen Wangenknochen machten sie früher sexy, schätze ich, inzwischen lassen sie sie streng wirken.“"
                                            },
                                            {
                                                "example_id": "d7604a3e-0cd8-4ab8-919c-11a851b97f9e",
                                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                                "text": "„Der Bruch seines linken Wangenknochens war zwar vollständig verheilt, aber die Knochenteile waren schlecht zusammengewachsen.“"
                                            },
                                            {
                                                "example_id": "8b8726ef-82ce-4fa5-b925-87df1cb8f0e2",
                                                "sense_id": "3cec5b32-c09f-3f90-bf17-4e3501ed3cbf",
                                                "text": "„Beide hatten wir aufgeschlagene Wangenknochen, und unsere Haut hatte das Gedächtnis verloren und vergessen, wohin sie sich zurückschieben musste, wenn wir getroffen wurden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "55f6a3b8-0ecb-4b70-b474-cef893d4da53",
                        "source_entry_id": "3c1b2e90-f1d8-3db5-9515-1e5b1e3961e4",
