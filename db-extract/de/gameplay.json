                    {
                        "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                        "entry_id": "febf482c-090c-3d74-a1a4-96f4980edb10",
                        "glosses": [
                            "bestimmte Art und Weise, in der ein Spieler mit einem (Video-)Spiel interagiert beziehungsweise interagieren kann"
                        ],
                        "tags": [
                            "jargon"
                        ],
                        "examples": [
                            {
                                "example_id": "f2f44ab5-c4f8-4adb-8920-aa2984facb92",
                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                "text": "„Game-Designer entwerfen das Gameplay, die Spielmechanik, indem sie Regelsysteme erdenken und gestalten, die für die Spieler zu sinnträchtigen Erfahrungen werden.“"
                            },
                            {
                                "example_id": "e5349830-108d-48e4-8a16-50bfa5569bbe",
                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                "text": "„Smartphones sind ideale Gaming-Maschinen – vor allem, da Sie [sic] eine Vielzahl an Zusatzfunktionen mitbringen, die sich in das Gameplay integrieren lassen.“"
                            },
                            {
                                "example_id": "1f769472-689e-4eaf-9715-e04a6c3e8ac7",
                                "sense_id": "936faaf0-4152-3061-a3f5-58dca853b978",
                                "text": "„Sobald vermehrt oder sogar übermäßig Werbung in Computerspielen platziert wird und das Spielgeschehen dadurch unterbrochen, gestört oder das Gameplay offensichtlich verlangsamt wird, sind Gerichtsurteile und gesetzliche Regelungen zum In-Game Advertising zu erwarten.“"
                            }
                        ],
