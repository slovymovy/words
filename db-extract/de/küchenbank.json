                                "example_id": "8f2e4f01-4c09-4a1d-bbec-67fdc4b55ff3",
                                "sense_id": "d50e1778-979e-3289-a992-1591ae6bdf4f",
                                "text": "„Er erhob sich, hielt sich an der Küchenbank fest und schloss mit zittriger Hand die Schublade.“"
                            }
