{
    "word_family": [
        "haste",
        "hasten"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "68f61119-7f60-342f-9355-4ec85705176c",
                    "sense_definition": "Done with too much speed and without enough careful thought.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "speed",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "It was a <w>hasty</w> decision that he later regretted.",
                            "target_lang_translations": {
                                "cs": "Bylo to <w>unáhlené</w> rozhodnutí, kterého později litoval."
                            }
                        },
                        {
                            "text": "Avoid making <w>hasty</w> judgments about people you just met.",
                            "target_lang_translations": {
                                "cs": "Vyhněte se <w>ukvapeným</w> soudům o lidech, které jste právě potkali."
                            }
                        }
                    ],
                    "synonyms": [
                        "brash"
                    ],
                    "common_phrases": [
                        "hasty decision",
                        "hasty conclusion"
                    ],
                    "target_lang_definitions": {
                        "cs": "Udělaný příliš rychle a bez dostatečného uvážení."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "unáhlený",
                                "target_lang_sense_clarification": "jednání nebo rozhodnutí provedené v přílišném spěchu"
                            },
                            {
                                "target_lang_word": "ukvapený",
                                "target_lang_sense_clarification": "člověk nebo čin, kterému chybí rozvaha"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "829b009b-4adb-3b65-a062-43bf739f7de7",
                    "sense_definition": "Easily becoming angry or impatient.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "temperament",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He has a <w>hasty</w> temper and often shouts when frustrated.",
                            "target_lang_translations": {
                                "cs": "Má <w>výbušnou</w> povahu a často křičí, když je frustrovaný."
                            }
                        },
                        {
                            "text": "Despite his <w>hasty</w> nature, he is a very kind person.",
                            "target_lang_translations": {
                                "cs": "Navzdory své <w>prchlivé</w> povaze je to velmi laskavý člověk."
                            }
                        }
                    ],
                    "common_phrases": [
                        "hasty temper"
                    ],
                    "target_lang_definitions": {
                        "cs": "Snadno se rozhněvá nebo ztratí trpělivost."
                    },
                    "translations": {
                        "cs": [
                            {
                                "target_lang_word": "výbušný",
                                "target_lang_sense_clarification": "člověk s prudkou povahou"
                            },
                            {
                                "target_lang_word": "prchlivý",
                                "target_lang_sense_clarification": "člověk, který se snadno nechá vytočit"
                            }
                        ]
                    }
                }
            ]
        },
