                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "86b9e2de-2638-4f07-ba55-b0f595e2e854",
                                "sense_id": "c4c2e673-5da0-3039-90f6-c8fd7f5f4f49",
                                "text": "Byłam z bratową na zakupach, szukałyśmy prezentu dla mojego brata na czterdzieste urodziny."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "008ec252-7f55-4b34-b06d-d93229aaedf2",
                        "source_entry_id": "47bdb431-9791-3e20-b445-7e1835c74c44",
                        "source_sense_id": "c4c2e673-5da0-3039-90f6-c8fd7f5f4f49",
                        "target_lang_word": "sister-in-law",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sister-in-law",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ddd349fd-4e47-3fab-8551-67a23bc04eb9",
                                        "entry_id": "11ad6798-7bcf-337f-8cc8-2f2a6f185b0d",
                                        "glosses": [
                                            "A female relative of one's generation, separated by one degree of marriage:",
                                            "The sister of one's spouse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9218e4fd-e703-4a9b-ba26-ecd0d11b1675",
                                                "sense_id": "ddd349fd-4e47-3fab-8551-67a23bc04eb9",
                                                "text": "Though they are not twins, my sister-in-law resembles my wife in almost every way."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "926323db-5065-328d-a551-355e110391f9",
                                        "entry_id": "11ad6798-7bcf-337f-8cc8-2f2a6f185b0d",
                                        "glosses": [
                                            "A female relative of one's generation, separated by one degree of marriage:",
                                            "The wife of one's sibling."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03303c06-cf44-4fab-99ff-17241b6570e9",
                                                "sense_id": "926323db-5065-328d-a551-355e110391f9",
                                                "text": "My sister-in-law and my brother both met while they were on vacation in Jamaica."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d2b95d28-da67-35ad-8140-a990967e1d8c",
                                        "entry_id": "11ad6798-7bcf-337f-8cc8-2f2a6f185b0d",
                                        "glosses": [
                                            "Co-sister-in-law: The wife of one's sibling-in-law.",
                                            "The wife of the sibling of one's spouse."
                                        ],
                                        "tags": [
                                            "uncommon"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f7ac34ff-c5e3-326f-b024-ea770b33bbf4",
