                                        "sense_id": "a57811e0-a8cf-3ba4-b169-4cfded4734f6",
                                        "entry_id": "3bafe266-2b72-36dd-9561-dfe370764de5",
                                        "glosses": [
                                            "regencape met een capuchon"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8ddcbdee-0046-4680-b0e8-4c5787b6229c",
                                                "sense_id": "a57811e0-a8cf-3ba4-b169-4cfded4734f6",
                                                "text": "Er zijn ook regenponcho's speciaal voor op de fiets. Deze hebben een grote voorflap om aan het stuur vast te maken, een kleine achterflap voor op de rug en een capuchon voor op het hoofd"
                                            }
                                        ]
