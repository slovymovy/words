{
    "word_family": [
        "sipper",
        "sippable"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "bb055a1a-39c6-3886-a664-84d6e68c6939",
                    "sense_definition": "To drink a liquid slowly, taking only small mouthfuls at a time.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She sat by the window, <w>sipping</w> hot tea while watching the rain fall.",
                            "target_lang_translations": {
                                "ru": "Она сидела у окна, <w>потягивая</w> горячий чай и наблюдая за дождем."
                            }
                        },
                        {
                            "text": "It is better to <w>sip</w> slowly on a hot drink to avoid burning your tongue.",
                            "target_lang_translations": {
                                "ru": "Горячие напитки лучше <w>пить маленькими глотками</w>, чтобы не обжечь язык."
                            }
                        }
                    ],
                    "synonyms": [
                        "nurse"
                    ],
                    "antonyms": [
                        "gulp",
                        "guzzle",
                        "chug"
                    ],
                    "common_phrases": [
                        "sip slowly",
                        "sip on a drink"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пить жидкость медленно, маленькими глотками."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потягивать",
                                "target_lang_sense_clarification": "медленно пить, наслаждаясь"
                            },
                            {
                                "target_lang_word": "пить маленькими глотками",
                                "target_lang_sense_clarification": "о способе употребления"
                            },
                            {
                                "target_lang_word": "прихлебывать",
                                "target_lang_sense_clarification": "пить понемногу, часто с характерным звуком"
                            },
                            {
                                "target_lang_word": "пригубить",
                                "target_lang_sense_clarification": "слегка отпить, коснувшись губами"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dc5463ff-fef9-329b-9987-2db843605c2d",
                    "sense_definition": "To consume a resource, such as fuel or electricity, in very small and efficient amounts.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "consumption",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "This new hybrid engine is designed to <w>sip</w> fuel even during heavy city traffic.",
                            "target_lang_translations": {
                                "ru": "Этот новый гибридный двигатель спроектирован так, чтобы крайне экономно <w>расходовать</w> топливо даже в плотном городском потоке."
                            }
                        },
                        {
                            "text": "Modern LED bulbs <w>sip</w> electricity compared to the old incandescent ones.",
                            "target_lang_translations": {
                                "ru": "Современные светодиодные лампы <w>потребляют минимум</w> электроэнергии по сравнению со старыми лампами накаливания."
                            }
                        }
                    ],
                    "antonyms": [
                        "guzzle",
                        "drain"
                    ],
                    "common_phrases": [
                        "sip electricity",
                        "sip fuel"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "often used in technical or automotive contexts to describe efficiency"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Потреблять ресурс (топливо или электричество) в очень малых, экономных количествах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "потреблять по минимуму",
                                "target_lang_sense_clarification": "об экономичном расходе"
                            },
                            {
                                "target_lang_word": "расходовать экономно",
                                "target_lang_sense_clarification": "о топливе или энергии"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6ad670d6-e83f-3889-8e24-f14509d14e2d",
                    "sense_definition": "A small mouthful of a liquid that is being drunk.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "drinking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He took a small <w>sip</w> of the coffee to check if it was too hot.",
                            "target_lang_translations": {
                                "ru": "Он сделал маленький <w>глоток</w> кофе, чтобы проверить, не слишком ли он горячий."
                            }
                        },
                        {
                            "text": "After taking a <w>sip</w> of water, the speaker continued his presentation.",
                            "target_lang_translations": {
                                "ru": "Сделав <w>глоток</w> воды, оратор продолжил свою презентацию."
                            }
                        }
                    ],
                    "antonyms": [
                        "gulp"
                    ],
                    "common_phrases": [
                        "take a sip",
                        "small sip"
                    ],
                    "target_lang_definitions": {
                        "ru": "Маленький глоток выпиваемой жидкости."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "глоток",
                                "target_lang_sense_clarification": "небольшое количество жидкости"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "aae78c81-14f7-3483-83fa-3d4e743a0932",
                    "sense_definition": "A social gathering or event where people consume alcoholic drinks in small quantities.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_event",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The gallery hosted a cocktail <w>sip</w> to celebrate the opening of the new exhibit.",
                            "target_lang_translations": {
                                "ru": "Галерея устроила <w>коктейльный прием</w> в честь открытия новой выставки."
                            }
                        },
                        {
                            "text": "It was a smart afternoon <w>sip</w> where guests mingled with glasses of champagne.",
                            "target_lang_translations": {
                                "ru": "Это была элегантная дневная <w>вечеринка</w>, где гости общались с бокалами шампанского в руках."
                            }
                        }
                    ],
                    "common_phrases": [
                        "cocktail sip"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "sometimes used in specific social contexts or dialects"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Светское мероприятие или вечеринка, где подают алкогольные напитки в небольших количествах."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "коктейльная вечеринка",
                                "target_lang_sense_clarification": "неформальное светское собрание"
                            },
                            {
                                "target_lang_word": "фуршет",
                                "target_lang_sense_clarification": "прием с напитками и закусками"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "6c31703c-91d1-3337-a7cd-8cefaa324693",
                    "sense_definition": "An abbreviation for Session Initiation Protocol, a signaling protocol used for initiating real-time sessions.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technology",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "The IT department is configuring the <w>SIP</w> trunk to improve our VoIP communications.",
                            "target_lang_translations": {
                                "ru": "ИТ-отдел настраивает <w>SIP</w>-транк для улучшения нашей VoIP-связи."
                            }
                        },
                        {
                            "text": "Most modern internet telephony services rely on the <w>SIP</w> standard for connectivity.",
                            "target_lang_translations": {
                                "ru": "Большинство современных сервисов интернет-телефонии используют стандарт <w>SIP</w> для обеспечения связи."
                            }
                        }
                    ],
                    "common_phrases": [
                        "SIP trunking",
                        "SIP server"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Протокол установления сеанса (SIP) — протокол передачи данных, используемый для организации мультимедийных сессий."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SIP",
                                "target_lang_sense_clarification": "протокол IP-телефонии"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8f9a3f05-dc1a-35f6-ae4e-935c2c7ac8db",
                    "sense_definition": "An abbreviation for System Integrity Protection, a security feature in macOS.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technology",
                    "name_type": "technology_or_software_name",
                    "examples": [
                        {
                            "text": "You may need to disable <w>SIP</w> temporarily to modify certain system files on your Mac.",
                            "target_lang_translations": {
                                "ru": "Вам может потребоваться временно отключить <w>SIP</w>, чтобы изменить определенные системные файлы на вашем Mac."
                            }
                        },
                        {
                            "text": "Apple introduced <w>SIP</w> to prevent unauthorized processes from altering protected folders.",
                            "target_lang_translations": {
                                "ru": "Apple внедрила <w>SIP</w>, чтобы предотвратить изменение защищенных папок несанкционированными процессами."
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "initialism"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Защита целостности системы (SIP) — функция безопасности в операционной системе macOS."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "SIP",
                                "target_lang_sense_clarification": "технология защиты в macOS"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}