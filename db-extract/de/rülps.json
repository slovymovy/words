                                "target_senses": [
                                    {
                                        "sense_id": "4f3e25cb-900a-3fee-be99-580dfb1084ae",
                                        "entry_id": "b4504a0b-4a6f-35ef-a951-f397b023ffe6",
                                        "glosses": [
                                            "Pourriture, maladie de la vigne."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e27789d-8033-4f1b-b51b-2f804fcde64c",
                                                "sense_id": "4f3e25cb-900a-3fee-be99-580dfb1084ae",
                                                "text": "Rot blanc : Maladie survenant après la grêle sur les grappes blessées qui deviennent rougeâtres et blanches, et présentent des taches jaune livide formant des auréoles concentriques"
                                            },
                                            {
                                                "example_id": "dc8c9ad3-0be1-4bf5-9101-7aad4f98226e",
                                                "sense_id": "4f3e25cb-900a-3fee-be99-580dfb1084ae",
                                                "text": "Rot brun : Atteinte de mildiou qui provoque le brunissement plus ou moins violacé, puis le dessèchement des baies"
                                            },
                                            {
                                                "example_id": "6be83b73-cd20-408e-8a11-291fd105f9d0",
                                                "sense_id": "4f3e25cb-900a-3fee-be99-580dfb1084ae",
                                                "text": "Rot gris : Attaque de mildiou provoquant l’apparition de filaments blanc-gris sur les raisins atteints (d’après Agric., 1977)."
                                            },
                                            {
                                                "example_id": "77ed7fce-4371-4c31-89ad-97affabebf8a",
                                                "sense_id": "4f3e25cb-900a-3fee-be99-580dfb1084ae",
                                                "text": "Rot noir, black-rot."
                                            }
                                        ]
                                    }
                                ]
