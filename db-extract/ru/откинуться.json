                ],
                "senses": [
                    {
                        "sense_id": "0b062d2b-ae9e-3a88-bf1a-8fdd2d884a2e",
                        "entry_id": "5bbef370-f2c3-3280-b6bd-9a3a1060281c",
                        "glosses": [
                            "небрежно отклоняться назад"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "58977793-ebe8-4b7c-8c9d-7bee017a91b8",
                                "sense_id": "0b062d2b-ae9e-3a88-bf1a-8fdd2d884a2e",
                                "text": "Он с удовольствием затянулся и откинулся на стуле."
                            },
                            {
                                "example_id": "21a396b0-bbf8-4ae9-be72-13779cfd4dde",
                                "sense_id": "0b062d2b-ae9e-3a88-bf1a-8fdd2d884a2e",
                                "text": "Макарцев откинулся на спинку кресла, снял очки, плавно кинул их на стол и по-детски заморгал глазами."
                            }
                        ]
                    },
                    {
                        "sense_id": "8999656f-9b7f-3c4e-b0f0-8156e9ad3ccb",
                        "entry_id": "5bbef370-f2c3-3280-b6bd-9a3a1060281c",
                        "glosses": [
                            "разг., эвф. то же, что умереть"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "374e7a7a-e1d7-4bef-99dd-683dc5c0c325",
                                "sense_id": "8999656f-9b7f-3c4e-b0f0-8156e9ad3ccb",
                                "text": "Он только вчера откинулся, а сегодня уже и некролог."
                            },
                            {
                                "example_id": "24bd1cd2-2767-40bc-928a-f70fa1e501f2",
                                "sense_id": "8999656f-9b7f-3c4e-b0f0-8156e9ad3ccb",
                                "text": "У меня временно сайт откинулся, после нового года буду оживлять."
                            }
                        ]
                    },
                    {
                        "sense_id": "db77fcf0-2e6b-3b18-b870-f27996928887",
                        "entry_id": "5bbef370-f2c3-3280-b6bd-9a3a1060281c",
                        "glosses": [
                            "крим. жарг. быть освобождённым из мест лишения свободы"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f229e2a8-c79e-4e0c-8510-0a2952558d0b",
                                "sense_id": "db77fcf0-2e6b-3b18-b870-f27996928887",
                                "text": "Я вчера откинулся, я парниша хоть куда, завтра посажу на перышко терпилу — и обратно в Магадан."
                            }
                        ]
                    }
                ],
