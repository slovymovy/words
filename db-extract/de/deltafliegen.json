                ],
                "senses": [
                    {
                        "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                        "entry_id": "2b3fee88-aeac-3619-82db-7fdda87bc086",
                        "glosses": [
                            "Sportart, die mit einem Hängegleiter betrieben wird, beziehungsweise Bewegung eines Drachenfliegers im Luftraum"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8a2d8177-46e9-4d6a-aca2-491a282fb391",
                                "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                                "text": "„Das Deltafliegen stellt besonders hohe Ansprüche an die körperliche Leistungsfähigkeit, die physisch-technische Kompetenz, die Geländebeurteilung, das Erspüren von Aufwinden.“"
                            },
                            {
                                "example_id": "dbbaea85-feb8-4027-bf13-6cbbbfb91b44",
                                "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                                "text": "„Deltafliegen, die ursprüngliche Art des Hängegleitens, ist mit dem Aufkommen des Gleitschirmes etwas in Vergessenheit geraten.“"
                            },
                            {
                                "example_id": "8cd16d09-5e13-44e8-a948-66410464c439",
                                "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                                "text": "„Deltafliegen ist eine wunderbare, freie Art von Fliegen, die dem Vogelflug bestimmt am nächsten kommt.“"
                            },
                            {
                                "example_id": "14a8f113-0262-4afa-993a-728c98bae6c3",
                                "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                                "text": "„Ich werde wieder Deltafliegen gehen, weil ich konnte meinen ersten Flug nicht geniessen, kommentierte der Amerikaner, nicht ohne Galgenhumor.“"
                            },
                            {
                                "example_id": "eea30b9d-ad35-4443-8d99-954a983b492a",
                                "sense_id": "be39b43a-028a-3e6c-bc67-20980791d1c3",
                                "text": "„Vor 30 Jahren (1980) gewann Beat Spreiter laut «Vaterland» die Landesmeisterschaften im Deltafliegen vor Hansjörg Frommelt und Markus Erne.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
