{
    "word_family": [
        "ranger"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "82524686-c440-3ab9-9b94-943d54c39d31",
                    "sense_definition": "A variety of things of a particular type; a selection or array.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "variety",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shop offers a wide <w>range</w> of products for sale.",
                            "target_lang_translations": {
                                "ru": "Магазин предлагает широкий <w>ассортимент</w> товаров на продажу.",
                                "tr": "Mağaza satılık geniş bir ürün <w>yelpazesi</w> sunmaktadır.",
                                "zh": "这家商店出售<w>种类繁多</w>的产品。"
                            }
                        },
                        {
                            "text": "We discussed a whole <w>range</w> of topics during the meeting.",
                            "target_lang_translations": {
                                "ru": "Мы обсудили целый <w>ряд</w> тем во время встречи.",
                                "tr": "Toplantı sırasında pek çok <w>farklı</w> konuyu ele aldık.",
                                "zh": "会议期间我们讨论了<w>一系列</w>议题。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "wide range of",
                        "whole range of",
                        "range of products"
                    ],
                    "target_lang_definitions": {
                        "ru": "Разнообразие вещей определенного типа; подборка или набор.",
                        "tr": "Belirli bir türdeki şeylerin çeşitliliği; bir seçim veya yelpaze.",
                        "zh": "指特定类型事物的多样性；一系列或一组选择。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ассортимент",
                                "target_lang_sense_clarification": "набор товаров или услуг"
                            },
                            {
                                "target_lang_word": "ряд",
                                "target_lang_sense_clarification": "совокупность явлений или предметов"
                            },
                            {
                                "target_lang_word": "диапазон",
                                "target_lang_sense_clarification": "охват, объем чего-либо"
                            },
                            {
                                "target_lang_word": "выбор",
                                "target_lang_sense_clarification": "разнообразие вариантов"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "çeşitlilik",
                                "target_lang_sense_clarification": "farklı türlerin bulunması durumu"
                            },
                            {
                                "target_lang_word": "yelpaze",
                                "target_lang_sense_clarification": "seçenekler veya konular bütünü"
                            },
                            {
                                "target_lang_word": "ürün gamı",
                                "target_lang_sense_clarification": "ticarette sunulan çeşitler"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "指事物涵盖的广度或种类"
                            },
                            {
                                "target_lang_word": "系列",
                                "target_lang_sense_clarification": "指一组相关联的事物"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "928e0447-9fc5-3727-9ba3-da98ff65e9e4",
                    "sense_definition": "A line or series of mountains.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "geography",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mountain <w>range</w> is covered in deep snow all winter.",
                            "target_lang_translations": {
                                "ru": "<w>Горный хребет</w> всю зиму покрыт глубоким снегом.",
                                "tr": "<w>Sıradağlar</w> bütün kış boyunca derin bir kar tabakasıyla kaplıdır.",
                                "zh": "整个冬天，这座<w>山脉</w>都被厚雪覆盖。"
                            }
                        },
                        {
                            "text": "We could see the peaks of the <w>range</w> in the distance.",
                            "target_lang_translations": {
                                "ru": "Мы видели вершины <w>горной цепи</w> вдалеке.",
                                "tr": "Uzaktan <w>sıradağların</w> zirvelerini görebiliyorduk.",
                                "zh": "我们可以看到远处<w>山脉</w>的顶峰。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "mountain range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Линия или цепь гор.",
                        "tr": "Bir hat veya sıra halinde uzanan dağ dizisi.",
                        "zh": "成行或成链状分布的山脉。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "горный хребет",
                                "target_lang_sense_clarification": "география"
                            },
                            {
                                "target_lang_word": "горная цепь",
                                "target_lang_sense_clarification": "география"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "sıradağ",
                                "target_lang_sense_clarification": "coğrafya"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "山脉",
                                "target_lang_sense_clarification": "地理学上的山体连绵"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24693751-9244-3686-ac4f-51196ca27893",
                    "sense_definition": "The maximum distance that a person can see or that a weapon, radio, or vehicle can reach or travel.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "distance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The enemy ship is now out of <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "Вражеский корабль теперь вне зоны <w>досягаемости</w>.",
                                "tr": "Düşman gemisi artık <w>menzilin</w> dışında.",
                                "zh": "敌舰现在已超出<w>射程</w>。"
                            }
                        },
                        {
                            "text": "This electric car has a <w>range</w> of three hundred miles.",
                            "target_lang_translations": {
                                "ru": "У этого электромобиля <w>запас хода</w> составляет триста миль.",
                                "tr": "Bu elektrikli arabanın üç yüz millik bir <w>menzili</w> var.",
                                "zh": "这辆电动汽车的<w>续航里程</w>为三百英里。"
                            }
                        }
                    ],
                    "synonyms": [
                        "distance",
                        "radius",
                        "compass"
                    ],
                    "common_phrases": [
                        "out of range",
                        "within range",
                        "close range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Максимальное расстояние, которое может видеть человек или на которое может действовать оружие, радио или транспортное средство.",
                        "tr": "Bir kişinin görebileceği veya bir silahın, radyonun ya da aracın ulaşabileceği, katetebileceği maksimum mesafe.",
                        "zh": "人眼可见或武器、无线电、车辆所能到达的最大距离。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "дальность",
                                "target_lang_sense_clarification": "расстояние действия"
                            },
                            {
                                "target_lang_word": "досягаемость",
                                "target_lang_sense_clarification": "пределы доступности"
                            },
                            {
                                "target_lang_word": "радиус действия",
                                "target_lang_sense_clarification": "зона охвата сигнала или устройства"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "menzil",
                                "target_lang_sense_clarification": "ulaşılabilecek maksimum mesafe"
                            },
                            {
                                "target_lang_word": "erim",
                                "target_lang_sense_clarification": "etki alanı veya ulaşma mesafesi"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "射程",
                                "target_lang_sense_clarification": "武器的有效打击距离"
                            },
                            {
                                "target_lang_word": "续航里程",
                                "target_lang_sense_clarification": "车辆一次加注能源可行驶的距离"
                            },
                            {
                                "target_lang_word": "范围",
                                "target_lang_sense_clarification": "可触及的区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "1e1da443-0d51-3d8c-abeb-19c32a250abe",
                    "sense_definition": "An area specifically designed for practicing shooting at targets or for military training.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "place",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Soldiers practice their aim at the firing <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты тренируются в меткости на <w>стрельбище</w>.",
                                "tr": "Askerler atış <w>alanında</w> nişan alma pratiği yapıyorlar.",
                                "zh": "士兵们在<w>靶场</w>练习瞄准。"
                            }
                        },
                        {
                            "text": "He goes to the shooting <w>range</w> every weekend.",
                            "target_lang_translations": {
                                "ru": "Он ходит в <w>тир</w> каждые выходные.",
                                "tr": "Her hafta sonu atış <w>poligonuna</w> gider.",
                                "zh": "他每个周末都去<w>靶场</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "training area",
                        "training ground"
                    ],
                    "common_phrases": [
                        "shooting range",
                        "firing range",
                        "driving range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Территория, специально предназначенная для тренировки в стрельбе по мишеням или для военных учений.",
                        "tr": "Hedeflere ateş etme pratiği yapmak veya askeri eğitim için özel olarak tasarlanmış alan.",
                        "zh": "专门用于射击练习或军事训练的场地。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стрельбище",
                                "target_lang_sense_clarification": "место для стрельбы"
                            },
                            {
                                "target_lang_word": "полигон",
                                "target_lang_sense_clarification": "военный учебный центр"
                            },
                            {
                                "target_lang_word": "тир",
                                "target_lang_sense_clarification": "помещение для стрельбы"
                            }
                        ],
                        "tr": [
                            {
                                "target_lang_word": "atış alanı",
                                "target_lang_sense_clarification": "ateş pratik yeri"
                            },
                            {
                                "target_lang_word": "poligon",
                                "target_lang_sense_clarification": "atış yapılan tesis"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "靶场",
                                "target_lang_sense_clarification": "射击练习场所"
                            },
                            {
                                "target_lang_word": "训练场",
                                "target_lang_sense_clarification": "军事训练区域"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4217cf79-e5a8-339d-8048-578391b8fea8",
                    "sense_definition": "The scale of tones that a voice or an instrument is capable of producing.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "music",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The singer has an incredible vocal <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "У певца невероятный вокальный <w>диапазон</w>.",
                                "tr": "Şarkıcının inanılmaz bir ses <w>aralığı</w> var.",
                                "zh": "这位歌手拥有令人难以置信的<w>音域</w>。"
                            }
                        },
                        {
                            "text": "This song is too high for my normal <w>range</w>.",
                            "target_lang_translations": {
                                "ru": "Эта песня слишком высока для моего обычного <w>диапазона</w>.",
                                "tr": "Bu şarkı benim normal ses <w>sınırım</w> için çok tiz.",
                                "zh": "这首歌的音调太高，超出了我正常的<w>音域</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "compass"
                    ],
                    "common_phrases": [
                        "vocal range"
                    ],
                    "target_lang_definitions": {
                        "ru": "Шкала тонов, которые способен воспроизводить голос или инструмент.",
                        "tr": "Bir sesin veya enstrümanın üretebildiği ses tonlarının aralığı.",
                        "zh": "人声或乐器能够发出的音高范围。"
