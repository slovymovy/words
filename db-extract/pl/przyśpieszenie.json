                                        "glosses": [
                                            "Ableitung der Geschwindigkeit nach der Zeit (kann beliebiges Vorzeichen haben)"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6beba132-66ca-485b-a329-8bdcfe2973a8",
                                                "sense_id": "7a7a63f3-ac01-38c2-ad6a-bb094cb9528b",
                                                "text": "Im freien Fall erfährt man eine Beschleunigung von ungefähr 9,81 m/s²."
