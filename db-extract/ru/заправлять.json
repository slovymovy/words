                                "sense_id": "72128e1e-89b2-3b06-98bb-3034d79794c7",
                                "text": "заправля́ть чьи́ми-либо дела́ми",
                                "translation": "to run someone's affairs",
                                "english": "to run someone's affairs"
                            },
                            {
                                "example_id": "a329863b-a0ea-4638-9bc2-65b328afd445",
                                "sense_id": "72128e1e-89b2-3b06-98bb-3034d79794c7",
                                "text": "заправля́ть всем",
                                "translation": "to run the show; rule the roost",
                                "english": "to run the show; rule the roost"
                            },
                            {
                                "example_id": "9e844f9c-af0b-4fc5-bde2-f469e863d88c",
                                "sense_id": "72128e1e-89b2-3b06-98bb-3034d79794c7",
                                "text": "Тут он всем заправляет.",
