                "senses": [
                    {
                        "sense_id": "4e54f240-61df-3335-be17-9481216e0e10",
                        "entry_id": "23668604-5c6a-364e-b83b-2fba1f730c00",
                        "glosses": [
                            "In an imperfect manner or degree; not fully or completely."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eeb31746-c3cd-4d70-94d9-926b96ec7d15",
                                "sense_id": "4e54f240-61df-3335-be17-9481216e0e10",
                                "text": "We cannot look, however imperfectly, upon a great man, without gaining something by him."
                            },
                            {
                                "example_id": "b5eeca65-8005-4014-a15a-ae481339cdce",
                                "sense_id": "4e54f240-61df-3335-be17-9481216e0e10",
                                "text": "Mrs. PAGE is gifted with a pleasing voice, which is yet imperfectly weeded of certain sharpnesses, but seems susceptible of a wide range of melodious inflection."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19951668-0573-487e-a8c0-2cd434e9f938",
                        "source_entry_id": "23668604-5c6a-364e-b83b-2fba1f730c00",
                        "source_sense_id": "4e54f240-61df-3335-be17-9481216e0e10",
                        "source_sense_description": "in an imperfect manner",
                        "target_lang_word": "imparfaitement",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "imparfaitement",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                        "entry_id": "580dc9e2-e128-3454-aaf3-60158a77ec0d",
                                        "glosses": [
                                            "D’une manière imparfaite."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0602e395-9b5e-4de8-afad-a3ccb6d585d7",
                                                "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                                "text": "Mais l’obscurité se faisait rapidement, et les sentiers de la forêt ne paraissaient qu’imparfaitement connus des maraudeurs."
                                            },
                                            {
                                                "example_id": "702daa5a-e8cc-42ee-af13-470ae2f58fef",
                                                "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                                "text": "Les prophètes et les patriarches, ces saints de la vieille loi, et qui n’ont connu la vérité qu’imparfaitement et à travers des métaphores, ont le nimbe en argent."
                                            },
                                            {
                                                "example_id": "46d66b2d-e42d-4a44-b62c-8635d9489aba",
                                                "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                                "text": "Au point de vue religieux les Berbères sont des musulmans de surface, dont le vernis islamique ne recouvre que très imparfaitement leurs croyances primitives."
                                            },
                                            {
                                                "example_id": "d55e9a78-d266-4fde-90d3-27e1c62d4e9d",
                                                "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                                "text": "L’humus […] résulte de la transformation de la matière organique. C'est un produit composite, chimiquement mal défini, et les détails de sa formation sont encore imparfaitement connus."
                                            },
                                            {
                                                "example_id": "0d1ee638-350c-4afa-aec5-c544c15a7a33",
                                                "sense_id": "e3d6e308-b834-3400-adb8-56b75bec6393",
                                                "text": "Les gens de bien même tombent dans des infidélités inévitables, et ne sont parfaits qu’imparfaitement."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
