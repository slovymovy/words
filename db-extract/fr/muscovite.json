                    {
                        "translation_id": "80a2d3cf-cc53-412c-93b8-4e1e79d3ffa1",
                        "source_entry_id": "54c8fe2b-ec75-3fb7-b3b9-694779452464",
                        "source_sense_id": "670ebaa2-0157-3b74-b7f4-ceb9e07f5647",
                        "target_lang_word": "мусковит",
                        "target_lang_code": "ru",
