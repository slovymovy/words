                    },
                    {
                        "translation_id": "926d0188-1fde-4628-b4e7-f3f518b1b374",
                        "source_entry_id": "9ce93937-b9ea-3f77-a6b9-711277df2e94",
                        "source_sense_id": "d3110751-d559-3e53-bd30-b8534e1e7436",
                        "source_sense_description": "an vielen Orten",
                        "target_lang_word": "un peu partout",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "un peu partout",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                        "entry_id": "7bd73c9a-7b81-3fe2-b851-3acbe5f307e7",
                                        "glosses": [
                                            "En divers endroits."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "edbceb87-02ac-4187-a405-2b829b57c459",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "J'ai constaté également, un peu partout, des traces de bombardement à l'aide de shrapnells; […]."
                                            },
                                            {
                                                "example_id": "4e47e663-0686-4580-82d0-1cc2513b7c9c",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "Dans tous les pays du monde les savons de ménage sont parfumés, sauf en France, parce que des droits d'octroi frappent un peu partout les savons parfumés."
                                            },
                                            {
                                                "example_id": "72736c65-3591-40fb-8c9c-c453331d295f",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "À travers les vitres des brasseries et des cafés, on distinguait confusément, un peu partout, la foule des consommateurs gesticulant parmi la fumée des cigarettes."
                                            },
                                            {
                                                "example_id": "c625b753-333b-486a-b848-4fda8b3e7b6b",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "Le soixante-dixième anniversaire du Tsar rouge avait été célébré un peu partout. Je vis le très fameux portrait du petit père des peuples dessiné par Picasso."
                                            },
                                            {
                                                "example_id": "e39c6362-bffe-4cc8-901b-b8d7dd33743e",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "Établies un peu partout au Québec, ces microbrasseries brassent des centaines de bières originales pour le plus grand plaisir des dégustateurs."
                                            },
                                            {
                                                "example_id": "ca6f95f9-1877-47b3-b9c5-9531c1ee6fb4",
                                                "sense_id": "a7b7a244-946f-3cc4-84a7-dcb04d50785a",
                                                "text": "[…] le souvenir le plus frappant que j’ai gardé de ce périple ce sont les cuvettes disposées un peu partout pour pallier d’éventuels maux de mer."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
