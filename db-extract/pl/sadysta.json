                                                "example_id": "aca3a6dd-5b3b-4659-afd6-302e5b528d91",
                                                "sense_id": "38cdbf07-c843-35d2-8dfd-b63d2842f7f6",
                                                "text": "Terwijl ik dat irritante sirene’tje hoor loeien, de klep langzaam voor mijn neus dicht gaat en een olijke sadist me nog even hartelijk uitzwaait (hij vaart, ik vloek) probeer ik te bedenken waarom ik het wachten op de pont van en naar Noord zo verschrikkelijk vind."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ec648d31-2725-49ba-9437-86e4e4b2ccfe",
                        "source_entry_id": "12c13d62-4c6d-3d39-a06a-aa432773cab5",
                        "source_sense_id": "558b23db-5f86-3046-b3f6-09d3c60f1ed1",
                        "target_lang_word": "Sadist",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Sadist",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                        "entry_id": "a15f78f9-d707-3ee4-bbb4-99cf111ac0e8",
                                        "glosses": [
                                            "Person, die Lustgewinn daraus zieht, andere zu quälen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2b955b34-d4d5-48fa-b30c-86f5c873c7e7",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Schon am Nachmittag nach diesem feierlichen Treueschwur, den wir vor einem Korvettenkapitän, unserem Kompaniechef und einigen Marineoffizieren leisten mussten, entpuppten sich einige unserer Ausbilder als einfallsreiche Sadisten.“"
                                            },
                                            {
                                                "example_id": "aabc4fe2-7795-43cb-9365-e60bce4ea056",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Ob Reinhold Sadist von Anlage war, weiß er nicht.“"
                                            },
                                            {
                                                "example_id": "166dbab9-d06b-4946-9696-86333fe3c837",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Er weckte immer den guten Sadisten in mir.“"
                                            },
                                            {
                                                "example_id": "0a97d6d2-3c4e-4484-a8e8-2d8faf29b788",
                                                "sense_id": "7b8c5df8-60f2-3d96-8826-0b0fc7a2af13",
                                                "text": "„Irgendwann würde ich so weit sein, daß ich Kinkel anpumpte, auch Sommerwild und sogar diesen Sadisten Fredebeul, der mir wahrscheinlich ein Fünfmarkstück vor die Nase halten und mich zwingen würde, danach zu springen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3a37d709-d760-44c3-870b-167c33485db4",
                        "source_entry_id": "12c13d62-4c6d-3d39-a06a-aa432773cab5",
                        "source_sense_id": "558b23db-5f86-3046-b3f6-09d3c60f1ed1",
