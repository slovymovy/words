                "senses": [
                    {
                        "sense_id": "a4147bf3-b42f-3d0a-aa3d-b28eda3be5e6",
                        "entry_id": "d6ed61a7-e8e5-3589-a159-f63c93ce9c8b",
                        "glosses": [
                            "The property that makes a person likeable, that allows them to be liked."
                        ],
                        "tags": [
                            "uncountable",
                            "usually"
                        ],
                        "examples": [
                            {
                                "example_id": "40806c02-07f7-42a4-ac57-eb03164d76b2",
                                "sense_id": "a4147bf3-b42f-3d0a-aa3d-b28eda3be5e6",
                                "text": "Attractiveness and likeability isn't simply a matter of sexual desirability."
                            },
                            {
                                "example_id": "407afa38-f834-486d-b0fc-d8af558e4426",
                                "sense_id": "a4147bf3-b42f-3d0a-aa3d-b28eda3be5e6",
                                "text": "Perhaps the most striking result of this study was that a simple advertising likeability scale predicted sales winners 87% of the time."
                            },
                            {
                                "example_id": "304109db-2c93-4b3e-a27b-b269b57e58d0",
                                "sense_id": "a4147bf3-b42f-3d0a-aa3d-b28eda3be5e6",
                                "text": "In the category condition. participants (1) guessed the targets' academic majors and (2) rated their likeability."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "89b81cdc-7290-4a8d-8dfc-c6eaf2d68780",
                        "source_entry_id": "d6ed61a7-e8e5-3589-a159-f63c93ce9c8b",
                        "source_sense_id": "a4147bf3-b42f-3d0a-aa3d-b28eda3be5e6",
                        "source_sense_description": "Translations",
                        "target_lang_word": "amabilité",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "amabilité",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "8f6dbe85-d8ec-384d-acca-c047b4328d00",
                                        "entry_id": "5229921d-8b59-3aac-a772-37d45feca549",
                                        "glosses": [
                                            "Qualité d’une personne aimable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "93bb1811-74ad-4c23-9076-ae6e31e88f6e",
                                                "sense_id": "8f6dbe85-d8ec-384d-acca-c047b4328d00",
                                                "text": "Comme ils se multipliaient! Avec quelle amabilité ils présidaient à la distribution des rafraîchissements! Non! ils n'attendaient pas, ils prévenaient les désirs de chacun."
                                            },
                                            {
                                                "example_id": "0badd96a-f633-4501-a8cd-a4668596b7e1",
                                                "sense_id": "8f6dbe85-d8ec-384d-acca-c047b4328d00",
                                                "text": "Ce commandant, un homme fort, haut, avec des moustaches et une barbiches grises, […], nous reçut avec bonhomie et amabilité."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "be548898-1dfc-3ec9-854a-55e47af311c8",
                                        "entry_id": "5229921d-8b59-3aac-a772-37d45feca549",
                                        "glosses": [
                                            "Les signes par lesquels elle se manifeste."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4db8a299-d7b5-45ca-af35-79d2e09ae866",
                                                "sense_id": "be548898-1dfc-3ec9-854a-55e47af311c8",
                                                "text": "Et tous, me voyant en bons termes avec le maître tout-puissant, sont pour moi pleins d’amabilité et de prévenances."
                                            },
                                            {
                                                "example_id": "43592390-c355-4e2d-8edb-14a0438b8ca3",
                                                "sense_id": "be548898-1dfc-3ec9-854a-55e47af311c8",
                                                "text": "[…] et nous nous quittâmes, sur des amabilités réciproques, devenus à travers l’espace les meilleurs amis du monde."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
