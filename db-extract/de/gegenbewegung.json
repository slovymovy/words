                        "entry_id": "cc986b74-3455-34b2-add4-ab78b9afddc0",
                        "glosses": [
                            "körperliche Verlagerung/Ausführung in die andere Richtung als die zuerst ausgeführte oder ›normal‹ getätigte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e2ef079-e19e-40c8-a566-f1423ff94f5d",
                                "sense_id": "978a47cc-8a5e-3869-876a-2d8887d062d8",
                                "text": "Man kommt ins Schwanken und doch bringen einen entsprechende Gegenbewegungen wieder ins Gleichgewicht."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "a7105850-926b-3f9d-aa3c-b468ca1b8a18",
                        "entry_id": "cc986b74-3455-34b2-add4-ab78b9afddc0",
                        "glosses": [
                            "Ausprägung in die andere Richtung, die einer erstgenannten widerspricht, konträr gegenübersteht"
                        ],
                        "tags": [
                            "von Richtungen",
                            "Klassen",
                            "Gruppierungen",
                            "Parteien",
                            "Märkten"
                        ],
                        "examples": [
                            {
                                "example_id": "901227de-bea9-4f26-9f61-e72af1e87a0f",
                                "sense_id": "a7105850-926b-3f9d-aa3c-b468ca1b8a18",
                                "text": "Eine Gegenbewegung zur Aufklärung ist wohl die Romantik."
                            },
                            {
                                "example_id": "7efce9d1-e429-4066-8dbc-fa247215150f",
                                "sense_id": "a7105850-926b-3f9d-aa3c-b468ca1b8a18",
                                "text": "„Alsdann setzt die Gegenbewegung von Osten nach Westen ein, und ihr ganzer Verlauf ähnelt bemerkenswerterweise dem der ihr vorangegangenen Bewegung von Westen nach Osten.“"
                            }
                        ],
