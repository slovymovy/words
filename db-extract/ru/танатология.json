                                "target_senses": [
                                    {
                                        "sense_id": "30d34e1a-cbb4-39a1-be66-9fb72b46f96e",
                                        "entry_id": "66fbacd1-910c-3ad9-8f8f-41637fdaaa6f",
                                        "glosses": [
                                            "The scientific study of death and the practices associated with it, including the study of the needs of the terminally ill and their families."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "150d21d9-50dc-416d-a596-4a9750b49fce",
                                                "sense_id": "30d34e1a-cbb4-39a1-be66-9fb72b46f96e",
                                                "text": "Meronym: mortuary science"
                                            },
                                            {
                                                "example_id": "df75234a-ffd3-45ff-96c3-0cc6d40f0d09",
                                                "sense_id": "30d34e1a-cbb4-39a1-be66-9fb72b46f96e",
                                                "text": "The work is part of a growing field called comparative thanatology — the study of how different animals react to death."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4de5727e-df48-4bd0-b656-159815fda91c",
