                        "entry_id": "982e38e5-4e26-3786-95d9-496141c01e11",
                        "glosses": [
                            "totstandkoming van iets dat daarvoor niet bestond"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fa99e53b-461f-446c-be96-6147e5e16333",
                                "sense_id": "b71ff7db-9150-396d-844b-6ecc36b1b56b",
                                "text": "Het is de moderne techniek, die ons overtuigt, dat er wèl iets nieuws is onder de zon; maar het was de moderne biologie, die ons de wezenlijke betekenis van de verandering, van de wording, van de nieuwvorming pas goed liet beseffen."
                            }
                        ]
