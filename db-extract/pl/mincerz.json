                "senses": [
                    {
                        "sense_id": "9e7abcf5-f72e-3547-8069-c7313ed57182",
                        "entry_id": "f9d10ba0-124d-35b5-9cd5-061f5144520c",
                        "glosses": [
                            "rzemieślnik zajmujący się biciem pieniądza metalowego"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e6317607-8368-400a-a381-51f97deaa933",
                                "sense_id": "9e7abcf5-f72e-3547-8069-c7313ed57182",
                                "text": "Mincerze zajmowali się nie tylko wytwarzaniem monet, lecz także spełniali inne funkcje skarbowe, np. sprzedaż soli monopolowej, ściganie fałszerzy pieniędzy, pobór podatków itp."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    },
                    {
                        "sense_id": "af70ab38-3b6e-3fbd-93d8-69c27e76448b",
                        "entry_id": "f9d10ba0-124d-35b5-9cd5-061f5144520c",
                        "glosses": [
                            "pracownik mennicy zajmujący się współcześnie wytwarzaniem monet obiegowych, medali, odznaczeń i pieczęci państwowych"
                        ],
                        "tags": [
                            "colloquial",
                            "professional"
                        ],
