                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2656e19-6ba7-43a6-a8cd-a739ccf255c0",
                                                "sense_id": "0344dfe3-f698-3f2e-bce5-9414fc94fe42",
                                                "text": "Os EUA dizem que os mísseis serviriam para impedir um ataque nuclear de países como Irã e Coréia do Norte."
                                            }
                                        ]
                                    },
