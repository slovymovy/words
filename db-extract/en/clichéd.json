                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "849df5c5-9ada-41dd-ac9b-ce259a68591e",
                                                "sense_id": "abbf5649-e876-366c-a456-a197b658fb77",
                                                "text": "Wie kannst du das immer wieder falsch machen? Das ist doch echt banal."
                                            },
                                            {
                                                "example_id": "7b24d936-f863-449a-a874-447a11496162",
                                                "sense_id": "abbf5649-e876-366c-a456-a197b658fb77",
                                                "text": "Die Lösung ist banal."
                                            },
                                            {
                                                "example_id": "d2c4c780-1ec1-4778-8c9d-da29f23f6a7a",
                                                "sense_id": "abbf5649-e876-366c-a456-a197b658fb77",
                                                "text": "„Die einfache Bewegung kommt uns banal vor.“"
                                            }
