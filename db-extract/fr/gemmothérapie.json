                "senses": [
                    {
                        "sense_id": "759f7633-390d-3356-badc-c4b54747e0f0",
                        "entry_id": "d873a9c4-8cdf-3dde-9fbc-aca0f3e8ad12",
                        "glosses": [
                            "Méthode thérapeutique utilisant essentiellement des bourgeons de plantes par voie interne comme traitement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6ed44b56-1b5f-4a3b-9519-e208e6d4117f",
                                "sense_id": "759f7633-390d-3356-badc-c4b54747e0f0",
                                "text": "Après la phytothérapie, c’est-à-dire l'emploi des plantes, vient la gemmothérapie, qui consiste en l’utilisation d’extraits embryonnaires végétaux (bourgeons et jeunes pousses)."
                            },
                            {
                                "example_id": "faaf0dc3-4f62-4a5a-accf-1cdd8caabce4",
                                "sense_id": "759f7633-390d-3356-badc-c4b54747e0f0",
                                "text": "Dans la boutique et sur le site Internet, vous trouverez des plantes médicinales issues de l’agriculture biologique pour cuisiner ou faire des infusions, des extraits liquides de plantes médicinales, de la gemmothérapie… et des conseils personnalisés !"
                            },
                            {
                                "example_id": "0f3b6854-57c0-49f2-8a27-a1f4864f4832",
                                "sense_id": "759f7633-390d-3356-badc-c4b54747e0f0",
                                "text": "Le bourgeon de tilleul est couramment utilisé en gemmothérapie pour ses effets relaxants."
                            }
                        ]
                    }
                ],
