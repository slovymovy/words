                {
                    "sense_id": "a6896802-e66e-3624-810e-f7651ee3a680",
                    "sense_definition": "Kwaśny owoc o żółtej skórce, bogaty w witaminę C.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "owoc",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Moja babcia pija wyłącznie herbatę z <w>cytryną</w>.",
                            "target_lang_translations": {
                                "ru": "Моя бабушка пьёт чай исключительно с <w>лимоном</w>.",
                                "en": "My grandmother only drinks tea with <w>lemon</w>."
                            }
                        },
                        {
                            "text": "Do przygotowania tej lemoniady potrzebna jest świeża <w>cytryna</w>.",
                            "target_lang_translations": {
                                "ru": "Для приготовления этого лимонада нужен свежий <w>лимон</w>.",
                                "en": "A fresh <w>lemon</w> is needed to prepare this lemonade."
                            }
                        }
                    ],
                    "common_phrases": [
                        "herbata z cytryną",
                        "świeża cytryna",
                        "wycisnąć cytrynę"
                    ],
                    "target_lang_definitions": {
                        "ru": "Кислый плод с жёлтой кожурой, богатый витамином C.",
                        "en": "A sour, yellow-skinned citrus fruit that is rich in vitamin C."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "лимон",
                                "target_lang_sense_clarification": "плод"
                            }
                        ],
                        "en": [
                            {
                                "target_lang_word": "lemon",
                                "target_lang_sense_clarification": "the fruit"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a4367d6e-02cd-38eb-8ff5-09fbb494b265",
                    "sense_definition": "Wiecznie zielone drzewo z rodzaju cytrusów, rodzące kwaśne, żółte owoce.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "drzewo",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "W oranżerii natknęliśmy się na rozłożyste <w>cytryny</w>, rosnące w ozdobnych donicach.",
                            "target_lang_translations": {
                                "ru": "В оранжерее мы наткнулись на раскидистые <w>лимоны</w>, растущие в декоративных горшках.",
                                "en": "In the orangery, we came across spreading <w>lemon trees</w> growing in decorative pots."
                            }
                        },
                        {
                            "text": "W ciepłym klimacie śródziemnomorskim <w>cytryna</w> rośnie bezpośrednio w gruncie.",
                            "target_lang_translations": {
                                "ru": "В тёплом средиземноморском климате <w>лимон</w> растёт прямо в грунте.",
                                "en": "In the warm Mediterranean climate, the <w>lemon tree</w> grows directly in the ground."
                            }
                        }
                    ],
                    "synonyms": [
                        "cytrynowiec",
                        "limonija"
                    ],
                    "common_phrases": [
                        "drzewko cytryny"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вечнозелёное дерево рода цитрусовых, приносящее кислые жёлтые плоды.",
                        "en": "An evergreen tree of the citrus genus that produces sour, yellow fruits."
                    },
