                        "target_lang_word": "Venedig",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Venedig",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "32b85845-0a17-392a-86e7-0cf74d07b51b",
                                        "entry_id": "e2ebc3d8-885f-3901-b4ea-9e6b846d152b",
                                        "glosses": [
                                            "Lagunenstadt in Italien, die wegen ihrer enormen Kunstschätze weltweit bekannt ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1cbc4147-c118-4234-bd4f-ed52191df9c6",
                                                "sense_id": "32b85845-0a17-392a-86e7-0cf74d07b51b",
                                                "text": "Venedig ist eine phantastische Stadt."
                                            },
                                            {
                                                "example_id": "dc928e74-94ce-445c-ad76-a21b5ba6a4b8",
                                                "sense_id": "32b85845-0a17-392a-86e7-0cf74d07b51b",
                                                "text": "„Du bist schön Venedig, von Wellen umgeben, / ruhiger Spiegel erhabener Kunstwerke!“ (Originali ital.: „Sei pur bella, Venezia, in mezzo all’onde / Specchio tranquillo ai monumenti alteri!“)"
                                            },
                                            {
                                                "example_id": "b8041381-6143-4b6f-9aeb-53a8b257d27a",
                                                "sense_id": "32b85845-0a17-392a-86e7-0cf74d07b51b",
                                                "text": "„Heute Morgen hat Steinsiek mit einem Bekannten geskypt, der in Venedig festsitzt.“"
                                            },
                                            {
                                                "example_id": "57f466e7-0e1b-402b-9f54-d1f799911f7d",
                                                "sense_id": "32b85845-0a17-392a-86e7-0cf74d07b51b",
                                                "text": "„Schon drei Tage nach der Vorführung auf dem Glockenturm von San Marco, die von starker Wirkung auf alle Beteiligten war, überreichte Galilei der Signoria von Venedig sein Fernrohr als Geschenk.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "0517de8e-0c83-3cf3-8bb2-59e146bfc4a5",
                                        "entry_id": "e2ebc3d8-885f-3901-b4ea-9e6b846d152b",
                                        "glosses": [
                                            "eine von sieben Provinzen in der Region Venetien, Italien"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5c5d2e83-817b-415a-a6e5-c3969f5d2f08",
                                                "sense_id": "0517de8e-0c83-3cf3-8bb2-59e146bfc4a5",
                                                "text": "„Venedig umfasst heute nicht nur die weltberühmte historische Inselstadt, sondern wie bereits erwähnt, ein seit 1926 auf das Festland erweitertes Stadtgebiet und zudem Hauptstadt der gleichnamigen Provinz Venedig und der Region Venetien, die in etwa der Verwaltungsebene „Bundesland“ in Deutschland entspricht.“"
                                            },
                                            {
                                                "example_id": "fd67c39e-83ec-45cb-8983-3ea43e6371de",
                                                "sense_id": "0517de8e-0c83-3cf3-8bb2-59e146bfc4a5",
                                                "text": "„Der Umfang des Landes entspricht ziemlich genau der heutigen Provinz Udine (6 570 qkm) und dem Distrikt Portogruaro (632 qkm) der Provinz Venedig abzüglich der Gemeinde Caorle (177 qkm); zusammen 7025 qkm.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "7bf65e90-81e9-3594-8a38-cf2b15453e92",
                                        "entry_id": "e2ebc3d8-885f-3901-b4ea-9e6b846d152b",
                                        "glosses": [
                                            "Republik (bis etwa 18. Jhd.) mit [1] als Hauptstadt"
                                        ],
                                        "tags": [
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1583245c-0086-4d7e-8671-a44ebdf08202",
                                                "sense_id": "7bf65e90-81e9-3594-8a38-cf2b15453e92",
                                                "text": "„Ruskin (1890) beispielsweise war absolut davon überzeugt, daß sich allein an den Artefakten aus der Spätzeit der Republik Venedigs ein Niedergang der venezianischen Kultur ablesen lasse.“"
                                            },
                                            {
                                                "example_id": "2f95588e-09aa-4cb7-a225-42356db88bb1",
                                                "sense_id": "7bf65e90-81e9-3594-8a38-cf2b15453e92",
                                                "text": "„Hätte man eingewilligt, dem Kaiser sofort die Lombardei zu geben; wäre man die Verpflichtung eingegangen, die Republik von Venedig in ihrem gegenwärtigen Zustande zu erhalten und die Democratie nicht bis zur Alpengrenze dringen zu lassen […].“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
