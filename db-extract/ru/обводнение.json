                "senses": [
                    {
                        "sense_id": "cad1f7c0-6cbb-30d3-9cca-892a2fb6f81b",
                        "entry_id": "795057a4-5463-31bc-bc93-5011b79deb16",
                        "glosses": [
                            "снабжение пресной водой путём устройства искусственных водоемов (прудов, каналов, колодцев и т.п.)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d04c46a4-3ec8-427b-a937-38581554b40e",
                                "sense_id": "cad1f7c0-6cbb-30d3-9cca-892a2fb6f81b",
                                "text": "Но главное и уже мирового масштаба — это влияние перекопа на заволжские степи: обводнение степных рек и речонок, питающих влагою степи, и этим поднятие урожайности и победа над засухой, создающей периодические голодовки в Самарской губернии."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b097fa6-6cf7-47aa-a897-0c779aaa44a7",
                        "source_entry_id": "795057a4-5463-31bc-bc93-5011b79deb16",
                        "source_sense_id": "cad1f7c0-6cbb-30d3-9cca-892a2fb6f81b",
                        "target_lang_word": "Bewässerung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Bewässerung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "221d2c38-a0fc-3abd-8b8b-376ad7b40f9a",
                                        "entry_id": "2c370269-9402-3a87-b32b-bf36526ecb49",
                                        "glosses": [
                                            "künstliche Zuführung von Wasser zu Feldern und Flächen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6d2ee105-a95a-45b6-b7f9-b00a641968a7",
                                                "sense_id": "221d2c38-a0fc-3abd-8b8b-376ad7b40f9a",
                                                "text": "Der Graben dient zur Bewässerung der Felder."
                                            },
                                            {
                                                "example_id": "b53b1831-4ad2-477e-8490-fedeeb63b2d5",
                                                "sense_id": "221d2c38-a0fc-3abd-8b8b-376ad7b40f9a",
                                                "text": "„Das war nur durch künstliche Bewässerung möglich, denn Peru besitzt gerade zur Pazifikküste große wüstenartige Trockengebiete.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "54d766ca-b697-4252-af05-d8669b31c4fe",
                        "source_entry_id": "795057a4-5463-31bc-bc93-5011b79deb16",
                        "source_sense_id": "cad1f7c0-6cbb-30d3-9cca-892a2fb6f81b",
                        "target_lang_word": "Berieselung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "42ff2c5c-f2d8-458d-bc90-34952770d974",
                        "source_entry_id": "795057a4-5463-31bc-bc93-5011b79deb16",
                        "source_sense_id": "cad1f7c0-6cbb-30d3-9cca-892a2fb6f81b",
                        "target_lang_word": "Wasserzufuhr",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wasserzufuhr",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                        "entry_id": "931420de-1764-3467-a231-f8bfd128926e",
                                        "glosses": [
                                            "Aufnahme beziehungsweise Zuführung von Wasser"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6c9a88f-1905-441b-89f0-705c75f03ade",
                                                "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                                "text": "„Der normale Organismus ist nur wenige Tage in der Lage, ohne Wasserzufuhr auszukommen.“"
                                            },
                                            {
                                                "example_id": "b7403f8d-3945-4bb7-996a-908525c4c38e",
                                                "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                                "text": "„Eine mangelhafte Wasserzufuhr verursacht im tierischen Organismus Störungen im Stoffwechsel und im Allgemeinbefinden.“"
                                            },
                                            {
                                                "example_id": "eb9f6aba-ef9a-4207-b58c-3b3ff40d608c",
                                                "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                                "text": "„Ein Minimum der Wasserzufuhr wird durch den Durst angefordert, während die obere Grenze der Wasserzufuhr viel mehr durch Gewohnheit bestimmt wird.“"
                                            },
                                            {
                                                "example_id": "77ef4b92-953a-4e17-bc0c-68dae6a407fd",
                                                "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                                "text": "„Es erstaunt somit nicht, dass die erwähnten kleinen Becken von zwei Wasserzufuhren aus dem großen Rückhaltebecken gespeist werden und ihrerseits das Wasser über zwei Kanalisationen abführen“"
                                            },
                                            {
                                                "example_id": "8a30afce-6bfd-4b3d-8847-e0841bdfce55",
                                                "sense_id": "b332bd5e-8c2d-380e-bfc5-0ffe6712e0d0",
                                                "text": "„Im Mai dieses Jahres hatte die Sindh-Regierung die Sperrung der Wasserzufuhr nach Pakka Qila veranlasst, um militante MQM-Anhänger zur Aufgabe im bewaffneten Konflikt zu bewegen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
