                    }
                ],
                "senses": [
                    {
                        "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                        "entry_id": "964ce0e4-4fe5-39b4-85da-be4b863e829b",
                        "glosses": [
                            "Qui est enfermé, emprisonné."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a34f2a31-76c3-4e40-90d8-89853ab0866e",
                                "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                                "text": "Qu’est-ce que me conseillerait ce claquemuré de Julius ?…"
                            },
                            {
                                "example_id": "1be195b9-7fe6-40cb-9fcc-3f87ccb500d8",
                                "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                                "text": "La chambre de Louise, minuscule, contenait un lit de fer, un berceau, une table qui supportait un réchaud ; elle dormait, cuisinait, mangeait, vivait avec un homme entre ces quatre murs ; tout au long du corridor, des familles étouffaient, claquemurées dans d’identiques réduits ; déjà la promiscuité dans laquelle je vivais et la monotonie des journées bourgeoises m’oppressaient."
                            },
                            {
                                "example_id": "e753b39b-8e89-464b-921b-a7160f4cc2cc",
                                "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                                "text": "Plus de dix fois dix portes plus dix — et quelles portes ! — de sa maison claquemurée."
                            },
                            {
                                "example_id": "09188a4c-4dd7-4f4c-8e93-3d72e6548773",
                                "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                                "text": "Malgré ces désagréments, je ne vis pas claquemuré et profite de chaque occasion pour me distraire."
                            },
                            {
                                "example_id": "ae9a26b6-17df-44f1-a986-81c0216b6128",
                                "sense_id": "7979e20f-7aa3-3072-84b2-b506b73e9026",
                                "text": "(Sens figuré) Pourquoi ne pas avoir le recul pour pardonner, pourquoi ne pas enlever une à une les épines pour ne garder que le bois pur, pourquoi rester claquemurée dans d’insondables mortifications infantiles ?"
                            }
                        ]
                    }
