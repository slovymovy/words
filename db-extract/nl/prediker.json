                    {
                        "translation_id": "e2f5abbe-a3a8-4b10-a49f-6711257f4f3a",
                        "source_entry_id": "93f85f51-88bb-3183-8106-44903a4f80cb",
                        "source_sense_id": "d7aada09-d8e4-38ed-949d-3647db77aa88",
                        "target_lang_word": "Ecclésiaste",
