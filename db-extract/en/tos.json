            {
                "entry_id": "36705208-d61a-3162-afb7-ed8797035b94",
                "word": "ToS",
                "pos": "noun",
                "lang_code": "en",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "0c39f791-d937-3be3-80c0-ac0537d33531",
                        "entry_id": "36705208-d61a-3162-afb7-ed8797035b94",
                        "glosses": [
                            "Alternative letter-case form of TOS (“terms of service”)."
                        ],
                        "tags": [
                            "alt-of"
                        ],
                        "examples": [
                            {
                                "example_id": "60e8454a-d912-493f-a098-3ad63197adff",
                                "sense_id": "0c39f791-d937-3be3-80c0-ac0537d33531",
                                "text": "Clearly, from Facebook’s ToS, neither sexting nor bullying will be tolerated on their network."
                            },
                            {
                                "example_id": "068efb53-8d1e-496e-934a-8774145e2247",
                                "sense_id": "0c39f791-d937-3be3-80c0-ac0537d33531",
                                "text": "Thus, crawlers that do not obey a website’s posted robots.txt file may be breaching the site’s ToS."
                            },
                            {
                                "example_id": "6adb484f-6f9b-42d4-84e4-588d800f41b2",
                                "sense_id": "0c39f791-d937-3be3-80c0-ac0537d33531",
                                "text": "While a company’s ToS is a legal contract that outlines the terms between a company and a user of its services, the community standards or guidelines is a more human-readable document that explains a platform’s rules and, sometimes, the consequences for violating those rules."
                            }
                        ]
                    }
                ],
