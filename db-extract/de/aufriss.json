                "senses": [
                    {
                        "sense_id": "ce7d2580-c0a5-3c27-80c2-257a2165a63a",
                        "entry_id": "5739f368-7124-3328-8794-46ee7da29174",
                        "glosses": [
                            "zeichnerische Darstellung der Vorder- oder Seitenansicht eines Gebäudes oder eines Objektes"
                        ],
                        "tags": [
                            "Ingenieurwesen"
                        ],
                        "examples": [
                            {
                                "example_id": "8ff7a451-21ca-40ad-b452-c75e5900117a",
                                "sense_id": "ce7d2580-c0a5-3c27-80c2-257a2165a63a",
                                "text": "Dieses Objekt müsste zunächst einmal im Aufriss dargestellt werden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e19d898e-55db-36b6-8bd6-532c4b2a479c",
                        "entry_id": "5739f368-7124-3328-8794-46ee7da29174",
                        "glosses": [
                            "kurzgefasste Darstellung eines bestimmten Themas oder eines bestimmten Stoffes"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7fa10dff-5660-4183-96b0-b8017d10086c",
                                "sense_id": "e19d898e-55db-36b6-8bd6-532c4b2a479c",
                                "text": "Dieser Aufriss der platonischen Ideenlehre war hoch anschaulich."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "8d8342a6-d334-38a6-b10e-8dd9db08a8ac",
                        "entry_id": "5739f368-7124-3328-8794-46ee7da29174",
                        "glosses": [
                            "das Aufreißen, also die Suche nach einem Freund oder einer Freundin"
                        ],
                        "tags": [
                            "casual",
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "7fcbd814-f55e-4c5d-94ea-2b9810d9c54e",
                                "sense_id": "8d8342a6-d334-38a6-b10e-8dd9db08a8ac",
                                "text": "Manchmal gehen auch Frauen auf Aufriss."
                            }
                        ],
                        "sense_index_json": "\"3\""
                    },
                    {
                        "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                        "entry_id": "5739f368-7124-3328-8794-46ee7da29174",
                        "glosses": [
                            "Zumessung einer großen Bedeutung"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4172a5d6-b24a-4136-ab99-78c0de9a42e1",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Ein großer Aufriss wurde deswegen nicht gemacht - es war wie eine Selbstverständlichkeit.“"
                            },
                            {
                                "example_id": "d7c3313c-8137-4a28-a325-72d2da916714",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„So weit habe ich es begriffen, wir reden nicht mehr von kleinen Nachlässigkeiten, Jup will den ganz großen Aufriss, damit ich sicher weggesperrt werde.“"
                            },
                            {
                                "example_id": "fd5bb95e-a0f2-44da-845f-bff08ea2bf43",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Jeder macht einen großen Aufriss um die Space Needle, dabei ist sie weder der höchste noch der billigste von Seattles wundervollen Aussichtspunkten.“"
                            },
                            {
                                "example_id": "456ed3fe-3068-4a92-bf6a-4f607db30062",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Vielleicht weil sie auf der Bühne stehen, ohne einen großen Aufriss darum zu machen.“"
                            },
                            {
                                "example_id": "e964a258-fa54-4968-acee-0d4ffbab7858",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Die Sitzbank an der Bahnhaltestelle war bereits besetzt, und ich wollte keinen großen Aufriss machen, die Leute dort herunter zu scheuchen, nur weil es mir dreckig ging.“"
                            },
                            {
                                "example_id": "cd1d3422-b8eb-408f-bb05-9ae030c5d241",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Mia wollte keinen großen Aufriss deswegen machen, es war nur ein Geburtstag und in ihrem Alter waren Geburtstage so wie so nicht mehr so toll.“"
                            },
                            {
                                "example_id": "8d3ef876-f63b-4bd4-a5f5-911e534645df",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Bei den Bordellbetreibern möchte ich noch keinen großen Aufriss machen, solange wir keine handfesten Hinweise auf eine mögliche Täterschaft haben.“"
                            },
                            {
                                "example_id": "79417c02-cf9d-4f85-a687-ae35176bbeec",
                                "sense_id": "d85449ce-c3c7-3c0c-8e85-698d697bb948",
                                "text": "„Die Erde ist auch nachtragend, würde aber keinen großen Aufriss machen, sondern Herrn Johannsen in Zukunft einfach mehr oder weniger ignorieren.“"
                            }
                        ],
                        "sense_index_json": "\"4\""
                    }
                ],
