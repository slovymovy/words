                                                "example_id": "224d6839-3f70-4977-b673-34e6f0acd710",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Ample discours."
                                            },
                                            {
                                                "example_id": "1fff8f6b-550e-4eca-9945-4c0d60edbd41",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Ample récit."
                                            },
                                            {
                                                "example_id": "95933d19-2c22-452e-b9d6-abd6b8b79581",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Ample sujet."
                                            },
                                            {
                                                "example_id": "8b431f81-7de2-4b44-b1ec-fa89b4bc22dd",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Une ample matière."
                                            },
                                            {
                                                "example_id": "e684cf4c-60ca-46ce-9c9a-dc124fcc9924",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Une relation bien ample."
                                            },
                                            {
                                                "example_id": "b23f98f9-bcb4-4184-8a94-7c4bec4287f2",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Un champ bien ample pour discourir."
                                            },
                                            {
                                                "example_id": "06d7b710-f283-4133-8dc5-74bdfc79d276",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Ample pouvoir."
                                            },
                                            {
                                                "example_id": "9fa63bbd-cc2e-4e9c-ad5f-6f754fcf04cd",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Permission très ample."
                                            },
                                            {
                                                "example_id": "9d82e138-4842-40a6-a9da-6bc008090fdf",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Il ne demandait qu’un congé d’un mois, on lui en a accordé un bien plus ample."
                                            },
                                            {
                                                "example_id": "a485c732-e139-4838-a255-534cf6ca3e65",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Cela demande un plus ample examen."
                                            },
                                            {
                                                "example_id": "9b59e0fa-83c1-4de8-9e93-2d793efb97de",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Un plus ample informé."
                                            },
                                            {
                                                "example_id": "e28bbfcc-2584-4aaa-96d2-cc62bc9906dd",
                                                "sense_id": "af5009f6-2d69-3a89-8ff2-4a6c6314f4c9",
                                                "text": "Une telle interprétation mériterait certes plus ample vérification dans le cadre belge, mais aussi à la lumière d’autres expériences européennes ou nord- américaines."
                                            }
                                        ]
                                    }
                                ]
                            }
