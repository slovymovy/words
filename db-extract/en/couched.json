                                "example_id": "b568c62a-dd3e-40e2-8bd0-0e8b6c874c37",
                                "sense_id": "49063cd6-e5e3-3d41-8a3c-f46cc25f9489",
                                "text": "Holmes gives us the Arms of the Name of TOURNEY, Or, a Cheveron couched Gules, Fig. 15. IF it be turned to the other Side, says he, it is termed couched sinister;[…]"
                            },
                            {
                                "example_id": "7f791b0d-0f94-40ae-919e-39e7e0d80c25",
                                "sense_id": "49063cd6-e5e3-3d41-8a3c-f46cc25f9489",
                                "text": "Argent, on a fesse sable, three chevronels couched sinister of the field. - TRENOWITH, Corn."
                            }
                        ]
                    }
