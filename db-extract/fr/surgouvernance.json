                        "examples": [
                            {
                                "example_id": "b462a97e-ae01-43f8-9e0c-cadc24b42135",
                                "sense_id": "29349e9b-878d-38a0-82a8-8fbc2de1364b",
                                "text": "«Les partis doivent reconnaître l’importance de régler les problèmes de surgouvernance et préciser les moyens qu’ils prendraient pour améliorer la situation."
                            },
                            {
                                "example_id": "2cf798eb-7ab9-4821-840f-a1484312e098",
                                "sense_id": "29349e9b-878d-38a0-82a8-8fbc2de1364b",
                                "text": "Volumineuses et complexes, les règles de notre parti démontrent clairement par leur seul poids mort à quel état de surgouvernance nous avons abouti."
                            },
                            {
                                "example_id": "b4cf59ba-47fa-4e6b-971d-3e6d12490860",
                                "sense_id": "29349e9b-878d-38a0-82a8-8fbc2de1364b",
                                "text": "Cette « surgouvernance affective » de l’eau, alors qu’elle est –à vous entendre– « sous-gouvernée » au niveau opérationnel, est peut-être nécessaire à la société."
                            }
                        ]
                    }
