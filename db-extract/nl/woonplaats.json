                    {
                        "form_id": "87496f2c-5073-41b6-88d1-3a52a78135f4",
                        "entry_id": "666f3e2f-e0e7-3580-887a-573c568227fe",
                        "tags": [
                            "plural"
                        ],
                        "form": "woonplaatsen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "5257b5ce-38ab-3d43-8e7e-edd33d8c3019",
                        "entry_id": "666f3e2f-e0e7-3580-887a-573c568227fe",
                        "glosses": [
                            "plaats waar men woont, waar men ingeschreven is in het bevolkingsregister"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b7eb631d-d2bc-4bf0-9bdc-3107cb3b994c",
                                "sense_id": "5257b5ce-38ab-3d43-8e7e-edd33d8c3019",
                                "text": "We waren daarvoor gekomen, en voor de romantische illusie om onze nieuwe woonplaats Venetië te zien door de ogen van de illustere toeristen die ons waren voorgegaan, zoals Stendhal, Lord Byron, Alexandre Dumas, Richard Wagner, Marcel Proust, Gustav Mahler, Thomas Mann, Ernest Hemingway, Rainer Maria Rilke, en die met zekerheid op deze zelfde stoelen hadden gezeten om hetzelfde uitzicht beroemd te maken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "11c27802-0abb-4632-9029-7c9ea23f396d",
                        "source_entry_id": "666f3e2f-e0e7-3580-887a-573c568227fe",
                        "source_sense_id": "5257b5ce-38ab-3d43-8e7e-edd33d8c3019",
                        "target_lang_word": "abode",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "abode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8d38691a-b263-3027-971a-f0decb865c7d",
                                        "entry_id": "faf0133b-7433-3305-9b61-9184b15a6ee8",
                                        "glosses": [
                                            "Act of waiting; delay."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c91995c1-cf65-4f0b-b50c-54ff75ac84c4",
                                                "sense_id": "8d38691a-b263-3027-971a-f0decb865c7d",
                                                "text": "Vpon his Courser set the louely lode, / And with her fled away without abode."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e690f37-a239-3046-bc42-40370a75db18",
                                        "entry_id": "faf0133b-7433-3305-9b61-9184b15a6ee8",
                                        "glosses": [
                                            "Stay or continuance in a place; sojourn."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4e99ce4a-c2b2-45dc-be26-d5bccf08354b",
                                                "sense_id": "2e690f37-a239-3046-bc42-40370a75db18",
                                                "text": "During the whole time of his abode in the university he generally spent thirteen hours of the day in study; by which assiduity besides an exact dispatch of the whole course of philosophy, he read over in a manner all classic authors that are extant[…]"
                                            },
                                            {
                                                "example_id": "3fe6d178-1072-4e8f-a32d-1169e28d8fb1",
                                                "sense_id": "2e690f37-a239-3046-bc42-40370a75db18",
                                                "text": "You behold, Sir, how he waxeth Wroth at your Abode here."
                                            },
                                            {
                                                "example_id": "578c67d0-9d41-4b95-81b7-b08bdd5cda69",
                                                "sense_id": "2e690f37-a239-3046-bc42-40370a75db18",
                                                "text": "The humor of my proposition appealed more strongly to Miss Trevor than I had looked for, and from that time forward she became her old self again;[…]. Our table in the dining-room became again the abode of scintillating wit and caustic repartee, Farrar bracing up to his old standard, and the demand for seats in the vicinity rose to an animated competition."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                        "entry_id": "faf0133b-7433-3305-9b61-9184b15a6ee8",
                                        "glosses": [
                                            "A residence, dwelling or habitation."
                                        ],
                                        "tags": [
                                            "formal"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4526c77c-ef1f-4786-881c-9c449974a42a",
                                                "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                                "text": "of no fixed abode"
                                            },
                                            {
                                                "example_id": "4fcd28d1-a639-4ca7-af58-c15b9358766b",
                                                "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                                "text": "Come let me lead you to our poor Abode."
                                            },
                                            {
                                                "example_id": "528bc35c-759e-4607-82c0-35bfdd8730c7",
                                                "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                                "text": "“I am of another world. I am John Carter, Prince of the House of Tardos Mors, Jeddak of Helium. Perchance some faint rumour of me may have leaked within the confines of your hellish abode.”"
                                            },
                                            {
                                                "example_id": "a8dd9164-ae51-40b4-9db7-e5189583fe80",
                                                "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                                "text": "He unrolled the newspaper baton idly and read idly:\nWhat is home without\nPlumtree's Potted Meat?\nIncomplete.\nWith it an abode of bliss."
                                            },
                                            {
                                                "example_id": "b4a8c524-e7f1-483f-ac80-0c913c393f7e",
                                                "sense_id": "87d6ad60-e7a6-3ee6-8560-7e57e8e83fa4",
                                                "text": "Here's an interesting effect of a global pandemic that has forced Americans to stay home for nearly 10 months: with less vacation and dine-out options, folks have more money saved up then usual and, given the virtually endless amount of time spent staring at their own four walls, they seem to be more willing than usual to shell out some extra cash to spruce up their abodes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ab65be0a-dc4c-3dfc-b679-b24dc2aeca17",
                                        "entry_id": "fd2d0d1f-6d39-3511-952f-5b6b6d394a54",
                                        "glosses": [
                                            "simple past and past participle of abide"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "aebb7e26-51c5-4046-a17e-c6940bc645b1",
                                                "sense_id": "ab65be0a-dc4c-3dfc-b679-b24dc2aeca17",
                                                "text": "The fine, soundless pulse of this game was in the air for our young woman while they remained in the shop. While they remained? They remained all day; their presence continued and abode with her, was in everything she did till nightfall...."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "d06871b8-215e-3e10-9db8-1e20ff00b876",
                                        "entry_id": "faebd9b1-b7e9-336c-8dd5-20daadf9d5c5",
                                        "glosses": [
                                            "An omen; a foretelling."
                                        ],
                                        "tags": [
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2a15db3a-1818-4d9a-9cc4-988d6133caac",
                                                "sense_id": "d06871b8-215e-3e10-9db8-1e20ff00b876",
                                                "text": "High-thundering Juno's husband, stirs my spirit with true abodes."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "abode",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b70939d5-62cb-314b-ac48-0606b5da943b",
                                        "entry_id": "16853733-a747-345d-b0b1-212eaaa47425",
                                        "glosses": [
                                            "To bode; to foreshow; to presage."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "cd9073e6-3f29-4f6b-9b80-7cd0b397ddd4",
                                                "sense_id": "b70939d5-62cb-314b-ac48-0606b5da943b",
                                                "text": "The night-crow cried, aboding luckless time"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "26f85c1d-3479-32c0-9dfd-6f2e174b2cb2",
                                        "entry_id": "16853733-a747-345d-b0b1-212eaaa47425",
                                        "glosses": [
                                            "To be ominous."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "obsolete"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
