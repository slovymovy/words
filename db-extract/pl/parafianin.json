                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7e0a4454-4963-48a9-ae8e-c2e8a4a4bc33",
                                                "sense_id": "77df290b-4d81-387f-b1de-c2b7fe786a5f",
