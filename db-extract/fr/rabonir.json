                ],
                "senses": [
                    {
                        "sense_id": "8fab05fd-8726-3497-a5d0-715220182c75",
                        "entry_id": "fe6c91f7-eaaf-36d6-8819-9c3b9574dfe8",
                        "glosses": [
                            "Rendre meilleur."
                        ],
                        "tags": [
                            "dated"
                        ],
                        "examples": [
                            {
                                "example_id": "168bf0ad-44b4-4ccf-aca3-7e8af650861d",
                                "sense_id": "8fab05fd-8726-3497-a5d0-715220182c75",
                                "text": "Il y en a qui, pus y deviennent vieux, pus y durcissent ; mais lui, il se fait doux comme votre cassis, et y rabonit."
                            },
                            {
                                "example_id": "d910e045-3b0d-4e2b-a86a-7f48b73bbe91",
                                "sense_id": "8fab05fd-8726-3497-a5d0-715220182c75",
                                "text": "Ils croyaient tout bêtement que la vertu du saint était de rabonir les gens. Ainsi, une femme l’avait prié de rabonir son mari, un ivrogne qui la battait."
                            }
                        ]
                    },
                    {
                        "sense_id": "420928e1-b0b5-3872-8134-02532b17f816",
                        "entry_id": "fe6c91f7-eaaf-36d6-8819-9c3b9574dfe8",
                        "glosses": [
                            "Devenir meilleur."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "53f0cbd3-bf20-47c6-9130-807f92b0c4de",
                                "sense_id": "420928e1-b0b5-3872-8134-02532b17f816",
                                "text": "Elle se rabonit. Je m’assis près du lit, et je lui pris la main."
                            }
                        ]
                    }
                ],
