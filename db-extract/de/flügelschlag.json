                ],
                "senses": [
                    {
                        "sense_id": "f01cc73d-56b9-39d6-a9af-e0401de3053c",
                        "entry_id": "b8ba2d92-3946-3421-8501-a8866b88e985",
                        "glosses": [
                            "Bewegung von Flügeln"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5a8a4ca6-bd10-4ec0-bba5-f631406b501e",
                                "sense_id": "f01cc73d-56b9-39d6-a9af-e0401de3053c",
                                "text": "Ein Kolibri schafft bis zu 90 Flügelschläge pro Sekunde."
                            },
                            {
                                "example_id": "dd15a6ed-4f40-4a8e-8898-285b5afdb745",
                                "sense_id": "f01cc73d-56b9-39d6-a9af-e0401de3053c",
                                "text": "„Sein Anruf bei der Polizei nach dem Entdecken eines verdächtigen Klebebands an einer Tür erscheint wie der Flügelschlag des Schmetterlings, der einen Tornado auslöste.“"
                            },
                            {
                                "example_id": "1bd036a8-6c61-48db-9546-179727f3aa35",
                                "sense_id": "f01cc73d-56b9-39d6-a9af-e0401de3053c",
                                "text": "„Die Tauben weichen ihr aus, unsicher wohin, kreuzen wieder ihren Weg, flattern und fliegen schließlich mit sirrendem Flügelschlag auf.“"
                            },
                            {
                                "example_id": "0cb3db46-4dab-4b04-abc1-25960d986357",
                                "sense_id": "f01cc73d-56b9-39d6-a9af-e0401de3053c",
                                "text": "„Ein riesiger Dohlenschwarm war über den Mauern aufgestiegen und kreiste mit tausendfachem Flügelschlag und Gekrächze in der Luft.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
