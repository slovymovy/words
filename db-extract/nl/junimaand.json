                        "examples": [
                            {
                                "example_id": "4f7c43c6-24b2-4461-9a51-98e3264637e1",
                                "sense_id": "3727b6f7-939a-305c-8c5e-a7de9be82ed5",
                                "text": "Zijn ogen leken er nog donkerder door, en zijn verkreukelde linnen jasje en lichtgewicht broek waren niet bepaald geschikt voor het Engelse weer, gezien de junimaand van dit jaar."
                            },
                            {
                                "example_id": "67e9c1fb-f040-4fdd-a3bf-5938395405a5",
                                "sense_id": "3727b6f7-939a-305c-8c5e-a7de9be82ed5",
                                "text": "In Moskou (34,7 graden) werd vorige week de warmste junidag in 120 jaar gemeten. Onder meer Kiev (Oekraïne) en Boedapest (Hongarije) beleven de warmste junimaand ooit."
                            }
                        ]
