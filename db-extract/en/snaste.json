                        "entry_id": "786bb1b6-01fb-3d8b-a12c-b4dbeca77191",
                        "glosses": [
                            "The burnt or burning part of the wick of a candle; the snuff."
                        ],
                        "tags": [
                            "dialectal",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "270e82e4-df52-476d-91d1-dfbb851a84a9",
                                "sense_id": "d7b52329-ca04-3b9b-9498-59138b0fd654",
                                "text": "Till some part of the candle was consumed, and the dust gathered about the snaste; but then it made the snaste big, and long, and to burn duskishly."
                            },
                            {
                                "example_id": "e117221b-a000-41bb-8bbf-155705a925f3",
                                "sense_id": "d7b52329-ca04-3b9b-9498-59138b0fd654",
                                "text": "A coming letter is foretold by a projecting spark on the snaste."
                            },
                            {
                                "example_id": "cb9b4ece-2305-407f-aa44-58e3f5f3c5c3",
                                "sense_id": "d7b52329-ca04-3b9b-9498-59138b0fd654",
                                "text": "As that snaste of that candle, goos out."
                            }
                        ]
                    }
