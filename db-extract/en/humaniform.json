                        "examples": [
                            {
                                "example_id": "dd89d1e9-58f9-46ca-b562-eadb3bcf1795",
                                "sense_id": "88c50ed3-a48f-3adc-9379-49ea35d16ac4",
                                "text": "The meaning of the word God or its equivalent in any other word, has been developed first from man's physical nature and wants, then from his intellectual. And has been all the time changing from the definite, visible, tangible, audible and humaniform, and plural, to the solitary, invisible, intangible, inaudible, and to the too indefinite for exact expression...."
                            },
                            {
                                "example_id": "e8dbbca2-a005-46be-b543-7845b58d4700",
                                "sense_id": "88c50ed3-a48f-3adc-9379-49ea35d16ac4",
                                "text": "Darcy frowned slightly as he studied the robot. It was a new model, a little more humaniform than the older models were."
                            },
                            {
                                "example_id": "ed1c028b-18f3-4759-a9e8-fcc2328daa0a",
                                "sense_id": "88c50ed3-a48f-3adc-9379-49ea35d16ac4",
                                "text": "We did our best with the humaniform medical equipment that was available."
                            }
                        ]
                    }
