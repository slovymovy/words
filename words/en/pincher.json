{
    "word_family": [
        "pinch"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "bc15dbec-eb95-30d0-bed9-ad9b2c4d5614",
                    "sense_definition": "A person or thing that pinches or squeezes tightly.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "pincher_squeeze",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The crab is a notorious <w>pincher</w>, so be very careful when picking it up.",
                            "target_lang_translations": {
                                "de": "Die Krabbe ist ein berüchtigter <w>Kneifer</w>, seien Sie also sehr vorsichtig, wenn Sie sie aufheben."
                            }
                        },
                        {
                            "text": "He proved to be a real penny <w>pincher</w> who refused to spend money even on basic necessities.",
                            "target_lang_translations": {
                                "de": "Er erwies sich als echter <w>Knauser</w>, der sich weigerte, selbst für die grundlegendsten Notwendigkeiten Geld auszugeben."
                            }
                        }
                    ],
                    "common_phrases": [
                        "penny pincher"
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person oder Sache, die zwickt, kneift oder fest zusammendrückt."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kneifer",
                                "target_lang_sense_clarification": "Person oder Tier, die/das kneift"
                            },
                            {
                                "target_lang_word": "Zwicker",
                                "target_lang_sense_clarification": "Person oder Sache, die zwickt"
                            },
                            {
                                "target_lang_word": "Knauser",
                                "target_lang_sense_clarification": "im übertragenen Sinne bei 'penny pincher'"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "22f81c2d-44ae-39ce-8abf-20a451888d1a",
                    "sense_definition": "A person who steals; a petty thief.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "pincher_thief",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopkeeper warned everyone that the new boy was a habitual <w>pincher</w>.",
                            "target_lang_translations": {
                                "de": "Der Ladenbesitzer warnte alle davor, dass der neue Junge ein gewohnheitsmäßiger <w>Langfinger</w> sei."
                            }
                        },
                        {
                            "text": "They all knew he was a petty <w>pincher</w> who took anything left unattended.",
                            "target_lang_translations": {
                                "de": "Sie alle wussten, dass er ein <w>Kleindieb</w> war, der alles mitnahm, was unbeaufsichtigt herumlag."
                            }
                        }
                    ],
                    "synonyms": [
                        "thief",
                        "pilferer"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "Used colloquially for someone who steals or pilfers."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Eine Person, die stiehlt; ein Gelegenheits- oder Kleindieb."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Langfinger",
                                "target_lang_sense_clarification": "umgangssprachlich für Dieb"
                            },
                            {
                                "target_lang_word": "Mopsen",
                                "target_lang_sense_clarification": "abgeleitet von klauen/stibitzen"
                            },
                            {
                                "target_lang_word": "Kleindieb",
                                "target_lang_sense_clarification": "Person, die Kleinigkeiten entwendet"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "677ecc58-ead0-3105-97b2-cf1730925ccf",
                    "sense_definition": "Dated form of <w>pincer</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "pincher_pincer",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The blacksmith reached into the toolbox for a large <w>pincher</w> to grip the hot iron.",
                            "target_lang_translations": {
                                "de": "Der Schmied griff in den Werkzeugkasten nach einer großen <w>Zange</w>, um das heiße Eisen zu fassen."
                            }
                        },
                        {
                            "text": "An old pair of <w>pinchers</w> lay rusting beside the workbench in the shed.",
                            "target_lang_translations": {
                                "de": "Eine alte <w>Kneifzange</w> rostete neben der Werkbank im Schuppen vor sich hin."
                            }
                        }
                    ],
                    "synonyms": [
                        "pincer"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "Dated spelling/variant of pincer."
                        },
                        {
                            "trait_type": "form",
                            "comment": "Dated form of pincer."
                        }
                    ],
                    "target_lang_definitions": {
                        "de": "Veraltete Form von pincer: Kneifzange oder Schere (bei Tieren)."
                    },
                    "translations": {
                        "de": [
                            {
                                "target_lang_word": "Kneifzange",
                                "target_lang_sense_clarification": "Werkzeug zum Greifen oder Schneiden"
                            },
                            {
                                "target_lang_word": "Beißzange",
                                "target_lang_sense_clarification": "Handwerkzeug"
                            },
                            {
                                "target_lang_word": "Zange",
                                "target_lang_sense_clarification": "allgemeines Greifwerkzeug"
                            }
                        ]
                    }
                }
            ]
        },
        {
