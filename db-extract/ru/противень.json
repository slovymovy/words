                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4e93ecf4-975b-4559-baaf-8ebf52b7e210",
                        "source_entry_id": "56d75546-b45a-3de1-91ae-f312393b7ed5",
                        "source_sense_id": "4c48d0df-5e2a-3f5b-a41e-e39afd2be849",
