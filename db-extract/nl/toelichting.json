                        "translation_id": "3da66e8f-eea3-4485-ba66-9f61469daf0a",
                        "source_entry_id": "f0b959da-b782-331a-b53b-2cb6b97b8e22",
                        "source_sense_id": "ec2205be-7636-3f19-9352-c60a278dbb3b",
                        "source_sense_description": "nadere tekst om het te verduidelijken",
                        "target_lang_word": "Erläuterung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erläuterung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "Erklärung (von Zusammenhängen, Sachverhalten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d8097fa6-da91-4a30-bdc4-a5133b081776",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "Die Erläuterungen des Vortragenden waren viel zu umständlich."
                                            },
                                            {
                                                "example_id": "b9611590-50de-41c2-8419-2654c873bab8",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Nach dieser Erläuterung erzählte der Mönch die Geschichte der Bank zu Ende, denn die Griechen hatten es nicht bei ihrem Mißtrauen belassen.“"
                                            },
                                            {
                                                "example_id": "45c60c16-f36a-4f67-9f5e-b13c0c5fab60",
                                                "sense_id": "ff8b494c-73d9-3858-8a48-477fe005138c",
                                                "text": "„Um einen guten und gut erzählten Witz zu verstehen, braucht man natürlich keine Erläuterungen, schon gar keine sprachwissenschaftlich oder sonstwie wissenschaftlich untermauerten.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                        "entry_id": "d53109ef-8c52-314e-9732-421069f6a75d",
                                        "glosses": [
                                            "ein Rechtsbehelf"
                                        ],
                                        "tags": [
                                            "schweizerisches Verwaltungsrecht"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4bb3b5df-d1e0-4d72-b052-06ea54523583",
                                                "sense_id": "309c8500-ae51-3110-9a21-b74b6d0c723d",
                                                "text": "Sowohl Erläuterung als auch Berichtigung haben nicht den Zweck der Änderung eines Entscheides, sondern nur einer Klarstellung."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aef4b40d-cd4a-457e-b681-e723306ffadb",
                        "source_entry_id": "f0b959da-b782-331a-b53b-2cb6b97b8e22",
                        "source_sense_id": "ec2205be-7636-3f19-9352-c60a278dbb3b",
                        "source_sense_description": "nadere tekst om het te verduidelijken",
                        "target_lang_word": "explanation",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "explanation",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "The act or process of explaining."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "60906a1d-055d-4ea9-9831-60470e103713",
                                                "sense_id": "dcba4dc7-09bc-3a91-93f8-db9aaf29acb2",
                                                "text": "The explanation was long and drawn-out."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "Something that explains or makes understandable."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bf764402-80f1-4def-944f-8a53943d6e83",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "An explanation for the UFO sightings was easily found."
                                            },
                                            {
                                                "example_id": "cd63b806-2b9c-4ecc-960a-4e7860d0e759",
                                                "sense_id": "30fa8df3-2483-3919-80b8-67bb5439ac16",
                                                "text": "The socialist will, of course, see in this merely a proof that the more intelligent person is today bound to become a socialist. But this is far from being the necessary or even the most likely explanation."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                        "entry_id": "c41814ee-a326-3aa0-a00c-b21c1adfd30b",
                                        "glosses": [
                                            "A resolution of disputed points pursuant to discussion; a mutual clarification of disputed points; reconciliation."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c5ace244-1b22-4335-8a9a-4abdf818a43f",
                                                "sense_id": "42a55c3b-bc18-3e85-ad5a-82d715911072",
                                                "text": "This little explanation with Mr. Knightley gave Emma considerable pleasure."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "aa491b90-f902-4a75-aa31-235d64cfcf47",
                        "source_entry_id": "f0b959da-b782-331a-b53b-2cb6b97b8e22",
                        "source_sense_id": "ec2205be-7636-3f19-9352-c60a278dbb3b",
                        "source_sense_description": "nadere tekst om het te verduidelijken",
                        "target_lang_word": "commentaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "commentaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "96757144-efbe-3757-87b1-98201e59710c",
                                        "entry_id": "9b23dbbd-0f38-3d0f-a43b-abf413e916c1",
                                        "glosses": [
                                            "Éclaircissements, observations et remarques sur un livre, sur un texte, pour en faciliter l’intelligence."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6b96e493-b49e-48b6-9f87-66220320c52b",
                                                "sense_id": "96757144-efbe-3757-87b1-98201e59710c",
                                                "text": "La musique exprime les sentiments, mais elle serait bien empêchée de les définir, et, sans le commentaire des paroles, absent de la musique instrumentale, l’auditeur reste toujours dans un certain vague quant à la nature et à l’objet du sentiment dont s’est inspiré le musicien."
                                            },
                                            {
                                                "example_id": "bcf39b04-07c3-4532-9e78-a8696221a977",
                                                "sense_id": "96757144-efbe-3757-87b1-98201e59710c",
                                                "text": "Je passai les heures qui suivirent à rédiger des missives à ce joueur de golf. Monsieur Saito rythmait ma production en la déchirant, sans autre commentaire que ce cri qui devait être un refrain."
                                            },
                                            {
                                                "example_id": "0e57e7c8-7757-4e8c-a7a5-767634dab7c6",
                                                "sense_id": "96757144-efbe-3757-87b1-98201e59710c",
                                                "text": "Et sans doute avait-il encore moins envie de faire le moindre commentaire sur l’interminable litanie des propos rabat-joie que L’Ecclésiaste donne à entendre dans la Bible."
                                            },
                                            {
                                                "example_id": "0553bcb1-deb0-454a-a12d-fc6f9afac6af",
                                                "sense_id": "96757144-efbe-3757-87b1-98201e59710c",
                                                "text": "Les sources auxquelles j’ai puisé pour mon travail sont malheureusement loin d’être abondantes. On sait que les commentaires de Sylla ont péri, ainsi que les livres de Tite-Live qui racontaient la guerre sociale."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e35ebecf-e811-358e-b3c4-4ba3a4db5254",
                                        "entry_id": "9b23dbbd-0f38-3d0f-a43b-abf413e916c1",
                                        "glosses": [
                                            "Interprétation, le plus souvent maligne, qu’on donne aux paroles ou aux actions de quelqu’un."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b82da4f-66df-404f-8af8-bf07253328de",
                                                "sense_id": "e35ebecf-e811-358e-b3c4-4ba3a4db5254",
                                                "text": "Avec le principe de responsabilité en cascade, le blogueur passe du statut d’éditeur à celui d’hébergeur vis-à-vis des internautes qui laissent des commentaires sur son blog."
                                            },
                                            {
                                                "example_id": "2532977f-d097-48bb-a7f6-21804d4be064",
                                                "sense_id": "e35ebecf-e811-358e-b3c4-4ba3a4db5254",
                                                "text": "[…], mais l'examen ne se prolonge pas « tant qu'et plus », le maillot trop large et le cuissard qui tombe sur les genoux suscitent vite un commentaire.\n— Vous êtes fagoté comme l’as de pique. C'est la dernière mode à Paris ?\nLes considérations surprennent par leur franchise et plus encore par leur drôlerie, […]."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
