                                        "entry_id": "e84e5a81-7fcf-329c-9d97-344fb8ea762e",
                                        "glosses": [
                                            "The process by which something rots."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "779407e5-b0b7-45a6-812b-6766684ef722",
                                                "sense_id": "7ebbc243-277d-39ff-8ec0-1ded9ce6c38d",
                                                "text": "[…] the mould on the boles of the other [trees], that lyes commonly there, and is made of the annual rottings of their own leaves."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20b8ceba-87da-3a2a-9ca7-cb534f5a2075",
                                        "entry_id": "e84e5a81-7fcf-329c-9d97-344fb8ea762e",
                                        "glosses": [
                                            "Material that has rotted."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2750d998-3fbd-49c2-b618-02e0a67975f8",
                                                "sense_id": "20b8ceba-87da-3a2a-9ca7-cb534f5a2075",
                                                "text": "From the compost rinds and rottings, from the garbage peels, from the shadows' darkness, darkness, this guttered meal and all its redolence."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "394f1b99-b0bd-4d9d-9e15-04be72ea4cd5",
                        "source_entry_id": "a328b284-b413-3f99-8ac2-99e23281ea6e",
                        "source_sense_description": "Putréfaction",
