                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a61f43af-5798-4521-8e30-d6fc5d245522",
                                                "sense_id": "5783da79-3a41-303f-8a53-412e8d71eb8e",
                                                "text": "The dolphins became entangled in a fishing net."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e2246c02-1806-36e4-a43c-be4756dddd41",
                                        "entry_id": "4e4c2afb-7226-3ae1-916a-92c0d6e5cb42",
                                        "glosses": [
                                            "To involve in such complications as to render extrication difficult."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "2ed679f3-4a18-3d4b-ba75-3ecb51ccf33c",
                                        "entry_id": "4e4c2afb-7226-3ae1-916a-92c0d6e5cb42",
                                        "glosses": [
                                            "To ensnare."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "638df3d9-49b0-4d33-a7d7-1ded3fa30c52",
                                                "sense_id": "2ed679f3-4a18-3d4b-ba75-3ecb51ccf33c",
                                                "text": "But when I turn away, / Thou, willing me to stay, / Wooest not, nor vainly wranglest; / But, looking fixedly the while, / All my bounding heart entanglest, / In a golden-netted smile; […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fcee539b-2b0c-3dd2-99a7-2f3864ecbcc6",
                                        "entry_id": "4e4c2afb-7226-3ae1-916a-92c0d6e5cb42",
