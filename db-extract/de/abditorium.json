                        "tags": [
                            "general"
                        ],
                        "examples": [
                            {
                                "example_id": "8ea77878-1562-477b-8cbb-bbef778b8fa6",
                                "sense_id": "498f46f7-2d93-343e-be6b-32e3e3c531e0",
                                "text": "Die Gebrüder Grimm übersetzen in ihrem Wörterbuch das Wort „Hudelwinkel“ mit Abditorium."
                            },
                            {
                                "example_id": "b34db565-531e-4ae4-bf8b-59570f4c0b49",
                                "sense_id": "498f46f7-2d93-343e-be6b-32e3e3c531e0",
                                "text": "Das alte Abditorium wurde bei Ausgrabungen gefunden, die vor den Bauarbeiten zum neuen Einkaufszentrum stattfanden."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "6640e419-2cb8-310c-8993-d2546da27233",
