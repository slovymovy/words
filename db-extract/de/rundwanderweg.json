                "senses": [
                    {
                        "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                        "entry_id": "74d5e566-d060-375e-b9dc-de9f589040f6",
                        "glosses": [
                            "zum Ausgangspunkt wieder zurückführender Wanderweg"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4d212747-0274-4244-8045-dee209d28ec7",
                                "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                                "text": "Den Rundwanderweg im Allgäu habe ich locker in fünfundvierzig Minuten durchwandert."
                            },
                            {
                                "example_id": "d71743f5-8bdb-4273-8a4a-2efcf8da4af8",
                                "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                                "text": "„Erlebnisstationen ergänzen nun den bestehenden Hohenbrunner Rundwanderweg.“"
                            },
                            {
                                "example_id": "c99a9fd5-8d72-429f-84a8-9cae849d035e",
                                "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                                "text": "„Über Alpenpässe und an klaren Bergseen vorbei: Wer eine Hüttenwanderung machen möchte, kann sich den neuen Rundwanderweg ‚Trekking dei laghetti alpini‘ vornehmen.“"
                            },
                            {
                                "example_id": "07bab16f-1e6c-4f74-90bd-213328ef17d2",
                                "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                                "text": "„In diesem Gebiet sind Rundwanderwege mit einer Gesamtlänge von rund Hundert Kilometern vom Deutschen Wanderinstitut zertifiziert worden.“"
                            },
                            {
                                "example_id": "7d22eeb7-0b81-489f-88f5-963b361876b9",
                                "sense_id": "6031d98b-8c48-3e81-b3aa-420a490e16bb",
                                "text": "„Dem folgten der Abriss der militärischen Einrichtungen, der Abtransport von nicht naturgerechtem Kalkschotter und die Anlage eines Rundwanderweges.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
