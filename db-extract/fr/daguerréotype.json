                                "target_senses": [
                                    {
                                        "sense_id": "64edd6d6-d0dd-32d7-bf6c-af9a27d0a796",
                                        "entry_id": "e1e993a3-222d-37a4-8771-e70b8719e567",
                                        "glosses": [
                                            "primitieve foto in waarbij een gepolijste, met kwikdampen geprepareerde plaat is gebruikt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e6fb7e4f-afa2-42b3-91c6-4359236afe97",
                                                "sense_id": "64edd6d6-d0dd-32d7-bf6c-af9a27d0a796",
                                                "text": "De reeks clichés, van het daguerreotype, wordt beschouwd als de allereerste fotoreportage ter wereld."
                                            },
                                            {
                                                "example_id": "e21c4fe9-5ac0-4618-bd45-977720e67e00",
                                                "sense_id": "64edd6d6-d0dd-32d7-bf6c-af9a27d0a796",
                                                "text": "De daguerreotype, uitgevonden door Louis Daguerre in 1839, wordt gezien als de oudste vorm van fotografie en biedt een uniek beeld van 150 jaar geleden."
                                            },
                                            {
                                                "example_id": "8e4c3b59-17fc-422f-8452-764e72a40d93",
                                                "sense_id": "64edd6d6-d0dd-32d7-bf6c-af9a27d0a796",
                                                "text": "Ter gelegenheid van het honderdjarige bestaan van de collectie organiseerde men een expositie, waarbij David Acton de catalogus voor zijn rekening nam: een prachtig overzicht van de geschiedenis van de fotografie, van de eerste daguerreotypen uit de periode 1840-1845 tot aan de digitale fotografie van bijvoorbeeld Uta Barth en Richard Misrach."
                                            },
                                            {
                                                "example_id": "49c83b19-a348-4c63-a689-38d86bd5b6f4",
                                                "sense_id": "64edd6d6-d0dd-32d7-bf6c-af9a27d0a796",
                                                "text": "Vanwege de scherpe beelden en unieke waarde zijn daguerreotypes nog zeer gezocht."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
