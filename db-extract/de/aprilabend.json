                ],
                "senses": [
                    {
                        "sense_id": "9dbabe6f-9f68-3707-bf62-f19078d06283",
                        "entry_id": "bce482bb-ae7c-383d-bd41-7d995611ac76",
                        "glosses": [
                            "Abend im April"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fbe16120-b1f3-4ba7-b85d-eca1f0a7b2e5",
                                "sense_id": "9dbabe6f-9f68-3707-bf62-f19078d06283",
                                "text": "Meta kam an einem Aprilabend."
                            },
                            {
                                "example_id": "180e7516-ab0e-4a0e-a160-f398b2958baa",
                                "sense_id": "9dbabe6f-9f68-3707-bf62-f19078d06283",
                                "text": "„An einem feuchten, trüben Aprilabend kurz nach Ende des Ersten Weltkriegs war Marcia allein mit ihren seltsamen Gedanken und Wünschen.“"
                            },
                            {
                                "example_id": "f46c90d9-16c2-4f2f-aa20-28c812a5c0f1",
                                "sense_id": "9dbabe6f-9f68-3707-bf62-f19078d06283",
                                "text": "„Sylvia schwirrte von Gast zu Gast, und es waren so viele, dass sie sich an diesem milden Aprilabend bis auf die Straße verteilten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
