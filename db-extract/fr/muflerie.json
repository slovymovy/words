        "fr-extract.jsonl": [
            {
                "entry_id": "bc94b596-89bc-3f87-be95-88ccf48b96a7",
                "word": "muflerie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8831af7b-06ef-404f-8961-58fda56b2c0a",
                        "entry_id": "bc94b596-89bc-3f87-be95-88ccf48b96a7",
                        "tags": [
                            "plural"
                        ],
                        "form": "mufleries"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "b5c6dffe-ff60-393e-86f3-567655beccb8",
                        "entry_id": "bc94b596-89bc-3f87-be95-88ccf48b96a7",
                        "glosses": [
                            "Comportement caractérisé par un manque d'égards pour les autres."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1bfeb989-61be-42eb-b36e-7c8fb07e89d1",
                                "sense_id": "b5c6dffe-ff60-393e-86f3-567655beccb8",
                                "text": "Même, après coup, il s’en amusait, car il y avait en lui, rachetée par de rares délicatesses, une certaine muflerie."
                            },
                            {
                                "example_id": "a3fa1ea3-b9fc-497a-a31f-183c4f032155",
                                "sense_id": "b5c6dffe-ff60-393e-86f3-567655beccb8",
                                "text": "Et avec cette muflerie intermittente qui reparaissait chez lui dès qu’il n’était plus malheureux et qui baissait du même coup le niveau de sa moralité, il s’écria en lui-même : « Dire que j’ai gâché des années de ma vie, que j’ai voulu mourir, que j’ai eu mon plus grand amour, pour une femme qui ne me plaisait pas, qui n’était pas mon genre ! »"
                            },
                            {
                                "example_id": "3efd4e56-528e-4b1d-930d-c7826cbe7ed9",
                                "sense_id": "b5c6dffe-ff60-393e-86f3-567655beccb8",
                                "text": "La muflerie est le projet inverse de la galanterie : traiter l’autre en instrument dont on se débarrasse une fois qu’il a servi."
                            },
                            {
                                "example_id": "cc7fa352-71ee-4ed3-9933-97a0d7abb048",
                                "sense_id": "b5c6dffe-ff60-393e-86f3-567655beccb8",
                                "text": "Et il y a la muflerie devenue courante de ceux qui fendent la foule les yeux rivés sur leur téléphone portable ou qui conversent à voix très haute avec une présence invisible comme si vous qui êtes réellement présent n'existiez pas."
                            }
                        ]
                    },
                    {
                        "sense_id": "1e513c77-b1c8-3e18-892b-9ef563247313",
                        "entry_id": "bc94b596-89bc-3f87-be95-88ccf48b96a7",
                        "glosses": [
                            "Parole insultante, irrespectueuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fde1b3c9-4df4-4a55-8fb5-634539c3c1ea",
                                "sense_id": "1e513c77-b1c8-3e18-892b-9ef563247313",
                                "text": "Il a dit une muflerie."
                            }
                        ]
                    }
                ],
