                {
                    "sense_id": "25457a57-5cb4-3b37-ab1c-44a4969afb56",
                    "sense_definition": "To stay in hiding or concealment.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "hiding",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The wounded animal chose to <w>abscond</w> in the deep forest until it had fully recovered."
