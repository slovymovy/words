                "senses": [
                    {
                        "sense_id": "c4d0caf8-23b8-3f10-a7c9-37b227034879",
                        "entry_id": "5a8ab8ef-2467-3ace-88aa-c3e46948b6af",
                        "glosses": [
                            "Mandelbrotmenge"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a603da1c-2edf-475a-a2e6-fb6ebe49be28",
                                "sense_id": "c4d0caf8-23b8-3f10-a7c9-37b227034879",
                                "text": "„Man kann mit einiger Sicherheit davon ausgehen, dass das Wort \"Fraktal\" und die unzähligen Bilder vom Apfelmännchen und seinen Verwandten nie das große Publikum erreicht hätten, wenn nicht Benoît Mandelbrot sich so unermüdlich für ihre Popularisierung eingesetzt hätte.“"
                            },
                            {
                                "example_id": "b5b4570a-8651-4e40-9aea-59ca2fdb5480",
                                "sense_id": "c4d0caf8-23b8-3f10-a7c9-37b227034879",
                                "text": "„Er hat die kompliziert polyfone Jodel- und Trommelmusik der Pygmäen studiert und sich für die Apfelmännchen der fraktalen Geometrie begeistert, […]“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
