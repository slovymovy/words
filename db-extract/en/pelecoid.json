                "senses": [
                    {
                        "sense_id": "dc5363e6-f00b-35a4-b911-c246390f9a37",
                        "entry_id": "b5584e48-3d6e-364f-8b4a-e7a240005523",
                        "glosses": [
                            "Hatchet-shaped."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e76767f3-40e3-4e0d-84cb-964d42a0b95d",
                                "sense_id": "dc5363e6-f00b-35a4-b911-c246390f9a37",
                                "text": "He whom nature has supplied with a pelecoid nose is as cold, keen and sharp as the hatchet after which it was modeled. He is generally a dyspeptic, and hates people."
                            },
                            {
                                "example_id": "d97be1ce-76f4-4ee2-b214-97f5dd5d1b51",
                                "sense_id": "dc5363e6-f00b-35a4-b911-c246390f9a37",
                                "text": "Two more rows like the ones already constructed, except as to color, complete the pattern, which, when finished, forms a pleasing array of orderly pelecoid figures."
                            },
                            {
                                "example_id": "56d4da95-0bb3-4bb6-be3d-babfb249de52",
                                "sense_id": "dc5363e6-f00b-35a4-b911-c246390f9a37",
                                "text": "The leading feature of the \"Valencian\" pattern consists of the large central figure having radiating lines representing extending and withdrawing rays; there are also pelecoid figures, and double-pointed figures between the pelecoids."
                            }
                        ]
                    }
                ],
