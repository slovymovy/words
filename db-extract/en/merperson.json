                                        "examples": [
                                            {
                                                "example_id": "71642205-215b-4fa0-b03d-ba533b6a4700",
                                                "sense_id": "bcb16cbf-7c92-377e-b512-f9c33abe24b5",
                                                "text": "Syreny przestano produkować w 1983 roku."
                                            }
                                        ],
                                        "sense_index_json": "\"1.4\""
                                    },
                                    {
                                        "sense_id": "4630a1f3-ad50-3bd3-80a9-fa46687a5010",
