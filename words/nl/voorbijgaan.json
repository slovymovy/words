{
    "word_family": [
        "voorbijganger",
        "voorbijgang"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "e7e48dc3-116e-31e6-9102-20b3e3155b2f",
                    "sense_definition": "langs een bepaald punt of persoon bewegen in de ruimte",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "ruimtelijk",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Dezelfde fietser <w>ging</w> opnieuw <w>voorbij</w> aan ons huis.",
                            "target_lang_translations": {
                                "en": "The same cyclist <w>passed</w> our house again."
                            }
                        },
                        {
                            "text": "Ik zag hem in het <w>voorbijgaan</w> even zwaaien.",
                            "target_lang_translations": {
                                "en": "I saw him wave briefly while <w>passing</w> by."
                            }
                        }
                    ],
                    "synonyms": [
                        "passeren"
                    ],
                    "common_phrases": [
                        "in het voorbijgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to move past a certain point or person in space"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "to go past something or someone"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "to move past a location"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "a99c9c4b-bcbb-3a6e-875e-78cbee610772",
                    "sense_definition": "tot het verleden gaan behoren of ten einde komen",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "tijd",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die mooie tijd is helaas voorgoed <w>voorbijgegaan</w>.",
                            "target_lang_translations": {
                                "en": "Those beautiful times have unfortunately <w>passed</w> forever."
                            }
                        },
                        {
                            "text": "De storm zal snel <w>voorbijgaan</w> en dan wordt het weer rustig.",
                            "target_lang_translations": {
                                "en": "The storm will <w>pass</w> quickly, and then it will be calm again."
                            }
                        }
                    ],
                    "common_phrases": [
                        "snel voorbijgaan"
                    ],
                    "target_lang_definitions": {
                        "en": "to become part of the past or to come to an end"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "pass",
                                "target_lang_sense_clarification": "of time or events, to elapse or end"
                            },
                            {
                                "target_lang_word": "go by",
                                "target_lang_sense_clarification": "of time, to elapse"
                            },
                            {
                                "target_lang_word": "pass away",
                                "target_lang_sense_clarification": "to cease to exist or end"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dab98f0e-fe0a-31db-9dd5-962d2c5f3ff2",
                    "sense_definition": "iets of iemand negeren of niet in de beschouwing betrekken",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "abstract",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Er werd daarmee geheel <w>voorbijgegaan</w> aan de wil van de bevolking.",
                            "target_lang_translations": {
                                "en": "The will of the people was completely <w>ignored</w> by that."
                            }
                        },
                        {
                            "text": "Je kunt niet zomaar <w>voorbijgaan</w> aan de feiten in dit dossier.",
                            "target_lang_translations": {
                                "en": "You cannot simply <w>disregard</w> the facts in this file."
                            }
                        }
                    ],
                    "common_phrases": [
                        "voorbijgaan aan"
                    ],
                    "target_lang_definitions": {
                        "en": "to ignore something or someone, or not to take them into consideration"
                    },
                    "translations": {
                        "en": [
                            {
                                "target_lang_word": "ignore",
                                "target_lang_sense_clarification": "to pay no attention to"
                            },
                            {
                                "target_lang_word": "disregard",
                                "target_lang_sense_clarification": "to treat as unworthy of notice"
                            },
                            {
                                "target_lang_word": "overlook",
                                "target_lang_sense_clarification": "to fail to notice or consider"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}