                        "form": "die Bürgerwehren"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                        "entry_id": "e9142965-adbd-3691-952b-6a09da85519a",
                        "glosses": [
                            "paramilitärische Einheit, die sich aus Bürgern eines Ortes zusammensetzt und für den Schutz von jenem einsetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "56e9ce4c-7824-4d91-be1b-c6bd44d080c2",
                                "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                                "text": "„Seither liefert er den nigerianischen Sicherheitskräften wertvolle Informationen und begleitet als Scout eine bewaffnete Bürgerwehr.“"
                            },
                            {
                                "example_id": "c7ab4fd8-9e58-4f2d-bd1e-70c48283cf24",
                                "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                                "text": "„Und immer mehr Bürgerwehren werden gebildet, gerade in ländlichen Gegenden.“"
                            },
                            {
                                "example_id": "6b299a95-eab2-4e9b-9bd8-282bbeaae212",
                                "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                                "text": "„Überall standen auf einmal Posten, meist von selbst ernannten Bürgerwehren eingerichtet.“"
                            },
                            {
                                "example_id": "1af5f80b-9d51-48ea-90cd-d7911ce5fd58",
                                "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                                "text": "„Die Weißen in Belgisch-Kongo bewaffnen sich, bilden Bürgerwehren.“"
                            },
                            {
                                "example_id": "e54f2ade-6a3c-4208-9a01-dfa5e5324f0e",
                                "sense_id": "8b5494b9-2161-308b-baf8-683b2c3b1c26",
                                "text": "„In Teilen von Neukölln, Spandau und Lichtenberg trieben rivalisierende Banden und Bürgerwehren ihr Unwesen, weil der Staat weder die Versorgung der Bevölkerung gewährleisten noch deren Sicherheit garantieren konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
