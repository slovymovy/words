                "senses": [
                    {
                        "sense_id": "c7d6502f-e947-31b0-a16b-4f5412fdfe6b",
                        "entry_id": "5c16df52-f746-395b-a292-5c6cbdfe2867",
                        "glosses": [
                            "Faire perdre son caractère artistique à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3a9464fb-0f58-4017-a2f9-6d98df3c10bf",
                                "sense_id": "c7d6502f-e947-31b0-a16b-4f5412fdfe6b",
                                "text": "Le musée retient les effluves et cerne les constellations qu’il tente à toute vitesse de stabiliser et d’enfermer dans un signe, ce qui revient sûrement à désartistiser et à coaguler les sens."
                            },
                            {
                                "example_id": "b8a8ac4e-e9be-4e81-b2a2-69135b90ed04",
                                "sense_id": "c7d6502f-e947-31b0-a16b-4f5412fdfe6b",
                                "text": "En abordant systématiquement sous l’angle d’une psychologie expérimentale les thèmes spatiaux de la forme architecturale, Arnheim désartistise l’espace et offre ainsi aux architectes et aux étudiants un outil certainement stimulant, parfois contestable, apparemment désuet mais stable, et qui fait contrepoint à la position toujours mouvante, ou subversive de la création."
                            }
                        ]
                    }
