{
    "word_family": [
        "constrain",
        "constrained",
        "unconstrained"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "949c966e-ba19-3365-bde8-619ef1cbd3f9",
                    "sense_definition": "A limitation or restriction that controls what you can do or how something can develop.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The project was completed on time despite the severe budget <w>constraint</w> we faced.",
                            "target_lang_translations": {
                                "ru": "Проект был завершен вовремя, несмотря на жесткое бюджетное <w>ограничение</w>, с которым мы столкнулись."
                            }
                        },
                        {
                            "text": "An engineer must recognize the difference between a <w>constraint</w> to work within and a problem to be solved.",
                            "target_lang_translations": {
                                "ru": "Инженер должен понимать разницу между <w>ограничением</w>, в рамках которого нужно работать, и проблемой, которую нужно решить."
                            }
                        }
                    ],
                    "synonyms": [
                        "restriction",
                        "limitation",
                        "restraint",
                        "curb"
                    ],
                    "antonyms": [
                        "freedom",
                        "liberty"
                    ],
                    "common_phrases": [
                        "budget constraint",
                        "time constraint",
                        "legal constraint",
                        "resource constraint"
                    ],
                    "target_lang_definitions": {
                        "ru": "Ограничение или сдерживающий фактор, который контролирует ваши действия или развитие чего-либо."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "лимит или правило"
                            },
                            {
                                "target_lang_word": "сдерживающий фактор",
                                "target_lang_sense_clarification": "препятствие для развития"
                            },
                            {
                                "target_lang_word": "рамки",
                                "target_lang_sense_clarification": "установленные пределы"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "86670eb2-9efd-3038-9550-d74f9cb4b3d2",
                    "sense_definition": "A condition or rule that a solution to a mathematical or optimization problem must satisfy.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "technical_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The algorithm finds the optimal path while satisfying every linear <w>constraint</w> in the model.",
                            "target_lang_translations": {
                                "ru": "Алгоритм находит оптимальный путь, соблюдая каждое линейное <w>ограничение</w> в модели."
                            }
                        },
                        {
                            "text": "We need to define a new <w>constraint</w> to ensure the variables remain within a positive range.",
                            "target_lang_translations": {
                                "ru": "Нам нужно определить новое <w>условие</w>, чтобы переменные оставались в положительном диапазоне."
                            }
                        }
                    ],
                    "synonyms": [
                        "condition",
                        "requirement",
                        "parameter"
                    ],
                    "common_phrases": [
                        "linear constraint",
                        "satisfy a constraint",
                        "optimization constraint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Условие или правило, которому должно соответствовать решение математической задачи или задачи оптимизации."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "математическое условие"
                            },
                            {
                                "target_lang_word": "условие",
                                "target_lang_sense_clarification": "параметр модели"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "658312be-894c-32a2-9677-b35520c462ac",
                    "sense_definition": "A rule applied to database columns to ensure the integrity and accuracy of the data.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_restriction",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The database administrator added a unique <w>constraint</w> to the email column to prevent duplicate accounts.",
                            "target_lang_translations": {
                                "ru": "Администратор базы данных добавил <w>ограничение</w> уникальности для столбца email, чтобы предотвратить дублирование учетных записей."
                            }
                        },
                        {
                            "text": "You cannot delete this record because it would violate a foreign key <w>constraint</w> in the system.",
                            "target_lang_translations": {
                                "ru": "Вы не можете удалить эту запись, так как это нарушит <w>ограничение</w> внешнего ключа в системе."
                            }
                        }
                    ],
                    "synonyms": [
                        "rule",
                        "restriction"
                    ],
                    "common_phrases": [
                        "unique constraint",
                        "database constraint",
                        "integrity constraint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "computing"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Правило, применяемое к столбцам базы данных для обеспечения целостности и точности данных."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "ограничение",
                                "target_lang_sense_clarification": "в базах данных"
                            },
                            {
                                "target_lang_word": "констрейнт",
                                "target_lang_sense_clarification": "профессиональный жаргон"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "9ad77919-0e12-376d-a9ca-2fdbf47fc7dd",
                    "sense_definition": "The act of limiting or controlling your own feelings or behavior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "self_control",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He spoke with great <w>constraint</w> despite being visibly angry at the accusations.",
                            "target_lang_translations": {
                                "ru": "Он говорил с большой <w>сдержанностью</w>, несмотря на то, что был явно разгневан обвинениями."
                            }
                        },
                        {
                            "text": "She put such fierce <w>constraint</w> upon herself that she passed him without saying a single word.",
                            "target_lang_translations": {
                                "ru": "Она проявила такое сильное <w>самообладание</w>, что прошла мимо него, не сказав ни слова."
                            }
                        }
                    ],
                    "synonyms": [
                        "restraint",
                        "self-control",
                        "inhibition",
                        "suppression"
                    ],
                    "antonyms": [
                        "abandon",
                        "spontaneity"
                    ],
                    "common_phrases": [
                        "show constraint",
                        "act with constraint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "literary"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Акт ограничения или контроля собственных чувств или поведения."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сдержанность",
                                "target_lang_sense_clarification": "самоконтроль"
                            },
                            {
                                "target_lang_word": "стеснение",
                                "target_lang_sense_clarification": "внутренняя скованность"
                            },
                            {
                                "target_lang_word": "принуждение",
                                "target_lang_sense_clarification": "над собой"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b96bebdf-24d6-39ad-9083-d8bf934fcb50",
                    "sense_definition": "The use of force or threats to make someone do something against their will.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "force",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The prisoners claimed that they had signed the confessions only under severe <w>constraint</w>.",
                            "target_lang_translations": {
                                "ru": "Заключенные утверждали, что подписали признания только под сильным <w>принуждением</w>."
                            }
                        },
                        {
                            "text": "The witness testified that her initial statement was made under <w>constraint</w> from the authorities.",
                            "target_lang_translations": {
                                "ru": "Свидетельница показала, что ее первоначальное заявление было сделано под <w>давлением</w> со стороны властей."
                            }
                        }
                    ],
                    "synonyms": [
                        "compulsion",
                        "coercion",
                        "duress",
                        "pressure"
                    ],
                    "antonyms": [
                        "volition",
                        "free will"
                    ],
                    "common_phrases": [
                        "under constraint",
                        "physical constraint"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "formal"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Использование силы или угроз, чтобы заставить кого-то сделать что-то против его воли."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "принуждение",
                                "target_lang_sense_clarification": "под давлением"
                            },
                            {
                                "target_lang_word": "давление",
                                "target_lang_sense_clarification": "силовое воздействие"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}