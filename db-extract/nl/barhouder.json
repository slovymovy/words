                        "examples": [
                            {
                                "example_id": "b6d808c9-2b69-4938-b6e1-10645ab89ad6",
                                "sense_id": "22d82760-ac85-34bf-8722-760abf1f3b1c",
                                "text": "De enige tevreden gezichten op Malpensa waren die van de barhouders. Door de grote vertragingen draaiden die gisteren uitstekend. Zo goed dat een aantal bars door zijn voorraad heen was."
                            },
                            {
                                "example_id": "065ca262-e56a-4dde-abb3-57d6ced4a8ca",
                                "sense_id": "22d82760-ac85-34bf-8722-760abf1f3b1c",
                                "text": "Telefonisch geraadpleegde experts adviseerden daarna de boeken meteen te bevriezen. Een plaatselijke barhouder heeft alle ijsjes uit zijn vrieskist gehaald om plaats te maken voor de boeken."
                            }
                        ]
                    }
