                        "glosses": [
                            "boek dat men uitgeeeft om een bepaalde zaak of persoon te herdenken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d0dae9a4-774d-4336-83a1-8119ec13207f",
                                "sense_id": "0e12fd45-b4d4-3100-a856-efae790cbedb",
                                "text": "Verder zaten ze samen in een replica van de wagon - het origineel werd in de Tweede Wereldoorlog vernietigd - waar ze een herdenkingsboek signeerden en vervolgens elkaars hand vasthielden."
                            },
                            {
                                "example_id": "5f0dea99-461c-4518-b7b7-fbca9f52f437",
                                "sense_id": "0e12fd45-b4d4-3100-a856-efae790cbedb",
                                "text": "Op het Comenius College, waar Cécile en Livia beiden op het gymnasium zaten, is een lokaal vrijgemaakt voor een gedenkplek met kaarsen, bloemen en schoolfoto's van de zussen. Leerlingen krijgen daar de ruimte om te rouwen en een boodschap te schrijven in een herdenkingsboek."
                            }
                        ]
                    }
