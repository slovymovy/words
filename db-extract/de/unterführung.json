                ],
                "senses": [
                    {
                        "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                        "entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                        "glosses": [
                            "Verkehrsweg, der unter einem anderen hindurchführt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3b7f5682-9719-4720-b0c1-41c0d3b0a001",
                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                "text": "Um zum Krankenhaus zu kommen, musste er die Unterführung passieren."
                            },
                            {
                                "example_id": "f6096d43-9769-4ebb-b79b-e42222676e61",
                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                "text": "„Wir gelangen über einen Baustellenpfad aus der Unterführung hinaus auf den Bahnhofsvorplatz.“"
                            },
                            {
                                "example_id": "e4913f72-7197-489f-9386-14cd51a40d4d",
                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                "text": "„Morgens zogen sie schweigsam los, vorbei an der Sandkiste und durch die große Unterführung hindurch.“"
                            },
                            {
                                "example_id": "938be085-1d18-4c17-b6cf-84245d1c3eca",
                                "sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                                "text": "„In der Unterführung am Zentralplatz war eine Zoohandlung.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "e79955b0-8676-3e7a-9000-a719132a7090",
                        "entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                        "glosses": [
                            "Schriftzeichen, das in der Zeile unter einem gleichen Wort gesetzt wird"
                        ],
                        "tags": [],
                        "examples": [],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "ad240391-9ba2-4cde-a857-2275828af16e",
                        "source_entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                        "source_sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                        "source_sense_description": "Verkehrsweg, der unter einem anderen hindurchführt",
                        "target_lang_word": "subway",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "subway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "23cc163c-cf37-3810-9e85-c7401b059a8d",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "An underground railway, especially for mass transit of people in urban areas."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Scotland",
                                            "South-Africa",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "59abfd09-b487-4211-b14f-380e559a9a43",
                                                "sense_id": "23cc163c-cf37-3810-9e85-c7401b059a8d",
                                                "text": "He is going to Westminster by subway."
                                            },
                                            {
                                                "example_id": "6d6c5897-eadf-4352-80c7-f0712bd8f2ad",
                                                "sense_id": "23cc163c-cf37-3810-9e85-c7401b059a8d",
                                                "text": "In 1884 Greathead was part of a syndicate that obtained powers for another subway – 'The City of London & Southwark Subway'. The term 'subway' sounded more sophisticated than 'underground railway', which was associated with the sulphurous Metropolitan, and it would be adopted by New York for its own electric metro when work started on that in 1904."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e7717c40-4fe9-32be-a4a5-ed61a2dcd40e",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "A train that runs on such an underground railway."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "Scotland",
                                            "South-Africa",
                                            "US"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a489bff1-50f6-4b44-a196-123bbb61d2e6",
                                                "sense_id": "e7717c40-4fe9-32be-a4a5-ed61a2dcd40e",
                                                "text": "Just before you leave, the subway comes. You get on. It stops at the next station."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d1977195-f339-3302-af32-e93a0f1ef2fd",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "A rapid transit system, regardless of the elevation of its right of way; a metro system."
                                        ],
                                        "tags": [
                                            "Canada",
                                            "US"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "a50734b3-4519-3b76-bbbc-53988d982d33",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "An underground walkway, tunnel for pedestrians (called pedestrian underpass in US)."
                                        ],
                                        "tags": [
                                            "British"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f6e19b10-78ce-401e-b999-7bd0a4816952",
                                                "sense_id": "a50734b3-4519-3b76-bbbc-53988d982d33",
                                                "text": "At Nairobi the mail waits an hour-and-a-half. The station has three long platforms, mostly covered in awnings, the island connected with the main platform (which is used by the mails in both directions) by a subway."
                                            },
                                            {
                                                "example_id": "e66f9f3d-abdd-4cb2-9e46-65cb7337dc5c",
                                                "sense_id": "a50734b3-4519-3b76-bbbc-53988d982d33",
                                                "text": "Heading beneath the tracks via the subway to the immediate north of the station takes us to the Didcot Railway Centre."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8775d6c1-0c6f-3a56-b9fb-781cfb6eb07a",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "An underground route for pipes, sewers, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "7c85908d-92f4-3484-815f-cdd6ec2bff4d",
                                        "entry_id": "b9eba166-33b7-31e9-8e03-c38730412aeb",
                                        "glosses": [
                                            "An underground route for creatures (e.g. bats)."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "subway",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "042e2b74-0bd8-31da-8ab5-f52cfa85b7b0",
                                        "entry_id": "cae095cb-a904-3b4d-ae89-b30d5324eb8f",
                                        "glosses": [
                                            "To travel by underground railway."
                                        ],
                                        "tags": [
                                            "US",
                                            "informal",
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9a852850-bd61-409b-ab48-9ca9303aadaf",
                                                "sense_id": "042e2b74-0bd8-31da-8ab5-f52cfa85b7b0",
                                                "text": "I suppose I could have subwayed around town in search of froufrou French pastry shops."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3167f9ff-e67e-4ab9-8312-f440c72eed38",
                        "source_entry_id": "ad5d7a3c-4a7f-33a3-b2ff-da54713f2a46",
                        "source_sense_id": "f31967b2-4eee-3fc0-9f80-61316a50027b",
                        "source_sense_description": "Verkehrsweg, der unter einem anderen hindurchführt",
