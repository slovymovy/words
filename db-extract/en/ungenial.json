                        "glosses": [
                            "Not genial."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3974551c-d15b-4fbe-90dc-cded99f65ffd",
                                "sense_id": "f3b58415-e0d4-38a6-825c-0b440b856fcd",
                                "text": "And yet this same ungenial climate, hostile as it generally is to the long remembrance of departed people, has sometimes a lovely way of dealing with the records on certain monuments that lie horizontally in the open air."
                            },
                            {
                                "example_id": "735b4134-cc55-4b21-9dcb-bc140fcf8907",
                                "sense_id": "f3b58415-e0d4-38a6-825c-0b440b856fcd",
                                "text": "The weather is raw and boisterous in winter, shifty and ungenial in summer, and a downright meteorological purgatory in the spring."
                            },
                            {
                                "example_id": "77353889-0fb4-41bb-b15d-248782246758",
                                "sense_id": "f3b58415-e0d4-38a6-825c-0b440b856fcd",
                                "text": "It may make folks smile and stare; but the ungenial coalition of barbarous with refined phrases will prevent you in the end from being so generally tasted as you desire to be."
                            }
                        ]
                    }
                ],
