                        "entry_id": "4709075e-75d1-3116-8290-58db47caccaf",
                        "glosses": [
                            "A young or little cow; calf."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "90a67355-6990-4838-9914-7c3584c30768",
                                "sense_id": "a13a2e39-3f7c-36e3-8484-e267c38e7679",
                                "text": "She nuzzled between the legs—a bull calf. She continued to nuzzle and clean the little pea-green body that was blue with white patches about his cowling parts."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abf37db9-c3d5-45c1-83c3-b72c37c36dc3",
                        "source_entry_id": "4709075e-75d1-3116-8290-58db47caccaf",
                        "source_sense_id": "a13a2e39-3f7c-36e3-8484-e267c38e7679",
