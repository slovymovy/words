                        "cross_references": [
                            {
                                "target_word": "mustard gas",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                        "entry_id": "4da23ec2-724b-3a4e-8ec6-3a1b3d209ea1",
                                        "glosses": [
                                            "A highly cytotoxic vesicant, C₄H₈Cl₂S, used in World War I that is known to cause skin burns, blisters, inflammation, edema, and potentially other respiratory effects."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b613d834-375c-4cbf-95cc-d042704baabd",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "The man who survived mustard gas and pepper spray is now a seasoned veteran."
                                            },
                                            {
                                                "example_id": "05164b8b-f60f-4d5b-ba37-492f6d14cd2b",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "The necessarily elaborate precautions taken to decontaminate vehicles and trains which have been in contact with mustard gas were shown, and examples of the board's breakdown and ambulance vehicles were available for inspection."
                                            },
                                            {
                                                "example_id": "ede77d7f-23af-4060-b42b-430d88437eef",
                                                "sense_id": "a2175a93-1a0c-398f-8585-662ecf54604b",
                                                "text": "With the cessation of hostilities, the military traffic declined considerably, although at least two years will be required to remove the many thousands of tons of explosives still stored at the depot. The supplies of mustard gas have already been despatched to Stranraer to be dumped in the sea, and the disposal of ¾-million land mines has called for the provision of 17 special trains."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
