                                        "sense_id": "cbf606e3-33d7-335b-882d-b30cfcb0d8a6",
                                        "entry_id": "fa799c1d-7d79-34a3-970f-5bf785bfd75c",
                                        "glosses": [
                                            "A Pyrenean chamois (Rupicapra pyrenaica)."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7c323ef6-8081-4c77-9562-80be5a26c2b9",
                                                "sense_id": "cbf606e3-33d7-335b-882d-b30cfcb0d8a6",
                                                "text": "[T]hat threatening aspect with which they seemed to hang over the wandering traveller […] bid him to fear, lest even the light steps of the Izard (the Chamois of the Pyrenees), or the wild goats, who now and then appeared suspended amid the craggy fissures, should disunite them from the mountain itself and bury him beneath their thundering ruins."
                                            }
                                        ]
                                    }
                                ]
                            }
