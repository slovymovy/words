                        "glosses": [
                            "Contraction de zu dem, donnant souvent : au (à le), à la, à l’."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fb0c26-3cd9-41ac-98fb-4f6f1a7f823f",
                                "sense_id": "15a1fca0-1344-3c3a-9e91-e490cceddb1a",
                                "text": "Ich gehe zum Bahnhof.",
                                "translation": "Je vais à la gare."
                            },
                            {
                                "example_id": "9af8d586-0117-4cf6-923e-33d34b4987da",
                                "sense_id": "15a1fca0-1344-3c3a-9e91-e490cceddb1a",
                                "text": "Dieses Parfum stinkt zum Himmel!",
                                "translation": "Ce parfum pue horriblement ! [Littéralement : jusqu’au ciel]"
                            },
                            {
                                "example_id": "d155fff8-b8b4-481b-a130-6a3be1b0a15f",
                                "sense_id": "15a1fca0-1344-3c3a-9e91-e490cceddb1a",
                                "text": "Gleichberechtigung ist schlussendlich zum Vorteil aller.",
                                "translation": "L’égalité en droit est en fin de compte à l’avantage de tous."
                            },
                            {
                                "example_id": "1f90c136-88a3-490b-9474-6aad4301ef68",
                                "sense_id": "15a1fca0-1344-3c3a-9e91-e490cceddb1a",
                                "text": "Als die Türklingel ertönt, fahre ich zusammen. Ich gehe im Kopf noch einmal meinen Plan durch, dann straffe ich meine Schultern und trete den Weg zur Haustür an. Mein Herzschlag ist so laut, er schallt durchs ganze Haus, bringt die Fenstergläser zum Klirren.",
                                "translation": "Je sursaute en entendant retentir la sonnette. Mentalement, je ressasse une fois de plus mon plan, puis je redresse les épaules et me dirige vers l’entrée. Mon cœur bat tellement fort qu’il résonne à travers toute la maison et fait cliqueter les vitres."
                            }
                        ]
                    },
                    {
                        "sense_id": "8e458cc5-66fb-382b-ae70-1d538a33f53d",
                        "entry_id": "ff79a891-2bf1-33bc-9df9-938ea590945d",
