                "senses": [
                    {
                        "sense_id": "3bff0243-a9be-3407-ad65-a3d358099630",
                        "entry_id": "a49c5c78-6d54-37d4-a743-d1df110de9f8",
                        "glosses": [
                            "home office (place at home for telecommuting)"
                        ],
                        "tags": [
                            "countable",
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "87a50dcf-ac08-4d6e-9315-58a16e029a35",
                                "sense_id": "3bff0243-a9be-3407-ad65-a3d358099630",
                                "text": "Während des ersten strengen Lockdowns in Italien saß auch er zu Hause im Homeoffice und unterrichtete virtuell."
                            }
                        ]
                    },
                    {
                        "sense_id": "22dae205-9e8c-37bc-bf1d-f86f29404cd7",
                        "entry_id": "a49c5c78-6d54-37d4-a743-d1df110de9f8",
                        "glosses": [
                            "(the practice of) telecommuting"
                        ],
                        "tags": [
                            "metonymically",
                            "neuter",
                            "strong",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "23778b2b-4fdc-4f4b-ad0b-1b76bfdf310c",
                                "sense_id": "22dae205-9e8c-37bc-bf1d-f86f29404cd7",
                                "text": "Alle anderen, die keinen festen Telearbeitsplatz haben, sondern gelegentlich Homeoffice machen, sind selbst für den Schutz vor Hitze zuständig."
                            },
                            {
                                "example_id": "100b110f-5c5d-44dc-9d78-66250ce8f345",
                                "sense_id": "22dae205-9e8c-37bc-bf1d-f86f29404cd7",
                                "text": "Und das Homeoffice wird bleiben. Für die Zeit nach der Pandemie halten die Ifo-Experten einen Homeoffice-Anteil von 24 Prozent der Arbeitszeit für wahrscheinlich, das wären zehn Prozentpunkte mehr als zuvor."
                            }
                        ]
                    }
                ],
