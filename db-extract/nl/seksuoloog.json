                                                "example_id": "196d8691-c7a8-49e3-9911-51855625964a",
                                                "sense_id": "b29c6efc-6ce4-3a99-a4ef-746e0e075f15",
                                                "text": "Then there's US sexologist Ray Blanchard, best known for his ... well, problematic concept of autogynyphelia: the idea that trans women are actually men who feel attracted to their female-selves."
                                            }
                                        ]
