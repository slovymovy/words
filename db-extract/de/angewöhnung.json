                "senses": [
                    {
                        "sense_id": "13acabb6-ec7c-366e-94cc-3cca3f6c2b3e",
                        "entry_id": "d5c4fc19-9e66-3547-92d5-7c0311dd7246",
                        "glosses": [
                            "Aneignung einer Gewohnheit, Verhaltensweise oder Fähigkeit; Anpassung an etwas"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f2278843-61ab-4697-9b24-8fa7c0468729",
                                "sense_id": "13acabb6-ec7c-366e-94cc-3cca3f6c2b3e",
                                "text": "„Füchse sind an sich nicht aggressiv gegenüber Menschen, solange sie in Ruhe gelassen werden. Sie sind sehr scheu und kommen selbst nach jahrelanger Angewöhnung nicht freiwillig zum Menschen, außer sie haben ein freundliches Gemüt.“"
                            },
                            {
                                "example_id": "7a01e94d-4635-45ca-859e-d2a02f1e8150",
                                "sense_id": "13acabb6-ec7c-366e-94cc-3cca3f6c2b3e",
                                "text": "„Angewöhnung geistiger Grundsätze ohne Gründe nennt man Glauben.“"
                            },
                            {
                                "example_id": "7b51170a-2ce9-4fb0-a104-c3ee629e8217",
                                "sense_id": "13acabb6-ec7c-366e-94cc-3cca3f6c2b3e",
                                "text": "„Ausschweifungen jeder Art, üble Angewöhnungen, Vernachlässigung der Gesundheit, Versäumung einer richtigen Ausbildung — all das macht Menschen zweiter Güte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
