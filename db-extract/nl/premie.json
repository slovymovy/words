                    {
                        "sense_id": "78e9c03a-7abb-325b-9ef2-9c7b05d9c161",
                        "entry_id": "68c961c4-d08e-3c36-8b50-0bf6503b78ea",
                        "glosses": [
                            "de betaling aan een verzekeringsmaatschappij als tegenprestatie voor het aanhouden van een verzekering"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5380def3-9c57-47b7-a0a0-9e67347149dd",
                                "sense_id": "78e9c03a-7abb-325b-9ef2-9c7b05d9c161",
                                "text": "De premie was aan het begin van het jaar flink gestegen."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ecf13f6-379b-3da6-b8cb-e02de2a0808f",
                        "entry_id": "68c961c4-d08e-3c36-8b50-0bf6503b78ea",
                        "glosses": [
                            "de geldbonus die betaald wordt als een misdadiger gevangen wordt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "81deb6bc-16a2-4cd8-a9d7-b6cd9d154183",
                                "sense_id": "7ecf13f6-379b-3da6-b8cb-e02de2a0808f",
                                "text": "Er stond een flinke premie op het vinden van de kinderlokker."
                            },
                            {
                                "example_id": "65473058-e25a-4caa-996b-a6e354f59a00",
                                "sense_id": "7ecf13f6-379b-3da6-b8cb-e02de2a0808f",
                                "text": "Een Russische zakenman heeft een premie van 1 miljoen dollar op het hoofd van de Russische president Vladimir Poetin gezet. Hij deed dat met het verzoek aan Russische militairen om Poetin te arresteren als oorlogsmisdadiger."
                            }
                        ]
                    }
                ],
