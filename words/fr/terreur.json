                    ],
                    "synonyms": [
                        "fléau"
                    ],
                    "antonyms": [
                        "ange"
                    ],
                    "common_phrases": [
                        "terreur de l'école",
                        "vraie terreur"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "souvent employé pour désigner un enfant turbulent"
