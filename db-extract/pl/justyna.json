                            {
                                "example_id": "c1f77530-8d8c-43e6-9ca5-ca2359a53472",
                                "sense_id": "d0bea1a4-6751-3d88-a9cc-09193e817f88",
                                "text": "Justyna była jedną z niewielu dziewczyn w szkole, która nosiła warkocze."
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d14e1119-b7e4-48b7-9465-7a3f73cf3af5",
