                        "target_lang_word": "lentille gravitationnelle",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lentille gravitationnelle",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "75b52953-04a4-355b-8934-a4e60b473b0d",
                                        "entry_id": "d9f51925-870b-3eb9-b4ae-9a86825d741c",
                                        "glosses": [
                                            "Corps céleste dont la masse, conformément à la théorie de la relativité générale, entraîne une modification observable du trajet dans l’espace du rayonnement électromagnétique d’un astre, dont l’image se trouve ainsi déviée, déformée ou démultipliée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cd177911-d2ca-4cce-86ef-68c267c67121",
                                                "sense_id": "75b52953-04a4-355b-8934-a4e60b473b0d",
                                                "text": "La masse se comporte comme une lentille gravitationnelle et dévie la lumière du quasar, à la manière d’une lentille optique déformant l’image de l’objet observé."
                                            }
                                        ]
                                    }
                                ]
                            }
