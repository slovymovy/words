        "fr-extract.jsonl": [
            {
                "entry_id": "5d0aeb32-8783-3e12-8908-cda9babfaa69",
                "word": "nanan",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "8cbbee63-8bdb-4db8-898c-ae197691a4ad",
                        "entry_id": "5d0aeb32-8783-3e12-8908-cda9babfaa69",
                        "tags": [
                            "Québec"
                        ],
                        "form": "nanane"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "3b3b6473-fb74-3717-95c9-686a0d85a408",
                        "entry_id": "5d0aeb32-8783-3e12-8908-cda9babfaa69",
                        "glosses": [
                            "Mot dont les enfants se servent et dont on se sert en leur parlant, et qui signifie friandises, sucreries."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "da0ffab9-9bd9-45e5-908b-b1d180c469c7",
                                "sense_id": "3b3b6473-fb74-3717-95c9-686a0d85a408",
                                "text": "Si vous êtes sages, vous aurez du nanan."
                            },
                            {
                                "example_id": "69cfdc90-34d6-4885-aca4-3be704cbd68d",
                                "sense_id": "3b3b6473-fb74-3717-95c9-686a0d85a408",
                                "text": "Quand il n’y en aura plus, il y en aura encore, grâce au papa Micou, qui me donnera encore du nanan si je suis gentil."
                            },
                            {
                                "example_id": "bce889e9-7aa9-445b-8e8a-f97e217e3520",
                                "sense_id": "3b3b6473-fb74-3717-95c9-686a0d85a408",
                                "text": "Un truc habituel est de faire semblant d’agiter largement la soupe et ne perturber que la zone liquide ce qui permet au serveur et à ses petits copains, tout en affectant le désintéressement de types pas pressés, de se taper le nanan, c’est-à-dire tout le sédiment substantiel."
                            },
                            {
                                "example_id": "079d5b98-1d5d-4fab-8c57-6f38ecf9a3d3",
                                "sense_id": "3b3b6473-fb74-3717-95c9-686a0d85a408",
                                "text": "Dans ce récipient végétal dont les bords sont glissants comme un plancher bien ciré, la plante sécrète et stocke un liquide sucré. Du nanan pour les insectes de passage."
                            }
                        ]
                    },
                    {
                        "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                        "entry_id": "5d0aeb32-8783-3e12-8908-cda9babfaa69",
                        "glosses": [
                            "C’est du nanan : c'est délicieux, c'est excellent, c'est un régal."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "d3d5cfa9-9c95-4b31-a363-519b1449138b",
                                "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                                "text": "Lisez ces vers : c’est du nanan."
                            },
                            {
                                "example_id": "a60ac85f-c313-43a5-bd55-c005879d857c",
                                "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                                "text": "– Ha ! ha ! mon petit ! s’écria-t-elle, en voilà du nanan !"
                            },
                            {
                                "example_id": "92a0ce8a-ee03-4f29-900e-784e949b224c",
                                "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                                "text": "Le bonhomme n’ignore pas le complot, et il n’a pas la force de se passer de nanan pendant quelques jours pour le déjouer."
                            },
                            {
                                "example_id": "e20a31e7-e456-4947-9b7c-7ec24ca3b002",
                                "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                                "text": "– Ah ! vous allez voir quelque chose de drôle; la chapelle au père Mathieu. Ça, c’est du nanan, mon bon."
                            },
                            {
                                "example_id": "af8e8eb4-4847-4d94-aaff-142723f627b6",
                                "sense_id": "923db8ad-6bf5-3523-a894-42199081511b",
                                "text": "L’amour avec moi, c’est du nanan …."
                            }
                        ]
                    },
                    {
                        "sense_id": "a9a7a4fc-c738-3402-855c-c62ee74973fb",
                        "entry_id": "5d0aeb32-8783-3e12-8908-cda9babfaa69",
                        "glosses": [
                            "C’est du nanan : c’est facile, c’est du gâteau."
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "9c627678-e792-4848-a35b-e441280a5e6a",
                                "sense_id": "a9a7a4fc-c738-3402-855c-c62ee74973fb",
                                "text": "Les trois ou quatre obstinés magnifiques qui, depuis six ans, ont lutté pied à pied pour faire sortir l'Arche de terre se prennent pas les coudes, convaincus que la suite sera du nanan."
                            },
                            {
                                "example_id": "6fb1970d-886a-4deb-bece-77a17336f49f",
                                "sense_id": "a9a7a4fc-c738-3402-855c-c62ee74973fb",
                                "text": "Et du nanan, j’ose le dire, répondit le détective avec satisfaction."
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            }
        ],
