                "senses": [
                    {
                        "sense_id": "983d250c-12b6-312f-8bfb-2825f7440699",
                        "entry_id": "1d726293-f242-3dd7-a251-fccf5f041f54",
                        "glosses": [
                            "мед. инвазионная болезнь животных, редко человека, возникающая при проникновении в эпителиальные клетки кишечника одноклеточных паразитов - кокцидий"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "736679e2-3861-403a-8061-eb51b377e57d",
                                "sense_id": "983d250c-12b6-312f-8bfb-2825f7440699",
                                "text": "Угнетенное состояние, потеря аппетита, анемия, исхудание - это основные симптомы при печеночной форме кокцидиоза, а при кишечной - понос с кровью."
                            }
                        ]
                    }
                ],
