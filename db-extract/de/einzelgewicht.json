                ],
                "senses": [
                    {
                        "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                        "entry_id": "a9f02690-1711-3df6-96de-3c0d462b34c8",
                        "glosses": [
                            "Gewicht eines einzelnen Stücks oder einer einzelnen Person (meist von mehreren)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2f5a4799-ff3d-4cee-921b-14f20687fbae",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "[Selbstbedienungskassen im Supermarkt:] „Alle Artikel werden gewogen und die gespeicherten Einzelgewichte der Waren werden mit dem Gewicht des gesamten Einkaufs verglichen.“"
                            },
                            {
                                "example_id": "8352f54b-0d00-4e6d-a701-102eead675b6",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Alle relevanten Einzelgewichte werden addiert (im Beispiel: 1047 kg).“"
                            },
                            {
                                "example_id": "ef8542d2-9e9e-48ff-b97e-6ea5ea1fba63",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "[Windkraftanlage:] „So haben etwa die Rotorblätter ein Einzelgewicht von acht Tonnen und nach der Installation einen Gesamt-Durchmesser von 82 Metern, die Anlagen sind jeweils 120 Meter hoch.“"
                            },
                            {
                                "example_id": "3698ff1c-fb28-440c-86e9-9ee46dce7260",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "[Mannschaftsrudern (Leichtgewichte – Männer):] Das Einzelgewicht jedes Ruderers darf 72,5 kg nicht übersteigen, das Durchschnittsgewicht der Mannschaft darf 70,0 kg nicht überschreiten."
                            },
                            {
                                "example_id": "c0d2f5b2-f3ad-4d7e-a673-d88a8883cbe3",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Ferner konnte die Stirling zwar eine ansehnliche Gesamtbombenlast (von 6350 kg) mitführen, aufgrund des zweigeteilten Bombenschachts war das Mitführen von größeren Bomben jedoch nicht möglich. Lediglich Bomben bis zu einem Einzelgewicht von 907 kg konnten untergebracht werden.“"
                            },
                            {
                                "example_id": "aea80b8a-f802-4f3f-abbd-6e2d2c3e619a",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "[Autokräne:] „Kompakte Abmessungen der Kranbauteile und moderate Einzelgewichte ermöglichen einen wirtschaftlichen Krantransport zur Baustelle.“"
                            },
                            {
                                "example_id": "a24d2839-eab7-48e4-bd9b-1e4161d011c1",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Das Postgesetz erlaubt es nur denjenigen Personen oder Unternehmen, Briefe mit einem Einzelgewicht von bis zu 1.000 Gramm zu befördern (zur Beförderung zählen das Einsammeln, Sortieren, Transportieren und Zustellen), die eine Lizenz der Bundesnetzagentur erhalten haben (siehe Kapitel II B Lizenzierung).“"
                            },
                            {
                                "example_id": "cb5a551c-f3be-4900-9225-021a77ee1af2",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Metalldiebe stehlen 25 Tonnen Bahnschienen“ […] „Insgesamt transportierten die Täter demnach etwa 77 Schienenteile mit einer Länge von je sechs Metern und einem Einzelgewicht von 325 Kilo ab.“"
                            },
                            {
                                "example_id": "f07b3451-199e-480b-8aae-2abec5f6e857",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Das Bodenkampf-Flugzeug, auch bekannt unter dem Beinamen \"Warzenschwein\", kann mit seiner 30-Millimeter-Bordkanone pro Minute 3900 Geschosse mit einem Einzelgewicht von bis zu 750 Gramm abfeuern.“"
                            },
                            {
                                "example_id": "006150c0-276f-422e-9e9b-23291931ded5",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "„Wiener FPÖ bunkerte Parteivermögen in Gold“ […] „Die Barren haben demnach ein Einzelgewicht von 500 Gramm und bestehen aus Feingold.“"
                            },
                            {
                                "example_id": "734441c9-66ae-4f16-bf17-83cabab53305",
                                "sense_id": "786dbe25-7085-38c4-bb19-70b9223af26c",
                                "text": "[Teilchenphysik:] „Quarks sind ziemlich fiese Teilchen, denn sie sind nicht nur schwer nachweisbar, sondern lassen sich auch kaum vermessen: Sie treten immer nur in Gruppen und nie einzeln auf, weshalb man aus dem Gesamtgewicht dieser Gemeinschaft das Einzelgewicht herausrechnen muss.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
