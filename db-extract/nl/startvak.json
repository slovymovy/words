                        "examples": [
                            {
                                "example_id": "c3081704-8fe5-4f52-9416-40b8daf6e872",
                                "sense_id": "a18f9bb1-6b71-3482-ae8b-391c4c760a82",
                                "text": "Drieduizend mensen in één startvak, vieze dixies, bandjes langs de kant van de weg en sponzen en neveldouches voor de laatste meters... Redacteur Hanna Gillissen maakte het allemaal mee tijdens de 10 Engelse mijl van het grootste hardloopevenement van Nederland; de Dam tot Damloop."
                            },
                            {
                                "example_id": "1ae5aa6c-6b32-4066-849a-7bdb17494c38",
                                "sense_id": "a18f9bb1-6b71-3482-ae8b-391c4c760a82",
                                "text": "Toen ik even na twaalf uur in het startvak stond, hoorde je vaak mensen praten over Rotterdam of Enschede. Allemaal Marathonlopers die vandaag meestal liepen in een lange tight en een t-shirt met lange mouwen."
                            }
                        ]
