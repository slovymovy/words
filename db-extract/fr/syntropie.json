                "senses": [
                    {
                        "sense_id": "ccdfd7ff-4e5a-35e8-87d3-d6629946d3a3",
                        "entry_id": "258cf0e2-6390-33d3-830e-fb8f9efb1e14",
                        "glosses": [
                            "Effet convergeant de la dynamique de plusieurs éléments d'un système agroécologique ayant pour conséquence sa complexification."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7bd9088c-7b70-4fa1-8018-8787b3253b8e",
                                "sense_id": "ccdfd7ff-4e5a-35e8-87d3-d6629946d3a3",
                                "text": "La syntropie est l’antonyme de l’entropie, qui est un phénomène tendant au désordre, à la destruction, à la simplification. La syntropie signifie au contraire de tendre vers l'organisation et la complexification du vivant, l’osmose entre chaque espèce vivante, tout comme la nature s’organise formidablement entre toutes ses espèces."
                            },
                            {
                                "example_id": "225f3322-5623-4dd5-bec9-96f5d2941386",
                                "sense_id": "ccdfd7ff-4e5a-35e8-87d3-d6629946d3a3",
                                "text": "Il m'a fallu deux ans d'expérimentation et de travail intensif sur les principes de la syntropie pour passer de « si t'as peur, plante deux fois plus » à « 10 cm² de vide c'est un désert »."
                            }
                        ]
                    },
                    {
                        "sense_id": "082617f0-015f-3f30-88ce-8fb36aa8f2cb",
                        "entry_id": "258cf0e2-6390-33d3-830e-fb8f9efb1e14",
                        "glosses": [
                            "Caractéristique du monde vivant à tendre vers de plus en plus d’organisation, vers une complexification de plus en plus élevée."
                        ],
                        "tags": [],
                        "examples": []
                    },
                    {
                        "sense_id": "14142180-2fa5-3c84-b537-28c80517f350",
                        "entry_id": "258cf0e2-6390-33d3-830e-fb8f9efb1e14",
                        "glosses": [
                            "Tendance vers la complexité, la structure, l'ordre, l'organisation de modèles toujours plus avantageux et ordonnés. Initialement proposé comme synonyme de néguentropie."
                        ],
                        "tags": [],
                        "examples": []
                    }
