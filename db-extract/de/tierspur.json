                ],
                "senses": [
                    {
                        "sense_id": "a1f027cf-a0f0-34cc-8e31-041d8920588c",
                        "entry_id": "5527f793-ea59-3b24-abf5-d562217f7c3c",
                        "glosses": [
                            "Fußabdruck eines Tieres im Boden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b3d84265-6738-47f3-be25-12e7a820e5fb",
                                "sense_id": "a1f027cf-a0f0-34cc-8e31-041d8920588c",
                                "text": "„Tierspuren markierten den Weg zu diesen Orten, an denen man seinen Durst stillen konnte.“"
                            },
                            {
                                "example_id": "d822f1f7-6aa8-41ff-8135-38906ef3223a",
                                "sense_id": "a1f027cf-a0f0-34cc-8e31-041d8920588c",
                                "text": "„Ich weiß nicht mehr, wie lange er auf dem Darß blieb, aber wir gingen noch oft zum Schwimmen und noch oft in den Wald, nicht nur wegen der Tierspuren, sondern auch, um Blaubeeren und wilde Himbeeren zu sammeln.“"
                            },
                            {
                                "example_id": "03c1b781-adaa-42c5-afa6-78efe0985aa7",
                                "sense_id": "a1f027cf-a0f0-34cc-8e31-041d8920588c",
                                "text": "„Unterwegs entdeckten die Wanderer zahlreiche Tierspuren, und wenig später sahen sie auch ein halbes Dutzend Mufflons mit zurückgebogenen Hörnern und gelblichem Fell.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
