                        "examples": [
                            {
                                "example_id": "f9bb33a2-ca65-4241-9b96-fcdc6a0ebb78",
                                "sense_id": "f8ca710e-c279-350e-a789-4c5745c9786b",
                                "text": "Met alle bidding en smeking biddende te allen tijde in de geest, en tot hetzelve wakende met alle gedurigheid en smeking voor al de heiligen."
                            },
                            {
                                "example_id": "38561099-31c1-4867-975a-d903a6715ac9",
                                "sense_id": "f8ca710e-c279-350e-a789-4c5745c9786b",
                                "text": "Ik heb gezondigd tegen Uw roeping, smeking en nodiging: „Och, dat ge naar Mij hoorde; och, dat ge in Mijn wegen wandelde. Zie, Ik zal Mijn Geest overvloedig over u uitstorten en Ik zal Mijn woorden u bekendmaken.”"
                            }
                        ]
                    }
