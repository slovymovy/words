                "translations": [
                    {
                        "translation_id": "f5567bc3-4524-49f6-8367-b116d8772c96",
                        "source_entry_id": "23eeaa0f-497e-3bed-92e2-540d7d7140b4",
                        "source_sense_description": "обладающий чувственной, сексуально привлекательной внешностью",
                        "target_lang_word": "sexy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sexy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "157c96a7-021b-3162-beba-23a8d7196dd0",
                                        "entry_id": "604fcf9a-e084-3f57-82b9-45095dd23ae5",
                                        "glosses": [
                                            "Used to describe prime numbers that differ from each other by six."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6751356b-c251-41ae-9240-a74ff2507b5a",
                                                "sense_id": "157c96a7-021b-3162-beba-23a8d7196dd0",
                                                "text": "(73,79) is a sexy prime pair."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sexy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "545e2618-c570-3cc1-a8b0-cb2892d45bbd",
                                        "entry_id": "c80f9a84-6772-3c03-a64b-4f940919e8fe",
                                        "glosses": [
                                            "Having sex appeal; attractive."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "bdfb618f-af1d-4bc8-8296-c7b39219f9ff",
                                                "sense_id": "545e2618-c570-3cc1-a8b0-cb2892d45bbd",
                                                "text": "The participants in the swimsuit competition are all very sexy."
                                            },
                                            {
                                                "example_id": "5faf878c-66af-4c92-a7ad-1698ac4522ec",
                                                "sense_id": "545e2618-c570-3cc1-a8b0-cb2892d45bbd",
                                                "text": "She has a sexy voice!"
                                            },
                                            {
                                                "example_id": "7a9e591b-0633-4f22-8325-fc036bdfb91c",
                                                "sense_id": "545e2618-c570-3cc1-a8b0-cb2892d45bbd",
                                                "text": "If you want my body and you think I'm sexy / Come on sugar let me know"
                                            },
                                            {
                                                "example_id": "70c2368b-2b59-4486-8f33-195c7de9b9df",
                                                "sense_id": "545e2618-c570-3cc1-a8b0-cb2892d45bbd",
                                                "text": "So we decided, in the sexiest and most entertaining way possible, to create a “fluid-bound contract.”"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                        "entry_id": "c80f9a84-6772-3c03-a64b-4f940919e8fe",
                                        "glosses": [
                                            "Intriguing, appealing, likely to excite interest."
                                        ],
                                        "tags": [
                                            "of a thing or concept"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "889fbd61-866f-46ef-b8e8-df63050dc16c",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "The manufacturers have launched a sexy new car."
                                            },
                                            {
                                                "example_id": "f102a04c-5dfe-48f8-8bd2-3488c97478f6",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "We have some sexy ideas on how to improve sales."
                                            },
                                            {
                                                "example_id": "ca137913-8cea-44d5-81e5-4ced7f975434",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "Being an undertaker is not a sexy career."
                                            },
                                            {
                                                "example_id": "6ae8a384-c2a3-4c35-a3aa-8caeccbd90c9",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "Creamy cheese, tangy-sweet peppers, and a hit of heat tango in this sexy deviled-egg combo."
                                            },
                                            {
                                                "example_id": "8e46222e-540a-4cc3-bf60-b185329d65f5",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "\"The management of the quay walls and bridges has lagged behind in recent decades because it was not given the political priority it deserves and it is not a sexy topic,\" says Dijksma."
                                            },
                                            {
                                                "example_id": "a57fdcef-db9c-4b96-801d-a37793685a69",
                                                "sense_id": "816c96bf-ab1c-3b5e-8aeb-b8ca9593a5d3",
                                                "text": "Seeing A-listers in the aisles makes Frieze seem sexier than most fairs, placing added pressure on galleries to live up to the sponsorship provided by high-end fashion brands and luxury goods."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "005281ac-927c-39ae-9058-99c05b97e8b8",
                                        "entry_id": "c80f9a84-6772-3c03-a64b-4f940919e8fe",
                                        "glosses": [
                                            "Sexual; relating to or involving sex."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a0d0350e-8ceb-44d2-ac2d-79a220108855",
                                                "sense_id": "005281ac-927c-39ae-9058-99c05b97e8b8",
                                                "text": "He didn't really like me; all he wanted was for me to be sexy with him."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
