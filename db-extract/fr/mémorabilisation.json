                        "glosses": [
                            "Fait de rendre mémorable un évènement, une personne ou un objet."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "7975962d-f9b7-4e6b-b4bb-f7a78d987125",
                                "sense_id": "eae35174-6b22-3a44-9585-33a1d8047345",
                                "text": "Il participe d’une part de la configuration esthétique du texte, d’autre part de la construction des identités et de la mise en valeur et de la « mémorabilisation » du héros dont les faits sont narrés."
                            },
                            {
                                "example_id": "8d5f4c52-3543-4748-a413-51b538114551",
                                "sense_id": "eae35174-6b22-3a44-9585-33a1d8047345",
                                "text": "Quoique… considérant qu’en chaque parole écrite sous la lumière crue de sa singularité un aporisme moteur cherche à tout prix son règne, son rivage, sa mémorabilisation, nous poserions volontiers que ledit par soi-même énergumène ne l’était point tant, sinon en vertu de ce couac final qui fit office de clef de voûte, voire de parachute."
                            }
                        ]
                    }
