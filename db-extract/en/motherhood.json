                    {
                        "translation_id": "47df1c99-6c6d-45cf-b260-16353b2ab51b",
                        "source_entry_id": "42263f07-abda-36e6-97b6-fe756ca599ec",
                        "source_sense_description": "state of being a mother",
                        "target_lang_word": "moederschap",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "moederschap",
