                    },
                    {
                        "translation_id": "bc7452e3-e97b-4c43-8c16-32c5c39dd4dd",
                        "source_entry_id": "1b8f73cd-9b2c-337c-a8e3-733ddfb613a0",
                        "source_sense_id": "29f2ddde-dead-3f35-b673-b9174c93fabf",
                        "source_sense_description": "eine Person, die beruflich mit Wein handelt",
                        "target_lang_word": "marchand de vin",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "marchand de vin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "3b5c29df-fd34-370b-adb3-284163a41b23",
                                        "entry_id": "df63dc69-ad8c-3242-a440-e198fee5f6c7",
                                        "glosses": [
                                            "Sauce préparée avec des échalottes et du vin rouge."
                                        ],
                                        "tags": [
                                            "Sauces"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "4ee49420-c867-4848-9323-a84ebae51530",
                                                "sense_id": "3b5c29df-fd34-370b-adb3-284163a41b23",
                                                "text": "Recette d'entrecôte bordelaise avec sauce marchand de vin, une des délicieuses recettes de bœuf."
                                            },
                                            {
                                                "example_id": "5fd88daf-12fa-45c0-ad03-4e896d812494",
                                                "sense_id": "3b5c29df-fd34-370b-adb3-284163a41b23",
                                                "text": "Le poulet faisait partie des menus de fête, un mets noble alors que le bifteck frites, l’entrecôte marchand de vin étaient des plats populaires."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "marchand de vin",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b58fa378-4eb6-3144-85e7-8277b74c545f",
                                        "entry_id": "20f6ed31-6c2c-3101-b1f6-9ca8ebfdd720",
                                        "glosses": [
                                            "Commerçant spécialisé dans la vente de vin."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "da5ab21c-e5ab-4e07-a8e5-8656c8860f46",
                                                "sense_id": "b58fa378-4eb6-3144-85e7-8277b74c545f",
                                                "text": "Sur vingt boutiques, on en compte quatorze de marchands de vin et quatre de brocanteurs. Il y a le vins-restaurant, le vins-épicerie, la fruiterie et vins, le vins-crémier, le vins-tabac, le vins-concert et bal musette, le charbons et vins, le bar, la distillerie, le grand comptoir, et, pour chaque débit, un hôtel meublé."
                                            },
                                            {
                                                "example_id": "33f871cc-66bf-4cfe-aa97-509c138e1dfb",
                                                "sense_id": "b58fa378-4eb6-3144-85e7-8277b74c545f",
                                                "text": "La boutique du marchand de vin sentait le vin à la tireuse (on se grisait aux vapeurs et cet honnête commerçant était bourré sans boire), et l'épicerie, les épices. C'était avant la civilisation de l'emballage et du froid."
                                            },
                                            {
                                                "example_id": "521450c9-b80a-4f70-9966-4c230dd6dd02",
                                                "sense_id": "b58fa378-4eb6-3144-85e7-8277b74c545f",
                                                "text": "Au-delà, il n’y avait plus que les boutiques braisillantes des marchands de vin, qui luisaient, pareilles à des phares."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
