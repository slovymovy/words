                        "entry_id": "90d738c6-eb50-3392-b1eb-86bf67d4cccb",
                        "glosses": [
                            "harde langwerpige constructie waar in een kerkgebouw waarop gelovigen tijdens een dienst kunnen zitten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "099d5fae-4c5d-4301-a214-b9a3a9fc8a78",
                                "sense_id": "bb1e29a4-fdc1-3d1d-a804-8103e4554b06",
                                "text": "Wat gaat er na de sluiting van de kerk met de kerkbanken gebeuren?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c63a0396-a185-416a-9cda-f965bd91c2cd",
                        "source_entry_id": "90d738c6-eb50-3392-b1eb-86bf67d4cccb",
                        "source_sense_id": "bb1e29a4-fdc1-3d1d-a804-8103e4554b06",
                        "source_sense_description": "harde langwerpige constructie waar in een kerkgebouw waarop gelovigen tijdens een dienst kunnen zitten",
                        "target_lang_word": "Kirchenbank",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Kirchenbank",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ce1f82c5-b012-382b-8103-9afa33cda02a",
                                        "entry_id": "b312b28c-b428-3bca-aff8-f62d5eddade7",
                                        "glosses": [
                                            "in der Kirche befindliche Sitzbank"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4764dbfd-6ab7-4b3d-95f5-1b33c3263cc3",
                                                "sense_id": "ce1f82c5-b012-382b-8103-9afa33cda02a",
                                                "text": "„Ich setzte mich, als ein Regen anbrauste, auf die nächste Kirchenbank.“"
                                            },
                                            {
                                                "example_id": "7135aedd-582b-4930-bde2-e20172debc2f",
                                                "sense_id": "ce1f82c5-b012-382b-8103-9afa33cda02a",
                                                "text": "„Sie rutschte auf der Kirchenbank vor und zurück und drehte sich zur Tür.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "d9d113c0-f0b2-412e-8ca7-518a59e8eedf",
                        "source_entry_id": "90d738c6-eb50-3392-b1eb-86bf67d4cccb",
                        "source_sense_id": "bb1e29a4-fdc1-3d1d-a804-8103e4554b06",
                        "source_sense_description": "harde langwerpige constructie waar in een kerkgebouw waarop gelovigen tijdens een dienst kunnen zitten",
                        "target_lang_word": "pew",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pew",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0bc4a807-8f16-32c7-8c3e-93343fa28a92",
                                        "entry_id": "f349abbb-31e4-376b-9b57-84d51d644a82",
                                        "glosses": [
                                            "One of the long benches in a church, seating several persons, usually fixed to the floor and facing the chancel."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d3735c00-8f2c-4318-ad54-47a9bc344d2f",
                                                "sense_id": "0bc4a807-8f16-32c7-8c3e-93343fa28a92",
                                                "text": "In many churches some pews are reserved for either clerical or liturgical officials such as canons, or for prominent families."
                                            },
                                            {
                                                "example_id": "0eda6732-161f-423b-bffc-a7ed757eee11",
                                                "sense_id": "0bc4a807-8f16-32c7-8c3e-93343fa28a92",
                                                "text": "The pews are filling up, notably with young people, Gen Z's attendance at church has quadrupled in recent years—from a small base, but the significance lies more in the direction of travel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "dfbc2507-98dd-3cd3-a714-2109dfa623fc",
                                        "entry_id": "f349abbb-31e4-376b-9b57-84d51d644a82",
                                        "glosses": [
                                            "An enclosed compartment in a church which provides seating for a group of people, often a prominent family."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "507b5c3e-f128-460f-8678-c1a05e24fdb8",
                                                "sense_id": "dfbc2507-98dd-3cd3-a714-2109dfa623fc",
                                                "text": "At St. Patrick’s Cathedral, firefighters in dress blues and white gloves escorted families to the pews for a memorial service, led by Mr. Bloomberg, to honor the 343 Fire Department employees killed on 9/11."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "23d59150-7b32-3517-a2de-5fb2b2f4095e",
                                        "entry_id": "f349abbb-31e4-376b-9b57-84d51d644a82",
                                        "glosses": [
                                            "Any structure shaped like a church pew, such as a stall, formerly used by money lenders, etc.; a box in a theatre; or a pen or sheepfold."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c2768f7d-b48f-4ff9-b8ad-9da996a7758d",
                                                "sense_id": "23d59150-7b32-3517-a2de-5fb2b2f4095e",
                                                "text": "[H]e, a lollard indeed over his elbovv-cuſhion, in almoſt the ſeaventh part of 40. or 50. years teaches them ſcarce half the principles of religion; and his ſheep oft-times ſit the vvhile to as little purpoſe of benifiting as the ſheep in thir pues at Smithfield; […]"
                                            },
                                            {
                                                "example_id": "1fbbcc40-b639-4227-9d1d-35c64b41ab0a",
                                                "sense_id": "23d59150-7b32-3517-a2de-5fb2b2f4095e",
                                                "text": "my wife and I […]did get into the play, the only one we have seen this winter: it was “The Five Hours’ Adventure:” but I sat so far I could not hear well, nor was there any pretty woman that I did see, but my wife, who sat in my Lady Fox’s pew with her."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6729afe5-b29b-3646-87fa-b141d5c65f26",
                                        "entry_id": "f349abbb-31e4-376b-9b57-84d51d644a82",
                                        "glosses": [
                                            "A chair; a seat."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "humorous"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "474a3980-fd5b-4377-977b-cb64e3bd1a27",
                                                "sense_id": "6729afe5-b29b-3646-87fa-b141d5c65f26",
                                                "text": "Pull up a pew."
                                            },
                                            {
                                                "example_id": "6a0c145d-29a6-468a-8bea-9d4ed50a6cd9",
                                                "sense_id": "6729afe5-b29b-3646-87fa-b141d5c65f26",
                                                "text": "Victor Crabbe's headmaster was a little man called Boothby […] who subscribed to a popular book club and had many long-playing records, who invited people to curry tiffin and said, \"Take a pew.\""
                                            }
                                        ]
                                    }
                                ]
                            },
