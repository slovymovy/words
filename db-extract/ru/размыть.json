                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd6eed85-d24c-4547-8279-1aaed8253ae6",
                                                "sense_id": "348a4c29-c1b9-3cf2-aa9c-c91283defae3",
                                                "text": "Ses voiles délavées par le soleil et la pluie mais qui paraissaient blanches sur le gris du ciel, essayaient de récupérer les rares frissons de brise pour améliorer la lente progression du bateau."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "fe2ea697-7252-3d62-b907-5782ea583ef3",
                                        "entry_id": "c7d460a5-b416-3c82-a99f-ecddf687e9ad",
                                        "glosses": [
                                            "Imbiber d’eau."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2633981c-d5e4-42ad-a760-466693205e1c",
                                                "sense_id": "fe2ea697-7252-3d62-b907-5782ea583ef3",
                                                "text": "Les neiges qui séjournent longtemps sur les terres en pénètrent et délavent les parties les moins solides."
                                            },
                                            {
                                                "example_id": "f715d135-49ea-40ca-b9e4-cb3900fca867",
                                                "sense_id": "fe2ea697-7252-3d62-b907-5782ea583ef3",
                                                "text": "— Le village auvergnat est resté malpropre, boueux, puant, délavé par les purins; il est sans lumières; les conditions d'habitation y sont exécrables."
                                            }
                                        ]
                                    }
                                ]
                            }
