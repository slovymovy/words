                        "glosses": [
                            "In a corresponding manner; conformably."
                        ],
                        "tags": [
                            "not-comparable"
                        ],
                        "examples": [
                            {
                                "example_id": "4c00994b-9d30-4e71-90ae-1ef3f22f0e2b",
                                "sense_id": "ace1d297-81d9-39f6-a9d9-93f6e8535751",
                                "text": "He lived in a huge mansion, with a correspondingly large set of gates to keep out unwanted guests."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4339de67-e30d-4c13-841b-d01d83e0897a",
