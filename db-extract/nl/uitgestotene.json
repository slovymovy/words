        "nl-extract.jsonl": [
            {
                "entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                "word": "uitgestotene",
                "pos": "noun",
                "lang_code": "nl",
                "forms": [
                    {
                        "form_id": "a842546b-ce15-4fdb-8b39-ecb5770dc826",
                        "entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                        "tags": [
                            "plural"
                        ],
                        "form": "uitgestotenen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                        "entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                        "glosses": [
                            "persoon die uit een groep, team of gemeenschap is verwijderd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "87e3c772-0358-4103-9c8f-b9b43cf47a51",
                                "sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                                "text": "Hierbij valt vooral de dochter van Jefta op. Jefta is een sterke, gelovige strijder die als uitgestotene uit zijn clan hunkert naar erkenning. Als krachtige dealmaker slaagt hij erin stamleider en rechter van heel Israël te worden. Maar alles ontspoort, als hij ook God denkt te kunnen manipuleren. Hij belooft de HEERE te offeren „wat” of „wie” hem na de overwinning ook maar als eerste tegemoetkomt. Dat blijkt zijn dochter te zijn. Desondanks zet hij zijn gelofte door. Zo verliest de man zonder familie zijn enig kind."
                            },
                            {
                                "example_id": "876e725b-98a3-4134-982a-6df7d112ab13",
                                "sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                                "text": "Ik speel hem liever als een reliëfrijk personage, wiens hang naar geweld voortkwam uit het besef dat hij een uitgestotene was van de samenleving die hij domineerde.”"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "12d78121-1af4-43f2-93f7-e8386eeddbc8",
                        "source_entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                        "source_sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                        "target_lang_word": "reprobate",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "reprobate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "29bb4e3f-528f-317d-831a-c5b7462674ab",
                                        "entry_id": "8c7b656f-cef1-384b-87bb-532df7e1c7f7",
                                        "glosses": [
                                            "Rejected; cast off as worthless."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ebb1b297-da27-4a7b-994e-cd1d441dad4c",
                                                "sense_id": "29bb4e3f-528f-317d-831a-c5b7462674ab",
                                                "text": "Reprobate silver shall men call them, because the Lord hath rejected them."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "673fbf3a-d4b3-3efd-ab00-8fa10509ce3b",
                                        "entry_id": "8c7b656f-cef1-384b-87bb-532df7e1c7f7",
                                        "glosses": [
                                            "Rejected by God; damned, sinful."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6bec01d0-ab32-3310-a268-c565b9856bea",
                                        "entry_id": "8c7b656f-cef1-384b-87bb-532df7e1c7f7",
                                        "glosses": [
                                            "Immoral, having no religious or principled character."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "01b0195e-cbb5-4008-8cea-54288bb27d7a",
                                                "sense_id": "6bec01d0-ab32-3310-a268-c565b9856bea",
                                                "text": "The reprobate criminal sneered at me."
                                            },
                                            {
                                                "example_id": "e4a14cf5-f5cc-42d7-993a-6f24fc2c18b7",
                                                "sense_id": "6bec01d0-ab32-3310-a268-c565b9856bea",
                                                "text": "And strength, and art, are easily outdone / By spirits reprobate."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprobate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "31201c19-8c0a-3c45-88c3-0c4f49c41e59",
                                        "entry_id": "321a8369-1abf-3a99-b81b-8dc9aaf53fe0",
                                        "glosses": [
                                            "One rejected by God; a sinful person."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46607e4c-cbe1-4594-95f9-67847999f39d",
                                                "sense_id": "31201c19-8c0a-3c45-88c3-0c4f49c41e59",
                                                "text": "And the solitarines of man, which God had namely and principally orderd to prevent by mariage, hath no remedy, but lies under a worse condition then the loneliest single life; for in single life the absence and remotenes of a helper might inure him to expect his own comforts out of himselfe, or to seek with hope; but here the continuall sight of his deluded thoughts without cure, must needs be to him, if especially his complexion incline him to melancholy, a daily trouble and paine of losse in som degree like that which Reprobats feel."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                                        "entry_id": "321a8369-1abf-3a99-b81b-8dc9aaf53fe0",
                                        "glosses": [
                                            "A person with low morals or principles."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "481946be-3446-4d5a-b03c-44a8c8f0d603",
                                                "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                                                "text": "I acknowledge myself for a reprobate, a villain, a traitor to the king."
                                            },
                                            {
                                                "example_id": "ed816229-a009-421b-81a8-d47bc99c9797",
                                                "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                                                "text": "[T]he young sinner took leave of Pen, and the club of the elder criminals, and sauntered into Blacquiere’s, an adjacent establishment, frequented by reprobates of his own age."
                                            },
                                            {
                                                "example_id": "3e38e951-a90b-4538-ade6-f5bc8c41e201",
                                                "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                                                "text": "\"Good morning, Mrs. Denny,\" he said. \"Wherefore this worried look on your face? Has that reprobate James been misbehaving himself?\""
                                            },
                                            {
                                                "example_id": "04b6b137-a4af-4c03-a67f-c799cec8edbc",
                                                "sense_id": "b91c72ea-4d28-3d40-827b-09a25c34e571",
                                                "text": "West of here, it ascends to its viaduct where, 20 feet above the ground, the Westway seeks to emulate it; two scruffy reprobates shouldering their way through a not very pretty streetscape; the one a railway built by corporate buccaneers, the other a road constructed as part of a discredited plan to girdle London with motorways."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "reprobate",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "dfa654ca-337f-397c-843e-058e449da667",
                                        "entry_id": "dc3cfa80-063b-3531-a4e3-0756bccd4447",
                                        "glosses": [
                                            "To have strong disapproval of something; to reprove; to condemn."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b7155983-0f6a-44b9-a8cd-124f9ae898db",
                                                "sense_id": "dfa654ca-337f-397c-843e-058e449da667",
                                                "text": "Lord Rotheles allowed it was a very sufficient cause for returning soon, and reprobated all delays of letters, though he confessed to being a very idle correspondent;..."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9751dc84-dd24-3c71-a38d-176c644b85ac",
                                        "entry_id": "dc3cfa80-063b-3531-a4e3-0756bccd4447",
                                        "glosses": [
                                            "Of God: to abandon or reject, to deny eternal bliss."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "f9487862-7d0d-3898-976d-acf78f6229af",
                                        "entry_id": "dc3cfa80-063b-3531-a4e3-0756bccd4447",
                                        "glosses": [
                                            "To refuse, set aside."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "c7424965-2aaa-4955-8272-6464065105d7",
                        "source_entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                        "source_sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                        "target_lang_word": "pariah",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "pariah",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "Synonym of outcast: A person despised and excluded by their family, community, or society, especially a member of the untouchable castes in Indian society."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "86ba56ca-37db-451f-b601-61fa69fc9eb8",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "What is this smoking that it should be considered a crime? I believe in my heart that women are jealous of it, as of a rival. They speak of it as of some secret, awful vice that seizes upon a man, and makes him a Pariah from genteel society."
                                            },
                                            {
                                                "example_id": "86e0ca5a-5b5b-4429-bcf0-8016b2dc4f00",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "I’m a pariah, outlawed from Time Lord society."
                                            },
                                            {
                                                "example_id": "ad771975-d037-4101-b08a-19c9e664f8c4",
                                                "sense_id": "7fb8e39f-a072-3ea4-8f28-ea8eaceb4dd1",
                                                "text": "[…] I went from being a much-feted author to a pariah, since one of the many problems of being trashed on the front page of the New York Times is that everyone is in the know."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "A similarly despised group of people or species of animal."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9ee605c-d8f3-45dd-b598-368cdf83c75e",
                                                "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                                "text": "As ecological conditions became unfavorable for pig raising, there was no alternative function which could redeem its existence. The creature became not only useless, but worse than useless—harmful, a curse to touch or merely to see—a pariah animal."
                                            },
                                            {
                                                "example_id": "7ab014ec-9269-478a-a72c-42ebafd772b9",
                                                "sense_id": "da89aa4b-9257-3d80-8ec0-24974a0c8444",
                                                "text": "This scenario could lead to war crimes the scale of which has not been seen in Europe since the Nazis — crimes that would make Vladimir Putin, his cronies and Russia as a country all global pariahs."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4660e2e6-4dcf-3e86-a95b-952144c6cba7",
                                        "entry_id": "c3f38f3e-edb4-3fca-bb4c-4c610b54f5db",
                                        "glosses": [
                                            "Ellipsis of pariah dog (“an Indian breed, any stray dog in Indian contexts”)."
                                        ],
                                        "tags": [
                                            "abbreviation",
                                            "alt-of",
                                            "ellipsis"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "4db9341c-8355-41f7-8ca1-e580dd61fe4e",
                        "source_entry_id": "2f2a7644-9c4a-3196-8160-aa08c6da52fc",
                        "source_sense_id": "6a05c26e-64e0-3b1f-a820-3f122ac17a02",
                        "target_lang_word": "outcast",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                        "entry_id": "1922064f-fa7a-3145-b0ce-60ddefb41e6d",
                                        "glosses": [
                                            "To cast out; to banish."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6fcdc0ce-0e24-4609-8e19-798cf0e13180",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "And her faire yellow locks behind her flew, / Looſely diſperſt with puff of euery blaſt: / All as a blazing ſtarre doth farre outcaſt / His hearie beames, and flaming lockes diſpredd, / At ſight whereof the people ſtand aghaſt: […]"
                                            },
                                            {
                                                "example_id": "f20995f4-f31f-4220-bb47-020e9b6f856c",
                                                "sense_id": "0c7b6019-1dae-3233-9f43-9f2b7c68377d",
                                                "text": "It means equal ruin to me, as the world reckons it — outcasting, the loss of my appointment, the breaking off my life's work. I pay my price."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                        "entry_id": "3315f9dd-599f-36e7-a483-ae59f2e7d189",
                                        "glosses": [
                                            "That has been cast out; banished, ostracized."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d7e33450-4b43-4f8e-8761-2b692b956bbc",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "O, horrible fate! Outcast, rejected, / As one with pestilence infected!"
                                            },
                                            {
                                                "example_id": "3757b719-0a4d-4a16-b9b2-2db71c31bf71",
                                                "sense_id": "9b154b2c-dbf3-3c99-9954-a26ee4fc9f13",
                                                "text": "We were not a big huggie family so I was very, very encased in a little stay-away-from-me shell growing-up, and here I got to open up and feel safe and able to touch and hold and be able to be with another human being, which was really a big relief, a very positive part of my understanding of myself that I wasn't just this outcast evil outsider of everything."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "outcast",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "One that has been excluded from a society or system, a pariah, a leper."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "00859b53-870b-497c-9404-2dd23f9417d5",
                                                "sense_id": "44d4edd8-5da3-38f3-9dae-90e3ea2b16f7",
                                                "text": "The other factions believe that those who are Factionless are nomads and outcasts. But they are actually a fully functioning community."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "Synonym of outsider: someone who does not belong, a misfit."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26ad113e-870c-4173-b8f9-c0c527b8ef7d",
                                                "sense_id": "72b5aba4-e0d0-3d0e-8860-084a7bcb937a",
                                                "text": "Do you ever feel like an outcast?\nYou don't have to fit into the format\nOh, but it's okay to be different\n'Cause baby, so am I"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "256ec6b3-1751-32c0-90e4-5bd8c8dd304e",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "A quarrel."
                                        ],
                                        "tags": [
                                            "Scotland"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "71b3bac1-2eb5-3a37-9d89-565466b92a21",
                                        "entry_id": "d3c3e57d-020b-398b-a770-91221f63374d",
                                        "glosses": [
                                            "The amount of increase in the bulk of grain during malting."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    }
