                        "examples": [
                            {
                                "example_id": "a85dee0c-2f1b-4fbf-8b69-10529cc09701",
                                "sense_id": "32b58be6-999a-39a2-a53a-728edc9e22a0",
                                "text": "Bij de Museumprijs, een initiatief van onder meer het Prins Bernhard Cultuurfonds, staat elk jaar een ander thema centraal. Dit jaar was het beoordelingscriterium de mate waarin een museum erin slaagt een groep of gemeenschap aan zich te binden."
                            },
                            {
                                "example_id": "0a04fcf6-2e42-49e7-a17f-55f34ac88510",
                                "sense_id": "32b58be6-999a-39a2-a53a-728edc9e22a0",
                                "text": "De raad adviseert de musea zelf om meer ontmoetingsplaats te worden voor bezoekers van verschillende leeftijden, achtergronden en opleidingsniveaus. „Overheden zouden op hun beurt musea meer de ruimte moeten geven om nieuwe publieksgroepen te bereiken, ook als dat geen stijgende bezoekersaantallen oplevert.” Culturele diversiteit zou een beoordelingscriterium voor subsidies moeten worden, vindt het adviesorgaan."
                            }
                        ]
                    }
