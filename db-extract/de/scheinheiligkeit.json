                ],
                "senses": [
                    {
                        "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                        "entry_id": "850195e7-eb16-3d1c-9159-f668c1ae8bcf",
                        "glosses": [
                            "Einstellung/Haltung, etwas vorzutäuschen, unaufrichtig zu sein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3fc44665-f915-4663-9b5c-05a1d2e76947",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Nun werden die Brüder in der Broschüre der Gottlosigkeit und Scheinheiligkeit bezichtigt.“"
                            },
                            {
                                "example_id": "a7d0b38b-a472-4629-b0d5-05336f6080e4",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Wahre Glückseligkeit besteht nicht in bürgerlicher Ehrbarkeit oder Scheinheiligkeit, die Stricke des Teufels unter dem hellen Licht des Evangeliums sind.“"
                            },
                            {
                                "example_id": "52dc889e-26f0-4e2d-a728-d2098908b44a",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Das eiserne Pflichtgefühl eines Gutmenschen dagegen erinnert eher an schmierige Scheinheiligkeit.“"
                            },
                            {
                                "example_id": "3de0adf5-4b2e-4863-8c9d-790f4d5c5788",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Er war zwar kein Mann des Wortes, aber was Scheinheiligkeit war, wusste er trotzdem.“"
                            },
                            {
                                "example_id": "14448259-c5be-47f3-99fe-6e33185c4ef5",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Es ist ein Reich der Wahrheit und straft alle Lügen und entlarvt alle Scheinheiligkeit und Scheinherrlichkeit.“"
                            },
                            {
                                "example_id": "cce5f338-2f86-41e8-a5cc-6f472714028b",
                                "sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                                "text": "„Und er sei ein Satiriker gewesen, jemand, der die Realität hinter den Phänomenen, den rhetorischen Platitüden und Scheinheiligkeiten offenlegt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "c1898d71-c0e6-433c-9f45-56f8179de985",
                        "source_entry_id": "850195e7-eb16-3d1c-9159-f668c1ae8bcf",
                        "source_sense_id": "bd2accf7-07b8-30ba-9d69-da93a52b3920",
                        "source_sense_description": "Einstellung/Haltung, etwas vorzutäuschen, unaufrichtig zu sein",
                        "target_lang_word": "hypocrisy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hypocrisy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The contrivance of a false appearance of virtue or goodness, while concealing real character or inclinations, especially with respect to religious and moral beliefs; hence in general sense, dissimulation, pretence, sham."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "31075058-ad03-47b9-bf62-ebdd0313c7ac",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "political hypocrisy"
                                            },
                                            {
                                                "example_id": "770d7719-4297-40be-a0cc-0d5f835fa782",
                                                "sense_id": "ca88c147-93b2-3ed9-8775-b32191239e0e",
                                                "text": "He condemned the hypocrisy of politicians who broke their own laws."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The claim or pretense of having beliefs, standards, qualities, behaviours, virtues, motivations, etc. which one does not really have."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "87329f87-8458-49d3-8097-9349bee93b90",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "rank hypocrisy"
                                            },
                                            {
                                                "example_id": "267a85cc-f06c-4cdc-963e-c273013969db",
                                                "sense_id": "9c0567de-4505-3417-9cc9-bc3d3cad9b87",
                                                "text": "charge of hypocrisy"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "45dffe3d-9f1a-3719-a1a1-baf07453151f",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "The practice of engaging in the same behaviour or activity for which one criticises another; moral self-contradiction whereby the behavior of one or more people belies their own claimed or implied possession of certain beliefs, standards or virtues."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "1cfb1c5a-b232-3aa9-acec-bf5edd0241cf",
                                        "entry_id": "6c83e06e-fc8c-397b-9c40-8bcb975166bc",
                                        "glosses": [
                                            "An instance of hypocrisy."
                                        ],
                                        "tags": [
                                            "countable",
