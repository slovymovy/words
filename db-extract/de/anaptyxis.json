                "senses": [
                    {
                        "sense_id": "1beaee46-dd3e-3af6-8350-04749ada7b50",
                        "entry_id": "0b6a269f-530b-369f-b242-211c7d1e2b40",
                        "glosses": [
                            "Einschaltung eines Sprossvokals zwischen zwei Konsonanten zwecks besserer Aussprache"
                        ],
                        "tags": [
                            "Sprachwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "311f18e9-097d-4c6f-b43e-e9fbd55c26d0",
                                "sense_id": "1beaee46-dd3e-3af6-8350-04749ada7b50",
                                "text": "„Auf Grund des von Thurneysen Kuhn’s Ztschr. XXVII 181 f. Ausgeführten ist wahrscheinlich, dass in den Verbindungen tr, kr, tl, kl, tn, kn die Anaptyxis sich lautgesetzlich nur dann einstellte, wenn die vorhergehende Silbe kurz war.“"
                            },
                            {
                                "example_id": "f0aca59f-b8fb-41e8-89ab-697ea247f919",
                                "sense_id": "1beaee46-dd3e-3af6-8350-04749ada7b50",
                                "text": "„Gelegentliche Exkreszenzen von Konsonanten (Epenthese), wie im Deutschen der Einschub von [t] zwischen [n] und [l] (öffentlich, eigentlich, namentlich usw.) durch assimilatorische Denasalierung des [n] durch das [l] und Auslautverhärtung des resultierenden [d] zu [t], oder Exkreszenzen von Vokalen (Anaptyxis, Svarabhakti, Sproßvokalbildung) wie der Einschub eines [ə] zwischen [θ] und [l] in Formen des Englischen (athlete, [æθəlii̯t] statt [æθlii̯t]) fallen gegenüber der allgemeinen Tendenz kaum ins Gewicht.“"
                            },
                            {
                                "example_id": "b5c99557-b082-4956-8ca4-c18e1c3447fa",
                                "sense_id": "1beaee46-dd3e-3af6-8350-04749ada7b50",
                                "text": "„Es gibt aber möglicherweise auch ein unabhängiges Argument für die Anaptyxis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
