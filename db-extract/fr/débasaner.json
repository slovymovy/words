                ],
                "senses": [
                    {
                        "sense_id": "5f88b3aa-8aad-3181-8c93-1ed589145c6e",
                        "entry_id": "0c8fdbe7-6f7c-3892-b942-df6f3d6b1227",
                        "glosses": [
                            "Faire perdre son caractère basané à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "8afb9471-9c9f-4200-b506-6d6d003f9e25",
                                "sense_id": "5f88b3aa-8aad-3181-8c93-1ed589145c6e",
                                "text": "Elle n’avait pas regardé mes mains sans ongles, j’étais parvenue à les débasaner, mais elles n’avaient plus rien de semblable à celles d’une Secrétaire."
                            },
                            {
                                "example_id": "4819021e-a4b7-473c-9ac7-9c547f834890",
                                "sense_id": "5f88b3aa-8aad-3181-8c93-1ed589145c6e",
                                "text": "Si l’on transpose dans un contexte urbain actuel le « simple » devient le « bon jeune », le « nèg’ marron » des raps et l’Arabe débasané dont Rachid Ahrab, présentateur de journal télévisé, est le modèle moqué par tous mes informateurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "c57a5475-4bfe-3e06-bfe7-4078cfbf4f19",
                        "entry_id": "0c8fdbe7-6f7c-3892-b942-df6f3d6b1227",
                        "glosses": [
                            "Enlever ses basanes."
                        ],
                        "tags": [
                            "pronominal"
                        ],
                        "examples": [
                            {
                                "example_id": "c22dfa53-c02e-4800-b4ad-569181038613",
                                "sense_id": "c57a5475-4bfe-3e06-bfe7-4078cfbf4f19",
                                "text": "C’est qu’on était parfois si fatigué — si vous saviez ! — que rien au monde ne pouvait nous être une tentation plus forte et un plus parfait remède à notre lassitude que de nous débotter, débasaner, nous délivrer du sabre, de la tunique et de tout le fourbi !"
                            }
                        ]
                    }
                ],
