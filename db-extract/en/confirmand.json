                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Konfirmandin",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                        "entry_id": "36356081-4ec9-3475-8eb1-ad808a232564",
                                        "glosses": [
                                            "weibliche Person, die im Konfirmationsunterricht auf die Konfirmation vorbereitet wird, weibliche Person, die gerade konfirmiert wird/wurde"
                                        ],
                                        "tags": [
                                            "evangelische Kirche",
                                            "auch"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "715f8551-e760-40c5-a1d5-85739ce25232",
                                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                                "text": "Die Konfirmandinnen besuchen regelmäßig den Konfirmationsunterricht und während der gesamten Konfirmandenzeit den Gottesdienst der Kirchengemeinde."
                                            },
                                            {
                                                "example_id": "e1ce99ea-22aa-48a4-8d9c-c2a07ae28984",
                                                "sense_id": "07bd8c75-d2df-3f53-b977-ec9cecf59b5a",
                                                "text": "„Elses Brüder reisten zur Feier an, was bedeutete, dass Klaus in der Badewanne schlafen musste und die Konfirmandin unterm Tisch.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "a3b3a520-c576-4c3a-ac25-12634b900dd8",
                        "source_entry_id": "cea34800-2624-3034-a094-8e2a48193500",
                        "source_sense_id": "84ba8893-3862-3606-94f4-0661c7fdab76",
