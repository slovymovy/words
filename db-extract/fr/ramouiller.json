                "senses": [
                    {
                        "sense_id": "9f2e7e6f-a5cb-34c3-9c99-2e698c0b67bc",
                        "entry_id": "475f44dd-be64-3ea9-8c56-95f89b8dbf60",
                        "glosses": [
                            "Avoir de la difficulté, manquer de rapidité ou d'efficacité pour faire quelque chose."
                        ],
                        "tags": [
                            "familiar"
                        ],
                        "examples": [
                            {
                                "example_id": "fe96c980-da11-49ab-96a7-b71b640b3af3",
                                "sense_id": "9f2e7e6f-a5cb-34c3-9c99-2e698c0b67bc",
                                "text": "En plus un zindows la dessus, il n'y a que 95 qui peut tourner, car meme le 98 actuelle fait ramouiller a mort la machine et zindows 95, c'est a degouté de l'informatique tellement c'est peu stable"
                            },
                            {
                                "example_id": "11576617-b431-414a-b927-203791ff9171",
                                "sense_id": "9f2e7e6f-a5cb-34c3-9c99-2e698c0b67bc",
                                "text": "Vous n’avez pas encore vu les trailers des jeux de la nouvelle console de Microsoft, la Xbox 360 ? Et bien Microsoft a pensé à vous et vient de publier une page avec toutes les vidéos en HD siouplait 😉 Bon, ça commence à ramouiller alors patience."
                            },
                            {
                                "example_id": "f8881a2a-d449-44d8-99f5-f27f599a2780",
                                "sense_id": "9f2e7e6f-a5cb-34c3-9c99-2e698c0b67bc",
                                "text": "Ca ramouille un peu vers le milieu mais dans l'ensemble ça fait le job et on s'aperçoit de certains trucs qu'on ne remarque pas forcément dans les versions dessinées."
                            }
                        ]
                    }
