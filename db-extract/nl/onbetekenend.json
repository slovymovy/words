                "senses": [
                    {
                        "sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
                        "entry_id": "c21abbd4-4951-315e-95b6-1bde126eb038",
                        "glosses": [
                            "van geen enkel belang zijnde; van geen enkele waarde zijnde"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e8bf6e7e-3ed7-49ed-aaef-8a936fb3490c",
                                "sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
                                "text": "GroenLinks is bang bij regeringsdeelname aan het eind van de rit als een soort D66, onbetekenend en onbelangrijk, te eindigen, en geeft dus ook niet thuis. De PvdA."
                            },
                            {
                                "example_id": "425b5f99-f011-4616-9930-ed2dbae8a0ce",
                                "sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
                                "text": "In InBev/SabMiller is Grolsch onbetekenend, maar in een kleiner bedrijf kunnen ze een rol spelen. Dus verkoop kan voor Grolsch best eens voordelig uitpakken.\""
                            },
                            {
                                "example_id": "eef8c2e7-66ef-430d-b84f-e40097fb438d",
                                "sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
                                "text": "Een sfeerloos, onbetekenend pleintje wordt dan zo waar feeëriek. Hier, onder de schemerlamp, kan de jeugd zich verzamelen in de huiskamer van de wijk. De voorstellingen, uitgespaard in de lampenkappen, stralen dat ook letterlijk uit. Spelende kinderen, een picknicktafel, een kinderwagen. Beelden die de huiselijkheid alleen nog maar versterken."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d967a9ae-3a5e-424e-ac25-b735ca5ab4c9",
                        "source_entry_id": "c21abbd4-4951-315e-95b6-1bde126eb038",
                        "source_sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
                        "target_lang_word": "unremarkable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unremarkable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "0da8d986-4c36-3999-b0e1-7494d54582f7",
                                        "entry_id": "4d128883-13de-3396-937f-1ec301f8bfbd",
                                        "glosses": [
                                            "Not remarkable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "fafdf7b6-9839-40db-bea2-2fe903930d02",
                                                "sense_id": "0da8d986-4c36-3999-b0e1-7494d54582f7",
                                                "text": "The temptation is to regard him [John Ogdon] as an idiot savant, a big talent bottled inside a recalcitrant body and accompanied by a personality that seems not just unremarkable, but almost entirely blank."
                                            },
                                            {
                                                "example_id": "74353723-42f7-4660-b735-0ef68f42bafb",
                                                "sense_id": "0da8d986-4c36-3999-b0e1-7494d54582f7",
                                                "text": "Delivered to British Railways' Royston depot (near Barnsley) as D3378 in August 1957, the '08e' prototype led an unremarkable life for its first 35 years, working from Farnley Junction, Healey Mills and Holbeck before being withdrawn (for the first time) from Sheffield's Tinsley depot in February 1992."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "6bb88a8e-dcf4-4a7b-9c84-ba6ef2108b2a",
                        "source_entry_id": "c21abbd4-4951-315e-95b6-1bde126eb038",
                        "source_sense_id": "bc717ae1-b77e-368b-8ba9-c3b7aaeefd1c",
