                "entry_id": "0956311f-b02f-32e5-bc7b-6b17aa67b9d0",
                "word": "palangre",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "521d98f0-8639-4fb7-a347-f584bfefa946",
                        "entry_id": "0956311f-b02f-32e5-bc7b-6b17aa67b9d0",
                        "tags": [
