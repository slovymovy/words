                "senses": [
                    {
                        "sense_id": "857d330f-121c-30e0-8b46-444d73b7b007",
                        "entry_id": "140372f5-a1ac-3e4c-93a6-caa4090192dc",
                        "glosses": [
                            "ein mittels eines kryptographischen Verfahrens verschlüsselter Text"
                        ],
                        "tags": [
                            "Kryptographie"
                        ],
                        "examples": [
                            {
                                "example_id": "81a61c86-0b21-4be0-be8d-e0d6a6717b6c",
                                "sense_id": "857d330f-121c-30e0-8b46-444d73b7b007",
                                "text": "Mit einem geheimen Schlüssel kann ein Geheimtext wieder in den ursprünglichen Klartext zurückgewandelt werden."
                            },
                            {
                                "example_id": "1197d39e-88ef-4f52-9f04-6928bf17bbc1",
                                "sense_id": "857d330f-121c-30e0-8b46-444d73b7b007",
                                "text": "„Der XSL-Angriff hingegen könnte - wenn er denn durchführbar ist - die Rekonstruktion des Schlüssels aus kleinen Mengen Geheimtext ermöglichen, denn anders als die bisher üblichen statistischen Methoden ‘berechnet’ er den Schlüssel direkt.“"
                            },
                            {
                                "example_id": "9f32a305-b33c-4e21-991b-9754e92736a1",
                                "sense_id": "857d330f-121c-30e0-8b46-444d73b7b007",
                                "text": "„Dieser wendet auf den Geheimtext seinen privaten Schlüssel an.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
