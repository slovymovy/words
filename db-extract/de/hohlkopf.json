                ],
                "senses": [
                    {
                        "sense_id": "01344c1d-ec1a-3634-8c48-622d05f9c6b8",
                        "entry_id": "c65794cb-2df8-309b-bc67-6b15424209c6",
                        "glosses": [
                            "dummer Mensch"
                        ],
                        "tags": [
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "73a77ab1-1e51-4351-91b5-be1e93ccb7de",
                                "sense_id": "01344c1d-ec1a-3634-8c48-622d05f9c6b8",
                                "text": "Der alte Hohlkopf von nebenan parkt sein Auto immer vor meiner Einfahrt."
                            },
                            {
                                "example_id": "29c9b9b3-3ee6-46b0-a20e-5c5d66cdd977",
                                "sense_id": "01344c1d-ec1a-3634-8c48-622d05f9c6b8",
                                "text": "„In einem fremden Hause hätte er das nicht getan, aber zu Hause fühlte er sich geehrt; und mit Recht, wie die Schweizer meinen, über die sich manche Hohlköpfe lustig machen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "01327ad3-06e6-445f-8c72-3e58ad111379",
                        "source_entry_id": "c65794cb-2df8-309b-bc67-6b15424209c6",
                        "source_sense_id": "01344c1d-ec1a-3634-8c48-622d05f9c6b8",
                        "source_sense_description": "abwertend: dummer Mensch",
                        "target_lang_word": "demeuré",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "demeuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1ae1c23c-c31f-3c86-b88e-f2156889064e",
                                        "entry_id": "e033789b-f622-32ba-9cae-78fd4cf55638",
                                        "glosses": [
                                            "Personne dont les facultés mentales ne se sont pas développées normalement."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a63b8a2f-4ae1-4602-9da8-f4055e40a115",
                                                "sense_id": "1ae1c23c-c31f-3c86-b88e-f2156889064e",
                                                "text": "« Selon M. Lepelletier, disait-il, le développement mental du petit est un peu en retard sur son développement physique. Il ne manque ni d’intelligence ni de mémoire, mais il est, pour le moment, un peu demeuré.\n– Quoi ? s’écria ma mère, dis tout de suite que c’est un anormal ! »"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29613f86-4ea5-3da2-88a0-73fac5118222",
                                        "entry_id": "e033789b-f622-32ba-9cae-78fd4cf55638",
                                        "glosses": [
                                            "Personne stupide."
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "pejorative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dafa1e53-3d46-4f76-ad97-9f2de2b9eaf6",
                                                "sense_id": "29613f86-4ea5-3da2-88a0-73fac5118222",
                                                "text": "N’y prête pas attention, c’est un demeuré."
                                            },
                                            {
                                                "example_id": "46add110-c324-4f44-a2b8-89ca4ca59c72",
                                                "sense_id": "29613f86-4ea5-3da2-88a0-73fac5118222",
                                                "text": "Tu comprends, Gérard, répétait-elle, Paul est libre et, du reste, il est incapable, il est nul, c’est un âne, un demeuré."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "demeuré",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "e41f054b-777e-3ea0-b4da-029bb979687b",
                                        "entry_id": "c0c6c91f-927b-31ff-9980-73745e68ac78",
                                        "glosses": [
                                            "Participe passé masculin singulier du verbe demeurer."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9c4e5bb0-90f1-4bfc-9f0c-23aa8ac6a602",
                                                "sense_id": "e41f054b-777e-3ea0-b4da-029bb979687b",
                                                "text": "Quant au Timor oriental, demeuré portugais jusqu’en 1975, il est annexé par l’Indonésie et ne deviendra indépendant qu’en 2002."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
