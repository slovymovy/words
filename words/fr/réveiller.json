{
    "word_family": [
        "réveil",
        "réveille-matin",
        "réveillon",
        "réveillonner",
        "réveilleur"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "192b70f5-977b-3a70-9732-472bb9a4265a",
                    "sense_definition": "Faire sortir quelqu'un du sommeil, l'empêcher de continuer à dormir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sortir_du_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Ne <w>réveille</w> pas le bébé, il vient de s'endormir."
                        },
                        {
                            "text": "Ma mère me <w>réveille</w> tous les matins à sept heures."
                        },
                        {
                            "text": "Le tonnerre a <w>réveillé</w> les enfants en pleine nuit."
                        }
                    ],
                    "synonyms": [
                        "éveiller"
                    ],
                    "antonyms": [
                        "endormir"
                    ],
                    "common_phrases": [
                        "réveiller les enfants",
                        "réveiller en sursaut",
                        "réveiller le bébé"
                    ]
                },
                {
                    "sense_id": "4a444ded-e6e6-3a7f-a8a9-1f41f462f101",
                    "sense_definition": "Se réveiller : sortir du sommeil, cesser de dormir.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "sortir_du_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Je me <w>réveille</w> toujours très tôt le dimanche."
                        },
                        {
                            "text": "Hier, nous nous sommes <w>réveillés</w> en retard à cause d'une panne d'électricité."
                        },
                        {
                            "text": "Elle s'est <w>réveillée</w> en sursaut au milieu de la nuit."
                        }
                    ],
                    "synonyms": [
                        "s'éveiller"
                    ],
                    "antonyms": [
                        "s'endormir"
                    ],
                    "common_phrases": [
                        "se réveiller tôt",
                        "se réveiller tard",
                        "se réveiller en sursaut",
                        "se réveiller en pleine nuit"
                    ]
                },
                {
                    "sense_id": "0f8f4f5d-0788-3aa1-baf5-d48448c5e17b",
                    "sense_definition": "Exciter de nouveau un sentiment, un souvenir ou un désir ; le ranimer.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "ranimer_renouveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette vieille photo a <w>réveillé</w> en lui de nombreux souvenirs d'enfance."
                        },
                        {
                            "text": "Le discours du ministre a <w>réveillé</w> la colère des syndicats."
                        },
                        {
                            "text": "Cette chanson <w>réveille</w> de vieux souvenirs chez mes grands-parents."
                        }
                    ],
                    "synonyms": [
                        "raviver",
                        "ranimer"
                    ],
                    "antonyms": [
                        "étouffer"
                    ],
                    "common_phrases": [
                        "réveiller de vieux souvenirs",
                        "réveiller la curiosité",
                        "réveiller la colère"
                    ]
                },
                {
                    "sense_id": "c8fe08a8-300f-3b06-b6fe-0a9f9a5b3cff",
                    "sense_definition": "Se réveiller : sortir d'un évanouissement, d'un coma ou d'un état d'inconscience.",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "sortir_du_sommeil",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Après trois jours de coma, le patient s'est enfin <w>réveillé</w>."
                        },
                        {
                            "text": "Elle s'est <w>réveillée</w> à l'hôpital, sans comprendre ce qui s'était passé."
                        },
                        {
                            "text": "Il a mis des semaines à se <w>réveiller</w> du coma."
                        }
                    ],
                    "antonyms": [
                        "s'évanouir"
                    ],
                    "common_phrases": [
                        "se réveiller du coma"
                    ]
                },
                {
                    "sense_id": "0655d61d-3244-3af0-9db1-5befab18c7f6",
                    "sense_definition": "Renouveler quelque chose, le faire renaître ou lui redonner de la vie.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ranimer_renouveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le festival a <w>réveillé</w> la vie culturelle de la petite ville."
                        },
                        {
                            "text": "Cette réforme a <w>réveillé</w> le débat sur les retraites."
                        },
                        {
                            "text": "Cette crise économique a <w>réveillé</w> une vieille rivalité entre les deux régions."
                        }
                    ],
                    "synonyms": [
                        "raviver"
                    ],
                    "common_phrases": [
                        "réveiller une vieille rivalité",
                        "réveiller le débat"
                    ]
                },
                {
                    "sense_id": "5103e100-8075-3e98-9c4c-acb8f44bf25c",
                    "sense_definition": "Se réveiller : se ranimer, se renouveler, redevenir actif (en parlant d'un sentiment, de la nature, etc.).",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "ranimer_renouveler",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Sa curiosité s'est <w>réveillée</w> en voyant les photos."
                        },
                        {
                            "text": "Au printemps, la nature se <w>réveille</w> peu à peu."
                        },
                        {
                            "text": "Dans le village, les vieilles querelles se <w>réveillent</w> à chaque élection."
                        }
                    ],
                    "synonyms": [
                        "renaître"
                    ],
                    "antonyms": [
                        "s'endormir"
                    ]
                }
            ]
        }
    ]
}