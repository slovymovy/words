                ],
                "senses": [
                    {
                        "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                        "entry_id": "bc0e2f13-a2c3-3179-99e8-a45b6b3b7022",
                        "glosses": [
                            "Vorrichtung zum Aufladen des Akkumulators eines elektrisch angetriebenen Fahrzeugs"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d93bb70e-dca1-4ec1-bc98-0d374147d514",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Es sollen nicht nur das Hantieren mit oftmals dreckigen Kabeln und – angesichts einer verwirrenden Steckerstandardvielfalt – das Suchen nach einer geeigneten Ladesäule entfallen.“"
                            },
                            {
                                "example_id": "1b45a7f3-6358-46bc-9f2b-1f502bba0648",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Die Kosten für Elektroauto-Ladestrom an öffentlichen Ladesäulen beeinflussen die Betriebskosten des E-Autos erheblich.“"
                            },
                            {
                                "example_id": "68290e91-b7f6-4484-9367-fe86ff3c4ac9",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Bereits heute gibt es zu wenig Ladesäulen im Verhältnis zur Anzahl der Elektroautos.“"
                            },
                            {
                                "example_id": "11e4c2b7-6e5d-4c6f-9103-2bcfc3e296ee",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Im August 2023 lag das Verhältnis Elektroauto zu öffentlicher Ladesäule nach Berechnungen des VDA bei 21:1, also 21 Autos pro Ladesäule. Empfohlen wird mindestens 10:1.“"
                            },
                            {
                                "example_id": "1dabb4a6-d7d3-4ad3-9c16-7ef0b7efb58a",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Doch immer noch ist der Markt intransparent. Preise sind an den Ladesäulen – anders als bei Tankstellen – nicht weithin sichtbar und auch online nur mit Aufwand ausfindig zu machen.“"
                            },
                            {
                                "example_id": "57853460-4a22-477e-8e2a-7153c028f660",
                                "sense_id": "b9534a4c-de4a-3dbc-bf71-1c9b9259347a",
                                "text": "„Wer bei EnBW an einer Ladesäule lädt und den Tarif \"S\" für Wenigfahrer ohne Grundgebühr nutzt, der zahlt für die gleiche Menge Strom bereits 12,99 Euro – also mehr als das Doppelte des Privat-Ladetarifs.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
