                ],
                "senses": [
                    {
                        "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                        "entry_id": "6d169d12-2b83-336a-9238-f0cc262b4649",
                        "glosses": [
                            "eine auf Intuition und nicht auf rationaler Überlegung beruhende Einschätzung von etwas"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "19b003d6-1e2e-4970-93a5-969ea1854c17",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "Er hat sich mehr aus einem Bauchgefühl heraus für dieses Fach entschieden."
                            },
                            {
                                "example_id": "a0340b4c-de79-43bd-8932-f0cf85a6aef6",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "»Mein Bauchgefühl sagt mir, dass da etwas nicht stimmt.«"
                            },
                            {
                                "example_id": "acbe3b0f-e21b-4b26-b25d-c604f4ea1688",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "»Wenn mir mein Bauchgefühl sagt, dieser Mieter gefällt mir nicht, dann nehme ich natürlich einen anderen.«"
                            },
                            {
                                "example_id": "ff63c5d5-f0d1-483f-a890-6fc528f5df2d",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "»Im Nachhinein hat sich mein Bauchgefühl bewahrheitet.«"
                            },
                            {
                                "example_id": "c01718cf-132e-4435-98f1-3710ce83f992",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "»Ich habe bei diesem Kindergarten ein gutes Bauchgefühl, da können wir unser Kind hingeben.«"
                            },
                            {
                                "example_id": "91a5ad20-a2c6-4361-af3f-00f454c1ff27",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "Kaufentscheidungen werden häufig aus einem Bauchgefühl heraus und nicht rational getroffen - wie uns das Fach Marketing an der Uni belegt."
                            },
                            {
                                "example_id": "daa114ef-5c46-43f3-9090-bff52358eb4d",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Von der Marktforschung hält der Filmproduzent Nico Hofmann nichts, vielmehr vertraut er auf sein Bauchgefühl: »[…]«.“"
                            },
                            {
                                "example_id": "3d7b5705-d9e4-4657-8a5a-fcbd2d7dfd39",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "Die Differenz zwischen dem Bauchgefühl der Unsicherheit und der tatsächlichen Kriminalität scheint angesichts der seit Jahrzehnten zurückgehenden Statistik größer zu werden."
                            },
                            {
                                "example_id": "017362d4-df30-4990-875a-884ef1f75860",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Wie wir Entscheidungen treffen, hängt von zwei Bewertungssystemen ab: Verstand und Bauchgefühl - Intuition - Unterbewusstes. Der Verstand entscheidet nach Logik, der Bauch danach, ob es sich wohlig und gut anfühlt.“"
                            },
                            {
                                "example_id": "51f5ba04-bbb8-441b-a1f1-e123f31109ee",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Bei alledem kann sich das Bauchgefühl ziemlich sicher sein, straflos davon zu kommen. »Niemand wird je zugeben, dass er eine wichtige Entscheidung aufgrund unbewusster Faktoren oder gar Vorteile getroffen hat«, sagt [Daniel] Kahneman.“"
                            },
                            {
                                "example_id": "ba3b667c-b9ef-42a1-852c-ae4d77ebcf85",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Jeder Mensch verfügt über gefühltes Wissen, das wir als Bauchgefühl kennen, aber oft nicht wahrnehmen.“"
                            },
                            {
                                "example_id": "a87855d8-6f72-4624-a1f4-bd4f78f2b013",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Algorithmen entscheiden in Zukunft, ob wir einen Job bekommen oder nicht. Erfahrung und Bauchgefühl werden ersetzt durch emotionslose Beurteilung.“"
                            },
                            {
                                "example_id": "918e5489-dfcb-4452-b9e3-696f29eb247e",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„Sich vom Bauchgefühl leiten lassen oder auf die Willenskraft setzen - beide Rezepte können von Erfolg gekrönt sein im Leben, im Sport, bei der Arbeit.“"
                            },
                            {
                                "example_id": "34f4e957-c5eb-4c44-b06b-038520aeb33c",
                                "sense_id": "204e59c2-c3b6-34f1-bce1-c8694fb47b32",
                                "text": "„So vertrauen manche Menschen besonders ihrer Intuition (was erstmal nicht unbedingt problematisch ist), haben aber wenig Interesse daran, ihr Bauchgefühl durch stichhaltige Beweise abzusichern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
