                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "16112d2a-b8ac-4d72-ae89-0ebc0efc68df",
                                                "sense_id": "b4a5b785-9999-3033-8f91-c98b982973f9",
                                                "text": "Zčervenal studem."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "41e5aa4e-33d6-3d16-917b-fc265759f600",
                                        "entry_id": "00a748f3-917e-35f3-b38a-f7052b69bdce",
