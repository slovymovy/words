                        "sense_id": "0d8ddc0f-541a-35dd-8a3b-8faf5b5df40a",
                        "entry_id": "577ce11f-f4d0-3a5a-8df7-e5901557fab0",
                        "glosses": [
                            "Ensemble de tout ce qui a trait à la micro-informatique ludique, en particulier les jeux vidéo sur ordinateur."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "bc988938-b847-48fb-9376-c1d30a732939",
                                "sense_id": "0d8ddc0f-541a-35dd-8a3b-8faf5b5df40a",
                                "text": "Le jeu vidéo, au sens devenu habituel du terme, c'est-à-dire « jeu sur téléviseur régi par console non programmable », est en train d'être balayé par la micro-informatique ludique, ce que nous appelons la ludotique."
                            },
                            {
                                "example_id": "55dd4085-ab7f-4523-8375-b2f309842810",
                                "sense_id": "0d8ddc0f-541a-35dd-8a3b-8faf5b5df40a",
                                "text": "Il a également ouvert de nouvelles voies, donné naissance à une culture, à un langage et inspiré la génération de ceux qui dominent aujourd’hui le secteur multimilliardaire de la ludotique."
                            }
                        ]
                    }
