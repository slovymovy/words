                        "glosses": [
                            "Predigerin/Rednerin, die in ihren Reden immer wieder eindringlich zu Hass, Feindschaft, Gewalt auffordert oder aufhetzt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "44dca524-69ee-4a55-bc22-0c68f6d4bc59",
                                "sense_id": "b0ded02c-ed62-3593-b526-d5d186fbb3d0",
                                "text": "Sie sagt, ich würde mit meinen Reden Hass schüren, ich sei eine Hasspredigerin, die Gräben schaufle, statt zu vermitteln."
                            },
                            {
                                "example_id": "4c6df06e-e372-4509-86e8-c28975c1ad53",
                                "sense_id": "b0ded02c-ed62-3593-b526-d5d186fbb3d0",
                                "text": "„Das klingt jetzt so gar nicht nach einer Hasspredigerin.“"
                            }
                        ],
