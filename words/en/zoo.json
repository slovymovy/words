{
    "word_family": [
        "zoology",
        "zoologist",
        "zoological"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "3c8e6325-e293-3eea-be7d-02f2788e534e",
                    "sense_definition": "A park where live animals are exhibited.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We decided to visit the <w>zoo</w> to see the elephants and tigers.",
                            "target_lang_translations": {
                                "ru": "Мы решили сходить в <w>зоопарк</w>, чтобы посмотреть на слонов и тигров.",
                                "zh": "我们决定去<w>动物园</w>看大象和老虎。"
                            }
                        },
                        {
                            "text": "The city <w>zoo</w> is open every day from morning until evening.",
                            "target_lang_translations": {
                                "ru": "Городской <w>зоопарк</w> открыт каждый день с утра до вечера.",
                                "zh": "这家城市<w>动物园</w>每天从早到晚都开放。"
                            }
                        }
                    ],
                    "synonyms": [
                        "wildlife park",
                        "animal park"
                    ],
                    "common_phrases": [
                        "visit the zoo",
                        "petting zoo",
                        "city zoo"
                    ],
                    "target_lang_definitions": {
                        "ru": "Парк, в котором содержатся и демонстрируются живые животные.",
                        "zh": "饲养并展示活体动物的公园。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зоопа́рк",
                                "target_lang_sense_clarification": "основное значение"
                            },
                            {
                                "target_lang_word": "звери́нец",
                                "target_lang_sense_clarification": "место содержания животных"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "动物园",
                                "target_lang_sense_clarification": "主要指供公众参观的动物园"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c595f8d1-306f-3051-99af-568cf1a2d198",
                    "sense_definition": "Any place that is wild, crowded, or chaotic.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The shopping center was a <w>zoo</w> the week before Christmas.",
                            "target_lang_translations": {
                                "ru": "За неделю до Рождества в торговом центре творился настоящий <w>сумасшедший дом</w>.",
                                "zh": "圣诞节前一周，购物中心里简直<w>乱成一团</w>。"
                            }
                        },
                        {
                            "text": "Our house becomes a <w>zoo</w> whenever all the cousins come to visit.",
                            "target_lang_translations": {
                                "ru": "Наш дом превращается в <w>зоопарк</w>, когда приезжают все двоюродные братья и сестры.",
                                "zh": "每当表亲们都来做客时，我们家就变成了<w>闹剧</w>现场。"
                            }
                        }
                    ],
                    "synonyms": [
                        "madhouse",
                        "circus"
                    ],
                    "antonyms": [
                        "haven",
                        "oasis"
                    ],
                    "common_phrases": [
                        "absolute zoo",
                        "like a zoo",
                        "what a zoo"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любое место, где царит шум, суматоха или хаос.",
                        "zh": "指代任何混乱、嘈杂或拥挤不堪的地方。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "сумасше́дший дом",
                                "target_lang_sense_clarification": "переносное значение (хаос, беспорядок)"
                            },
                            {
                                "target_lang_word": "зоопа́рк",
                                "target_lang_sense_clarification": "переносное значение (шумное сборище)"
                            },
                            {
                                "target_lang_word": "балага́н",
                                "target_lang_sense_clarification": "беспорядок, шум"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "乱成一团",
                                "target_lang_sense_clarification": "形容场面混乱"
                            },
                            {
                                "target_lang_word": "闹剧",
                                "target_lang_sense_clarification": "形容场面嘈杂混乱"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "92cd80ac-54fe-375c-8170-f95f90f22667",
                    "sense_definition": "A large and varied collection of something.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The theory attempts to explain the confusing <w>zoo</w> of subatomic particles.",
                            "target_lang_translations": {
                                "ru": "Эта теория пытается объяснить запутанный <w>зоопарк</w> субатомных частиц.",
                                "zh": "该理论试图解释亚原子粒子那令人困惑的<w>大杂烩</w>。"
                            }
                        },
                        {
                            "text": "We encountered a <w>zoo</w> of different software errors while testing the new system.",
                            "target_lang_translations": {
                                "ru": "При тестировании новой системы мы столкнулись с целым <w>зоопарком</w> различных программных ошибок.",
                                "zh": "在测试新系统时，我们遇到了各种各样的软件错误<w>大杂烩</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "array",
                        "assortment",
                        "variety"
                    ],
                    "common_phrases": [
                        "zoo of particles"
                    ],
                    "target_lang_definitions": {
                        "ru": "Большое и разнообразное скопление чего-либо (часто разнородного).",
                        "zh": "指代某种事物的大量且多样的集合。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "зоопа́рк",
                                "target_lang_sense_clarification": "набор разнородных элементов (научное/IT)"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "大杂烩",
                                "target_lang_sense_clarification": "指种类繁多且混杂的集合"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "e737476a-6cfc-340d-8152-591ab828d4b4",
                    "sense_definition": "The jungle.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The soldiers felt a constant anxiety while patrolling the <w>zoo</w>.",
                            "target_lang_translations": {
                                "ru": "Солдаты чувствовали постоянную тревогу, патрулируя <w>джунгли</w>.",
                                "zh": "士兵们在巡逻<w>丛林</w>时感到持续的焦虑。"
                            }
                        },
                        {
                            "text": "He told stories about surviving in the <w>zoo</w> during his time in the service.",
                            "target_lang_translations": {
                                "ru": "Он рассказывал истории о выживании в <w>джунглях</w> во время службы.",
                                "zh": "他讲述了自己在服役期间于<w>丛林</w>中求生的故事。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "slang",
                            "comment": "military context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Джунгли (военный сленг).",
                        "zh": "指代丛林（军事俚语）。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "джу́нгли",
                                "target_lang_sense_clarification": "значение в контексте"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "丛林",
                                "target_lang_sense_clarification": "军事语境下的丛林地带"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}