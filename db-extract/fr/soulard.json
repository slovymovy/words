                    {
                        "translation_id": "ebcb0fb8-4f5c-44e5-b0f9-af086466a03c",
                        "source_entry_id": "3460b89f-2101-3c93-a6ef-46f6f92b1a91",
                        "source_sense_id": "03565026-e9c7-3559-8eec-8f709596e506",
                        "target_lang_word": "drunk",
