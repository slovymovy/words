                "senses": [
                    {
                        "sense_id": "c483a9ec-03e3-34af-acf9-1ea4f0d1e9c5",
                        "entry_id": "686f368e-8faa-3a8f-af06-445fa307c18a",
                        "glosses": [
                            "historisches Kraftmessgerät im Wiener Wurstelprater"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "732c5e44-7aed-4867-8bc6-b869fa5e2c3e",
                                "sense_id": "c483a9ec-03e3-34af-acf9-1ea4f0d1e9c5",
                                "text": "Er gab dem Watschenmann eine kräftige Ohrfeige."
                            },
                            {
                                "example_id": "61a8c680-b3c7-4428-87dd-abfd81dec17d",
                                "sense_id": "c483a9ec-03e3-34af-acf9-1ea4f0d1e9c5",
                                "text": "Na, so gehen’s halt in den Prater, watschen’s dort den Watschenmann."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "83470380-e977-3b9e-a28e-eec783ef42f4",
                        "entry_id": "686f368e-8faa-3a8f-af06-445fa307c18a",
                        "glosses": [
                            "Mensch, der (ungerechtfertigt) für Missstände oder Verfehlungen anderer verantwortlich gemacht wird"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "a2ac5feb-65b5-4a5e-9f30-a3d08647d08e",
                                "sense_id": "83470380-e977-3b9e-a28e-eec783ef42f4",
                                "text": "Ich lasse mich doch nicht zum Watschenmann machen."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1aa884e2-3586-41a4-88da-96c9efc0bfb2",
                        "source_entry_id": "686f368e-8faa-3a8f-af06-445fa307c18a",
                        "source_sense_id": "83470380-e977-3b9e-a28e-eec783ef42f4",
                        "target_lang_word": "bouc émissaire",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "bouc émissaire",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "0b7f407c-20e1-3f03-927e-132f3d7a740c",
                                        "entry_id": "8e60b96c-a7e7-3cac-8296-936bceba0d4a",
                                        "glosses": [
                                            "Bouc que l’on chassait dans le désert, après l’avoir chargé des malédictions que l’on voulait détourner du peuple."
                                        ],
                                        "tags": [
                                            "Biblical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "08c96f97-2f9f-46be-91fc-b9eba021e4d2",
                                                "sense_id": "0b7f407c-20e1-3f03-927e-132f3d7a740c",
                                                "text": "Dans les plus profondes strates de mythologisation, là où l’inconscient est projeté, on trouve de nombreux thèmes qui expriment le principe des opposés. On repère déjà une couche très ancienne de mythologisation dans le rituel archaïque du bouc émissaire, lequel sert à projeter l’inconscient sur des situations réelles."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                        "entry_id": "8e60b96c-a7e7-3cac-8296-936bceba0d4a",
                                        "glosses": [
                                            "Personne sur laquelle on fait retomber les torts des autres, victime expiatoire."
                                        ],
                                        "tags": [
                                            "familiar",
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "33597a74-2300-4317-96a4-9e8c8318c485",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "La personne responsable de la frustration est la cible de l’agression, mais en l’absence de cet agent frustrant, l’agression est déplacée vers d’autres personnes (plus communément appelées boucs émissaires)."
                                            },
                                            {
                                                "example_id": "7ce772d5-bdca-440d-82ad-2dcf75c0bf0e",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Le chef commet un massacre, un vol ou une injustice, à la suite de quoi, pour ne pas être inquiété, il invente un bouc émissaire et le livre à la vindicte populaire…"
                                            },
                                            {
                                                "example_id": "27d462c8-0382-4d0c-a9ae-dab39a15a410",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Dans le moments de déchaînement collectif d’agressivité sur un bouc émissaire, montré du doigt ou exhibé sur l’estrade, le pasteur contribue activement à exacerber la haine de l’autre maléfique : en vociférant dans le micro, en s’agitant en long et en large, en mouillant sa chemise et en transpirant à grosses gouttes."
                                            },
                                            {
                                                "example_id": "041379de-4fd2-4ea9-b020-8e7a208fc3f0",
                                                "sense_id": "686149a8-260c-3657-a250-afcef7b739ee",
                                                "text": "Les messages de haine et les théories du complot qui ciblent des communautés et en font des boucs émissaires sont de plus en plus répandus sur les plateformes en ligne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
