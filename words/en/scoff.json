                    "frequency": "Middle",
                    "semantic_group_id": "mockery",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The audience began to <w>scoff</w> at the speaker's ridiculous claims."
                        },
                        {
                            "text": "It is easy to <w>scoff</w> at new ideas before you understand them."
                        }
                    ],
                    "synonyms": [
                        "deride",
                        "sneer"
                    ],
                    "common_phrases": [
                        "scoff at"
                    ]
                },
                {
                    "sense_id": "a8fbbba3-cbbe-3688-bcf8-234d0770a633",
                    "sense_definition": "To eat food very quickly and greedily.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "eating",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The hungry children managed to <w>scoff</w> all the sandwiches in minutes."
                        },
                        {
                            "text": "He had to <w>scoff</w> his lunch before the meeting started."
                        }
                    ],
                    "synonyms": [
                        "gobble",
                        "scarf"
                    ],
                    "common_phrases": [
                        "scoff down"
                    ],
                    "traits": [
