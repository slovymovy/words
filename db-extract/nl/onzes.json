                "entry_id": "501256cc-084b-3d4b-b30a-606fa8fadf81",
                "word": "onzes",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "d828df76-a4cd-3a87-bde1-a7488eaf5056",
                        "entry_id": "501256cc-084b-3d4b-b30a-606fa8fadf81",
                        "glosses": [
                            "genitief van wij en we"
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "2737cb21-483b-4743-93cc-ae3d9418ede1",
                                "sense_id": "d828df76-a4cd-3a87-bde1-a7488eaf5056",
                                "text": "Wij volgen iemand gemakkelijkst na, wanneer hij onzes gelijke is."
                            },
                            {
                                "example_id": "b4525442-7628-4607-b58a-2f6f7520332b",
                                "sense_id": "d828df76-a4cd-3a87-bde1-a7488eaf5056",
                                "text": "O Galate, weest geluckigh, en onzes gedachtigh"
                            }
                        ]
                    }
                ],
                "translations": [],
                "word_linkages": []
            },
            {
                "entry_id": "a413a4ed-fcb3-302d-b983-1a23f291e236",
                "word": "onzes",
                "pos": "pron",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "59594ea0-bd79-3bd9-8979-50b27ff93ae4",
                        "entry_id": "a413a4ed-fcb3-302d-b983-1a23f291e236",
                        "glosses": [
                            "genitief (van) ons"
                        ],
                        "tags": [
                            "masculine",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "966d75a5-4ff2-4371-b422-6a3412674f4d",
                                "sense_id": "59594ea0-bd79-3bd9-8979-50b27ff93ae4",
                                "text": "Enkele jaren geleden moesten wij sluipend onzes weegs gaan."
                            },
                            {
                                "example_id": "26d37bc5-4e29-42b6-9eba-f64a2fcd1380",
                                "sense_id": "59594ea0-bd79-3bd9-8979-50b27ff93ae4",
                                "text": "Jakob heeft genomen alles, wat onzes vaders was, en van hetgeen, dat onzes vaders was, heeft hij al deze heerlijkheid gemaakt."
                            }
                        ]
                    },
                    {
                        "sense_id": "428b7fe3-9c9c-38aa-baa6-755fdea4dfa2",
                        "entry_id": "a413a4ed-fcb3-302d-b983-1a23f291e236",
                        "glosses": [
                            "genitief (van) ons"
                        ],
                        "tags": [
                            "neuter",
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c3fe40be-e1e5-4543-9a03-00ececd378eb",
                                "sense_id": "428b7fe3-9c9c-38aa-baa6-755fdea4dfa2",
                                "text": "Zeven dagen achter elkaar werken in de hitte en in het zweet onzes aanschijns, heeft zijn sporen achtergelaten, nog afgezien van het feestje de voorafgaande nacht."
                            }
                        ]
                    }
                ],
