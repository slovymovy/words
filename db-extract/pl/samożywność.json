                                    {
                                        "sense_id": "fa62731e-04cd-3bd2-a46d-2b1d7b8c89b8",
                                        "entry_id": "038cca4b-73bd-3fe1-9129-00203cf428cc",
                                        "glosses": [
                                            "The synthesis of food from inorganic substances, using heat or light as a source of energy"
                                        ],
