{
    "word_family": [
        "recipeless"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "a5926503-dbf8-3901-86df-25604f191384",
                    "sense_definition": "A set of instructions for making or preparing food dishes.",
                    "learner_level": "A1",
                    "frequency": "High",
                    "semantic_group_id": "cooking",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I found a simple <w>recipe</w> for chocolate cake in this old cookbook.",
                            "target_lang_translations": {
                                "ru": "Я нашла простой <w>рецепт</w> шоколадного торта в этой старой поваренной книге."
                            }
                        },
                        {
                            "text": "You should follow the <w>recipe</w> carefully to make sure the bread rises correctly.",
                            "target_lang_translations": {
                                "ru": "Вам следует внимательно следовать <w>рецепту</w>, чтобы хлеб правильно поднялся."
                            }
                        }
                    ],
                    "common_phrases": [
                        "follow a recipe",
                        "simple recipe",
                        "secret recipe",
                        "cake recipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор инструкций по приготовлению кулинарных блюд."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецепт",
                                "target_lang_sense_clarification": "кулинарный"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "67ada4a0-ba69-3494-adbd-f9c8a855f15e",
                    "sense_definition": "A plan or procedure to obtain a specific end result or outcome.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "plan",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "His new approach to management is definitely a <w>recipe</w> for success.",
                            "target_lang_translations": {
                                "ru": "Его новый подход к управлению — это определенно <w>залог</w> успеха."
                            }
                        },
                        {
                            "text": "Ignoring the safety warnings is a <w>recipe</w> for disaster in this factory.",
                            "target_lang_translations": {
                                "ru": "Игнорирование предупреждений о безопасности на этом заводе — прямой <w>путь</w> к катастрофе."
                            }
                        }
                    ],
                    "common_phrases": [
                        "recipe for success",
                        "recipe for disaster",
                        "recipe for trouble"
                    ],
                    "target_lang_definitions": {
                        "ru": "План или порядок действий для достижения определенного результата или исхода."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецепт",
                                "target_lang_sense_clarification": "переносное значение: способ достижения цели"
                            },
                            {
                                "target_lang_word": "залог",
                                "target_lang_sense_clarification": "в контексте успеха или неудачи"
                            },
                            {
                                "target_lang_word": "путь",
                                "target_lang_sense_clarification": "к определенному результату"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d9699dd4-215b-33fb-a689-9a439addb61c",
                    "sense_definition": "Any set of instructions for preparing a mixture of ingredients or substances.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "instructions",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist spent hours copying alchemical <w>recipes</w> and trying to replicate them in his laboratory.",
                            "target_lang_translations": {
                                "ru": "Ученый часами переписывал алхимические <w>рецепты</w>, пытаясь воспроизвести их в своей лаборатории."
                            }
                        },
                        {
                            "text": "We need a precise <w>recipe</w> for the cleaning solution to ensure it is effective.",
                            "target_lang_translations": {
                                "ru": "Нам нужен точный <w>состав</w> чистящего раствора, чтобы гарантировать его эффективность."
                            }
                        }
                    ],
                    "common_phrases": [
                        "chemical recipe",
                        "mixing recipe"
                    ],
                    "target_lang_definitions": {
                        "ru": "Любой набор инструкций для приготовления смеси ингредиентов или веществ."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецепт",
                                "target_lang_sense_clarification": "состав смеси или раствора"
                            },
                            {
                                "target_lang_word": "рецептура",
                                "target_lang_sense_clarification": "совокупность компонентов и их пропорций"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "7fb2127c-3311-3a3c-a950-f8e7623451ab",
                    "sense_definition": "A set of conditions and parameters of an industrial process to obtain a given result.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "technical_process",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The engineer adjusted the stepper <w>recipes</w> to improve the yield of the semiconductor wafers.",
                            "target_lang_translations": {
                                "ru": "Инженер скорректировал <w>параметры</w> степпера, чтобы повысить выход полупроводниковых пластин."
                            }
                        },
                        {
                            "text": "Each batch of steel requires a specific industrial <w>recipe</w> to meet quality standards.",
                            "target_lang_translations": {
                                "ru": "Для каждой партии стали требуется определенная промышленная <w>рецептура</w>, чтобы соответствовать стандартам качества."
                            }
                        }
                    ],
                    "common_phrases": [
                        "industrial recipe",
                        "process recipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Набор условий и параметров промышленного процесса для получения заданного результата."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецепт",
                                "target_lang_sense_clarification": "технические параметры процесса"
                            },
                            {
                                "target_lang_word": "технологическая карта",
                                "target_lang_sense_clarification": "описание производственного процесса"
                            },
                            {
                                "target_lang_word": "регламент",
                                "target_lang_sense_clarification": "установленный порядок действий"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "ce310b59-12cd-3112-8f24-560e1e9a801c",
                    "sense_definition": "A formula for preparing or using a medicine; a medical prescription.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "medical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "No sooner has a drug been blacklisted than chemists adjust their <w>recipe</w> and start churning out a different one.",
                            "target_lang_translations": {
                                "ru": "Как только препарат попадает в черный список, химики меняют его <w>состав</w> и начинают штамповать другой."
                            }
                        },
                        {
                            "text": "The apothecary followed the ancient <w>recipe</w> to create the herbal tonic.",
                            "target_lang_translations": {
                                "ru": "Аптекарь следовал древнему <w>рецепту</w>, чтобы создать травяной тоник."
                            }
                        }
                    ],
                    "synonyms": [
                        "receipt"
                    ],
                    "common_phrases": [
                        "medical recipe"
                    ],
                    "traits": [
                        {
                            "trait_type": "dated",
                            "comment": "often replaced by prescription in modern medical contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Формула для приготовления или использования лекарства; медицинское предписание."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "рецепт",
                                "target_lang_sense_clarification": "медицинское предписание врача"
                            },
                            {
                                "target_lang_word": "состав",
                                "target_lang_sense_clarification": "лекарственного средства"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}