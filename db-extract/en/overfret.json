                "senses": [
                    {
                        "sense_id": "9774fa71-053c-39c6-9e09-26dae769cece",
                        "entry_id": "f182e2be-3b36-3727-8148-66442bfeaa15",
                        "glosses": [
                            "To fret excessively."
                        ],
                        "tags": [
                            "intransitive",
                            "reflexive"
                        ],
                        "examples": [
                            {
                                "example_id": "b17a0d5a-9113-4708-b7a1-6366491b317d",
                                "sense_id": "9774fa71-053c-39c6-9e09-26dae769cece",
                                "text": "\"I believe it was,\" replied Lord Norbourne, kindly taking his companion's hand. \"I have learnt to think of my loss with a sadness that soothes me. I turn to her image when overfretted with worldly cares. I hope almost as she hoped for our re-union.\""
                            },
                            {
                                "example_id": "28c23be0-e389-427b-aecf-68ea84403810",
                                "sense_id": "9774fa71-053c-39c6-9e09-26dae769cece",
                                "text": "But now come down from your pedestal, and do not overfret yourself, because your hand, or your mind, or your soul, will not fulfil all that you would have it."
                            }
                        ]
                    }
                ],
