                "senses": [
                    {
                        "sense_id": "62973a37-56d4-321a-92db-ffaa14027e3f",
                        "entry_id": "b1baf65a-293f-3d11-8cc0-bfc43c2b2a3c",
                        "glosses": [
                            "Bestandteil der Pkw-Karosserie; balkenartiges Element, das längs unterhalb der Einstiegstüren verläuft, auf beiden Seiten des Pkws jeweils zwischen dem hinteren und dem vorderen Radkasten"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d03597cd-56e2-422d-b188-e14d15fe826d",
                                "sense_id": "62973a37-56d4-321a-92db-ffaa14027e3f",
                                "text": "Nach meinem Unfall war mein Türschweller auf der Fahrerseite ganz schön eingedrückt und zerkratzt."
                            },
                            {
                                "example_id": "266e3e6b-ddbe-4f3d-a932-752646efdf98",
                                "sense_id": "62973a37-56d4-321a-92db-ffaa14027e3f",
                                "text": "„Der einzig korrekte Reparaturweg ist, einen angeknickten oder eingedrückten Türschweller zu erneuern.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29b4a021-3856-4a7e-845b-d03ea51b0096",
                        "source_entry_id": "b1baf65a-293f-3d11-8cc0-bfc43c2b2a3c",
