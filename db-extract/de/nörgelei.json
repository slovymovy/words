                "senses": [
                    {
                        "sense_id": "c0fc254c-05b9-3b04-ac07-a40c8f00e5e4",
                        "entry_id": "42047dc4-4989-33dc-b256-48dbf8d72a34",
                        "glosses": [
                            "anhaltende/penetrante Äußerung von Unmut"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c2b89624-eb59-4c8f-bd99-06afefdc468f",
                                "sense_id": "c0fc254c-05b9-3b04-ac07-a40c8f00e5e4",
                                "text": "„Der Mensch nörgelt, seit er den Mund aufmacht, aber bis auf den heutigen Tag gibt es kein wissenschaftliches Fach, das sich mit Nörgelei befasst.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "6d1ccb2e-9b79-4245-a3ac-b6f4a09f20be",
                        "source_entry_id": "42047dc4-4989-33dc-b256-48dbf8d72a34",
                        "source_sense_id": "c0fc254c-05b9-3b04-ac07-a40c8f00e5e4",
