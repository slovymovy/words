            {
                "entry_id": "5fa9c606-035a-398c-af05-d75a87eb83df",
                "word": "tondu",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "9d673b80-0ee8-4cbf-8e1b-57b0505cd0b6",
                        "entry_id": "5fa9c606-035a-398c-af05-d75a87eb83df",
                        "tags": [
