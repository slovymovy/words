                                    },
                                    {
                                        "sense_id": "a47c62e7-3d0e-342d-8788-0748eeae2ba8",
                                        "entry_id": "1d2edfae-b1d6-3715-861f-f4204c5c8f81",
                                        "glosses": [
                                            "Peinture de large format."
                                        ],
                                        "tags": [
                                            "Peinture"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8b51bf61-0430-48b1-9686-dd18e2d486ba",
                                                "sense_id": "a47c62e7-3d0e-342d-8788-0748eeae2ba8",
                                                "text": "Mégalographie des Mystères de Dionysos : vue d’ensemble des murs nord et est ; Pompéi, Villa des Mystères."
                                            },
                                            {
                                                "example_id": "c0876ace-27bd-4231-8fd9-dce004ba4eff",
                                                "sense_id": "a47c62e7-3d0e-342d-8788-0748eeae2ba8",
                                                "text": "Il ne s’agit pas d’une mégalographie de personnages grandeur nature comme celle de la frise des Mystères, mais de ceux plus petits du cubiculum qui précède le fameux salon, avec Ménade et Satyre."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
