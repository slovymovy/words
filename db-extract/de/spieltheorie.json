                ],
                "senses": [
                    {
                        "sense_id": "547b14aa-b9af-3968-a351-4a5aac66f1df",
                        "entry_id": "9e0bcc4a-6a8d-3c0d-a7d4-9a2d3ea01cf8",
                        "glosses": [
                            "Theorie, die sich mit der mathematischen Analyse von Entscheidungssituationen, in denen der Erfolg des Einzelnen nicht nur vom eigenen Handeln, sondern auch vom Verhalten anderer abhängt, beschäftigt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "966544fe-6049-4b12-876a-e0e0817c0476",
                                "sense_id": "547b14aa-b9af-3968-a351-4a5aac66f1df",
                                "text": "Die Spieltheorie wurde in den 1940er Jahren von John von Neumann entwickelt."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                        "entry_id": "9e0bcc4a-6a8d-3c0d-a7d4-9a2d3ea01cf8",
                        "glosses": [
                            "wissenschaftsbasiertes Denkgebäude, das Fragestellungen zur Phänomenologie, Etymologie, Geschichte und gesellschaftlichen Bedeutung des Spiels systematisch zu erfassen und darzustellen versucht"
                        ],
                        "tags": [
                            "Spielwissenschaft"
                        ],
                        "examples": [
                            {
                                "example_id": "b85cef52-719d-4a5d-bb95-c1335d9202de",
                                "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                                "text": "„Die Spieltheorie erst führt in das Innerste der Fröbelschen Gedanken hinein.“"
                            },
                            {
                                "example_id": "117cc26f-ad07-452d-88bb-ab8db07a1014",
                                "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                                "text": "“Piagets Spiellehre unter dem Titel ‚Nahahmung, Spiel und Traum’ (1969) hat gewiss das Ihre dazu beigetragen, dass die Spieltheorie durch die Psychologie der kognitiven Entwicklung überformt und teilweise geradezu blockiert worden ist.“"
                            },
                            {
                                "example_id": "095ab449-50a9-4ee3-8bd6-3624214be52b",
                                "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                                "text": "„Unser Weg durch die Phänomene und Spieltheorien, durch Praxisprobleme und Pädagogik des Spieles wollte zeigen, welche Vielfalt im Leben der Kinder und welche Wahrnehmungen der Erwachsenen in dem großen Komplex Kinderspiel zusammenkommen.“"
                            },
                            {
                                "example_id": "8fb9ea16-bf8a-4cd8-8d7e-24e9d3d799fa",
                                "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                                "text": "„Eine aus der Kulturanthropologie hervorgegangene Spieltheorie vertritt die Auffassung, dass im Spiel und mit dem Spiel menschliche Kulturen entstehen, dass die Kulturen letztlich im Spiel wurzeln.“"
                            },
                            {
                                "example_id": "416288a7-ef9f-40c1-9bc4-956ae0fbe0c7",
                                "sense_id": "4aadfdbf-c690-3ae2-a653-bd8b72ebedae",
                                "text": "„Die kognitive Spieltheorie […] interpretiert das Spielen als parallele Erscheinung zur Entwicklung der Strukturen des kindlichen Denkens.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
