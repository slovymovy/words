                        "form": "der Körpersprache"
                    },
                    {
                        "form_id": "d0255012-0a4c-4db6-bce4-f82048804ecc",
                        "entry_id": "c63259da-355d-3f90-9515-d339cfd2ede6",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Körpersprache"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                        "entry_id": "c63259da-355d-3f90-9515-d339cfd2ede6",
                        "glosses": [
                            "die Art und Weise, mit dem eigenen Körper (seiner Haltung oder den Bewegungen) das Gesprochene zu verdeutlichen oder etwas Unausgesprochenes darzulegen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "14fad56d-a077-410f-9b20-c3d90e20772c",
                                "sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                                "text": "„Im engen Sinne ist nonverbale Kommunikation Körpersprache […]“"
                            },
                            {
                                "example_id": "fa26e8e9-1145-438c-b162-8623829d30ed",
                                "sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                                "text": "„Doch wenn wir wirklich Trost und Geborgenheit suchen, sehnen wir uns nach der Nestwärme der Körpersprache und ihrer täuschungslosen Unmißverständlichkeit zurück.“"
                            },
                            {
                                "example_id": "7b7aaed3-d876-4660-8e08-960cd2716738",
                                "sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                                "text": "„Wir verstehen nicht, was sie sagen, aber ihre Mimik und Körpersprache ist schon interessant genug.“"
                            },
                            {
                                "example_id": "72467bb7-0a43-4dc0-80ea-6a9ded88bdb5",
                                "sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                                "text": "„In der Körpersprache der Internationalität verständigten sie sich lückenlos, Jottpee war in der Liebe eine delikate Mischung von Naturtalent und Raffinesse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "bc84c5f3-2a2e-4b3e-a631-bca13c7daad0",
                        "source_entry_id": "c63259da-355d-3f90-9515-d339cfd2ede6",
                        "source_sense_id": "6b4f474e-2f00-3707-86b7-5d8a1d75c69e",
                        "target_lang_word": "body language",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "body language",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "c3cc8f1e-0c9c-387e-abba-8afc2a775fd5",
                                        "entry_id": "97528c8e-8f9f-3ac9-932c-8741f66a04fa",
                                        "glosses": [
                                            "Nonverbal communication by means of facial expressions, eye behavior, gestures, posture, and the like; often thought to be involuntary."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "80dee5e6-1b8e-4d36-a849-68c3599f83ff",
                                                "sense_id": "c3cc8f1e-0c9c-387e-abba-8afc2a775fd5",
                                                "text": "The one question is whether Paul Pogba was taken off just before half-time to rest him or because of a problem. The midfielder’s body language suggested it was the former and he appeared on the pitch after the final whistle."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5af8c2c5-511d-32e7-8456-0685fefed169",
                                        "entry_id": "97528c8e-8f9f-3ac9-932c-8741f66a04fa",
                                        "glosses": [
                                            "Deliberate, usually culturally influenced, nonverbal communication using the body through facial expressions, gestures, dance, mime, etc."
                                        ],
                                        "tags": [
                                            "uncountable",
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b343f529-3a1d-4539-a2c4-86b26d599f30",
                                                "sense_id": "5af8c2c5-511d-32e7-8456-0685fefed169",
                                                "text": "There are, however, body languages that can transcend cultural lines."
                                            },
                                            {
                                                "example_id": "1c2e8470-b163-478f-a1b0-367320587a32",
                                                "sense_id": "5af8c2c5-511d-32e7-8456-0685fefed169",
                                                "text": "As with spoken languages, body languages are used by everyone to live out their lives, to communicate, and to accomplish things in the world — all of which can be done with more or less success with no awareness of the rule-structures that govern the use of body language or its connection with the culture, far less the metaphysics of self that is involved."
                                            },
                                            {
                                                "example_id": "8abf95dd-4a7c-4c58-90a4-c2749a2a9d9a",
                                                "sense_id": "5af8c2c5-511d-32e7-8456-0685fefed169",
                                                "text": "2008, P. Brunelli - Uptodate Fashion Academy, 2.03: Body language & imagination, in Emotional Trend: Psyche > Creativity > Beauty to Fashion,\nIn artistic terms, the synthesis between body languages and dressing languages is expressed in dances, since the rhythmic and creative movement of the body reveals emotions and culture."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5376a8e7-c4e2-4d91-a5a0-2e1f4f0a3b74",
                        "source_entry_id": "c63259da-355d-3f90-9515-d339cfd2ede6",
