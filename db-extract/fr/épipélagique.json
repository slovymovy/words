                        ],
                        "form": "épipélagiques"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "e8a00bf9-2e3b-3cea-b0b3-a42037a98c35",
                        "entry_id": "49dd4ad2-ef9d-3241-a2e0-14d9b707ab0e",
                        "glosses": [
                            "Qui se situe dans la zone aquatique se situant de 0 à 200 m sous la surface de la mer."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b2ec918d-c083-405c-9fdd-e3b8bf593ab8",
                                "sense_id": "e8a00bf9-2e3b-3cea-b0b3-a42037a98c35",
                                "text": "Épipélagique (de la surface jusqu'à 200 mètres) - Espace où la lumière est suffisante pour permettre la photosynthèse, les plantes et animaux étant largement concentrés dans cette zone. Cet espace est aussi appelé zone photique. Attention toutefois, la zone photique ne concerne que les 100 premiers mètres de la zone épipélagique. En dessous, il ne reste plus que 1 % du rayonnement global (le bleu va plus profondément, le rouge beaucoup moins), ce qui est insuffisant pour la photosynthèse."
                            },
                            {
                                "example_id": "e20aea5c-66ed-4050-8c6d-1d9a117312d3",
                                "sense_id": "e8a00bf9-2e3b-3cea-b0b3-a42037a98c35",
                                "text": "…loin d'être limité à la couche épipélagique, le zooplancton effectue des migrations journalières entre cette couche euphotique et la couche mésopélagique"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "fd627e39-8aa4-40df-bb50-62be630ff6bc",
                        "source_entry_id": "49dd4ad2-ef9d-3241-a2e0-14d9b707ab0e",
                        "source_sense_id": "e8a00bf9-2e3b-3cea-b0b3-a42037a98c35",
                        "target_lang_word": "epipelagisch",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "epipelagisch",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                        "entry_id": "0ff2bbed-b3d8-32f1-a6fd-7efcf100db18",
                                        "glosses": [
                                            "das Epipelagial betreffend, zu ihm gehörig"
                                        ],
                                        "tags": [
                                            "Biogeographie"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2ca6e5c0-3626-499f-b857-4d587d43a9b4",
                                                "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                                "text": "Die epipelagische Zone wird von der Sonne durchflutet und erlaubt daher vielzelligen Algen, höheren Pflanzen und photoautotrophen Kleinstlebewesen, Photosynthese zu betreiben."
                                            },
                                            {
                                                "example_id": "94d5f0c4-3640-439d-bd5f-6d82ac1a62bf",
                                                "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                                "text": "In einigen Fällen ist es schwer zu entscheiden, wo die Stammformen zu suchen sind, ob die Vorfahren epipelagisch oder benthal waren."
                                            },
                                            {
                                                "example_id": "35eb4690-5cb3-4964-b7e1-66fe34a2c50e",
                                                "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                                "text": "Eine epipelagisch (oberste Meeresschicht von der Oberfläche bis 200m Tiefe) in Schwärmen lebende Art, die küstennahe Gewässer und Wassertiefen bis 60m bevorzugt."
                                            },
                                            {
                                                "example_id": "abbdd2cc-8241-40fd-b238-d6ca09061a1f",
                                                "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                                "text": "Man kennt nur Larven und Jungfische, die epipelagisch in den obersten 200 Meter der Wassersäule leben."
                                            },
                                            {
                                                "example_id": "4512f79f-74d0-45a1-a0cb-84a9bd269991",
                                                "sense_id": "45d44d61-aa4d-33ee-9ed6-32c4c7d05ab6",
                                                "text": "Der Schlanke Sonnenfisch lebt weit verbreitet epipelagisch im westlichen (Florida bis Brasilien) und östlichen Atlantik (Skandinavien bis Südafrika) und im östlichen Pazifik (Kalifornien bis Chile)."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
