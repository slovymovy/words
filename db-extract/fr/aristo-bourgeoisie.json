                        "sense_id": "a60bcca0-1092-3dce-bc59-0075848512e9",
                        "entry_id": "085c2592-924b-351c-9d8d-157ab2ecd78a",
                        "glosses": [
                            "élite de la bourgeoisie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "257da5ad-893c-4203-b852-237907d80e65",
                                "sense_id": "a60bcca0-1092-3dce-bc59-0075848512e9",
                                "text": "Violemment anticommunistes, les membres de cette aristo-bourgeoisie sont de véritables potentats locaux, alliés à l’armée et contrôlant la police dirigée par l’un des leurs."
                            },
                            {
                                "example_id": "77f50d5a-d9b0-40f7-be76-9d697bbcfcbf",
                                "sense_id": "a60bcca0-1092-3dce-bc59-0075848512e9",
                                "text": "Or, la réalité était tout autre : la forme de ce nouveau pouvoir semblait être un régime voulant remplacer progressivement le capitalisme libéral de l’aristo-bourgeoisie."
                            },
                            {
                                "example_id": "30dcb33c-1777-4475-8413-ddc45c813ac4",
                                "sense_id": "a60bcca0-1092-3dce-bc59-0075848512e9",
                                "text": "Il voulait arriver au pouvoir, autant pour mater cette aristo-bourgeoisie beauvaisienne qui lui tenait rigueur, que pour satisfaire s’a haine contre la religion."
                            }
                        ]
                    }
