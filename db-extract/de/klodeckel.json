                        "entry_id": "f884a36b-1400-3091-9261-ae3fdd0d1073",
                        "glosses": [
                            "Deckel für eine Toilette"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b87c7aac-7694-4377-953f-0b341fd96e96",
                                "sense_id": "484a93e2-83de-354f-95f6-5e1cd6566d33",
                                "text": "Typisch Männer: sie pinkeln im Stehen und lassen den Klodeckel offen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "76ac14f8-4a74-3f3c-ac52-eb0e5e56f276",
                        "entry_id": "f884a36b-1400-3091-9261-ae3fdd0d1073",
                        "glosses": [
                            "Brasse"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "d9445fdc-9c10-480a-a72a-4a49318e5f46",
                                "sense_id": "76ac14f8-4a74-3f3c-ac52-eb0e5e56f276",
                                "text": "„Als Köder für die Brasse kannst du verwenden, was dir vor die Füße fällt. Ich glaube, die riesigen Mäuler der Klodeckel saugen einfach alles ab, was gerade auf der Tagestour auf dem Weg liegt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
