                                "target_senses": [
                                    {
                                        "sense_id": "bcccaff5-589f-37be-8c87-b83e6091cf5f",
                                        "entry_id": "14995259-fcbd-3c8c-80fc-cbc7a20b7676",
                                        "glosses": [
                                            "To use grenade(s) upon."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "703656aa-fccd-4d67-8a6c-4be04dfe8438",
                                                "sense_id": "bcccaff5-589f-37be-8c87-b83e6091cf5f",
                                                "text": "Some of the infantry got pinned down by it, and from cover kept up the battle by grenading rubble piles or any other likely spots ahead of them."
                                            },
                                            {
                                                "example_id": "24679ad9-4e50-4e3b-a1b8-5bf7dd258c21",
                                                "sense_id": "bcccaff5-589f-37be-8c87-b83e6091cf5f",
                                                "text": "They advanced after grenading the next traverse, much like the British did."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f48d26fd-ace2-3238-8146-5bf1fc147d01",
