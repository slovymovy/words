                                        "entry_id": "c4d83532-f573-37b3-ba9f-3cddf0ba8e1e",
                                        "glosses": [
                                            "(Oberflächen) mit Flüssigkeitstropfen oder einem Flüssigkeitsfilm versehen oder überziehen"
