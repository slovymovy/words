                ],
                "senses": [
                    {
                        "sense_id": "4f6b61fd-1ae0-3ba8-9aff-95c032149e0a",
                        "entry_id": "a2aaeaaf-e27a-3309-9890-3ecb1e449504",
                        "glosses": [
                            "Zeitabschnitt, während dem jemand studiert"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec9b867b-6a07-4c8e-9606-bc8425befd1b",
                                "sense_id": "4f6b61fd-1ae0-3ba8-9aff-95c032149e0a",
                                "text": "„Zwanzig Jahre zuvor, während meiner eigenen Studienzeit, waren die Universitäten perfekt regiert worden.“"
                            },
                            {
                                "example_id": "d5a8754c-3b58-4e66-984d-f9977bef25e0",
                                "sense_id": "4f6b61fd-1ae0-3ba8-9aff-95c032149e0a",
                                "text": "„In der Wiener Studienzeit lernt Canetti naturgemäß eine ganze Reihe von Studenten kennen, die skurrilsten Typen sind darunter, mit wenigen nur pflegt er einen intensiveren Kontakt.“"
                            },
                            {
                                "example_id": "5bd1aa10-e2d1-4435-9ca4-aa8d022a9857",
                                "sense_id": "4f6b61fd-1ae0-3ba8-9aff-95c032149e0a",
                                "text": "„Man konnte selbstverständlich in der Studienzeit auch politisch und kulturell aktiv werden.“"
                            },
                            {
                                "example_id": "266fe4ad-b34f-40f8-83d3-cf3df634a97a",
                                "sense_id": "4f6b61fd-1ae0-3ba8-9aff-95c032149e0a",
                                "text": "„Aus der Pisaer Studienzeit sind Kolleghefte erhalten, geschrieben in der jugendlichen Handschrift Galileis.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
