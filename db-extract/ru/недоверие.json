                "senses": [
                    {
                        "sense_id": "95c146d3-b8d5-3343-aa20-e8f6f99e0d81",
                        "entry_id": "d14cad5c-19e8-3ceb-a809-772cf86a89e1",
                        "glosses": [
                            "mistrust (lack of trust)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5e41d086-5cc2-405f-8ae3-1aa5613ba3d9",
                                "sense_id": "95c146d3-b8d5-3343-aa20-e8f6f99e0d81",
                                "text": "— Позво́льте мне запере́ть дверь на чёрный ход и забра́ть ключ, — заговори́л Бормента́ль, пря́чась за дверь в стене́ и прикрыва́я ладо́нью лицо́ — э́то вре́менно, не из недове́рия к вам. Но кто́-нибудь придёт, а вы не вы́держите и откро́ете, а нам нельзя́ меша́ть. Мы за́няты.",
                                "translation": "\"Permit me to lock the back door and keep the key,\" said Bormental hiding in the shadow behind the door and covering his face with his hand. \"It is a temporary measure, not because we don't trust you. But someone might come and you might find it difficult to refuse them entry, and we must not be disturbed. We are busy.",
                                "english": "\"Permit me to lock the back door and keep the key,\" said Bormental hiding in the shadow behind the door and covering his face with his hand. \"It is a temporary measure, not because we don't trust you. But someone might come and you might find it difficult to refuse them entry, and we must not be disturbed. We are busy."
                            }
                        ]
                    }
                ],
