                "forms": [],
                "senses": [
                    {
                        "sense_id": "77890756-2ea3-38de-b0c4-6a62f9d49c63",
                        "entry_id": "c1210bd3-4037-3a7b-a51e-243590d8d950",
                        "glosses": [
                            "прост. известно, ясно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "42a47506-e875-4186-9ec4-990a1631f13a",
                                "sense_id": "77890756-2ea3-38de-b0c4-6a62f9d49c63",
                                "text": "Озимь ино место червь сгубил, ино место ранние морозы сгубили; перепахали было на яровое, да не знамо, уродится ли что?"
                            },
                            {
                                "example_id": "e24015b3-4af6-4c42-b2ba-8117d94900ad",
                                "sense_id": "77890756-2ea3-38de-b0c4-6a62f9d49c63",
                                "text": "Полагать надо, врут все это, потому народ по деревням знамо какой — глупый народ!"
                            }
                        ]
                    },
                    {
                        "sense_id": "32b2b4d2-d597-3d88-9c5a-c5adeecb9dd1",
                        "entry_id": "c1210bd3-4037-3a7b-a51e-243590d8d950",
                        "glosses": [
                            "прост. употребляется как вводное слово, соответствующее по значению сл.: конечно, известно"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c4a40142-fec5-42af-820c-64e00f9288a4",
                                "sense_id": "32b2b4d2-d597-3d88-9c5a-c5adeecb9dd1",
                                "text": "— Так ли всё это было, как объясняет Акинфов? — Знамо, было. — Хорошо; ну, а для чего ты отвинчивал гайку?"
                            },
                            {
                                "example_id": "63b78aaf-025b-4633-ae79-f232bf20530f",
                                "sense_id": "32b2b4d2-d597-3d88-9c5a-c5adeecb9dd1",
                                "text": "Оно бы, знамо, и мне в покое бы дожить да в тепле…"
                            }
                        ]
                    }
                ],
