                "senses": [
                    {
                        "sense_id": "d8f6306f-f464-38f6-9164-c3215d16577c",
                        "entry_id": "cd0d948d-0872-3789-ad37-81131bf91c1d",
                        "glosses": [
                            "ударами или трепаньем превратить в мочало"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "77fe1c2d-d587-47b8-b5a8-8ae94ce504fd",
                                "sense_id": "d8f6306f-f464-38f6-9164-c3215d16577c",
                                "text": "Сережа дубину размочалил совсем, новую тут же выломал."
                            }
                        ]
                    },
                    {
                        "sense_id": "9e44ec23-25fd-3d7c-8e14-e2ded0b52ab6",
                        "entry_id": "cd0d948d-0872-3789-ad37-81131bf91c1d",
                        "glosses": [
                            "перен., разг. разбить ударяя обо что-то, испортить, сломать, привести в негодность"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cd4168c6-6c81-4655-8d8b-99c37f425319",
                                "sense_id": "9e44ec23-25fd-3d7c-8e14-e2ded0b52ab6",
                                "text": "А то вот так и размочалю всю твою поганую голову!"
                            },
                            {
                                "example_id": "cdfdcc5a-d092-4e61-b1ed-7a366709d27a",
                                "sense_id": "9e44ec23-25fd-3d7c-8e14-e2ded0b52ab6",
                                "text": "― Эка бедняга! как его размочалило. Гляди-ка-сь, ― тужил, стоя, Патап Максимыч."
                            }
                        ]
                    }
                ],
