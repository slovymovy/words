                                        "entry_id": "4200e6c5-5cad-3950-bf45-0e48f4364ad7",
                                        "glosses": [
                                            "los om zichzelf opgewonden hoeveelheid wol, garen enz"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "97889b05-cb65-4d02-9958-c056b648ee6a",
                                                "sense_id": "f174c2a8-d36d-35d6-9c92-ee06fa66fbc9",
                                                "text": "Ik heb nog een kluwen rode wol, daarmee komt de trui wel af."
                                            }
                                        ]
