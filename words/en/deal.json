                        {
                            "text": "There is a good <w>deal</w> of work left to do.",
                            "target_lang_translations": {
                                "ru": "Осталось сделать еще <w>много</w> работы.",
                                "pl": "Zostało jeszcze <w>sporo</w> pracy do wykonania."
                            }
                        }
