                                                "sense_id": "bad76fdd-e17a-3678-ab01-3ce5e2c41f03",
                                                "text": "Bei permanenter Gefühlsstörung bzw. Taubheit der Finger ist ein nur kleiner operativer Eingriff erforderlich."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
