                                "target_senses": [
                                    {
                                        "sense_id": "f58ef760-dfb5-3ba0-bffb-5fb81549691e",
                                        "entry_id": "65f7a861-80d6-3c1e-86db-f84d297e24dd",
                                        "glosses": [
                                            "Endroit où l’on garde et on élève des petits animaux vivants en tentant de reconstituer leur biotope."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "993dc7e4-6295-4306-b723-025f14eca74c",
                                                "sense_id": "f58ef760-dfb5-3ba0-bffb-5fb81549691e",
                                                "text": "Le premier vivarium public ou maison pour reptiles a été créé en 1849 au Zoo de Londres."
                                            },
                                            {
                                                "example_id": "f573f1ca-345d-4a46-9030-c53eb591b852",
                                                "sense_id": "f58ef760-dfb5-3ba0-bffb-5fb81549691e",
                                                "text": "J'allai tout auprès cueillir Robert Levesque que je n'avais pas revu depuis mon retour d'A. O. F. ; l'invitai à m'accompagner au Jardin des Plantes où je voulais revoir mon caméléon. Ne parvenant pas à nourrir celui-ci, je l'avais confié au vivarium, où on le gorge de blattes, à défaut de mouches, assez rares dans cette saison."
                                            },
                                            {
                                                "example_id": "eb8520f4-40c2-4fdc-ab4b-9cb70ff15e22",
                                                "sense_id": "f58ef760-dfb5-3ba0-bffb-5fb81549691e",
                                                "text": "Le Jardin des Plantes proprement dit comporte une orangerie, des serres tropicales, un jardin d'hiver, un jardin alpin. Lui sont annexés des galeries de zoologie, botanique, géologie, minéralogie, paléontologie, une ménagerie et un vivarium."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
