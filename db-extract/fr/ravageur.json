                "forms": [
                    {
                        "form_id": "0f417aea-7633-4681-bbc3-bcbfeeae084c",
                        "entry_id": "f67f365d-d38b-3adf-8b6a-18bb778dc2df",
                        "tags": [
                            "plural"
                        ],
                        "form": "ravageurs"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "8b8a6e6e-5f36-3d3d-89fd-6ee8c8081b5c",
                        "entry_id": "f67f365d-d38b-3adf-8b6a-18bb778dc2df",
                        "glosses": [
                            "Celui qui ravage."
                        ],
                        "tags": [
                            "Didactique"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "469415b5-b08e-395d-838d-ccee86ad55f1",
                        "entry_id": "f67f365d-d38b-3adf-8b6a-18bb778dc2df",
                        "glosses": [
                            "Animal (rat, souris, insecte, etc.) qui cause des ravages aux cultures ou aux récoltes."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "35ae3314-59b3-4ef8-abeb-406d4e0fde55",
                                "sense_id": "469415b5-b08e-395d-838d-ccee86ad55f1",
                                "text": "Attention : le confinement dû à une densité trop forte favorise le développement de maladies ou de ravageurs."
                            }
                        ]
                    },
                    {
                        "sense_id": "ebf8edf3-8d5f-3f61-bcb2-f1f2fb17f6a1",
                        "entry_id": "f67f365d-d38b-3adf-8b6a-18bb778dc2df",
                        "glosses": [
                            "Chiffonnier, qui fouille les rivières pour y trouver des objets à revendre, ou des cadavres."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "8bccadf0-02cb-4928-813c-68250409b77e",
                                "sense_id": "ebf8edf3-8d5f-3f61-bcb2-f1f2fb17f6a1",
                                "text": "Le lendemain de l’accident, on avait inutilement cherché le corps du noyé […]. Des ravageurs fouillaient activement la Seine pour toucher la prime."
                            },
                            {
                                "example_id": "1105f34a-a26f-4215-9296-6e3305159b56",
                                "sense_id": "ebf8edf3-8d5f-3f61-bcb2-f1f2fb17f6a1",
                                "text": "Sans doute moins célèbre que le chiffonnier après la révolution industrielle, le ravageur reste toutefois l'un de ces métiers ambulants souvent représentés par les caricaturistes, comme par Daumier dans une lithographie de 1842 appartenant à la série Bohémiens de Paris."
                            }
                        ]
                    }
                ],
