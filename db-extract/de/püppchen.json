                    }
                ],
                "senses": [
                    {
                        "sense_id": "0a2becc8-eb09-3281-9e64-83339df46fb5",
                        "entry_id": "fd14c4fa-f656-3ad9-9ad1-151ca8e260cb",
                        "glosses": [
                            "eine kleine Puppe"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f33d9acf-bba2-43e5-bb35-31c00197ac30",
                                "sense_id": "0a2becc8-eb09-3281-9e64-83339df46fb5",
                                "text": "Als kleines Mädchen wollte sie ihr Püppchen überall hin mitnehmen."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9ec1c1e0-b449-3f47-b6f5-d92918a3508b",
                        "entry_id": "fd14c4fa-f656-3ad9-9ad1-151ca8e260cb",
                        "glosses": [
                            "hübsche, zierliche junge Frau, auch als Kosename"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "362fdab1-39e9-49fa-8d89-9ba76ec7368d",
                                "sense_id": "9ec1c1e0-b449-3f47-b6f5-d92918a3508b",
                                "text": "„Aber indem ich um diese Erlaubnis bat, arbeitete sich meine Hand, ohne auf die Genehmigung zu warten, bereits so gut vor, daß ich mich überzeugte und mehr als überzeugte, nicht nur, daß die Pensionärin ein reizendes Püppchen war, sondern daß sowohl M. M. wie sie selber ihre Freude an meiner Neugier hatten.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "27a1dc1d-4729-4e8e-92b1-6238f522b41a",
                        "source_entry_id": "fd14c4fa-f656-3ad9-9ad1-151ca8e260cb",
                        "source_sense_id": "0a2becc8-eb09-3281-9e64-83339df46fb5",
                        "source_sense_description": "eine kleine Puppe",
                        "target_lang_word": "panenka",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "panenka",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "3983aa4d-794d-301c-af88-371a8a906975",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "hračka ve tvaru postavy"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "729ccc16-3d1c-4b41-a96f-31168de9c75d",
                                                "sense_id": "3983aa4d-794d-301c-af88-371a8a906975",
                                                "text": "Panenka byla velice krásná, útlá a bílá v růžových šatečkách. Jmenovala se Edda a uměla pohybovat hlavou i očima."
                                            },
                                            {
                                                "example_id": "0b047e58-6cfa-46ca-9adc-51be56803353",
                                                "sense_id": "3983aa4d-794d-301c-af88-371a8a906975",
                                                "text": "Máte doma teenagerku, která si už dávno nehraje s panenkami? Pak vám jistě nemusíme připomínat, že udělat jí radost není tak snadné jako v době, kdy byla ještě malá holka."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2e6bd2d8-60a9-33c9-805a-0162bd174ce5",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "hezká dívka"
                                        ],
                                        "tags": [
                                            "expressively",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3ebfcca7-9838-46e8-b13c-7fff8fc89052",
                                                "sense_id": "2e6bd2d8-60a9-33c9-805a-0162bd174ce5",
                                                "text": "Kup si, panenko, krásnou stužku, budeš ještě krásnější, uvážeš-li si ji na svůj bílý krček!"
                                            },
                                            {
                                                "example_id": "18a0f5b7-ec5c-4ae9-9b8e-c13bcd408ed4",
                                                "sense_id": "2e6bd2d8-60a9-33c9-805a-0162bd174ce5",
                                                "text": "Šly panenky silnicí, potkali je myslivci dva. ― Kam, panenky, kam jdete? Která moje budete?"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "10cbb22d-e0d1-334c-ab50-e42570188f6e",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "zornice"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "13822f53-a8b5-4986-b361-ec38d2c167f3",
                                                "sense_id": "10cbb22d-e0d1-334c-ab50-e42570188f6e",
                                                "text": "Jen se mi nad tou sladěnou nádherou protočily panenky."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44a6dc1f-5f34-3e36-806d-f18bbedc964f",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "druh vepřového masa, velmi libového; polohou a kvalitou odpovídající svíčkové u skotu"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cf2b6dbe-9cef-4bfc-bf97-bc215a38d720",
                                                "sense_id": "44a6dc1f-5f34-3e36-806d-f18bbedc964f",
                                                "text": "Šál vepřové panenky nakrájíme na asi centimetr silné medailonky, místy propícháme a vložíme do marinády. Panenku necháme marinovat nejlépe přes noc."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f38fb055-4ae7-3fd7-a060-c3adcc246d7d",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "malý hydraulický zvedák"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6837304c-47fc-384e-ae27-6ed754623be6",
                                        "entry_id": "235fc8bc-30ce-394c-9990-0c03f4cf4a3e",
                                        "glosses": [
                                            "rod ptáků z čeledi astrildovití"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            },
