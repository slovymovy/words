        "fr-extract.jsonl": [
            {
                "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                "word": "soutenable",
                "pos": "adj",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "ec52e61c-e8d6-4463-8c47-aabe3af0a6a5",
                        "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "tags": [
                            "plural",
                            "masculine",
                            "feminine"
                        ],
                        "form": "soutenables"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "eb98d9d6-b4dc-3a78-a86f-473ff1e1c3cc",
                        "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "glosses": [
                            "(En parlant d’une opinion, d’une proposition, d’une cause, d’une affaire) Qui peut se soutenir par de bonnes raisons."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4e62eeb8-7ddb-47f5-987a-b66853d41825",
                                "sense_id": "eb98d9d6-b4dc-3a78-a86f-473ff1e1c3cc",
                                "text": "Cette opinion, cette proposition, cette cause est soutenable, n’est pas soutenable."
                            },
                            {
                                "example_id": "41485f36-cd84-4fc7-b2a7-5b279dad8845",
                                "sense_id": "eb98d9d6-b4dc-3a78-a86f-473ff1e1c3cc",
                                "text": "Il me vint à l’esprit, en une seconde, une vingtaine d’idées dont la plus soutenable fut que j’étais devenu fou."
                            },
                            {
                                "example_id": "ff50b6ee-c301-4495-970a-9280212bccab",
                                "sense_id": "eb98d9d6-b4dc-3a78-a86f-473ff1e1c3cc",
                                "text": "On a émis sur le personnage fameux, vulgairement nommé la Barbe-Bleue, les opinions les plus diverses, les plus étranges et les plus fausses. Il n’en est peut-être pas de moins soutenable que celle qui fait de ce gentilhomme une personnification du soleil."
                            }
                        ]
                    },
                    {
                        "sense_id": "bd11fe4e-8ecb-3323-be08-e908085b20ef",
                        "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "glosses": [
                            "Qui peut se supporter."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0e07bd69-5a4c-441b-ac9b-968ed3cf7442",
                                "sense_id": "bd11fe4e-8ecb-3323-be08-e908085b20ef",
                                "text": "Ce genre de vie, ce procédé n’est pas soutenable."
                            }
                        ]
                    },
                    {
                        "sense_id": "a7906711-db39-38f2-81d8-29b2aae75021",
                        "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "glosses": [
                            "(En parlant d'un comportement, d'une technologie,) qui respecte l'environnement."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4709e318-7cf5-4c1f-b0f1-76d6fbedffc7",
                                "sense_id": "a7906711-db39-38f2-81d8-29b2aae75021",
                                "text": "J'ai l'impression que les gens réagissent comme si \"leur\" usage de la voiture, avion etc. était raisonnable, tandis que c'est une minorité d'\"autres\" qui ont des usages déraisonnables et non soutenables."
                            }
                        ]
                    },
                    {
                        "sense_id": "a09a67ed-2793-3e39-87f2-5d9aac733427",
                        "entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "glosses": [
                            "Qui contribue à la soutenabilité par la prise en compte des dimensions sociales, économiques et environnementales du développement."
                        ],
                        "tags": [
                            "Économie"
                        ],
                        "examples": []
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1a792ffc-0f7e-49ad-ae25-0fe512dbae49",
                        "source_entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "target_lang_word": "tenable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "tenable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "12c2d67d-9f7d-329d-ab27-10f1b9742c56",
                                        "entry_id": "ecfcb367-cf19-3f63-a087-76ae3fa6858c",
                                        "glosses": [
                                            "capable of being maintained or justified; well-founded"
                                        ],
                                        "tags": [
                                            "usually"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bbe3ca41-7eaa-4f7a-99c9-0092856f61f8",
                                                "sense_id": "12c2d67d-9f7d-329d-ab27-10f1b9742c56",
                                                "text": "Back in the 1800s, many did not consider Darwin's theory of evolution to be tenable at all."
                                            },
                                            {
                                                "example_id": "dd4e34d9-ab09-44d9-976c-439dacb5f67a",
                                                "sense_id": "12c2d67d-9f7d-329d-ab27-10f1b9742c56",
                                                "text": "Modern war rests on industry, and its evolution has all but abolished the \"non-combatant,\" emptied the old idea of \"innocent\" trade of meaning, and made even of neutrality a barely tenable status."
                                            },
                                            {
                                                "example_id": "b25beb77-37aa-43ee-84d0-fcef6ac0c04f",
                                                "sense_id": "12c2d67d-9f7d-329d-ab27-10f1b9742c56",
                                                "text": "Fitting into a tenable social position among other people requires not only the ability to simultaneously assess the nature of relationships with each person individually but also the ability to comprehend the indirect relational consequences of actions for connected relationships."
                                            },
                                            {
                                                "example_id": "83c2f904-57c1-4996-8140-5e11798c1171",
                                                "sense_id": "12c2d67d-9f7d-329d-ab27-10f1b9742c56",
                                                "text": "In short, it is not a tenable position in our tight-knit community, or in a pluralistic democracy, to ask for a kinder space and to be unkind towards others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c2484181-c082-30e1-a192-63847809850c",
                                        "entry_id": "ecfcb367-cf19-3f63-a087-76ae3fa6858c",
                                        "glosses": [
                                            "Capable of being defended against assault or attack; defensible"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "abfe4a0f-ba7b-4b4d-ad07-17300ea7d434",
                                                "sense_id": "c2484181-c082-30e1-a192-63847809850c",
                                                "text": "The island of Melos undoubtedly fell within his general conceptions of tenable empire for Athens."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "5a1ccb6b-796e-37e5-8f5e-f01c677ccbe0",
                                        "entry_id": "ecfcb367-cf19-3f63-a087-76ae3fa6858c",
                                        "glosses": [
                                            "Fit for habitation, similar, or related use."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "dc117afc-39ae-4a8e-b5f1-17ef972f7934",
                                                "sense_id": "5a1ccb6b-796e-37e5-8f5e-f01c677ccbe0",
                                                "text": "In February, 1679, he was admitted \"a planter\" of the town and a home lot was granted him \"on condition that it should have a tenable house built upon it within two years."
                                            },
                                            {
                                                "example_id": "625a05bb-7b78-4203-81f8-d67a69872414",
                                                "sense_id": "5a1ccb6b-796e-37e5-8f5e-f01c677ccbe0",
                                                "text": "They made a day of straightening the leaning stable on its foundations and staying its framework, so that with new roof and sheathing, it would be a tenable building for many years to come."
                                            },
                                            {
                                                "example_id": "cde5493d-7d63-4b5b-aa96-097217ebb91e",
                                                "sense_id": "5a1ccb6b-796e-37e5-8f5e-f01c677ccbe0",
                                                "text": "Protecting or assisting occupant evacuation and safety by maintaining tenable building spaces and exit paths"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "95c65eb5-e79b-41b6-a963-6ca45125043b",
                        "source_entry_id": "302936c3-9c72-3c66-9a69-86ae498a3225",
                        "target_lang_word": "sustainable",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "sustainable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "27b573ea-e16f-3593-92d2-c0450c15336e",
                                        "entry_id": "bfb14c4d-5d67-3e9f-a251-1cc1a377fa87",
                                        "glosses": [
                                            "Able to be sustained."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                        "entry_id": "bfb14c4d-5d67-3e9f-a251-1cc1a377fa87",
                                        "glosses": [
                                            "Able to be produced or sustained for an indefinite period without damaging the environment, or without depleting a resource; renewable."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "46ae9268-7d43-43ac-9a78-fd557b39d1d4",
                                                "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                                "text": "sustainable economy"
                                            },
                                            {
                                                "example_id": "40eaf799-9df7-40da-a4c1-d5554bef36bc",
                                                "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                                "text": "In addition to the resources listed in the organic and local food sections earlier, a good source of sustainable meat is Heritage Foods USA (heritagefoodsusa.com)."
                                            },
                                            {
                                                "example_id": "784acd32-393d-4abf-a978-42f65c3e1424",
                                                "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                                "text": "Some critics have asserted that sustainable food is \"elitist\"; that it's too expensive and not widely available."
                                            },
                                            {
                                                "example_id": "810d7d06-e97d-4d7c-b899-3fa65520da29",
                                                "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                                "text": "A city on a hill—or many cities on hills—surrounded by unbroken vistas of beautiful countryside; small, thriving, family-run farms growing organic, seasonal, and sustainable fruits and vegetables specific to the region."
                                            },
                                            {
                                                "example_id": "e0b0228e-839b-48af-ac2a-aad544de195b",
                                                "sense_id": "abc05903-e21c-3ad6-8d5f-ebf0561266a0",
                                                "text": "Right now, rich nations devour 28 tonnes of material per person per year – including everything from fish to forests, plastics to metals. That’s four times more than ecologists say is sustainable."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sustainable",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4847ee98-aea3-3fed-bedf-738618806972",
                                        "entry_id": "a0929996-b71d-33c2-8b1e-cc6f13ef6509",
                                        "glosses": [
                                            "A renewable energy source."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f4c8f620-e935-498c-83fe-efc1837dad25",
                                                "sense_id": "4847ee98-aea3-3fed-bedf-738618806972",
                                                "text": "It has only been in the last 20 years that the long-term trend away from fossil fuels and toward nuclear energy and sustainables has intensified."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
