                        ]
                    },
                    {
                        "translation_id": "dbeec8e7-fb93-41d4-872f-3d087e5733a1",
                        "source_entry_id": "fad70d5b-7ef0-3bd4-b5f1-52e3861adabb",
                        "source_sense_id": "8dd27a54-b5c9-3b23-88cd-e5130443faa0",
                        "source_sense_description": "Halbinsel zwischen Schwarzem Meer und Mittelmeer",
                        "target_lang_word": "Asie Mineure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Asie Mineure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b9a00203-2c85-3d38-889c-b5b558e25f07",
                                        "entry_id": "49fb75be-2d49-31ad-8937-6a5e7145ded4",
                                        "glosses": [
                                            "Anatolie, correspondant à une grande partie de la Turquie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b5cb3368-8b9b-4521-b388-537e2a47077c",
                                                "sense_id": "b9a00203-2c85-3d38-889c-b5b558e25f07",
                                                "text": "La chèvre angora habite l’Angora, villayet d’Anatolie en Asie Mineure."
                                            },
                                            {
                                                "example_id": "f81f0148-2494-428f-8543-ec60b73f314a",
                                                "sense_id": "b9a00203-2c85-3d38-889c-b5b558e25f07",
                                                "text": "C’est à partir de la Méditerranée que les Grecs entreprirent de coloniser la côte ouest de l’Asie Mineure, mille ans avant l’ère chrétienne, ou s’établir sur la côte de Cyrénaïque et le delta du Nil, en Sicile et en Italie du Sud (Grande-Grèce)."
                                            },
                                            {
                                                "example_id": "0065fc63-97b7-4b1a-ae12-a8c0f68c9e4a",
                                                "sense_id": "b9a00203-2c85-3d38-889c-b5b558e25f07",
                                                "text": "À la suite de la Judée, l'Asie Mineure est la première région évangélisée."
                                            },
                                            {
                                                "example_id": "4d409234-f293-4ae1-b545-7f21f1b40f84",
                                                "sense_id": "b9a00203-2c85-3d38-889c-b5b558e25f07",
                                                "text": "Depuis, j'ai vérifié que le vent est un grand personnage de la géographie, et que l'on s'expose à ne rien comprendre à l'histoire si l'on oublie les brises, les typhons, les mistrals et les foehns, ou bien ce vent grec qui emporta par étourderie, voilà près de trois mille ans, quelques marins de Phocée en Asie Mineure, et qui les jeta en France afin qu'ils créent la ville de Marseille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
