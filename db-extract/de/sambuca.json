                        "glosses": [
                            "in der Regel farbloser, klarer Likör mit 38 bis 42 Volumenprozent Alkohol"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "50404ffe-66b2-4703-a3ae-052e5e81d92b",
                                "sense_id": "8581e890-1280-3a89-a3ea-bc9ffd7c54cb",
                                "text": "„Er reicht mir ein Shotglas und beobachtet aufmerksam, wie ich es austrinke (billiger Sambuca); dann streckt er mir die Hand hin, damit ich einschlage, als ich fertig bin.“"
                            }
