                            {
                                "example_id": "dd73640f-a566-4ee7-b3ea-fe95d759e796",
                                "sense_id": "0a80971e-df57-3f7c-89a0-03915e9e6f0e",
                                "text": "Das Programm wurde in Forth geschrieben."
                            },
                            {
                                "example_id": "03ea0aa3-17b2-4d30-b0f8-71a6e7c1b61c",
                                "sense_id": "0a80971e-df57-3f7c-89a0-03915e9e6f0e",
