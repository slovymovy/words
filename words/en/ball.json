                {
                    "sense_id": "5bded8bb-876d-3413-85bd-5109f4df789d",
                    "sense_definition": "In baseball, a pitch that is not swung at by the batter and is outside the strike zone.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "baseball_terms",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The umpire called a <w>ball</w> because the pitch was too high.",
                            "target_lang_translations": {
                                "ru": "Судья объявил <w>бол</w>, потому что подача была слишком высокой.",
                                "zh": "因为那一球太高了，裁判判了一个<w>坏球</w>。"
                            }
                        },
                        {
                            "text": "After three <w>balls</w> and two strikes, the tension in the stadium was high.",
                            "target_lang_translations": {
                                "ru": "После трех <w>болов</w> и двух страйков напряжение на стадионе возросло.",
                                "zh": "三<w>坏球</w>两好球之后，球场里的气氛变得十分紧张。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "three balls",
                        "ball four"
                    ],
                    "target_lang_definitions": {
                        "ru": "В бейсболе: подача, которую отбивающий не пытался отбить и которая прошла вне зоны страйка.",
                        "zh": "棒球中，打者没有挥棒且球投在好球区之外的一次投球。"
                    },
