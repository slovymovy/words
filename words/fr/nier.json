            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c7fea28a-8231-33d3-9843-e07eea40f471",
                    "sense_definition": "Dire qu'une chose n'est pas vraie ou soutenir qu'un fait n'existe pas.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "contestation",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "L'accusé s'obstine à <w>nier</w> les faits malgré les nombreuses preuves présentées."
                        },
                        {
                            "text": "Il est totalement impossible de <w>nier</w> l'évidence dans cette situation critique."
                        }
                    ],
                    "common_phrases": [
                        "nier l'évidence",
                        "nier les faits",
                        "nier en bloc"
                    ]
                },
                {
                    "sense_id": "06f87c5e-9a46-319b-89e8-c8e56938fe75",
                    "sense_definition": "Refuser d'admettre, de reconnaître ou d'accorder quelque chose à quelqu'un.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "refus",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "On ne peut pas lui <w>nier</w> un véritable talent pour la musique classique."
                        },
                        {
                            "text": "Cette loi injuste visait à <w>nier</w> aux citoyens leurs libertés fondamentales."
                        }
                    ],
                    "common_phrases": [
                        "nier un droit",
                        "nier une dette"
                    ]
                },
                {
                    "sense_id": "ec504a07-8524-3db2-81b7-ee1ff1d7f56e",
                    "sense_definition": "Rejeter ou contester la validité logique d'une idée ou d'une proposition intellectuelle.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "theorie",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Le philosophe <w>nie</w> la proposition selon laquelle l'esprit serait entièrement séparé du corps."
                        },
                        {
                            "text": "Les scientifiques continuent de <w>nier</w> cette hypothèse théorique faute de données vérifiables."
                        }
                    ],
                    "common_phrases": [
                        "nier une proposition",
                        "nier une hypothèse"
                    ]
                },
                {
                    "sense_id": "53385889-d7e9-3f93-90c2-8737743f6158",
                    "sense_definition": "S'opposer à une force, une autorité ou une convention que l'on désapprouve et dont on refuse l'existence légitime.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "opposition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Cette révolte populaire <w>nie</w> le pouvoir répressif établi depuis des générations."
                        },
                        {
                            "text": "Son manifeste artistique <w>nie</w> ouvertement les structures bourgeoises traditionnelles."
                        }
                    ],
                    "common_phrases": [
                        "nier l'autorité"
                    ]
                }
            ]
        }
