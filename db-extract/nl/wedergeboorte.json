                "translations": [
                    {
                        "translation_id": "7209452b-d37e-420b-bd82-f16fdae1e3d4",
                        "source_entry_id": "9703f03a-8bdc-3ab8-8a1e-916dfa2a25c3",
                        "source_sense_id": "9b73b40d-d5f5-3859-95f2-be507960f49c",
                        "target_lang_word": "Wiedergeburt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Wiedergeburt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "der Anfang eines neuen Lebens ein und desselben Individuums nach dem Tod als ein anderes Lebewesen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "22641106-7e15-4fe2-9f19-24b1e4499bbf",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "Im Buddhismus glaubt man an Wiedergeburt."
                                            },
                                            {
                                                "example_id": "070051ae-8bb6-4ced-b494-25e02612960b",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„In den meisten Fassungen der Loreleysage haben die Dichter Loreleys Wiedergeburt einfach übergangen, wahrscheinlich weil das Thema Reinkarnation nicht in das christliche Weltbild der damaligen Zeit paßte.“"
                                            },
                                            {
                                                "example_id": "641fd7e5-26f3-477f-895e-3c320d91b8f2",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Ich gebe allerdings zu, daß ich mich, um das schöne Vorrecht der Wiedergeburt zu haben, auch damit zufrieden geben würde; besonders heute wäre ich einverstanden, nicht nur als Frau, sondern sogar als irgendein stumpfes Geschöpf wiedergeboren zu werden, das aber nur, wenn ich mein Gedächtnis behielte, denn ohne das wäre ich nicht ich selbst.“"
                                            },
                                            {
                                                "example_id": "6cfb41a7-40cc-4403-88e0-c1eafde8c420",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Denn dieser Käfer wurde im alten Ägypten als Bringer der Wiedergeburt und des Glücks verehrt.“"
                                            },
                                            {
                                                "example_id": "595f2a70-4e1a-4223-b83f-a6a1a0f4573b",
                                                "sense_id": "fe07f77f-7714-3e0b-9df2-a3c54770ee5e",
                                                "text": "„Die Pythagoräer waren zudem von der Möglichkeit einer Wiedergeburt in tierischer Gestalt überzeugt und deshalb Vegetarier.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "erneute Popularität oder Verwendung eines Systems, einer Sache oder Idee"
                                        ],
                                        "tags": [
                                            "figurative"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "3a50d052-c858-41b1-8795-ce187a6d095e",
                                                "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                                "text": "In Deutschland feiert man zurzeit die Wiedergeburt des Protests."
                                            },
                                            {
                                                "example_id": "6710ce24-54b4-441c-8909-02648adfdb34",
                                                "sense_id": "8436dba0-877a-396d-8094-5125f5012d7a",
                                                "text": "„Damals hielten sich die kaiserlichen Landsknechte, darunter auch solche aus deutschen Ländern, für ihren ausgebliebenen Sold an den Reichtümern der Ewigen Stadt schadlos, die gerade ihre Wiedergeburt aus den antiken Ruinen erlebte.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "2b954114-a996-35ba-8ede-d47619492066",
                                        "entry_id": "8f815b01-95c5-35fc-9d3c-f138beb628fb",
                                        "glosses": [
                                            "Eintritt in einen spirituellen/religiösen Zustand des Daseins durch einen Akt göttlicher Gnade/Berufung, als Gegensatz zum vorhergehenden Lebensabschnitt"
                                        ],
                                        "tags": [
                                            "figurative",
                                            "no-plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "adb09944-d5bc-4312-9b0b-9620da046855",
                                                "sense_id": "2b954114-a996-35ba-8ede-d47619492066",
                                                "text": "„Die Taufe ist daher ein wirksames Zeichen der Wiedergeburt, um innerlich erneut zu leben.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e2c2f217-c6ec-4a30-9163-a00618c68824",
                        "source_entry_id": "9703f03a-8bdc-3ab8-8a1e-916dfa2a25c3",
                        "source_sense_id": "9b73b40d-d5f5-3859-95f2-be507960f49c",
                        "target_lang_word": "rebirth",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rebirth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "9dc71bb4-22d4-31ef-8340-c8c164f0de59",
                                        "entry_id": "7042de61-c8cf-3644-9c86-d0cb19a8ae0d",
                                        "glosses": [
                                            "Reincarnation; new birth subsequent to one's first."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1a6f634d-b763-48e2-bac3-148af471f562",
                                                "sense_id": "9dc71bb4-22d4-31ef-8340-c8c164f0de59",
                                                "text": "A theistic version of the above doctrine of transmigratory existence is presented best in the Bhagavadgitā which compares the rebirth of the soul in another body to changing of clothes, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "979c17ad-8677-3ac4-8e91-c84f732fd6f4",
                                        "entry_id": "7042de61-c8cf-3644-9c86-d0cb19a8ae0d",
                                        "glosses": [
                                            "Revival, reinvigoration."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4a033788-6e56-4486-afd1-c44315abdee5",
                                                "sense_id": "979c17ad-8677-3ac4-8e91-c84f732fd6f4",
                                                "text": "And it was the spread of modern nationalism in the aftermath of Napoleon's defeat that mainly accounted for the nineteenth-century rebirth of the “Handelian” oratorio in Germany, where it had never thrived before, […]"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a3c735ac-57c3-3b63-99c1-c099b5aabeef",
                                        "entry_id": "7042de61-c8cf-3644-9c86-d0cb19a8ae0d",
                                        "glosses": [
                                            "Spiritual renewal."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "291d943b-fa31-449d-907f-d28fe01d8240",
                                                "sense_id": "a3c735ac-57c3-3b63-99c1-c099b5aabeef",
                                                "text": "The rebirth of Baptism affirms that Christ the healer shares our life."
                                            },
                                            {
                                                "example_id": "a649af2b-d773-431d-8b62-d1a877ead9bb",
                                                "sense_id": "a3c735ac-57c3-3b63-99c1-c099b5aabeef",
                                                "text": "Rather, in 1 Pet 3:21, those who have experienced rebirth in Christ, presumably through baptism, are promised an eschatological reward."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "rebirth",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "880dce13-c94f-314a-a9af-df00d906d307",
                                        "entry_id": "3b877546-b34c-3930-9a0e-27b04edf2b65",
                                        "glosses": [
                                            "To cause to be born again, spiritually renewed, or revived."
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "362374d3-9b24-4e2d-a4b5-061681cd1e06",
                                                "sense_id": "880dce13-c94f-314a-a9af-df00d906d307",
                                                "text": "D’Alessandro fashioned it upon a book he wrote, the lost stories he rebirthed and cherished."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "0766b04a-af56-3666-9854-404c79475c1a",
                                        "entry_id": "3b877546-b34c-3930-9a0e-27b04edf2b65",
                                        "glosses": [
                                            "To be born again, spiritually renewed, or revived."
                                        ],
                                        "tags": [
                                            "intransitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f04899b-1ef3-43e0-b639-1373fdca353b",
                                                "sense_id": "0766b04a-af56-3666-9854-404c79475c1a",
                                                "text": "As I rebirthed and did the LRT, I began to love and accept myself as a woman."
                                            },
                                            {
                                                "example_id": "b8e99d39-a6be-4ca4-b231-56884ef35c27",
                                                "sense_id": "0766b04a-af56-3666-9854-404c79475c1a",
                                                "text": "“And how ’bout me?” / “Two life sentences, probably.” / “The one life,” says Johnny, laughing, “isn’t enough? They don’t satisfy one, they want two? Maybe when I rebirth again, I owe them another next life.”"
                                            },
                                            {
                                                "example_id": "ea4c4bb9-c8b6-45c7-8b87-e0e4e1b7dd73",
                                                "sense_id": "0766b04a-af56-3666-9854-404c79475c1a",
                                                "text": "I rebirthed to let go of any belief systems of lack and limitation that might be blocking my success."
                                            },
                                            {
                                                "example_id": "6a13eeb9-db19-420d-9414-9c50c4bee87e",
                                                "sense_id": "0766b04a-af56-3666-9854-404c79475c1a",
                                                "text": "“When I rebirth, you will eat of me. But not overmuch, I pray. The black spruce of Three Streams, echoing the sweet tongue of Betula Carla, be yet to forget. And forgive. Overmuch. Over so little. Over and over and over.”"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "deb39292-d3b4-4698-9585-8c06fe387ff1",
                        "source_entry_id": "9703f03a-8bdc-3ab8-8a1e-916dfa2a25c3",
                        "source_sense_id": "9b73b40d-d5f5-3859-95f2-be507960f49c",
