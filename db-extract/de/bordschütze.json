                        "sense_id": "0ed1d789-87cd-370d-a3e4-75b4fe36f998",
                        "entry_id": "568fa299-c79d-36e7-a694-83f5998eedbd",
                        "glosses": [
                            "Schütze, der mit einem Maschinengewehr oder einer Maschinenkanone aus dem Flugzeug feuert"
                        ],
                        "tags": [
                            "Luftwaffe"
                        ],
                        "examples": [
                            {
                                "example_id": "c0a41411-7613-44ab-ade7-67ba99d23e15",
                                "sense_id": "0ed1d789-87cd-370d-a3e4-75b4fe36f998",
                                "text": "„Der gelernte Mechaniker Richard Schuh, 1920 in Remmingsheim bei Tübingen geboren, hatte im Krieg als Bordschütze bei der Luftwaffe gedient.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
