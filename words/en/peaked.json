                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Inflation <w>peaked</w> last winter and has been falling steadily ever since.",
                            "target_lang_translations": {
                                "tr": "Enflasyon geçen kış <w>zirve yaptı</w> ve o zamandan beri istikrarlı bir şekilde düşüyor."
