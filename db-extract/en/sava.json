                                                "example_id": "c76ac378-cd2b-4a78-8d63-206a6b7be4da",
                                                "sense_id": "58cc9bda-f06b-3e43-913b-571b12facafe",
                                                "text": "Die Save hat 207 km des Flusslaufs durch Serbien.“"
