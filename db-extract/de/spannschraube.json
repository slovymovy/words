                "senses": [
                    {
                        "sense_id": "3fd69197-ee84-35fb-90af-2721a94cea0d",
                        "entry_id": "1598b811-7a0e-3a60-b90b-795572a4d528",
                        "glosses": [
                            "Gewindehülse mit zwei gegensinnigen Innengewinden und entsprechenden Schrauben zum dauerhaften Spannen von Drähten und Seilen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ec04e7f3-92ce-433f-90c3-0899c6d36bd6",
                                "sense_id": "3fd69197-ee84-35fb-90af-2721a94cea0d",
                                "text": "Mit Seilen und Spannschrauben sichere ich die Ladung gegen ein Verrutschen."
                            },
                            {
                                "example_id": "d295b959-10bf-4fe5-b25f-d8639b3ef25e",
                                "sense_id": "3fd69197-ee84-35fb-90af-2721a94cea0d",
                                "text": "„Spannschrauben oder Wantenspanner - wie Spannschlösser oftmals auch genannt werden - dienen in den meisten Fällen zum straffen Verspannen oder Abspannen von Seilen. Mit Ihnen werden Drahtseile verspannt (z. B. zum Sichern von Schornsteinen oder Masten), Sonnensegel gespannt oder auch Verstrebungen von Lager-Regalen auf Spannung gebracht.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
