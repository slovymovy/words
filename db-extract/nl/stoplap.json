                        "sense_id": "91ac6142-93ff-305e-bf1b-6cf488fe99f6",
                        "entry_id": "c50ce776-33b0-3c04-b97a-c26987b006af",
                        "glosses": [
                            "oefenlapje om te leren stoppen"
