        "ru-extract.jsonl": [
            {
                "entry_id": "210de651-68e4-3b71-9411-4fa1cd58a58c",
                "word": "Муратов",
                "pos": "name",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "59d97a82-a08a-3d6d-9e63-9367b8f9e358",
                        "entry_id": "210de651-68e4-3b71-9411-4fa1cd58a58c",
                        "glosses": [
                            "русская фамилия"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c304c499-614f-4179-a6c8-4dc7858daf52",
                                "sense_id": "59d97a82-a08a-3d6d-9e63-9367b8f9e358",
                                "text": "Дмитрий Муратов получил Нобелевскую премию мира. Он разделит её с филиппинской журналисткой Марией Рессой, которая возглавляет редакцию оппозиционного сайта Rappler."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "412c560c-4e39-4f61-aec7-1baed0f0bb9b",
                        "source_entry_id": "210de651-68e4-3b71-9411-4fa1cd58a58c",
                        "source_sense_id": "59d97a82-a08a-3d6d-9e63-9367b8f9e358",
                        "target_lang_word": "Muratov",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Muratov",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "b11c8440-ecb1-3f6d-bcc1-3a25d2e7a90a",
                                        "entry_id": "f2691168-b356-319b-8800-be6ddf2e18c2",
                                        "glosses": [
                                            "A surname from Russian."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "17e507dd-0bf5-4bce-9bf9-1713772de477",
                                                "sense_id": "b11c8440-ecb1-3f6d-bcc1-3a25d2e7a90a",
                                                "text": "Maria Ressa, the chief executive and cofounder of Rappler, and Dmitry Muratov, the editor-in-chief of Novaya Gazeta, were named as this year’s laureates by Berit Reiss-Andersen, the chair of the Norwegian Nobel committee."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
