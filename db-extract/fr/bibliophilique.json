                        "glosses": [
                            "Relatif à la bibliophilie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "37e712b7-0b0a-4425-b9be-46cd6f2aa084",
                                "sense_id": "25863abd-c7e4-3dd6-9cdb-07e54a2108b0",
                                "text": "Un livre ne garde sa valeur bibliophilique que s’il comporte ses couvertures originales."
                            },
                            {
                                "example_id": "e2aef9b4-e8f9-4d65-b5e0-523d16c2d3b1",
                                "sense_id": "25863abd-c7e4-3dd6-9cdb-07e54a2108b0",
                                "text": "Ma machine à parcourir le temps était ce petit Suétone aux pages maculées, que, sans respect pour sa valeur bibliophilique, je mettais dans une de mes poches, chaque fois que je partais à l’Aventure."
                            }
                        ]
                    }
