                ],
                "senses": [
                    {
                        "sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "glosses": [
                            "разг. тот, кто склонен добиваться своих целей при помощи разного рода ухищрений, комбинаций"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0d02d7f1-b225-493f-a697-0757e5840581",
                                "sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                                "text": "Остальные ходы, правда, рисовались в совершенном уже тумане, но это нисколько не смущало великого комбинатора."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "5c30de1d-3164-4035-b1ee-e74e94061284",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "schemer",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "schemer",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "db3b0865-f3b9-3562-a875-b59ab62c7aa2",
                                        "entry_id": "a8d62822-9c1b-39a3-b135-e2979e1aaceb",
                                        "glosses": [
                                            "One who plots or schemes, who formulates devious plans."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "15dfa7bb-4663-4aaf-ab49-4b5f857484e4",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "contriver",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "contriver",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "8bd4f52e-fdef-3963-a3a5-ddcc4882280c",
                                        "entry_id": "c4168526-18b8-38fe-93a2-67244c9eb9b5",
                                        "glosses": [
                                            "A person who contrives."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "03eb7c09-926a-46d3-b89c-d2794ec0d99f",
                                                "sense_id": "8bd4f52e-fdef-3963-a3a5-ddcc4882280c",
                                                "text": "I’ll tell thee, Charles, it is the stubbornest young fellow of France; full of ambition, an envious emulator of every man’s good parts, a secret and villainous contriver against me his natural brother."
                                            },
                                            {
                                                "example_id": "1770becb-e837-4fdb-938f-87637d124ab2",
                                                "sense_id": "8bd4f52e-fdef-3963-a3a5-ddcc4882280c",
                                                "text": "[…] those desctructive Machines, whereof he said, some evil Genius, Enemy to Mankind, must have been the first Contriver."
                                            },
                                            {
                                                "example_id": "81e157ab-2792-41de-99fd-fbb51711a7d0",
                                                "sense_id": "8bd4f52e-fdef-3963-a3a5-ddcc4882280c",
                                                "text": "A heroine returning, at the close of her career, to her native village, in all the triumph of recovered reputation, and all the dignity of a countess […] is an event on which the pen of the contriver may well delight to dwell;"
                                            },
                                            {
                                                "example_id": "144d075c-88d4-4655-a064-9bf36e9f9ef6",
                                                "sense_id": "8bd4f52e-fdef-3963-a3a5-ddcc4882280c",
                                                "text": "They had toured the world together with their Soirée of Illusions, combining his art as a public performer with her skill as a technician, a contriver of magical apparatus, and her artistic taste, which was far beyond his own."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "880e3b3c-3511-4298-8c7d-0f1f02804d6c",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "combinador",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "762c05d9-be11-45de-8c16-af2df6cd59ad",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "chanchullero",
                        "target_lang_code": "es",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "51accbb3-dc47-4584-8f14-61ffcf54e8c0",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "Macher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Macher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                        "entry_id": "bc76cfe3-39e4-3346-b9a3-b23c827fee2b",
                                        "glosses": [
                                            "Person, die handelt/aktiv ist/etwas herstellt; Akteur, Handelnder"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9be500eb-e760-497c-b2b3-8804c5aeb832",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Pragmatische Macher waren nun am Drücker und sorgten für blühende Landschaften.“"
                                            },
                                            {
                                                "example_id": "50b7f46e-9387-41ff-b342-f5fc74f5f246",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Im Deutschen ist ein Macher ein Machertyp, der immerzu macht und macht.“"
                                            },
                                            {
                                                "example_id": "7152a88a-86ce-4950-b84d-fb7a759caf69",
                                                "sense_id": "4536bd48-6064-3504-8f1f-8e7fb7c9d25d",
                                                "text": "„Um die Ergebnisse unseres Tuns wäre es besser bestellt, wenn die Denker öfter aus sich heraus und die Macher gelegentlich in sich gehen würden.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "f9c3f536-0de1-3fc6-b78a-33a8792b4b4b",
                                        "entry_id": "bc76cfe3-39e4-3346-b9a3-b23c827fee2b",
                                        "glosses": [
                                            "ein Anstifter, der etwas anstiftet"
                                        ],
                                        "tags": [
                                            "derogatory"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "7bab7711-c472-4782-837d-ed6b83cbc681",
                                                "sense_id": "f9c3f536-0de1-3fc6-b78a-33a8792b4b4b",
                                                "text": "Die eigentlichen Macher blieben lange Zeit im Hintergrund."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "ea95626d-359a-44c5-954d-188873b017e8",
                        "source_entry_id": "9a7f4a38-636d-3226-bf4f-cc0909e3c540",
                        "source_sense_id": "d2bad7ae-6073-3d6d-bb34-0deb03db41e6",
                        "target_lang_word": "débrouillard",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "débrouillard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "741ba5c3-c5b4-32a5-8008-a08477980e2a",
                                        "entry_id": "dbbae61e-2993-3423-a5e9-a95f9b156f4f",
                                        "glosses": [
                                            "Qui est habile à se débrouiller."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "066d7109-95f6-4c21-92b1-e45716f23ddc",
                                                "sense_id": "741ba5c3-c5b4-32a5-8008-a08477980e2a",
                                                "text": "Ce garçon est très débrouillard : il saura se tirer d’affaire."
                                            },
                                            {
                                                "example_id": "4a675bf0-7076-4c59-912d-aac135258d46",
                                                "sense_id": "741ba5c3-c5b4-32a5-8008-a08477980e2a",
                                                "text": "— Garçon, je dis, dans notre confrérie, d’habitude, on passe pour assez débrouillard, mais, toi, alors, tu es le président de la république des débrouillards ; à toi le pompon !"
                                            },
                                            {
                                                "example_id": "53fdcf83-a592-494e-98e1-68f1458eb9a9",
                                                "sense_id": "741ba5c3-c5b4-32a5-8008-a08477980e2a",
                                                "text": "Mais je crois que nous voici déjà près de chez vous, miss Poirson. Ce taximan est un débrouillard."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "débrouillard",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f32779e7-a560-3b5d-8bdb-b30dc606ba21",
                                        "entry_id": "802b9be3-a8d9-31a5-9cd4-ce89b31c3eab",
                                        "glosses": [
                                            "Personne habile à se débrouiller, qui fait preuve de débrouillardise."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d0654607-43e7-48f2-b20f-f2e94ccc791c",
                                                "sense_id": "f32779e7-a560-3b5d-8bdb-b30dc606ba21",
                                                "text": "On découvrit alors la raison pour laquelle il était resté si bêtement en panne, lui, le débrouillard, quand la ficelle avait cassé."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
                ],
                "word_linkages": [
