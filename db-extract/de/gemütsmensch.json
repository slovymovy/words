                "senses": [
                    {
                        "sense_id": "cf9d0d9d-951b-3dd6-afa4-ac48badc0f69",
                        "entry_id": "b7ee1603-7cb9-3f08-84e8-e53b9b02494b",
                        "glosses": [
                            "gemütlicher, gutmütiger Mensch"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aefbcc83-4037-41fc-a9f4-b8d490a599c0",
                                "sense_id": "cf9d0d9d-951b-3dd6-afa4-ac48badc0f69",
                                "text": "„Rembrandt war gewiß kein Gelehrter, aber auch kein einfältiger Gemütsmensch.“"
                            },
                            {
                                "example_id": "70b86a2f-c23a-4cda-80f0-89501594aa85",
                                "sense_id": "cf9d0d9d-951b-3dd6-afa4-ac48badc0f69",
                                "text": "„In dieser turbulenten Geschichte soll das Schlusswort ein Gemütsmensch haben: Gerhard Polt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "0b4786e1-c351-4501-b45a-12eba0e5185a",
                        "source_entry_id": "b7ee1603-7cb9-3f08-84e8-e53b9b02494b",
                        "source_sense_id": "cf9d0d9d-951b-3dd6-afa4-ac48badc0f69",
