                    }
                ],
                "senses": [
                    {
                        "sense_id": "659526a2-7358-3030-a45a-0a365fe24792",
                        "entry_id": "cb6c5756-3c26-3341-abb0-c0faecad0313",
                        "glosses": [
                            "матем. функционал, отражающий линейную часть приращения функции; главная часть приращения функции, пропорциональная приращению независимой переменной"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2daacf4-246b-4de8-a29f-768e363a7a9d",
                                "sense_id": "659526a2-7358-3030-a45a-0a365fe24792",
                                "text": "Если в дифференциале полином имеет коэффициентами целые числа и неразложим на линейные множители при помощи одних квадратных радикалов, то этот дифференциал не может быть интегрирован в конечном виде, каково бы ни было значение А, коль скоро в непрерывной дроби, происходящей от разложения радикала ни один из 2N-1 первых знаменателей не будет второй степени, причем N означает число целых решений уравнений."
                            }
                        ]
                    },
                    {
                        "sense_id": "ddd69a35-cce8-39dc-b10b-24f6f10b5275",
                        "entry_id": "cb6c5756-3c26-3341-abb0-c0faecad0313",
                        "glosses": [
                            "техн. автомоб. устройство, передающее вращение на два вала (в автомобиле — на ведущие колёса), но позволяющее им вращаться несинхронно, с различной скоростью"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ed83aeb5-549b-44d4-ac02-9cb08f14609d",
                                "sense_id": "ddd69a35-cce8-39dc-b10b-24f6f10b5275",
                                "text": "Симметричный межколесный дифференциал в случае малого внутреннего трения распределяет крутящий момент поровну между полуосями."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "19a043e9-efd8-435f-aeff-aab75616c25c",
                        "source_entry_id": "cb6c5756-3c26-3341-abb0-c0faecad0313",
                        "source_sense_description": "функционал",
                        "target_lang_word": "differential",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "differential",
