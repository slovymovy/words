{
    "word_family": [
        "folder",
        "folding",
        "unfolded",
        "unfolding"
    ],
    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "4f8afd73-30f3-385c-8947-78b3474ddf96",
                    "sense_definition": "To open something that was previously folded or closed up.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She carefully began to <w>unfold</w> the map to find the correct route to the hotel.",
                            "target_lang_translations": {
                                "ru": "Она осторожно начала <w>разворачивать</w> карту, чтобы найти нужный маршрут к отелю.",
                                "zh": "她小心地开始<w>展开</w>地图，以便找到去酒店的正确路线。"
                            }
                        },
                        {
                            "text": "Please <w>unfold</w> a tablecloth and place it over the dining table before the guests arrive.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, <w>разложите</w> скатерть на обеденном столе до прихода гостей.",
                                "zh": "请在客人到来前<w>铺开</w>桌布，把它铺到餐桌上。"
                            }
                        }
                    ],
                    "synonyms": [
                        "uncover"
                    ],
                    "antonyms": [
                        "fold"
                    ],
                    "common_phrases": [
                        "unfold a map",
                        "unfold a tablecloth"
                    ],
                    "target_lang_definitions": {
                        "ru": "Открыть что-либо, что ранее было сложено или закрыто.",
                        "zh": "把先前折叠着或收拢着的东西打开、展开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развернуть",
                                "target_lang_sense_clarification": "полностью раскрыть сложенное"
                            },
                            {
                                "target_lang_word": "разворачивать",
                                "target_lang_sense_clarification": "процесс раскрытия сложенного"
                            },
                            {
                                "target_lang_word": "разложить",
                                "target_lang_sense_clarification": "расправить на поверхности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "把折着或收着的东西打开"
                            },
                            {
                                "target_lang_word": "摊开",
                                "target_lang_sense_clarification": "把布、纸等摊平"
                            },
                            {
                                "target_lang_word": "铺开",
                                "target_lang_sense_clarification": "把桌布等铺开"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "caebaf94-21e4-379d-b2b4-7d4da0c52b20",
                    "sense_definition": "To become opened or spread out from a folded state.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_opening",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy red curtains <w>unfolded</w> slowly to reveal the grand stage behind them.",
                            "target_lang_translations": {
                                "ru": "Тяжелые красные занавеси медленно <w>раздвинулись</w>, открывая величественную сцену.",
                                "zh": "沉重的红色帷幕慢慢<w>展开</w>，露出了后面宏伟的舞台。"
                            }
                        },
                        {
                            "text": "As the flower begins to bloom, its delicate petals <w>unfold</w> in the morning sun.",
                            "target_lang_translations": {
                                "ru": "Когда цветок начинает цвести, его нежные лепестки <w>распускаются</w> в лучах утреннего солнца.",
                                "zh": "当花开始开放时，它娇嫩的花瓣会在晨光中<w>舒展开来</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "curtains unfolded"
                    ],
                    "target_lang_definitions": {
                        "ru": "Раскрыться или расправиться из сложенного состояния.",
                        "zh": "从折叠或收拢的状态变为打开或展开。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "развернуться",
                                "target_lang_sense_clarification": "о предметах или цветах"
                            },
                            {
                                "target_lang_word": "раскрыться",
                                "target_lang_sense_clarification": "стать открытым"
                            },
                            {
                                "target_lang_word": "распуститься",
                                "target_lang_sense_clarification": "о цветах или почках"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "从折叠或收拢状态自行打开"
                            },
                            {
                                "target_lang_word": "舒展开来",
                                "target_lang_sense_clarification": "慢慢伸展开"
                            },
                            {
                                "target_lang_word": "绽开",
                                "target_lang_sense_clarification": "多用于花瓣等"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "035a74d6-f283-3db8-8522-ced7e2148668",
                    "sense_definition": "To happen or develop over time, especially in a way that reveals new details.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The mystery began to <w>unfold</w> as the detective discovered new clues at the scene.",
                            "target_lang_translations": {
                                "ru": "Тайна начала <w>раскрываться</w>, когда детектив обнаружил новые улики на месте происшествия.",
                                "zh": "随着侦探在现场发现新的线索，真相开始<w>浮现</w>。"
                            }
                        },
                        {
                            "text": "Events <w>unfolded</w> in an unexpected way during the final minutes of the championship game.",
                            "target_lang_translations": {
                                "ru": "События <w>разворачивались</w> неожиданным образом в последние минуты финальной игры чемпионата.",
                                "zh": "在冠军赛最后几分钟，局势的<w>发展</w>出人意料。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reveal"
                    ],
                    "common_phrases": [
                        "events unfolded",
                        "story unfolds",
                        "situation unfolds"
                    ],
                    "target_lang_definitions": {
                        "ru": "Происходить или развиваться с течением времени, раскрывая новые детали.",
                        "zh": "指事情随着时间发生或发展，尤其是逐渐显露出新的细节。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворачиваться",
                                "target_lang_sense_clarification": "о событиях или сюжете"
                            },
                            {
                                "target_lang_word": "развиваться",
                                "target_lang_sense_clarification": "о ситуации"
                            },
                            {
                                "target_lang_word": "раскрываться",
                                "target_lang_sense_clarification": "о тайне или интриге"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开",
                                "target_lang_sense_clarification": "事情、情节等逐步发生和呈现"
                            },
                            {
                                "target_lang_word": "发展",
                                "target_lang_sense_clarification": "局势、情况随着时间推进"
                            },
                            {
                                "target_lang_word": "浮现",
                                "target_lang_sense_clarification": "真相、细节开始显现"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "24111cf7-a0e5-3975-94bf-7e49a65cff7a",
                    "sense_definition": "To make something known or clear by explaining it in detail.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "development",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The scientist will <w>unfold</w> the principles of the new theory during her keynote speech.",
                            "target_lang_translations": {
                                "ru": "Ученый <w>изложит</w> принципы новой теории во время своего основного доклада.",
                                "zh": "这位科学家将在主题演讲中<w>阐述</w>新理论的原理。"
                            }
                        },
                        {
                            "text": "He chose to <w>unfold</w> his designs for the new building only after the funding was secured.",
                            "target_lang_translations": {
                                "ru": "Он решил <w>раскрыть</w> свои проекты нового здания только после того, как было обеспечено финансирование.",
                                "zh": "直到资金落实后，他才决定<w>详细介绍</w>新大楼的设计方案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "expose",
                        "reveal"
                    ],
                    "common_phrases": [
                        "unfold the truth",
                        "unfold a plan"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сделать что-либо известным или понятным, подробно объяснив это.",
                        "zh": "通过详细解释，把某事说明白或公之于众。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "излагать",
                                "target_lang_sense_clarification": "подробно описывать идеи"
                            },
                            {
                                "target_lang_word": "раскрывать",
                                "target_lang_sense_clarification": "делать явным планы или суть"
                            },
                            {
                                "target_lang_word": "развернуть",
                                "target_lang_sense_clarification": "подробно представить теорию"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "阐述",
                                "target_lang_sense_clarification": "系统地说明原理、观点等"
                            },
                            {
                                "target_lang_word": "详细说明",
                                "target_lang_sense_clarification": "把内容讲清楚"
                            },
                            {
                                "target_lang_word": "详细介绍",
                                "target_lang_sense_clarification": "介绍计划、设计等具体内容"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "696863b0-f86f-35a0-9d5d-700f180fc9a2",
                    "sense_definition": "To release animals, such as sheep, from a pen or fold.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "agriculture",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "At dawn, the shepherd went out to <w>unfold</w> the sheep so they could graze in the meadow.",
                            "target_lang_translations": {
                                "ru": "На рассвете пастух вышел, чтобы <w>выпустить</w> овец из загона на луг.",
                                "zh": "黎明时，牧羊人出去把羊<w>放出</w>圈，好让它们去草地上吃草。"
                            }
                        },
                        {
                            "text": "It was his daily chore to <w>unfold</w> the flock and lead them to the hills.",
                            "target_lang_translations": {
                                "ru": "Его ежедневной обязанностью было <w>выгонять</w> стадо и вести его к холмам.",
                                "zh": "他每天的活儿就是把羊群<w>赶出</w>圈，再带到山坡上去。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "unfold sheep"
                    ],
                    "target_lang_definitions": {
                        "ru": "Выпускать животных (например, овец) из загона.",
                        "zh": "把羊等牲畜从圈栏中放出来。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "выпускать из загона",
                                "target_lang_sense_clarification": "о скоте"
                            },
                            {
                                "target_lang_word": "выгонять",
                                "target_lang_sense_clarification": "на пастбище"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "放出",
                                "target_lang_sense_clarification": "把牲畜从圈里放出来"
                            },
                            {
                                "target_lang_word": "赶出",
                                "target_lang_sense_clarification": "把羊群等赶出栏圈"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "d68e28ca-2075-38d9-a66a-c4d6cea07e93",
                    "sense_definition": "To reassemble a line of text that was previously split across multiple lines.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "technical",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The script was designed to <w>unfold</w> the long strings of text for better readability in the editor.",
                            "target_lang_translations": {
                                "ru": "Скрипт был разработан для того, чтобы <w>разворачивать</w> длинные строки текста для лучшей читаемости в редакторе.",
                                "zh": "这个脚本旨在把长文本串<w>恢复为单行</w>，以便在编辑器中更易阅读。"
                            }
                        },
                        {
                            "text": "You may need to <w>unfold</w> the lines if the formatting was corrupted during the file transfer.",
                            "target_lang_translations": {
                                "ru": "Возможно, вам придется <w>объединить</w> строки, если форматирование было повреждено при передаче файла.",
                                "zh": "如果文件传输过程中格式损坏了，你可能需要把这些行<w>合并</w>起来。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Восстанавливать строку текста, которая была разбита на несколько строк.",
                        "zh": "把先前被拆分为多行的文本重新还原成一行。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "разворачивать",
                                "target_lang_sense_clarification": "технический термин для строк текста"
                            },
                            {
                                "target_lang_word": "объединять строки",
                                "target_lang_sense_clarification": "в программировании"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "恢复为单行",
                                "target_lang_sense_clarification": "把被拆成多行的文本重新接成一行"
                            },
                            {
                                "target_lang_word": "合并",
                                "target_lang_sense_clarification": "把断开的文本行重新并在一起"
                            },
                            {
                                "target_lang_word": "取消折行",
                                "target_lang_sense_clarification": "取消文本折行"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4ee480d6-407b-3542-b77a-db65983df050",
                    "sense_definition": "In functional programming, a higher-order function that is the opposite of a <w>fold</w>.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "programming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The developer used an <w>unfold</w> to generate a list of numbers from a single seed value.",
                            "target_lang_translations": {
                                "ru": "Разработчик использовал функцию <w>unfold</w> для генерации списка чисел из одного начального значения.",
                                "zh": "开发者使用了一个<w>展开函数</w>，从单个种子值生成了一个数字列表。"
                            }
                        },
                        {
                            "text": "Understanding how an <w>unfold</w> works is essential for mastering advanced functional programming techniques.",
                            "target_lang_translations": {
                                "ru": "Понимание того, как работает <w>развертка</w>, необходимо для освоения продвинутых техник функционального программирования.",
                                "zh": "理解<w>反折叠</w>的工作方式，对于掌握高级函数式编程技术至关重要。"
                            }
                        }
                    ],
                    "antonyms": [
                        "fold"
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical context"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "В функциональном программировании: функция высшего порядка, обратная свертке (fold).",
                        "zh": "在函数式编程中，指与 fold 相反的一种高阶函数。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "анаморфизм",
                                "target_lang_sense_clarification": "математический термин"
                            },
                            {
                                "target_lang_word": "unfold",
                                "target_lang_sense_clarification": "используется без перевода в IT"
                            },
                            {
                                "target_lang_word": "развертка",
                                "target_lang_sense_clarification": "редкий перевод функции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "展开函数",
                                "target_lang_sense_clarification": "函数式编程中与 fold 相对的高阶函数"
                            },
                            {
                                "target_lang_word": "反折叠",
                                "target_lang_sense_clarification": "较书面或术语化的说法"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}