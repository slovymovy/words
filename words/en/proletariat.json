{
    "word_family": [
        "proletarian",
        "proletary",
        "prole"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "262a0114-409a-304c-a26b-5b4688231a7f",
                    "sense_definition": "The lowest class of society or the masses in general.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proletariat</w> struggled to survive during the economic depression.",
                            "target_lang_translations": {
                                "zh": "在经济大萧条时期，<w>平民</w>在生存线上挣扎。"
                            }
                        },
                        {
                            "text": "Political leaders often claim to represent the interests of the <w>proletariat</w>.",
                            "target_lang_translations": {
                                "zh": "政治领袖常声称自己代表<w>无产阶级</w>的利益。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prole"
                    ],
                    "common_phrases": [
                        "the urban proletariat"
                    ],
                    "target_lang_definitions": {
                        "zh": "社会的最底层或广大群众。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无产阶级",
                                "target_lang_sense_clarification": "指社会底层或广大劳动群众。"
                            },
                            {
                                "target_lang_word": "平民",
                                "target_lang_sense_clarification": "指普通百姓或社会地位较低的群体。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4942ce4a-1de1-36a1-95fb-f7f1a9436c48",
                    "sense_definition": "Wage earners who own no capital and depend on their labor for survival, often viewed as being in conflict with the capital-owning class.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>proletariat</w> sought better working conditions through organized labor unions.",
                            "target_lang_translations": {
                                "zh": "<w>无产阶级</w>通过组织工会寻求改善工作条件。"
                            }
                        },
                        {
                            "text": "Historical theories often describe the struggle between the <w>proletariat</w> and the wealthy owners.",
                            "target_lang_translations": {
                                "zh": "历史理论常描述<w>无产阶级</w>与富有所有者之间的斗争。"
                            }
                        }
                    ],
                    "synonyms": [
                        "proletarian"
                    ],
                    "antonyms": [
                        "bourgeoisie"
                    ],
                    "common_phrases": [
                        "industrial proletariat"
                    ],
                    "target_lang_definitions": {
                        "zh": "指靠出卖劳动力为生、不占有生产资料的劳动者阶级。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无产阶级",
                                "target_lang_sense_clarification": "马克思主义术语，指与资产阶级相对立的劳动阶级。"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f7e67373-207f-3e68-86a7-2b42281b6f36",
                    "sense_definition": "The lowest class of citizens in ancient Rome who owned no property and had few rights.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "social_class",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "In ancient Rome, the <w>proletariat</w> were citizens whose only contribution was their children.",
                            "target_lang_translations": {
                                "zh": "在古罗马，<w>无产者</w>是那些唯一贡献就是生育后代的公民。"
                            }
                        },
                        {
                            "text": "Historians study how the <w>proletariat</w> lived within the Roman social structure.",
                            "target_lang_translations": {
                                "zh": "历史学家研究<w>无产者</w>如何在罗马社会结构中生活。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "Refers specifically to the Roman social class."
                        }
                    ],
                    "target_lang_definitions": {
                        "zh": "古罗马社会中不占有财产、几乎没有权利的最低阶层公民。"
                    },
                    "translations": {
                        "zh": [
                            {
                                "target_lang_word": "无产者",
                                "target_lang_sense_clarification": "古罗马时期指仅能提供后代的贫民。"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}