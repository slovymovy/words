                                        "entry_id": "15df8f7c-0bfb-33b8-a8a9-0360b9db3c3d",
                                        "glosses": [
                                            "The quality or state of being insubordinate; disobedience to lawful authority; specifically, an employee's failure or refusal to comply with a request or an assignment given by his/her supervisor."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "af6b841b-7394-4801-9b4a-1fff3ec86ed6",
                                                "sense_id": "34169fcf-04c1-3ba6-8ff8-7eba933c8462",
                                                "text": "Green, who served as a technical manager in the network's Washington bureau, charged in her suit that she was subject to \"repeated acts of insubordination by white male engineers and technicians, with the effect of the erosion and undermining of [her] ability to carry out her duties as supervisor.\""
                                            }
                                        ]
                                    }
                                ]
