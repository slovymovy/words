                ],
                "senses": [
                    {
                        "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                        "entry_id": "4ed23b21-673e-38d3-bd09-f61dd396c46a",
                        "glosses": [
                            "deutscher Nachname, Familienname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84246769-bdf7-496c-8cf9-57391efe5d5a",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Frau Giger ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "2971f923-4a61-410a-a783-bd4b9432d21c",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Herr Giger wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "9911baa9-ad35-4a6f-a4e6-68cdc95bf5bd",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Die Gigers fliegen heute nach La Paz."
                            },
                            {
                                "example_id": "46c401c6-aff7-46e2-a20c-76a727d1fc85",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Der Giger trägt nie die Schals, die die Giger ihm strickt."
                            },
                            {
                                "example_id": "74a034f8-3f7c-4a51-9eb4-0a3ce209edee",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Giger kommt, geht der Herr Ullrich.“"
                            },
                            {
                                "example_id": "8fdff805-39df-4b34-a5c5-44ff1d388da0",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Giger kommt und geht."
                            },
                            {
                                "example_id": "78a55505-c169-4ebd-8830-addb05d1908f",
                                "sense_id": "31817f53-f649-3f66-9725-f9a167aa3a2e",
                                "text": "Gigers kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
