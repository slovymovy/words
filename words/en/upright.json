{
    "word_family": [
        "uprightness",
        "uprightly"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c7491d7c-f953-3221-8dd2-49c6d4fedc80",
                    "sense_definition": "Vertical or erect in posture or position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verticality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The doctor advised him to maintain an <w>upright</w> posture to prevent back pain.",
                            "target_lang_translations": {
                                "ru": "Врач посоветовал ему сохранять <w>прямую</w> осанку, чтобы предотвратить боль в спине.",
                                "zh": "医生建议他保持<w>挺直的</w>姿势，以预防背痛。"
                            }
                        },
                        {
                            "text": "She sat in an <w>upright</w> position on the wooden chair.",
                            "target_lang_translations": {
                                "ru": "Она сидела в <w>прямом</w> положении на деревянном стуле.",
                                "zh": "她坐在木椅上，身体保持<w>直立</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "orthograde",
                        "surrect"
                    ],
                    "antonyms": [
                        "horizontal",
                        "prone"
                    ],
                    "common_phrases": [
                        "upright posture",
                        "upright position"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальный или прямой в осанке или положении.",
                        "zh": "指姿势或位置垂直、挺直。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямой",
                                "target_lang_sense_clarification": "об осанке или положении"
                            },
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "о положении тела"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挺直的",
                                "target_lang_sense_clarification": "形容姿势"
                            },
                            {
                                "target_lang_word": "垂直的",
                                "target_lang_sense_clarification": "形容位置"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "88b43fe1-9de1-3957-952e-e4339acbec09",
                    "sense_definition": "In its proper vertical orientation; not overturned or upside down.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "verticality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please make sure the box remains <w>upright</w> during the move so nothing spills.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, убедитесь, что коробка остается в <w>вертикальном</w> положении во время переезда, чтобы ничего не пролилось.",
                                "zh": "搬运时请确保箱子保持<w>竖直</w>，以免东西洒出来。"
                            }
                        },
                        {
                            "text": "He helped his son set the fallen lamp <w>upright</w> again.",
                            "target_lang_translations": {
                                "ru": "Он помог сыну снова поставить упавшую лампу <w>вертикально</w>.",
                                "zh": "他帮儿子把倒下的台灯重新<w>扶正</w>了。"
                            }
                        }
                    ],
                    "antonyms": [
                        "overturned",
                        "upside-down"
                    ],
                    "common_phrases": [
                        "set upright",
                        "keep upright"
                    ],
                    "target_lang_definitions": {
                        "ru": "В правильном вертикальном положении; не перевернутый.",
                        "zh": "处于正确的垂直方向；没有翻倒或颠倒。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "о положении предметов"
                            },
                            {
                                "target_lang_word": "в вертикальном положении",
                                "target_lang_sense_clarification": "стоящий прямо"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "直立的",
                                "target_lang_sense_clarification": "物体处于垂直状态"
                            },
                            {
                                "target_lang_word": "竖直的",
                                "target_lang_sense_clarification": "物体没有倒下"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bc487124-fbeb-30a5-9bd4-c57a75e62020",
                    "sense_definition": "Of good morals; honest, honorable, and practicing ethical values.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "morality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was known throughout the community as an <w>upright</w> citizen who always helped others.",
                            "target_lang_translations": {
                                "ru": "В округе его знали как <w>добропорядочного</w> гражданина, который всегда помогал другим.",
                                "zh": "他在社区里以<w>正直</w>的公民著称，总是乐于助人。"
                            }
                        },
                        {
                            "text": "She lived an <w>upright</w> life guided by strong personal principles.",
                            "target_lang_translations": {
                                "ru": "Она вела <w>честную</w> жизнь, руководствуясь твердыми личными принципами.",
                                "zh": "她过着<w>正派</w>的生活，并以坚定的个人原则为指导。"
                            }
                        }
                    ],
                    "synonyms": [
                        "surrect"
                    ],
                    "antonyms": [
                        "dishonest",
                        "corrupt"
                    ],
                    "common_phrases": [
                        "upright citizen",
                        "upright man"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высоких моральных качеств; честный, благородный и этичный.",
                        "zh": "品行端正的；诚实、高尚且遵守道德准则的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "честный",
                                "target_lang_sense_clarification": "о человеке или жизни"
                            },
                            {
                                "target_lang_word": "высокоморальный",
                                "target_lang_sense_clarification": "добропорядочный"
                            },
                            {
                                "target_lang_word": "добропорядочный",
                                "target_lang_sense_clarification": "о гражданине"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "正直的",
                                "target_lang_sense_clarification": "形容人品"
                            },
                            {
                                "target_lang_word": "正派的",
                                "target_lang_sense_clarification": "形容行为举止"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5aa641f6-b5e4-36d8-aaa5-77e5d6b00cae",
                    "sense_definition": "Greater in height than breadth.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "verticality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The artist chose an <w>upright</w> canvas to paint the tall skyscraper.",
                            "target_lang_translations": {
                                "ru": "Художник выбрал <w>вертикальный</w> холст, чтобы нарисовать высокий небоскреб.",
                                "zh": "艺术家选择了一块<w>竖向</w>的画布来绘制那座高耸的摩天大楼。"
                            }
                        },
                        {
                            "text": "The book was printed in an <w>upright</w> format rather than landscape.",
                            "target_lang_translations": {
                                "ru": "Книга была напечатана в <w>книжном</w> формате, а не в альбомном.",
                                "zh": "这本书采用的是<w>纵向</w>排版，而不是横向的。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий высоту больше, чем ширину; вертикальный.",
                        "zh": "高度大于宽度的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "о формате или холсте"
                            },
                            {
                                "target_lang_word": "книжный",
                                "target_lang_sense_clarification": "о формате печати"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "竖向的",
                                "target_lang_sense_clarification": "形容格式或布局"
                            },
                            {
                                "target_lang_word": "纵向的",
                                "target_lang_sense_clarification": "形容尺寸比例"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "566996d9-bb8a-38f1-b68b-c119e0d60a71",
                    "sense_definition": "Having the head approximately at a right angle with the shaft.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verticality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The golf club has an <w>upright</w> lie angle suitable for taller players.",
                            "target_lang_translations": {
                                "ru": "Клюшка для гольфа имеет более <w>крутой</w> угол наклона, подходящий для более высоких игроков.",
                                "zh": "这支高尔夫球杆的杆头角度较<w>陡直</w>，适合身材较高的球员。"
                            }
                        },
                        {
                            "text": "He adjusted the tool to a more <w>upright</w> angle for better precision.",
                            "target_lang_translations": {
                                "ru": "Он настроил инструмент под более <w>вертикальным</w> углом для большей точности.",
                                "zh": "他将工具调整到更<w>垂直</w>的角度，以获得更高的精度。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "form",
                            "comment": "technical term used in specific mechanical or sporting contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Имеющий головку примерно под прямым углом к рукоятке или стержню.",
                        "zh": "指头部与杆身呈直角或接近直角的。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "крутой",
                                "target_lang_sense_clarification": "об угле наклона инструмента или клюшки"
                            },
                            {
                                "target_lang_word": "вертикальный",
                                "target_lang_sense_clarification": "об угле"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "陡直的",
                                "target_lang_sense_clarification": "形容角度"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "98a4fe15-be79-3481-9c10-f103908da99d",
                    "sense_definition": "In or into a vertical or erect position.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "verticality",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The toddler managed to stand <w>upright</w> for a few seconds without falling.",
                            "target_lang_translations": {
                                "ru": "Малышу удалось постоять <w>прямо</w> несколько секунд и не упасть.",
                                "zh": "那个蹒跚学步的孩子成功地<w>直立</w>站了几秒钟而没有摔倒。"
                            }
                        },
                        {
                            "text": "Humans are unique because they walk <w>upright</w> on two legs.",
                            "target_lang_translations": {
                                "ru": "Люди уникальны тем, что ходят <w>прямо</w> на двух ногах.",
                                "zh": "人类的独特之处在于他们用双腿<w>直立</w>行走。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "stand upright",
                        "walk upright",
                        "sit upright"
                    ],
                    "target_lang_definitions": {
                        "ru": "В вертикальном или прямом положении.",
                        "zh": "处于或进入垂直、挺直的位置。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "прямо",
                                "target_lang_sense_clarification": "о положении тела"
                            },
                            {
                                "target_lang_word": "вертикально",
                                "target_lang_sense_clarification": "в вертикальном положении"
                            },
                            {
                                "target_lang_word": "стоя",
                                "target_lang_sense_clarification": "в стоячем положении"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "挺直地",
                                "target_lang_sense_clarification": "形容姿势"
                            },
                            {
                                "target_lang_word": "直立地",
                                "target_lang_sense_clarification": "形容动作状态"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "faadfee0-ceab-33aa-be68-96aa58684b64",
                    "sense_definition": "A vertical post or pillar that supports a structure, or a goal post in sports.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "structural_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ball bounced off the <w>upright</w> and missed the goal completely.",
                            "target_lang_translations": {
                                "ru": "Мяч отскочил от <w>штанги</w> и пролетел совершенно мимо ворот.",
                                "zh": "球从<w>门柱</w>上弹开，完全偏离了球门。"
                            }
                        },
                        {
                            "text": "We need to secure the wooden <w>uprights</w> before putting up the roof.",
                            "target_lang_translations": {
                                "ru": "Нам нужно закрепить деревянные <w>стойки</w> перед установкой крыши.",
                                "zh": "在安装屋顶之前，我们需要固定好木制<w>立柱</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "hit the upright"
                    ],
                    "target_lang_definitions": {
                        "ru": "Вертикальная стойка или столб, поддерживающий конструкцию, или штанга ворот в спорте.",
                        "zh": "支撑结构的垂直柱子，或体育运动中的球门柱。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка ворот",
                                "target_lang_sense_clarification": "в спорте"
                            },
                            {
                                "target_lang_word": "штанга",
                                "target_lang_sense_clarification": "в спортивных воротах"
                            },
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "опора конструкции"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立柱",
                                "target_lang_sense_clarification": "建筑支撑物"
                            },
                            {
                                "target_lang_word": "门柱",
                                "target_lang_sense_clarification": "体育运动"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "0be9974e-0a28-3a2e-ad7a-3baa9dc805d0",
                    "sense_definition": "Any vertical part of a structure.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "structural_parts",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The metal <w>uprights</w> of the scaffolding must be checked for safety.",
                            "target_lang_translations": {
                                "ru": "Металлические <w>стойки</w> строительных лесов необходимо проверить на безопасность.",
                                "zh": "必须检查脚手架的金属<w>支柱</w>以确保安全。"
                            }
                        },
                        {
                            "text": "He bolted the horizontal shelves to the heavy steel <w>uprights</w>.",
                            "target_lang_translations": {
                                "ru": "Он прикрутил горизонтальные полки к тяжелым стальным <w>опорам</w>.",
                                "zh": "他把水平搁板用螺栓固定在沉重的钢制<w>支柱</w>上。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Любая вертикальная часть конструкции.",
                        "zh": "结构的任何垂直部分。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "стойка",
                                "target_lang_sense_clarification": "вертикальная опора"
                            },
                            {
                                "target_lang_word": "подпорка",
                                "target_lang_sense_clarification": "вертикальный элемент"
                            },
                            {
                                "target_lang_word": "колонна",
                                "target_lang_sense_clarification": "вертикальный столб"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "支柱",
                                "target_lang_sense_clarification": "垂直支撑件"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "024a52fc-f207-37ac-a510-3eb0171361d2",
                    "sense_definition": "An upright piano.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "musical_instruments",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Since their apartment was small, they bought an <w>upright</w> instead of a grand piano.",
                            "target_lang_translations": {
                                "ru": "Так как их квартира была маленькой, они купили <w>пианино</w> вместо рояля.",
                                "zh": "因为他们的公寓很小，所以他们买了台<w>立式钢琴</w>而不是三角钢琴。"
                            }
                        },
                        {
                            "text": "She practiced her scales on the old <w>upright</w> in the living room.",
                            "target_lang_translations": {
                                "ru": "Она разучивала гаммы на старом <w>пианино</w> в гостиной.",
                                "zh": "她在客厅那台旧的<w>立式钢琴</w>上练习音阶。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Пианино (в отличие от рояля).",
                        "zh": "立式钢琴。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "пианино",
                                "target_lang_sense_clarification": "музыкальный инструмент"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "立式钢琴",
                                "target_lang_sense_clarification": "乐器"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "69820263-3ca7-33b6-b8bf-e88c10991cb9",
                    "sense_definition": "An upright arcade game cabinet.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "gaming",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The retro arcade was filled with classic <w>uprights</w> from the 1980s.",
                            "target_lang_translations": {
                                "ru": "Ретро-зал игровых автоматов был заполнен классическими <w>вертикальными автоматами</w> из 1980-х.",
                                "zh": "复古游戏厅里摆满了20世纪80年代的经典<w>立式街机</w>。"
                            }
