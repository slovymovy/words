                                        "sense_id": "1738d361-eaf4-3871-94c8-d5e3eae433a9",
                                        "entry_id": "f9e07763-44c9-3b25-996a-3f98680e1bd7",
                                        "glosses": [
                                            "A short break or rest period during the day when a cup of tea or coffee is drunk."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "639ec9ca-e75b-3185-b0d9-f9492f485a8e",
                                        "entry_id": "f9e07763-44c9-3b25-996a-3f98680e1bd7",
                                        "glosses": [
                                            "A short rest break which an employee is entitled to take, shorter in duration than a lunchbreak"
                                        ],
                                        "tags": [
                                            "Australia"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "fa90a1a0-747d-40dc-a944-74dc3e430e34",
                                                "sense_id": "639ec9ca-e75b-3185-b0d9-f9492f485a8e",
                                                "text": "An employee who works between 3 and 5 hours on a day should be entitled to a paid tea break for rest."
                                            },
                                            {
                                                "example_id": "2cb75682-1196-4265-86af-92cdb7ddfa27",
                                                "sense_id": "639ec9ca-e75b-3185-b0d9-f9492f485a8e",
                                                "text": "According to the SCHADS award, support workers are entitled to a paid 10 minute tea break for every four hours worked."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
