                                    },
                                    {
                                        "sense_id": "d7d2b665-c13f-35d2-9e9e-1f382495c3aa",
                                        "entry_id": "c562f60e-f79f-3911-9789-6d0c763cfd98",
                                        "glosses": [
                                            "A special airliner flight to bring home passengers who are stranded."
                                        ],
                                        "tags": [
