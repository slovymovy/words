                            },
                            {
                                "target_lang_word": "urdir",
                                "target_lang_sense_clarification": "un complot o trampa"
                            },
                            {
                                "target_lang_word": "fraguarse",
                                "target_lang_sense_clarification": "un plan secreto"
                            }
                        ]
                    }
                },
                {
