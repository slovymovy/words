                    }
                ],
                "senses": [
                    {
                        "sense_id": "b4fed810-bf8d-32b3-a461-75e1c1651176",
                        "entry_id": "5c322836-e2c7-33fe-8b8d-4f61c085b86e",
                        "glosses": [
                            "Rougeur cutanée plus ou moins vive généralement liée à une maladie infectieuse."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a46f4fb8-9577-4bde-affb-ef4806507426",
                                "sense_id": "b4fed810-bf8d-32b3-a461-75e1c1651176",
                                "text": "L’exanthème scarlatiniforme est caractérisé par de vastes nappes rouges parsemées d’un piqueté maculo-papuleux et évoluant vers la désquamation."
                            },
                            {
                                "example_id": "740031e4-5d96-4a2b-92a2-52b40a6716ee",
                                "sense_id": "b4fed810-bf8d-32b3-a461-75e1c1651176",
                                "text": "Toutes les fois qu’on traite un exanthème devenu chronique et passé en habitude, il est prudent, après la guérison, d’entretenir un cautère pendant quelque temps, afin de prévenir les résultats nuisibles de la suppression d’une évacuation à laquelle l’économie se serait accoutumée."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "a7a13fd9-aa17-4293-b013-aabd2385b7a0",
                        "source_entry_id": "5c322836-e2c7-33fe-8b8d-4f61c085b86e",
                        "source_sense_id": "b4fed810-bf8d-32b3-a461-75e1c1651176",
