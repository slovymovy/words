                        "tags": [],
                        "examples": [
                            {
                                "example_id": "4b32c5b7-5d03-4149-bf01-588a35688bdd",
                                "sense_id": "9aa96c82-2b23-3aa2-9752-37440314a378",
                                "text": "In his Shem Hagedolim, one of the first bio-bibliographies of Hebrew books and authors, he writes in the section on Rabbis that Rabbeinu Tzidkiyah wrote Shibolei Haleket. He explains that he saw Part II of this work in a manuscript and it contains many responsa of Rashi. In one of them, it says that Rashi was sick and did not have the strength to write and he called his daughter וקרא לבתו to write down that responsum."
                            }
                        ]
                    }
