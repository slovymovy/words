                "senses": [
                    {
                        "sense_id": "a4bb16be-693b-3195-92cb-de432e2f5b30",
                        "entry_id": "8f04fd15-ece9-3d58-a068-1d41c8564447",
                        "glosses": [
                            "Verhandlung mit dem Ziel, die Bedingungen für den Verkauf einer Ware oder Dienstleistung zu vereinbaren"
                        ],
                        "tags": [
                            "plural-normally"
                        ],
                        "examples": [
                            {
                                "example_id": "e62327aa-7817-4f05-b059-c43c80141e47",
                                "sense_id": "a4bb16be-693b-3195-92cb-de432e2f5b30",
                                "text": "„Aus mehreren Interessenten seien zuvor drei Bietergruppen zur Verkaufsverhandlung eingeladen worden, die sich um die Liegenschaften matchten.“"
                            },
                            {
                                "example_id": "6871fcb4-355b-4754-9be9-490b2eb9f4eb",
                                "sense_id": "a4bb16be-693b-3195-92cb-de432e2f5b30",
                                "text": "„Die Münchner Traditionsfirma, die mit dem Wintersport groß wurde und noch immer Willy Bogner gehört, ist schon lange in Schwierigkeiten und kämpft ums Überleben, die Umsätze sind gesunken, es gab Personalquerelen, gescheiterte Verkaufsverhandlung, Probleme mit den Steuerbehörden. Dann kam auch noch Corona.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
