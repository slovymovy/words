                "entry_id": "2073fbab-2591-31dc-b77a-1ce6c38e1389",
                "word": "opkroppen",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "59afd1d5-de56-354c-8f6d-4a1079f09da3",
                        "entry_id": "2073fbab-2591-31dc-b77a-1ce6c38e1389",
                        "glosses": [
                            "niet uiten (en dus binnenhouden) van gevoelens zoals bijvoorbeeld woede"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6b1df2f3-a03b-4f54-bcbc-a26294f92877",
                                "sense_id": "59afd1d5-de56-354c-8f6d-4a1079f09da3",
                                "text": "Hij kon zijn woede en verontwaardiging maar met moeite opkroppen."
                            },
                            {
                                "example_id": "2aeb69db-4906-49fc-830d-dd6327856390",
                                "sense_id": "59afd1d5-de56-354c-8f6d-4a1079f09da3",
                                "text": "Nieuwe reeks van het programma over identiteit met filosoof Stine Jensen. Het thema van de eerste uitzending is woede. Wat is de waarde van woede? Bestaat er zoiets als positieve woede? En is het opkroppen van woede slecht?"
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "abb1e153-b271-40e2-a00d-5d73b219a8dc",
                        "source_entry_id": "2073fbab-2591-31dc-b77a-1ce6c38e1389",
                        "source_sense_id": "59afd1d5-de56-354c-8f6d-4a1079f09da3",
                        "source_sense_description": "niet uiten (en dus binnenhouden) van gevoelens zoals bijvoorbeeld woede",
                        "target_lang_word": "verschlucken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "verschlucken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "43546ac9-3b10-320b-89af-d4c7fe15b1d1",
                                        "entry_id": "bea9cf7a-b23a-317e-a9c9-4c887164042f",
                                        "glosses": [
                                            "einen Festkörper durch Muskelbewegungen vom Mundraum in die Speiseröhre befördern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "d85a9c22-fa54-44d6-a1d8-3456062019c5",
                                                "sense_id": "43546ac9-3b10-320b-89af-d4c7fe15b1d1",
                                                "text": "Das Spielzeug enthält Kleinteile, die von Kindern verschluckt werden können."
                                            },
                                            {
                                                "example_id": "fb8deef1-c586-43ca-b3b0-148596e100fe",
                                                "sense_id": "43546ac9-3b10-320b-89af-d4c7fe15b1d1",
                                                "text": "Ich habe ein Pfefferkorn verschluckt."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "065cc867-955d-3582-95d0-8e4899676af4",
                                        "entry_id": "bea9cf7a-b23a-317e-a9c9-4c887164042f",
                                        "glosses": [
                                            "den Akt des Schluckens nicht ordnungsgemäß ausführen, sodass Nahrung in die Luftröhre gelangt"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1cc5acc0-260e-4a3a-bf1f-c838653f8774",
                                                "sense_id": "065cc867-955d-3582-95d0-8e4899676af4",
                                                "text": "Du sollst nicht beim Essen reden, sonst verschluckst du dich."
                                            },
                                            {
                                                "example_id": "a8b952a1-b676-4b3a-a154-6d41b329ca64",
                                                "sense_id": "065cc867-955d-3582-95d0-8e4899676af4",
                                                "text": "Wenn man sich verschluckt, wird sofort ein Hustenreiz ausgelöst."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "960742f1-15c8-4647-9aa1-0567869c90e6",
                        "source_entry_id": "2073fbab-2591-31dc-b77a-1ce6c38e1389",
                        "source_sense_id": "59afd1d5-de56-354c-8f6d-4a1079f09da3",
                        "source_sense_description": "niet uiten (en dus binnenhouden) van gevoelens zoals bijvoorbeeld woede",
                        "target_lang_word": "hinunterschlucken",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "hinunterschlucken",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "8736d566-12fd-3f68-8349-799aef76c5c2",
                                        "entry_id": "f5b0fc19-87c1-3001-b301-73bd69e0f4be",
                                        "glosses": [
                                            "(etwas Essbares oder Ähnliches) schlucken, in den Magen befördern"
                                        ],
                                        "tags": [
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "40d87e32-4c21-4d68-8620-fffa0c3d495a",
                                                "sense_id": "8736d566-12fd-3f68-8349-799aef76c5c2",
                                                "text": "„Sie brachte ein Glas Grog für mich und für sich eine Tasse Kamillentee, das war unsere Sylvesterbowle, und als ich erst den Grog hinuntergeschluckt hatte, da erzählte ich dem guten Seelchen alles – alles – und – sie wurde beinahe vom Schlage gerührt.“"
                                            },
                                            {
                                                "example_id": "8c47dc19-efdc-4469-800e-b89671369868",
                                                "sense_id": "8736d566-12fd-3f68-8349-799aef76c5c2",
                                                "text": "„Oft werde der Stoff von den Dealern einfach im Mund behalten und bei Kontrollen hinuntergeschluckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "59e84302-c0ff-31ff-a8f0-1a9615510ab6",
                                        "entry_id": "f5b0fc19-87c1-3001-b301-73bd69e0f4be",
                                        "glosses": [
                                            "(etwas Beleidigendes, Unangenehmes oder Ähnliches) hinnehmen und nicht widersprechen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "247c2f0d-9c1b-4181-8695-cb1fbef4b1fb",
                                                "sense_id": "59e84302-c0ff-31ff-a8f0-1a9615510ab6",
                                                "text": "„Raschke hatte einen ‚dicken Hals‘ bekommen, sich aber zurückgenommen und die deftige Beleidigung hinuntergeschluckt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "ac1604a6-a94b-3ec6-a6b0-99eb3f5a112d",
                                        "entry_id": "f5b0fc19-87c1-3001-b301-73bd69e0f4be",
                                        "glosses": [
                                            "sich eine ärgerliche Äußerung/Reaktion verkneifen"
                                        ],
                                        "tags": [
                                            "colloquial",
                                            "figurative",
                                            "transitive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "26c8b596-1379-4b30-8e6f-fa458cc20e3a",
                                                "sense_id": "ac1604a6-a94b-3ec6-a6b0-99eb3f5a112d",
                                                "text": "„Ihr Blick wirkt nachdenklich, danach folgt ein höfliches Lächeln, so als ob sie ihren Unmut hinunterschlucken würde.“"
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
