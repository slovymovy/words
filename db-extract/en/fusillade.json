                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "500466f3-1767-45e2-8cad-91abbb734e56",
                        "entry_id": "610001d9-1fa5-3d9d-b276-fbd1a5b2268f",
