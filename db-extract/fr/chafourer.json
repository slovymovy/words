                "senses": [
                    {
                        "sense_id": "2b5014f2-4730-30da-9bcd-e453d3ff10c6",
                        "entry_id": "a0b49905-b66f-3fd5-b56f-17ccb850f7fb",
                        "glosses": [
                            "Défigurer, barbouiller, griffonner, déformer une chose en la manipulant avec violence  ^([2])."
                        ],
                        "tags": [
                            "obsolete"
                        ],
                        "examples": [
                            {
                                "example_id": "c4eb06f5-4995-4b65-99a8-bf54e47eacce",
                                "sense_id": "2b5014f2-4730-30da-9bcd-e453d3ff10c6",
                                "text": "Et ne seroit qu'en chafourer le papier en vain; car il y en a assez d'escrit, et mesmes ce grand Bocace en a faict un beau livre à part."
                            },
                            {
                                "example_id": "d0023690-ba64-449d-9916-f8479a00ff1c",
                                "sense_id": "2b5014f2-4730-30da-9bcd-e453d3ff10c6",
                                "text": "Il a trouvé qu'on avoit tasché de m'y chafourer estrangement ; mais il a faict cognoistre la verité aulx principaulx, à part et sans scandale, […]"
                            }
                        ]
                    }
