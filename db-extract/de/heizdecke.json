                            {
                                "example_id": "eb566d32-35cf-4ca3-9ad3-6c3d8807e842",
                                "sense_id": "4a725ddc-c101-39e5-88b4-01ad27bf6c70",
                                "text": "Da es nun Winter wurde, holte sie ihre Heizdecke aus dem Schrank."
                            },
                            {
                                "example_id": "245b0c7b-edb1-47dd-97fc-1600513033fa",
                                "sense_id": "4a725ddc-c101-39e5-88b4-01ad27bf6c70",
                                "text": "„Während seines zweiwöchigen Urlaubs nach der Grundausbildung ging Roth zu einem Osteopathen in Moorestown, der eine Stauchung des Sakroiliakalgelenks diagnostizierte und ihm riet, auf einer Heizdecke zu liegen und abrupte Bewegungen zu vermeiden.“"
                            }
                        ],
