                        "examples": [
                            {
                                "example_id": "f6fb3ef2-95f6-4e9d-9f01-e8b30e90bd49",
                                "sense_id": "d8193b68-fcb0-3fe9-84d6-fa3232767af7",
                                "text": "Hij zag de gezichten van de kameraden voor zich, messcherpe beelden als in een moderne kleurenfilm, hoe ze glimlachten en gebaarden tijdens de discussie, hoe ze met hun sigaretten zwaaiden en nieuw bier kregen voorgezet."
                            },
                            {
                                "example_id": "1c65c6ff-a276-498d-b030-04b712b9c451",
                                "sense_id": "d8193b68-fcb0-3fe9-84d6-fa3232767af7",
                                "text": "Fanny en Alexander speelde zich rond 1910 af, niet zo ver verwijderd van haar eigen jeugd, het was alsof ze die herbeleefde in een moderne kleurenfilm."
                            }
                        ]
