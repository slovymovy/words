                                            {
                                                "example_id": "4b9b60f3-201f-469c-9c79-bd526af10ebe",
                                                "sense_id": "8442bd28-2fb1-3ff6-8dd7-af635844d91c",
                                                "text": "Zrzucenie bomby w jednym momencie spowodowało pogrom wśród wroga."
