                        ],
                        "examples": [
                            {
                                "example_id": "daba59a8-e43f-4b95-9460-994733e4f160",
                                "sense_id": "5f625483-463e-3208-88e4-03d721cb19f4",
                                "text": "On apporta de la viande grillée, des champignons jaunes très-beaux, dont je ne pus me décider à goûter, encore que je visse tout ce monde en manger sans crainte; des œufs fricassés avec diverses sortes d'herbes fortes, des galetons de blé noir, et des fromages de Chambérat, renommés en tout le pays."
                            },
                            {
                                "example_id": "657288aa-ad4e-4bae-a5e4-21c5e1f1f3cf",
                                "sense_id": "5f625483-463e-3208-88e4-03d721cb19f4",
                                "text": "Pour accompagner les sauces, la ménagère fait chaque matin des galettes de blé noir, que l’on appelle galetons dans la Haute-Vienne."
                            }
                        ]
                    }
