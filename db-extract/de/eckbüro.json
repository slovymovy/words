                ],
                "senses": [
                    {
                        "sense_id": "97b76155-db1b-31cc-9309-43e6b6ba5d32",
                        "entry_id": "45ac194a-72fb-3054-9001-2ea9a318776e",
                        "glosses": [
                            "Büro, das sich in einer Ecke eines Hauses/Geschosses befindet"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "666bdae6-3039-455b-bafe-19da54cf6eaa",
                                "sense_id": "97b76155-db1b-31cc-9309-43e6b6ba5d32",
                                "text": "„Denn die Rechtsanwaltskanzlei von Leo Specht, Freund und neuerdings auch Geschäftspartner des ehemaligen Kanzlers, befindet sich direkt vis-à-vis des altehrwürdigen Genossen-Hauptquartiers in der Löwelstraße, wo Gusenbauer in seinen acht Jahren als Parteichef im herzeigbaren Eckbüro im zweiten Stock zu residieren pflegte.“"
                            },
                            {
                                "example_id": "326b1f34-cbaf-4af3-876b-ca1baec2c081",
                                "sense_id": "97b76155-db1b-31cc-9309-43e6b6ba5d32",
                                "text": "„Von ihrem Eckbüro im achten Stock des Parlamentsgebäudes blickt sie den Interessenverbänden fast in die Büros.“"
                            },
                            {
                                "example_id": "37a625c8-9d60-4204-b6a3-25f462d47b60",
                                "sense_id": "97b76155-db1b-31cc-9309-43e6b6ba5d32",
                                "text": "„Nun sitzt Aggarwal in seinem Eckbüro im Langenthaler Gewerbegebiet, an dem die Züge zwischen Bern und Zürich vorbeirauschen, und erzählt, wie er zu einem der grössten Importeure indischer Lebensmittel in der Schweiz wurde.“"
                            },
                            {
                                "example_id": "2d4b89af-677d-41aa-8f37-bcc929596ae2",
                                "sense_id": "97b76155-db1b-31cc-9309-43e6b6ba5d32",
                                "text": "„Im Eckbüro warteten Sonny und Tessio.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
