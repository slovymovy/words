                        "glosses": [
                            "elk van de Griekse goden die op de Olympus woonden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ba43e10e-df7a-4172-985a-fd9048e63945",
                                "sense_id": "107a3ef8-ec19-321e-8501-180f6845b8f9",
                                "text": "Derhalve kon Maerlant niet alleen heidense verhaalpersonages zich in de directe rede naar hartelust laten beroemen op afstamming van deze of gene Olympiër, maar kon hij ook bijvoorbeeld een Dardanus zonder gewetensbezwaren in de lopende tekst met ‘Jupiters sone’ aanduiden, aangezien diezelfde Jupiter in Maerlants ogen immers een sterfelijke man, dus waarom niet tevens een vader, was geweest (…)."
                            }
                        ]
                    },
                    {
                        "sense_id": "7ec7a6d7-32aa-3d0e-a3b1-02fc9e2dea4e",
                        "entry_id": "7cf9361f-0e49-3a5d-8c1e-cd4b9584a05c",
                        "glosses": [
                            "bijnaam van Zeus, als oppergod van de Griekse goden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "aad4016f-c169-4b0e-ba37-ee9ab65d04fb",
                                "sense_id": "7ec7a6d7-32aa-3d0e-a3b1-02fc9e2dea4e",
                                "text": "Welaan jij toch, eer hem, gij Olympiër, plannen beramende Zeus."
                            }
                        ]
                    },
                    {
                        "sense_id": "13f6ce11-f118-3759-81f3-9122b237e4da",
                        "entry_id": "7cf9361f-0e49-3a5d-8c1e-cd4b9584a05c",
                        "glosses": [
                            "iemand die door zijn prestaties ver boven iedereen uitsteekt"
                        ],
                        "tags": [
                            "figuratively"
                        ],
                        "examples": [
                            {
                                "example_id": "320cce47-1dd2-44b9-aa1a-bda46fbd54fa",
                                "sense_id": "13f6ce11-f118-3759-81f3-9122b237e4da",
                                "text": "Goethe op zijn beurt resideerde in Weimar als een Olympiër, die in zijn woning aan het Frauenplan boven zijn stadgenoten uit torende."
                            },
                            {
                                "example_id": "39b3f895-5686-4562-b2f5-2c62a5f0e7e0",
                                "sense_id": "13f6ce11-f118-3759-81f3-9122b237e4da",
                                "text": "Hij laat hier beslist meer het achterste van zijn tong zien dan Vestdijk, in wiens houding steeds iets doorschemert van de monkelende Olympiër die voor het geïmponeerde publiek wel eventjes een vers uit de mouw zal schudden. Vestdijk weet alles al, zo lijkt het, terwijl Kopland alles nog moet ontdekken."
                            }
                        ]
                    }
