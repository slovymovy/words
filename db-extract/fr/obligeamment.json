                        "sense_id": "b4c7286c-8d8b-3f71-8679-25341dc4fab1",
                        "entry_id": "d4a45f63-0e17-315a-b1bb-4406f7377f51",
                        "glosses": [
                            "D’une manière obligeante, courtoise ou aimable."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "19b533f7-7d8c-4f8c-939b-ee2ce91dd5a0",
                                "sense_id": "b4c7286c-8d8b-3f71-8679-25341dc4fab1",
                                "text": "[…]; bien souvent d'ailleurs et très obligeamment, BONATI fils, qui fut pour moi un ami sûr, me procura d'intéressants renseignements sur la flore hygrophile de la vallée moyenne."
                            },
                            {
                                "example_id": "182886bf-b757-47df-b323-dace75c60d59",
                                "sense_id": "b4c7286c-8d8b-3f71-8679-25341dc4fab1",
                                "text": "Cléon parle peu obligeamment, ou peu juste ; c’est l’un ou l’autre ; mais il ajoute qu’il est fait ainsi, et qu’il dit ce qu’il pense."
                            }
                        ]
                    }
                ],
