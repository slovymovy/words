                        "target_lang_word": "unterordnen",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "unterordnen",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "39aedc5d-3315-3ade-964d-e54bf5e9eb08",
                                        "entry_id": "dce326dd-444a-3f57-b594-d90f47616903",
                                        "glosses": [
                                            "sich (freiwillig) in eine Situation finden, in der jemand anderer übergeordnet ist"
                                        ],
                                        "tags": [
                                            "reflexive"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e46aa8aa-2808-4563-b106-ad8c59abff63",
                                                "sense_id": "39aedc5d-3315-3ade-964d-e54bf5e9eb08",
                                                "text": "Sie ist eine brillante Strategin, aber sie kann sich nicht unterordnen."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "d00ede8a-4326-3f87-96eb-57bb00236429",
                                        "entry_id": "dce326dd-444a-3f57-b594-d90f47616903",
                                        "glosses": [
                                            "in ein System einordnen, einsortieren"
                                        ],
                                        "tags": [
                                            "wertfrei"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8d64b66c-9254-4daf-8d1d-a25eeae87213",
                                                "sense_id": "d00ede8a-4326-3f87-96eb-57bb00236429",
                                                "text": "Wo soll ich denn diesen Druck unterordnen, bei den Aquarellen?"
                                            },
                                            {
                                                "example_id": "39cc6ebb-01c4-45b8-9f40-63457ea5517f",
                                                "sense_id": "d00ede8a-4326-3f87-96eb-57bb00236429",
                                                "text": "Die Schiedstelle ist dem Verbraucheramt untergeordnet."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "3636f188-2669-3b73-a8c0-b71bbc02700a",
                                        "entry_id": "dce326dd-444a-3f57-b594-d90f47616903",
                                        "glosses": [
                                            "etwas nur eine weniger wichtige Position einräumen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "796da6f1-e418-4249-bb60-0f47198bb8af",
                                                "sense_id": "3636f188-2669-3b73-a8c0-b71bbc02700a",
                                                "text": "Dieser wichtigen Frage müssen wir alles andere unterordnen."
                                            },
                                            {
                                                "example_id": "0e381eb8-f440-4418-9bce-3994c2a4617b",
                                                "sense_id": "3636f188-2669-3b73-a8c0-b71bbc02700a",
                                                "text": "Sie ordnete die eigene Karriere dem Leben als Mutter unter."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    }
                                ]
                            }
                        ]
                    }
