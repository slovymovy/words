                "senses": [
                    {
                        "sense_id": "6a82461d-e1c8-3864-9486-7a0ad498b757",
                        "entry_id": "3e86cc13-ca80-3ebd-9783-806f8c8978f3",
                        "glosses": [
                            "miasto w północno-wschodnich Włoszech"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "eb4b01e0-7ab0-4dc2-a459-f2768f3bcbf9",
                                "sense_id": "6a82461d-e1c8-3864-9486-7a0ad498b757",
                                "text": "We wrześniu zwiedziliśmy bazylikę w Padwie."
                            },
                            {
                                "example_id": "119d07cd-bc4f-49f5-913a-521ce7cc0f6e",
                                "sense_id": "6a82461d-e1c8-3864-9486-7a0ad498b757",
                                "text": "Dla wenecjan Padwa była (a może nadal jest?) miastem grzechu"
                            },
                            {
                                "example_id": "aca3a724-a0a0-4470-baab-f712b30439f4",
                                "sense_id": "6a82461d-e1c8-3864-9486-7a0ad498b757",
                                "text": "(…) spośród około 1000 polskich studentów, którzy w XVI wieku edukowali się w Padwie, wywodziło się 49 późniejszych biskupów i opatów oraz 38 wojewodów i kasztelanów. Odsetek sięgający niemal 10 procent! Bez jakiejkolwiek przesady można stwierdzić, że Padwa była prawdziwą kuźnią polskich kadr urzędniczych i kościelnych"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
