                        ],
                        "examples": [
                            {
                                "example_id": "bbd4eb2f-740b-4ba9-9a64-1006442e7157",
                                "sense_id": "5bb18b49-a545-3151-b3c0-3be70641b680",
                                "text": "I don't like wearing phones for any length of time, but these are as comfortable as any I've tried. The only problem is that their isolation is so good, you feel cut off from the outside world and you can't hear what people are saying about you."
                            },
                            {
                                "example_id": "eaddde4b-1501-4970-99cf-7a7117aa4ee2",
                                "sense_id": "5bb18b49-a545-3151-b3c0-3be70641b680",
                                "text": "I ripped the phones off my head, fluffed my hair, and tossed the crumpled lyric sheet in the garbage can before strolling into the control room like a queen."
                            }
                        ]
                    }
                ],
