                ],
                "senses": [
                    {
                        "sense_id": "217fb127-00cc-3eb8-966f-3ea17484f04d",
                        "entry_id": "c6fa1610-5788-38ab-968d-1f0d7c57a858",
                        "glosses": [
                            "veraltet: Sonderschule für minderbegabte Kinder"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1e3524ae-10da-4969-92f7-3caad8837be9",
                                "sense_id": "217fb127-00cc-3eb8-966f-3ea17484f04d",
                                "text": "„Unter diesen Umständen bedeutete es für Margot eine große Chance, dass sie wenigstens die Hilfsschule besuchen durfte.“"
                            },
                            {
                                "example_id": "5834f431-dc9e-4f63-bc2a-4d4516e8426b",
                                "sense_id": "217fb127-00cc-3eb8-966f-3ea17484f04d",
                                "text": "„Auf der Höhe der Hilfsschule, dem »Margarinegymnasium«, überholte uns Robert.“"
                            },
                            {
                                "example_id": "1fc852a6-49bf-497f-8bd3-1d82a1570bf3",
                                "sense_id": "217fb127-00cc-3eb8-966f-3ea17484f04d",
                                "text": "„Heinzelmann Scholz besuchte, wie seine sämtlichen schulpflichtigen Geschwister, die Hilfsschule, und obwohl ihm dort bereits seit drei Jahren Lesen und Schreiben beigebracht wurden, war er dieser Künste niemals mächtig geworden.“"
                            },
                            {
                                "example_id": "e3794530-7297-4838-b255-9106df8eebc1",
                                "sense_id": "217fb127-00cc-3eb8-966f-3ea17484f04d",
                                "text": "„Zur Schule brachen alle Kinder gemeinsam auf, und auf halbem Weg bogen die ab, die zur Hilfsschule mussten.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
