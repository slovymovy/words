                                "target_senses": [
                                    {
                                        "sense_id": "4a287b95-5d75-3641-94b4-fb7018d77191",
                                        "entry_id": "801fe148-079e-3dde-bb1e-44e3d66e3e16",
                                        "glosses": [
                                            "Qui sort."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8fcfce41-0538-47be-86a7-dfa420ee25fc",
                                                "sense_id": "4a287b95-5d75-3641-94b4-fb7018d77191",
                                                "text": "Numéros sortants, Les numéros gagnants au tirage d’une loterie."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3007d657-58e8-30f7-8451-5a3e168bf571",
                                        "entry_id": "801fe148-079e-3dde-bb1e-44e3d66e3e16",
                                        "glosses": [
                                            "Qui termine un mandat électif, et doit être remplacé ou réélu."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "23ee8e06-94fb-4287-a186-99167278ec2b",
                                                "sense_id": "3007d657-58e8-30f7-8451-5a3e168bf571",
                                                "text": "En ouvrant la séance, M. Hibon, président sortant, adresse ses remerciements pour le grand honneur, qui, dit-il, fut fait à un amateur de présider les travaux de la Société en 1936, puis il prie M. Allorge de lui succéder au fauteuil présidentiel."
                                            },
                                            {
                                                "example_id": "323020cc-2852-4dcf-b033-e08674fd4189",
                                                "sense_id": "3007d657-58e8-30f7-8451-5a3e168bf571",
                                                "text": "Sans égard excessif pour l’équipe sortante, dont quelques piliers sont encore à ses côtés, il s’avoue surpris par le nombre de « projets encarafés » qu’il a découverts dans les placards du palais Rohan."
                                            },
                                            {
                                                "example_id": "a017efee-c261-4725-8c26-cb8309a60e8f",
                                                "sense_id": "3007d657-58e8-30f7-8451-5a3e168bf571",
                                                "text": "Cinq personnes sont mortes dans ces violences que le président républicain sortant est accusé d'avoir encouragées par ses déclarations."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2b0a007e-1708-3a26-9d6a-1514363b6bca",
                                        "entry_id": "801fe148-079e-3dde-bb1e-44e3d66e3e16",
                                        "glosses": [
                                            "Qualifie un angle plus petit qu’un angle plat."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a5c1df84-121b-4245-abaa-ff3c23649726",
                                                "sense_id": "2b0a007e-1708-3a26-9d6a-1514363b6bca",
                                                "text": "Le plafond, de bois de cèdre, offre les combinaisons mathématiques si familières aux architectes arabes : tous les morceaux sont ajustés de façon à ce que leurs angles sortants ou rentrants forment une variété infinie de dessins."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sortant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "d230231d-3ce6-3f2b-bafc-9384ec5db3ff",
                                        "entry_id": "f84688e0-f4cd-3d44-92a3-d6d1fe3f350e",
                                        "glosses": [
                                            "Personne qui sort d’un effectif, qui cesse d’appartenir à un groupe."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "da1087d1-8d73-4d69-83ef-66bacc3714ec",
                                                "sense_id": "d230231d-3ce6-3f2b-bafc-9384ec5db3ff",
                                                "text": "Les entrants et les sortants."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c26345e5-b782-386e-9dc7-77fe755fcab0",
                                        "entry_id": "f84688e0-f4cd-3d44-92a3-d6d1fe3f350e",
                                        "glosses": [
                                            "Élu dont le mandat vient à terme."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "205edd32-4e08-4e66-829b-f0ae98d02108",
                                                "sense_id": "c26345e5-b782-386e-9dc7-77fe755fcab0",
                                                "text": "Olivier Faure, le sortant, affronte Nicolas Mayer-Rossignol, maire de Rouen (Seine-Maritime)."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "sortant",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4912f302-7834-392e-b8b2-bbce9e79a73c",
                                        "entry_id": "245b7bfe-78b6-3e37-aefc-4aa3011b0957",
                                        "glosses": [
                                            "Participe présent de sortir."
                                        ],
                                        "tags": [
                                            "form-of"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a2398759-6128-477a-8ea7-fb51dac67254",
                                                "sense_id": "4912f302-7834-392e-b8b2-bbce9e79a73c",
                                                "text": "Je me vengerai, dit-il en se promenant à grands pas, elle en mourra de honte : je la peindrai ! oui, je la représenterai sous les traits de Messaline sortant à la nuit du palais de Claude."
                                            },
                                            {
                                                "example_id": "0ef600d1-c6e1-4c46-bd6d-6b8c675c33cd",
                                                "sense_id": "4912f302-7834-392e-b8b2-bbce9e79a73c",
                                                "text": "Prenez 500 gr. de pâte à baba, déjà levée, rompez-la et avec elle emplissez à moitié des petits moules à baba beurrés, rangez les moules sur des plaques, faites lever la pâte jusqu’à la hauteur des bords et cuisez-les à four chaud; en les sortant du four, siropez les gâteaux avec un sirop au Madère chaud ou au rhum, en les trempant entièrement, et faites-les égoutter sur une grille."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
