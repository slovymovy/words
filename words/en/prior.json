{
    "word_family": [
        "priority",
        "prioritize",
        "priory"
    ],
    "entries": [
        {
            "pos": "adjective",
            "senses": [
                {
                    "sense_id": "c92b9f1a-1f3a-30ee-b205-aa8dc2681f32",
                    "sense_definition": "Existing or happening before something else in time or order.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_order",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "I had no <w>prior</w> knowledge that you were coming to visit.",
                            "target_lang_translations": {
                                "ru": "У меня не было <w>предварительной</w> информации о том, что вы собираетесь приехать.",
                                "zh": "我没有收到你来访的<w>预先</w>通知。"
                            }
                        },
                        {
                            "text": "The job requires <w>prior</w> experience in a similar role.",
                            "target_lang_translations": {
                                "ru": "Для этой работы требуется <w>предыдущий</w> опыт на аналогичной должности.",
                                "zh": "这份工作需要相关职位的<w>先前</w>经验。"
                            }
                        }
                    ],
                    "synonyms": [
                        "previous",
                        "earlier",
                        "former",
                        "preceding",
                        "past",
                        "advance"
                    ],
                    "common_phrases": [
                        "prior knowledge",
                        "prior agreement",
                        "prior notice",
                        "prior engagement",
                        "without prior warning"
                    ],
                    "target_lang_definitions": {
                        "ru": "Существующий или происходящий раньше чего-либо другого во времени или порядке.",
                        "zh": "在时间或顺序上先于某事存在或发生。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "предварительный",
                                "target_lang_sense_clarification": "происходящий заранее (напр. соглашение, уведомление)"
                            },
                            {
                                "target_lang_word": "предшествующий",
                                "target_lang_sense_clarification": "идущий перед чем-то"
                            },
                            {
                                "target_lang_word": "предыдущий",
                                "target_lang_sense_clarification": "бывший ранее"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先前的",
                                "target_lang_sense_clarification": "指在时间上更早的"
                            },
                            {
                                "target_lang_word": "预先的",
                                "target_lang_sense_clarification": "指事先准备或发生的"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "07d6428b-8a4f-3418-a99a-2a5bc3886d7a",
                    "sense_definition": "More important or significant than something else.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "importance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She felt she had a <w>prior</w> claim to the inheritance.",
                            "target_lang_translations": {
                                "ru": "Она чувствовала, что у нее есть <w>преимущественное</w> право на наследство.",
                                "zh": "她认为自己对这份遗产拥有<w>优先</w>继承权。"
                            }
                        },
                        {
                            "text": "Family obligations are <w>prior</w> to social events for him.",
                            "target_lang_translations": {
                                "ru": "Семейные обязанности для него <w>важнее</w> светских мероприятий.",
                                "zh": "对他来说，家庭责任比社交活动更<w>优先</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "prior claim",
                        "prior obligation"
                    ],
                    "target_lang_definitions": {
                        "ru": "Более важный или значимый, чем что-либо другое.",
                        "zh": "比其他事物更重要或更具意义。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "преимущественный",
                                "target_lang_sense_clarification": "имеющий преимущество или приоритет"
                            },
                            {
                                "target_lang_word": "первоочередной",
                                "target_lang_sense_clarification": "более важный по очередности"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优先的",
                                "target_lang_sense_clarification": "具有优先权或更重要的"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "adverb",
            "senses": [
                {
                    "sense_id": "e505f295-b0da-3734-bc62-52c282a09e6c",
                    "sense_definition": "In advance; at an earlier time.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "time_adv",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please arrive at the airport two hours <w>prior</w> to your flight.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, приезжайте в аэропорт за два часа <w>до</w> вылета.",
                                "zh": "请在航班起飞两小时<w>之前</w>到达机场。"
                            }
                        },
                        {
                            "text": "The problem had been identified three months <w>prior</w>.",
                            "target_lang_translations": {
                                "ru": "Проблема была выявлена тремя месяцами <w>ранее</w>.",
                                "zh": "这个问题在三个月<w>之前</w>就已经被发现了。"
                            }
                        }
                    ],
                    "synonyms": [
                        "ago"
                    ],
                    "common_phrases": [
                        "prior to",
                        "immediately prior",
                        "weeks prior"
                    ],
                    "target_lang_definitions": {
                        "ru": "Заранее; в более раннее время.",
                        "zh": "预先；在更早的时间。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "до",
                                "target_lang_sense_clarification": "предлог, указывающий на предшествование (prior to)"
                            },
                            {
                                "target_lang_word": "ранее",
                                "target_lang_sense_clarification": "наречие времени"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "在……之前",
                                "target_lang_sense_clarification": "用于表示时间上的先后顺序"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "4cf0341d-f0b9-3560-8fd8-8ec9ac8e30aa",
                    "sense_definition": "A previous criminal conviction or arrest recorded on someone's file.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "law",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The suspect has two <w>priors</w> for theft in another state.",
                            "target_lang_translations": {
                                "ru": "У подозреваемого есть две <w>судимости</w> за кражу в другом штате.",
                                "zh": "该嫌疑人在外州有两次盗窃<w>前科</w>。"
                            }
                        },
                        {
                            "text": "Since he had no <w>priors</w>, the judge gave him a lighter sentence.",
                            "target_lang_translations": {
                                "ru": "Поскольку у него не было <w>судимостей</w>, судья вынес ему более мягкий приговор.",
                                "zh": "由于他没有<w>前科</w>，法官对他从轻发落。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "have priors",
                        "check for priors",
                        "no priors"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "law enforcement jargon"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Предыдущая судимость или арест, зафиксированные в чьем-либо досье.",
                        "zh": "某人档案中记录的先前刑事定罪或逮捕记录。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "судимость",
                                "target_lang_sense_clarification": "факт осуждения в прошлом"
                            },
                            {
                                "target_lang_word": "привод",
                                "target_lang_sense_clarification": "разг. задержание полицией"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "前科",
                                "target_lang_sense_clarification": "指过去的犯罪记录"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5fbef0f4-7e11-3ceb-bd59-116b261ed9c4",
                    "sense_definition": "A high-ranking officer in a monastery or religious order, usually ranking next below an abbot.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "religion",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The <w>prior</w> was responsible for the daily management of the abbey.",
                            "target_lang_translations": {
                                "ru": "<w>Приор</w> отвечал за повседневное управление аббатством.",
                                "zh": "<w>副院长</w>负责修道院的日常管理工作。"
                            }
                        },
                        {
                            "text": "The monks gathered to elect a new <w>prior</w> after the death of the old one.",
                            "target_lang_translations": {
                                "ru": "Монахи собрались, чтобы избрать нового <w>приора</w> после смерти старого.",
                                "zh": "老院长去世后，僧侣们聚集在一起选举新的<w>副院长</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "dean",
                        "provost"
                    ],
                    "common_phrases": [
                        "grand prior",
                        "prior of the abbey"
                    ],
                    "target_lang_definitions": {
                        "ru": "Высокопоставленный служитель в монастыре или религиозном ордене, обычно второй после аббата.",
                        "zh": "修道院或宗教团体中的高级神职人员，通常地位仅次于院长。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "приор",
                                "target_lang_sense_clarification": "титул настоятеля"
                            },
                            {
                                "target_lang_word": "настоятель",
                                "target_lang_sense_clarification": "глава монастыря"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "副院长",
                                "target_lang_sense_clarification": "修道院中的高级职位"
                            },
                            {
                                "target_lang_word": "修道院院长",
                                "target_lang_sense_clarification": "指修道院的负责人"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f36e3fa0-aa8f-323d-8f82-be203992fd8d",
                    "sense_definition": "A probability distribution adopted before seeing new data or evidence.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "statistics",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We need to establish a <w>prior</w> before we can run the statistical model.",
                            "target_lang_translations": {
                                "ru": "Нам нужно установить <w>априорное распределение</w>, прежде чем мы сможем запустить статистическую модель.",
                                "zh": "在运行统计模型之前，我们需要设定一个<w>先验分布</w>。"
                            }
                        },
                        {
                            "text": "The new evidence forced the scientist to update his <w>priors</w>.",
                            "target_lang_translations": {
                                "ru": "Новые доказательства заставили ученого обновить свои <w>априорные вероятности</w>.",
                                "zh": "新的证据迫使科学家更新了他的<w>先验概率</w>。"
                            }
                        }
                    ],
                    "antonyms": [
                        "posterior"
                    ],
                    "common_phrases": [
                        "informative prior",
                        "update priors"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "technical"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Распределение вероятностей, принятое до получения новых данных или доказательств.",
                        "zh": "在看到新数据或证据之前所采用的概率分布。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "априорное распределение",
                                "target_lang_sense_clarification": "статистический термин"
                            },
                            {
                                "target_lang_word": "априорная вероятность",
                                "target_lang_sense_clarification": "вероятность до опыта"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "先验分布",
                                "target_lang_sense_clarification": "统计学中的先验概率分布"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "name",
            "senses": [
                {
                    "sense_id": "c1dc30ea-7b74-3544-9345-69b155403759",
                    "sense_definition": "A surname originating as an occupation for someone employed by a prior.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "name_surname",
                    "name_type": "person_name",
                    "examples": [
                        {
                            "text": "Mr. <w>Prior</w> has been working at the bank for twenty years.",
                            "target_lang_translations": {
                                "ru": "Мистер <w>Прайор</w> работает в банке уже двадцать лет.",
                                "zh": "<w>普赖尔</w>先生在银行工作已经二十年了。"
                            }
                        },
                        {
                            "text": "I went to school with a girl named Sarah <w>Prior</w>.",
                            "target_lang_translations": {
                                "ru": "Я учился в школе с девочкой по имени Сара <w>Прайор</w>.",
                                "zh": "我上学时有个同学叫莎拉·<w>普赖尔</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "surname",
                            "comment": ""
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Фамилия, происходящая от названия должности служащего при приоре.",
                        "zh": "一种源于受雇于副院长的人的职业的姓氏。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "Прайор",
                                "target_lang_sense_clarification": "фамилия"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "普赖尔",
                                "target_lang_sense_clarification": "姓氏音译"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8510155b-d77b-3118-8e3e-26283e2297da",
                    "sense_definition": "An unincorporated community in Douglas County, Missouri, United States.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "name_place",
                    "name_type": "place_name",
                    "examples": [
                        {
                            "text": "They drove through the small community of <w>Prior</w> on their road trip.",
                            "target_lang_translations": {
                                "ru": "Во время поездки они проехали через небольшую общину <w>Прайор</w>.",
                                "zh": "他们在公路旅行中开车穿过了<w>普赖尔</w>这个小社区。"
                            }
                        },
                        {
                            "text": "My grandfather was born in a farmhouse near <w>Prior</w>.",
                            "target_lang_translations": {
                                "ru": "Мой дедушка родился на ферме недалеко от <w>Прайора</w>.",
                                "zh": "我祖父出生在<w>普赖尔</w>附近的一座农舍里。"
                            }
