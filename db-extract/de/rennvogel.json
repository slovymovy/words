                                                "sense_id": "556722b8-9d85-3e98-bdf4-4e5dfd4fa77f",
                                                "text": "De petits filets spéciaux permettent d’attraper le courvite isabelle et les gangas."
                                            },
                                            {
                                                "example_id": "4d1211ef-a544-4b61-b09c-90881977eef4",
                                                "sense_id": "556722b8-9d85-3e98-bdf4-4e5dfd4fa77f",
                                                "text": "Un courvite Isabelle avait hanté ces collines - un oiseau si rare qu'on n'en a pas vu plus d'une douzaine dans toute l'Angleterre."
                                            }
                                        ]
                                    }
