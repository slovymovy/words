                        "glosses": [
                            "großer Raum für die Ausübung des Fechtens/Fechtsports"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "436d1eab-6d74-4774-87cf-9668e3d357aa",
                                "sense_id": "3d1248d2-c07a-3f33-9e53-0c40051c8206",
                                "text": "„Darragon erkühnte sich, den Fechtsaal aufzusuchen, in dem sich dieser Fürst häufig zu seinem Vergnügen im Florettkampf übte.“"
                            },
                            {
                                "example_id": "69600971-75b4-4963-bbda-813a7d9b583f",
                                "sense_id": "3d1248d2-c07a-3f33-9e53-0c40051c8206",
                                "text": "„Das kalte und verräucherte Zimmer mit dem schäbigen Öfchen verwandelte sich in einen Fechtsaal, wo ein junger Mann und ein junges Mädchen ständig auf ihrer Hut, in steigender Erregung bis zum Morgen miteinander kämpften.“"
                            }
                        ],
