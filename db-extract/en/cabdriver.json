                    }
                ],
                "translations": [
                    {
                        "translation_id": "b2e21121-83e0-47c6-906a-02327e5d2390",
                        "source_entry_id": "65f36255-7ae5-3103-9e49-7bfedc7428e7",
                        "source_sense_description": "one who drives a taxi",
                        "target_lang_word": "taxichauffeur",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "taxichauffeur",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "461cd875-d9fa-3c4d-8f5c-a1ddd62c2540",
                                        "entry_id": "8fd7c8db-eb46-36d6-b6bd-ab321c4470ea",
                                        "glosses": [
                                            "iemand die beroepsmatig anderen vervoert in een auto"
                                        ],
                                        "tags": [
                                            "beroep"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "ea823db6-beee-431e-8a50-ad048dcd7988",
                                                "sense_id": "461cd875-d9fa-3c4d-8f5c-a1ddd62c2540",
                                                "text": "De taxichauffeur kwam gelukkig op tijd om nog de vlucht te kunnen halen."
                                            },
                                            {
                                                "example_id": "511c60aa-eab0-4e95-b5fc-36a5621d70de",
                                                "sense_id": "461cd875-d9fa-3c4d-8f5c-a1ddd62c2540",
                                                "text": "De eerste die ik sinds lange tijd sprak, afgezien van de weinige afgemeten woorden die ik aan het begin en het einde van de rit had gewisseld met mijn norse taxichauffeur, was een magere, donkere jongen in het nostalgische rode uniform van een piccolo."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bc486e13-0e1b-4799-a078-07e6e0d5a019",
                        "source_entry_id": "65f36255-7ae5-3103-9e49-7bfedc7428e7",
                        "source_sense_description": "one who drives a taxi",
                        "target_lang_word": "Taxifahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Taxifahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                        "entry_id": "b88ea0d3-ed26-3760-8ab2-37f943f76e64",
                                        "glosses": [
                                            "jemand, der beruflich ein Taxi fährt; der Fahrer eines Taxis"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6652a2ea-c88a-441a-958e-2b5375a73579",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "Der Taxifahrer war seinem Fahrgast beim Einsteigen behilflich."
                                            },
                                            {
                                                "example_id": "9f63835a-d4e5-447d-8e07-d35840352ac7",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Auch der Konsul sei inzwischen Taxifahrer geworden, erzählt er uns lachend.“"
                                            },
                                            {
                                                "example_id": "f3315127-9c1f-4f3b-b5d5-28c0bf6c5066",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Als die beiden Taxifahrer die Halle betraten, ging plötzlich alles so schnell, daß Perlmann, der doch die Stunden gezählt hatte, sich ganz unvorbereitet vorkam.“"
                                            },
                                            {
                                                "example_id": "f6b1a490-28ba-4445-b527-90f39b9cedd5",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Die Frau stieg aus und der Taxifahrer half ihr, die Kartons zu tragen.“"
                                            },
                                            {
                                                "example_id": "26076fde-ba99-428c-9ed3-92385254e062",
                                                "sense_id": "81b3c678-c45a-37f7-8fdf-2ebf13894983",
                                                "text": "„Sisi bedankte sich beim Taxifahrer und krabbelte müde aus dem Mercedes.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3132f74b-f613-4aaa-b817-76948a76c3df",
                        "source_entry_id": "65f36255-7ae5-3103-9e49-7bfedc7428e7",
                        "source_sense_description": "one who drives a taxi",
                        "target_lang_word": "Droschkenfahrer",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Droschkenfahrer",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "860545e9-fc0d-3b12-9303-ac24b9e6e368",
                                        "entry_id": "9b69dc29-73b1-3881-89d2-2edcfc5efe5f",
                                        "glosses": [
                                            "jemand, der eine (Auto-) oder (Pferde-)Droschke lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a6fdf517-05b5-45ed-aa39-23a52a4c3474",
                                                "sense_id": "860545e9-fc0d-3b12-9303-ac24b9e6e368",
                                                "text": "„Dann sah er den dicken Droschkenfahrer mit einem Gewehr auf das Pferd zugehen und schießen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "120e74d5-f815-4c10-b037-c8c35d429d4e",
                        "source_entry_id": "65f36255-7ae5-3103-9e49-7bfedc7428e7",
                        "source_sense_description": "one who drives a taxi",
                        "target_lang_word": "такси́ст",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "такси́ст",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "830b8dd8-7594-3eba-ae4e-2edce28fa0f5",
                                        "entry_id": "0bae5be3-b691-3693-99aa-e1a9880b07c4",
                                        "glosses": [
                                            "водитель такси"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "4cab2126-d9c8-40a3-b22b-de037241e4aa",
                                                "sense_id": "830b8dd8-7594-3eba-ae4e-2edce28fa0f5",
                                                "text": "— За́ город? — переспросил таксист и сразу заметно понаглел. — Семь с полтиной — повезу."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "2fe78a33-a7e8-4cdd-af19-68f2270909cc",
                        "source_entry_id": "65f36255-7ae5-3103-9e49-7bfedc7428e7",
                        "source_sense_description": "one who drives a carriage",
                        "target_lang_word": "Droschkenkutscher",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Droschkenkutscher",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                        "entry_id": "7636d6f3-df29-3038-97a7-e4f8f64d9eb2",
                                        "glosses": [
                                            "Person, die eine Droschke lenkt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d2f20f73-ee88-41bf-adfa-899a46512f97",
                                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                                "text": "„Denn aufgeregt waren die Droschkenkutscher an diesem Abend.“"
                                            },
                                            {
                                                "example_id": "a3e3c5cb-0547-46f6-ad68-1d6d89d3d4f3",
                                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                                "text": "„Es regnete an diesem Abend, und der Droschkenkutscher mußte das Verdeck hochziehen.“"
                                            },
                                            {
                                                "example_id": "eb8ede0b-0482-4284-a4ed-1aa8ed47ca5f",
                                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                                "text": "„Er mußte mehrmals seine Erzählung unterbrechen, um mit schneidender Stimme einen einäugigen Droschkenkutscher anzufahren, der alle Viertelstunden, triefend wie eine Dachrinne, hereinkam, um ihn zu einer nächtlichen Fahrt nach dem »schiefen Turm« aufzufordern.“"
                                            },
                                            {
                                                "example_id": "d36d4e5d-1b03-495c-bd6b-59002477e46a",
                                                "sense_id": "11b9bd96-5a9d-3d11-ade5-9dd0be0840f3",
                                                "text": "„Vor zwei Wochen noch pflegten die beiden Herren wie Droschkenkutscher zu fluchen, auf den Boden zu spucken, knallgelbe Schuhe und Jacken mit übertrieben auswattierten Schultern zu tragen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    }
                ],
