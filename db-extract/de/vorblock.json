                ],
                "senses": [
                    {
                        "sense_id": "822edf3e-97ff-3e31-8289-c6e86150e497",
                        "entry_id": "621fc764-96de-3a39-a6a6-d0b2ba0e46fb",
                        "glosses": [
                            "ein Zwischenprodukt in der Stahlproduktion"
                        ],
                        "tags": [
                            "Schwerindustrie"
                        ],
                        "examples": [
                            {
                                "example_id": "c77e43e5-167d-4b4d-a3ee-1c11f826743b",
                                "sense_id": "822edf3e-97ff-3e31-8289-c6e86150e497",
                                "text": "„Die Produkte des ersten Warmwalzvorgangs heißen Vorblock, Knüppel oder Bramme“"
                            },
                            {
                                "example_id": "5705d145-1fbf-4ed1-911d-b1c7c276c025",
                                "sense_id": "822edf3e-97ff-3e31-8289-c6e86150e497",
                                "text": "„Von Italimpianti Deutschland wurde ein neuer Temperaturausgleichsofen für die Vorblöcke geliefert.“"
                            },
                            {
                                "example_id": "f3af0993-b0f0-4d4f-bccd-3c78cf79dd21",
                                "sense_id": "822edf3e-97ff-3e31-8289-c6e86150e497",
                                "text": "„Die Norm gilt für Halbzeug (Vorblöcke, Vorbrammen, Knüppel), Stabstahl, Walzdraht, Breitflachstahl, warmgewalztes Blech und Band sowie für Freiform- und Gesenkschmiedestücke.“"
                            },
                            {
                                "example_id": "851d512a-4e4d-4197-90f1-6af1f0fb969e",
                                "sense_id": "822edf3e-97ff-3e31-8289-c6e86150e497",
                                "text": "„Da sind zunächst die Einsatzstoffe, Vorblöcke oder Knüppel, die in einem anderen Walzwerk hergestellt werden.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "b9108fe2-d576-35df-8883-17ae00723e85",
                        "entry_id": "621fc764-96de-3a39-a6a6-d0b2ba0e46fb",
                        "glosses": [
                            "Voranmeldung eines zu befahrenden Zugabschnittes"
                        ],
                        "tags": [
                            "Eisenbahn"
                        ],
                        "examples": [
                            {
                                "example_id": "9821c304-3fd9-4a61-9fbf-568685602000",
                                "sense_id": "b9108fe2-d576-35df-8883-17ae00723e85",
                                "text": "„Mit Eingang des Vorblocks ertönt ein langsam schlagender Wecker.“"
                            },
                            {
                                "example_id": "a1fcab3c-08e6-4cc6-8184-ca50718b0a54",
                                "sense_id": "b9108fe2-d576-35df-8883-17ae00723e85",
                                "text": "„Aber auch in automatisierten Anlagen kann durch einen Fehler der Technik der Vorblock ausbleiben.“"
                            },
                            {
                                "example_id": "94a820d8-61b0-4ad7-b4b8-4b0a3b3b6a32",
                                "sense_id": "b9108fe2-d576-35df-8883-17ae00723e85",
                                "text": "„Die Übertragung des Vorblocks ist nicht sicherheitsrelevant.“"
                            },
                            {
                                "example_id": "8790f3c1-0d2d-4191-958f-4aa1d03e01b9",
                                "sense_id": "b9108fe2-d576-35df-8883-17ae00723e85",
                                "text": "„Der Vorblock ist damit vollständig ausgelöst.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
