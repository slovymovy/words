                },
                {
                    "sense_id": "91c54db5-abff-3309-b7c1-59ac041200db",
                    "sense_definition": "Something very difficult, awkward, or frustrating to deal with.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "That heavy old wardrobe was a real <w>swine</w> to carry upstairs.",
                            "target_lang_translations": {
                                "ru": "Тащить этот тяжёлый старый шкаф наверх было <w>сущим мучением</w>."
                            }
                        },
                        {
                            "text": "This math problem is a complete <w>swine</w> to solve correctly.",
                            "target_lang_translations": {
                                "ru": "Правильно решить эту задачку по математике — <w>сплошная морока</w>."
