                "senses": [
                    {
                        "sense_id": "5509ec03-564a-3b07-aa9d-de99831d37e1",
                        "entry_id": "709a40cb-b9e5-3f8e-8f71-eecc9fb266ba",
                        "glosses": [
                            "Connecteur binaire (↔ ou ⇔) qui, à partir de deux formules, forme une troisième formule ; cette troisième formule."
                        ],
                        "tags": [
                            "rare"
                        ],
                        "examples": [
                            {
                                "example_id": "4c95fb2d-229d-4fd2-87a7-5e790c8aab29",
                                "sense_id": "5509ec03-564a-3b07-aa9d-de99831d37e1",
                                "text": "L’autre connecteur s’appelle bi-implication et peut se paraphraser par « on n’a pas A sans B et on n’a pas B sans A ». On le note « <=> »."
                            },
                            {
                                "example_id": "313fb8e0-1aba-495d-b57f-de6f7ae9e796",
                                "sense_id": "5509ec03-564a-3b07-aa9d-de99831d37e1",
                                "text": "L’équivalence est une relation entre formules tandis que la bi-implication est un connecteur (binaire) qui à partir de deux formules forme une nouvelle formule."
                            },
                            {
                                "example_id": "d6c798c9-bc84-47c4-9db9-f0485a01b2dd",
                                "sense_id": "5509ec03-564a-3b07-aa9d-de99831d37e1",
                                "text": "Lorsqu’une bi-implication est tautologique, on dit, dans le métalangage, que les deux membres de la bi-implication sont équivalents, ce qui revient à dire que ces deux membres prennent, pour toute interprétation des lettres de propositions la même valeur de vérité."
                            }
                        ]
                    }
