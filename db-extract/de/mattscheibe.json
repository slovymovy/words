                "senses": [
                    {
                        "sense_id": "cdc53a4a-3805-349a-912b-7ea186c334bc",
                        "entry_id": "35bbf549-0df6-3954-911b-fe6c89583d11",
                        "glosses": [
                            "lichtdurchlässige Scheibe, auf die bei optischen Kameras zur manuellen Scharfstellung das Bild projiziert wird"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "27312cc4-219a-4f75-92b5-1d89d9ad7c0e",
                                "sense_id": "cdc53a4a-3805-349a-912b-7ea186c334bc",
                                "text": "Die Mattscheibe dient zur manuellen Scharfstellung."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "298a07f6-3e62-3837-916f-a0339481fbdd",
                        "entry_id": "35bbf549-0df6-3954-911b-fe6c89583d11",
                        "glosses": [
                            "Bildschirm eines Fernsehapparates"
                        ],
                        "tags": [
                            "colloquial"
                        ],
                        "examples": [
                            {
                                "example_id": "b81320bc-a656-406e-8197-13ad09e17f04",
                                "sense_id": "298a07f6-3e62-3837-916f-a0339481fbdd",
                                "text": "Du kannst doch nicht den ganzen Tag vor der Mattscheibe sitzen."
                            },
                            {
                                "example_id": "598290f2-6a0a-4652-a849-d611f5cdae76",
                                "sense_id": "298a07f6-3e62-3837-916f-a0339481fbdd",
                                "text": "„Ich habe mir eine Kassette auf häuslicher Mattscheibe angeschaut; in Kinos läuft der Schwarzweißfilm schon lange nicht mehr.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
