                "senses": [
                    {
                        "sense_id": "8f9fb977-8b5b-3d52-8830-0d654daf03e9",
                        "entry_id": "58105637-f7d2-3073-849e-ece46dccf3e9",
                        "glosses": [
                            "Name in der Form einer Aussage"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "61d43a32-3fde-41c5-9c32-943d23fb7ce7",
                                "sense_id": "8f9fb977-8b5b-3d52-8830-0d654daf03e9",
                                "text": "„Bei den numidischen Namen handelt es sich um archaische Satznamen, in denen bestimmte Themenelemente varriiert werden (z. B. Namen wie ‚Mas-ilan‘ »der Herr (= Gott) hat zu eigen«, ‚Mas-elat‘ »Herr, nimm ihn zu eigen«, ‚Tak-malas‘ »der Herr ist sein Eigner« zur Verbwurzel ‚l‘ »in Besitz nehmen«.“"
                            },
                            {
                                "example_id": "4564d1e6-ad1b-40d7-88bb-04e896ec35ce",
                                "sense_id": "8f9fb977-8b5b-3d52-8830-0d654daf03e9",
                                "text": "„Die hebräischen Namen sind größtenteils Satznamen, die eine Aussage über Gott – Lobpreis, Dank – enthalten.“"
                            },
                            {
                                "example_id": "23457f88-d21c-4b02-b13c-84cd3966fd03",
                                "sense_id": "8f9fb977-8b5b-3d52-8830-0d654daf03e9",
                                "text": "„In den Bereich der aus Übernamen entstandenen Familiennamen führen folgende Satznamen: Schwingdenhammer für den Schmied, Machewurst für den Metzger oder Spannhaus für den Fuhrmann (…).“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
