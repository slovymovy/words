                                        "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "2422a1a8-4d63-40c0-ba70-eb82074f46ef",
                                                "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                                "text": "If you want sympathy you’ll find it in the dictionary between shit and syphilis. Sympathy may pay well in the short term, but if you cash in on sympathy, it will take everything from you in the long run."
                                            },
                                            {
                                                "example_id": "d736a7e1-0a90-4c8d-aa2c-a8f81326d5be",
                                                "sense_id": "1cb25a47-5201-31c0-9cd7-c2de5d4b4329",
                                                "text": "And all told, Trump’s second term has actually led to the most sympathy for migrants on record in the 21st century, per Gallup. Fully 79% of Americans now say immigration is a “good thing,” compared with 64% last year."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a4f72a97-d2cf-3a55-afd5-2c36a4868bf5",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another.",
                                            "The formal expression of pity or sorrow for someone else's misfortune."
                                        ],
                                        "tags": [
                                            "countable",
                                            "in-plural",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "e8675a03-92fa-4b36-90d3-1d2076872d91",
                                                "sense_id": "a4f72a97-d2cf-3a55-afd5-2c36a4868bf5",
                                                "text": "While you'll probably have her sympathies if your condominium association wants to preapprove your storm door, you'll need to work harder for her support if your boss at the music megastore demands you grow a goatee to help lend the place some indie cred."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "311ea450-6930-3762-b20e-9c11c4a4ddd3",
                                        "entry_id": "82869e33-dda5-3619-80e2-1bc567bb2777",
                                        "glosses": [
                                            "A feeling of pity or sorrow for the suffering or distress of another.",
                                            "The ability to share the feelings of another."
                                        ],
                                        "tags": [
