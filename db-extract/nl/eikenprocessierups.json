                        "entry_id": "3c3df9c5-df0a-3677-bc5e-86814d03fd0d",
                        "glosses": [
                            "larve van de eikenprocessievlinder Thaumetopoea processionea, een plaaginsect waarvan de rups voor de mens gevaarlijke brandharen heeft"
                        ],
                        "tags": [
                            "vlinders"
