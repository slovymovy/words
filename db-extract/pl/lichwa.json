                    }
                ],
                "translations": [
                    {
                        "translation_id": "eb08fab4-25b3-444c-8178-e5338f2d4541",
                        "source_entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
                        "source_sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                        "target_lang_word": "usury",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usury",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1da6602e-415e-3655-97aa-a8fd3d5882c8",
                                        "entry_id": "f8539936-45f5-3f91-be52-96b3e577cd6a",
                                        "glosses": [
                                            "An exorbitant rate of interest, in excess of any legal rates or at least immorally."
                                        ],
                                        "tags": [
                                            "countable"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54c0aa52-dbe4-3d27-bcfd-8424cd24c2fa",
                                        "entry_id": "f8539936-45f5-3f91-be52-96b3e577cd6a",
                                        "glosses": [
                                            "The practice of lending money at such rates."
                                        ],
                                        "tags": [
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8cdeb294-54d7-48b7-8483-c85208cda367",
                                                "sense_id": "54c0aa52-dbe4-3d27-bcfd-8424cd24c2fa",
                                                "text": "As a practical matter, California usury laws do not seriously inconvenience most lenders, and offer little protection to most borrowers."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f3c9e65a-5007-30d1-9260-f768bc7fb74e",
                                        "entry_id": "f8539936-45f5-3f91-be52-96b3e577cd6a",
                                        "glosses": [
                                            "The practice of lending money at interest."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1e6db645-93fb-4dc5-b67e-a4adf874bbbc",
                                                "sense_id": "f3c9e65a-5007-30d1-9260-f768bc7fb74e",
                                                "text": "The most hated sort, and with the greatest reason, is usury, which makes a gain out of money itself, and not from the natural object of it. For money was intended to be used in exchange, but not to increase at interest."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "270394d2-0c85-3c21-8f5c-3d24e18fbef7",
                                        "entry_id": "f8539936-45f5-3f91-be52-96b3e577cd6a",
                                        "glosses": [
                                            "Profit."
                                        ],
                                        "tags": [
                                            "obsolete",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6160cb3f-5420-4b6b-ade1-afff7639e1d4",
                                                "sense_id": "270394d2-0c85-3c21-8f5c-3d24e18fbef7",
                                                "text": "Then will we march to all thoſe Indian Mines,\nMy witleſſe brother to the Chriſtians loſt:\nAnd ranſome them with fame and vſurie."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "224f660a-7c8e-4308-9f8e-7f64a0df3a97",
                        "source_entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
                        "source_sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                        "target_lang_word": "lichva",
                        "target_lang_code": "cs",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "lichva",
                                "target_lang_code": "cs",
                                "target_senses": [
                                    {
                                        "sense_id": "d3e9e6cd-52a3-35be-aed2-f981911ea283",
                                        "entry_id": "dcf08bff-87d6-3288-aa8e-69d89fface73",
                                        "glosses": [
                                            "nepřiměřené obohacování, zejména pomocí vysokých úroků"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ce3b2ef1-840a-4a20-aa68-f9052addd7c0",
                                                "sense_id": "d3e9e6cd-52a3-35be-aed2-f981911ea283",
                                                "text": "Ale nyní svět, aby lichva hříchem byla, nechce."
                                            },
                                            {
                                                "example_id": "cebebc27-074a-4301-b5c2-cf6377e9bc32",
                                                "sense_id": "d3e9e6cd-52a3-35be-aed2-f981911ea283",
                                                "text": "„Je třeba pomoci proti pijavce lichvě, dobře někdy lisem Židy prohnat, ač ne do krve,“ bylo pravidlem tenkrát lidí nejdobromyslnějších."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "51ea81c4-80da-3a02-973c-599309efc5e4",
                                        "entry_id": "dcf08bff-87d6-3288-aa8e-69d89fface73",
                                        "glosses": [
                                            "zneužití tísně, nezkušenosti, rozumové slabosti, rozrušení nebo lehkomyslnosti druhého k vlastnímu obohacení se na jeho účet prostřednictvím právního jednání"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f98a594e-3e90-4849-897b-cbcd1e1fd8b6",
                        "source_entry_id": "af06a4dd-7795-3579-a8ce-89b55a257a66",
                        "source_sense_id": "51532904-6889-3b5a-b342-51a9c9581306",
                        "target_lang_word": "usure",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "usure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "b6b73266-74e3-3be4-9b13-06020629602f",
                                        "entry_id": "7519ae50-375a-3102-88f4-a659efcefc87",
                                        "glosses": [
                                            "Intérêt, profit qu’on exige d’un argent ou d’une marchandise prêtée, au-dessus du taux fixé par la loi ou établi par l’usage en matière de commerce."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "28dabd28-2f8c-4eb0-a682-f0ba5a2b51b1",
                                                "sense_id": "b6b73266-74e3-3be4-9b13-06020629602f",
                                                "text": "Oui, dit le chevalier, pour ronger les entrailles de nos nobles par l’usure, et pour tromper nos femmes et nos enfants avec des joyaux et des babioles ; […]."
                                            },
                                            {
                                                "example_id": "31c01f57-a338-4c43-8a0d-829eb5cbb2ac",
                                                "sense_id": "b6b73266-74e3-3be4-9b13-06020629602f",
                                                "text": "Mais nous avons vu comment Saint Louis, poussé par ses convictions religieuses, voulut rendre l'usure impraticable."
                                            },
                                            {
                                                "example_id": "53365269-5136-403c-b8b5-2a7f42a67e59",
                                                "sense_id": "b6b73266-74e3-3be4-9b13-06020629602f",
                                                "text": "En résumé donc la définition que l’auteur donne de l’usure, — « l’accaparement subreptice, au nom du capital, de la partie des bénéfices destinée à rémunérer soit les autres parties du capital, soit le travail » — est aussi vague, aussi incolore que toutes les définitions hasardées par d’autres écrivains."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "usure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "7d41807b-fafb-37cb-87e1-7d96af85a7d6",
                                        "entry_id": "11d38ba6-83a0-3cf6-a7fe-be316da6a5a5",
                                        "glosses": [
                                            "Dépérissement, détérioration des parties mécaniques, des habits, des meubles, des organes du corps humain, etc., par suite d’un long usage."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1436daa0-5da2-446b-8b07-d77804298bef",
                                                "sense_id": "7d41807b-fafb-37cb-87e1-7d96af85a7d6",
                                                "text": "Le vieillard devait avoir soixante-dix ans, […]. On devinait dans ce corps rachitique une effrayante usure de tous les rouages organiques."
                                            },
                                            {
                                                "example_id": "6b0ec22d-b1cc-4bbb-ba7e-943b76abfc92",
                                                "sense_id": "7d41807b-fafb-37cb-87e1-7d96af85a7d6",
                                                "text": "Le complet de serge laissait voir maintes traces d’usure, et les entournures trop larges faisaient paraître l’homme plus robuste qu’il n’était en réalité."
                                            },
                                            {
                                                "example_id": "cbb1946f-0542-4c63-a65a-fda3482be2bd",
                                                "sense_id": "7d41807b-fafb-37cb-87e1-7d96af85a7d6",
                                                "text": "La misère s’était implantée à demeure ; elle allait s’aggravant à chaque nouvel enfant, et l’usure et le découragement de mes parents rendaient de plus en plus fréquents les jours de famine et de détresse."
                                            },
                                            {
                                                "example_id": "9297b940-8eac-414f-8788-4a8bc89d8527",
                                                "sense_id": "7d41807b-fafb-37cb-87e1-7d96af85a7d6",
                                                "text": "Sa cravate montrait des signes d’usure et il s’habillait en drap recardé que la première pluie décatissait."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "910c257f-0c65-36d4-87b9-1c7c5cc09048",
                                        "entry_id": "11d38ba6-83a0-3cf6-a7fe-be316da6a5a5",
                                        "glosses": [
                                            "Dégradation d'une surface sous l'effet du frottement."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "usure",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "492cb8ad-ead6-3caa-8f34-0c6693ec399e",
