                ],
                "senses": [
                    {
                        "sense_id": "f06fa696-d322-3d4f-9878-965a34153aef",
                        "entry_id": "f817a925-6ed6-3eb2-9e69-b4fcdef3c314",
                        "glosses": [
                            "politisches Organ (Regierung), das legitim ein Territorium lenkt und vertritt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "3d4620a8-bc83-4239-a397-6593c81c218f",
                                "sense_id": "f06fa696-d322-3d4f-9878-965a34153aef",
                                "text": "„Des weiteren darf kein Unterschied gemacht werden auf Grund der politischen, rechtlichen oder internationalen Stellung des Landes oder Gebiets, dem eine Person angehört, gleichgültig ob dieses unabhängig ist, unter Treuhandschaft steht, keine Selbstregierung besitzt oder sonst in seiner Souveränität eingeschränkt ist.“"
                            },
                            {
                                "example_id": "1fbcaa9b-1104-4c01-9c5d-4338e37e891f",
                                "sense_id": "f06fa696-d322-3d4f-9878-965a34153aef",
                                "text": "Auch Gibraltar steht auf der Liste der Hoheitsgebiete ohne Selbstregierung im Sinne des Art. 73 der Charta der Vereinten Nationen."
                            },
                            {
                                "example_id": "9b011bf5-fc7a-408c-af47-2a4d4de93e29",
                                "sense_id": "f06fa696-d322-3d4f-9878-965a34153aef",
                                "text": "„Anstelle von „self-government“ wurde im deutschsprachigen Raum von Selbstregierung, Selbstverwaltung oder Mitverantwortung gesprochen. Die Verwendung solcher Begriffe sagt aber nichts über den demokratischen Gehalt der Konzepte aus […].“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "082b2f83-ea01-3862-adbf-4f532925f12c",
                        "entry_id": "f817a925-6ed6-3eb2-9e69-b4fcdef3c314",
                        "glosses": [
                            "Umstand, sich (völkerrechtlich anerkannt) als Territorium selbständig mit einer eigenen Regierung zu verwalten"
                        ],
                        "tags": [
                            "no-plural"
                        ],
                        "examples": [
                            {
                                "example_id": "18fe1bbd-3417-4e1b-9ce7-ed27964e74ec",
                                "sense_id": "082b2f83-ea01-3862-adbf-4f532925f12c",
                                "text": "„Anstelle von „self-government“ wurde im deutschsprachigen Raum von Selbstregierung, Selbstverwaltung oder Mitverantwortung gesprochen. Die Verwendung solcher Begriffe sagt aber nichts über den demokratischen Gehalt der Konzepte aus […].“"
                            },
                            {
                                "example_id": "423b05f4-7ecc-4bbb-a3c2-a99acdfe2b60",
                                "sense_id": "082b2f83-ea01-3862-adbf-4f532925f12c",
                                "text": "„Die Selbstregierung ist in Aller Munde, aber es fehlt viel, dass man sich auch überall ihr Wesen klar machte. Es giebt keine Selbstregierung, wenn sie nicht auf die Souverainetät des Einzelnen zurückgeführt wird.“ (1868)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    },
                    {
                        "sense_id": "ec075354-7031-348f-a6f9-0448a1dab4b2",
                        "entry_id": "f817a925-6ed6-3eb2-9e69-b4fcdef3c314",
                        "glosses": [
                            "Steuerung der Gemeinschaft (des Staates) durch alle Mitglieder der Gemeinschaft"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5c8d2bf0-7301-4528-bea4-ac1f08657163",
                                "sense_id": "ec075354-7031-348f-a6f9-0448a1dab4b2",
                                "text": "„Die Selbstregierung ist in Aller Munde, aber es fehlt viel, dass man sich auch überall ihr Wesen klar machte. Es giebt keine Selbstregierung, wenn sie nicht auf die Souverainetät des Einzelnen zurückgeführt wird.“ (1868)"
                            },
                            {
                                "example_id": "7e583868-1510-4015-b91a-0049fe995cc0",
                                "sense_id": "ec075354-7031-348f-a6f9-0448a1dab4b2",
                                "text": "„Ist es nicht die alte ultra-aristokratische Lehre, daß der Mensch zur Selbstregierung unfähig ist? Ihr behauptet, jene Leute seien der Selbstregierung unfähig, und nehmt das Recht in Anspruch, über sie zu regieren.“"
                            }
                        ],
                        "sense_index_json": "\"3\""
                    }
                ],
