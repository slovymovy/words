                "senses": [
                    {
                        "sense_id": "ecb4f84a-e19e-30d0-b530-f636eb0a56f3",
                        "entry_id": "e494ea2f-2e77-3d32-b711-8777e1aee9c5",
                        "glosses": [
                            "waarvan men droomt, maar niet op de werkelijkheid is gebaseerd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f0e29006-729c-49e8-82d5-76b75ffb341a",
                                "sense_id": "ecb4f84a-e19e-30d0-b530-f636eb0a56f3",
                                "text": "„Deze mensen zijn in de greep van dromerijen, meestal van linkse aard, over de ineenstorting van het kapitalisme. Het is ook een vorm van indoctrinatie die niets met de werkelijkheid te maken heeft”, schrijft iemand."
                            },
                            {
                                "example_id": "7cc88382-3002-4e60-be18-d6faa3d17ebb",
                                "sense_id": "ecb4f84a-e19e-30d0-b530-f636eb0a56f3",
                                "text": "Er viel na jaren van harde bezuinigingen ook veel te kiezen. Voor linkse dromerij, voor verzet tegen de gevestigde orde, voor geldsmijterij, of voor ervaring. Nu komt het erop aan dat partijen in de komende formatie zorgvuldig omgaan met de belangen van de kiezers en zich niet verliezen in een overhaaste uitruil, zoals in 2012."
                            },
                            {
                                "example_id": "93ebe142-d4f1-4ee0-b51e-f31bc3c0fb46",
                                "sense_id": "ecb4f84a-e19e-30d0-b530-f636eb0a56f3",
                                "text": "Ach, wat heb je nodig om gelukkig te zijn? Een bij, een klavertje en wat dromerijen?"
                            }
                        ]
                    }
                ],
