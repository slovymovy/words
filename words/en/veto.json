{
    "word_family": [
        "vetoable",
        "vetoer"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "d232fa6f-a535-3667-b85c-d3aaf2ae756f",
                    "sense_definition": "The official right or power to stop a decision, law, or plan from being accepted or put into action.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president has the power of <w>veto</w> over any legislation passed by congress.",
                            "target_lang_translations": {
                                "ru": "Президент обладает <w>правом вето</w> в отношении любого закона, принятого конгрессом.",
                                "zh": "总统对国会通过的任何立法都拥有<w>否决权</w>。"
                            }
                        },
                        {
                            "text": "Several members of the council threatened to use their <w>veto</w> to block the proposal.",
                            "target_lang_translations": {
                                "ru": "Несколько членов совета угрожали воспользоваться своим <w>правом вето</w>, чтобы заблокировать предложение.",
                                "zh": "几名理事会成员威胁要行使<w>否决权</w>来阻止该提案。"
                            }
                        }
                    ],
                    "synonyms": [
                        "prohibition",
                        "ban"
                    ],
                    "antonyms": [
                        "approval",
                        "ratification"
                    ],
                    "common_phrases": [
                        "power of veto",
                        "exercise a veto",
                        "right of veto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальное право или полномочие остановить принятие решения, закона или плана.",
                        "zh": "指官方拥有阻止某项决定、法律或计划被采纳或实施的权利或权力。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "право вето",
                                "target_lang_sense_clarification": "политическое право"
                            },
                            {
                                "target_lang_word": "вето",
                                "target_lang_sense_clarification": "полномочие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否决权",
                                "target_lang_sense_clarification": "政治上的否决权力"
                            },
                            {
                                "target_lang_word": "否决",
                                "target_lang_sense_clarification": "否决的权力"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "b496cb96-fc09-3092-98f5-7067ab5a36af",
                    "sense_definition": "An official act of refusing to allow a law or decision to be made.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_power",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The governor issued a <w>veto</w> to prevent the new tax bill from becoming law.",
                            "target_lang_translations": {
                                "ru": "Губернатор наложил <w>вето</w>, чтобы предотвратить вступление в силу нового налогового законопроекта.",
                                "zh": "州长行使了<w>否决</w>权，以阻止新的税收法案生效。"
                            }
                        },
                        {
                            "text": "Legislators did not have enough votes to override the presidential <w>veto</w>.",
                            "target_lang_translations": {
                                "ru": "У законодателей не хватило голосов, чтобы преодолеть президентское <w>вето</w>.",
                                "zh": "立法者没有足够的票数来推翻总统的<w>否决</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "rejection",
                        "refusal"
                    ],
                    "antonyms": [
                        "endorsement",
                        "acceptance"
                    ],
                    "common_phrases": [
                        "override a veto",
                        "issue a veto",
                        "presidential veto"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официальный акт отказа утвердить закон или решение.",
                        "zh": "指拒绝批准某项法律或决定的官方行为。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вето",
                                "target_lang_sense_clarification": "акт отказа"
                            },
                            {
                                "target_lang_word": "наложение вето",
                                "target_lang_sense_clarification": "процесс"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否决",
                                "target_lang_sense_clarification": "拒绝批准的行为"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "bf3827a2-0efa-3303-9dfb-c2091b2734c7",
                    "sense_definition": "A strong prohibition or refusal given by someone in authority regarding a general matter.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "general_prohibition",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Her father put a strict <w>veto</w> on her staying out late with friends.",
                            "target_lang_translations": {
                                "ru": "Её отец наложил строгий <w>запрет</w> на её поздние прогулки с друзьями.",
                                "zh": "她父亲严厉<w>禁止</w>她和朋友在外面待到很晚。"
                            }
                        },
                        {
                            "text": "The manager's <w>veto</w> of the holiday party plan disappointed the entire staff.",
                            "target_lang_translations": {
                                "ru": "<w>Запрет</w> менеджера на план праздничной вечеринки разочаровал весь персонал.",
                                "zh": "经理对节日派对计划的<w>否决</w>让全体员工感到失望。"
                            }
                        }
                    ],
                    "synonyms": [
                        "interdiction",
                        "ban"
                    ],
                    "antonyms": [
                        "permission"
                    ],
                    "common_phrases": [
                        "put a veto on"
                    ],
                    "target_lang_definitions": {
                        "ru": "Строгий запрет или отказ со стороны авторитетного лица по общему вопросу.",
                        "zh": "指权威人士对一般事务作出的严厉禁止或拒绝。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запрет",
                                "target_lang_sense_clarification": "строгое ограничение"
                            },
                            {
                                "target_lang_word": "запрещение",
                                "target_lang_sense_clarification": "действие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "禁止",
                                "target_lang_sense_clarification": "严厉的限制"
                            },
                            {
                                "target_lang_word": "否决",
                                "target_lang_sense_clarification": "拒绝采纳某项提议"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "44120765-4a48-36e9-b0e6-0dbc74343365",
                    "sense_definition": "A mechanism or technique used in experiments to discard false positive results.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "scientific_mechanism",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The physics experiment utilized an active <w>veto</w> system to filter out cosmic ray interference.",
                            "target_lang_translations": {
                                "ru": "В физическом эксперименте использовалась активная система <w>вето</w> для отсеивания помех от космических лучей.",
                                "zh": "该物理实验利用主动<w>反符合</w>系统来过滤宇宙射线干扰。"
                            }
                        },
                        {
                            "text": "Researchers designed a <w>veto</w> to ensure that background noise did not affect the data.",
                            "target_lang_translations": {
                                "ru": "Исследователи разработали <w>вето</w> (систему блокировки), чтобы гарантировать, что фоновый шум не повлияет на данные.",
                                "zh": "研究人员设计了一种<w>屏蔽</w>机制，以确保背景噪音不会影响数据。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Механизм или методика, используемые в экспериментах для отсеивания ложноположительных результатов.",
                        "zh": "实验中用于剔除假阳性结果的机制或技术。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вето",
                                "target_lang_sense_clarification": "научный термин"
                            },
                            {
                                "target_lang_word": "система вето",
                                "target_lang_sense_clarification": "механизм блокировки"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "反符合",
                                "target_lang_sense_clarification": "物理实验中的屏蔽机制"
                            },
                            {
                                "target_lang_word": "屏蔽",
                                "target_lang_sense_clarification": "剔除干扰的机制"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "48d48424-3089-3271-9ce6-85930516ba1f",
                    "sense_definition": "To officially refuse to allow a law, decision, or plan to go ahead.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "political_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The president <w>vetoed</w> the bill because he believed it would harm the economy.",
                            "target_lang_translations": {
                                "ru": "Президент <w>наложил вето</w> на законопроект, так как считал, что он навредит экономике.",
                                "zh": "总统<w>否决</w>了该法案，因为他认为这会损害经济。"
                            }
                        },
                        {
                            "text": "Five permanent members of the council have the right to <w>veto</w> any resolution.",
                            "target_lang_translations": {
                                "ru": "Пять постоянных членов совета имеют право <w>наложить вето</w> на любую резолюцию.",
                                "zh": "理事会的五个常任理事国拥有对任何决议的<w>否决</w>权。"
                            }
                        }
                    ],
                    "synonyms": [
                        "reject",
                        "block",
                        "forbid"
                    ],
                    "antonyms": [
                        "approve",
                        "ratify",
                        "authorize"
                    ],
                    "common_phrases": [
                        "veto a bill",
                        "veto a decision",
                        "veto a resolution"
                    ],
                    "target_lang_definitions": {
                        "ru": "Официально отказать в принятии закона, решения или плана.",
                        "zh": "官方拒绝批准某项法律、决定或计划的实施。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наложить вето",
                                "target_lang_sense_clarification": "воспользоваться правом"
                            },
                            {
                                "target_lang_word": "ветировать",
                                "target_lang_sense_clarification": "юридический термин"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否决",
                                "target_lang_sense_clarification": "行使否决权"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "5edc694f-1ce1-3968-963c-d683aee843a6",
                    "sense_definition": "To stop a plan or suggestion from happening by refusing to give permission.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "general_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "My parents <w>vetoed</w> my idea of taking a gap year before college.",
                            "target_lang_translations": {
                                "ru": "Мои родители <w>отвергли</w> мою идею взять академический отпуск перед колледжем.",
                                "zh": "我父母<w>否决</w>了我大学前休学一年的想法。"
                            }
                        },
                        {
                            "text": "We wanted to eat Italian food, but our friends <w>vetoed</w> the suggestion.",
                            "target_lang_translations": {
                                "ru": "Мы хотели поесть итальянской еды, но наши друзья <w>отвергли</w> это предложение.",
                                "zh": "我们想吃意大利菜，但朋友们<w>驳回</w>了这个建议。"
                            }
                        }
                    ],
                    "synonyms": [
                        "quash",
                        "rule out",
                        "stop"
                    ],
                    "antonyms": [
                        "allow",
                        "permit"
                    ],
                    "common_phrases": [
                        "veto a plan",
                        "veto an idea"
                    ],
                    "target_lang_definitions": {
                        "ru": "Остановить реализацию плана или предложения, отказав в разрешении.",
                        "zh": "通过拒绝给予许可来阻止某项计划或建议的实现。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запретить",
                                "target_lang_sense_clarification": "не дать разрешения"
                            },
                            {
                                "target_lang_word": "отвергнуть",
                                "target_lang_sense_clarification": "отказаться принимать"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "否决",
                                "target_lang_sense_clarification": "拒绝采纳建议"
                            },
                            {
                                "target_lang_word": "驳回",
                                "target_lang_sense_clarification": "拒绝接受提议"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}