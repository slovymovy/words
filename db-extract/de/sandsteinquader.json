                "senses": [
                    {
                        "sense_id": "6e7af690-a470-3ea4-a930-19ded304b58a",
                        "entry_id": "0ba34d19-12be-3fe2-837c-fc657ab1fb00",
                        "glosses": [
                            "der äußerlichen Gestalt (Form) nach einem Quader gleichendes Stück Sandstein"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30ae99c1-0c76-4f1f-b7ad-971d60801f54",
                                "sense_id": "6e7af690-a470-3ea4-a930-19ded304b58a",
                                "text": "„Wenige Schritte vom Weg ab, zwischen zwei Rebstöcken, steht ein Sandsteinquader, ein Grenzstein von 1826.“"
                            },
                            {
                                "example_id": "1232689d-9aae-4e63-823a-3e5f4a2a9d82",
                                "sense_id": "6e7af690-a470-3ea4-a930-19ded304b58a",
                                "text": "„Die mächtigen Sandsteinquader wurden vor ca. 3400 Jahren zusammengefügt und ab 1959 restauriert.“"
                            },
                            {
                                "example_id": "aa504153-2bcd-484c-9624-8cc5d2efcd10",
                                "sense_id": "6e7af690-a470-3ea4-a930-19ded304b58a",
                                "text": "„Der Kapellenerker im zweiten Obergeschoss ist aus Sandsteinquadern erbaut und sitzt auf drei Granitkonsolen, die durch Wappen verziert sind.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
