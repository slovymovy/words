                "senses": [
                    {
                        "sense_id": "8ac13c7a-2088-3302-ae3e-5f35eef8299d",
                        "entry_id": "73e7840e-2c33-3fe6-87e1-08e349fe1a24",
                        "glosses": [
                            "Sitzmöbel oder Fahrzeug für drei Personen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cf661f35-87c7-41fd-af35-f109868c1dde",
                                "sense_id": "8ac13c7a-2088-3302-ae3e-5f35eef8299d",
                                "text": "„Während sie das sagte, deutete sie mit der ausgestreckten linken Hand Richtung Sofa, als meinte sie mit »das alles« den Dreisitzer.“"
                            },
                            {
                                "example_id": "51c97c65-9a24-442d-8da8-0244f9de8686",
                                "sense_id": "8ac13c7a-2088-3302-ae3e-5f35eef8299d",
                                "text": "„Sie nehmen im Wohnzimmer auf dem Dreisitzer Platz, nachdem die Frau des Hauses noch schnell den Schonbezug abgenommen hat.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
