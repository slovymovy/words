                "entry_id": "a5f8bae0-eb13-3842-8839-7479fae174be",
                "word": "algocratie",
                "pos": "noun",
                "lang_code": "fr",
                "forms": [
                    {
                        "form_id": "4c35be4b-3a9b-4c7c-964b-670c1e439511",
                        "entry_id": "a5f8bae0-eb13-3842-8839-7479fae174be",
