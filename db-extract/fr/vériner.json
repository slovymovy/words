                "senses": [
                    {
                        "sense_id": "ae379b19-0645-3052-9a9d-a5ec146c8b0b",
                        "entry_id": "3efa6c6f-ef56-3948-a1c5-76b5287e7331",
                        "glosses": [
                            "Poser temporairement quelque chose sur vérins pour en assurer la mise en place, en position ou en sécurité durant une intervention."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "30fbf9d2-eb61-4d90-b8ad-8ba7f52b7118",
                                "sense_id": "ae379b19-0645-3052-9a9d-a5ec146c8b0b",
                                "text": "Si l’ouvrage n’a pas été construit à une hauteur au-dessus du TN proche de la hauteur définitive, ce qui est souvent le cas des tabliers en béton ou en acier construits près du sol, il convient au préalable de le vériner, souvent de plusieurs mètres."
                            }
                        ]
                    },
                    {
                        "sense_id": "cc351fff-0708-3cfe-9862-3ae6d5ff9084",
                        "entry_id": "3efa6c6f-ef56-3948-a1c5-76b5287e7331",
                        "glosses": [
                            "Soulever une charge lourde à l’aide de vérins pour permettre sa mise en position ou en sécurité."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "113217ad-1a21-4fb6-b21b-898955d1b48c",
                                "sense_id": "cc351fff-0708-3cfe-9862-3ae6d5ff9084",
                                "text": "Déposer des éléments de carrosserie, reposer, remplacer, souder, vériner, remettre en ligne… La diversité des tâches est passionnante […]"
                            }
                        ]
                    }
                ],
