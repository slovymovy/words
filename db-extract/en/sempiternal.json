                                        "entry_id": "46dab983-2f7d-3980-86de-8b69b8689b4b",
                                        "glosses": [
                                            "De duración infinita."
                                        ],
                                        "tags": [
                                            "literary",
                                            "obsolete"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a71471cc-8326-44f8-8941-12645c4fd188",
                                                "sense_id": "9a5ed997-4757-38cb-891d-d5de2b1ba64d",
                                                "text": "Los mejores prefieren una cosa sobre todas: en vez de lo perecedero, fama sempiterna. Mientras que los más se sacian como animales."
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
