                "senses": [
                    {
                        "sense_id": "3d1fb73c-f9fb-3ef0-87e1-9be69c86be34",
                        "entry_id": "98c10c41-a4e2-33ba-b8d7-119231a431a1",
                        "glosses": [
                            "Lüfter, der die Luft axial (parallel zur Drehachse des Laufrades) ansaugt und diese dann um 90° versetzt, radial wieder ausbläst"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "23aa6428-f0ca-4a01-a205-8657d620e418",
                                "sense_id": "3d1fb73c-f9fb-3ef0-87e1-9be69c86be34",
                                "text": "„Radiallüfter sind die souveränen Hochdruckspezialisten in radialer Bauweise mit 90° Luftumlenkung und aufwändig optimierten Laufrädern.“"
                            },
                            {
                                "example_id": "4c0598c3-53c0-47d4-b9a9-3f17f4b6a691",
                                "sense_id": "3d1fb73c-f9fb-3ef0-87e1-9be69c86be34",
                                "text": "„Die praktischen Radiallüfter werden sowohl in der Industrie als auch für gewerbliche Zwecke verwendet.“"
                            },
                            {
                                "example_id": "08ec1880-0da8-46a8-9df5-5c9ad215bfa2",
                                "sense_id": "3d1fb73c-f9fb-3ef0-87e1-9be69c86be34",
                                "text": "„Wird ein hoher Druck bei geringerem Volumenstrom gefordert, sind die Radiallüfter von ebm Papst eine Hochdruck-Alternative zu den Axiallüftern.“"
                            },
                            {
                                "example_id": "e2308365-4841-476f-b1f4-c547624d2387",
                                "sense_id": "3d1fb73c-f9fb-3ef0-87e1-9be69c86be34",
                                "text": "„Der Radiallüfter ist die etablierte Alternative zu Axialventilatoren, der einfach in Wand oder Decke verbaut wird und mit hoher Leistungsstärke Widerstände und Drücke einfacher überwindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
