                            {
                                "example_id": "6d8d813c-645d-47a4-a952-d85629dd5f3d",
                                "sense_id": "5633bca7-ad03-3b6a-974d-3a1855ab20d5",
                                "text": "Możemy powiedzieć, że idiolekt jest językiem (lektem) konkretnej (pojedynczej) osoby"
                            }
                        ],
