                "senses": [
                    {
                        "sense_id": "d8b70a9d-475b-3253-9c0a-41f6409bc313",
                        "entry_id": "ec5a09ef-811a-35e1-b2be-bcbe5249fcc3",
                        "glosses": [
                            "genderism, gender ideology, gender mainstreaming (views and actions that recognize and attempt to redress sexism)"
                        ],
                        "tags": [
                            "derogatory",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "66629d28-1ea5-4636-a623-673664b0b789",
                                "sense_id": "d8b70a9d-475b-3253-9c0a-41f6409bc313",
                                "text": "Verschwörungen zu Pandemie, Ukrainekrieg, Klimawandel oder gegen „Genderismus“ – Lamberty sagt der taz: „Das alles zusammen ist eine toxische Mischung – gerade dann, wenn man bedenkt, wie angespannt die gesellschaftliche Lage ist und auch noch sein wird.“"
                            }
                        ]
                    },
                    {
                        "sense_id": "0b163caf-4ef3-376e-8c32-bbff1df19f9e",
                        "entry_id": "ec5a09ef-811a-35e1-b2be-bcbe5249fcc3",
                        "glosses": [
                            "genderism (a gendered or gender-stereotyped behavior, activity or statement)"
                        ],
                        "tags": [
                            "countable",
                            "masculine",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "b3310514-dcf2-4214-8781-cf4dbc41cdd0",
                                "sense_id": "0b163caf-4ef3-376e-8c32-bbff1df19f9e",
                                "text": "Die geschlechtsspezifischen Verhaltensweisen (Genderismen) entstehen nicht aus der Konfrontation mit der Umwelt an sich, sondern in einer „Umwelt, die speziell für den Zweck eingerichtet wurde, sie gewissermaßen heraufzubeschwören“ (Goffman 1994: 146f.)."
                            }
                        ]
                    },
                    {
                        "sense_id": "d0773287-295a-3d48-a81a-a0b20ffbb242",
                        "entry_id": "ec5a09ef-811a-35e1-b2be-bcbe5249fcc3",
                        "glosses": [
                            "genderism (discrimination on the basis of gender)"
                        ],
                        "tags": [
                            "masculine",
                            "strong",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "ad4d83d7-aa86-4a93-89fe-02f87661e188",
                                "sense_id": "d0773287-295a-3d48-a81a-a0b20ffbb242",
                                "text": "Hornscheidt empfindet die Tatsache, dass sich Menschen ständig einem Geschlecht zuordnen, als Zwang, als Diskriminierung, als Genderismus, vergleichbar mit anderen -ismen wie Sexismus oder Rassismus."
                            }
                        ]
                    }
                ],
