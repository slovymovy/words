                "senses": [
                    {
                        "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                        "entry_id": "9a3630d4-0180-33aa-a640-ca5c3c4c94fb",
                        "glosses": [
                            "Literaturgattung und geistige Strömung, die sich mit der Apokalypse (dem bevorstehenden Ende der Welt) beschäftigt/beschäftigte"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "96cfadcf-3eca-4a61-9160-96a633a350e2",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "Die Forschung ist von einem Konsens über die Apokalyptik weit entfernt."
                            },
                            {
                                "example_id": "c3c9cffd-959b-4612-8514-8c6d43c48958",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "„Auch die Friedens- und die Umweltbewegung zeigten im vergangenen Jahrhundert deutliche Anzeichen von Apokalyptik.“"
                            },
                            {
                                "example_id": "e9b0a447-43af-4c1b-9115-6b71245eabe2",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "„Das wirkungsmächtigste Element religiöser Semantik in der Gegenwart ist die Apokalyptik.“"
                            },
                            {
                                "example_id": "da4ef436-a998-48e5-97f0-5b0e52f7d2db",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "„Wie aus den bisherigen Charakteristika hervorgeht, muss Apokalyptik nicht notwendig ein religiöses Phänomen sein. Sie ist allerdings immer ein in besonderer Weise welt-anschauliches Phänomen.“"
                            },
                            {
                                "example_id": "4e944b21-6eb6-4d33-af2a-499b60b08337",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "„Ist die Apokalyptik die Mutter der christlichen Theologie?“"
                            },
                            {
                                "example_id": "166b4118-f488-4c36-b680-977aca3b62d5",
                                "sense_id": "72abeecb-55cd-3a52-bf78-1720b46dfa6c",
                                "text": "„Lassen Sie mich also zunächst etwas zum Begriff der Apokalyptik sagen. Es handelt sich bei ihr um den literarischen Niederschlag von Visionen der Endzeit im Judentum seit dem zweiten vorchristlichen Jahrhundert.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
