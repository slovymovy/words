                    ],
                    "common_phrases": [
                        "wireless earphones",
                        "pair of earphones",
                        "plug in earphones"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пара небольших динамиков, которые вставляются в уши или надеваются на них для частного прослушивания аудио."
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "наушники",
                                "target_lang_sense_clarification": "устройство для прослушивания звука"
                            },
                            {
                                "target_lang_word": "вкладыши",
                                "target_lang_sense_clarification": "маленькие наушники, вставляемые в ушную раковину"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "cf048373-70e9-3e87-9b11-929610a9221c",
                    "sense_definition": "The plural form of <w>earphone</w>.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "audio_equipment",
                    "name_type": "no",
                    "examples": [
