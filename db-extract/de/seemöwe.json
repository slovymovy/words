                "senses": [
                    {
                        "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                        "entry_id": "fb56c65b-cee6-3c58-a4ab-9674e9f71d47",
                        "glosses": [
                            "am Meer gesellig lebender mittelgroßer bis großer schwimmfähiger, vorwiegend leuchtend weiß oder silbergrau gefiederter Seevogel (Larinae) mit relativ langen, schmalen und spitzen Flügeln, die ihm ein ausgezeichnetes Flugvermögen verleihen, mit einem kräftigen, schlanken, scharfen Schnabel und mit Schwimmhäuten an den Füßen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "cb718ece-ae6b-4438-a6c1-7c28a3413893",
                                "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                                "text": "«Wahrscheinlich wird eine Seemöwe vor dem Fenster kreischen, Helsinki liegt ja am Meer, Seemöwen sind die beutegierigsten Vögel der Welt, leider verhindert die Doppelverglasung der Fenster, daß du das beutegierige Gekreisch hören kannst, Eva, und diese rötlichen Raubvogelschnäbel wie Reißzähne, vermutlich allerdings wird es bereits Nacht sein, und ich bin nicht sicher, ob Seemöwen auch nachts kreischen.»"
                            },
                            {
                                "example_id": "f503942c-8895-4bd2-9cdf-e86396d9efb6",
                                "sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                                "text": "„Unter den Schwimmhäutlern sah Pencroff einige Labben aus der Familie der Seemöwen, auch Raubmöwen genannt.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "e8707b67-8e67-4877-8f37-48dae6748f19",
                        "source_entry_id": "fb56c65b-cee6-3c58-a4ab-9674e9f71d47",
                        "source_sense_id": "bce6d8d2-4fa0-3166-9e82-91fa336b8834",
                        "source_sense_description": "für Sprachen, die keine spezielle Entsprechung für „an der See lebende Möwe“ haben, siehe Übersetzungen im Eintrag Möwe",
                        "target_lang_word": "seagull",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "seagull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e859de90-3e9d-3d26-9123-22f14469779b",
                                        "entry_id": "3701c0fd-79ef-3344-9257-6d60fff8faf7",
                                        "glosses": [
                                            "Any of several white, often dark-backed birds of the family Laridae having long, pointed wings and short legs."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0635903b-8130-41d0-a705-c4ca9083e581",
                                                "sense_id": "e859de90-3e9d-3d26-9123-22f14469779b",
                                                "text": "And while there are plenty of benches, there's little shelter from the wind (or predatory seagulls the size of dogs) out on the platforms."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "44c14f48-1a91-3a5e-b4af-6b9865ef4cd8",
                                        "entry_id": "3701c0fd-79ef-3344-9257-6d60fff8faf7",
                                        "glosses": [
                                            "The symbol ̼, which combines under a letter as a sort of accent."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "c5a90fd6-243e-3d99-8172-3f631db0d976",
                                        "entry_id": "3701c0fd-79ef-3344-9257-6d60fff8faf7",
                                        "glosses": [
                                            "A fan or member of Brighton and Hove Albion Football Club."
                                        ],
                                        "tags": [
                                            "UK",
                                            "slang"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "seagull",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                        "entry_id": "4e4ac272-5b94-3cb1-9cda-b66a82a43bfd",
                                        "glosses": [
                                            "To run in the back line rather than concentrate on primary positional duties in open play."
                                        ],
                                        "tags": [
                                            "Australia",
                                            "British",
                                            "New-Zealand",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f9b625a1-991c-46da-8616-995b869ac02f",
                                                "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                                "text": "[…] and when you need cover for the fullback because of the bombs raining down, when the walking maul requires every forward to quit seagulling and actually do some hard graft, then the rest of the game opens up."
                                            },
                                            {
                                                "example_id": "f61509a8-92e4-46db-889c-70c037224001",
                                                "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                                "text": "On hand was seagulling number eight Dave Hodges to cross for the all-important try."
                                            },
                                            {
                                                "example_id": "5cfddb31-82fe-481b-9684-260687c8d18c",
                                                "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                                "text": "That occurred in the 12th minute when flanker George Smith, seagulling out wide, enjoyed the rewards of a two-man overlap to score."
                                            },
                                            {
                                                "example_id": "104b1107-3122-4038-ac96-3ff061a11bb9",
                                                "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                                "text": "France was full of running and continued to spread the ball wide or kick in behind the defence, where towering right-winger Aurelien Rougerie and the seagulling French back row had a height advantage contesting the high ball."
                                            },
                                            {
                                                "example_id": "7241ce64-866a-43a6-b6b1-f33f80311486",
                                                "sense_id": "721d78e6-6ffc-3096-b0a1-33d6edc51aa4",
                                                "text": "Samo seagulled for Australia's final try two minutes from time."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1e9b4b23-cd84-3282-a7cf-aaae9854e1d3",
                                        "entry_id": "4e4ac272-5b94-3cb1-9cda-b66a82a43bfd",
                                        "glosses": [
                                            "To use a British Seagull outboard."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a1662770-36ce-49ba-8679-621f99556f0e",
                                                "sense_id": "1e9b4b23-cd84-3282-a7cf-aaae9854e1d3",
                                                "text": "It should be considered a style of outboarding I believe. Seagulling arround^([sic]) and all."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2dd0c1ad-1787-3ea9-9aef-5792689e6fab",
                                        "entry_id": "4e4ac272-5b94-3cb1-9cda-b66a82a43bfd",
                                        "glosses": [
                                            "To work as a non-union casual stevedore."
                                        ],
                                        "tags": [
                                            "New-Zealand"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "86208e0c-ac55-490e-b06c-2e6a5ea93e99",
                                                "sense_id": "2dd0c1ad-1787-3ea9-9aef-5792689e6fab",
                                                "text": "Bill had been seagulling on the wharf since he got back from the war."
                                            },
                                            {
                                                "example_id": "874d62b6-3204-4c2c-878a-460016b41026",
                                                "sense_id": "2dd0c1ad-1787-3ea9-9aef-5792689e6fab",
                                                "text": "At that time many of them seagulled on the Mt Maunganui wharf to make a crust in order to carry on with their ideal of kiwifruit as a major exporting industry."
                                            },
                                            {
                                                "example_id": "a79ec879-a0a9-4e9f-ab25-80a117d09416",
                                                "sense_id": "2dd0c1ad-1787-3ea9-9aef-5792689e6fab",
                                                "text": "The only stories he told of his life were of how hard he had worked, seagulling on the wharf, standing in blood and guts at the Works, loading trucks with sacks of fertiliser and grain at the Farmers' Co-op."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
