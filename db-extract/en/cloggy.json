                        "glosses": [
                            "Tending to cause clogging due to its texture; lumpy; sticky."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f735b5d-89ed-48a6-b292-d24c5db1c0b3",
                                "sense_id": "d9858f22-7f82-3313-9d8f-191b0b316116",
                                "text": "[…] Nature stirres up all young things, Boyes, and Lambs, and Kitlins, to play and run about, by which they disperse the cloggy humours that otherwise would settle in their joynts […]"
                            },
                            {
                                "example_id": "f376009f-ef4d-419e-af57-c6605e9a5d23",
                                "sense_id": "d9858f22-7f82-3313-9d8f-191b0b316116",
                                "text": "[…] the land in many parts was naturally heavy, and even when the digging was proceeding, very cloggy."
                            },
                            {
                                "example_id": "da66242b-80a8-4347-bd83-3924f21a9e36",
                                "sense_id": "d9858f22-7f82-3313-9d8f-191b0b316116",
                                "text": "A cloggy sensation of the lukewarm fat of meat is upon me (we dined an hour or two ago), and my head is as heavy as so much lead."
                            },
                            {
                                "example_id": "d675385d-6baf-45b2-bf8d-98fa853ec791",
                                "sense_id": "d9858f22-7f82-3313-9d8f-191b0b316116",
                                "text": "The snow was very cloggy, making the sledge and our ski run heavily."
                            }
                        ]
                    },
