                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "7a545fdd-5d40-335b-aea5-3b91454851aa",
                                        "entry_id": "b3b86029-b4c6-3966-8468-2c9e70437512",
                                        "glosses": [
                                            "An addition or supplement that explains, modifies, or revokes a will or part of one."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "332f4617-204a-3d9e-815a-96a6070cfaa3",
                                        "entry_id": "b3b86029-b4c6-3966-8468-2c9e70437512",
                                        "glosses": [
                                            "An addition or supplement modifying any official document, such as a treaty."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c5594b03-ccd9-47f9-b03b-9d64240a5e32",
                                                "sense_id": "332f4617-204a-3d9e-815a-96a6070cfaa3",
                                                "text": "So insistent was this demand that the Wyandot actually received a codicil to the treaty […]"
                                            },
                                            {
                                                "example_id": "7cb531cb-0a5f-4546-a298-6903ea07fc8a",
                                                "sense_id": "332f4617-204a-3d9e-815a-96a6070cfaa3",
                                                "text": "Those loose ends were tied up in a little-understood clarification of Brexit called the Northern Ireland protocol, ratified in January 2020. It looked like a mere codicil three years ago; now it looks like a serious diplomatic blunder that could threaten Britain’s territory and the region’s peace."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "93a377a5-249a-3f5a-b651-31c241b1575d",
                                        "entry_id": "b3b86029-b4c6-3966-8468-2c9e70437512",
                                        "glosses": [
                                            "Any appendix or addition."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a4e9ffb3-e6c2-4cb7-a738-6308dc26dea3",
                                                "sense_id": "93a377a5-249a-3f5a-b651-31c241b1575d",
                                                "text": "If Nick answered a question Wani listened to him and then gave a flat little codicil or correction."
                                            }
                                        ]
                                    }
                                ]
                            },
