                                        "entry_id": "d5934a85-4522-3ebb-b841-25c14821466b",
                                        "glosses": [
                                            "A form of large-scale history dealing with large groups of cultures over very long time periods."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "eedbe3fc-c497-4189-8c90-3b86a28907b2",
                                                "sense_id": "1b579446-f31f-3e17-9880-5d2532860051",
                                                "text": "These days, it’s chiefly nonhistorians like Jared Diamond and Tim Flannery who seek to trace the long arc of the species and write macrohistory in a scientific key."
                                            }
                                        ]
                                    }
