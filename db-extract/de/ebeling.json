                ],
                "senses": [
                    {
                        "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                        "entry_id": "927ccfe5-211d-3a50-87a1-cda057ab2627",
                        "glosses": [
                            "deutschsprachiger Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f79d4b35-9e0f-46d5-a0aa-e8aff7cec1d3",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Frau Ebeling ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "0e2d8217-c89d-4b4b-8ca1-3b822955fcb8",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Herr Ebeling wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "2fcec5e4-8414-4723-a3f0-f9741e2ead35",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Die Ebelings kommen heute aus dem Teutoburger Wald."
                            },
                            {
                                "example_id": "c16e8765-56c8-479b-9e26-0ce3f02af91e",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Der Ebeling trägt nie die Schals, die die Ebeling ihm strickt."
                            },
                            {
                                "example_id": "069bacb2-7183-45a1-853c-325d2a329c39",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Ebeling kommt, geht der Herr Ebeling.“"
                            },
                            {
                                "example_id": "fbab4fac-231f-4faf-bb82-9abb4d84bc77",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Ebeling kommt und geht."
                            },
                            {
                                "example_id": "279a8e06-cc36-4787-a7ff-5bc205cb8d85",
                                "sense_id": "3e25c3ee-3701-333c-b9fa-e5f76187ff6d",
                                "text": "Ebelings kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
