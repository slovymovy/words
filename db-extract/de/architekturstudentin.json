                    {
                        "sense_id": "684f8d9d-0596-31fa-b060-db504dbf57c2",
                        "entry_id": "ad2031a3-a2ff-3c8d-b328-f78f1c3e28a6",
                        "glosses": [
                            "weibliche Person, die an einer Hochschule Architektur studiert"
                        ],
                        "tags": [
                            "Bildungswesen"
                        ],
                        "examples": [
                            {
                                "example_id": "094991c0-4035-446e-90b9-7da1b7c4cd59",
                                "sense_id": "684f8d9d-0596-31fa-b060-db504dbf57c2",
                                "text": "„Da sie mit ihrem Leben reichlich unzufrieden ist, sieht die ehemalige Architekturstudentin in dem Bauvorhaben eine Chance, ihren Jugendtraum zu verwirklichen.“"
                            },
                            {
                                "example_id": "9ffc9c0a-6582-437c-835e-ea56d0c2e10d",
                                "sense_id": "684f8d9d-0596-31fa-b060-db504dbf57c2",
                                "text": "„Eigentlich ist Lena glückliche Architekturstudentin in einer festen Beziehung.“"
                            },
                            {
                                "example_id": "f4f5a1ec-e6cb-44c4-ae00-765b13d31257",
                                "sense_id": "684f8d9d-0596-31fa-b060-db504dbf57c2",
                                "text": "„Der gutmütige Menschenfreund und Bewährungshelfer Uwe Weller gerät an seine Grenzen: Einer seiner Klienten soll eine Architekturstudentin der Wismarer Hochschule mit Säure verätzt und erschlagen haben.“"
                            }
                        ],
