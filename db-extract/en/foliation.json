                                        "entry_id": "327cbddf-e272-3123-bd01-c56acb79ed85",
                                        "glosses": [
                                            "Manière de feuilleter la pâtisserie."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2438e256-ed99-4545-91c0-6990ae7c726d",
                                                "sense_id": "229ad7fe-0144-3021-ace4-d25fedfff54d",
                                                "text": "Si le feuilletage lève trop pendant la cuisson, n’hésitez pas à appuyer un peu sur la plaque."
                                            },
                                            {
                                                "example_id": "4f288b1f-da88-4831-9121-4bbabfb789d4",
                                                "sense_id": "229ad7fe-0144-3021-ace4-d25fedfff54d",
                                                "text": "Retirez bien l’excédent de farine qui pourrait se former lorsque vous tourez la pâte. S'il y a trop de farine, les couches de détrempe ne se colleront pas entre elles et vous aurez du mal à réaliser le feuilletage."
                                            }
                                        ]
