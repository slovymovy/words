                "senses": [
                    {
                        "sense_id": "3276b8b0-ba75-3ed0-aa1a-437184d25fd1",
                        "entry_id": "4db22350-0f9b-358f-952e-431e914925d9",
                        "glosses": [
                            "Vertreter einer Gruppe ausgestorbener Reptilien aus dem Mesozoikum (Erdmittelalter), die vollständig an das Leben im Meer angepasst waren (Ichthyopterygia)"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "d502142f-eb3e-4cf1-9c8a-db95ff63b021",
                                "sense_id": "3276b8b0-ba75-3ed0-aa1a-437184d25fd1",
                                "text": "„Die Wissenschaftler beschäftigen sich außerdem vermehrt mit dem letzten Kapitel der Ichthyosaurier, das heißt ihrem Untergang in der Zeit der Oberkreide etwa 30 Millionen Jahre vor dem bekannten Massenaussterben der Dinosaurier.“"
                            },
                            {
                                "example_id": "6e99b871-461d-4fb6-8c68-10557db5533b",
                                "sense_id": "3276b8b0-ba75-3ed0-aa1a-437184d25fd1",
                                "text": "„Zehn Meter lang ist das Skelett, allein der Schädel wiegt eine Tonne. Dieses Ichthyosaurier-Fossil fanden britische Forscher in einem Stausee im Rutland Water Nature Reserve.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "30481c23-1b53-3b7b-8ab3-61774da1a0b9",
                        "entry_id": "4db22350-0f9b-358f-952e-431e914925d9",
                        "glosses": [
                            "Vertreter einer Gattung meereslebender ausgestorbener Reptilien innerhalb von [1]"
                        ],
                        "tags": [
                            "Paläontologie"
                        ],
                        "examples": [
                            {
                                "example_id": "2e77b49a-66b3-43be-b03d-626c9675135f",
                                "sense_id": "30481c23-1b53-3b7b-8ab3-61774da1a0b9",
                                "text": "Der Ichthyosaurier war vollständig schuppen- und panzerlos, er hatte eine glatte Haut, ähnlich der, der heutigen Delphine."
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
