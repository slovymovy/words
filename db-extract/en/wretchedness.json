                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Erbärmlichkeit",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "66f1a07a-85fc-36a3-9b75-baf89a3a85e6",
                                        "entry_id": "921075ed-df32-357f-87af-3fb22ee662ce",
                                        "glosses": [
                                            "Verfassung, erbärmlich zu sein"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9702bc4e-4e87-499f-a628-6817fe5aa4a6",
                                                "sense_id": "66f1a07a-85fc-36a3-9b75-baf89a3a85e6",
                                                "text": "„Sie drängen sich, ihm ihre Erbärmlichkeit zu zeigen.“"
                                            }
                                        ],
