        "nl-extract.jsonl": [
            {
                "entry_id": "f88da5c2-7868-3659-be35-ad442e90b950",
                "word": "bestrooien",
                "pos": "verb",
                "lang_code": "nl",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "f84a4a14-9ec9-3419-9573-1970105513e5",
                        "entry_id": "f88da5c2-7868-3659-be35-ad442e90b950",
                        "glosses": [
                            "iets bedekken met strooisel; iets door strooien bedekken"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "84b6ff63-5a1d-4988-8759-70c369407996",
                                "sense_id": "f84a4a14-9ec9-3419-9573-1970105513e5",
                                "text": "Zij liet het avondeten boven brengen, pakte zelf uit, hielp de bedden opmaken en vergat zelfs niet ze met insectenpoeder te bestrooien."
                            },
                            {
                                "example_id": "213db058-b8c0-4ed2-a992-cf7eb83a4765",
                                "sense_id": "f84a4a14-9ec9-3419-9573-1970105513e5",
                                "text": "\"De festivals verplaatsen een heel belangrijk feest voor het hindoeïsme van de lente naar de zomer\", zegt Baboeram in het NOS Radio 1 Journaal. Op de feestdag wordt het nieuwe jaar en de lente gevierd en bestrooien hindoes elkaar met gekleurd poeder. \"Het is net alsof zo'n organisatie dan kerstbomen optuigt in de lente en zegt: 'fijne Kerst allemaal'.\""
                            }
                        ]
                    }
                ],
