{
    "word_family": [
        "ballerina",
        "balletic"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "1901e2b7-6d37-35cc-b795-35d295b989fd",
                    "sense_definition": "A classical form of artistic dance characterized by precise and graceful movements.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "dance_form",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She started taking <w>ballet</w> lessons when she was only five years old.",
                            "target_lang_translations": {
                                "ru": "Она начала брать уроки <w>балета</w>, когда ей было всего пять лет.",
                                "zh": "她五岁时就开始上<w>芭蕾</w>课了。"
                            }
                        },
                        {
                            "text": "A professional <w>ballet</w> dancer must have incredible strength and flexibility.",
                            "target_lang_translations": {
                                "ru": "Профессиональный артист <w>балета</w> должен обладать невероятной силой и гибкостью.",
                                "zh": "专业的<w>芭蕾</w>舞者必须具备惊人的力量和柔韧性。"
                            }
                        }
                    ],
                    "synonyms": [
                        "classical dance"
                    ],
                    "common_phrases": [
                        "classical ballet",
                        "ballet dancer",
                        "ballet shoes",
                        "ballet class"
                    ],
                    "target_lang_definitions": {
                        "ru": "Классический вид сценического танца, характеризующийся точными и грациозными движениями.",
                        "zh": "一种以精确和优美的动作为特征的古典艺术舞蹈形式。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балет",
                                "target_lang_sense_clarification": "вид искусства"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芭蕾",
                                "target_lang_sense_clarification": "舞蹈艺术形式"
                            },
                            {
                                "target_lang_word": "芭蕾舞",
                                "target_lang_sense_clarification": "舞蹈艺术形式"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c743d435-acf1-35bf-a45c-419151100c72",
                    "sense_definition": "A theatrical presentation of classical dance, usually telling a story with music.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "dance_performance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We bought tickets to see a famous <w>ballet</w> at the opera house this weekend.",
                            "target_lang_translations": {
                                "ru": "Мы купили билеты на известный <w>балет</w> в оперный театр на эти выходные.",
                                "zh": "我们买了这周末去歌剧院看一场著名<w>芭蕾舞剧</w>的票。"
                            }
                        },
                        {
                            "text": "The Nutcracker is a very popular <w>ballet</w> performed during the Christmas season.",
                            "target_lang_translations": {
                                "ru": "«Щелкунчик» — очень популярный <w>балет</w>, который ставят в рождественский сезон.",
                                "zh": "《胡桃夹子》是一部在圣诞期间上演的非常受欢迎的<w>芭蕾舞剧</w>。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "go to the ballet",
                        "watch a ballet",
                        "stage a ballet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Театральное представление классического танца, обычно передающее сюжет с помощью музыки.",
                        "zh": "一种古典舞蹈的戏剧表演，通常通过音乐讲述一个故事。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балет",
                                "target_lang_sense_clarification": "спектакль"
                            },
                            {
                                "target_lang_word": "постановка",
                                "target_lang_sense_clarification": "сценическое произведение"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芭蕾舞剧",
                                "target_lang_sense_clarification": "舞台表演作品"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "c3189424-ef0b-3f6a-acbd-63adf291c075",
                    "sense_definition": "A group or company of professional dancers who perform classical dance.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "dance_company",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "He was thrilled to join the national <w>ballet</w> after graduating from the academy.",
                            "target_lang_translations": {
                                "ru": "Он был в восторге от того, что после окончания академии его приняли в национальный <w>балет</w>.",
                                "zh": "从学院毕业后，他非常激动能加入国家<w>芭蕾舞团</w>。"
                            }
                        },
                        {
                            "text": "The touring <w>ballet</w> will visit three different cities next month.",
                            "target_lang_translations": {
                                "ru": "Гастролирующий <w>балет</w> посетит три разных города в следующем месяце.",
                                "zh": "这个巡演的<w>芭蕾舞团</w>下个月将访问三个不同的城市。"
                            }
                        }
                    ],
                    "synonyms": [
                        "troupe",
                        "company"
                    ],
                    "common_phrases": [
                        "join the ballet",
                        "royal ballet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Группа или труппа профессиональных танцоров, исполняющих классические танцы.",
                        "zh": "表演古典舞蹈的专业舞者团体或公司。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балет",
                                "target_lang_sense_clarification": "коллектив танцоров"
                            },
                            {
                                "target_lang_word": "балетная труппа",
                                "target_lang_sense_clarification": "организация"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芭蕾舞团",
                                "target_lang_sense_clarification": "表演团体"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2816e9bf-8eaa-37a4-bce9-963d3dfb80eb",
                    "sense_definition": "An intricate series of actions or movements involving coordination between people or things.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "metaphorical_coordination",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The busy kitchen staff performed a chaotic <w>ballet</w> during the dinner rush.",
                            "target_lang_translations": {
                                "ru": "Занятой персонал кухни исполнял хаотичный <w>балет</w> во время наплыва посетителей на ужин.",
                                "zh": "晚餐高峰时，忙碌的厨房员工上演了一场混乱的<w>芭蕾</w>。"
                            }
                        },
                        {
                            "text": "Parking the large trucks in the small lot was a delicate <w>ballet</w> of maneuvering.",
                            "target_lang_translations": {
                                "ru": "Парковка больших грузовиков на маленькой площадке была тонким <w>балетом</w> маневрирования.",
                                "zh": "将大卡车停在小停车场里是一场精细的<w>芭蕾</w>式操纵。"
                            }
                        }
                    ],
                    "common_phrases": [
                        "delicate ballet"
                    ],
                    "target_lang_definitions": {
                        "ru": "Сложная последовательность действий или движений, требующая координации между людьми или предметами.",
                        "zh": "涉及人或事物之间协调的复杂动作或行为序列。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балет",
                                "target_lang_sense_clarification": "переносное значение"
                            },
                            {
                                "target_lang_word": "танец",
                                "target_lang_sense_clarification": "метафора сложных действий"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芭蕾",
                                "target_lang_sense_clarification": "比喻复杂的协调动作"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "27735706-12f3-34b6-b806-469f22d96d3f",
                    "sense_definition": "A light part song common among Elizabethan and Italian Renaissance composers.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "music_history",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The choir performed a lively <w>ballet</w> from the sixteenth century.",
                            "target_lang_translations": {
                                "ru": "Хор исполнил живое <w>балетто</w> шестнадцатого века.",
                                "zh": "合唱团演唱了一首十六世纪轻快的<w>芭蕾舞曲</w>。"
                            }
                        },
                        {
                            "text": "Musicians studied the structure of the Renaissance <w>ballet</w> to understand its rhythm.",
                            "target_lang_translations": {
                                "ru": "Музыканты изучали структуру ренессансного <w>балетто</w>, чтобы понять его ритм.",
                                "zh": "音乐家们研究了文艺复兴时期<w>芭蕾舞曲</w>的结构以理解其节奏。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "archaic",
                            "comment": "historical music term"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Легкая многоголосная песня, популярная среди композиторов елизаветинской эпохи и итальянского Возрождения.",
                        "zh": "一种在伊丽莎白时代和意大利文艺复兴时期作曲家中常见的轻快多声部歌曲。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "балетто",
                                "target_lang_sense_clarification": "музыкальный жанр"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "芭蕾舞曲",
                                "target_lang_sense_clarification": "历史音乐体裁"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76d6ae43-0862-3ce2-a816-dfdf47eb0460",
                    "sense_definition": "A small roundel on a coat of arms.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "heraldry",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The family crest featured a silver <w>ballet</w> on a black background.",
                            "target_lang_translations": {
                                "ru": "Фамильный герб украшал серебряный <w>шар</w> на черном фоне.",
                                "zh": "家族纹章的黑色背景上有一个银色的<w>圆盘</w>。"
                            }
                        },
                        {
                            "text": "In heraldry, the color of the <w>ballet</w> determines its specific name.",
                            "target_lang_translations": {
                                "ru": "В геральдике цвет <w>шара</w> определяет его конкретное название.",
                                "zh": "在纹章学中，<w>圆盘</w>的颜色决定了它的具体名称。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Небольшой круг (гербовая фигура) на рыцарском гербе.",
                        "zh": "纹章上的一种小圆盘图案。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "шар",
                                "target_lang_sense_clarification": "геральдическая фигура"
                            },
                            {
                                "target_lang_word": "кружок",
                                "target_lang_sense_clarification": "элемент герба"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "圆盘",
                                "target_lang_sense_clarification": "纹章学中的圆形图案"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "c03dc7dd-8a13-39cd-b340-95854003b839",
                    "sense_definition": "To perform an action reminiscent of ballet dancing.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_action",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "She managed to <w>ballet</w> her way gracefully through the crowded room.",
                            "target_lang_translations": {
                                "ru": "Ей удалось грациозно <w>протанцевать</w> через переполненную комнату.",
                                "zh": "她设法<w>轻盈地</w>穿过了拥挤的房间。"
                            }
                        },
                        {
                            "text": "The falling leaves seemed to <w>ballet</w> in the gentle autumn wind.",
                            "target_lang_translations": {
                                "ru": "Казалось, что падающие листья <w>кружатся в балете</w> на нежном осеннем ветру.",
                                "zh": "飘落的树叶仿佛在柔和的秋风中<w>跳着芭蕾</w>。"
                            }
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Выполнять действия, напоминающие балетный танец.",
                        "zh": "执行让人联想到芭蕾舞的动作。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "танцевать как в балете",
                                "target_lang_sense_clarification": "действие"
                            },
                            {
                                "target_lang_word": "протанцевать",
                                "target_lang_sense_clarification": "двигаться грациозно"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "跳芭蕾",
                                "target_lang_sense_clarification": "动作"
                            },
                            {
                                "target_lang_word": "轻盈地移动",
                                "target_lang_sense_clarification": "形容动作优美"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}