                        "target_lang_word": "prieur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "prieur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "f2021974-f8fc-328e-b3f3-9daf813fb2a8",
                                        "entry_id": "13d0e11b-a50e-34de-ab4e-133e2f3bcb76",
                                        "glosses": [
                                            "Supérieur dans certains monastères."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "ff624839-d106-4ccf-9a08-fc3584dedde8",
                                                "sense_id": "f2021974-f8fc-328e-b3f3-9daf813fb2a8",
                                                "text": "Quant au moine, Gurth le reconnut à l’instant même pour le prieur de l’abbaye de Jorvaulx."
                                            },
                                            {
                                                "example_id": "b97fb290-456d-4a73-a635-dbdfc86ea9ee",
