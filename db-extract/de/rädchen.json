                "senses": [
                    {
                        "sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                        "entry_id": "f0f8acc3-32dc-3435-8d67-985f5c66db6a",
                        "glosses": [
                            "kleines Rad"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "99d53e6c-56d2-42ce-bc00-bbdc25954988",
                                "sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                                "text": "In Armbanduhren sind oft mehrere Rädchen."
                            },
                            {
                                "example_id": "7a352d87-f2ec-4271-9d91-d4e402f1db24",
                                "sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                                "text": "„Es breitete sich über Couchgarnitur und Fernsehecke aus, über den schmalen Schreibtisch, an dem Papa abends gearbeitet hatte, wo er in ein kleines Aufnahmegerät mit gezackten Rädchen diktierte, das seine Wörter verschlang.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "25548ce3-0244-4043-bcf7-024e424ca412",
                        "source_entry_id": "f0f8acc3-32dc-3435-8d67-985f5c66db6a",
                        "source_sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                        "source_sense_description": "kleines Rad",
                        "target_lang_word": "small wheel",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": []
                    },
                    {
                        "translation_id": "733e522e-5b0d-4c55-91a7-7c2569433962",
                        "source_entry_id": "f0f8acc3-32dc-3435-8d67-985f5c66db6a",
                        "source_sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                        "source_sense_description": "kleines Rad",
                        "target_lang_word": "rouage",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "rouage",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "4d5367bb-c265-31f8-8665-8e18ba51de44",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Élément de roue."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c9716587-6e59-4c51-81cc-5569f980da37",
                                                "sense_id": "4d5367bb-c265-31f8-8665-8e18ba51de44",
                                                "text": "Bois de rouage, celui qu’on emploie à faire des roues."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Chacune des pièces qui concourent au fonctionnement d’une machine."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "819097c1-5739-4528-83c1-92afb7da03ca",
                                                "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                                "text": "Un rouage du moteur s’est brisé. Les rouages d’une montre, d’une locomotive."
                                            },
                                            {
                                                "example_id": "e915ea0d-2cf1-4f44-9edf-16d9af8d0721",
                                                "sense_id": "2ddc1778-df6a-379d-9a61-8503ac84884c",
                                                "text": "Jetant l’ouvrier dans la bourdonnante oisiveté de la caserne, il détourne l’être jeune et robuste du métier qu’il connaît, des activités que lui confère un long apprentissage, ne lui demandant autre chose, en retour, que d’obéir sans raison, d’obéir sans honneur, d’obéir comme une brute, comme un rouage silencieux dans un appareil de mort."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Mécanisme à fonctionnement régulier et prévisible."
                                        ],
                                        "tags": [
                                            "figuratively",
                                            "plural"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6167c61d-5826-4fa4-a109-7a8aef918661",
                                                "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                                "text": "Le boîtier ouvert lui avait livré l’état désespérant d'un mécanisme hors d'usage : rouages encrassés, ressort cassé, cette montre était morte, non de maladie mais de vieillesse."
                                            },
                                            {
                                                "example_id": "18a738ad-ed40-4506-a03b-10553d2b9e67",
                                                "sense_id": "1558f5dd-db46-3f08-8f45-10b07afb00ea",
                                                "text": "tourner comme les rouages d’une montre"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Chaque élément participant au fonctionnement d’un ensemble."
                                        ],
                                        "tags": [
                                            "figuratively"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "b0378ae8-03ad-456d-b015-90d0d47c3757",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Le vieillard devait avoir soixante-dix ans, […]. On devinait dans ce corps rachitique une effrayante usure de tous les rouages organiques."
                                            },
                                            {
                                                "example_id": "d5603fc3-1d51-470c-9fc3-4aeedbab4810",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Ceux qui ne souffrent pas très cruellement ont une sensation de malaise. Ils comprennent qu'il se passe quelque chose d'anormal, que les rouages sociaux sont faussés."
                                            },
                                            {
                                                "example_id": "e9faea30-8595-4813-9632-e686e1ead56f",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Car la culture devient vite un enfer pour qui n’est pas de la partie, ne maîtrise pas les rouages, croit – à tort – que c’est plus aisé de la bouger que de réformer la SNCF, ne sait pas tenir tête aux artistes."
                                            },
                                            {
                                                "example_id": "a4390bee-fc2c-4189-b88e-34e2be6df9f8",
                                                "sense_id": "86b23f9b-9e68-3099-812b-3646ff595665",
                                                "text": "Les médias demeurent un rouage du théâtre de la politique, mais on sent bien qu’ils façonnent de moins en moins les opinions."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "9c7ec00a-db74-38bf-be6d-a116830f68f1",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Paiement de la location des places occupées dans les foires ou les marchés par les marchands étrangers."
                                        ],
                                        "tags": [
                                            "Au Moyen Âge"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "123a7144-a224-369b-b21b-76a24e9f0194",
                                        "entry_id": "d4a93475-d27d-3057-934b-e7504a32c2a9",
                                        "glosses": [
                                            "Péage pour circuler sur les routes."
                                        ],
                                        "tags": [
                                            "Droit d’Ancien Régime"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "8c530f8b-fbd6-4ab5-b784-d05820316490",
                        "source_entry_id": "f0f8acc3-32dc-3435-8d67-985f5c66db6a",
                        "source_sense_id": "06817d29-cb3a-32b6-8f44-1eb2ab7e01f8",
                        "source_sense_description": "kleines Rad",
                        "target_lang_word": "roulette",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "roulette",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Petite roue de bois, de fer, de cuivre, etc., servant à faire rouler les objets auxquels elle est attachée."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7eca6066-6ce8-457f-961c-df25b0a7c3c7",
                                                "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                                "text": "Ce n’est qu’en frémissant qu’il posait le pied dans un bateau, ce véhicule nautique fût-il assuré par une traille à roulettes."
                                            },
                                            {
                                                "example_id": "660973b5-be46-4240-b9a8-e521ea1d248f",
                                                "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                                "text": "Llouba était devenue sous ses pinceaux une princesse intersidérale, sur un cheval blanc à roulettes."
                                            },
                                            {
                                                "example_id": "4d9d31b1-6fd7-45ca-b369-11abb1cb9b2f",
                                                "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                                "text": "Les échelles de bibliothèques sont posées sur des roulettes."
                                            },
                                            {
                                                "example_id": "73ca4eef-5ce1-4698-a78e-909933b76db0",
                                                "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                                "text": "Les roulettes d’un lit, d’une table, d’un fauteuil."
                                            },
                                            {
                                                "example_id": "ece7b458-acf2-448f-9285-7db5e10a5ff0",
                                                "sense_id": "ff72c5fc-6f09-3eb3-8b48-4bed9ff190ec",
                                                "text": "Un lit, un fauteuil à roulettes."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "c9cdcdc7-05f0-38ad-82a4-fd6efd4e9fd3",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Instrument de fer en forme de petite roue pour tracer des filets."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "e89e553f-b018-3dee-96a4-8438a6bae7e4",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Instrument en forme de petite roue, à l’usage des graveurs, des pâtissiers, des cordonniers, des corroyeurs, des brodeurs, des dentistes, etc."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "10927539-1cb0-3057-bc4e-694e65fdcb8e",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Jeu de hasard, où une petite boule d’ivoire, lancée dans un cercle divisé en soixante-seize cases numérotées en rouge et en noir, détermine le gain, suivant le numéro et la couleur de la case où elle s’arrête."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f12f44f3-1b02-4a71-83e6-e752a1f33242",
                                                "sense_id": "10927539-1cb0-3057-bc4e-694e65fdcb8e",
                                                "text": "Il perdit tout son argent à la roulette."
                                            },
                                            {
                                                "example_id": "4c7e2ed1-66d8-4f96-9c0d-37c003b65e25",
                                                "sense_id": "10927539-1cb0-3057-bc4e-694e65fdcb8e",
                                                "text": "Elle reprit les paquets, les étala l’un au-dessus de l’autre, les examina comme un joueur examine les trente-six numéros de la Roulette, avant de risquer sa mise."
                                            },
                                            {
                                                "example_id": "309e09ec-4758-4835-9fc9-df54adf6f4a0",
                                                "sense_id": "10927539-1cb0-3057-bc4e-694e65fdcb8e",
                                                "text": "Dans toute affaire, il y a du bon et du mauvais de chaque côté : si je me trompe aujourd’hui, j’ai chance de me rattraper demain, et, comme je n’ai pas de parti pris, ça finit par s’équilibrer. C’est la règle de la roulette."
                                            },
                                            {
                                                "example_id": "7574370e-7199-4fef-bdc7-d612563d2ba4",
                                                "sense_id": "10927539-1cb0-3057-bc4e-694e65fdcb8e",
                                                "text": "Au hasard j'ouvre le journal\n Crime passionnel rue Lacordaire\n Paraît qu'ça va d'plus en plus mal\n Pour les mangeurs de pommes de terre\n Paraît aussi qu'le président\n S'amuse à jouer à la roulette\n Entre deux annonces, à la page cent\n Avec c'qui reste de la planète."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "97033b9d-1260-3efd-9afb-015f7ff8fa45",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Appareil qui sert à ce jeu."
                                        ],
                                        "tags": [
                                            "broadly"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "8653916b-9532-3799-844f-3ef64cc67590",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Cycloïde ; ligne courbe que décrit un point de la circonférence d’un cercle qui roule sur un plan."
                                        ],
                                        "tags": [
                                            "dated"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c06197d9-d69f-4cd8-9fd7-19b9c05e5824",
                                                "sense_id": "8653916b-9532-3799-844f-3ef64cc67590",
                                                "text": "Pascal a composé un Traité de la roulette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "20624fc5-871e-390b-8bca-582629588f49",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Fraise dentaire."
                                        ],
                                        "tags": [
                                            "familiar"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "54f03c8f-9177-3d03-ab9c-0b753a9d1153",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Paire de roulettes qui se fixe à l’arrière des vélos au début de l'apprentissage."
                                        ],
                                        "tags": [
                                            "plural"
                                        ],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "164b78fe-dbb7-3c74-a89f-9697fa70c89d",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Dribble très technique consistant à entraîner le ballon en le faisant rouler sous le pied tout en pivotant sur soi-même de manière à contourner un joueur de l’équipe adverse."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "2af30f4c-1f4c-49b6-b14c-742f2829aa99",
                                                "sense_id": "164b78fe-dbb7-3c74-a89f-9697fa70c89d",
                                                "text": "Boudebouz s’illustre aux 20 mètres avec deux roulettes successives avant d’écarter sur Palmieri dont le centre tendu ne trouve pas preneur."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "1dbd3993-520b-3b68-b696-d47e2aaa9680",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Rouleau de timbres-poste destinés à alimenter les distributeurs automatiques. Les timbres y sont dentelés sur seulement 2 côtés. Cette présentation, aujourd'hui disparue, fut inventée en 1900."
                                        ],
                                        "tags": [
                                            "Poste"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "a3a7c9b2-ca7c-4173-aed6-6024972bc591",
                                                "sense_id": "1dbd3993-520b-3b68-b696-d47e2aaa9680",
                                                "text": "Les timbres-poste vendus à la roulette - On se souvient qu'en 1900, Léon Mougeot avait fait expérimenter à la poste de la rue du Louvre un distributeur automatique de timbre."
                                            },
                                            {
                                                "example_id": "44f8f21a-c16a-41b2-8ec5-ac6d7c92daab",
                                                "sense_id": "1dbd3993-520b-3b68-b696-d47e2aaa9680",
                                                "text": "Timbre en roulette, timbre de roulette, timbre à la roulette."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "d4413b30-edc0-3b9a-8b04-dabe406dbe8f",
                                        "entry_id": "4677473a-7d13-3bda-a67f-6ce92b20e73c",
                                        "glosses": [
                                            "Petit cylindre de plastique dur monté sur un manche qui sert à bien faire coller en l’aplatissant le bord d'un papier à tapisser."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    }
                                ]
                            }
                        ]
