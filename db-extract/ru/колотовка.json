                "senses": [
                    {
                        "sense_id": "5a2e3444-d8fc-3a0c-9007-b4cb8f62d6c0",
                        "entry_id": "a175391c-efa8-3a37-abb2-ee2c312e0b34",
                        "glosses": [
                            "бран., устар. драчливая и сварливая женщина"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0dd3408e-ac32-4444-a256-d297ea49e818",
                                "sense_id": "5a2e3444-d8fc-3a0c-9007-b4cb8f62d6c0",
                                "text": "― Слушай ты, колотовка: если я ворочусь домой да приведу с собой товарищей, так мы не только тебя в гроб забьем, ведьму проклятую, да и чертово гнездо-то твое вверх дном поставим!"
                            },
                            {
                                "example_id": "4157725a-b768-4705-99ae-692072d82ae7",
                                "sense_id": "5a2e3444-d8fc-3a0c-9007-b4cb8f62d6c0",
                                "text": "Золовки ― колотовки, ну а уж эта мухи не обидит."
                            }
                        ]
                    }
