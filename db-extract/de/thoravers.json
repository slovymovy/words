                "senses": [
                    {
                        "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                        "entry_id": "a42f753f-acaa-3ea3-a093-3e367887614c",
                        "glosses": [
                            "sinnvoller kleiner Abschnitt (Vers) aus dem ersten Teil der hebräischen Bibel (Thora)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b051f51b-4ccc-407a-a521-af206c277bf5",
                                "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                                "text": "„‚Israel geht mich an‘, sagt Mutter Mirjam und zitiert in Hebräisch einen Thoravers.“"
                            },
                            {
                                "example_id": "df9f143c-daf4-4cc1-96c0-2eccb0adb24e",
                                "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                                "text": "„In dem Thoravers, der auf den oben zitierten folgt, kommt das Wort „Goi“ in Bezug auf das jüdische Volk vor.“"
                            },
                            {
                                "example_id": "86843034-9112-4520-85aa-47c4307883aa",
                                "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                                "text": "„Er denkt an einen Thoravers. \"Du sollst den Fremdling nicht bedrücken\", so fängt er an, und weiter?“"
                            },
                            {
                                "example_id": "e4f642ae-1fd7-421b-b7e3-1ca0091aa243",
                                "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                                "text": "„Yosef rezitiert die Preise von Parmesan und Wein auf den Märkten von Venetien wie einen Thoravers.“"
                            },
                            {
                                "example_id": "cb38e451-ecbf-4e46-8d85-16b08f8747f2",
                                "sense_id": "b34007eb-b076-3ba3-ac59-db761ea11174",
                                "text": "„Schon der Prophet Jeremia warnt im 17. Kapitel seines Buches: „Und bringt keinerlei Last aus Euren Häusern heraus am Schabbattage!\" Auch das Gehverbot, nach dem strikten Wortsinn des Thoraverses, beginnt zwei Meter neben dem Ort, an dem man sich befindet.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
