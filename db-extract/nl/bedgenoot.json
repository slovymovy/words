                            "masculine"
                        ],
                        "examples": [
                            {
                                "example_id": "e2941793-769a-4ab0-8b57-aae2bb37af17",
                                "sense_id": "560ced15-9802-31e5-aaa6-a8cd3cb539ba",
                                "text": "Ik was verrast om te ontdekken dat mijn kamergenoot ook mijn bedgenoot zou zijn tijdens de reis.",
                                "translation": "I was surprised to find out my roommate would also be my bedfellow during the trip.",
                                "english": "I was surprised to find out my roommate would also be my bedfellow during the trip."
                            },
                            {
                                "example_id": "ab78ddbb-7a0d-4cbe-a964-612053ab2639",
                                "sense_id": "560ced15-9802-31e5-aaa6-a8cd3cb539ba",
                                "text": "Het was even wennen om een bedgenoot te hebben.",
                                "translation": "It took some getting used to having a bedmate.",
                                "english": "It took some getting used to having a bedmate."
                            },
                            {
                                "example_id": "b144c65e-1837-4c63-be8a-950eb8962b97",
                                "sense_id": "560ced15-9802-31e5-aaa6-a8cd3cb539ba",
                                "text": "Tijdens het kamp waren we met drie bedgenoten in een bed.",
                                "translation": "During the camp, we were three bedfellows in one bed.",
                                "english": "During the camp, we were three bedfellows in one bed."
                            }
                        ]
                    },
                    {
                        "sense_id": "a98975c7-4f53-335a-844d-ef5e1fa57c07",
                        "entry_id": "b86a52e1-48b3-3ae2-863a-db4a2fee05fc",
                        "glosses": [
