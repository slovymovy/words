                "senses": [
                    {
                        "sense_id": "2114dd0b-74b7-3ab5-8559-c5b8b1919dfe",
                        "entry_id": "bc6d7f3b-01f7-3f0a-9251-a27915eecd25",
                        "glosses": [
                            "durch Stress verursacht, auf Stress zurückzuführen"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ad42cad0-5a2a-407a-b1f0-18c32cc05ba3",
                                "sense_id": "2114dd0b-74b7-3ab5-8559-c5b8b1919dfe",
                                "text": "„Der Zähler läuft ununterbrochen, und man häuft Jahr um Jahr zusätzlicher Folter an, behauptet Babette, die früher für andere Leute den Papierkram erledigt hat, bis sie sich wegen stressbedingter Arbeitsunfähigkeit von der Büroarbeit freistellen lassen und für eine kleine Erholungspause in ihren Käfig zurückkehren musste.“"
                            }
                        ],
