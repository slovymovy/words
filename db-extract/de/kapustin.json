                "senses": [
                    {
                        "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                        "entry_id": "96ef37e6-2564-352c-99b4-33b96bbfb89e",
                        "glosses": [
                            "Familienname, Nachname"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "c5f60d18-cf33-4865-9b4d-5d342d3ada4c",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Frau Kapustin ist ein Genie im Verkauf."
                            },
                            {
                                "example_id": "44085967-1d69-4fde-93e9-33cfd66aca3b",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Herr Kapustin wollte uns kein Interview geben."
                            },
                            {
                                "example_id": "dcf92388-a7ea-4733-b55c-c819922afb5e",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Die Kapustins fahren heute nach Leipzig."
                            },
                            {
                                "example_id": "95cc757f-d490-49f8-8f84-247283cadb25",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Der Kapustin trägt nie die Schals, die die Kapustin ihm strickt."
                            },
                            {
                                "example_id": "6520850a-605b-4d29-b8b5-22c0bfa9ccad",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Das kann ich dir aber sagen: „Wenn die Frau Kapustin kommt, geht der Herr Kapustin.“"
                            },
                            {
                                "example_id": "26eb2d1c-2c3f-4931-97b7-19de918133a5",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Kapustin kommt und geht."
                            },
                            {
                                "example_id": "f39deea4-beda-4ed1-9b50-5781aa238b08",
                                "sense_id": "5ed367bd-c0f9-3935-ae77-02507b9d44e9",
                                "text": "Kapustins kamen, sahen und siegten."
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
