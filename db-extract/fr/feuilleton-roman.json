                        "entry_id": "8efe868d-9550-3d1b-b1e1-17e3b061f427",
                        "glosses": [
                            "Feuilleton littéraire paraissant dans un journal, dont le tout constitue un roman."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "92fac028-3b6d-4529-9c86-cde2c56e0127",
                                "sense_id": "303cbe10-326b-3840-b117-b38bab200477",
                                "text": "Mon père n’aime pas George Sand parce qu’elle fait paraître des feuilletons-romans dans les gazettes !"
                            },
                            {
                                "example_id": "58dd6456-92a8-4931-b4f2-e0d7cefe4e0e",
                                "sense_id": "303cbe10-326b-3840-b117-b38bab200477",
                                "text": "Ses feuilletons-romans, en 1838, sont d’Eugène Scribe, Balzac et Mme Charles Reybaud, mais ils paraissent d’abord dans une rubrique « Littérature », en page 3."
                            },
                            {
                                "example_id": "dc1da715-e225-4657-8acd-4d0792454eb3",
                                "sense_id": "303cbe10-326b-3840-b117-b38bab200477",
                                "text": "Parlons plus vrai, le feuilleton-roman n’est qu’un théâtre mobile qui va chercher les spectateurs, au lieu de les attendre."
                            }
                        ]
                    }
