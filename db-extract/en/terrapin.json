        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "36073464-5284-3527-9d02-8169a1124cff",
                "word": "terrapin",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "7b583c00-ffc1-42c1-a130-359a9bda9704",
                        "entry_id": "36073464-5284-3527-9d02-8169a1124cff",
