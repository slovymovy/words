                ],
                "senses": [
                    {
                        "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                        "entry_id": "645325dc-925c-307e-86d0-3bc244548c05",
                        "glosses": [
                            "Initialism of date of birth."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "1ea95669-3c4b-46b6-92ef-113597834f29",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "A-SSN verified on name, DoB and sex"
                            },
                            {
                                "example_id": "a569299b-2fef-457b-a058-40b76f7f4917",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "For those who treat horoscopes as gospel truth, the Supreme Court had dished out a bitter truth - the date of birth (DoB) of a person entered in a horoscope can never be given primacy over the DoB mentioned in his School Leaving Certificate (SLC). “Horoscope is a very weak material to prove age of a person,” a Bench comprising Justice Arijit Pasayat and Justice S H Kapadia on Mar 14 said allowing an appeal of Punjab government challenging a High Court order ruling in favour of a person who had relied on the horoscope for proving his DoB."
                            },
                            {
                                "example_id": "5cf972a0-0d00-4220-965e-25bf8302c53c",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "DoB = BIRTH/BAPTISM: Where possible we have given a precise date of birth or baptism, usually taken from the Barra Parish Register."
                            },
                            {
                                "example_id": "7fc588f5-4ab2-4ce6-9b1b-4734e096b539",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "Name / Address / City / ZIP / DoB / Sex / Education"
                            },
                            {
                                "example_id": "f5dc487e-8e18-4e20-a742-c25b88906e42",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "ID / First Name / Last Name / DoB / Gender / City / Country"
                            },
                            {
                                "example_id": "26efc42f-03a2-46ec-9340-cddf47164eea",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "name / DoB / position / matches / goals"
                            },
                            {
                                "example_id": "9ff78eab-54c3-411f-a5c2-a03d3563cbb7",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "DoB = 1988-05-15 12:29:58"
                            },
                            {
                                "example_id": "6934f1a2-b2f0-4699-9aeb-d705d62c1048",
                                "sense_id": "a0d67ae1-7317-3b61-addf-8edb0ece8a94",
                                "text": "Enter Your DoB: dd-mm-yy"
                            }
                        ]
                    },
                    {
                        "sense_id": "65b9fc1d-f284-3e06-a3dd-5f5dcd8dbef6",
                        "entry_id": "645325dc-925c-307e-86d0-3bc244548c05",
                        "glosses": [
                            "Initialism of degree of bending."
                        ],
                        "tags": [
                            "abbreviation",
                            "alt-of",
                            "initialism"
                        ],
                        "examples": [
                            {
                                "example_id": "aada0d49-dd07-45e7-b5d2-1e8dbb01a1f6",
                                "sense_id": "65b9fc1d-f284-3e06-a3dd-5f5dcd8dbef6",
                                "text": "Through-the-thickness stress distribution characterized by the degree of bending (DoB) has a major effect on the fatigue behavior of tubular joints commonly found in steel offshore structures. The determination of DoB values is essential for improving the accuracy of fatigue life estimation using the stress-life (S–N) method […]"
                            }
                        ]
                    }
                ],
