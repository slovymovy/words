                        "glosses": [
                            "Petite ferme cultivé par un soldat de réserve, bénéficiant d’un entraînement militaire périodique, dans le système suédois de l’indelta."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "28518d43-728e-41d5-88d2-156757c80052",
                                "sense_id": "78e6157a-140f-368a-badb-fb9d3aa7f59e",
                                "text": "Le torp est la chaumière du soldat laboureur."
                            },
                            {
                                "example_id": "1b8e1a14-d11d-443b-9583-298490a3c647",
                                "sense_id": "78e6157a-140f-368a-badb-fb9d3aa7f59e",
                                "text": "En temps de paix, les soldats de l’Indelta restent dans le torp qu’ils cultivent, n’étant astreints qu’à des manœuvres pendant le mois de juin."
                            },
                            {
                                "example_id": "55893733-1308-461e-8b97-33ab16f4c055",
                                "sense_id": "78e6157a-140f-368a-badb-fb9d3aa7f59e",
                                "text": "Un torp est composé d’une chaumière, d’un jardin et de quelques arpents de terre."
                            }
                        ]
                    }
