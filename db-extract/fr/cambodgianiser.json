                "senses": [
                    {
                        "sense_id": "d90ea094-1ecb-319f-b66e-2959095093a2",
                        "entry_id": "e41eed4a-bead-3106-9277-75a781450622",
                        "glosses": [
                            "Donner un caractère cambodgien à."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "5587cbac-343e-475b-87f0-5a5201d42ea1",
                                "sense_id": "d90ea094-1ecb-319f-b66e-2959095093a2",
                                "text": "Un majordome chinois cambodgianisé, des suivantes cambodgiennes et une naine composaient l’entourage de la reine."
                            },
                            {
                                "example_id": "899c4150-b2f7-49b6-b290-f5c4b30c7a63",
                                "sense_id": "d90ea094-1ecb-319f-b66e-2959095093a2",
                                "text": "Sous cette influence, les concessions conceptualisées et mises en place depuis longtemps pour les ressources naturelles ont été étendues aux infrastructures… dans une version quelque peu cambodgianisée du modèle."
                            },
                            {
                                "example_id": "dface074-8fa0-4e6c-83ec-928651a5293b",
                                "sense_id": "d90ea094-1ecb-319f-b66e-2959095093a2",
                                "text": "(…) qui revient plusieurs fois sous la forme cambodgianisée (…)."
                            }
                        ]
                    }
