                            {
                                "example_id": "96427034-c667-4d8b-a565-5d77f94f62be",
                                "sense_id": "b5e84e38-5645-349c-964b-d66daa12eae7",
                                "text": "Meng de poedersuiker en melk tot een glazuur. Eventueel wat melk toevoegen als het te dik wordt. Trek met een tl zigzaglijntjes over de crumble van de cupcakes."
                            },
                            {
                                "example_id": "4456a99c-ce51-41b4-a457-8378f6e1c06b",
                                "sense_id": "b5e84e38-5645-349c-964b-d66daa12eae7",
                                "text": "Door het gele gras langs de oever van de IJssel loopt een groene zigzaglijn. Het spoor van een loopgravenlinie uit de Tweede Wereldoorlog, zichtbaar geworden door de droogte."
                            }
                        ]
