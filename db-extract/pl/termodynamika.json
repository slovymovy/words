                                "target_senses": [
                                    {
                                        "sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                                        "entry_id": "bc097326-508b-34ae-8c7e-e3fb6a45b68f",
                                        "glosses": [
                                            "de leer van warmte en arbeid"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "cdbafa40-1a3f-4a77-bc19-97716f7539ad",
                                                "sense_id": "504a66b8-73da-38dc-858a-23a9a301950b",
                                                "text": "De ontwikkeling van de thermodynamica kwam voort uit de ontwikkeling van de stoommachine enerzijds en van de differentiaalrekening anderzijds."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "25d3b570-0104-4427-a189-5e60bfd1d729",
                        "source_entry_id": "977d101b-8440-33ee-8450-38dca073cbe2",
                        "source_sense_id": "a737f9c6-f80c-31d8-9209-b59cb9a51987",
                        "target_lang_word": "Thermodynamik",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Thermodynamik",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                        "entry_id": "d232f483-ab21-3ff0-9bce-f9c0b988b8af",
                                        "glosses": [
                                            "Wissenschaft, die sich mit der Wirkung von Wärme beschäftigt; die Lehre der thermischen Energie, ihre Erscheinungsformen und nutzbaren Fähigkeiten"
                                        ],
                                        "tags": [
                                            "physics"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "6a28e0b1-298e-4d08-b981-7e73328b1787",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Wir wollen damit beginnen, die Thermodynamik in den Rest der Physik einzuordnen.“"
                                            },
                                            {
                                                "example_id": "a30472a5-84af-441b-8880-8ffc3de9d4ef",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Thermodynamik ist die allgemeine Theorie energie- und stoffumwandelnder Prozesse.“"
                                            },
                                            {
                                                "example_id": "53845eba-a05d-4e4e-8607-6a8217b5e071",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die Thermodynamik sagt aus, dass eine Reaktion dann „freiwillig“ ablaufen kann, wenn die Differenz der freien Enthalpie zwischen Ausgangs- und Endzustand negativ ist (0<∆G).“"
                                            },
                                            {
                                                "example_id": "373d7945-9bd0-47b0-9068-9548adc1c0b9",
                                                "sense_id": "c348e206-84ea-388f-a1ee-a70b7425f4ba",
                                                "text": "„Die folgende Phase war gekennzeichnet durch das Bestreben, die wissenschaftlichen Erkenntnisse der Thermodynamik praktisch zu nutzen und so spielen vor allem Ingenieure eine herausragende Rolle.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e0e14057-c284-4865-bf6f-d5bda22c857a",
                        "source_entry_id": "977d101b-8440-33ee-8450-38dca073cbe2",
                        "source_sense_id": "a737f9c6-f80c-31d8-9209-b59cb9a51987",
                        "target_lang_word": "термодинамика",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "термодинамика",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "22cf5e73-02eb-31db-9854-6a6c0241e511",
                                        "entry_id": "9788c922-876a-33ae-930a-d818a5d1aad8",
                                        "glosses": [
                                            "физ. раздел физики, изучающий законы теплового движения, влияние теплового движения на физические свойства тела, превращение теплоты в другие виды энергии, состояния и процессы, для описания которых можно ввести понятие температуры"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5d6b7f80-da3c-4982-b7e3-bab7ae211a57",
                                                "sense_id": "22cf5e73-02eb-31db-9854-6a6c0241e511",
                                                "text": "Благодаря известным законам Ньютона мы можем метко стрелять и запускать ракеты, а благодаря законам термодинамики ― конструировать холодильники и автомобильные двигатели."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6a3514b2-27d8-35aa-ae71-2e297a559ce9",
                                        "entry_id": "9788c922-876a-33ae-930a-d818a5d1aad8",
                                        "glosses": [
                                            "учебный предмет, содержащий теоретические основы данного раздела физики"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "6ca181ca-79f6-46de-ad9e-1eab9d30b008",
                                                "sense_id": "6a3514b2-27d8-35aa-ae71-2e297a559ce9",
                                                "text": "Конечно, энтропия не такое простое понятие, как энергия. Поэтому энтропию изгнали из средней школы, и студенты часто мучаются, готовясь к экзаменам по термодинамике."
                                            },
                                            {
                                                "example_id": "39a3211d-e029-428e-87a6-3e629055cc51",
                                                "sense_id": "6a3514b2-27d8-35aa-ae71-2e297a559ce9",
                                                "text": "― Сижу вечером в аудитории, ― должна была быть лекция по термодинамике; вдруг влетает Женька Ястребова, золотая копна волос чуть прикрыта платком."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4b861e76-8471-3e17-b5d1-7b0ea1f6f526",
                                        "entry_id": "9788c922-876a-33ae-930a-d818a5d1aad8",
                                        "glosses": [
                                            "разг. учебник, излагающий содержание данного учебного предмета"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "553e4b68-f564-4cf4-b343-c0f806a34005",
                                                "sense_id": "4b861e76-8471-3e17-b5d1-7b0ea1f6f526",
                                                "text": "Так запоем читать термодинамику в каникулы мог только псих или отличник."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
