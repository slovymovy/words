                                        "sense_id": "b9bb11dc-bc5c-31d5-9342-cb211c86d7de",
                                        "entry_id": "79b1f24f-6363-3554-a707-fc7383df4c9e",
                                        "glosses": [
                                            "Propriété d’un système ou d’un matériau dont l’état dépend de l’histoire des sollicitations auxquelles il a été soumis, ou du sens de variation de ces sollicitations."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "f731b707-950b-40db-871d-01d5e3ee9eff",
                                                "sense_id": "b9bb11dc-bc5c-31d5-9342-cb211c86d7de",
                                                "text": "La courbe d’aimantation du fer présente une hystérèse ferromagnétique bien marquée."
                                            },
                                            {
                                                "example_id": "4e92b3b0-bb87-48cb-bc00-f8bedf7406eb",
                                                "sense_id": "b9bb11dc-bc5c-31d5-9342-cb211c86d7de",
                                                "text": "Ce thermostat coupe le chauffage à 65°C, et l’enclenche à nouveau à 60°C ; il a donc une hystérèse en température de 5°C."
                                            },
                                            {
                                                "example_id": "8bd1da2b-4984-4a8e-8b07-29190db17fd1",
                                                "sense_id": "b9bb11dc-bc5c-31d5-9342-cb211c86d7de",
                                                "text": "Un thermostat qui coupe le chauffage à 100 degrés Celsuis, et l'enclenche à 70 degrés Celsuis a une hystérèse de 30 degrés Celsuis."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e599ed61-f5ac-3be5-8767-d11c7d6689a5",
                                        "entry_id": "79b1f24f-6363-3554-a707-fc7383df4c9e",
                                        "glosses": [
                                            "Décalage entre le moment où la concentration maximale de médicament dans le sang est atteinte et l’instant où son effet est maximal."
                                        ],
                                        "tags": [
                                            "Pharmacocinétique-pharmacodynamie"
                                        ],
                                        "examples": []
                                    }
                                ]
                            }
