                                        "entry_id": "97994e32-6642-381a-ad52-1440a0f39ca2",
                                        "glosses": [
                                            "Dark silt accumulating mainly from airborne volcanic sediment or soot from artificial pollution, or detritus in water of ablation from ice sheets or glaciers. Cryoconite typically appears either as surface discoloration or in cryoconite holes."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "9f30817f-4a06-42bf-ad5f-d328d202e6d2",
                                                "sense_id": "77e8264a-308d-3b0b-a182-ea22ad9dc385",
                                                "text": "In these environments the cryoconite, a wind-borne fine debris deposited on glacier surfaces, represents a potential sink for organic and inorganic pollutants because of its high content of organic matter."
                                            }
