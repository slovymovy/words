                        "entry_id": "4907599b-8d83-3a12-be7e-d38bd38b2509",
                        "glosses": [
                            "Individu qui nourrit une profonde affection pour une marque, un produit, une œuvre, un artiste ou simplement un point de vue sur quelque chose, jusqu’à un niveau obsessionnel voire maladif."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "d32f959b-4c8a-42d1-9e91-11e7c81502ab",
                                "sense_id": "0bc3e484-23ef-36a5-83d2-3d1f25557d11",
                                "text": "Ce dernier la lui serra avec le regard farouche d’un fanboy Macintosh."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "83870ce1-c294-4a46-9cb3-9bc51801135c",
                        "source_entry_id": "4907599b-8d83-3a12-be7e-d38bd38b2509",
                        "source_sense_id": "0bc3e484-23ef-36a5-83d2-3d1f25557d11",
                        "target_lang_word": "fanboy",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "fanboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                        "entry_id": "525b19af-ab61-3ed3-86ea-d3fc27f996fb",
                                        "glosses": [
                                            "A male fan who is obsessive about a particular subject (especially, something or someone in popular entertainment media)."
                                        ],
                                        "tags": [
                                            "derogatory",
                                            "often",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "bccdb496-e7dd-42d1-948d-55e1ecf0e2f0",
                                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                                "text": "(It's in the nature of comic book fanboy obsessiveness that all of these Eras and Ages and such have been religiously chronicled; it's equally in their nature that no two fanboys can ever agree about anything about any of these Ages and Eras; everything is up for debate, eternally and in microscopic detail.)"
                                            },
                                            {
                                                "example_id": "a834457c-25cb-4bb5-983f-2c4801d5fab3",
                                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                                "text": "Six years and seven titles later, their company, Top Cow, is the third-biggest-grossing comic line, thanks mainly to a pair of blood-soaked, modern-day Gothics that have been a hit both with fanboys and a growing number of women."
                                            },
                                            {
                                                "example_id": "8ee85c4e-a986-4534-b7a2-6e2c646207bd",
                                                "sense_id": "4e4cb22e-176f-327f-af9a-57a8d64fa1ec",
                                                "text": "Apple fanboys have always devoted equal parts of their mind to genuine reasons to praise their chosen corporation, and to blindly ignoring its faults."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "fanboy",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "407f5dfa-b14e-3dd5-9d96-a6eb5281b9f3",
                                        "entry_id": "86ada6dd-3dfb-3fef-80b9-2db5a12a1439",
                                        "glosses": [
                                            "To worship, support, drool over the object of affection; to be a fanboy."
                                        ],
                                        "tags": [
                                            "intransitive",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8d34b3d-b61a-4dc3-81e4-df4f7b17b3f0",
                                                "sense_id": "407f5dfa-b14e-3dd5-9d96-a6eb5281b9f3",
                                                "text": "James has a tendency to fanboy when something he likes is done wrong."
                                            },
                                            {
                                                "example_id": "de9edc7f-1fde-4fef-bc98-bff578b89afc",
                                                "sense_id": "407f5dfa-b14e-3dd5-9d96-a6eb5281b9f3",
                                                "text": "2019, Ocean Vuong, On Earth We’re Briefly Gorgeous, New York: Penguin, [Acknowledgements],\nTo Yusef Komunyakaa, thank you for […] tolerating my fanboying when, by luck, I sat down beside you one rainy night in a West Village theater […] and kept yapping about everything and nothing at all."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
