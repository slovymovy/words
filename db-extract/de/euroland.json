                "senses": [
                    {
                        "sense_id": "78605f9c-4fcd-32aa-b813-ed8c64ef143d",
                        "entry_id": "ae41f38d-fd52-3af1-a297-4d6c689ec015",
                        "glosses": [
                            "Staat, der den Euro als offizielle Währung eingeführt hat"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "326c31a1-6674-4cec-9aa0-3c38caccbdd0",
                                "sense_id": "78605f9c-4fcd-32aa-b813-ed8c64ef143d",
                                "text": "„Das Misstrauen der internationalen Finanzmärkte in die griechische Haushaltspolitik führte im Mai 2010 dazu, dass nur durch koordinierte Hilfsmaßnahmen anderer Euroländer, der Europäischen Union, der Europäischen Zentralbank und des Internationalen Währungsfonds (IMF) eine drohende Zahlungsunfähigkeit Griechenlands verhindert werden konnte.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "505aef61-6a73-4aeb-96bc-ecb70dda77ed",
                        "source_entry_id": "ae41f38d-fd52-3af1-a297-4d6c689ec015",
                        "source_sense_id": "78605f9c-4fcd-32aa-b813-ed8c64ef143d",
                        "source_sense_description": "Staat, der den Euro als offizielle Währung eingeführt hat",
                        "target_lang_word": "Euroland",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Euroland",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4f4567b7-f90d-3f67-b01a-e16663f2ac9a",
                                        "entry_id": "e7f4861d-94ef-37f5-b8a2-41bdc5f10fe3",
                                        "glosses": [
                                            "Europe; the European Union (or formerly the European Economic Community)."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous",
                                            "rare",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "49d69a52-9ce0-49d7-aea9-b3366757a1af",
                                                "sense_id": "4f4567b7-f90d-3f67-b01a-e16663f2ac9a",
                                                "text": "The banks might be small, or they might have recognizable names: Chase, Citicorp, Barclays, Bank of America, Deutsche Bank, Algemeine Nederland—all chartered Offshore and doing business in Euroland."
                                            },
                                            {
                                                "example_id": "83f9286c-ec14-4b73-9bbd-6959a70d904b",
                                                "sense_id": "4f4567b7-f90d-3f67-b01a-e16663f2ac9a",
                                                "text": "No doubt she had to append numerous documents detailing how the proposal would speed the harmonisation of tariff structures, improve the efficiency of intergovernmental consultation processes, etc, etc, for that is the way these things are done in Euroland."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ff4fa6bb-cb30-3640-8fb2-4eae7b78ed9f",
                                        "entry_id": "e7f4861d-94ef-37f5-b8a2-41bdc5f10fe3",
                                        "glosses": [
                                            "The group of countries in Europe that use the euro for currency."
                                        ],
                                        "tags": [
                                            "dated",
                                            "humorous",
                                            "rare",
                                            "sometimes"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "8a2f1802-6ba7-4037-a90e-1e03cb6bb274",
                                                "sense_id": "ff4fa6bb-cb30-3640-8fb2-4eae7b78ed9f",
                                                "text": "Marie lives in France, which is part of Euroland."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
