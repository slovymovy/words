                    {
                        "sense_id": "d10babb4-39d3-32c1-ac8f-ba38a952f2c5",
                        "entry_id": "6a25a5ec-5a58-33f2-bb91-1a282a70e481",
                        "glosses": [
                            "häufig vorkommendes, hartes Mineral, das vorwiegend zu Schmucksteinen verarbeitet wird"
