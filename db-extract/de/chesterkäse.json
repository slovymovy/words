                "senses": [
                    {
                        "sense_id": "4599a083-c33a-3787-ae39-3377720a71e5",
                        "entry_id": "2627e141-be0b-3967-9628-b7f31b5aabd1",
                        "glosses": [
                            "ursprünglich aus England stammender Hartkäse, der weiß oder durch Zugabe von Pflanzenfarbstoffen kräftig orangefarben auf den Markt kommt"
                        ],
                        "tags": [
                            "englische Küche"
                        ],
                        "examples": [
                            {
                                "example_id": "d689460f-0fe2-4360-9179-277289ed818e",
                                "sense_id": "4599a083-c33a-3787-ae39-3377720a71e5",
                                "text": "„Bevor ich zu dieser Versammlung fuhr, hatte mir meine Frau etwas zu essen mitgegeben, weil wir erwarteten, dass die Mitarbeiter mich in mein Büro einsperren würden, so wie in Belgien üblich. Etwas Chesterkäse in Silberpapier, dazu Droste-Schokoladenpastillen sollten mir über die Runden helfen.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "514b7afb-6c05-43f2-a268-9d57fac206ff",
                        "source_entry_id": "2627e141-be0b-3967-9628-b7f31b5aabd1",
                        "source_sense_id": "4599a083-c33a-3787-ae39-3377720a71e5",
                        "source_sense_description": "aus England stammender Hartkäse, der weiß oder kräftig orangefarben auf den Markt kommt",
                        "target_lang_word": "Cheshire cheese",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Cheshire cheese",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                        "entry_id": "22c378ba-90d1-339d-950e-1608a7d91536",
                                        "glosses": [
                                            "A dense and crumbly cheese produced in the English county of Cheshire."
                                        ],
                                        "tags": [
                                            "countable",
                                            "uncountable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "f147e77b-eb04-4d4e-beb9-c4d5911a0d03",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Would not he believe that he had the same Antipathy to a Candied Orange, or a Piece of Puff-Past, as some have to a Cheshire Cheese, or a Breast of Mutton?"
                                            },
                                            {
                                                "example_id": "14bda872-3f3a-4d91-b6d4-52c6a4a0e795",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Cheshire cheeses, on account of their great size, are generally packed flat, and in a single tier only."
                                            },
                                            {
                                                "example_id": "1e4ea2f4-1370-46ed-81d0-00921cfc8697",
                                                "sense_id": "590395a9-1c2e-3284-b96f-eb69c0d700df",
                                                "text": "Cheshire cheese had been sent to London from as early as the sixteenth century."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
