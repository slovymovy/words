                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "03773243-ffe9-4548-b501-54109add0db8",
                        "source_entry_id": "b5735739-9f81-3875-8d21-f8b3041acad0",
                        "target_lang_word": "чёрствый",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "чёрствый",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "3e6740e4-1212-3045-809c-e5a97f11cd1c",
                                        "entry_id": "1161840b-fdcd-35dd-b982-60b2a45f61c2",
                                        "glosses": [
                                            "о хлебе, мучных изделиях, реже о другой пище — утративший мягкость, свежесть, высохший"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "84a41535-a4b3-4ed2-859e-efafadd3995b",
                                                "sense_id": "3e6740e4-1212-3045-809c-e5a97f11cd1c",
                                                "text": "У меня кусок хлеба есть свой; правда, простой кусок хлеба, подчас даже чёрствый; но он есть, трудами добытый, законно и безукоризненно употребляемый."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "52759d75-58d9-3fc0-a31d-c4cb6bf3b4b3",
                                        "entry_id": "1161840b-fdcd-35dd-b982-60b2a45f61c2",
                                        "glosses": [
                                            "перен. лишённый душевной чуткости"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d574357b-8725-401a-a36b-0358f7fb1834",
                                                "sense_id": "52759d75-58d9-3fc0-a31d-c4cb6bf3b4b3",
                                                "text": "Теперь товарищ мне иной дух отрицанья — // Не тот насмешник чёрствый и больной, // Но тот всесильный дух движенья и созданья, // Тот вечно юный, новый и живой."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    }
