    "entries": [
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "70446c5d-05ce-3a2a-9c12-74d3baff3893",
                    "sense_definition": "als Flüssigkeit von einem Ort wegströmen",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Warum <w>fließt</w> das schmutzige Wasser hier nur so langsam <w>ab</w>?"
                        },
                        {
                            "text": "Nach dem schweren Unwetter konnte der viele Regen nicht schnell genug <w>abfließen</w>."
                        }
                    ],
                    "synonyms": [
                        "ablaufen",
                        "wegfließen"
                    ],
                    "antonyms": [
                        "zufließen"
                    ],
                    "common_phrases": [
                        "langsam abfließen",
                        "schnell abfließen",
                        "Wasser abfließen lassen"
                    ]
                },
                {
                    "sense_id": "5debc886-0c20-32d2-9bed-0f0b0f9df693",
                    "sense_definition": "durch das Wegrinnen einer Flüssigkeit entleert werden",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "bewegung",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das Becken <w>fließt</w> wegen der vielen Haare fast gar nicht mehr <w>ab</w>."
                        },
                        {
                            "text": "Wenn die Spüle nicht richtig <w>abfließt</w>, müssen wir ein Reinigungsmittel benutzen."
                        }
                    ],
                    "synonyms": [
                        "ablaufen"
                    ],
                    "common_phrases": [
                        "nicht abfließen"
                    ]
                },
                {
                    "sense_id": "a25f4960-ec59-3c13-999c-88b74e2846ff",
                    "sense_definition": "in großer Menge an einen anderen Ort oder in fremde Hände gelangen (besonders Geld oder Kapital)",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Durch Korruption <w>fließt</w> jedes Jahr jede Menge Geld ins Ausland <w>ab</w>."
                        },
                        {
                            "text": "Die Regierung fürchtet, dass während der Wirtschaftskrise weiteres Kapital <w>abfließen</w> könnte."
                        }
                    ],
                    "synonyms": [
                        "ablaufen"
                    ],
                    "antonyms": [
                        "zufließen"
                    ],
                    "common_phrases": [
                        "Geld abfließen",
                        "Kapital abfließen"
                    ]
                }
            ]
        },
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "062db266-fa0b-3984-b548-588b49d5fd40",
                    "sense_definition": "das Wegrinnen oder Entweichen einer Flüssigkeit",
                    "learner_level": "B2",
                    "frequency": "Low",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Das verstopfte Rohr behindert das ungehinderte <w>Abfließen</w> des Wassers in der Küche."
                        },
                        {
                            "text": "Große Steine am Ufer verhindern das schnelle <w>Abfließen</w> der Fluten nach dem Regen."
                        }
                    ],
                    "common_phrases": [
                        "ungehindertes Abfließen"
                    ]
                }
            ]
        }
    ]
