                    "sense_id": "83528120-8cd3-31dc-8610-50714b784d36",
                    "sense_definition": "cierpiący na chorobę psychiczną lub znajdujący się w stanie utraty zmysłów",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "choroba_psychiczna",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Wszyscy patrzyli na niego jak na całkowicie <w>obłąkanego</w> człowieka, który nie panuje nad swoimi czynami.",
                            "target_lang_translations": {
                                "ru": "Все смотрели на него как на совершенно <w>безумного</w> человека, не отдающего отчёта в своих действиях."
                            }
                        },
                        {
                            "text": "Po wielu dniach samotności w ciemnym lesie wydawał się zupełnie <w>obłąkany</w> ze strachu.",
                            "target_lang_translations": {
                                "ru": "После многих дней одиночества в тёмном лесу он казался совершенно <w>обезумевшим</w> от страха."
                            }
                        }
                    ],
                    "synonyms": [
                        "niepoczytalny",
                        "opętany",
                        "pomylony",
                        "szalony"
                    ],
                    "antonyms": [
                        "poczytalny",
                        "zdrowy"
                    ],
                    "common_phrases": [
                        "obłąkany ze strachu",
                        "obłąkany człowiek"
                    ],
                    "target_lang_definitions": {
                        "ru": "страдающий психическим расстройством или потерявший рассудок"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "безумный",
                                "target_lang_sense_clarification": "лишившийся рассудка"
                            },
                            {
                                "target_lang_word": "умалишённый",
                                "target_lang_sense_clarification": "душевнобольной"
                            },
                            {
                                "target_lang_word": "помешанный",
                                "target_lang_sense_clarification": "сошедший с ума"
                            }
                        ]
