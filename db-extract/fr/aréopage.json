                    {
                        "sense_id": "7dc215f8-e979-3a0d-b2d6-14db97806a12",
                        "entry_id": "2141953e-bed7-3525-8d5c-8275887bdb9c",
                        "glosses": [
                            "group of eminent people"
                        ],
                        "tags": [
