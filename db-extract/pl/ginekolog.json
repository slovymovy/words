                        "translation_id": "ff5201db-adb5-4a32-8792-04b46e8920d6",
                        "source_entry_id": "e8943ed5-3fa2-3d00-aaa3-f6359f172093",
                        "source_sense_id": "373659d6-e800-3b65-97b6-516f741c0b94",
                        "target_lang_word": "Frauenarzt",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Frauenarzt",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                        "entry_id": "38913372-80ea-3465-9db1-cee5f0a792a8",
                                        "glosses": [
                                            "Arzt, der auf Frauenkrankheiten und Geburtshilfe spezialisiert ist"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7da527a2-7882-4393-bef1-8bca29d0ee65",
                                                "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                                "text": "Weil ihre Regel ausblieb, ging sie zum Frauenarzt."
                                            },
                                            {
                                                "example_id": "50f4f922-2831-4873-99ea-924cdffe1628",
                                                "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                                "text": "Betroffene Frauen sollten ihrem Frauenarzt die Beschwerden möglichst genau beschreiben."
                                            },
                                            {
                                                "example_id": "1ac7c514-223d-40be-8cb3-fced8e5cd3fd",
                                                "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                                "text": "„Als uns unser Frauenarzt zur Schwangerschaft gratulierte, war ich sehr froh.“"
                                            },
                                            {
                                                "example_id": "88c33878-f432-41f2-89ba-898e085a46d9",
                                                "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                                "text": "„Da Zwillinge sowieso nicht immer in große Verhältnisse hineingeboren werden, erkundigte sich ein kleiner Beamter tiefbekümmert beim Frauenarzt, weshalb in seiner jungen Ehe zuerst ein einziges Töchterchen ankam, danach ein Zwillingspärchen, und jetzt, im dritten Jahr, schon reguläre Drillinge.“"
                                            },
                                            {
                                                "example_id": "a4ce0421-ad9a-4274-a11a-da23107785bf",
                                                "sense_id": "ea7794d5-5e9c-382d-bbbd-b2ee15653e9a",
                                                "text": "„Ich wußte, daß Brandt einer der besten Frauenärzte in Berlin gewesen war.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "5600fa51-045e-4f25-8f09-032fbe8e3cab",
                        "source_entry_id": "e8943ed5-3fa2-3d00-aaa3-f6359f172093",
                        "source_sense_id": "373659d6-e800-3b65-97b6-516f741c0b94",
                        "target_lang_word": "гинеколог",
                        "target_lang_code": "ru",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "гинеколог",
                                "target_lang_code": "ru",
                                "target_senses": [
                                    {
                                        "sense_id": "16413621-f3eb-375e-a1f5-292e0ad8ca92",
                                        "entry_id": "9514ed47-652f-3990-9c1d-01df10a40c8a",
                                        "glosses": [
                                            "врач, специализирующийся на заболеваниях женских половых органов"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b1941edf-db1d-45e0-991a-2780921ecce5",
                                                "sense_id": "16413621-f3eb-375e-a1f5-292e0ad8ca92",
                                                "text": "Все стали думать, как бы сделать ребёнка. Помог врач-гинеколог."
                                            },
                                            {
                                                "example_id": "1e1c9c18-c99d-4edb-bf9f-98b61da05c43",
                                                "sense_id": "16413621-f3eb-375e-a1f5-292e0ad8ca92",
                                                "text": "Когда приблизилось время родов, мы обратились к гинекологу профессору Мюллеру, который дал нам опытную акушерку."
                                            },
                                            {
                                                "example_id": "749a5bc9-3517-48b9-9a9c-2c620ecc8f8d",
                                                "sense_id": "16413621-f3eb-375e-a1f5-292e0ad8ca92",
                                                "text": "Была у гинеколога 2 раза; она мне дала направление на аборт."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "f39b640d-ef88-4ecd-ba72-eb588782dd50",
                        "source_entry_id": "e8943ed5-3fa2-3d00-aaa3-f6359f172093",
