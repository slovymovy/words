                        "target_lang_word": "dynamitard",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "dynamitard",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "4c24d7bb-c16c-300c-8cfc-98253cdb76c5",
                                        "entry_id": "cf30ab4f-66b0-327e-aae2-bbc48a4319fc",
                                        "glosses": [
                                            "A political dynamiter."
                                        ],
                                        "tags": [
                                            "archaic",
                                            "historical"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1b86105e-cc05-4a57-95ae-a43f94d83e56",
                                                "sense_id": "4c24d7bb-c16c-300c-8cfc-98253cdb76c5",
                                                "text": "Are we then to repudiate Fabian methods, and return to those of the barricader, or adopt those of the dynamitard and the assassin?"
                                            },
                                            {
                                                "example_id": "86b67c68-18eb-455f-8612-04d4b2c58e8a",
                                                "sense_id": "4c24d7bb-c16c-300c-8cfc-98253cdb76c5",
                                                "text": "The president of the funeral committee was Thomas Clarke, a former Clan na Gael dynamitard who had been arrested in 1883, before he even commenced activities, and had served fifteen years of particularly harsh imprisonment."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "05fc0774-d9f9-40f0-b967-2fcfcf52bb5b",
                        "source_entry_id": "e3364654-765e-394a-8974-40bdb31b1b9c",
                        "source_sense_id": "9b654fd5-2525-3e14-ad7d-d64c8e54768f",
