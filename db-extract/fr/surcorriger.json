                ],
                "senses": [
                    {
                        "sense_id": "5c582058-c2ab-3d6e-ab22-58ca5f0079be",
                        "entry_id": "6b84fc0b-18c7-30fe-8087-a579accff755",
                        "glosses": [
                            "Corriger plus que la normale."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "867d17a9-aef0-4db5-9b8a-2529947bb873",
                                "sense_id": "5c582058-c2ab-3d6e-ab22-58ca5f0079be",
                                "text": "On éprouve donc le besoin de surcorriger les deux axes afin d'obtenir un mouvement de même sens."
                            },
                            {
                                "example_id": "4a5bc890-ece5-48f6-872c-4ee285c6a565",
                                "sense_id": "5c582058-c2ab-3d6e-ab22-58ca5f0079be",
                                "text": "Par conséquent, la chirurgie doit alors être prévue pour surcorriger l'ésotropie, cette surcorrection devant être compensée par le recul d'un droit externe de l'oeil abducté ;"
                            }
                        ]
                    }
