                                                "sense_id": "ff41c4f3-7657-36ca-afb7-3b08a8058219",
                                                "text": "Des saphirs bleu clair et bleu foncé, tels que le corindon, et aussi recherchés que celui du Malabar ou du Tibet."
                                            },
                                            {
                                                "example_id": "e2f0773f-8b54-4ff6-a238-1776889f96ea",
                                                "sense_id": "ff41c4f3-7657-36ca-afb7-3b08a8058219",
                                                "text": "Défarter avec une fibre de corindon (poil très fin et très résistant qui pourra curer le fond des micro-structures de la semelle)."
                                            }
                                        ]
                                    }
