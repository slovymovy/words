                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b563f2ef-bb54-43ae-8c75-d38c75035878",
                                "sense_id": "b0597973-646a-373f-84f2-49dba1cfdecb",
                                "text": "De film Nebraska van Alexander Payne heeft de publieksprijs gewonnen op het filmfestival van Rotterdam (IFFR). Ook de officiële openingsfilm Qissa kreeg een publieksprijs. De makers krijgen allebei 10.000 euro."
                            },
                            {
                                "example_id": "9e470d12-02e2-47b2-bdea-b1e72b28049a",
                                "sense_id": "b0597973-646a-373f-84f2-49dba1cfdecb",
                                "text": "De openingsfilm is 'De Wederopstanding van een Klootzak' van Guido van Driel. Een van de hoofdrollen wordt gespeeld door Jeroen Willems, die eind vorig jaar overleed."
                            }
                        ]
