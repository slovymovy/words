                "senses": [
                    {
                        "sense_id": "d442f327-1c67-3395-9efe-cf853a2dd231",
                        "entry_id": "18dc0b1b-5835-31a4-a2f0-2b3bce95a0df",
                        "glosses": [
                            "Composition du chant, on ne l’emploie qu’en parlant de la musique antique."
                        ],
                        "tags": [
                            "Ancient"
                        ],
                        "examples": []
                    },
                    {
                        "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                        "entry_id": "18dc0b1b-5835-31a4-a2f0-2b3bce95a0df",
                        "glosses": [
                            "Déclamation chantée ; chant récitatif ; chant monotone."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "2c0e5446-aa8f-497f-9c72-d5fd97f89a26",
                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                "text": "S’accompagnant de son gimbri, il nous chante, d'une voix tantôt gutturale, tantôt nasillarde, d’interminables mélopées, que l’assistance reprend aux refrains avec des battements rythmiques des mains."
                            },
                            {
                                "example_id": "5f6cdacc-49e4-4983-b6d6-a19b52335405",
                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                "text": "Brusquement, le grondement sonore des tambourins, vient couvrir toutes les voix. Les chanteuses, d’une voix chevrotante, entonnent une étrange mélopée : « Nous célébrons une fête pour nos seigneurs les esprits. »"
                            },
                            {
                                "example_id": "86b264ad-1de3-48a1-bd81-ab99bddb52f2",
                                "sense_id": "1010a147-72dd-371f-9f71-eaefa757d480",
                                "text": "Je fredonne une mélopée de mon pays, bercé par les cahots incessants du chemin."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "187d64ce-9cd2-4144-aac8-4db1cd115e6b",
                        "source_entry_id": "18dc0b1b-5835-31a4-a2f0-2b3bce95a0df",
                        "target_lang_word": "threnody",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "threnody",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                                        "entry_id": "52565089-c401-3514-b48b-38914a7930e5",
                                        "glosses": [
                                            "A song or poem of lamentation or mourning for a dead person; a dirge; an elegy."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "89a41e25-f733-4cf7-941c-40fcd2dd04d5",
                                                "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                                                "text": "The fifer actually knew but one tune \"The Bonnie Blue Flag\"—and did not know that well. But it was all that he had, and he played it with wearisome monotony for every camp call. . . . I never hated any piece of music as I came to hate that threnody of treason."
                                            },
                                            {
                                                "example_id": "cfb914de-d822-4e78-8c45-2e9eb5222479",
                                                "sense_id": "3237b5c8-311d-354b-9528-580a6c5ed248",
                                                "text": "A strongly personal note runs through Kenneth Leighton's Improvisation (Novello, 35p), which is a threnody in memory of Maurice de Sausmārez. Gently undulating, cantabile lines of ‘mourning’ alternate with sharp, anguished note-clusters which work up to a fierce paroxysm of grief."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
