                "senses": [
                    {
                        "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                        "entry_id": "46ebe21b-e2f9-3cc2-9a5d-f5c6b44f3bad",
                        "glosses": [
                            "weibliche Person, die auf dem Gebiet der Kunststofftechnik als Fachfrau gilt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "6c5c9e2d-e0e1-4aa0-b860-e1b2c51767ce",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "Sie interessierte sich für eine Ausbildung zur Kunststofftechnikerin."
                            },
                            {
                                "example_id": "cf0f502b-4bc8-42df-8270-4b46a655dd05",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "„Wie bist du auf den exotischen Beruf Kunststofftechnikerin gekommen?“"
                            },
                            {
                                "example_id": "1b475946-98da-49cd-8ca0-f0f778ff8b8c",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "„Silke Meierlein ist eine erfahrene Kunststofftechnikerin, während Monika Fröhlich noch am Anfang ihres Berufslebens als Zahntechnikerin in der Kunststoffprothetik steht.“"
                            },
                            {
                                "example_id": "034020cc-786c-4929-a88c-9cb8e9b48ffb",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "„Ines Jölly, 25, zog aus der Steiermark in Österreich in die niederbayerische Wachstumsregion: Die studierte Kunststofftechnikerin arbeitet seit November für BMW.“"
                            },
                            {
                                "example_id": "734640c3-1db7-49fe-8bc4-1cf97781c949",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "„Anja Gosch darf sich dieser Tage sehr freuen, denn die Kunststofftechnikerin, die an der Montanuniversität Leoben studiert hat, erhielt zwei wichtige Wissenschaftspreise – den dritten Platz beim ZwickRoell Science-Award und den ersten Platz beim Wilfried-Ensinger-Preis.“"
                            },
                            {
                                "example_id": "92fdb038-fb40-4632-ba27-0d56adb70bc4",
                                "sense_id": "352935c8-429c-3cbe-8fed-7478dcfc4573",
                                "text": "„Die Kunststofftechnikerin Veronika Berger ist Dissertantin an der Universität Linz.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
