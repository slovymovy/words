                        "glosses": [
                            "To treat with tenderness; fondle"
                        ],
                        "tags": [
                            "dialectal"
                        ],
                        "examples": [
                            {
                                "example_id": "60ca01b1-71f0-46fa-ab13-057e4529c190",
                                "sense_id": "3c51a7a1-cf1e-375c-8cf2-d7de68c12387",
                                "text": "Their doings now were jubilational—\nWhat quiet folks would call sensational.\nTheir goodies they unpack excitedly,\nTheir Common Grandsire greet delightedly,\nWith gentle, sympathetic tiddering.\nWhen from his tree-top he called diddering,\nAll \"gramps,\" Wag said, are worth considering."
                            }
                        ]
