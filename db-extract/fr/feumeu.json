                "senses": [
                    {
                        "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                        "entry_id": "9bf139da-43ff-3ed0-a890-d9759e541ea5",
                        "glosses": [
                            "Femme, fille."
                        ],
                        "tags": [
                            "slang"
                        ],
                        "examples": [
                            {
                                "example_id": "265b3169-760c-4cb7-a221-ac3b68365913",
                                "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                                "text": "Le taf c’est la tésan mais les feumeux, c’est si kiffant\nQue je crois que j’ai droit à ma chance à présent"
                            },
                            {
                                "example_id": "e1115c76-c516-4fe6-aa84-bbd0de6df6ed",
                                "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                                "text": "T’es belle et t’as du charme et devant toi il se pâme\nC’est ma nana c’est ma feumeu c’est ma vie c’est ma gonze"
                            },
                            {
                                "example_id": "01fe15ff-4c0b-4f1c-82bf-fc800ce6f764",
                                "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                                "text": "Oui mais voilà, on utilisait aussi feumeu, le verlan de meuf qui n’était pas femme."
                            },
                            {
                                "example_id": "1f34e3cf-af4b-4917-88c3-06605c7540f8",
                                "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                                "text": "Si j’étais une feumeu je serais une salope matérialiste"
                            },
                            {
                                "example_id": "d040fce9-6296-415f-acb2-e8406b598bbe",
                                "sense_id": "78a2e1a0-609a-388f-a992-a10986137964",
                                "text": "Je peux pas jouer à Civ6 fils, je dois retrouver ma feumeu au GB ce soir"
                            }
                        ]
                    }
                ],
