        "ru-extract.jsonl": [
            {
                "entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                "word": "попросту",
                "pos": "adv",
                "lang_code": "ru",
                "forms": [],
                "senses": [
                    {
                        "sense_id": "625ab0c4-5622-3582-8379-85f68b525a63",
                        "entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "glosses": [
                            "разг. просто, без затей"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "074c310c-14c4-49e4-8657-2c896cca434a",
                                "sense_id": "625ab0c4-5622-3582-8379-85f68b525a63",
                                "text": "В бытность мою в С-м уезде мне часто приходилось бывать на Дубовских огородах у огородника Саввы Стукача, или попросту Савки."
                            },
                            {
                                "example_id": "e67d06ba-477a-4db7-b674-f93c27c0ce5d",
                                "sense_id": "625ab0c4-5622-3582-8379-85f68b525a63",
                                "text": "Если рассуждать по науке, то, конечно, чертей нету, потому что это предрассудок; а ежели рассуждать попросту, как вот мы сейчас с тобой, то черти есть, короче говоря…"
                            }
                        ]
                    },
                    {
                        "sense_id": "5aaa6a01-5eec-31b8-a9af-d079d1bd162e",
                        "entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "glosses": [
                            "не церемонясь, без стеснения, запросто"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0c9eaddc-df58-45a3-9d69-0642c7d718a7",
                                "sense_id": "5aaa6a01-5eec-31b8-a9af-d079d1bd162e",
                                "text": "Милости просим, мы люди простые, и жалуйте к нам попросту без чинов."
                            }
                        ]
                    },
                    {
                        "sense_id": "3f357bdd-efcc-36d0-993b-fa7835e26aa7",
                        "entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "glosses": [
                            "просто, просто-напросто"
                        ],
                        "tags": [
                            "в знач. усилительной и ограничительной частицы"
                        ],
                        "examples": [
                            {
                                "example_id": "226ec7d3-6a09-40c4-afc0-3ca9e1b9c6ae",
                                "sense_id": "3f357bdd-efcc-36d0-993b-fa7835e26aa7",
                                "text": "Кручинину попросту было совестно за вчерашнее поведение."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d694fdad-56a8-4049-8eb3-e31f043d011d",
                        "source_entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "target_lang_word": "simply",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "simply",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "6d47a07a-ad66-3934-90dd-1b9f73795e4a",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "In a simple way or state; considered in or by itself; without addition; alone."
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "b66f9c70-a612-388b-bf5e-9152a8accd68",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Plainly; without art or subtlety"
                                        ],
                                        "tags": [],
                                        "examples": []
                                    },
                                    {
                                        "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Foolishly; stupidly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "454d6451-9736-47ee-8ab1-11a1dd0f16a8",
                                                "sense_id": "6239f6ba-01b4-3d8b-a5e8-60eb17e413e7",
                                                "text": "Mrs. Thorold had told her sons that a young lady was visiting at the house, whose history she had given them in short hand, describing her as a dependent on the late Mrs. Willoughby, whom her son had very simply intended to marry at Alvestone […]."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Merely; solely."
                                        ],
                                        "tags": [
                                            "focus"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dfd31c40-ee5f-45ef-9d10-293011cade0f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "I was simply asking a question."
                                            },
                                            {
                                                "example_id": "3cd986d7-c28f-422e-8cc3-199fa000c23f",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "A “moving platform” scheme[…]is more technologically ambitious than maglev trains even though it relies on conventional rails.[…]This set-up solves several problems […]. Stopping high-speed trains wastes energy and time, so why not simply slow them down enough for a moving platform to pull alongside?"
                                            },
                                            {
                                                "example_id": "5340c159-097f-40d5-b230-737c3eb94215",
                                                "sense_id": "f21e9594-f93f-34fe-8037-bba7a97eff1c",
                                                "text": "Rather than scanning a boarding pass or handing over a passport, you simply stare into a camera and you’re verified."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "absolutely, positively."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "9d513240-f09e-41a1-876c-467b420ad4ed",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "That was a simply wonderful dessert."
                                            },
                                            {
                                                "example_id": "2f3747f7-c95a-4ac2-9b0f-57c0eeb5ab57",
                                                "sense_id": "ea90e5ba-1156-3ff1-9e79-34b5f130a638",
                                                "text": "What about the way you love me? / And the way you squeeze me? / Simply beautiful"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                        "entry_id": "f4ae3883-ae84-34cb-8900-f8772cb30265",
                                        "glosses": [
                                            "Frankly."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b3b4fdc9-320f-49d4-be2a-7e06164b600c",
                                                "sense_id": "a62f13d8-c8e9-3a75-86a4-b896b73ab361",
                                                "text": "Simply, he just fired you."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7f98e222-71ca-42df-962d-94702c38d863",
                        "source_entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "target_lang_word": "without ceremony",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "without ceremony",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e3511281-7e24-37a2-8a80-b45c685d8407",
                                        "entry_id": "79b2b89e-1a94-36da-a3bc-1092a42cbe1d",
                                        "glosses": [
                                            "In an abrupt or peremptory manner, without formalities or niceties that might usually be expected."
                                        ],
                                        "tags": [
                                            "not-comparable"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c159d48-7240-4b02-b44f-7b48f49a2b13",
                                                "sense_id": "e3511281-7e24-37a2-8a80-b45c685d8407",
                                                "text": "He was fired on the spot and marched out of the building without ceremony."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "bd1b09c4-7078-4e4e-83f9-9c7a43db0a1c",
                        "source_entry_id": "5d279c88-8d86-3b9f-872d-432a2ebac5ae",
                        "target_lang_word": "po prostu",
                        "target_lang_code": "pl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "po prostu",
                                "target_lang_code": "pl",
                                "target_senses": [
                                    {
                                        "sense_id": "6c613272-7379-3827-8bdb-bd3a1f6c7798",
                                        "entry_id": "133d5658-e1b7-31df-bdc5-da6e0f91b2f8",
                                        "glosses": [
                                            "bezpośrednio, otwarcie, w sposób prosty, nie komplikując niepotrzebnie"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8c7b0499-a420-4aae-97b9-d44a8c930f9e",
                                                "sense_id": "6c613272-7379-3827-8bdb-bd3a1f6c7798",
                                                "text": "Nie owijaj w bawełnę, powiedz po prostu, o co ci chodzi."
                                            },
                                            {
                                                "example_id": "e4ceabfc-199d-4d16-823a-ee6dc2382198",
                                                "sense_id": "6c613272-7379-3827-8bdb-bd3a1f6c7798",
                                                "text": "Grają po prostu, od serca – z werwą i niekłamaną szczerością."
                                            }
                                        ],
                                        "sense_index_json": "\"1.1\""
                                    },
                                    {
                                        "sense_id": "024428f6-a72b-36c0-8793-8dbd61993c46",
                                        "entry_id": "133d5658-e1b7-31df-bdc5-da6e0f91b2f8",
                                        "glosses": [
                                            "zwyczajnie, w sposób oczywisty, bez uzasadniania"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "338d3829-63c1-4b02-a685-2f57258306b9",
                                                "sense_id": "024428f6-a72b-36c0-8793-8dbd61993c46",
                                                "text": "To jest po prostu draństwo!"
                                            },
                                            {
                                                "example_id": "ae873a9a-bb0d-4417-aea3-a8dbc3917860",
                                                "sense_id": "024428f6-a72b-36c0-8793-8dbd61993c46",
                                                "text": "Zakład go po prostu zwolnił, bez żadnych zarzutów."
                                            },
                                            {
                                                "example_id": "7d95a5c7-8be6-42c7-9448-71506f833e03",
                                                "sense_id": "024428f6-a72b-36c0-8793-8dbd61993c46",
                                                "text": "Wybacz, to był po prostu żart."
                                            },
                                            {
                                                "example_id": "6fa1cab1-38f2-4544-93cc-3407a5fbc915",
                                                "sense_id": "024428f6-a72b-36c0-8793-8dbd61993c46",
                                                "text": "Może po prostu mam takiego pecha?"
                                            }
                                        ],
                                        "sense_index_json": "\"1.2\""
                                    },
                                    {
                                        "sense_id": "4114b28b-0b5d-3fb5-835e-b66321aa8a07",
                                        "entry_id": "133d5658-e1b7-31df-bdc5-da6e0f91b2f8",
