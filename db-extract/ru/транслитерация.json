                                        "entry_id": "131eec7d-a202-332c-a2b2-e89ec0dff9d7",
                                        "glosses": [
                                            "Übertragung eines Textes aus einem Schriftsystem in ein anderes, und zwar so, dass die Schriftzeichen in beiden Richtungen eindeutig einander zugeordnet werden können"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "5e55acb4-0ecd-4981-b38d-f485e1f56082",
                                                "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                                                "text": "Transliteration liegt z. B. dann vor, wenn man einen Text, der in griechischer Schrift vorliegt, in die lateinische Schrift überträgt."
                                            },
                                            {
                                                "example_id": "cee8d8c0-163f-4cb8-8c07-75b3670401c3",
                                                "sense_id": "988284bf-d5f2-3311-8127-a88cd880ecab",
                                                "text": "Kennst du dich mit bulgarischer Transliteration aus?"
                                            },
                                            {
