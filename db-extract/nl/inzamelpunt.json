                        "glosses": [
                            "plaats waar men iets kan inleveren dat door een ander wordt verzameld"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a8f93a90-a262-4267-8043-ef078fea0fd4",
                                "sense_id": "c0e30d52-4ca0-316f-a7a7-6c595f176d40",
                                "text": "Tientallen mannen en vrouwen zijn bezig met sorteren, inpakken, sjouwen. Met busjes worden de dozen naar een centraal inzamelpunt gebracht."
                            },
                            {
                                "example_id": "75ef7598-b44e-470a-8850-6f1022079a38",
                                "sense_id": "c0e30d52-4ca0-316f-a7a7-6c595f176d40",
                                "text": "Omdat er in spaarlampen giftige stoffen zijn verwerkt, moeten ze apart worden ingeleverd bij een inzamelpunt. Toch gooien veel mensen de lampen nog bij het vuilnis of in de glasbak. Met de toename van het aantal spaarlampen is dat een groeiend probleem."
                            }
                        ]
                    }
