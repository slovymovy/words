                            {
                                "example_id": "b8ab5368-39b1-4956-9538-8ca83b0753ae",
                                "sense_id": "d7305b65-8068-3132-b0f3-34df3b636164",
                                "text": "„Daraufhin zeigte sie der Gruppe eine Tür in der Küche, die über eine steile, schmale Treppe in einen dunklen unterirdischen Gang führte. Er endete in einem lang gezogenen Steinkeller, in dem damals, als das Anwesen noch bewirtschaftet wurde, Fässer mit Tequila lagerten.“"
                            }
                        ],
