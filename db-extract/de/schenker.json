                "senses": [
                    {
                        "sense_id": "66ad16f1-d0d8-3517-b4cc-38f3f4e6cda4",
                        "entry_id": "21bc421f-c8ee-3f52-8904-6f7bf565e487",
                        "glosses": [
                            "jemand, der etwas verschenkt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "f397005a-bb80-4807-83f1-c002d8f245d8",
                                "sense_id": "66ad16f1-d0d8-3517-b4cc-38f3f4e6cda4",
                                "text": "„Und so dürfen wir alle uns irgendwie als Schenker und Beschenkte fühlen: Letzte Zweifel an der These, wonach unser Staat in langsam beunruhigender Form von einem Glücksspielkonzern infiltriert ist, können wir uns jetzt wohl schenken.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "3ceff020-10e8-430e-940c-88408d0cd765",
                        "source_entry_id": "21bc421f-c8ee-3f52-8904-6f7bf565e487",
                        "source_sense_id": "66ad16f1-d0d8-3517-b4cc-38f3f4e6cda4",
                        "source_sense_description": "jemand, der etwas verschenkt",
                        "target_lang_word": "donor",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donor",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "One who makes a donation."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "7f434fd6-ba5e-4aac-aa24-1bff8bd07436",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "The charity raised $2,000 from various donors."
                                            },
                                            {
                                                "example_id": "6a5e987f-ce21-43b1-9237-aeda4f8f44d6",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "The hospital is seeking an organ donor."
                                            },
                                            {
                                                "example_id": "4564271f-5e34-4c65-aab9-7bbef7a43aa1",
                                                "sense_id": "940ae706-aabb-3d3e-ac47-b6a71525e05d",
                                                "text": "\"You prefer, then, having the money to the ornaments which I had intended for you?\"/\"Oh! the hundred pounds, certainly,\" exclaimed Isabella, colouring a little at the idea of trespassing on the donor's generosity."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "29e9ce5d-6703-32bb-8ed6-49a18801e789",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "An object, typically broken beyond repair, that is used for spare parts."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a2dcd72d-53aa-4cfd-a777-01ca086ea180",
                                                "sense_id": "29e9ce5d-6703-32bb-8ed6-49a18801e789",
                                                "text": "You'll need to lengthen the plug for the fan switch and swap its connector for that of the donor."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "4d28b723-3416-3a1a-a76e-ddbdb5853d73",
                                        "entry_id": "b6f28072-96ec-348f-9e2b-ee40493121a5",
                                        "glosses": [
                                            "A group or molecule that donates either a radical, electrons or a moiety in a chemical reaction. Compare acceptor."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "8e459184-d4cf-4527-a23c-691daacb1302",
                                                "sense_id": "4d28b723-3416-3a1a-a76e-ddbdb5853d73",
                                                "text": "a carbonyl donor molecule"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "43dd4247-86ce-47a3-ae21-a7eb8b2a2d29",
                        "source_entry_id": "21bc421f-c8ee-3f52-8904-6f7bf565e487",
                        "source_sense_id": "66ad16f1-d0d8-3517-b4cc-38f3f4e6cda4",
                        "source_sense_description": "jemand, der etwas verschenkt",
                        "target_lang_word": "donateur",
                        "target_lang_code": "fr",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "donateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                        "entry_id": "32ffa88a-4667-3e5a-8e19-a27039131d79",
                                        "glosses": [
                                            "Celui qui donne quelque chose, donneur."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "1867fab9-88c0-4826-84e8-1597fee2c83e",
                                                "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                                "text": "Elle collectionne aussi toutes les plaques officielles des rues, et à chaque instant un généreux donateur arrive, apportant des panonceaux ou des affiches."
                                            },
                                            {
                                                "example_id": "c5b64d19-e699-46f1-9f43-e8269de53f0f",
                                                "sense_id": "1d0f5cb1-028c-3110-bd75-83fb6b9dec34",
                                                "text": "Ces ateliers, où l’on déballe ses soucis, permettent à l’association de fabriquer des tote bags colorés, utilisés pour remercier les donateurs et donatrices."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                        "entry_id": "32ffa88a-4667-3e5a-8e19-a27039131d79",
                                        "glosses": [
                                            "Personne qui a fait une donation."
                                        ],
                                        "tags": [
                                            "especially"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "94dca0ab-8cf6-4c6e-b6b7-a1633d3cf450",
                                                "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                                "text": "[…], par conséquent, il y a eu concours des volontés et réalisation de la donation le jour où la chose, offerte par le donateur (en la personne de son mandataire), a été acceptée par le donataire en personne."
                                            },
                                            {
                                                "example_id": "4c9bd02c-844c-4b04-9908-90119f3376fa",
                                                "sense_id": "6c98a5f3-67be-3927-9f6f-2f6592349e9f",
                                                "text": "La donation entre vifs est un acte par lequel le donateur se dépouille actuellement et irrévocablement de la chose donnée en faveur du donataire qui l'accepte."
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "target_word": "donateur",
                                "target_lang_code": "fr",
                                "target_senses": [
                                    {
                                        "sense_id": "56a95ba6-62c6-3c8a-b1af-c3c24f03e338",
                                        "entry_id": "2ce38a70-4c7d-3e92-8529-6596460ba7d7",
                                        "glosses": [
                                            "Qui donne quelque chose."
                                        ],
                                        "tags": [
                                            "rare"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "0d0140fc-c180-49e0-9332-d7a8980a751f",
                                                "sense_id": "56a95ba6-62c6-3c8a-b1af-c3c24f03e338",
                                                "text": "Ta méditation peut donc avoir la vocation de la lampe donatrice de lumière; ou bien celle d'une musique à écouter entre deux silences."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
