                        "glosses": [
                            "In an unhandsome manner."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "b216d4fd-923e-4c64-b241-c8a596df0b62",
                                "sense_id": "f6d20ab8-cdbd-3ca8-aef3-dc182b6355f1",
                                "text": "McClellan at once wrote that he should continue to \"work just as cheerfully as before;\" but he felt that the removal was very unhandsomely made just as he was entering upon active operations."
                            },
                            {
                                "example_id": "04bfe1d2-9cd0-4acd-a461-6a32cdd2985d",
                                "sense_id": "f6d20ab8-cdbd-3ca8-aef3-dc182b6355f1",
                                "text": "And Rudolph Musgrave, knowing that according to his lights he had behaved not unhandsomely, was the merest trifle patronizing and rather like a person speaking from a superior plane in his future dealings with Patricia."
                            }
                        ]
                    }
                ],
