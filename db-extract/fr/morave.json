                                        "entry_id": "a4c55750-8f13-3b78-b771-c19592ac5e11",
                                        "glosses": [
                                            "sich auf Mähren beziehend, aus Mähren kommend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "c8af0c23-2fdf-4d67-9d90-01a6d364f125",
                                                "sense_id": "e2649423-d8f0-3b08-8ee3-28b784c8dca1",
                                                "text": "„Die Bewohner der mährischen Beskiden sprechen die mährisch-walachische Mundart der tschechischen Sprache, jedoch mit vielen rumänischen Lehnwörtern.“"
                                            },
                                            {
                                                "example_id": "75964416-1f6b-4398-a5f5-ccd98f9220c5",
                                                "sense_id": "e2649423-d8f0-3b08-8ee3-28b784c8dca1",
                                                "text": "„Sein Nachfolger, Fürst Rastislav, strebte ein von den Franken unabhängiges Reich mit einem mährischen Erzbistum an.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
