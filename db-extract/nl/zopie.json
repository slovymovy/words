                        "examples": [
                            {
                                "example_id": "f978e0e7-0a6a-4319-ba4f-1eb0332110d4",
                                "sense_id": "0481547f-1066-359e-9b26-6fa0c6a09515",
                                "text": "Samen met de collega-Lions uit het Duitse Detmold verkopen de Lions worst en Duits bier voor het goede doel. Voor de kinderen is er zaterdag koek en zopie, terwijl er ook diverse eetkraampjes en straatmuzikanten in het centrum te vinden zijn."
                            },
                            {
                                "example_id": "af4e3df5-d20d-4d0a-93d2-b741fbc71d3b",
                                "sense_id": "0481547f-1066-359e-9b26-6fa0c6a09515",
                                "text": "Koek en zopie ontbreken niet, net als Jägermeister, vuurkorven en een aantal omkleedtenten. Ook de EHBO staat paraat. Al zullen de meeste stuurlui wel aan wal staan, denkt Mulder."
                            }
                        ]
                    }
