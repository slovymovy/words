                        "glosses": [
                            "Personne qui souffre d’hydrophobie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "07a135e8-e104-4001-9720-f9a519fbf3a9",
                                "sense_id": "d38406bc-2c77-31ca-b58c-8fbc0b103390",
                                "text": "Cette mer était infiniment plus gaie et plus colorée que l’océan que je fréquentais depuis ma tendre enfance ; moins menaçante aussi pour un hydrophobe comme moi."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "13b42dfe-f999-4324-88bc-449343d96986",
                        "source_entry_id": "b62bbcd3-f12e-30f2-9313-8621ba6e2d51",
                        "source_sense_id": "d38406bc-2c77-31ca-b58c-8fbc0b103390",
