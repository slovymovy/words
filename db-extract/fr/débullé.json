                        "examples": [
                            {
                                "example_id": "5340c676-efbc-447d-bb7d-2f9ec1f64fb9",
                                "sense_id": "718eeccb-4831-3f96-8f19-76ebf9197fac",
                                "text": "Le plan débullé est un plan « de travers », dont l'horizon est volontairement penché."
                            },
                            {
                                "example_id": "8eb65ff9-ea6f-406e-9f45-e68f807622a4",
                                "sense_id": "718eeccb-4831-3f96-8f19-76ebf9197fac",
                                "text": "Comme ces plans qu'on voit parfois dans les films, quand la caméra est légèrement de travers pour donner une impression de désorientation. Les gens du cinéma appellent ça un plan débullé."
                            }
