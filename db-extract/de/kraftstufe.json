                    {
                        "form_id": "1849099f-fa47-4417-b857-7a749866bd6a",
                        "entry_id": "bbc7f07a-bef8-3328-9f20-9bec5324c2d0",
                        "tags": [
                            "accusative",
                            "singular"
                        ],
                        "form": "die Kraftstufe"
                    },
                    {
                        "form_id": "4f2125c8-4474-423e-90bc-b5b76b403601",
                        "entry_id": "bbc7f07a-bef8-3328-9f20-9bec5324c2d0",
                        "tags": [
                            "accusative",
                            "plural"
                        ],
                        "form": "die Kraftstufen"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                        "entry_id": "bbc7f07a-bef8-3328-9f20-9bec5324c2d0",
                        "glosses": [
                            "Intensitäts- oder Leistungsgrad eines Geräts/einer Maschine, mit dem dieses arbeiten kann"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "0cda1064-53c0-464b-8c76-7e75819b78b4",
                                "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                                "text": "„Dieses Nackenmassagegerät mit ergonomischem Design hat drei einstellbaren Kraftstufen (Langsam, Mittel und Schnell), damit Sie sich je nach Ihrer persönlichen Bevorzugung entspannen können.“"
                            },
                            {
                                "example_id": "ff16aa14-62ec-4a44-aa6e-81dd569301e9",
                                "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                                "text": "„Das ist abhängig vom Gewicht des Fahrers, der gefahrenen Steigungen und der gewählten Kraftstufe, informierte Bianca Weber (Tourist-Information Hoher Westerwald Rennerod) bei der Vorstellung des E-Bike-Netzes.“"
                            },
                            {
                                "example_id": "05f9383a-654b-4c93-b2c1-6c3151c1de2d",
                                "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                                "text": "„3 KRAFTSTUFEN: Das Rücken- und Nackenmassagegerät verfügt über 3 Kraftstufen, um die Massage an Ihre Bedürfnisse anzupassen und eine präzisere und sanftere Steuerung zu erreichen.“"
                            },
                            {
                                "example_id": "a07808cd-0be1-46ad-880a-da5a2968e615",
                                "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                                "text": "„Bei elektrischen Pressen können zwei weitere Kraftstufen kalibriert werden:“"
                            },
                            {
                                "example_id": "e03e4491-b94f-4d25-b7d1-e370f71f8ca9",
                                "sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                                "text": "„Hiermit stellst du schnell und einfach ein, mit welcher Kraftstufe du Löcher bohren oder Schrauben festdrehen möchtest.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                        "entry_id": "bbc7f07a-bef8-3328-9f20-9bec5324c2d0",
                        "glosses": [
                            "(numerische) Skala, die den Grad einer Stärke/Kraft angibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "fc814709-5fa1-4905-b7b5-167afc106689",
                                "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                                "text": "„Die Muskelfunktionsprüfung links ergab Kraftstufe 3 für Delta, 4 für Biceps und Triceps brachii.“"
                            },
                            {
                                "example_id": "25e6cf6c-949e-47d2-82c7-94d99fc4c3d3",
                                "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                                "text": "„Die mächtigsten Skills erhalten Sie in den höchsten Kraftstufen 8 und 9 - mit einem Multiklassen-Charakter können Sie diese Stufen allerdings nicht freischalten - ein echter Nachteil.“"
                            },
                            {
                                "example_id": "c234a5a3-0c89-4ed9-bfbd-6e04ad1e2a13",
                                "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                                "text": "„Da ist was ganz arg schief gegangen und der Geist hat die maximale Kraftstufe, die der Beschwörer rufen kann, also das doppelte seine Magie.“"
                            },
                            {
                                "example_id": "caef1c8d-36cf-4d13-8de5-db2815f1553b",
                                "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                                "text": "„Durch die unterschiedlichen Gewichte sind die Medizinbälle für verschiedene Kraftstufen und Übungen geeignet.“"
                            },
                            {
                                "example_id": "e2008f6a-200d-49bd-a0cb-8fc713ab253d",
                                "sense_id": "9d1cd7ba-1022-31d0-a012-c0258105fb3c",
                                "text": "„Dadurch, daß jeder der 102 Zauber in 7 verschiedenen Kraftstufen gesprochen werden kann, wird gewährleistet, daß auch die Anfangszauber im späteren Spiel nicht nur Ballast sind.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "d32676a7-e054-4a20-a439-491af6200d3e",
                        "source_entry_id": "bbc7f07a-bef8-3328-9f20-9bec5324c2d0",
                        "source_sense_id": "c183479f-affc-38af-a0b9-cf2359a26a1f",
                        "source_sense_description": "Intensitäts- oder Leistungsgrad eines Geräts",
                        "target_lang_word": "power level",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "power level",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "e19697e6-ea6a-3dcb-bd39-c256ae4856e8",
                                        "entry_id": "5f92aa85-65c9-38a2-8a58-64a74f38ff26",
                                        "glosses": [
                                            "A symbolic and often arbitrary unit of measurement representing strength and fighting ability."
                                        ],
                                        "tags": [
                                            "Japanese",
                                            "especially",
                                            "slang"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "82113109-ef50-4563-a426-d99cbd1c68b7",
                                                "sense_id": "e19697e6-ea6a-3dcb-bd39-c256ae4856e8",
                                                "text": "Miku's power level skyrockets up to 15,000 during the big battle in episode 31."
                                            },
                                            {
                                                "example_id": "f4af2750-597f-4794-914f-0fda00bdaeca",
                                                "sense_id": "e19697e6-ea6a-3dcb-bd39-c256ae4856e8",
                                                "text": "Nappa: Vegeta, what does the scouter say about his power level? / Vegeta: It's over 9,000!"
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e6c477c8-804e-34c5-8f95-0557ac668fc9",
                                        "entry_id": "5f92aa85-65c9-38a2-8a58-64a74f38ff26",
                                        "glosses": [
                                            "An interest or specialized knowledge in a subject seen as uncool, especially related to video games and otaku culture."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c302b395-876e-44fb-946c-4383b94c1f25",
                                                "sense_id": "e6c477c8-804e-34c5-8f95-0557ac668fc9",
                                                "text": "The black and gold paint job is a subtle but still stylish way to hide your power level."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "8a2b12e4-f32b-3029-b3b3-e7fdc6d907e3",
                                        "entry_id": "5f92aa85-65c9-38a2-8a58-64a74f38ff26",
                                        "glosses": [
                                            "Extreme political views, especially those on the far right."
                                        ],
                                        "tags": [
                                            "Internet",
                                            "broadly"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "c8cec7c8-d30d-4712-aa93-54a4829fbd68",
                                                "sense_id": "8a2b12e4-f32b-3029-b3b3-e7fdc6d907e3",
                                                "text": "The message of the posters originate from a strategy called \"Hiding your power level\" or publicly disavowing Nazis and painting any opposition to this message as anti-white racism, the news site reported."
                                            },
                                            {
                                                "example_id": "cc375d55-678f-443a-bf89-5d14aa141f14",
                                                "sense_id": "8a2b12e4-f32b-3029-b3b3-e7fdc6d907e3",
                                                "text": "The idea that minority Republicans would want to support a white nationalist makes little sense until one realizes that Fuentes is fond of using coded language to hide messages intended only for racists, a practice frequently referred to within the alt-right as \"hiding your power level.\""
                                            },
                                            {
                                                "example_id": "2e274618-1da9-47de-89d1-5e29c5808221",
                                                "sense_id": "8a2b12e4-f32b-3029-b3b3-e7fdc6d907e3",
                                                "text": "It'd be a signal to other candidates, that you don't have to hide your 'power level,' as extremists like to say."
                                            },
                                            {
                                                "example_id": "b383d9e7-3ffb-480a-8eba-4346d75b2943",
                                                "sense_id": "8a2b12e4-f32b-3029-b3b3-e7fdc6d907e3",
                                                "text": "Over the past couple weeks, Kanye West revealed his power level, as the kids say. For starters, there was Ye's White Lives Matter T-shirt, which basically rendered everything else at his last-minute YZY SZN 9 fashion show irrelevant, the anti-Semitic tweets that got Ye booted off Twitter, and Ye's very public embrace of bigots like Candace Owens and Tucker Carlson."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "3d53f79c-8e40-3b79-a25e-dbb88a693545",
                                        "entry_id": "5f92aa85-65c9-38a2-8a58-64a74f38ff26",
                                        "glosses": [
                                            "Used other than figuratively or idiomatically: see power, level."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "b0bea912-0e29-4ac6-afa3-d6ee479d61b8",
                                                "sense_id": "3d53f79c-8e40-3b79-a25e-dbb88a693545",
                                                "text": "This is a heavy-duty fridge that operates on a higher power level than most households can supply."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
