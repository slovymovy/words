                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The heavy waves <w>battered</w> the wooden pier until it finally collapsed.",
                            "target_lang_translations": {
                                "ru": "Сильные волны <w>бились</w> о деревянный пирс, пока он наконец не рухнул."
                            }
                        },
                        {
                            "text": "The angry crowd <w>battered</w> down the wooden gates of the palace.",
                            "target_lang_translations": {
                                "ru": "Разъяренная толпа <w>выломала</w> деревянные ворота дворца."
