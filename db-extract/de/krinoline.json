                "senses": [
                    {
                        "sense_id": "b4b05ac8-2056-31d6-a57c-3e3f536db170",
                        "entry_id": "e081d32f-75cd-33f6-871c-7e52c47b7a80",
                        "glosses": [
                            "Reifrock (ein durch Reifen aus Holz, Draht oder Fischbein gespreizter Unterrock)"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "1dceed36-1083-4c27-9be0-15f7f0056fab",
                                "sense_id": "b4b05ac8-2056-31d6-a57c-3e3f536db170",
                                "text": "„Bäuerinnen in geblümten Kopftüchern, Mädchen mit unbedecktem Haupt und Gretchenfrisur, alle Frauen haben den bordeauxroten oder dunkelvioletten Seidenrock über gestärktem Unterrock, so dass sie aussehen, als stolzierten sie in Krinolinen.“"
                            },
                            {
                                "example_id": "5e0e85d1-e2b0-443a-8d9b-0ae4f75be7cf",
                                "sense_id": "b4b05ac8-2056-31d6-a57c-3e3f536db170",
                                "text": "\"Die walzerschwingende Plattform des Karussells erinnert in ihrer Bewegung an die Krinoline, den schwingenden Reifrock der feinen Damenwelt der Jahre um 1860.\" (Internetbeleg)"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    },
                    {
                        "sense_id": "fb314ef0-7230-3edd-8944-1635f2b7d1af",
                        "entry_id": "e081d32f-75cd-33f6-871c-7e52c47b7a80",
                        "glosses": [
                            "historisches Rundkarussell mit zugehöriger Blaskapelle auf dem Münchener Oktoberfest"
                        ],
                        "tags": [
                            "Unterhaltung"
                        ],
                        "examples": [
                            {
                                "example_id": "e5a6bd96-cdd9-468e-a2ae-4d288aaeadb8",
                                "sense_id": "fb314ef0-7230-3edd-8944-1635f2b7d1af",
                                "text": "\"Die Krinoline wurde bis 1938 mit Muskelkraft bewegt, seither per Elektroantrieb. Bis heute wird die Musik live von einer Blaskapelle gespielt.\" (Internetbeleg)"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7b59e1bd-deb6-4bbd-9b21-13ec38cdaaa3",
