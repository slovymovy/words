                "senses": [
                    {
                        "sense_id": "589cc1ff-edd5-37d2-b584-64777b28bfc3",
                        "entry_id": "6cc33118-64d9-3a58-9dc2-150aaad7df9c",
                        "glosses": [
                            "Erlebnis, durch das neue Erkenntnisse gewonnen werden"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "997d0333-4cac-4be6-ba84-c8f91264f4ef",
                                "sense_id": "589cc1ff-edd5-37d2-b584-64777b28bfc3",
                                "text": "„Sein Schlüsselerlebnis dürfte eine recht gewagte Kutschfahrt zu einem Gefecht bei Neapel gewesen sein, das sich Engländer und Franzosen liefern.“"
                            },
                            {
                                "example_id": "dafd14d2-52f4-417d-87f2-da34fceb234f",
                                "sense_id": "589cc1ff-edd5-37d2-b584-64777b28bfc3",
                                "text": "„Schlüsselerlebnis ist ein Gespräch mit einem General, dreimal so alt wie er selbst, der mit derselben Loyalität einer zivilen Regierung dient, mit der er vorher dem Kaiser gedient hat.“"
                            }
                        ],
