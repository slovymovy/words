{
    "word_family": [
        "marginal",
        "marginally",
        "marginalize",
        "marginalization"
    ],
    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "6c0d0c85-4fcb-325c-90d2-dcb8dd16d8e7",
                    "sense_definition": "The empty space at the side of a written or printed page, usually left blank.",
                    "learner_level": "B1",
                    "frequency": "High",
                    "semantic_group_id": "physical_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Please write your corrections in the <w>margin</w>.",
                            "target_lang_translations": {
                                "ru": "Пожалуйста, напишите свои исправления на <w>полях</w>.",
                                "zh": "请把修改意见写在<w>页边空白</w>处。"
                            }
                        },
                        {
                            "text": "The teacher wrote several comments in the wide <w>margins</w> of my essay.",
                            "target_lang_translations": {
                                "ru": "Учитель написал несколько замечаний на широких <w>полях</w> моего эссе.",
                                "zh": "老师在我的作文宽大的<w>页边</w>上写了几条评语。"
                            }
                        }
                    ],
                    "synonyms": [
                        "border",
                        "edge"
                    ],
                    "common_phrases": [
                        "in the margin",
                        "wide margin",
                        "narrow margin",
                        "left margin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Пустое пространство сбоку письменной или печатной страницы, обычно оставляемое чистым.",
                        "zh": "书页或印刷品侧面的空白区域，通常留白。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "по́ле",
                                "target_lang_sense_clarification": "страницы"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "页边空白",
                                "target_lang_sense_clarification": "书页边缘的空白处"
                            },
                            {
                                "target_lang_word": "页边",
                                "target_lang_sense_clarification": "书页的边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "8a47afc8-1513-3bb9-a3e8-6d0b0c7f712d",
                    "sense_definition": "The amount by which one thing is different from another, often used to describe a win in a competition or election.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "difference",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The team won the game by a narrow <w>margin</w> of two points.",
                            "target_lang_translations": {
                                "ru": "Команда выиграла игру с небольшим <w>перевесом</w> в два очка.",
                                "zh": "该队以两分的微弱<w>优势</w>赢得了比赛。"
                            }
                        },
                        {
                            "text": "She was elected by a comfortable <w>margin</w> over her opponent.",
                            "target_lang_translations": {
                                "ru": "Она была избрана со значительным <w>отрывом</w> от своего оппонента.",
                                "zh": "她以明显的<w>优势</w>击败对手当选。"
                            }
                        }
                    ],
                    "synonyms": [
                        "gap",
                        "difference"
                    ],
                    "common_phrases": [
                        "margin of victory",
                        "by a narrow margin",
                        "by a wide margin",
                        "winning margin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Величина, на которую одно отличается от другого; часто используется для описания победы в соревновании или на выборах.",
                        "zh": "两者之间的差额，常用于描述比赛或选举中的胜出优势。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "переве́с",
                                "target_lang_sense_clarification": "преимущество"
                            },
                            {
                                "target_lang_word": "отры́в",
                                "target_lang_sense_clarification": "дистанция"
                            },
                            {
                                "target_lang_word": "ра́зница",
                                "target_lang_sense_clarification": "различие"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "优势",
                                "target_lang_sense_clarification": "胜出的差距"
                            },
                            {
                                "target_lang_word": "差额",
                                "target_lang_sense_clarification": "数量上的差异"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4b4b5194-9afd-36fc-863e-f5af713a6473",
                    "sense_definition": "The difference between the cost of producing or buying something and the price it is sold for; profit.",
                    "learner_level": "B2",
                    "frequency": "High",
                    "semantic_group_id": "finance_profit",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Supermarkets often operate with very low profit <w>margins</w>.",
                            "target_lang_translations": {
                                "ru": "Супермаркеты часто работают с очень низкой <w>маржой</w> прибыли.",
                                "zh": "超市的经营通常只有很低的<w>利润率</w>。"
                            }
                        },
                        {
                            "text": "The company needs to increase its <w>margins</w> to stay in business.",
                            "target_lang_translations": {
                                "ru": "Компании необходимо увеличить свою <w>маржу</w>, чтобы остаться в бизнесе.",
                                "zh": "公司需要提高<w>毛利</w>才能维持经营。"
                            }
                        }
                    ],
                    "synonyms": [
                        "profit",
                        "markup",
                        "yield"
                    ],
                    "antonyms": [
                        "loss"
                    ],
                    "common_phrases": [
                        "profit margin",
                        "gross margin",
                        "net margin",
                        "low margins"
                    ],
                    "traits": [
                        {
                            "trait_type": "colloquial",
                            "comment": "common in business contexts"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Разница между себестоимостью производства или покупки чего-либо и ценой продажи; прибыль.",
                        "zh": "生产或购买成本与销售价格之间的差额；利润。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маржа́",
                                "target_lang_sense_clarification": "экономика"
                            },
                            {
                                "target_lang_word": "при́быль",
                                "target_lang_sense_clarification": "доход"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "利润率",
                                "target_lang_sense_clarification": "商业利润比例"
                            },
                            {
                                "target_lang_word": "毛利",
                                "target_lang_sense_clarification": "财务上的利润空间"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "dac3fffb-b67d-3e4c-a308-1753ebe1b594",
                    "sense_definition": "The outer edge or border of a place, area, or surface.",
                    "learner_level": "B2",
                    "frequency": "Middle",
                    "semantic_group_id": "physical_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "We walked along the <w>margin</w> of the lake to watch the birds.",
                            "target_lang_translations": {
                                "ru": "Мы шли по <w>кро́мке</w> озера, наблюдая за птицами.",
                                "zh": "我们沿着湖的<w>边缘</w>散步，观察鸟类。"
                            }
                        },
                        {
                            "text": "Trees grew thickly at the <w>margin</w> of the forest.",
                            "target_lang_translations": {
                                "ru": "Деревья густо росли на <w>опушке</w> леса.",
                                "zh": "森林的<w>边缘</w>长满了茂密的树木。"
                            }
                        }
                    ],
                    "synonyms": [
                        "edge",
                        "border",
                        "rim",
                        "verge"
                    ],
                    "antonyms": [
                        "center",
                        "middle"
                    ],
                    "common_phrases": [
                        "margin of the lake",
                        "forest margin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешний край или граница места, области или поверхности.",
                        "zh": "地点、区域或表面的外缘或边界。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "край",
                                "target_lang_sense_clarification": "граница"
                            },
                            {
                                "target_lang_word": "кро́мка",
                                "target_lang_sense_clarification": "узкий край"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "区域的界限"
                            },
                            {
                                "target_lang_word": "边沿",
                                "target_lang_sense_clarification": "物体的外缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "2620dc9e-d29f-3541-ae29-8412b9ff3151",
                    "sense_definition": "An extra amount of something, such as time, space, or money, allowed to ensure success or safety.",
                    "learner_level": "C1",
                    "frequency": "Middle",
                    "semantic_group_id": "leeway",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "There is no <w>margin</w> for error in this critical operation.",
                            "target_lang_translations": {
                                "ru": "В этой критически важной операции нет <w>права</w> на ошибку.",
                                "zh": "这项关键行动没有任何犯错的<w>余地</w>。"
                            }
                        },
                        {
                            "text": "We allowed a safety <w>margin</w> of ten minutes to catch the train.",
                            "target_lang_translations": {
                                "ru": "Мы оставили <w>запас</w> времени в десять минут, чтобы успеть на поезд.",
                                "zh": "我们预留了十分钟的<w>余地</w>以赶上火车。"
                            }
                        }
                    ],
                    "synonyms": [
                        "leeway",
                        "room",
                        "latitude",
                        "scope"
                    ],
                    "common_phrases": [
                        "margin of error",
                        "margin of safety",
                        "safety margin"
                    ],
                    "target_lang_definitions": {
                        "ru": "Дополнительное количество чего-либо (времени, пространства, денег), закладываемое для обеспечения успеха или безопасности.",
                        "zh": "为确保成功或安全而预留的额外时间、空间或资金。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "запа́с",
                                "target_lang_sense_clarification": "резерв"
                            },
                            {
                                "target_lang_word": "погре́шность",
                                "target_lang_sense_clarification": "допустимая ошибка"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "余地",
                                "target_lang_sense_clarification": "留出的空间或回旋余地"
                            },
                            {
                                "target_lang_word": "容差",
                                "target_lang_sense_clarification": "允许的误差范围"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "4ebc9471-88f6-3dd5-b747-b85fac42703b",
                    "sense_definition": "The outer limits of a group or society, often referring to people or ideas that are excluded or have little influence.",
                    "learner_level": "C1",
                    "frequency": "Low",
                    "semantic_group_id": "abstract_edge",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Many homeless people are forced to live on the <w>margins</w> of society.",
                            "target_lang_translations": {
                                "ru": "Многие бездомные вынуждены жить на <w>обочине</w> общества.",
                                "zh": "许多无家可归者被迫生活在社会的<w>边缘</w>。"
                            }
                        },
                        {
                            "text": "His radical ideas kept him at the political <w>margins</w> for years.",
                            "target_lang_translations": {
                                "ru": "Его радикальные идеи годами удерживали его на политической <w>периферии</w>.",
                                "zh": "他激进的思想使他多年来一直处于政治的<w>边缘</w>。"
                            }
                        }
                    ],
                    "synonyms": [
                        "fringe",
                        "periphery"
                    ],
                    "antonyms": [
                        "mainstream",
                        "center"
                    ],
                    "common_phrases": [
                        "on the margins",
                        "margins of society"
                    ],
                    "target_lang_definitions": {
                        "ru": "Внешние пределы группы или общества, часто относящиеся к людям или идеям, которые исключены или имеют мало влияния.",
                        "zh": "群体或社会的边缘地带，通常指被排斥或影响力较小的人群或思想。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "обо́чина",
                                "target_lang_sense_clarification": "перен. край общества"
                            },
                            {
                                "target_lang_word": "перифери́я",
                                "target_lang_sense_clarification": "окраина"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "边缘",
                                "target_lang_sense_clarification": "社会地位的边缘"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "f92f4014-2d18-314d-bb28-0376fc76057f",
                    "sense_definition": "Collateral security deposited with a broker to cover the risk of loss in financial trading.",
                    "learner_level": "C2",
                    "frequency": "Low",
                    "semantic_group_id": "finance_collateral",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Investors buying on <w>margin</w> face higher risks if the market drops.",
                            "target_lang_translations": {
                                "ru": "Инвесторы, покупающие с использованием <w>маржи</w>, сталкиваются с более высокими рисками при падении рынка.",
                                "zh": "如果市场下跌，进行<w>保证金</w>交易的投资者将面临更高的风险。"
                            }
                        },
                        {
                            "text": "The broker issued a <w>margin</w> call when the stock price fell sharply.",
                            "target_lang_translations": {
                                "ru": "Брокер выставил требование о внесении <w>маржи</w> (маржин-колл), когда цена акций резко упала.",
                                "zh": "当股价暴跌时，经纪人发出了追加<w>保证金</w>通知。"
                            }
                        }
                    ],
                    "synonyms": [
                        "collateral",
                        "security"
                    ],
                    "common_phrases": [
                        "buying on margin",
                        "margin call",
                        "margin account"
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Залоговое обеспечение, вносимое брокеру для покрытия риска убытков при финансовой торговле.",
                        "zh": "金融交易中存入经纪人处以覆盖亏损风险的抵押品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "маржа́",
                                "target_lang_sense_clarification": "залог"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "保证金",
                                "target_lang_sense_clarification": "金融交易中的抵押金"
                            }
                        ]
                    }
                }
            ]
        },
        {
            "pos": "verb",
            "senses": [
                {
                    "sense_id": "9ce5bcab-2736-3575-8e0a-7b6220a93a23",
                    "sense_definition": "To provide with a margin or border.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_general",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The ancient manuscript was <w>margined</w> with intricate gold leaf designs.",
                            "target_lang_translations": {
                                "ru": "Древняя рукопись была <w>окаймлена</w> сложными узорами из сусального золота.",
                                "zh": "这份古老的手稿被复杂的金箔图案所<w>镶边</w>。"
                            }
                        },
                        {
                            "text": "The river is <w>margined</w> by tall willow trees.",
                            "target_lang_translations": {
                                "ru": "Река <w>окаймлена</w> высокими ивами.",
                                "zh": "河岸边<w>环绕</w>着高大的柳树。"
                            }
                        }
                    ],
                    "synonyms": [
                        "border",
                        "edge"
                    ],
                    "target_lang_definitions": {
                        "ru": "Снабжать полями или каймой.",
                        "zh": "给某物加上边缘或边框。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "окаймля́ть",
                                "target_lang_sense_clarification": "окружать"
                            },
                            {
                                "target_lang_word": "обрамля́ть",
                                "target_lang_sense_clarification": "вставлять в рамку"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "镶边",
                                "target_lang_sense_clarification": "装饰边缘"
                            },
                            {
                                "target_lang_word": "环绕",
                                "target_lang_sense_clarification": "在周围形成边界"
                            }
                        ]
                    }
                },
                {
                    "sense_id": "76b75c8f-6c92-3405-ba7e-e9292894d1ae",
                    "sense_definition": "To deposit collateral when trading securities.",
                    "learner_level": "C2",
                    "frequency": "VeryLow",
                    "semantic_group_id": "verb_finance",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "The portfolio was heavily <w>margined</w>, increasing the risk of a total loss.",
                            "target_lang_translations": {
                                "ru": "Портфель был в значительной степени <w>обеспечен маржой</w>, что повышало риск полной потери.",
                                "zh": "该投资组合大量使用了<w>保证金</w>交易，增加了全盘亏损的风险。"
                            }
                        },
                        {
                            "text": "Traders must ensure their accounts are properly <w>margined</w> before executing large orders.",
                            "target_lang_translations": {
                                "ru": "Трейдеры должны убедиться, что их счета должным образом <w>обеспечены маржой</w> перед выполнением крупных ордеров.",
                                "zh": "交易员在执行大额订单前，必须确保其账户已足额<w>缴纳保证金</w>。"
                            }
                        }
                    ],
                    "traits": [
                        {
                            "trait_type": "regional",
                            "comment": "finance"
                        }
                    ],
                    "target_lang_definitions": {
                        "ru": "Вносить залог при торговле ценными бумагами.",
                        "zh": "在交易证券时存入抵押品。"
                    },
                    "translations": {
                        "ru": [
                            {
                                "target_lang_word": "вносить маржу",
                                "target_lang_sense_clarification": "бирж.: вносить залог при торговле ценными бумагами"
                            }
                        ],
                        "zh": [
                            {
                                "target_lang_word": "缴纳保证金",
                                "target_lang_sense_clarification": "金融操作行为"
                            }
                        ]
                    }
                }
            ]
        }
    ]
}