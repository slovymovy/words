                        "glosses": [
                            "Frau, die sich den Kummer anderer anhört und eventuell Trost spendet und/oder Ratschläge gibt"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e016e5d8-f15e-4df2-bd31-842a01b290c7",
                                "sense_id": "d37bfedb-b3cf-3e7b-9f2c-e6d7411df60e",
                                "text": "„Ich weiß auf solche Fragen so wenig Antwort, wie ich meine Rolle als die Beichtmutter mit dem Kind zu erklären vermag.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
