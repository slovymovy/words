                    }
                ],
                "senses": [
                    {
                        "sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
                        "entry_id": "de08742f-b345-3a31-8e64-0fc40c790fc4",
                        "glosses": [
                            "Relatif à l’ataxie."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "e41cb22e-3008-4602-a148-e06d19befb32",
                                "sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
                                "text": "Pourquoi n’ai-je pas balafré la face hideuse de ce vieux faune ataxique ?…"
                            },
                            {
                                "example_id": "bff7a18b-d7bb-49e6-ad18-f7467ed08eab",
                                "sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
                                "text": "Fièvre ataxique. — État ataxique. — Symptômes ataxiques."
                            },
                            {
                                "example_id": "2a73a517-9282-4c6d-9b75-382cc54298f8",
                                "sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
                                "text": "A petits pas gourds, chaussé de chaussons, un vieux gaga apoplectique, rhumatismal, ataxique et blanc, dont par derrière les kellner se gaussaient, le goguenardant et tournant en bourrique, vint s'attabler à un autre coin; […]."
                            },
                            {
                                "example_id": "3d01fa7a-c51f-47cd-b6b6-c1b6ec6fa648",
                                "sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
                                "text": "Il y avait là des prêtres ataxiques, lesquels, bien entendu, n’avaient jamais usé de morphine et acceptaient chrétiennement des douleurs surhumaines, alors que les médecins, en général, dès les premières atteintes du mal, recourent aux poisons calmants."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "1ad2022d-4f6b-40b1-8be9-ed89ea001b76",
                        "source_entry_id": "de08742f-b345-3a31-8e64-0fc40c790fc4",
                        "source_sense_id": "8193061b-0393-37d7-9050-b9dc91abe356",
