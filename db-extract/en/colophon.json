                                "target_senses": [
                                    {
                                        "sense_id": "b5c91092-2667-3f27-afb3-df1dab3bbafd",
                                        "entry_id": "434f4478-415d-35f6-a9d1-2079fb575896",
                                        "glosses": [
                                            "opsomming van de manier waarop een boek tot stand is gekomen"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "e68b6993-3ff7-4ca2-bd1b-57144e5600a1",
                                                "sense_id": "b5c91092-2667-3f27-afb3-df1dab3bbafd",
                                                "text": "Alleen uit het colofon blijkt dat de krant van Milieudefensie is."
                                            },
                                            {
                                                "example_id": "e98dc4c1-f71a-426b-983e-d7fd53c675ab",
                                                "sense_id": "b5c91092-2667-3f27-afb3-df1dab3bbafd",
                                                "text": "Bij NRC maakt, op voorstel van de redactie zelf, de hoofdredacteur wél deel uit van de directie, maar het bedrijf wordt geleid door een algemeen directeur. Dat staat zo dagelijks in het colofon van de krant (‘Hoofdredacteur: Peter Vandermeersch; Algemeen directeur: Rien van Beemen) en is zo helder vastgelegd bij de Kamer van Koophandel (Peter Vandermeersch hoofdredacteur-directeur; Rien Van Beemen algemeen directeur)."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "1d2851b6-d4bd-4ed7-9426-a7f76e9fc1c5",
                        "source_entry_id": "7164f0a3-3e1b-3ffe-aefd-ec0b9105ac49",
