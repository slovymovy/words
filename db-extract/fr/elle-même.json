                                        "sense_id": "cb48f85b-ddb6-3525-84e3-479ca66a925d",
                                        "entry_id": "721de060-22cc-38f5-aae2-c03dfbbb69af",
                                        "glosses": [
                                            "Her; the female object of a verb or preposition that also appears as the subject."
                                        ],
                                        "tags": [
                                            "feminine",
                                            "personal",
                                            "pronoun",
                                            "reflexive",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "909f30dd-5abb-4725-a9f4-82d2e9384582",
                                                "sense_id": "cb48f85b-ddb6-3525-84e3-479ca66a925d",
                                                "text": "She injured herself."
                                            },
                                            {
                                                "example_id": "41c79c93-4a98-460f-bf4a-50dd07ea0340",
                                                "sense_id": "cb48f85b-ddb6-3525-84e3-479ca66a925d",
                                                "text": "This time was most dreadful for Lilian. Thrown on her own resources and almost penniless, she maintained herself and paid the rent of a wretched room near the hospital by working as a charwoman, sempstress, anything. In a moment she had dropped to the level of a casual labourer."
                                            },
                                            {
                                                "example_id": "ad4a70cf-7c34-4841-9851-2c37e18ea718",
                                                "sense_id": "cb48f85b-ddb6-3525-84e3-479ca66a925d",
                                                "text": "Lizzo, who is known for messages of self-love and wider acceptance, has recently said as much as she shared that she is encouraging a stance of body neutrality for herself and others."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "e48c16f5-17c3-360c-98b2-a0439ae5e300",
                                        "entry_id": "721de060-22cc-38f5-aae2-c03dfbbb69af",
                                        "glosses": [
                                            "She; an intensifier of the female subject or object, often used to indicate the directness or exclusiveness of that person ."
                                        ],
                                        "tags": [
                                            "emphatic",
                                            "feminine",
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "62b47243-0b5b-4c75-834e-2fe6eef2271e",
                                                "sense_id": "e48c16f5-17c3-360c-98b2-a0439ae5e300",
                                                "text": "She was injured herself."
                                            }
                                        ]
                                    },
                                    {
                                        "sense_id": "48a50ecd-b934-302c-8e07-aebeca60c011",
                                        "entry_id": "721de060-22cc-38f5-aae2-c03dfbbb69af",
                                        "glosses": [
                                            "The subject or non-reflexive object of a predicate; she (used of upper-class ladies, or sarcastically, of women who imagine themselves to be more important than others)"
                                        ],
                                        "tags": [
                                            "Ireland",
                                            "feminine",
                                            "personal",
                                            "pronoun",
                                            "singular",
                                            "third-person"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "22b0a434-feaf-4287-b806-97ce0ace4add",
                                                "sense_id": "48a50ecd-b934-302c-8e07-aebeca60c011",
                                                "text": "What's herself up to this time?"
                                            },
                                            {
                                                "example_id": "704d94e6-f41c-4104-9e3c-6ba09c4fe4b7",
                                                "sense_id": "48a50ecd-b934-302c-8e07-aebeca60c011",
                                                "text": "Have you seen herself yet this morning?"
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
