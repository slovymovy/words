                ],
                "senses": [
                    {
                        "sense_id": "6ed0fc00-b69e-35e1-bc08-ff28418debcb",
                        "entry_id": "a7cebb4d-0536-3a4c-9332-8b80615a7fdc",
                        "glosses": [
                            "прич. от унести"
                        ],
                        "tags": [
                            "participle"
                        ],
                        "examples": [
                            {
                                "example_id": "3bf47c71-2dcf-4484-9854-88172eb09dbe",
                                "sense_id": "6ed0fc00-b69e-35e1-bc08-ff28418debcb",
                                "text": "Мне кажется, мы не до конца осознали, какую цену России придётся заплатить за вторжение в Украину, за войну, уже унёсшую тысячи жизней."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "7ce9b639-94ac-4542-96bf-8b30de05e8ab",
                        "source_entry_id": "a7cebb4d-0536-3a4c-9332-8b80615a7fdc",
                        "source_sense_id": "6ed0fc00-b69e-35e1-bc08-ff28418debcb",
                        "target_lang_word": "carried away",
                        "target_lang_code": "en",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "carried away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "3eb081fa-2f44-3873-8826-d892337398b9",
                                        "entry_id": "9199cf4a-f509-3a67-96e2-77baba378297",
                                        "glosses": [
                                            "past participle of carry away"
                                        ],
                                        "tags": [
                                            "form-of",
                                            "participle",
                                            "past"
                                        ],
                                        "examples": []
                                    }
                                ]
                            },
                            {
                                "target_word": "carried away",
                                "target_lang_code": "en",
                                "target_senses": [
                                    {
                                        "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                        "entry_id": "682585fc-2f02-3f50-8b35-e2bd84b8203c",
                                        "glosses": [
                                            "Made excessively emotional or excited, so that one goes too far."
                                        ],
                                        "tags": [
                                            "idiomatic"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "dd93951d-a5ea-47c9-ad7d-ea10a3456ac6",
                                                "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                                "text": "I only meant to buy one new dress, but I got carried away and ended up with five."
                                            },
                                            {
                                                "example_id": "874609df-27cd-491b-b457-98ce77093df5",
                                                "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                                "text": "[…] the unusual degree of taste and energy which Annie, who appeared carried away by the interest of the drama, infused into her reading, […]"
                                            },
                                            {
                                                "example_id": "0767691d-2ff0-4a80-aa10-397c681022c6",
                                                "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                                "text": "She sounds carried away."
                                            },
                                            {
                                                "example_id": "a7662665-431b-4569-a650-d9f4c8c11090",
                                                "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                                "text": "As the speech continues , Mercutio seems carried away by it, so that Romeo 's interruption (addressing Mercutio by name for the first time, as if to call him to himself) is like the breaking of a rapture."
                                            },
                                            {
                                                "example_id": "b6b005b7-a5e2-4456-b15f-e6ea6ff81de2",
                                                "sense_id": "1124573e-f889-374c-8eab-ac75fbb9243a",
                                                "text": "“People got carried away, myself included,” Kwarteng told the Financial Times. “There was no tactical subtlety whatsoever."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "e5b981b7-4e44-4896-926c-71a3c1a11c8d",
