                        "sense_id": "a8f790e7-8628-3ce3-a38e-795a87fcb81a",
                        "entry_id": "ee1413f2-3c79-3b8e-ab11-3896d9f45aab",
                        "glosses": [
                            "In good enough shape to be shown or offered to other people; tidy; attractive."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "a2b4ba5b-5966-464b-91c4-2d63a2fee740",
                                "sense_id": "a8f790e7-8628-3ce3-a38e-795a87fcb81a",
                                "text": "Before we go out, let me just go to the washroom and make myself presentable."
                            },
                            {
                                "example_id": "d899f4ae-0de4-4a05-887b-b1df2dfb8e85",
                                "sense_id": "a8f790e7-8628-3ce3-a38e-795a87fcb81a",
                                "text": "Before they went to see Glinda, however, they were taken to a room of the Castle, where Dorothy washed her face and combed her hair, and the Lion shook the dust out of his mane, and the Scarecrow patted himself into his best shape, and the Woodman polished his tin and oiled his joints. When they were all quite presentable they followed the soldier girl into a big room where the Witch Glinda sat upon a throne of rubies."
                            }
                        ]
                    },
                    {
                        "sense_id": "1f500577-6b64-367c-a2d8-2eb59124b400",
                        "entry_id": "ee1413f2-3c79-3b8e-ab11-3896d9f45aab",
                        "glosses": [
                            "Acceptable; worth considering."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "865ea376-644a-4c77-8279-eee0a0645898",
                                "sense_id": "1f500577-6b64-367c-a2d8-2eb59124b400",
                                "text": "Liverpool took control of what had been a tight game, with Bruno Fernandes and Marcus Rashford missing presentable chances, when former Old Trafford target Cody Gakpo applied a smooth finish to Andy Robertson's perfect pass two minutes before the break."
                            }
                        ]
                    },
