                ],
                "senses": [
                    {
                        "sense_id": "19b5628e-86e1-38ff-91b1-dc3fe4666709",
                        "entry_id": "f299f378-f8ac-3f6e-afd1-865bd318b3aa",
                        "glosses": [
                            "zonder enige schuld of slechtheid"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "66149878-a73d-4931-a824-5b5407c04ec8",
                                "sense_id": "19b5628e-86e1-38ff-91b1-dc3fe4666709",
                                "text": "NRC Handelsblad ontmaskerde UvA-onderzoeker Aysha Navest, die met twee evenmin smetvrije collega-antropologen had meegewerkt aan een studie over 22 anonieme jihadbruiden, als een vrouw die op een forum de gewelddadige jihad heeft geprezen."
                            },
                            {
                                "example_id": "2e28130a-2809-4d77-99a7-326438241f49",
                                "sense_id": "19b5628e-86e1-38ff-91b1-dc3fe4666709",
                                "text": "Het aantal biowijnen nam met hetzelfde percentage toe. Ondanks de berichtgeving in de pers, dat wij bij economische tegenwind onze biologische eet- en drinkprincipes opzijzetten vanwege het hogere prijskaartje dat aan producten van smetvrije komaf hangt."
                            }
                        ]
                    },
                    {
                        "sense_id": "542fc036-9961-3521-b534-eb458136d4a4",
                        "entry_id": "f299f378-f8ac-3f6e-afd1-865bd318b3aa",
                        "glosses": [
                            "zonder vlek, helemaal schoon"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "ff8bd250-e523-4e00-bde1-62c0e08c5157",
                                "sense_id": "542fc036-9961-3521-b534-eb458136d4a4",
                                "text": "Er schort nog iets aan die seks. Anastasia ligt zich doorgaans uit te strekken als was ze aan het turnen, en kreunt vaak al voor Grey of zijn zweep in de buurt komt. Extreme opwinding? Misschien. Maar zou ze er dan na de daad altijd nog zo smetvrij uitzien?"
                            },
                            {
                                "example_id": "3519aec3-4d6a-477c-965c-58446a3b9854",
                                "sense_id": "542fc036-9961-3521-b534-eb458136d4a4",
                                "text": "Wie een op zichzelf vrij onschuldige bacterie in zijn neus blijkt te huisvesten, krijgt zalf en shampoo om het reukorgaan smetvrij te maken voordat de chirurg aan de slag gaat."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "29308b3c-5803-4268-9e90-cc6c85e3b68b",
                        "source_entry_id": "f299f378-f8ac-3f6e-afd1-865bd318b3aa",
                        "source_sense_id": "19b5628e-86e1-38ff-91b1-dc3fe4666709",
