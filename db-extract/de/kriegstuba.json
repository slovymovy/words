                        "sense_id": "8ddb2980-eb4e-31b7-b129-1711713bd74b",
                        "entry_id": "d50d4f17-7f07-35b0-a3a0-e07b6f42480b",
                        "glosses": [
                            "war tuba, martial tuba (a kind of war-horn)"
