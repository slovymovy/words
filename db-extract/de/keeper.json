                                "sense_id": "2d55e62a-2ea2-3612-81ee-dfce50e136bc",
                                "text": "Der Keeper mixt eine Bloody Mary."
                            },
                            {
                                "example_id": "04fa66c0-42f2-4890-8625-bec28e16b31a",
                                "sense_id": "2d55e62a-2ea2-3612-81ee-dfce50e136bc",
                                "text": "„Nach seinem auffallenden Auftritt in der Bar hat ihm der Keeper später beim Absacker etwas von dubiosen Geschäften erzählt.“"
                            }
                        ],
                        "sense_index_json": "\"2\""
                    }
