                        "sense_id": "f290304c-ef2c-33f7-8ad2-28cea93e869a",
                        "entry_id": "c9de2996-ae4b-336a-9174-76ebcbbad5f6",
                        "glosses": [
                            "cecha tego, co nieszczere; cecha tego, kto jest nieszczery"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "03defd14-e84e-4f06-bb3a-e2bf682e28fd",
                                "sense_id": "f290304c-ef2c-33f7-8ad2-28cea93e869a",
                                "text": "Nieszczerość jako pewna postawa wobec siebie i wobec innych wchodzi w skład codzienności każdego z nas"
                            },
                            {
                                "example_id": "89714503-ace8-4999-b9c3-de445cee9582",
                                "sense_id": "f290304c-ef2c-33f7-8ad2-28cea93e869a",
                                "text": "Nieszczerość jest na wskroś pragmatyczną postawą, ciągłą próbą zmylenia drugiej strony, aby łatwiej osiągnąć swój cel. Nieszczerym się nie bywa, nieszczerym się jest"
                            }
                        ],
                        "sense_index_json": "\"1.1\""
                    }
                ],
