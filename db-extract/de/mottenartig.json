                ],
                "senses": [
                    {
                        "sense_id": "a9bbf2ee-83cf-3e2e-87dd-02cb5c1a58c5",
                        "entry_id": "b628e078-1db4-3388-b1ad-567d6ec96600",
                        "glosses": [
                            "Motten ähnelnd, an Motten erinnernd"
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "45dad45d-563b-4ba6-bb26-c17fa1577a8b",
                                "sense_id": "a9bbf2ee-83cf-3e2e-87dd-02cb5c1a58c5",
                                "text": "„Die Mahlzeiten, darunter die Eier eines mottenartigen Insekts von der Größe einer Bachstelze und die Äpfel eines Pilzbaumes, der in den Kratern erloschener Vulkane wuchs, waren unvorstellbar in ihrer Fremdartigkeit.“"
                            },
                            {
                                "example_id": "0a92af26-ce31-4946-982e-60b83dae4135",
                                "sense_id": "a9bbf2ee-83cf-3e2e-87dd-02cb5c1a58c5",
                                "text": "„Die billigen Bretter hinter dem Altar waren golden gestrichen worden, und die verputzten Wände der Kirche waren mit Blumen bemalt, die von mottenartigen, durch die Lichtvierecke schwebenden Insekten heimgesucht wurden: eins, dann das nächste.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
