                "senses": [
                    {
                        "sense_id": "30743c43-9091-3767-b995-5e671b8a0a6f",
                        "entry_id": "849d422e-25ae-3fe8-b5c7-36d761da3bf1",
                        "glosses": [
                            "Zustand der Mattheit nach reichlichem Verzehr von Nahrung"
                        ],
                        "tags": [
                            "humorous"
                        ],
                        "examples": [
                            {
                                "example_id": "78d6b9a4-1666-4cb1-850e-7c1b84b9f6cd",
                                "sense_id": "30743c43-9091-3767-b995-5e671b8a0a6f",
                                "text": "„Daher gab es auch tüchtig Ärger, als der Stadtdirektor in Vechta/Niedersachsen seinen Mitarbeitern im Jahr 2000 gestattete, ihre Futternarkose für zwanzig Minuten auf einer Isomatte neben dem Schreibtisch zu genießen.“"
                            },
                            {
                                "example_id": "57cf34d4-648d-4d20-8df8-5b8adc2e2f39",
                                "sense_id": "30743c43-9091-3767-b995-5e671b8a0a6f",
                                "text": "„Wenn man nach einer ausgiebigen Mahlzeit, insbesondere Fast Food, sehr träge wird, befindet man sich in einer Futternarkose.“"
                            },
                            {
                                "example_id": "34a04c90-d1dc-40d1-b7e0-e4b3d122cd45",
                                "sense_id": "30743c43-9091-3767-b995-5e671b8a0a6f",
                                "text": "„Jeder kennt die ‚Futternarkose‘, in die man nach ausgiebigen Mahlzeiten fällt.“"
                            },
                            {
                                "example_id": "77cae5d4-a426-4914-9205-95031c986b63",
                                "sense_id": "30743c43-9091-3767-b995-5e671b8a0a6f",
                                "text": "„Das erste Glas Rotwein. Rauchen. Trinken. Kochen. Rauchen. Trinken. Essen. Danach komatöse Futternarkose.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
