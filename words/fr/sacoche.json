    "entries": [
        {
            "pos": "noun",
            "senses": [
                {
                    "sense_id": "f3e9f3bb-4101-3440-81f9-1740ee19a27f",
                    "sense_definition": "Sac en cuir ou en toile, généralement muni d'une bandoulière, que l'on porte sur le côté ou dans le dos.",
                    "learner_level": "A2",
                    "frequency": "High",
                    "semantic_group_id": "bagage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il range ses clés et son portefeuille dans sa <w>sacoche</w> avant de quitter la maison."
                        },
                        {
                            "text": "Ce touriste porte une <w>sacoche</w> en bandoulière pour garder ses affaires en sécurité."
                        }
                    ],
                    "common_phrases": [
                        "sacoche en bandoulière",
                        "sacoche en cuir"
                    ]
                },
                {
                    "sense_id": "74c0f0a3-2329-3bb9-a704-ea6a5f7e5bd5",
                    "sense_definition": "Sac à main servant à transporter ses objets personnels au quotidien.",
                    "learner_level": "A2",
                    "frequency": "Middle",
                    "semantic_group_id": "bagage",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle a posé sa petite <w>sacoche</w> sur la table avant de s'asseoir."
                        },
                        {
                            "text": "J'ai oublié ma <w>sacoche</w> avec mes papiers d'identité sur le siège du bus."
                        }
                    ],
                    "synonyms": [
                        "sac à main"
                    ]
                },
                {
                    "sense_id": "9dfe5dd1-9083-3713-9565-038f3f7c1b5e",
                    "sense_definition": "Sac fixé au porte-bagages, au cadre ou au guidon d'un vélo ou d'une moto.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "transport",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Il a accroché deux grandes <w>sacoches</w> à l'arrière de son vélo pour son voyage."
                        },
                        {
                            "text": "Pensez à bien fermer la <w>sacoche</w> de votre moto pour ne rien perdre en route."
                        }
                    ],
                    "common_phrases": [
                        "sacoche de vélo",
                        "sacoches latérales"
                    ]
                },
                {
                    "sense_id": "631e3d4f-8768-37ae-9ed2-ef8a6ec1a7f8",
                    "sense_definition": "Housse ou sac renforcé conçu pour transporter et protéger un ordinateur portable ou du matériel électronique.",
                    "learner_level": "B1",
                    "frequency": "Middle",
                    "semantic_group_id": "materiel",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Elle transporte tous les jours son ordinateur dans une <w>sacoche</w> rembourrée."
                        },
                        {
                            "text": "N'oublie pas de ranger les câbles dans la <w>sacoche</w> avant de partir au bureau."
                        }
                    ],
                    "common_phrases": [
                        "sacoche d'ordinateur"
                    ]
                }
            ]
        }
    ]
