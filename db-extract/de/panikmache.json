                "senses": [
                    {
                        "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                        "entry_id": "3e193afe-7d55-3592-a57e-febb42d1ba2d",
                        "glosses": [
                            "Versuch, künstlich Panik zu verursachen"
                        ],
                        "tags": [
                            "colloquial",
                            "derogatory"
                        ],
                        "examples": [
                            {
                                "example_id": "c4bbba59-1394-4e93-8aea-dcf99650e7c2",
                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                "text": "„Ich bin eigentlich sehr anfällig für jegliche Panikmache, aber es gibt so strenge Auflagen im Strahlenschutz - würde man wirklich Mikrowellen verkaufen, seit Jahrzehnten, wenn von den Geräten eine ernsthafte Gefahr ausginge?“"
                            },
                            {
                                "example_id": "c19d8736-6aa4-4ca2-a86e-9f8c3242abfa",
                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                "text": "„Das rechte Phantasma gesellschaftlichen Zusammenlebens basiert auf der Angst vor der Fragmentierung, auf der Panik und Panikmache vor einer Desintegration der Gesellschaft. Schon historisch führt diese Panikmache in die Irre.“"
                            },
                            {
                                "example_id": "ab0aee84-a7e1-42d1-b42e-4b2aeeac10da",
                                "sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
                                "text": "„Vielleicht ist also doch nur alles Panikmache, und wir stehen gar nicht kurz vor der Apokalypse.“"
                            }
                        ],
                        "sense_index_json": "\"1\""
                    }
                ],
                "translations": [
                    {
                        "translation_id": "31dafe36-125a-430d-87be-d58bc8d67ebf",
                        "source_entry_id": "3e193afe-7d55-3592-a57e-febb42d1ba2d",
                        "source_sense_id": "179c496e-e027-32c0-8fde-98ff2cb37db7",
