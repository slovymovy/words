                    },
                    {
                        "sense_id": "941b5dd7-0a2f-36a3-b7ee-4b859d66f03f",
                        "entry_id": "7aaf3275-4a4f-3816-8a91-c674124bfca2",
                        "glosses": [
                            "hole in a bag"
                        ],
                        "tags": [
                            "neuter",
                            "strong"
                        ],
                        "examples": [
                            {
                                "example_id": "696f479f-40df-4187-9107-8470fe117dd1",
                                "sense_id": "941b5dd7-0a2f-36a3-b7ee-4b859d66f03f",
                                "text": "Einige der Säcke waren geplatzt. Hier steckte ein Kamel seine langen, gelben Zähne heraus, dort ein Pferd sein Vorderbein, dort ein Hund sein Schwänzchen, und aus dem einen Sackloche grinste ganz fidel ein menschlicher Totenschädel. Was Kapitän Flederwisch mit den 40.000 Zentnern Knochen anfangen wollte?"
                            }
                        ]
                    }
