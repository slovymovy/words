                    "frequency": "High",
                    "semantic_group_id": "unterkunft",
                    "name_type": "no",
                    "examples": [
                        {
                            "text": "Die Stadt musste viele Menschen nach dem Unwetter in einer Notunterkunft <w>unterbringen</w>."
                        },
                        {
                            "text": "Er <w>brachte</w> die ausländischen Gäste in einem ruhigen Hotel in der Nähe des Zentrums <w>unter</w>."
                        }
                    ],
                    "synonyms": [
                        "beherbergen",
                        "einquartieren"
                    ],
                    "common_phrases": [
                        "Gäste unterbringen",
                        "im Hotel unterbringen",
                        "in einer Notunterkunft unterbringen"
                    ]
                },
                {
