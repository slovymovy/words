                            "singular"
                        ],
                        "form": "die Verächtlichkeit"
                    },
                    {
                        "form_id": "d4f18634-b7bd-4c03-8d19-f088f9c1a4cb",
                        "entry_id": "c224213c-0e46-348a-978e-84f15ff325e0",
                        "tags": [
                            "accusative",
