                                    {
                                        "sense_id": "360cf10d-1b8b-31cc-aaf8-9f7aed59cf3d",
                                        "entry_id": "4f622566-1426-33a3-925f-1ca85db6d1f4",
                                        "glosses": [
                                            "The first milk drawn from an animal (especially a cow) after it has given birth."
                                        ],
                                        "tags": [
                                            "plural",
                                            "plural-only"
                                        ],
                                        "examples": [
                                            {
                                                "example_id": "1c795953-584f-4572-9922-517ab569e4d9",
                                                "sense_id": "360cf10d-1b8b-31cc-aaf8-9f7aed59cf3d",
                                                "text": "He took a jug of ‘beestings’ milk from the press, the milk of a cow that has recently calved, and drank it down in six big gulps."
                                            }
                                        ]
                                    }
                                ]
                            },
