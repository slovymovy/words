                        "entry_id": "a44124f3-7876-3406-98ce-89b63748e0f0",
                        "glosses": [
                            "A short, simple verse or song."
                        ],
                        "tags": [],
                        "examples": [
                            {
                                "example_id": "9f09f865-780d-4b1c-8a3b-f93df762d431",
                                "sense_id": "6407f36c-4430-3fcb-9a0a-263d736b4e62",
                                "text": "The Acme mattress ditty has been stuck in my head all day."
                            },
                            {
                                "example_id": "c5c85675-ce72-4aea-ab8c-02a1a0e2c850",
                                "sense_id": "6407f36c-4430-3fcb-9a0a-263d736b4e62",
                                "text": "religious, martial, or civil ditties"
                            },
                            {
                                "example_id": "6362fc34-05d5-4398-9a63-e34e44b07045",
                                "sense_id": "6407f36c-4430-3fcb-9a0a-263d736b4e62",
                                "text": "And to the warbling lute soft ditties sing."
                            }
                        ]
                    },
                    {
                        "sense_id": "18649d74-3611-35df-98be-5531d876d088",
                        "entry_id": "a44124f3-7876-3406-98ce-89b63748e0f0",
                        "glosses": [
                            "A saying or utterance, especially one that is short and frequently repeated."
                        ],
                        "tags": [],
