    "source_file_to_entries": {
        "raw-wiktextract-data.jsonl": [
            {
                "entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                "word": "decrepitude",
                "pos": "noun",
                "lang_code": "en",
                "forms": [
                    {
                        "form_id": "61f1f8a7-f66e-4752-94b5-d6eb009fdafd",
                        "entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "tags": [
                            "plural"
                        ],
                        "form": "decrepitudes"
                    }
                ],
                "senses": [
                    {
                        "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                        "entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "glosses": [
                            "The state of being decrepit or worn out from age or long use."
                        ],
                        "tags": [
                            "countable",
                            "uncountable"
                        ],
                        "examples": [
                            {
                                "example_id": "b306be2a-f7dd-408b-9c83-d4167f53d5b6",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "There prevailed in his time an opinion, that the world was in its decay, and that we have had the misfortune to be produced in the decrepitude of nature."
                            },
                            {
                                "example_id": "78190e11-350f-4a1f-90c6-29fbdfd06a0e",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "This was the probable destination of his sister Kate. His uncle had deceived him, and might he not consign her to some miserable place where her youth and beauty would prove a far greater curse than ugliness and decrepitude?"
                            },
                            {
                                "example_id": "6fec3e5a-1627-4753-8659-d91972c365cc",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "Being a trifle precipitate in his entry, he trod on a bottle, and was instantly extinguished by a Japanese screen, which appeared to collapse on him out of pure decrepitude."
                            },
                            {
                                "example_id": "a7a66194-78f6-46b6-8e2b-f28dd7e36be3",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "We were encircled by a ghostly decrepitude, roads that led to nowhere, canals holding pools of brilliant, stinking water, a few nat-haunted banyan trees, grotesque with old muscled trunks and bearded roots."
                            },
                            {
                                "example_id": "e1c16bda-cf01-4c8a-bc68-d6864f6eb4fa",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "He recalled that when he accompanied Nixon to Peking in February, 1972, he had been struck by Mao's decrepitude and Chou's failing health."
                            },
                            {
                                "example_id": "b9a634ec-df8c-4d67-9dd6-2bfeb135bc1d",
                                "sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                                "text": "Having slapped into middle age, where thoughts of one’s general infallibility are tempered by the realisation that those creaky, achy complaints are signs of certain decrepitude, I have decided to ward against further gravitational decline by hauling my saggy, sorry self to the gym."
                            }
                        ]
                    }
                ],
                "translations": [
                    {
                        "translation_id": "4084d0c9-92cd-44cc-af4b-e8270b91ff20",
                        "source_entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "source_sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                        "source_sense_description": "the state of being decrepit",
                        "target_lang_word": "aftakeling",
                        "target_lang_code": "nl",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "aftakeling",
                                "target_lang_code": "nl",
                                "target_senses": [
                                    {
                                        "sense_id": "9ea717d2-7de9-3978-b62c-e807c2da0c1e",
                                        "entry_id": "7b483737-be7e-3635-9b57-353e746c8ffd",
                                        "glosses": [
                                            "het aftakelen: de achteruitgang in kracht, schoonheid, intelligentie etc."
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "83d4ec57-86ab-42cb-ad8f-68db0b2164e3",
                                                "sense_id": "9ea717d2-7de9-3978-b62c-e807c2da0c1e",
                                                "text": "De speculaties over Poetins aftakeling zijn vooral gebaseerd op twee recente openbare optredens: hoe hij zijn Veiligheidsraad afblaft en zijn zeventig minuten lange imperialistische toespraak aan de vooravond van de inval in Oekraïne."
                                            }
                                        ]
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "9102ec4f-0912-4c32-afad-f4454dca3792",
                        "source_entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "source_sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                        "source_sense_description": "the state of being decrepit",
                        "target_lang_word": "Abnutzung",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Abnutzung",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "ea0dbd26-7e75-3729-b10e-6778b62b44d3",
                                        "entry_id": "8202e283-a972-32cd-9855-b4d515394e5a",
                                        "glosses": [
                                            "kontinuierliche Beschädigung durch Benutzung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "a7a89762-15a5-46a5-9fd4-f10a33ab7a29",
                                                "sense_id": "ea0dbd26-7e75-3729-b10e-6778b62b44d3",
                                                "text": "In der Kostenrechnung muss man die Abnutzung der Teile berücksichtigen."
                                            },
                                            {
                                                "example_id": "a0f26a1d-4628-4bdf-9a77-f292985ad911",
                                                "sense_id": "ea0dbd26-7e75-3729-b10e-6778b62b44d3",
                                                "text": "„Auch beim Menschen könnte es darauf ankommen, das Erbgut der Zellen vor früher Abnutzung zu bewahren – und so vielleicht den ganzen Körper.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "3f07703c-3504-4f2c-b796-b9e9b330a12e",
                        "source_entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "source_sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                        "source_sense_description": "the state of being decrepit",
                        "target_lang_word": "Altersschwäche",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Altersschwäche",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                        "entry_id": "7180b68a-713e-3671-aed0-c770a1364e4b",
                                        "glosses": [
                                            "körperlicher und/oder geistiger Mangel, der sich mit zunehmendem Alter einstellt"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "96aca1b6-bd98-489e-b86b-3ab92153a5ad",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "Nachlassende geistige Fitness ist eine von vielen Formen der Altersschwäche."
                                            },
                                            {
                                                "example_id": "6fab4cb4-3ae3-4a64-b38d-2577afc74981",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "„Als er sich wieder erheben wollte, brachte er es angesichts seines Leibesumfanges und seiner Altersschwäche lange Zeit nicht zustande.“"
                                            },
                                            {
                                                "example_id": "931c8060-9da7-4b59-b63d-b733a819c5ab",
                                                "sense_id": "e92ca96b-c738-3c08-ac76-d3a02dfcd850",
                                                "text": "„Es ist gerichtsbekannt, daß der Pflichtverteidiger des Angeklagten unter Altersschwäche leidet und einen Sprachfehler hat, so daß er kaum zu verstehen ist.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "translation_id": "7874b63f-a3f1-499b-bc0c-641eb7dc3e6c",
                        "source_entry_id": "82882d5b-93e5-3100-b504-580eac0980f3",
                        "source_sense_id": "d03b8500-2f12-358d-83df-c8edddabce9c",
                        "source_sense_description": "the state of being decrepit",
                        "target_lang_word": "Verfall",
                        "target_lang_code": "de",
                        "target_sense_ids": [],
                        "cross_references": [
                            {
                                "target_word": "Verfall",
                                "target_lang_code": "de",
                                "target_senses": [
                                    {
                                        "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "allmähliche Zerstörung von Gebäuden oder Gegenständen (aufgrund des Alters, mangelnder Pflege, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "477fca4c-26d4-4640-be73-3fcd9d1bc648",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "Das Endstadium des Verfalls ist beim Reetdach erreicht, wenn man mit den Händen leicht hineingreifen kann und die Halme sich dabei anfühlen wie ein tropfnasses Papierhandtuch."
                                            },
                                            {
                                                "example_id": "9321cb94-bab7-4b61-953d-7d274584df8a",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "Russlands Parlament will Kulturdenkmäler vor Verfall schützen."
                                            },
                                            {
                                                "example_id": "23bc976c-4056-46df-8f31-77cf151a33d4",
                                                "sense_id": "e20aa1c4-7f56-3e92-8e1a-7b8d9d572ef2",
                                                "text": "„Der Verfall war fast unheimlich.“"
                                            }
                                        ],
                                        "sense_index_json": "\"1\""
                                    },
                                    {
                                        "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Wertminderung oder Verlust des Wertes einer Sache (zum Beispiel Währung, Gutschein, Patent, Preise, …)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "80dca254-de57-45bc-a7da-27878d1f5a3a",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "Mit dem eskalierenden Verfall des US-Dollar stehen die Pläne fuer eine arabische Einheitswährung wieder auf der Tagesordnung."
                                            },
                                            {
                                                "example_id": "8b0aaf4b-9eb6-4682-ac2f-ad03cd4a9961",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "In Indien und China gibt es fast schon eine Flut an gut ausgebildeten Forschern und dieses Überangebot sorgt für einen weiteren Verfall der Löhne und macht Forschung dadurch billiger."
                                            },
                                            {
                                                "example_id": "60e0f4e9-a00a-41e5-9a5d-511a6887b189",
                                                "sense_id": "5902e0a2-5c2d-360a-9948-c5868e228fe4",
                                                "text": "Der Europäische Gerichtshof prüft in einem aktuellen Verfahren, ob der Verfall von Urlaubstagen nach Ablauf der gesetzlich festgelegten Fristen zulässig ist."
                                            }
                                        ],
                                        "sense_index_json": "\"2\""
                                    },
                                    {
                                        "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Verlust von Einfluss und Geltung (von Staaten, politischen Systemen, Kultur, Sitten)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "0096dc6a-b805-42a8-addb-8309635d7bdd",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Sein dänischer Verleger sagt, Hultberg habe sich an das alte Manuskript erinnert, als er einen neuen Roman über den Verfall nicht der Menschheit allgemein oder einer ganzen Stadt, sondern einer Familie schreiben wollte."
                                            },
                                            {
                                                "example_id": "2912c06e-2925-4bcb-b25d-6d8d340550f2",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Und deshalb bedeutet das Ende der Milchwirtschaft auch den Verfall der schönen Urlaubslandschaft, wenn die Bauern sie einmal nicht mehr pflegen."
                                            },
                                            {
                                                "example_id": "fa157bbf-468d-4f12-a747-eb85aa325b92",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Auch im Provinzstädtchen Leninsk, wo sich der Verfall der UdSSR als Panorama einer von innen verrotteten Gesellschaft spiegelt."
                                            },
                                            {
                                                "example_id": "439d6345-6158-4965-8276-6a49a0dc3258",
                                                "sense_id": "54e653e8-c3a8-365d-98fa-b643a2b8f94d",
                                                "text": "Um einem Verfall der Sitten vorzubeugen und die öffentliche Moral zu schützen, müsse, so die Polizei, das Liebespärchen angemessen bestraft werden."
                                            }
                                        ],
                                        "sense_index_json": "\"3\""
                                    },
                                    {
                                        "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Verlust von körperlicher, geistiger oder seelischer Kraft (eines Menschen)"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "151d3ba0-2bb4-4a73-868f-fe9db6449891",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "Die Wissenschaftler vermuten daher, dass der geistige Verfall des weiblichen Gehirns schneller abläuft und Männer sich länger in einer Vorstufe zur Demenz befinden."
                                            },
                                            {
                                                "example_id": "e3ee772f-d629-432f-a124-fbd4a4cff4a1",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "In Zeiten, in denen viele den Verfall der Sprach- und Lesefähigkeit von Kindern und Jugendlichen beklagen, setzt ´Tatort Bodensee´ gerade auf die Entwicklung und Förderung dieser Fähigkeiten[…]"
                                            },
                                            {
                                                "example_id": "cf9f5d71-3129-44de-bc04-35ef72bfbd3a",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "Der körperliche und psychische Verfall des Vaters löst bei den Geschwistern unterschiedliche Gefühle aus, von Unbehagen über Aggression bis hin zu Schuldgefühlen und Scham."
                                            },
                                            {
                                                "example_id": "4d4cbe77-654b-45f6-a498-5f7d01fa016d",
                                                "sense_id": "ad0f147a-9f60-3c33-bc4a-e1228c8aa5cf",
                                                "text": "„Philip war über Sandys Verfall entsetzt.“"
                                            }
                                        ],
                                        "sense_index_json": "\"4\""
                                    },
                                    {
                                        "sense_id": "1c6bc532-4029-3098-a18d-84ddd61dc105",
                                        "entry_id": "531d4a66-7aeb-3b69-8603-a289f0bce160",
                                        "glosses": [
                                            "Einzug von Vermögenswerten als Folge einer strafbaren Handlung"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "066af85c-bb64-4580-a4a1-c9bec6280339",
                                                "sense_id": "1c6bc532-4029-3098-a18d-84ddd61dc105",
                                                "text": "„Zweck des Verfalls ist es, einen Vermögenszuwachs der durch die Begehung einer strafbaren Handlung erlangt wurde, zu beseitigen.“"
                                            }
                                        ],
                                        "sense_index_json": "\"5\""
                                    }
                                ]
                            }
                        ]
