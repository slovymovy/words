                                        "entry_id": "267f3a49-5c48-3974-8c4a-cbd96a515e40",
                                        "glosses": [
                                            "die Neurologie (Wissenschaft und Lehre vom Nervensystem, seinen Erkrankungen und deren medizinischer Behandlung) betreffend; das Nervensystem betreffend"
                                        ],
                                        "tags": [],
                                        "examples": [
                                            {
                                                "example_id": "d0c339df-16f5-4e43-91fd-e928b4335470",
                                                "sense_id": "35421c3a-f2f0-3c68-8e75-cf6b0f680e00",
                                                "text": "Epilepsie gehört zu den neurologischen Erkrankungen."
                                            },
                                            {
                                                "example_id": "b85a4b5a-9179-4ba1-8768-79b93e3272bd",
                                                "sense_id": "35421c3a-f2f0-3c68-8e75-cf6b0f680e00",
                                                "text": "„Als neurologischer Status wird der durch den Arzt erhobene Befund der neurologischen Untersuchung zur Beurteilung zentral- und periphernervöser Funktionen bezeichnet.“"
                                            }
